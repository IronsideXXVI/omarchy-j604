# J604 build (IronsideXXVI/omarchy-j604), Omarchy EDGE channel: the official omarchy-dev recipe (omacom/omarchy-pkgs
# 5c7fdeae, 4.0.0.r7641.gf97d3e7-1), pkgrel -> 1.1, plus the keyboard-backlight patches (kbd-*.patch,
# 2026-11-09), each byte-for-byte a commit of an omacom/omarchy pull request branch on quattro cbd0029 (they apply to f97d3e7 unchanged):
# kbd-0101 = #12558 (idle.keyboardBacklight, Daniel Fernau), kbd-0102 = the platform's idle.json default
# (omarchy-mac: 10 s), kbd-0103 = the restore level kept across a reboot, kbd-0104 = key-names "-" leaves
# absent keys out of Super+K. omarchy-dev and omarchy-settings-dev are built from the same patched source.
# 1.2 (2026-11-11): bar-0301 names the Glassy bar's strip as its ext-background-effect blur region, so Hyprland
# (with the carried blur-region patch) blurs only behind the strip; the look is unchanged. Only omarchy-dev ships
# Bar.qml; omarchy-settings-dev stays 1.1.
# Maintainer: Ryan Hughes <ryan@omarchy.org>
pkgname='omarchy-dev'
pkgver=4.0.0.r7641.gf97d3e7
pkgrel=1.2
# Pinned by the upstream watch in .omarchy/package.json (bin/sync-upstream):
# every quattro tip becomes a commit pin here, so the package is versioned,
# checksummed and built exactly like a release, just more often. The r-number
# is the branch's total commit count, not the distance from the last tag: the
# published history used the total, and pacman must never see it go down.
_commit=f97d3e7dc80e1f3ff39b142bbd330d537fe7c674
pkgdesc='Beautiful, modern, and opinionated Arch Linux by DHH (quattro branch tip)'
# The payload is architecture-independent, but the dependency set is not: the
# boot stack differs per architecture (see depends_x86_64 / depends_aarch64),
# and makepkg only honours arch-suffixed arrays on arch-specific packages.
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/omarchy'
license=('MIT')
provides=('omarchy')
conflicts=('omarchy')
# Hard depends: only packages whose removal would brick the desktop. The ISO
# pacstraps the full default install set from install/omarchy-base.packages.
depends=(
  # Omarchy meta
  'omarchy-keyring'
  'omarchy-settings-dev'

  # Wayland / Hyprland core
  'hyprland'
  'quickshell'
  'uwsm'
  'sddm'
  'xdg-desktop-portal-hyprland'

  # Audio / auth / portal essentials
  'wireplumber'
  'pipewire'
  'gnome-keyring'

  # Required by omarchy-* scripts and omarchy-shell
  'gum'
  'jq'
  'git'
  'perl' # /usr/bin/omarchy-shell invokes perl directly
  'omarchy-speedtest' # omarchy-network-speedtest runs its client

  # Update availability checks (checkupdates from pacman-contrib uses fakeroot)
  'fakeroot'
  'pacman-contrib'

  # System font (UI assumes it)
  'ttf-jetbrains-mono-nerd-basic'
)

# Bootloader stack. Lives here rather than on omarchy-settings because
# omarchy-settings is also installed into the live ISO env (for plymouth
# / /etc/skel seeding), where the limine-mkinitcpio-hook would fail with
# 'Cannot detect an ESP path' inside the chroot. The omarchy-settings
# config drop-ins under /etc/mkinitcpio.conf.d/, /etc/limine-entry-tool.d/,
# and /etc/snapper/config-templates/ only do anything when these are
# installed alongside.
depends_x86_64=(
  'limine'
  'limine-mkinitcpio-hook'
  'limine-snapper-sync'
  'snapper'
)

# Apple Silicon boots through m1n1 + GRUB from the Asahi packages and keeps
# Arch Linux ARM's kernel and boot layout, so the Limine/Snapper stack does not
# apply. Only Apple Silicon's Broadcom Wi-Fi needs iwd, and omarchy-mac depends
# on it. Elsewhere the package only renames the Wi-Fi interface to wlan0
# (80-iwd.link), and a saved connection tied to the old name stops connecting.
depends_aarch64=(
  'networkmanager'
)

makedepends=(
  'git'
)

# Source: the pinned quattro commit. Set OMARCHY_SRC=/path/to/checkout to
# build from a local source tree instead (mirrors omarchy-zsh/omarchy-fish DX);
# the arrays are emptied below so nothing is downloaded in that case.
source=("omarchy::git+https://github.com/omacom/omarchy.git#commit=${_commit}")
sha256sums=('c4defe655926e5d33062397f59064549f55784db700c858b12a7b886f7aa205d')
if [[ -n "${OMARCHY_SRC:-}" ]]; then
  source=()
  sha256sums=()
fi

# J604 build: keyboard-backlight series (see header).
source+=("kbd-0101-Add-optional-idle-timeout-for-keyboard-backlight.patch")
sha256sums+=('6ed892b49418e9450b5c2517c3319a4a930799d2b4547ca6dde0fd6e53ea58e9')
source+=("kbd-0102-Let-a-platform-set-the-default-keyboard-backlight-id.patch")
sha256sums+=('f312f5611a1627f775f18e1f0e6c4e638167c85b534fcb6c43d29d41519bed4d')
source+=("kbd-0103-Keep-the-keyboard-backlight-s-restore-level-across-a.patch")
sha256sums+=('373b54e1f5244fa05f3f8b9d33f76bd4685ec77bdd10bbc5f6a7be4f31bc077a')
source+=("kbd-0104-Let-a-platform-leave-keys-its-keyboards-lack-out-of-.patch")
sha256sums+=('d6afec57b3c76e8999817d43d0a45925e6b78a114491e07b7f09670a30eda6b7')

source+=("bar-0301-Blur-the-Glassy-bar-only-behind-its-strip.patch")
sha256sums+=('d52664552f9f27b949dfa998a856cf0cd4503cbf581104bc9970e31ef76fbb5d')

prepare() {
  if [[ -n "${OMARCHY_SRC:-}" ]]; then
    rm -rf "$srcdir/omarchy"
    mkdir -p "$srcdir/omarchy"
    cp -a "${OMARCHY_SRC}/." "$srcdir/omarchy/"
  fi
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/kbd-0101-Add-optional-idle-timeout-for-keyboard-backlight.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/kbd-0102-Let-a-platform-set-the-default-keyboard-backlight-id.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/kbd-0103-Keep-the-keyboard-backlight-s-restore-level-across-a.patch"
  patch -d "$srcdir/omarchy" -Np1 -i "$srcdir/kbd-0104-Let-a-platform-leave-keys-its-keyboards-lack-out-of-.patch"
  patch -d "$srcdir/omarchy" -Np1 --fuzz=0 -i "$srcdir/bar-0301-Blur-the-Glassy-bar-only-behind-its-strip.patch"
}

package() {
  # omarchy-update cannot start without the library settings now ships. Set
  # here, not above: makepkg checks only the top-level depends before
  # building, against a repository that may not publish that settings yet.
  depends+=('omarchy-security-functions')
  # The theme intro videos ship on their own, so this package stays small.
  depends+=('omarchy-themes-intros')

  cd "$srcdir/omarchy"

  # Runtime binaries — ship everything in bin/ except the debug helpers
  # that ship from omarchy-settings (needed before omarchy is installed,
  # e.g. on the ISO live env), and the sudo grant helpers settings owns.
  install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/omarchy/bin"
  for bin in bin/*; do
    [[ -f $bin ]] || continue
    local base
    base=$(basename "$bin")
    case "$base" in
      omarchy-debug|omarchy-debug-idle|omarchy-upload-log|omarchy-sudo-passwordless|omarchy-security-functions)
        continue
        ;;
    esac
    install -Dm755 "$bin" "$pkgdir/usr/bin/$base"
    ln -s "/usr/bin/$base" "$pkgdir/usr/share/omarchy/bin/$base"
  done

  install -d "$pkgdir/usr/share/omarchy"

  # Guard direct pacman upgrades from bypassing the Omarchy update pipeline,
  # and pause Hyprland live config reloads while settings files are replaced.
  # Ship hooks with their Exec targets so package skew cannot leave a broken
  # hook pointing at a missing binary.
  install -Dm644 default/libalpm/hooks/00-omarchy-update-guard.hook "$pkgdir/usr/share/libalpm/hooks/00-omarchy-update-guard.hook"
  install -Dm644 default/libalpm/hooks/10-omarchy-hyprland-reload-pause.hook "$pkgdir/usr/share/libalpm/hooks/10-omarchy-hyprland-reload-pause.hook"
  install -Dm644 default/libalpm/hooks/90-omarchy-hyprland-reload-resume.hook "$pkgdir/usr/share/libalpm/hooks/90-omarchy-hyprland-reload-resume.hook"
  # Sources with per-person blocked apps re-deny them after every transaction,
  # since an upgrade replaces a program and its ACL with it.
  if [[ -f default/libalpm/hooks/95-omarchy-blocked-apps.hook ]]; then
    install -Dm644 default/libalpm/hooks/95-omarchy-blocked-apps.hook "$pkgdir/usr/share/libalpm/hooks/95-omarchy-blocked-apps.hook"
  fi

  # Target-side setup scripts and package lists used by ISO finalization,
  # first login, future users, migrations, and reinstall/reset commands.
  cp -a install "$pkgdir/usr/share/omarchy/"

  # Theme bundles for theme switching.
  cp -a themes "$pkgdir/usr/share/omarchy/"
  # Their intro videos ship from omarchy-themes-intros, into these same
  # directories, so they are not downloaded again with every rebuild.
  rm -rf "$pkgdir"/usr/share/omarchy/themes/*/backgrounds/intros

  # Versioned migrations runner reads from this tree.
  cp -a migrations "$pkgdir/usr/share/omarchy/"

  # Fresh users created after install are already on the package layout in this
  # build, so seed migration markers through /etc/skel. Existing users keep
  # their own state and still run pending migrations on update.
  if compgen -G 'migrations/*.sh' >/dev/null; then
    install -d "$pkgdir/etc/skel/.local/state/omarchy/migrations"
    for migration in migrations/*.sh; do
      touch "$pkgdir/etc/skel/.local/state/omarchy/migrations/$(basename "$migration")"
    done
  fi
  # Quickshell desktop shell tree.
  cp -a shell "$pkgdir/usr/share/omarchy/"

  # Runtime version file.
  install -Dm644 version "$pkgdir/usr/share/omarchy/version"
}
