new file mode 100644
index 000000000..a45721663
--- /dev/null
+++ b/etc/sudoers.d/omarchy-plymouth-quit
@@ -0,0 +1,2 @@
+%wheel ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block omarchy-plymouth-quit.service
+sddm ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block omarchy-plymouth-quit.service
diff --git a/etc/systemd/system/omarchy-plymouth-quit.service b/etc/systemd/system/omarchy-plymouth-quit.service
new file mode 100644
index 000000000..ecb9b7556
--- /dev/null
+++ b/etc/systemd/system/omarchy-plymouth-quit.service
@@ -0,0 +1,9 @@
+[Unit]
+Description=Hand the screen from the boot splash to the desktop
+ConditionPathExists=/run/plymouth/pid
+
+[Service]
+Type=oneshot
+# The desktop is on screen by now, so keep the splash's frame rather than
+# repaint the console under it.
+ExecStart=/usr/bin/plymouth quit --retain-splash
diff --git a/etc/systemd/system/omarchy-plymouth-quit.timer b/etc/systemd/system/omarchy-plymouth-quit.timer
new file mode 100644
index 000000000..96aeb6e31
--- /dev/null
+++ b/etc/systemd/system/omarchy-plymouth-quit.timer
@@ -0,0 +1,7 @@
+[Unit]
+Description=Quit the boot splash if the desktop never takes it over
+
+[Timer]
+OnActiveSec=60s
+AccuracySec=1s
+Unit=omarchy-plymouth-quit.service
diff --git a/etc/systemd/system/sddm.service.d/10-omarchy-plymouth-handoff.conf b/etc/systemd/system/sddm.service.d/10-omarchy-plymouth-handoff.conf
new file mode 100644
index 000000000..0037de1bb
--- /dev/null
+++ b/etc/systemd/system/sddm.service.d/10-omarchy-plymouth-handoff.conf
@@ -0,0 +1,16 @@
+# sddm has no Plymouth handover of its own: plymouth-quit.service runs first
+# and the screen goes black until the desktop draws, for seconds. Take that job
+# over as gdm.service does. Plymouth is deactivated instead: it keeps its last
+# frame on screen and gives up the display, so the compositor's first frame
+# replaces the splash directly. Hyprland, the session's or the greeter's,
+# quits Plymouth as it starts rendering (omarchy-plymouth-quit.service); the
+# timer quits it if neither ever does, and a failed sddm still runs the plain
+# quit.
+[Unit]
+After=plymouth-start.service
+Conflicts=plymouth-quit.service
+OnFailure=plymouth-quit.service
+Wants=omarchy-plymouth-quit.timer
+
+[Service]
+ExecStartPre=-/usr/bin/plymouth deactivate
diff --git a/shell/services/BackgroundIntro.qml b/shell/services/BackgroundIntro.qml
index 673aefad2..38b517488 100644
--- a/shell/services/BackgroundIntro.qml
+++ b/shell/services/BackgroundIntro.qml
@@ -26,6 +26,20 @@ Item {
   property string themeColors: ""
   property string themeShell: ""
   property real themeOpacity: 1
+  // The boot splash's background, as omarchy-plymouth-set installed it. The
+  // login cover is that colour, as Hyprland's own background is, so the screen
+  // holds the splash's colour from Plymouth until the desktop fades in. The
+  // splash's logo stays with Plymouth: Hyprland draws frames of its own before
+  // this cover maps, and a logo here would blink out and back.
+  property string splashDir: "/usr/share/plymouth/themes/omarchy"
+  readonly property color splashBackground: {
+    var match = String(splashScript.text() || "").match(/Window\.SetBackgroundTopColor\(\s*([\d.]+)\s*,\s*([\d.]+)\s*,\s*([\d.]+)\s*\)/)
+    var channels = match ? match.slice(1).map(Number) : []
+    if (channels.length !== 3 || !channels.every(isFinite)) return "black"
+    // Truncated to 8 bits as Plymouth converts it, so the two match exactly.
+    var byte = function(value) { return Math.floor(Math.min(Math.max(value, 0), 1) * 255) / 255 }
+    return Qt.rgba(byte(channels[0]), byte(channels[1]), byte(channels[2]), 1)
+  }
   readonly property var backgroundService: host && host.services ? host.firstPartyServiceFor("omarchy.background") : null
   readonly property bool backgroundActive: !!backgroundService && !backgroundService.suspended
   readonly property bool backgroundReady: backgroundActive && backgroundService.ready !== false
@@ -196,6 +210,14 @@ Item {
     }
   }
 
+  FileView {
+    id: splashScript
+    path: root.startupPending ? root.splashDir + "/omarchy.script" : ""
+    blockLoading: true
+    watchChanges: false
+    printErrors: false
+  }
+
   // A shell restart shares this compositor session; a new login does not.
   FileView {
     id: sessionMarker
@@ -255,7 +277,7 @@ Item {
 
       Rectangle {
         anchors.fill: parent
-        color: "black"
+        color: root.splashBackground
         opacity: root.startupOpacity
       }
 
diff --git a/test/shell.d/background-startup-test.sh b/test/shell.d/background-startup-test.sh
index 624e80a64..6f6fb6cfb 100644
--- a/test/shell.d/background-startup-test.sh
+++ b/test/shell.d/background-startup-test.sh
@@ -28,11 +28,15 @@ else
 fi
 SH
 chmod +x "$stage/bin/hyprctl"
+# The boot splash as omarchy-plymouth-set installs it.
+mkdir -p "$stage/splash"
+printf 'Window.SetBackgroundTopColor(0.101, 0.105, 0.149);\n' >"$stage/splash/omarchy.script"
 : >"$stage/cursor.log"
-output=$(HOME="$stage/home" PATH="$stage/bin:$PATH" STARTUP_CURSOR_LOG="$stage/cursor.log" timeout 6 quickshell -p "$stage" --no-color 2>&1) || fail "background startup fixture exits cleanly" "$output"
+output=$(HOME="$stage/home" PATH="$stage/bin:$PATH" STARTUP_CURSOR_LOG="$stage/cursor.log" SPLASH_DIR="$stage/splash" timeout 6 quickshell -p "$stage" --no-color 2>&1) || fail "background startup fixture exits cleanly" "$output"
 [[ $output == *"RESULT pass"* ]] || fail "the wallpaper restores before background plugin loading" "$output"
 if rg -q 'RESULT fail|ReferenceError|TypeError|Error:|Unable to assign|Binding loop' <<<"$output"; then
   fail "background startup fixture has no QML errors" "$output"
 fi
 pass "fresh startup hides the desktop until both the background and bar are ready"
 pass "the startup cursor stays hidden until the desktop begins fading in"
+pass "a new login starts on the boot splash's background"
