diff --git a/default/hypr/autostart.lua b/default/hypr/autostart.lua
index d1529d712..f575a6674 100644
--- a/default/hypr/autostart.lua
+++ b/default/hypr/autostart.lua
@@ -1,6 +1,12 @@
 require("default.hypr.startup-cursor")
 
 hl.on("hyprland.start", function()
+  -- sddm only deactivated Plymouth, which kept its frame on screen until
+  -- Hyprland committed a buffer of its own to every output it enabled at
+  -- startup. This event comes as Hyprland starts rendering, after those
+  -- commits, so Plymouth can quit. See etc/systemd/system/sddm.service.d/.
+  hl.exec_cmd("sudo -n /usr/bin/systemctl start --no-block omarchy-plymouth-quit.service")
+
   -- Applications inherit the user's cursor; only the compositor starts blank.
   if omarchy_startup_cursor_pending then
     hl.env("XCURSOR_PATH", omarchy_startup_cursor.path)
diff --git a/default/hypr/looknfeel.lua b/default/hypr/looknfeel.lua
index a562c6be4..9fcdfedb1 100644
--- a/default/hypr/looknfeel.lua
+++ b/default/hypr/looknfeel.lua
@@ -1,5 +1,29 @@
 -- Refer to https://wiki.hypr.land/Configuring/Basics/Variables/
 
+-- The boot splash's background, so the desktop starts on the colour the splash
+-- leaves on screen instead of cutting to black. omarchy-plymouth-set writes it
+-- into the installed Plymouth script; keep in sync with default/sddm/hyprland.lua.
+local function splash_background()
+  local file = io.open("/usr/share/plymouth/themes/omarchy/omarchy.script", "r")
+  if not file then
+    return "rgb(000000)"
+  end
+
+  local script = file:read("a")
+  file:close()
+  local r, g, b = script:match("Window%.SetBackgroundTopColor%(%s*([%d.]+)%s*,%s*([%d.]+)%s*,%s*([%d.]+)%s*%)")
+  r, g, b = tonumber(r), tonumber(g), tonumber(b)
+  if not (r and g and b) then
+    return "rgb(000000)"
+  end
+
+  -- Truncated as Plymouth converts it, so the two match to the last bit.
+  local function byte(value)
+    return math.floor(math.min(math.max(value, 0), 1) * 255)
+  end
+  return string.format("rgb(%02x%02x%02x)", byte(r), byte(g), byte(b))
+end
+
 local active_border_color = { colors = { "rgba(33ccffee)", "rgba(00ff99ee)" }, angle = 45 }
 local inactive_border_color = "rgba(595959aa)"
 
@@ -106,7 +130,7 @@ hl.config({
   misc = {
     disable_hyprland_logo = true,
     disable_splash_rendering = true,
-    background_color = "rgb(000000)",
+    background_color = splash_background(),
     disable_scale_notification = true,
     focus_on_activate = true,
     anr_missed_pings = 3,
diff --git a/default/sddm/hyprland.lua b/default/sddm/hyprland.lua
index 5f31ecbd1..2c76e0ed5 100644
--- a/default/sddm/hyprland.lua
+++ b/default/sddm/hyprland.lua
@@ -67,6 +67,37 @@ if non_latin_layouts:find(" " .. kb_layout:match("^[^,]*") .. " ", 1, true) then
   kb_options = "grp:alts_toggle"
 end
 
+-- The boot splash's background, so the greeter starts on the colour the splash
+-- leaves on screen instead of cutting to black. Duplicated from
+-- default/hypr/looknfeel.lua for the same reason as read_vconsole(); keep the
+-- two in sync.
+local function splash_background()
+  local file = io.open("/usr/share/plymouth/themes/omarchy/omarchy.script", "r")
+  if not file then
+    return "rgb(000000)"
+  end
+
+  local script = file:read("a")
+  file:close()
+  local r, g, b = script:match("Window%.SetBackgroundTopColor%(%s*([%d.]+)%s*,%s*([%d.]+)%s*,%s*([%d.]+)%s*%)")
+  r, g, b = tonumber(r), tonumber(g), tonumber(b)
+  if not (r and g and b) then
+    return "rgb(000000)"
+  end
+
+  -- Truncated as Plymouth converts it, so the two match to the last bit.
+  local function byte(value)
+    return math.floor(math.min(math.max(value, 0), 1) * 255)
+  end
+  return string.format("rgb(%02x%02x%02x)", byte(r), byte(g), byte(b))
+end
+
+-- sddm only deactivated Plymouth; see default/hypr/autostart.lua. A boot that
+-- shows this greeter quits it here, as a session's Hyprland does.
+hl.on("hyprland.start", function()
+  hl.exec_cmd("sudo -n /usr/bin/systemctl start --no-block omarchy-plymouth-quit.service")
+end)
+
 hl.config({
   input = {
     kb_layout = kb_layout,
@@ -77,7 +108,7 @@ hl.config({
   misc = {
     disable_hyprland_logo = true,
     disable_splash_rendering = true,
-    background_color = "rgb(000000)",
+    background_color = splash_background(),
     force_default_wallpaper = 0,
   },
 
