# J604 local build (see README)
# The official 4.5.0-3 recipe (omacom/omarchy-pkgs rc c7a1ef7f), changed only by pkgrel 3 -> 3.4 and the patches below
# J604 local build (see README)
#  0001 = cherry-pick -x of omacom/omarchy PR 12558 104b880d (idle.keyboardBacklight);
#  0002/0003 = J604 patches (keyboard blank record across reboots; platform-root default + LED gate);
#  0004/0005 = cherry-pick -x of omacom/omarchy plymouth-handover d7feacb59, 47c9d9ad3 (as in omarchy-settings 4.5.0-3.3);
# J604 local build (see README)
#         lack out of the Super+K menu (with omarchy-mac 0.2.3-2.6). 3.2 = 0001-0005 only (published and withdrawn).
# J604 local build (see README)
#         omarchy-battery-status takes UPower's charge thresholds only while its charge limit is on, else the
#         battery's own sysfs thresholds. 3.3 = 0001-0006 (built, never published).
# J604 local build (see README)
#         blur rule from the packaged toggle (omarchy-settings 4.5.0-3.4 adds xray to it), through the
#         official omarchy-bar sync-glass; no-op for other bar backgrounds and hand-edited copies.
#  0009 = backport of omacom/omarchy PR 8025 head 6c729990 (automatic display brightness: omarchy brightness auto,
# J604 local build (see README)
# J604 local build (see README)
#         sensor (first-run + migration 1794108600, the user's choice kept), the keyboard backlight follows the sensor
#         like macOS, no backlight write to a DPMS-off panel. 3.609 = 3.5 + 0009 + 0010 (local pkgrel in the .60N
#         scheme of the 1.609 dev loop; sorts above 3.5).
# J604 local build (see README)
#         brightness default again, without ignoring a failure. 1794108600 could not install the service's
#         unit, which omarchy 3.609 needed from omarchy-settings and settings 3.4 did not ship. 3.610 = 3.609 +
#         0011, and needs omarchy-settings >= 4.5.0-3.610 (which ships the unit).
# Maintainer: Ryan Hughes <ryan@omarchy.org>
# Release versioning convention (do not "fix" this; enforced by bin/omarchy-pkgs release):
#  - Pre-releases use the ATTACHED form pkgver=X.Y.ZrcN — NO separator. pacman's
#    vercmp orders 4.0.0rc1 < 4.0.0rc2 < 4.0.0, but 4.0.0.rc1 and 4.0.0_rc1
#    both sort AFTER 4.0.0 and would strand users on the pre-release.
#  - pkgrel resets to 1 whenever pkgver changes; bump pkgrel alone only to
#    repackage the same source.
#  - epoch is a manual escape hatch decided by a human; tooling never sets it.
#  - _commit is the single source of truth for what gets built. _tag is
#    provenance only (empty when cut from a bare commit). omarchy and
#    omarchy-settings must always carry identical _tag/_commit/pkgver/sha256sums.
pkgname='omarchy'
_tag='v4.5.0'
_commit='ac2690cd7be4f47e4a255f5e2e78d904d436b068'
pkgver=4.5.0
pkgrel=3.610
pkgdesc='Beautiful, modern, and opinionated Arch Linux by DHH'
# The payload is architecture-independent, but the dependency set is not: the
# boot stack differs per architecture (see depends_x86_64 / depends_aarch64),
# and makepkg only honours arch-suffixed arrays on arch-specific packages.
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/omarchy'
license=('MIT')
conflicts=('omarchy-dev')
# Hard depends: only packages whose removal would brick the desktop. The ISO
# pacstraps the full default install set from install/omarchy-base.packages.
depends=(
  # Omarchy meta
  'omarchy-keyring'
  # The theme intro videos ship on their own, so this package stays small.
  'omarchy-themes-intros'
  # Exact-version pin: omarchy-settings-dev `provides=omarchy-settings`
  # (unversioned), and an unversioned dependency here would let the dev
  # package satisfy it, leaving a mixed dev/stable install. A versioned
  # dependency can only be satisfied by the real omarchy-settings built
  # from the same _commit, and forces the pair to upgrade together.
  "omarchy-settings=${pkgver}"
  # J604 local build (see README)
  # which migration 1794122400 installs.
  'omarchy-settings>=4.5.0-3.610'

  # Wayland / Hyprland core
  'hyprland'
  'quickshell'
  'uwsm'
  'sddm'
  'xdg-desktop-portal-hyprland'

  # Audio / auth / portal essentials
  'wireplumber'
  'pipewire'
  'gnome-keyring'

  # Required by omarchy-* scripts and omarchy-shell
  'gum'
  'jq'
  'git'
  'perl' # /usr/bin/omarchy-shell invokes perl directly
  'omarchy-speedtest' # omarchy-network-speedtest runs its client

  # Update availability checks (checkupdates from pacman-contrib uses fakeroot)
  'fakeroot'
  'pacman-contrib'

  # System font (UI assumes it)
  'ttf-jetbrains-mono-nerd-basic'
)

# Bootloader stack. Lives here rather than on omarchy-settings because
# omarchy-settings is also installed into the live ISO env (for plymouth
# / /etc/skel seeding), where the limine-mkinitcpio-hook would fail with
# 'Cannot detect an ESP path' inside the chroot. The omarchy-settings
# config drop-ins under /etc/mkinitcpio.conf.d/, /etc/limine-entry-tool.d/,
# and /etc/snapper/config-templates/ only do anything when these are
# installed alongside.
depends_x86_64=(
  'limine'
  'limine-mkinitcpio-hook'
  'limine-snapper-sync'
  'snapper'
)

# Apple Silicon boots through m1n1 + GRUB from the Asahi packages and keeps
# Arch Linux ARM's kernel and boot layout, so the Limine/Snapper stack does not
# apply. Only Apple Silicon's Broadcom Wi-Fi needs iwd, and omarchy-mac depends
# on it. Elsewhere the package only renames the Wi-Fi interface to wlan0
# (80-iwd.link), and a saved connection tied to the old name stops connecting.
depends_aarch64=(
  'networkmanager'
)

makedepends=(
  'git'
)

# Source: the pinned release commit; set OMARCHY_SRC=/path/to/checkout to
# build from a local source tree instead (mirrors omarchy-zsh/omarchy-fish DX).
if [[ -n "${OMARCHY_SRC:-}" ]]; then
  source=()
  sha256sums=()
else
  source=("omarchy::git+https://github.com/omacom/omarchy.git#commit=${_commit}")
  sha256sums=('c31a1cb76aa89e78254603f7ea6deecd9ed7e78309befd9a0b70ddbf015468ba')
fi

