+if (( $# == 2 )) && [[ $1 == "--monitor" ]]; then
+  printf '%s\n' "${BRIGHTNESS_VALUE:-30}"
+elif (( $# == 5 )) && [[ $1 == "--no-osd" && $2 == "--monitor" && $5 == "--nonblocking" ]]; then
