+systemctl_state="$test_tmp/systemctl-state"
+systemctl_calls="$test_tmp/systemctl-calls"
+monitors_file="$test_tmp/monitors.json"
+mkdir -p "$mock_bin"
+printf 'disabled inactive\n' >"$systemctl_state"
