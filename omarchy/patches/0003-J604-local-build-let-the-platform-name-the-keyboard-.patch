 assertDeepEqual(idle.eventParts({ data: 'a,b,c' }, 2), ['a', 'b', 'c'], 'idle parses raw event data')
 assertDeepEqual(
@@ -76,6 +87,9 @@ grep -F 'root.keyboardBacklightTimeoutArmed = root.keyboardBacklightTimeoutEnabl
 grep -F 'function enqueueKeyboardCommand' "$idle_service" >/dev/null
 grep -F 'function pumpKeyboardCommand' "$idle_service" >/dev/null
 grep -F 'id: keyboardCommandProcess' "$idle_service" >/dev/null
+grep -F 'path: "/usr/share/omarchy-platform/idle.json"' "$idle_service" >/dev/null
+grep -F 'id: keyboardBacklightProbe' "$idle_service" >/dev/null
+grep -F 'keyboardBacklightTimeoutSeconds > 0 && keyboardBacklightPresent' "$idle_service" >/dev/null
