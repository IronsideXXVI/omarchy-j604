-7. `idle.screensaver` and `idle.lock` are seconds since user idle began. Optional `idle.keyboardBacklight` is the same clock; omit it or set `0` to leave the keyboard LED at the last chosen level.
+7. `idle.screensaver` and `idle.lock` are seconds since user idle began. Optional `idle.keyboardBacklight` is the same clock; omit it or set `0` to leave the keyboard LED at the last chosen level. Without the key, a platform's default from `/usr/share/omarchy-platform/idle.json` (`{"keyboardBacklight": <seconds>}`) applies; a machine without a `*kbd_backlight*` LED has no timeout.
 8. `version: 1` is required.
 
 The bar's sections run along it in the order `left`, `centerBegin`, `center`, `centerEnd`, `right`. `center` is a box in the middle of the bar whose widgets are centered as one group; `centerBegin` and `centerEnd` hang off its two edges and move out as it grows. An empty box takes no room, so the two meet in the middle of the bar. While a widget is dragged, the other widgets make room for it where it would land, and it gives up its own room unless it would land back there; the box shows as an outline, or a line across the bar when empty, that it can be dropped into or beside, and grows to take in a widget that would land in it. A drop within the bar's thickness of an empty box's middle lands in it. The tray's drawer, which opens while a widget is dragged, holds the tray section the same way: it shows as an outline, or a line when empty, and a drop over it, or within half the bar's thickness of it, lands in it. A layout written from elsewhere during a drag (`omarchy bar move`, a hand edit) that moves widgets about makes the drag let go, and the layout stays as written.
diff --git a/manual/13-toggles-idle-screensaver.md b/manual/13-toggles-idle-screensaver.md
index f11b2fc7..9d3148a3 100644
--- a/manual/13-toggles-idle-screensaver.md
+++ b/manual/13-toggles-idle-screensaver.md
@@ -79,7 +79,7 @@ The Omarchy shell owns idle behavior, and the timings are a top-level `idle` blo
 
 `screensaver` and `lock` are seconds counted from the moment you went idle — not from each other. So with the defaults, the screensaver comes up after two and a half minutes and the lock screen takes over at five minutes, whether or not the screensaver ran. Save the file and the shell picks up the new timings right away.
 
-Keyboard backlight timeout is off unless you add it. A positive `idle.keyboardBacklight` turns the keyboard light off after that many idle seconds and brings back the last level you chose when you type or move the pointer. Omit the key, or set it to `0`, to leave the light at that chosen level. Stay awake does not disable this timeout, and playing video does not keep the keyboard lit.
+Keyboard backlight timeout is off unless you add it or your machine's platform package turns it on (a Mac does, at 10 seconds). A positive `idle.keyboardBacklight` turns the keyboard light off after that many idle seconds and brings back the last level you chose when you type or move the pointer. Omit the key, or set it to `0`, to leave the light at that chosen level. Stay awake does not disable this timeout, and playing video does not keep the keyboard lit.
 
 ```json
 {
diff --git a/shell/plugins/services/idle/IdleModel.js b/shell/plugins/services/idle/IdleModel.js
index 3c85ddcd..83d9b25a 100644
--- a/shell/plugins/services/idle/IdleModel.js
+++ b/shell/plugins/services/idle/IdleModel.js
@@ -24,8 +24,28 @@ function delayAfterFirstIdle(timeoutSeconds, firstIdleSeconds) {
   return delay > 0 ? delay : 0
 }
 
-function keyboardBacklightTimeoutSeconds(idle) {
-  return secondsFromConfig(idle && idle.keyboardBacklight, 0)
+// shell.json's idle.keyboardBacklight wins, 0 included. Without it the
+// platform's default applies, and without that the timeout is off.
+function keyboardBacklightTimeoutSeconds(idle, platformIdle) {
+  var fallback = secondsFromConfig(platformIdle && platformIdle.keyboardBacklight, 0)
+  if (!idle || idle.keyboardBacklight === undefined || idle.keyboardBacklight === null) return fallback
+  return secondsFromConfig(idle.keyboardBacklight, fallback)
+}
+
+// A platform package can name a default keyboard-backlight timeout in the
+// fixed platform root, /usr/share/omarchy-platform/idle.json (read by
+// Service.qml): {"keyboardBacklight": <seconds>}. Other keys, and a file that
+// is missing or not a JSON object, name nothing.
+function parsePlatformIdle(text) {
+  var raw = String(text || "").trim()
+  if (!raw) return ({})
+  try {
+    var parsed = JSON.parse(raw)
+    if (parsed && typeof parsed === "object" && !Array.isArray(parsed) && parsed.keyboardBacklight !== undefined)
+      return { keyboardBacklight: secondsFromConfig(parsed.keyboardBacklight, 0) }
+  } catch (error) {
+  }
+  return ({})
 }
 
 function eventParts(event, count) {
@@ -73,6 +93,7 @@ if (typeof module !== "undefined") {
     firstIdleTimeout: firstIdleTimeout,
     delayAfterFirstIdle: delayAfterFirstIdle,
     keyboardBacklightTimeoutSeconds: keyboardBacklightTimeoutSeconds,
+    parsePlatformIdle: parsePlatformIdle,
     eventParts: eventParts,
     screensaverWindowsAfter: screensaverWindowsAfter
   }
diff --git a/shell/plugins/services/idle/Service.qml b/shell/plugins/services/idle/Service.qml
index 67f05874..91d1a8ed 100644
--- a/shell/plugins/services/idle/Service.qml
+++ b/shell/plugins/services/idle/Service.qml
@@ -27,8 +27,13 @@ Item {
   readonly property int firstIdleTimeoutSeconds: IdleModel.firstIdleTimeout(screensaverTimeoutSeconds, lockTimeoutSeconds)
   readonly property int screensaverDelaySeconds: IdleModel.delayAfterFirstIdle(screensaverTimeoutSeconds, firstIdleTimeoutSeconds)
   readonly property int lockDelaySeconds: IdleModel.delayAfterFirstIdle(lockTimeoutSeconds, firstIdleTimeoutSeconds)
-  readonly property int keyboardBacklightTimeoutSeconds: IdleModel.keyboardBacklightTimeoutSeconds(idleConfig)
-  readonly property bool keyboardBacklightTimeoutEnabled: keyboardBacklightTimeoutSeconds > 0
+  // Read synchronously at startup (the FileView blocks loading), then kept
+  // current by its load handlers, as the audio hints are.
+  property var platformIdle: IdleModel.parsePlatformIdle(platformIdleFile.text())
+  readonly property int keyboardBacklightTimeoutSeconds: IdleModel.keyboardBacklightTimeoutSeconds(idleConfig, platformIdle)
+  // A machine without a keyboard LED has nothing to time out.
+  property bool keyboardBacklightPresent: false
+  readonly property bool keyboardBacklightTimeoutEnabled: keyboardBacklightTimeoutSeconds > 0 && keyboardBacklightPresent
   property bool keyboardBacklightTimeoutArmed: false
   property var keyboardCommandPending: null
   readonly property bool idleEnabled: stayAwakeStateLoaded && !stayAwake
@@ -226,8 +231,11 @@ Item {
     enqueueKeyboardCommand("keyboard-restore", "omarchy-brightness-keyboard --no-osd restore")
   }
 
+  // Turning the timeout off brings back a level it left dark. Turning it on,
+  // as at session start once the LED is found, brings back one a blank left
+  // dark across a reboot. restore acts only on a recorded blank.
   onKeyboardBacklightTimeoutEnabledChanged: {
-    if (root.keyboardBacklightTimeoutArmed && !root.keyboardBacklightTimeoutEnabled)
+    if (root.keyboardBacklightTimeoutArmed !== root.keyboardBacklightTimeoutEnabled)
       enqueueKeyboardCommand("keyboard-restore", "omarchy-brightness-keyboard --no-osd restore")
     root.keyboardBacklightTimeoutArmed = root.keyboardBacklightTimeoutEnabled
   }
@@ -245,6 +253,7 @@ Item {
       lock: root.lockTimeoutSeconds,
       keyboardBacklight: root.keyboardBacklightTimeoutSeconds,
       keyboardBacklightIdle: keyboardBacklightMonitor.isIdle,
+      keyboardBacklightPresent: root.keyboardBacklightPresent,
       screensaverDelay: root.screensaverDelaySeconds,
       lockDelay: root.lockDelaySeconds,
       screensaverWindows: root.screensaverWindowCount,
@@ -364,6 +373,24 @@ Item {
     id: wakeProcess
     onExited: function(exitCode, exitStatus) { root.logEvent("process-exit", "wake exitCode=" + exitCode + " status=" + exitStatus) }
   }
+  Process {
+    id: keyboardBacklightProbe
+    // The same LEDs omarchy-brightness-keyboard drives.
+    command: ["bash", "-c", "compgen -G '/sys/class/leds/*kbd_backlight*' >/dev/null"]
+    onExited: function(exitCode) { root.keyboardBacklightPresent = exitCode === 0 }
+  }
+
+  FileView {
+    id: platformIdleFile
+    path: "/usr/share/omarchy-platform/idle.json"
+    blockLoading: true
+    watchChanges: true
+    printErrors: false
+    onLoaded: root.platformIdle = IdleModel.parsePlatformIdle(text())
+    onLoadFailed: root.platformIdle = IdleModel.parsePlatformIdle("")
+    onFileChanged: reload()
+  }
+
   Process {
     id: keyboardCommandProcess
     onExited: function(exitCode, exitStatus) {
@@ -406,6 +433,7 @@ Item {
   Component.onCompleted: {
     logEvent("service-ready")
     root.keyboardBacklightTimeoutArmed = root.keyboardBacklightTimeoutEnabled
+    keyboardBacklightProbe.running = true
     refreshStayAwakeState()
   }
 
