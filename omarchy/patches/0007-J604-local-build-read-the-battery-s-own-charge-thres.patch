From 92fc53a74c563602a8bc5cd6ded73b7c95d241eb Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 08:27:12 +0000
Subject: [PATCH] J604 local build: read the battery's own charge thresholds
 before UPower's

UPower lists the charge thresholds it would apply, from its hwdb default
(CHARGE_LIMIT=75,80 for every battery), even while its own charge limit
setting is off. omarchy-battery-status took those numbers first, so on a Mac
with the official full-charge default (the SMC limit at 100%,
"omarchy battery charge limit" reports 100%) the power panel showed a
75-80% threshold, timed charging to 80%, and could call idle charging above
80% "holding".

Take UPower's thresholds only once its charge limit is on (it prints
"charge-threshold-enabled: yes" only then); otherwise read the battery
UPower resolved from sysfs, which is what the firmware enforces. With
UPower's limit on nothing changes: its numbers come first and the sysfs
files fill in what it leaves out, as before.

Measured on the J604 (MacBook Pro 14-inch M4, omarchy 4.5.0-3, upower 1.91.5):
sysfs 100/100, upower 75%/80% without charge-threshold-enabled,
omarchy-battery-status --shell "threshold 75-80%".

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 bin/omarchy-battery-status          | 12 +++++-
 test/shell.d/battery-status-test.sh | 64 +++++++++++++++++++++++++++++
 2 files changed, 74 insertions(+), 2 deletions(-)

diff --git a/bin/omarchy-battery-status b/bin/omarchy-battery-status
index 00a06734..cf0392c7 100755
--- a/bin/omarchy-battery-status
+++ b/bin/omarchy-battery-status
@@ -89,8 +89,16 @@ power_rate=$(awk -v rate="${power_rate_raw:-0}" 'BEGIN {
   print rounded
 }')
 state=$(awk '/state/ { print $2; exit }' <<<"$battery_info")
-threshold_start=$(awk '/charge-start-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")
-threshold_end=$(awk '/charge-end-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")
+# UPower lists the thresholds it would apply (its hwdb defaults) even while its
+# own charge limit is off, so its numbers count only once it has turned that
+# limit on; without them the battery's own thresholds, the ones its firmware
+# enforces, stand.
+threshold_start=""
+threshold_end=""
+if [[ $(awk '/charge-threshold-enabled:/ { print $2; exit }' <<<"$battery_info") == "yes" ]]; then
+  threshold_start=$(awk '/charge-start-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")
+  threshold_end=$(awk '/charge-end-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")
+fi
 
 # Read the thresholds from the battery UPower resolved rather than a BAT* glob,
 # which misses every battery with another name.
diff --git a/test/shell.d/battery-status-test.sh b/test/shell.d/battery-status-test.sh
index b97ae88f..be5d68fa 100644
--- a/test/shell.d/battery-status-test.sh
+++ b/test/shell.d/battery-status-test.sh
@@ -211,3 +211,67 @@ printf '9000000\n' >"$hold_dir/power/BAT0/power_now"
 sparse_output=$(OMARCHY_POWER_SUPPLY_PATH="$hold_dir/power" PATH="$hold_dir/bin:$PATH" "$ROOT/bin/omarchy-battery-status")
 [[ $sparse_output == "Battery 60%  ·  "$' '"9W" ]] || fail "missing readings drop out of the status line" "$sparse_output"
 pass "battery status leaves out readings it doesn't have"
+
+# UPower lists its hwdb default thresholds (75-80%) for a battery whose own
+# limit is off (100%) while its charge limit setting is off. The battery's own
+# thresholds win: no early hold at 85%, and the time to full counts to 100%.
+limit_dir=$(mktemp -d)
+trap 'rm -rf "$tmp_dir" "$hold_dir" "$limit_dir"' EXIT
+mkdir -p "$limit_dir/bin" "$limit_dir/power/macsmc-battery" "$limit_dir/power/macsmc-ac"
+printf 'Mains\n' >"$limit_dir/power/macsmc-ac/type"
+printf '1\n' >"$limit_dir/power/macsmc-ac/online"
+printf '100\n' >"$limit_dir/power/macsmc-battery/charge_control_start_threshold"
+printf '100\n' >"$limit_dir/power/macsmc-battery/charge_control_end_threshold"
+printf '100000\n' >"$limit_dir/power/macsmc-battery/power_now"
+cat >"$limit_dir/bin/upower" <<'STUB'
+#!/bin/bash
+
+if [[ $1 == "-e" ]]; then
+  echo "/org/freedesktop/UPower/devices/battery_macsmc_battery"
+  exit 0
+fi
+
+if [[ $1 == "-i" ]]; then
+  cat <<'INFO'
+  native-path:          macsmc-battery
+  power supply:         yes
+  state:                charging
+  energy:               53.1 Wh
+  energy-full:          62.4 Wh
+  energy-rate:          0.1 W
+  time to full:         0.5 hours
+  percentage:           85%
+    charge-start-threshold:        75%
+    charge-end-threshold:          80%
+    charge-threshold-supported:    yes
+INFO
+  exit 0
+fi
+
+exit 1
+STUB
+chmod +x "$limit_dir/bin/upower"
+off_output=$(OMARCHY_POWER_SUPPLY_PATH="$limit_dir/power" PATH="$limit_dir/bin:$PATH" "$ROOT/bin/omarchy-battery-status" --shell)
+grep -Fx $'state\tcharging' <<<"$off_output" >/dev/null || fail "a disabled UPower threshold does not hold the battery early" "$off_output"
+grep -Fx $'threshold\t100%' <<<"$off_output" >/dev/null || fail "the battery's own threshold wins over UPower's disabled default" "$off_output"
+printf '9300000\n' >"$limit_dir/power/macsmc-battery/power_now"
+off_time=$(OMARCHY_POWER_SUPPLY_PATH="$limit_dir/power" PATH="$limit_dir/bin:$PATH" "$ROOT/bin/omarchy-battery-status" --shell)
+grep -Fx $'time\t1h' <<<"$off_time" >/dev/null || fail "time to full counts to the battery's own 100% limit" "$off_time"
+pass "battery status ignores UPower's thresholds while its charge limit is off"
+
+# With UPower's charge limit on and no sysfs reading, UPower's thresholds stand.
+rm "$limit_dir/power/macsmc-battery/charge_control_start_threshold" "$limit_dir/power/macsmc-battery/charge_control_end_threshold"
+printf '100000\n' >"$limit_dir/power/macsmc-battery/power_now"
+sed -i 's/    charge-threshold-supported:    yes/    charge-threshold-enabled:      yes\n    charge-threshold-supported:    yes/' "$limit_dir/bin/upower"
+on_output=$(OMARCHY_POWER_SUPPLY_PATH="$limit_dir/power" PATH="$limit_dir/bin:$PATH" "$ROOT/bin/omarchy-battery-status" --shell)
+grep -Fx $'threshold\t75-80%' <<<"$on_output" >/dev/null || fail "an enabled UPower threshold stands in for a missing sysfs one" "$on_output"
+grep -Fx $'state\tholding' <<<"$on_output" >/dev/null || fail "idle charging above an enabled UPower threshold is holding" "$on_output"
+pass "battery status uses UPower's thresholds once its charge limit is on"
+
+# With UPower's charge limit on, UPower's thresholds come first, as before,
+# even where the battery's own files read otherwise.
+printf '100\n' >"$limit_dir/power/macsmc-battery/charge_control_start_threshold"
+printf '100\n' >"$limit_dir/power/macsmc-battery/charge_control_end_threshold"
+first_output=$(OMARCHY_POWER_SUPPLY_PATH="$limit_dir/power" PATH="$limit_dir/bin:$PATH" "$ROOT/bin/omarchy-battery-status" --shell)
+grep -Fx $'threshold\t75-80%' <<<"$first_output" >/dev/null || fail "an enabled UPower threshold comes before the battery's own" "$first_output"
+pass "battery status takes UPower's thresholds first once its charge limit is on"
-- 
2.43.0

