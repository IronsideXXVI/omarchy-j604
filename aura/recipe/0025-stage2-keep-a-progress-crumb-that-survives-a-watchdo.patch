diff --git a/src/pmu_counter.c b/src/pmu_counter.c
index e2382973..325fc9c9 100644
--- a/src/pmu_counter.c
+++ b/src/pmu_counter.c
@@ -4,6 +4,7 @@
 #include "adt.h"
 #include "soc.h"
 #include "spmi.h"
+#include "../build/build_cfg.h"
 #include "string.h"
 #include "utils.h"
 
@@ -110,3 +111,38 @@ int pmu_read_boot_record(u8 *counts, u8 *error_stage)
     *error_stage = record[1];
     return 0;
 }
+
+#ifdef ESP_STAGE2
+/* Bytes of the PMU's legacy scratch (offset from info-leg_scrpad), for records that must survive a reset. */
+static char pmu_scr_path[64];
+static u8 pmu_scr_addr;
+static u16 pmu_scr_base;
+static int pmu_scr_state; /* 0 unknown, 1 found, -1 none */
+
+static spmi_dev_t *pmu_scratch_open(void)
+{
+    if (!pmu_scr_state)
+        pmu_scr_state = pmu_find_scratchpad(pmu_scr_path, sizeof(pmu_scr_path), &pmu_scr_addr, &pmu_scr_base) ? -1 : 1;
+    return pmu_scr_state > 0 ? spmi_init(pmu_scr_path) : NULL;
+}
+
+int pmu_scratch_read(u16 off, u8 *buf, size_t len)
+{
+    spmi_dev_t *spmi = pmu_scratch_open();
+    if (!spmi)
+        return -1;
+    int ret = spmi_ext_read_long(spmi, pmu_scr_addr, pmu_scr_base + off, buf, len);
+    spmi_shutdown(spmi);
+    return ret ? -1 : 0;
+}
+
+int pmu_scratch_write(u16 off, const u8 *buf, size_t len)
+{
+    spmi_dev_t *spmi = pmu_scratch_open();
+    if (!spmi)
+        return -1;
+    int ret = spmi_ext_write_long(spmi, pmu_scr_addr, pmu_scr_base + off, buf, len);
+    spmi_shutdown(spmi);
+    return ret ? -1 : 0;
+}
+#endif /* ESP_STAGE2 */
