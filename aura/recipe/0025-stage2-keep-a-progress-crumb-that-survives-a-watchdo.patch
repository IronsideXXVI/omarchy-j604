diff --git a/src/stage_crumb.c b/src/stage_crumb.c
new file mode 100644
index 00000000..89712e5e
--- /dev/null
+++ b/src/stage_crumb.c
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: MIT */
+
+/*
+ * Stage 2 progress crumb (J604, Nov 16 2026). A Stage 2 that hangs is reset by its watchdog and its
+ * console, a RAM page, does not survive the reset, so the next boot cannot say where it stopped.
+ * This keeps a few bytes in the PMU's legacy scratch, which do survive (scratch + 0x28..0x2f, free
+ * and backed on T8132; the kernel's cells end at +0x27):
+ *   +0x28 0xa5  +0x29 step  +0x2a sub  +0x2b boot sequence    (this boot, updated as it goes)
+ *   +0x2c 0xa6  +0x2d step  +0x2e sub  +0x2f its sequence      (the last boot that never jumped)
+ * At entry, a record whose step is not STAGE_CRUMB_JUMP belongs to a boot that stopped: it is
+ * copied to the second half before this boot starts writing. Linux reads both through nvmem.
+ * Only the ESP Stage 2 writes it; every failure is ignored (a crumb never stops a boot).
+ */
+
+#include "stage_crumb.h"
+#include "pmu_counter.h"
+#include "types.h"
+
+#ifdef ESP_STAGE2
+
+#define CRUMB_OFF  0x28
+#define CRUMB_LEN  8
+#define CRUMB_CUR  0xa5
+#define CRUMB_PREV 0xa6
+
+static bool crumb_on;
+
+void stage_crumb_begin(void)
+{
+    u8 r[CRUMB_LEN];
+
+    crumb_on = false;
+    if (pmu_scratch_read(CRUMB_OFF, r, CRUMB_LEN))
+        return;
+    bool had = r[0] == CRUMB_CUR;
+    if (had && r[1] != STAGE_CRUMB_JUMP && r[1] != 0) {
+        u8 p[4] = {CRUMB_PREV, r[1], r[2], r[3]};
+        pmu_scratch_write(CRUMB_OFF + 4, p, 4);
+    }
+    u8 c[4] = {CRUMB_CUR, STAGE_CRUMB_ENTRY, 0, (u8)(had ? r[3] + 1 : 1)};
+    crumb_on = !pmu_scratch_write(CRUMB_OFF, c, 4);
+}
+
+void stage_crumb(u8 step, u8 sub)
+{
+    if (!crumb_on)
+        return;
+    u8 s[2] = {step, sub};
+    pmu_scratch_write(CRUMB_OFF + 1, s, 2);
+}
+
+#endif /* ESP_STAGE2 */
diff --git a/src/stage_crumb.h b/src/stage_crumb.h
new file mode 100644
index 00000000..5768734a
--- /dev/null
+++ b/src/stage_crumb.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: MIT */
+
+#ifndef STAGE_CRUMB_H
+#define STAGE_CRUMB_H
+
+#include "../build/build_cfg.h"
+#include "types.h"
+
+/* Steps of an ESP Stage 2, in the order a good boot passes them. */
+#define STAGE_CRUMB_ENTRY     0x01 /* watchdog armed, crumb started */
+#define STAGE_CRUMB_PAYLOADS  0x02 /* "Checking for payloads" */
+#define STAGE_CRUMB_NVME      0x03 /* nvme_init entered (sub: 1 = it returned false) */
+#define STAGE_CRUMB_KBOOT     0x04 /* kboot_boot entered */
+#define STAGE_CRUMB_PCIE      0x05 /* PCIe prepare/init about to run */
+#define STAGE_CRUMB_PCIE_DONE 0x06 /* sub: pcie_prepare_fdt result | pcie_init result << 4 (low bits) */
+#define STAGE_CRUMB_NOPAYLOAD 0x0e /* "No valid payload found": the proxy follows */
+#define STAGE_CRUMB_JUMP      0x0f /* "Vectoring to next stage" */
+
+#ifdef ESP_STAGE2
+void stage_crumb_begin(void);
+void stage_crumb(u8 step, u8 sub);
+#else
+/* Stage 1 has no room for it (its image must end before the DCP log buffer). */
+static inline void stage_crumb_begin(void)
+{
+}
+static inline void stage_crumb(u8 step, u8 sub)
+{
+    (void)step;
+    (void)sub;
+}
+#endif
+
+#endif
