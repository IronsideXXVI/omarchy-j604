From 4d95c66356471d2692ff2821c637d50e81b8c91d Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 09:35:17 +0000
Subject: [PATCH 19/21] main: arm the boot watchdog in an ESP Stage 2 too

Stage 2 disarms Stage 1's boot watchdog at its start, and nothing arms
one again until Linux, so a Stage 2, loader or kernel that stops before
the watchdog driver probes stays on screen until someone holds the power
button. Arm the boot watchdog in an ESP Stage 2 as Stage 1 does, and arm
it again for the whole period right before the next stage, as a trial
boot does. A host that attaches disarms it as before; Linux's driver
finds it running (WDOG_HW_RUNNING) and keeps it fed.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 src/main.c | 11 ++++++++++-
 src/wdt.c  |  6 ++++--
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/src/main.c b/src/main.c
index e85ae886..bafb7ae7 100644
--- a/src/main.c
+++ b/src/main.c
@@ -431,7 +431,7 @@ void aura_main(void)
     wdt_disable();
     if (aura_trial_enabled() && wdt_arm_trial())
         printf("WDT: could not arm the trial watchdog\n");
-#if defined(CHAINLOADING) && !defined(ESP_STAGE2)
+#if defined(CHAINLOADING)
     else if (!aura_trial_enabled() && wdt_arm_boot())
         printf("WDT: could not arm the boot watchdog\n");
     else if (!aura_trial_enabled())
@@ -522,6 +522,15 @@ next_stage:
     /* Give the next stage of a trial boot the whole watchdog period. */
     if (aura_trial_enabled() && wdt_arm_trial())
         printf("WDT: could not arm the trial watchdog\n");
+#ifdef ESP_STAGE2
+    /*
+     * A plain boot, as a trial: the loader and the OS after Stage 2 start under the whole boot
+     * watchdog period, until Linux's driver finds it running and keeps it fed. A host that
+     * attached here disarmed it, and it stays off.
+     */
+    else if (wdt_boot_watchdog_armed() && wdt_arm_boot())
+        printf("WDT: could not arm the boot watchdog for the next stage\n");
+#endif
     printf("Vectoring to next stage...\n");
 #if defined(CHAINLOADING) && !defined(ESP_STAGE2)
     stage1_log_flush();
diff --git a/src/wdt.c b/src/wdt.c
index c46d43e9..b4bf83d0 100644
--- a/src/wdt.c
+++ b/src/wdt.c
@@ -140,8 +140,10 @@ int wdt_arm_trial(void)
  * read that drops it into the proxy with no host) stays on screen until someone holds the power
  * button. Stage 1 arms the primary watchdog for its longest period instead. The first host it
  * sees (a synced window or proxy request) disarms it, so a debugging session is never reset
- * under it; Stage 2's own wdt_disable() at its start disarms it on the normal path. Its reads
- * take well under a second, and its bounded host windows are 10-100 s.
+ * under it. An ESP Stage 2 disarms it at its start and arms it again the same way, then once
+ * more for the whole period right before its next stage, so a hang between Stage 2 and the
+ * kernel resets too; Linux's driver finds it running and keeps it fed. Its reads take well
+ * under a second, and its bounded host windows are 10-100 s.
  */
 int wdt_arm_boot(void)
 {
