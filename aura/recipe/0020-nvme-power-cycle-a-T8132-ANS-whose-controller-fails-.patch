From fbb083d9aa18c1bbf156518ef7a8a5c4e6dca236 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 10:22:38 +0000
Subject: [PATCH 20/21] nvme: power-cycle a T8132 ANS whose controller fails to
 come ready

A J604 Stage 2 parked in its proxy with no watchdog after a start of ANS
from off. Read from the parked stage: BOOT_STATUS 0xde71ce55 (the
firmware started), CC 0x470000 (EN clear) and CSTS 0x2 (controller fatal
status): the start succeeded, the controller then never came ready, and
the boot stopped.

Nothing has been queued before the controller is ready, so do what T6050
already does for an adopted session: power ANS off, start it from off
again and set the controller up once more, up to two times, with a log
line for each.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 src/nvme.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/nvme.c b/src/nvme.c
index d873a37c..162b73f3 100644
--- a/src/nvme.c
+++ b/src/nvme.c
@@ -586,6 +586,7 @@ bool nvme_init(void)
     nvme_boot_ticks = 0;
 
     bool from_off = false, earlier = false, adopted = false, restarted = false;
+    int enable_retries = 0;
     int adt_path[8];
     int node = adt_path_offset_trace(adt, "/arm-io/ans", adt_path);
     if (node < 0) {
@@ -778,6 +779,20 @@ setup_controller:
             from_off = true;
             goto setup_controller;
         }
+        /*
+         * T8132: after a start from off the firmware can report BOOT_STATUS OK and still never
+         * bring the controller ready (J604 Stage 2 parked with CC 0x470000, CSTS 0x2 = fatal).
+         * Nothing was queued yet: power ANS off and start it and the controller again.
+         */
+        if (from_off && nvme_type == NVME_T8132 && !nvme_secure_regs &&
+            enable_retries < NVME_ANS_START_TRIES - 1) {
+            enable_retries++;
+            printf("nvme: controller not ready after a start from off; ANS power cycle %d/%d\n",
+                   enable_retries, NVME_ANS_START_TRIES - 1);
+            if (!nvme_ans_power_off() || !nvme_ans_power_on())
+                goto out_preserve;
+            goto setup_controller;
+        }
         goto out_disable_ctrl;
     }
 
