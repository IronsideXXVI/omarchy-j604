# Aurora bootloader; ordinary updates refresh ESP Stage 2, never enroll Stage 1.
# J604 local build: alarm-aurora 22001de packages/aura (aura 1.0.0b13), changed only by
# pkgrel 1 -> 1.612 and the J604 series 0001-0015 applied in prepare(). The build label stays
# <VERSION>-g<commit>: update-m1n1 parses that form from Stage 1 to allow a Stage 2 trial.
pkgname=aura
pkgver=1.0.0b13
pkgrel=1.612
pkgdesc='Aurora Silicon bootloader for Apple Silicon'
arch=('aarch64')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/aura'
license=('MIT' 'GPL-2.0-only')
_commit=f0f180afe5db5c976b6e997ed1308ce4d5213bcb
# 1 once the pinned source has no monitor (aura#77); prepare() checks it. Such an
# aura moves the kernel into the CTXR window, so it requires a kernel built with
# CONFIG_ARM64_CTXR_EXECMEM, which linux-aurora provides as aurora-ctxr-execmem.
_monitor_free=1
_ctxr_kernel=()
if (( _monitor_free )); then _ctxr_kernel=('aurora-ctxr-execmem'); fi
_compat=1.6.1.aurora19
provides=("m1n1=$_compat" "m1n1-aurora=$_compat" "m1n1-neo=$_compat")
conflicts=('m1n1' 'm1n1-aurora' 'm1n1-neo')
replaces=('m1n1-neo')
makedepends=('git' 'clang' 'lld' 'llvm' 'rustup' 'make' 'python')
options=('!strip' '!debug')
source=("aura::git+$url.git#commit=$_commit" build-qualification.json validate-qualification.py
        0001-kboot-give-the-T8132-device-tree-room-for-its-hand-o.patch
        0002-pcie_fdt-publish-every-APCIe-root-port-s-own-tables-.patch
        0003-pcie_fdt-leave-plain-SMC-GPIO-output-rails-to-the-OS.patch
        0004-smp-index-the-T8132-CPU_START-status-mask-by-cpu-id-.patch
        0005-tests-host-test-of-the-AVE-encoder-firmware-hand-ove.patch
        0006-kboot-admit-T8132-boards-per-handoff-path-from-one-t.patch
        0007-sio-build-the-T8132-SIO-s-firmware-tables-in-the-pro.patch
        0008-tests-host-test-of-the-SIO-firmware-tables.patch
        0009-kboot-enable-a-handed-over-external-DCP-and-its-Type.patch
        0010-kboot-hand-the-preloaded-ANE-firmware-over-on-the-T8.patch
        0011-payload-hand-an-inline-payload-a-live-ANS-session-on.patch
        0012-tests-stub-nvme_init-in-the-payload-host-harness.patch
        0013-nvme-retry-the-post-M4-ANS-start-from-off-and-hand-a.patch
        0014-smp-restart-WD2-for-its-own-period-as-a-T8132-S2R-wa.patch
        0015-smp-check-that-DRAM-was-kept-before-a-T8132-S2R-wake.patch)
sha256sums=('SKIP' '7c00e3e91d3f53a6e8c2d4898671230f0758284d40d966018509941c3f65e6c2' 'd89f89a68105e4663bdf14bf9d4d70f3fad79538a4c566e8fae73c0b40a9be26'
