From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 21:34:04 +0000
Subject: [PATCH 13/13] tests: stub nvme_init() in the payload host harness

payload_run() now brings ANS up for an inline payload on the T8132, so
the harness that compiles payload.c needs nvme_init() beside its
nvme_shutdown() stub.

Assisted-by: LLM
---
 tests/python/test_m3_defaults_optout.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/tests/python/test_m3_defaults_optout.py b/tests/python/test_m3_defaults_optout.py
index 5eb8027c..c4db3be6 100644
--- a/tests/python/test_m3_defaults_optout.py
+++ b/tests/python/test_m3_defaults_optout.py
@@ -240,6 +240,7 @@ static bool smp_is_alive(int cpu) { return false; }
 static int smp_call_sync0(int cpu, void (*fn)(void)) { return 0; }
 static void do_enable_tso(void) {}
 static bool nvme_shutdown(void) { return true; }
+static bool nvme_init(void) { return true; }
 static bool nvme_keep_running_for_linux;
 static bool nvme_set_sart_var(const char *v) { return true; }
 static int display_configure(const char *s) { printf("DISPLAY %s\n", s); return 0; }
