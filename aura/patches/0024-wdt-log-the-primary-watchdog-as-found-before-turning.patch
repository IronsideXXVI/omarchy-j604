From 3ecf15adce1da300f77fe041666b70438574204e Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 05:20:54 +0000
Subject: [PATCH] wdt: log the primary watchdog as found before turning it off

A boot that stops before Stage 1 turns the primary watchdog off is reset
by whatever the previous stage armed there, and its period is not in the
device tree. Print the control, count and alarm registers (and both
times at the 24 MHz counter rate) right before the write that disables
it, so a good boot's log shows how the firmware left it.

Assisted-by: LLM
---
 src/wdt.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/wdt.c b/src/wdt.c
index b4bf83d0..66f932fc 100644
--- a/src/wdt.c
+++ b/src/wdt.c
@@ -27,6 +27,15 @@ void wdt_disable(void)
     }
 
     printf("Primary WDT register @ 0x%lx\n", wdt_base);
+    /*
+     * Log the watchdog as the previous stage left it, before turning it off: a boot that stops
+     * before this point is reset by that watchdog, and its period is otherwise unknown. The
+     * counter runs at 24 MHz.
+     */
+    u32 ctl = read32(wdt_base + WDT_CTL), count = read32(wdt_base + WDT_COUNT),
+        alarm = read32(wdt_base + WDT_ALARM);
+    printf("Primary WDT as found: CTL=0x%x COUNT=0x%x (%u ms) ALARM=0x%x (%u ms)\n", ctl, count,
+           (u32)(count / 24000), alarm, (u32)(alarm / 24000));
     write32(wdt_base + WDT_CTL, 0);
     printf("Primary WDT disabled\n");
 
