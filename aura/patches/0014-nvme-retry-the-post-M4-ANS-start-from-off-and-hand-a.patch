  * endpoint map is answered as macOS does after a wake (bit 1 added to every part but the last,
  * the last masked by warm_last_mask) and no endpoint is started again.
  */
-static bool rtkit_boot_internal(rtkit_dev_t *rtk, u32 timeout_usec, bool warm, u32 warm_last_mask)
+static bool rtkit_boot_internal(rtkit_dev_t *rtk, u32 timeout_usec, bool warm, u32 warm_last_mask,
+                                u32 hello_usec)
 {
     struct asc_message msg;
 
@@ -694,7 +695,7 @@ static bool rtkit_boot_internal(rtkit_dev_t *rtk, u32 timeout_usec, bool warm, u
         return false;
     }
 
-    if (!asc_recv_timeout(rtk->asc, &msg, USEC_PER_SEC)) {
+    if (!asc_recv_timeout(rtk->asc, &msg, hello_usec)) {
         rtkit_printf("did not receive HELLO\n");
         rtk->no_hello = true;
         return false;
@@ -840,13 +841,26 @@ static bool rtkit_boot_internal(rtkit_dev_t *rtk, u32 timeout_usec, bool warm, u
 
 bool rtkit_boot(rtkit_dev_t *rtk)
 {
-    return rtkit_boot_internal(rtk, 0, false, 0);
+    return rtkit_boot_internal(rtk, 0, false, 0, USEC_PER_SEC);
 }
 
 bool rtkit_boot_warm(rtkit_dev_t *rtk, u32 last_mask)
 {
     rtk->inherited = true;
-    return rtkit_boot_internal(rtk, 2 * USEC_PER_SEC, true, last_mask);
+    return rtkit_boot_internal(rtk, 2 * USEC_PER_SEC, true, last_mask, USEC_PER_SEC);
+}
+
+/*
+ * A retried start: warm as rtkit_boot_warm() or cold as rtkit_boot(), the HELLO waited for up
+ * to hello_usec and the power states for a bounded time. A cold start follows a reset of an
+ * IOP that an idle may have left with its receive side off, so that is turned on as well.
+ */
+bool rtkit_boot_wait(rtkit_dev_t *rtk, bool warm, u32 last_mask, u32 hello_usec)
+{
+    rtk->inherited = warm;
+    if (!warm)
+        asc_i2a_enable(rtk->asc, true);
+    return rtkit_boot_internal(rtk, RTKIT_IOP_POWER_TIMEOUT, warm, last_mask, hello_usec);
 }
 
 /* Boot the IOP, or adopt the session of one a previous stage left running. Such
@@ -877,7 +891,7 @@ bool rtkit_boot_timed(rtkit_dev_t *rtk, u32 timeout_usec)
     }
 
     rtk->timeout_usec = timeout_usec;
-    return rtkit_boot_internal(rtk, timeout_usec, false, 0);
+    return rtkit_boot_internal(rtk, timeout_usec, false, 0, USEC_PER_SEC);
 }
 
 u32 rtkit_get_timeout(rtkit_dev_t *rtk)
