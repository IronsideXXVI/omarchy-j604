diff --git a/src/nvme.c b/src/nvme.c
index 0a34ef10..d873a37c 100644
--- a/src/nvme.c
+++ b/src/nvme.c
@@ -470,18 +470,74 @@ static bool nvme_ans_power_off(void)
     return true;
 }
 
-/* Post-M4, ANS off: power, the SART entries back, then the firmware's start after a power loss. */
-static bool nvme_ans_power_on(void)
+/*
+ * Post-M4, ANS off: power, the SART entries back, then the firmware's start after a power loss.
+ * The first try is that warm start with the 1 s HELLO wait every good start met. It depends on
+ * the state the last owner left: a J604 Stage 2 after a warm reboot found the controller fatal
+ * (CSTS.CFS) with the CPU stopped, got no HELLO, and ANS stayed down until a power cycle. So a
+ * failed try is undone completely (CPU stopped, its mail dropped, power off) and tried again
+ * with longer waits; the last try on the T8132 also resets ANS through PMGR and boots it cold,
+ * as Linux's apple,t8132-nvme-ans2 entry (cold_reset) does with a stopped ANS.
+ */
+#define NVME_ANS_START_TRIES     3
+#define NVME_ANS_RETRY_WAIT_USEC (3 * USEC_PER_SEC)
+
+static void nvme_ans_log_state(const char *when)
 {
-    if (pcie_ans_power_on() || !sart_set_entries(nvme_sart, nvme_sart_saved, nvme_sart_saved_cnt) ||
-        !rtkit_boot_warm(nvme_rtkit, BIT(0)) ||
-        poll32(nvme_base + NVME_BOOT_STATUS, 0xffffffff, NVME_BOOT_STATUS_OK, USEC_PER_SEC) < 0) {
-        printf("nvme: ANS didn't start from off; it stays down until a reboot\n");
+    printf("nvme: %s: RUN=%d CC=0x%x CSTS=0x%x BOOT_STATUS=0x%x\n", when, asc_cpu_running(nvme_asc),
+           read32(nvme_base + NVME_CC), read32(nvme_base + NVME_CSTS),
+           read32(nvme_base + NVME_BOOT_STATUS));
+}
+
+static bool nvme_ans_start(int try)
+{
+    bool cold = try == NVME_ANS_START_TRIES - 1 && chip_id == T8132;
+    u32 wait = try ? NVME_ANS_RETRY_WAIT_USEC : USEC_PER_SEC;
+
+    if (try) {
+        nvme_ans_log_state("start failed");
+        if (nvme_rtkit) {
+            /* A failed handshake can own buffers: rtkit_free() keeps those, and they stay. */
+            rtkit_stop(nvme_rtkit);
+            rtkit_free(nvme_rtkit);
+            nvme_rtkit = NULL;
+        } else {
+            asc_cpu_stop(nvme_asc);
+        }
+        if (pcie_ans_power_off())
+            printf("nvme: couldn't power ANS off before try %d\n", try + 1);
+        printf("nvme: ANS start try %d of %d%s\n", try + 1, NVME_ANS_START_TRIES,
+               cold ? ", cold after a reset" : "");
+    }
+    if (pcie_ans_power_on())
         return false;
+    if (cold) {
+        /* Linux's ps_ans; the ADT may call the device ANS2. */
+        pmgr_reset(nvme_die, "ANS");
+        pmgr_reset(nvme_die, "ANS2");
     }
-    nvme_boot_ticks = get_ticks();
-    printf("nvme: ANS started from off\n");
-    return true;
+    if (!sart_set_entries(nvme_sart, nvme_sart_saved, nvme_sart_saved_cnt))
+        return false;
+    if (!nvme_rtkit && !(nvme_rtkit = rtkit_init("nvme", nvme_asc, NULL, NULL, nvme_sart, false)))
+        return false;
+    if (!(try ? rtkit_boot_wait(nvme_rtkit, !cold, BIT(0), wait)
+              : rtkit_boot_warm(nvme_rtkit, BIT(0))))
+        return false;
+    return poll32(nvme_base + NVME_BOOT_STATUS, 0xffffffff, NVME_BOOT_STATUS_OK, wait) >= 0;
+}
+
+static bool nvme_ans_power_on(void)
+{
+    for (int try = 0; try < NVME_ANS_START_TRIES; try++) {
+        if (nvme_ans_start(try)) {
+            nvme_boot_ticks = get_ticks();
+            printf("nvme: ANS started from off%s\n", try ? " on a retry" : "");
+            return true;
+        }
+    }
+    nvme_ans_log_state("start failed");
+    printf("nvme: ANS didn't start from off; it stays down until a reboot\n");
+    return false;
 }
 
 /* A write or flush, timed: the Stage 1 log then shows how close a marker spend came. */
@@ -814,6 +870,33 @@ out_preserve:
     return false;
 }
 
+/*
+ * After a failed nvme_init() on a post-M4 ANS: whether the payload can still adopt the session
+ * as U-Boot's driver does (apple_nvme_adopt(): CPU running, BOOT_STATUS ok, no CFS). Only a
+ * completed controller disable fences this stage's queues, so it is done here first; then
+ * nothing of this stage's is left for ANS to reach and the session is the payload's.
+ */
+bool nvme_hand_over_for_adoption(void)
+{
+    if (nvme_initialized || nvme_type != NVME_T8132 || nvme_secure_regs || !nvme_asc ||
+        !nvme_base || !asc_cpu_running(nvme_asc) ||
+        read32(nvme_base + NVME_BOOT_STATUS) != NVME_BOOT_STATUS_OK ||
+        (read32(nvme_base + NVME_CSTS) & NVME_CSTS_CFS)) {
+        printf("nvme: no running ANS session to hand over\n");
+        return false;
+    }
+    write64_lo_hi(nvme_qreg(NVME_IOQ_CMDS), 0);
+    write64_lo_hi(nvme_qreg(NVME_IOQ_CQES), 0);
+    if (!nvme_ctrl_disable()) {
+        printf("nvme: controller didn't disable; not handing ANS over\n");
+        return false;
+    }
+    /* The queues stay allocated: ANS no longer reaches them, and the heap is reserved anyway. */
+    nvme_reboot_required = false;
+    printf("nvme: controller disabled; the payload adopts the running ANS session\n");
+    return true;
+}
+
 void nvme_ensure_shutdown(void)
 {
     if (nvme_post_m4()) {
