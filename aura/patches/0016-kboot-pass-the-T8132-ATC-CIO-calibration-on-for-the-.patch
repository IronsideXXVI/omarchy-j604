From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 20:20:57 +0000
Subject: [PATCH 16/17] kboot: pass the T8132 ATC CIO calibration on for the
 J604

Linux serves a USB4 or Thunderbolt connection only once its Type-C PHY
has the CIO calibration. Stage 2 passes the SuperSpeed lists on, but not
the CIO ones, so a USB4 plug comes up as USB2 only.

Copy the CIO lists from this machine's ADT into the ten
apple,tunable-cio-* properties, in the banks the Linux driver applies
them to, all of them or none. A board DT copy stays in place when the
ADT lacks a list. The offsets match the J713 DT entry for entry, and the
per-PHY calibration words come from each machine's own ADT.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 src/kboot_atc.c | 69 +++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 69 insertions(+)

diff --git a/src/kboot_atc.c b/src/kboot_atc.c
index a8ab9d94..7e7cd711 100644
--- a/src/kboot_atc.c
+++ b/src/kboot_atc.c
@@ -182,6 +182,39 @@ static const struct adt_tunable_info atc_tunables_t8132_usb3[] = {
     {"tunable_LN1_TX_SHM_USB_DFLT", "apple,tunable-lane1-usb", 0x14000, 0x1000, true},
 };
 
+/*
+ * T8132 CIO (USB4/Thunderbolt) calibration, in the PHY banks the Linux driver
+ * applies it to (apple,tunable-cio-*). The offsets match the J713 DT entry for
+ * entry; the values are each machine's own.
+ */
+static const struct adt_tunable_info atc_tunables_t8132_cio[] = {
+    {"tunable_ATCAXI2AF", "apple,tunable-cio-axi2af", 0, 0x8000, true},
+    {"tunable_ATCAXI2AF_WR_DIS", "apple,tunable-cio-axi2af", 0, 0x8000, true},
+    {"tunable_ATCAXI2AF_LOCK_LOCK", "apple,tunable-cio-axi2af", 0, 0x8000, true},
+    {"tunable_ATCAXI2AF_LIOA_IOA", "apple,tunable-cio-lioa", 0, 0x4000, true},
+    {"tunable_ATC_FABRIC", "apple,tunable-cio-fabric", 0, 0x4000, true},
+    {"tunable_ATC_COMMON_CFG", "apple,tunable-cio-config", 0, 0x4000, true},
+    {"tunable_AUSCMN_DIG", "apple,tunable-cio-common", 0x800, 0x200, true},
+    {"tunable_AUSPLL_CORE", "apple,tunable-cio-common", 0x2200, 0x4000, true},
+    {"tunable_CIO3PLL_CORE", "apple,tunable-cio-common", 0x2a00, 0x200, true},
+    {"tunable_CIO3PLL_TOP", "apple,tunable-cio-common", 0x2800, 0x200, true},
+    {"tunable_ACIOPHY_PLL_TOP", "apple,tunable-cio-common", 0x1000, 0x4000, true},
+    {"tunable_CIO_SHIM", "apple,tunable-cio-common", 0x4000, 0x4000, true},
+    {"tunable_ACIOPHY_TOP", "apple,tunable-cio-common", 0, 0x4000, true},
+    {"tunable_LN0_RX_TOP_CIO_DFLT", "apple,tunable-cio-lane0", 0x9000, 0x1000, true},
+    {"tunable_LN0_RX_SHM_CIO_DFLT", "apple,tunable-cio-lane0", 0xb000, 0x1000, true},
+    {"tunable_LN0_TX_TOP_CIO_DFLT", "apple,tunable-cio-lane0", 0xc000, 0x1000, true},
+    {"tunable_LN0_TX_SHM_CIO_DFLT", "apple,tunable-cio-lane0", 0xd000, 0x1000, true},
+    {"tunable_LN0_RX_EQ_CIO_EQA", "apple,tunable-cio-lane0-eq", 0xa000, 0x1000, true},
+    {"tunable_LN1_RX_TOP_CIO_DFLT", "apple,tunable-cio-lane1", 0x10000, 0x1000, true},
+    {"tunable_LN1_RX_SHM_CIO_DFLT", "apple,tunable-cio-lane1", 0x12000, 0x1000, true},
+    {"tunable_LN1_TX_TOP_CIO_DFLT", "apple,tunable-cio-lane1", 0x13000, 0x1000, true},
+    {"tunable_LN1_TX_SHM_CIO_DFLT", "apple,tunable-cio-lane1", 0x14000, 0x1000, true},
+    {"tunable_LN1_RX_EQ_CIO_EQA", "apple,tunable-cio-lane1-eq", 0x11000, 0x1000, true},
+    {"tunable_AUSCMN_SHM", "apple,tunable-cio-post", 0xa00, 0x200, true},
+    {"tunable_CLKMON_CFG", "apple,tunable-cio-post", 0x2600, 0x100, true},
+};
+
 /* Optional for USB3-only: the USB half of multifunction mode also needs AUX. */
 static const struct adt_tunable_info atc_tunable_t8132_usb3_dp = {
     "tunable_AUX_TOP", "apple,tunable-usb3-dp", 0x16000, 0x4000, true,
@@ -847,6 +880,40 @@ cleanup:
     printf("FDT: T8132 USB3 calibration incomplete; preserving USB2 fallback\n");
 }
 
+/*
+ * Publish the T8132 CIO calibration from this machine's ADT, all of it or
+ * none: the PHY serves USB4/Thunderbolt only with the complete set. A board
+ * DT may carry a fallback copy; it is replaced only when every ADT list is
+ * present. A malformed list drops the whole set, so the PHY falls back to
+ * USB2 rather than run a partial calibration.
+ */
+static void dt_copy_t8132_cio_tunables(void *dt, int adt_node, int fdt_node)
+{
+    for (size_t i = 0; i < ARRAY_SIZE(atc_tunables_t8132_cio); i++) {
+        u32 len;
+        const void *raw = adt_getprop(adt, adt_node, atc_tunables_t8132_cio[i].adt_name, &len);
+
+        if (!raw || !len || len % 12) {
+            printf("FDT: T8132 CIO calibration not in the ADT (%s); keeping the DT's\n",
+                   atc_tunables_t8132_cio[i].adt_name);
+            return;
+        }
+    }
+
+    for (size_t i = 0; i < ARRAY_SIZE(atc_tunables_t8132_cio); i++)
+        fdt_delprop(dt, fdt_node, atc_tunables_t8132_cio[i].fdt_name);
+
+    for (size_t i = 0; i < ARRAY_SIZE(atc_tunables_t8132_cio); i++) {
+        if (dt_append_atc_tunable(dt, adt_node, fdt_node, &atc_tunables_t8132_cio[i])) {
+            for (size_t j = 0; j < ARRAY_SIZE(atc_tunables_t8132_cio); j++)
+                fdt_delprop(dt, fdt_node, atc_tunables_t8132_cio[j].fdt_name);
+            printf("FDT: T8132 CIO calibration malformed; USB4/Thunderbolt serves as USB2\n");
+            return;
+        }
+    }
+    printf("FDT: Copied T8132 CIO calibration\n");
+}
+
 static void dt_copy_atc_tunables(void *dt, const char *adt_path, const char *dt_alias, int port)
 {
     int ret;
@@ -878,6 +945,8 @@ static void dt_copy_atc_tunables(void *dt, const char *adt_path, const char *dt_
         !fdt_node_check_compatible(dt, fdt_node, "apple,t8132-atcphy") &&
         adt_is_compatible_at(adt, adt_node, "atc-phy,t8132", 0)) {
         dt_copy_t8132_usb3_tunables(dt, adt_node, fdt_node);
+        if (!fdt_node_check_compatible(dt, 0, "apple,j604"))
+            dt_copy_t8132_cio_tunables(dt, adt_node, fdt_node);
         return;
     }
 
