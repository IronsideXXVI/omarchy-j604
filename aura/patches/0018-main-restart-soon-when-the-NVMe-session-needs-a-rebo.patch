From 41c4dbfe04f4ab31c6dc0d8c4afd0018305d1384 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 09:35:17 +0000
Subject: [PATCH 18/21] main: restart soon when the NVMe session needs a reboot

A Stage 1 that cannot read its Stage 2 because its NVMe session failed
(nvme_io_failed()) cannot recover without a reboot, yet it waits the
whole 178 s boot watchdog period for a host. Restart the boot watchdog's
count with 20 s instead. It stays the boot watchdog, so a host that syncs
in time still disarms it.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 src/main.c | 13 +++++++++++--
 src/wdt.c  | 17 +++++++++++++++++
 src/wdt.h  |  3 +++
 3 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/src/main.c b/src/main.c
index 6017d368..e85ae886 100644
--- a/src/main.c
+++ b/src/main.c
@@ -285,9 +285,18 @@ void run_actions(void)
                "  Check that the file this Stage 1 names exists on its EFI partition.\n"
                "  Hold the power button to shut down, then hold it again to choose another "
                "system.\n");
-    if (stage1_config_target() && wdt_boot_watchdog_armed())
+    if (stage1_config_target() && wdt_boot_watchdog_armed()) {
+        /*
+         * A failed NVMe session stays failed until a reboot (nvme.c), so no host action short of
+         * one reads the Stage 2 either: restart soon instead of after the whole boot watchdog
+         * period. A host still gets the time to attach, and its sync disarms the watchdog.
+         */
+        unsigned restart_s = WDT_BOOT_SECONDS;
+        if (nvme_io_failed() && !wdt_boot_watchdog_shorten(WDT_NVME_RESTART_SECONDS))
+            restart_s = WDT_NVME_RESTART_SECONDS;
         printf("  Without a host, this Mac restarts by itself within %u s to try again.\n",
-               WDT_BOOT_SECONDS);
+               restart_s);
+    }
 
     if (payload_action == STAGE1_PAYLOAD_HALT)
         panic("Stage 1: no safe proxy carrier after CDC failure\n");
diff --git a/src/wdt.c b/src/wdt.c
index 798c3914..c46d43e9 100644
--- a/src/wdt.c
+++ b/src/wdt.c
@@ -156,6 +156,23 @@ bool wdt_boot_watchdog_armed(void)
     return wdt_boot_armed;
 }
 
+/*
+ * Restart the armed boot watchdog's count with a shorter period. It stays the boot watchdog: a
+ * host that syncs in the meantime still disarms it.
+ */
+int wdt_boot_watchdog_shorten(unsigned seconds)
+{
+    if (!wdt_boot_armed || seconds >= WDT_BOOT_SECONDS)
+        return -1;
+    if (wdt_arm(seconds)) {
+        /* wdt_arm() stops the count before it writes the new period: arm the old one again. */
+        if (wdt_arm(WDT_BOOT_SECONDS))
+            wdt_boot_armed = false;
+        return -1;
+    }
+    return 0;
+}
+
 /* Only the boot watchdog: a trial's or a host-armed one is not ours to disarm. */
 void wdt_host_attached(void)
 {
diff --git a/src/wdt.h b/src/wdt.h
index ffa9a0d7..fc5b8bfb 100644
--- a/src/wdt.h
+++ b/src/wdt.h
@@ -24,6 +24,9 @@ void wdt_host_attached(void);
 #define WDT_S2R_DRAM_LOST_SECONDS 20
 #define WDT_S2R_MALFORMED_SECONDS 30
 void wdt_s2r_wake_mark(unsigned seconds);
+/* A stage that can no longer boot (its NVMe session needs a reboot) restarts this much sooner */
+#define WDT_NVME_RESTART_SECONDS 20
+int wdt_boot_watchdog_shorten(unsigned seconds);
 bool wdt_boot_watchdog_armed(void);
 
 #endif
