@@ -5414,6 +5417,162 @@ static void dt_reserve_j713_dcpext(void)
     }
 }
 
+/*
+ * One-tree T8132 boards (the J604): the kernel boots with the device tree m1n1 completes, in
+ * which an external DCP and the nodes it consumes are disabled until it is handed over. Enable
+ * a disabled node; one that is already enabled is left as it is.
+ */
+static int dt_enable_dcpext_one_node(int node)
+{
+    int len = 0;
+    const char *status = fdt_getprop(dt, node, "status", &len);
+
+    if (!status || (len == sizeof("okay") && !strcmp(status, "okay")))
+        return 0;
+    if (len != sizeof("disabled") || strcmp(status, "disabled"))
+        return -1;
+    return fdt_setprop_string(dt, node, "status", "okay") ? -1 : 0;
+}
+
+/*
+ * Enable the power-domain chain of a node: every domain must be a firmware-owned PMGR state with
+ * #power-domain-cells = <0>, so the kernel registers it without reading or writing it.
+ */
+static int dt_enable_dcpext_domains(int node, unsigned int depth)
+{
+    int len = 0;
+    const fdt32_t *pd = fdt_getprop(dt, node, "power-domains", &len);
+
+    if (!pd)
+        return 0;
+    if (depth > 4 || len <= 0 || len % 4)
+        return -1;
+    for (int i = 0; i < len / 4; i++) {
+        uint32_t phandle = fdt32_ld(&pd[i]);
+        int target = fdt_node_offset_by_phandle(dt, phandle);
+        int clen = 0;
+        const fdt32_t *cells =
+            target < 0 ? NULL : fdt_getprop(dt, target, "#power-domain-cells", &clen);
+
+        if (!cells || clen != 4 || fdt32_ld(cells) != 0 ||
+            !fdt_getprop(dt, target, "apple,firmware-owned", NULL) ||
+            dt_enable_dcpext_one_node(target))
+            return -1;
+        /* Offsets move when a property shrinks: look the target up again by phandle. */
+        target = fdt_node_offset_by_phandle(dt, phandle);
+        if (target < 0 || dt_enable_dcpext_domains(target, depth + 1))
+            return -1;
+        pd = fdt_getprop(dt, node, "power-domains", &len);
+        if (!pd)
+            return -1;
+    }
+    return 0;
+}
+
+/* Enable the node a property's first phandle names (mboxes, iommus), with its domains. */
+static int dt_enable_dcpext_ref(const char *path, const char *prop)
+{
+    int node = fdt_path_offset(dt, path);
+    int len = 0;
+    const fdt32_t *ref = node < 0 ? NULL : fdt_getprop(dt, node, prop, &len);
+
+    if (!ref || len < 4)
+        return -1;
+    uint32_t phandle = fdt32_ld(ref);
+    int target = fdt_node_offset_by_phandle(dt, phandle);
+    if (target < 0 || dt_enable_dcpext_one_node(target))
+        return -1;
+    target = fdt_node_offset_by_phandle(dt, phandle);
+    return target < 0 ? -1 : dt_enable_dcpext_domains(target, 0);
+}
+
+/*
+ * The Type-C display routes of a handed-over dcpext: each route the tree describes as
+ * "disabled" is enabled. A route with any other status (reserved, failed, malformed) is left as
+ * it is, and a dcpext without routes has nothing to enable. The kernel tree keeps the routes
+ * disabled because a USB-C port controller waits for every available route's mode switch; the
+ * dcpext registers them once it is adopted, and disables them again in the live tree if it
+ * cannot.
+ */
+static int dt_enable_dcpext_routes(const char *alias)
+{
+    int node = fdt_path_offset(dt, alias);
+    int routes = node < 0 ? node : fdt_subnode_offset(dt, node, "typec-routes");
+    int route;
+
+    if (routes == -FDT_ERR_NOTFOUND)
+        return 0;
+    if (routes < 0)
+        return -1;
+    fdt_for_each_subnode(route, dt, routes)
+    {
+        int len = 0;
+        const char *status = fdt_getprop(dt, route, "status", &len);
+
+        if (!status || len != sizeof("disabled") || memcmp(status, "disabled", len))
+            continue;
+        /* Only what follows this route moves; the walk goes on from its offset. */
+        if (fdt_setprop_string(dt, route, "status", "okay"))
+            return -1;
+    }
+    return route == -FDT_ERR_NOTFOUND ? 0 : -1;
+}
+
+/*
+ * A handed-over dcpext (marker set by dt_reserve_j713_dcpext()): enable its mailbox, its
+ * firmware DART, its display DART (named by its piodma child, which stays disabled: the kernel
+ * enables PIODMA at runtime) and the dcpext itself, each with its firmware-owned PMGR domains,
+ * and its Type-C display routes (dt_enable_dcpext_routes()).
+ */
+static int dt_enable_j604_dcpext_one(unsigned int n)
+{
+    if (n >= ARRAY_SIZE(dcpext_aliases))
+        return -1;
+    const char *alias = dcpext_aliases[n];
+    int node = fdt_path_offset(dt, alias);
+    char piodma[64];
+
+    if (node < 0 || fdt_get_path(dt, node, piodma, sizeof(piodma) - sizeof("/piodma")))
+        return -1;
+    size_t plen = strlen(piodma);
+    memcpy(piodma + plen, "/piodma", sizeof("/piodma"));
+    if (dt_enable_dcpext_ref(alias, "mboxes") || dt_enable_dcpext_ref(alias, "iommus") ||
+        dt_enable_dcpext_ref(piodma, "iommus"))
+        return -1;
+    node = fdt_path_offset(dt, alias);
+    if (node < 0 || dt_enable_dcpext_one_node(node))
+        return -1;
+    node = fdt_path_offset(dt, alias);
+    if (node < 0 || dt_enable_dcpext_domains(node, 0))
+        return -1;
+    return dt_enable_dcpext_routes(alias);
+}
+
+static void dt_enable_j604_dcpext(void)
+{
+    if (!t8132_board_admitted(dt, T8132_PATH_DCPEXT_ENABLE))
+        return;
+    for (size_t n = 0; n < ARRAY_SIZE(dcpext_aliases); n++) {
+        const char *alias = dcpext_aliases[n];
+        int node = fdt_path_offset(dt, alias);
+        int len = 0;
+        const fdt32_t *ready =
+            node < 0 ? NULL : fdt_getprop(dt, node, T8132_DCPEXT_READY, &len);
+
+        if (!ready || len != 4 || fdt32_ld(ready) != 1)
+            continue;
+        if (!dt_display_transaction(dt_enable_j604_dcpext_one, n)) {
+            printf("FDT: '%s' and its mailbox, DARTs and domains enabled for the kernel\n", alias);
+            continue;
+        }
+        /* Not enabled: withdraw the marker, so the kernel gate stays closed. */
+        node = fdt_path_offset(dt, alias);
+        if (node >= 0)
+            fdt_delprop(dt, node, T8132_DCPEXT_READY);
+        printf("FDT: '%s' nodes could not be enabled; kernel gate remains closed\n", alias);
+    }
+}
+
 /*
  * T8122: reserve the external DCP firmware for the kernel's gate only with the boot.bin config
  * line chosen.asahi,t8122-dcpext=1, and only when the internal display was handed over
@@ -8029,8 +8188,10 @@ static int dt_set_display(void)
     if (chip_id == T8132) {
         if (dt_set_m4_dcp_handoff())
             printf("FDT: M4 DCP handoff refused; keeping the boot framebuffer\n");
-        else
+        else {
             dt_reserve_j713_dcpext();
+            dt_enable_j604_dcpext();
+        }
         return 0;
     }
 
diff --git a/tests/python/test_j604_dcpext_enable.py b/tests/python/test_j604_dcpext_enable.py
new file mode 100644
index 00000000..c7c06c5d
--- /dev/null
+++ b/tests/python/test_j604_dcpext_enable.py
@@ -0,0 +1,241 @@
+# SPDX-License-Identifier: MIT
+"""J604: a handed-over external DCP is enabled with the nodes it consumes, and only then."""
+
+from pathlib import Path
+from test_siliconforest_handoff import run_c
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def test_j604_dcpext_enable(tmp_path):
+    kboot = (ROOT / "src/kboot.c").read_text()
+
+    def function(name, kind):
+        start = kboot.index(kind + name + "(")
+        return kboot[start:kboot.index("\n}\n", start) + 3]
+
+    start = kboot.index("static const char dcpext_aliases")
+    aliases = kboot[start:kboot.index("\n};", start) + 3]
+    board = "\n".join(line for line in (ROOT / "src/t8132_board.h").read_text().splitlines()
+                      if not line.startswith("#include"))
+    code = "\n".join([
+        aliases,
+        function("dt_display_transaction", "static int "),
+        function("dt_enable_dcpext_one_node", "static int "),
+        function("dt_enable_dcpext_domains", "static int "),
+        function("dt_enable_dcpext_ref", "static int "),
+        function("dt_enable_dcpext_routes", "static int "),
+        function("dt_enable_j604_dcpext_one", "static int "),
+        function("dt_enable_j604_dcpext", "static void "),
+    ])
+    run_c(tmp_path, "j604-dcpext-enable", r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "libfdt.h"
+#define ARRAY_SIZE(x) (sizeof(x) / sizeof((x)[0]))
+#define T8132_DCPEXT_READY "apple,t8132-dcpext-firmware-ready"
+static void *dt;
+''' + board + "\n" + code + r'''
+static char buf[16384];
+static bool okay(const char *path);
+
+static int sub(int parent, const char *name, uint32_t phandle, bool disabled)
+{
+    int n = fdt_add_subnode(dt, parent, name);
+    assert(n >= 0);
+    if (phandle)
+        assert(!fdt_setprop_u32(dt, n, "phandle", phandle));
+    if (disabled)
+        assert(!fdt_setprop_string(dt, n, "status", "disabled"));
+    return n;
+}
+
+static int at(const char *path) { int n = fdt_path_offset(dt, path); assert(n >= 0); return n; }
+
+static void pd(const char *path, uint32_t parent, bool owned)
+{
+    int n = at(path);
+    assert(!fdt_setprop_u32(dt, n, "#power-domain-cells", 0));
+    if (owned)
+        assert(!fdt_setprop_empty(dt, n, "apple,firmware-owned"));
+    if (parent)
+        assert(!fdt_setprop_u32(dt, at(path), "power-domains", parent));
+}
+
+/* Two dcpexts in the J604 kernel tree's layout, every node disabled. */
+static void tree(const char *compatible, int len, bool owned_cpu1)
+{
+    dt = buf;
+    assert(!fdt_create_empty_tree(dt, sizeof(buf)));
+    assert(!fdt_setprop(dt, 0, "compatible", compatible, len));
+    int al = sub(0, "aliases", 0, false);
+    assert(!fdt_setprop_string(dt, al, "dcpext0", "/soc/dcp@286e00000"));
+    assert(!fdt_setprop_string(dt, at("/aliases"), "dcpext1", "/soc/dcp@48ae00000"));
+    int soc = sub(0, "soc", 0, false);
+    (void)soc;
+    for (int i = 0; i < 2; i++) {
+        uint32_t b = 10 * (i + 1);
+        char p[64];
+        const char *pmgr[] = {"sys", "fe", "cpu"};
+        for (int j = 0; j < 3; j++) {
+            snprintf(p, sizeof(p), "ps_dispext%d_%s", i, pmgr[j]);
+            sub(at("/soc"), p, b + 1 + j, true);
+            snprintf(p, sizeof(p), "/soc/ps_dispext%d_%s", i, pmgr[j]);
+            pd(p, j ? b + j : 0, !(i == 1 && j == 2 && !owned_cpu1));
+        }
+        snprintf(p, sizeof(p), "mailbox%d", i);
+        sub(at("/soc"), p, b + 4, true);
+        snprintf(p, sizeof(p), "/soc/mailbox%d", i);
+        assert(!fdt_setprop_u32(dt, at(p), "power-domains", b + 3));
+        snprintf(p, sizeof(p), "dart-dcpext%d", i);
+        sub(at("/soc"), p, b + 5, true);
+        snprintf(p, sizeof(p), "/soc/dart-dcpext%d", i);
+        assert(!fdt_setprop_u32(dt, at(p), "power-domains", b + 3));
+        snprintf(p, sizeof(p), "dart-dispext%d", i);
+        sub(at("/soc"), p, b + 6, true);
+        snprintf(p, sizeof(p), "/soc/dart-dispext%d", i);
+        assert(!fdt_setprop_u32(dt, at(p), "power-domains", b + 3));
+        snprintf(p, sizeof(p), i ? "dcp@48ae00000" : "dcp@286e00000");
+        int d = sub(at("/soc"), p, b + 7, true);
+        snprintf(p, sizeof(p), i ? "/soc/dcp@48ae00000" : "/soc/dcp@286e00000");
+        d = at(p);
+        assert(!fdt_setprop_string(dt, d, "compatible", "apple,t8132-dcpext"));
+        assert(!fdt_setprop_u32(dt, at(p), "mboxes", b + 4));
+        uint32_t iommu[2] = {cpu_to_fdt32(b + 5), cpu_to_fdt32(23)};
+        assert(!fdt_setprop(dt, at(p), "iommus", iommu, sizeof(iommu)));
+        assert(!fdt_setprop_u32(dt, at(p), "power-domains", b + 3));
+        sub(at(p), "piodma", 0, true);
+        char q[80];
+        snprintf(q, sizeof(q), "%s/piodma", p);
+        uint32_t pio[2] = {cpu_to_fdt32(b + 6), cpu_to_fdt32(16)};
+        assert(!fdt_setprop(dt, at(q), "iommus", pio, sizeof(pio)));
+        /* Its three Type-C routes, disabled as in the kernel tree. */
+        sub(at(p), "typec-routes", 0, false);
+        snprintf(q, sizeof(q), "%s/typec-routes", p);
+        for (int r = 0; r < 3; r++) {
+            char name[16];
+            snprintf(name, sizeof(name), "route@%d", r);
+            sub(at(q), name, 0, true);
+        }
+    }
+}
+
+static bool route_okay(int dcp, int r)
+{
+    char p[80];
+    snprintf(p, sizeof(p), "%s/typec-routes/route@%d",
+             dcp ? "/soc/dcp@48ae00000" : "/soc/dcp@286e00000", r);
+    return okay(p);
+}
+
+static void routes(int dcp, bool want)
+{
+    for (int r = 0; r < 3; r++)
+        assert(route_okay(dcp, r) == want);
+}
+
+static bool okay(const char *path)
+{
+    const char *s = fdt_getprop(dt, at(path), "status", NULL);
+    return !s || !strcmp(s, "okay");
+}
+
+static void mark(const char *path, uint32_t v)
+{
+    assert(!fdt_setprop_u32(dt, at(path), T8132_DCPEXT_READY, v));
+}
+
+static bool marked(const char *path) { return fdt_getprop(dt, at(path), T8132_DCPEXT_READY, NULL); }
+
+static const char *const set0[] = {"/soc/dcp@286e00000", "/soc/mailbox0", "/soc/dart-dcpext0",
+                                   "/soc/dart-dispext0", "/soc/ps_dispext0_cpu",
+                                   "/soc/ps_dispext0_fe", "/soc/ps_dispext0_sys"};
+static const char *const set1[] = {"/soc/dcp@48ae00000", "/soc/mailbox1", "/soc/dart-dcpext1",
+                                   "/soc/dart-dispext1", "/soc/ps_dispext1_cpu",
+                                   "/soc/ps_dispext1_fe", "/soc/ps_dispext1_sys"};
+
+static void all(const char *const *set, bool want)
+{
+    for (int i = 0; i < 7; i++)
+        assert(okay(set[i]) == want);
+}
+
+#define J604 "apple,j604\0apple,t8132\0apple,arm-platform"
+#define J713 "apple,j713\0apple,t8132\0apple,arm-platform"
+
+int main(void)
+{
+    /* Marked dcpext0: it, its mailbox, both DARTs and its domains; piodma and dcpext1 stay off. */
+    tree(J604, sizeof(J604), true);
+    mark("/soc/dcp@286e00000", 1);
+    dt_enable_j604_dcpext();
+    all(set0, true);
+    all(set1, false);
+    assert(!okay("/soc/dcp@286e00000/piodma"));
+    assert(marked("/soc/dcp@286e00000"));
+    /* Its Type-C routes come with it; dcpext1's stay off. */
+    routes(0, true);
+    routes(1, false);
+
+    /* A route with another status is left as it is; the others are enabled. */
+    tree(J604, sizeof(J604), true);
+    assert(!fdt_setprop_string(dt, at("/soc/dcp@286e00000/typec-routes/route@1"), "status",
+                               "reserved"));
+    mark("/soc/dcp@286e00000", 1);
+    dt_enable_j604_dcpext();
+    all(set0, true);
+    assert(route_okay(0, 0) && route_okay(0, 2));
+    assert(!strcmp(fdt_getprop(dt, at("/soc/dcp@286e00000/typec-routes/route@1"), "status",
+                               NULL), "reserved"));
+
+    /* A dcpext without routes is enabled as before. */
+    tree(J604, sizeof(J604), true);
+    assert(!fdt_del_node(dt, at("/soc/dcp@286e00000/typec-routes")));
+    mark("/soc/dcp@286e00000", 1);
+    dt_enable_j604_dcpext();
+    all(set0, true);
+
+    /* Both marked: both enabled. */
+    tree(J604, sizeof(J604), true);
+    mark("/soc/dcp@286e00000", 1);
+    mark("/soc/dcp@48ae00000", 1);
+    dt_enable_j604_dcpext();
+    all(set0, true);
+    all(set1, true);
+
+    /* A domain that is not firmware-owned: dcpext1 is left as it was, its marker withdrawn. */
+    tree(J604, sizeof(J604), false);
+    mark("/soc/dcp@286e00000", 1);
+    mark("/soc/dcp@48ae00000", 1);
+    dt_enable_j604_dcpext();
+    all(set0, true);
+    all(set1, false);
+    assert(!marked("/soc/dcp@48ae00000"));
+    assert(marked("/soc/dcp@286e00000"));
+    /* The failed one's routes stay off with it: the port controllers do not wait for it. */
+    routes(0, true);
+    routes(1, false);
+
+    /* No marker, or a marker other than 1: nothing changes. */
+    tree(J604, sizeof(J604), true);
+    mark("/soc/dcp@48ae00000", 0);
+    dt_enable_j604_dcpext();
+    all(set0, false);
+    all(set1, false);
+    routes(0, false);
+    routes(1, false);
+
+    /* The J713 (U-Boot imports its handoff): never enabled by m1n1. */
+    tree(J713, sizeof(J713), true);
+    mark("/soc/dcp@286e00000", 1);
+    dt_enable_j604_dcpext();
