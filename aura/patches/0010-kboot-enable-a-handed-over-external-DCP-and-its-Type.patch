--- a/src/kboot.c
+++ b/src/kboot.c
@@ -5359,7 +5359,7 @@ static bool dt_j713_dcpext_powered(const char *alias)
 }
 
 /*
- * J713: iBoot starts both external DCPs and leaves them quiesced, as it does the internal one,
+ * J713 and J604: iBoot starts both external DCPs and leaves them quiesced, as it does the internal one,
