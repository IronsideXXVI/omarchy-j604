diff --git a/omarchy-mac-boot/files/usr/lib/omarchy/mac-first-boot/omarchy-mac-first-boot b/omarchy-mac-boot/files/usr/lib/omarchy/mac-first-boot/omarchy-mac-first-boot
index 0056a5a..e8a3a41 100755
--- a/omarchy-mac-boot/files/usr/lib/omarchy/mac-first-boot/omarchy-mac-first-boot
+++ b/omarchy-mac-boot/files/usr/lib/omarchy/mac-first-boot/omarchy-mac-first-boot
@@ -178,6 +178,9 @@ make_keyring() {
   rm -rf "$keyring_dir"
   local -a keyrings=(archlinuxarm asahi-alarm)
   [[ ! -f $keyring_import_dir/omarchy.gpg ]] || keyrings+=(omarchy)
+  # J604 local build: the private [j604] repository keyring that j604-keyring
+  # ships beside the release keyrings, populated the same way.
+  [[ ! -f $keyring_import_dir/j604.gpg ]] || keyrings+=(j604)
   pacman-key --gpgdir "$keyring_dir" --init >>"$log_file" 2>&1 &&
     pacman-key --gpgdir "$keyring_dir" --populate-from "$keyring_import_dir" --populate "${keyrings[@]}" \
       >>"$log_file" 2>&1 || fail "could not create the package keyring"
diff --git a/omarchy-mac-boot/test/mac-first-boot-test.sh b/omarchy-mac-boot/test/mac-first-boot-test.sh
index 6867d95..c714523 100644
--- a/omarchy-mac-boot/test/mac-first-boot-test.sh
+++ b/omarchy-mac-boot/test/mac-first-boot-test.sh
@@ -515,6 +515,17 @@ expect_handoff "keyring init"
 grep -Eq -- '--populate archlinuxarm asahi-alarm omarchy$' "$case_dir/pacman-key.log" ||
   fail "the Omarchy release keyring is populated when omarchy-keyring ships it (omarchy-update-keyring requires it)"
 
+new_case keyring-j604
+write_esp 'format=1' 'encrypt=0'
+: >"$root/usr/share/pacman/keyrings/omarchy.gpg"
+: >"$root/usr/share/pacman/keyrings/j604.gpg"
+expect_handoff "keyring init with j604-keyring"
+grep -Eq -- '--populate archlinuxarm asahi-alarm omarchy j604$' "$case_dir/pacman-key.log" ||
+  fail "the [j604] keyring is populated with the release keyrings when j604-keyring ships it"
+! grep -Eq -- '--(add|lsign-key)' "$case_dir/pacman-key.log" || fail "first boot imports no key outside a keyring package"
+rm -f "$root/usr/share/pacman/keyrings/j604.gpg"
+echo 'ok - j604-keyring is populated beside the release keyrings'
+
 new_case keyring-retry
 write_esp 'format=1' 'encrypt=0' 'lane=edge'
 mv "$root/usr/bin/omarchy-provision-owner" "$case_dir/omarchy-provision-owner"
