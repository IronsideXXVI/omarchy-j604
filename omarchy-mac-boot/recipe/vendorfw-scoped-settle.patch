From 41af22ae880f15a669f5c0add688a6da7cdddaa5 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 5 Nov 2026 18:28:56 +0000
Subject: [PATCH] Wait only for the replayed input events before the passphrase
 prompt

omarchy-vendorfw-initrd.sh replays hid, input, spi and platform devices
after staging the ESP vendor firmware, then runs a global "udevadm
settle". The settle waits for every queued event, including ones this
helper never queued. The unit is ordered before cryptsetup-pre.target, so
the passphrase prompt waits for the slowest probe that udev is running at
that moment.

On an M4 MacBook Pro (J604) with the display driver bound at boot, that
probe is the appledrm modalias autoload: its DCP firmware startup runs
inside the probe for 6.6 s. The vendor firmware was staged at 1.12 s, but
the unit finished at 8.15 s, 20 ms after the display came up, and the
prompt appeared at 8.21 s instead of 1.42 s.

Replay hid, input and spi with "udevadm trigger --settle", which waits
only for the events it queued (the keyboard and trackpad path the prompt
needs). The wait stays bounded at 10 s, as before; the install hook adds
timeout for that. Platform devices are still replayed, but afterwards and
without waiting: udevd holds an event while one for the same device, a
parent or a child is running, so their replay can sit behind such a
probe.

The source checks cover the scoped wait. The disposable fixture run checks
that a udev queue that never empties no longer holds the helper.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 .../etc/initcpio/install/omarchy-vendorfw     |  1 +
 .../initcpio/omarchy-vendorfw-initrd.sh       | 16 +++++-
 .../test/mac-hid-initramfs-test.sh            | 49 +++++++++++++++++++
 3 files changed, 64 insertions(+), 2 deletions(-)

diff --git a/omarchy-mac-boot/files/etc/initcpio/install/omarchy-vendorfw b/omarchy-mac-boot/files/etc/initcpio/install/omarchy-vendorfw
index 6bd4815..11a9d3f 100755
--- a/omarchy-mac-boot/files/etc/initcpio/install/omarchy-vendorfw
+++ b/omarchy-mac-boot/files/etc/initcpio/install/omarchy-vendorfw
@@ -11,6 +11,7 @@ build() {
     add_binary blkid
     add_binary cp
     add_binary sleep
+    add_binary timeout
     add_file /usr/lib/omarchy/initcpio/omarchy-vendorfw.sh
     add_file /usr/lib/omarchy/initcpio/omarchy-vendorfw-initrd.sh
     add_file /usr/lib/omarchy/initcpio/omarchy-vendorfw.service \
diff --git a/omarchy-mac-boot/files/usr/lib/omarchy/initcpio/omarchy-vendorfw-initrd.sh b/omarchy-mac-boot/files/usr/lib/omarchy/initcpio/omarchy-vendorfw-initrd.sh
index 1035da2..064a00c 100755
--- a/omarchy-mac-boot/files/usr/lib/omarchy/initcpio/omarchy-vendorfw-initrd.sh
+++ b/omarchy-mac-boot/files/usr/lib/omarchy/initcpio/omarchy-vendorfw-initrd.sh
@@ -109,6 +109,18 @@ cp -r "$src"/. "$dest"/
 } >"$record"
 
 if command -v udevadm >/dev/null 2>&1; then
-    udevadm trigger --action=add --subsystem-match=hid --subsystem-match=input --subsystem-match=spi --subsystem-match=platform || true
-    udevadm settle --timeout=10 || true
+    # Replay the keyboard and trackpad side and wait for those events only.
+    # A global "udevadm settle" also waits for events this helper never
+    # queued, such as a display driver still probing (its firmware startup
+    # takes 6.6 s on an M4 MacBook Pro), and the passphrase prompt waits for
+    # this unit. Bounded like the settle it replaces.
+    bound=
+    if command -v timeout >/dev/null 2>&1; then
+        bound="timeout 10"
+    fi
+    $bound udevadm trigger --settle --action=add --subsystem-match=hid --subsystem-match=input --subsystem-match=spi || true
+    # Platform devices are replayed afterwards and not waited for: udevd
+    # holds an event while one for the same device, a parent or a child is
+    # still running, so this replay can sit behind such a probe.
+    udevadm trigger --action=add --subsystem-match=platform || true
 fi
diff --git a/omarchy-mac-boot/test/mac-hid-initramfs-test.sh b/omarchy-mac-boot/test/mac-hid-initramfs-test.sh
index d18eb8a..6dd3da4 100644
--- a/omarchy-mac-boot/test/mac-hid-initramfs-test.sh
+++ b/omarchy-mac-boot/test/mac-hid-initramfs-test.sh
@@ -73,6 +73,26 @@ grep -Fq '/run/omarchy-vendorfw-initrd.status' "$early_sh" ||
   fail "the early helper records /run/omarchy-vendorfw-initrd.status when firmware is missing"
 grep -Fq 'missing' "$early_sh" ||
   fail "the early helper records status=missing"
+# The passphrase prompt waits for this helper, so it waits only for the
+# events it replays, never for the whole udev queue (a display driver can be
+# probing for seconds).
+if grep -Eq '^[[:space:]]*[^#]*udevadm settle' "$early_sh"; then
+  fail "the early helper must not wait for the whole udev queue"
+fi
+settled=$(grep -E '^[[:space:]]*[^#]*udevadm trigger .*--settle' "$early_sh" || true)
+[[ $(grep -c . <<<"$settled") == 1 ]] ||
+  fail "the early helper waits for exactly one replay" "$settled"
+for subsystem in hid input spi; do
+  grep -Fq -- "--subsystem-match=$subsystem" <<<"$settled" ||
+    fail "the early helper waits for the replayed $subsystem events (keyboard path)" "$settled"
+done
+if grep -Fq -- '--subsystem-match=platform' <<<"$settled"; then
+  fail "the early helper must not wait for replayed platform events" "$settled"
+fi
+grep -Eq '^[[:space:]]*udevadm trigger --action=add --subsystem-match=platform' "$early_sh" ||
+  fail "the early helper still replays platform devices"
+grep -Fq 'add_binary timeout' "$install_hook" ||
+  fail "the install hook adds timeout, which bounds the replay wait"
 grep -Fq 'menci/archlinuxarm:latest' "${BASH_SOURCE[0]}" ||
   fail "the container image is Arch Linux ARM"
 if grep -Eq '[|][|] image=' "${BASH_SOURCE[0]}"; then
@@ -590,4 +610,33 @@ OMARCHY_VENDORFW_DEVICE_TREE_ESP=$tmp/device-tree-esp PATH="$tmp/helper-bin:$PAT
 grep -Fq "$esp_partuuid" "$tmp/noesp-dt.err" ||
   fail "a missing ESP names the device tree's PARTUUID" "$(cat "$tmp/noesp-dt.err")"
 echo 'ok - missing ESP records status=missing and exits 0'
+
+# A udev queue that does not empty (a display driver still probing) must not
+# hold the helper: it waits for the replayed input side only.
+reset_helper
+rm -f "$tmp/helper-bin/sleep"
+touch /dev/disk/by-uuid/4F4D-5801
+(cd "$cpiosrc" && find . -print | cpio -o -H newc --quiet) >"$esp/vendorfw/firmware.cpio"
+cat >"$tmp/helper-bin/udevadm" <<SH
+#!/bin/sh
+printf 'udevadm %s\n' "\$*" >>"$calls"
+case " \$* " in
+  *" settle "*|*" --settle "*"--subsystem-match=platform"*) exec sleep 30 ;;
+esac
+exit 0
+SH
+chmod +x "$tmp/helper-bin/udevadm"
+started=$(date +%s)
+PATH="$tmp/helper-bin:$PATH" /usr/lib/omarchy/initcpio/omarchy-vendorfw-initrd.sh \
+  >"$tmp/scoped.out" 2>"$tmp/scoped.err" ||
+  fail "the helper ran with a busy udev queue" "$(cat "$tmp/scoped.err")"
+elapsed=$(($(date +%s) - started))
+((elapsed < 5)) || fail "a busy udev queue held the helper for ${elapsed}s" "$(cat "$calls")"
+grep -Fxq 'udevadm trigger --settle --action=add --subsystem-match=hid --subsystem-match=input --subsystem-match=spi' "$calls" ||
+  fail "the helper waited for the replayed keyboard and trackpad events" "$(cat "$calls")"
+grep -Fxq 'udevadm trigger --action=add --subsystem-match=platform' "$calls" ||
+  fail "the helper still replays platform devices" "$(cat "$calls")"
+[[ $(grep '^udevadm' "$calls" | tail -1) == 'udevadm trigger --action=add --subsystem-match=platform' ]] ||
+  fail "platform devices are replayed after the waited-for input replay" "$(cat "$calls")"
+echo 'ok - the helper waits for its own input replay, not for the whole udev queue'
 echo 'ok - omarchy-mac-hid-initramfs'
-- 
2.43.0

