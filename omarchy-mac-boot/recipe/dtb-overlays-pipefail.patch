From b086c9fb88b1bd417c174d4b0b21d29ea195f154 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 19:34:08 +0000
Subject: [PATCH] omarchy-mac-boot: dtb-overlays: read the device tree to the
 end

dtb_overlays_has_compatible pipes dtc into awk, and awk exited at the
first available match. omarchy-apple-silicon-boot-check runs with
pipefail, so for a device tree whose match comes early and whose source
is larger than a pipe buffer, dtc died of SIGPIPE and the function
reported a miss. The check then applied an overlay that update-m1n1
(plain sh) correctly left out, and failed m1n1/boot.bin as not built
from the installed device trees: with dtc installed, the omarchy-ane
overlays and the t6001/t6021 kernel trees that already carry the ANE
node. awk now reads on to the end. The test adds a large device tree
under pipefail.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>

---
 omarchy-mac-boot/lib/dtb-overlays.sh       |  4 +++-
 omarchy-mac-boot/test/dtb-overlays-test.sh | 17 +++++++++++++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/omarchy-mac-boot/lib/dtb-overlays.sh b/omarchy-mac-boot/lib/dtb-overlays.sh
index 06ee0c1..b7ef604 100644
--- a/omarchy-mac-boot/lib/dtb-overlays.sh
+++ b/omarchy-mac-boot/lib/dtb-overlays.sh
@@ -71,7 +71,9 @@ dtb_overlays_has_compatible() {
         if (matched[depth] && (status[depth] == "" || status[depth] == "okay" ||
           status[depth] == "ok")) {
           found = 1
-          exit
+          # Read on to the end: a caller under pipefail (the boot check) would
+          # otherwise see dtc die of SIGPIPE and take the match for a miss.
+          next
         }
         delete matched[depth]
         delete status[depth]
diff --git a/omarchy-mac-boot/test/dtb-overlays-test.sh b/omarchy-mac-boot/test/dtb-overlays-test.sh
index 1b04b4c..b19d5ab 100755
--- a/omarchy-mac-boot/test/dtb-overlays-test.sh
+++ b/omarchy-mac-boot/test/dtb-overlays-test.sh
@@ -146,6 +146,23 @@ DTS
 done
 pass "only a node with no status, \"okay\" or \"ok\" has the compatible"
 
+# omarchy-apple-silicon-boot-check runs under pipefail. A match early in a
+# device tree larger than a pipe buffer is still a match: if awk stopped
+# reading, dtc would die of SIGPIPE and the pipeline would report a miss.
+{
+  printf '/dts-v1/;\n/ {\n  compatible = "apple,j293", "apple,t8103";\n'
+  printf '  ane@1000 { compatible = "apple,t8103-ane"; };\n'
+  for i in $(seq 1 8000); do
+    printf '  padding%d { compatible = "omarchy,test-padding"; };\n' "$i"
+  done
+  printf '};\n'
+} | dtc -q -I dts -O dtb -o "$tmp/large.dtb" -
+(( $(dtc -q -I dtb -O dts -o - "$tmp/large.dtb" | wc -c) > 262144 )) ||
+  fail "the large device tree's source is larger than a pipe buffer"
+(set -o pipefail; dtb_overlays_has_compatible "$tmp/large.dtb" apple,t8103-ane) ||
+  fail "under pipefail, an early match in a large device tree has the compatible"
+pass "under pipefail, an early match in a large device tree has the compatible"
+
 # A kernel that ships the node disabled does not keep the overlay out: the
 # overlay merges into the node and enables it in place.
 board_dtb t8103-j293-kernel-ane-disabled.dtb j293 t8103 \
-- 
2.43.0

