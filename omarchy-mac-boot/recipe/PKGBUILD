# Maintainer: Marcelo Alcantara <maralc@gmail.com>
# Recipe from maralcbr/omarchy-pkgs asahi-quattro pkgbuilds/omarchy-mac-boot
# (20260921-10 at 0a55baeddecf59687c32b4bd4e1dee743605c183); the payload now
# builds from omarchy-mac-boot/ in omacom/omarchy-mac-pkgs.

pkgname=omarchy-mac-boot
# pkgver is the UTC commit date of _commit, so it sorts above the fork's
# 20260921-N. Reset pkgrel to 1 when pkgver changes; bump it to re-pin or
# rebuild on the same day.
pkgver=20261104
# Local J604 build (not an Omarchy release): 1.616 sorts above the official
# 20261104-1 and the local 1.1-1.3 and 1.613-1.615, and below any later
# official build.
pkgrel=1.616
pkgdesc='Apple Silicon boot support for Omarchy: initramfs, in-place encryption, first boot and Limine activation'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/omacom/omarchy-mac-pkgs'
license=('MIT')
makedepends=('git')
# The device tree overlay tests run dtc, fdtoverlay and fdtget.
checkdepends=('dtc')
provides=('omarchy-apple-boot' 'omarchy-first-boot')
conflicts=('omarchy-apple-boot' 'omarchy-first-boot')
replaces=('omarchy-apple-boot' 'omarchy-first-boot')
install=omarchy-mac-boot.install
# An exact omarchy-mac-pkgs main commit, never a branch.
_commit=7e50e937b5f32a62f1c8fee9699467d23faa74d5
# user4k.patch is omacom/omarchy-mac-pkgs#46 against _commit. Drop it, and its
# line in prepare(), once a re-pin includes it.
source=("omarchy-mac-pkgs::git+https://github.com/omacom/omarchy-mac-pkgs.git#commit=${_commit}"
        user4k.patch
        vendorfw-scoped-settle.patch
        j604-keyring-populate.patch
        external-displays-after-splash.patch
        dtb-overlays-pipefail.patch
        machine-dtb.patch)
sha256sums=('378689659412cb71f7a81b1054ee5a0b6a4e47e86ab3db3ccf9cd06e2359949f'
            '9193fe7b34130670c06fc2081ebe94f76559199a51dd57050789ed536b3ba3b3'
            '250b24f7cdec8732882f4b98e3c0c2920e2a138c55409662f6cb62d9f8b14a6b'
            'c7f2c28580d29b6a433343aa835234ef9d7d49ceb0dc2e8f759501412f8bd46f'
            '5209bdb88c91e9ab9f00a7bdf1390c93ca23ed57a2ebf07d3d028f4da2c2ddca'
            'c6948971edac7bbcd804ba9d8da7f21557f7df78db0b17fbd2d613fc0045be1e'
            '483ee729114983a18e0967df76b767842e41334c397c221585e9fbf3627c43e7')

prepare() {
  # Tests and staging must not be able to read the other package's tree.
  rm -rf "$srcdir/boot"
  cp -a "$srcdir/omarchy-mac-pkgs/omarchy-mac-boot" "$srcdir/boot"
  patch -d "$srcdir/boot" -Np2 <"$srcdir/user4k.patch"
  # vendorfw-scoped-settle.patch: the early vendorfw helper waits for its own
  # input replay, not the whole udev queue (omarchy-mac-pkgs
  # j604/vendorfw-scoped-settle 41af22a, not yet proposed upstream).
  patch -d "$srcdir/boot" -Np2 <"$srcdir/vendorfw-scoped-settle.patch"
  # j604-keyring-populate.patch: first boot populates the private [j604]
  # keyring (j604-keyring) with the release keyrings, on the same code path.
  patch -d "$srcdir/boot" -Np2 <"$srcdir/j604-keyring-populate.patch"
  # external-displays-after-splash.patch: release the held external displays
  # once Plymouth is gone, not before the display manager, so Omarchy's
  # Plymouth handover has no ordering cycle through the splash.
  patch -d "$srcdir/boot" -Np2 <"$srcdir/external-displays-after-splash.patch"
  # dtb-overlays-pipefail.patch: dtb_overlays_has_compatible reads the device
  # tree to the end, so the boot check (pipefail) does not take an early match
  # for a miss when dtc dies of SIGPIPE.
  patch -d "$srcdir/boot" -Np2 <"$srcdir/dtb-overlays-pipefail.patch"
  # machine-dtb.patch: /etc/default/update-m1n1 gives update-m1n1 only the
  # running Mac's own device tree of the newest kernel, so m1n1 stage 1 can
  # still chainload boot.bin (Linux 7.3 ships 137 device trees, 13.5 MB, which
  # a T8132 stage 1 refuses); the boot check expects the same image.
  patch -d "$srcdir/boot" -Np2 <"$srcdir/machine-dtb.patch"
  [[ $(git -C "$srcdir/omarchy-mac-pkgs" rev-parse HEAD) == "$_commit" ]]
  [[ $(TZ=UTC0 git -C "$srcdir/omarchy-mac-pkgs" show -s --format=%cd --date=format-local:%Y%m%d HEAD) == "$pkgver" ]]
}

check() {
  "$srcdir/boot/test/all"
}

package() {
  # Runtime-only, so the builder stages and tests the payload without the
  # desktop. 1.39.0-2 is the first limine-mkinitcpio-hook that leaves a Mac's
  # /boot to mkinitcpio until Limine is activated. update-m1n1 builds stage 2
  # from m1n1 and U-Boot, so neither can be removed; m1n1 is the virtual name,
  # leaving its provider (m1n1-aurora) to the image, as the kernel is. First
  # boot populates the Asahi repository's keyring, and the J604 build's
  # [j604] keyring the same way (j604-keyring, as asahi-alarm-keyring).
  # dtc: /etc/default/update-m1n1 (machine-dtb.patch) reads each device tree's
  # compatible with fdtget; without it boot.bin falls back to every device
  # tree, which a T8132 Mac's m1n1 stage 1 refuses.
  depends=('omarchy' 'limine' 'limine-mkinitcpio-hook>=1.39.0-2' 'limine-snapper-sync' 'asahi-scripts' 'dtc'
           'm1n1' 'uboot-asahi' 'asahi-alarm-keyring' 'j604-keyring'
           'bash' 'binutils' 'btrfs-progs' 'coreutils' 'cpio' 'cryptsetup' 'diffutils' 'gawk' 'gnupg' 'grep'
           'gum' 'gzip' 'kbd' 'mkinitcpio' 'sed' 'systemd' 'util-linux')

  "$srcdir/boot/install" "$pkgdir"
  # Once the source drops its own Plymouth fragment (omacom/omarchy-mac#544),
  # the Apple drop-ins build on omarchy-settings' HOOKS baseline
  # (/etc/mkinitcpio.conf.d/00-omarchy-hooks.conf, omacom/omarchy-mac#536), and
  # an older settings package leaves Plymouth out of the Mac initramfs. A
  # settings version cannot say so (quattro candidates sort below stock
  # releases, and omarchy pins its settings exactly), so the settings packages
  # that ship the baseline provide it by name.
  [[ -e $pkgdir/etc/mkinitcpio.conf.d/93-omarchy-mac-plymouth.conf ]] ||
    depends+=('omarchy-mkinitcpio-hooks-baseline')
  printf '%s\n' "$_commit" | install -Dm644 /dev/stdin "$pkgdir/usr/share/omarchy-mac/boot-source-revision"

  # Administrator-editable: every /etc file and the initramfs helpers an image
  # may rewrite.
  mapfile -t backup < <(cd "$pkgdir" && find etc usr/lib/omarchy/initcpio -type f | sort)
}
