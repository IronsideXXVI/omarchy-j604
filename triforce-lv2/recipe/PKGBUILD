# J604 local build: the official omarchy-pkgs recipe at 9679db33, changed only by
# pkgrel 2 -> 2.604 and the J604 patches in the source array (carried from 0.3.2-1.611).
pkgname=triforce-lv2
_name=triforce
pkgver=0.3.2
pkgrel=2.604
pkgdesc='A beamformer LV2 plugin for Apple Silicon laptop microphones'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/chadmed/triforce'
license=('GPL-2.0-or-later')
depends=('glibc' 'gcc-libs' 'lv2')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
        0001-Fix-the-steering-vector-phase.patch)
sha256sums=('1d081222d0bfe2c961ac44b368c9f1d2dd9ec0833a35bab87863bac07e9df019'
            '3c81bbda4c647251b40c2f31c642374411243b6177058cef382c4931d44e032a')

prepare() {
  cd $_name-$pkgver
  patch -p1 --fuzz=0 --no-backup-if-mismatch -i ../0001-Fix-the-steering-vector-phase.patch
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $_name-$pkgver
  cargo build --frozen --release
}

package() {
  cd $_name-$pkgver
  make LIBDIR=/usr/lib DESTDIR="$pkgdir" install
  install -Dm644 LICENCE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENCE.txt"
}
