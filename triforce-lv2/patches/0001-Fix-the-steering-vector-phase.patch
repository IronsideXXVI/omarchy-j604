From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 15:36:37 +0000
Subject: [PATCH] Fix the steering vector phase

The repetency was computed as 2*pi / (f / c), which is 2*pi times the
wavelength, not 2*pi over it, and the path difference was then divided
by c a second time. The phase of each element came out as
2*pi * path / f: about 1e-4 rad for 2 cm at 1.1 kHz instead of 0.4 rad,
so every steering direction gave the same all-ones steering vector and
the array geometry had no effect.

Use the wavenumber 2*pi * f / c and multiply it by the path difference.
Configurations steered broadside (v_angle 0) are unchanged: their path
difference is zero either way.
---
 src/lib.rs | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/lib.rs b/src/lib.rs
index 4a35ae0..60a569d 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -70,8 +70,8 @@ fn steering_vec(theta: f32, phi: f32, f: f32, elems: [ElemDistance; 3]) -> Vecto
     let mic_positions: Vec<Vector3<f32>> =
         elems.iter().map(|e| Vector3::new(e.x, e.y, 0f32)).collect();
 
-    // Calculate angular repetency (2pi/lambda)
-    let repetency = (2f32 * PI) / (f / C);
+    // Angular repetency (wavenumber), 2pi/lambda = 2pi * f / c
+    let repetency = (2f32 * PI) * f / C;
 
     // Compute the unit vector of the DOA
     let u_dir = Vector3::new(phi.sin() * theta.cos(), phi.sin() * theta.sin(), phi.cos());
@@ -81,8 +81,10 @@ fn steering_vec(theta: f32, phi: f32, f: f32, elems: [ElemDistance; 3]) -> Vecto
     let mut steering_vector = Vector3::from_element(Complex::new(0f32, 0f32));
 
     for (i, mic_pos) in mic_positions.iter().enumerate() {
-        let delay = mic_pos.dot(&u_dir) / C;
-        let phase = -repetency * delay;
+        // Path difference along the DOA, in metres; times the wavenumber
+        // gives the phase of this element relative to the zeroth
+        let path = mic_pos.dot(&u_dir);
+        let phase = -repetency * path;
         steering_vector[i] = Complex::new(phase.cos(), phase.sin());
     }
 
