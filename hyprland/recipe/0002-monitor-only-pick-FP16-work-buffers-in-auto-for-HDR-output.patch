From 5b64ff21eb2585b28b9f1e28285f57be1e733cb5 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 21 Nov 2026 13:49:59 +0000
Subject: [PATCH] monitor: only pick FP16 work buffers in auto for HDR output

render:use_fp16 = 2 (auto) turns FP16 on whenever the output isn't sRGB
or 10-bit is enabled. On a 10-bit wide-gamut SDR panel that makes every
work, blur and mirror buffer ABGR16161616F, 8 bytes per pixel, for SDR
content that blends fine in the output's own 10-bit format.

In auto, use FP16 only when the output is HDR (PQ or HLG transfer, or
HDR metadata set). SDR output, 10-bit or wide gamut included, gets the
output's DRM format for its work buffers, which resources() already
falls back to. use_fp16 = 1 still forces FP16 and 0 still disables it.
---
 src/output/Monitor.cpp | 16 ++++++----------
 1 file changed, 6 insertions(+), 10 deletions(-)

diff --git a/src/output/Monitor.cpp b/src/output/Monitor.cpp
index 7775fcac3..f157c39a2 100644
--- a/src/output/Monitor.cpp
+++ b/src/output/Monitor.cpp
@@ -2682,18 +2682,14 @@ bool CMonitor::needsUnmodifiedCopy() {
 bool CMonitor::useFP16() {
     static const auto PFP16 = CConfigValue<Hyprlang::INT>("render:use_fp16");
 
-    auto              isSRGB = [this] {
-        if (m_imageDescription->value().transferFunction != CM_TRANSFER_FUNCTION_SRGB && m_imageDescription->value().transferFunction != CM_TRANSFER_FUNCTION_GAMMA22)
-            return false;
-
-        if (m_imageDescription->value().primariesNamed != CM_PRIMARIES_SRGB)
-            return false;
-
-        return true;
+    auto              isHDR = [this] {
+        const auto TF = m_imageDescription->value().transferFunction;
+        return TF == CM_TRANSFER_FUNCTION_ST2084_PQ || TF == CM_TRANSFER_FUNCTION_HLG || inHDR();
     };
 
-    // Auto: use FP16 if the monitor is not sRGB or is 10 bit
-    return g_pHyprRenderer->fp16Supported() && (*PFP16 == 1 || (*PFP16 == 2 && (!isSRGB() || m_enabled10bit)));
+    // Auto: use FP16 only for HDR output. SDR output, 10 bit or wide gamut included, blends fine in
+    // the output's own format (e.g. 2101010) at half the memory of FP16.
+    return g_pHyprRenderer->fp16Supported() && (*PFP16 == 1 || (*PFP16 == 2 && isHDR()));
 }
 
 PImageDescription CMonitor::workBufferImageDescription() {
