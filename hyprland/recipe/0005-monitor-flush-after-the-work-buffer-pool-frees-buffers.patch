From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 22 Nov 2026 10:25:40 +0000
Subject: [PATCH] monitor: flush after the work buffer pool frees buffers

The work buffer pool frees idle buffers from a timer, usually when no
frame is being rendered. Deleting the GL objects does not reach the
driver, so a driver that retires finished submissions only on its next
flush keeps their storage alive until the next frame. On an idle
desktop that can be minutes.

Queue one glFlush after the pool has released its buffers.
---
 src/output/MonitorResources.cpp | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/output/MonitorResources.cpp b/src/output/MonitorResources.cpp
index 4cc4d1bb8..7b8d8fcc8 100644
--- a/src/output/MonitorResources.cpp
+++ b/src/output/MonitorResources.cpp
@@ -1,3 +1,4 @@
+#include "../managers/eventLoop/EventLoopManager.hpp"
 #include "MonitorResources.hpp"
 #include "../managers/screenshare/ScreenshareManager.hpp"
 #include "../helpers/cm/ColorManagement.hpp"
@@ -14,8 +15,20 @@ using namespace NColorManagement;
 
 static void prepareWorkBufferRelease() {
     // Timer expiry also runs when no frame has made the rendering context current.
-    if (Render::GL::g_pHyprOpenGL)
+    if (!Render::GL::g_pHyprOpenGL)
+        return;
+
+    Render::GL::g_pHyprOpenGL->makeEGLCurrent();
+
+    // The buffers are deleted right after this returns. With no frame following, nothing reaches the
+    // driver again, and it can keep the storage referenced by the last (finished) submissions. Flush
+    // once the pool is done so the driver gets a chance to retire them.
+    g_pEventLoopManager->doLater([] {
+        if (!Render::GL::g_pHyprOpenGL)
+            return;
         Render::GL::g_pHyprOpenGL->makeEGLCurrent();
+        glFlush();
+    });
 }
 
 CMonitorResources::CMonitorResources(WP<CMonitor> monitor, DRMFormat format, Vector2D size, NColorManagement::PImageDescription imageDescription) :
