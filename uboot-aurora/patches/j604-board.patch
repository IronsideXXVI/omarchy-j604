 	if (input >= 0) {
 		input = fdt_parent_offset(blob, input);
 		if (input > 0 && fdt_setprop_string(blob, input, "status", "disabled"))
@@ -503,6 +506,46 @@ static void rtkit_helper_fdt_disable_j713(struct udevice *dev, void *blob)
 	}
 }
 
+/* Failed optional input must not leave a completed-handoff claim behind. */
+static void rtkit_helper_fdt_disable_j713(struct udevice *dev, void *blob)
+{
+	int node = rtkit_helper_fdt_node(blob, dev);
+
+	if (node >= 0)
+		rtkit_helper_fdt_disable_j713_node(blob, node);
+	rtkit_helper_fdt_disable_j713_input(blob);
+}
+
+/*
+ * A J713-class helper that never probed (or was skipped) has no session for
+ * Linux to adopt, yet its node would still reach the OS as "okay" and the OS
+ * driver would cold-start the ASC. Disable every T8132 ASC4 helper node that
+ * does not carry a session kept by an active helper.
+ */
+static void rtkit_helper_fdt_disable_unkept_j713(void *blob, bool live)
+{
+	static const char compatible[] = "apple,t8132-rtk-helper-asc4";
+	bool unkept = false;
+	int node = -1;
+
+	while ((node = fdt_node_offset_by_compatible(blob, node, compatible)) >= 0) {
+		const char *status = fdt_getprop(blob, node, "status", NULL);
+		bool claim = fdt_getprop(blob, node, "apple,rtkit-handoff", NULL) ||
+			     fdt_getprop(blob, node, "apple,rtkit-buffers", NULL) ||
+			     fdt_getprop(blob, node, "linux-enablement-mac,rtkit-inherited", NULL);
+
+		if (live && fdt_getprop(blob, node, "apple,rtkit-handoff", NULL))
+			continue;
+		unkept = true;
+		if (!claim && status && !strcmp(status, "disabled"))
+			continue;
+		if (rtkit_helper_fdt_disable_j713_node(blob, node))
+			node = -1; /* Removed: offsets after it moved, rescan. */
+	}
+	if (unkept)
+		rtkit_helper_fdt_disable_j713_input(blob);
+}
+
 /*
