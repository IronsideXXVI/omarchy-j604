+                    '-I', str(libfdt), str(source), *map(str, sources), '-o', str(binary)], check=True)
+    return subprocess.run([str(binary)], capture_output=True).returncode
+
+
+def test_j713_unprobed_helper_mtp_disabled(tmp_path):
+    # A J713-class helper that never probed is skipped by the fixup loop
+    # (!device_active), yet its &mtp node reached Linux as "okay" and the
+    # rtkit-helper driver cold-started the ASC. Every unkept T8132 ASC4 node
+    # must reach the OS disabled with no handoff claim; a kept one must not.
+    repo = Path(__file__).resolve().parents[3]
+    text = (repo / 'arch/arm/mach-apple/rtkit_helper.c').read_text()
+    production = _j713_sweep_production(text)
+    assert _run_j713_sweep(tmp_path, 'sweep', production) == 0
+    # Mutation checks: each guarded behaviour is observed at run time (mutants
+    # are built without -Werror so that a kill is a failed assertion).
+    mutants = {
+        'no_sweep': ('\tif (apple_j713_class())\n\t\trtkit_helper_fdt_disable_unkept_j713(blob, live);\n', ''),
+        'no_class_gate': ('\tif (apple_j713_class())\n\t\trtkit_helper_fdt_disable_unkept_j713(', '\tif (1)\n\t\trtkit_helper_fdt_disable_unkept_j713('),
+        'no_keep': ('\t\tif (live && fdt_getprop(blob, node, "apple,rtkit-handoff", NULL))\n\t\t\tcontinue;\n', ''),
+        'no_live': ('\t\tlive |= rtkit_helper_j713_handoff(dev) && priv->handoff_published;\n', ''),
+        'trust_stale': ('\t\tif (live && fdt_getprop(', '\t\tif (fdt_getprop('),
+        'no_input': ('\tif (unkept)\n\t\trtkit_helper_fdt_disable_j713_input(blob);\n', ''),
+    }
+    for name, (old, new) in mutants.items():
+        assert production.count(old) == 1, name
+        assert _run_j713_sweep(tmp_path, 'mut_' + name, production.replace(old, new), werror=False) != 0, name
