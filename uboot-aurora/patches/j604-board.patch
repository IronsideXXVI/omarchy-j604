+def test_t8132_board_handoff_gate(tmp_path):
+    # The mtp-live-v1 publication runs only behind rtkit_helper_j713_handoff().
+    # Compile the real gate and the real apple_j713_class() so that every
+    # T8132 laptop on the J713 contract (J713, J604) keeps its keyboard at the
+    # first OS prompt; the J614s keeps its own T6041 helper.
+    repo = Path(__file__).resolve().parents[3]
+    helper = (repo / 'arch/arm/mach-apple/rtkit_helper.c').read_text()
+    header = (repo / 'arch/arm/include/asm/arch-apple/t8132_board.h').read_text()
+    assert '#include <asm/arch/t8132_board.h>' in helper
+    start = helper.index('static bool rtkit_helper_j713_handoff(')
+    gate = helper[start:helper.index('\n}\n', start) + 3]
+    start = header.index('static inline bool apple_j713_class(')
+    board = header[start:header.index('\n}\n', start) + 3]
+    unit = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <string.h>
+struct udevice { const char *compatible; };
+static const char *const *machine;
+static bool of_machine_is_compatible(const char *compat)
+{
+ for (const char *const *m = machine; *m; m++)
+  if (!strcmp(*m, compat)) return true;
+ return false;
+}
+static bool device_is_compatible(const struct udevice *dev, const char *compat)
+{ return !strcmp(dev->compatible, compat); }
+''' + board + gate + r'''
+int main(void)
+{
+ static const char *const j713[] = {"apple,j713", "apple,t8132", NULL};
+ static const char *const j604[] = {"apple,j604", "apple,t8132", NULL};
+ static const char *const j700[] = {"apple,j700", "apple,t8140", NULL};
+ static const char *const soc[] = {"apple,t8132", NULL};
+ static const char *const j614s[] = {"apple,j614s", "apple,t6041", NULL};
+ struct udevice mtp = {"apple,t8132-rtk-helper-asc4"};
+ struct udevice t8140 = {"apple,t8140-rtk-helper-asc4"};
+ struct udevice other = {"apple,t8132-rtk-helper"};
+ struct udevice t6041 = {"apple,t6041-rtk-helper-asc4"};
+ machine = j713; assert(apple_j713_class()); assert(rtkit_helper_j713_handoff(&mtp));
+ machine = j604; assert(apple_j713_class()); assert(rtkit_helper_j713_handoff(&mtp));
