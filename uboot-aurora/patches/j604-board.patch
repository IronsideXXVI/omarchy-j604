+ machine = soc; assert(!apple_j713_class()); assert(!rtkit_helper_j713_handoff(&mtp));
+ machine = j604; assert(!rtkit_helper_j713_handoff(&t6041));
+ machine = j614s; assert(!apple_j713_class()); assert(rtkit_helper_j713_handoff(&t6041));
+ assert(!rtkit_helper_j713_handoff(&mtp));
+ return 0;
+}
+'''
