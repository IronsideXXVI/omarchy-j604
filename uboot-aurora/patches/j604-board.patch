+static bool apple_j713_class(void) { return j713; }
+static bool rtkit_helper_j713_handoff(struct udevice *dev) { return j713; }
+static bool rtkit_helper_j613_handoff(struct udevice *dev) { return false; }
+static void __attribute__((noreturn)) panic(const char *fmt, ...) { abort(); }
+static bool rtkit_helper_uses_dram(struct udevice *dev) { return false; }
+static int rtkit_helper_fdt_node(void *blob, struct udevice *dev)
+{ return fdt_path_offset(blob, "/soc/mtp@394600000"); }
