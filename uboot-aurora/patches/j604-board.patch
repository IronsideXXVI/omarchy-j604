+static int rtkit_helper_fdt_publish_j713(struct udevice *dev, void *blob)
+{
+ int node = rtkit_helper_fdt_node(blob, dev);
+ publishes++;
+ if (!publish_ok || node < 0) return -ENODEV;
+ assert(!fdt_setprop_string(blob, node, "apple,rtkit-handoff", "mtp-live-v1"));
