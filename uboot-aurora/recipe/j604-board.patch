+def test_t8132_board_handoff_gate(tmp_path):
+    # The mtp-live-v1 publication runs only behind rtkit_helper_j713_handoff().
+    # Compile the real gate and the real apple_j713_class() so that every
+    # T8132 laptop on the J713 contract (J713, J604) keeps its keyboard at the
+    # first OS prompt, and nothing else does.
+    repo = Path(__file__).resolve().parents[3]
+    helper = (repo / 'arch/arm/mach-apple/rtkit_helper.c').read_text()
+    header = (repo / 'arch/arm/include/asm/arch-apple/t8132_board.h').read_text()
+    assert 'of_machine_is_compatible' not in helper
+    assert '#include <asm/arch/t8132_board.h>' in helper
+    start = helper.index('static bool rtkit_helper_j713_handoff(')
+    gate = helper[start:helper.index('\n}\n', start) + 3]
+    start = header.index('static inline bool apple_j713_class(')
+    board = header[start:header.index('\n}\n', start) + 3]
