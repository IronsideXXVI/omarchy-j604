 	uclass_id_foreach_dev(UCLASS_MISC, dev, uc) {
@@ -624,7 +668,10 @@ int apple_rtkit_helper_fdt_fixup(void *blob)
 				apple_dart_release_bypass(priv->dart);
 			}
 		}
+		live |= rtkit_helper_j713_handoff(dev) && priv->handoff_published;
 	}
+	if (apple_j713_class())
+		rtkit_helper_fdt_disable_unkept_j713(blob, live);
 
 	return 0;
 }
