+ if (with_status) assert(!fdt_setprop_string(blob, mtp, "status", status));
+ if (stale) {
+  assert(!fdt_setprop_string(blob, mtp, "apple,rtkit-handoff", "mtp-live-v1"));
+  assert(!fdt_setprop_u32(blob, mtp, "linux-enablement-mac,rtkit-inherited", 1));
+ }
+ int dc = fdt_add_subnode(blob, fdt_path_offset(blob, "/soc"), "dockchannel@394408000");
+ int hid = fdt_add_subnode(blob, dc, "input@0");
+ assert(hid >= 0 && fdt_add_subnode(blob, hid, "keyboard") >= 0);
+ assert(!fdt_setprop_string(blob, fdt_path_offset(blob, HID), "status", "okay"));
+ int aliases = fdt_add_subnode(blob, 0, "aliases");
+ assert(!fdt_setprop_string(blob, aliases, "keyboard", "/soc/dockchannel@394408000/input@0/keyboard"));
+}
+static const char *status_of(char *blob, const char *path)
+{ int n = fdt_path_offset(blob, path); return n < 0 ? "gone" : fdt_getprop(blob, n, "status", NULL); }
+static bool disabled(char *blob, const char *path)
+{ const char *s = status_of(blob, path); return s && (!strcmp(s, "disabled") || !strcmp(s, "gone")); }
+static bool no_claims(char *blob)
+{
+ int n = fdt_path_offset(blob, MTP);
+ return n < 0 || (!fdt_getprop(blob, n, "apple,rtkit-handoff", NULL) &&
+		  !fdt_getprop(blob, n, "apple,rtkit-buffers", NULL) &&
+		  !fdt_getprop(blob, n, "linux-enablement-mac,rtkit-inherited", NULL));
+}
+static void reset(bool is_j713, struct udevice *dev, bool is_active, bool ok)
+{ j713 = is_j713; bound = dev; active = is_active; publish_ok = ok; stops = publishes = 0;
+  priv = (struct rtkit_helper_priv){0}; }
+
+int main(void)
+{
+ char blob[4096], again[4096];
+ struct udevice dev = {.driver = &driver_tag};
+
+ /* 1. Probe failed: the helper is bound but inactive, &mtp must not stay okay. */
+ for (int stale = 0; stale < 2; stale++) {
+  build(blob, sizeof(blob), stale, true, "okay");
+  reset(true, &dev, false, true);
+  assert(!apple_rtkit_helper_fdt_fixup(blob) && !publishes && !stops);
+  assert(disabled(blob, MTP) && no_claims(blob) && disabled(blob, HID));
+  memcpy(again, blob, sizeof(blob));
+  assert(!apple_rtkit_helper_fdt_fixup(again) && !memcmp(again, blob, sizeof(blob)));
+ }
+ /* 2. Never bound (no driver match / bind failure): same outcome. */
+ build(blob, sizeof(blob), true, true, "okay");
+ reset(true, NULL, false, true);
+ assert(!apple_rtkit_helper_fdt_fixup(blob));
+ assert(disabled(blob, MTP) && no_claims(blob) && disabled(blob, HID));
+ /* 3. Already disabled without claims is left alone, the HID is still disabled. */
+ build(blob, sizeof(blob), false, true, "disabled");
+ reset(true, &dev, false, true);
+ assert(!apple_rtkit_helper_fdt_fixup(blob) && disabled(blob, MTP) && disabled(blob, HID));
+ /* 4. No room for status: the node is removed and the sweep terminates. */
+ build(blob, sizeof(blob), false, false, NULL);
+ assert(!fdt_pack(blob));
+ reset(true, &dev, false, true);
+ assert(!apple_rtkit_helper_fdt_fixup(blob));
+ assert(fdt_path_offset(blob, MTP) < 0);
+ /* 5. A live, published session is kept and described. */
+ build(blob, sizeof(blob), false, true, "okay");
+ reset(true, &dev, true, true);
+ assert(!apple_rtkit_helper_fdt_fixup(blob) && publishes == 1 && !stops);
+ int mtp = fdt_path_offset(blob, MTP);
+ assert(!strcmp(status_of(blob, MTP), "okay") && !strcmp(status_of(blob, HID), "okay"));
+ assert(fdt_getprop(blob, mtp, "apple,rtkit-handoff", NULL));
+ /* 6. Active helper whose publication is refused: stopped and disabled. */
+ build(blob, sizeof(blob), true, true, "okay");
+ reset(true, &dev, true, false);
+ assert(!apple_rtkit_helper_fdt_fixup(blob) && publishes == 1 && stops == 1);
+ assert(disabled(blob, MTP) && no_claims(blob) && disabled(blob, HID));
+ /* 7. Outside the J713 class the OS tree is not touched. */
+ build(blob, sizeof(blob), false, true, "okay");
+ memcpy(again, blob, sizeof(blob));
+ reset(false, &dev, false, true);
+ assert(!apple_rtkit_helper_fdt_fixup(blob) && !memcmp(again, blob, sizeof(blob)));
+ return 0;
+}
+"""
+
+
+def _j713_sweep_production(text):
+    start = text.index('static bool rtkit_helper_fdt_disable_j713_node(')
+    production = text[start:text.index('/*\n * Describe the running session', start)]
+    fixup = text.index('int apple_rtkit_helper_fdt_fixup(')
+    return production + text[fixup:text.index('static const struct udevice_id rtkit_helper_ids', fixup)]
+
+
+def _run_j713_sweep(tmp_path, name, production, werror=True):
+    repo = Path(__file__).resolve().parents[3]
+    source, binary = tmp_path / (name + '.c'), tmp_path / name
+    source.write_text(J713_SWEEP_HARNESS.replace('@PRODUCTION@', production))
+    libfdt = repo / 'scripts/dtc/libfdt'
+    sources = [libfdt / (n + '.c') for n in ('fdt', 'fdt_ro', 'fdt_rw', 'fdt_sw', 'fdt_wip', 'fdt_empty_tree', 'fdt_strerror', 'fdt_addresses')]
+    subprocess.run(['cc', '-D_GNU_SOURCE', '-std=gnu11', '-Wall', '-Wextra', '-Werror' if werror else '-Wno-error',
+                    '-Wno-unused-parameter', '-Wno-unused-function', '-Wno-format', '-fsanitize=address,undefined', '-fno-sanitize-recover=all',
+                    '-I', str(libfdt), str(source), *map(str, sources), '-o', str(binary)], check=True)
+    return subprocess.run([str(binary)], capture_output=True).returncode
+
+
+def test_j713_unprobed_helper_mtp_disabled(tmp_path):
+    # A J713-class helper that never probed is skipped by the fixup loop
+    # (!device_active), yet its &mtp node reached Linux as "okay" and the
+    # rtkit-helper driver cold-started the ASC. Every unkept T8132 ASC4 node
+    # must reach the OS disabled with no handoff claim; a kept one must not.
+    repo = Path(__file__).resolve().parents[3]
+    text = (repo / 'arch/arm/mach-apple/rtkit_helper.c').read_text()
+    production = _j713_sweep_production(text)
+    assert _run_j713_sweep(tmp_path, 'sweep', production) == 0
+    # Mutation checks: each guarded behaviour is observed at run time (mutants
+    # are built without -Werror so that a kill is a failed assertion).
+    mutants = {
+        'no_sweep': ('\tif (apple_j713_class())\n\t\trtkit_helper_fdt_disable_unkept_j713(blob, live);\n', ''),
+        'no_class_gate': ('\tif (apple_j713_class())\n\t\trtkit_helper_fdt_disable_unkept_j713(', '\tif (1)\n\t\trtkit_helper_fdt_disable_unkept_j713('),
+        'no_keep': ('\t\tif (live && fdt_getprop(blob, node, "apple,rtkit-handoff", NULL))\n\t\t\tcontinue;\n', ''),
+        'no_live': ('\t\tlive |= rtkit_helper_j713_handoff(dev) && priv->handoff_published;\n', ''),
+        'trust_stale': ('\t\tif (live && fdt_getprop(', '\t\tif (fdt_getprop('),
+        'no_input': ('\tif (unkept)\n\t\trtkit_helper_fdt_disable_j713_input(blob);\n', ''),
+    }
+    for name, (old, new) in mutants.items():
+        assert production.count(old) == 1, name
+        assert _run_j713_sweep(tmp_path, 'mut_' + name, production.replace(old, new), werror=False) != 0, name
