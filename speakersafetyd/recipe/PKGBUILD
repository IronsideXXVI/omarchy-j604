# J604 local build: the official omarchy-pkgs recipe at 9679db33, changed only by
# pkgrel 2 -> 2.604 and the J604 patches in the source array (carried from 2.0.1-1.607).
pkgname=speakersafetyd
pkgver=2.0.1
pkgrel=2.604
pkgdesc='Asahi Linux speaker safety daemon'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/AsahiLinux/speakersafetyd'
license=('MIT')
depends=('glibc' 'gcc-libs' 'alsa-lib')
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz"
        0001-j504-Write-the-full-speaker-names-in-conf.patch
        0002-skip-a-sense-period-read-after-a-probe-closed-the-speakers.patch
        0003-service-keep-the-runtime-directory-across-a-restart.patch
        0004-j604-add-the-J604-board-file-and-its-udev-trigger.patch)
sha256sums=('0e1cb05a2f5521d80f9a502daa0b75ef5c7f2b9e8913b0f88c2d19a97d4439e5'
            '9c1060ca170f52ceb2a68fd1d3c67a31edc4171473b65c239de2115ac8c1870f'
            '40fa32b197413c5a5e2f8c0e4c45e4469d99e3be216cc3c3c05c2a2642105cbe'
            'fa56a4545429f83990caac336a74fb80ec1a874c4aa8439f3b946069346c9a40'
            '8978ae857134bf8e94cc97b1c4916d07182fcd0d2976e1425a0d68c41a0af271')

prepare() {
  cd $pkgname-$pkgver
  patch -p1 --fuzz=0 --no-backup-if-mismatch -i ../0001-j504-Write-the-full-speaker-names-in-conf.patch
  patch -p1 --fuzz=0 --no-backup-if-mismatch -i ../0002-skip-a-sense-period-read-after-a-probe-closed-the-speakers.patch
  patch -p1 --fuzz=0 --no-backup-if-mismatch -i ../0003-service-keep-the-runtime-directory-across-a-restart.patch
  patch -p1 --fuzz=0 --no-backup-if-mismatch -i ../0004-j604-add-the-J604-board-file-and-its-udev-trigger.patch
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $pkgname-$pkgver
  cargo build --frozen --release
}

package() {
  cd $pkgname-$pkgver
  make DESTDIR="$pkgdir" UNITDIR=/usr/lib/systemd/system UDEVDIR=/usr/lib/udev/rules.d install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
