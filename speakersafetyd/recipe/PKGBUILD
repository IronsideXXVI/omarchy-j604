# J604 local build (see README)
# The official asahi-alarm/PKGBUILDs speakersafetyd recipe at 554db4d8ca17 (the package Omarchy installs from
# [asahi-alarm], 2.0.1-1), changed only by: pkgrel 1 -> 1.605 and 0002 (conf/apple/j604.conf = the J604's own
# audump output, Apple's J604 limits, + the AppleJ604 udev line; = the upstream draft), applied in prepare() the way
# the recipe applies its own 0001. 1.604 (t_limit 10 C below the J604 data) was never installed; superseded.
# Maintainer: Jos Dehaes <jos.dehaes@gmail.com>
# Maintainer: Matthias Kurz <m.kurz@irregular.at>

pkgname=speakersafetyd
pkgver=2.0.1
pkgrel=1.605
pkgdesc='Asahi Linux speaker safety daemon'
arch=('aarch64')
url='http://asahilinux.org'
depends=('alsa-lib')
license=('MIT')
source=(
  "speakersafetyd-${pkgver}.tar.gz::https://github.com/AsahiLinux/speakersafetyd/archive/${pkgver}.tar.gz"
  "0001-j504-Write-the-full-speaker-names-in-conf.patch"
  "0002-conf-Add-J604-MacBook-Pro-14-inch-M4.patch"
)
sha256sums=('0e1cb05a2f5521d80f9a502daa0b75ef5c7f2b9e8913b0f88c2d19a97d4439e5'
            '9c1060ca170f52ceb2a68fd1d3c67a31edc4171473b65c239de2115ac8c1870f'
            'f376b7e09682b5e4b9f18689b85037caf93b7cd950c9014dd1dc295c49a0cd20')

prepare() {
  cd $pkgname-$pkgver
  cat ../0001-j504-Write-the-full-speaker-names-in-conf.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
  cat ../0002-conf-Add-J604-MacBook-Pro-14-inch-M4.patch | patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f
}

build() {
  cd "${srcdir}/speakersafetyd-${pkgver}"
  make
}

package() {
  cd "${srcdir}/speakersafetyd-${pkgver}"
  make DESTDIR="${pkgdir}" UNITDIR=/usr/lib/systemd/system UDEVDIR=/usr/lib/udev/rules.d install
}
