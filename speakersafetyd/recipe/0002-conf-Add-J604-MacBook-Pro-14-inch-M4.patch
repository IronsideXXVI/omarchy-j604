From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 5 Nov 2026 07:30:00 +0000
Subject: [PATCH] conf: Add J604 (MacBook Pro 14-inch M4)

The J604 has six SN012776 amps, two woofers and a tweeter per side, like
the J504. docs/audump.py run on its macOS speaker tuning (acoustic ID 30)
prints exactly j504.conf's body, limits included (TemperatureLimit 130 C
woofers, 140 C tweeters; HardTempLimitHeadroom 10 C), and macOS's speaker
tuning for acoustic ID 30 is byte-identical to the J504's (acoustic ID
24). Its device tree lists the amps, and so their V/I sense slots, in
j504.conf's order. The udev rule starts the daemon for the AppleJ604 card.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 95-speakersafetyd.rules |   1 +
 conf/apple/j604.conf    | 147 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 148 insertions(+)
 create mode 100644 conf/apple/j604.conf

diff --git a/95-speakersafetyd.rules b/95-speakersafetyd.rules
index 364270b..7e9338d 100644
--- a/95-speakersafetyd.rules
+++ b/95-speakersafetyd.rules
@@ -27,6 +27,7 @@ KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ504", TAG+="systemd", ENV{SYSTEMD_WANTS}="
 KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ514", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakersafetyd.service"
 KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ516", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakersafetyd.service"
 KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ575", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakersafetyd.service"
+KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ604", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakersafetyd.service"
 KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ613", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakersafetyd.service"
 KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ615", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakersafetyd.service"
 
diff --git a/conf/apple/j604.conf b/conf/apple/j604.conf
new file mode 100644
index 0000000..02f8c5a
--- /dev/null
+++ b/conf/apple/j604.conf
@@ -0,0 +1,147 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Copyright The Asahi Linux Contributors
+#
+# MacBook Pro 14-inch M4 (J604, Mac16,1): six SN012776 amps, two woofers
+# and a tweeter per side.
+#
+# Every value is the J604's own: docs/audump.py run on the J604's macOS
+# speaker tuning (ADT /product/audio acoustic-id 30) prints exactly this
+# file's body, which is also j504.conf's (MacBook Pro 14-inch M3, acoustic
+# ID 24): macOS's speaker tuning for acoustic ID 30 is byte-identical to
+# that for ID 24.
+#   woofers  tr_coil 28.09 tr_magnet 34.43 K/W, tau_coil 3.05 tau_magnet
+#            192.45 s, z_nominal 3.20 ohm, a_t_20c/35c 0.00383214/0.00362404
+#   tweeters tr_coil 34.50 tr_magnet 48.20 K/W, tau_coil 2.31 tau_magnet
+#            61.40 s, z_nominal 3.20 ohm, a_t_20c/35c 0.00354779/0.00329538
+#   z_shunt 0.09 ohm, is_scale 3.75 A and vs_scale 14 V (SN012776 sense
+#   full scale), t_ambient 50 C, t_hysteresis 5 C, t_window 20 C, linked
+#   gains.
+#   t_limit: the tuning's TemperatureLimit, 130 C woofers, 140 C tweeters.
+#   t_headroom: the tuning's HardTempLimitHeadroom, 10 C.
+#
+# Sense layout: the amps report in the order the J604 device tree lists
+# them (ADT speaker-config): left woofer 1, right woofer 1, left woofer 2,
+# right woofer 2, left tweeter, right tweeter. Amp n sends its current on
+# 16-bit channel 2n and its voltage on 2n+1 (ti,imon-slot-no and
+# ti,vmon-slot-no of t8132-j604.dts, in 8-bit units). This is j504.conf's
+# layout, not j314.conf's, which puts the tweeters before the second
+# woofers. Section names equal the amps' sound-name-prefix. visense_pcm 2
+# is macaudio's Speaker Sense front-end.
+
+[Globals]
+visense_pcm = 2
+t_ambient = 50.0
+t_hysteresis = 5.0
+t_window = 20.0
+channels = 12
+period = 4096
+link_gains = True
+uclamp_max = 64
+
+[Controls]
+vsense = VSENSE Switch
+isense = ISENSE Switch
+amp_gain = Amp Gain Volume
+volume = Speaker Volume
+
+[Speaker/Left Woofer 1]
+group = 1
+tr_coil = 28.09
+tr_magnet = 34.43
+tau_coil = 3.05
+tau_magnet = 192.45
+t_limit = 130.0
+t_headroom = 10.0
+z_nominal = 3.20
+z_shunt = 0.09
+a_t_20c = 0.00383214
+a_t_35c = 0.00362404
+is_scale = 3.75
+vs_scale = 14
+is_chan = 0
+vs_chan = 1
+
+[Speaker/Right Woofer 1]
+group = 1
+tr_coil = 28.09
+tr_magnet = 34.43
+tau_coil = 3.05
+tau_magnet = 192.45
+t_limit = 130.0
+t_headroom = 10.0
+z_nominal = 3.20
+z_shunt = 0.09
+a_t_20c = 0.00383214
+a_t_35c = 0.00362404
+is_scale = 3.75
+vs_scale = 14
+is_chan = 2
+vs_chan = 3
+
+[Speaker/Left Woofer 2]
+group = 1
+tr_coil = 28.09
+tr_magnet = 34.43
+tau_coil = 3.05
+tau_magnet = 192.45
+t_limit = 130.0
+t_headroom = 10.0
+z_nominal = 3.20
+z_shunt = 0.09
+a_t_20c = 0.00383214
+a_t_35c = 0.00362404
+is_scale = 3.75
+vs_scale = 14
+is_chan = 4
+vs_chan = 5
+
+[Speaker/Right Woofer 2]
+group = 1
+tr_coil = 28.09
+tr_magnet = 34.43
+tau_coil = 3.05
+tau_magnet = 192.45
+t_limit = 130.0
+t_headroom = 10.0
+z_nominal = 3.20
+z_shunt = 0.09
+a_t_20c = 0.00383214
+a_t_35c = 0.00362404
+is_scale = 3.75
+vs_scale = 14
+is_chan = 6
+vs_chan = 7
+
+[Speaker/Left Tweeter]
+group = 0
+tr_coil = 34.50
+tr_magnet = 48.20
+tau_coil = 2.31
+tau_magnet = 61.40
+t_limit = 140.0
+t_headroom = 10.0
+z_nominal = 3.20
+z_shunt = 0.09
+a_t_20c = 0.00354779
+a_t_35c = 0.00329538
+is_scale = 3.75
+vs_scale = 14
+is_chan = 8
+vs_chan = 9
+
+[Speaker/Right Tweeter]
+group = 0
+tr_coil = 34.50
+tr_magnet = 48.20
+tau_coil = 2.31
+tau_magnet = 61.40
+t_limit = 140.0
+t_headroom = 10.0
+z_nominal = 3.20
+z_shunt = 0.09
+a_t_20c = 0.00354779
+a_t_35c = 0.00329538
+is_scale = 3.75
+vs_scale = 14
