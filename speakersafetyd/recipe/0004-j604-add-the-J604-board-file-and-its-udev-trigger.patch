diff --git a/src/main.rs b/src/main.rs
index d4ffb61..4ebd993 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -417,3 +417,40 @@ fn main() {
         resume_unwind(e);
     }
 }
+
+#[cfg(test)]
+mod j604_config_tests {
+    //! The J604's board file loads and parses the way main() loads it at startup: a missing or broken
+    //! conf/apple/j604.conf fails the package build instead of the daemon on the Mac.
+    use configparser::ini::Ini;
+
+    fn j604() -> Ini {
+        // main(): machine "apple,j604" -> <config base>/apple/j604.conf
+        let (maker, model) = "apple,j604".split_once(",").unwrap();
+        let path = format!("{}/conf/{}/{}.conf", env!("CARGO_MANIFEST_DIR"), maker, model);
+        let mut cfg = Ini::new_cs();
+        cfg.load(&path).unwrap_or_else(|e| panic!("Failed to read config file {}: {}", path, e));
+        cfg
+    }
+
+    #[test]
+    fn j604_board_file_parses_like_startup() {
+        let cfg = j604();
+        let g = crate::types::Globals::parse(&cfg);
+        let speakers = crate::get_speakers(&cfg);
+        assert_eq!(speakers.len(), 6, "the J604 has six speakers");
+        assert!(2 * speakers.len() <= g.channels);
+        for name in speakers {
+            let s = "Speaker/".to_owned() + &name;
+            let _: usize = crate::helpers::parse_int(&cfg, &s, "group");
+            let _: usize = crate::helpers::parse_int(&cfg, &s, "is_chan");
+            let _: usize = crate::helpers::parse_int(&cfg, &s, "vs_chan");
+            for k in ["tau_coil", "tau_magnet", "tr_coil", "tr_magnet", "t_headroom", "z_nominal", "is_scale", "vs_scale"] {
+                assert!(crate::helpers::parse_float(&cfg, &s, k) > 0.0, "{} {}", name, k);
+            }
+            let t_limit = crate::helpers::parse_float(&cfg, &s, "t_limit");
+            // Speaker::new's own startup assert
+            assert!(t_limit - g.t_window > g.t_ambient, "{}", name);
+        }
+    }
+}
