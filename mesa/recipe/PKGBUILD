pkgbase=mesa-aurora
pkgname=('mesa-aurora' 'vulkan-aurora')
epoch=1
# Development versions sort by real UTC date, full reachable commit count,
# then source hash. Hash-only same-day repins can downgrade existing packages.
pkgver=26.3.0_devel.20261122.232644.e705eca833f
pkgrel=1.8303
pkgdesc='Aurora Asahi Gallium, Zink and Honeykrisp'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/omacom/mesa'
license=('MIT')
# omacom/mesa tag aurora-7.3.0-1 (branch carry/aurora-7.3): aurora-silicon/mesa
# aurora-wip at 1fdf5396758f plus our open aurora-silicon/mesa PRs #415 (the
# measured 30-core T6034 G15C, M3 Max) and #416 (the native G15 Vulkan profile).
# Each carry drops out when its PR merges.
# Full-history `git rev-list --count` for this pin is 232644 (not first-parent).
# This Mesa opens the kernel GPU driver named "aurora" and still accepts "asahi".
_commit=e705eca833f365eb4233b255ef82f40c9a0ccbb2
_src=mesa-omacom
# Matched to the DRM UAPI of the 7.3 kernel on the aurora-silicon base.
# The drivers never link SPIRV-Tools, which Arch Linux ARM moves without a
# versioned soname. Asahi needs LLVM only to precompile its CL shaders, so a
# first build makes those compilers and the packaged one uses them. llvmpipe, the
# fallback renderer for a Mac without a working GPU, links the system LLVM, like
# Arch's own mesa: one LLVM per process. mesa-aurora depends on 'libLLVM.so',
# which makepkg turns into the exact soname libgallium links (today libLLVM.so=23.1-64),
# so an LLVM major bump blocks the upgrade until this package is rebuilt for it,
# rather than leaving libgallium without its LLVM.
makedepends=('git' 'meson' 'ninja' 'python-mako' 'python-yaml' 'python-packaging' 'rust'
             'rust-bindgen' 'clang' 'llvm' 'libclc' 'spirv-llvm-translator' 'spirv-tools'
             'cbindgen' 'glslang' 'libdrm' 'expat' 'libglvnd'
             'libx11' 'libxcb' 'libxext' 'libxfixes' 'libxrandr' 'libxshmfence' 'libxxf86vm'
             'wayland' 'wayland-protocols' 'vulkan-headers' 'vulkan-icd-loader' 'libdisplay-info'
             'lm_sensors' 'zlib' 'zstd' 'xcb-util-keysyms')
# Use a distinct VCS cache name when changing repository origin. Existing
# makepkg caches named mesa belong to Aurora and reject a different URL.
# J604 carry (the 1.8192 set rebased on this pin; order = apply order; 0003 #218 dropped: upstream has it):
# 0001 P010/P012/P016 real depth; 0006 G16 Gallium disk-cache key; 0008 keep superseded scratch; 0011 release deleted
# textures and finished batches; 0002 G16G sparse, opt-in ASAHI_G16G_SPARSE=1; 0004/0005 G16 shared negative-zero
# (omacom/mesa#48); 0007 blend dst-first, pixel hoist, host blend src, border twins (#49-#51); 0012 EGL Wayland idle spare-buffer trim;
# 0013 glFlush framebuffer and sampler-view validation (svm v2).
source=("$_src::git+$url.git#commit=$_commit"
        0001-st-mesa-nir-convert-P010-P012-P016-external-images-a.patch
        0006-g16-gallium-cache.patch
        0008-asahi-keep-superseded-device-scratch-buffers-until-t.patch
        0011-asahi-release-deleted-textures-and-finished-batches.patch
        0002-hk-offer-sparse-binding-and-residency-on-G16G-on-req.patch
        0004-g16-nz-experiment.patch
        0005-g16-nz-default.patch
        0007-g16-blend-dst-first-uniform-hoist-host-src-border-twin.patch
        0012-egl-wayland-free-idle-spare-buffers.patch
        0013-mesa-validate-framebuffer-and-sampler-views-at-glFlush.patch)
sha256sums=('SKIP'
            'eca9119577843e3f8713d313dfb9b693c13013850462456308adbf2192c2e61c'
            '267c4da14f14947726b35b5e2a5c56ec242beab437a652025cbe9f95b1f1070f'
            '10765c1133aefa9dd9ab52b62db857bd2712ae0fedb7ccc436956d35ecddc196'
            '9b651b833c2d98a4af1dbebbaebc68695e92229f5430f117566871ef15b75eb6'
            '768d2682a3af292c6833da335e586b9466945d87bd0e33a6d1c1c677b723b732'
            '9da330b74fcbf7f8a40166a107eabaa937fc2f9a568679cf48a6e1b74cdc63fb'
            '8e7a5d119f2523f0c24310c97703e0f3d6284c38f40a6c5c16bbfb59859055c4'
