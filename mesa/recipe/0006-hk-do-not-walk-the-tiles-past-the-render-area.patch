 src/asahi/vulkan/hk_queue.c                   |   8 +
 src/asahi/vulkan/meson.build                  |   9 +
 src/asahi/vulkan/tests/vulkan_render_area.c   | 396 ++++++++++++++++++
 .../vulkan/tests/vulkan_render_area.frag      |  10 +
 .../vulkan/tests/vulkan_render_area.vert      |   9 +
 .../vulkan/tests/vulkan_render_area_shaders.h |  79 ++++
 8 files changed, 518 insertions(+)
 create mode 100644 src/asahi/vulkan/tests/vulkan_render_area.c
 create mode 100644 src/asahi/vulkan/tests/vulkan_render_area.frag
 create mode 100644 src/asahi/vulkan/tests/vulkan_render_area.vert
 create mode 100644 src/asahi/vulkan/tests/vulkan_render_area_shaders.h

diff --git a/src/asahi/vulkan/hk_cmd_buffer.c b/src/asahi/vulkan/hk_cmd_buffer.c
index 49772d7f0d6..039f3989191 100644
--- a/src/asahi/vulkan/hk_cmd_buffer.c
+++ b/src/asahi/vulkan/hk_cmd_buffer.c
@@ -3835,6 +3835,8 @@ hk_cs_init_graphics(struct hk_cmd_buffer *cmd, struct hk_cs *cs)
    }
 
    cs->tib = render->tilebuffer;
+   cs->area_x1 = render->area.offset.x + render->area.extent.width;
+   cs->area_y1 = render->area.offset.y + render->area.extent.height;
    /* Attachmentless rendering defers its API sample count. Publish the
     * native one-sample no-imageblock profile in this control stream while
     * preserving the deferred count in render state. */
diff --git a/src/asahi/vulkan/hk_cmd_buffer.h b/src/asahi/vulkan/hk_cmd_buffer.h
index 38941cb1eb5..0bd5a988687 100644
--- a/src/asahi/vulkan/hk_cmd_buffer.h
+++ b/src/asahi/vulkan/hk_cmd_buffer.h
@@ -1296,6 +1296,11 @@ struct hk_cs {
    /* Remaining state is for graphics only, ignored for compute */
    struct agx_tilebuffer_layout tib;
 
+   /* Bottom-right corner of the render area, or 0 where it is not known (a
+    * secondary command buffer continuing a render pass). Tiles past it hold
+    * nothing the render may change, so the render need not visit them. */
+   uint32_t area_x1, area_y1;
+
    struct util_dynarray scissor, depth_bias;
    uint64_t uploaded_scissor, uploaded_zbias;
 
diff --git a/src/asahi/vulkan/hk_queue.c b/src/asahi/vulkan/hk_queue.c
index 4c7eb7eeee4..5ab808c69fb 100644
--- a/src/asahi/vulkan/hk_queue.c
+++ b/src/asahi/vulkan/hk_queue.c
@@ -196,6 +196,14 @@ asahi_fill_vdm_command(struct hk_device *dev, struct hk_cs *cs,
    c->width_px = empty_attachmentless ? 1 : cs->cr.width;
    c->height_px = empty_attachmentless ? 1 : cs->cr.height;
 
+   /* Draws stay inside the render area and the tiles past its bottom-right
+    * corner keep their contents, so do not walk them: user interfaces render
+    * small areas of full-screen targets. */
+   if (cs->area_x1 && cs->area_y1) {
+      c->width_px = MIN2(c->width_px, cs->area_x1);
+      c->height_px = MIN2(c->height_px, cs->area_y1);
+   }
+
    c->isp_bgobjdepth = cs->cr.isp_bgobjdepth;
    c->isp_bgobjvals = cs->cr.isp_bgobjvals;
 
