From ee8dbbfeb42e21f0a9c9c950f1beb2d27a4046c6 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 23 Nov 2026 16:30:00 +0000
Subject: [PATCH 10/10] mesa: validate framebuffer and sampler views at glFlush

Deleting a texture that is still the bound render target or a bound
sampler view only marks that state dirty. The pipe context keeps its
reference until the next draw validates the state again. A compositor
that frees its spare render targets on a timer and then goes idle keeps
one of them allocated until it draws the next frame, which on an idle
desktop can be minutes.

In _mesa_flush, apply pending state changes and validate the framebuffer
and sampler view atoms before flushing, so the driver drops those
references and the flush can retire the storage. When nothing is dirty
this is a couple of bit tests.

This is kept out of st_glFlush on purpose: _mesa_make_current also calls
st_glFlush when it releases a context, and _mesa_free_context_data does
that after the context's shared state, programs and framebuffers are
gone. Validating there dereferences the freed state. Any client that
destroys a GL context while it is current hits it; Qt Quick does when
a window is first exposed, through its fallback surface probe.
---
 src/mesa/main/context.c              |  1 +
 src/mesa/state_tracker/st_cb_flush.c | 29 ++++++++++++++++++++++++++++
 src/mesa/state_tracker/st_cb_flush.h |  1 +
 3 files changed, 31 insertions(+)

diff --git a/src/mesa/main/context.c b/src/mesa/main/context.c
index 5b6c691b680..2883ad64b6b 100644
--- a/src/mesa/main/context.c
+++ b/src/mesa/main/context.c
@@ -1619,6 +1619,7 @@ _mesa_flush(struct gl_context *ctx)
    bool async = !ctx->Shared->HasExternallySharedImages;
    FLUSH_VERTICES(ctx, 0, 0);
 
+   st_validate_for_flush(ctx);
    st_glFlush(ctx, async ? PIPE_FLUSH_ASYNC : 0);
 }
 
diff --git a/src/mesa/state_tracker/st_cb_flush.c b/src/mesa/state_tracker/st_cb_flush.c
index 8e92ce5214f..f8b87d45a62 100644
--- a/src/mesa/state_tracker/st_cb_flush.c
+++ b/src/mesa/state_tracker/st_cb_flush.c
@@ -34,12 +34,15 @@
 #include "util/glheader.h"
 #include "main/macros.h"
 #include "main/context.h"
+#include "main/state.h"
 #include "st_context.h"
 #include "st_cb_bitmap.h"
 #include "st_cb_flush.h"
 #include "st_cb_clear.h"
 #include "st_context.h"
 #include "st_manager.h"
+#include "st_atom.h"
+#include "st_util.h"
 #include "pipe/p_context.h"
 #include "pipe/p_defines.h"
 #include "pipe/p_screen.h"
@@ -86,6 +89,31 @@ st_finish(struct st_context *st)
 }
 
 
+
+/**
+ * Bring the framebuffer and sampler view state up to date ahead of a flush.
+ *
+ * A texture deleted since the last draw (a framebuffer attachment, or one
+ * still bound for sampling) stays referenced by the bound pipe state until
+ * the next draw validates it. A client that goes idle right after deleting
+ * it would keep its memory until it draws again. Only for a live, current
+ * context: not from the flush on context release, which also runs while a
+ * context is being torn down and its state is already freed.
+ */
+void
+st_validate_for_flush(struct gl_context *ctx)
+{
+   struct st_context *st = st_context(ctx);
+   st_state_bitset mask = {0};
+
+   if (ctx->NewState)
+      _mesa_update_state(ctx);
+
+   ST_SET_STATE(mask, ST_NEW_FB_STATE);
+   ST_SET_SHADER_STATES(mask, SAMPLER_VIEWS);
+   st_validate_state(st, mask);
+}
+
 void
 st_glFlush(struct gl_context *ctx, unsigned gallium_flush_flags)
 {
@@ -96,6 +124,7 @@ st_glFlush(struct gl_context *ctx, unsigned gallium_flush_flags)
     * synchronization issues.  Calling finish() here will just hide
     * problems that need to be fixed elsewhere.
     */
+
    st_flush(st, NULL, gallium_flush_flags);
 
    st_manager_flush_frontbuffer(st);
diff --git a/src/mesa/state_tracker/st_cb_flush.h b/src/mesa/state_tracker/st_cb_flush.h
index 72029cc7a1e..7a5c0e9a4a1 100644
--- a/src/mesa/state_tracker/st_cb_flush.h
+++ b/src/mesa/state_tracker/st_cb_flush.h
@@ -40,6 +40,7 @@ extern void
 st_init_flush_functions(struct pipe_screen *screen,
                         struct dd_function_table *functions);
 
+void st_validate_for_flush(struct gl_context *ctx);
 void st_glFlush(struct gl_context *ctx, unsigned gallium_flush_flags);
 void st_glFinish(struct gl_context *ctx);
 
