From 6a062613f4ea0dbc81bc94a7c06f3459aa69a864 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 13:36:27 +0000
Subject: [PATCH 07/10] asahi: enable qualified G16 shared negative-zero
 materialization

J604 M4 render.heavy fill median drops from 371.494 to 348.73585 us in balanced same-boot old/off/on/on/off/old runs. All finite blend readbacks match and each arm has zero GPU faults. Retain ASAHI_G16_SHARED_NZ=0 opt-out and separate linked-program logging. This does not qualify constant-program launch or claim macOS parity.

(cherry picked from commit 4174d4a196a35ea0d3fad37ca31c32df10472e88)
---
 src/asahi/compiler/agx_compile.c                         | 6 ++++++
 src/asahi/compiler/agx_debug.h                           | 3 +++
 src/asahi/compiler/agx_lower_uniform_sources.c           | 2 +-
 src/asahi/compiler/test/test-native-form-regressions.cpp | 6 +++---
 src/asahi/vulkan/hk_shader.c                             | 2 +-
 5 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/src/asahi/compiler/agx_compile.c b/src/asahi/compiler/agx_compile.c
index d56116c9573..b4bfe6654df 100644
--- a/src/asahi/compiler/agx_compile.c
+++ b/src/asahi/compiler/agx_compile.c
@@ -84,6 +84,12 @@ agx_pad_binary(struct util_dynarray *dyn, uint32_t align)
    return dyn->size;
 }
 
+bool
+agx_g16_shared_nz_enabled(void)
+{
+   return debug_get_bool_option("ASAHI_G16_SHARED_NZ", true);
+}
+
 uint64_t
 agx_get_compiler_debug(void)
 {
diff --git a/src/asahi/compiler/agx_debug.h b/src/asahi/compiler/agx_debug.h
index ed4bc6963d8..1f0abf8452c 100644
--- a/src/asahi/compiler/agx_debug.h
+++ b/src/asahi/compiler/agx_debug.h
@@ -39,6 +39,9 @@ enum agx_compiler_dbg {
 
 uint64_t agx_get_compiler_debug(void);
 
+/* Qualified on G16G; ASAHI_G16_SHARED_NZ=0 restores legacy materialization. */
+bool agx_g16_shared_nz_enabled(void);
+
 /* Why the last agx_compile_shader_nir() on this thread returned false
  * ("" when it succeeded), for the driver's "cannot encode" error. */
 const char *agx_last_compile_refusal(void);
diff --git a/src/asahi/compiler/agx_lower_uniform_sources.c b/src/asahi/compiler/agx_lower_uniform_sources.c
index 8f9121cb051..5f0baaf8d9f 100644
--- a/src/asahi/compiler/agx_lower_uniform_sources.c
+++ b/src/asahi/compiler/agx_lower_uniform_sources.c
@@ -679,7 +679,7 @@ agx_lower_uniform_sources(agx_context *ctx)
    /* Preserve the exact f32 add and saturation. Only change which operand
     * satisfies the existing mixed uniform/GPR encoding contract. */
    if (ctx->key->dev.chip == AGX_CHIP_G16G && !ctx->is_preamble &&
-       (agx_get_compiler_debug() & AGX_DBG_G16_NZ)) {
+       agx_g16_shared_nz_enabled()) {
       agx_foreach_block(ctx, block) {
          agx_index zero = agx_null();
          agx_foreach_instr_in_block_safe(block, I) {
diff --git a/src/asahi/compiler/test/test-native-form-regressions.cpp b/src/asahi/compiler/test/test-native-form-regressions.cpp
index be241bff62a..b4ce1da0249 100644
--- a/src/asahi/compiler/test/test-native-form-regressions.cpp
+++ b/src/asahi/compiler/test/test-native-form-regressions.cpp
@@ -7447,7 +7447,7 @@ TEST(NativeForms, G16SharedNegativeZero)
       adds[c]->saturate = true;
    }
    agx_lower_uniform_sources(b->shader);
-   bool enabled = agx_get_compiler_debug() & AGX_DBG_G16_NZ;
+   bool enabled = agx_g16_shared_nz_enabled();
    for (unsigned c = 0; c < 4; ++c) {
       EXPECT_TRUE(adds[c]->saturate);
       EXPECT_EQ(adds[c]->op, AGX_OPCODE_FADD);
@@ -7499,7 +7499,7 @@ TEST(NativeForms, G16CapturedBlend)
    key.fs.nr_samples=1;
    agx_shader_part part={};
    ASSERT_TRUE(agx_compile_shader_nir(b.shader,&key,&part));
-   bool enabled = agx_get_compiler_debug() & AGX_DBG_G16_NZ;
+   bool enabled = agx_g16_shared_nz_enabled();
    EXPECT_EQ(part.info.stats.instrs, enabled ? 22u : 25u);
    EXPECT_EQ(part.info.binary_size, enabled ? 170u : 178u);
    fprintf(stderr,"G16 CAPTURED: instructions=%u bytes=%u gprs=%u spills=%u\n",
@@ -7523,7 +7523,7 @@ TEST(NativeForms, G16NegativeZeroBoundaries)
          I->saturate=saturate;
          agx_lower_uniform_sources(b->shader);
          bool eligible=saturate && imm==0x80 &&
-                       (agx_get_compiler_debug() & AGX_DBG_G16_NZ);
+                       agx_g16_shared_nz_enabled();
          EXPECT_EQ(I->src[0].type,eligible ? AGX_INDEX_UNIFORM : AGX_INDEX_NORMAL);
          EXPECT_EQ(I->saturate,saturate);
          EXPECT_EQ(I->op,AGX_OPCODE_FADD);
diff --git a/src/asahi/vulkan/hk_shader.c b/src/asahi/vulkan/hk_shader.c
index 270f527ac83..4a082f9a05a 100644
--- a/src/asahi/vulkan/hk_shader.c
+++ b/src/asahi/vulkan/hk_shader.c
@@ -211,7 +211,7 @@ hk_physical_device_compiler_flags(const struct hk_physical_device *pdev)
    /* This could be optimized but it doesn't matter. */
    return pdev->dev.debug |
           hk_fs_structure_key_bits() |
-          ((uint64_t)!!(agx_get_compiler_debug() & AGX_DBG_G16_NZ) << 31);
+          ((uint64_t)!!agx_g16_shared_nz_enabled() << 31);
 }
 
 const nir_shader_compiler_options *
-- 
