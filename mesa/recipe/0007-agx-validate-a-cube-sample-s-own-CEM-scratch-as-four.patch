From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DjDeveloperr <hey@djdev.me>
Date: Thu, 29 Oct 2026 13:06:26 -0400
Subject: [PATCH 7/9] agx: validate a cube sample's own CEM scratch as four
 words

agx3_reserve_cube_scratch gives an AGX3B cube sample a seventh source,
the four-word vector the packer computes CEM in. The validator modelled
that source like any other 32-bit texture source, two halves wide, so a
build with assertions rejected every shader with such a sample ("source
6, expected width 2, got width 8 ... Invalid vectors after cube-array
scratch") and exited. That broke the gallium blit tests on debug builds.
Release builds skip validation, and RA and the packer already size the
scratch from its vector, so the generated code is unchanged.

Read source 6 of a seven-source texture sample as eight halves, and
validate a cube and a cube-array sample before and after the pass in the
cube scratch test.

(cherry picked from commit 4222ab487edbf064c4dd10fcee9d113822adc942)
---
 src/asahi/compiler/agx_validate.c             |  5 ++++
 .../compiler/test/test-agx3-cube-scratch.cpp  | 28 +++++++++++++++++++
 2 files changed, 33 insertions(+)

diff --git a/src/asahi/compiler/agx_validate.c b/src/asahi/compiler/agx_validate.c
index 7e39d8ac903..417b3df42db 100644
--- a/src/asahi/compiler/agx_validate.c
+++ b/src/asahi/compiler/agx_validate.c
@@ -488,6 +488,11 @@ agx_read_registers(const agx_context *ctx, const agx_instr *I, unsigned s)
           * its existing compare/offset collect. */
          return agx_is_null(I->src[s]) ? 0
                                       : 2 * agx_channels(I->src[s]);
+      } else if (s == 6 && I->op == AGX_OPCODE_TEXTURE_SAMPLE &&
+                 I->nr_srcs == 7) {
+         /* A cube sample's own CEM scratch (agx3_reserve_cube_scratch): the
+          * four words the packer computes CEM in. */
+         return 8;
       } else {
          return size;
       }
diff --git a/src/asahi/compiler/test/test-agx3-cube-scratch.cpp b/src/asahi/compiler/test/test-agx3-cube-scratch.cpp
index 257fe072e32..f1b94b8e652 100644
--- a/src/asahi/compiler/test/test-agx3-cube-scratch.cpp
+++ b/src/asahi/compiler/test/test-agx3-cube-scratch.cpp
@@ -65,3 +65,31 @@ TEST(AGX3CubeScratch, CubeSamplesReadAnUndefinedScratchVector)
    EXPECT_FALSE(agx3_reserve_cube_scratch(b->shader));
    ralloc_free(mem);
 }
+
+/* A cube sample that reads its scratch is valid IR: the scratch source is
+ * four words wide. agx_validate checks only in builds with assertions. */
+TEST(AGX3CubeScratch, ScratchSourceValidates)
+{
+   void *mem = ralloc_context(NULL);
+   agx_shader_key key = {};
+   key.dev.encoding = AGX_ISA_ENCODING_AGX3B;
+   agx_builder *b = agx_test_builder(mem);
+   b->shader->key = &key;
+   for (unsigned array = 0; array < 2; ++array) {
+      const unsigned comps = 3 + array;
+      agx_index coords = agx_vec_temp(b->shader, AGX_SIZE_32, comps);
+      agx_instr *collect = agx_collect_to(b, coords, comps);
+      agx_foreach_src(collect, c)
+         collect->src[c] = agx_undef(AGX_SIZE_32);
+      agx_texture_sample_to(b, agx_vec_temp(b->shader, AGX_SIZE_16, 4), coords,
+                            agx_immediate(0), agx_immediate(0),
+                            agx_immediate(0), agx_immediate(0), agx_null(),
+                            array ? AGX_DIM_CUBE_ARRAY : AGX_DIM_CUBE,
+                            AGX_LOD_MODE_AUTO_LOD, 0xf, false, false, false,
+                            AGX_GATHER_NONE, false);
+   }
+   agx_validate(b->shader, "cube sample test shader");
+   ASSERT_TRUE(agx3_reserve_cube_scratch(b->shader));
+   agx_validate(b->shader, "cube-array scratch");
+   ralloc_free(mem);
+}
