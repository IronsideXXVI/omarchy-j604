From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sat, 31 Oct 2026 17:02:12 +1100
Subject: [PATCH 8/9] hk: consume start timestamps when native compute reuses a
 stream

Query reset can leave the general compute stream open. A following
TOP_OF_PIPE timestamp stays pending until stream creation, but native
compute can reuse the reset stream instead. When BOTTOM_OF_PIPE resolves
the pending start, it becomes the completed dispatches' end stamp and the
finish is placed on a separate tiny carrier. The measured interval then
excludes the dispatches.

Extend the existing M5 reuse handling to native graphics: request a stream
check for a pending start and consume it before recording work into the
reused stream. Both timestamps can ride on the dispatches' existing
command without another launch or execution dependency.

Exercise reset-stream reuse and submission resolution with exact prior
barriers both enabled and disabled, including the command count and end
boundary.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit 0cce7da835f89299d159cfc5b63b777e60418653)
---
 src/asahi/vulkan/hk_sync.c                  |  9 +++-
 src/asahi/vulkan/tests/test-hk-sync-prior.c | 48 +++++++++++++++++++++
 2 files changed, 55 insertions(+), 2 deletions(-)

diff --git a/src/asahi/vulkan/hk_sync.c b/src/asahi/vulkan/hk_sync.c
index 80dd841ba96..df594c48d4f 100644
--- a/src/asahi/vulkan/hk_sync.c
+++ b/src/asahi/vulkan/hk_sync.c
@@ -973,7 +973,8 @@ hk_sync_check_cs(struct hk_cmd_buffer *cmd)
       cs->sync.kind |= HK_SYNC_GFX_MEM;
    note_last(cmd, cs);
 
-   if (agx_chip_g17_m5(hk_cmd_buffer_device(cmd)->dev.chip) &&
+   if ((agx_native_graphics(&hk_cmd_buffer_device(cmd)->dev) ||
+        agx_chip_g17_m5(hk_cmd_buffer_device(cmd)->dev.chip)) &&
        cmd->sync.pending_start_ts.handle && !cs->timestamp.start.handle &&
        !cs->timestamp.end.handle) {
       cs->timestamp.start = cmd->sync.pending_start_ts;
@@ -1331,7 +1332,11 @@ hk_sync_write_timestamp(struct hk_cmd_buffer *cmd, VkPipelineStageFlags2 stage,
    if (!src_kinds) {
       hk_sync_flush_pending_timestamp(cmd);
       st->pending_start_ts = req;
-      if (agx_chip_g17_m5(hk_cmd_buffer_device(cmd)->dev.chip))
+      /* A query reset or earlier dispatch may have left a reusable stream.
+       * Consume the start stamp before recording work into it too, rather
+       * than resolving it as an end stamp at the next timestamp write. */
+      if (agx_native_graphics(&hk_cmd_buffer_device(cmd)->dev) ||
+          agx_chip_g17_m5(hk_cmd_buffer_device(cmd)->dev.chip))
          st->cs_check_pending = true;
       return;
    }
diff --git a/src/asahi/vulkan/tests/test-hk-sync-prior.c b/src/asahi/vulkan/tests/test-hk-sync-prior.c
index fdc5e2c6e49..3b5e7c5184d 100644
--- a/src/asahi/vulkan/tests/test-hk-sync-prior.c
+++ b/src/asahi/vulkan/tests/test-hk-sync-prior.c
@@ -118,6 +118,53 @@ end_timestamp(struct hk_cmd_buffer *cmd, uint32_t query)
    hk_sync_write_timestamp(cmd, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, req);
 }
 
+/* ResetQueryPool leaves a reusable compute stream. TOP_OF_PIPE must become
+ * its start stamp before a following dispatch reuses it; otherwise resolving
+ * the pending start at BOTTOM_OF_PIPE puts both stamps after the work.
+ */
+static void
+test_timestamp_reused_compute(void)
+{
+   for (unsigned exact = 0; exact < 2; ++exact) {
+      struct hk_cmd_buffer *cmd = timestamp_cmd(AGX_CHIP_G17P, exact);
+      cmd->sync.kind_override = HK_SYNC_ALL;
+      struct hk_cs *reset = add(cmd, true);
+      cmd->sync.kind_override = 0;
+      cmd->current_cs.cs = reset;
+      reset->g17p_timestamp_query = true;
+      reset->stats.cmds = 1;
+      hk_sync_after_stream(cmd, reset, HK_SYNC_ALL);
+
+      const struct agx_timestamp_req start = {
+         .handle = 1, .addr = 0x10000, .offset_B = 0};
+      hk_sync_write_timestamp(cmd, VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT, start);
+      T("top timestamp requests a check of the reused compute stream",
+        cmd->sync.cs_check_pending);
+
+      struct hk_cs *dispatch = hk_cmd_buffer_get_cs(cmd, true);
+      T("timed dispatch reuses the reset stream", dispatch == reset);
+      T("top timestamp is consumed before the reused dispatch",
+        !cmd->sync.pending_start_ts.handle &&
+        dispatch->timestamp.start.handle == start.handle &&
+        dispatch->timestamp.start.offset_B == start.offset_B &&
+        dispatch->timestamp.start.addr == start.addr);
+      /* A broken placement would need another payload-producing stream,
+       * outside this CPU fixture, when recording the end stamp. */
+      if (cmd->sync.pending_start_ts.handle)
+         continue;
+
+      dispatch->stats.cmds++;
+      end_timestamp(cmd, 1);
+      T("bottom timestamp ends the dispatch's command",
+        dispatch->timestamp.end.handle == 1 &&
+        dispatch->timestamp.end.offset_B == 8);
+      T("timestamp pair needs no extra compute command",
+        list_is_singular(&cmd->control_streams));
+      T("bottom timestamp closes the timed stream", !cmd->current_cs.cs);
+      T("timed reset and dispatch resolve", submit(new_queue(exact), cmd));
+   }
+}
+
 /* Exercise actual timestamp placement, barriers and the submission resolver.
  * Existing query-command scopes are not removed by the timestamp scope's
  * redundant same-engine execution edge. No command payload or GPU is needed.
@@ -1281,6 +1328,7 @@ main(void)
    test_chain_first_skips_empty_buffers();
    test_rt_kernel_gate();
    test_timestamp_execution_scopes();
+   test_timestamp_reused_compute();
    /* Each matching destination retains the exact old source prefix, including
     * reuse of a recording and independent physical destinations on the queue. */
    struct hk_queue *q = new_queue(true);
