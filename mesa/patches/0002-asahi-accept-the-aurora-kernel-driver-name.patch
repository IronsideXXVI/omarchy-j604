+++ b/src/gallium/winsys/kmsro/drm/kmsro_drm_winsys.c
@@ -87,7 +87,9 @@ kmsro_screen_create(int kms_fd, const struct pipe_screen_config *config,
       util_sparse_array_init(&ro->bo_map, sizeof(struct renderonly_scanout), 64);
       simple_mtx_init(&ro->bo_map_lock, mtx_plain);
 
-      if (!force_zink && strcmp(render_dev_name, "asahi") == 0) {
+      /* "aurora" is the native AGX kernel driver; "asahi" is its older name. */
+      if (!force_zink && (strcmp(render_dev_name, "aurora") == 0 ||
+                          strcmp(render_dev_name, "asahi") == 0)) {
 #if defined(GALLIUM_ASAHI)
          ro->create_for_resource = renderonly_create_gpu_import_for_resource;
          screen = asahi_drm_screen_create_renderonly(ro->gpu_fd, ro, config);
diff --git a/src/util/tests/drirc_configdir/00-test.conf b/src/util/tests/drirc_configdir/00-test.conf
index 4ec89240fdf..b22c1de434d 100644
--- a/src/util/tests/drirc_configdir/00-test.conf
+++ b/src/util/tests/drirc_configdir/00-test.conf
@@ -56,4 +56,9 @@
             <option name="mesa_drirc_option" value="8" />
         </application>
     </device>
+    <device driver="driver">
+        <application name="Alias Application" executable="app_alias">
+            <option name="mesa_drirc_option" value="11" />
+        </application>
+    </device>
 </driconf>
diff --git a/src/util/tests/xmlconfig.cpp b/src/util/tests/xmlconfig.cpp
index da922eb9573..e8e5faecf01 100644
--- a/src/util/tests/xmlconfig.cpp
+++ b/src/util/tests/xmlconfig.cpp
@@ -259,6 +259,35 @@ TEST_F(xmlconfig_test, drirc_env_override)
 }
 
 #if WITH_XMLCONFIG
+TEST_F(xmlconfig_test, drirc_driver_alias)
+{
+   driInjectExecName("app_alias");
+
+   driOptionDescription driconf[] = {
+      DRI_CONF_SECTION_MISCELLANEOUS
+      DRI_CONF_OPT_I(mesa_drirc_option, 0, 0, 200, "description")
+   };
+   driParseOptionInfo(&options, driconf, ARRAY_SIZE(driconf));
+
+   /* A section for "driver" applies to a driver renamed to "renamed" that
+    * keeps "driver" as its alias, and not to one without the alias.
+    */
+   driOptionCache cache;
+   driConfigFileParseParams params = {
+      .driverName = "renamed",
+      .driverNameAlias = "driver",
+      .kernelDriverName = "drm",
+   };
+   driParseConfigFiles(&cache, &options, &params);
+   EXPECT_EQ(driQueryOptioni(&cache, "mesa_drirc_option"), 11);
+   driDestroyOptionCache(&cache);
+
+   params.driverNameAlias = NULL;
+   driParseConfigFiles(&cache, &options, &params);
+   EXPECT_EQ(driQueryOptioni(&cache, "mesa_drirc_option"), 0);
+   driDestroyOptionCache(&cache);
+}
+
 TEST_F(xmlconfig_test, drirc_app_versioned)
 {
    driOptionCache cache = drirc_init("driver", "drm",
diff --git a/src/util/xmlconfig.c b/src/util/xmlconfig.c
index c3972bb61df..03e8e3d8403 100644
--- a/src/util/xmlconfig.c
+++ b/src/util/xmlconfig.c
@@ -654,7 +654,7 @@ struct OptConfData {
 #endif
    driOptionCache *cache;
    int screenNum;
-   const char *driverName, *execName;
+   const char *driverName, *driverNameAlias, *execName;
    const char *kernelDriverName;
    const char *deviceName;
    uint32_t deviceVersion;
@@ -736,7 +736,8 @@ parseDeviceAttr(struct OptConfData *data, const char **attr)
       else if (!strcmp(attr[i], "device_version_regexp")) device_version_regexp = attr[i+1];
       else XML_WARNING("unknown device attribute: %s.", attr[i]);
    }
-   if (driver && strcmp(driver, data->driverName))
+   if (driver && strcmp(driver, data->driverName) &&
+       (!data->driverNameAlias || strcmp(driver, data->driverNameAlias)))
       data->ignoringDevice = data->inDevice;
    else if (kernel && (!data->kernelDriverName ||
                        strcmp(kernel, data->kernelDriverName)))
@@ -1440,6 +1441,7 @@ driParseConfigFiles(driOptionCache *cache, const driOptionCache *info,
    userData.cache = cache;
    userData.screenNum = params->screenNum;
    userData.driverName = params->driverName;
+   userData.driverNameAlias = params->driverNameAlias;
    userData.kernelDriverName = params->kernelDriverName;
    userData.deviceName = params->deviceName;
    userData.deviceVersion = params->deviceVersion;
diff --git a/src/util/xmlconfig.h b/src/util/xmlconfig.h
index 56d9b63acf6..b55fe2d72dc 100644
--- a/src/util/xmlconfig.h
+++ b/src/util/xmlconfig.h
@@ -138,6 +138,10 @@ typedef void (*driShaderOptionCallback)(const void *hash_data,
 typedef struct {
    int screenNum;
    const char *driverName;
+   /* Optional second name a renamed driver still answers to in
+    * <device driver="...">, so existing configuration keeps applying.
+    */
+   const char *driverNameAlias;
    const char *kernelDriverName;
    const char *deviceName;
    uint32_t deviceVersion;
