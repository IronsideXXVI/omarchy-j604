 #if defined GALLIUM_ETNAVIV
diff --git a/src/gallium/auxiliary/target-helpers/drm_helper.h b/src/gallium/auxiliary/target-helpers/drm_helper.h
index 2e1969dd34d..5b9be2adbc1 100644
--- a/src/gallium/auxiliary/target-helpers/drm_helper.h
+++ b/src/gallium/auxiliary/target-helpers/drm_helper.h
@@ -353,9 +353,14 @@ const driOptionDescription asahi_driconf[] = {
       #include "asahi/driinfo_asahi.h"
 };
 DRM_DRIVER_DESCRIPTOR(asahi, asahi_driconf, ARRAY_SIZE(asahi_driconf))
+/* The kernel driver is "aurora"; "asahi" stays for older kernels and for
+ * MESA_LOADER_DRIVER_OVERRIDE and dri_driver settings that name it.
+ */
+DRM_DRIVER_DESCRIPTOR_ALIAS(asahi, aurora, asahi_driconf, ARRAY_SIZE(asahi_driconf))
 
 #else
 DRM_DRIVER_DESCRIPTOR_STUB(asahi)
+DRM_DRIVER_DESCRIPTOR_STUB(aurora)
 #endif
 
 #ifdef GALLIUM_ETNAVIV
diff --git a/src/gallium/auxiliary/target-helpers/drm_helper_public.h b/src/gallium/auxiliary/target-helpers/drm_helper_public.h
index fe0e12280f6..6cd07b95bcd 100644
--- a/src/gallium/auxiliary/target-helpers/drm_helper_public.h
+++ b/src/gallium/auxiliary/target-helpers/drm_helper_public.h
@@ -19,6 +19,7 @@ extern const struct drm_driver_descriptor v3d_driver_descriptor;
 extern const struct drm_driver_descriptor vc4_driver_descriptor;
 extern const struct drm_driver_descriptor panfrost_driver_descriptor;
 extern const struct drm_driver_descriptor panthor_driver_descriptor;
+extern const struct drm_driver_descriptor aurora_driver_descriptor;
 extern const struct drm_driver_descriptor asahi_driver_descriptor;
 extern const struct drm_driver_descriptor etnaviv_driver_descriptor;
 extern const struct drm_driver_descriptor rknpu_driver_descriptor;
diff --git a/src/gallium/drivers/asahi/agx_pipe.c b/src/gallium/drivers/asahi/agx_pipe.c
index c769f062345..2b873dcf743 100644
--- a/src/gallium/drivers/asahi/agx_pipe.c
+++ b/src/gallium/drivers/asahi/agx_pipe.c
@@ -2656,7 +2656,10 @@ agx_screen_create(int fd, struct renderonly *ro,
 
    /* parse driconf configuration now for device specific overrides */
    driParseConfigFiles(config->options, config->options_info,
-                       &(driConfigFileParseParams) { .driverName = "asahi" });
+                       &(driConfigFileParseParams) {
+                          .driverName = "aurora",
+                          .driverNameAlias = "asahi",
+                       });
 
    agx_screen->dev.fd = fd;
    agx_screen->dev.ro = ro;
diff --git a/src/gallium/targets/dril/dril_target.c b/src/gallium/targets/dril/dril_target.c
index b5ba5180cbd..9bd61948fc8 100644
--- a/src/gallium/targets/dril/dril_target.c
+++ b/src/gallium/targets/dril/dril_target.c
@@ -646,6 +646,7 @@ DEFINE_LOADER_DRM_ENTRYPOINT(vc4)
 DEFINE_LOADER_DRM_ENTRYPOINT(panfrost)
 DEFINE_LOADER_DRM_ENTRYPOINT(panthor)
 DEFINE_LOADER_DRM_ENTRYPOINT(apple)
+DEFINE_LOADER_DRM_ENTRYPOINT(aurora)
 DEFINE_LOADER_DRM_ENTRYPOINT(asahi)
 DEFINE_LOADER_DRM_ENTRYPOINT(etnaviv)
 DEFINE_LOADER_DRM_ENTRYPOINT(tegra)
diff --git a/src/gallium/targets/dril/meson.build b/src/gallium/targets/dril/meson.build
index 55f10dc7805..18ff3b1a2ff 100644
--- a/src/gallium/targets/dril/meson.build
