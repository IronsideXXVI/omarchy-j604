 src/asahi/lib/agx_device.h                    | 15 ++++++++++
 src/asahi/vulkan/hk_physical_device.c         |  2 +-
 src/broadcom/simulator/v3d_simulator.c        |  3 +-
 .../auxiliary/pipe-loader/pipe_loader_drm.c   |  2 ++
 .../auxiliary/target-helpers/drm_helper.h     |  5 ++++
 .../target-helpers/drm_helper_public.h        |  1 +
 src/gallium/drivers/asahi/agx_pipe.c          |  5 +++-
 src/gallium/targets/dril/dril_target.c        |  1 +
 src/gallium/targets/dril/meson.build          |  2 +-
 .../winsys/kmsro/drm/kmsro_drm_winsys.c       |  4 ++-
 src/util/tests/drirc_configdir/00-test.conf   |  5 ++++
 src/util/tests/xmlconfig.cpp                  | 29 +++++++++++++++++++
