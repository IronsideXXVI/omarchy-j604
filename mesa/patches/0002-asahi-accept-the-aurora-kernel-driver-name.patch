diff --git a/src/asahi/lib/agx_device.c b/src/asahi/lib/agx_device.c
index b24942a8eba..4e40409d2f6 100644
--- a/src/asahi/lib/agx_device.c
+++ b/src/asahi/lib/agx_device.c
@@ -890,10 +890,15 @@ agx_open_device(void *memctx, struct agx_device *dev)
          goto fail;
       }
 
-      if (!strcmp(version->name, "asahi")) {
+      if (agx_is_native_drm_driver(version->name)) {
          dev->is_virtio = false;
-         dev->render_rsrc_spec_hi = version->version_major > 0 ||
-                                   version->version_minor >= 2;
+         /* The 0.2 rule describes the "asahi" numbering only. The "aurora"
+          * kernel versions its UAPI separately and gates the high dwords on
+          * DRM_ASAHI_RENDER_RSRC_SPEC_HI per runtime.
+          */
+         dev->render_rsrc_spec_hi =
+            !strcmp(version->name, AGX_DRM_DRIVER_NAME_LEGACY) &&
+            (version->version_major > 0 || version->version_minor >= 2);
          dev->ops = agx_device_drm_ops;
       } else if (!strcmp(version->name, "virtio_gpu")) {
          dev->is_virtio = true;
diff --git a/src/asahi/lib/agx_device.h b/src/asahi/lib/agx_device.h
index d53e5eeddcc..3e615d11752 100644
--- a/src/asahi/lib/agx_device.h
+++ b/src/asahi/lib/agx_device.h
@@ -6,6 +6,7 @@
 #pragma once
 
 #include <stdint.h>
+#include <string.h>
 #ifdef HAVE_LIBDRM
 #include <xf86drm.h>
 #endif
@@ -35,6 +36,20 @@ struct vdrm_device;
 struct asahi_ccmd_submit_res;
 #endif
 
+/* DRM name of the native kernel driver. Kernels before the Aurora rename
+ * report "asahi", so both are accepted and Mesa and the kernel can update in
+ * either order.
+ */
+#define AGX_DRM_DRIVER_NAME        "aurora"
+#define AGX_DRM_DRIVER_NAME_LEGACY "asahi"
+
+static inline bool
+agx_is_native_drm_driver(const char *name)
+{
+   return name && (!strcmp(name, AGX_DRM_DRIVER_NAME) ||
+                   !strcmp(name, AGX_DRM_DRIVER_NAME_LEGACY));
+}
+
 enum agx_dbg {
    AGX_DBG_TRACE = BITFIELD_BIT(0),
    AGX_DBG_BODUMP = BITFIELD_BIT(1),
diff --git a/src/asahi/vulkan/hk_physical_device.c b/src/asahi/vulkan/hk_physical_device.c
index ac48a0805b1..85721e325fc 100644
--- a/src/asahi/vulkan/hk_physical_device.c
+++ b/src/asahi/vulkan/hk_physical_device.c
@@ -1873,7 +1873,7 @@ hk_create_drm_physical_device(struct vk_instance *_instance,
       goto fail_fd;
    }
 
-   bool is_asahi = (strcmp(version->name, "asahi") == 0);
+   bool is_asahi = agx_is_native_drm_driver(version->name);
    is_asahi |= strcmp(version->name, "virtio_gpu") == 0;
    drmFreeVersion(version);
 
diff --git a/src/broadcom/simulator/v3d_simulator.c b/src/broadcom/simulator/v3d_simulator.c
index bf353beb9ef..af325e6af1b 100644
--- a/src/broadcom/simulator/v3d_simulator.c
+++ b/src/broadcom/simulator/v3d_simulator.c
@@ -1224,7 +1224,8 @@ v3d_simulator_init(int fd)
                 sim_file->gem_type = GEM_I915;
         else if (version && strncmp(version->name, "amdgpu", version->name_len) == 0)
                 sim_file->gem_type = GEM_AMDGPU;
-        else if (version && strncmp(version->name, "asahi", version->name_len) == 0)
+        else if (version && (strncmp(version->name, "aurora", version->name_len) == 0 ||
+                             strncmp(version->name, "asahi", version->name_len) == 0))
                 sim_file->gem_type = GEM_ASAHI;
         else
                 sim_file->gem_type = GEM_DUMB;
diff --git a/src/gallium/auxiliary/pipe-loader/pipe_loader_drm.c b/src/gallium/auxiliary/pipe-loader/pipe_loader_drm.c
index dc631b4c86d..968fb3dfdac 100644
