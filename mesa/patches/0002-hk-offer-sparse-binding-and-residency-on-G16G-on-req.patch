diff --git a/src/asahi/vulkan/tests/vulkan_sparse_transfer.c b/src/asahi/vulkan/tests/vulkan_sparse_transfer.c
new file mode 100644
index 00000000000..4925da5e751
--- /dev/null
+++ b/src/asahi/vulkan/tests/vulkan_sparse_transfer.c
@@ -0,0 +1,603 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Sparse binding and residency through the transfer path, on hardware.
+ *
+ * Buffer: an 8-chunk sparse buffer gets chunks 0, 2, 4 and 6 bound and
+ * filled with a per-chunk word, and is copied back whole. Then chunk 3 is
+ * bound to the memory that backed chunk 2 and chunk 2 is unbound; chunk 3
+ * must now read chunk 2's word.
+ *
+ * Image: a 4x4-tile sparse 2D R8G8B8A8_UINT image gets the even tiles of a
+ * checkerboard bound and uploaded with a per-tile word, and is copied back
+ * whole. Then tile (1,0) is bound to the memory that backed tile (0,0) and
+ * tile (0,0) is unbound; tile (1,0) must now read tile (0,0)'s word. The
+ * copy reads the image through its sparse texture translation table, so a
+ * table update the GPU did not see after the rebind shows as a wrong word.
+ *
+ * Unbound regions are reported, and judged only when the device reports
+ * sparseResidencyNonResidentStrict.
+ *
+ * Usage: vulkan-sparse-transfer
+ * Exit status: 0 = correct output, 1 = wrong output, 2 = Vulkan error,
+ *              3 = sparse binding/residency not advertised.
+ */
+#define _POSIX_C_SOURCE 200809L
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <vulkan/vulkan.h>
+
+#define CHECK(call)                                                            \
+  do {                                                                         \
+    VkResult r_ = (call);                                                      \
+    if (r_ != VK_SUCCESS) {                                                    \
+      fprintf(stderr, "%s: %d\n", #call, r_);                                  \
+      exit(2);                                                                 \
+    }                                                                          \
+  } while (0)
+
+static VkPhysicalDevice pdev;
+static VkDevice dev;
+static VkQueue q;
+static uint32_t qf;
+static VkCommandPool pool;
+static VkFence fence;
+static bool strict;
+static unsigned failures;
+
+static uint32_t memory_type(uint32_t bits, VkMemoryPropertyFlags flags) {
+  VkPhysicalDeviceMemoryProperties m;
+  vkGetPhysicalDeviceMemoryProperties(pdev, &m);
+  for (uint32_t i = 0; i < m.memoryTypeCount; i++)
+    if ((bits & (1u << i)) && (m.memoryTypes[i].propertyFlags & flags) == flags)
+      return i;
+  fprintf(stderr, "no memory type\n");
+  exit(2);
+}
+
+struct hostbuf {
+  VkBuffer buf;
+  VkDeviceMemory mem;
+  uint32_t *map;
+  VkDeviceSize size;
+};
+
+static struct hostbuf host_buffer(VkDeviceSize size) {
+  struct hostbuf h = {.size = size};
+  VkBufferCreateInfo bi = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = size,
+      .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+  };
+  CHECK(vkCreateBuffer(dev, &bi, NULL, &h.buf));
+  VkMemoryRequirements req;
+  vkGetBufferMemoryRequirements(dev, h.buf, &req);
+  VkMemoryAllocateInfo ai = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = req.size,
+      .memoryTypeIndex = memory_type(req.memoryTypeBits,
+                                     VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                         VK_MEMORY_PROPERTY_HOST_COHERENT_BIT),
+  };
+  CHECK(vkAllocateMemory(dev, &ai, NULL, &h.mem));
+  CHECK(vkBindBufferMemory(dev, h.buf, h.mem, 0));
+  CHECK(vkMapMemory(dev, h.mem, 0, VK_WHOLE_SIZE, 0, (void **)&h.map));
+  return h;
+}
+
+static VkCommandBuffer begin(void) {
+  VkCommandBufferAllocateInfo ai = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+  };
+  VkCommandBuffer cb;
+  CHECK(vkAllocateCommandBuffers(dev, &ai, &cb));
+  VkCommandBufferBeginInfo bi = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+  };
+  CHECK(vkBeginCommandBuffer(cb, &bi));
+  return cb;
+}
+
+static void end_submit_wait(VkCommandBuffer cb) {
+  CHECK(vkEndCommandBuffer(cb));
+  VkSubmitInfo si = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &cb,
+  };
+  CHECK(vkResetFences(dev, 1, &fence));
+  CHECK(vkQueueSubmit(q, 1, &si, fence));
+  CHECK(vkWaitForFences(dev, 1, &fence, VK_TRUE, 10ull * 1000000000ull));
+  vkFreeCommandBuffers(dev, pool, 1, &cb);
+}
+
+static void bind_sparse(const VkBindSparseInfo *info) {
+  CHECK(vkResetFences(dev, 1, &fence));
+  CHECK(vkQueueBindSparse(q, 1, info, fence));
+  CHECK(vkWaitForFences(dev, 1, &fence, VK_TRUE, 10ull * 1000000000ull));
+}
+
+static void transfer_barrier(VkCommandBuffer cb) {
+  VkMemoryBarrier mb = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT |
+                       VK_ACCESS_HOST_READ_BIT,
+  };
+  vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                       VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_HOST_BIT,
+                       0, 1, &mb, 0, NULL, 0, NULL);
+}
+
+/* Count words in [first, first + count) that differ from want. */
+static unsigned check_words(const uint32_t *p, size_t count, uint32_t want,
+                            uint32_t *first_bad) {
+  unsigned bad = 0;
+  for (size_t i = 0; i < count; i++) {
+    if (p[i] != want) {
+      if (!bad)
+        *first_bad = p[i];
+      bad++;
+    }
+  }
+  return bad;
+}
+
+static void judge(const char *what, unsigned bad, uint32_t want, uint32_t got) {
+  if (bad) {
+    printf("  FAIL %s: %u words wrong (want 0x%08x, first 0x%08x)\n", what, bad,
+           want, got);
+    failures++;
+  } else {
+    printf("  ok   %s = 0x%08x\n", what, want);
+  }
+}
+
+static void judge_unbound(const char *what, const uint32_t *p, size_t count) {
+  uint32_t first = 0;
+  unsigned nonzero = check_words(p, count, 0, &first);
+  if (strict) {
+    judge(what, nonzero, 0, first);
+  } else {
+    printf("  info %s (not strict): %u of %zu words non-zero, first 0x%08x\n",
+           what, nonzero, count, nonzero ? first : 0);
+  }
+}
+
+static void buffer_test(void) {
+  /* Probe the sparse page size. */
+  VkBufferCreateInfo bi = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .flags = VK_BUFFER_CREATE_SPARSE_BINDING_BIT |
+               VK_BUFFER_CREATE_SPARSE_RESIDENCY_BIT,
+      .size = 65536,
+      .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+  };
+  VkBuffer probe;
+  CHECK(vkCreateBuffer(dev, &bi, NULL, &probe));
+  VkMemoryRequirements req;
+  vkGetBufferMemoryRequirements(dev, probe, &req);
+  vkDestroyBuffer(dev, probe, NULL);
+  const VkDeviceSize A = req.alignment;
+  const unsigned chunks = 8;
+
+  bi.size = chunks * A;
+  VkBuffer buf;
+  CHECK(vkCreateBuffer(dev, &bi, NULL, &buf));
+  vkGetBufferMemoryRequirements(dev, buf, &req);
+  printf("buffer: page %llu B, %u chunks, size %llu B\n", (unsigned long long)A,
+         chunks, (unsigned long long)req.size);
+
+  VkMemoryAllocateInfo ai = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = 4 * A,
+      .memoryTypeIndex = memory_type(req.memoryTypeBits, 0),
+  };
+  VkDeviceMemory mem;
+  CHECK(vkAllocateMemory(dev, &ai, NULL, &mem));
+
+  VkSparseMemoryBind binds[4];
+  for (unsigned i = 0; i < 4; i++)
+    binds[i] = (VkSparseMemoryBind){.resourceOffset = (2 * i) * A,
+                                    .size = A,
+                                    .memory = mem,
+                                    .memoryOffset = i * A};
+  VkSparseBufferMemoryBindInfo bbi = {.buffer = buf, .bindCount = 4, .pBinds = binds};
+  VkBindSparseInfo si = {.sType = VK_STRUCTURE_TYPE_BIND_SPARSE_INFO,
+                         .bufferBindCount = 1,
+                         .pBufferBinds = &bbi};
+  bind_sparse(&si);
+
+  struct hostbuf rb = host_buffer(chunks * A);
+  memset(rb.map, 0x5A, chunks * A);
+  VkCommandBuffer cb = begin();
+  for (unsigned k = 0; k < chunks; k += 2)
+    vkCmdFillBuffer(cb, buf, k * A, A, 0xB0000000u | k);
+  transfer_barrier(cb);
+  VkBufferCopy whole = {.size = chunks * A};
+  vkCmdCopyBuffer(cb, buf, rb.buf, 1, &whole);
+  transfer_barrier(cb);
+  end_submit_wait(cb);
+
+  const size_t wpc = A / 4;
+  char what[64];
+  for (unsigned k = 0; k < chunks; k++) {
+    snprintf(what, sizeof(what), "buffer chunk %u", k);
+    if (k % 2 == 0) {
+      uint32_t got = 0;
+      unsigned bad = check_words(rb.map + k * wpc, wpc, 0xB0000000u | k, &got);
+      judge(what, bad, 0xB0000000u | k, got);
+    } else {
+      judge_unbound(what, rb.map + k * wpc, wpc);
+    }
+  }
+
+  /* Move chunk 2's memory to chunk 3, unbind chunk 2. */
+  VkSparseMemoryBind rebinds[2] = {
+      {.resourceOffset = 2 * A, .size = A, .memory = VK_NULL_HANDLE},
+      {.resourceOffset = 3 * A, .size = A, .memory = mem, .memoryOffset = A},
+  };
+  bbi.bindCount = 2;
+  bbi.pBinds = rebinds;
+  bind_sparse(&si);
+
+  memset(rb.map, 0x5A, chunks * A);
+  cb = begin();
+  vkCmdCopyBuffer(cb, buf, rb.buf, 1, &whole);
+  transfer_barrier(cb);
+  end_submit_wait(cb);
+
+  const unsigned expect_bound[] = {0, 3, 4, 6};
+  const uint32_t expect_word[] = {0xB0000000u, 0xB0000002u, 0xB0000004u,
+                                  0xB0000006u};
+  for (unsigned i = 0; i < 4; i++) {
+    uint32_t got = 0;
+    unsigned k = expect_bound[i];
+    unsigned bad = check_words(rb.map + k * wpc, wpc, expect_word[i], &got);
+    snprintf(what, sizeof(what), "buffer chunk %u after rebind", k);
+    judge(what, bad, expect_word[i], got);
+  }
+  judge_unbound("buffer chunk 2 after unbind", rb.map + 2 * wpc, wpc);
+
+  vkDestroyBuffer(dev, buf, NULL);
+  vkFreeMemory(dev, mem, NULL);
+  vkDestroyBuffer(dev, rb.buf, NULL);
+  vkFreeMemory(dev, rb.mem, NULL);
+}
+
+static void image_layout(VkCommandBuffer cb, VkImage img, VkImageLayout from,
+                         VkImageLayout to, VkAccessFlags src, VkAccessFlags dst) {
+  VkImageMemoryBarrier b = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = src,
+      .dstAccessMask = dst,
+      .oldLayout = from,
+      .newLayout = to,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = img,
+      .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+  };
+  vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                       VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1, &b);
+}
+
+static void readback_image(VkImage img, struct hostbuf *rb, uint32_t w, uint32_t h) {
+  memset(rb->map, 0x5A, rb->size);
+  VkCommandBuffer cb = begin();
+  VkBufferImageCopy c = {
+      .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+      .imageExtent = {w, h, 1},
+  };
+  vkCmdCopyImageToBuffer(cb, img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, rb->buf, 1, &c);
+  transfer_barrier(cb);
+  end_submit_wait(cb);
+}
+
+/* Count texels of tile (tx, ty) in a w-wide readback that differ from want. */
+static unsigned check_tile(const uint32_t *p, uint32_t w, uint32_t gw, uint32_t gh,
+                           unsigned tx, unsigned ty, uint32_t want, uint32_t *got) {
+  unsigned bad = 0;
+  for (uint32_t y = ty * gh; y < (ty + 1) * gh; y++)
+    for (uint32_t x = tx * gw; x < (tx + 1) * gw; x++)
+      if (p[y * w + x] != want) {
+        if (!bad)
+          *got = p[y * w + x];
+        bad++;
+      }
+  return bad;
+}
+
+static void image_test(void) {
+  const VkFormat fmt = VK_FORMAT_R8G8B8A8_UINT;
+  const VkImageUsageFlags usage =
+      VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+  uint32_t n = 0;
+  vkGetPhysicalDeviceSparseImageFormatProperties(
+      pdev, fmt, VK_IMAGE_TYPE_2D, VK_SAMPLE_COUNT_1_BIT, usage,
+      VK_IMAGE_TILING_OPTIMAL, &n, NULL);
+  if (n == 0) {
+    printf("  FAIL image: no sparse format properties for R8G8B8A8_UINT\n");
+    failures++;
+    return;
+  }
+  VkSparseImageFormatProperties fp[4];
+  if (n > 4)
+    n = 4;
+  vkGetPhysicalDeviceSparseImageFormatProperties(
+      pdev, fmt, VK_IMAGE_TYPE_2D, VK_SAMPLE_COUNT_1_BIT, usage,
+      VK_IMAGE_TILING_OPTIMAL, &n, fp);
+  const uint32_t gw = fp[0].imageGranularity.width;
+  const uint32_t gh = fp[0].imageGranularity.height;
+  const unsigned tiles_x = 4, tiles_y = 4;
+  const uint32_t w = tiles_x * gw, h = tiles_y * gh;
+
+  VkImageCreateInfo ici = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .flags = VK_IMAGE_CREATE_SPARSE_BINDING_BIT |
+               VK_IMAGE_CREATE_SPARSE_RESIDENCY_BIT,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = fmt,
+      .extent = {w, h, 1},
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = usage,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+  };
+  VkImage img;
+  CHECK(vkCreateImage(dev, &ici, NULL, &img));
+  VkMemoryRequirements req;
+  vkGetImageMemoryRequirements(dev, img, &req);
+  uint32_t sn = 0;
+  vkGetImageSparseMemoryRequirements(dev, img, &sn, NULL);
+  VkSparseImageMemoryRequirements sreq[4];
+  if (sn > 4)
+    sn = 4;
+  vkGetImageSparseMemoryRequirements(dev, img, &sn, sreq);
+  printf("image: %ux%u, tile %ux%u, tile bytes %llu, mip tail first lod %u, "
+         "mip tail size %llu\n",
+         w, h, gw, gh, (unsigned long long)req.alignment,
+         sn ? sreq[0].imageMipTailFirstLod : 0,
+         sn ? (unsigned long long)sreq[0].imageMipTailSize : 0ull);
+  if (!sn || sreq[0].imageMipTailFirstLod == 0) {
+    printf("  FAIL image: level 0 is in the mip tail\n");
+    failures++;
+    vkDestroyImage(dev, img, NULL);
+    return;
+  }
+  const VkDeviceSize T = req.alignment;
+
+  VkMemoryAllocateInfo ai = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = (tiles_x * tiles_y / 2) * T,
+      .memoryTypeIndex = memory_type(req.memoryTypeBits, 0),
+  };
+  VkDeviceMemory mem;
+  CHECK(vkAllocateMemory(dev, &ai, NULL, &mem));
+
+  VkSparseImageMemoryBind binds[16];
+  unsigned nb = 0;
+  for (unsigned ty = 0; ty < tiles_y; ty++)
+    for (unsigned tx = 0; tx < tiles_x; tx++)
+      if ((tx + ty) % 2 == 0) {
+        binds[nb] = (VkSparseImageMemoryBind){
+            .subresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0},
+            .offset = {(int32_t)(tx * gw), (int32_t)(ty * gh), 0},
+            .extent = {gw, gh, 1},
+            .memory = mem,
+            .memoryOffset = nb * T,
+        };
+        nb++;
+      }
+  VkSparseImageMemoryBindInfo ibi = {.image = img, .bindCount = nb, .pBinds = binds};
+  VkBindSparseInfo si = {.sType = VK_STRUCTURE_TYPE_BIND_SPARSE_INFO,
+                         .imageBindCount = 1,
+                         .pImageBinds = &ibi};
+  bind_sparse(&si);
+
+  /* Staging: one gw x gh block per tile, each filled with its word. */
+  struct hostbuf st = host_buffer((VkDeviceSize)tiles_x * tiles_y * gw * gh * 4);
+  for (unsigned t = 0; t < tiles_x * tiles_y; t++)
+    for (uint32_t i = 0; i < gw * gh; i++)
+      st.map[t * gw * gh + i] = 0xC0000000u | t;
+
+  VkCommandBuffer cb = begin();
+  image_layout(cb, img, VK_IMAGE_LAYOUT_UNDEFINED,
+               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0, VK_ACCESS_TRANSFER_WRITE_BIT);
+  for (unsigned ty = 0; ty < tiles_y; ty++)
+    for (unsigned tx = 0; tx < tiles_x; tx++)
+      if ((tx + ty) % 2 == 0) {
+        unsigned t = ty * tiles_x + tx;
+        VkBufferImageCopy c = {
+            .bufferOffset = (VkDeviceSize)t * gw * gh * 4,
+            .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+            .imageOffset = {(int32_t)(tx * gw), (int32_t)(ty * gh), 0},
+            .imageExtent = {gw, gh, 1},
+        };
+        vkCmdCopyBufferToImage(cb, st.buf, img,
+                               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &c);
+      }
+  image_layout(cb, img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+               VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+               VK_ACCESS_TRANSFER_READ_BIT);
+  end_submit_wait(cb);
+
+  struct hostbuf rb = host_buffer((VkDeviceSize)w * h * 4);
+  readback_image(img, &rb, w, h);
+
+  char what[64];
+  unsigned bound_bad = 0;
+  for (unsigned ty = 0; ty < tiles_y; ty++)
+    for (unsigned tx = 0; tx < tiles_x; tx++) {
+      unsigned t = ty * tiles_x + tx;
+      if ((tx + ty) % 2 == 0) {
+        uint32_t got = 0;
+        unsigned bad = check_tile(rb.map, w, gw, gh, tx, ty, 0xC0000000u | t, &got);
+        if (bad) {
+          snprintf(what, sizeof(what), "image tile (%u,%u)", tx, ty);
+          judge(what, bad, 0xC0000000u | t, got);
+          bound_bad++;
+        }
+      } else if (tx == 1 && ty == 0) {
+        /* One unbound tile is reported; the rest behave alike. */
+        uint32_t got = 0;
+        unsigned nz = check_tile(rb.map, w, gw, gh, tx, ty, 0, &got);
+        if (strict)
+          judge("image tile (1,0) unbound", nz, 0, got);
+        else
+          printf("  info image tile (1,0) unbound (not strict): %u texels "
+                 "non-zero, first 0x%08x\n", nz, nz ? got : 0);
+      }
+    }
+  if (!bound_bad)
+    printf("  ok   image: all %u bound tiles hold their words\n", nb);
+
+  /* Move tile (0,0)'s memory (offset 0) to tile (1,0), unbind tile (0,0). */
+  VkSparseImageMemoryBind rebinds[2] = {
+      {.subresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0},
+       .offset = {0, 0, 0},
+       .extent = {gw, gh, 1},
+       .memory = VK_NULL_HANDLE},
+      {.subresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0},
+       .offset = {(int32_t)gw, 0, 0},
+       .extent = {gw, gh, 1},
+       .memory = mem,
+       .memoryOffset = 0},
+  };
+  ibi.bindCount = 2;
+  ibi.pBinds = rebinds;
+  bind_sparse(&si);
+
+  readback_image(img, &rb, w, h);
+  uint32_t got = 0;
+  unsigned bad = check_tile(rb.map, w, gw, gh, 1, 0, 0xC0000000u, &got);
+  judge("image tile (1,0) after rebind", bad, 0xC0000000u, got);
+  bad = check_tile(rb.map, w, gw, gh, 2, 0, 0xC0000002u, &got);
+  judge("image tile (2,0) after rebind", bad, 0xC0000002u, got);
+  bad = check_tile(rb.map, w, gw, gh, 3, 3, 0xC000000Fu, &got);
+  judge("image tile (3,3) after rebind", bad, 0xC000000Fu, got);
+  {
+    uint32_t g0 = 0;
+    unsigned nz = check_tile(rb.map, w, gw, gh, 0, 0, 0, &g0);
+    if (strict)
+      judge("image tile (0,0) after unbind", nz, 0, g0);
+    else
+      printf("  info image tile (0,0) after unbind (not strict): %u texels "
+             "non-zero, first 0x%08x\n", nz, nz ? g0 : 0);
+  }
+
+  vkDestroyImage(dev, img, NULL);
+  vkFreeMemory(dev, mem, NULL);
+  vkDestroyBuffer(dev, st.buf, NULL);
+  vkFreeMemory(dev, st.mem, NULL);
+  vkDestroyBuffer(dev, rb.buf, NULL);
+  vkFreeMemory(dev, rb.mem, NULL);
+}
+
+int main(void) {
+  VkApplicationInfo app = {
+      .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .pApplicationName = "vulkan-sparse-transfer",
+      .apiVersion = VK_API_VERSION_1_1,
+  };
+  VkInstanceCreateInfo ici = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+  };
+  VkInstance inst;
+  CHECK(vkCreateInstance(&ici, NULL, &inst));
+  uint32_t count = 1;
+  VkResult r = vkEnumeratePhysicalDevices(inst, &count, &pdev);
+  if ((r != VK_SUCCESS && r != VK_INCOMPLETE) || count == 0) {
+    fprintf(stderr, "no Vulkan device\n");
+    return 2;
+  }
+
+  VkPhysicalDeviceProperties props;
+  vkGetPhysicalDeviceProperties(pdev, &props);
+  VkPhysicalDeviceFeatures feat;
+  vkGetPhysicalDeviceFeatures(pdev, &feat);
+  strict = props.sparseProperties.residencyNonResidentStrict;
+  printf("device: %s\n", props.deviceName);
+  printf("features: sparseBinding %u residencyBuffer %u residencyImage2D %u "
+         "shaderResourceResidency %u; strict %u, standard2DBlockShape %u\n",
+         feat.sparseBinding, feat.sparseResidencyBuffer,
+         feat.sparseResidencyImage2D, feat.shaderResourceResidency, strict,
+         props.sparseProperties.residencyStandard2DBlockShape);
+  if (!feat.sparseBinding || !feat.sparseResidencyBuffer ||
+      !feat.sparseResidencyImage2D) {
+    printf("SPARSE-NOT-ADVERTISED\n");
+    return 3;
+  }
+
+  uint32_t nqf = 0;
+  vkGetPhysicalDeviceQueueFamilyProperties(pdev, &nqf, NULL);
+  VkQueueFamilyProperties qfp[16];
+  if (nqf > 16)
+    nqf = 16;
+  vkGetPhysicalDeviceQueueFamilyProperties(pdev, &nqf, qfp);
+  qf = UINT32_MAX;
+  for (uint32_t i = 0; i < nqf; i++)
+    if ((qfp[i].queueFlags & VK_QUEUE_SPARSE_BINDING_BIT) &&
+        (qfp[i].queueFlags & VK_QUEUE_GRAPHICS_BIT)) {
+      qf = i;
+      break;
+    }
+  if (qf == UINT32_MAX) {
+    printf("  FAIL no graphics queue family with SPARSE_BINDING\n");
+    printf("RESULT FAIL 1\n");
+    return 1;
+  }
+
+  float prio = 1.0f;
+  VkDeviceQueueCreateInfo qci = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = qf,
+      .queueCount = 1,
+      .pQueuePriorities = &prio,
+  };
+  VkPhysicalDeviceFeatures want = {
+      .sparseBinding = VK_TRUE,
+      .sparseResidencyBuffer = VK_TRUE,
+      .sparseResidencyImage2D = VK_TRUE,
+  };
+  VkDeviceCreateInfo dci = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &qci,
+      .pEnabledFeatures = &want,
+  };
+  CHECK(vkCreateDevice(pdev, &dci, NULL, &dev));
+  vkGetDeviceQueue(dev, qf, 0, &q);
+  VkCommandPoolCreateInfo pci = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .queueFamilyIndex = qf,
+  };
+  CHECK(vkCreateCommandPool(dev, &pci, NULL, &pool));
+  VkFenceCreateInfo fci = {.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  CHECK(vkCreateFence(dev, &fci, NULL, &fence));
+
+  buffer_test();
+  image_test();
+
+  vkDestroyFence(dev, fence, NULL);
+  vkDestroyCommandPool(dev, pool, NULL);
+  vkDestroyDevice(dev, NULL);
+  vkDestroyInstance(inst, NULL);
+
+  if (failures) {
+    printf("RESULT FAIL %u\n", failures);
+    return 1;
+  }
+  printf("RESULT PASS\n");
+  return 0;
+}
