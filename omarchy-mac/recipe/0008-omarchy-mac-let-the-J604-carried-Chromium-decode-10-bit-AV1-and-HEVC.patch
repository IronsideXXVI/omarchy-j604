index 8bddf67..2cfa158 100755
--- a/omarchy-mac/bin/omarchy-mac-setup-user
+++ b/omarchy-mac/bin/omarchy-mac-setup-user
@@ -8,61 +8,9 @@ root=${root%/}
 omarchy-hw-apple-silicon || exit 0
 config=${XDG_CONFIG_HOME:-$HOME/.config}
 
