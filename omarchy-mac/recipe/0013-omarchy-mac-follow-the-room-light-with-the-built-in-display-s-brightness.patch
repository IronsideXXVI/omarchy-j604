 omarchy-mac/bin/omarchy-mac-brightness-auto   | 123 ++++++++++++++++++
 .../omarchy-mac/brightness/apple,j604.conf    |  21 +++
 omarchy-mac/test/brightness-auto-test.sh      |  69 ++++++++++
 .../omarchy-mac-brightness-auto.service       |   1 +
 .../user/omarchy-mac-brightness-auto.service  |  14 ++
 5 files changed, 228 insertions(+)
 create mode 100755 omarchy-mac/bin/omarchy-mac-brightness-auto
 create mode 100644 omarchy-mac/share/omarchy-mac/brightness/apple,j604.conf
