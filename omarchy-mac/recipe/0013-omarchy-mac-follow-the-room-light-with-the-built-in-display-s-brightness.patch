diff --git a/omarchy-mac/bin/omarchy-mac-brightness-auto b/omarchy-mac/bin/omarchy-mac-brightness-auto
new file mode 100755
index 0000000..54fb215
--- /dev/null
+++ b/omarchy-mac/bin/omarchy-mac-brightness-auto
@@ -0,0 +1,123 @@
+#!/bin/bash
+
+# omarchy:summary=Follow the room light with the built-in display's brightness, as macOS does
+# omarchy:args=[on|off|status]
+# omarchy:examples=omarchy mac brightness-auto status | omarchy mac brightness-auto off | omarchy mac brightness-auto on
+
+# macOS ships automatic brightness on for the built-in display. This reads the ambient light
+# sensor, looks the room's illuminance up in the model's curve (lux to nits, from macOS's own
+# curve, in /usr/share/omarchy-mac/brightness named after the device tree's first compatible)
+# and moves the backlight there over the ramp macOS uses. A brightness the user sets by hand
+# becomes the new level for the room: the curve is scaled by it, as macOS scales its curve.
+# Runs only on a Mac with a table and a light sensor, and steps aside while Omarchy's own
+# omarchy-brightness-auto service runs.
+
+set -u
+
+omarchy-hw-apple-silicon 2>/dev/null || exit 0
+
+table_dir=${OMARCHY_MAC_BRIGHTNESS_DIR:-/usr/share/omarchy-mac/brightness}
+iio_root=${OMARCHY_MAC_IIO_ROOT:-/sys/bus/iio/devices}
+backlight_root=${OMARCHY_MAC_BACKLIGHT_ROOT:-/sys/class/backlight}
+compatible_file=${OMARCHY_MAC_DT_COMPATIBLE:-/proc/device-tree/compatible}
+config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-mac
+off_file=$config_dir/brightness-auto-off
+scale_file=$config_dir/brightness-auto-scale
+state_file=${XDG_RUNTIME_DIR:-/tmp}/omarchy-mac-brightness-auto.last
+once=${OMARCHY_MAC_BRIGHTNESS_ONCE:-}
+step_sleep=${OMARCHY_MAC_BRIGHTNESS_STEP_SLEEP:-}
+
+model() { tr '\0' '\n' <"$compatible_file" 2>/dev/null | head -n1; }
+
+load_table() {
+  local file
+  file="$table_dir/$(model).conf"
+  [[ -r $file ]] || return 1
+  # shellcheck disable=SC1090
+  source "$file"
+}
+
+sensor() {
+  local dir
+  for dir in "$iio_root"/iio:device*; do
+    [[ -r $dir/in_illuminance_input ]] && { echo "$dir"; return 0; }
+  done
+  return 1
+}
+
+read_raw() { local v; v=$(<"$backlight_root/$BACKLIGHT/brightness") 2>/dev/null && echo "$v"; }
+read_max() { local v; v=$(<"$backlight_root/$BACKLIGHT/max_brightness") 2>/dev/null && echo "$v"; }
+write_raw() { brightnessctl -q -d "$BACKLIGHT" set "$1" >/dev/null 2>&1 && echo "$1" >"$state_file"; }
+
+# The curve's nits for a room at $1 lux, times the user's scale, within the panel's range.
+target_nits() {
+  awk -v lux="$1" -v curve="$CURVE" -v scale="$2" -v lo="$MIN_NITS" -v hi="$MAX_NITS" 'BEGIN {
+    n = split(curve, p, " ")
+    for (i = 1; i <= n; i++) { split(p[i], q, ":"); x[i] = q[1] + 0; y[i] = q[2] + 0 }
+    if (lux <= x[1]) t = y[1]
+    else if (lux >= x[n]) t = y[n]
+    else for (i = 1; i < n; i++) if (lux >= x[i] && lux <= x[i + 1]) {
+      t = y[i] + (y[i + 1] - y[i]) * (lux - x[i]) / (x[i + 1] - x[i]); break
+    }
+    t *= scale
+    if (t < lo) t = lo
+    if (t > hi) t = hi
+    printf "%.2f\n", t
+  }'
+}
+
+nits_to_raw() { awk -v n="$1" -v m="$2" -v hi="$MAX_NITS" 'BEGIN { r = int(n * m / hi + 0.5); if (r < 1) r = 1; if (r > m) r = m; print r }'; }
+
+status() {
+  local enabled=on
+  [[ -e $off_file ]] && enabled=off
+  echo "Automatic brightness: $enabled, scale $(cat "$scale_file" 2>/dev/null || echo 1)"
+}
+
+case ${1:-run} in
+  status) status; exit 0 ;;
+  off) mkdir -p "$config_dir" && touch "$off_file"; status; exit 0 ;;
+  on) rm -f "$off_file"; status; exit 0 ;;
+  run) ;;
+  *) echo "Usage: omarchy-mac-brightness-auto [on|off|status]" >&2; exit 2 ;;
+esac
+
+load_table || exit 0
+dir=$(sensor) || exit 0
+max=$(read_max) || exit 0
+[[ -n $step_sleep ]] || step_sleep=$(awk -v r="$RAMP_SECONDS" -v s="$RAMP_STEPS" 'BEGIN { printf "%.3f\n", r / s }')
+
+smoothed=""
+while :; do
+  if [[ ! -e $off_file ]] && ! systemctl --user is-active --quiet omarchy-brightness-auto.service 2>/dev/null; then
+    lux=$(<"$dir/in_illuminance_input") 2>/dev/null || lux=""
+    raw=$(read_raw) || raw=""
+    if [[ -n $lux && -n $raw ]] && (( raw > 0 )); then
+      smoothed=$(awk -v o="${smoothed:-$lux}" -v n="$lux" -v w="$SMOOTHING" 'BEGIN { printf "%.4f\n", o * (1 - w) + n * w }')
+      scale=$(cat "$scale_file" 2>/dev/null || echo 1)
+      last=$(cat "$state_file" 2>/dev/null || echo "")
+      # A level we did not write is the user's: it rescales the curve for this room.
+      if [[ -n $last ]] && (( raw > last + 1 || raw < last - 1 )); then
+        base=$(target_nits "$smoothed" 1)
+        scale=$(awk -v r="$raw" -v m="$max" -v hi="$MAX_NITS" -v b="$base" 'BEGIN {
+          s = (r * hi / m) / b; if (s < 0.1) s = 0.1; if (s > 10) s = 10; printf "%.4f\n", s }')
+        mkdir -p "$config_dir" && echo "$scale" >"$scale_file"
+        echo "$raw" >"$state_file"
+      else
+        want=$(nits_to_raw "$(target_nits "$smoothed" "$scale")" "$max")
+        # Small moves are left alone (sensor jitter, the panel's own light in a dark room).
+        if awk -v w="$want" -v r="$raw" -v p="$HYSTERESIS_PERCENT" -v m="$max" -v hi="$MAX_NITS" 'BEGIN {
+             d = w - r; if (d < 0) d = -d; lim = r * p / 100; if (lim < m * 2 / hi) lim = m * 2 / hi; exit !(d > lim) }'; then
+          for (( i = 1; i <= RAMP_STEPS; i++ )); do
+            write_raw "$(awk -v a="$raw" -v b="$want" -v i="$i" -v s="$RAMP_STEPS" 'BEGIN { printf "%d\n", int(a + (b - a) * i / s + 0.5) }')" || break
+            (( i < RAMP_STEPS )) && sleep "$step_sleep"
+          done
+        elif [[ -z $last ]]; then
+          echo "$raw" >"$state_file"
+        fi
+      fi
+    fi
+  fi
+  [[ -n $once ]] && exit 0
+  sleep "$POLL_SECONDS"
+done
diff --git a/omarchy-mac/share/omarchy-mac/brightness/apple,j604.conf b/omarchy-mac/share/omarchy-mac/brightness/apple,j604.conf
new file mode 100644
index 0000000..7f770bd
--- /dev/null
+++ b/omarchy-mac/share/omarchy-mac/brightness/apple,j604.conf
@@ -0,0 +1,21 @@
+# Automatic brightness for the MacBook Pro 14" M4 (J604), read by omarchy-mac-brightness-auto.
+# macOS's own curve for this panel (CoreBrightness status, built-in display): the factory curve
+# ALSUserPreference/GoodCurve, Lux1 0 / Lux2 150 against Backlight1 139.44 / Backlight2 223.11 nits,
+# MaxNits 600, MinNits 1. Values marked TO-VERIFY are not yet traced.
+
+# The panel's backlight device; its brightness is in nits.
+BACKLIGHT=apple-panel-bl
+MAX_NITS=600
+MIN_NITS=1
+# Room illuminance (lux) : display brightness (nits), in a straight line between points and held
+# beyond the ends. Above 150 lux the line of macOS's two points is carried on to MaxNits.
+CURVE="0:139.44 150:223.11 826:600"   # TO-VERIFY: the curve's shape above 150 lux
+# macOS moves the backlight to a new level in 1.94 s.
+RAMP_SECONDS=1.94
+RAMP_STEPS=20
+# Weight of a new sensor reading against the running level.
+SMOOTHING=0.25            # TO-VERIFY
+# A move smaller than this share of the current level is left alone.
+HYSTERESIS_PERCENT=5      # TO-VERIFY: macOS LuxThreshold 78.5
+# Seconds between sensor reads (the sensor reports every 0.2 s).
+POLL_SECONDS=1
diff --git a/omarchy-mac/test/brightness-auto-test.sh b/omarchy-mac/test/brightness-auto-test.sh
new file mode 100755
index 0000000..d9ac14f
--- /dev/null
+++ b/omarchy-mac/test/brightness-auto-test.sh
@@ -0,0 +1,69 @@
+#!/bin/bash
+set -euo pipefail
+root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
+t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
+fail() { echo "brightness-auto-test: $*" >&2; exit 1; }
+
+mkdir -p "$t/bin" "$t/iio/iio:device0" "$t/bl/apple-panel-bl" "$t/config" "$t/run" "$t/table"
+printf 'apple,j604\0apple,t8132\0apple,arm-platform\0' >"$t/compatible"
+echo 600 >"$t/bl/apple-panel-bl/max_brightness"
+echo 300 >"$t/bl/apple-panel-bl/brightness"
+cat >"$t/bin/brightnessctl" <<EOF
+#!/bin/bash
+[[ \$1 == -q && \$2 == -d && \$3 == apple-panel-bl && \$4 == set ]] || exit 1
+echo "\$5" >"$t/bl/apple-panel-bl/brightness"; echo "\$5" >>"$t/writes"
+EOF
+printf '#!/bin/bash\nexit 0\n' >"$t/bin/omarchy-hw-apple-silicon"
+printf '#!/bin/bash\n[[ -e %s/stock ]]\n' "$t" >"$t/bin/systemctl"
+chmod +x "$t/bin/"*
+# The model's table with smoothing off, so one read settles.
+sed 's/^SMOOTHING=.*/SMOOTHING=1/' "$root/share/omarchy-mac/brightness/apple,j604.conf" >"$t/table/apple,j604.conf"
+
+run() { # lux [args]
+  echo "$1" >"$t/iio/iio:device0/in_illuminance_input"
+  PATH="$t/bin:$PATH" HOME="$t" XDG_CONFIG_HOME="$t/config" XDG_RUNTIME_DIR="$t/run" \
+    OMARCHY_MAC_BRIGHTNESS_ONCE=1 OMARCHY_MAC_BRIGHTNESS_STEP_SLEEP=0 \
+    OMARCHY_MAC_BRIGHTNESS_DIR="${table:-$t/table}" OMARCHY_MAC_IIO_ROOT="$t/iio" \
+    OMARCHY_MAC_BACKLIGHT_ROOT="$t/bl" OMARCHY_MAC_DT_COMPATIBLE="$t/compatible" \
+    bash "$root/bin/omarchy-mac-brightness-auto" "${@:2}"
+}
+b() { cat "$t/bl/apple-panel-bl/brightness"; }
+
+# The shipped table parses and names this Mac's backlight.
+( source "$root/share/omarchy-mac/brightness/apple,j604.conf"; [[ $BACKLIGHT == apple-panel-bl && -n $CURVE ]] ) ||
+  fail "shipped table"
+# 150 lux is macOS's 223.1 nits, reached in 20 steps (the 1.94 s ramp).
+run 150; [[ $(b) == 223 ]] || fail "150 lux -> 223 nits: $(b)"
+[[ $(wc -l <"$t/writes") == 20 ]] || fail "ramp steps: $(wc -l <"$t/writes")"
+# A dark room: macOS's 139.44 nits.
+run 0; [[ $(b) == 139 ]] || fail "0 lux -> 139 nits: $(b)"
+# Between points: 75 lux -> 139.44 + (223.11 - 139.44) / 2 = 181.28 nits.
+run 75; [[ $(b) == 181 ]] || fail "75 lux -> 181 nits: $(b)"
+# A small change in the light (under 5 %) is left alone.
+: >"$t/writes"; run 77; [[ ! -s $t/writes ]] || fail "jitter moved the panel: $(b)"
+# Bright light: the line carried on to the panel's 600 nits, and held there.
+run 1000; [[ $(b) == 600 ]] || fail "1000 lux -> 600 nits: $(b)"
+# Covered sensor and back: down to the dark level, then back up.
+run 0; [[ $(b) == 139 ]] || fail "covered: $(b)"
+run 75; [[ $(b) == 181 ]] || fail "uncovered: $(b)"
+# The user sets 362 nits at 75 lux (twice the curve): the curve doubles for every room.
+echo 362 >"$t/bl/apple-panel-bl/brightness"; run 75
+[[ $(cat "$t/config/omarchy-mac/brightness-auto-scale") == 1.9969 ]] || fail "scale: $(cat "$t/config/omarchy-mac/brightness-auto-scale")"
+run 150; [[ $(b) == 446 ]] || fail "scaled 150 lux -> 446 nits: $(b)"
+rm "$t/config/omarchy-mac/brightness-auto-scale"
+# Off: no further moves; on again resumes.
+run 150 off >/dev/null; run 0; [[ $(b) == 446 ]] || fail "off stays off: $(b)"
+run 0 on >/dev/null; run 0; [[ $(b) == 139 ]] || fail "on resumes: $(b)"
+# Omarchy's own automatic brightness running: step aside.
+touch "$t/stock"; run 150; [[ $(b) == 139 ]] || fail "stock service wins: $(b)"; rm "$t/stock"
+# A panel that is off (0) is not woken.
+echo 0 >"$t/bl/apple-panel-bl/brightness"; run 150; [[ $(b) == 0 ]] || fail "panel off: $(b)"
+# A Mac without a table, or without a sensor: nothing happens.
+echo 100 >"$t/bl/apple-panel-bl/brightness"; rm -f "$t/run/"*
+printf 'apple,j313\0' >"$t/compatible"; run 150; [[ $(b) == 100 ]] || fail "no table: $(b)"
+printf 'apple,j604\0' >"$t/compatible"; rm "$t/iio/iio:device0/in_illuminance_input"
+PATH="$t/bin:$PATH" HOME="$t" XDG_CONFIG_HOME="$t/config" XDG_RUNTIME_DIR="$t/run" OMARCHY_MAC_BRIGHTNESS_ONCE=1 \
+  OMARCHY_MAC_BRIGHTNESS_DIR="$t/table" OMARCHY_MAC_IIO_ROOT="$t/iio" OMARCHY_MAC_BACKLIGHT_ROOT="$t/bl" \
+  OMARCHY_MAC_DT_COMPATIBLE="$t/compatible" bash "$root/bin/omarchy-mac-brightness-auto"
+[[ $(b) == 100 ]] || fail "no sensor: $(b)"
+echo "brightness-auto-test: ok"
