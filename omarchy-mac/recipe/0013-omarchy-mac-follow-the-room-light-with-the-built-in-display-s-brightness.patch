diff --git a/omarchy-mac/vendor/systemd/user/omarchy-mac-brightness-auto.service b/omarchy-mac/vendor/systemd/user/omarchy-mac-brightness-auto.service
new file mode 100644
index 0000000..30cfd8d
--- /dev/null
+++ b/omarchy-mac/vendor/systemd/user/omarchy-mac-brightness-auto.service
@@ -0,0 +1,14 @@
+[Unit]
+Description=Follow the room light with the built-in display's brightness
+After=graphical-session.target
+PartOf=graphical-session.target
+
+[Service]
+Type=simple
+ExecCondition=/usr/bin/omarchy-hw-apple-silicon
+ExecStart=/usr/bin/omarchy-mac-brightness-auto
+Restart=on-failure
+RestartSec=10
+
+[Install]
+WantedBy=graphical-session.target
