prepare() {
  # Every patch listed in source=, in listed order.
  local s f n=0 listed
  listed=$(printf '%s\n' "${source[@]}" | grep -c '\.patch$')
  for s in "${source[@]}"; do
    f=${s##*/}; [[ $f == *.patch ]] || continue
    patch -d "$srcdir/omarchy-mac-pkgs" -Np1 -i "$srcdir/$f" || { error "patch $f failed"; return 1; }
    n=$((n + 1))
  done
  (( n == listed )) || { error "applied $n of $listed listed patches"; return 1; }
  # Tests and staging must not be able to read the other package's tree.
  rm -rf "$srcdir/addon"
  cp -a "$srcdir/omarchy-mac-pkgs/omarchy-mac" "$srcdir/addon"
  [[ $(<"$srcdir/addon/version") == "$pkgver" ]]
  [[ $(git -C "$srcdir/omarchy-mac-pkgs" rev-parse HEAD) == "$_commit" ]]
}

check() {
  "$srcdir/addon/test/all"
}

package() {
  # Runtime-only: the builder does not need the Omarchy desktop to stage or
  # test the add-on. What every Mac needs comes from here, so an image's first
  # boot has it offline and no owner can remove it: the speaker stack (whose
  # speakersafetyd unit this package presets), audio routing, the GPU's OpenGL
  # and Vulkan drivers and the keyring of the Asahi repository the platform
  # root names. The runtime's Apple package list keeps the removable defaults
  # (video decode, wf-recorder, widevine, asahi-bless).
  #
  # The GPU drivers are mesa-aurora and vulkan-aurora by name, at least the
  # edgeC build: the 7.3 kernel names its GPU driver "aurora", which only
  # aurora_dri.so opens. Stock mesa and vulkan-asahi have none, and a Mac left
  # on them boots to a black screen. Naming them swaps the stock packages
  # through their conflicts, on Macs only; nothing replaces mesa, so other
  # aarch64 machines on [omarchy] keep theirs.
  depends=('omarchy' 'bash' 'coreutils' 'diffutils' 'grep' 'sed' 'gawk' 'systemd' 'pciutils' 'kmod'
           'mkinitcpio' 'networkmanager' 'iwd' 'python' 'pipewire' 'pipewire-pulse' 'libpulse' 'wireplumber'
           'asahi-audio' 'speakersafetyd' 'alsa-ucm-conf-asahi' 'rtkit' 'pipewire-alsa'
           'mesa-aurora>=1:26.3.0_devel.20261120.232519.fb3b11e121c'
           'vulkan-aurora>=1:26.3.0_devel.20261120.232519.fb3b11e121c'
           'asahi-alarm-keyring' 'aurora-touchid-rearm')

  "$srcdir/addon/install" "$pkgdir"
  install -Dm644 "$srcdir/addon/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/addon/ORIGINS.md" "$pkgdir/usr/share/doc/$pkgname/ORIGINS.md"
  printf '%s\n' "$_commit" >"$pkgdir/usr/share/omarchy-mac/source-revision"
}
