# J604 local build (see README)
# The official 0.2.3-2 recipe (omacom/omarchy-pkgs rc f9d0eda9), changed only by pkgrel 2 -> 2.6 (2.1-2.4 were
# earlier lab builds, 2.5 = 0001 only, published and withdrawn) and 0001: the platform root names a 10 s
# J604 local build (see README)
# Apple F-row and marks keys an Apple keyboard lacks "-" (Super+K, with omarchy 4.5.0-3.3).
# J604 local build (see README)
# allowlist gains t8132 + j604 only; consent test: J604 available, J713 unsupported). Nothing else changes.
# Maintainer: Scott Jones <scottajones@gmail.com>
# Ported from omarchy-mac/omarchy-pkgs-aarch64 pkgbuilds/omarchy-mac at 02ed7b250f7edcf7c5f748acaf7b21ef0a764e9d.

pkgname=omarchy-mac
# pkgver matches omarchy-mac/version at _commit. Bump pkgrel to re-pin or
# rebuild the same add-on version; reset it to 1 when pkgver increases.
pkgver=0.2.3
pkgrel=2.7
pkgdesc='Apple Silicon configuration and support services for Omarchy'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
# Owns /usr/share/omarchy-platform: one platform package per machine. Nothing
# may depend on omarchy-platform; the provide exists only for the conflict.
provides=('omarchy-platform')
conflicts=('omarchy-platform')
url='https://github.com/omacom/omarchy-mac-pkgs'
license=('MIT')
makedepends=('git' 'findutils')
checkdepends=('diffutils' 'python' 'systemd')
# An exact omarchy-mac-pkgs main commit, never a branch.
_commit=ea0097a523191bcf3c6997e8d3a162ea13a1fe67
source=("omarchy-mac-pkgs::git+https://github.com/omacom/omarchy-mac-pkgs.git#commit=${_commit}")
sha256sums=('267c97b5a20cacb906414b3c3174f38195d793046a3a064107ca33f01679ad7f')

source+=("0001-J604-local-build-turn-the-keyboard-backlight-off-aft.patch")
sha256sums+=('f95b3562cbd0116933091177bab1cf601339ec5441604fcb5c4c2cc35b548ea5')
source+=("0002-J604-local-build-name-the-whole-Apple-F-row-in-Super.patch")
sha256sums+=('252c8701d1fcc95573a4ebfff2133c3d3f285eadded5f9f6a6584858580079d3')
source+=("0002-Offer-Touch-ID-on-the-J604-MacBook-Pro-14-inch-M4.patch")
sha256sums+=('3abb224343221790a9c060da9049c0a5b26bc8d9aac10614509c175629489f44')

prepare() {
  patch -d "$srcdir/omarchy-mac-pkgs" -Np1 -i "$srcdir/0001-J604-local-build-turn-the-keyboard-backlight-off-aft.patch"
  patch -d "$srcdir/omarchy-mac-pkgs" -Np1 -i "$srcdir/0002-J604-local-build-name-the-whole-Apple-F-row-in-Super.patch"
  patch -d "$srcdir/omarchy-mac-pkgs" -Np1 -i "$srcdir/0002-Offer-Touch-ID-on-the-J604-MacBook-Pro-14-inch-M4.patch"
  # Tests and staging must not be able to read the other package's tree.
  rm -rf "$srcdir/addon"
  cp -a "$srcdir/omarchy-mac-pkgs/omarchy-mac" "$srcdir/addon"
  [[ $(<"$srcdir/addon/version") == "$pkgver" ]]
  [[ $(git -C "$srcdir/omarchy-mac-pkgs" rev-parse HEAD) == "$_commit" ]]
}

check() {
  "$srcdir/addon/test/all"
}

package() {
  # Runtime-only: the builder does not need the Omarchy desktop to stage or
  # test the add-on. What every Mac needs comes from here, so an image's first
  # boot has it offline and no owner can remove it: the speaker stack (whose
  # speakersafetyd unit this package presets), audio routing, the GPU's Vulkan
  # driver and the keyring of the Asahi repository the platform root names.
  # The runtime's Apple package list keeps the removable defaults (video
  # decode, wf-recorder, widevine, asahi-bless).
  depends=('omarchy' 'bash' 'coreutils' 'diffutils' 'grep' 'sed' 'gawk' 'systemd' 'pciutils' 'kmod'
           'mkinitcpio' 'networkmanager' 'iwd' 'python' 'pipewire' 'pipewire-pulse' 'libpulse' 'wireplumber'
           'asahi-audio' 'speakersafetyd' 'alsa-ucm-conf-asahi' 'rtkit' 'pipewire-alsa'
           'vulkan-asahi' 'asahi-alarm-keyring')

  "$srcdir/addon/install" "$pkgdir"
  install -Dm644 "$srcdir/addon/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/addon/ORIGINS.md" "$pkgdir/usr/share/doc/$pkgname/ORIGINS.md"
  printf '%s\n' "$_commit" >"$pkgdir/usr/share/omarchy-mac/source-revision"
}
