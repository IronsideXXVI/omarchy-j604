From 7b32c16f5344a33483c4d9fb5793244da0856098 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 02:02:45 +0000
Subject: [PATCH 12/24] omarchy-mac: let mpv decode AV1 on the Apple Video
 Decoder

mpv asked the decoder only for H.264, HEVC and VP9, so AV1, including
10-bit HDR streams, always played in software, though the decoder of an
M3 or later Mac decodes it (a 14-inch MacBook Pro with M4 decodes 4K AV1
at about 600 frames per second). Add av1 to hwdec-codecs; where a
Mac's decoder lacks it, mpv falls back to software as before.

An untouched copy of the previous default is replaced at setup, as the
one before it is; an edited copy stays.
---
 omarchy-mac/README.md                      |  2 +-
 omarchy-mac/bin/omarchy-mac-setup-system   | 13 ++++++------
 omarchy-mac/share/omarchy-mac/mpv/mpv.conf |  7 ++++---
 omarchy-mac/test/mpv-0.2.3.conf            | 23 ++++++++++++++++++++++
 omarchy-mac/test/mpv-test.sh               | 19 ++++++++++++++++--
 5 files changed, 52 insertions(+), 12 deletions(-)
 create mode 100644 omarchy-mac/test/mpv-0.2.3.conf

diff --git a/omarchy-mac/README.md b/omarchy-mac/README.md
index b2c7329..af4bf76 100644
--- a/omarchy-mac/README.md
+++ b/omarchy-mac/README.md
@@ -47,7 +47,7 @@ Vendor defaults use NetworkManager's `/usr/lib/NetworkManager/conf.d`, systemd's
 
 mpv has no vendor configuration directory and decodes in software unless told otherwise. The package ships its Apple default as `/usr/share/omarchy-mac/mpv/mpv.conf` and a systemd-tmpfiles rule that copies it to `/etc/mpv/mpv.conf` only when that file is missing. pacman's systemd hook applies the rule when the package is installed or upgraded, and boot applies it again. An existing `/etc/mpv/mpv.conf` is never overwritten, with one exception: `omarchy-mac-setup-system` replaces a regular file byte-identical to the earlier default, which lacks `gpu-sw=yes`, with the current default, and leaves an edited copy or a link alone. An upgrade alone does not apply this, because neither `omarchy update` nor a pacman upgrade runs setup: run `sudo omarchy-mac-setup-system`, or rerun hardware setup, to apply it. So edit it rather than delete it to change the system default; each user's `~/.config/mpv/mpv.conf` is read after it and wins, and `hwdec=no` there decodes in software.
 
-The default decodes H.264, HEVC and VP9 on the Apple Video Decoder with copy-back (`hwdec=vaapi-copy`, `hwdec-codecs=h264,hevc,vp9`) and draws with the OpenGL renderer (`vo=gpu`, `gpu-api=opengl`). On an M2 Max, copy-back is bit-exact against software decoding, and 1080p playback falls from about 55% to 13% of a core. Zero-copy (`hwdec=vaapi`) is not used: Asahi's Vulkan driver reads the imported chroma plane from the wrong offset, so gpu-next shows green frames, and `libva-v4l2_request` invalidates the frames of a decoder it closes, which copy-back has already copied out. gpu-next also costs about three times the CPU of OpenGL to upload copied frames. `libva-v4l2_request-avd` and `avd-fw` provide the decoder; without them mpv falls back to software.
+The default decodes H.264, HEVC, VP9 and, on Macs whose decoder has it (M3 and later), AV1 on the Apple Video Decoder with copy-back (`hwdec=vaapi-copy`, `hwdec-codecs=h264,hevc,vp9,av1`; a codec the decoder lacks plays in software) and draws with the OpenGL renderer (`vo=gpu`, `gpu-api=opengl`). On an M2 Max, copy-back is bit-exact against software decoding, and 1080p playback falls from about 55% to 13% of a core. Zero-copy (`hwdec=vaapi`) is not used: Asahi's Vulkan driver reads the imported chroma plane from the wrong offset, so gpu-next shows green frames, and `libva-v4l2_request` invalidates the frames of a decoder it closes, which copy-back has already copied out. gpu-next also costs about three times the CPU of OpenGL to upload copied frames. `libva-v4l2_request-avd` and `avd-fw` provide the decoder; without them mpv falls back to software.
 
 On a Mac whose GPU has no driver yet, such as the M3 Max, the only OpenGL renderer is Mesa's software one: llvmpipe, or softpipe where Mesa is built without LLVM. mpv rejects a software renderer while probing, and mpv 0.41 then aborts with `vo_x11_init: Assertion '!vo->x11' failed`: its Wayland context does not clean up after a failed init, and the X11 context it tries next asserts on the leftover (fixed upstream in mpv-player/mpv@a58dd8ac41, not yet in a release). `gpu-sw=yes` lets mpv draw on llvmpipe or softpipe there instead. It changes nothing where the context mpv picks has a hardware renderer.
 
diff --git a/omarchy-mac/bin/omarchy-mac-setup-system b/omarchy-mac/bin/omarchy-mac-setup-system
index 808aded..25d6f50 100755
--- a/omarchy-mac/bin/omarchy-mac-setup-system
+++ b/omarchy-mac/bin/omarchy-mac-setup-system
@@ -51,18 +51,19 @@ elif [[ -f $brcmfmac ]] && grep -Fxq -- "$quirk" "$brcmfmac"; then
   echo "Removed the Intel Mac Broadcom quirk from $brcmfmac; it stops applying at the next reboot"
 fi
 
-# The earlier mpv default lacks gpu-sw, so mpv aborts where the GPU has no
-# driver, and tmpfiles never replaces the copy it made. Only a regular file
-# byte-identical to that copy takes the new default; edits and links stay.
+# Earlier mpv defaults lack gpu-sw (0.2.2, so mpv aborts where the GPU has no
+# driver) or AV1 (0.2.3, so AV1 plays in software where the decoder has it), and
+# tmpfiles never replaces the copy it made. Only a regular file byte-identical
+# to one of those copies takes the new default; edits and links stay.
 mpv="$root/etc/mpv/mpv.conf"
-released_mpv_sum=9e186dd88be483b3666795b805e780921adecd1051ae85986857c22152a2d818
-if [[ -f $mpv && ! -L $mpv ]] && [[ $(sha256sum <"$mpv") == "$released_mpv_sum  -" ]]; then
+released_mpv_sums=" 9e186dd88be483b3666795b805e780921adecd1051ae85986857c22152a2d818 3875d4bd3d4e64c8ffb95429d4029c5e4b47a94f36ae9d4132dfca95ba3c0a67 "
+if [[ -f $mpv && ! -L $mpv ]] && [[ $released_mpv_sums == *" $(sha256sum <"$mpv" | cut -d' ' -f1) "* ]]; then
   updated=$(mktemp "$root/etc/mpv/.mpv.conf.XXXXXX")
   cp -- "$root/usr/share/omarchy-mac/mpv/mpv.conf" "$updated" || { rm -f -- "$updated"; exit 1; }
   chown --reference="$mpv" "$updated"
   chmod --reference="$mpv" "$updated"
   mv -- "$updated" "$mpv"
-  echo "Updated $mpv to the current omarchy-mac default, which lets mpv draw in software where the GPU has no driver"
+  echo "Updated $mpv to the current omarchy-mac default, which lets mpv draw in software where the GPU has no driver and decode AV1 on the Apple Video Decoder"
 fi
 
 unit=omarchy-wifi-resume-fix.service
diff --git a/omarchy-mac/share/omarchy-mac/mpv/mpv.conf b/omarchy-mac/share/omarchy-mac/mpv/mpv.conf
index 73bceb4..aa4fb87 100644
--- a/omarchy-mac/share/omarchy-mac/mpv/mpv.conf
+++ b/omarchy-mac/share/omarchy-mac/mpv/mpv.conf
@@ -1,5 +1,6 @@
-# Omarchy on Apple Silicon: mpv decodes H.264, HEVC and VP9 on the Apple Video
-# Decoder and draws with the OpenGL renderer.
+# Omarchy on Apple Silicon: mpv decodes H.264, HEVC, VP9 and, where the Mac's
+# decoder has it (M3 and later), AV1 on the Apple Video Decoder and draws with
+# the OpenGL renderer. A codec the decoder lacks plays in software.
 #
 # vaapi-copy returns each decoded frame to memory, bit for bit what software
 # decoding gives. Zero-copy (hwdec=vaapi) turns green through gpu-next, whose
@@ -14,7 +15,7 @@
 # after it and wins: hwdec=no decodes in software, vo=gpu-next with gpu-api=auto
 # restores mpv's default renderer.
 hwdec=vaapi-copy
-hwdec-codecs=h264,hevc,vp9
+hwdec-codecs=h264,hevc,vp9,av1
 vo=gpu
 gpu-api=opengl
 # A Mac whose GPU has no driver yet renders on llvmpipe or softpipe; mpv 0.41
diff --git a/omarchy-mac/test/mpv-0.2.3.conf b/omarchy-mac/test/mpv-0.2.3.conf
new file mode 100644
index 0000000..73bceb4
--- /dev/null
+++ b/omarchy-mac/test/mpv-0.2.3.conf
@@ -0,0 +1,23 @@
+# Omarchy on Apple Silicon: mpv decodes H.264, HEVC and VP9 on the Apple Video
+# Decoder and draws with the OpenGL renderer.
+#
+# vaapi-copy returns each decoded frame to memory, bit for bit what software
+# decoding gives. Zero-copy (hwdec=vaapi) turns green through gpu-next, whose
+# Vulkan import on Asahi reads the colour plane from the wrong offset, and it
+# keeps frames the VA driver invalidates when its decoder closes. OpenGL draws
+# the copied frames for about a third of the CPU gpu-next needs here.
+#
+# systemd-tmpfiles copies this file from /usr/share/omarchy-mac/mpv/mpv.conf when
+# /etc/mpv/mpv.conf is missing, and never overwrites it. The one exception:
+# omarchy-mac-setup-system replaces an unedited copy of the earlier default,
+# which lacked gpu-sw, with this one. Your own ~/.config/mpv/mpv.conf is read
+# after it and wins: hwdec=no decodes in software, vo=gpu-next with gpu-api=auto
+# restores mpv's default renderer.
+hwdec=vaapi-copy
+hwdec-codecs=h264,hevc,vp9
+vo=gpu
+gpu-api=opengl
+# A Mac whose GPU has no driver yet renders on llvmpipe or softpipe; mpv 0.41
+# rejects either and then aborts in its X11 fallback. Where the context mpv
+# picks has a hardware renderer, this changes nothing.
+gpu-sw=yes
diff --git a/omarchy-mac/test/mpv-test.sh b/omarchy-mac/test/mpv-test.sh
index 0a5f3b4..1c5b3e6 100755
--- a/omarchy-mac/test/mpv-test.sh
+++ b/omarchy-mac/test/mpv-test.sh
@@ -14,13 +14,13 @@ cmp -s "$work/fresh/etc/mpv/mpv.conf" "$work/fresh/usr/share/omarchy-mac/mpv/mpv
   fail 'a fresh install gets the vendor mpv default'
 [[ $(setting "$work/fresh" hwdec) == "vaapi-copy" ]] ||
   fail 'mpv decodes on AVD with copy-back, never zero-copy' "$(setting "$work/fresh" hwdec)"
-[[ $(setting "$work/fresh" hwdec-codecs) == "h264,hevc,vp9" ]] ||
+[[ $(setting "$work/fresh" hwdec-codecs) == "h264,hevc,vp9,av1" ]] ||
   fail 'mpv asks AVD only for the codecs it decodes' "$(setting "$work/fresh" hwdec-codecs)"
 [[ $(setting "$work/fresh" vo) == "gpu" && $(setting "$work/fresh" gpu-api) == "opengl" ]] ||
   fail 'mpv draws copied frames with the OpenGL renderer'
 [[ $(setting "$work/fresh" gpu-sw) == "yes" ]] ||
   fail 'mpv draws in software on a Mac whose GPU has no driver yet' "$(setting "$work/fresh" gpu-sw)"
-pass 'a fresh install decodes H.264, HEVC and VP9 on AVD in mpv, with copy-back and OpenGL, and draws in software without a GPU driver'
+pass 'a fresh install decodes H.264, HEVC, VP9 and AV1 on AVD in mpv, with copy-back and OpenGL, and draws in software without a GPU driver'
 
 # An upgraded Mac already has /etc/mpv from mpv-mpris.
 "$ROOT"/install "$work/upgrade"
@@ -122,3 +122,18 @@ rm -r "$work/other/etc/mpv"
 setup "$work/other"
 [[ ! -e $work/other/etc/mpv ]] || fail 'setup creates no mpv.conf where none exists'
 pass 'an edited or linked mpv default, another machine and a missing one are left to tmpfiles and the administrator'
+
+# omarchy-mac 0.2.3 (to pkgrel 2.21) copied a default without AV1; setup replaces that copy too while untouched.
+released "$work/v023"
+install -m644 "$ROOT/test/mpv-0.2.3.conf" "$work/v023/etc/mpv/mpv.conf"
+setup "$work/v023"
+cmp -s "$work/v023/etc/mpv/mpv.conf" "$work/v023/usr/share/omarchy-mac/mpv/mpv.conf" ||
+  fail 'setup replaces an untouched 0.2.3 mpv default'
+[[ $(setting "$work/v023" hwdec-codecs) == "h264,hevc,vp9,av1" ]] || fail 'the replaced default decodes AV1 on AVD'
+released "$work/v023e"
+install -m644 "$ROOT/test/mpv-0.2.3.conf" "$work/v023e/etc/mpv/mpv.conf"
+printf 'profile=high-quality\n' >>"$work/v023e/etc/mpv/mpv.conf"
+cp "$work/v023e/etc/mpv/mpv.conf" "$work/expected"
+setup "$work/v023e"
+cmp -s "$work/v023e/etc/mpv/mpv.conf" "$work/expected" || fail 'an edited 0.2.3 default stays'
+pass 'an untouched 0.2.3 mpv default takes AV1 at setup; an edited one stays'
