From 7a8bc2a3bba780e74814beae16ce153f3d171826 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 09:15:24 +0000
Subject: [PATCH 19/24] Put the keyboard curve on macOS's own keyboard scale

The kernel now drives the MacBook Pro 14" M4's keyboard light on macOS's
scale: max_brightness is macOS's top level (35 % PWM duty) and 0..max
follows macOS's duty line. macOS's level is (nits - 0.10) / 14.56, so its
keyboard curve, 3.665 / 10.17 / 10.17 / 0.147 nits at 0 / 70 / 160 / 300
lux, is 0.2448 / 0.6916 / 0.6916 / 0.0032 of max_brightness.
---
 .../omarchy-mac/brightness/apple,j604.conf    | 11 +++++-----
 omarchy-mac/test/brightness-auto-test.sh      | 22 +++++++++----------
 2 files changed, 17 insertions(+), 16 deletions(-)

diff --git a/omarchy-mac/share/omarchy-mac/brightness/apple,j604.conf b/omarchy-mac/share/omarchy-mac/brightness/apple,j604.conf
index c288343..a6babc6 100644
--- a/omarchy-mac/share/omarchy-mac/brightness/apple,j604.conf
+++ b/omarchy-mac/share/omarchy-mac/brightness/apple,j604.conf
@@ -19,9 +19,10 @@ SMOOTHING=0.25            # TO-VERIFY
 HYSTERESIS_PERCENT=5      # TO-VERIFY: macOS LuxThreshold 78.5
 # Seconds between sensor reads (the sensor reports every 0.2 s).
 POLL_SECONDS=1
-# The keyboard backlight (LED class; 255 = 100 % PWM duty at 25 kHz) follows the room as macOS's keyboard curve
-# does (CoreBrightness KeyboardBacklightAdjustedBrightnessCurve, MEASURED): lux 0 / 70 / 160 / 300 against
-# 3.665 / 10.17 / 10.17 / 0.147 nits, which the ADT's kbd-backlight nits-to-pwm-percentage table turns into
-# 12.6 / 25.9 / 25.9 / 3.6 % duty. macOS's highest keyboard level is 28.5 % duty.
+# The keyboard backlight follows the room as macOS's keyboard curve does (CoreBrightness
+# KeyboardBacklightAdjustedBrightnessCurve, MEASURED): lux 0 / 70 / 160 / 300 against 3.665 / 10.17 / 10.17 /
+# 0.147 nits. The kernel drives the LED on macOS's own scale (max_brightness = macOS's top level, 35 % PWM duty;
+# 0..max on macOS's duty line, MEASURED), where macOS's level is (nits - 0.10) / 14.56 (MEASURED at 1.01 / 3.74 /
+# 7.38 / 11.02 / 14.66 nits), so the points are 0.2448 / 0.6916 / 0.6916 / 0.0032 of max_brightness.
 KBD_LED=kbd_backlight
-KBD_CURVE="0:0.1260 70:0.2585 160:0.2585 300:0.0359"   # TO-VERIFY: the table's two parts read as nits / duty pairs
+KBD_CURVE="0:0.2448 70:0.6916 160:0.6916 300:0.0032"
diff --git a/omarchy-mac/test/brightness-auto-test.sh b/omarchy-mac/test/brightness-auto-test.sh
index 099ac94..e697dee 100755
--- a/omarchy-mac/test/brightness-auto-test.sh
+++ b/omarchy-mac/test/brightness-auto-test.sh
@@ -41,8 +41,8 @@ kb() { cat "$t/leds/kbd_backlight/brightness"; }
   fail "shipped table"
 # 150 lux is macOS's 223.1 nits, reached in 20 steps (the 1.94 s ramp).
 run 150; [[ $(b) == 223 ]] || fail "150 lux -> 223 nits: $(b)"
-# The keyboard: 150 lux sits on macOS's flat 70-160 lux part, 25.85 % duty of 255 = 66.
-[[ $(kb) == 66 ]] || fail "keyboard at 150 lux -> 66: $(kb)"
+# The keyboard: 150 lux sits on macOS's flat 70-160 lux part, 0.6916 of 255 = 176.
+[[ $(kb) == 176 ]] || fail "keyboard at 150 lux -> 176: $(kb)"
 [[ $(wc -l <"$t/writes") == 20 ]] || fail "ramp steps: $(wc -l <"$t/writes")"
 # A dark room: macOS's 139.44 nits.
 run 0; [[ $(b) == 139 ]] || fail "0 lux -> 139 nits: $(b)"
@@ -52,13 +52,13 @@ run 75; [[ $(b) == 181 ]] || fail "75 lux -> 181 nits: $(b)"
 : >"$t/writes"; run 77; [[ ! -s $t/writes ]] || fail "jitter moved the panel: $(b)"
 # Bright light: the line carried on to the panel's 600 nits, and held there.
 run 1000; [[ $(b) == 600 ]] || fail "1000 lux -> 600 nits: $(b)"
-# macOS nearly turns the keyboard off in bright light (3.59 % duty of 255 = 9), never to 0.
-[[ $(kb) == 9 ]] || fail "keyboard at 1000 lux -> 9: $(kb)"
-# Between points: 230 lux -> 0.2585 + (0.0359 - 0.2585) * 70 / 140 = 0.1472 -> 38.
-run 230; [[ $(kb) == 38 ]] || fail "keyboard at 230 lux -> 38: $(kb)"
+# macOS nearly turns the keyboard off in bright light (0.0032 of 255, under 1), never to 0.
+[[ $(kb) == 1 ]] || fail "keyboard at 1000 lux -> 1: $(kb)"
+# Between points: 230 lux -> 0.6916 + (0.0032 - 0.6916) * 70 / 140 = 0.3474 -> 89.
+run 230; [[ $(kb) == 89 ]] || fail "keyboard at 230 lux -> 89: $(kb)"
 # Covered sensor and back: down to the dark level, then back up.
 run 0; [[ $(b) == 139 ]] || fail "covered: $(b)"
-[[ $(kb) == 32 ]] || fail "keyboard in the dark -> 12.6 % of 255 = 32: $(kb)"
+[[ $(kb) == 62 ]] || fail "keyboard in the dark -> 0.2448 of 255 = 62: $(kb)"
 run 75; [[ $(b) == 181 ]] || fail "uncovered: $(b)"
 # The user sets 362 nits at 75 lux (twice the curve): the curve doubles for every room.
 echo 362 >"$t/bl/apple-panel-bl/brightness"; run 75
@@ -70,10 +70,10 @@ run 150 off >/dev/null; run 0; [[ $(b) == 446 ]] || fail "off stays off: $(b)"
 run 0 on >/dev/null; run 0; [[ $(b) == 139 ]] || fail "on resumes: $(b)"
 # Omarchy's own automatic brightness running: step aside.
 touch "$t/stock"; run 150; [[ $(b) == 139 ]] || fail "stock service wins: $(b)"; rm "$t/stock"
-# The keyboard set by hand to 16 in the dark (half the curve): it halves for every room.
-echo 16 >"$t/leds/kbd_backlight/brightness"; run 0
-[[ $(cat "$t/config/omarchy-mac/brightness-auto-kbd-scale") == 0.4980 ]] || fail "kbd scale: $(cat "$t/config/omarchy-mac/brightness-auto-kbd-scale")"
-run 75; [[ $(kb) == 33 ]] || fail "scaled keyboard at 75 lux -> 33: $(kb)"
+# The keyboard set by hand to 31 in the dark (half the curve): it halves for every room.
+echo 31 >"$t/leds/kbd_backlight/brightness"; run 0
+[[ $(cat "$t/config/omarchy-mac/brightness-auto-kbd-scale") == 0.4966 ]] || fail "kbd scale: $(cat "$t/config/omarchy-mac/brightness-auto-kbd-scale")"
+run 75; [[ $(kb) == 88 ]] || fail "scaled keyboard at 75 lux -> 88: $(kb)"
 rm "$t/config/omarchy-mac/brightness-auto-kbd-scale"
 # A keyboard light turned off (by hand or idle) stays off.
 echo 0 >"$t/leds/kbd_backlight/brightness"; run 1000; run 0; [[ $(kb) == 0 ]] || fail "keyboard off stays off: $(kb)"
