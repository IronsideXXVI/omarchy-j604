diff --git a/omarchy-mac/vendor/systemd/user/omarchy-mac-truetone.service b/omarchy-mac/vendor/systemd/user/omarchy-mac-truetone.service
new file mode 100644
index 0000000..a297eb4
--- /dev/null
+++ b/omarchy-mac/vendor/systemd/user/omarchy-mac-truetone.service
@@ -0,0 +1,15 @@
+[Unit]
+Description=Match the built-in display's white to the room light (True Tone)
+# hyprsunset holds Hyprland's CTM protocol; Omarchy starts it with the session.
+After=graphical-session.target
+PartOf=graphical-session.target
+
+[Service]
+Type=simple
+ExecCondition=/usr/bin/omarchy-hw-apple-silicon
+ExecStart=/usr/bin/omarchy-mac-truetone
+Restart=on-failure
+RestartSec=10
+
+[Install]
+WantedBy=graphical-session.target
