From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 03:14:11 +0000
Subject: [PATCH] Offer Touch ID on the J604 (MacBook Pro 14-inch, M4)

linux-aurora's apple_sep has a J604 profile (T8132 SoC, R3 sensor), and
the J604 device tree enables the SEP mailbox, spi2 and the Mesa sensor
with the sep alias, so setup can turn Touch ID on there the same way as
on the other supported boards: same consent, same calibration carve from
the iBoot System Container, same driver options and readiness checks.
Other T8132 boards stay unsupported here.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 omarchy-mac/lib/touchid-eligibility      | 3 ++-
 omarchy-mac/test/touchid-consent-test.sh | 4 ++++
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/omarchy-mac/lib/touchid-eligibility b/omarchy-mac/lib/touchid-eligibility
index f778ce0..e18f537 100755
--- a/omarchy-mac/lib/touchid-eligibility
+++ b/omarchy-mac/lib/touchid-eligibility
@@ -51,7 +51,8 @@ if compatible apple,t8103 || compatible apple,t6000 || compatible apple,t6001; t
   echo unsupported:m1-family
   exit 0
 elif ! compatible apple,t8112 && ! compatible apple,t6020 && ! compatible apple,t6021 && ! compatible apple,t8140 &&
-  ! { compatible apple,t8122 && { compatible apple,j613 || compatible apple,j615; }; }; then
+  ! { compatible apple,t8122 && { compatible apple,j613 || compatible apple,j615; }; } &&
+  ! { compatible apple,t8132 && compatible apple,j604; }; then
   echo unsupported:board
   exit 0
 fi
diff --git a/omarchy-mac/test/touchid-consent-test.sh b/omarchy-mac/test/touchid-consent-test.sh
index 287685a..5e221cd 100644
--- a/omarchy-mac/test/touchid-consent-test.sh
+++ b/omarchy-mac/test/touchid-consent-test.sh
@@ -178,6 +178,10 @@ machine apple,j504 apple,t8122 apple,arm-platform
 [[ $(eligibility) == "unsupported:board" ]] || fail 'a T8122 board whose wiring the driver has not read is unsupported'
 machine apple,j613 apple,t8122 apple,arm-platform
 [[ $(eligibility) == "available" ]] || fail 'the M3 Air J613 is available'
+machine apple,j713 apple,t8132 apple,arm-platform
+[[ $(eligibility) == "unsupported:board" ]] || fail 'a T8132 board other than the J604 stays unsupported here'
+machine apple,j604 apple,t8132 apple,arm-platform
+[[ $(eligibility) == "available" ]] || fail 'the M4 MacBook Pro J604 is available'
 rm "$tree/chosen/apfs-preboot-uuid"
 [[ $(eligibility) == "unsupported:no-os-identity" ]] || fail 'without the forwarded identity there is no lane for Linux'
 neo
-- 
