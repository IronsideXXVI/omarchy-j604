From 5afb58b6f68426f32f04841333b318ee3db16c77 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 13:08:26 +0000
Subject: [PATCH 17/24] omarchy-mac: re-apply Chromium's flags when omarchy-mac
 itself updates

The Chromium flags hook ran only on chromium transactions. When
omarchy-mac brought a new lib/chromium-flags on its own, as 2.26 did
with the J604's hardware encoder, the flags kept the old rules until
the next Chromium update: the J604 ran Chromium 1.608 without
AcceleratedVideoEncoder.

Trigger the hook on omarchy-mac as well, so a changed rule reaches every
account's flags in the transaction that carries it.
---
 .../share/libalpm/hooks/91-omarchy-mac-chromium-decoder.hook   | 3 +++
 omarchy-mac/test/desktop-setup-test.sh                         | 1 +
 2 files changed, 4 insertions(+)

diff --git a/omarchy-mac/share/libalpm/hooks/91-omarchy-mac-chromium-decoder.hook b/omarchy-mac/share/libalpm/hooks/91-omarchy-mac-chromium-decoder.hook
index 4f58426..5943bcf 100644
--- a/omarchy-mac/share/libalpm/hooks/91-omarchy-mac-chromium-decoder.hook
+++ b/omarchy-mac/share/libalpm/hooks/91-omarchy-mac-chromium-decoder.hook
@@ -1,11 +1,14 @@
 # Chromium's hardware decode flags follow the installed Chromium: the J604's
 # carried build decodes every codec on the Apple Video Decoder, any other build
 # gets the 10-bit, AV1 and HEVC workaround switches back (lib/chromium-flags).
+# It also runs when omarchy-mac itself changes, so a new lib/chromium-flags
+# reaches the flags without waiting for the next Chromium update.
 [Trigger]
 Type = Package
 Operation = Install
 Operation = Upgrade
 Target = chromium
+Target = omarchy-mac
 
 [Action]
 Description = Updating Chromium's hardware video decode flags...
diff --git a/omarchy-mac/test/desktop-setup-test.sh b/omarchy-mac/test/desktop-setup-test.sh
index e3b14f5..86f51d7 100644
--- a/omarchy-mac/test/desktop-setup-test.sh
+++ b/omarchy-mac/test/desktop-setup-test.sh
@@ -263,6 +263,7 @@ TEST_COMPATIBLE='apple,j604' TEST_CHROMIUM=156.0.8078.79-1 "$setup_user" "$stage
 TEST_COMPATIBLE='apple,j604' TEST_CHROMIUM=156.0.8078.79-1.607 "$setup_user" "$stage"
 hook=$stage/usr/share/libalpm/hooks/91-omarchy-mac-chromium-decoder.hook
 [[ -f $hook ]] && grep -Fxq 'Type = Package' "$hook" && grep -Fxq 'Target = chromium' "$hook" &&
+  grep -Fxq 'Target = omarchy-mac' "$hook" &&
   grep -Fxq 'Operation = Install' "$hook" && grep -Fxq 'Operation = Upgrade' "$hook" &&
   grep -Fxq 'When = PostTransaction' "$hook" &&
   grep -Fxq "Exec = /usr/bin/sh -c 'systemd-detect-virt --quiet --chroot || /usr/lib/omarchy-mac/chromium-flags-users || true'" "$hook" ||
