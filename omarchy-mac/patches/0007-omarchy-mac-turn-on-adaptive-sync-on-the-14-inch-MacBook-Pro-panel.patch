From 5d6bda0ffdd6356cc2dfaa7a4b30e16c8b84fd5a Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 20:10:43 +0000
Subject: [PATCH] omarchy-mac: turn on adaptive sync on the 14-inch MacBook Pro
 panel

The panel line in displays.conf gains vrr=1, so the built-in ProMotion panel gets Hyprland adaptive sync (the kernel offers a 24-120 Hz range) and an idle desktop no longer holds it at 120 Hz. External monitors are untouched. Needs omarchy panel-defaults with the vrr key; an older one skips the word.
---
 omarchy-mac/share/omarchy-platform/displays.conf | 5 +++--
 omarchy-mac/test/desktop-setup-test.sh           | 6 +++---
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/omarchy-mac/share/omarchy-platform/displays.conf b/omarchy-mac/share/omarchy-platform/displays.conf
index 766cbfd..53e6230 100644
--- a/omarchy-mac/share/omarchy-platform/displays.conf
+++ b/omarchy-mac/share/omarchy-platform/displays.conf
@@ -5,5 +5,6 @@ backlight-skip 228600000.dsi.0
 backlight-prefer apple-panel-bl
 # DCP registers no DDC channel; a probe would walk the SoC's SMBus for ~3 s
 ddc-require-connector-ddc
-# The 14" MacBook Pro's panel: 10-bit frames in Display P3 (Hyprland's defaults are 8 bits and sRGB)
-panel eDP 3024x1964 bitdepth=10 cm=dp3
+# The 14" MacBook Pro's panel: 10-bit frames in Display P3 (Hyprland's defaults are 8 bits and sRGB) and
+# adaptive sync, so an idle desktop can drop the 120 Hz ProMotion panel toward 24 Hz as macOS does
+panel eDP 3024x1964 bitdepth=10 cm=dp3 vrr=1
diff --git a/omarchy-mac/test/desktop-setup-test.sh b/omarchy-mac/test/desktop-setup-test.sh
index 264e99e..5ed03fa 100644
--- a/omarchy-mac/test/desktop-setup-test.sh
+++ b/omarchy-mac/test/desktop-setup-test.sh
@@ -42,8 +42,8 @@ while IFS= read -r line || [[ -n $line ]]; do
     [[ -n $argument && $argument != */* && $argument != . && $argument != .. && $mode =~ ^[0-9]+x[0-9]+$ && -n $settings ]] ||
       fail "displays.conf: $directive takes a connector, a mode and settings" "$line"
     for setting in $settings; do
-      [[ $setting =~ ^bitdepth=(8|10)$ || $setting =~ ^cm=(srgb|dp3|dcip3|adobe|wide|edid)$ ]] ||
-        fail "displays.conf: $directive sets bitdepth (8 or 10) or cm (a Hyprland SDR preset)" "$line"
+      [[ $setting =~ ^bitdepth=(8|10)$ || $setting =~ ^cm=(srgb|dp3|dcip3|adobe|wide|edid)$ || $setting =~ ^vrr=(0|1|2|3)$ ]] ||
+        fail "displays.conf: $directive sets bitdepth (8 or 10), cm (a Hyprland SDR preset) or vrr (0-3)" "$line"
     done
     # Only a panel the bar also knows: the same connector and mode as a cutout.
     python3 -c 'import json, sys; c, w, h = sys.argv[2], *map(int, sys.argv[3].split("x")); sys.exit(not any(p["connector"] == c and p["width"] == w and p["height"] == h for p in json.load(open(sys.argv[1]))["panels"]))' \
@@ -53,7 +53,7 @@ while IFS= read -r line || [[ -n $line ]]; do
   esac
   directives+=("$directive${argument:+ $argument}")
 done <"$platform/displays.conf"
-[[ ${directives[*]} == 'backlight-skip display-pipe backlight-skip 228600000.dsi.0 backlight-prefer apple-panel-bl ddc-require-connector-ddc panel eDP 3024x1964 bitdepth=10 cm=dp3' ]] ||
+[[ ${directives[*]} == 'backlight-skip display-pipe backlight-skip 228600000.dsi.0 backlight-prefer apple-panel-bl ddc-require-connector-ddc panel eDP 3024x1964 bitdepth=10 cm=dp3 vrr=1' ]] ||
   fail 'displays.conf skips the Touch Bar backlights, prefers the Retina panel, probes DDC only where a connector has it and runs the 14" MacBook Pro panel at 10 bits in Display P3' "${directives[*]}"
 for helper in electron-launchers electron-desktop-entries; do
   [[ -x $stage/usr/lib/omarchy-mac/$helper ]] || fail "$helper is staged"
-- 
2.43.0

