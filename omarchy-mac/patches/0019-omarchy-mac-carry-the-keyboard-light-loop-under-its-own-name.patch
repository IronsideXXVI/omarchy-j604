diff --git a/omarchy-mac/bin/omarchy-brightness-keyboard-auto b/omarchy-mac/bin/omarchy-brightness-keyboard-auto
new file mode 100755
index 0000000..bbabf09
--- /dev/null
+++ b/omarchy-mac/bin/omarchy-brightness-keyboard-auto
@@ -0,0 +1,290 @@
+#!/bin/bash
+
+# omarchy:summary=Drive keyboard backlight from the ambient light sensor
+# omarchy:args=[--once|--available|--map-lux N]
+# omarchy:examples=omarchy brightness keyboard auto --once | omarchy brightness keyboard auto --map-lux 12
+
+# Inverse of display auto-brightness: dark rooms need the keys lit, bright
+# rooms do not. Dedicated keyboard-brightness keys (or any other write to the
+# LED) pause auto until ambient light moves enough that the old choice no
+# longer fits. Keys left off by something other than those keys (lock
+# blanking, a restored 0, a 1% leftover) are not a choice: auto resumes.
+
+set -euo pipefail
+
+# Off Apple Silicon there is nothing to drive (and --available says so).
+if ! omarchy-hw-apple-silicon 2>/dev/null; then
+  [[ " $* " == *" --available "* ]] && exit 1
+  exit 0
+fi
+
+POLL_SECONDS=5
+DARK_LUX=8
+BRIGHT_LUX=180
+DEADBAND_PERCENT=4
+OVERRIDE_LUX_DELTA=20
+OVERRIDE_LUX_RATIO=40
+# 2/255 is 1% and invisible, so that band counts as off.
+EFFECTIVELY_OFF_PERCENT=2
+MANUAL_LEVEL_FILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-keyboard-manual"
+
+# A Mac with a curve of its own in its brightness table (KBD_CURVE, "lux:fraction ...", the share of the
+# LED's maximum, macOS's own keyboard curve) follows that instead of the dark/bright line below.
+model_curve() {
+  local compatible=${OMARCHY_MAC_DT_COMPATIBLE:-/proc/device-tree/compatible} model file
+  [[ -r $compatible ]] || return 0
+  model=$(tr '\0' '\n' <"$compatible" | head -n1) || true
+  file="${OMARCHY_MAC_BRIGHTNESS_DIR:-/usr/share/omarchy-mac/brightness}/$model.conf"
+  [[ -n $model && -r $file ]] || return 0
+  sed -n 's/^KBD_CURVE="\([^"]*\)".*/\1/p' "$file" | head -n1
+}
+KBD_CURVE=$(model_curve)
+
+once=0
+available_only=0
+map_lux=""
+
+while (($#)); do
+  case "$1" in
+    --once)
+      once=1
+      shift
+      ;;
+    --available)
+      available_only=1
+      shift
+      ;;
+    --map-lux)
+      if [[ -z ${2:-} ]]; then
+        echo "Usage: omarchy-brightness-keyboard-auto --map-lux N" >&2
+        exit 1
+      fi
+      map_lux=$2
+      shift 2
+      ;;
+    -h|--help)
+      echo "Usage: omarchy-brightness-keyboard-auto [--once|--available|--map-lux N]"
+      exit 0
+      ;;
+    *)
+      echo "Unknown option: $1" >&2
+      echo "Usage: omarchy-brightness-keyboard-auto [--once|--available|--map-lux N]" >&2
+      exit 1
+      ;;
+  esac
+done
+
+lux_to_percent() {
+  local lux=$1
+  (( lux < 0 )) && lux=0
+
+  if [[ -n ${KBD_CURVE:-} ]]; then
+    # Between points a straight line, held flat past the ends; a share above zero stays at least 1 %.
+    awk -v lux="$lux" -v curve="$KBD_CURVE" 'BEGIN {
+      n = split(curve, p, " ")
+      for (i = 1; i <= n; i++) { split(p[i], kv, ":"); x[i] = kv[1]; y[i] = kv[2] }
+      if (lux <= x[1]) f = y[1]
+      else if (lux >= x[n]) f = y[n]
+      else for (i = 2; i <= n; i++) if (lux <= x[i]) { f = y[i-1] + (y[i] - y[i-1]) * (lux - x[i-1]) / (x[i] - x[i-1]); break }
+      pc = int(f * 100 + 0.5); if (f > 0 && pc < 1) pc = 1; print pc
+    }'
+    return 0
+  fi
+
+  if (( lux <= DARK_LUX )); then
+    echo 100
+  elif (( lux >= BRIGHT_LUX )); then
+    echo 0
+  else
+    echo $(( (100 * (BRIGHT_LUX - lux)) / (BRIGHT_LUX - DARK_LUX) ))
+  fi
+}
+
+if [[ -n $map_lux ]]; then
+  [[ $map_lux =~ ^[0-9]+$ ]] || {
+    echo "lux must be a non-negative integer" >&2
+    exit 1
+  }
+  lux_to_percent "$map_lux"
+  exit 0
+fi
+
+find_als() {
+  local d name
+  local iio_devices_dir=${OMARCHY_IIO_DEVICES_DIR:-/sys/bus/iio/devices}
+
+  # Prefer a device that names itself as ALS. Apple AOP exposes the lid-angle
+  # sensor (aop-sensors-las) next to the illuminance sensor (aop-sensors-als);
+  # walking sysfs in device-number order would otherwise pick whichever one
+  # happens to publish an illuminance channel first.
+  for d in "$iio_devices_dir"/iio:device*; do
+    [[ -r $d/name ]] || continue
+    name=$(<"$d/name")
+    [[ $name == *als* ]] || continue
+    if [[ -r $d/in_illuminance_input ]]; then
+      printf '%s\n' "$d/in_illuminance_input"
+      return 0
+    fi
+    if [[ -r $d/in_illuminance_raw ]]; then
+      printf '%s\n' "$d/in_illuminance_raw"
+      return 0
+    fi
+  done
+
+  for d in "$iio_devices_dir"/iio:device*; do
+    if [[ -r $d/in_illuminance_input ]]; then
+      printf '%s\n' "$d/in_illuminance_input"
+      return 0
+    fi
+    if [[ -r $d/in_illuminance_raw ]]; then
+      printf '%s\n' "$d/in_illuminance_raw"
+      return 0
+    fi
+  done
+  return 1
+}
+
+find_kbd() {
+  local candidate
+  local leds_dir=${OMARCHY_LEDS_DIR:-/sys/class/leds}
+
+  for candidate in "$leds_dir"/*kbd_backlight*; do
+    if [[ -e $candidate/brightness && -r $candidate/max_brightness ]]; then
+      printf '%s\n' "$candidate"
+      return 0
+    fi
+  done
+  return 1
+}
+
+als_path=$(find_als || true)
+kbd_path=$(find_kbd || true)
+
+if [[ $available_only == 1 ]]; then
+  if [[ -n $als_path && -n $kbd_path ]]; then
+    exit 0
+  else
+    exit 1
+  fi
+fi
+
+if [[ -z $als_path || -z $kbd_path ]]; then
+  exit 0
+fi
+
+device=$(basename "$kbd_path")
+max=$(<"$kbd_path/max_brightness")
+[[ $max =~ ^[1-9][0-9]*$ ]] || exit 0
+
+last_set=""
+paused=0
+pause_lux=0
+
+session_locked() {
+  omarchy-hyprland-session-locked >/dev/null 2>&1
+}
+
+lid_closed() {
+  omarchy-hw-laptop-closed >/dev/null 2>&1
+}
+
+read_lux() {
+  local raw
+  raw=$(<"$als_path") || return 1
+  raw=${raw%%.*}
+  [[ $raw =~ ^[0-9]+$ ]] || return 1
+  printf '%s\n' "$raw"
+}
+
+apply_percent() {
+  local percent=$1
+  local target current delta
+
+  (( percent < 0 )) && percent=0
+  (( percent > 100 )) && percent=100
+  target=$(( max * percent / 100 ))
+
+  current=$(brightnessctl -d "$device" get) || return 0
+  delta=$(( current - target ))
+  (( delta < 0 )) && delta=$(( -delta ))
+  if (( delta * 100 < max * DEADBAND_PERCENT )); then
+    last_set=$current
+    return 0
+  fi
+
+  brightnessctl -d "$device" set "$target" >/dev/null
+  # Auto has overridden any level set by hand, so that record is stale.
+  rm -f "$MANUAL_LEVEL_FILE"
+  last_set=$(brightnessctl -d "$device" get || echo "$target")
+}
+
+# Off by accident rather than by the keyboard-brightness keys, which record
+# every level they set.
+left_off() {
+  local current=$1 manual=""
+
+  (( current * 100 <= max * EFFECTIVELY_OFF_PERCENT )) || return 1
+  # Stock omarchy-brightness-keyboard keeps the level from before an "off" (the lock's blank, idle)
+  # until its "restore": a blank with that record was not the user's choice.
+  [[ -s "${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-keyboard-$device" ]] && return 0
+  # A keyboard-brightness command that records every level it sets (MANUAL_LEVEL_FILE) says which
+  # off was set by hand; stock steps to off with the keys leave no record, and that off is a choice.
+  [[ -r $MANUAL_LEVEL_FILE ]] || return 1
+  manual=$(<"$MANUAL_LEVEL_FILE")
+  [[ $manual != "$current" ]]
+}
+
+tick() {
+  local lux current delta threshold
+
+  lux=$(read_lux) || return 0
+
+  if session_locked || lid_closed; then
+    return 0
+  fi
+
+  current=$(brightnessctl -d "$device" get) || return 0
+
+  if [[ -n $last_set && $current != "$last_set" ]]; then
+    last_set=$current
+    if left_off "$current"; then
+      paused=0
+    else
+      paused=1
+      pause_lux=$lux
+      return 0
+    fi
+  fi
+
+  if (( paused )); then
+    delta=$(( lux - pause_lux ))
+    (( delta < 0 )) && delta=$(( -delta ))
+    threshold=$OVERRIDE_LUX_DELTA
+    if (( pause_lux * OVERRIDE_LUX_RATIO / 100 > threshold )); then
+      threshold=$(( pause_lux * OVERRIDE_LUX_RATIO / 100 ))
+    fi
+    if (( delta < threshold )); then
+      return 0
+    fi
+    paused=0
+  fi
+
+  apply_percent "$(lux_to_percent "$lux")"
+}
+
+tick
+
+if (( once )); then
+  exit 0
+fi
+
+while true; do
+  sleep "$POLL_SECONDS"
+  als_path=$(find_als || true)
+  kbd_path=$(find_kbd || true)
+  [[ -n $als_path && -n $kbd_path ]] || continue
+  device=$(basename "$kbd_path")
+  max=$(<"$kbd_path/max_brightness")
+  [[ $max =~ ^[1-9][0-9]*$ ]] || continue
+  tick
+done
