From 267114c010a90482222380e8b5e9861b81087adf Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 03:39:16 +0000
Subject: [PATCH 24/24] Keep Wi-Fi power save on for the Broadcom chips

Omarchy turns Wi-Fi power save off everywhere because of latency
spikes and Intel firmware that drops the link. With the kernel's 20 ms
sleep return on the BCM4388, power save on brings the 14-inch M4
MacBook Pro's Wi-Fi rail from 477 mW to 114 mW. macOS idles at 118 mW.
Turn it back on for brcmfmac devices only.

---
 .../vendor/NetworkManager/conf.d/20-omarchy-mac-wifi.conf  | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/omarchy-mac/vendor/NetworkManager/conf.d/20-omarchy-mac-wifi.conf b/omarchy-mac/vendor/NetworkManager/conf.d/20-omarchy-mac-wifi.conf
index 437452b..9e385bd 100644
--- a/omarchy-mac/vendor/NetworkManager/conf.d/20-omarchy-mac-wifi.conf
+++ b/omarchy-mac/vendor/NetworkManager/conf.d/20-omarchy-mac-wifi.conf
@@ -6,3 +6,10 @@ wifi.backend=iwd
 [device-omarchy-mac-mt7932]
 match-device=driver:mt7932-fullmac
 wifi.iwd.autoconnect=false
+
+# Omarchy keeps Wi-Fi power save off for every machine. On the Broadcom
+# chips the kernel now naps 20 ms after the last frame (BCM4388), which
+# brings the Wi-Fi rail down to what macOS draws idle, so keep it on there.
+[connection-omarchy-mac-brcmfmac]
+match-device=driver:brcmfmac
+wifi.powersave=3
