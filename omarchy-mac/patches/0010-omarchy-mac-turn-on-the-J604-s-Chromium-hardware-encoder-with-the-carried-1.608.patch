From 932cdb7d393013c86ccf7d3b4916b6cb3b3bc3c5 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 08:16:32 +0000
Subject: [PATCH 11/24] omarchy-mac: turn on the J604's Chromium hardware
 encoder with the carried 1.608

The J604's carried Chromium from local pkgrel N.608 on builds the V4L2
video encoder and creates it on Linux, so WebCodecs, WebRTC and screen
recording in the browser can encode H.264 on the AVE. Chromium runs it only
with the AcceleratedVideoEncoder feature.

Add the feature to chromium-flags.conf on the J604 when the installed
Chromium is that build, once, next to AcceleratedVideoDecoder. An older
carried build and the stock one have no such encoder, so there the feature
comes off again. The pacman hook re-applies this after every chromium
transaction, as it does for the decoder. Other Macs and other browsers are
unchanged.
---
 omarchy-mac/lib/chromium-flags         | 17 +++++++++++++++++
 omarchy-mac/test/desktop-setup-test.sh | 13 +++++++++++++
 2 files changed, 30 insertions(+)
 mode change 100755 => 100644 omarchy-mac/lib/chromium-flags

diff --git a/omarchy-mac/lib/chromium-flags b/omarchy-mac/lib/chromium-flags
old mode 100755
new mode 100644
index 28389e6..a13a168
--- a/omarchy-mac/lib/chromium-flags
+++ b/omarchy-mac/lib/chromium-flags
@@ -56,6 +56,22 @@ enable_decoder() {
     echo "$switch" >>"$1"
   done
 }
+# The carried Chromium from local pkgrel N.608 on also has the V4L2 video
+# encoder (the J604's AVE) built, which runs only with the AcceleratedVideoEncoder
+# feature. Older and stock builds have no such encoder, so there the feature
+# comes off again.
+chromium_encodes() {
+  [[ $(pacman -Q chromium 2>/dev/null) =~ ^chromium\ [^[:space:]]+-[0-9]+\.6([0-9][0-9])$ ]] &&
+    (( 10#${BASH_REMATCH[1]} >= 8 ))
+}
+enable_encoder() {
+  sed -i -E '/^--disable-features=/{s/([=,])AcceleratedVideoEncoder([,[:space:]]|$)/\1\2/;s/,,/,/;s/=,/=/;s/,([[:space:]]|$)/\1/;/^--disable-features=[[:space:]]*$/d}' "$1"
+  if chromium_encodes; then
+    sed -i -E '/^--enable-features=/{/[=,]AcceleratedVideoEncoder([,[:space:]]|$)/!s/^(--enable-features=[^[:space:]]*)/\1,AcceleratedVideoEncoder/}' "$1"
+  else
+    sed -i -E '/^--enable-features=/{s/([=,])AcceleratedVideoEncoder([,[:space:]]|$)/\1\2/;s/,,/,/;s/=,/=/;s/,([[:space:]]|$)/\1/;/^--enable-features=[[:space:]]*$/d}' "$1"
+  fi
+}
 flag_dirs=("$config")
 [[ $config == "$HOME/.config" ]] || flag_dirs+=("$HOME/.config")
 for flags_dir in "${flag_dirs[@]}"; do
@@ -63,6 +79,7 @@ for flags_dir in "${flag_dirs[@]}"; do
     [[ -f $flags ]] || continue
     if chromium_decodes "$flags"; then
       enable_decoder "$flags"
+      enable_encoder "$flags"
     elif grep -q -- '^--disable-features=' "$flags"; then
       sed -i -E '/^--disable-features=/{/[=,]AcceleratedVideoDecoder([,[:space:]]|$)/!s/^(--disable-features=[^[:space:]]*)/\1,AcceleratedVideoDecoder/;s/^--disable-features=,/--disable-features=/}' "$flags"
     else
diff --git a/omarchy-mac/test/desktop-setup-test.sh b/omarchy-mac/test/desktop-setup-test.sh
index 5973499..e3b14f5 100644
--- a/omarchy-mac/test/desktop-setup-test.sh
+++ b/omarchy-mac/test/desktop-setup-test.sh
@@ -248,6 +248,19 @@ TEST_COMPATIBLE='apple,j604' TEST_CHROMIUM=156.0.8078.79-1 "$setup_user" "$stage
 TEST_COMPATIBLE='apple,j604' TEST_CHROMIUM=156.0.8078.79-1.607 "$setup_user" "$stage"
 [[ $(<"$flags") == $'--ozone-platform=wayland\n--enable-features=TouchpadOverscrollHistoryNavigation,OverlayScrollbar,AcceleratedVideoDecoder\n--no-default-browser-check' ]] ||
   fail 'the carried Chromium takes the switches off again' "$(cat "$flags")"
+TEST_COMPATIBLE='apple,j604' TEST_CHROMIUM=156.0.8078.79-1.608 "$setup_user" "$stage"
+TEST_COMPATIBLE='apple,j604' TEST_CHROMIUM=156.0.8078.79-1.608 "$setup_user" "$stage"
+[[ $(<"$flags") == $'--ozone-platform=wayland\n--enable-features=TouchpadOverscrollHistoryNavigation,OverlayScrollbar,AcceleratedVideoDecoder,AcceleratedVideoEncoder\n--no-default-browser-check' ]] ||
+  fail "the J604's carried Chromium 1.608 turns the hardware encoder on, once" "$(cat "$flags")"
+TEST_COMPATIBLE='apple,j604' TEST_CHROMIUM=156.0.8078.79-1.607 "$setup_user" "$stage"
+[[ $(<"$flags") == $'--ozone-platform=wayland\n--enable-features=TouchpadOverscrollHistoryNavigation,OverlayScrollbar,AcceleratedVideoDecoder\n--no-default-browser-check' ]] ||
+  fail 'a carried Chromium without the encoder takes the feature off again' "$(cat "$flags")"
+TEST_COMPATIBLE='apple,j604' TEST_CHROMIUM=156.0.8078.79-1.610 "$setup_user" "$stage"
+grep -Eq -- '^--enable-features=.*,AcceleratedVideoEncoder$' "$flags" ||
+  fail 'a later carried Chromium keeps the encoder' "$(cat "$flags")"
+TEST_COMPATIBLE='apple,j604' TEST_CHROMIUM=156.0.8078.79-1 "$setup_user" "$stage"
+! grep -q AcceleratedVideoEncoder "$flags" || fail 'a stock Chromium gets no encoder feature' "$(cat "$flags")"
+TEST_COMPATIBLE='apple,j604' TEST_CHROMIUM=156.0.8078.79-1.607 "$setup_user" "$stage"
 hook=$stage/usr/share/libalpm/hooks/91-omarchy-mac-chromium-decoder.hook
 [[ -f $hook ]] && grep -Fxq 'Type = Package' "$hook" && grep -Fxq 'Target = chromium' "$hook" &&
   grep -Fxq 'Operation = Install' "$hook" && grep -Fxq 'Operation = Upgrade' "$hook" &&
