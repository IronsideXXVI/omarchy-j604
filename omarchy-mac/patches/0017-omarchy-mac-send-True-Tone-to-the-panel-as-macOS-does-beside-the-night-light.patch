-status() {
-  local enabled=true
-  [[ -e $off_file ]] && enabled=false
-  echo "True Tone: $([[ $enabled == true ]] && echo on || echo off), white $(current_kelvin || echo '?') K"
+# One panel_adaptation line (nine S31.32 values) per frame from white "$1 $2" to white "$3 $4", along
+# RAMP_CURVE (the share of the matrix's move still to go against seconds); the last line is the target.
+ramp_lines() {
+  awk -v x0="$1" -v y0="$2" -v x1="$3" -v y1="$4" -v rx="$REFERENCE_X" -v ry="$REFERENCE_Y" \
+      -v lms="$ADAPT_LMS" -v pm="$ADAPT_P" -v qm="$ADAPT_Q" -v curve="$RAMP_CURVE" \
+      -v total="$RAMP_SECONDS" -v frame="$FRAME_SECONDS" -v id="$identity" '
+    function left(t,   i) {
+      if (t <= ct[1]) return cv[1]
+      for (i = 2; i <= nc; i++) if (t <= ct[i]) return cv[i-1] + (cv[i] - cv[i-1]) * (t - ct[i-1]) / (ct[i] - ct[i-1])
+      return 0
+    }
+    function cone(x, y, o,   X, Z) {
+      X = x / y; Z = (1 - x - y) / y
+      o[1] = L[1] * X + L[2] + L[3] * Z; o[2] = L[4] * X + L[5] + L[6] * Z; o[3] = L[7] * X + L[8] + L[9] * Z
+    }
+    # The adaptation for white x y into r[1..9] (plain numbers).
+    function mat(x, y, r,   c, g, i, j, k, v, m, rs, top) {
+      if ((x - rx)^2 + (y - ry)^2 < 1e-10) { for (i = 1; i <= 9; i++) r[i] = (i % 4 == 1) ? 1 : 0; return }
+      cone(x, y, c)
+      for (k = 1; k <= 3; k++) g[k] = c[k] / d[k]
+      top = 0
+      for (i = 1; i <= 3; i++) {
+        rs = 0
+        for (j = 1; j <= 3; j++) {
+          v = 0
+          for (k = 1; k <= 3; k++) v += P[(i-1)*3+k] * g[k] * Q[(k-1)*3+j]
+          m[i, j] = v; rs += v
+        }
+        if (rs > top) top = rs
+      }
+      for (i = 1; i <= 3; i++) for (j = 1; j <= 3; j++) r[(i-1)*3+j] = m[i, j] / top
+    }
+    function fmt(r,   i, out) {
+      out = sprintf("%.0f", r[1] * 4294967296)
+      for (i = 2; i <= 9; i++) out = out sprintf(" %.0f", r[i] * 4294967296)
+      return out
+    }
+    BEGIN {
+      split(lms, L, " "); split(pm, P, " "); split(qm, Q, " ")
+      cone(rx, ry, d)
+      nc = split(curve, cp, " ")
+      for (i = 1; i <= nc; i++) { split(cp[i], kv, ":"); ct[i] = kv[1]; cv[i] = kv[2] }
+      mat(x0, y0, a); mat(x1, y1, b)
+      n = int(total / frame + 0.5); if (n < 1) n = 1
+      # macOS moves the matrix itself along the curve (MEASURED on its red gain per frame).
+      for (s = 1; s < n; s++) {
+        f = 1 - left(s * frame)
+        for (i = 1; i <= 9; i++) r[i] = a[i] + (b[i] - a[i]) * f
+        print fmt(r)
+      }
+      if ((x1 - rx)^2 + (y1 - ry)^2 < 1e-10) print id; else print fmt(b)
+    }'
 }
 
+white_now() { cat "$white_file" 2>/dev/null || echo "$REFERENCE_X $REFERENCE_Y"; }
+
+as_root() { if (( EUID == 0 )); then "$@"; else sudo "$@"; fi; }
+
 case ${1:-run} in
-  status) status; exit 0 ;;
-  off)
-    mkdir -p "$config_dir" && touch "$off_file"
-    # Give the panel its own white back unless night light holds it.
-    k=$(current_kelvin); [[ -n $k ]] && load_table && (( k >= MIN_KELVIN )) && set_kelvin "$REFERENCE_KELVIN"
-    status; exit 0 ;;
-  on) rm -f "$off_file"; status; exit 0 ;;
+  status)
+    load_table >/dev/null 2>&1; REFERENCE_X=${REFERENCE_X:-0.3127}; REFERENCE_Y=${REFERENCE_Y:-0.3290}
+    echo "True Tone: $([[ -e $off_file ]] && echo off || echo on), white x y $(white_now)"; exit 0 ;;
+  off) as_root /usr/bin/install -D -m 0644 /dev/null "$off_file" && echo "True Tone: off (the panel's own white within 2 s)"; exit 0 ;;
+  on) as_root /usr/bin/rm -f "$off_file" && echo "True Tone: on"; exit 0 ;;
+  # The matrices one move would send, one per frame (for checking the ramp): ramp x0 y0 x1 y1
+  ramp) load_table || exit 1; ramp_lines "$2" "$3" "$4" "$5"; exit 0 ;;
   run) ;;
   *) echo "Usage: omarchy-mac-truetone [on|off|status]" >&2; exit 2 ;;
 esac
 
 load_table || exit 0
 dir=$(sensor) || exit 0
+out=$(adapt_file) || exit 0
+[[ -n $frame_sleep ]] || frame_sleep=$FRAME_SECONDS
+mkdir -p "$(dirname "$white_file")" 2>/dev/null
+
+# The white this loop starts from: the one it last set, or the panel's own if the driver holds none.
+read -r cx cy < <(white_now)
+[[ $(<"$out") == "$identity" ]] && { cx=$REFERENCE_X; cy=$REFERENCE_Y; }
+
+move_to() { # x y: run the ramp, then remember the white
+  local l
+  while read -r l; do
+    printf '%s\n' "$l" >"$out" 2>/dev/null || return 1
+    [[ $frame_sleep == 0 ]] || sleep "$frame_sleep"
+  done < <(ramp_lines "$cx" "$cy" "$1" "$2")
+  cx=$1; cy=$2
+  echo "$cx $cy" >"$white_file" 2>/dev/null
+}
 
-last_set=""
-steps=${RAMP_STEPS:-20}
-deadband=${DEADBAND_KELVIN:-25}
-[[ -n $step_sleep ]] || step_sleep=$(awk -v r="$RAMP_SECONDS" -v s="$steps" 'BEGIN { printf "%.3f\n", r / s }')
+far() { awk -v a="$1" -v b="$2" -v c="$3" -v d="$4" -v e="$DEADBAND_XY" 'BEGIN { exit !((a - c)^2 + (b - d)^2 > e^2) }'; }
 
 while :; do
-  if [[ ! -e $off_file ]]; then
+  if [[ -e $off_file ]]; then
+    far "$cx" "$cy" "$REFERENCE_X" "$REFERENCE_Y" && move_to "$REFERENCE_X" "$REFERENCE_Y"
+  else
     lux=$(<"$dir/in_illuminance_input") 2>/dev/null || lux=""
     room=$(<"$dir/in_colortemp_input") 2>/dev/null || room=""
-    current=$(current_kelvin)
-    if [[ -n $current && -n $lux && -n $room ]]; then
-      if (( current < MIN_KELVIN )) && [[ $current != "$last_set" ]]; then
-        last_set=""   # night light is on: it owns the white
-      elif awk -v l="$lux" -v m="$MIN_LUX" -v r="$room" 'BEGIN { exit !(l >= m && r > 0) }'; then
-        target=$(target_kelvin "${room%.*}")
-        # macOS reaches each new white in its ramp time (PCCRampTime) in small steps; moves inside the
-        # dead band (sensor noise) are left alone.
-        if (( target - current > deadband || current - target > deadband )) ||
-           { (( target != current )) && (( target == MIN_KELVIN || target == MAX_KELVIN )); }; then
-          prev=$current
-          for (( i = 1; i <= steps; i++ )); do
-            k=$(( current + (target - current) * i / steps ))
-            if (( k != prev )); then set_kelvin "$k" || break; last_set=$k; prev=$k; fi
-            (( i < steps )) && sleep "$step_sleep"
-          done
-        fi
-      fi
+    # Below MIN_LUX the reading's colour is not trusted and the white holds where it is.
+    if [[ -n $lux && -n $room ]] && awk -v l="$lux" -v m="$MIN_LUX" -v r="$room" 'BEGIN { exit !(l >= m && r > 0) }'; then
+      read -r tx ty < <(room_white "${room%.*}")
+      far "$cx" "$cy" "$tx" "$ty" && move_to "$tx" "$ty"
     fi
   fi
   [[ -n $once ]] && exit 0
diff --git a/omarchy-mac/share/omarchy-mac/truetone/apple,j604.conf b/omarchy-mac/share/omarchy-mac/truetone/apple,j604.conf
index f1ec239..9c2f1f6 100644
--- a/omarchy-mac/share/omarchy-mac/truetone/apple,j604.conf
+++ b/omarchy-mac/share/omarchy-mac/truetone/apple,j604.conf
@@ -1,26 +1,31 @@
 # True Tone for the MacBook Pro 14" M4 (J604), read by omarchy-mac-truetone.
 # The display's white point follows the colour temperature of the room, as macOS does on this panel:
-# macOS moves the white STRENGTH of the way from the panel's white toward the room's colour in CIE xy.
+# macOS moves the white STRENGTH of the way from the panel's white toward the room's colour in CIE xy
+# and sends it as a 3x3 colour matrix, one per frame over its ramp (set_matrix at location 9, the
+# same place the display driver sends panel_adaptation x the compositor's matrix).
 # Its own numbers on this Mac (CoreBrightness status): ColorAdaptationStrength 0.2, and in a warm room
 # at night a white of x 0.3382, y 0.3517 (about 5270 K); 0.2 of the way toward a 3000 K room is 5288 K.
 
-# The panel's own white (no adaptation): D65, in CIE xy and kelvin.
+# The panel's own white (no adaptation): D65.
 REFERENCE_X=0.3127
 REFERENCE_Y=0.3290
-REFERENCE_KELVIN=6500
-# The lowest white True Tone moves to. Night light (omarchy-toggle-nightlight) owns everything below
-# 6000 K, and the shell reads a temperature below that as night light on, so True Tone stays above it
-# (macOS itself goes to about 5100-5300 K in a 2700-3200 K room).
-MIN_KELVIN=6000
-MAX_KELVIN=6500
-# Fraction of the way from the panel's white to the room's colour (ColorAdaptationStrength).
+# Fraction of the way from the panel's white to the room's colour (ColorAdaptationStrength, at 0 lux;
+# other rooms TO-VERIFY).
 STRENGTH=0.2
 # Below this illuminance the reading's colour is not trusted and the white holds where it is.
 MIN_LUX=5               # TO-VERIFY
-# macOS reaches each new white in 2 s (PCCRampTime; MEASURED q6-rows-tt-2: off and on each a 2 s burst of
-# about 90 colour matrix updates), here in RAMP_STEPS steps. Smaller moves than DEADBAND_KELVIN are noise.
-RAMP_SECONDS=2
-RAMP_STEPS=20
-DEADBAND_KELVIN=25      # TO-VERIFY
+# White to matrix: a von Kries adaptation from D65 to the white in the panel's RGB, matrix = P x
+# diag(LMS(white) / LMS(D65)) x Q, scaled so no row adds above 1. LMS, P and Q are a fit to macOS's
+# own matrices on this panel (three whites, every coefficient within 0.003 of macOS's).
+ADAPT_LMS="0.40024 0.70760 -0.08081 -0.22630 1.16532 0.04570 0 0 0.91822"
+ADAPT_P="3.7988582 -2.7212530 -0.0776150 -0.5897890 1.5835038 0.0062846 0.0036388 -0.2191743 1.2155425"
+ADAPT_Q="0.3595802 0.6206726 0.0197510 0.1338371 0.8620760 0.0040887 0.0230557 0.1535828 0.8233561"
+# macOS's ramp to each new white: one matrix per frame, the share of the move still to go against
+# seconds (MEASURED: its set_matrix payloads per frame when True Tone switches).
+RAMP_CURVE="0:1 0.33:0.767 0.5:0.584 0.665:0.391 0.83:0.238 1.0:0.131 1.165:0.057 1.33:0.014 1.93:0"
+RAMP_SECONDS=1.93
+FRAME_SECONDS=0.0167
+# Moves smaller than this distance in CIE xy are sensor noise (about 25 K near 6000 K).
+DEADBAND_XY=0.0015      # TO-VERIFY
 # Seconds between sensor reads (the sensor reports every 0.2 s).
 POLL_SECONDS=1
