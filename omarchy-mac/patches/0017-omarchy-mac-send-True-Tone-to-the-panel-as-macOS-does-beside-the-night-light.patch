-k() { cat "$t/kelvin"; }
-
-# The xy model without the range (MIN/MAX opened): a 3000 K room -> 5288 K, beside macOS's own
-# 5269 K white in a warm room at night.
-sed -e 's/^MIN_KELVIN=.*/MIN_KELVIN=1000/' -e 's/^MAX_KELVIN=.*/MAX_KELVIN=20000/' -e 's/^RAMP_SECONDS=.*/RAMP_SECONDS=0.01/' \
