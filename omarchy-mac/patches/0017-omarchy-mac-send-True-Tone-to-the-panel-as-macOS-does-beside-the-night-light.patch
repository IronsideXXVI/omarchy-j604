-# The white for a room at $1 K: STRENGTH of the way from the panel's white to the room's colour in
-# CIE xy (the room on the Planckian locus, Kim et al.), back to kelvin (McCamy), in range.
-target_kelvin() {
-  awk -v T="$1" -v rx="$REFERENCE_X" -v ry="$REFERENCE_Y" -v s="$STRENGTH" -v lo="$MIN_KELVIN" -v hi="$MAX_KELVIN" 'BEGIN {
+# The white "x y" for a room at $1 K: STRENGTH of the way from the panel's white to the room's colour
+# in CIE xy (the room on the Planckian locus, Kim et al.).
+room_white() {
+  awk -v T="$1" -v rx="$REFERENCE_X" -v ry="$REFERENCE_Y" -v s="$STRENGTH" 'BEGIN {
     if (T < 1667) T = 1667
     if (T > 25000) T = 25000
     if (T <= 4000) x = -0.2661239e9 / T^3 - 0.2343589e6 / T^2 + 0.8776956e3 / T + 0.179910
@@ -55,63 +63,112 @@ target_kelvin() {
     if (T <= 2222) y = -1.1063814 * x^3 - 1.34811020 * x^2 + 2.18555832 * x - 0.20219683
     else if (T <= 4000) y = -0.9549476 * x^3 - 1.37418593 * x^2 + 2.09137015 * x - 0.16748867
     else y = 3.0817580 * x^3 - 5.87338670 * x^2 + 3.75112997 * x - 0.37001483
-    wx = rx + s * (x - rx); wy = ry + s * (y - ry)
-    n = (wx - 0.3320) / (0.1858 - wy)
-    t = 449 * n^3 + 3525 * n^2 + 6823.3 * n + 5520.33
-    if (t < lo) t = lo
-    if (t > hi) t = hi
-    printf "%d\n", t + 0.5
+    printf "%.6f %.6f\n", rx + s * (x - rx), ry + s * (y - ry)
   }'
