+# True Tone: the panel's white follows the room light through the display driver's panel_adaptation,
+# which the driver composes with the compositor's colour matrix (night light stays the compositor's).
+# A system service because panel_adaptation is a root-only sysfs attribute; the switch is
+# /etc/omarchy-mac/truetone-off ("omarchy-mac-truetone off|on").
+[Unit]
+Description=Match the built-in display's white to the room light (True Tone)
+After=systemd-udev-settle.service multi-user.target
+
+[Service]
+Type=simple
+ExecCondition=/usr/bin/omarchy-hw-apple-silicon
+ExecStart=/usr/bin/omarchy-mac-truetone
+Restart=on-failure
+RestartSec=10
+
+[Install]
+WantedBy=multi-user.target
