+m() { cat "$t/dcp/panel_adaptation"; }
+# Largest difference between the driver's matrix (S31.32) and a reference in plain numbers.
+diff9() { awk -v a="$(m)" -v b="$1" 'BEGIN { split(a, x, " "); split(b, y, " "); for (i = 1; i <= 9; i++) {
+  d = x[i] / 4294967296 - y[i]; if (d < 0) d = -d; if (d > w) w = d }; printf "%.4f\n", w }'; }
+
+# A warm room at night (3000 K): the white goes 0.2 of the way (macOS's strength) along CIE xy, to
+# 5288 K (macOS's own white in such a room is 5269 K at x 0.3382, y 0.3517: its y sits above the
+# Planckian locus, which the room points of q10-rows-tt-5 settle). The matrix is the fitted von Kries
+# adaptation for that white (within 0.003 of macOS's matrices at macOS's own whites, catfit.py).
+want="0.90672 0.08312 0.01015 -0.00737 0.84637 -0.00102 -0.00327 -0.02199 0.74088"
+run 150 3000
+w=$(diff9 "$want"); awk -v w="$w" 'BEGIN { exit !(w <= 0.0002) }' || fail "3000 K room matrix: $w off"
+read -r x y <"$t/white"; awk -v x="$x" -v y="$y" 'BEGIN { exit !(x > 0.337 && x < 0.338 && y > 0.343 && y < 0.345) }' ||
+  fail "white for a 3000 K room: $x $y"
+# A full 3x3, not a diagonal: the off-diagonal terms macOS uses are there.
+awk -v a="$(m)" 'BEGIN { split(a, x, " "); exit !(x[2] / 4294967296 > 0.05) }' || fail "no off-diagonal term: $(m)"
+
+# The ramp: one matrix per frame over macOS's 1.93 s, each closer to the target, along its curve.
+PATH="$t/bin:$PATH" OMARCHY_MAC_TRUETONE_DIR="$root/share/omarchy-mac/truetone" OMARCHY_MAC_DT_COMPATIBLE="$t/compatible" \
+  bash "$root/bin/omarchy-mac-truetone" ramp 0.3127 0.3290 $(cat "$t/white") >"$t/frames"
+n=$(grep -c . "$t/frames"); (( n == 116 )) || fail "ramp frames: $n (1.93 s at 60 Hz = 116)"
+# At 0.5 s (frame 30) macOS has 58 % of the move still to go: the red gain is that far from the end.
+awk -v f="$(sed -n 30p "$t/frames")" -v e="$(tail -1 "$t/frames")" 'BEGIN { split(f, a, " "); split(e, b, " ");
+  left = 1 - (a[1] - 4294967296) / (b[1] - 4294967296); exit !(left > 0.57 && left < 0.60) }' ||
+  fail "ramp shape at 0.5 s: $(sed -n 30p "$t/frames" | cut -d" " -f1)"
+
+# The same room again: inside the dead band, nothing is written.
+cp "$t/dcp/panel_adaptation" "$t/before"
+run 150 3010
+cmp -s "$t/before" "$t/dcp/panel_adaptation" || fail "a 10 K wobble moved the white"
+# Too dark to trust the colour: the white holds.
+run 1 6500; cmp -s "$t/before" "$t/dcp/panel_adaptation" || fail "a 1 lux reading moved the white"
+# Daylight (6500 K, on the Planckian locus just below D65): back beside the panel's own white.
+run 800 6504; w=$(diff9 "1 0 0 0 1 0 0 0 1"); awk -v w="$w" 'BEGIN { exit !(w < 0.01) }' || fail "6500 K room: $w from the panel's white"
+
+# Off: the panel's own white, and it stays there whatever the room; on resumes.
+run 150 3000; touch "$t/etc/truetone-off"; run 150 3000
+[[ $(m) == "$id" ]] || fail "off did not give the panel its white back: $(m)"
+run 150 2700; [[ $(m) == "$id" ]] || fail "off moved with the room: $(m)"
+rm "$t/etc/truetone-off"; run 150 3000
+w=$(diff9 "$want"); awk -v w="$w" 'BEGIN { exit !(w <= 0.0002) }' || fail "on did not resume: $w"
+
+# Night light is not touched: the script never calls hyprsunset/hyprctl.
+! grep -q -E 'hyprctl|hyprsunset' "$root/bin/omarchy-mac-truetone" || fail "True Tone still drives hyprsunset"
+
+# No table, no sensor or no panel_adaptation (an older kernel): nothing happens.
+echo "$id" >"$t/dcp/panel_adaptation"
+printf 'apple,j313\0' >"$t/compatible"; run 150 3000; [[ $(m) == "$id" ]] || fail "no table: $(m)"
+printf 'apple,j604\0' >"$t/compatible"; mv "$t/dcp/panel_adaptation" "$t/dcp/gone"; run 150 3000
+[[ ! -e $t/dcp/panel_adaptation ]] || fail "wrote without panel_adaptation"
 echo "truetone-test: ok"
