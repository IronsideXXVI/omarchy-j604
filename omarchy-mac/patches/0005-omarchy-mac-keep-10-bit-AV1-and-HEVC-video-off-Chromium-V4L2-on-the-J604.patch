From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 00:25:00 +0000
Subject: [PATCH] omarchy-mac: keep 10-bit, AV1 and HEVC video off Chromium's
 V4L2 decoder on the J604

On the 14-inch MacBook Pro M4 (J604), Chromium decodes through V4L2
with AcceleratedVideoDecoder on. For 10-bit VP9, AV1 and HEVC the Apple
Video Decoder delivers P010 pictures, which Chromium's V4L2 decoder
cannot lay out ("Cannot derive stride for each plane for pixel format
P010"); the video then stalls and never falls back to software.

Add Chromium's own GPU workaround switches to its flags on the J604:
disable_accelerated_vp9_profile2_decode, disable_accelerated_av1_decode
(one AV1 profile covers 8 and 10 bit) and
disable_accelerated_hevc_decode. Those streams then play in software,
as without the feature, while H.264 and VP9 profile 0 stay on the
hardware decoder. Each switch is added once. Other browsers and other
Macs are unchanged.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 omarchy-mac/bin/omarchy-mac-setup-user | 11 +++++++++++
 omarchy-mac/test/desktop-setup-test.sh | 10 ++++++----
 2 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/omarchy-mac/bin/omarchy-mac-setup-user b/omarchy-mac/bin/omarchy-mac-setup-user
index b6365f2..8bddf67 100755
--- a/omarchy-mac/bin/omarchy-mac-setup-user
+++ b/omarchy-mac/bin/omarchy-mac-setup-user
@@ -25,6 +25,13 @@ config=${XDG_CONFIG_HOME:-$HOME/.config}
 # feature out of --disable-features, which wins over --enable-features, and add
 # it to --enable-features. Its other browsers and every other Mac keep the
 # workaround until the decoder is known to work for them.
+#
+# Chromium's V4L2 decoder cannot lay out the decoder's 10-bit (P010)
+# pictures, so 10-bit VP9, AV1 and HEVC would stall instead of falling back
+# to software. Its GPU workaround switches keep VP9 profile 2, AV1 (one
+# profile covers 8 and 10 bit) and HEVC off the hardware decoder: those
+# play in software, as without the feature, while H.264 and VP9 profile 0
+# stay on the Apple Video Decoder.
 chromium_decodes() {
   [[ ${1##*/} == chromium-flags.conf ]] && omarchy-hw-match-device-tree apple,j604 2>/dev/null
 }
@@ -36,6 +43,10 @@ enable_decoder() {
     [[ -z $(tail -c1 "$1") ]] || echo >>"$1"
     echo '--enable-features=AcceleratedVideoDecoder' >>"$1"
   fi
+  local switch
+  for switch in --disable_accelerated_vp9_profile2_decode --disable_accelerated_av1_decode --disable_accelerated_hevc_decode; do
+    grep -Fxq -- "$switch" "$1" || echo "$switch" >>"$1"
+  done
 }
 flag_dirs=("$config")
 [[ $config == "$HOME/.config" ]] || flag_dirs+=("$HOME/.config")
diff --git a/omarchy-mac/test/desktop-setup-test.sh b/omarchy-mac/test/desktop-setup-test.sh
index 84e6790..264e99e 100644
--- a/omarchy-mac/test/desktop-setup-test.sh
+++ b/omarchy-mac/test/desktop-setup-test.sh
@@ -202,21 +202,23 @@ TEST_COMPATIBLE='apple,j614 apple,t8132 apple,arm-platform' "$setup_user" "$stag
 [[ $(<"$flags") == "$stock" ]] || fail 'another M4 Mac keeps the workaround in Chromium' "$(cat "$flags")"
 TEST_COMPATIBLE='apple,j604 apple,t8132 apple,arm-platform' "$setup_user" "$stage"
 TEST_COMPATIBLE='apple,j604 apple,t8132 apple,arm-platform' "$setup_user" "$stage"
-[[ $(<"$flags") == $'--ozone-platform=wayland\n--enable-features=TouchpadOverscrollHistoryNavigation,OverlayScrollbar,AcceleratedVideoDecoder\n--no-default-browser-check' ]] ||
+[[ $(<"$flags") == $'--ozone-platform=wayland\n--enable-features=TouchpadOverscrollHistoryNavigation,OverlayScrollbar,AcceleratedVideoDecoder\n--no-default-browser-check\n--disable_accelerated_vp9_profile2_decode\n--disable_accelerated_av1_decode\n--disable_accelerated_hevc_decode' ]] ||
   fail 'the J604 turns Chromium hardware decode on, once, and drops a list left empty' "$(cat "$flags")"
 printf '%s\n' '--disable-features=SomeOtherThing,AcceleratedVideoDecoder,Another' '--ozone-platform=wayland' >"$flags"
 TEST_COMPATIBLE='apple,j604' "$setup_user" "$stage"
-[[ $(<"$flags") == $'--disable-features=SomeOtherThing,Another\n--ozone-platform=wayland\n--enable-features=AcceleratedVideoDecoder' ]] ||
+[[ $(<"$flags") == $'--disable-features=SomeOtherThing,Another\n--ozone-platform=wayland\n--enable-features=AcceleratedVideoDecoder\n--disable_accelerated_vp9_profile2_decode\n--disable_accelerated_av1_decode\n--disable_accelerated_hevc_decode' ]] ||
   fail 'the J604 keeps the other disabled features and starts a feature list' "$(cat "$flags")"
 printf '%s' '--disable-features=AcceleratedVideoDecoder' >"$flags"
 TEST_COMPATIBLE='apple,j604' "$setup_user" "$stage"
-[[ $(<"$flags") == '--enable-features=AcceleratedVideoDecoder' ]] ||
+[[ $(<"$flags") == $'--enable-features=AcceleratedVideoDecoder\n--disable_accelerated_vp9_profile2_decode\n--disable_accelerated_av1_decode\n--disable_accelerated_hevc_decode' ]] ||
   fail 'the J604 replaces a lone workaround line without a final newline' "$(cat "$flags")"
 printf '%s\n' '--ozone-platform=wayland' >"$HOME/.config/brave-flags.conf"
 TEST_COMPATIBLE='apple,j604' "$setup_user" "$stage"
 grep -Fxq -- '--disable-features=AcceleratedVideoDecoder' "$HOME/.config/brave-flags.conf" ||
   fail "the J604's other browsers keep the workaround"
-pass 'the J604 keeps Chromium hardware decode on; other Macs and browsers keep the workaround'
+! grep -q -- '_decode$' "$HOME/.config/brave-flags.conf" ||
+  fail "the J604's other browsers get no Chromium decoder workarounds"
+pass 'the J604 keeps Chromium hardware decode on for H.264 and VP9 profile 0, once; other Macs and browsers keep the workaround'
 rm -f "$work/bin/omarchy-hw-match-device-tree"
 
 : >"$CALLS"
-- 
2.43.0

