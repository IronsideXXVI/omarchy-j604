From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 03:47:51 +0000
Subject: [PATCH 18/19] encode: code the client's frame_num and POC words when
 it writes its own SPS

When the client asked for packed sequence headers it puts its own SPS in the
container, so the encoder has to write the same values in band. Take
log2_max_frame_num_minus4, pic_order_cnt_type and
log2_max_pic_order_cnt_lsb_minus4 from the H.264 sequence parameter buffer.
VA-API's HEVC sequence buffer has no POC width, so read
log2_max_pic_order_cnt_lsb_minus4 from the SPS NAL unit in the client's
packed sequence header. Set the encoder's controls before streaming starts.

A client that does not ask for packed headers keeps the encoder's values,
as before.
---
 src/encode.c       | 164 +++++++++++++++++++++++++++++++++++++++++++--
 src/v4l2_request.h |   1 +
 2 files changed, 160 insertions(+), 5 deletions(-)

diff --git a/src/encode.c b/src/encode.c
index 16a981b..94dd4a2 100644
--- a/src/encode.c
+++ b/src/encode.c
@@ -66,6 +66,15 @@ struct v4l2r_enc {
 	uint32_t fps_num, fps_den;
 	bool rc_dirty;
 
+	/*
+	 * The client builds its own sequence header (it asked for packed
+	 * sequence headers): code its frame_num and POC words, enum
+	 * enc_sps_word, -1 for the encoder's own value.
+	 */
+	bool client_sps;
+	int32_t sps[4];
+	uint32_t packed_type;	/* of the next packed header data buffer */
+
 	void *cap_map[V4L2R_ENC_CAPTURE_BUFFERS];
 	size_t cap_len[V4L2R_ENC_CAPTURE_BUFFERS];
 	unsigned int nb_captures;
@@ -78,6 +87,13 @@ struct v4l2r_enc {
 	bool have_picture;
 };
 
+enum enc_sps_word {
+	ENC_SPS_H264_LOG2_MAX_FRAME_NUM_MINUS4,
+	ENC_SPS_H264_POC_TYPE,
+	ENC_SPS_H264_LOG2_MAX_POC_LSB_MINUS4,
+	ENC_SPS_HEVC_LOG2_MAX_POC_LSB_MINUS4,
+};
+
 /* --- encoder device discovery --- */
 
 static bool fmt_listed(int fd, enum v4l2_buf_type type, uint32_t fourcc)
@@ -250,6 +266,12 @@ VAStatus v4l2r_enc_create(struct v4l2r_context *ctx,
 		if (config->attributes[i].type == VAConfigAttribRateControl &&
 		    config->attributes[i].value != VA_ATTRIB_NOT_SUPPORTED)
 			enc->rc_mode = config->attributes[i].value;
+		else if (config->attributes[i].type == VAConfigAttribEncPackedHeaders &&
+			 config->attributes[i].value != VA_ATTRIB_NOT_SUPPORTED &&
+			 (config->attributes[i].value & VA_ENC_PACKED_HEADER_SEQUENCE))
+			enc->client_sps = true;
+	for (int i = 0; i < 4; i++)
+		enc->sps[i] = -1;
 	enc->qp = 26;
 	enc->bitrate = 8000000;
 	enc->fps_num = 30;
@@ -301,6 +323,95 @@ VAStatus v4l2r_enc_begin_picture(struct v4l2r_context *ctx,
 	return VA_STATUS_SUCCESS;
 }
 
+/*
+ * log2_max_pic_order_cnt_lsb_minus4 of the first HEVC SPS NAL unit (type 33)
+ * in a packed sequence header (H.265 7.3.2.2.1), or -1. VA-API's HEVC
+ * sequence buffer has no such field; the client's SPS is the only source.
+ */
+struct sps_bits {
+	const uint8_t *p;
+	size_t bits, pos;
+};
+
+static uint32_t sps_u(struct sps_bits *b, unsigned int n)
+{
+	uint32_t v = 0;
+
+	while (n--) {
+		v <<= 1;
+		if (b->pos < b->bits)
+			v |= (b->p[b->pos >> 3] >> (7 - (b->pos & 7))) & 1;
+		b->pos++;
+	}
+	return v;
+}
+
+static uint32_t sps_ue(struct sps_bits *b)
+{
+	unsigned int zeros = 0;
+
+	while (b->pos < b->bits && !sps_u(b, 1))
+		if (++zeros > 31)
+			return UINT32_MAX;
+	return zeros ? (1u << zeros) - 1 + sps_u(b, zeros) : 0;
+}
+
+int32_t v4l2r_hevc_sps_poc_lsb(const uint8_t *data, size_t bytes)
+{
+	uint8_t rbsp[256];
+	size_t n = 0, i;
+	struct sps_bits b;
+	unsigned int sub, zeros = 0;
+
+	for (i = 0; i + 4 < bytes; i++)
+		if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1 &&
+		    ((data[i + 3] >> 1) & 0x3f) == 33)
+			break;
+	if (i + 4 >= bytes)
+		return -1;
+	/* Past the start code and the two-byte NAL unit header. */
+	for (i += 5; i < bytes && n < sizeof(rbsp); i++) {
+		if (i + 2 < bytes && data[i] == 0 && data[i + 1] == 0 &&
+		    data[i + 2] <= 1)
+			break;	/* next start code */
+		if (zeros >= 2 && data[i] == 3) {
+			zeros = 0;	/* emulation prevention byte */
+			continue;
+		}
+		zeros = data[i] ? 0 : zeros + 1;
+		rbsp[n++] = data[i];
+	}
+	b = (struct sps_bits){ .p = rbsp, .bits = n * 8 };
+	sps_u(&b, 4);			/* sps_video_parameter_set_id */
+	sub = sps_u(&b, 3);		/* sps_max_sub_layers_minus1 */
+	sps_u(&b, 1);			/* sps_temporal_id_nesting_flag */
+	sps_u(&b, 32); sps_u(&b, 32); sps_u(&b, 32);	/* general profile, tier, level */
+	if (sub) {
+		uint32_t present = sps_u(&b, 2 * sub);
+
+		sps_u(&b, 2 * (8 - sub));	/* reserved_zero_2bits */
+		for (unsigned int s = 0; s < sub; s++) {
+			if (present >> (2 * (sub - s) - 1) & 1) {
+				sps_u(&b, 32); sps_u(&b, 32); sps_u(&b, 24);
+			}
+			if (present >> (2 * (sub - s) - 2) & 1)
+				sps_u(&b, 8);
+		}
+	}
+	sps_ue(&b);			/* sps_seq_parameter_set_id */
+	if (sps_ue(&b) == 3)		/* chroma_format_idc */
+		sps_u(&b, 1);
+	sps_ue(&b);			/* pic_width_in_luma_samples */
+	sps_ue(&b);			/* pic_height_in_luma_samples */
+	if (sps_u(&b, 1))		/* conformance_window_flag */
+		for (int k = 0; k < 4; k++)
+			sps_ue(&b);
+	sps_ue(&b);			/* bit_depth_luma_minus8 */
+	sps_ue(&b);			/* bit_depth_chroma_minus8 */
+	i = sps_ue(&b);			/* log2_max_pic_order_cnt_lsb_minus4 */
+	return b.pos <= b.bits && i <= 12 ? (int32_t)i : -1;
+}
+
 static void misc_param(struct v4l2r_enc *enc, const VAEncMiscParameterBuffer *misc,
 		       size_t bytes)
 {
@@ -363,6 +474,15 @@ VAStatus v4l2r_enc_render_buffer(struct v4l2r_context *ctx,
 				enc->peak = enc->bitrate = s->bits_per_second;
 				enc->rc_dirty = true;
 			}
+			if (enc->client_sps) {
+				uint32_t poc = s->seq_fields.bits.pic_order_cnt_type;
+
+				enc->sps[ENC_SPS_H264_LOG2_MAX_FRAME_NUM_MINUS4] =
+					s->seq_fields.bits.log2_max_frame_num_minus4;
+				enc->sps[ENC_SPS_H264_POC_TYPE] = poc;
+				enc->sps[ENC_SPS_H264_LOG2_MAX_POC_LSB_MINUS4] = poc ? -1 :
+					(int32_t)s->seq_fields.bits.log2_max_pic_order_cnt_lsb_minus4;
+			}
 		} else {
 			const VAEncSequenceParameterBufferHEVC *s = buf->data;
 
@@ -408,10 +528,30 @@ VAStatus v4l2r_enc_render_buffer(struct v4l2r_context *ctx,
 		misc_param(enc, buf->data, bytes);
 		return VA_STATUS_SUCCESS;
 
-	case VAEncSliceParameterBufferType:
-	case VAEncPackedHeaderParameterBufferType:
+	case VAEncPackedHeaderParameterBufferType: {
+		const VAEncPackedHeaderParameterBuffer *h = buf->data;
+
+		enc->packed_type = bytes >= sizeof(*h) ? h->type : 0;
+		return VA_STATUS_SUCCESS;
+	}
+
 	case VAEncPackedHeaderDataBufferType:
-		/* One slice per picture, headers written by the encoder. */
+		/*
+		 * Headers are written by the encoder; an HEVC client's SPS gives
+		 * the POC width it expects (VA-API has no field for it).
+		 */
+		if (enc->client_sps && enc->coded == V4L2_PIX_FMT_HEVC &&
+		    enc->packed_type == VAEncPackedHeaderSequence) {
+			int32_t lsb = v4l2r_hevc_sps_poc_lsb(buf->data, bytes);
+
+			if (lsb >= 0)
+				enc->sps[ENC_SPS_HEVC_LOG2_MAX_POC_LSB_MINUS4] = lsb;
+		}
+		enc->packed_type = 0;
+		return VA_STATUS_SUCCESS;
+
+	case VAEncSliceParameterBufferType:
+		/* One slice per picture. */
 		return VA_STATUS_SUCCESS;
 
 	default:
@@ -545,6 +685,19 @@ static VAStatus enc_configure(struct v4l2r_context *ctx,
 	ioctl(enc->fd, VIDIOC_S_PARM, &parm);
 
 	set_ctrl(enc->fd, V4L2_CID_MPEG_VIDEO_B_FRAMES, 0);
+	if (enc->client_sps && enc->coded == V4L2_PIX_FMT_H264 &&
+	    drv->encoder.sps_h264) {
+		set_ctrl(enc->fd, V4L2R_CID_H264_LOG2_MAX_FRAME_NUM_MINUS4,
+			 enc->sps[ENC_SPS_H264_LOG2_MAX_FRAME_NUM_MINUS4]);
+		set_ctrl(enc->fd, V4L2R_CID_H264_POC_TYPE,
+			 enc->sps[ENC_SPS_H264_POC_TYPE]);
+		set_ctrl(enc->fd, V4L2R_CID_H264_LOG2_MAX_POC_LSB_MINUS4,
+			 enc->sps[ENC_SPS_H264_LOG2_MAX_POC_LSB_MINUS4]);
+	} else if (enc->client_sps && enc->coded == V4L2_PIX_FMT_HEVC &&
+		   drv->encoder.sps_hevc) {
+		set_ctrl(enc->fd, V4L2R_CID_HEVC_LOG2_MAX_POC_LSB_MINUS4,
+			 enc->sps[ENC_SPS_HEVC_LOG2_MAX_POC_LSB_MINUS4]);
+	}
 	set_ctrl(enc->fd, V4L2_CID_MPEG_VIDEO_GOP_SIZE,
 		 enc->intra_period ? (int32_t)enc->intra_period : 0);
 	if (enc->coded == V4L2_PIX_FMT_H264)
@@ -615,10 +768,11 @@ static VAStatus enc_configure(struct v4l2r_context *ctx,
 	enc->crop_h = vis_h;
 
 	v4l2r_diag(ctx, V4L2R_DIAG_LEVEL_INFO, V4L2R_DIAG_INFO, "enc-setup", 0,
-		   "encoding %ux%u of %ux%u (pitch %u) to %.4s via %s [%s], rc 0x%x, gop %u",
+		   "encoding %ux%u of %ux%u (pitch %u) to %.4s via %s [%s], rc 0x%x, gop %u, client SPS %s (%d %d %d / %d)",
 		   vis_w, vis_h, in->width, in->height, in->pitch, (const char *)&enc->coded,
 		   drv->encoder.video_path, drv->encoder.card, enc->rc_mode,
-		   enc->intra_period);
+		   enc->intra_period, enc->client_sps ? "yes" : "no", enc->sps[0],
+		   enc->sps[1], enc->sps[2], enc->sps[3]);
 	return VA_STATUS_SUCCESS;
 
 fail:
diff --git a/src/v4l2_request.h b/src/v4l2_request.h
index 464a7c4..c651863 100644
--- a/src/v4l2_request.h
+++ b/src/v4l2_request.h
@@ -912,6 +912,7 @@ struct v4l2r_enc;
 bool v4l2r_encoder_supports(struct v4l2r_driver *drv, VAProfile profile);
 uint32_t v4l2r_encoder_attribute(struct v4l2r_driver *drv, VAProfile profile,
 				 VAConfigAttribType type);
+int32_t v4l2r_hevc_sps_poc_lsb(const uint8_t *data, size_t bytes);
 VAStatus v4l2r_enc_create(struct v4l2r_context *ctx,
 			  const struct v4l2r_config *config);
 void v4l2r_enc_destroy(struct v4l2r_context *ctx);
