From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 22 Nov 2026 01:42:24 +0000
Subject: [PATCH 12/13] context: do not rebind a surface with a derived image

A derived image maps its surface's CAPTURE buffer directly. Rebinding
the surface while such an image is alive moved the surface to another
buffer and orphaned the mapped one: the image stopped showing the
surface, and the orphan could be recycled for a different surface while
the image still mapped it. Wait for the buffer instead, as without
rebinding, and add the rebind-derived-held case, which failed before.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
(cherry picked from commit d4121bd74dc98beedee18281f81267bfe9a9558b)
---
 src/context.c           |  6 ++++--
 tests/failure-cleanup.c | 10 +++++++---
 tests/meson.build       |  4 ++--
 3 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/src/context.c b/src/context.c
index 2691b30..e3540d7 100644
--- a/src/context.c
+++ b/src/context.c
@@ -976,12 +976,14 @@ static int capture_buffer_bind(struct v4l2r_context *ctx,
 	 * and last_ref_seq intact, so frames already submitted still find it
 	 * by its timestamp, and it is only recycled once they are done. Only
 	 * for decoder-allocated buffers no client has exported: an exported
-	 * buffer's memory is what the client sees for this surface. At most
+	 * buffer's memory is what the client sees for this surface. Likewise
+	 * while a derived image maps the buffer: the image must keep showing
+	 * this surface, and the orphan must not be recycled under it. At most
 	 * rebind_spare buffers are added beyond the bound ones.
 	 */
 	if (ctx->rebind_spare && ctx->capture_memory == V4L2_MEMORY_MMAP &&
 	    !ctx->conv && !capture_exported(&ctx->captures[index]) &&
-	    !capture_idle(ctx, index)) {
+	    !surface->image_refs && !capture_idle(ctx, index)) {
 		int idle = free_list_take_idle(ctx);
 
 		if (idle < 0 && ctx->free_count < ctx->rebind_spare)
diff --git a/tests/failure-cleanup.c b/tests/failure-cleanup.c
index c73990d..ce6083d 100644
--- a/tests/failure-cleanup.c
+++ b/tests/failure-cleanup.c
@@ -887,7 +887,7 @@ static void rebind(const char *name)
     VASurfaceID sid = surface();
     struct v4l2r_surface *s = V4L2R_SURFACE(drv, sid);
     bool exported = !strcmp(name, "exported");
-    bool derived = !strcmp(name, "derived");
+    bool derived = !strcmp(name, "derived") || !strcmp(name, "derived-held");
     VAImage image = {0};
     if (exported || derived) {
         assert(picture(id, sid) == VA_STATUS_SUCCESS);
@@ -902,7 +902,8 @@ static void rebind(const char *name)
             /* The driver exports the buffer for its own mapping. */
             assert(table.vaDeriveImage(&va, sid, &image) == VA_STATUS_SUCCESS);
             assert(!ctx->captures[s->capture_index].client_exported);
-            assert(v4l2r_DestroyImage(&va, image.image_id) == VA_STATUS_SUCCESS);
+            if (!strcmp(name, "derived"))
+                assert(v4l2r_DestroyImage(&va, image.image_id) == VA_STATUS_SUCCESS);
         }
     }
     assert(ctx->capture_memory == V4L2_MEMORY_MMAP || (!exported && !derived));
@@ -919,7 +920,8 @@ static void rebind(const char *name)
     if (!strcmp(name, "alloc-fail")) inject(VIDIOC_CREATE_BUFS, -1, 1, ENOMEM);
     assert(picture(id, sid) == VA_STATUS_SUCCESS);
     if (!strcmp(name, "alloc-fail")) { assert(injected == 1); armed = false; }
-    bool waits = !strcmp(name, "off") || exported || !strcmp(name, "alloc-fail");
+    bool waits = !strcmp(name, "off") || exported || !strcmp(name, "derived-held") ||
+                 !strcmp(name, "alloc-fail");
     if (waits) {
         /* Same buffer, after waiting for it; the pool did not grow. */
         assert(s->capture_index == busy && hw_waits == 1);
@@ -978,6 +980,8 @@ static void rebind(const char *name)
     }
     hw_busy = finish_on_poll = false; hw_finish(); hw_waits = 0;
     assert(table.vaSyncSurface(&va, sid) == VA_STATUS_SUCCESS);
+    if (!strcmp(name, "derived-held"))
+        assert(v4l2r_DestroyImage(&va, image.image_id) == VA_STATUS_SUCCESS);
     assert(table.vaDestroyContext(&va, id) == VA_STATUS_SUCCESS);
     teardown();
 }
diff --git a/tests/meson.build b/tests/meson.build
index 261b578..bc71b8b 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -45,8 +45,8 @@ endforeach
 foreach case : ['normal', 'early-export', 'held-image']
   test('failure-churn-' + case, failure_cleanup, args: ['churn-' + case], timeout: 120)
 endforeach
-foreach case : ['env', 'off', 'target', 'orphan', 'exported', 'derived', 'alloc-fail',
-                'spare-limit']
+foreach case : ['env', 'off', 'target', 'orphan', 'exported', 'derived', 'derived-held',
+                'alloc-fail', 'spare-limit']
   test('rebind-' + case, failure_cleanup, args: ['rebind-' + case], timeout: 15)
 endforeach
 if conf.get('HAVE_V4L2_M2M_HOLD_CAPTURE_BUF') == 1
