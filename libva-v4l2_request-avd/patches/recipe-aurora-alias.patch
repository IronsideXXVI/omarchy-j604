Recipe change for the J604 build of libva-v4l2_request-avd (apply with patch -p1 in an omacom/omarchy-pkgs checkout at 08b5d28a).
The only change to the package: one more alias symlink, aurora_drv_video.so, as in aurora-silicon/alarm-aurora aedcf240ca91 (Ryan Murray)
and omacom/omarchy-pkgs#2375. The rest is the local pkgrel and a header comment.

--- a/pkgbuilds/libva-v4l2_request-avd/PKGBUILD
+++ b/pkgbuilds/libva-v4l2_request-avd/PKGBUILD
@@ -1,11 +1,15 @@
 # VA-API driver with Apple Video Decoder fixes, maintained at omacom/libva-v4l2_request.
 # The asahi alias lets libva discover it on Apple Silicon.
+#
+# J604 local build (pkgrel .604): the official recipe plus the aurora alias
+# (aurora-silicon/alarm-aurora aedcf240ca91 by Ryan Murray, also open as
+# omacom/omarchy-pkgs#2375), for the aurora 7.3 kernel's DRM driver name.
 
 _fork=omacom
 _commit=c653eaa6234a02b5f31f77a8aa23f7a744650e87
 pkgname=libva-v4l2_request-avd
 pkgver=1.3.r11.r169.gc653eaa
-pkgrel=1
+pkgrel=1.604
 pkgdesc='VA-API driver for V4L2 stateless decoders, with Apple Video Decoder (AVD) support'
 arch=('aarch64')
 url="https://github.com/$_fork/libva-v4l2_request"
@@ -58,6 +62,8 @@
   # variable at all. If mesa ever ships its own asahi_drv_video.so this will
   # collide and pacman will say so at install time.
   ln -sf v4l2_request_drv_video.so "$pkgdir/usr/lib/dri/asahi_drv_video.so"
+  # Aurora kernels name the AGX render node driver "aurora".
+  ln -sf v4l2_request_drv_video.so "$pkgdir/usr/lib/dri/aurora_drv_video.so"
 
   install -Dm644 "libva-v4l2_request-$_commit/COPYING" \
     "$pkgdir/usr/share/licenses/$pkgname/COPYING"
