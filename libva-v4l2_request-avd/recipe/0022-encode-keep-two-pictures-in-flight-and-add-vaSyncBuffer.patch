 /* --- context --- */
 
+/* Pictures queued in all encoder contexts: a fast exit for the sync hooks. */
+static _Atomic unsigned int enc_inflight;
+static pthread_mutex_t enc_live_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct v4l2r_context *enc_live[V4L2R_ENC_LIVE_MAX];
+
+static VAStatus enc_drain(struct v4l2r_context *ctx);
+
+static bool enc_live_add(struct v4l2r_context *ctx)
+{
+	bool added = false;
+
+	pthread_mutex_lock(&enc_live_lock);
+	for (unsigned int i = 0; i < V4L2R_ENC_LIVE_MAX && !added; i++)
+		if (!enc_live[i]) {
+			enc_live[i] = ctx;
+			added = true;
+		}
+	pthread_mutex_unlock(&enc_live_lock);
+	return added;
+}
+
+static void enc_live_remove(struct v4l2r_context *ctx)
+{
+	pthread_mutex_lock(&enc_live_lock);
+	for (unsigned int i = 0; i < V4L2R_ENC_LIVE_MAX; i++)
+		if (enc_live[i] == ctx)
+			enc_live[i] = NULL;
+	pthread_mutex_unlock(&enc_live_lock);
+}
+
+/* A queued picture that will not complete: an empty coded buffer, and the
+ * input surface free again. */
+static void enc_fail_picture(struct v4l2r_buffer *coded,
+			     struct v4l2r_surface *input)
+{
+	VACodedBufferSegment *seg = coded->data;
+
+	memset(seg, 0, sizeof(*seg));
+	seg->buf = (uint8_t *)coded->data + sizeof(*seg);
+	input->status = VASurfaceReady;
+}
