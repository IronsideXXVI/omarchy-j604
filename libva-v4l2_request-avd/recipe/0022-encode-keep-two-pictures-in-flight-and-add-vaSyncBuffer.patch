+/*
+ * Collect the oldest queued picture: its coded data into its coded buffer,
+ * the CAPTURE buffer back to the encoder, then its input surface back.
+ * ctx->mutex held. With soft set, a deadline that passes before the coded
+ * picture is there returns VA_STATUS_ERROR_TIMEDOUT and leaves it queued.
+ * The m2m queue runs pictures in the order they were queued.
+ */
+static VAStatus enc_complete_one(struct v4l2r_context *ctx, uint64_t deadline,
+				 bool soft)
+{
+	struct v4l2r_enc *enc = ctx->enc;
+	struct v4l2r_buffer *coded;
+	VACodedBufferSegment *seg;
+	struct v4l2_plane plane;
+	struct v4l2_buffer b;
+	size_t capacity;
+	int ret;
+
+	if (!enc->npend)
+		return VA_STATUS_SUCCESS;
+	coded = enc->pend[0].coded;
+
+	memset(&plane, 0, sizeof(plane));
+	b = (struct v4l2_buffer) {
+		.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
+		.memory = V4L2_MEMORY_MMAP,
+		.length = 1,
+		.m.planes = &plane,
+	};
+	ret = dqbuf_wait(enc->fd, &b, deadline);
+	if (ret == -ETIMEDOUT && soft)
+		return VA_STATUS_ERROR_TIMEDOUT;
+	if (ret < 0 || b.index >= enc->nb_captures || (b.flags & V4L2_BUF_FLAG_ERROR)) {
+		v4l2r_diag(ctx, V4L2R_DIAG_LEVEL_ERROR,
+			   ret == -ETIMEDOUT ? V4L2R_DIAG_TIMEOUT : V4L2R_DIAG_KERNEL,
+			   "enc-frame", ret, "no coded picture for frame %llu",
+			   (unsigned long long)enc->pend[0].frame);
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+	}
+
+	/* Coded buffers are a VACodedBufferSegment followed by the data. */
+	seg = coded->data;
+	capacity = v4l2r_buffer_bytes(coded) - sizeof(*seg);
+	memset(seg, 0, sizeof(*seg));
+	seg->buf = (uint8_t *)coded->data + sizeof(*seg);
+	seg->size = plane.bytesused - plane.data_offset;
+	if (seg->size > capacity) {
+		seg->size = capacity;
+		seg->status = VA_CODED_BUF_STATUS_SLICE_OVERFLOW_MASK;
+	}
+	memcpy(seg->buf, (uint8_t *)enc->cap_map[b.index] + plane.data_offset, seg->size);
+
+	/* Give the capture buffer back, then get the input surface back. */
+	plane.bytesused = 0;
+	ioctl(enc->fd, VIDIOC_QBUF, &b);
+	memset(&plane, 0, sizeof(plane));
+	b = (struct v4l2_buffer) {
+		.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE,
+		.memory = V4L2_MEMORY_DMABUF,
+		.length = 1,
+		.m.planes = &plane,
+	};
+	if (dqbuf_wait(enc->fd, &b, v4l2r_now_ns() + V4L2R_ENC_TIMEOUT_NS) < 0)
+		return VA_STATUS_ERROR_OPERATION_FAILED;
+
+	enc->pend[0].input->status = VASurfaceReady;
+	enc->pend[0].input->decode_status = VA_STATUS_SUCCESS;
+	enc->npend--;
+	memmove(&enc->pend[0], &enc->pend[1], enc->npend * sizeof(enc->pend[0]));
+	atomic_fetch_sub(&enc_inflight, 1);
+	return VA_STATUS_SUCCESS;
+}
+
+/* Collect every queued picture. ctx->mutex held. */
+static VAStatus enc_drain(struct v4l2r_context *ctx)
+{
+	VAStatus status = VA_STATUS_SUCCESS;
+
+	while (ctx->enc && ctx->enc->npend && status == VA_STATUS_SUCCESS)
+		status = enc_complete_one(ctx, v4l2r_now_ns() + V4L2R_ENC_TIMEOUT_NS,
+					  false);
+	return status;
+}
+
+/* Whether a queued picture writes coded or reads input. */
+static bool enc_pending(const struct v4l2r_enc *enc,
+			const struct v4l2r_buffer *coded,
+			const struct v4l2r_surface *input)
+{
+	for (unsigned int i = 0; i < enc->npend; i++)
+		if ((coded && enc->pend[i].coded == coded) ||
+		    (input && enc->pend[i].input == input))
+			return true;
+	return false;
+}
+
+/*
+ * Collect queued pictures, oldest first, until none writes coded or reads
+ * input. A timeout under the hardware one is the client's: it may pass.
+ * ctx->mutex held.
+ */
+static VAStatus enc_sync_locked(struct v4l2r_context *ctx,
+				const struct v4l2r_buffer *coded,
+				const struct v4l2r_surface *input,
+				uint64_t timeout_ns)
+{
+	bool soft = timeout_ns < V4L2R_ENC_TIMEOUT_NS;
+	uint64_t deadline = soft ? v4l2r_now_ns() + timeout_ns : 0;
+	VAStatus status = VA_STATUS_SUCCESS;
+
+	while (ctx->enc && enc_pending(ctx->enc, coded, input)) {
+		status = enc_complete_one(ctx, soft ? deadline :
+					  v4l2r_now_ns() + V4L2R_ENC_TIMEOUT_NS, soft);
+		if (status != VA_STATUS_SUCCESS) {
+			if (status != VA_STATUS_ERROR_TIMEDOUT)
+				enc_teardown(ctx->enc);
+			break;
+		}
+	}
+	return status;
+}
+
+VAStatus v4l2r_enc_sync_surface(struct v4l2r_surface *surface,
+				uint64_t timeout_ns)
+{
+	struct v4l2r_context *live[V4L2R_ENC_LIVE_MAX];
+	VAStatus status = VA_STATUS_SUCCESS;
+
+	if (!atomic_load(&enc_inflight))
+		return VA_STATUS_SUCCESS;
+	pthread_mutex_lock(&enc_live_lock);
+	memcpy(live, enc_live, sizeof(live));
+	pthread_mutex_unlock(&enc_live_lock);
+	for (unsigned int i = 0; i < V4L2R_ENC_LIVE_MAX && status == VA_STATUS_SUCCESS; i++) {
+		if (!live[i])
+			continue;
+		pthread_mutex_lock(&live[i]->mutex);
+		status = enc_sync_locked(live[i], NULL, surface, timeout_ns);
+		pthread_mutex_unlock(&live[i]->mutex);
+	}
+	return status;
+}
+
+VAStatus v4l2r_enc_sync_coded(struct v4l2r_driver *drv, VABufferID buf_id,
+			      uint64_t timeout_ns)
+{
+	struct v4l2r_context *ctx;
+	struct v4l2r_buffer *coded;
+	VAStatus status;
+
+	coded = V4L2R_BUFFER_GET(drv, buf_id);
+	if (!coded)
+		return VA_STATUS_ERROR_INVALID_BUFFER;
+	if (coded->type != VAEncCodedBufferType || !atomic_load(&enc_inflight))
+		return VA_STATUS_SUCCESS;
+	ctx = V4L2R_CONTEXT_GET(drv, coded->context_id);
+	if (!ctx || !ctx->enc)
+		return VA_STATUS_SUCCESS;
+	pthread_mutex_lock(&ctx->mutex);
+	status = enc_sync_locked(ctx, coded, NULL, timeout_ns);
+	pthread_mutex_unlock(&ctx->mutex);
+	return status;
+}
