prepare() {
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/package-tests.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0001-driver-encode-H.264-and-HEVC-on-V4L2-stateful-encode.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0002-surface-size-exported-10-bit-backings-for-AV1-and-VP9.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0003-avd-take-the-VP9-maximum-frame-size-from-the-kernel.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0004-context-keep-up-to-16-bitstream-buffers-in-flight.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0005-buffer-surface-encode-bound-coded-sizes-and-hold-the-.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0006-context-rebind-a-busy-surface-to-an-idle-CAPTURE-buf.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0007-context-do-not-enter-DMABUF-mode-for-a-probe-only-ba.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0008-context-rebind-busy-surfaces-by-default.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0009-context-only-client-exports-keep-a-busy-surface-from.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0010-context-when-every-rebind-spare-is-busy-wait-for-the.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0011-tests-cover-rebinding-a-busy-surface.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0012-context-do-not-rebind-a-surface-with-a-derived-image.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0013-tests-cover-the-spare-that-frees-first-when-every-sp.patch"
}

build() {
  # libva supplies /usr/lib/dri. AV1 must be enabled; other codecs follow
  # the available kernel controls.
  # Plain meson rather than arch-meson: the latter lives in devtools, which is
  # not a safe assumption outside a clean chroot. buildtype=plain hands the
  # compiler makepkg's own CFLAGS/LDFLAGS, which is what arch-meson does too.
  meson setup \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode=nodownload \
    -Dtest_profile=package \
    -Dcodec_av1=enabled \
    "libva-v4l2_request-$_commit" build
  meson compile -C build
}

check() {
  # Keep driver regressions; sanitizer campaigns and lab tooling run in driver CI.
  meson test -C build --no-rebuild --num-processes 1 --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  # libva picks its driver from the DRM driver name of the render node, which
  # on Apple Silicon is "asahi", so it looks for asahi_drv_video.so. Nothing
  # else ships that name (mesa provides no VA driver for asahi), so aliasing it
  # here makes every VA-API application find the decoder with no environment
  # variable at all. If mesa ever ships its own asahi_drv_video.so this will
  # collide and pacman will say so at install time.
  ln -sf v4l2_request_drv_video.so "$pkgdir/usr/lib/dri/asahi_drv_video.so"
  # The 7.3 Aurora kernel names the GPU's DRM driver "aurora", so libva looks
  # for aurora_drv_video.so there. Ship both names: one package then serves the
  # 7.2 and the 7.3 kernel.
  ln -sf v4l2_request_drv_video.so "$pkgdir/usr/lib/dri/aurora_drv_video.so"

  install -Dm644 "libva-v4l2_request-$_commit/COPYING" \
    "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 "libva-v4l2_request-$_commit/README" \
    "$pkgdir/usr/share/doc/$pkgname/README"
}
