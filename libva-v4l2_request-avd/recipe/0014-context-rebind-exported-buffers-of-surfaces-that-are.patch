From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 21 Nov 2026 22:47:15 +0000
Subject: [PATCH] context: rebind exported buffers of surfaces that are
 exported every frame

A busy client-exported CAPTURE buffer is never rebound, so playback through FFmpeg hwmap or mpv dma-buf interop waits for every busy buffer as if V4L2R_REBIND were 0. Those clients call vaExportSurfaceHandle() again after each decode and import the new dma-buf, so the buffer they hold is the frame they last imported, not the surface memory for all time.

Rebind such a buffer once its surface has had a fresh export before each of its last two decodes. A surface decoded again without a new export means the client keeps its first dma-buf; from then on exported buffers stay pinned for the whole context, as before. V4L2R_REBIND_EXPORTED=0 keeps every exported buffer pinned.
---
 src/context.c      | 31 ++++++++++++++++++++++++++++++-
 src/surface.c      |  1 +
 src/v4l2_request.h | 15 +++++++++++++++
 3 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/src/context.c b/src/context.c
index e3540d7..35d889d 100644
--- a/src/context.c
+++ b/src/context.c
@@ -875,6 +875,7 @@ static int capture_buffer_bind(struct v4l2r_context *ctx,
 			       struct v4l2r_surface *surface)
 {
 	int index = surface->capture_index;
+	bool fresh_export = false;
 
 	/* Refresh the completion counter with anything already finished. */
 	v4l2r_reap_capture(ctx);
@@ -981,8 +982,33 @@ static int capture_buffer_bind(struct v4l2r_context *ctx,
 	 * this surface, and the orphan must not be recycled under it. At most
 	 * rebind_spare buffers are added beyond the bound ones.
 	 */
+	/*
+	 * A client that exports the surface again after each decode (FFmpeg's
+	 * hwmap, mpv's interop) imports the new dma-buf every frame, so an
+	 * exported buffer can be rebound like any other: the next export
+	 * hands out the new buffer, and the old one keeps the frame the client
+	 * last imported. Require two decodes in a row with a fresh export in
+	 * between, and stop for good once a surface is decoded again without
+	 * one: such a client keeps its first dma-buf and must see every decode
+	 * in it.
+	 */
+	if (ctx->rebind_exported && surface->client_exported) {
+		if (surface->export_gen != surface->bind_export_gen) {
+			if (surface->fresh_exports < 2)
+				surface->fresh_exports++;
+		} else if (!ctx->export_cached) {
+			ctx->export_cached = true;
+			v4l2r_trace("surface 0x%08x decoded again without a new "
+				    "export: exported buffers stay pinned\n",
+				    surface->id);
+		}
+		fresh_export = !ctx->export_cached && surface->fresh_exports >= 2;
+	}
+	surface->bind_export_gen = surface->export_gen;
+
 	if (ctx->rebind_spare && ctx->capture_memory == V4L2_MEMORY_MMAP &&
-	    !ctx->conv && !capture_exported(&ctx->captures[index]) &&
+	    !ctx->conv &&
+	    (!capture_exported(&ctx->captures[index]) || fresh_export) &&
 	    !surface->image_refs && !capture_idle(ctx, index)) {
 		int idle = free_list_take_idle(ctx);
 
@@ -1338,6 +1364,9 @@ VAStatus v4l2r_CreateContext(VADriverContextP va_ctx, VAConfigID config_id,
 
 			ctx->rebind_first = first ? atoi(first) != 0 :
 					    V4L2R_REBIND_FIRST_DEFAULT;
+			rebind = getenv("V4L2R_REBIND_EXPORTED");
+			ctx->rebind_exported = rebind ? atoi(rebind) > 0 :
+					       V4L2R_REBIND_EXPORTED_DEFAULT;
 		}
 
 		capabilities = (capability.capabilities & V4L2_CAP_DEVICE_CAPS) ?
diff --git a/src/surface.c b/src/surface.c
index 702e088..b3607a2 100644
--- a/src/surface.c
+++ b/src/surface.c
@@ -1074,6 +1074,7 @@ VAStatus v4l2r_ExportSurfaceHandle(VADriverContextP va_ctx, VASurfaceID surface_
 		return status;
 
 	surface->client_exported = true;
+	surface->export_gen++;
 	if (surface->ctx && surface->capture_index >= 0)
 		surface->ctx->captures[surface->capture_index].client_exported = true;
 
diff --git a/src/v4l2_request.h b/src/v4l2_request.h
index 9360a3a..e462ed0 100644
--- a/src/v4l2_request.h
+++ b/src/v4l2_request.h
@@ -70,6 +70,9 @@ static inline uint64_t v4l2r_now_ns(void)
 #define V4L2R_REBIND_DEFAULT 4
 #define V4L2R_REBIND_MAX 8
 #define V4L2R_REBIND_FIRST_DEFAULT 1
+/* Rebind the exported buffers of surfaces re-exported after every decode
+ * (V4L2R_REBIND_EXPORTED); 0 keeps every exported buffer pinned. */
+#define V4L2R_REBIND_EXPORTED_DEFAULT 1
 
 /* Upper bound on any single wait for the hardware (buffer/request/fence). */
 #define V4L2R_POLL_TIMEOUT_MS		2000
@@ -302,6 +305,12 @@ struct v4l2r_surface {
 	unsigned int image_refs;
 	/* Handed to a client by vaExportSurfaceHandle(). */
 	bool client_exported;
+	/* vaExportSurfaceHandle() calls so far, the count at the last decode,
+	 * and how many decodes in a row followed a fresh export (V4L2R_REBIND_EXPORTED).
+	 * Only touched under drv->api_mutex. */
+	unsigned int export_gen;
+	unsigned int bind_export_gen;
+	unsigned int fresh_exports;
 	struct v4l2r_surface_backing *backing;
 	/* A finished decode still needs (or is undergoing) format conversion
 	 * into the backing. Protected by ctx->mutex. */
@@ -421,6 +430,12 @@ struct v4l2r_context {
 	bool is_avd;
 	unsigned int rebind_spare;	/* V4L2R_REBIND: 0 = wait for busy buffers */
 	bool rebind_first;	/* V4L2R_REBIND_FIRST: spares busy = wait for the first */
+	/* V4L2R_REBIND_EXPORTED: also rebind client-exported buffers of
+	 * surfaces the client re-exports after every decode. */
+	bool rebind_exported;
+	/* A client decoded into an exported surface again without exporting
+	 * it anew: it keeps the old dma-buf, so exported buffers stay pinned. */
+	bool export_cached;
 
 	unsigned int picture_width;
 	unsigned int picture_height;
