_name=asahi-alarm-installer
pkgname=asahi-fwextract
pkgver=0.9.2
pkgrel=1.609  # local J604 build of the asahi-alarm 0.9.2-1 recipe; any official -2 or newer wins
pkgdesc='Asahi Linux firmware extractor'
arch=('any')
url='http://asahilinux.org'
license=('MIT')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/asahi-alarm/${_name}/archive/refs/tags/v${pkgver}.tar.gz"
        "0001-firmware-extract-H17-camera-tuning-from-current-daem.patch"
        "0002-firmware-wifi-keep-BCM4388-C2.patch")
install=asahi-fwextract.install
sha256sums=('2d4f049d618aa7592db0f6b0bfca1f4485bb2244c74c4d5038681b4b36e305e4'
            '5b4c97518f4bb16fdf4f6da15685cda6b1de4e45117d3fa1b412956c2470e79c'
            '7005d3104bbe534ef414c6980020110adaf3067036970cd57279526cce409156')
b2sums=('cb1ebd6e602c3267c0464d4f2dbba446ffa2f25ba27b93685dc3ddf26576f6fbc275996bc81c9c72583ad760f82b4c366cb7ee4f8696bd746b30c4591dcbd3f0'
        '2cc28f7585ebab0083edb7d5b0ee93211b1a26e8ecfb2e10befa2f8846d733aa4695c7cdebbff9bbbe883e69cfb05f3add734a5c73451cb0611ab650bc095994'
        '4288d19d2aead8d0f48c8571ade8d97b5aad0847e2cd207b010c926b81e3914183a42348fcaedba52496df423bade82f85f75ce0d5a04d6fc2afd14ad50b766b')
depends=(python "asahi-scripts>=20230606-1" lzfse)
makedepends=(python-build python-installer python-wheel python-setuptools)

# J604 (2026-11-07): 0001 = aurora-silicon/aurora-installer a88e1d1 (cherry-pick -x, limited to
# asahi_firmware/isp.py + tests/test_isp.py): IMX958 2224_01XX + H17 1925_03XX setfiles, appleh13/h16camerad
# from the archive root, usr/sbin and usr/libexec. Needed for the J604 front camera (T8132 ISP).
# J604 (2026-11-10): 0002 = aurora-silicon/aurora-installer 34f90a5 (asahi_firmware/wifi.py only): keep the
# C-4388__s-C2 Wi-Fi tree, skip only dangling aliases. Without it asahi-fwupdate drops the J604 Wi-Fi firmware.
prepare() {
    cd "$_name-$pkgver"
    patch -Np1 -i "$srcdir/0001-firmware-extract-H17-camera-tuning-from-current-daem.patch"
    patch -Np1 -i "$srcdir/0002-firmware-wifi-keep-BCM4388-C2.patch"
}

build() {
    cd "$_name-$pkgver"
    python -m build --wheel --no-isolation
}

check() {
    cd "$_name-$pkgver"
    python -m unittest -v tests.test_isp
}

package() {
    cd "$_name-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
}
