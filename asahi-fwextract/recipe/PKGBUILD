_name=asahi-alarm-installer
pkgname=asahi-fwextract
pkgver=0.9.2
pkgrel=1.608  # local J604 build of the asahi-alarm 0.9.2-1 recipe; any official -2 or newer wins
pkgdesc='Asahi Linux firmware extractor'
arch=('any')
url='http://asahilinux.org'
license=('MIT')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/asahi-alarm/${_name}/archive/refs/tags/v${pkgver}.tar.gz"
        "0001-firmware-extract-H17-camera-tuning-from-current-daem.patch")
install=asahi-fwextract.install
sha256sums=('2d4f049d618aa7592db0f6b0bfca1f4485bb2244c74c4d5038681b4b36e305e4'
            '7b696f8e8e10f3e0a6a0b5563a3e449959c1fbda8026efcf883c2bf8f9722177')
b2sums=('cb1ebd6e602c3267c0464d4f2dbba446ffa2f25ba27b93685dc3ddf26576f6fbc275996bc81c9c72583ad760f82b4c366cb7ee4f8696bd746b30c4591dcbd3f0'
        '753c7e14c73e94b5f367dcd900315013e735e78828947630c1acf87c8dce08c0d0061025ecdb94f669a85d7108a9872db5a7bde551c4fd6049f6716a67f5202d')
depends=(python "asahi-scripts>=20230606-1" lzfse)
makedepends=(python-build python-installer python-wheel python-setuptools)

# J604 (2026-11-07): 0001 = aurora-silicon/aurora-installer a88e1d1 (cherry-pick -x, limited to
# asahi_firmware/isp.py + tests/test_isp.py): IMX958 2224_01XX + H17 1925_03XX setfiles, appleh13/h16camerad
# from the archive root, usr/sbin and usr/libexec. Needed for the J604 front camera (T8132 ISP).
prepare() {
    cd "$_name-$pkgver"
    patch -Np1 -i "$srcdir/0001-firmware-extract-H17-camera-tuning-from-current-daem.patch"
}

build() {
    cd "$_name-$pkgver"
    python -m build --wheel --no-isolation
}

check() {
    cd "$_name-$pkgver"
    python -m unittest -v tests.test_isp
}

package() {
    cd "$_name-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
}
