[Unit]
Description=Limit an uncommitted Aurora Stage 2 trial to twelve minutes
ConditionPathExists=/proc/device-tree/chosen/aurora,trial

[Timer]
# J604 (local 9.605): count from activation in the unlocked root, not from kernel start,
# so an encrypted-root passphrase wait does not use up the trial.
OnActiveSec=12min
AccuracySec=10s

[Install]
WantedBy=timers.target
