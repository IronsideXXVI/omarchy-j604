# J604 local build (see README)
# The official recipe, changed only by: pkgrel N -> N.2 and initcpio fixes 0001 (D1, apple_nvmem_spmi) + 0002 (dwc3-apple glue), applied in prepare().
# Maintainer: Jos Dehaes <jos.dehaes@gmail.com>
# Maintainer: Matthias Kurz <m.kurz@irregular.at>

pkgname=asahi-scripts
pkgver=20261023
pkgrel=1.2
pkgdesc='Asahi Linux maintenance scripts'
arch=('any')
url='http://asahilinux.org'
license=('MIT')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/asahi-alarm/${pkgname}/archive/refs/tags/${pkgver}.tar.gz"
        "0001-initcpio-Add-apple_nvmem_spmi-module.patch"
        "0002-initcpio-Add-the-dwc3-apple-glue-module.patch")
install=asahi-scripts.install
sha256sums=('64c7e8d50f7ad37d58a64d1f1bc7c8848d7507093f40172e6dbce75c72b26ce4'
            '200f07a78f5c9c4b626e9d6daa48b39eef6539784e513649d281b7ea738cd534'
            '3eb4c21e4e9b0bf89d171d96c40650a5267023746c8eb4359f63a8c5b3694144')
b2sums=('d39055c0fea22fd52821197bdb78610ab943e5e1418d344795dab82b381b94eddd89641bdf60357411b2c14caf96eb19a4a23bd258d3a00127e70679a7ca8770'
        '25ca8baf5e4d091384e0d64a9e68ea48505c0439b7002bca11fca9b735c15972d649decc3e1956da836b5c9e7121a2b0deaff44bdd8b7f608a3092b44c3af8ea'
        'da4394a7f96f1f88af54c7937aa66bdd28b0dda229dd936743b096bfd792ab0b64fed643edce45b32545d3ca53af366e37139a6f0bed3b4b9f397af924466c15')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  patch -Np1 -i "${srcdir}/0001-initcpio-Add-apple_nvmem_spmi-module.patch"
  patch -Np1 -i "${srcdir}/0002-initcpio-Add-the-dwc3-apple-glue-module.patch"
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make PREFIX=/usr DESTDIR=${pkgdir} all
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make PREFIX=/usr DESTDIR=${pkgdir} install-arch
  # re-add DTBS variable
  sed -i -e '/${CONFIG/i : ${DTBS:=$(/bin/ls -d /lib/modules/*-ARCH | sort -rV | head -1)/dtbs/*.dtb}' "$pkgdir/usr/bin/update-m1n1"
  install -Dm644 "$srcdir/${pkgname}-${pkgver}/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
