# J604 local build (see README)
# The official recipe, changed only by: pkgrel 1.604 -> 1.605 (the jack/HPAI build 1.604 plus the speakers), 0002 (J604 speaker card) applied after the jack/HPAI patch 0001.
pkgname=alsa-ucm-conf-aurora
pkgver=10.aurora3
pkgrel=1.605
pkgdesc='Aurora Apple Silicon ALSA profiles including J700'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/aurora-silicon/alsa-ucm-conf-asahi'
license=('BSD-3-Clause')
_commit=b9b2d0c82cbb46025e586b2dc9f2cae644d29999
makedepends=('git')
depends=('alsa-ucm-conf')
provides=("alsa-ucm-conf-asahi=$pkgver" "alsa-ucm-conf-asahi-aurora=$pkgver")
conflicts=('alsa-ucm-conf-asahi' 'alsa-ucm-conf-asahi-aurora')
replaces=('alsa-ucm-conf-asahi-aurora')
source=("ucm::git+$url.git#commit=$_commit"
        0001-j604-ucm-jack-hpai.patch
        0002-j604-ucm-speakers.patch)
sha256sums=('SKIP'
            'b9b9a202d04b2049a2769784613ea56abf269a4828ab60d5b3cc724f91cd2281'
            '83ba03e199b5d8f3b2f2c73205dc9322404bcc156757a967a7e354927cb3213e')
prepare() {
  # J604 headphone jack and microphone cards, until the pinned source has
  # them. git apply refuses to create files that already exist, so this
  # fails loudly once the pin moves past the upstream commit.
  git -C ucm apply "$srcdir/0001-j604-ucm-jack-hpai.patch"
  git -C ucm apply "$srcdir/0002-j604-ucm-speakers.patch"
}
package() {
  install -d "$pkgdir/usr/share/alsa"
  cp -a ucm/ucm2 "$pkgdir/usr/share/alsa/"
  install -Dm644 ucm/LICENSE.asahi "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
