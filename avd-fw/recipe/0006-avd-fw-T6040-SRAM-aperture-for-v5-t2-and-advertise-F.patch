From 4f7111b6cb29eb13949eedd19d893189cb1ec4d3 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sat, 31 Oct 2026 23:31:32 +1100
Subject: [PATCH 06/15] avd-fw: T6040 SRAM aperture for v5-t2 and advertise
 FIFO slots

The queue ABI's PIODMA destination header is an address in the AVD
internal map, so it must match the SoC's sram window. T6040 has a
0x14000-byte code window and its sram starts at +0x94000; the v5-t1
aperture (+0x92000) would stage program words inside the firmware's
private state. Give v5-t2 the T6040 aperture and document that T6040
loads v5-t2 for queue mode (legacy mode does not use the aperture).

Publish the hardware FIFO slot count at info +0x28 so the host caps
frames in flight at min(16, slots): 7 on tier-0 parts (T8103, T8140
and the parts we cannot confirm), 15 otherwise.

Note the open question on the PIODMA header size field.
[dylan: one co-author trailer of the original message is not reproduced here]

---
 docs/queue.md           | 19 +++++++++++++++++--
 src/queue-fw.c          | 14 ++++++++++++++
 tests/transport-test.py |  5 +++--
 3 files changed, 34 insertions(+), 4 deletions(-)

diff --git a/docs/queue.md b/docs/queue.md
index cd97a30..7eeb80f 100644
--- a/docs/queue.md
+++ b/docs/queue.md
@@ -26,7 +26,8 @@ information block at SRAM `+0x7fc0` before raising the existing boot-ready flag:
 | 0x1c | PIODMA destination header for every packet (use verbatim) |
 | 0x20 | VP register index limit (exclusive), 4 / 9 / 12 |
 | 0x24 | codec mask: bits HEVC=0, H.264=1, VP9=2, AV1=3 |
-| 0x28..0x3c | reserved, zero |
+| 0x28 | hardware FIFO slots: cap frames in flight at min(16, this) |
+| 0x2c..0x3c | reserved, zero |
 
 Read the block after boot-ready. Missing magic means old firmware: use the
 legacy backend, or reject queue mode. An unknown version must not be submitted.
@@ -47,7 +48,15 @@ Current firmware aperture addresses are:
 | v3-t0, v3-t1 | `0x01090000` | `0x40070000` | `0x000c + 4*vp` / `0x0030` |
 | v4-t0 | `0x01092000` | `0x41070000` | `0x000c + 4*vp` / `0x0040` |
 | v5-t0 | `0x01090000` | `0x41070000` | `0x000c + 4*vp` / `0x0040` |
-| v5-t1, v5-t2 | `0x01092000` | `0x41070000` | `0x000c + 4*vp` / `0x0040` |
+| v5-t1 | `0x01092000` | `0x41070000` | `0x000c + 4*vp` / `0x0040` |
+| v5-t2 (T6040/T6041) | `0x01094000` | `0x41070000` | `0x000c + 4*vp` / `0x0040` |
+
+The aperture must match the SoC's DT `sram` offset from the AVD base
+(+0x90000 on T6000, T8112 and T8140; +0x92000 on T8132; +0x94000 on T6040),
+because the PIODMA destination header is an address in that space. T6040 must
+load `avd-fw-v5-t2` for queue mode: `avd-fw-v5-t1` would place staged words
+0x2000 bytes low, inside the firmware's private state. Legacy mode does not
+use the aperture, so T6040 legacy decode is unaffected by the image choice.
 
 Firmware image version numbers differ from Linux's hardware revision numbering:
 T8103 uses v2, T6000/T8112 use v3, T8122 uses v4, and T8140/T6040 use v5.
@@ -134,6 +143,12 @@ Tansy `0x5c11` command fetches 368 bytes: a header plus 91 continuation words.
 It clears stale DONE at `+0x04` before issuing, polls DONE bit 0 without masking interrupts, then
 acknowledges DONE. Polling has a bounded software iteration timeout.
 
+Open hardware question: public notes describe the per-segment header as
+`SIZE_words << 18 | DEST | BIT(0)`, while this ABI advertises a header with
+the size field zero and carries the size only in the command register. If
+device bring-up sees PIODMA timeouts, OR `payload_words << 18` into each
+packet header and record which form the engine accepts.
+
 The engine consumes the destination header and places the payload into SRAM
 `+0x9000`. CM3 writes those words to the selected VP instruction FIFO, using
 local stores with conservative spacing. It pauses when the existing per-VP FIFO
diff --git a/src/queue-fw.c b/src/queue-fw.c
index ccf3e41..03bd756 100644
--- a/src/queue-fw.c
+++ b/src/queue-fw.c
@@ -21,6 +21,9 @@
 #else
 #if AVD_VER == 5 && AVD_TIER == 0
 #define SRAM_APERTURE 0x01090000u
+#elif AVD_VER == 5 && AVD_TIER == 2
+/* T6040/T6041: 0x14000-byte code window, so SRAM starts at +0x94000. */
+#define SRAM_APERTURE 0x01094000u
 #else
 #define SRAM_APERTURE 0x01092000u
 #endif
@@ -36,6 +39,16 @@
 #else
 #define Q_PIODMA_BASE 0x41070000u
 #endif
+/*
+ * Independent hardware instruction FIFOs (EXEC bits 7:4).  Public variant
+ * tables give 7 on T8103 and T8140 and 15 on the later tier-1 parts; tier-0
+ * parts we cannot confirm get the conservative 7.
+ */
+#if AVD_TIER == 0
+#define FIFO_SLOTS 7u
+#else
+#define FIFO_SLOTS 15u
+#endif
 #define Q_DMA(off) REG(Q_PIODMA_BASE + (off))
 #define SRAM_ALIAS 0x10000000u
 #define Q_RING (SRAM_APERTURE + AVDQ_RING_OFFSET)
@@ -78,6 +91,7 @@ void avdq_fw_init(void)
 	Q_INFO[7] = avdq_packet_header(SRAM_APERTURE + AVDQ_STAGE_OFFSET);
 	Q_INFO[8] = VP_COUNT;
 	Q_INFO[9] = AVD_VER <= 3 ? 7u : 15u;
+	Q_INFO[10] = FIFO_SLOTS;
 	barrier();
 	Q_INFO[0] = AVDQ_MAGIC;
 }
diff --git a/tests/transport-test.py b/tests/transport-test.py
index d148fa5..0f1e4af 100644
--- a/tests/transport-test.py
+++ b/tests/transport-test.py
@@ -47,10 +47,11 @@ class Transport:
         self.uc.hook_add(UC_HOOK_MEM_READ, self.read)
         self.uc.hook_add(UC_HOOK_MEM_WRITE, self.write)
         self.call("avdq_fw_init")
-        self.info = [self.u32(0x10007fc0 + i * 4) for i in range(10)]
+        self.info = [self.u32(0x10007fc0 + i * 4) for i in range(11)]
         assert self.info[:4] == [0x41565131, 1, 16, 64]
-        expected = 0x0108c000 if self.version == 2 else 0x01090000 if self.version == 3 or (self.version == 5 and self.tier == 0) else 0x01092000
+        expected = 0x0108c000 if self.version == 2 else 0x01090000 if self.version == 3 or (self.version == 5 and self.tier == 0) else 0x01094000 if (self.version == 5 and self.tier == 2) else 0x01092000
         assert self.info[4] == expected and self.info[8] == self.vps
+        assert self.info[10] == (7 if self.tier == 0 else 15)
         self.ring = self.info[4] + self.info[5]
 
     def u32(self, addr):
