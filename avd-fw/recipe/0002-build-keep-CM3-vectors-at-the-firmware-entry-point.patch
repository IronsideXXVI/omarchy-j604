From 645128ae93cccab7ebf79fdcb3051421c8a559f4 Mon Sep 17 00:00:00 2001
From: DjDeveloperr <hey@djdev.me>
Date: Mon, 21 Sep 2026 02:52:05 -0400
Subject: [PATCH 02/15] build: keep CM3 vectors at the firmware entry point

---
 Makefile   | 7 +++++--
 avd-cm3.ld | 6 +++++-
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/Makefile b/Makefile
index d003b45..1e95415 100644
--- a/Makefile
+++ b/Makefile
@@ -31,7 +31,10 @@ LAST_BUILT := $(shell echo "$(CFLAGS)" | cmp -s .flags || echo "$(CFLAGS)" > .fl
 
 NAME = avd-fw-v$(AVD_VER)-t$(AVD_TIER)
 
-OBJECTS := util.o irq.o avd.o
+# Keep the reset path at the start of .text.  The AVD CM3 boot path used on
+# t8140 is only hardware-verified with _start at 0x0c70; placing avd.o last
+# moves it behind the full IRQ trampoline table.
+OBJECTS := avd.o irq.o util.o
 
 BUILD_OBJS := $(patsubst %,build/%,$(OBJECTS))
 
@@ -41,7 +44,7 @@ clean:
 	rm -rf build/*
 
 build/$(NAME).elf: $(BUILD_OBJS)
-	$(CC) $(CFLAGS) -T $(LD_SCRIPT) -o $@ $^
+	$(CC) $(CFLAGS) -fuse-ld=lld -T $(LD_SCRIPT) -o $@ $^
 
 build/%.o: src/%.c .flags
 	mkdir -p "$(dir $@)"
diff --git a/avd-cm3.ld b/avd-cm3.ld
index ccfcabf..6226e22 100644
--- a/avd-cm3.ld
+++ b/avd-cm3.ld
@@ -1,6 +1,10 @@
 SECTIONS {
     . = 0x00000000;
-    .vectors : { *(.vectors) }
+    .vectors : { KEEP(*(.vectors)) }
     .text    : { *(.text*)   }
     .data    : { *(.data*)   }
+
+    /* Bare-metal CM3 firmware has no unwinder.  LLVM otherwise places this
+     * orphan section at address zero, ahead of the architectural vectors. */
+    /DISCARD/ : { *(.ARM.exidx*) *(.ARM.extab*) }
 }
