+++ b/docs/queue.md
@@ -276,13 +276,19 @@ lead's device tests. No hardware was requested for this change.
 Requirements: Clang with the ARM bare-metal target, LLD, llvm-objcopy, a native C
 compiler, Meson >=1.4, Ninja. Keep LLVM/LLD tools on PATH.
 
+The Makefile and Meson (with `llvm.ini` and its default options) build the same
+images byte for byte. Do not pass `--buildtype` or `-Doptimization` to Meson,
+and do not let a distribution inject its own CFLAGS: either changes the code.
+`arm-none-eabi-gcc.ini` is a GCC alternative and produces different images.
+
 ```sh
 make test
 sh tests/build-all.sh
 python3 tests/check-images.py build/avd-fw-*.bin
-meson setup build/meson --cross-file llvm.ini --buildtype=release
+meson setup build/meson --cross-file llvm.ini
 meson compile -C build/meson
 meson test -C build/meson --print-errorlogs
+sh tests/check-reproducible.sh   # Make and Meson images must be byte-identical
 
 # Optional integration test of actual ARM machine code, with synthetic MMIO:
 python3 -m venv build/test-venv
diff --git a/meson.build b/meson.build
index 522e7e8..fdbebee 100644
--- a/meson.build
+++ b/meson.build
@@ -1,4 +1,9 @@
-project('avd-fw', 'c', default_options: ['c_std=c11'], meson_version: '>=1.4.0', version: '0.1')
+# optimization=2 and debug=false match the Makefile (-O2, no -g), so both build
+# systems produce byte-identical images; tests/check-reproducible.sh checks it.
+# Meson's own default (buildtype=debug: -O0 -g) would ship different firmware.
+project('avd-fw', 'c',
+    default_options: ['c_std=c11', 'optimization=2', 'debug=false'],
+    meson_version: '>=1.4.0', version: '0.1')
 
 # cross files are needed as those are the only way to set default compiler
 # and specify the host arch
diff --git a/tests/check-reproducible.sh b/tests/check-reproducible.sh
new file mode 100755
index 0000000..4810056
--- /dev/null
+++ b/tests/check-reproducible.sh
@@ -0,0 +1,30 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+# Build every image with the Makefile and with Meson (llvm.ini, default options)
+# and require byte-identical results, so there is one reproducible firmware.
+set -eu
+cd "$(dirname "$0")/.."
+out=build/repro
+rm -rf "$out"
+mkdir -p "$out/make"
+for variant in 2:0 3:0 3:1 4:0 5:0 5:1 5:2; do
+    version=${variant%:*}
+    tier=${variant#*:}
+    make -s AVD_VER="$version" AVD_TIER="$tier"
+    cp "build/avd-fw-v$version-t$tier.bin" "$out/make/"
+done
+env -u CFLAGS -u LDFLAGS meson setup "$out/meson" --cross-file llvm.ini >/dev/null
+meson compile -C "$out/meson" >/dev/null
+fail=0
+for image in "$out"/make/avd-fw-*.bin; do
+    name=$(basename "$image")
+    other=$(find "$out/meson" -name "$name" -type f | head -n 1)
+    if [ -z "$other" ]; then
+        echo "$name: missing from the Meson build"; fail=1
+    elif cmp -s "$image" "$other"; then
+        echo "$name: identical $(sha256sum "$image" | cut -d' ' -f1)"
+    else
+        echo "$name: Make and Meson images differ"; fail=1
+    fi
+done
+exit $fail
