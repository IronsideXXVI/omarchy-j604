     t.vp_done(); t.poll()
+    t.poll(8)
+    assert t.stores == words + [0xfeed] and len(t.fetches) == 4
     assert t.kicks == [0x2b000400] and not t.notifications
     t.vp_done(); t.poll()
     assert len(t.kicks) == 1
