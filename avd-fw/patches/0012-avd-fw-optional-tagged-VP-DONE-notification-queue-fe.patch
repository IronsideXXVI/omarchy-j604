From bf49a31b1036c72be5fdc37eb8232f6c953e0626 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sun, 1 Nov 2026 18:47:51 +1100
Subject: [PATCH 12/15] avd-fw: optional tagged VP DONE notification (queue
 feature bit 2)

The host can overlap VP9 pictures if it learns when picture N's VP stage is
done: the symbol counts for backward adaptation exist at that point, so the
VP of picture N+1 can start while the PP of picture N still runs.

Add queue feature bit 2 (AVDQ_FEAT_VP_DONE). A descriptor with flag bit 1
(AVDQ_FLAG_VP_DONE) gets one extra mailbox-1 message, 0x5454xxxx with the
frame tag, when its VP stage completes. That is once per frame, before the
usual tagged completion. Descriptors without the flag behave as before, and
hosts that do not set it see no new messages.

Tested:
- make test: the queue unit test passes;
- the unicorn transport test passes on all seven images;
- check-images passes.
Images built with tests/build-all.sh are byte-identical to the firmware that
ran the J616s (T6040) rewrite bench on 2026-11-01: VP9 1080p 878 fps and
4K 244 fps, every frame bit-exact against software decode.
[dylan: one co-author trailer of the original message is not reproduced here]

---
 src/queue-fw.c          | 30 +++++++++++++++++++++++++++++-
 src/queue.c             |  3 ++-
 src/queue.h             |  5 ++++-
 tests/queue-test.c      |  2 +-
 tests/transport-test.py |  2 +-
 5 files changed, 37 insertions(+), 5 deletions(-)

diff --git a/src/queue-fw.c b/src/queue-fw.c
index c93bfcd..a481e62 100644
--- a/src/queue-fw.c
+++ b/src/queue-fw.c
@@ -99,7 +99,8 @@ void avdq_fw_init(void)
 	Q_INFO[8] = VP_COUNT;
 	Q_INFO[9] = AVD_VER <= 3 ? 7u : 15u;
 	Q_INFO[10] = FIFO_SLOTS;
-	Q_INFO[11] = AVDQ_FEAT_SRAM_RING | AVDQ_FEAT_MULTI_KICK;
+	Q_INFO[11] = AVDQ_FEAT_SRAM_RING | AVDQ_FEAT_MULTI_KICK |
+		     AVDQ_FEAT_VP_DONE;
 	Q_INFO[12] = AVDQ_SRAM_RING_OFFSET;
 	Q_INFO[13] = AVDQ_SRAM_RING_WORDS;
 	barrier();
@@ -266,6 +267,32 @@ static void kick(void *cookie, const struct avdq_desc *d)
 		reg_write(REG(DECODE_CTRL_BASE + PP_FIFO), d->pp_cont);
 }
 
+/* VP records do not release any descriptor or DMA storage. */
+static void notify_vp(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < FW->q.count; i++) {
+		unsigned int idx = FW->q.order[(FW->q.head + i) & 15u];
+		struct avdq_frame *f = &FW->q.frame[idx];
+		volatile struct avdq_desc *d = Q_DESC(idx);
+
+		if (!(f->desc.flags & AVDQ_FLAG_VP_DONE) || f->vp_notified ||
+		    f->status || (f->phase != AVDQ_PP_READY &&
+		    f->phase != AVDQ_PP && f->phase != AVDQ_DONE))
+			continue;
+		if (!(reg_read(CM3_MBOX1_STATUS) & CM3_MBOX_STATUS_EMPTY))
+			return;
+		d->reserved[0] = f->desc.tag;
+		barrier();
+		d->reserved[1] = 1;
+		barrier();
+		reg_write(CM3_MBOX1_TX, AVDQ_VP_NOTIFY | (f->desc.tag & 0xfff0u) | idx);
+		f->vp_notified = 1;
+		return;
+	}
+}
+
 static int complete(void *cookie, unsigned int idx, const struct avdq_frame *f)
 {
 	volatile struct avdq_desc *d = Q_DESC(idx);
@@ -323,6 +350,7 @@ int avdq_fw_poll(void)
 		/* Queue mode owns PIODMA; the Tansy transport cannot run concurrently. */
 		reg_write(Q_DMA(0x00), reg_read(Q_DMA(0x00)) & ~1u);
 	}
+	notify_vp();
 	avdq_step(&FW->q, &ops, FW);
 	if (FW->fatal && !FW->q.count &&
 	    (reg_read(CM3_MBOX1_STATUS) & CM3_MBOX_STATUS_EMPTY)) {
diff --git a/src/queue.c b/src/queue.c
index 4c5eb53..058c5d5 100644
--- a/src/queue.c
+++ b/src/queue.c
@@ -21,7 +21,7 @@ static int valid(const struct avdq_desc *d, unsigned int idx,
 	    d->state != AVDQ_SUBMITTED || d->codec > AVDQ_AV1 ||
 	    !(codec_mask & (1u << d->codec)) || d->vp_slot >= vp_count ||
 	    !d->program_words || d->program_words > AVDQ_MAX_WORDS ||
-	    !d->pp_kick || (d->flags & ~AVDQ_FLAG_SRAM) ||
+	    !d->pp_kick || (d->flags & ~(AVDQ_FLAG_SRAM | AVDQ_FLAG_VP_DONE)) ||
 	    d->pp_extra > AVDQ_MAX_PP_EXTRA || (d->pp_extra && !d->pp_cont))
 		return 0;
 	if (d->flags & AVDQ_FLAG_SRAM) {
@@ -49,6 +49,7 @@ int avdq_submit(struct avdq *q, unsigned int idx, const struct avdq_desc *d,
 	f = &q->frame[idx];
 	f->desc = *d;
 	f->pushed = 0;
+	f->vp_notified = 0;
 	f->status = valid(d, idx, vp_count, codec_mask) ? AVDQ_OK : AVDQ_INVALID;
 	f->phase = f->status ? AVDQ_DONE : AVDQ_PENDING;
 	q->order[(q->head + q->count) & (AVDQ_COUNT - 1)] = idx;
diff --git a/src/queue.h b/src/queue.h
index 074e9a7..ddd6082 100644
--- a/src/queue.h
+++ b/src/queue.h
@@ -24,6 +24,9 @@
  */
 #define AVDQ_FLAG_SRAM 1u
 #define AVDQ_FEAT_SRAM_RING 1u
+#define AVDQ_FEAT_VP_DONE (1u << 2)
+#define AVDQ_FLAG_VP_DONE (1u << 1)
+#define AVDQ_VP_NOTIFY 0x54540000u
 #define AVDQ_FEAT_MULTI_KICK 2u
 #define AVDQ_SRAM_RING_OFFSET 0x0u
 #define AVDQ_SRAM_RING_WORDS 0x1800u
@@ -78,7 +81,7 @@ enum avdq_phase { AVDQ_FREE, AVDQ_PENDING, AVDQ_PUSH, AVDQ_VP,
 	AVDQ_PP_READY, AVDQ_PP, AVDQ_DONE };
 struct avdq_frame {
 	struct avdq_desc desc;
-	uint32_t phase, pushed, status;
+	uint32_t phase, pushed, status, vp_notified;
 };
 struct avdq {
 	struct avdq_frame frame[AVDQ_COUNT];
diff --git a/tests/queue-test.c b/tests/queue-test.c
index e739f2e..c7bf651 100644
--- a/tests/queue-test.c
+++ b/tests/queue-test.c
@@ -105,7 +105,7 @@ static void invalid(void)
 		case 10: d.program_lo = 0xfffffffcu; d.program_hi = 0xffffffffu; break;
 		case 11: d.pp_kick = 0; break;
 		case 12: d.reserved[1] = 1; break;
-		case 13: d.flags = 2; break;
+		case 13: d.flags = 4; break;
 		case 14: d.pp_extra = AVDQ_MAX_PP_EXTRA + 1; d.pp_cont = 1; break;
 		case 15: d.pp_extra = 1; break; /* continuation word missing */
 		case 16: d.flags = AVDQ_FLAG_SRAM; break; /* program_hi must be 0 */
diff --git a/tests/transport-test.py b/tests/transport-test.py
index 72c07c4..d464c19 100644
--- a/tests/transport-test.py
+++ b/tests/transport-test.py
@@ -50,7 +50,7 @@ class Transport:
         self.call("avdq_fw_init")
         self.info = [self.u32(0x10007fc0 + i * 4) for i in range(16)]
         assert self.info[:4] == [0x41565131, 2, 16, 64]
-        assert self.info[11:16] == [3, 0, 0x1800, 0, 0]
+        assert self.info[11:16] == [7, 0, 0x1800, 0, 0]
         expected = 0x0108c000 if self.version == 2 else 0x01090000 if self.version == 3 or (self.version == 5 and self.tier == 0) else 0x01094000 if (self.version == 5 and self.tier == 2) else 0x01092000
         assert self.info[4] == expected and self.info[8] == self.vps
         assert self.info[10] == (7 if self.version == 2 or (self.version == 5 and self.tier == 0) else 15)
