diff --git a/src/queue.c b/src/queue.c
new file mode 100644
index 0000000..a7954e5
--- /dev/null
+++ b/src/queue.c
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: MIT */
+#include "queue.h"
+
+void avdq_init(struct avdq *q)
+{
+	unsigned int i;
+	q->head = q->count = q->halted = 0;
+	q->pp_active = -1;
+	for (i = 0; i < AVDQ_COUNT; i++)
+		q->frame[i].phase = AVDQ_FREE;
+}
+
+static int valid(const struct avdq_desc *d, unsigned int idx,
+		 unsigned int vp_count, unsigned int codec_mask)
+{
+	uint64_t addr = ((uint64_t)d->program_hi << 32) | d->program_lo;
+	uint64_t packets = (d->program_words + AVDQ_PACKET_WORDS - 1u) /
+			   AVDQ_PACKET_WORDS;
+	unsigned int i;
+	if (d->magic != AVDQ_MAGIC || (d->tag & 15u) != idx ||
+	    d->state != AVDQ_SUBMITTED || d->codec > AVDQ_AV1 ||
+	    !(codec_mask & (1u << d->codec)) || d->vp_slot >= vp_count ||
+	    !addr || (addr & 3u) || !d->program_words ||
+	    d->program_words > AVDQ_MAX_WORDS ||
+	    addr > UINT64_MAX - packets * AVDQ_PACKET_BYTES || !d->pp_kick)
+		return 0;
+	for (i = 0; i < 5; i++)
+		if (d->reserved[i])
+			return 0;
+	return 1;
+}
+
+int avdq_submit(struct avdq *q, unsigned int idx, const struct avdq_desc *d,
+	       unsigned int vp_count, unsigned int codec_mask)
+{
+	struct avdq_frame *f;
+	/* Duplicate doorbells must never overwrite the owner or its full tag. */
+	if (idx >= AVDQ_COUNT || q->count == AVDQ_COUNT ||
+	    q->frame[idx].phase != AVDQ_FREE || q->halted)
+		return -1;
+	f = &q->frame[idx];
+	f->desc = *d;
+	f->pushed = 0;
+	f->status = valid(d, idx, vp_count, codec_mask) ? AVDQ_OK : AVDQ_INVALID;
+	f->phase = f->status ? AVDQ_DONE : AVDQ_PENDING;
+	q->order[(q->head + q->count) & (AVDQ_COUNT - 1)] = idx;
+	q->count++;
+	return 0;
+}
+
+void avdq_fault(struct avdq *q)
+{
+	unsigned int i;
+	q->halted = 1;
+	q->pp_active = -1;
+	for (i = 0; i < AVDQ_COUNT; i++) {
+		struct avdq_frame *f = &q->frame[i];
+		if (f->phase != AVDQ_FREE && f->phase != AVDQ_DONE) {
+			f->status = AVDQ_IO;
+			f->phase = AVDQ_DONE;
+		}
+	}
+}
+
+void avdq_vp_done(struct avdq *q, unsigned int vp)
+{
+	unsigned int i;
+	if (q->halted)
+		return;
+	for (i = 0; i < q->count; i++) {
+		struct avdq_frame *f = &q->frame[q->order[(q->head + i) & 15u]];
+		if (f->phase == AVDQ_VP && f->desc.vp_slot == vp) {
+			f->phase = AVDQ_PP_READY;
+			return;
+		}
+	}
+	/* Lost/coalesced or premature DONE cannot be attributed safely. */
+	avdq_fault(q);
+}
+
+void avdq_pp_done(struct avdq *q)
+{
+	if (q->halted)
+		return;
+	if (q->pp_active < 0) {
+		avdq_fault(q);
+		return;
+	}
+	q->frame[q->pp_active].phase = AVDQ_DONE;
+	q->pp_active = -1;
+}
+
+void avdq_step(struct avdq *q, const struct avdq_ops *ops, void *cookie)
+{
+	unsigned int i;
+	/* Publish in submission order; a full outbox never drops a completion. */
+	if (q->count) {
+		unsigned int idx = q->order[q->head];
+		struct avdq_frame *f = &q->frame[idx];
+		if (f->phase == AVDQ_DONE && ops->complete(cookie, idx, f)) {
+			f->phase = AVDQ_FREE;
+			q->head = (q->head + 1u) & 15u;
+			q->count--;
+		}
+	}
+	if (q->halted)
+		return;
+	for (i = 0; i < q->count; i++) {
+		unsigned int idx = q->order[(q->head + i) & 15u];
+		struct avdq_frame *f = &q->frame[idx];
+		if (f->phase == AVDQ_PP_READY && q->pp_active < 0) {
+			q->pp_active = (int)idx;
+			f->phase = AVDQ_PP;
+			ops->kick(cookie, f->desc.pp_kick);
+			break;
+		}
+	}
+	/* One SRAM staging buffer; preserve program order across chunks. */
+	for (i = 0; i < q->count; i++) {
+		struct avdq_frame *f = &q->frame[q->order[(q->head + i) & 15u]];
+		int result;
+		if (f->phase != AVDQ_PENDING && f->phase != AVDQ_PUSH)
+			continue;
+		f->phase = AVDQ_PUSH;
+		result = ops->feed(cookie, f);
+		if (result < 0)
+			avdq_fault(q);
+		else if (result > 0)
+			f->phase = AVDQ_VP;
+		break;
+	}
+}
diff --git a/src/queue.h b/src/queue.h
new file mode 100644
index 0000000..79ad4c8
--- /dev/null
+++ b/src/queue.h
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef AVD_FW_QUEUE_H
+#define AVD_FW_QUEUE_H
+
+#include <stdint.h>
+
+#define AVDQ_VERSION 1u
+#define AVDQ_MAGIC 0x41565131u /* AVQ1 */
+#define AVDQ_COUNT 16u
+#define AVDQ_DESC_BYTES 64u
+#define AVDQ_RING_OFFSET 0x8000u
+#define AVDQ_STAGE_OFFSET 0x9000u
+#define AVDQ_PACKET_WORDS 256u
+#define AVDQ_PACKET_BYTES ((AVDQ_PACKET_WORDS + 1u) * 4u)
+#define AVDQ_MAX_WORDS 0x100000u
+#define AVDQ_NOTIFY 0x54530000u
+#define AVDQ_FATAL 0x5452ffffu
+
+#define AVDQ_SUBMITTED 1u
+#define AVDQ_COMPLETE 2u
+#define AVDQ_OK 0u
+#define AVDQ_INVALID 1u
+#define AVDQ_IO 2u
+
+enum avdq_codec { AVDQ_HEVC, AVDQ_H264, AVDQ_VP9, AVDQ_AV1 };
+
+/* Little-endian wire layout. No native pointers or compiler bitfields. */
+struct avdq_desc {
+	uint32_t magic, tag, codec, vp_slot;
+	uint32_t program_lo, program_hi, program_words, pp_kick;
+	uint32_t state, status, completion_tag, reserved[5];
+};
+_Static_assert(sizeof(struct avdq_desc) == AVDQ_DESC_BYTES, "wire size");
+
+/* The packet header encodes a destination in the 128-KiB SRAM aperture. */
+static inline uint32_t avdq_packet_header(uint32_t dst)
+{
+	return (dst & 0xfffeu) | ((dst & 0x10000u) << 1) | 1u;
+}
+
+static inline uint32_t avdq_dma_command(uint32_t words)
+{
+	return ((words + 1u) << 6) | 0x11u;
+}
+
+static inline uint32_t avdq_notification(uint32_t tag, unsigned int idx)
+{
+	return AVDQ_NOTIFY | (tag & 0xfff0u) | idx;
+}
+
+/* Return -1 before doing any aperture read for an unaligned/outside token. */
+static inline int avdq_index(uint32_t token, uint32_t ring)
+{
+	uint32_t offset = token - ring;
+	if (token < ring || offset >= AVDQ_COUNT * AVDQ_DESC_BYTES ||
+	    offset % AVDQ_DESC_BYTES)
+		return -1;
+	return (int)(offset / AVDQ_DESC_BYTES);
+}
+
+enum avdq_phase { AVDQ_FREE, AVDQ_PENDING, AVDQ_PUSH, AVDQ_VP,
+	AVDQ_PP_READY, AVDQ_PP, AVDQ_DONE };
+struct avdq_frame {
+	struct avdq_desc desc;
+	uint32_t phase, pushed, status;
+};
+struct avdq {
+	struct avdq_frame frame[AVDQ_COUNT];
+	uint32_t order[AVDQ_COUNT], head, count, halted;
+	int pp_active;
+};
+
+/* Single owner: IRQs only latch events, the foreground calls these methods. */
+struct avdq_ops {
+	/* Feed a bounded amount: 0 waiting, 1 all words sent, -1 fatal I/O. */
+	int (*feed)(void *cookie, struct avdq_frame *f);
+	void (*kick)(void *cookie, uint32_t word);
+	/* Must publish record before notification; return 0 if outbox full. */
+	int (*complete)(void *cookie, unsigned int idx,
+			const struct avdq_frame *f);
+};
+void avdq_init(struct avdq *q);
+int avdq_submit(struct avdq *q, unsigned int idx, const struct avdq_desc *d,
+	       unsigned int vp_count, unsigned int codec_mask);
+void avdq_fault(struct avdq *q);
+void avdq_vp_done(struct avdq *q, unsigned int vp);
+void avdq_pp_done(struct avdq *q);
+void avdq_step(struct avdq *q, const struct avdq_ops *ops, void *cookie);
+#endif
