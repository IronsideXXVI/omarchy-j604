+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+cd "$(dirname "$0")/.."
+for variant in 2:0 3:0 3:1 4:0 5:0 5:1 5:2; do
+    version=${variant%:*}
+    tier=${variant#*:}
+    make AVD_VER="$version" AVD_TIER="$tier"
+done
diff --git a/tests/check-images.py b/tests/check-images.py
new file mode 100644
index 0000000..5ecc0e3
--- /dev/null
+++ b/tests/check-images.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Check padding and architectural boot vectors for every built variant."""
+import pathlib
+import struct
+import subprocess
+import sys
+
+for arg in sys.argv[1:]:
+    image = pathlib.Path(arg)
+    version, tier = map(int, image.stem.removeprefix("avd-fw-v").split("-t"))
+    pad = 0xc000 if version == 2 else 0x10000 if version == 3 or (version == 5 and tier == 0) else 0x12000
+    data = image.read_bytes()
+    assert len(data) == pad, (image, len(data), pad)
+    sp, reset = struct.unpack_from("<II", data)
+    assert sp == 0x10000000 + pad, (image, sp)
+    elf = image.with_suffix(".elf")
+    if not elf.exists():
+        elf = image.parent.parent / elf.name  # Meson >=1.10 apple/ subdirectory
+    nm = subprocess.check_output(["llvm-nm", str(elf)], text=True)
+    start = next(int(line.split()[0], 16) for line in nm.splitlines() if line.endswith(" T _start"))
+    assert reset == start | 1, (image, hex(reset), hex(start))
+    assert reset < pad and reset & 1
+    print(f"{image.stem}: size={len(data):#x} SP={sp:#x} reset={reset:#x}")
+if len(sys.argv) < 2:
+    raise SystemExit("usage: check-images.py build/avd-fw-*.bin")
diff --git a/tests/queue-test.c b/tests/queue-test.c
new file mode 100644
index 0000000..7aad65f
--- /dev/null
+++ b/tests/queue-test.c
@@ -0,0 +1,227 @@
+/* SPDX-License-Identifier: MIT */
+#include <assert.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include "queue.h"
+
+struct fake {
+	unsigned int feeds, kicks, completions, blocked, fail;
+	uint32_t tags[64], statuses[64], words[64];
+};
+static int feed(void *cookie, struct avdq_frame *f)
+{
+	struct fake *io = cookie;
+	io->feeds++;
+	if (io->fail)
+		return -1;
+	if (io->blocked)
+		return 0;
+	f->pushed++;
+	return f->pushed == f->desc.program_words;
+}
+static void kick(void *cookie, uint32_t word)
+{
+	struct fake *io = cookie;
+	io->words[io->kicks++] = word;
+}
+static int complete(void *cookie, unsigned int idx, const struct avdq_frame *f)
+{
+	struct fake *io = cookie;
+	assert(idx < AVDQ_COUNT);
+	if (io->blocked)
+		return 0;
+	io->tags[io->completions] = f->desc.tag;
+	io->statuses[io->completions++] = f->status;
+	return 1;
+}
+static const struct avdq_ops ops = { feed, kick, complete };
+static struct avdq_desc descriptor(unsigned int tag, unsigned int vp)
+{
+	struct avdq_desc d = {0};
+	d.magic = AVDQ_MAGIC;
+	d.tag = tag;
+	d.codec = AVDQ_HEVC;
+	d.vp_slot = vp;
+	d.program_lo = 0x4000;
+	d.program_hi = 1; /* exercise a program above 4 GiB */
+	d.program_words = 1;
+	d.pp_kick = 0x2b000400u | (tag & 15u) << 4;
+	d.state = AVDQ_SUBMITTED;
+	return d;
+}
+static void step(struct avdq *q, struct fake *io)
+{
+	avdq_step(q, &ops, io);
+}
+static void wire(void)
+{
+	unsigned int i;
+	assert(offsetof(struct avdq_desc, program_lo) == 0x10);
+	assert(offsetof(struct avdq_desc, state) == 0x20);
+	assert(offsetof(struct avdq_desc, completion_tag) == 0x28);
+	for (i = 0; i < 16; i++) {
+		assert(avdq_index(0x1098000u + i * 64, 0x1098000u) == (int)i);
+		assert(avdq_index(0x1098001u + i * 64, 0x1098000u) < 0);
+	}
+	assert(avdq_index(0x1097fffu, 0x1098000u) < 0);
+	assert(avdq_index(0x1098400u, 0x1098000u) < 0);
+	assert(avdq_index(0xffffffffu, 0x1098000u) < 0);
+	assert(avdq_notification(0x12345678u, 8) == 0x54535678u);
+	assert(avdq_notification(0xffffffffu, 15) == 0x5453ffffu);
+	assert(avdq_notification(0xffffffffu, 15) != AVDQ_FATAL);
+	assert(avdq_dma_command(1) == 0x91);
+	assert(avdq_dma_command(256) == 0x4051);
+	for (i = 0; i < 0x20000; i += 4) {
+		uint32_t h = avdq_packet_header(i);
+		/* Destination decode from the MIT public emulator. */
+		uint32_t x = h & ~0x3fd0001u;
+		assert(((x & 0x1ffffu) | ((x & 0x20000u) >> 1)) == i);
+	}
+}
+static void invalid(void)
+{
+	unsigned int n;
+	for (n = 0; n < 13; n++) {
+		struct avdq q;
+		struct fake io = {0};
+		struct avdq_desc d = descriptor(0x100, 0);
+		avdq_init(&q);
+		switch (n) {
+		case 0: d.magic = 0; break;
+		case 1: d.tag++; break;
+		case 2: d.state = AVDQ_COMPLETE; break;
+		case 3: d.codec = 32; break;
+		case 4: d.codec = AVDQ_AV1; break;
+		case 5: d.vp_slot = 9; break;
+		case 6: d.program_lo = d.program_hi = 0; break;
+		case 7: d.program_lo++; break;
+		case 8: d.program_words = 0; break;
+		case 9: d.program_words = AVDQ_MAX_WORDS + 1; break;
+		case 10: d.program_lo = 0xfffffffcu; d.program_hi = 0xffffffffu; break;
+		case 11: d.pp_kick = 0; break;
+		case 12: d.reserved[4] = 1; break;
+		}
+		assert(!avdq_submit(&q, 0, &d, 9, 7));
+		assert(q.frame[0].phase == AVDQ_DONE);
+		/* Tag mismatch also gets echoed without masking the full generation. */
+		io.blocked = 1;
+		step(&q, &io);
+		assert(q.count == 1 && io.completions == 0 && io.feeds == 0);
+		io.blocked = 0; step(&q, &io);
+		assert(!q.count && io.completions == 1);
+		assert(io.tags[0] == d.tag && io.statuses[0] == AVDQ_INVALID);
+		avdq_init(&q);
+	}
+}
+static void pipeline(void)
+{
+	struct avdq q;
+	struct fake io = {0};
+	struct avdq_desc a = descriptor(0x12340000, 0);
+	struct avdq_desc b = descriptor(0x56780001, 0);
+	struct avdq_desc c = descriptor(0xabcd0002, 1);
+	avdq_init(&q);
+	assert(!avdq_submit(&q, 0, &a, 12, 15));
+	assert(!avdq_submit(&q, 1, &b, 12, 15));
+	assert(!avdq_submit(&q, 2, &c, 12, 15));
+	assert(avdq_submit(&q, 0, &b, 12, 15) == -1);
+	step(&q, &io); step(&q, &io); step(&q, &io);
+	assert(q.frame[0].phase == AVDQ_VP && q.frame[1].phase == AVDQ_VP);
+	assert(io.feeds == 3 && !io.kicks && !io.completions);
+	/* Different VP can finish first; PP runs once at a time. */
+	avdq_vp_done(&q, 1); step(&q, &io);
+	assert(io.kicks == 1 && io.words[0] == c.pp_kick);
+	avdq_vp_done(&q, 0); avdq_vp_done(&q, 0); step(&q, &io);
+	assert(io.kicks == 1 && q.frame[1].phase == AVDQ_PP_READY);
+	avdq_pp_done(&q); step(&q, &io);
+	assert(io.kicks == 2 && io.words[1] == a.pp_kick && !io.completions);
+	avdq_pp_done(&q);
+	io.blocked = 1; step(&q, &io);
+	assert(q.count == 3 && !io.completions && io.kicks == 3);
+	io.blocked = 0; step(&q, &io);
+	avdq_pp_done(&q); step(&q, &io); step(&q, &io);
+	assert(!q.count && io.completions == 3);
+	assert(io.tags[0] == a.tag && io.tags[1] == b.tag && io.tags[2] == c.tag);
+	assert(!io.statuses[0] && !io.statuses[1] && !io.statuses[2]);
+}
+static void wrap_and_full(void)
+{
+	struct avdq q;
+	struct fake io = {0};
+	unsigned int round, i;
+	avdq_init(&q);
+	for (round = 0; round < 3; round++) {
+		for (i = 0; i < 16; i++) {
+			struct avdq_desc d = descriptor((round << 28) | i, 0);
+			assert(!avdq_submit(&q, i, &d, 12, 15));
+		}
+		assert(q.count == 16);
+		assert(avdq_submit(&q, 16, &q.frame[0].desc, 12, 15) == -1);
+		for (i = 0; i < 16; i++) step(&q, &io);
+		for (i = 0; i < 16; i++) {
+			avdq_vp_done(&q, 0); step(&q, &io);
+			avdq_pp_done(&q); step(&q, &io);
+		}
+		assert(q.count == 0 && q.head == 0 && !q.halted);
+	}
+	assert(io.completions == 48);
+	assert(io.tags[32] == 0x20000000);
+}
+static void partial_program(void)
+{
+	struct avdq q;
+	struct fake io = {0};
+	struct avdq_desc a = descriptor(0, 0), b = descriptor(1, 1);
+	unsigned int i;
+	a.program_words = 513;
+	avdq_init(&q);
+	avdq_submit(&q, 0, &a, 12, 15); avdq_submit(&q, 1, &b, 12, 15);
+	io.blocked = 1; step(&q, &io);
+	assert(q.frame[0].pushed == 0 && q.frame[1].phase == AVDQ_PENDING);
+	io.blocked = 0;
+	for (i = 0; i < 512; i++) step(&q, &io);
+	assert(q.frame[0].phase == AVDQ_PUSH && !q.frame[1].pushed);
+	step(&q, &io);
+	assert(q.frame[0].phase == AVDQ_VP && !q.frame[1].pushed);
+	step(&q, &io);
+	assert(q.frame[1].phase == AVDQ_VP && q.frame[0].pushed == 513);
+}
+static void arbitrary_indices(void)
+{
+	struct avdq q;
+	struct fake io = {0};
+	struct avdq_desc a = descriptor(0x1007, 0), b = descriptor(0x2003, 0);
+	avdq_init(&q);
+	assert(!avdq_submit(&q, 7, &a, 12, 15));
+	assert(!avdq_submit(&q, 3, &b, 12, 15));
+	step(&q, &io); step(&q, &io);
+	avdq_vp_done(&q, 0); step(&q, &io); avdq_pp_done(&q); step(&q, &io);
+	avdq_vp_done(&q, 0); step(&q, &io); avdq_pp_done(&q); step(&q, &io);
+	assert(io.completions == 2 && io.tags[0] == a.tag && io.tags[1] == b.tag);
+}
+static void errors(void)
+{
+	struct avdq q;
+	struct fake io = {0};
+	struct avdq_desc a = descriptor(0, 0), b = descriptor(1, 1);
+	avdq_init(&q);
+	avdq_submit(&q, 0, &a, 12, 15); avdq_submit(&q, 1, &b, 12, 15);
+	io.fail = 1; step(&q, &io);
+	assert(q.halted && q.count == 2);
+	step(&q, &io); step(&q, &io);
+	assert(!q.count && io.statuses[0] == AVDQ_IO && io.statuses[1] == AVDQ_IO);
+	assert(avdq_submit(&q, 0, &a, 12, 15) == -1);
+	avdq_vp_done(&q, 0); avdq_pp_done(&q); /* late events after a fault */
+	assert(!io.kicks);
+	avdq_init(&q);
+	avdq_pp_done(&q); assert(q.halted);
+	avdq_init(&q);
+	avdq_vp_done(&q, 0); assert(q.halted);
+}
+int main(void)
+{
+	wire(); invalid(); pipeline(); wrap_and_full(); partial_program(); arbitrary_indices(); errors();
+	puts("queue: wire, validation, pipeline, backpressure, wrap, tags, errors passed");
+	return 0;
+}
diff --git a/tests/transport-test.py b/tests/transport-test.py
new file mode 100644
index 0000000..5c66f3b
--- /dev/null
+++ b/tests/transport-test.py
@@ -0,0 +1,205 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Run built CM3 transport code against a synthetic MMIO/PIODMA model.
+
+Requires the optional `unicorn` Python package and llvm-nm on PATH.
+This checks software integration, not silicon register semantics.
+"""
+import pathlib
+import struct
+import subprocess
+import sys
+
+from unicorn import Uc, UC_ARCH_ARM, UC_MODE_THUMB, UC_MODE_MCLASS
+from unicorn import UC_HOOK_MEM_READ, UC_HOOK_MEM_WRITE
+from unicorn.arm_const import UC_ARM_REG_R0, UC_ARM_REG_R1, UC_ARM_REG_SP, UC_ARM_REG_LR, UC_ARM_REG_PC
+
+
+class Transport:
+    def __init__(self, image):
+        self.uc = Uc(UC_ARCH_ARM, UC_MODE_THUMB | UC_MODE_MCLASS)
+        self.uc.mem_map(0, 0x20000)
+        self.uc.mem_map(0x10000000, 0x20000)
+        self.uc.mem_map(0x40000000, 0x200000)
+        self.uc.mem_map(0x41000000, 0x200000)
+        self.uc.mem_map(0x50010000, 0x4000)
+        self.uc.mem_map(0xe000e000, 0x2000)
+        self.uc.mem_write(0, image.read_bytes())
+        elf = image.with_suffix(".elf")
+        if not elf.exists():
+            elf = image.parent.parent / elf.name
+        nm = subprocess.check_output(["llvm-nm", str(elf)], text=True)
+        self.symbol = {name: int(addr, 16) for addr, kind, name in
+                       (line.split() for line in nm.splitlines() if len(line.split()) == 3)}
+        self.version, self.tier = map(int, image.stem.removeprefix("avd-fw-v").split("-t"))
+        self.decode = 0x40100000 if self.version <= 3 else 0x41100000
+        self.dma = 0x40070000 if self.version <= 3 else 0x41070000
+        self.fifo = 0x4004 if self.version == 2 else 0xc
+        self.pp = 0x4014 if self.version == 2 else 0x30 if self.version == 3 else 0x40
+        self.maximum = 0x4018 if self.version == 2 else 0x34 if self.version == 3 else 0x44
+        self.current = 0x402c if self.version == 2 else 0x5c if self.version == 3 else 0x7c
+        self.vps = 4 if self.version == 2 else 9 if self.version == 3 else 12
+        self.pp_idx = 4 if self.version == 2 else 9 if self.version == 3 else 13
+        self.packets = {}
+        self.stores, self.kicks, self.notifications, self.fetches = [], [], [], []
+        self.busy, self.full, self.dma_ticks, self.dma_timeout = False, False, 0, False
+        self.clear = set()
+        self.uc.hook_add(UC_HOOK_MEM_READ, self.read)
+        self.uc.hook_add(UC_HOOK_MEM_WRITE, self.write)
+        self.call("avdq_fw_init")
+        self.info = [self.u32(0x10007fc0 + i * 4) for i in range(10)]
+        assert self.info[:4] == [0x41565131, 1, 16, 64]
+        expected = 0x0108c000 if self.version == 2 else 0x01090000 if self.version == 3 or (self.version == 5 and self.tier == 0) else 0x01092000
+        assert self.info[4] == expected and self.info[8] == self.vps
+        self.ring = self.info[4] + self.info[5]
+
+    def u32(self, addr):
+        return struct.unpack("<I", self.uc.mem_read(addr, 4))[0]
+
+    def put(self, addr, value):
+        self.uc.mem_write(addr, struct.pack("<I", value))
+
+    def call(self, name, a=0, b=0):
+        self.uc.reg_write(UC_ARM_REG_SP, 0x1000b000)
+        self.uc.reg_write(UC_ARM_REG_R0, a)
+        self.uc.reg_write(UC_ARM_REG_R1, b)
+        self.uc.reg_write(UC_ARM_REG_LR, 0x1f001)
+        self.uc.emu_start(self.symbol[name] | 1, 0x1f000, count=1000000)
+        assert self.uc.reg_read(UC_ARM_REG_PC) == 0x1f000, name + " did not return"
+        return self.uc.reg_read(UC_ARM_REG_R0)
+
+    def read(self, uc, access, addr, size, value, user):
+        if addr in self.clear:
+            self.put(addr, 0)
+            self.clear.remove(addr)
+        if addr == 0x5001005c:
+            self.put(addr, 0 if self.busy else 4)
+        if self.decode + self.maximum <= addr < self.decode + self.maximum + self.vps * 4:
+            self.put(addr, 256)
+        if self.decode + self.current <= addr < self.decode + self.current + self.vps * 4:
+            self.put(addr, 256 if self.full else 0)
+        if addr == self.dma + 4:
+            if self.dma_timeout:
+                self.put(addr, 0)
+            elif self.dma_ticks:
+                self.dma_ticks -= 1
+                self.put(addr, int(self.dma_ticks == 0))
+
+    def write(self, uc, access, addr, size, value, user):
+        if addr == self.dma + 0x54:
+            source = self.u32(self.dma + 0x4c) | self.u32(self.dma + 0x50) << 32
+            header, payload = self.packets[source]
+            assert header == self.info[7]
+            assert value == ((len(payload) + 1) << 6) | 0x11
+            self.fetches.append(source)
+            self.uc.mem_write(0x10009000, struct.pack("<" + "I" * len(payload), *payload))
+            self.dma_ticks = 3
+            self.put(self.dma + 4, 0)
+        if self.decode + self.fifo <= addr < self.decode + self.fifo + self.vps * 4:
+            self.stores.append(value)
+        if addr == self.decode + self.pp:
+            self.kicks.append(value)
+        if addr == 0x50010060:
+            assert not self.busy, "unread notification overwritten"
+            self.busy = True
+            self.notifications.append(value)
+        # irq_clear() writes W1C decode status then waits for the ack.
+        status = self.decode + (0x4060 if self.version == 2 else 0x124 if self.version == 3 else 0x194)
+        if status <= addr <= status + 13 * 4:
+            self.clear.add(addr)
+
+    def submit(self, idx, tag, words, vp=0):
+        source = 0x100004000 + idx * 0x10000
+        for p in range((len(words) + 255) // 256):
+            self.packets[source + p * 1028] = (self.info[7], words[p * 256:(p + 1) * 256])
+        desc = [0x41565131, tag, 0, vp, source & 0xffffffff, source >> 32,
+                len(words), 0x2b000400 | idx << 4, 1, 0, 0, 0, 0, 0, 0, 0]
+        self.uc.mem_write(0x10008000 + idx * 64, struct.pack("<16I", *desc))
+        # Exercise the actual mailbox IRQ wrapper and interrupt acknowledgement.
+        self.put(0x50010058, self.ring + idx * 64)
+        self.call("irq1")
+
+    def poll(self, n=1):
+        for _ in range(n):
+            self.call("avdq_fw_poll")
+
+    def vp_done(self):
+        self.call("irq20" if self.version == 2 else "irq80")
+
+    def pp_done(self):
+        self.call("irq40" if self.version == 2 else "irq64")
+
+    def result(self, idx):
+        return [self.u32(0x10008000 + idx * 64 + off) for off in (0x20, 0x24, 0x28)]
+
+
+def check(image):
+    t = Transport(image)
+    # Legacy outputs before the first queue doorbell are unchanged.
+    t.vp_done()
+    assert t.notifications == [0x100]
+    t.busy = False
+    t.pp_done()
+    assert t.notifications[-1] == 0x1000
+    t.busy = False
+    t.notifications.clear()
+    words = list(range(513))
+    t.submit(0, 0xabcd0000, words)
+    t.submit(1, 0x12340001, [0xfeed])
+    t.full = True
+    t.poll(20)
+    assert not t.stores and len(t.fetches) == 1
+    t.full = False
+    t.poll(550)
+    assert t.stores == words + [0xfeed]
+    assert len(t.fetches) == 4 and not t.kicks and not t.notifications
+    t.vp_done(); t.poll()
+    assert t.kicks == [0x2b000400] and not t.notifications
+    t.vp_done(); t.poll()
+    assert len(t.kicks) == 1
+    t.pp_done(); t.poll()
+    assert t.result(0) == [2, 0, 0xabcd0000]
+    assert t.notifications == [0x54530000]
+    assert t.kicks == [0x2b000400, 0x2b000410]
+    t.pp_done(); t.poll(5)
+    assert t.result(1)[0] == 1 and len(t.notifications) == 1
+    t.busy = False; t.poll()
+    assert t.result(1) == [2, 0, 0x12340001]
+    assert t.notifications == [0x54530000, 0x54530001]
+    # Exercise slot reuse with a different full generation and max u32 tag.
+    t.busy = False
+    t.submit(15, 0xffffffff, [123])
+    t.poll(8); t.vp_done(); t.poll(); t.pp_done(); t.poll()
+    assert t.result(15) == [2, 0, 0xffffffff]
+    assert t.notifications[-1] == 0x5453ffff
+    # Decode error halts all accepted work; late events cannot kick PP.
+    t = Transport(image)
+    t.submit(0, 0x20000, [1]); t.submit(1, 0x20001, [2]); t.poll(20)
+    t.call("irq19" if t.version == 2 else "irq79")
+    t.poll(); t.busy = False; t.poll()
+    assert t.result(0) == [2, 2, 0x20000] and t.result(1) == [2, 2, 0x20001]
+    t.vp_done(); t.poll()
+    assert not t.kicks
+    # A duplicate doorbell must not replace an in-flight tag; it poisons the
+    # queue and emits the separate fatal token after accepted errors drain.
+    t = Transport(image)
+    t.submit(0, 0x20000, [1]); t.poll(8)
+    t.put(0x50010058, t.ring); t.call("irq1")
+    t.poll(2)
+    assert t.result(0) == [2, 2, 0x20000]
+    t.busy = False; t.poll()
+    assert t.notifications[-1] == 0x5452ffff
+    # Explicit init is also sufficient after dirty SRAM (boot/reset path).
+    t.call("avdq_fw_init")
+    t.busy = False; t.notifications.clear()
+    t.submit(0, 0x30000, [3]); t.poll(8)
+    t.vp_done(); t.poll(); t.pp_done(); t.poll()
+    assert t.result(0) == [2, 0, 0x30000]
+    print(image.stem + ": legacy IRQs, 64-bit PIODMA, packets, FIFO pressure, VP->PP, outbox, tags, error/reset passed", flush=True)
+
+
+if __name__ == "__main__":
+    for arg in sys.argv[1:]:
+        check(pathlib.Path(arg))
+    if len(sys.argv) < 2:
+        raise SystemExit("usage: transport-test.py build/avd-fw-*.bin")
