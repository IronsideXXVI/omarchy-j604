From 220b1e70c9d7dcccbf66d5194e372300aa3c5a32 Mon Sep 17 00:00:00 2001
From: Neal Gompa <neal@asahilinux.org>
Date: Fri, 18 Sep 2026 15:47:57 -0400
Subject: [PATCH 01/15] meson: Fix the install path for the firmware directory

Linux mandates that the firmware is installed into a subdirectory
of /usr/lib/firmware. This was incorrectly installing into the
nonexistent /usr/lib64/firmware, which is not a valid path.

With this, we no longer need the path workarounds in the meson
cross-toolchain definition files, so drop those too.

Signed-off-by: Neal Gompa <neal@asahilinux.org>
---
 arm-none-eabi-gcc.ini | 3 ---
 llvm.ini              | 3 ---
 meson.build           | 2 +-
 meson.options         | 2 +-
 4 files changed, 2 insertions(+), 8 deletions(-)

diff --git a/arm-none-eabi-gcc.ini b/arm-none-eabi-gcc.ini
index 7133ca5..8c9a298 100644
--- a/arm-none-eabi-gcc.ini
+++ b/arm-none-eabi-gcc.ini
@@ -8,6 +8,3 @@ system     = 'none'
 cpu_family = 'arm'
 cpu        = 'cortex-m3'
 endian     = 'little'
-
-[built-in options]
-libdir = 'lib'
diff --git a/llvm.ini b/llvm.ini
index e6e5ae6..6cc9bdd 100644
--- a/llvm.ini
+++ b/llvm.ini
@@ -7,6 +7,3 @@ system     = 'none'
 cpu_family = 'arm'
 cpu        = 'cortex-m3'
 endian     = 'little'
-
-[built-in options]
-libdir = 'lib'
diff --git a/meson.build b/meson.build
index be2dd42..84a1284 100644
--- a/meson.build
+++ b/meson.build
@@ -15,7 +15,7 @@ if meson.get_compiler('c').get_id() == 'clang'
     add_project_link_arguments('--target=arm-none-eabi', language : 'c')
 endif
 
-install_dir = get_option('libdir') / get_option('firmwaredir') / 'apple'
+install_dir = get_option('prefix') / 'lib' / get_option('firmwaredir') / 'apple'
 
 objcopy = find_program('llvm-objcopy')
 
diff --git a/meson.options b/meson.options
index 7c85365..c800ff0 100644
--- a/meson.options
+++ b/meson.options
@@ -1 +1 @@
-option('firmwaredir', type : 'string', value : 'firmware', description : 'Firmware install path in $libdir')
+option('firmwaredir', type : 'string', value : 'firmware', description : 'Firmware install path in $prefix/lib')
-- 
2.43.0

