+		/* Re-publication must clear the old ACK before waiting on a wrap. */
+		slots[cursor].arg0 = chan->req.arg0;
+		KUNIT_ASSERT_FALSE(test, chan_tx_done(t->isp, chan));
+		KUNIT_ASSERT_EQ(test, chan->cursor, cursor);
