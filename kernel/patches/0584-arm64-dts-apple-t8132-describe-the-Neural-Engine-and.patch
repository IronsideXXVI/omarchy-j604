From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 03:29:13 +0000
Subject: [PATCH] arm64: dts: apple: t8132: describe the Neural Engine and its
 DARTs

Add the T8132 Neural Engine and its three DARTs from the J604 runtime ADT
(/arm-io/ane, /arm-io/dart-ane):

  ane        six windows (engine 0x500000000 +0x2000000, PMGR
             0x380700000 +0x18000, 0x380724000 +0x4000, 0x3803c0000
             +0x30000, 0x211000000 +0xff4000, 0x3882c8000 +0x4000),
             ane-type 0x100, pre-loaded TEXT/DATA at device addresses
             0x10000000000 / 0x100000c0000, interrupts 629 and 642
  dart-ane   DART0 0x501800000, DART1 0x501820000, DART2 0x501840000
             (+0xc000 each), one interrupt 630, sids 0/0xa/0xb/0xf,
             DAPF bank at DART0 + 0x10000, five dapf-instance-0 records

The engine's channel interrupt is taken as 629, the one next to the
DART's, which is how the T6041 pairs them (1054 / 1055); the second
interrupt (642) is not described (TO-VERIFY on the machine). Like the
T6041 node, only stream 0 is given to the host and each DART takes the
whole firmware window below 0x40000000000. The DAPF ranges are the five
dapf-instance-0 records of the J604 ADT, inclusive, in record order.
The power domains are the five ANE states the ADT lists (ANE_SYS +0x570,
ANE_CPU, ANE_MPM, ANE_TD, ANE_BASE).

Every node is "disabled" and the ANE power states stay disabled in the
board PMGR files. The boot loader has to add the preload reservations
(memory-region) before the node can bind.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 74 ++++++++++++++++++++++++++++
 1 file changed, 74 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index a5cb0fbfba..d685fae157 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -678,6 +678,80 @@
 			};
 		};
 
+		/*
+		 * Neural Engine (H16): J604 runtime ADT /arm-io/ane ("ane,t8020",
+		 * ane-type 0x100, pre-loaded __TEXT 0xc0000 / __DATA 0x2ac000 at
+		 * DVA 0x10000000000 / 0x100000c0000) and /arm-io/dart-ane (three
+		 * DART instances at 0x501800000/0x501820000/0x501840000, one
+		 * interrupt, the DAPF bank at DART0 + 0x10000, five dapf-instance-0
+		 * records). The boot loader supplies the preload reservations.
+		 * The channel interrupt is the one next to the DART's, as on the
+		 * T6041 (1054 / 1055).
+		 */
+		ane: ane@500000000 {
+			compatible = "apple,t8132-ane";
+			reg = <0x5 0x00000000 0x0 0x2000000>,
+			      <0x3 0x80700000 0x0 0x18000>,
+			      <0x3 0x80724000 0x0 0x4000>,
+			      <0x3 0x803c0000 0x0 0x30000>,
+			      <0x2 0x11000000 0x0 0xff4000>,
+			      <0x3 0x882c8000 0x0 0x4000>;
+			reg-names = "engine", "pmgr", "aux-0", "aux-1", "aux-2",
+				    "aux-4";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 629 IRQ_TYPE_LEVEL_HIGH>;
+			/* Stream 0 only: the MPM stream 11 is not given to the host. */
+			iommus = <&ane_dart0 0>, <&ane_dart1 0>, <&ane_dart2 0>;
+			power-domains = <&ps_ane_sys>, <&ps_ane_cpu>, <&ps_ane_mpm>,
+					<&ps_ane_td>, <&ps_ane_base>;
+			apple,ane-type = <0x100>;
+			apple,firmware-preloaded;
+			/* Inclusive DAPF bounds, in ADT dapf-instance-0 record order. */
+			apple,dapf-ranges = /bits/ 64 <0x48d668000 0x48d668003>,
+					    /bits/ 64 <0x38070c000 0x38070c01b>,
+					    /bits/ 64 <0x380700570 0x380700573>,
+					    /bits/ 64 <0x3807273cc 0x3807273cf>,
+					    /bits/ 64 <0x302668000 0x302668003>;
+			apple,firmware-iovas = /bits/ 64 <0x10000000000 0x100000c0000>;
+			status = "disabled";
+		};
+
+		ane_dart0: iommu@501800000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x5 0x01800000 0x0 0xc000>;
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 630 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_ane_sys>;
+			/* Include firmware identity MMIO pages below the preload DVAs. */
+			apple,dma-range = <0x0 0x0 0x400 0x0>;
+			status = "disabled";
+		};
+
+		ane_dart1: iommu@501820000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x5 0x01820000 0x0 0xc000>;
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 630 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_ane_sys>;
+			/* Include firmware identity MMIO pages below the preload DVAs. */
+			apple,dma-range = <0x0 0x0 0x400 0x0>;
+			status = "disabled";
+		};
+
+		ane_dart2: iommu@501840000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x5 0x01840000 0x0 0xc000>;
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 630 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_ane_sys>;
+			/* Include firmware identity MMIO pages below the preload DVAs. */
+			apple,dma-range = <0x0 0x0 0x400 0x0>;
+			status = "disabled";
+		};
+
 		/*
 		 * JPEG engines: J604 runtime ADT jpeg0/jpeg1 (hw-type 100008, the
 		 * T6041 revision) and dart-jpeg0/1 (sid 0, vm-base 0x10000000000,
