From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Sun, 8 Nov 2026 14:13:01 +0100
Subject: [PATCH] media: apple: isp: Set the J714c lens shading target
 and scene metering

macOS's appleh16camerad sets the IMX958's lens shading ideal percent to
84 before loading its setfile (CH_LSC_IDEAL_PERCENT_SET, 0x0a4e), and
sends the face-detection scene metering setup that this driver skips
on H17 firmware. The T6050 firmware takes both. Add the command, and
make the percent and the scene metering T6050 hardware data.

[Dylan: carried onto the J604 tree; the T6050 hardware lines are left out]
Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
[dylan: one co-author trailer of the original message is not reproduced here]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/media/platform/apple/isp/isp-cam.c | 11 +++++++++--
 drivers/media/platform/apple/isp/isp-cmd.c | 11 +++++++++++
 drivers/media/platform/apple/isp/isp-cmd.h | 12 ++++++++++++
 drivers/media/platform/apple/isp/isp-drv.h |  4 ++++
 4 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 7492346b4b..4d5bb55ac8 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -1105,6 +1105,13 @@ static int isp_ch_load_setfile(struct apple_isp *isp, u32 ch)
 	if (isp->hw->setfile_radial_gain)
 		isp_setfile_radial_gain(isp->data_surf->virt, len);
 
+	if (isp->hw->lsc_ideal_percent) {
+		err = isp_cmd_ch_lsc_ideal_percent_set(isp, ch,
+						       isp->hw->lsc_ideal_percent);
+		if (err)
+			return err;
+	}
+
 	err = isp_cmd_ch_set_file_load(isp, ch, isp->data_surf->iova,
 				       setfile->size);
 	if (err)
@@ -1342,8 +1349,8 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	if (err)
 		return err;
 
-	/* The H17 firmware faults on this face-detection metering setup. */
-	if (!h17) {
+	/* Most H17 firmware faults on this face-detection metering setup. */
+	if (!h17 || isp->hw->ae_fd_scene_metering) {
 		err = isp_cmd_apple_ch_ae_fd_scene_metering_config_set(isp,
 								       ch);
 		if (err)
diff --git a/drivers/media/platform/apple/isp/isp-cmd.c b/drivers/media/platform/apple/isp/isp-cmd.c
index a1a5557111..4dc706aad6 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.c
+++ b/drivers/media/platform/apple/isp/isp-cmd.c
@@ -772,6 +772,17 @@ int isp_cmd_apple_ch_ae_metering_mode_set(struct apple_isp *isp, u32 chan,
 	return CISP_SEND_IN(isp, args);
 }
 
+int isp_cmd_ch_lsc_ideal_percent_set(struct apple_isp *isp, u32 chan,
+				     u16 percent)
+{
+	struct cmd_ch_lsc_ideal_percent_set args = {
+		.opcode = CISP_OPCODE(CISP_CMD_CH_LSC_IDEAL_PERCENT_SET),
+		.chan = chan,
+		.percent = percent,
+	};
+	return CISP_SEND_IN(isp, args);
+}
+
 int isp_cmd_apple_ch_ae_flicker_freq_update_current_set(struct apple_isp *isp,
 							u32 chan, u32 freq)
 {
diff --git a/drivers/media/platform/apple/isp/isp-cmd.h b/drivers/media/platform/apple/isp/isp-cmd.h
index ab98f3447d..6511b625c5 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.h
+++ b/drivers/media/platform/apple/isp/isp-cmd.h
@@ -70,6 +70,7 @@
 #define CISP_CMD_CH_ALS_DISABLE				     0x0a1d
 #define CISP_CMD_CH_CNR_START				     0x0a2f
 #define CISP_CMD_CH_MBNR_ENABLE				     0x0a3a
+#define CISP_CMD_CH_LSC_IDEAL_PERCENT_SET		     0x0a4e
 #define CISP_CMD_CH_OUTPUT_CONFIG_SET			     0x0b01
 #define CISP_CMD_CH_OUTPUT_CONFIG_SCL1_SET		     0x0b09
 #define CISP_CMD_CH_PREVIEW_STREAM_SET			     0x0b0d
@@ -782,6 +783,15 @@ struct cmd_apple_ch_ae_fd_scene_metering_config_set {
 static_assert(sizeof(struct cmd_apple_ch_ae_fd_scene_metering_config_set) ==
 	      0x24);
 
+/* The lens shading falloff the firmware corrects to, in percent at the corner */
+struct cmd_ch_lsc_ideal_percent_set {
+	u64 opcode;
+	u32 chan;
+	u16 percent;
+	u16 pad;
+} __packed;
+static_assert(sizeof(struct cmd_ch_lsc_ideal_percent_set) == 0x10);
+
 struct cmd_apple_ch_ae_metering_mode_set {
 	u64 opcode;
 	u32 chan;
@@ -810,6 +820,8 @@ int isp_cmd_apple_ch_ae_fd_scene_metering_config_set(struct apple_isp *isp,
 						     u32 chan);
 int isp_cmd_apple_ch_ae_metering_mode_set(struct apple_isp *isp, u32 chan,
 					  u32 mode);
+int isp_cmd_ch_lsc_ideal_percent_set(struct apple_isp *isp, u32 chan,
+				     u16 percent);
 int isp_cmd_apple_ch_ae_flicker_freq_update_current_set(struct apple_isp *isp,
 							u32 chan, u32 freq);
 
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index ed6d59f90d..2fe091c88d 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -286,6 +286,10 @@ struct apple_isp_hw {
 	bool setfile_stride_fixup;
 	/* Compute the setfile's noise reduction radial gains from its lens shading */
 	bool setfile_radial_gain;
+	/* The lens shading falloff to correct to, in percent at the corner (0: unset) */
+	u16 lsc_ideal_percent;
+	/* H17 firmware that takes the face-detection scene metering setup */
+	bool ae_fd_scene_metering;
 };
 
 enum isp_sensor_id {
-- 
2.43.0

