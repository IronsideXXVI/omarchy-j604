From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 03:07:41 +0000
Subject: [PATCH] j604: lab: drop the speaker enables now in the J604
 tree

The lab include enabled the J604's speaker card and six amps over the
board tree, which kept them disabled. The board tree enables them now,
so these overrides only repeat it. The built device tree is the same
apart from the explicit "okay" status lines.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 9 ---------
 1 file changed, 9 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index 14e63d49d4..6fb12d798c 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -43,15 +43,6 @@ aliases {
 	};
 };
 
-/* The speaker amps and the sound card, gated as on 1.617 (macaudio + tas2764 safety chain). */
-&{/soc/i2c@3ad01c000/codec@38} { status = "okay"; };
-&{/soc/i2c@3ad01c000/codec@39} { status = "okay"; };
-&{/soc/i2c@3ad01c000/codec@3a} { status = "okay"; };
-&{/soc/i2c@3ad01c000/codec@3b} { status = "okay"; };
-&{/soc/i2c@3ad01c000/codec@3c} { status = "okay"; };
-&{/soc/i2c@3ad01c000/codec@3d} { status = "okay"; };
-&{/sound} { status = "okay"; };
-
 /* The boot framebuffer keeps no power domains (1.617: drop them, the DCP owns the display). */
 &{/chosen/framebuffer@0} { /delete-property/ power-domains; };
 
-- 
