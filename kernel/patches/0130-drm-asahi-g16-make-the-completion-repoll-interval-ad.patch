From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 9 Nov 2026 23:59:41 +0000
Subject: [PATCH] drm/asahi: g16: make the completion repoll interval
 adjustable at runtime

While a command is published the G16 backend re-polls for its completion
every g16_resnap_us (100 us), after up to four 5 us polls that follow each
firmware event. g16_resnap_us is a boot-only parameter.

On the J604 a render command under desktop load retired about 190 us after
its last firmware event. With one command in flight at a time, that delay
is added to every command, so it has to be measurable and tunable without
rebuilding or rebooting.

Add g16_resnap_live_us (0644, default 0). When it is nonzero it replaces
g16_resnap_us, clamped to 10..1000 us; 0 keeps the boot-time value, so the
default behaviour does not change.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit c9033a1c3300e92947f05977671319f689c6b987)
---
 drivers/gpu/drm/asahi/g16/params.rs | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index f658599125..69ba4dd743 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -37,11 +37,18 @@ pub(crate) fn repoll_us() -> u32 {
     module_parameters::g16_repoll_us.value().clamp(5, 100)
 }
 
-/// Completion repoll interval, us.
+/// Completion repoll interval, us: `g16_resnap_live_us` when set (10..=1000), else the
+/// boot-time `g16_resnap_us` (25..=1000).
 pub(crate) fn resnap_us() -> u32 {
-    module_parameters::g16_resnap_us.value().clamp(25, 1000)
+    match RESNAP_LIVE_US.load(Ordering::Relaxed) {
+        0 => module_parameters::g16_resnap_us.value().clamp(25, 1000),
+        live => live.clamp(10, 1000),
+    }
 }
 
+/// Storage of `g16_resnap_live_us` (runtime 0644; 0 = use `g16_resnap_us`).
+static RESNAP_LIVE_US: AtomicU32 = AtomicU32::new(0);
+
 /// Whether firmware halts are answered with the handshake (else fail-stop).
 pub(crate) fn recovery() -> bool {
     module_parameters::g16_recovery.value() != 0
@@ -430,6 +437,15 @@ macro_rules! live_u32_param {
     "G16: post a render command's TA record before its FS record (default 1; runtime 0644; 0: FS first)"
 );
 
+live_u32_param!(
+    RESNAP_LIVE_PARAM,
+    RESNAP_LIVE_PARMTYPE,
+    RESNAP_LIVE_PARM,
+    RESNAP_LIVE_US,
+    "g16_resnap_live_us",
+    "G16: runtime completion repoll interval, us (default 0 = g16_resnap_us; 10..1000; runtime 0644)"
+);
+
 /// Fragment-only dependency publication has not been qualified on this backend.
 pub(crate) fn early_tiling() -> bool {
     false
-- 
