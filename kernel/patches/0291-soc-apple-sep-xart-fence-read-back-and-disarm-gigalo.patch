+/*
+ * Drops the clean cached pages of a store file, so that the next read of a
+ * range just written and flushed comes from the device rather than from the
+ * page cache. Pages still dirty, locked or mapped stay cached; callers flush
+ * first. Returns 0; the read-back that follows is the check.
+ */
+int sep_store_drop_cache(void *handle)
+{
+	struct file *f = handle;
+
+	invalidate_mapping_pages(f->f_mapping, 0, -1);
+	return 0;
+}
