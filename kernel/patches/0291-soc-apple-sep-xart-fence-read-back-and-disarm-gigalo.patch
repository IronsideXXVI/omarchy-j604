+        let mut store = open(&bytes, &faults, &writes, true)?;
+        faults.sync.set(true);
+        assert_eq!(store.write(&ROOT1, b"root one, next"), Err(EIO));
+        faults.sync.set(false);
+        assert!(!store.writes_enabled());
+        // Only the new slot was written; the old root's slot was not touched.
+        assert_eq!(writes.borrow().len(), 1);
+        assert_eq!(bytes.borrow()[BASE as usize + KEY_KIND], 1);
+        Ok(())
