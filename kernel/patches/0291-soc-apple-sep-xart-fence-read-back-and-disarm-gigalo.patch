+    #[test]
+    fn a_silently_corrupted_write_is_caught_and_taken_back() -> Result<()> {
+        let bytes = RefCell::new(image()?);
+        let before = copy(&bytes)?;
+        let (faults, writes) = (Faults::default(), RefCell::new(KVec::new()));
+        let mut store = open(&bytes, &faults, &writes, true)?;
+        faults.flip.set(true);
+        assert_eq!(store.write(&ROOT1, b"root one, next"), Err(EIO));
+        faults.flip.set(false);
+        assert!(!store.writes_enabled());
+        // The old record was not deleted: every live slot is as it was.
+        let at = |slot: usize| BASE as usize + slot * SLOT_SIZE;
+        assert!(before[at(0)..at(4)] == bytes.borrow()[at(0)..at(4)]);
+        // The bad slot's header was taken back.
+        assert_eq!(bytes.borrow()[at(4) + KEY_KIND], 0);
+        assert!(all_inside(&writes));
+        assert!(outside_unchanged(&before, &bytes.borrow()));
+        drop(store);
+        // The next boot finds the old record alone, and arms again.
+        let mut store = open(&bytes, &faults, &writes, true)?;
+        let (_, records, _, malformed, duplicates, _, writable) = store.summary();
+        assert_eq!((records, malformed, duplicates, writable), (4, 0, 0, true));
+        assert_eq!(value_of(&mut store, &ROOT1)?.as_deref(), Some(&b"root one"[..]));
+        Ok(())
+    }
