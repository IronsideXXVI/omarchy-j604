+        faults.torn.set(false);
+        assert!(!store.writes_enabled());
+        assert!(all_inside(&writes));
+        assert!(outside_unchanged(&before, &bytes.borrow()));
+        drop(store);
+        // The half-written slot is malformed: the next boot serves the old
+        // record but does not arm writes (Touch ID unavailable).
+        assert!(matches!(open(&bytes, &faults, &writes, true), Err(e) if e == EIO));
+        let mut store = open(&bytes, &faults, &writes, false)?;
+        assert_eq!(value_of(&mut store, &ROOT1)?.as_deref(), Some(&b"root one"[..]));
+        assert_eq!(value_of(&mut store, &MACOS_LOCKER)?.as_deref(), Some(&b"macOS locker"[..]));
