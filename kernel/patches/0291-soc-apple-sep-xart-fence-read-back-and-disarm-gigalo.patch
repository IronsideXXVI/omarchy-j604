+/// Whether the guard runs strict for `xart_strict=param` on a platform whose
+/// profile defaults to `platform`. A negative value takes the platform's
+/// choice; any other nonzero value turns it on.
+///
+/// Strict, the guard refuses every rewrite and delete of a session record
+/// that existed before Linux created it, with no window and no one-time
+/// allowance: Linux then never changes a record another OS made. Touch ID is
+/// unavailable wherever the enclave needs such a rewrite, and the record
+/// stays as it was. The shared roots still follow the level.
+pub(crate) fn strict(param: i8, platform: bool) -> bool {
+    choice(param, platform)
+}
+
+/// [j604] A yes/no module parameter whose default (-1) takes `platform`: 0 is
+/// no, any other value yes.
+pub(crate) fn choice(param: i8, platform: bool) -> bool {
+    match param {
+        p if p < 0 => platform,
+        0 => false,
+        _ => true,
+    }
+}
