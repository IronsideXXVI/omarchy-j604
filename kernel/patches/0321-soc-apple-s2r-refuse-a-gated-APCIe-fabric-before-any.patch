From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 19:36:40 +0000
Subject: [PATCH] soc: apple: s2r: refuse a gated APCIe fabric before
 any coprocessor stops

The T8132 lowering refuses when ANS's APCIe block is on with its own
fabric gated, but only once it reaches that step: in the real sequence
every coprocessor has been stopped by then, and a refusal returns to a
machine whose disk, display and GPU only a real sleep can bring back.

Read the same power state words in ->enter, before anything is told,
whenever the run will lower the block. Past the noirq phase nothing
changes them before the lowering. The check in the lowering stays as
the second line. A host test covers which runs lower the block.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/apple-s2r.c      | 26 ++++++++++++++++++++++++++
 tools/asahi/run-host-tests.py      |  3 ++-
 tools/asahi/s2r-split-ans-tests.py | 26 +++++++++++++++++++++++---
 3 files changed, 51 insertions(+), 4 deletions(-)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index ffc12afc3e..0306ee0450 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -646,6 +646,20 @@ static int apple_s2r_split_ans(unsigned int ab, unsigned int depth, unsigned int
 	return -EINVAL;
 }
 
+/*
+ * Whether this run lowers ANS's APCIe block: the real sequence always, a
+ * split step from depth 3 (0 is the whole lowering), unless ANS keeps running
+ * (@ans S2R_SPLIT_ANS_NOTICE).
+ */
+static bool apple_s2r_lowers_apcie(unsigned int ab, unsigned int depth, int ans)
+{
+	if (!ab)
+		return true;
+	if (ab != S2R_STEP_T8132_RAISE || ans == S2R_SPLIT_ANS_NOTICE)
+		return false;
+	return !depth || depth >= 3;
+}
+
 static const char *const apple_s2r_step_names[] = {
 	[S2R_STEP_NONE]		= "none",
 	[S2R_STEP_COPROCS]	= "coprocessor refusal",
@@ -3268,6 +3282,18 @@ static int apple_s2r_enter(suspend_state_t state)
 				READ_ONCE(split_ans), READ_ONCE(split_depth));
 			return -EINVAL;
 		}
+		/*
+		 * The lowering's fabric guard, read here first: past the noirq
+		 * phase nothing changes these words before the lowering, and
+		 * from the coprocessor stop on a refusal cannot be undone.
+		 */
+		if (apple_s2r_lowers_apcie(READ_ONCE(abort_before), READ_ONCE(split_depth),
+					   s2r->t8132.split_ans) &&
+		    apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_SYS_ST) &&
+		    !apple_s2r_t8132_apcie_fabric_on(s2r, true)) {
+			pr_warn("apple-s2r: T8132 sequence: ANS's APCIe block is on with its own fabric gated: refused\n");
+			return -EBUSY;
+		}
 	}
 
 	/*
diff --git a/tools/asahi/run-host-tests.py b/tools/asahi/run-host-tests.py
index dad9900ba8..40d7bf63ae 100755
--- a/tools/asahi/run-host-tests.py
+++ b/tools/asahi/run-host-tests.py
@@ -174,7 +174,8 @@ ASAHI_TESTS = {
     'qspi-nvram-tests.py': [(out('--output'), PASS)],
     's2r-split-ans-tests.py': [(out(), PASS)]
         + mutations('--mutation', ('notice-depth', 'depth-seven', 'depth-zero',
-                                   'not-split', 'mode-unknown'), out()),
+                                   'not-split', 'mode-unknown', 'lowers-real',
+                                   'lowers-notice', 'lowers-depth'), out()),
     'rtkit-crashlog-tests.py': [(out(), PASS)]
         + mutations('--mutation', ('buffer-header', 'section-header', 'section-size', 'footer-room',
                                    'mailbox-minimum', 'version-string', 'message-string'), out()),
diff --git a/tools/asahi/s2r-split-ans-tests.py b/tools/asahi/s2r-split-ans-tests.py
index ca65f0e8f8..667aed5b47 100755
--- a/tools/asahi/s2r-split-ans-tests.py
+++ b/tools/asahi/s2r-split-ans-tests.py
@@ -20,11 +20,15 @@ MUTATIONS = {
     'depth-zero': ('if (!depth || depth >= 7)', 'if (depth >= 7)'),
     'not-split': ('ab != S2R_STEP_T8132_RAISE', 'ab < S2R_STEP_T8132_WAKE'),
     'mode-unknown': ('\treturn -EINVAL;\n}', '\treturn S2R_SPLIT_ANS_STOP;\n}'),
+    'lowers-real': ('\tif (!ab)\n\t\treturn true;', '\tif (!ab)\n\t\treturn false;'),
+    'lowers-notice': ('ans == S2R_SPLIT_ANS_NOTICE', 'ans == S2R_SPLIT_ANS_CYCLE'),
+    'lowers-depth': ('return !depth || depth >= 3;', 'return depth >= 3;'),
 }
 
 PRELUDE = r'''
 #include <assert.h>
 #include <errno.h>
+#include <stdbool.h>
 #include <stdio.h>
 '''
 
@@ -54,6 +58,20 @@ int main(void) {
     /* unknown modes are refused */
     assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, 1, 3) == -EINVAL);
     assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, 1, 0xffffffffu) == -EINVAL);
+    /* the early fabric refusal applies exactly where the APCIe block is lowered */
+    assert(apple_s2r_lowers_apcie(0, 0, S2R_SPLIT_ANS_STOP));
+    assert(apple_s2r_lowers_apcie(0, 5, S2R_SPLIT_ANS_STOP));
+    assert(apple_s2r_lowers_apcie(S2R_STEP_T8132_RAISE, 0, S2R_SPLIT_ANS_STOP));
+    for (d = 1; d <= 2; d++)
+        assert(!apple_s2r_lowers_apcie(S2R_STEP_T8132_RAISE, d, S2R_SPLIT_ANS_STOP));
+    for (d = 3; d <= 8; d++) {
+        assert(apple_s2r_lowers_apcie(S2R_STEP_T8132_RAISE, d, S2R_SPLIT_ANS_STOP));
+        assert(apple_s2r_lowers_apcie(S2R_STEP_T8132_RAISE, d, S2R_SPLIT_ANS_CYCLE));
+    }
+    assert(!apple_s2r_lowers_apcie(S2R_STEP_T8132_RAISE, 1, S2R_SPLIT_ANS_NOTICE));
+    assert(!apple_s2r_lowers_apcie(S2R_STEP_T8132_RAISE, 4, S2R_SPLIT_ANS_NOTICE));
+    assert(!apple_s2r_lowers_apcie(S2R_STEP_T8132_LOWER, 0, S2R_SPLIT_ANS_STOP));
+    assert(!apple_s2r_lowers_apcie(S2R_STEP_T8132_STOP, 7, S2R_SPLIT_ANS_STOP));
     puts("apple-s2r split_ans: every abort/depth/mode combination selects as documented");
     return 0;
 }
@@ -63,9 +81,11 @@ int main(void) {
 def extract(source):
     step = re.search(r'enum apple_s2r_step \{.*?\n\};\n', source, re.S).group(0)
     mode = re.search(r'enum apple_s2r_split_ans_mode \{.*?\n\};\n', source, re.S).group(0)
-    start = source.index('static int apple_s2r_split_ans(')
-    end = source.index('\n}\n', start) + 3
-    return step + mode + source[start:end]
+    code = step + mode
+    for fn in ('static int apple_s2r_split_ans(', 'static bool apple_s2r_lowers_apcie('):
+        start = source.index(fn)
+        code += source[start:source.index('\n}\n', start) + 3]
+    return code
 
 
 def main():
