diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index a564c18f57..441717b770 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -389,6 +389,50 @@ static const u32 t8132_quiesce_words[] = {
 	0x250, 0x578, 0x4d8,
 };
 
+/*
+ * t8132_commit_code: one group of read-backs around the commit, and WD2's
+ * time naming the first one that is not as on macOS: 8 s + 3 s per slot, so
+ * that a reset read with the RTC's one second names one slot; nothing found
+ * keeps macOS's 5 s. The top slot stays below WD1's commit time.
+ */
+#define T8132_CODE_WAKE			1	/* slot: index in the armed wake list */
+#define T8132_CODE_QUIESCE		2	/* slot: index in t8132_quiesce_words */
+#define T8132_CODE_INVARIANTS		3	/* slot: enum apple_s2r_t8132_inv */
+#define T8132_CODE_COMMIT		4	/* slot: what the commit reads after 3 ms */
+#define T8132_CODE_BASE_SECS		8
+#define T8132_CODE_STEP_SECS		3
+#define T8132_CODE_SLOT_MAX		29
+
+enum apple_s2r_t8132_inv {
+	T8132_INV_DCS,		/* DCS not settled at its sleep state */
+	T8132_INV_VOTER,	/* a PMC voter not 0 */
+	T8132_INV_PERF,		/* the SoC not settled at its sleep perf state */
+	T8132_INV_MCC,		/* an MCC channel's enables not 0 */
+	T8132_INV_NUB,		/* the NUB SRAM word without AUTO_ENABLE */
+	T8132_INV_RVBAR,	/* this core's RVBAR not the verified, locked one */
+	T8132_INV_CLUSTER,	/* a CPU cluster word not 0 */
+};
+
+static u32 apple_s2r_t8132_code_secs(int slot)
+{
+	if (slot < 0)
+		return T8132_WD2_SLEEP_SECS;
+	return T8132_CODE_BASE_SECS +
+	       T8132_CODE_STEP_SECS * min(slot, T8132_CODE_SLOT_MAX);
+}
+
+/*
+ * Domains with no user once every device and coprocessor has stopped, which
+ * Aurora lowers at the last step (apple_sleep_lower_stray(), t8132_stray_words,
+ * from macOS's sequence): AVD_SYS, VENC_SYS, GFX, JPG.
+ */
+static const struct {
+	const char *name;
+	u32 offset;
+} t8132_stray_words[] = {
+	{ "AVD_SYS", 0x580 }, { "VENC_SYS", 0x308 }, { "GFX", 0x250 }, { "JPG", 0x578 },
+};
+
 /* DISP_CPU, DISPEXT0_CPU, DISPEXT1_CPU */
 static const u32 t8132_ps_disp_cpu[] = { 0x10000, 0x1e8, 0x4f0 };
 
@@ -441,6 +485,8 @@ struct apple_s2r_t8132 {
 	unsigned int ps_rewake_timeouts;
 	u32 atc0_saved[3];
 	u32 quiesce_still_on;
+	/* t8132_lower_stray: the stray words this sleep lowered, one bit each */
+	u8 stray_lowered;
 
 	u64 siq_cfg;
 	u64 cntkctl;
@@ -1272,6 +1318,14 @@ static uint split_ans;
 module_param(split_ans, uint, 0644);
 MODULE_PARM_DESC(split_ans, "For bring-up, with split_depth 1-6: what the split step does with ANS, whose power those depths never cut: 0 idle and halt it, as before (it does not come back, the disk is lost), 1 send it only its shutdown notice and leave it running (depths 1-2; the resume resets its controller), 2 idle and halt it, then cycle its own power domain in the undo so it restarts as after depth 7 (not yet run on the hardware); other combinations are refused (default: 0)");
 
+static uint t8132_commit_code;
+module_param(t8132_commit_code, uint, 0644);
+MODULE_PARM_DESC(t8132_commit_code, "For bring-up, with t8132_sequence: read one group back around the commit and run WD2 out at 8 + 3 x the slot of the first finding (s) instead of macOS's 5, so that the time of the reset names it: 1 armed wake sources already pending (slot = index in the armed list), 2 quiesce words still on (slot = index), 3 tail invariants (0 DCS, 1 PMC voter, 2 SoC perf, 3 MCC enables, 4 NUB SRAM auto-enable, 5 RVBAR, 6 CPU clusters), 4 the commit register 3 ms after the commit (slot 0 reads 0, 1 reads 1, 2 other); 0 off, other values do nothing (default: 0)");
+
+static bool t8132_lower_stray;
+module_param(t8132_lower_stray, bool, 0644);
+MODULE_PARM_DESC(t8132_lower_stray, "For bring-up, with t8132_sequence: on a real sleep, once every coprocessor has stopped, lower AVD_SYS, VENC_SYS, GFX and JPG if still on, as Aurora does from macOS's sequence; one that will not go off resets with stage 0x3e, as any refusal past the coprocessor stops; raised again on the wake (default: off)");
+
 static bool t8132_time_trail;
 module_param(t8132_time_trail, bool, 0644);
 MODULE_PARM_DESC(t8132_time_trail, "For bring-up, with t8132_sequence and wdt_from_enter: at each step past the match, arm the watchdog again with that step's own time (20 s apart), so that the time of a reset names the step a hang came from (default: off)");
@@ -1981,6 +2035,41 @@ static int apple_s2r_t8132_ps_wait_off(void __iomem *reg)
 			       T8132_PS_TIMEOUT_US);
 }
 
+/* t8132_lower_stray: back on after the wake, for genpd's books */
+static void apple_s2r_t8132_stray_raise(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	int i;
+
+	for (i = ARRAY_SIZE(t8132_stray_words) - 1; i >= 0; i--)
+		if (t->stray_lowered & BIT(i))
+			apple_s2r_t8132_ps_raise(t->ps + t8132_stray_words[i].offset);
+	t->stray_lowered = 0;
+}
+
+/*
+ * t8132_lower_stray, every coprocessor stopped: lower the stray words still
+ * on. Returns the index + 1 of one that would not go off, 0 if none.
+ */
+static int apple_s2r_t8132_lower_stray(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	int i, stuck = 0;
+
+	t->stray_lowered = 0;
+	for (i = 0; i < ARRAY_SIZE(t8132_stray_words); i++) {
+		u32 off = t8132_stray_words[i].offset;
+
+		if (!apple_s2r_t8132_ps_on(s2r, off))
+			continue;
+		apple_s2r_t8132_ps_lower(t->ps + off);
+		t->stray_lowered |= BIT(i);
+		if (apple_s2r_t8132_ps_wait_off(t->ps + off) && !stuck)
+			stuck = i + 1;
+	}
+	return stuck;
+}
+
 /*
  * Never DEV_DISABLE, which keeps a domain off: the SEP's is set at the
  * commit, and macOS's wake writes that word without it. A word that was off
@@ -2933,6 +3022,57 @@ static void apple_s2r_t8132_raise_after_lower(struct apple_s2r *s2r)
 	t->raised = true;
 }
 
+/*
+ * t8132_commit_code: the first read-back of the group that is not what macOS
+ * has right before its commit, as a slot; -1 if none. Reads only.
+ */
+static int apple_s2r_t8132_code_slot(struct apple_s2r *s2r, unsigned int group)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	unsigned int i, src, cpu = smp_processor_id();
+	u64 rvbar;
+
+	switch (group) {
+	case T8132_CODE_WAKE:
+		for (i = 0; i < t->nwake; i++) {
+			src = t->wake_enable[i];
+			if (src / 32 < T8132_WAKE_WORDS &&
+			    readl(t->wake + T8132_WAKE_STATUS(src / 32)) & BIT(src % 32))
+				return i;
+		}
+		return -1;
+	case T8132_CODE_QUIESCE:
+		return t->quiesce_still_on ? __ffs(t->quiesce_still_on) : -1;
+	case T8132_CODE_INVARIANTS:
+		if ((readl(t->dcs) & (T8132_DCS_BUSY | T8132_DCS_STATE)) !=
+		    FIELD_PREP(T8132_DCS_STATE, T8132_DCS_SLEEP_STATE))
+			return T8132_INV_DCS;
+		for (i = 0; i < T8132_PMC_VOTER_AGENTS; i++)
+			if (readl(t->pmc_voters + i * T8132_PMC_VOTER_STRIDE))
+				return T8132_INV_VOTER;
+		if ((readl(t->clk_perf + T8132_CLK_PERF_SOC) &
+		     (T8132_DCS_BUSY | T8132_DCS_STATE)) !=
+		    FIELD_PREP(T8132_DCS_STATE, T8132_SOC_SLEEP_STATE))
+			return T8132_INV_PERF;
+		for (i = 0; i < T8132_MCC_CHANNELS; i++)
+			if (readl(t->mcc[i] + T8132_MCC_ENABLES))
+				return T8132_INV_MCC;
+		if (!(readl(t->ps_aon + T8132_PS_AON_NUB_SRAM) & T8132_PS_AUTO_ENABLE))
+			return T8132_INV_NUB;
+		if (s2r->rvbar && s2r->rvbar[cpu]) {
+			rvbar = readq(s2r->rvbar[cpu]);
+			if (!(rvbar & IMPL_RVBAR_LOCK) ||
+			    (rvbar & IMPL_RVBAR_ADDR) != s2r->reset_vector)
+				return T8132_INV_RVBAR;
+		}
+		if ((readl(t->cluster + T8132_CLUSTER_E) | readl(t->cluster + T8132_CLUSTER_P)) &
+		    T8132_CLUSTER_ON)
+			return T8132_INV_CLUSTER;
+		return -1;
+	}
+	return -1;
+}
+
 /*
  * With the breadcrumb on, the steps past the match replaced macOS's 0x50:
  * it goes back as the last PMU write before the engine, so that a start
@@ -2994,11 +3134,22 @@ static int apple_s2r_t8132_finish(unsigned long arg)
 	struct apple_s2r_t8132 *t = &s2r->t8132;
 	struct apple_s2r_mailbox *mb = s2r->mailbox;
 	u64 flags = S2R_FLAG_QUIET | (warm_flags & S2R_FLAGS_OS);
-	unsigned int depth;
+	unsigned int depth, code;
 	int i, ret;
 
 	t->siq_cfg = read_sysreg_s(SYS_APL_SIQ_CFG_EL1);
 
+	if (!READ_ONCE(abort_before) && READ_ONCE(t8132_lower_stray)) {
+		int stuck = apple_s2r_t8132_lower_stray(s2r);
+
+		if (stuck) {
+			pr_emerg("apple-s2r: T8132: %s will not go off: %#x\n",
+				 t8132_stray_words[stuck - 1].name,
+				 readl(t->ps + t8132_stray_words[stuck - 1].offset));
+			apple_s2r_t8132_fatal(s2r, S2R_CRUMB_T8132_FATAL);
+		}
+	}
+
 	ret = apple_s2r_check(s2r, S2R_STEP_T8132_STOP);
 	if (ret)
 		return ret;
@@ -3114,6 +3265,14 @@ static int apple_s2r_t8132_finish(unsigned long arg)
 	writel((readl(t->ps_aon + T8132_PS_AON_NUB_SRAM) & ~T8132_PS_FLAGS) | T8132_PS_AUTO_ENABLE,
 	       t->ps_aon + T8132_PS_AON_NUB_SRAM);
 
+	code = READ_ONCE(t8132_commit_code);
+	if (code && code != T8132_CODE_COMMIT) {
+		int slot = apple_s2r_t8132_code_slot(s2r, code);
+
+		if (slot >= 0)
+			apple_s2r_t8132_set_wd2(s2r, apple_s2r_t8132_code_secs(slot));
+	}
+
 	/* Our boot firmware's mailbox; the wake comes back through the WD2 stub. */
 	if (!s2r->wdt_armed)
 		flags &= ~S2R_FLAG_WDT_THROUGH;
@@ -3139,6 +3298,11 @@ static int apple_s2r_t8132_finish(unsigned long arg)
 	 */
 	apple_cpu_t8132_release_stopped(true);
 	mdelay(T8132_POST_COMMIT_MS);
+	if (code == T8132_CODE_COMMIT) {
+		u32 commit = readl(t->commit);
+
+		apple_s2r_t8132_set_wd2(s2r, apple_s2r_t8132_code_secs(commit > 1 ? 2 : commit));
+	}
 	apple_cpu_t8132_deep_sleep();
 }
 
@@ -3169,6 +3333,8 @@ static void apple_s2r_t8132_return(struct apple_s2r *s2r)
 	writel(T8132_PWRGATE_ON, t->pwrgate + T8132_PWRGATE_WAKE_1);
 
 	apple_s2r_t8132_ps_rewake(s2r);
+	if (t->stray_lowered)
+		apple_s2r_t8132_stray_raise(s2r);
 	/* ATC0's words were saved already lowered: back in reverse order. */
 	apple_s2r_t8132_ps_restore(t->ps + T8132_PS_ATC0_COMMON, t->atc0_saved[2]);
 	apple_s2r_t8132_ps_restore(t->ps_aon + T8132_PS_AON_ATC0_USB_AON, t->atc0_saved[1]);
diff --git a/tools/asahi/run-host-tests.py b/tools/asahi/run-host-tests.py
