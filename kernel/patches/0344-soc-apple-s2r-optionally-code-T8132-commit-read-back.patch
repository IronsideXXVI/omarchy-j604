diff --git a/tools/asahi/t8132-commit-code-tests.py b/tools/asahi/t8132-commit-code-tests.py
new file mode 100755
index 0000000000..5983970e93
--- /dev/null
+++ b/tools/asahi/t8132-commit-code-tests.py
@@ -0,0 +1,162 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Check the T8132 commit code and stray lowering of apple-s2r.
+
+apple_s2r_t8132_code_secs() is extracted from drivers/soc/apple/apple-s2r.c
+and evaluated for every slot. It checks that with nothing found WD2 keeps
+macOS's 5 s; that each slot gets its own time, at least 3 s from every other
+and from 5 s, so that a reset time read with the RTC's one second names one
+slot; that every time, clamped, is below WD1's commit time; that each group
+fits the slots (armed wake sources, quiesce words, invariants, commit values);
+that the quiesce group names the lowest index still on; that the wake group
+reads the status words, not the masks; that the parameter defaults to 0 and
+gates the pre-commit and post-commit re-arms; that the post-commit read comes
+after the commit and its 3 ms; and that the stray lowering is real-path only,
+default off, a subset of the quiesce list, and raised again after ps_rewake.
+"""
+import argparse
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+MUTATIONS = {
+    'code-on': ('static uint t8132_commit_code;', 'static uint t8132_commit_code = 2;'),
+    'stray-on': ('static bool t8132_lower_stray;', 'static bool t8132_lower_stray = true;'),
+    'code-ungated': ('\tif (code && code != T8132_CODE_COMMIT) {', '\tif (code != T8132_CODE_COMMIT) {'),
+    'step-small': ('#define T8132_CODE_STEP_SECS\t\t3', '#define T8132_CODE_STEP_SECS\t\t1'),
+    'base-low': ('#define T8132_CODE_BASE_SECS\t\t8', '#define T8132_CODE_BASE_SECS\t\t5'),
+    'no-clamp': ('T8132_CODE_STEP_SECS * min(slot, T8132_CODE_SLOT_MAX);', 'T8132_CODE_STEP_SECS * slot;'),
+    'slot-max-high': ('#define T8132_CODE_SLOT_MAX\t\t29', '#define T8132_CODE_SLOT_MAX\t\t31'),
+    'highest-bit': ('__ffs(t->quiesce_still_on)', '__fls(t->quiesce_still_on)'),
+    'wake-mask': ('readl(t->wake + T8132_WAKE_STATUS(src / 32))', 'readl(t->wake + T8132_WAKE_MASK(src / 32))'),
+    'commit-early': ('\tmdelay(T8132_POST_COMMIT_MS);\n\tif (code == T8132_CODE_COMMIT) {',
+                     '\tif (code == T8132_CODE_COMMIT) {'),
+    'stray-on-abort': ('if (!READ_ONCE(abort_before) && READ_ONCE(t8132_lower_stray)) {',
+                       'if (READ_ONCE(t8132_lower_stray)) {'),
+    'no-raise': ('\tif (t->stray_lowered)\n\t\tapple_s2r_t8132_stray_raise(s2r);\n', ''),
+    'stray-extra': ('{ "JPG", 0x578 },', '{ "JPG", 0x578 }, { "ISP_SYS", 0x530 },'),
+}
+
+
+def define(src, name):
+    m = re.search(r'#define %s\s+(\d+)' % name, src)
+    assert m, f'Assertion failed: no #define {name}'
+    return int(m.group(1))
+
+
+def code_secs_fn(src):
+    at = src.index('static u32 apple_s2r_t8132_code_secs(int slot)')
+    body = src[at:src.index('\n}\n', at)]
+    m0 = re.search(r'if \(slot < 0\)\n\t\treturn (\w+);', body)
+    m1 = re.search(r'return (\w+) \+\s+(\w+) \* (min\(slot, (\w+)\)|slot);', body)
+    assert m0 and m1, 'Assertion failed: code_secs shape changed'
+    zero = define(src, m0.group(1))
+    base, step = define(src, m1.group(1)), define(src, m1.group(2))
+    cap = define(src, m1.group(4)) if m1.group(4) else None
+    return lambda k: zero if k < 0 else base + step * (min(k, cap) if cap is not None else k)
+
+
+def hexlist(text):
+    return [int(x, 0) for x in re.findall(r'0x[0-9a-fA-F]+', text)]
+
+
+def fn_body(src, head):
+    at = src.index(head)
+    return src[at:src.index('\n}\n', at)]
+
+
+def check(src):
+    secs = code_secs_fn(src)
+    sleep = define(src, 'T8132_WD2_SLEEP_SECS')
+    wd1 = define(src, 'T8132_WD1_COMMIT_SECS')
+    smax = define(src, 'T8132_CODE_SLOT_MAX')
+    q = re.search(r'static const u32 t8132_quiesce_words\[\] = \{(.*?)\};', src, re.S).group(1)
+    nq = len([x for x in q.split(',') if x.strip()])
+    q_hex = hexlist(q)
+    if 'T8132_PS_ATC0_COMMON' in q:
+        q_hex.append(int(re.search(r'#define T8132_PS_ATC0_COMMON\s+(0x[0-9a-fA-F]+)', src).group(1), 16))
+    inv = re.search(r'enum apple_s2r_t8132_inv \{(.*?)\};', src, re.S).group(1)
+    ninv = len(re.findall(r'T8132_INV_\w+,', inv))
+    nwake = define(src, 'T8132_WAKE_SOURCES_MAX')
+
+    assert secs(-1) == sleep == 5, f'Assertion failed: nothing found must keep 5 s, got {secs(-1)}'
+    slots = [secs(k) for k in range(smax + 1)]
+    allt = sorted(slots + [sleep])
+    gaps = [b - a for a, b in zip(allt, allt[1:])]
+    assert min(gaps) >= 3, f'Assertion failed: bins closer than 3 s: {allt[:6]}...'
+    top = max(secs(k) for k in range(0, 64))
+    assert top < wd1, f'Assertion failed: slot time {top} s not below WD1 commit {wd1} s'
+    assert nq - 1 <= smax and ninv - 1 <= smax and 2 <= smax, 'Assertion failed: a group does not fit the slots'
+    assert nwake <= 64, 'Assertion failed: wake list size'
+    assert ninv == 7, f'Assertion failed: {ninv} invariants, want 7'
+
+    for name, val in (('WAKE', 1), ('QUIESCE', 2), ('INVARIANTS', 3), ('COMMIT', 4)):
+        assert define(src, 'T8132_CODE_' + name) == val, f'Assertion failed: group {name} != {val}'
+
+    slot = fn_body(src, 'static int apple_s2r_t8132_code_slot(struct apple_s2r *s2r, unsigned int group)')
+    assert 'readl(t->wake + T8132_WAKE_STATUS(src / 32)) & BIT(src % 32)' in slot, \
+        'Assertion failed: the wake group must read the status words'
+    assert 'return t->quiesce_still_on ? __ffs(t->quiesce_still_on) : -1;' in slot, \
+        'Assertion failed: the quiesce group must name the lowest index still on'
+    assert 'writel' not in slot, 'Assertion failed: code_slot must only read'
+    order = [slot.find('return T8132_INV_' + n + ';') for n in
+             ('DCS', 'VOTER', 'PERF', 'MCC', 'NUB', 'RVBAR', 'CLUSTER')]
+    assert all(o >= 0 for o in order) and order == sorted(order), f'Assertion failed: invariant order {order}'
+
+    assert 'static uint t8132_commit_code;' in src, 'Assertion failed: t8132_commit_code must default to 0'
+    assert 'module_param(t8132_commit_code, uint, 0644);' in src
+    assert 'static bool t8132_lower_stray;' in src, 'Assertion failed: t8132_lower_stray must default to off'
+    fin = fn_body(src, 'static int apple_s2r_t8132_finish(unsigned long arg)')
+    pre = fin.find('\tif (code && code != T8132_CODE_COMMIT) {')
+    assert pre >= 0, 'Assertion failed: the pre-commit re-arm must be gated by a nonzero, non-commit group'
+    i_nub = fin.find('T8132_PS_AON_NUB_SRAM);')
+    i_mb = fin.find('WRITE_ONCE(mb->entry')
+    assert i_nub < pre < i_mb, 'Assertion failed: the pre-commit read must follow the NUB write, before the mailbox'
+    i_commit = fin.find('writel(S2R_TIMER_START, t->commit);')
+    i_delay = fin.find('mdelay(T8132_POST_COMMIT_MS);')
+    i_post = fin.find('\tif (code == T8132_CODE_COMMIT) {')
+    i_wfi = fin.find('apple_cpu_t8132_deep_sleep();')
+    assert 0 <= i_commit < i_delay < i_post < i_wfi, 'Assertion failed: the commit read must follow the commit and its 3 ms'
+    assert 'apple_s2r_t8132_code_secs(commit > 1 ? 2 : commit)' in fin, 'Assertion failed: commit slots'
+    assert fin.count('apple_s2r_t8132_set_wd2(s2r, apple_s2r_t8132_code_secs(') == 2, \
+        'Assertion failed: exactly two coded WD2 re-arms'
+    assert 'if (!READ_ONCE(abort_before) && READ_ONCE(t8132_lower_stray)) {' in src, \
+        'Assertion failed: stray lowering must be real-path only and gated'
+
+    s = re.search(r'\} t8132_stray_words\[\] = \{(.*?)\};', src, re.S).group(1)
+    stray = hexlist(s)
+    assert stray == [0x580, 0x308, 0x250, 0x578], f'Assertion failed: stray words {stray}'
+    assert set(stray) <= set(q_hex), 'Assertion failed: a stray word is not in the quiesce list'
+    assert re.search(r'\tu8 stray_lowered;', src) and len(stray) <= 8, 'Assertion failed: stray bits'
+    ret = fn_body(src, 'static void apple_s2r_t8132_return(struct apple_s2r *s2r)')
+    i_wake = ret.find('apple_s2r_t8132_ps_rewake(s2r);')
+    i_raise = ret.find('\tif (t->stray_lowered)\n\t\tapple_s2r_t8132_stray_raise(s2r);')
+    assert i_wake >= 0 and i_raise > i_wake, 'Assertion failed: stray words not raised after ps_rewake'
+    return nq, ninv, slots
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path)
+    parser.add_argument('--mutation', choices=MUTATIONS)
+    args = parser.parse_args()
+    src = (ROOT / 'drivers/soc/apple/apple-s2r.c').read_text()
+    if args.mutation:
+        old, new = MUTATIONS[args.mutation]
+        assert old in src, f'missing mutation site: {old}'
+        src = src.replace(old, new, 1)
+    try:
+        nq, ninv, slots = check(src)
+    except (AssertionError, KeyError, ValueError, AttributeError) as e:
+        print(e if str(e).startswith('Assertion') else f'Assertion failed: {e}')
+        raise SystemExit(1)
+    line = ('t8132 commit code: 4 groups, slots 0..%d = WD2 %d..%d s every 3 s, none found 5 s; '
+            '%d quiesce words, %d invariants; stray words gated, raised after the wake') % (
+        len(slots) - 1, slots[0], slots[-1], nq, ninv)
+    if args.out:
+        args.out.write_text(line + '\n')
+    print(line)
+
+
+if __name__ == '__main__':
+    main()
