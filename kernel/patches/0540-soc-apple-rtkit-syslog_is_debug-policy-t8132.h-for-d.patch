From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 04:50:09 +0000
Subject: [PATCH] soc: apple: rtkit: syslog_is_debug policy + t8132.h for
 drm/apple sync

Prerequisites for syncing drivers/gpu/drm/apple to Aurora
integration/aurora 50d5865ea6 on a15y:

- include/linux/soc/apple/rtkit.h: add the optional
  apple_rtkit_ops.syslog_is_debug callback (doc taken from 50d5865ea6).
- drivers/soc/apple/rtkit.c: honour it when printing a decoded syslog
  record (dev_dbg when the client says debug, dev_info otherwise),
  as in 50d5865ea6.
- include/linux/soc/apple/t8132.h: new, verbatim from 50d5865ea6; used
  by drivers/gpu/drm/apple/t8132_ext_drm.c.
- Rust: set the new field to None in the RtKit vtables
  (rust/kernel/soc/apple/rtkit.rs, drm/asahi g15/g16 boot.rs) so the
  const initializers compile.

[j604: header trimmed against 50d5865ea6: APPLE_RTKIT_FIRMWARE_OWNED_CRASHLOG,
 APPLE_RTKIT_EARLY_CRASHLOG and apple_rtkit_set_rx_util_min() are NOT
 taken; a15y's rtkit.c does not implement them and drm/apple does not
 use them (only upstream rust/kernel/soc/apple/rtkit.rs does, which is
 not part of this sync).]

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g15/boot.rs |  1 +
 drivers/gpu/drm/asahi/g16/boot.rs |  1 +
 drivers/soc/apple/rtkit.c         |  9 +++-
 include/linux/soc/apple/rtkit.h   |  6 +++
 include/linux/soc/apple/t8132.h   | 86 +++++++++++++++++++++++++++++++
 rust/kernel/soc/apple/rtkit.rs    |  1 +
 6 files changed, 102 insertions(+), 2 deletions(-)
 create mode 100644 include/linux/soc/apple/t8132.h

diff --git a/drivers/gpu/drm/asahi/g15/boot.rs b/drivers/gpu/drm/asahi/g15/boot.rs
index 4f268b2b47..165fa60093 100644
--- a/drivers/gpu/drm/asahi/g15/boot.rs
+++ b/drivers/gpu/drm/asahi/g15/boot.rs
@@ -322,6 +322,7 @@ static RTKIT_OPS: bindings::apple_rtkit_ops = bindings::apple_rtkit_ops {
     shmem_destroy: Some(rtkit_shmem_destroy),
     shmem_setup_ep: None,
     protocol_version: 0,
+    syslog_is_debug: None,
 };
 
 /// The GPU's RTKit client. Never freed: the firmware session lasts until reboot.
diff --git a/drivers/gpu/drm/asahi/g16/boot.rs b/drivers/gpu/drm/asahi/g16/boot.rs
index 8dbcb351ac..0c848a726d 100644
--- a/drivers/gpu/drm/asahi/g16/boot.rs
+++ b/drivers/gpu/drm/asahi/g16/boot.rs
@@ -292,6 +292,7 @@ static RTKIT_OPS: bindings::apple_rtkit_ops = bindings::apple_rtkit_ops {
     shmem_setup_ep: Some(rtkit_shmem_setup),
     shmem_destroy: Some(rtkit_shmem_destroy),
     protocol_version: 12,
+    syslog_is_debug: None,
 };
 
 /// The GPU's RTKit client. Never freed: the firmware session lasts until reboot.
diff --git a/drivers/soc/apple/rtkit.c b/drivers/soc/apple/rtkit.c
index d41396404f..8bfa668754 100644
--- a/drivers/soc/apple/rtkit.c
+++ b/drivers/soc/apple/rtkit.c
@@ -946,8 +946,13 @@ static void apple_rtkit_syslog_rx_log(struct apple_rtkit *rtk, u64 msg)
 		msglen--;
 
 	rtk->syslog_msg_buffer[msglen] = 0;
-	dev_info(rtk->dev, "RTKit: syslog message: %s: %s\n", log_context,
-		 rtk->syslog_msg_buffer);
+	if (rtk->ops->syslog_is_debug &&
+	    rtk->ops->syslog_is_debug(rtk->cookie, log_context, rtk->syslog_msg_buffer))
+		dev_dbg(rtk->dev, "RTKit: syslog message: %s: %s\n", log_context,
+			rtk->syslog_msg_buffer);
+	else
+		dev_info(rtk->dev, "RTKit: syslog message: %s: %s\n", log_context,
+			 rtk->syslog_msg_buffer);
 
 done:
 	apple_rtkit_send_message(rtk, APPLE_RTKIT_EP_SYSLOG, msg, NULL, false);
diff --git a/include/linux/soc/apple/rtkit.h b/include/linux/soc/apple/rtkit.h
index a77d218471..0bbe3ffbf3 100644
--- a/include/linux/soc/apple/rtkit.h
+++ b/include/linux/soc/apple/rtkit.h
@@ -83,6 +83,11 @@ struct apple_rtkit_inherited_buffer {
  * @shmem_destroy: Undo the shared memory buffer setup in shmem_setup. If not
  *                 specified dma_free_coherent is used. Called in process
  *                 context.
+ * @syslog_is_debug:
+ *                 Optional policy for a decoded, NUL-terminated syslog record.
+ *                 Return true to log at debug instead of info. Called in
+ *                 process context; strings are borrowed until return. Records
+ *                 are acknowledged regardless of the chosen log level.
  * @protocol_version: Optional exact protocol version required by the client.
  *                 Zero retains normal highest-supported-version negotiation.
  */
@@ -94,6 +99,7 @@ struct apple_rtkit_ops {
 	int (*shmem_setup)(void *cookie, struct apple_rtkit_shmem *bfr);
 	int (*shmem_setup_ep)(void *cookie, u8 endpoint, struct apple_rtkit_shmem *bfr);
 	void (*shmem_destroy)(void *cookie, struct apple_rtkit_shmem *bfr);
+	bool (*syslog_is_debug)(void *cookie, const char *context, const char *message);
 	u16 protocol_version;
 };
 
diff --git a/include/linux/soc/apple/t8132.h b/include/linux/soc/apple/t8132.h
new file mode 100644
index 0000000000..ec91e8faaa
--- /dev/null
+++ b/include/linux/soc/apple/t8132.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef _LINUX_SOC_APPLE_T8132_H
+#define _LINUX_SOC_APPLE_T8132_H
+
+#include <linux/of.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+/*
+ * The M4 MacBook Airs, J713 (13-inch) and J715 (15-inch): one board design
+ * and boot loader handoff. Their ADTs differ in the panel, the speakers, the
+ * radio's firmware island and per-machine trims, all of which their device
+ * trees describe.
+ */
+static inline bool apple_t8132_air(void)
+{
+	return of_machine_is_compatible("apple,j713") ||
+	       of_machine_is_compatible("apple,j715");
+}
+
+/*
+ * The other M4 Macs: the MacBook Pro 14-inch (J604), the Mac mini (J773g)
+ * and the iMacs (J623, J624). The J604 and J773g ADTs are read; the iMacs
+ * have none yet.
+ */
+static inline bool apple_t8132_pro_mini_imac(void)
+{
+	return of_machine_is_compatible("apple,j604") ||
+	       of_machine_is_compatible("apple,j623") ||
+	       of_machine_is_compatible("apple,j624") ||
+	       of_machine_is_compatible("apple,j773g");
+}
+
+/*
+ * The OS firmware the M4 PMP, PMGR ownership, display and GPU paths are
+ * qualified on, as the boot loader reports it: macOS 26.6.2 (iBoot
+ * mBoot-18000.161.10). These paths depend on the firmware, not the board.
+ */
+static inline bool apple_t8132_qualified_firmware(void)
+{
+	const char *version;
+
+	return of_machine_is_compatible("apple,t8132") &&
+	       !of_property_read_string(of_chosen, "asahi,os-fw-version", &version) &&
+	       !strcmp(version, "26.6.2");
+}
+
+/*
+ * The firmware-dependent M4 paths: every M4 Mac on the qualified firmware,
+ * and the Airs on any firmware, as before.
+ */
+static inline bool apple_t8132_firmware_path(void)
+{
+	return apple_t8132_air() || apple_t8132_qualified_firmware();
+}
+
+/*
+ * The radio port the Airs have: reg-on on the SMC's gP13 with the same
+ * template, and the radio's two ordinary streams managed on port 0 of the
+ * built-in PCIe controller. The J604 and J773g ADTs match; the iMacs are
+ * assumed to.
+ */
+static inline bool apple_t8132_managed_radio(void)
+{
+	return apple_t8132_air() || apple_t8132_pro_mini_imac();
+}
+
+/*
+ * The Airs' USB-C host sequence: a DWC3 enters host mode before core init
+ * and gets the CIO setup before xHCI starts. Every M4 Mac has these ATCs.
+ */
+static inline bool apple_t8132_usb_host_first(void)
+{
+	return apple_t8132_air() || apple_t8132_pro_mini_imac();
+}
+
+/*
+ * The Airs' MTP keyboard and trackpad, which iBoot leaves running: the
+ * J604 has the same.
+ */
+static inline bool apple_t8132_live_mtp(void)
+{
+	return apple_t8132_air() || of_machine_is_compatible("apple,j604");
+}
+
+#endif
diff --git a/rust/kernel/soc/apple/rtkit.rs b/rust/kernel/soc/apple/rtkit.rs
index eda8deb2e4..b13cf9fd5b 100644
--- a/rust/kernel/soc/apple/rtkit.rs
+++ b/rust/kernel/soc/apple/rtkit.rs
@@ -237,6 +237,7 @@ impl<T: Operations> RtKit<T> {
             None
         },
         protocol_version: 0,
+        syslog_is_debug: None,
     };
 
     const COREANALYTICS_VTABLE: bindings::apple_rtkit_ops = bindings::apple_rtkit_ops {
