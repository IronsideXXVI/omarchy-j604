From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 01:14:12 +0000
Subject: [PATCH] drm/apple: m4: optionally pace J604 panel swaps onto
 the 120 Hz grid

With "as soon as possible" timing words the J604 panel shows a frame at
its next 4.17 ms tick, so a frame that arrives a little late or early
lands on a tick between two 120 Hz refreshes and is shown 12.5 ms or
20.9 ms after the previous one. On a fixed-refresh panel the same frame
would wait for the next refresh and the cadence would stay even.

Add swap_pace (0644, default off) and swap_pace_lead_us (default 1500).
With swap_pace on, an internal-panel swap whose first reachable tick,
counted from the last swap completion, is an odd one waits until that
tick has passed (at most 4.17 ms), so the frame is shown on the 120 Hz
grid. This is the host-side counterpart of swap_target=2, for comparing
the two on the machine.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 4f9b74cf992c7e6ded1c3a351dcb5188802da50c)
---
 drivers/gpu/drm/apple/iomfb_m4.c | 45 ++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index 4d819be7ce..97ee2c3056 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -185,6 +185,16 @@ module_param(swap_target_lead_us, uint, 0644);
 MODULE_PARM_DESC(swap_target_lead_us,
 		 "J604: with swap_target=2, how far ahead of submission the target tick must be, us (default 2000)");
 
+static bool swap_pace;
+module_param(swap_pace, bool, 0644);
+MODULE_PARM_DESC(swap_pace,
+		 "J604: before an internal-panel swap, wait when the frame would otherwise be shown on the panel tick between two 120 Hz refreshes (4.17 ms after one), so it is shown on the 120 Hz grid of the last completion (experimental; default: off)");
+
+static unsigned int swap_pace_lead_us = 1500;
+module_param(swap_pace_lead_us, uint, 0644);
+MODULE_PARM_DESC(swap_pace_lead_us,
+		 "J604: with swap_pace, the time from starting a swap to the first panel tick it can make, us (default 1500)");
+
 static bool panel_edr;
 /* Given on the command line or written: the machine default stays out. */
 static bool panel_edr_given;
@@ -2563,6 +2573,34 @@ static bool dcp_m4_ext_swap_give_up(struct dcp_m4_runtime *r, struct dcp_m4_swap
  * retargets the swap as dcp_m4_swap_set_intent() describes.
  */
 
+
+/*
+ * swap_pace: internal-panel swaps carry "as soon as possible" timing words,
+ * so the panel shows a frame at its next 4.17 ms tick. Measured from the last
+ * completion, even ticks are the 120 Hz grid and odd ones fall between two
+ * refreshes. When the first tick a swap started now can make
+ * (swap_pace_lead_us ahead) is an odd one, wait until it has passed, so the
+ * frame is shown on the next grid tick instead. Returns the wait in us.
+ */
+static unsigned long dcp_m4_swap_pace_us(struct dcp_m4_runtime *r)
+{
+	u64 freq, half, base, now, t, k;
+
+	if (!READ_ONCE(swap_pace))
+		return 0;
+	freq = arch_timer_get_cntfrq();
+	half = div_u64(freq, 240);
+	base = READ_ONCE(r->int_done_cnt);
+	now = __arch_counter_get_cntpct();
+	if (!half || !base || base > now)
+		return 0;
+	t = now + div_u64(freq * READ_ONCE(swap_pace_lead_us), USEC_PER_SEC);
+	k = div64_u64(t - base + half - 1, half);
+	if (!(k & 1))
+		return 0;
+	/* At most one tick (4.17 ms): the frame then makes tick k + 1. */
+	return div64_u64((base + k * half - t) * USEC_PER_SEC, freq) + 1;
+}
 /*
  * The first timing word of an internal-panel swap (swap_target): 0 keeps the
  * constant 120 of dcp_m4_swap_set_timing(). 1 is the counter now. 2 is the
@@ -2638,6 +2676,13 @@ static int dcp_m4_runtime_swap_full(struct dcp_m4_runtime *r, bool primary,
 		dcp_m4_failed(dcp, -ENOMEM);
 		return -ENOMEM;
 	}
+	/* swap_pace: an internal panel frame waits for the 120 Hz grid. */
+	if (!ext && primary && frame) {
+		unsigned long pace = dcp_m4_swap_pace_us(r);
+
+		if (pace)
+			usleep_range(pace, pace + 50);
+	}
 	r->deadline = jiffies + msecs_to_jiffies(5000);
 	ret = dcp_m4_runtime_call(r, 406, false, start, sizeof(start), started, sizeof(started));
 	if (!ret)
-- 
