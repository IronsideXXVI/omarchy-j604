From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 21:39:34 +0000
Subject: [PATCH] iommu: apple-dart: probe a DART whose filter ranges
 are not described

A DART with a dapf reg but no apple,dapf-ranges failed its probe with
-EINVAL, and took its consumer with it, although it translates as well
without them: the ranges only let it write the address filter back after
a sleep that clears it. Probe such a DART with a warning that the filter
is not restored after a sleep. Ranges that are present must still be
start and end pairs that fit the dapf registers.

Move the decision into apple_dart_dapf_count() and test it: absent,
present without a value, an odd count, the T8132 ISP DART's 13 ranges
and more entries than the registers hold.

Fixes: 0b038b66ffa4 ("iommu: apple-dart: take the coprocessor DARTs through a firmware suspend")
Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
(cherry picked from commit 95be9a0b99e2822253a26c83fe23bf1ec55423ab)
---
 drivers/iommu/apple-dart-test.c | 24 +++++++++++++++++++++++
 drivers/iommu/apple-dart.c      | 34 +++++++++++++++++++++++++++------
 2 files changed, 52 insertions(+), 6 deletions(-)

diff --git a/drivers/iommu/apple-dart-test.c b/drivers/iommu/apple-dart-test.c
index c63cb0067c..2a96e7961f 100644
--- a/drivers/iommu/apple-dart-test.c
+++ b/drivers/iommu/apple-dart-test.c
@@ -1230,8 +1230,32 @@ static void apple_dart_test_host_power_tables(struct kunit *test)
 }
 #endif
 
+/*
+ * apple,dapf-ranges: absent leaves the DART probing without a filter to restore; it must
+ * otherwise be start and end pairs that fit the dapf registers, 0x40 per entry.
+ */
+static void apple_dart_test_dapf_count(struct kunit *test)
+{
+	/* the T8132 ISP DART: a 16 KiB dapf bank, 13 ranges */
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 26, SZ_16K), 13);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 2, SZ_16K), 1);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 512, SZ_16K), 256);
+	/* a dapf reg without the property: no filter to restore, the DART still probes */
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(false, -EINVAL, SZ_16K), 0);
+	/* present but no value, an odd cell count, or a cell size that is not 64 bits */
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, -ENODATA, SZ_16K), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 0, SZ_16K), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 25, SZ_16K), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, -EINVAL, SZ_16K), -EINVAL);
+	/* more entries than the registers hold */
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 514, SZ_16K), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 26, 12 * 0x40), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 26, 13 * 0x40), 13);
+}
+
 static struct kunit_case apple_dart_test_cases[] = {
 	KUNIT_CASE(apple_dart_test_iommu_specifiers),
+	KUNIT_CASE(apple_dart_test_dapf_count),
 	KUNIT_CASE(apple_dart_test_consumer_window),
 	KUNIT_CASE(apple_dart_test_invalid_consumer_window),
 	KUNIT_CASE(apple_dart_test_independent_remap_roots),
diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 1db1882476..c932794399 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -4295,20 +4295,42 @@ static void apple_dart_sleep_cfg_read(struct apple_dart *dart, u32 *cfg)
 #define DART_DAPF_STRIDE	0x40
 #define DART_DAPF_CONFIG	0x31
 
+/*
+ * The number of filter entries apple,dapf-ranges describes, given whether the property is
+ * present, its count of u64 cells and the size of the dapf registers. 0 without the
+ * property: the DART still translates, only the filter is not written back after a sleep.
+ * -EINVAL for anything but start and end pairs that fit the registers.
+ */
+static int apple_dart_dapf_count(bool present, int n, resource_size_t size)
+{
+	if (!present)
+		return 0;
+	if (n <= 0 || n % 2)
+		return -EINVAL;
+	if (size < (resource_size_t)(n / 2) * DART_DAPF_STRIDE)
+		return -EINVAL;
+	return n / 2;
+}
+
 static int apple_dart_dapf_parse(struct platform_device *pdev, struct apple_dart *dart)
 {
 	struct device *dev = &pdev->dev;
 	struct device_node *np = dev->of_node;
 	struct resource *res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dapf");
+	bool present = of_property_present(np, "apple,dapf-ranges");
 	int n = of_property_count_u64_elems(np, "apple,dapf-ranges");
+	int count = apple_dart_dapf_count(present, n, resource_size(res));
 	unsigned int i;
 
-	if (n <= 0 || n % 2)
-		return dev_err_probe(dev, -EINVAL, "apple,dapf-ranges needs start and end pairs\n");
-	dart->dapf_count = n / 2;
-	if (resource_size(res) < dart->dapf_count * DART_DAPF_STRIDE)
-		return dev_err_probe(dev, -EINVAL, "DAPF region too small for %u ranges\n",
-				     dart->dapf_count);
+	if (count < 0)
+		return dev_err_probe(dev, count,
+				     "apple,dapf-ranges must be pairs that fit %pR\n", res);
+	if (!count) {
+		/* Its consumer's firmware would fault after a sleep that clears the filter. */
+		dev_warn(dev, "no apple,dapf-ranges: the filter is not restored after a sleep\n");
+		return 0;
+	}
+	dart->dapf_count = count;
 
 	dart->dapf = devm_platform_ioremap_resource_byname(pdev, "dapf");
 	if (IS_ERR(dart->dapf))
