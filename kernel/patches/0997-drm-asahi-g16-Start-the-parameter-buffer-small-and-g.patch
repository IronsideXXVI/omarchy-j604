     /// `g16_pb_lazy`: backs each built unit's PB heap up to what this VM's renders were seen
     /// holding (in SUBMIT, under the VM's resource lock). A failed step leaves the backing as
     /// it was; managers are then seeded within it.
+    /// `g16_pb_grow`: a unit whose renders overflowed asks for twice its backing instead, and
+    /// the backing after the step is recorded for the manager reuse checks.
     fn grow_pb(&self, factory: &Factory, vm: &mmu::Vm) {
         for k in 0..self.unit_count() {
             if let Ok(unit) = self.alloc_unit(k) {
-                let _ = unit.grow(factory, vm, self.pb_hint.want(k));
+                let _ = unit.grow(
+                    factory,
+                    vm,
+                    self.pb_hint.grow_want(k, unit.heap_blocks_unit()),
+                );
+                self.pb_hint.grown(k, unit.heap_blocks_unit());
             }
         }
     }
