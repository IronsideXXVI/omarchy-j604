+    writeln!(
+        f,
+        "pb_grow: on {} read {} overflowed {} overflow_sum {} overflow_max {} doublings {} reuse_refused {}",
+        super::params::pb_grow(),
+        GROW_PB[0].load(Ordering::Relaxed),
+        GROW_PB[1].load(Ordering::Relaxed),
+        GROW_PB[2].load(Ordering::Relaxed),
+        GROW_PB[3].load(Ordering::Relaxed),
+        GROW_PB[4].load(Ordering::Relaxed),
+        GROW_PB[5].load(Ordering::Relaxed)
     )
 }
 
