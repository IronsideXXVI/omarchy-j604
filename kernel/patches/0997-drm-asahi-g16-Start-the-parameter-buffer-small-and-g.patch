+    /// `g16_pb_grow` at this render's retirement: `count` is the overflow word the firmware
+    /// wrote into the render's pass scene. Atomics only: this runs in the fence-signalling
+    /// section of the poll pass.
+    pub(crate) fn overflow_note(&self, count: u32) {
+        GROW_PB[0].fetch_add(1, Ordering::Relaxed);
+        if !pb_grow::overflowed(count) {
+            return;
+        }
+        GROW_PB[1].fetch_add(1, Ordering::Relaxed);
+        GROW_PB[2].fetch_add(u64::from(count), Ordering::Relaxed);
+        GROW_PB[3].fetch_max(u64::from(count), Ordering::Relaxed);
+        if let Some(hint) = self.hint.as_ref() {
+            hint.overflowed(self.assigned.load(Ordering::Acquire) as usize);
+        }
+    }
+    /// `g16_pb_grow`: whether this leased manager was prepared with at least its slot's heap
+    /// backing after the last growth step. Always true with the word off.
+    pub(crate) fn grow_holds(&self) -> bool {
+        if super::params::pb_grow() == 0 {
+            return true;
+        }
+        let slot = self.assigned.load(Ordering::Acquire) as usize;
+        self.hint
+            .as_ref()
+            .map_or(true, |hint| hint.holds(slot, self.capacity_blocks()))
+    }
