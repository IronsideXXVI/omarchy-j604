 );
 
+/// Storage of `g16_pb_grow` (runtime 0644, default 1).
+static PB_GROW: AtomicU32 = AtomicU32::new(1);
+
+/// Parameter-buffer growth from the firmware's overflow word: at each render retirement the word
+/// the fragment start record points at in the render's pass scene (+0x54) is read; a non-zero
+/// word doubles that unit's heap backing at the VM's next submit, up to its window, and leased
+/// managers prepared below the new backing are not reused. Needs `g16_pb_lazy`. On, a lazily
+/// backed heap also starts at `pb_grow::FLOOR_BLOCKS` (2 MiB) instead of the `g16_pb_lazy`
+/// floor, when its unit is built. 0 reads nothing and keeps the `g16_pb_lazy` floor.
+pub(crate) fn pb_grow() -> u32 {
+    PB_GROW.load(Ordering::Relaxed)
+}
+
+live_u32_param!(
+    PB_GROW_PARAM,
+    PB_GROW_PARMTYPE,
+    PB_GROW_PARM,
+    PB_GROW,
+    "g16_pb_grow",
+    "G16: non-zero reads each render's overflow word at retirement and doubles that unit's parameter-buffer backing at the next submit, up to its window, and starts lazily backed heaps at 16 blocks (2 MiB) when their unit is built; needs g16_pb_lazy (default 1; 0: the g16_pb_lazy floor, no reads)"
+);
+
 /// Storage of `g16_pb_size` (runtime 0644, default 0).
 static PB_SIZE: AtomicU32 = AtomicU32::new(0);
 
diff --git a/drivers/gpu/drm/asahi/g16/pb_grow.rs b/drivers/gpu/drm/asahi/g16/pb_grow.rs
new file mode 100644
index 00000000000..c4714f1f753
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16/pb_grow.rs
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! `g16_pb_grow`: the parameter-buffer growth rule (pools.rs), as pure functions.
+//!
+//! The fragment start record points the firmware at a word in the render's pass scene, at the
+//! place where upstream's G14X start record points at the render's TVB overflow count. A render
+//! whose word is not zero at retirement asks its unit's heap backing to double at the VM's
+//! next submit; the allocator caps the step at the heap window. The scene image is rewritten
+//! at publication, so the word read at retirement is that render's.
+
+/// The blocks a lazily backed heap starts with while `g16_pb_grow` is on: 2 MiB, the size the
+/// firmware's overflow word then grows from. macOS idles at 66 blocks (8.25 MiB) of parameter
+/// buffer for all its clients together; four heaps at this floor hold 64.
+pub(crate) const FLOOR_BLOCKS: u32 = 16;
+
+/// The blocks a unit's heap is backed with when the unit is built: `FLOOR_BLOCKS` for a lazily
+/// backed heap with growth on (at most its window), else `first` (the `g16_pb_lazy` floor or
+/// the whole window).
+pub(crate) const fn start(first: u32, lazy: bool, grow: bool, window: u32) -> u32 {
+    if lazy && grow {
+        if FLOOR_BLOCKS < window {
+            FLOOR_BLOCKS
+        } else {
+            window
+        }
+    } else {
+        first
+    }
+}
+
+/// Offset in the pass scene of the word the fragment start record points at (start +0x34).
+pub(crate) const SCENE_OVERFLOWS: usize = 0x54;
+
+/// Whether a render's overflow word asks for growth.
+pub(crate) const fn overflowed(count: u32) -> bool {
+    count != 0
+}
+
+/// The blocks a unit asks for in SUBMIT: at least twice its current backing after a render on
+/// its slot overflowed, else `base` (the `g16_pb_lazy` want). The allocator caps it.
+pub(crate) const fn want(base: u32, backed: u32, overflowed: bool) -> u32 {
+    let twice = backed.saturating_mul(2);
+    if overflowed && twice > base {
+        twice
+    } else {
+        base
+    }
+}
+
+/// Whether a leased manager prepared with `capacity` backed blocks may be reused once its
+/// slot's heap is backed to `backed` blocks: not after a growth step past it, or the new
+/// blocks would reach no render.
+pub(crate) const fn holds(capacity: u32, backed: u32) -> bool {
+    backed <= capacity
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The allocator's step (pools.rs `Allocator::grow`): rounded up to 16, at most the window.
+    fn step(want: u32, backed: u32, window: u32) -> u32 {
+        let t = (want.min(window).div_ceil(16) * 16).min(window);
+        if t <= backed {
+            backed
+        } else {
+            t
+        }
+    }
+
+    #[test]
+    fn no_overflow_asks_the_old_want() {
+        for (base, backed) in [(0, 256), (768, 256), (u32::MAX, 2048)] {
+            assert_eq!(want(base, backed, false), base);
+        }
+    }
+
+    #[test]
+    fn an_overflow_asks_twice_the_backing_or_more() {
+        assert_eq!(want(0, 256, true), 512);
+        assert_eq!(want(4096, 256, true), 4096);
+        assert_eq!(want(0, u32::MAX, true), u32::MAX);
+    }
+
+    #[test]
+    fn a_full_unit_reaches_its_window_in_three_steps_and_stops() {
+        let (window, mut backed, mut steps) = (2048, 256, 0);
+        for _ in 0..10 {
+            let next = step(want(0, backed, true), backed, window);
+            if next == backed {
+                break;
+            }
+            backed = next;
+            steps += 1;
+        }
+        assert_eq!((backed, steps), (2048, 3));
+    }
+
+    #[test]
+    fn a_compact_unit_stops_at_its_window() {
+        let (window, mut backed) = (1024, 128);
+        for _ in 0..10 {
+            backed = step(want(0, backed, true), backed, window);
+        }
+        assert_eq!(backed, 1024);
+    }
+
+    #[test]
+    fn growth_on_starts_a_lazy_heap_at_the_floor() {
+        assert_eq!(start(64, true, true, 2048), 16);
+        assert_eq!(start(64, true, true, 1024), 16);
+        assert_eq!(start(64, true, true, 8), 8);
+    }
+
+    #[test]
+    fn growth_off_or_an_eager_heap_keeps_the_old_start() {
+        assert_eq!(start(64, true, false, 2048), 64);
+        assert_eq!(start(2048, false, true, 2048), 2048);
+        assert_eq!(start(1024, false, false, 1024), 1024);
+    }
+
+    #[test]
+    fn a_full_unit_reaches_its_window_from_the_floor_within_the_growth_steps() {
+        let (window, mut backed, mut steps) = (2048, start(64, true, true, 2048), 0);
+        for _ in 0..20 {
+            let next = step(want(0, backed, true), backed, window);
+            if next == backed {
+                break;
+            }
+            backed = next;
+            steps += 1;
+        }
+        // pools.rs GROW_STEPS is 8: 16 -> 32 -> ... -> 2048 takes 7.
+        assert_eq!((backed, steps), (2048, 7));
+    }
+
+    #[test]
+    fn the_floor_is_a_whole_number_of_growth_rounds() {
+        assert_eq!(FLOOR_BLOCKS % 16, 0);
+        assert!(FLOOR_BLOCKS * 4 <= 66);
+    }
+
+    #[test]
+    fn only_a_non_zero_word_overflows() {
+        assert!(!overflowed(0));
+        assert!(overflowed(1));
+        assert!(overflowed(u32::MAX));
+    }
+
+    #[test]
+    fn a_manager_holds_until_a_step_passes_it() {
+        assert!(holds(256, 0));
+        assert!(holds(256, 256));
+        assert!(!holds(256, 512));
+        assert!(holds(512, 512));
+    }
+}
