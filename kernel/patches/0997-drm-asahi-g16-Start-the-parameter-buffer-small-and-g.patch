     }
+    /// `g16_pb_grow`, at a render's retirement (atomics only): a render on `slot` overflowed.
+    fn overflowed(&self, slot: usize) {
+        if let Some(over) = self.over.get(slot) {
+            over.store(true, Ordering::Relaxed);
+        }
+    }
+    /// `g16_pb_grow`, in SUBMIT: the blocks unit `k` asks for with `backed` blocks backed now
+    /// ([`Self::want`] with the word off). Takes the slot's overflow flag, so a failed step is
+    /// asked again only after a later overflow.
+    pub(crate) fn grow_want(&self, k: usize, backed: u32) -> u32 {
+        if super::params::pb_grow() == 0 {
+            return self.want(k);
+        }
+        let over = self
+            .over
+            .get(k)
+            .is_some_and(|o| o.swap(false, Ordering::Relaxed));
+        if over {
+            GROW_PB[4].fetch_add(1, Ordering::Relaxed);
+        }
+        pb_grow::want(self.want(k), backed, over)
+    }
+    /// `g16_pb_grow`, in SUBMIT after `grow`: unit `k`'s heap is backed to `blocks` (nothing
+    /// with the word off).
+    pub(crate) fn grown(&self, k: usize, blocks: u32) {
+        if super::params::pb_grow() == 0 {
+            return;
+        }
+        if let Some(b) = self.backed.get(k) {
+            b.fetch_max(blocks, Ordering::Relaxed);
+        }
+    }
+    fn holds(&self, slot: usize, capacity: u32) -> bool {
+        self.backed.get(slot).map_or(true, |b| {
+            pb_grow::holds(capacity, b.load(Ordering::Relaxed))
+        })
+    }
     fn sample(&self, slot: usize, used: u32, seeded: u32) {
         if let Some(hw) = self.hw.get(slot) {
             hw.fetch_max(used, Ordering::Relaxed);
@@ -231,7 +293,7 @@ pub(crate) fn sized_blocks(slot: usize, unit: u32) -> u32 {
