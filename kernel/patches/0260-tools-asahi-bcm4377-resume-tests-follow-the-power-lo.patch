From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 03:41:22 +0000
Subject: [PATCH] tools/asahi: bcm4377-resume-tests: follow the
 power-loss reboot

hci_bcm4377's resume now boots the controller firmware again when a
sleep cut its power (power_loss_reboot, default off). That path reads
bcm4377->power_lost, the BAR2 boot stage and RTI status and the BAR0
window, so the fixture failed to compile against it.

Give the fixture the power_lost and bar2 fields, a firmware state
behind ioread32, pm_resume_via_firmware(), pci_read_config_dword()
and an init_cfg stub, and add the cases that cover the new field:
power kept, power lost with the firmware still running, power lost
with the firmware gone, the parameter at its default, and power lost
with the HCI device down (cases 46-50).

Three new mutations check that the cases bite: always-reboot (reboot
even when power was kept), no-reopen (skip reopening the HCI device)
and param-gate (ignore the parameter).

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 tools/asahi/bcm4377-resume-tests.py   | 12 +++++--
 tools/asahi/bcm4377-resume/controls.c | 48 +++++++++++++++++++++++++++
 tools/asahi/bcm4377-resume/fixture.h  | 17 +++++++++-
 tools/asahi/run-host-tests.py         |  3 +-
 4 files changed, 75 insertions(+), 5 deletions(-)

diff --git a/tools/asahi/bcm4377-resume-tests.py b/tools/asahi/bcm4377-resume-tests.py
index 4c7104ff1b..eba8934496 100755
--- a/tools/asahi/bcm4377-resume-tests.py
+++ b/tools/asahi/bcm4377-resume-tests.py
@@ -3,7 +3,7 @@
 """Compile retained Bluetooth resume callbacks against controlled core/PCI services."""
 import argparse, hashlib, json, os, re, resource, subprocess
 from pathlib import Path
-p=argparse.ArgumentParser();p.add_argument('--out',required=True);p.add_argument('--old-ref');p.add_argument('--mutation',choices=['epoch','close','producer-fence','active-fence','board']);a=p.parse_args()
+p=argparse.ArgumentParser();p.add_argument('--out',required=True);p.add_argument('--old-ref');p.add_argument('--mutation',choices=['epoch','close','producer-fence','active-fence','board','always-reboot','no-reopen','param-gate']);a=p.parse_args()
 r=Path(__file__).resolve().parents[2];o=Path(a.out);o.mkdir(parents=True,exist_ok=False);(o/'tmp').mkdir()
 def extract(s,n):
  m=re.search(r'^(?:static )?(?:int|void|bool) '+n+r'\([^;]*?\)\n\{',s,re.M|re.S)
@@ -12,7 +12,7 @@ def extract(s,n):
  while depth:depth+=(s[b]=='{')-(s[b]=='}');b+=1
  return s[m.start():b]+'\n'
 s=(r/'drivers/bluetooth/hci_bcm4377.c').read_text();core=(r/'net/bluetooth/hci_sync.c').read_text();core_hci=(r/'net/bluetooth/hci_core.c').read_text()
-names=['bcm4377_setup_retry_allowed','bcm4377_queue_setup_retry','bcm4377_setup_retry_work','bcm4377_resume_recovery_supported','bcm4377_resume_recovery_allowed','bcm4377_resume_recovery_invalidate','bcm4377_resume_recovery_sync','bcm4377_resume_recovery_destroy','bcm4377_resume_recovery_work','bcm4377_hci_timeout','bcm4377_resume_recovery_stop','bcm4377_hci_open','bcm4377_hci_close','bcm4377_hci_setup_once','bcm4377_hci_setup','bcm4377_hci_post_init','bcm4377_hci_unregister_dev','bcm4377_suspend','bcm4377_resume']
+names=['bcm4377_setup_retry_allowed','bcm4377_queue_setup_retry','bcm4377_setup_retry_work','bcm4377_resume_recovery_supported','bcm4377_resume_recovery_allowed','bcm4377_resume_recovery_invalidate','bcm4377_resume_recovery_sync','bcm4377_resume_recovery_destroy','bcm4377_resume_recovery_work','bcm4377_hci_timeout','bcm4377_resume_recovery_stop','bcm4377_hci_open','bcm4377_hci_close','bcm4377_hci_setup_once','bcm4377_hci_setup','bcm4377_hci_post_init','bcm4377_hci_unregister_dev','bcm4377_suspend','bcm4377_resume','bcm4377_resume_noirq']
 bodies={n:extract(s,n) for n in names};shared=[]
 if a.old_ref:
  old=subprocess.check_output(['git','show',a.old_ref+':drivers/bluetooth/hci_bcm4377.c'],cwd=r,text=True)
@@ -24,6 +24,10 @@ mutations={
  'producer-fence':('bcm4377_resume_recovery_stop','cancel_work_sync(&bcm4377->resume_work);','',21),
  'active-fence':('bcm4377_resume_recovery_stop','flush_work(&bcm4377->hdev->cmd_sync_work);','',40),
  'board':('bcm4377_resume_recovery_supported','of_machine_is_compatible("apple,j493")','true',13),
+ # tb-14f: a retained firmware is never booted again; a lost one is, before the resume commands; only with the parameter.
+ 'always-reboot':('bcm4377_resume_noirq','if (power_loss_reboot &&','if (power_loss_reboot || true ||',47),
+ 'no-reopen':('bcm4377_resume','ret = hci_reset_dev_sync(bcm4377->hdev);','ret = 0;',48),
+ 'param-gate':('bcm4377_resume_noirq','if (power_loss_reboot &&','if (',49),
 }
 if a.mutation:
  n,old,new,case=mutations[a.mutation];assert old in bodies[n];bodies[n]=bodies[n].replace(old,new,1)
@@ -38,6 +42,8 @@ fixture=re.sub(r'^struct bcm4377_hw \{.*?\};', 'typedef uint32_t u32;\n'+hw_stru
 # The variant table names register offsets by macro; take their definitions from the driver.
 hw_macros='\n'+''.join(m.group()+'\n' for name in sorted(set(re.findall(r'\b[A-Z][A-Z0-9_]+\b',hw_table))) for m in [re.search(r'^#define '+name+r'\b.*$',s,re.M)] if m)
 assert 'BAR2_CONTEXT_ADDR_HI' in hw_macros,hw_macros
+# bcm4377_resume_noirq() reads the BAR0 window and the firmware's boot state by these registers.
+hw_macros+=''.join(re.search(r'^#define '+name+r'\b.*$',s,re.M).group()+'\n' for name in ('BCM4377_PCIECFG_BAR0_WINDOW1','BCM4377_BAR2_BOOTSTAGE','BCM4377_BAR2_RTI_STATUS'))
 # bcm4377_suspend() undoes a failed wake arming through bcm4377_resume(), declared ahead of it.
 resume_decl=re.search(r'^static int bcm4377_resume\(struct device \*dev\);$',s,re.M).group()+'\n'
 fixture=fixture.replace('struct bcm4377_hw *hw;', 'const struct bcm4377_hw *hw;')
@@ -56,7 +62,7 @@ c=subprocess.run(['cc','-std=gnu11','-pthread','-Wall','-Wextra','-Wno-unused-fu
 (o/'compile.log').write_text(c.stdout+c.stderr);assert not c.returncode,c.stderr
 def no_core():resource.setrlimit(resource.RLIMIT_CORE,(0,0))
 results=[]
-for n in ([mutations[a.mutation][3]] if a.mutation else [0,1,2,28] if a.old_ref else range(46)):
+for n in ([mutations[a.mutation][3]] if a.mutation else [0,1,2,28] if a.old_ref else range(51)):
  c=subprocess.run([str(o/'controls'),str(n)],capture_output=True,text=True,preexec_fn=no_core,env=dict(env,ASAN_OPTIONS='detect_leaks=1'))
  results.append({'case':n,'exit':c.returncode,'stdout':c.stdout,'stderr':c.stderr})
 expected=-6 if a.old_ref or a.mutation else 0
diff --git a/tools/asahi/bcm4377-resume/controls.c b/tools/asahi/bcm4377-resume/controls.c
index ff558fd981..4916cc6455 100644
--- a/tools/asahi/bcm4377-resume/controls.c
+++ b/tools/asahi/bcm4377-resume/controls.c
@@ -7,6 +7,13 @@ static void deliver_work(struct bcm4377_data *b) {if(b->resume_work.queued){b->r
 static void resume_cycle(struct device *dev) {assert(!bcm4377_suspend(dev));assert(!bcm4377_resume(dev));}
 static void recover(struct bcm4377_data *b) {hci_cmd_timeout(&b->hdev->cmd_timer.work);deliver_work(b);run_request(b->hdev);}
 static void *active_callback(void *data) {run_request(data);return NULL;}
+/* A system sleep with the noirq resume: tb-14f decides there, bcm4377_resume() acts. */
+static void power_cycle(struct device *dev)
+{
+	assert(!bcm4377_suspend(dev));
+	assert(!bcm4377_resume_noirq(dev));
+	assert(!bcm4377_resume(dev));
+}
 static void *producer(void *data) {deliver_work(data);return NULL;}
 static void pause_producer(struct bcm4377_data *b) {bcm4377_hci_timeout(b->hdev);producer_pause=true;pthread_barrier_init(&producer_captured,NULL,2);pthread_barrier_init(&producer_release,NULL,2);pthread_create(&producer_thread,NULL,producer,b);pthread_barrier_wait(&producer_captured);}
 int main(int argc,char **argv) {
@@ -108,6 +115,47 @@ int main(int argc,char **argv) {
 		recover(&b);
 		assert(rebind_count == 1);
 		break;
+	case 46: /* power kept (no resume via firmware): nothing booted, usual unquiesce */
+		power_loss_reboot = true;
+		power_cycle(&dev);
+		assert(!init_cfg_count && !b.power_lost && !reset_count && !open_count);
+		assert(quiesces == 1 && !b.quiesced);
+		break;
+	case 47: /* power cut, firmware retained: windows restored, firmware NOT booted */
+		power_loss_reboot = true;
+		fixture_firmware_resume = true;
+		fixture_fw_state = 2;
+		power_cycle(&dev);
+		assert(init_cfg_count == 1 && fixture_window1 == hw.bar0_window1);
+		assert(!b.power_lost && !b.needs_reset && !reset_count && !open_count);
+		assert(quiesces == 1 && (h.flags & HCI_UP));
+		break;
+	case 48: /* power cut, firmware lost (boot ROM): close + open boot it before resume */
+		power_loss_reboot = true;
+		fixture_firmware_resume = true;
+		fixture_fw_state = 0;
+		power_cycle(&dev);
+		assert(init_cfg_count == 1 && reset_count == 1 && open_count == 1);
+		assert(!b.needs_reset && !b.quiesced && (h.flags & HCI_UP) && !req_locked);
+		break;
+	case 49: /* the same loss with the parameter at its default: nothing booted */
+		fixture_firmware_resume = true;
+		fixture_fw_state = 0;
+		power_cycle(&dev);
+		assert(init_cfg_count == 1 && !b.power_lost && !reset_count && !open_count);
+		break;
+	case 50: /* firmware lost while HCI is down: marked, booted at the next open */
+		power_loss_reboot = true;
+		fixture_firmware_resume = true;
+		fixture_fw_state = 0;
+		h.flags = HCI_RUNNING;
+		power_cycle(&dev);
+		assert(b.power_lost && b.needs_reset && !reset_count && !open_count);
+		req_locked = true;
+		assert(!hci_dev_open_sync(&h));
+		req_locked = false;
+		assert(reset_count == 1 && !b.needs_reset);
+		break;
  default:abort();
  }
 	if (atoi(argv[1]) == 6 || atoi(argv[1]) == 44 || atoi(argv[1]) == 45)
diff --git a/tools/asahi/bcm4377-resume/fixture.h b/tools/asahi/bcm4377-resume/fixture.h
index 225a52b5d0..23e499594f 100644
--- a/tools/asahi/bcm4377-resume/fixture.h
+++ b/tools/asahi/bcm4377-resume/fixture.h
@@ -56,6 +56,8 @@ struct bcm4377_hw { unsigned int id; int (*send_calibration)(struct bcm4377_data
 struct bcm4377_data {
  struct hci_dev *hdev; struct pci_dev *pdev; struct bcm4377_hw *hw;
 	bool wake_armed, quiesced, needs_reset, cal_needed, cal_loaded;
+	bool power_lost;
+	char *bar2;
 	bool setup_retry_used, setup_retry_pending, setup_retry_blocked;
 	struct delayed_work setup_retry_work;
 	bdaddr_t bdaddr;
@@ -128,7 +130,20 @@ static bool device_may_wakeup(struct device *d) { return fixture_wakeup; }
 static void pci_save_state(struct pci_dev *p) {}
 static int enable_irq_wake(int irq) { return 0; }
 static void disable_irq_wake(int irq) {}
-static int ioread32(void *addr) { return 0; }
+/* The firmware's boot state as BAR2 reads it: 0 = boot ROM (firmware lost), else running. */
+static int fixture_fw_state;
+static int ioread32(void *addr) { return fixture_fw_state; }
+/* tb-14f: the module parameter, a resume via firmware, and the private window across it. */
+static bool power_loss_reboot, fixture_firmware_resume;
+static uint32_t fixture_window1;
+static int init_cfg_count;
+static bool pm_resume_via_firmware(void) { return fixture_firmware_resume; }
+static int pci_read_config_dword(struct pci_dev *p, int off, uint32_t *v) { *v = fixture_window1; return 0; }
+static int pcibios_err_to_errno(int e) { return -EIO; }
+static int bcm4377_init_cfg(struct bcm4377_data *b) { init_cfg_count++; fixture_window1 = b->hw->bar0_window1; return 0; }
+#ifndef dev_info
+#define dev_info(...) ((void)0)
+#endif
 static int hci_suspend_dev(struct hci_dev *h);
 static int hci_resume_dev(struct hci_dev *h);
 static void hci_unregister_dev(struct hci_dev *h) {assert(!request.fn&&!active->resume_work.queued&&!active_running);h->flags|=HCI_UNREGISTER;unregistered++;}
