From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 21:04:20 +0000
Subject: [PATCH] soc: apple: sleep: mark the T8132 way into a deep
 sleep in WD2

Every J604 deep sleep so far reset 120 s after .begin, whatever the
alarm (a 90 s alarm moved nothing): no later WD2 write took effect,
neither the commit's 5 s nor the resume stub's 60 s. The machine
stopped somewhere between .begin and the commit.

With wake_entry_marks, restart WD2 at each step on the way in: 130 s
at the end of .prepare, 140 s at .enter, 150 s after the CPU hold,
160 s before the coprocessor stop, 170 s before cpu_suspend and 178 s
after the parked CPUs stop. The reset time then names the step that
never finished. Off by default.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/sleep.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index 50f326854e..568a253d0a 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -133,6 +133,9 @@ struct aura_s2r_mailbox {
 /* The T8132 resume stub and the wake variant picked for the next commit (below). */
 void t8132_resume_stub(void);
 static void *t8132_wake_entry(void);
+static bool wake_entry_marks;
+module_param(wake_entry_marks, bool, 0644);
+MODULE_PARM_DESC(wake_entry_marks, "WD2 marks on the way into a deep sleep: 130 .prepare, 140 .enter, 150, 160, 170 before cpu_suspend, 178 after the park");
 /* The sleep's own safety net: ADT /arm-io/wdt simple-reconfig-wdog-icc-time. */
 #define WDT_SLEEP_SECS		5
 /* Device suspend and resume can take a while, and nothing else recovers a hang in them. */
@@ -2433,6 +2436,16 @@ static void apple_sleep_set_wd2(struct apple_sleep *s, unsigned int secs)
 	writel(1, s->wdt + WDT_WD2_CTL);
 }
 
+/*
+ * With wake_entry_marks, restart WD2 at each step into a deep sleep, so a reset that comes
+ * before the commit's own 5 s says which step it never left (.begin arms 120 s).
+ */
+static void apple_sleep_entry_mark(struct apple_sleep *s, unsigned int secs)
+{
+	if (READ_ONCE(wake_entry_marks) && pm_suspend_via_firmware())
+		apple_sleep_set_wd2(s, secs);
+}
+
 #define PS_PARENT_MISSING	BIT(11)
 #define PS_AUTO_STATE		GENMASK(27, 24)
 #define PS_REWAKE_PASSES	2
@@ -2940,6 +2953,7 @@ static int apple_sleep_commit(unsigned long unused)
 	 */
 	s->siq_cfg = read_sysreg_s(SYS_APL_SIQ_CFG_EL1);
 	s->cpus_stop_ret = spin_table_stop_parked();
+	apple_sleep_entry_mark(s, 178);
 
 	s->soc->ops->lower_io(s);
 	apple_sleep_arm_wd2(s);
@@ -3670,7 +3684,9 @@ static int apple_sleep_enter(suspend_state_t state)
 	ret = apple_sleep_refuse(s);
 	if (ret)
 		return ret;
+	apple_sleep_entry_mark(s, 140);
 	ret = apple_sleep_cpus_hold(s);
+	apple_sleep_entry_mark(s, 150);
 	/* As on macOS, the display goes off before the GPU. */
 	if (!ret)
 		ret = sleep_display_off(s);
@@ -3687,6 +3703,7 @@ static int apple_sleep_enter(suspend_state_t state)
 		apple_sleep_stray_restore(s);
 		return ret;
 	}
+	apple_sleep_entry_mark(s, 160);
 	apple_sleep_coprocs_stop(s, true);
 
 	sleep_wake_arm(s);
@@ -3709,6 +3726,7 @@ static int apple_sleep_enter(suspend_state_t state)
 			dcache_clean_poc((unsigned long)_text, (unsigned long)_end);
 		t8132_wake_marks_set(READ_ONCE(wake_init_marks) ? 3 : 1);
 	}
+	apple_sleep_entry_mark(s, 170);
 	ret = cpu_suspend(0, apple_sleep_commit);
 	if (ret)
 		panic("Apple committed sleep returned without physical wake: %d", ret);
@@ -3979,6 +3997,7 @@ static int apple_sleep_prepare(void)
 		}
 	}
 	apple_sleep_gate_prepare(s);
+	apple_sleep_entry_mark(s, 130);
 
 	return 0;
 }
-- 
2.43.0

