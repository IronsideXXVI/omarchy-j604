From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 03:16:57 +0000
Subject: [PATCH] arm64: suspend: let a platform mark the steps of a
 firmware resume

A J604 deep sleep resets the SoC in its resume stub's 60 s watchdog
window, after the stub and before the sleep driver's first line after
cpu_suspend(): somewhere in cpu_resume, cpu_do_resume,
__cpu_suspend_exit() or the DAIF restore. Nothing survives the reset
but its time, so the only way to name the step is to give each one a
window of its own.

Add a hook the platform may set, called after a resume through
firmware at the first and last lines of __cpu_suspend_exit() and right
before cpu_suspend() restores DAIF. It is NULL unless set, so nothing
changes elsewhere. The Apple sleep driver sets it on T8132 only and
restarts WD2 for 65, 70 and 75 s there, between the stub's 60 s and
apple_sleep_return()'s 80 s. A reset 60 s after the wake then means
the resume assembly itself.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/include/asm/suspend.h | 13 +++++++++++++
 arch/arm64/kernel/suspend.c      | 21 ++++++++++++++++++++-
 drivers/soc/apple/sleep.c        | 30 ++++++++++++++++++++++++++++++
 3 files changed, 63 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/include/asm/suspend.h b/arch/arm64/include/asm/suspend.h
index e9ce68d50b..6147e2d085 100644
--- a/arch/arm64/include/asm/suspend.h
+++ b/arch/arm64/include/asm/suspend.h
@@ -38,6 +38,19 @@ struct sleep_stack_data {
 extern unsigned long *sleep_save_stash;
 
 extern int cpu_suspend(unsigned long arg, int (*fn)(unsigned long));
+
+/*
+ * The steps of the generic return from a suspend that went through firmware, for a
+ * platform that can only tell where a resume stopped from a watchdog's timing. The hook
+ * runs with the MMU on, nothing traced, and must not sleep or fault.
+ */
+enum arm64_suspend_mark {
+	ARM64_SUSPEND_EXIT_FIRST,	/* cpu_resume and cpu_do_resume done */
+	ARM64_SUSPEND_EXIT_LAST,	/* __cpu_suspend_exit() done */
+	ARM64_SUSPEND_DAIF_RESTORE,	/* right before cpu_suspend() restores DAIF */
+};
+
+extern void (*arm64_suspend_mark_hook)(enum arm64_suspend_mark mark);
 extern void cpu_resume(void);
 int __cpu_suspend_enter(struct sleep_stack_data *state);
 void __cpu_suspend_exit(void);
diff --git a/arch/arm64/kernel/suspend.c b/arch/arm64/kernel/suspend.c
index 2a69c79b4e..142ec97529 100644
--- a/arch/arm64/kernel/suspend.c
+++ b/arch/arm64/kernel/suspend.c
@@ -42,10 +42,23 @@ void __init cpu_suspend_set_dbg_restorer(int (*hw_bp_restore)(unsigned int))
 	hw_breakpoint_restore = hw_bp_restore;
 }
 
+void (*arm64_suspend_mark_hook)(enum arm64_suspend_mark mark);
+
+static __always_inline void arm64_suspend_mark(enum arm64_suspend_mark mark)
+{
+	void (*hook)(enum arm64_suspend_mark mark) = READ_ONCE(arm64_suspend_mark_hook);
+
+	if (hook)
+		hook(mark);
+}
+
 void notrace __cpu_suspend_exit(void)
 {
 	unsigned int cpu = smp_processor_id();
 
+	if (pm_resume_via_firmware())
+		arm64_suspend_mark(ARM64_SUSPEND_EXIT_FIRST);
+
 	mte_suspend_exit();
 
 	/*
@@ -91,8 +104,10 @@ void notrace __cpu_suspend_exit(void)
 	 * A firmware-driven system suspend really reset this CPU. Nothing else on
 	 * this path restores implementation-defined state.
 	 */
-	if (pm_resume_via_firmware())
+	if (pm_resume_via_firmware()) {
 		arm64_impdef_cpu_reset_restore();
+		arm64_suspend_mark(ARM64_SUSPEND_EXIT_LAST);
+	}
 }
 
 /*
@@ -107,6 +122,7 @@ int cpu_suspend(unsigned long arg, int (*fn)(unsigned long))
 	int ret = 0;
 	unsigned long flags;
 	struct sleep_stack_data state;
+	bool resumed = false;
 
 	/*
 	 * Some portions of CPU state (e.g. PSTATE.{PAN,DIT}) are initialized
@@ -161,6 +177,7 @@ int cpu_suspend(unsigned long arg, int (*fn)(unsigned long))
 	} else {
 		ct_cpuidle_exit();
 		__cpu_suspend_exit();
+		resumed = true;
 	}
 
 	unpause_graph_tracing();
@@ -170,6 +187,8 @@ int cpu_suspend(unsigned long arg, int (*fn)(unsigned long))
 	 * restored, so from this point onwards, debugging is fully
 	 * reenabled if it was enabled when core started shutdown.
 	 */
+	if (resumed && pm_resume_via_firmware())
+		arm64_suspend_mark(ARM64_SUSPEND_DAIF_RESTORE);
 	local_daif_restore(flags);
 
 	return ret;
diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index a9bf57c1de..b097a3d1a8 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -200,6 +200,10 @@ static_assert(AURA_S2R_CHECKED_SIZE + sizeof(struct aura_s2r_slc) == AURA_S2R_SL
 #define WDT_REWAKE_SECS		100
 /* Last on the way back: SError unmasked again, before device resume. */
 #define WDT_UNMASK_SECS		140
+/* Inside the generic return, T8132: see t8132_return_mark(). */
+#define WDT_EXIT_FIRST_SECS	65
+#define WDT_EXIT_LAST_SECS	70
+#define WDT_DAIF_SECS		75
 /* ISR_EL1.A: an SError pending */
 #define SLEEP_ISR_A		BIT(8)
 
@@ -2476,6 +2480,30 @@ static void apple_sleep_lower_io(struct apple_sleep *s)
 	}
 }
 
+/*
+ * T8132's way back stops between the resume stub's 60 s window and apple_sleep_return()'s
+ * 80 s. These split the generic return in between, so a reset names the step: 60 the
+ * resume assembly itself, 65 the first line of __cpu_suspend_exit(), 70 its last, 75 the
+ * DAIF restore. Plain writes, no call: it runs before the idmap is gone.
+ */
+static notrace void t8132_return_mark(enum arm64_suspend_mark mark)
+{
+	static const u8 secs[] = {
+		[ARM64_SUSPEND_EXIT_FIRST] = WDT_EXIT_FIRST_SECS,
+		[ARM64_SUSPEND_EXIT_LAST] = WDT_EXIT_LAST_SECS,
+		[ARM64_SUSPEND_DAIF_RESTORE] = WDT_DAIF_SECS,
+	};
+	void __iomem *wdt;
+
+	if (!apple_sleep || mark >= ARRAY_SIZE(secs))
+		return;
+	wdt = apple_sleep->wdt;
+	writel(0, wdt + WDT_WD2_CTL);
+	writel(0, wdt + WDT_WD2_COUNT);
+	writel(secs[mark] * WDT_TICKS_PER_S, wdt + WDT_WD2_ALARM);
+	writel(1, wdt + WDT_WD2_CTL);
+}
+
 static void apple_sleep_set_wd2(struct apple_sleep *s, unsigned int secs)
 {
 	writel(0, s->wdt + WDT_WD2_CTL);
@@ -4350,6 +4378,8 @@ static int apple_sleep_probe(struct platform_device *pdev)
 
 	/* Last: the exported helpers take it as a probed driver, and a failure frees s. */
 	apple_sleep = s;
+	if (s->soc->commit == t8132_sleep_commit)
+		WRITE_ONCE(arm64_suspend_mark_hook, t8132_return_mark);
 	/* Deep becomes the default sleep state, unless mem_sleep_default= chose another. */
 	suspend_set_ops(&apple_sleep_ops);
 	/* Userspace may still pick deep through /sys/power/mem_sleep. */
-- 
2.43.0

