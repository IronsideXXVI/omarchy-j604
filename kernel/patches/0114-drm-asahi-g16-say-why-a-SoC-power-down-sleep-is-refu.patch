 drivers/gpu/drm/asahi/g16/sleep.rs        | 58 +++++++++++++++++++++++
 drivers/gpu/drm/asahi/g16/sleep/policy.rs | 51 ++++++++++++++++++++
 3 files changed, 116 insertions(+)
 create mode 100644 drivers/gpu/drm/asahi/g16/sleep.rs
 create mode 100644 drivers/gpu/drm/asahi/g16/sleep/policy.rs

