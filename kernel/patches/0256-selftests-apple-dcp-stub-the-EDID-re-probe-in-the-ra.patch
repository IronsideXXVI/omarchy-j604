From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Wed, 11 Nov 2026 03:49:29 +1100
Subject: [PATCH] selftests: apple-dcp: stub the EDID re-probe in the
 rate harness

The publication-hpd and panel-dimensions scenarios build the real
dcp_get_modes(), which now calls dcpavserv_edid_retry() and
dcpavserv_edid_retry_reset(). Their EDID read always returns an EDID, so
the re-probe must never be asked for; the reset runs under the AV
service lock.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit 330e988e7de52a88cd0f2c2b7fe89c1501803a73)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 tools/testing/selftests/drivers/gpu/apple-dcp/rate.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/rate.py b/tools/testing/selftests/drivers/gpu/apple-dcp/rate.py
index c4c92d244f..34df0691db 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/rate.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/rate.py
@@ -775,6 +775,9 @@ static void afk_service_retire(struct apple_epic_service *s) { assert(!*hpd_lock
 static bool cancel_work_sync(struct work_struct *w) { assert(!w->scheduled); return false; }
 /* Native audio is out of scope: reject entry instead of silently queueing it. */
 static void dcp_external_audio_start(struct apple_dcp *d) { assert(!d->external_native); }
+/* The stubbed read always carries an EDID: nothing asks for a re-probe. */
+static bool dcpavserv_edid_retry(struct apple_dcp *d,u64 e) { (void)d;(void)e;assert(0);return false; }
+static void dcpavserv_edid_retry_reset(struct apple_dcp *d) { assert(d->dcpavserv.lock); }
 static void dpavservep_detach(struct apple_dcp *d);
 static struct apple_dcp *probing;
 static struct drm_edid transport_edid;
