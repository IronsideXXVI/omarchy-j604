From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:11 -0500
Subject: [PATCH] soc: apple: mailbox: add the secure RTBuddy port and sleep
 helpers

A coprocessor can have a second mailbox, the ADT's
iop,secure-rtbuddy-proxy, for its secure side. It has the registers of
the AOP setup port. Its interrupts aren't described yet, so this variant
has none and its consumer polls. Match the generic compatible, since the
node isn't specific to one SoC.

Firmware that powers itself down for a system sleep needs more from its
mailbox:

- A way to clear and set bit 0 of the receive control word around the
  stop, as macOS does.
- A check for a free send slot that works with interrupts off, where
  apple_mbox_send()'s own deadline can't pass.
- For an ASCWrap v6 CPU whose stop moves to the sleep's last step, with
  interrupts off and one CPU up, where neither the lifecycle lock nor
  runtime PM can be taken: its control word for polling its status, the
  stop's register writes alone, and a call that settles the books after
  the sleep without touching the registers, so that the next start goes
  through.

The wait for room to send now ends only on a fatal signal. The freezer
signals every user task as a system sleep begins, and a message half
sent can break a coprocessor's handshake.

Rust bindings cover the receive control and holding and releasing
receive.

Signed-off-by: Diljit Singh <hey@djdev.me>

[j604 backport: only the commit's own changes: send_ready, set_recv_enabled, ASCWrap v6 cpu_control/stop_cpu_atomic/cpu_stopped (run_off split from our v6 stop), killable send wait, polled secure-rtbuddy port (no node in the J604 ADT template: 0 matches), IRQ guards; conflict context was Aurora-only (ASCWrap v8 PSD, v8 RX poller, G17 threaded IRQ, counted FIFO, get_cpu_state) and is not taken]
Assisted-by: Claude:claude-opus-5.5

---
 drivers/soc/apple/mailbox.c       | 171 ++++++++++++++++++++++++------
 include/linux/soc/apple/mailbox.h |  12 +++
 rust/kernel/soc/apple/mailbox.rs  |  18 ++++
 3 files changed, 170 insertions(+), 31 deletions(-)

diff --git a/drivers/soc/apple/mailbox.c b/drivers/soc/apple/mailbox.c
index 52b9cabd2b..73aa031e2c 100644
--- a/drivers/soc/apple/mailbox.c
+++ b/drivers/soc/apple/mailbox.c
@@ -42,6 +42,7 @@
 #define APPLE_ASC_MBOX_A2I_RECV1 0x818
 
 #define APPLE_ASC_MBOX_I2A_CONTROL 0x114
+#define APPLE_ASC_MBOX_CONTROL_RECV_ENABLE BIT(0)
 #define APPLE_ASC_MBOX_I2A_SEND0 0x820
 #define APPLE_ASC_MBOX_I2A_SEND1 0x828
 #define APPLE_ASC_MBOX_I2A_RECV0 0x830
@@ -122,6 +123,8 @@ struct apple_mbox_hw {
 	unsigned int reg_offset;
 	bool is_ascwrap_v6;
 	bool ap_initializes_mailboxes;
+	/* No interrupts: the consumer calls apple_mbox_poll() while it expects traffic. */
+	bool polled;
 
 	unsigned int control_full;
 	unsigned int control_empty;
@@ -172,14 +175,11 @@ int apple_mbox_ascwrap_v6_require_safe_cpu_lifecycle(struct apple_mbox *mbox)
 }
 EXPORT_SYMBOL_GPL(apple_mbox_ascwrap_v6_require_safe_cpu_lifecycle);
 
-static void apple_mbox_ascwrap_v6_stop_cpu_locked(struct apple_mbox *mbox)
+static void apple_mbox_ascwrap_v6_run_off(struct apple_mbox *mbox)
 {
 	void __iomem *cpu_control;
 	u32 val;
 
-	if (!mbox->ascwrap_v6_cpu_running)
-		return;
-
 	cpu_control = (u8 __iomem *)mbox->wrapper_regs +
 		      APPLE_ASCWRAP_V6_CPU_CONTROL;
 
@@ -188,12 +188,25 @@ static void apple_mbox_ascwrap_v6_stop_cpu_locked(struct apple_mbox *mbox)
 	writel(val & ~APPLE_ASCWRAP_V6_CPU_RUN, cpu_control);
 	val = readl(cpu_control);
 	writel(val & ~APPLE_ASCWRAP_V6_CPU_STOP_SECOND_CLEAR, cpu_control);
+}
+
 
+static void apple_mbox_ascwrap_v6_stopped_locked(struct apple_mbox *mbox)
+{
 	mbox->ascwrap_v6_cpu_running = false;
 	pm_runtime_mark_last_busy(mbox->dev);
 	pm_runtime_put_autosuspend(mbox->dev);
 }
 
+static void apple_mbox_ascwrap_v6_stop_cpu_locked(struct apple_mbox *mbox)
+{
+	if (!mbox->ascwrap_v6_cpu_running)
+		return;
+
+	apple_mbox_ascwrap_v6_run_off(mbox);
+	apple_mbox_ascwrap_v6_stopped_locked(mbox);
+}
+
 /*
  * A failed resume leaves the runtime PM error set, and runtime PM then fails
  * every later resume with -EINVAL without retrying the power domain.  The
@@ -271,6 +284,44 @@ out_unlock:
 }
 EXPORT_SYMBOL_GPL(apple_mbox_ascwrap_v6_stop_cpu);
 
+void __iomem *apple_mbox_ascwrap_v6_cpu_control(struct apple_mbox *mbox)
+{
+	if (!mbox || !mbox->hw->is_ascwrap_v6 || !mbox->wrapper_regs)
+		return NULL;
+
+	return (u8 __iomem *)mbox->wrapper_regs + APPLE_ASCWRAP_V6_CPU_CONTROL;
+}
+EXPORT_SYMBOL_GPL(apple_mbox_ascwrap_v6_cpu_control);
+
+/* No lock and no runtime PM: the registers alone, as apple_mbox_ascwrap_v6_stop_cpu() has them. */
+void apple_mbox_ascwrap_v6_stop_cpu_atomic(struct apple_mbox *mbox)
+{
+	if (!mbox || !mbox->hw->is_ascwrap_v6 || !mbox->wrapper_regs ||
+	    !READ_ONCE(mbox->ascwrap_v6_cpu_running))
+		return;
+
+	apple_mbox_ascwrap_v6_run_off(mbox);
+}
+EXPORT_SYMBOL_GPL(apple_mbox_ascwrap_v6_stop_cpu_atomic);
+
+int apple_mbox_ascwrap_v6_cpu_stopped(struct apple_mbox *mbox)
+{
+	int ret = 0;
+
+	if (!mbox || !mbox->hw->is_ascwrap_v6 || !mbox->wrapper_regs)
+		return -EOPNOTSUPP;
+
+	mutex_lock(&mbox->lifecycle_lock);
+	if (mbox->removing)
+		ret = -ENODEV;
+	else if (mbox->ascwrap_v6_cpu_running)
+		apple_mbox_ascwrap_v6_stopped_locked(mbox);
+	mutex_unlock(&mbox->lifecycle_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_mbox_ascwrap_v6_cpu_stopped);
+
 int apple_mbox_send(struct apple_mbox *mbox, const struct apple_mbox_msg msg,
 		    bool atomic)
 {
@@ -336,7 +387,8 @@ int apple_mbox_send(struct apple_mbox *mbox, const struct apple_mbox_msg msg,
 		 * it unmasked for them. The handler masks it when it fires,
 		 * and removal masks it otherwise.
 		 */
-		t = wait_for_completion_interruptible_timeout(
+		/* Not for the freezer's signal: a message half sent can break a handshake. */
+		t = wait_for_completion_killable_timeout(
 			&mbox->tx_empty,
 			min(remaining, msecs_to_jiffies(APPLE_MBOX_TX_RECHECK_MS)));
 		if (t < 0)
@@ -438,6 +490,12 @@ static irqreturn_t apple_mbox_recv_irq(int irq, void *data)
 	return IRQ_HANDLED;
 }
 
+bool apple_mbox_send_ready(struct apple_mbox *mbox)
+{
+	return !(readl_relaxed(mbox->regs + mbox->hw->a2i_control) & mbox->hw->control_full);
+}
+EXPORT_SYMBOL(apple_mbox_send_ready);
+
 int apple_mbox_poll(struct apple_mbox *mbox)
 {
 	unsigned long flags;
@@ -501,7 +559,8 @@ int apple_mbox_start(struct apple_mbox *mbox)
 
 	apple_mbox_enable_hw(mbox);
 
-	enable_irq(mbox->irq_recv_not_empty);
+	if (mbox->irq_recv_not_empty >= 0)
+		enable_irq(mbox->irq_recv_not_empty);
 	mbox->active = true;
 
 out_unlock:
@@ -516,7 +575,8 @@ static void apple_mbox_stop_locked(struct apple_mbox *mbox)
 		return;
 
 	mbox->active = false;
-	disable_irq(mbox->irq_recv_not_empty);
+	if (mbox->irq_recv_not_empty >= 0)
+		disable_irq(mbox->irq_recv_not_empty);
 	pm_runtime_mark_last_busy(mbox->dev);
 	pm_runtime_put_autosuspend(mbox->dev);
 }
@@ -548,15 +608,36 @@ int apple_mbox_restore(struct apple_mbox *mbox)
 }
 EXPORT_SYMBOL(apple_mbox_restore);
 
+/*
+ * Bit 0 of the receive control word, read and written back. A client whose
+ * firmware powers itself down clears it when the firmware has answered, and sets
+ * it before starting the firmware again. That it gates receiving is inferred.
+ */
+void apple_mbox_set_recv_enabled(struct apple_mbox *mbox, bool enabled)
+{
+	unsigned long flags;
+	u32 val;
+
+	spin_lock_irqsave(&mbox->rx_lock, flags);
+	val = readl_relaxed(mbox->regs + mbox->hw->i2a_control);
+	val = enabled ? val | APPLE_ASC_MBOX_CONTROL_RECV_ENABLE :
+			val & ~APPLE_ASC_MBOX_CONTROL_RECV_ENABLE;
+	writel_relaxed(val, mbox->regs + mbox->hw->i2a_control);
+	spin_unlock_irqrestore(&mbox->rx_lock, flags);
+}
+EXPORT_SYMBOL_GPL(apple_mbox_set_recv_enabled);
+
 void apple_mbox_hold_rx(struct apple_mbox *mbox)
 {
-	disable_irq(mbox->irq_recv_not_empty);
+	if (mbox->irq_recv_not_empty >= 0)
+		disable_irq(mbox->irq_recv_not_empty);
 }
 EXPORT_SYMBOL(apple_mbox_hold_rx);
 
 void apple_mbox_release_rx(struct apple_mbox *mbox)
 {
-	enable_irq(mbox->irq_recv_not_empty);
+	if (mbox->irq_recv_not_empty >= 0)
+		enable_irq(mbox->irq_recv_not_empty);
 }
 EXPORT_SYMBOL(apple_mbox_release_rx);
 
@@ -595,7 +676,8 @@ static void apple_mbox_quiesce(void *data)
 	mbox->active = false;
 	mutex_unlock(&mbox->lifecycle_lock);
 	if (was_active) {
-		disable_irq(mbox->irq_recv_not_empty);
+		if (mbox->irq_recv_not_empty >= 0)
+			disable_irq(mbox->irq_recv_not_empty);
 		pm_runtime_mark_last_busy(mbox->dev);
 		pm_runtime_put_autosuspend(mbox->dev);
 	}
@@ -611,7 +693,8 @@ static void apple_mbox_quiesce(void *data)
 	if (mbox->irq_send_empty >= 0)
 		synchronize_irq(mbox->irq_send_empty);
 	complete_all(&mbox->tx_empty);
-	synchronize_irq(mbox->irq_recv_not_empty);
+	if (mbox->irq_recv_not_empty >= 0)
+		synchronize_irq(mbox->irq_recv_not_empty);
 
 	spin_lock_irqsave(&mbox->rx_lock, flags);
 	had_rx = mbox->rx;
@@ -763,34 +846,41 @@ static int apple_mbox_probe(struct platform_device *pdev)
 		mbox->regs = (u8 __iomem *)mbox->regs + mbox->hw->reg_offset;
 	}
 
-	mbox->irq_recv_not_empty =
-		platform_get_irq_byname(pdev, "recv-not-empty");
-	if (mbox->irq_recv_not_empty < 0)
-		return mbox->irq_recv_not_empty;
+	if (mbox->hw->polled) {
+		mbox->irq_recv_not_empty = -ENXIO;
+		mbox->irq_send_empty = -ENXIO;
+	} else {
+		mbox->irq_recv_not_empty =
+			platform_get_irq_byname(pdev, "recv-not-empty");
+		if (mbox->irq_recv_not_empty < 0)
+			return mbox->irq_recv_not_empty;
 
-	/*
-	 * Some coprocessors (e.g. the T6021 ANE ASC) have no send-empty line.
-	 * apple_mbox_send then polls the A2I control register instead.
-	 */
-	mbox->irq_send_empty =
-		platform_get_irq_byname_optional(pdev, "send-empty");
-	if (mbox->irq_send_empty < 0 && mbox->irq_send_empty != -ENXIO)
-		return mbox->irq_send_empty;
+		/*
+		 * Some coprocessors (e.g. the T6021 ANE ASC) have no send-empty line.
+		 * apple_mbox_send then polls the A2I control register instead.
+		 */
+		mbox->irq_send_empty =
+			platform_get_irq_byname_optional(pdev, "send-empty");
+		if (mbox->irq_send_empty < 0 && mbox->irq_send_empty != -ENXIO)
+			return mbox->irq_send_empty;
+	}
 
 	spin_lock_init(&mbox->rx_lock);
 	spin_lock_init(&mbox->tx_lock);
 	mutex_init(&mbox->lifecycle_lock);
 	init_completion(&mbox->tx_empty);
 
-	irqname = devm_kasprintf(dev, GFP_KERNEL, "%s-recv", dev_name(dev));
-	if (!irqname)
-		return -ENOMEM;
+	if (mbox->irq_recv_not_empty >= 0) {
+		irqname = devm_kasprintf(dev, GFP_KERNEL, "%s-recv", dev_name(dev));
+		if (!irqname)
+			return -ENOMEM;
 
-	ret = devm_request_irq(dev, mbox->irq_recv_not_empty,
-			       apple_mbox_recv_irq,
-			       IRQF_NO_AUTOEN | IRQF_NO_SUSPEND, irqname, mbox);
-	if (ret)
-		return ret;
+		ret = devm_request_irq(dev, mbox->irq_recv_not_empty,
+				       apple_mbox_recv_irq,
+				       IRQF_NO_AUTOEN | IRQF_NO_SUSPEND, irqname, mbox);
+		if (ret)
+			return ret;
+	}
 
 	if (mbox->irq_send_empty >= 0) {
 		irqname = devm_kasprintf(dev, GFP_KERNEL, "%s-send",
@@ -906,6 +996,24 @@ static const struct apple_mbox_hw apple_mbox_t8140_aop_setup_hw = {
 	.has_irq_controls = false,
 };
 
+/* The kind of port the secure RTBuddy proxy has, with the AOP setup port's registers. */
+static const struct apple_mbox_hw apple_mbox_secure_rtbuddy_hw = {
+	.polled = true,
+
+	.control_full = APPLE_ASC_MBOX_CONTROL_FULL,
+	.control_empty = APPLE_ASC_MBOX_CONTROL_EMPTY,
+
+	.a2i_control = APPLE_T8140_AOP_SETUP_A2I_CONTROL,
+	.a2i_send0 = APPLE_T8140_AOP_SETUP_A2I_SEND0,
+	.a2i_send1 = APPLE_T8140_AOP_SETUP_A2I_SEND1,
+
+	.i2a_control = APPLE_T8140_AOP_SETUP_I2A_CONTROL,
+	.i2a_recv0 = APPLE_T8140_AOP_SETUP_I2A_RECV0,
+	.i2a_recv1 = APPLE_T8140_AOP_SETUP_I2A_RECV1,
+
+	.has_irq_controls = false,
+};
+
 static const struct apple_mbox_hw apple_mbox_m3_hw = {
 	.control_full = APPLE_M3_MBOX_CONTROL_FULL,
 	.control_empty = APPLE_M3_MBOX_CONTROL_EMPTY,
@@ -930,6 +1038,7 @@ static const struct of_device_id apple_mbox_of_match[] = {
 	{ .compatible = "apple,t8122-agx-asc-mailbox", .data = &apple_mbox_asc_hw },
 	{ .compatible = "apple,t8140-ascwrap-v6", .data = &apple_mbox_ascwrap_v6_hw },
 	{ .compatible = "apple,t8140-asc-mailbox", .data = &apple_mbox_t8140_asc_hw },
+	{ .compatible = "apple,secure-rtbuddy-proxy", .data = &apple_mbox_secure_rtbuddy_hw },
 	{ .compatible = "apple,t8140-aop-setup-mailbox", .data = &apple_mbox_t8140_aop_setup_hw },
 	/*
 	 * t6030 gfx-asc mailbox in the boot.bin DTB: it carries no asc-mailbox-v4 fallback so that
diff --git a/include/linux/soc/apple/mailbox.h b/include/linux/soc/apple/mailbox.h
index 6f7b4a5d2a..4d39d50f9e 100644
--- a/include/linux/soc/apple/mailbox.h
+++ b/include/linux/soc/apple/mailbox.h
@@ -93,7 +93,11 @@ struct apple_mbox *apple_mbox_get_byname(struct device *dev, const char *name);
 int apple_mbox_start(struct apple_mbox *mbox);
 void apple_mbox_stop(struct apple_mbox *mbox);
 int apple_mbox_restore(struct apple_mbox *mbox);
+/* For a caller with interrupts off, where apple_mbox_send()'s own deadline can't pass. */
+bool apple_mbox_send_ready(struct apple_mbox *mbox);
 int apple_mbox_poll(struct apple_mbox *mbox);
+/* Bit 0 of the receive control word, for firmware that powers itself down. */
+void apple_mbox_set_recv_enabled(struct apple_mbox *mbox, bool enabled);
 /*
  * Leave received messages in the hardware FIFO, without an interrupt, until
  * apple_mbox_release_rx().  For consumers that must not wake the system.
@@ -109,5 +113,13 @@ int apple_mbox_ascwrap_v6_get_lifecycle(
 int apple_mbox_ascwrap_v6_require_safe_cpu_lifecycle(struct apple_mbox *mbox);
 int apple_mbox_ascwrap_v6_start_cpu(struct apple_mbox *mbox);
 int apple_mbox_ascwrap_v6_stop_cpu(struct apple_mbox *mbox);
+/*
+ * For a CPU that a system sleep's last step stops with interrupts off: its control word, for
+ * polling its status, and the stop's register writes alone. Once the sleep is over,
+ * apple_mbox_ascwrap_v6_cpu_stopped() settles the books without touching the registers.
+ */
+void __iomem *apple_mbox_ascwrap_v6_cpu_control(struct apple_mbox *mbox);
+void apple_mbox_ascwrap_v6_stop_cpu_atomic(struct apple_mbox *mbox);
+int apple_mbox_ascwrap_v6_cpu_stopped(struct apple_mbox *mbox);
 
 #endif
diff --git a/rust/kernel/soc/apple/mailbox.rs b/rust/kernel/soc/apple/mailbox.rs
index c4f86930e3..03b17af885 100644
--- a/rust/kernel/soc/apple/mailbox.rs
+++ b/rust/kernel/soc/apple/mailbox.rs
@@ -96,6 +96,24 @@ impl<T: MailCallback> Mailbox<T> {
         // SAFETY: Calling the c function, `mbox` is a valid pointer
         to_result(unsafe { bindings::apple_mbox_send(self.mbox, msg, atomic) })
     }
+
+    /// Sets bit 0 of the receive control word, for firmware that powers itself down.
+    pub fn set_recv_enabled(&self, enabled: bool) {
+        // SAFETY: Calling the c function, `mbox` is a valid pointer
+        unsafe { bindings::apple_mbox_set_recv_enabled(self.mbox, enabled) };
+    }
+
+    /// Stops taking receive interrupts, so that no handler reads the mailbox.
+    pub fn hold_rx(&self) {
+        // SAFETY: Calling the c function, `mbox` is a valid pointer
+        unsafe { bindings::apple_mbox_hold_rx(self.mbox) };
+    }
+
+    /// Undoes [`Self::hold_rx`].
+    pub fn release_rx(&self) {
+        // SAFETY: Calling the c function, `mbox` is a valid pointer
+        unsafe { bindings::apple_mbox_release_rx(self.mbox) };
+    }
 }
 
 impl<T: MailCallback> Drop for Mailbox<T> {
