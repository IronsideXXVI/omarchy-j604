From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 02:47:48 +0000
Subject: [PATCH] media: apple: isp: list the call sizes before the
 first stream on request

The driver adds common call sizes (640x480, 1280x960, a square) that fit
inside a device tree preset's crop. They depend on the presets alone.
On a deferred start (T8132) they are added only when the camera is
detected, at the first stream of a boot, so an application that lists
the formats before that sees the two device tree presets only, and a
second application sees five.

Behind the new apple_isp.early_call_sizes parameter, off by default and
read at probe, add them from probe on such a SoC, and skip the second
addition at the detection. The sizes are the same either way: they come
from the same presets with the same code.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-cam.c | 25 +++++++++++++++++++++-
 drivers/media/platform/apple/isp/isp-cam.h |  1 +
 drivers/media/platform/apple/isp/isp-drv.c |  6 ++++++
 drivers/media/platform/apple/isp/isp-drv.h |  2 ++
 4 files changed, 33 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 908faa71b1..3b59028062 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -510,6 +510,29 @@ static int isp_add_call_sizes(struct apple_isp *isp)
 	return 0;
 }
 
+/*
+ * The call sizes come from the device tree presets alone, so a deferred start
+ * can offer them before the firmware runs. Without this, an application that
+ * lists the formats before the first stream of a boot sees only the presets.
+ */
+static bool early_call_sizes;
+module_param(early_call_sizes, bool, 0444);
+MODULE_PARM_DESC(early_call_sizes,
+		 "Deferred-start SoCs: list the derived call sizes from probe instead of after the first stream (default: off)");
+
+int apple_isp_add_early_call_sizes(struct apple_isp *isp)
+{
+	int err;
+
+	if (!early_call_sizes || !isp->hw->deferred_start)
+		return 0;
+
+	err = isp_add_call_sizes(isp);
+	if (!err)
+		isp->call_sizes_added = true;
+	return err;
+}
+
 static int isp_ch_cache_sensor_info(struct apple_isp *isp, u32 ch)
 {
 	struct isp_format *fmt = isp_get_format(isp, ch);
@@ -561,7 +584,7 @@ static int isp_ch_cache_sensor_info(struct apple_isp *isp, u32 ch)
 		err = isp_ch_cache_sensor_configs(isp, ch, args->num_presets);
 	if (!err)
 		isp_ch_read_sensor_configs(isp, ch, args->num_presets);
-	if (!err)
+	if (!err && !isp->call_sizes_added)
 		err = isp_add_call_sizes(isp);
 
 exit:
diff --git a/drivers/media/platform/apple/isp/isp-cam.h b/drivers/media/platform/apple/isp/isp-cam.h
index 51c2f2ec6c..557a1aaa7c 100644
--- a/drivers/media/platform/apple/isp/isp-cam.h
+++ b/drivers/media/platform/apple/isp/isp-cam.h
@@ -14,6 +14,7 @@
 #define ISP_FRAME_RATE_DEFAULT 30
 
 int apple_isp_detect_camera(struct apple_isp *isp);
+int apple_isp_add_early_call_sizes(struct apple_isp *isp);
 
 int apple_isp_start_camera(struct apple_isp *isp);
 void apple_isp_stop_camera(struct apple_isp *isp);
diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index d242afc9ff..ce24b26f5e 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -901,6 +901,12 @@ static int apple_isp_probe(struct platform_device *pdev)
 		}
 	}
 
+	err = apple_isp_add_early_call_sizes(isp);
+	if (err) {
+		dev_err(dev, "failed to add the call sizes: %d\n", err);
+		goto halt_firmware;
+	}
+
 	err = apple_isp_setup_video(isp);
 	if (err) {
 		dev_err(dev, "failed to register video device: %d\n", err);
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index b92b4ae659..991769d068 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -444,6 +444,8 @@ struct apple_isp {
 	struct delayed_work fw_idle_work;
 	/* the camera was detected; until then a deferred start is pending */
 	bool camera_detected;
+	/* the crop-derived call sizes are in the presets already */
+	bool call_sizes_added;
 	/* configurations the firmware has, once a deferred start detected them */
 	u32 num_fw_presets;
 
-- 
2.43.0

