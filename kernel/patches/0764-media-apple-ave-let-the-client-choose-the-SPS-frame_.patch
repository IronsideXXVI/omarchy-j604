+++ b/drivers/media/platform/apple/ave/ave-v4l2.c
@@ -536,6 +536,13 @@ static int ave_s_ctrl(struct v4l2_ctrl *ctrl)
 	case V4L2_CID_APPLE_AVE_PRIORITIZE_SPEED:
 		ctx->prioritize_speed = ctrl->val;
 		break;
+	case V4L2_CID_APPLE_AVE_H264_LOG2_MAX_FRAME_NUM_MINUS4:
