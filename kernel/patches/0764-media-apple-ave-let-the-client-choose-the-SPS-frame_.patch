diff --git a/drivers/media/platform/apple/ave/ave-abi-test.c b/drivers/media/platform/apple/ave/ave-abi-test.c
index 67c496da6c..db1887d456 100644
--- a/drivers/media/platform/apple/ave/ave-abi-test.c
+++ b/drivers/media/platform/apple/ave/ave-abi-test.c
@@ -336,6 +336,111 @@ static void ave_9003_speed(struct kunit *test)
 	}
 }
 
+/*
+ * Client sequence words on 9003: unset, Start keeps the macOS constants
+ * (1, 0, 2; HEVC 7) byte for byte; set, only those words change. The test
+ * probe parser takes aligned words inside the sequence block only.
+ */
+static void ave_9003_client_sps(struct kunit *test)
+{
+	static const u32 h264_off[] = { 0x2d34, 0x2d38, 0x2d3c };
+	struct ave_dev *ave = kunit_kzalloc(test, sizeof(*ave), GFP_KERNEL);
+	struct ave_ctx *ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	struct ave_session *sess = kunit_kzalloc(test, sizeof(*sess), GFP_KERNEL);
+	u8 *base = kunit_kzalloc(test, 0x14000, GFP_KERNEL);
+	u8 *set = kunit_kzalloc(test, 0x14000, GFP_KERNEL);
+	u32 off[AVE_SPS_PROBE_MAX], val[AVE_SPS_PROBE_MAX];
+
+	KUNIT_ASSERT_NOT_NULL(test, ave);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	KUNIT_ASSERT_NOT_NULL(test, sess);
+	KUNIT_ASSERT_NOT_NULL(test, base);
+	KUNIT_ASSERT_NOT_NULL(test, set);
+	ave->layout = &ave_layout_9003_78_0;
+	ctx->ave = ave;
+	ctx->sess = sess;
+
+	for (enum ave_codec codec = AVE_CODEC_H264; codec <= AVE_CODEC_HEVC; codec++) {
+		size_t len = ave->layout->bytes[codec - 1][AVE_IMAGE_START];
+		bool h264 = codec == AVE_CODEC_H264;
+
+		ave_test_session(sess, codec, 1920, 1080, false);
+		memset(base, 0, len);
+		KUNIT_ASSERT_EQ(test, ave_build_start(ctx, base, len), 0);
+		ave_test_session(sess, codec, 1920, 1080, false);
+		sess->p.sps_set = BIT(AVE_SPS_COUNT) - 1;
+		sess->p.sps_val[AVE_SPS_H264_LOG2_MAX_FRAME_NUM_MINUS4] = 4;
+		sess->p.sps_val[AVE_SPS_H264_POC_TYPE] = 2;
+		sess->p.sps_val[AVE_SPS_H264_LOG2_MAX_POC_LSB_MINUS4] = 3;
+		sess->p.sps_val[AVE_SPS_HEVC_LOG2_MAX_POC_LSB_MINUS4] = 8;
+		memset(set, 0, len);
+		KUNIT_ASSERT_EQ(test, ave_build_start(ctx, set, len), 0);
+		if (h264) {
+			KUNIT_EXPECT_EQ(test, get_unaligned_le32(base + 0x2d34), 1);
+			KUNIT_EXPECT_EQ(test, get_unaligned_le32(base + 0x2d38), 0);
+			KUNIT_EXPECT_EQ(test, get_unaligned_le32(base + 0x2d3c), 2);
+			KUNIT_EXPECT_EQ(test, get_unaligned_le32(set + 0x2d34), 4);
+			KUNIT_EXPECT_EQ(test, get_unaligned_le32(set + 0x2d38), 2);
+			KUNIT_EXPECT_EQ(test, get_unaligned_le32(set + 0x2d3c), 3);
+		} else {
+			KUNIT_EXPECT_EQ(test, get_unaligned_le32(base + 0x5ae0), 7);
+			KUNIT_EXPECT_EQ(test, get_unaligned_le32(set + 0x5ae0), 8);
+		}
+		for (size_t o = 0; o < len; o += 4) {
+			bool expected = !h264 && o == 0x5ae0;
+
+			for (unsigned int i = 0; h264 && i < ARRAY_SIZE(h264_off); i++)
+				expected |= o == h264_off[i];
+			if (!expected)
+				KUNIT_EXPECT_EQ_MSG(test, get_unaligned_le32(base + o),
+						    get_unaligned_le32(set + o),
+						    "codec %d word +%#zx", codec, o);
+		}
+	}
+
+	/* Controls are offered only where the words are known. */
+	KUNIT_EXPECT_EQ(test, ave_sps_offset(&ave_layout_9003_78_0,
+					     AVE_SPS_H264_POC_TYPE), 0x2d38);
+	KUNIT_EXPECT_EQ(test, ave_sps_offset(&ave_layout_9003_78_0,
+					     AVE_SPS_HEVC_LOG2_MAX_POC_LSB_MINUS4), 0x5ae0);
+	KUNIT_EXPECT_EQ(test, ave_sps_offset(&ave_layout_6070_11_1,
+					     AVE_SPS_H264_POC_TYPE), 0);
+	KUNIT_EXPECT_EQ(test, ave_sps_offset(&ave_layout_26a428,
+					     AVE_SPS_H264_POC_TYPE), 0);
+	KUNIT_EXPECT_EQ(test, ave_sps_offset(NULL, AVE_SPS_H264_POC_TYPE), 0);
+
+	KUNIT_EXPECT_EQ(test, ave_sps_probe_parse("", 0x2900, 0x3060, off, val), 0);
+	KUNIT_EXPECT_EQ(test, ave_sps_probe_parse("\n", 0x2900, 0x3060, off, val), 0);
+	KUNIT_EXPECT_EQ(test, ave_sps_probe_parse("0x2d3c=4\n", 0x2900, 0x3060,
+						  off, val), 1);
+	KUNIT_EXPECT_EQ(test, val[0], 4);
+	KUNIT_ASSERT_EQ(test, ave_sps_probe_parse("0x2d34=4,0x2d38=2", 0x2900,
+						  0x3060, off, val), 2);
+	KUNIT_EXPECT_EQ(test, off[0], 0x2d34);
+	KUNIT_EXPECT_EQ(test, val[0], 4);
+	KUNIT_EXPECT_EQ(test, off[1], 0x2d38);
+	KUNIT_EXPECT_EQ(test, val[1], 2);
+	KUNIT_EXPECT_EQ(test, ave_sps_probe_parse("0x305c=1", 0x2900, 0x3060,
+						  off, val), 1);
+	KUNIT_EXPECT_EQ(test, ave_sps_probe_parse("0x3060=1", 0x2900, 0x3060,
+						  off, val), -EINVAL);
+	KUNIT_EXPECT_EQ(test, ave_sps_probe_parse("0x2d35=1", 0x2900, 0x3060,
+						  off, val), -EINVAL);
+	KUNIT_EXPECT_EQ(test, ave_sps_probe_parse("0x10=1", 0x2900, 0x3060,
+						  off, val), -EINVAL);
+	KUNIT_EXPECT_EQ(test, ave_sps_probe_parse("0x2d34", 0x2900, 0x3060,
+						  off, val), -EINVAL);
+	KUNIT_EXPECT_EQ(test, ave_sps_probe_parse("0x2d34=x", 0x2900, 0x3060,
+						  off, val), -EINVAL);
+	KUNIT_EXPECT_EQ(test, ave_sps_probe_parse("0x2d34=1,", 0x2900, 0x3060,
+						  off, val), -EINVAL);
+	KUNIT_EXPECT_EQ(test,
+			ave_sps_probe_parse("0x2d00=1,0x2d04=1,0x2d08=1,0x2d0c=1,"
+					    "0x2d10=1,0x2d14=1,0x2d18=1,0x2d1c=1,"
+					    "0x2d20=1",
+					    0x2900, 0x3060, off, val), -EINVAL);
+}
