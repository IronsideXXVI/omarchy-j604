+/* Ranges from H.264 7.4.2.1.1 and H.265 7.4.3.2.1; -1 keeps the firmware value. */
+#define AVE_SPS_CTRL(_id, _name, _max)					\
+	{ .ops = &ave_ctrl_ops, .id = (_id), .name = (_name),		\
+	  .type = V4L2_CTRL_TYPE_INTEGER, .min = -1, .max = (_max),	\
+	  .step = 1, .def = -1 }
+
+static const struct v4l2_ctrl_config ave_ctrl_sps[AVE_SPS_COUNT] = {
+	[AVE_SPS_H264_LOG2_MAX_FRAME_NUM_MINUS4] =
+		AVE_SPS_CTRL(V4L2_CID_APPLE_AVE_H264_LOG2_MAX_FRAME_NUM_MINUS4,
+			     "H264 Log2 Max Frame Num Minus4", 12),
+	[AVE_SPS_H264_POC_TYPE] =
+		AVE_SPS_CTRL(V4L2_CID_APPLE_AVE_H264_POC_TYPE, "H264 POC Type", 2),
+	[AVE_SPS_H264_LOG2_MAX_POC_LSB_MINUS4] =
+		AVE_SPS_CTRL(V4L2_CID_APPLE_AVE_H264_LOG2_MAX_POC_LSB_MINUS4,
