 			.header = AVE_SURFACE(0x48, 0x10),
@@ -211,6 +224,19 @@ const struct ave_fw_layout ave_layout_9003_78_0 = {
 			.hevc_dpb_minus1 = 0x5b00,
 			.hevc_reorder = 0x5b04,
 			.hevc_reorder_on = 0x95fc,
+			/*
+			 * The sequence block is the 6070 one 0xdc98 bytes lower
+			 * (profile, level, max_refs, picture size all match);
