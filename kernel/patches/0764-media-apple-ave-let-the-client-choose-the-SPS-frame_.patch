diff --git a/drivers/media/platform/apple/ave/ave-writer.c b/drivers/media/platform/apple/ave/ave-writer.c
index 8699f78c6f..5df4e02965 100644
--- a/drivers/media/platform/apple/ave/ave-writer.c
+++ b/drivers/media/platform/apple/ave/ave-writer.c
@@ -10,6 +10,8 @@
  */
 #include <linux/device.h>
 #include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
 #include <linux/sizes.h>
 #include <linux/string.h>
 #include <linux/unaligned.h>
@@ -437,6 +439,111 @@ static void ave_start_put8(u8 *cmd, u32 off, u8 val)
 		cmd[off] = val;
 }
 
+/*
+ * Test only: raw Start words for sweeping the firmware's sequence fields.
+ * The words must lie inside the codec's sequence block on this firmware
+ * build; each session that applies them logs them.
+ */
+static char sps_probe[96];
+module_param_string(sps_probe, sps_probe, sizeof(sps_probe), 0644);
+MODULE_PARM_DESC(sps_probe, "Test only: raw Start words \"off=val[,off=val]\" inside the sequence block, for sessions started from now on (default empty: none)");
+
+static enum ave_codec ave_sps_codec(enum ave_sps_word word)
+{
+	return word == AVE_SPS_HEVC_LOG2_MAX_POC_LSB_MINUS4 ? AVE_CODEC_HEVC :
+							      AVE_CODEC_H264;
+}
+
+/* Where @word sits in this build's Start command for its codec; 0: unknown. */
+u32 ave_sps_offset(const struct ave_fw_layout *fw, enum ave_sps_word word)
+{
+	const struct ave_start_layout *l;
+
+	if (!fw || fw->kind == AVE_LAYOUT_6070 || fw->counted)
+		return 0;
+	l = &fw->start[ave_sps_codec(word) - 1];
+	switch (word) {
+	case AVE_SPS_H264_LOG2_MAX_FRAME_NUM_MINUS4:
+		return l->sps_h264_log2_max_frame_num_minus4;
+	case AVE_SPS_H264_POC_TYPE:
+		return l->sps_h264_poc_type;
+	case AVE_SPS_H264_LOG2_MAX_POC_LSB_MINUS4:
+		return l->sps_h264_log2_max_poc_lsb_minus4;
+	case AVE_SPS_HEVC_LOG2_MAX_POC_LSB_MINUS4:
+		return l->sps_hevc_log2_max_poc_lsb_minus4;
+	default:
+		return 0;
+	}
+}
+
+/*
+ * Parse "off=val[,off=val]" (each number in C notation) into at most
+ * AVE_SPS_PROBE_MAX pairs of aligned words inside [@lo, @hi). Surrounding
+ * white space (the newline a sysfs write brings) is ignored, and a blank
+ * string is no words. Returns the number of pairs, or -EINVAL.
+ */
+int ave_sps_probe_parse(const char *spec, u32 lo, u32 hi, u32 *off, u32 *val)
+{
+	char buf[sizeof(sps_probe)], *s, *tok;
+	int n = 0;
+
+	if (strscpy(buf, spec, sizeof(buf)) < 0)
+		return -EINVAL;
+	s = strim(buf);
+	if (!*s)
+		return 0;
+	while ((tok = strsep(&s, ",")) != NULL) {
+		char *eq = strchr(tok, '=');
+
+		if (!eq || n == AVE_SPS_PROBE_MAX)
+			return -EINVAL;
+		*eq = '\0';
+		if (kstrtou32(tok, 0, &off[n]) || kstrtou32(eq + 1, 0, &val[n]))
+			return -EINVAL;
+		if (!IS_ALIGNED(off[n], 4) || off[n] < lo || off[n] >= hi ||
+		    hi - off[n] < 4)
+			return -EINVAL;
+		n++;
+	}
+	return n;
+}
+
+/* The client's sequence words, then any test probe words. */
+static void ave_start_client_sps(struct ave_ctx *ctx, u8 *cmd, size_t len)
+{
+	const struct ave_params *p = &ctx->sess->p;
+	const struct ave_fw_layout *fw = ctx->ave->layout;
+	const struct ave_start_layout *l = &fw->start[p->codec - 1];
+	u32 off[AVE_SPS_PROBE_MAX], val[AVE_SPS_PROBE_MAX];
+	char spec[sizeof(sps_probe)];
+	int n;
+
+	for (unsigned int i = 0; i < AVE_SPS_COUNT; i++) {
+		u32 o = ave_sps_offset(fw, i);
+
+		if ((p->sps_set & BIT(i)) && o && ave_sps_codec(i) == p->codec &&
+		    o + 4 <= len)
+			ave_put32(cmd, o, p->sps_val[i]);
+	}
+
+	if (!l->sps_probe_hi || l->sps_probe_hi > len)
+		return;
+	kernel_param_lock(THIS_MODULE);
+	strscpy(spec, sps_probe, sizeof(spec));
+	kernel_param_unlock(THIS_MODULE);
+	n = ave_sps_probe_parse(spec, l->sps_probe_lo, l->sps_probe_hi, off, val);
