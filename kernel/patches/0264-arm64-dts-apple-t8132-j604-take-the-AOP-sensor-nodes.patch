From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 23:43:05 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: take the AOP sensor
 nodes from t8132.dtsi

t8132.dtsi now describes the AOP's light, lid angle, accelerometer,
gyroscope, device motion and board temperature services, and
t8132-laptop.dtsi labels the accelerometer "accel-base". The J604's
own copies of the first four nodes add nothing to that: drop them.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 20 -------------------
 1 file changed, 20 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index 90d74c483c..d75d1b9a9e 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -1334,26 +1334,6 @@
 	};
 };
 
-&aop {
-	aop_als: als {
-		compatible = "apple,t8132-aop-als", "apple,aop-als";
-		status = "okay";
-	};
-	aop_las: las {
-		compatible = "apple,t8132-aop-las", "apple,aop-las";
-		status = "okay";
-	};
-	aop_accel: accel {
-		compatible = "apple,t8132-aop-accel", "apple,aop-accel";
-		status = "okay";
-		label = "accel-base";
-	};
-	aop_gyro: gyro {
-		compatible = "apple,t8132-aop-gyro", "apple,aop-gyro";
-		status = "okay";
-	};
-};
-
 &avd_dart {
 	power-domains = <&ps_avd_sys>;
 	status = "okay";
