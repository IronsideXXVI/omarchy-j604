From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 21:36:48 +0000
Subject: [PATCH] soc: apple: rtkit: send the AP idle notice with
 interrupts off

A coprocessor that keeps running across a system sleep may have to hear
about the AP's idle state at the very end of the sleep path, where one
CPU runs with interrupts off. apple_rtkit_ap_power_noirq() cannot be
used there: its wait sleeps between polls and counts jiffies, which do
not advance, and the management endpoint's acknowledgment is only
handled by the receive work.

Add apple_rtkit_ap_idle_polled(), which sends the AP idle state through
the polled receive path that apple_rtkit_sleep_idle_polled() already
uses, and move that path's set-up and tear-down into two helpers shared
by both.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/rtkit.c       | 44 +++++++++++++++++++++++++++------
 include/linux/soc/apple/rtkit.h |  6 +++++
 2 files changed, 42 insertions(+), 8 deletions(-)

diff --git a/drivers/soc/apple/rtkit.c b/drivers/soc/apple/rtkit.c
index ed9213e8f7..b21e54882c 100644
--- a/drivers/soc/apple/rtkit.c
+++ b/drivers/soc/apple/rtkit.c
@@ -2482,15 +2482,12 @@ static int apple_rtkit_polled_state(struct apple_rtkit *rtk, u8 type, unsigned i
 	return -ETIMEDOUT;
 }
 
-int apple_rtkit_sleep_idle_polled(struct apple_rtkit *rtk, void __iomem *cpu_control,
-				  unsigned int *us)
+/* Receive with the polled handler, after answering what already waits. */
+static void apple_rtkit_polled_begin(struct apple_rtkit *rtk)
 {
 	unsigned long flags;
 	u64 owed;
-	u32 status;
-	int ret;
 
-	*us = 0;
 	spin_lock_irqsave(&rtk->mbox->rx_lock, flags);
 	rtk->mbox->rx = apple_rtkit_polled_rx;
 	spin_unlock_irqrestore(&rtk->mbox->rx_lock, flags);
@@ -2505,6 +2502,39 @@ int apple_rtkit_sleep_idle_polled(struct apple_rtkit *rtk, void __iomem *cpu_con
 		if (!apple_rtkit_polled_send(rtk, echo))
 			dev_err(rtk->dev, "RTKit: oslog echo failed before the idle\n");
 	}
+}
+
+static void apple_rtkit_polled_end(struct apple_rtkit *rtk)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&rtk->mbox->rx_lock, flags);
+	rtk->mbox->rx = apple_rtkit_rx;
+	spin_unlock_irqrestore(&rtk->mbox->rx_lock, flags);
+}
+
+int apple_rtkit_ap_idle_polled(struct apple_rtkit *rtk, unsigned int *us)
+{
+	int ret;
+
+	*us = 0;
+	apple_rtkit_polled_begin(rtk);
+	ret = apple_rtkit_polled_state(rtk, APPLE_RTKIT_MGMT_SET_AP_PWR_STATE,
+				       &rtk->ap_power_state, us);
+	apple_rtkit_polled_end(rtk);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_ap_idle_polled);
+
+int apple_rtkit_sleep_idle_polled(struct apple_rtkit *rtk, void __iomem *cpu_control,
+				  unsigned int *us)
+{
+	u32 status;
+	int ret;
+
+	*us = 0;
+	apple_rtkit_polled_begin(rtk);
 
 	ret = apple_rtkit_polled_state(rtk, APPLE_RTKIT_MGMT_SET_AP_PWR_STATE,
 				       &rtk->ap_power_state, us);
@@ -2517,9 +2547,7 @@ int apple_rtkit_sleep_idle_polled(struct apple_rtkit *rtk, void __iomem *cpu_con
 						APPLE_ASC_CPU_STATUS_DOWN,
 						APPLE_RTKIT_POLLED_STEP_US, 5000);
 
-	spin_lock_irqsave(&rtk->mbox->rx_lock, flags);
-	rtk->mbox->rx = apple_rtkit_rx;
-	spin_unlock_irqrestore(&rtk->mbox->rx_lock, flags);
+	apple_rtkit_polled_end(rtk);
 
 	return ret;
 }
diff --git a/include/linux/soc/apple/rtkit.h b/include/linux/soc/apple/rtkit.h
index 244e60bbc6..72648973d0 100644
--- a/include/linux/soc/apple/rtkit.h
+++ b/include/linux/soc/apple/rtkit.h
@@ -284,6 +284,12 @@ void apple_rtkit_mailbox_off(struct apple_rtkit *rtk);
 int apple_rtkit_sleep_idle_polled(struct apple_rtkit *rtk, void __iomem *cpu_control,
 				  unsigned int *us);
 
+/*
+ * Only the AP idle notice, with interrupts off and one CPU up, for a co-processor that
+ * keeps running across the sleep. @us is about how long the acknowledgment took.
+ */
+int apple_rtkit_ap_idle_polled(struct apple_rtkit *rtk, unsigned int *us);
+
 /*
  * Only the mailbox's receive bit, for the moment before that co-processor's run bit
  * goes. Safe with interrupts off, and apple_rtkit_warm_restart() sets it again.
-- 
2.43.0

