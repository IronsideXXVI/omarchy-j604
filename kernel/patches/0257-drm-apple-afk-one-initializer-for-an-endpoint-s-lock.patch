From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Tue, 10 Nov 2026 20:38:44 +1100
Subject: [PATCH] drm/apple: afk: one initializer for an endpoint's
 locks and queues

afk_fail_commands_locked() wakes the endpoint's compact_orphan_wq, which
afk_init() initializes. The AV lifetime KUnit fixtures build endpoints
by hand and never initialized it, so the first av_audiosrv_cleanup()
through afk_quiesce() woke a zeroed wait queue:

  Unable to handle kernel NULL pointer dereference at virtual address 0
  pc : __wake_up_common+0x40/0xe8
   __wake_up+0x44/0x78
   afk_fail_commands_locked+0xb0/0xc4
   afk_quiesce+0x60/0x100
   av_audiosrv_cleanup+0x88/0x100

and every later suite in the run crashed with it (2 of 17 passed).

Add afk_ep_init_state() for the locks, command list, wait queues and
completions every endpoint needs before use, start afk_init() from it,
and use it for the endpoints the KUnit fixtures build, so a field added
to the endpoint is initialized for them too.

KUnit (arm64): apple-av-audio-lifetime 17/17 (was 2 passed, 15
crashed); apple-* 298/299, one skipped.

Assisted-by: LLM
Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
(cherry picked from commit 89f323e9a9fed3458f0b60b8a209415e1fd48bd5)

[Dylan Ironside: resolved against the J604 series commit 3e669a2496, whose
 test-local av_life_init_ep() this supersedes: both fixture calls use
 afk_ep_init_state() and the local helper is dropped]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/afk-parser-test.c  |  2 +-
 drivers/gpu/drm/apple/afk.c              | 11 ++---------
 drivers/gpu/drm/apple/afk.h              | 18 ++++++++++++++++++
 drivers/gpu/drm/apple/av-lifetime-test.c | 17 +++--------------
 4 files changed, 24 insertions(+), 24 deletions(-)

diff --git a/drivers/gpu/drm/apple/afk-parser-test.c b/drivers/gpu/drm/apple/afk-parser-test.c
index 8b93e67fd3..7c17a171ed 100644
--- a/drivers/gpu/drm/apple/afk-parser-test.c
+++ b/drivers/gpu/drm/apple/afk-parser-test.c
@@ -16,11 +16,11 @@ static int afk_parser_test_init(struct kunit *test)
 	if (IS_ERR(dcp->dev))
 		return PTR_ERR(dcp->dev);
 	dcp->fw_compat = DCP_FIRMWARE_H17P;
+	afk_ep_init_state(ep);
 	ep->dcp = dcp;
 	ep->num_channels = 1;
 	ep->services[0].channel = 1;
 	ep->services[0].enabled = true;
-	spin_lock_init(&ep->services[0].lock);
 	test->priv = ep;
 	return 0;
 }
diff --git a/drivers/gpu/drm/apple/afk.c b/drivers/gpu/drm/apple/afk.c
index 6337ea8134..0788c428b9 100644
--- a/drivers/gpu/drm/apple/afk.c
+++ b/drivers/gpu/drm/apple/afk.c
@@ -98,7 +98,7 @@ struct apple_dcp_afkep *afk_init(struct apple_dcp *dcp, u32 endpoint,
 				 const struct apple_epic_service_ops *ops)
 {
 	struct apple_dcp_afkep *afkep;
-	int ret, i;
+	int ret;
 
 	afkep = kzalloc_obj(*afkep);
 	if (!afkep)
@@ -125,14 +125,7 @@ struct apple_dcp_afkep *afk_init(struct apple_dcp *dcp, u32 endpoint,
 		}
 	}
 	INIT_WORK(&afkep->service_work, afk_service_worker);
-	INIT_LIST_HEAD(&afkep->compact_cmds);
-	init_waitqueue_head(&afkep->compact_orphan_wq);
-	mutex_init(&afkep->compact_tx_lock);
-	init_completion(&afkep->started);
-	init_completion(&afkep->stopped);
-	spin_lock_init(&afkep->lock);
-	for (i = 0; i < AFK_MAX_CHANNEL; i++)
-		spin_lock_init(&afkep->services[i].lock);
+	afk_ep_init_state(afkep);
 	ret = devm_add_action_or_reset(dcp->dev, afk_release_context, afkep);
 	if (ret)
 		return ERR_PTR(ret);
diff --git a/drivers/gpu/drm/apple/afk.h b/drivers/gpu/drm/apple/afk.h
index 1e0a3fae11..2586408eee 100644
--- a/drivers/gpu/drm/apple/afk.h
+++ b/drivers/gpu/drm/apple/afk.h
@@ -542,6 +542,24 @@ struct apple_dcp_afkep {
 	bool match_epic_name;
 };
 
+/*
+ * The locks, lists and wait queues of an endpoint, before anything may use
+ * them. afk_init() starts from it, and so does any endpoint built without it.
+ */
+static inline void afk_ep_init_state(struct apple_dcp_afkep *ep)
+{
+	u32 i;
+
+	spin_lock_init(&ep->lock);
+	INIT_LIST_HEAD(&ep->compact_cmds);
+	init_waitqueue_head(&ep->compact_orphan_wq);
+	mutex_init(&ep->compact_tx_lock);
+	init_completion(&ep->started);
+	init_completion(&ep->stopped);
+	for (i = 0; i < AFK_MAX_CHANNEL; i++)
+		spin_lock_init(&ep->services[i].lock);
+}
+
 struct apple_dcp_afkep *afk_init(struct apple_dcp *dcp, u32 endpoint,
 				 const struct apple_epic_service_ops *ops);
 int afk_v2_copy_owned(struct apple_epic_service *service, u64 dva,
diff --git a/drivers/gpu/drm/apple/av-lifetime-test.c b/drivers/gpu/drm/apple/av-lifetime-test.c
index 86c802c765..19c5ce42dc 100644
--- a/drivers/gpu/drm/apple/av-lifetime-test.c
+++ b/drivers/gpu/drm/apple/av-lifetime-test.c
@@ -46,18 +46,6 @@ struct av_life_test {
 static struct av_life_test *av_life_current;
 static void av_life_release_group(struct av_life_test *t);
 
-/*
- * A fake endpoint gets what afk_init() gives a real one before anything can
- * quiesce it: afk_quiesce() -> afk_cancel_commands() walks compact_cmds and
- * wakes compact_orphan_wq.
- */
-static void av_life_init_ep(struct apple_dcp_afkep *ep)
-{
-	spin_lock_init(&ep->lock);
-	INIT_LIST_HEAD(&ep->compact_cmds);
-	init_waitqueue_head(&ep->compact_orphan_wq);
-}
-
 static void av_life_owner_fn(struct work_struct *work)
 {
 	struct av_life_test *t = av_life_current;
@@ -166,7 +154,7 @@ static struct av_life_test *av_life_setup(struct kunit *test, work_func_t owner_
 	KUNIT_ASSERT_NOT_NULL(test, t->ep);
 	t->dcp->dev = t->dev;
 	dev_set_drvdata(t->dev, t->dcp);
-	av_life_init_ep(t->ep);
+	afk_ep_init_state(t->ep);
 	init_rwsem(&t->asrv->srv_rwsem);
 #if IS_ENABLED(CONFIG_DRM_APPLE_DCP_T6030_AUDIO)
 	init_waitqueue_head(&t->asrv->gen_wq);
@@ -498,7 +486,7 @@ static struct av_life_test *av_life_group_setup(struct kunit *test,
 	if (endpoint > 0) {
 		t->ep = devm_kzalloc(t->dev, sizeof(*t->ep), GFP_KERNEL);
 		KUNIT_ASSERT_NOT_NULL(test, t->ep);
-		av_life_init_ep(t->ep);
+		afk_ep_init_state(t->ep);
 		t->ep->dcp = t->dcp;
 		t->wq = alloc_ordered_workqueue("av-lifetime-devres", 0);
 		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, t->wq);
@@ -641,6 +629,7 @@ static void av_lifetime_devres_preserves_successor(struct kunit *test)
 
 	KUNIT_ASSERT_NOT_NULL(test, next);
 	KUNIT_ASSERT_NOT_NULL(test, ep);
+	afk_ep_init_state(ep);
 	KUNIT_ASSERT_EQ(test, av_audiosrv_register_cleanup(t->dcp, t->asrv, t->ep), 0);
 	devres_close_group(t->dev, t->group);
 	t->dcp->audiosrv = next;
