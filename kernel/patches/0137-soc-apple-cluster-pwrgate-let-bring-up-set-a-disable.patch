From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 00:28:29 +0000
Subject: [PATCH] soc: apple: cluster-pwrgate: let bring-up set a
 disabled node's enables

Enabling the J604's cluster power gate node is a device tree change,
which means a new boot image. To try a deep sleep with the enables set
on the boot that showed their words, add a write-only parameter:
writing 1 to apply_disabled sets bit 31 of a disabled node's words now,
logging each word before and after, as an enabled node does at boot.
A core picks the word up at its next WFI.

Nothing is written unless root asks for it. The match table stays
after init for this path.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 767931bc8c6e6e8e355e346a5fce4eaf02827231)
---
 drivers/soc/apple/apple-cluster-pwrgate.c | 42 ++++++++++++++++++++++-
 1 file changed, 41 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/apple/apple-cluster-pwrgate.c b/drivers/soc/apple/apple-cluster-pwrgate.c
index 521bff7af8..fe834613cb 100644
--- a/drivers/soc/apple/apple-cluster-pwrgate.c
+++ b/drivers/soc/apple/apple-cluster-pwrgate.c
@@ -10,6 +10,7 @@
 
 #include <linux/bits.h>
 #include <linux/init.h>
+#include <linux/moduleparam.h>
 #include <linux/io.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
@@ -17,7 +18,7 @@
 
 #define CLUSTER_PWRGATE_EN	BIT(31)
 
-static const struct of_device_id apple_cluster_pwrgate_of_match[] __initconst = {
+static const struct of_device_id apple_cluster_pwrgate_of_match[] = {
 	{ .compatible = "apple,cluster-pwrgate" },
 	{ }
 };
@@ -58,3 +59,42 @@ static int __init apple_cluster_pwrgate_init(void)
 	return 0;
 }
 early_initcall(apple_cluster_pwrgate_init);
+
+/*
+ * For bring-up on a board whose node is still disabled: writing 1 sets the
+ * enables of that node's words now, as an enabled node would have at boot.
+ * Only once the read-only report above shows words of the expected layout.
+ */
+static int apple_cluster_pwrgate_apply_set(const char *val, const struct kernel_param *kp)
+{
+	struct device_node *np;
+	bool apply;
+	int ret;
+
+	ret = kstrtobool(val, &apply);
+	if (ret || !apply)
+		return ret;
+
+	for_each_matching_node(np, apple_cluster_pwrgate_of_match) {
+		void __iomem *gate;
+		int i;
+
+		if (of_device_is_available(np))
+			continue;
+		for (i = 0; (gate = of_iomap(np, i)); i++) {
+			u32 was = readl(gate);
+
+			writel(was | CLUSTER_PWRGATE_EN, gate);
+			pr_info("%pOF: cluster %d power gate %#x, now %#x (apply_disabled)\n",
+				np, i, was, readl(gate));
+			iounmap(gate);
+		}
+	}
+	return 0;
+}
+
+static const struct kernel_param_ops apple_cluster_pwrgate_apply_ops = {
+	.set = apple_cluster_pwrgate_apply_set,
+};
+module_param_cb(apply_disabled, &apple_cluster_pwrgate_apply_ops, NULL, 0200);
+MODULE_PARM_DESC(apply_disabled, "Write 1 to set the power-gate enables of a disabled cluster power gate node now (bring-up)");
-- 
