From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 4 Nov 2026 21:52:06 -0500
Subject: [PATCH] dt-bindings: mux: apple,display-crossbar: add the T8132
 crossbar

T8132 has one display crossbar per ATC, in the ATC's power domain. Add its
compatible, and allow a power domain.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 282924438652622f10565da7de0056db11949b05)
---
 .../devicetree/bindings/mux/apple,display-crossbar.yaml       | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Documentation/devicetree/bindings/mux/apple,display-crossbar.yaml b/Documentation/devicetree/bindings/mux/apple,display-crossbar.yaml
index fcb65f7913..7e5dc22e28 100644
--- a/Documentation/devicetree/bindings/mux/apple,display-crossbar.yaml
+++ b/Documentation/devicetree/bindings/mux/apple,display-crossbar.yaml
@@ -25,10 +25,14 @@ properties:
       - apple,t6000-display-crossbar
       - apple,t6020-display-crossbar
       - apple,t6041-display-crossbar
+      - apple,t8132-display-crossbar
 
   reg:
     maxItems: 1
 
+  power-domains:
+    maxItems: 1
+
   '#mux-control-cells':
     const: 1
 
