From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 15:38:23 +0000
Subject: [PATCH] dt-bindings: npu: apple,ane: make the binding parse
 and validate again

One conditional block lists apple,dapf-ranges twice with the same
constraint. YAML does not allow duplicate keys, so the schema failed to
parse, dt_binding_check skipped it and no ANE node was validated. Drop
the second entry.

With the file parsing, two conditionals that carry only an else branch
fail the meta-schema, which wants a then with every if. Write them as
if: not: ... then: with the same constraints.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 .../devicetree/bindings/npu/apple,ane.yaml    | 38 +++++++++----------
 1 file changed, 19 insertions(+), 19 deletions(-)

diff --git a/Documentation/devicetree/bindings/npu/apple,ane.yaml b/Documentation/devicetree/bindings/npu/apple,ane.yaml
index eb69389508..cfda18adbf 100644
--- a/Documentation/devicetree/bindings/npu/apple,ane.yaml
+++ b/Documentation/devicetree/bindings/npu/apple,ane.yaml
@@ -314,8 +314,6 @@ allOf:
             - const: perf
         apple,ane-type:
           const: 0x110
-        apple,dapf-ranges:
-          maxItems: 4
       required:
         - apple,ane-type
         - apple,firmware-preloaded
@@ -475,16 +473,17 @@ allOf:
         - mboxes
 
   - if:
-      properties:
-        compatible:
-          contains:
-            enum:
-              - apple,t8140-ane
-              - apple,t6041-ane
-              - apple,t6050-ane
-              - apple,t8132-ane
-              - apple,t6001-ane
-    else:
+      not:
+        properties:
+          compatible:
+            contains:
+              enum:
+                - apple,t8140-ane
+                - apple,t6041-ane
+                - apple,t6050-ane
+                - apple,t8132-ane
+                - apple,t6001-ane
+    then:
       properties:
         power-domains:
           minItems: 5
@@ -504,13 +503,14 @@ allOf:
       required:
         - clocks
   - if:
-      properties:
-        compatible:
-          contains:
-            enum:
-              - apple,t6001-ane
-              - apple,t6050-ane
-    else:
+      not:
+        properties:
+          compatible:
+            contains:
+              enum:
+                - apple,t6001-ane
+                - apple,t6050-ane
+    then:
       properties:
         clocks: false
 
-- 
2.43.0

