From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 23:33:22 +0000
Subject: [PATCH] usb: dwc3: apple: offer SuperSpeed Plus on T8132
 ports behind a switch

The T8132 Type-C ports' controllers are DWC_usb31 cores, and macOS
names their buses "USB 3.1 Bus". Our devicetree caps them at
maximum-speed = "super-speed", for which dwc3_core_init() sets
LLUCTL.FORCE_GEN1 on every USB3 port, so a link never tries 10 Gb/s.

Add t8132_usb_gen2, off by default. When it is set, a cable session
starts with the cap lifted, as Aurora's J575c (T6041) runs its ports
with no maximum-speed and reaches a USB 3.2 Gen 2 SSD at 10 Gb/s there:
maximum_speed SuperSpeed Plus at Gen 2x1 and FORCE_GEN1 cleared, before
the role and xHCI start. Cleared again, the next cable session is
capped as the devicetree says. Whether the T8132 ATC PHY trains at
Gen 2 is for a device to show; the default stays off until it does.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/usb/dwc3/dwc3-apple.c | 49 +++++++++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/drivers/usb/dwc3/dwc3-apple.c b/drivers/usb/dwc3/dwc3-apple.c
index c3b02c3602..e435939a17 100644
--- a/drivers/usb/dwc3/dwc3-apple.c
+++ b/drivers/usb/dwc3/dwc3-apple.c
@@ -178,6 +178,8 @@ struct dwc3_apple {
 	bool rpm_held;
 	bool pre_core_rpm;
 	bool dt_dis_u3_susphy;
+	enum usb_device_speed dt_maximum_speed;
+	bool dt_speed_saved;
 	bool sleep_ddr;
 	struct notifier_block pm_nb;
 	/* Kept through a deep sleep, with the PHY's hibernation, and the GUID it had. */
@@ -863,6 +865,52 @@ static bool dwc3_apple_host_only(struct device *dev)
 	       of_device_is_compatible(dev->of_node, "apple,t6050-dwc3");
 }
 
+static bool t8132_usb_gen2;
+module_param(t8132_usb_gen2, bool, 0644);
+MODULE_PARM_DESC(t8132_usb_gen2,
+		 "T8132: let a Type-C port's USB 3.1 controller run SuperSpeed Plus (USB 3.2 Gen 2, 10 Gb/s), as macOS's \"USB 3.1 Bus\" does; applies at the next cable (default off)");
+
+/*
+ * The T8132 ports' controllers are DWC_usb31 cores, and macOS names their buses "USB 3.1 Bus".
+ * The devicetree caps them at maximum-speed = "super-speed", for which dwc3_core_init() sets
+ * LLUCTL.FORCE_GEN1 and the link never tries 10 Gb/s. With t8132_usb_gen2, a cable session
+ * starts with the cap lifted, as Aurora's J575c (T6041) runs its ports with no maximum-speed:
+ * SuperSpeed Plus, one lane at Gen 2. Whether this ATC PHY trains at Gen 2 is for a device to
+ * show; a link that does not falls back as any SuperSpeed link does. Cleared, the next cable
+ * session is capped as the devicetree says again.
+ */
+static void dwc3_apple_usb_gen2(struct dwc3_apple *appledwc)
+{
+	struct dwc3 *dwc = &appledwc->dwc;
+	bool gen2;
+	u32 reg;
+	int i;
+
+	if (!of_device_is_compatible(appledwc->dev->of_node, "apple,t8132-dwc3") ||
+	    !DWC3_IP_IS(DWC31))
+		return;
+	if (!appledwc->dt_speed_saved) {
+		appledwc->dt_maximum_speed = dwc->maximum_speed;
+		appledwc->dt_speed_saved = true;
+	}
+	if (appledwc->dt_maximum_speed != USB_SPEED_SUPER)
+		return;
+
+	gen2 = READ_ONCE(t8132_usb_gen2);
+	dwc->maximum_speed = gen2 ? USB_SPEED_SUPER_PLUS : USB_SPEED_SUPER;
+	dwc->max_ssp_rate = gen2 ? USB_SSP_GEN_2x1 : USB_SSP_GEN_UNKNOWN;
+	for (i = 0; i < dwc->num_usb3_ports; i++) {
+		reg = dwc3_readl(dwc, DWC3_LLUCTL(i));
+		if (gen2)
+			reg &= ~DWC3_LLUCTL_FORCE_GEN1;
+		else
+			reg |= DWC3_LLUCTL_FORCE_GEN1;
+		dwc3_writel(dwc, DWC3_LLUCTL(i), reg);
+	}
+	if (gen2)
+		dev_info(appledwc->dev, "SuperSpeed Plus (Gen 2) allowed for this cable session\n");
+}
+
 static int dwc3_apple_init(struct dwc3_apple *appledwc, enum dwc3_apple_state state)
 {
 	int ret, ret_reset;
@@ -880,6 +928,7 @@ static int dwc3_apple_init(struct dwc3_apple *appledwc, enum dwc3_apple_state st
 	ret = dwc3_apple_core_start(appledwc, state);
 	if (ret)
 		return ret;
+	dwc3_apple_usb_gen2(appledwc);
 
 	ret = dwc3_apple_set_role(appledwc, state);
 	if (ret)
-- 
2.43.0

