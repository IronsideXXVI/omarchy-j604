From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 09:27:49 +0000
Subject: [PATCH] drm/asahi: g16: stop the firmware at the sleep's
 commit with g16_deep_sleep

With asahi.g16_deep_sleep=1, a sleep that powers the SoC down idles the
G16 firmware and stops its ASC in .suspend_late. An idled firmware does
not come back with its power kept: only a sleep that reaches the
hardware restarts it. So any refusal after .suspend_late (the PMP's,
another device's late or noirq suspend, the sleep driver's last checks)
left the GPU failed until reboot:

  G16: firmware did not come back after the sleep: EAGAIN; the GPU
  stays failed until reboot

and the compositor then got EIO.

Where the sleep driver can take it, leave the idle and the stop for its
commit, past every refusal, as the PMP and ANS already do: register a
last stop with apple_sleep_coproc_register_first() (polled RTKit idle,
mailbox receive off, run bit cleared twice), set it ready in
.suspend_late, and in .resume_early ask apple_sleep_coproc_stopped(). A
sleep refused before the commit then finds the firmware still running
and costs the GPU nothing. It registers first so that the GPU stops
before the PMP, which carries its power vote.

A sleep that stopped the firmware but then did not reach the hardware
now keeps it marked stopped, so that the next one that does restarts it
warm, instead of reporting it failed. Without the sleep driver the stop
stays in .suspend_late, as before.

Suspend-to-idle and g16_deep_sleep=0 are unchanged: nothing registers
and no callback does anything new.

Fixes: 6beaf1563c06 ("drm/asahi: g16: try a firmware stop and warm restart across suspend-to-RAM")
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/glue.c   |  55 +++++++++++++
 drivers/gpu/drm/asahi/g16/sleep.rs | 121 ++++++++++++++++++++++++++---
 2 files changed, 167 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/glue.c b/drivers/gpu/drm/asahi/g16/glue.c
index 84e5b606d1..f4c51484c5 100644
--- a/drivers/gpu/drm/asahi/g16/glue.c
+++ b/drivers/gpu/drm/asahi/g16/glue.c
@@ -22,6 +22,8 @@
 #include <linux/soc/apple/pmp-display.h>
 #include <linux/soc/apple/pmp-cooling.h>
 #include <linux/soc/apple/pmp-telemetry.h>
+#include <linux/soc/apple/rtkit.h>
+#include <linux/soc/apple/sleep.h>
 #include <linux/thermal.h>
 
 bool asahi_g16_board(void);
@@ -349,3 +351,56 @@ void asahi_g16_clpc_gpu_put(struct apple_clpc_gpu *gpu)
 {
 	apple_clpc_gpu_put(gpu);
 }
+
+/*
+ * g16_deep_sleep: the firmware's idle and the ASC stop at the sleep's commit (apple-s2r), past
+ * every refusal, as for the PMP. An idled firmware doesn't come back with its power kept, so a
+ * sleep refused before the commit must find it still running. Registered first: the GPU stops
+ * before the PMP, which carries its power vote. Only a retained session registers, and it pins
+ * this module until reboot.
+ */
+#define ASAHI_G16_ASC_RUN	BIT(4)
+
+static struct {
+	struct apple_rtkit *rtk;
+	void __iomem *control;
+	unsigned int us;
+	int ret;
+} asahi_g16_commit;
+
+/* Interrupts off, one CPU: apple_rtkit_sleep_stop(), polled. It can't refuse the sleep. */
+static int asahi_g16_commit_stop(void *unused)
+{
+	void __iomem *control = asahi_g16_commit.control;
+
+	asahi_g16_commit.ret = apple_rtkit_sleep_idle_polled(asahi_g16_commit.rtk, control,
+							     &asahi_g16_commit.us);
+	apple_rtkit_mailbox_recv_off(asahi_g16_commit.rtk);
+	/* Twice, each time from what it reads back. */
+	writel(readl(control) & ~ASAHI_G16_ASC_RUN, control);
+	writel(readl(control) & ~ASAHI_G16_ASC_RUN, control);
+	return 0;
+}
+
+int asahi_g16_commit_register(struct device *dev, struct apple_rtkit *rtk, void __iomem *control);
+int asahi_g16_commit_register(struct device *dev, struct apple_rtkit *rtk, void __iomem *control)
+{
+	asahi_g16_commit.rtk = rtk;
+	asahi_g16_commit.control = control;
+	return apple_sleep_coproc_register_first(dev, asahi_g16_commit_stop, NULL);
+}
+
+void asahi_g16_commit_ready(struct device *dev, bool ready);
+void asahi_g16_commit_ready(struct device *dev, bool ready)
+{
+	apple_sleep_coproc_set_ready(dev, ready);
+}
+
+/* Whether the commit stopped the firmware; if so, how its idle went (@us: about how long). */
+bool asahi_g16_commit_stopped(struct device *dev, int *idle, unsigned int *us);
+bool asahi_g16_commit_stopped(struct device *dev, int *idle, unsigned int *us)
+{
+	*idle = asahi_g16_commit.ret;
+	*us = asahi_g16_commit.us;
+	return apple_sleep_coproc_stopped(dev);
+}
diff --git a/drivers/gpu/drm/asahi/g16/sleep.rs b/drivers/gpu/drm/asahi/g16/sleep.rs
index 6ed4a1fadc..a0a5fb1d12 100644
--- a/drivers/gpu/drm/asahi/g16/sleep.rs
+++ b/drivers/gpu/drm/asahi/g16/sleep.rs
@@ -12,10 +12,17 @@
 //! still refuses the sleep if the AGX vote was taken.
 //!
 //! For bring-up, `asahi.g16_deep_sleep=1` takes such a sleep instead: the firmware is idled and
-//! its ASC stopped late in the suspend (`.suspend_late`, interrupts still on), and restarted warm
-//! early in the resume (`.resume_early`, after the power domain is back). Whether the G16
-//! firmware comes back from that on the J604 is what the parameter is for; a firmware that does
-//! not come back leaves the GPU failed until reboot, the rest of the system resumes.
+//! its ASC stopped, and restarted warm early in the resume (`.resume_early`, after the power
+//! domain is back). Whether the G16 firmware comes back from that on the J604 is what the
+//! parameter is for; a firmware that does not come back leaves the GPU failed until reboot, the
+//! rest of the system resumes.
+//!
+//! An idled firmware doesn't come back with its power kept: only a sleep that reaches the
+//! hardware restarts it. So where the sleep driver can take it (apple-s2r), the idle and the stop
+//! are left for the sleep's commit, past every refusal, with interrupts off (`g16/glue.c`), as
+//! for the PMP: a sleep refused before then finds the firmware still running and costs the GPU
+//! nothing. Without the sleep driver they run in `.suspend_late` (interrupts still on), and a
+//! sleep refused after that leaves the firmware stopped until one that reaches the hardware.
 
 use core::ffi::c_void;
 use core::ptr::null_mut;
@@ -32,8 +39,26 @@ static RTK: AtomicPtr<bindings::apple_rtkit> = AtomicPtr::new(null_mut());
 static ASC_CONTROL: AtomicPtr<c_void> = AtomicPtr::new(null_mut());
 /// This sleep stops the firmware (set in `.prepare`, cleared in `.complete`).
 static STOP_WANTED: AtomicBool = AtomicBool::new(false);
-/// The firmware was stopped by `.suspend_late` and must be restarted.
+/// The firmware was stopped and must be restarted by a sleep that reaches the hardware.
 static STOPPED: AtomicBool = AtomicBool::new(false);
+/// The sleep driver takes the stop at its commit (registered once, until reboot).
+static COMMIT_REGISTERED: AtomicBool = AtomicBool::new(false);
+/// This sleep's stop was left for the commit (set in `.suspend_late`, read in `.resume_early`).
+static AT_COMMIT: AtomicBool = AtomicBool::new(false);
+
+extern "C" {
+    fn asahi_g16_commit_register(
+        dev: *mut c_void,
+        rtk: *mut bindings::apple_rtkit,
+        control: *mut c_void,
+    ) -> core::ffi::c_int;
+    fn asahi_g16_commit_ready(dev: *mut c_void, ready: bool);
+    fn asahi_g16_commit_stopped(
+        dev: *mut c_void,
+        idle: *mut core::ffi::c_int,
+        us: *mut core::ffi::c_uint,
+    ) -> bool;
+}
 
 /// Called once the firmware has started: both pointers stay valid until reboot.
 pub(crate) fn publish(rtk: *mut bindings::apple_rtkit, asc_control: *mut c_void) {
@@ -84,7 +109,36 @@ unsafe extern "C" fn sleep_prepare(dev: *mut bindings::device) -> core::ffi::c_i
     EBUSY.to_errno()
 }
 
-/// `.suspend_late`: idles the firmware and stops its ASC, interrupts still on.
+/// Registers the stop at the sleep's commit, once. False: the sleep driver can't take it.
+fn commit_available(
+    d: &device::Device,
+    dev: *mut bindings::device,
+    rtk: *mut bindings::apple_rtkit,
+    control: *mut c_void,
+) -> bool {
+    if COMMIT_REGISTERED.load(Ordering::Relaxed) {
+        return true;
+    }
+    // SAFETY: `dev` is the bound GPU; both pointers were published by the retained session and
+    // live until reboot, as does this module, which the session pins.
+    match to_result(unsafe { asahi_g16_commit_register(dev.cast(), rtk, control) }) {
+        Ok(()) => {
+            COMMIT_REGISTERED.store(true, Ordering::Relaxed);
+            true
+        }
+        Err(e) => {
+            dev_warn!(
+                d,
+                "G16: the sleep driver can't stop the firmware at its commit ({:?}): stopping it now\n",
+                e
+            );
+            false
+        }
+    }
+}
+
+/// `.suspend_late`: leaves the firmware's idle and stop for the sleep's commit, or does them
+/// here, interrupts still on.
 unsafe extern "C" fn sleep_suspend_late(dev: *mut bindings::device) -> core::ffi::c_int {
     if !STOP_WANTED.load(Ordering::Relaxed) {
         return 0;
@@ -94,6 +148,20 @@ unsafe extern "C" fn sleep_suspend_late(dev: *mut bindings::device) -> core::ffi
     };
     // SAFETY: The PM core passes the bound device and holds a reference to it for the callback.
     let d = unsafe { device::Device::<device::Normal>::from_raw(dev) };
+    if STOPPED.load(Ordering::Relaxed) {
+        dev_info!(
+            d,
+            "G16: firmware still stopped from a sleep that did not reach the hardware: this one restarts it\n"
+        );
+        return 0;
+    }
+    if commit_available(d, dev, rtk, control) {
+        // SAFETY: Registered above for this device.
+        unsafe { asahi_g16_commit_ready(dev.cast(), true) };
+        AT_COMMIT.store(true, Ordering::Relaxed);
+        dev_info!(d, "G16: firmware idle and ASC stop left for the sleep's commit\n");
+        return 0;
+    }
     // SAFETY: Both pointers were published by the running session and live until reboot.
     match to_result(unsafe { bindings::apple_rtkit_sleep_stop(rtk, control) }) {
         Ok(()) => {
@@ -115,14 +183,49 @@ unsafe extern "C" fn sleep_suspend_late(dev: *mut bindings::device) -> core::ffi
 
 /// `.resume_early`: restarts the stopped firmware warm, once its power domain is back.
 unsafe extern "C" fn sleep_resume_early(dev: *mut bindings::device) -> core::ffi::c_int {
-    if !STOPPED.swap(false, Ordering::Relaxed) {
+    // SAFETY: The PM core passes the bound device and holds a reference to it for the callback.
+    let d = unsafe { device::Device::<device::Normal>::from_raw(dev) };
+    if AT_COMMIT.swap(false, Ordering::Relaxed) {
+        let mut idle: core::ffi::c_int = 0;
+        let mut us: core::ffi::c_uint = 0;
+        // SAFETY: Registered for this device in `.suspend_late`; the out pointers are locals.
+        let stopped = unsafe { asahi_g16_commit_stopped(dev.cast(), &mut idle, &mut us) };
+        // SAFETY: As above.
+        unsafe { asahi_g16_commit_ready(dev.cast(), false) };
+        if !stopped {
+            dev_info!(
+                d,
+                "G16: sleep refused before the commit: the firmware never stopped and still runs\n"
+            );
+            return 0;
+        }
+        if idle != 0 {
+            dev_warn!(
+                d,
+                "G16: firmware idle at the commit failed ({}, {} us): ASC stopped anyway\n",
+                idle,
+                us
+            );
+        } else {
+            dev_info!(d, "G16: firmware idled ({} us) and ASC stopped at the commit\n", us);
+        }
+        STOPPED.store(true, Ordering::Relaxed);
+    }
+    if !STOPPED.load(Ordering::Relaxed) {
         return 0;
     }
+    // SAFETY: Reads a global flag word.
+    if !unsafe { bindings::pm_resume_via_firmware() } {
+        dev_warn!(
+            d,
+            "G16: the sleep did not reach the hardware: the firmware stays stopped until one that does\n"
+        );
+        return 0;
+    }
+    STOPPED.store(false, Ordering::Relaxed);
     let Some((rtk, control)) = firmware() else {
         return 0;
     };
-    // SAFETY: The PM core passes the bound device and holds a reference to it for the callback.
-    let d = unsafe { device::Device::<device::Normal>::from_raw(dev) };
     // SAFETY: Both pointers were published by the running session and live until reboot.
     match to_result(unsafe { bindings::apple_rtkit_sleep_return(rtk, control) }) {
         Ok(()) => dev_info!(d, "G16: firmware warm-restarted after the sleep\n"),
