From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bartosz Nitka <niteria@gmail.com>
Date: Fri, 6 Nov 2026 17:17:02 +0100
Subject: [PATCH] iommu: apple-dart: generalize the external display power
 gating

An adopted J713 external display DART can be unpowered across sleep, so
its registers are used only with its power confirmed:
apple_dart_dispext_get() counts a use, an invalidation waits for the uses
and marks the DART unconfirmed until a state check after power-up.

The internal display DARTs can lose power the same way once their DCP
powers its domains down. Give the gate its own flag, power_gated, set for
the external display DARTs as before, and rename its state and helpers
from dispext_* to pm_*. The external display DART's adoption, frontends,
fault handling and state check stay as they are.

No functional change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 9972b186dd30ce747951a6b66e2a64364a516442)
---
 drivers/iommu/apple-dart-dcp-shared.h | 12 ++--
 drivers/iommu/apple-dart-dcp.h        | 75 ++++++++++++------------
 drivers/iommu/apple-dart.c            | 82 +++++++++++++++------------
 3 files changed, 89 insertions(+), 80 deletions(-)

diff --git a/drivers/iommu/apple-dart-dcp-shared.h b/drivers/iommu/apple-dart-dcp-shared.h
index f597edd6b6..2396ac5e1d 100644
--- a/drivers/iommu/apple-dart-dcp-shared.h
+++ b/drivers/iommu/apple-dart-dcp-shared.h
@@ -378,7 +378,7 @@ int apple_dart_dcp_dispext_stream_ok(struct device *piodma, unsigned int sid)
 	if (apple_dart_dispext_retired(pio->dart))
 		return -EIO;
 	/* Its power not confirmed since sleep: usable later, not now. */
-	return apple_dart_dispext_unconfirmed(pio->dart) ? -EAGAIN : 0;
+	return apple_dart_pm_unconfirmed(pio->dart) ? -EAGAIN : 0;
 }
 EXPORT_SYMBOL_GPL(apple_dart_dcp_dispext_stream_ok);
 
@@ -807,7 +807,7 @@ unlock:
 
 /*
  * J713 external DCP: the external display DART operations above, each
- * inside one use of the DART's registers (apple_dart_dispext_get()): with
+ * inside one use of the DART's registers (apple_dart_pm_get()): with
  * its power not confirmed since sleep, -EAGAIN before any step, nothing
  * published, nothing retired. A sleep waits for a use under way to end, so
  * no step of it (its flushes included) runs unconfirmed.
@@ -824,12 +824,12 @@ static struct apple_dart *apple_dart_dcp_dispext_gate(struct device *piodma)
 		struct apple_dart *__gd = apple_dart_dcp_dispext_gate(piodma);	\
 		typeof(call) __ret;						\
 										\
-		if (__gd && !apple_dart_dispext_get(__gd)) {			\
+		if (__gd && !apple_dart_pm_get(__gd)) {			\
 			__ret = (typeof(call))-EAGAIN;				\
 		} else {							\
 			__ret = (call);						\
 			if (__gd)						\
-				apple_dart_dispext_put(__gd);			\
+				apple_dart_pm_put(__gd);			\
 		}								\
 		__ret;								\
 	})
@@ -863,11 +863,11 @@ void *apple_dart_dcp_dispext_scanout_alloc(struct device *piodma, size_t size, u
 	struct apple_dart *dart = apple_dart_dcp_dispext_gate(piodma);
 	void *ret;
 
-	if (dart && !apple_dart_dispext_get(dart))
+	if (dart && !apple_dart_pm_get(dart))
 		return ERR_PTR(-EAGAIN);
 	ret = __apple_dart_dcp_dispext_scanout_alloc(piodma, size, dva);
 	if (dart)
-		apple_dart_dispext_put(dart);
+		apple_dart_pm_put(dart);
 	return ret;
 }
 EXPORT_SYMBOL_GPL(apple_dart_dcp_dispext_scanout_alloc);
diff --git a/drivers/iommu/apple-dart-dcp.h b/drivers/iommu/apple-dart-dcp.h
index 87a35bc5ef..21a0ef567f 100644
--- a/drivers/iommu/apple-dart-dcp.h
+++ b/drivers/iommu/apple-dart-dcp.h
@@ -82,65 +82,66 @@ struct apple_dart_dcp {
 	} while (0)
 
 /*
- * J713 external display DART: its power not confirmed since sleep (from
- * suspend until its firmware powers it up again): no register of it may be
- * read or written, and nothing is retired for that.
+ * A power-gated display DART (see struct apple_dart): its power not
+ * confirmed since it may have gone off (from sleep, or from a power-down by
+ * its DCP, until it is confirmed on again): no register of it may be read or
+ * written, and nothing is retired for that.
  */
-static inline bool apple_dart_dispext_unconfirmed(const struct apple_dart *dart)
+static inline bool apple_dart_pm_unconfirmed(const struct apple_dart *dart)
 {
-	return dart->dispext && READ_ONCE(dart->dispext_unverified);
+	return dart->power_gated && READ_ONCE(dart->pm_unverified);
 }
 
 /*
- * A use of an external display DART's registers, taken at the start of an
+ * A use of a power-gated display DART's registers, taken at the start of an
  * operation and dropped at its end, and only with its power confirmed:
- * false (the caller returns -EAGAIN, nothing retired) from sleep until its
- * next confirmed power-up. Inside it the operation's steps, flushes included,
- * run unchecked: an invalidation (sleep) waits for it to end. Any other
- * DART: always true, no count.
+ * false (the caller returns -EAGAIN, nothing retired) from the moment it may
+ * go off until its next confirmed power-up. Inside it the operation's steps,
+ * flushes included, run unchecked: an invalidation waits for it to end. Any
+ * other DART: always true, no count.
  */
-static inline bool apple_dart_dispext_get(struct apple_dart *dart)
+static inline bool apple_dart_pm_get(struct apple_dart *dart)
 {
 	unsigned long flags;
 	bool ok;
 
-	if (!dart->dispext)
+	if (!dart->power_gated)
 		return true;
-	spin_lock_irqsave(&dart->dispext_pm_lock, flags);
-	ok = !dart->dispext_unverified;
+	spin_lock_irqsave(&dart->pm_gate_lock, flags);
+	ok = !dart->pm_unverified;
 	if (ok)
-		dart->dispext_users++;
-	spin_unlock_irqrestore(&dart->dispext_pm_lock, flags);
+		dart->pm_users++;
+	spin_unlock_irqrestore(&dart->pm_gate_lock, flags);
 	return ok;
 }
 
-static inline void apple_dart_dispext_put(struct apple_dart *dart)
+static inline void apple_dart_pm_put(struct apple_dart *dart)
 {
 	unsigned long flags;
 
-	if (!dart->dispext)
+	if (!dart->power_gated)
 		return;
-	spin_lock_irqsave(&dart->dispext_pm_lock, flags);
-	if (!--dart->dispext_users)
-		wake_up_all(&dart->dispext_wq);
-	spin_unlock_irqrestore(&dart->dispext_pm_lock, flags);
+	spin_lock_irqsave(&dart->pm_gate_lock, flags);
+	if (!--dart->pm_users)
+		wake_up_all(&dart->pm_wq);
+	spin_unlock_irqrestore(&dart->pm_gate_lock, flags);
 }
 
 /*
- * Sleep: no power confirmed from now on, a new generation (a check
- * still under way confirms nothing), and every use in flight waited for.
- * @suspend: asleep until the matching resume (no check runs then).
+ * Sleep or a power-down: no power confirmed from now on, a new generation (a
+ * check still under way confirms nothing), and every use in flight waited
+ * for. @suspend: asleep until the matching resume (no check runs then).
  */
-static inline void apple_dart_dispext_invalidate(struct apple_dart *dart, bool suspend)
+static inline void apple_dart_pm_invalidate(struct apple_dart *dart, bool suspend)
 {
 	unsigned long flags;
 
-	spin_lock_irqsave(&dart->dispext_pm_lock, flags);
-	dart->dispext_unverified = true;
-	dart->dispext_sleeping = suspend;
-	dart->dispext_gen++;
-	spin_unlock_irqrestore(&dart->dispext_pm_lock, flags);
-	wait_event(dart->dispext_wq, !READ_ONCE(dart->dispext_users));
+	spin_lock_irqsave(&dart->pm_gate_lock, flags);
+	dart->pm_unverified = true;
+	dart->pm_sleeping = suspend;
+	dart->pm_gen++;
+	spin_unlock_irqrestore(&dart->pm_gate_lock, flags);
+	wait_event(dart->pm_wq, !READ_ONCE(dart->pm_users));
 }
 
 /* Every borrowed stream of @dart, for one reason. */
@@ -221,7 +222,7 @@ static bool apple_dart_dcp_registers(struct apple_dart_dcp *dcp)
 	struct apple_dart *dart = dcp->dart;
 	u32 protect, ttbr, tcr, streams;
 
-	/* An external display DART's callers hold a use of it (apple_dart_dispext_get()). */
+	/* An external display DART's callers hold a use of it (apple_dart_pm_get()). */
 	if (READ_ONCE(dcp->failed))
 		return false;
 	protect = readl(dart->regs + DART_T8110_PROTECT);
@@ -666,7 +667,7 @@ static phys_addr_t __apple_dart_dcp_translate(struct apple_dart_dcp *dcp, u64 io
 	 * An external display DART's registers only inside a use of them (its
 	 * power confirmed, a sleep waits for it): none, no lookup.
 	 */
-	if (dcp->failed || !apple_dart_dispext_get(dcp->dart))
+	if (dcp->failed || !apple_dart_pm_get(dcp->dart))
 		goto out;
 	used = true;
 	if (regs && !apple_dart_dcp_registers(dcp))
@@ -698,7 +699,7 @@ static phys_addr_t __apple_dart_dcp_translate(struct apple_dart_dcp *dcp, u64 io
 out:
 	spin_unlock_irqrestore(&dcp->lock, flags);
 	if (used)
-		apple_dart_dispext_put(dcp->dart);
+		apple_dart_pm_put(dcp->dart);
 	return phys;
 }
 
@@ -1440,13 +1441,13 @@ static size_t apple_dart_dcp_unmap(struct apple_dart_dcp *dcp, u64 iova,
 	 * has no generic DMA user (its host mappings are the private window and
 	 * scanout APIs, which never come through here).
 	 */
-	if (!apple_dart_dispext_get(dcp->dart)) {
+	if (!apple_dart_pm_get(dcp->dart)) {
 		dev_err_ratelimited(dcp->dart->dev, "SID%u unmap at %llx while unconfirmed since sleep: refused\n",
 				    dcp->sid, iova);
 		return 0;
 	}
 	unmapped = __apple_dart_dcp_unmap(dcp, iova, size, count, gather);
-	apple_dart_dispext_put(dcp->dart);
+	apple_dart_pm_put(dcp->dart);
 	return unmapped;
 }
 
diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 3cded361f9..90d7fee60d 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -318,20 +318,27 @@ struct apple_dart {
 	/* A J713 external display DART, borrowed from its external DCP */
 	bool dispext;
 	/*
-	 * J713 external display DART: its power confirmation across
-	 * sleep, under dispext_pm_lock (a spinlock: only these fields, never
+	 * A display DART whose power can go away under its borrowed streams:
+	 * an external display DART across sleep (its firmware powers it), or an
+	 * internal one powered down by its DCP. Its registers are used only
+	 * with its power confirmed (apple_dart_pm_get()).
+	 */
+	bool power_gated;
+	/*
+	 * Power-gated display DART: its power confirmation across
+	 * sleep, under pm_gate_lock (a spinlock: only these fields, never
 	 * across a register access): unverified from suspend until a state
 	 * check at a D572(1) of the current generation, which every suspend
 	 * and resume moves on; sleeping between suspend and resume; and the
-	 * register uses in flight (apple_dart_dispext_get()), which an
-	 * invalidation waits for (dispext_wq).
+	 * register uses in flight (apple_dart_pm_get()), which an
+	 * invalidation waits for (pm_wq).
 	 */
-	spinlock_t dispext_pm_lock;
-	bool dispext_unverified;
-	bool dispext_sleeping;
-	u64 dispext_gen;
-	unsigned int dispext_users;
-	wait_queue_head_t dispext_wq;
+	spinlock_t pm_gate_lock;	/* the pm_* fields below */
+	bool pm_unverified;
+	bool pm_sleeping;
+	u64 pm_gen;
+	unsigned int pm_users;
+	wait_queue_head_t pm_wq;
 	u32 dispext_protect, dispext_lock;	/* PROTECT and PROTECT_LOCK as adopted */
 	/* Retained radio/display state left in place across suspend-to-idle. */
 	bool s2idle_kept;
@@ -1572,10 +1579,10 @@ static int apple_dart_dcp_invalidate_tlb_gated(struct apple_dart_stream_map *str
 {
 	int ret;
 
-	if (!apple_dart_dispext_get(stream_map->dart))
+	if (!apple_dart_pm_get(stream_map->dart))
 		return -EAGAIN;
 	ret = apple_dart_dcp_invalidate_tlb(stream_map);
-	apple_dart_dispext_put(stream_map->dart);
+	apple_dart_pm_put(stream_map->dart);
 	return ret;
 }
 
@@ -2032,10 +2039,10 @@ static int apple_dart_dcp_domain_flush(struct apple_dart_domain *domain)
 	struct apple_dart *dart = domain->dcp->dart;
 	int ret;
 
-	if (!apple_dart_dispext_get(dart))
+	if (!apple_dart_pm_get(dart))
 		return -EAGAIN;
 	ret = __apple_dart_dcp_domain_flush(domain);
-	apple_dart_dispext_put(dart);
+	apple_dart_pm_put(dart);
 	return ret;
 }
 
@@ -2773,11 +2780,11 @@ static struct iommu_device *apple_dart_probe_device(struct device *dev)
 		int ret = -EINVAL;
 
 		/* An external display DART's registers only inside a use. */
-		if (borrowed && !apple_dart_dispext_get(borrowed->dart)) {
+		if (borrowed && !apple_dart_pm_get(borrowed->dart)) {
 			ret = -EAGAIN;
 		} else if (borrowed) {
 			ret = apple_dart_dcp_validate(borrowed, dev);
-			apple_dart_dispext_put(borrowed->dart);
+			apple_dart_pm_put(borrowed->dart);
 		}
 		if (ret)
 			return ERR_PTR(ret);
@@ -3057,7 +3064,7 @@ static int apple_dart_of_xlate(struct device *dev,
 #if IS_ENABLED(CONFIG_APPLE_DART_J713_DCP)
 /*
  * The check, inside a use of the DART's registers (on an external display
- * DART, apple_dart_dispext_get() by the caller).
+ * DART, apple_dart_pm_get() by the caller).
  */
 static int __apple_dart_dcp_check(struct device *dev)
 {
@@ -3147,10 +3154,10 @@ int apple_dart_dcp_check(struct device *dev)
 	if (!domain || domain->owner != &apple_dart_iommu_ops || !to_dart_domain(domain)->dcp)
 		return __apple_dart_dcp_check(dev);
 	dart = to_dart_domain(domain)->dcp->dart;
-	if (!apple_dart_dispext_get(dart))
+	if (!apple_dart_pm_get(dart))
 		return -EAGAIN;
 	ret = __apple_dart_dcp_check(dev);
-	apple_dart_dispext_put(dart);
+	apple_dart_pm_put(dart);
 	return ret;
 }
 EXPORT_SYMBOL_GPL(apple_dart_dcp_check);
@@ -4254,8 +4261,9 @@ static int apple_dart_probe(struct platform_device *pdev)
 	spin_lock_init(&dart->managed_lock);
 	dart->preserve_display = j713_display || j713_dcpext || j713_dispext;
 	dart->dispext = j713_dispext;
-	spin_lock_init(&dart->dispext_pm_lock);
-	init_waitqueue_head(&dart->dispext_wq);
+	dart->power_gated = j713_dispext;
+	spin_lock_init(&dart->pm_gate_lock);
+	init_waitqueue_head(&dart->pm_wq);
 	if (j713_dcpext)
 		dart->dcp_instance = &dcp_adt_external[res->start == 0x48a340000ULL];
 	else if (j713_dispext)
@@ -4979,7 +4987,7 @@ static __maybe_unused int apple_dart_suspend(struct device *dev)
 		if (pm_suspend_target_state != PM_SUSPEND_TO_IDLE)
 			return -EBUSY;
 		if (apple_dart_has_borrowed(dart))
-			apple_dart_dispext_invalidate(dart, true);
+			apple_dart_pm_invalidate(dart, true);
 		return 0;
 	}
 	/*
@@ -5098,13 +5106,13 @@ static __maybe_unused int apple_dart_resume(struct device *dev)
 	/*
 	 * An adopted external display DART may be off now, its display with it,
 	 * and nothing confirms otherwise: no register of it is read or written
-	 * (apple_dart_dispext_unconfirmed()) until its firmware powers it up
+	 * (apple_dart_pm_unconfirmed()) until its firmware powers it up
 	 * again; the state check then (apple_dart_dcp_dispext_state()) runs
 	 * first: kept, it goes on; lost, it is retired, saying so.
 	 */
 	if (dart->dispext) {
 		if (apple_dart_has_borrowed(dart)) {
-			apple_dart_dispext_invalidate(dart, false);
+			apple_dart_pm_invalidate(dart, false);
 			dev_dbg(dev, "external display DART unconfirmed after sleep\n");
 		}
 		return 0;
@@ -5205,16 +5213,16 @@ static int apple_dart_dispext_verify(struct apple_dart *dart, const char *when)
 	 * not while asleep (between suspend and resume nothing confirms its
 	 * power), and an invalidation meanwhile waits for it to end.
 	 */
-	spin_lock_irqsave(&dart->dispext_pm_lock, flags);
-	if (dart->dispext_sleeping) {
-		spin_unlock_irqrestore(&dart->dispext_pm_lock, flags);
+	spin_lock_irqsave(&dart->pm_gate_lock, flags);
+	if (dart->pm_sleeping) {
+		spin_unlock_irqrestore(&dart->pm_gate_lock, flags);
 		dev_dbg(dart->dev, "external display DART %s during sleep: not checked\n", when);
 		return -EAGAIN;
 	}
-	gen = dart->dispext_gen;
-	was = dart->dispext_unverified;
-	dart->dispext_users++;
-	spin_unlock_irqrestore(&dart->dispext_pm_lock, flags);
+	gen = dart->pm_gen;
+	was = dart->pm_unverified;
+	dart->pm_users++;
+	spin_unlock_irqrestore(&dart->pm_gate_lock, flags);
 
 	protect = readl(dart->regs + DART_T8110_PROTECT);
 	lock = readl(dart->regs + DART_T8110_PROTECT_LOCK);
@@ -5234,14 +5242,14 @@ static int apple_dart_dispext_verify(struct apple_dart *dart, const char *when)
 	kept &= (protect & lock & DART_T8110_PROTECT_TTBR_TCR) ==
 		(dart->dispext_protect & dart->dispext_lock & DART_T8110_PROTECT_TTBR_TCR);
 
-	spin_lock_irqsave(&dart->dispext_pm_lock, flags);
+	spin_lock_irqsave(&dart->pm_gate_lock, flags);
 	/* Only a check of the current generation confirms: a sleep since voids it. */
-	current_gen = gen == dart->dispext_gen;
+	current_gen = gen == dart->pm_gen;
 	if (kept && current_gen)
-		dart->dispext_unverified = false;
-	if (!--dart->dispext_users)
-		wake_up_all(&dart->dispext_wq);
-	spin_unlock_irqrestore(&dart->dispext_pm_lock, flags);
+		dart->pm_unverified = false;
+	if (!--dart->pm_users)
+		wake_up_all(&dart->pm_wq);
+	spin_unlock_irqrestore(&dart->pm_gate_lock, flags);
 
 	dev_dbg(dart->dev, "external display DART %s: protect %08x lock %08x (adopted %08x/%08x): state %s%s%s\n",
 		when, protect, lock, dart->dispext_protect, dart->dispext_lock,
