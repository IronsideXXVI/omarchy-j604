From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 21:52:21 +0000
Subject: [PATCH] soc: apple: s2r: check what suspend-to-RAM needs
 before offering it

->enter powers the parked CPUs down for good and may tell the enclave to
sleep before it saves the CPU complex state, so a machine without a
cluster that can be re-initialised (no CPU complex described for cluster
power gating) found out only after that: the state save returned
-ENODEV, the sleep was refused, and every secondary CPU stayed offline
until the next reboot.

Check the prerequisites first:
 - apple_cpu_acc_available(): a cluster whose CPU complex state can be
   saved, which apple_cpu_acc_save() needs;
 - apple_sleep_ap_wake_ready(): the AP wake sources, which the wake
   source step needs.

The suspend ops' ->valid does the check, so "deep" is not offered in
mem_sleep at all where a step cannot run, and a suspend that asks for it
is refused before anything is frozen. At our own probe the wake sources
may not have probed yet, so only the cluster is checked there; every
later call checks both, and ->enter checks both again before a core is
parked or a coprocessor is told or stopped. The probe says why
suspend-to-RAM is not offered.

There is no switch to skip the check: once a cluster has its CPU complex
described, it passes by itself.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/include/asm/apple_cpu.h |  6 ++++
 arch/arm64/kernel/apple_cpu.c      | 20 ++++++++++++
 drivers/soc/apple/apple-s2r.c      | 49 ++++++++++++++++++++++++++++--
 drivers/soc/apple/apple-sleep.c    |  9 ++++++
 include/linux/soc/apple/sleep.h    |  2 ++
 5 files changed, 84 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/include/asm/apple_cpu.h b/arch/arm64/include/asm/apple_cpu.h
index 221d6d24cf..0f272966f4 100644
--- a/arch/arm64/include/asm/apple_cpu.h
+++ b/arch/arm64/include/asm/apple_cpu.h
@@ -19,6 +19,7 @@
 void __noreturn apple_cpu_deep_sleep(unsigned int flags);
 int apple_cpu_acc_save(void);
 int apple_cpu_acc_restore(void);
+bool apple_cpu_acc_available(void);
 int apple_cpu_park_power_down_all(void);
 void apple_cpu_power_cycled(void);
 
@@ -36,6 +37,11 @@ static inline int apple_cpu_acc_restore(void)
 	return -ENODEV;
 }
 
+static inline bool apple_cpu_acc_available(void)
+{
+	return false;
+}
+
 static inline int apple_cpu_park_power_down_all(void)
 {
 	return 0;
diff --git a/arch/arm64/kernel/apple_cpu.c b/arch/arm64/kernel/apple_cpu.c
index 99a1baaf28..125b4a4de9 100644
--- a/arch/arm64/kernel/apple_cpu.c
+++ b/arch/arm64/kernel/apple_cpu.c
@@ -1314,6 +1314,26 @@ int apple_cpu_acc_save(void)
 }
 EXPORT_SYMBOL_GPL(apple_cpu_acc_save);
 
+/**
+ * apple_cpu_acc_available() - whether apple_cpu_acc_save() has a cluster to save
+ *
+ * For a suspend-to-RAM preflight: without a cluster that has its CPU complex
+ * described (cluster power gating), apple_cpu_acc_save() returns -ENODEV, and
+ * by then the parked CPUs have already been powered down for good.
+ *
+ * Return: true if at least one cluster can be re-initialised.
+ */
+bool apple_cpu_acc_available(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < apple_nr_clusters; i++)
+		if (apple_clusters[i].acc)
+			return true;
+	return false;
+}
+EXPORT_SYMBOL_GPL(apple_cpu_acc_available);
+
 /**
  * apple_cpu_park_power_down_all() - power down every parked CPU
  *
diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 35a1cccb0a..329753dc0d 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -1013,6 +1013,41 @@ static bool apple_s2r_abort_reachable(struct apple_s2r *s2r, unsigned int ab)
 	}
 }
 
+/*
+ * Preflight: what ->enter needs on this machine, checked before anything that
+ * can't be undone. A missing piece makes a later step fail after the parked
+ * CPUs were powered down for good and maybe after the enclave was told.
+ * @full: also what depends on other drivers having probed (not yet at our
+ * own probe).
+ *
+ * Return: NULL when suspend-to-RAM can run, otherwise why not.
+ */
+static const char *apple_s2r_preflight(bool full)
+{
+	if (!apple_s2r)
+		return "no suspend-to-RAM driver";
+	if (!apple_cpu_acc_available())
+		return "no CPU cluster has its CPU complex described (cluster power gating)";
+	if (full && !apple_sleep_ap_wake_ready())
+		return "no AP wake sources set up, the wake source step cannot run";
+	return NULL;
+}
+
+/* Set while our own probe registers the ops, before the other drivers probed */
+static bool apple_s2r_registering;
+
+static int apple_s2r_valid(suspend_state_t state)
+{
+	const char *why;
+
+	if (state != PM_SUSPEND_MEM)
+		return 0;
+	why = apple_s2r_preflight(!READ_ONCE(apple_s2r_registering));
+	if (why && !READ_ONCE(apple_s2r_registering))
+		pr_warn_ratelimited("apple-s2r: suspend-to-RAM refused: %s\n", why);
+	return !why;
+}
+
 static int apple_s2r_enter(suspend_state_t state)
 {
 	struct apple_s2r *s2r = apple_s2r;
@@ -1024,6 +1059,12 @@ static int apple_s2r_enter(suspend_state_t state)
 		return -EBUSY;
 	}
 
+	/* Again, before a core is parked or a coprocessor is told or stopped */
+	if (apple_s2r_preflight(true)) {
+		pr_warn("apple-s2r: suspend-to-RAM refused: %s\n", apple_s2r_preflight(true));
+		return -ENODEV;
+	}
+
 	/*
 	 * Bring-up: an aborted run that still tells the enclave reaches a
 	 * stop no log can report, so only with the breadcrumb and the
@@ -1347,7 +1388,7 @@ static void apple_s2r_resume_end(void)
 }
 
 static const struct platform_suspend_ops apple_s2r_ops = {
-	.valid = suspend_valid_only_mem,
+	.valid = apple_s2r_valid,
 	.begin = apple_s2r_begin,
 	.prepare_late = apple_s2r_prepare_late,
 	.enter = apple_s2r_enter,
@@ -1602,15 +1643,19 @@ static int apple_s2r_probe(struct platform_device *pdev)
 	 * refuses a sleep that powers the SoC down once the firmware ran: with
 	 * "deep" as the default every suspend would fail. Offer it only.
 	 */
+	WRITE_ONCE(apple_s2r_registering, true);
 	if (default_deep)
 		suspend_set_ops(&apple_s2r_ops);
 	else
 		suspend_set_ops_keep_s2idle(&apple_s2r_ops);
+	WRITE_ONCE(apple_s2r_registering, false);
 
 	if (s2r->rvbar_last)
 		apple_s2r_debugfs_init(dev);
 
-	if (s2r->mailbox)
+	if (apple_s2r_preflight(false))
+		dev_info(dev, "suspend-to-RAM not offered: %s\n", apple_s2r_preflight(false));
+	else if (s2r->mailbox)
 		dev_info(dev, "suspend-to-RAM available (mailbox at %#llx, reset vector %#llx)%s\n",
 			 mailbox, s2r->reset_vector,
 			 s2r->timer ? "" : ", without clock/PLL/timer steps");
diff --git a/drivers/soc/apple/apple-sleep.c b/drivers/soc/apple/apple-sleep.c
index 299ea2ad11..c6302eacab 100644
--- a/drivers/soc/apple/apple-sleep.c
+++ b/drivers/soc/apple/apple-sleep.c
@@ -638,6 +638,15 @@ void apple_sleep_pmgr_wake(void)
 }
 EXPORT_SYMBOL_GPL(apple_sleep_pmgr_wake);
 
+/* For a suspend-to-RAM preflight: whether apple_sleep_ap_wake_arm() can run */
+bool apple_sleep_ap_wake_ready(void)
+{
+	struct apple_sleep *s = apple_sleep;
+
+	return s && s->wake && s->has_wake_sources;
+}
+EXPORT_SYMBOL_GPL(apple_sleep_ap_wake_ready);
+
 int apple_sleep_ap_wake_arm(void)
 {
 	struct apple_sleep *s = apple_sleep;
diff --git a/include/linux/soc/apple/sleep.h b/include/linux/soc/apple/sleep.h
index 7d14b5e95a..7ab8fb837e 100644
--- a/include/linux/soc/apple/sleep.h
+++ b/include/linux/soc/apple/sleep.h
@@ -43,6 +43,7 @@ void apple_sleep_cpm_restore(void);
 void apple_sleep_pmgr_wake(void);
 int apple_sleep_ap_wake_arm(void);
 void apple_sleep_ap_wake_restore(void);
+bool apple_sleep_ap_wake_ready(void);
 /*
  * From the SMC's driver, in its noirq resume: the SMC woke the AP for the lid alone, and the
  * lid reads closed. If nothing else woke the SoC, the PM core goes back to sleep once every
@@ -63,6 +64,7 @@ static inline void apple_sleep_cpm_restore(void) { }
 static inline void apple_sleep_pmgr_wake(void) { }
 static inline int apple_sleep_ap_wake_arm(void) { return -ENODEV; }
 static inline void apple_sleep_ap_wake_restore(void) { }
+static inline bool apple_sleep_ap_wake_ready(void) { return false; }
 static inline void apple_sleep_lid_closed_wake(void) { }
 
 #endif
