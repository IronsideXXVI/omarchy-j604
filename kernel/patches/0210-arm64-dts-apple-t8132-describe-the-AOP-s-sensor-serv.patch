From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Friedrich <261542475+aeries0x@users.noreply.github.com>
Date: Tue, 10 Nov 2026 17:44:26 +0100
Subject: [PATCH] arm64: dts: apple: t8132: describe the AOP's sensor
 services

The T8132 AOP node had only its audio service, so the light sensor,
lid angle, motion and board temperature services the firmware
announces got devices without a node and no driver bound to them
(their drivers match by compatible). Add the nodes as on T6041, and
the T8132 compatibles to the bindings that listed only T6041 (the
motion binding already has them). A board whose ADT lacks a service
gets no device for it; the loader already copies the accelerometer's
and gyroscope's calibration into nodes of these names. On the laptops
the accelerometer is in the base, labelled as on the M4 Pro laptops.

Assisted-by: LLM
Signed-off-by: Friedrich <261542475+aeries0x@users.noreply.github.com>
(cherry picked from commit 2162355cb0b96681b3a67b6a714a40ee4764daee)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../bindings/iio/imu/apple,aop-devmotion.yaml |  4 ++-
 .../iio/temperature/apple,aop-temp.yaml       |  4 ++-
 arch/arm64/boot/dts/apple/t8132-laptop.dtsi   |  5 ++++
 arch/arm64/boot/dts/apple/t8132.dtsi          | 29 +++++++++++++++++++
 4 files changed, 40 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/iio/imu/apple,aop-devmotion.yaml b/Documentation/devicetree/bindings/iio/imu/apple,aop-devmotion.yaml
index 22e0950345..4a284ba64b 100644
--- a/Documentation/devicetree/bindings/iio/imu/apple,aop-devmotion.yaml
+++ b/Documentation/devicetree/bindings/iio/imu/apple,aop-devmotion.yaml
@@ -17,7 +17,9 @@ description:
 properties:
   compatible:
     items:
-      - const: apple,t6041-aop-devmotion6
+      - enum:
+          - apple,t6041-aop-devmotion6
+          - apple,t8132-aop-devmotion6
       - const: apple,aop-devmotion6
 
 required:
diff --git a/Documentation/devicetree/bindings/iio/temperature/apple,aop-temp.yaml b/Documentation/devicetree/bindings/iio/temperature/apple,aop-temp.yaml
index 3652ae2c78..f7df7e338c 100644
--- a/Documentation/devicetree/bindings/iio/temperature/apple,aop-temp.yaml
+++ b/Documentation/devicetree/bindings/iio/temperature/apple,aop-temp.yaml
@@ -18,7 +18,9 @@ description: |
 properties:
   compatible:
     items:
-      - const: apple,t6041-aop-als-temp
+      - enum:
+          - apple,t6041-aop-als-temp
+          - apple,t8132-aop-als-temp
       - const: apple,aop-als-temp
 
   apple,temp-offset-calibration:
diff --git a/arch/arm64/boot/dts/apple/t8132-laptop.dtsi b/arch/arm64/boot/dts/apple/t8132-laptop.dtsi
index cfb8d81d32..c6a1a5ee78 100644
--- a/arch/arm64/boot/dts/apple/t8132-laptop.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-laptop.dtsi
@@ -100,6 +100,11 @@
 	dma-names = "dma", "spkr", "sense", "cout", "cin";
 };
 
+/* The sensor is on the logic board, in the base. */
+&aop_accel {
+	label = "accel-base";
+};
+
 &fpwm1 {
 	status = "okay";
 };
diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 680b4afbc9..da81240f36 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -1029,6 +1029,35 @@
 			dma-names = "dma";
 			#sound-dai-cells = <1>;
 		};
+
+		/*
+		 * The sensor services the firmware announces; a board whose ADT
+		 * lacks one simply gets no device for it. The loader copies the
+		 * accelerometer's and gyroscope's calibration into their nodes.
+		 */
+		aop_als: als {
+			compatible = "apple,t8132-aop-als", "apple,aop-als";
+		};
+
+		aop_las: las {
+			compatible = "apple,t8132-aop-las", "apple,aop-las";
+		};
+
+		aop_accel: accel {
+			compatible = "apple,t8132-aop-accel", "apple,aop-accel";
+		};
+
+		aop_gyro: gyro {
+			compatible = "apple,t8132-aop-gyro", "apple,aop-gyro";
+		};
+
+		aop_devmotion: devmotion6 {
+			compatible = "apple,t8132-aop-devmotion6", "apple,aop-devmotion6";
+		};
+
+		aop_temp: als-temp {
+			compatible = "apple,t8132-aop-als-temp", "apple,aop-als-temp";
+		};
 	};
 
 	/* ADT lists the interrupts as 1, 0, 3, 2 of the block: send-empty is the lowest. */
-- 
2.43.0

