From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 9 Nov 2026 23:59:16 +0000
Subject: [PATCH] drm/asahi: g16: try a firmware stop and warm restart
 across suspend-to-RAM

A sleep that powers the SoC down is refused once the G16 firmware has
run, because nothing stops it before the sleep or restarts it after. The
RTKit library already has both halves, used by the PMP, DCP and ANS:
apple_rtkit_sleep_stop() idles the firmware and clears the ASC run bit,
apple_rtkit_sleep_return() restarts it warm with its buffers and
endpoints kept once the sleep reached the hardware.

Add asahi.g16_deep_sleep (default 0, writable by root at run time). Set,
.prepare lets such a sleep through instead of refusing it, .suspend_late
stops the firmware (interrupts still on) and .resume_early restarts it
once its power domain is back. A failed stop refuses the sleep; a
firmware that does not come back is logged and leaves the GPU failed,
while the rest of the system resumes. Whether the G16 firmware comes
back this way on the J604 is what the parameter is for, so the default
keeps the refusal.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/boot.rs   |   6 ++
 drivers/gpu/drm/asahi/g16/params.rs |  18 +++++
 drivers/gpu/drm/asahi/g16/regs.rs   |   6 ++
 drivers/gpu/drm/asahi/g16/sleep.rs  | 115 ++++++++++++++++++++++++++--
 4 files changed, 139 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/boot.rs b/drivers/gpu/drm/asahi/g16/boot.rs
index 13d67873cf..9432dc573e 100644
--- a/drivers/gpu/drm/asahi/g16/boot.rs
+++ b/drivers/gpu/drm/asahi/g16/boot.rs
@@ -354,6 +354,11 @@ impl Rtkit {
         to_result(unsafe { bindings::apple_rtkit_wake(self.rtk) })
     }
 
+    /// The C handle, for the system sleep path. Live until reboot (never freed).
+    pub(crate) fn raw(&self) -> *mut bindings::apple_rtkit {
+        self.rtk
+    }
+
     fn running(&self) -> bool {
         // SAFETY: `rtk` is retained and valid for the session lifetime.
         unsafe {
@@ -849,6 +854,7 @@ pub(crate) fn start(
         return Err(e);
     }
     let (init, channels, max_frequency_khz) = built.ok_or(EINVAL)?;
+    super::sleep::publish(session.rtkit.raw(), session.regs.asc_control_ptr());
     Ok(Booted {
         session,
         init,
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 69ba4dd743..c6b52da980 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -446,6 +446,24 @@ live_u32_param!(
     "G16: runtime completion repoll interval, us (default 0 = g16_resnap_us; 10..1000; runtime 0644)"
 );
 
+/// Storage of `g16_deep_sleep` (runtime 0644, testing; any nonzero value means on).
+static DEEP_SLEEP: AtomicU32 = AtomicU32::new(0);
+
+/// Whether a sleep that powers the SoC down stops the firmware and warm-restarts it on resume
+/// (testing, default off), instead of being refused. See `sleep.rs`.
+pub(crate) fn deep_sleep() -> bool {
+    DEEP_SLEEP.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    DEEP_SLEEP_PARAM,
+    DEEP_SLEEP_PARMTYPE,
+    DEEP_SLEEP_PARM,
+    DEEP_SLEEP,
+    "g16_deep_sleep",
+    "G16: stop and warm-restart the firmware across suspend-to-RAM (testing; default 0; runtime 0644)"
+);
+
 /// Fragment-only dependency publication has not been qualified on this backend.
 pub(crate) fn early_tiling() -> bool {
     false
diff --git a/drivers/gpu/drm/asahi/g16/regs.rs b/drivers/gpu/drm/asahi/g16/regs.rs
index e264e319c2..15a17e61f5 100644
--- a/drivers/gpu/drm/asahi/g16/regs.rs
+++ b/drivers/gpu/drm/asahi/g16/regs.rs
@@ -246,6 +246,12 @@ impl Regs {
         self.asc.io().try_write32(value, ASC_CONTROL)
     }
 
+    /// The ASC control word as the C RTKit sleep helpers take it (`cpu_control`). Valid as
+    /// long as this `Regs` lives; the session keeps it until reboot.
+    pub(crate) fn asc_control_ptr(&self) -> *mut core::ffi::c_void {
+        (self.asc.raw.addr() + ASC_CONTROL) as *mut core::ffi::c_void
+    }
+
     /// Engine receipts, under the device lock: busy is bit 0 of `C020 | C120`; the fault status
     /// is `D8C0` under fault-bank selectors 0 and 1 (`D800`), with the saved selector restored.
     /// 64-bit accesses.
diff --git a/drivers/gpu/drm/asahi/g16/sleep.rs b/drivers/gpu/drm/asahi/g16/sleep.rs
index 5d4086666f..6ed4a1fadc 100644
--- a/drivers/gpu/drm/asahi/g16/sleep.rs
+++ b/drivers/gpu/drm/asahi/g16/sleep.rs
@@ -5,20 +5,55 @@
 //! Suspend-to-idle keeps the SoC powered, and the GPU firmware runs through it with its own idle
 //! power management (`asahi.g16_idle_power_off`). A sleep that powers the SoC down
 //! (`pm_suspend_via_firmware()`) takes the GPU's ASC, its power domain and the state iBoot set up
-//! for the cold start with it. G16 has no firmware stop (RTKit idle, then the ASC stopped) and no
-//! warm restart (the ASC started again with the firmware's state kept in DRAM, the RTKit handshake
-//! and no initialization, as macOS does on T8140), so such a sleep is refused once the firmware
-//! has been touched. A G16 that never got that far has nothing to lose; the PMP still refuses the
-//! sleep if the AGX vote was taken.
+//! for the cold start with it. G16 has no qualified firmware stop (RTKit idle, then the ASC
+//! stopped) and warm restart (the ASC started again with the firmware's state kept in DRAM, the
+//! RTKit handshake and no initialization, as macOS does on T8140), so such a sleep is refused
+//! once the firmware has been touched. A G16 that never got that far has nothing to lose; the PMP
+//! still refuses the sleep if the AGX vote was taken.
+//!
+//! For bring-up, `asahi.g16_deep_sleep=1` takes such a sleep instead: the firmware is idled and
+//! its ASC stopped late in the suspend (`.suspend_late`, interrupts still on), and restarted warm
+//! early in the resume (`.resume_early`, after the power domain is back). Whether the G16
+//! firmware comes back from that on the J604 is what the parameter is for; a firmware that does
+//! not come back leaves the GPU failed until reboot, the rest of the system resumes.
+
+use core::ffi::c_void;
+use core::ptr::null_mut;
+use core::sync::atomic::{AtomicBool, AtomicPtr, Ordering};
 
-use kernel::{bindings, device, prelude::*};
+use kernel::{bindings, device, error::to_result, prelude::*};
 
 mod policy;
 
 use policy::Verdict;
 
+/// The firmware's RTKit handle and ASC control word, published once the firmware runs.
+static RTK: AtomicPtr<bindings::apple_rtkit> = AtomicPtr::new(null_mut());
+static ASC_CONTROL: AtomicPtr<c_void> = AtomicPtr::new(null_mut());
+/// This sleep stops the firmware (set in `.prepare`, cleared in `.complete`).
+static STOP_WANTED: AtomicBool = AtomicBool::new(false);
+/// The firmware was stopped by `.suspend_late` and must be restarted.
+static STOPPED: AtomicBool = AtomicBool::new(false);
+
+/// Called once the firmware has started: both pointers stay valid until reboot.
+pub(crate) fn publish(rtk: *mut bindings::apple_rtkit, asc_control: *mut c_void) {
+    ASC_CONTROL.store(asc_control, Ordering::Release);
+    RTK.store(rtk, Ordering::Release);
+}
+
+fn firmware() -> Option<(*mut bindings::apple_rtkit, *mut c_void)> {
+    let rtk = RTK.load(Ordering::Acquire);
+    let control = ASC_CONTROL.load(Ordering::Acquire);
+    if rtk.is_null() || control.is_null() {
+        None
+    } else {
+        Some((rtk, control))
+    }
+}
+
 /// `.prepare`, before any device suspends, so that the refusal comes before anything stopped.
 unsafe extern "C" fn sleep_prepare(dev: *mut bindings::device) -> core::ffi::c_int {
+    STOP_WANTED.store(false, Ordering::Relaxed);
     // SAFETY: Reads a global flag word.
     let via_firmware = unsafe { bindings::pm_suspend_via_firmware() };
     let verdict = policy::verdict(via_firmware, super::boot::glue::retained());
@@ -34,6 +69,14 @@ unsafe extern "C" fn sleep_prepare(dev: *mut bindings::device) -> core::ffi::c_i
         );
         return 0;
     }
+    if super::params::deep_sleep() && firmware().is_some() {
+        dev_warn!(
+            d,
+            "G16: testing (g16_deep_sleep=1): stopping the firmware for a sleep that powers the SoC down, warm restart on resume\n"
+        );
+        STOP_WANTED.store(true, Ordering::Relaxed);
+        return 0;
+    }
     dev_warn!(
         d,
         "G16: refusing a sleep that powers the SoC down: the GPU firmware has no stop and warm restart yet and would not come back (suspend-to-idle is not affected)\n"
@@ -41,6 +84,63 @@ unsafe extern "C" fn sleep_prepare(dev: *mut bindings::device) -> core::ffi::c_i
     EBUSY.to_errno()
 }
 
+/// `.suspend_late`: idles the firmware and stops its ASC, interrupts still on.
+unsafe extern "C" fn sleep_suspend_late(dev: *mut bindings::device) -> core::ffi::c_int {
+    if !STOP_WANTED.load(Ordering::Relaxed) {
+        return 0;
+    }
+    let Some((rtk, control)) = firmware() else {
+        return 0;
+    };
+    // SAFETY: The PM core passes the bound device and holds a reference to it for the callback.
+    let d = unsafe { device::Device::<device::Normal>::from_raw(dev) };
+    // SAFETY: Both pointers were published by the running session and live until reboot.
+    match to_result(unsafe { bindings::apple_rtkit_sleep_stop(rtk, control) }) {
+        Ok(()) => {
+            STOPPED.store(true, Ordering::Relaxed);
+            dev_info!(d, "G16: firmware idled and ASC stopped for the sleep\n");
+            0
+        }
+        Err(e) => {
+            dev_err!(d, "G16: firmware stop failed: {:?}; refusing the sleep\n", e);
+            // SAFETY: As above. Without a real sleep this only checks that it still runs.
+            let back = to_result(unsafe { bindings::apple_rtkit_sleep_return(rtk, control) });
+            if let Err(e2) = back {
+                dev_err!(d, "G16: firmware not running after the failed stop: {:?}\n", e2);
+            }
+            e.to_errno()
+        }
+    }
+}
+
+/// `.resume_early`: restarts the stopped firmware warm, once its power domain is back.
+unsafe extern "C" fn sleep_resume_early(dev: *mut bindings::device) -> core::ffi::c_int {
+    if !STOPPED.swap(false, Ordering::Relaxed) {
+        return 0;
+    }
+    let Some((rtk, control)) = firmware() else {
+        return 0;
+    };
+    // SAFETY: The PM core passes the bound device and holds a reference to it for the callback.
+    let d = unsafe { device::Device::<device::Normal>::from_raw(dev) };
+    // SAFETY: Both pointers were published by the running session and live until reboot.
+    match to_result(unsafe { bindings::apple_rtkit_sleep_return(rtk, control) }) {
+        Ok(()) => dev_info!(d, "G16: firmware warm-restarted after the sleep\n"),
+        Err(e) => dev_err!(
+            d,
+            "G16: firmware did not come back after the sleep: {:?}; the GPU stays failed until reboot\n",
+            e
+        ),
+    }
+    // A failed GPU must not stop the rest of the system from resuming.
+    0
+}
+
+/// `.complete`: the sleep is over, whatever happened.
+unsafe extern "C" fn sleep_complete(_dev: *mut bindings::device) {
+    STOP_WANTED.store(false, Ordering::Relaxed);
+}
+
 struct SleepOps(bindings::dev_pm_ops);
 
 // SAFETY: Immutable: the callbacks are plain functions.
@@ -48,6 +148,9 @@ unsafe impl Sync for SleepOps {}
 
 static OPS: SleepOps = SleepOps(bindings::dev_pm_ops {
     prepare: Some(sleep_prepare),
+    complete: Some(sleep_complete),
+    suspend_late: Some(sleep_suspend_late),
+    resume_early: Some(sleep_resume_early),
     // SAFETY: All-zero is the absence of every other callback.
     ..unsafe { core::mem::zeroed() }
 });
