From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 19:10:45 +0000
Subject: [PATCH] drm: apple: dcp: route DP Alt Mode on a T8132 dcpext

A T8132 dcpext's Type-C routes dropped every DP Alt Mode state ("no DP
alt mode PHY on this SoC"): the routes served Thunderbolt/USB4 DP
tunnels only. A Type-C port's PHY now runs DisplayPort on its four lanes
when it has its calibration (phy: apple: atc: run DP Alt Mode on a T8132
Type-C port's four lanes), so route those states as on the other SoCs:
the crossbar's DP PHY output selected for the dcpext (selector 2 or 4),
the route's PHY as the DPTX PHY, DFP port 0.

The check that used to refuse them meant two things. Split it:
dcp_typec_route_t8132() keeps the three uses about the dcpext itself (its
idle tunnel output, no tiles, no apple_crtc connector), and
dcp_typec_route_dp_alt() decides the DP Alt Mode state, through the pure
dcp_fabric_t8132_dp_alt() with the PHY's answer from
apple_atc_dp_alt_lanes(): pin assignments C and E on a calibrated PHY are
routed; D (two lanes beside USB3, not run on T8132) and a PHY without the
calibration, or no PHY module, are taken as applied with an info line,
as before, so the port controller's mode change goes on and the PHY
serves the USB beside the lanes. The route activation refuses the DP PHY
output on the same decision.

A T8132 dcpext has no connector of this driver, so the HPD replay only
marked the cable connected. Connect it from the reconnect work, which
waits for the firmware, as its tunnels do (dcp_typec_connect_sink(),
used by the direct route and by a port given a pipeline later). The
connector state then follows the firmware's sink report as for a tunnel
(t8132_ext_drm.c, iomfb_m4_ext_detect()).

KUnit (apple-dcp-fabric scenario S50h): C/E with a calibrated PHY route;
D does not; no calibration, a missing PHY module and a phy that is no ATC
DP PHY do not route.

[j604: X2-01 C2b (BOARD-SWEEP-1838 row X2). Not run on the J604: the
 routes are enabled only by a boot loader that hands the dcpext over with
 them (m1n1 patch in X2-01), and a USB-C monitor is needed at the desk.
 An IRQ_HPD from the sink is not forwarded on T8132 (no connector of this
 driver), as for its tunnels.]

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 4020097268e03beaead4037e99b07957992422ea)
(cherry picked from commit 902b76332da117f38ab5666603b9924852cd122c)
(cherry picked from commit c7f99128ced140a5e398fea0a1e9cccde434c86c)
---
 drivers/gpu/drm/apple/dcp-fabric-core.c | 15 +++++
 drivers/gpu/drm/apple/dcp-fabric-core.h | 12 ++++
 drivers/gpu/drm/apple/dcp-fabric-test.c | 16 +++++
 drivers/gpu/drm/apple/dcp-fabric.c      | 89 +++++++++++++++++++------
 drivers/gpu/drm/apple/dcp.c             |  2 +-
 5 files changed, 111 insertions(+), 23 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-fabric-core.c b/drivers/gpu/drm/apple/dcp-fabric-core.c
index 4d787164ed..95b86a132e 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-core.c
+++ b/drivers/gpu/drm/apple/dcp-fabric-core.c
@@ -551,5 +551,20 @@ dcp_fabric_t8132_hdmi_step(bool has_fixed, bool dead, bool session_ready,
 }
 EXPORT_SYMBOL_GPL(dcp_fabric_t8132_hdmi_step);
 
+/*
+ * A DP Alt Mode state on a T8132 dcpext's Type-C route. The port's PHY runs
+ * DisplayPort on its four lanes only (pin assignments C and E), and only with
+ * its calibration (@phy_lanes > 0, from apple_atc_dp_alt_lanes(); 0 or an
+ * error otherwise, including a PHY module that is not there).
+ */
+enum dcp_fabric_t8132_dp_alt dcp_fabric_t8132_dp_alt(int phy_lanes, bool four_lanes)
+{
+	if (phy_lanes <= 0)
+		return DCP_FABRIC_T8132_DP_ALT_NO_PHY;
+	return four_lanes ? DCP_FABRIC_T8132_DP_ALT_ROUTE :
+			    DCP_FABRIC_T8132_DP_ALT_TWO_LANES;
+}
+EXPORT_SYMBOL_GPL(dcp_fabric_t8132_dp_alt);
+
 MODULE_DESCRIPTION("Apple display fabric decisions");
 MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/gpu/drm/apple/dcp-fabric-core.h b/drivers/gpu/drm/apple/dcp-fabric-core.h
index d1f8755ade..4d49d623e5 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-core.h
+++ b/drivers/gpu/drm/apple/dcp-fabric-core.h
@@ -227,4 +227,16 @@ dcp_fabric_t8132_hdmi_step(bool has_fixed, bool dead, bool session_ready,
 			   bool service_ready, unsigned int tries,
 			   unsigned int max_tries);
 
+/* What a T8132 dcpext's Type-C route does with a DP Alt Mode state. */
+enum dcp_fabric_t8132_dp_alt {
+	/* Four calibrated DP lanes: route the display. */
+	DCP_FABRIC_T8132_DP_ALT_ROUTE,
+	/* The port's PHY runs no DisplayPort: not routed, its USB goes on. */
+	DCP_FABRIC_T8132_DP_ALT_NO_PHY,
+	/* Pin assignment D, two lanes beside USB3: not run on T8132. */
+	DCP_FABRIC_T8132_DP_ALT_TWO_LANES,
+};
+
+enum dcp_fabric_t8132_dp_alt dcp_fabric_t8132_dp_alt(int phy_lanes, bool four_lanes);
+
 #endif /* __APPLE_DCP_FABRIC_CORE_H__ */
diff --git a/drivers/gpu/drm/apple/dcp-fabric-test.c b/drivers/gpu/drm/apple/dcp-fabric-test.c
index a22f05c190..f1504d1f2b 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-test.c
+++ b/drivers/gpu/drm/apple/dcp-fabric-test.c
@@ -252,6 +252,7 @@ static const struct fabric_scenario scenarios[] = {
 	{ "S50e_t6030_crossbar_core", 54 },
 	{ "S50f_unwired_m3_ports_core", 55 },
 	{ "S50g_t8132_hdmi_start_core", 56 },
+	{ "S50h_t8132_dp_alt_core", 57 },
 };
 
 static void fabric_scenario_desc(const struct fabric_scenario *scenario,
@@ -490,6 +491,21 @@ static void fabric_scenario_test(struct kunit *test)
 		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_hdmi_step(true, false, true, false, 4, 4),
 				DCP_FABRIC_T8132_HDMI_IDLE);
 		break;
+	case 57:
+		/* Four calibrated lanes (C, E): routed. */
+		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_dp_alt(1, true),
+				DCP_FABRIC_T8132_DP_ALT_ROUTE);
+		/* Pin assignment D with a calibrated PHY: two lanes, not run. */
+		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_dp_alt(1, false),
+				DCP_FABRIC_T8132_DP_ALT_TWO_LANES);
+		/* No calibration, no PHY module, not an ATC DP PHY: not routed. */
+		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_dp_alt(0, true),
+				DCP_FABRIC_T8132_DP_ALT_NO_PHY);
+		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_dp_alt(-ENOENT, true),
+				DCP_FABRIC_T8132_DP_ALT_NO_PHY);
+		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_dp_alt(-EINVAL, false),
+				DCP_FABRIC_T8132_DP_ALT_NO_PHY);
+		break;
 	case 55:
 		f.port[0].next = NULL;
 		KUNIT_EXPECT_EQ(test, dcp_fabric_tunnel_request(f.port, 2, 0, &found), -ENODEV);
diff --git a/drivers/gpu/drm/apple/dcp-fabric.c b/drivers/gpu/drm/apple/dcp-fabric.c
index 64eece6922..b6ced8f009 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.c
+++ b/drivers/gpu/drm/apple/dcp-fabric.c
@@ -192,15 +192,41 @@ bool dcp_hdmi_port_attached(struct apple_dcp *dcp)
 }
 
 /*
- * A route of an adopted T8132 dcpext. Its PHY has no DP alt mode, so the
- * crossbar's DP PHY output has nothing behind it, and the dcpext is no
- * apple_crtc pipeline: its DRM objects are its own (t8132_ext_drm.c).
+ * A route of an adopted T8132 dcpext. The dcpext is no apple_crtc pipeline:
+ * its DRM objects are its own (t8132_ext_drm.c).
  */
-static bool dcp_typec_route_no_dp_alt(const struct apple_dcp_typec_route *route)
+static bool dcp_typec_route_t8132(const struct apple_dcp_typec_route *route)
 {
 	return of_device_is_compatible(route->dcp->dev->of_node, "apple,t8132-dcpext");
 }
 
+static bool dcp_typec_dp_four_lanes(unsigned long mode)
+{
+	return mode == TYPEC_DP_STATE_C || mode == TYPEC_DP_STATE_E;
+}
+
+/*
+ * What @route does with DP Alt Mode state @mode: every route but a T8132
+ * dcpext's takes it. There the port's PHY decides, see
+ * dcp_fabric_t8132_dp_alt(); the crossbar's DP PHY output has nothing behind
+ * it otherwise.
+ */
+static enum dcp_fabric_t8132_dp_alt
+dcp_typec_route_dp_alt(const struct apple_dcp_typec_route *route, unsigned long mode)
+{
+	typeof(apple_atc_dp_alt_lanes) *lanes;
+	int ret = -ENOENT;
+
+	if (!dcp_typec_route_t8132(route))
+		return DCP_FABRIC_T8132_DP_ALT_ROUTE;
+	lanes = symbol_get(apple_atc_dp_alt_lanes);
+	if (lanes) {
+		ret = lanes(route->phy);
+		symbol_put(apple_atc_dp_alt_lanes);
+	}
+	return dcp_fabric_t8132_dp_alt(ret, dcp_typec_dp_four_lanes(mode));
+}
+
 bool dcp_is_t8132_ext(const struct apple_dcp *dcp)
 {
 	return of_device_is_compatible(dcp->dev->of_node, "apple,t8132-dcpext");
@@ -533,7 +559,9 @@ static int dcp_typec_route_activate(struct apple_dcp_typec_route *route,
 	dcp_tb_events_retire(dcp);
 
 	/* Never select a DP PHY output that has no DP PHY behind it. */
-	if (xbar == route->xbar && dcp_typec_route_no_dp_alt(route))
+	if (xbar == route->xbar &&
+	    dcp_typec_route_dp_alt(route, route->port->applied_mode) !=
+	    DCP_FABRIC_T8132_DP_ALT_ROUTE)
 		return -EOPNOTSUPP;
 
 	dcp_firmware_metadata_connection(dcp, READ_ONCE(dcp->typec_generation), false);
@@ -1403,18 +1431,30 @@ static void dcp_typec_plan(struct drm_device *drm,
 	}
 }
 
+/*
+ * Tell a direct DP-alt route's pipeline its sink is there. A T8132 dcpext has
+ * no connector of this driver and connects from its reconnect work, which
+ * waits for the firmware, as for its tunnels (see dcp_tb_external()).
+ */
+static void dcp_typec_connect_sink(struct apple_dcp *dcp)
+{
+	WRITE_ONCE(dcp->typec_cable_connected, true);
+	if (dcp->typec_connector) {
+		dcp_dptx_connect_oob(to_platform_device(dcp->dev), 0);
+	} else if (dcp_is_t8132_ext(dcp)) {
+		dcp->typec_reconnect_tries = 0;
+		dcp_queue_typec_reconnect(dcp, 0);
+	}
+}
+
 /* Replay HPD to the pipeline a direct DP-alt port has just been given. */
 static void dcp_typec_port_attach(struct apple_dcp_typec_port *port)
 {
-	struct apple_dcp *dcp = port->owner->dcp;
-
 	port->hpd = port->dp_hpd;
 	if (!port->hpd)
 		return;
 
-	WRITE_ONCE(dcp->typec_cable_connected, true);
-	if (dcp->typec_connector)
-		dcp_dptx_connect_oob(to_platform_device(dcp->dev), 0);
+	dcp_typec_connect_sink(port->owner->dcp);
 }
 
 /*
@@ -1969,14 +2009,23 @@ static int dcp_typec_route_set(struct typec_mux_dev *mux,
 	}
 
 	/*
-	 * No DP alt mode on T8132. The state is taken as applied and
-	 * nothing is routed, as before these routes existed, so the port
-	 * controller's mode change goes on. USB, USB4/TBT and safe states are
-	 * handled above as on every other SoC.
+	 * A T8132 port runs DP Alt Mode on four calibrated lanes only. Any
+	 * other DP state is taken as applied and nothing is routed, so the
+	 * port controller's mode change goes on and the PHY serves the USB
+	 * beside the lanes. USB, USB4/TBT and safe states are handled above as
+	 * on every other SoC.
 	 */
-	if (dcp_typec_route_no_dp_alt(route)) {
+	switch (dcp_typec_route_dp_alt(route, state->mode)) {
+	case DCP_FABRIC_T8132_DP_ALT_ROUTE:
+		break;
+	case DCP_FABRIC_T8132_DP_ALT_TWO_LANES:
+		dev_info_once(route->dcp->dev,
+			      "DP alt mode display not routed: pin assignment D (two lanes beside USB3) is not run on T8132\n");
+		port->applied_valid = true;
+		return 0;
+	case DCP_FABRIC_T8132_DP_ALT_NO_PHY:
 		dev_info_once(route->dcp->dev,
-			      "DP alt mode display not routed: no DP alt mode PHY on this SoC\n");
+			      "DP alt mode display not routed: the port's PHY has no DisplayPort calibration\n");
 		port->applied_valid = true;
 		return 0;
 	}
@@ -2042,11 +2091,7 @@ static int dcp_typec_route_set(struct typec_mux_dev *mux,
 	}
 
 	if (hpd && !port->hpd) {
-		struct apple_dcp *dcp = port->owner->dcp;
-
-		WRITE_ONCE(dcp->typec_cable_connected, true);
-		if (dcp->typec_connector)
-			dcp_dptx_connect_oob(to_platform_device(dcp->dev), 0);
+		dcp_typec_connect_sink(port->owner->dcp);
 	} else if (hpd && dp_data && (dp_data->status & DP_STATUS_IRQ_HPD)) {
 		struct apple_dcp *dcp = port->owner->dcp;
 
@@ -4230,7 +4275,7 @@ bool dcp_typec_port_unusable(unsigned int idx)
 		return false;
 
 	list_for_each_entry(route, &port->routes, port_link)
-		if (!READ_ONCE(route->dcp->ext_dead) && !dcp_typec_route_no_dp_alt(route))
+		if (!READ_ONCE(route->dcp->ext_dead) && !dcp_typec_route_t8132(route))
 			return false;
 
 	return true;
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 5b8460bc85..329b295195 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -6675,7 +6675,7 @@ static void dcp_t8132_ext_routes(struct apple_dcp *dcp)
 		dcp_typec_routes_disable(dcp);
 		return;
 	}
-	dev_info(dcp->dev, "%u Type-C display route(s) registered, no DP alt mode\n",
+	dev_info(dcp->dev, "%u Type-C display route(s) registered: DP tunnels, and DP alt mode where the port's PHY runs four lanes\n",
 		 dcp->nr_typec_routes);
 }
 
