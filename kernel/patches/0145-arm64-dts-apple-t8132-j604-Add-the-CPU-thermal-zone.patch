From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 07:31:32 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j604: Add the CPU thermal zone

Describe the SMC temperature and fan sensors of the 14-inch MacBook Pro
(M4, 2024) and a CPU thermal zone on the SMC's hottest CPU die reading,
TCMz, that throttles both clusters through their cpufreq cooling
devices. With ARM_APPLE_SOC_CPUFREQ_THERMAL_ZONES this zone becomes the
board thermal policy, so the T8132 cpufreq driver gives both clusters
their states above P-state 4 while it works.

The trips are the ones this machine was qualified with on an earlier
kernel under 8 minutes of sustained all-core load:

 - 95 C, hysteresis 15 C: P cluster, full range;
 - 99 C, hysteresis 14 C: E cluster, full range, so the E cores slow
   down only when throttling the P cores cannot hold the die;
 - 101 C, hysteresis 6 C: P cluster to cooling state 8 or deeper and
   E cluster to state 3 or deeper at once;
 - 105 C, hot: cpufreq takes the higher states back;
 - 110 C, critical.

TCMz moves by about 3 C between samples; with 2 C of hysteresis one
low sample let step_wise drop all throttling in one step and the die
overshot, so the hysteresis is large. Passive polling is 100 ms to
keep the overshoot at the start of a load small. The fan stays under
the SMC's control.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 156 +++++++++++++++++++++++
 1 file changed, 156 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index f7ad4f2527..008c746010 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -16,6 +16,7 @@
 #include "t8132.dtsi"
 #include "t8132-jxxx.dtsi"
 #include <dt-bindings/leds/common.h>
+#include <dt-bindings/thermal/thermal.h>
 
 / {
 	compatible = "apple,j604", "apple,t8132", "apple,arm-platform"; /* DTV-ROOT-1 */
@@ -105,8 +106,26 @@
 		nvmem-cells = <&rtc_offset>;
 		nvmem-cell-names = "rtc_offset";
 	};
+
+	smc_hwmon: hwmon {
+		compatible = "apple,smc-hwmon";
+		#thermal-sensor-cells = <1>;
+
+		/*
+		 * Channel 0 is the sensor of the cpu-thermal zone below, which
+		 * refers to it by index: keep it the first temperature node.
+		 * On this machine TCMz read the same as the hottest P-core die
+		 * sensor under macOS.
+		 */
+		temperature-TCMz {
+			apple,key-id = "TCMz"; /* DTV-THERM-1 */
+			label = "CPU Die Hottest";
+		};
+	};
 };
 
+#include "hwmon-fan.dtsi" /* DTV-THERM-2 */
+
 &nub_spmi {
 	status = "okay"; /* DTV-SPMI-1, DTV-SPMI-2 */
 
@@ -427,6 +446,143 @@
 	status = "okay";
 };
 
+/*
+ * CPU thermal policy: one zone on the SMC's hottest CPU die reading (TCMz)
+ * throttles both clusters through cpufreq. While it works, the T8132 cpufreq
+ * driver gives the clusters their states above P-state 4; it takes them back
+ * at the hot trip, on sensor loss, or without the cooling bindings
+ * (ARM_APPLE_SOC_CPUFREQ_THERMAL_ZONES). The fan stays with the SMC.
+ *
+ * The trips are the ones this machine was qualified with on an earlier
+ * kernel, 8 minutes of sustained all-core load. TCMz moves by about 3 C
+ * between samples, so a small hysteresis lets step_wise drop all throttling
+ * in one step: 15 C and 14 C keep the instances throttling until the die has
+ * really cooled. The E cluster slows down only if throttling the P cluster
+ * cannot hold the die (DTV-THERM-3, DTV-THERM-4). trip-clamp limits both
+ * clusters at once (P to cooling state 8 or deeper, E to state 3 or deeper)
+ * instead of one step per poll. The 100 ms passive polling keeps the
+ * overshoot at the start of a load small.
+ */
+&cpu_e0 {
+	#cooling-cells = <2>;
+};
+
+&cpu_e1 {
+	#cooling-cells = <2>;
+};
+
+&cpu_e2 {
+	#cooling-cells = <2>;
+};
+
+&cpu_e3 {
+	#cooling-cells = <2>;
+};
+
+&cpu_e4 {
+	#cooling-cells = <2>;
+};
+
+&cpu_e5 {
+	#cooling-cells = <2>;
+};
+
+&cpu_p0 {
+	#cooling-cells = <2>;
+};
+
+&cpu_p1 {
+	#cooling-cells = <2>;
+};
+
+&cpu_p2 {
+	#cooling-cells = <2>;
+};
+
+&cpu_p3 {
+	#cooling-cells = <2>;
+};
+
+/ {
+	thermal-zones {
+		cpu-thermal {
+			polling-delay-passive = <100>;
+			polling-delay = <1000>;
+			thermal-sensors = <&smc_hwmon 0>;	/* TCMz */
+
+			trips {
+				cpu_p_alert: trip-alert {
+					temperature = <95000>;
+					hysteresis = <15000>;
+					type = "passive";
+				};
+
+				cpu_e_alert: trip-e-alert {
+					temperature = <99000>;
+					hysteresis = <14000>;
+					type = "passive";
+				};
+
+				cpu_clamp: trip-clamp {
+					temperature = <101000>;
+					hysteresis = <6000>;
+					type = "passive";
+				};
+
+				/* cpufreq takes the higher states back here. */
+				trip-hot {
+					temperature = <105000>;
+					hysteresis = <0>;
+					type = "hot";
+				};
+
+				trip-critical {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map-p {
+					trip = <&cpu_p_alert>;
+					cooling-device =
+						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+
+				map-e {
+					trip = <&cpu_e_alert>;
+					cooling-device =
+						<&cpu_e0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_e1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_e2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_e3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_e4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu_e5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+
+				map-clamp {
+					trip = <&cpu_clamp>;
+					cooling-device =
+						<&cpu_p0 8 THERMAL_NO_LIMIT>,
+						<&cpu_p1 8 THERMAL_NO_LIMIT>,
+						<&cpu_p2 8 THERMAL_NO_LIMIT>,
+						<&cpu_p3 8 THERMAL_NO_LIMIT>,
+						<&cpu_e0 3 THERMAL_NO_LIMIT>,
+						<&cpu_e1 3 THERMAL_NO_LIMIT>,
+						<&cpu_e2 3 THERMAL_NO_LIMIT>,
+						<&cpu_e3 3 THERMAL_NO_LIMIT>,
+						<&cpu_e4 3 THERMAL_NO_LIMIT>,
+						<&cpu_e5 3 THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+	};
+};
+
 #include "t8132-j604-gpu.dtsi"
 
 /*
