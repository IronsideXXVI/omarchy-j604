From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 07:44:37 +0000
Subject: [PATCH] power: reset: macsmc-reboot: print what ended the
 previous boot

After a reset the driver reports "PMU logged 1 boot error(s) and 0
panic(s)" and clears the counts, but that only says the previous boot
did not shut down cleanly. iBoot also keeps the boot stage a failed boot
had reached, next to the counts, and the PMU keeps a fault shadow.

Read both once at probe, before this boot changes anything, when the
device tree names them ("boot_error_stage", "fault_shadow"), and print
them. Read-only; boards without the cells are unchanged. Describe the
two cells for the J604.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 12 ++++++
 drivers/power/reset/macsmc-reboot.c           | 37 +++++++++++++++++++
 2 files changed, 49 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index 39f472f477..7cc624ea96 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -183,6 +183,10 @@
 					reg = <0xf802 0x01>;
 					bits = <0x00 0x04>;
 				};
+				/* iBoot's record: the boot stage a failed boot had reached. */
+				boot_error_stage: boot-error-stage@f803 {
+					reg = <0xf803 0x01>;
+				};
 				panic_count: panic-count@f802,4 {
 					reg = <0xf802 0x01>;
 					bits = <0x04 0x04>;
@@ -964,6 +968,14 @@
 	};
 };
 
+/* What ended the previous boot, printed once by macsmc-reboot (read-only). */
+&{/soc/smc@38c600000/reboot} {
+	nvmem-cells = <&shutdown_flag>, <&boot_stage>, <&boot_error_count>, <&panic_count>,
+		      <&pm_setting>, <&boot_error_stage>, <&fault_shadow>;
+	nvmem-cell-names = "shutdown_flag", "boot_stage", "boot_error_count", "panic_count",
+			   "pm_setting", "boot_error_stage", "fault_shadow";
+};
+
 &{/soc/smc@38c600000/rtc} {
 	interrupts-extended = <&nub_spmi 0x02 0x01>;
 	wakeup-source;
diff --git a/drivers/power/reset/macsmc-reboot.c b/drivers/power/reset/macsmc-reboot.c
index a2e1422e05..9e913b1e69 100644
--- a/drivers/power/reset/macsmc-reboot.c
+++ b/drivers/power/reset/macsmc-reboot.c
@@ -198,6 +198,41 @@ static int macsmc_reboot_notify(struct notifier_block *this, unsigned long actio
 	return NOTIFY_OK;
 }
 
+/*
+ * Optional cells some boards describe: the boot stage a failed boot had reached
+ * (PMU scratchpad + 3, next to the counts) and the PMU's fault shadow. Printed
+ * once, read-only, before anything of this boot can change them: they tell what
+ * ended the previous boot.
+ */
+static void macsmc_reboot_print_last_end(struct macsmc_reboot *reboot)
+{
+	struct nvmem_cell *stage_cell, *fault_cell;
+	u8 *stage = NULL, *fault = NULL;
+	size_t stage_len = 0, fault_len = 0;
+
+	stage_cell = nvmem_cell_get(reboot->dev, "boot_error_stage");
+	fault_cell = nvmem_cell_get(reboot->dev, "fault_shadow");
+	if (!IS_ERR(stage_cell))
+		stage = nvmem_cell_read(stage_cell, &stage_len);
+	if (!IS_ERR(fault_cell))
+		fault = nvmem_cell_read(fault_cell, &fault_len);
+
+	if (!IS_ERR_OR_NULL(stage) && stage_len >= 1)
+		dev_info(reboot->dev, "previous boot: failed-boot stage %#x\n", stage[0]);
+	if (!IS_ERR_OR_NULL(fault) && fault_len)
+		dev_info(reboot->dev, "previous boot: PMU fault shadow %*ph\n",
+			 (int)min_t(size_t, fault_len, 32), fault);
+
+	if (!IS_ERR_OR_NULL(stage))
+		kfree(stage);
+	if (!IS_ERR_OR_NULL(fault))
+		kfree(fault);
+	if (!IS_ERR(stage_cell))
+		nvmem_cell_put(stage_cell);
+	if (!IS_ERR(fault_cell))
+		nvmem_cell_put(fault_cell);
+}
+
 static void macsmc_power_init_error_counts(struct macsmc_reboot *reboot)
 {
 	int boot_error_count, panic_count;
@@ -353,6 +388,8 @@ static int macsmc_reboot_probe(struct platform_device *pdev)
 			dev_warn(&pdev->dev, "Missing NVMEM cell pm_setting (%d)\n", ret);
 		reboot->pm_setting = NULL;
 	}
+	/* Before this boot changes anything: what ended the previous one. */
+	macsmc_reboot_print_last_end(reboot);
 
 	/* Set the boot_stage to indicate we're running the OS kernel */
 	if (reboot->nvm.boot_stage &&
