From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 08:21:41 +0000
Subject: [PATCH] accel/ane: report a quarantined H16 engine through
 "wedged"

The ane_t6021 driver's wedged, ane_stats and reset files read its H14
state through drvdata, so they are hidden on the later generations,
whose backends keep their own drvdata. An H16 engine that its backend
quarantined (mappings, power and the module held until reboot) is then
invisible to tools that read wedged, such as omarchy-m-test's Neural
Engine check, which passes it as healthy.

Show wedged again for a device the H16 backend owns and answer it from
the backend: 1 once the engine or its session is quarantined, else 0.
ane_stats and reset stay hidden there, and an H17 staged bind, which
sets no drvdata, still shows none of the three.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/accel/ane/ane_fw_platform.h         |  1 +
 drivers/accel/ane/ane_h16_backend.c         | 14 ++++++++++++++
 drivers/accel/ane/ane_t6021_rtclient_main.c | 11 ++++++++++-
 3 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/drivers/accel/ane/ane_fw_platform.h b/drivers/accel/ane/ane_fw_platform.h
index e735fa82df..1b9b8aa403 100644
--- a/drivers/accel/ane/ane_fw_platform.h
+++ b/drivers/accel/ane/ane_fw_platform.h
@@ -155,6 +155,7 @@ int ane_fw_preload_range(struct device_node *np, unsigned int index, u64 *phys,
 int ane_h16_backend_probe(struct platform_device *pdev, const struct ane_fw_platform *soc);
 void ane_h16_backend_remove(struct platform_device *pdev);
 int ane_h16_backend_suspend(struct device *dev);
+int ane_h16_backend_wedged(struct device *dev);
 int ane_h16_backend_resume(struct device *dev);
 
 #endif /* __ANE_FW_PLATFORM_H__ */
diff --git a/drivers/accel/ane/ane_h16_backend.c b/drivers/accel/ane/ane_h16_backend.c
index feffb913ae..cef4cbf67f 100644
--- a/drivers/accel/ane/ane_h16_backend.c
+++ b/drivers/accel/ane/ane_h16_backend.c
@@ -836,6 +836,20 @@ static int ane_h16_pin(void *ctx)
  * freezable) or a path that skipped the notifiers. A device whose engine
  * was never started has nothing to save.
  */
+/*
+ * The "wedged" sysfs file of a bound H16 device: 1 once the engine or its
+ * session is quarantined (mappings, power and module held until reboot),
+ * else 0. -ENODEV for a device this backend does not own (H17 staged bind).
+ */
+int ane_h16_backend_wedged(struct device *dev)
+{
+	struct ane_h16_device *h = dev_get_drvdata(dev);
+
+	if (!h)
+		return -ENODEV;
+	return READ_ONCE(h->boot.quarantined) || READ_ONCE(h->session.quarantined);
+}
+
 int ane_h16_backend_suspend(struct device *dev)
 {
 	struct ane_h16_device *h = dev_get_drvdata(dev);
diff --git a/drivers/accel/ane/ane_t6021_rtclient_main.c b/drivers/accel/ane/ane_t6021_rtclient_main.c
index de63ffa229..d7e1004870 100644
--- a/drivers/accel/ane/ane_t6021_rtclient_main.c
+++ b/drivers/accel/ane/ane_t6021_rtclient_main.c
@@ -4145,8 +4145,12 @@ static DEVICE_ATTR_RO(ane_stats);
 static ssize_t wedged_show(struct device *dev, struct device_attribute *attr,
 			   char *buf)
 {
+	const struct ane_t602x_soc *soc = of_device_get_match_data(dev);
 	struct ane_rtclient *ane = dev_get_drvdata(dev);
 
+	/* H16: the backend owns drvdata and its own quarantine state. */
+	if (soc->platform)
+		return sysfs_emit(buf, "%d\n", ane_h16_backend_wedged(dev) > 0);
 	return sysfs_emit(buf, "%d\n", atomic_read(&ane_t6021_quarantined) ||
 			  READ_ONCE(ane->recovering) || !READ_ONCE(ane->registered) ||
 			  READ_ONCE(ane->sleep_pm.state) == ANE_T6021_PM_FAILED);
@@ -4181,8 +4185,13 @@ static umode_t ane_t6021_stats_is_visible(struct kobject *kobj,
 	const struct ane_t602x_soc *soc = of_device_get_match_data(dev);
 	struct ane_rtclient *ane = dev_get_drvdata(dev);
 
+	/*
+	 * Later generations keep their own drvdata: only wedged, and only
+	 * where the H16 backend owns the device (not an H17 staged bind).
+	 */
 	if (soc->platform)
-		return 0;
+		return attr == &dev_attr_wedged.attr && ane_h16_backend_wedged(dev) >= 0 ?
+		       attr->mode : 0;
 	if (attr == &dev_attr_ane_stats.attr && !ane->stats_slots)
 		return 0;
 	return attr->mode;
-- 
