From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 19 Nov 2026 05:25:01 +0000
Subject: [PATCH] drm/asahi: g16: Drop the unused queue scratch clones
 from RenderGraph

RenderGraph kept qscratch, a second reference to each queue's qinfo
object, under allow(dead_code); nothing reads it. The graph is built by
value on the boot path, where start_backend holds it more than once, so
every field there counts against the boot chain. Drop the field; the
objects themselves stay referenced through qinfo, and nothing the
firmware sees changes.

This makes room on the boot chain for the notifier records field that
the next commit adds.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/graph.rs | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/graph.rs b/drivers/gpu/drm/asahi/g16/graph.rs
index 6da1973a88..f97aeff0aa 100644
--- a/drivers/gpu/drm/asahi/g16/graph.rs
+++ b/drivers/gpu/drm/asahi/g16/graph.rs
@@ -236,8 +236,6 @@ pub(crate) struct RenderGraph {
     pub(crate) qstate: [Arc<FwObject>; 2],
     pub(crate) ring: [Arc<FwObject>; 2],
     #[allow(dead_code)]
-    pub(crate) qscratch: [Arc<FwObject>; 2],
-    #[allow(dead_code)]
     pub(crate) user_stamp: [Arc<FwObject>; 2],
     pub(crate) fw_stamp: [Arc<FwObject>; 2],
     pub(crate) sched_ctx: Arc<FwObject>,
@@ -252,7 +250,6 @@ impl RenderGraph {
     fn new(o: &mut Objects, context: Arc<FwObject>) -> Result<Self> {
         let [ta, fs] = [QueueObjects::new(o)?, QueueObjects::new(o)?];
         Ok(Self {
-            qscratch: [ta.qinfo.clone(), fs.qinfo.clone()],
             qinfo: [ta.qinfo, fs.qinfo],
             qstate: [ta.qstate, fs.qstate],
             ring: [ta.ring, fs.ring],
