From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 15:53:18 +0000
Subject: [PATCH] soc: apple: pmp: arm the retained-vote sleep for one sleep at
 a time

apple_pmp_j713_display_sleep_enable() let a consumer say once, after
prepare, that it releases DISP for a sleep that stops the PMP, and the
promise held until reboot. The PMP then relied only on DISP not being
held when its suspend_late ran.

Make it an arming for one sleep instead. The consumer arms in its
suspend, after it has powered the display down and put its vote; the
arming is refused (-EBUSY, or the owner's error) while DISP is still
held. The PMP's wake clears it, and the new
apple_pmp_j713_display_sleep_disable() clears it from the consumer's
resume, which also covers a sleep aborted before the PMP stopped. So the
PMP refusal is lifted only for a sleep in which the display side has
really released its vote, and it is back as soon as that sleep is over.
Every other refusal (AGX held, request in flight, failed stream) stays.

KUnit: the existing order test now arms after the put and arms again for
its second sleep; new cases for arming while DISP is held or the owner
failed, one arming per sleep, disarm from resume, and an armed sleep
still refused while AGX is held.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/pmp-display-sleep-test.c | 79 +++++++++++++++++++++-
 drivers/soc/apple/pmp-display-sleep.h      | 40 +++++++++--
 drivers/soc/apple/pmp-display.c            | 40 +++++++++--
 include/linux/soc/apple/pmp-display.h      | 11 +--
 4 files changed, 151 insertions(+), 19 deletions(-)

diff --git a/drivers/soc/apple/pmp-display-sleep-test.c b/drivers/soc/apple/pmp-display-sleep-test.c
index 32f84e5253..81f34c7ff3 100644
--- a/drivers/soc/apple/pmp-display-sleep-test.c
+++ b/drivers/soc/apple/pmp-display-sleep-test.c
@@ -69,10 +69,10 @@ static void pmp_sleep_teardown_restore_order(struct kunit *test)
 	struct model m;
 
 	model_boot(&m);
-	m.s.consumer = true;			/* apple_pmp_j713_display_sleep_enable() */
-	/* DCP .suspend: power gate, put. */
+	/* DCP .suspend: power gate (put), then arm this sleep (display_sleep_enable). */
 	KUNIT_EXPECT_EQ(test, model_put_disp(&m), 0);
 	KUNIT_EXPECT_EQ(test, m.sends, 2U);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
 	/* PMP suspend_late. */
 	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
 	KUNIT_EXPECT_TRUE(test, m.s.asleep);
@@ -85,8 +85,10 @@ static void pmp_sleep_teardown_restore_order(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
 	KUNIT_EXPECT_TRUE(test, m.v.disp_held);
 	KUNIT_EXPECT_EQ(test, m.sends, 3U);
-	/* A second sleep goes the same way. */
+	/* The wake ended the arming: a second sleep arms again, the same way. */
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
 	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
 	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
 	pmp_display_sleep_leave(&m.s);
 	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
@@ -158,6 +160,73 @@ static void pmp_sleep_enter_leave_idempotent(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, m.s.asleep);
 }
 
+/* Arming while DISP is still held (the consumer did not power down) is refused. */
+static void pmp_sleep_arm_refused_disp_held(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_DISP_HELD);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	/* A failed owner refuses before anything else. */
+	model_put_disp(&m);
+	m.v.provider_error = -EIO;
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_FAILED);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+}
+
+/* One arming, one sleep: after wake an unarmed sleep is refused again. */
+static void pmp_sleep_arm_one_sleep(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	pmp_display_sleep_leave(&m.s);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+	/* Display used, blanked and powered down again, but not armed: refused. */
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+}
+
+/* A sleep aborted after the consumer armed it, before the PMP stopped: its resume disarms. */
+static void pmp_sleep_disarm_on_resume(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	pmp_display_sleep_disarm(&m.s);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	KUNIT_EXPECT_TRUE(test, pmp_display_sleep_admits(&m.s));
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	/* Disarm with nothing armed changes nothing. */
+	pmp_display_sleep_disarm(&m.s);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+}
+
+/* Armed by the display, but the GPU holds AGX: still refused; the display's resume disarms. */
+static void pmp_sleep_armed_agx_still_refused(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	m.v.agx_held = true;
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_AGX_HELD);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+	pmp_display_sleep_disarm(&m.s);
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+}
+
 static void pmp_sleep_reasons(struct kunit *test)
 {
 	enum pmp_display_sleep_verdict v;
@@ -175,6 +244,10 @@ static struct kunit_case pmp_display_sleep_cases[] = {
 	KUNIT_CASE(pmp_sleep_refused_agx_held),
 	KUNIT_CASE(pmp_sleep_refused_pending_or_failed),
 	KUNIT_CASE(pmp_sleep_enter_leave_idempotent),
+	KUNIT_CASE(pmp_sleep_arm_refused_disp_held),
+	KUNIT_CASE(pmp_sleep_arm_one_sleep),
+	KUNIT_CASE(pmp_sleep_disarm_on_resume),
+	KUNIT_CASE(pmp_sleep_armed_agx_still_refused),
 	KUNIT_CASE(pmp_sleep_reasons),
 	{}
 };
diff --git a/drivers/soc/apple/pmp-display-sleep.h b/drivers/soc/apple/pmp-display-sleep.h
index c69103b05b..a59ae97a5e 100644
--- a/drivers/soc/apple/pmp-display-sleep.h
+++ b/drivers/soc/apple/pmp-display-sleep.h
@@ -8,10 +8,12 @@
  * consumer, the DCP, which powers the display domains down first and calls
  * apple_pmp_j713_display_put() (iomfb_m4_power_gate()); it takes the vote
  * again with apple_pmp_j713_display_get() after power-up. AGX has no release
- * at all. So a sleep that stops the PMP may only go ahead when a consumer has
- * said it releases DISP for such a sleep, DISP and AGX are not held, nothing
- * is in flight and the request stream works; from then until wake no vote
- * may be taken, since a stopped PMP cannot accept one.
+ * at all. So a sleep that stops the PMP may only go ahead when the consumer
+ * has released DISP for this sleep and armed it (pmp_display_sleep_arm()),
+ * AGX is not held, nothing is in flight and the request stream works; from
+ * then until wake no vote may be taken, since a stopped PMP cannot accept
+ * one. The arming lasts one sleep: wake clears it, and so does the
+ * consumer's resume (pmp_display_sleep_disarm()).
  */
 #ifndef _APPLE_PMP_DISPLAY_SLEEP_H
 #define _APPLE_PMP_DISPLAY_SLEEP_H
@@ -20,7 +22,7 @@
 
 enum pmp_display_sleep_verdict {
 	PMP_DISPLAY_SLEEP_OK,
-	/* No consumer releases DISP for such a sleep (apple_pmp_j713_display_sleep_enable()). */
+	/* DISP not released and this sleep not armed (apple_pmp_j713_display_sleep_enable()). */
 	PMP_DISPLAY_SLEEP_NO_CONSUMER,
 	/* The PMP owner failed, or an ambiguous reply closed the request stream. */
 	PMP_DISPLAY_SLEEP_FAILED,
@@ -33,7 +35,7 @@ enum pmp_display_sleep_verdict {
 };
 
 struct pmp_display_sleep {
-	/* A consumer releases DISP before such a sleep and takes it again after. */
+	/* Armed for this sleep: the consumer released DISP. Cleared at wake. */
 	bool consumer;
 	/* Between apple_pmp_display_sleep() and apple_pmp_display_wake(). */
 	bool asleep;
@@ -82,9 +84,33 @@ pmp_display_sleep_enter(struct pmp_display_sleep *s, const struct pmp_display_sl
 	return verdict;
 }
 
+/* Wake: votes may be taken again, and the next sleep needs a new arming. */
 static inline void pmp_display_sleep_leave(struct pmp_display_sleep *s)
 {
 	s->asleep = false;
+	s->consumer = false;
+}
+
+/*
+ * The consumer, in its suspend, once it has powered the display down and put
+ * DISP: arm this sleep. Refused while DISP is still held or the owner failed;
+ * nothing changes then.
+ */
+static inline enum pmp_display_sleep_verdict
+pmp_display_sleep_arm(struct pmp_display_sleep *s, const struct pmp_display_sleep_votes *v)
+{
+	if (v->provider_error)
+		return PMP_DISPLAY_SLEEP_FAILED;
+	if (v->disp_held)
+		return PMP_DISPLAY_SLEEP_DISP_HELD;
+	s->consumer = true;
+	return PMP_DISPLAY_SLEEP_OK;
+}
+
+/* The consumer's resume: also ends a sleep that was aborted before the PMP stopped. */
+static inline void pmp_display_sleep_disarm(struct pmp_display_sleep *s)
+{
+	s->consumer = false;
 }
 
 /* Whether a vote may be taken now: not while the PMP is stopped for a sleep. */
@@ -99,7 +125,7 @@ static inline const char *pmp_display_sleep_reason(enum pmp_display_sleep_verdic
 	case PMP_DISPLAY_SLEEP_OK:
 		return "votes released";
 	case PMP_DISPLAY_SLEEP_NO_CONSUMER:
-		return "retained power votes have no teardown (no consumer releases DISP)";
+		return "retained power votes have no teardown (DISP not released for this sleep)";
 	case PMP_DISPLAY_SLEEP_FAILED:
 		return "the vote stream failed";
 	case PMP_DISPLAY_SLEEP_PENDING:
diff --git a/drivers/soc/apple/pmp-display.c b/drivers/soc/apple/pmp-display.c
index 29db2d27a8..b9a322fca8 100644
--- a/drivers/soc/apple/pmp-display.c
+++ b/drivers/soc/apple/pmp-display.c
@@ -581,12 +581,15 @@ EXPORT_SYMBOL_GPL(apple_pmp_j713_gpu_get);
  * that suspend before the PMP's and that resume after it. AGX has no
  * release: a held AGX vote keeps refusing such a sleep.
  *
- * The consumer says it does so with apple_pmp_j713_display_sleep_enable(),
- * after prepare; it holds until reboot, as the links do. Without it,
- * apple_pmp_display_sleep() refuses, as the PMP did before.
+ * The consumer arms each such sleep after its put
+ * (apple_pmp_j713_display_sleep_enable()); the arming ends at the PMP's wake
+ * and with apple_pmp_j713_display_sleep_disable() in the consumer's resume.
+ * Unarmed, apple_pmp_display_sleep() refuses, as the PMP did before.
  */
 int apple_pmp_j713_display_sleep_enable(struct device *consumer)
 {
+	enum pmp_display_sleep_verdict verdict = PMP_DISPLAY_SLEEP_OK;
+	struct pmp_display_sleep_votes v = {};
 	struct apple_pmp_display *p;
 	unsigned long flags;
 	int ret;
@@ -596,21 +599,48 @@ int apple_pmp_j713_display_sleep_enable(struct device *consumer)
 	p = pmp_power_consumer(consumer, PMP_POWER_DISP);
 	if (IS_ERR(p))
 		return PTR_ERR(p);
+	/* Every get and put sends under the request lock: none is half done while it is held. */
 	mutex_lock(&p->request);
 	ret = p->link[PMP_POWER_DISP] ? 0 : -ENODEV;
 	if (!ret) {
 		spin_lock_irqsave(&p->lock, flags);
-		p->sleep.consumer = true;
+		v.provider_error = p->vote.provider_error;
+		v.disp_held = p->vote.held[PMP_POWER_DISP];
+		verdict = pmp_display_sleep_arm(&p->sleep, &v);
 		spin_unlock_irqrestore(&p->lock, flags);
+		if (verdict == PMP_DISPLAY_SLEEP_FAILED)
+			ret = v.provider_error;
+		else if (verdict != PMP_DISPLAY_SLEEP_OK)
+			ret = -EBUSY;
 	}
 	mutex_unlock(&p->request);
 	if (!ret)
-		dev_info(p->dev, "%s releases the retained DISP vote for a system sleep\n",
+		dev_info(p->dev, "%s released the retained DISP vote for this sleep\n",
 			 dev_name(consumer));
+	else if (verdict != PMP_DISPLAY_SLEEP_OK)
+		dev_err(p->dev, "%s: %s: sleep not armed\n", dev_name(consumer),
+			pmp_display_sleep_reason(verdict));
 	return ret;
 }
 EXPORT_SYMBOL_GPL(apple_pmp_j713_display_sleep_enable);
 
+/* The consumer's resume: the sleep it armed is over, whether or not the PMP stopped. */
+void apple_pmp_j713_display_sleep_disable(struct device *consumer)
+{
+	struct apple_pmp_display *p;
+	unsigned long flags;
+
+	if (!apple_pmp_display_board())
+		return;
+	p = pmp_power_consumer(consumer, PMP_POWER_DISP);
+	if (IS_ERR(p))
+		return;
+	spin_lock_irqsave(&p->lock, flags);
+	pmp_display_sleep_disarm(&p->sleep);
+	spin_unlock_irqrestore(&p->lock, flags);
+}
+EXPORT_SYMBOL_GPL(apple_pmp_j713_display_sleep_disable);
+
 /*
  * From the PMP's suspend_late, before it stops. 0: no vote is held or in
  * flight, and none is taken until apple_pmp_display_wake(). Otherwise
diff --git a/include/linux/soc/apple/pmp-display.h b/include/linux/soc/apple/pmp-display.h
index 888fe75a6d..66efd37dd2 100644
--- a/include/linux/soc/apple/pmp-display.h
+++ b/include/linux/soc/apple/pmp-display.h
@@ -61,12 +61,15 @@ int apple_pmp_j713_gpu_check(struct device *consumer);
 
 /*
  * A system sleep that stops the PMP (pmp-export.c) needs every retained vote
- * released first. The DISP consumer says, once after prepare, that it powers
- * the display down and puts its vote in its suspend, and gets it again in its
- * resume (display_sleep_enable); without that, such a sleep is refused.
- * The AGX vote has no release, so a held AGX vote refuses it too.
+ * released first. The DISP consumer powers the display down and puts its
+ * vote in its suspend, then arms this one sleep (display_sleep_enable;
+ * -EBUSY while DISP is held); it gets the vote again in its resume and ends
+ * the arming there (display_sleep_disable), as the PMP's wake also does.
+ * Unarmed, such a sleep is refused. The AGX vote has no release, so a held
+ * AGX vote refuses it too.
  */
 int apple_pmp_j713_display_sleep_enable(struct device *consumer);
+void apple_pmp_j713_display_sleep_disable(struct device *consumer);
 /* Internal: the PMP owner, around its own stop and restart. */
 int apple_pmp_display_sleep(void);
 void apple_pmp_display_wake(void);
