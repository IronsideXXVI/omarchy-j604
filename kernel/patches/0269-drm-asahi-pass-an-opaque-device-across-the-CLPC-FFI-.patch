From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Tue, 27 Oct 2026 17:37:42 +1100
Subject: [PATCH] drm/asahi: pass an opaque device across the CLPC FFI boundary

Keep the C wrapper responsible for the device layout, as the existing
sysfs wrappers do. Rust bindings include private configuration-dependent
scheduler members and cannot be named in a WERROR-safe extern signature.
The live platform device and owned request lifetime remain unchanged.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit 61a2fec62a709db5b435a9a41ff51270362d4a80)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g17/clpc.c   | 2 +-
 drivers/gpu/drm/asahi/g17/clpc.h   | 2 +-
 drivers/gpu/drm/asahi/g17/power.rs | 4 ++--
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g17/clpc.c b/drivers/gpu/drm/asahi/g17/clpc.c
index b8ae1242cd..58adaba199 100644
--- a/drivers/gpu/drm/asahi/g17/clpc.c
+++ b/drivers/gpu/drm/asahi/g17/clpc.c
@@ -2,7 +2,7 @@
 #include <linux/soc/apple/clpc.h>
 #include "clpc.h"
 
-int asahi_clpc_gpu_get(struct device *dev, struct apple_clpc_gpu **out)
+int asahi_clpc_gpu_get(void *dev, struct apple_clpc_gpu **out)
 {
 	return apple_clpc_gpu_get(dev, out);
 }
diff --git a/drivers/gpu/drm/asahi/g17/clpc.h b/drivers/gpu/drm/asahi/g17/clpc.h
index 3fc6f75473..372820ade7 100644
--- a/drivers/gpu/drm/asahi/g17/clpc.h
+++ b/drivers/gpu/drm/asahi/g17/clpc.h
@@ -3,7 +3,7 @@
 #define _ASAHI_G17_CLPC_H
 struct device;
 struct apple_clpc_gpu;
-int asahi_clpc_gpu_get(struct device *dev, struct apple_clpc_gpu **out);
+int asahi_clpc_gpu_get(void *dev, struct apple_clpc_gpu **out);
 void asahi_clpc_gpu_set_active(struct apple_clpc_gpu *gpu, bool active);
 void asahi_clpc_gpu_put(struct apple_clpc_gpu *gpu);
 #endif
diff --git a/drivers/gpu/drm/asahi/g17/power.rs b/drivers/gpu/drm/asahi/g17/power.rs
index c0ec972bf6..998467bb24 100644
--- a/drivers/gpu/drm/asahi/g17/power.rs
+++ b/drivers/gpu/drm/asahi/g17/power.rs
@@ -262,7 +262,7 @@ mod tests {
 }
 
 unsafe extern "C" {
-    fn asahi_clpc_gpu_get(dev: *mut kernel::bindings::device, out: *mut *mut core::ffi::c_void) -> core::ffi::c_int;
+    fn asahi_clpc_gpu_get(dev: *mut core::ffi::c_void, out: *mut *mut core::ffi::c_void) -> core::ffi::c_int;
     fn asahi_clpc_gpu_set_active(gpu: *mut core::ffi::c_void, active: bool);
     fn asahi_clpc_gpu_put(gpu: *mut core::ffi::c_void);
 }
@@ -280,7 +280,7 @@ impl Demand {
     pub(super) fn new(dev: *mut kernel::bindings::device) -> kernel::error::Result<Self> {
         let mut out = core::ptr::null_mut();
         // SAFETY: live platform device and writable result; C returns an owned reference.
-        let ret = unsafe { asahi_clpc_gpu_get(dev, &mut out) };
+        let ret = unsafe { asahi_clpc_gpu_get(dev.cast(), &mut out) };
         if ret < 0 {
             Err(kernel::error::Error::from_errno(ret))
         } else {
