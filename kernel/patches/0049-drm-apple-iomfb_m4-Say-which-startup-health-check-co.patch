From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 6 Nov 2026 17:09:00 +0000
Subject: [PATCH] drm/apple: iomfb_m4: Say which startup health check
 cost the most

The startup line and the debugfs status give the number of full health
checks, their total and the longest one, but not which check was the
longest or where it spent its time. That is what a fix needs to know:
whether the cost is in the first check, at the step where the PMP check
joins in, or spread over all of them.

Also keep the cost of the first check, the three costliest checks with
their index (counting from 1), a histogram of check costs (below 0.5, 1,
2 and 4 ms, and 4 ms or more), and how the costliest check split between
the DCP's own DART stream, the PIODMA stream, the PMP check and the
scanout stream. Print them in a second startup line and add them to the
debugfs status. The checks run as before and in the same order; only a
few more clock reads are added around them.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
[j604: k610 drm sync: iomfb_m4.c conflict in __dcp_m4_runtime_health(); upstream checks the PIODMA stream only for the internal DCP (!dcp->external), which the split-out PIODMA check keeps.]
---
 drivers/gpu/drm/apple/iomfb_m4.c | 100 +++++++++++++++++++++++++++----
 1 file changed, 90 insertions(+), 10 deletions(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index b747b67bf5..ea0ce065a0 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -910,7 +910,16 @@ struct dcp_m4_runtime {
 	u32 head, count, callbacks;
 	/* Cost of the full health check (startup paces on it until qualified). */
 	u32 health_checks;
-	u64 health_ns, health_max_ns, health_last_ns;
+	u64 health_ns, health_max_ns, health_last_ns, health_first_ns;
+	/* The costliest checks, costliest first; index counts from 1. */
+	struct {
+		u32 index;
+		u64 ns;
+	} health_top[3];
+	/* Where the costliest check spent its time, by DCP_M4_HEALTH_* part. */
+	u64 health_max_part_ns[4];
+	/* Checks by cost: < 0.5, < 1, < 2, < 4 and >= 4 ms. */
+	u32 health_hist[5];
 	unsigned long deadline;
 	/* Hard cap of a progress-bounded call; 0: deadline is a fixed total. */
 	unsigned long limit;
@@ -1094,39 +1103,87 @@ static int dcp_m4_runtime_next(struct dcp_m4_runtime *r, u64 *word, bool wait)
 	return ret;
 }
 
-static int __dcp_m4_runtime_health(struct dcp_m4_runtime *r)
+enum {
+	DCP_M4_HEALTH_DCP,	/* coprocessor run bit and the DCP's own DART stream */
+	DCP_M4_HEALTH_PIODMA,
+	DCP_M4_HEALTH_PMP,
+	DCP_M4_HEALTH_SCANOUT,
+};
+
+static u64 dcp_m4_health_lap(ktime_t *mark)
+{
+	ktime_t now = ktime_get();
+	u64 ns = ktime_to_ns(ktime_sub(now, *mark));
+
+	*mark = now;
+	return ns;
+}
+
+static int __dcp_m4_runtime_health(struct dcp_m4_runtime *r, u64 *part)
 {
 	struct iomfb_m4 *dcp = r->dcp;
 	int ret = READ_ONCE(dcp->error);
+	ktime_t mark = ktime_get();
 
 	/* Powered down by its owner: only the failure latch. */
 	if (READ_ONCE(dcp->gated))
 		return ret;
 
-	if (!ret && (!(readl(dcp->coproc + 0x44) & BIT(4)) || dcp_m4_dart_check(dcp->dev) ||
-		     (!dcp->external && dcp_m4_dart_check(&dcp->piodma->dev))))
+	if (!ret && (!(readl(dcp->coproc + 0x44) & BIT(4)) || dcp_m4_dart_check(dcp->dev)))
+		ret = -EIO;
+	part[DCP_M4_HEALTH_DCP] = dcp_m4_health_lap(&mark);
+	if (!ret && !dcp->external && dcp_m4_dart_check(&dcp->piodma->dev))
 		ret = -EIO;
+	part[DCP_M4_HEALTH_PIODMA] = dcp_m4_health_lap(&mark);
 	if (!ret && r->power_done)
 		ret = dcp_m4_pmp_check(dcp->dev);
+	part[DCP_M4_HEALTH_PMP] = dcp_m4_health_lap(&mark);
 	if (!ret && dcp->scanout)
 		ret = dcp_m4_dart_check(dcp->scanout);
+	part[DCP_M4_HEALTH_SCANOUT] = dcp_m4_health_lap(&mark);
 	return ret;
 }
 
+static void dcp_m4_health_account(struct dcp_m4_runtime *r, u64 ns, const u64 *part)
+{
+	u64 bound = 500 * NSEC_PER_USEC;
+	unsigned int i;
+
+	if (!r->health_checks++)
+		r->health_first_ns = ns;
+	r->health_ns += ns;
+	r->health_last_ns = ns;
+	if (ns > r->health_max_ns) {
+		r->health_max_ns = ns;
+		memcpy(r->health_max_part_ns, part, sizeof(r->health_max_part_ns));
+	}
+	for (i = 0; i < ARRAY_SIZE(r->health_hist) - 1 && ns >= bound; i++)
+		bound <<= 1;
+	r->health_hist[i]++;
+	for (i = 0; i < ARRAY_SIZE(r->health_top); i++)
+		if (ns > r->health_top[i].ns)
+			break;
+	if (i == ARRAY_SIZE(r->health_top))
+		return;
+	memmove(&r->health_top[i + 1], &r->health_top[i],
+		(ARRAY_SIZE(r->health_top) - i - 1) * sizeof(r->health_top[0]));
+	r->health_top[i].index = r->health_checks;
+	r->health_top[i].ns = ns;
+}
+
 /* Callers hold dcp->lock; the counters are statistics for the log and debugfs. */
 static int dcp_m4_runtime_health(struct dcp_m4_runtime *r)
 {
+	u64 part[ARRAY_SIZE(r->health_max_part_ns)];
 	ktime_t start = ktime_get();
-	int ret = __dcp_m4_runtime_health(r);
-	u64 ns = ktime_to_ns(ktime_sub(ktime_get(), start));
+	int ret = __dcp_m4_runtime_health(r, part);
 
-	r->health_checks++;
-	r->health_ns += ns;
-	r->health_last_ns = ns;
-	r->health_max_ns = max(r->health_max_ns, ns);
+	dcp_m4_health_account(r, ktime_to_ns(ktime_sub(ktime_get(), start)), part);
 	return ret;
 }
 
+#define DCP_M4_US(ns) div_u64(ns, NSEC_PER_USEC)
+
 /*
  * Full DART/PMP/CPU qualification runs through startup and KMS creation. After
  * that, per-message, per-swap and per-frame checks are only the failure latch;
@@ -2503,6 +2560,17 @@ static int dcp_m4_startup(struct iomfb_m4 *dcp)
 	dev_info(dev, "IOMFB startup took %lld ms (%u health checks, %llu us total, max %llu us)\n",
 		 ktime_ms_delta(ktime_get(), start), r->health_checks,
 		 div_u64(r->health_ns, NSEC_PER_USEC), div_u64(r->health_max_ns, NSEC_PER_USEC));
+	dev_info(dev, "IOMFB startup health checks: first %llu us; max #%u (dcp %llu, piodma %llu, pmp %llu, scanout %llu us); top #%u %llu us, #%u %llu us, #%u %llu us; <0.5/1/2/4/>=4 ms: %u/%u/%u/%u/%u\n",
+		 DCP_M4_US(r->health_first_ns), r->health_top[0].index,
+		 DCP_M4_US(r->health_max_part_ns[DCP_M4_HEALTH_DCP]),
+		 DCP_M4_US(r->health_max_part_ns[DCP_M4_HEALTH_PIODMA]),
+		 DCP_M4_US(r->health_max_part_ns[DCP_M4_HEALTH_PMP]),
+		 DCP_M4_US(r->health_max_part_ns[DCP_M4_HEALTH_SCANOUT]),
+		 r->health_top[0].index, DCP_M4_US(r->health_top[0].ns),
+		 r->health_top[1].index, DCP_M4_US(r->health_top[1].ns),
+		 r->health_top[2].index, DCP_M4_US(r->health_top[2].ns),
+		 r->health_hist[0], r->health_hist[1], r->health_hist[2],
+		 r->health_hist[3], r->health_hist[4]);
 	ret = 0;
 	goto out;
 failed:
@@ -5488,6 +5556,18 @@ static int iomfb_m4_status_show(struct seq_file *s, void *unused)
 			   r->health_checks, div_u64(r->health_ns, NSEC_PER_USEC),
 			   div_u64(r->health_max_ns, NSEC_PER_USEC),
 			   div_u64(r->health_last_ns, NSEC_PER_USEC));
+	if (r)
+		seq_printf(s, "health_first_us=%llu health_max_index=%u health_max_part_us=%llu/%llu/%llu/%llu health_top=%u:%llu,%u:%llu,%u:%llu health_hist=%u/%u/%u/%u/%u\n",
+			   DCP_M4_US(r->health_first_ns), r->health_top[0].index,
+			   DCP_M4_US(r->health_max_part_ns[DCP_M4_HEALTH_DCP]),
+			   DCP_M4_US(r->health_max_part_ns[DCP_M4_HEALTH_PIODMA]),
+			   DCP_M4_US(r->health_max_part_ns[DCP_M4_HEALTH_PMP]),
+			   DCP_M4_US(r->health_max_part_ns[DCP_M4_HEALTH_SCANOUT]),
+			   r->health_top[0].index, DCP_M4_US(r->health_top[0].ns),
+			   r->health_top[1].index, DCP_M4_US(r->health_top[1].ns),
+			   r->health_top[2].index, DCP_M4_US(r->health_top[2].ns),
+			   r->health_hist[0], r->health_hist[1], r->health_hist[2],
+			   r->health_hist[3], r->health_hist[4]);
 	if (r)
 		seq_printf(s, "idle_cache=%u state=%u fences=%u registered=%u entries=%llu\n",
 			   !r->idle_unavailable && READ_ONCE(idle_cache_ms), r->idle_state,
