From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 19:22:34 +0000
Subject: [PATCH] soc: apple: s2r: let the split step keep ANS or cycle
 its power

A split step at depths 1-6 idles and halts ANS but never cuts its power:
only depth 7 takes ANS's own domain down. RTKit firmware idled with its
power kept does not come back (apple_rtkit_sleep_return()), yet
nvme-apple's resume takes the real sleep's restart, as the split step has
declared the resume firmware-driven. ANS never reports on, nvme-apple
holds every request, and the machine waits on its disk until a watchdog
resets it.

Add split_ans, off by default. 1 sends ANS only its shutdown notice and
leaves it running, for depths 1-2, which leave its PCIe block alone: the
resume then resets its controller, as after a sleep refused past the
notice. 2 stops ANS as before and cycles its own power domain in the
undo, so that it restarts as after depth 7. Other combinations are
refused before anything is told, and each mode reports what it did. A
host test covers the selection.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 MAINTAINERS                        |  1 +
 drivers/soc/apple/apple-s2r.c      | 75 +++++++++++++++++++++++-
 tools/asahi/run-host-tests.py      |  3 +
 tools/asahi/s2r-split-ans-tests.py | 94 ++++++++++++++++++++++++++++++
 4 files changed, 172 insertions(+), 1 deletion(-)
 create mode 100755 tools/asahi/s2r-split-ans-tests.py

diff --git a/MAINTAINERS b/MAINTAINERS
index 5a7f14406c..89f7665934 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -2794,6 +2794,7 @@ F:	tools/asahi/apple-pwm-pm-tests.py
 F:	drivers/reset/reset-apple-cio.c
 F:	drivers/rtc/rtc-macsmc.c
 F:	drivers/soc/apple/*
+F:	tools/asahi/s2r-split-ans-tests.py
 F:	tools/asahi/m3-uapi-*
 F:	drivers/soc/apple/clpc.kunitconfig
 F:	tools/asahi/pmp-bootargs-tests.rs
diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 6acd5b4062..ffc12afc3e 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -479,6 +479,11 @@ struct apple_s2r_t8132 {
 	bool pcie_ans_stopped;
 	int ans_off_ret;
 	int pcie_ans_on_ret;
+	/* split_ans: what the split step does with ANS (apple_s2r_split_ans()) */
+	int split_ans;
+	bool ans_cycled;
+	int ans_cycle_off;
+	int ans_cycle_on;
 	/* abort_before at the raise: the IO lowering was undone without a commit */
 	bool raised;
 	/* What the finisher lowered, and the first lowering step that failed */
@@ -611,6 +616,36 @@ enum apple_s2r_step {
 	S2R_STEP_T8132_RAISE,
 };
 
+/* What a split step does with ANS, as split_ans selects it */
+enum apple_s2r_split_ans_mode {
+	/* Idled and halted; its power kept below depth 7: the disk is lost */
+	S2R_SPLIT_ANS_STOP,
+	/* Only its shutdown notice: the resume resets its controller */
+	S2R_SPLIT_ANS_NOTICE,
+	/* Idled and halted, then its own domain cycled in the undo */
+	S2R_SPLIT_ANS_CYCLE,
+};
+
+/*
+ * split_ans for an abort at @ab with split_depth @depth. ANS idled with its
+ * power kept never comes back (apple_rtkit_sleep_return()), and below depth 7
+ * nothing cuts that power. 1 keeps ANS running past its shutdown notice, for
+ * depths that leave its PCIe block alone; 2 cycles ANS's own domain after the
+ * undo, at the depths that never power it down. Return: the mode, or -EINVAL.
+ */
+static int apple_s2r_split_ans(unsigned int ab, unsigned int depth, unsigned int mode)
+{
+	if (!mode || ab != S2R_STEP_T8132_RAISE)
+		return S2R_SPLIT_ANS_STOP;
+	if (!depth || depth >= 7)
+		return -EINVAL;
+	if (mode == 1)
+		return depth <= 2 ? S2R_SPLIT_ANS_NOTICE : -EINVAL;
+	if (mode == 2)
+		return S2R_SPLIT_ANS_CYCLE;
+	return -EINVAL;
+}
+
 static const char *const apple_s2r_step_names[] = {
 	[S2R_STEP_NONE]		= "none",
 	[S2R_STEP_COPROCS]	= "coprocessor refusal",
@@ -1072,6 +1107,10 @@ static uint split_depth;
 module_param(split_depth, uint, 0644);
 MODULE_PARM_DESC(split_depth, "For bring-up, with t8132_sequence and abort_before=16 (the split step): how much of the IO lowering runs before it is raised again: 1 ANS stopped only, 2 + ATC0, 3 + APCIe root ports stopped, 4 + APCIe PHY, 5 + APCIe clock and system domains, 6 + AXI enables and GP, 7 + the ANS domain, 8 all of it with every coprocessor stopped first as in a real sleep (they stay stopped until a reboot); 0 is all of it (default: 0)");
 
+static uint split_ans;
+module_param(split_ans, uint, 0644);
+MODULE_PARM_DESC(split_ans, "For bring-up, with split_depth 1-6: what the split step does with ANS, whose power those depths never cut: 0 idle and halt it, as before (it does not come back, the disk is lost), 1 send it only its shutdown notice and leave it running (depths 1-2; the resume resets its controller), 2 idle and halt it, then cycle its own power domain in the undo so it restarts as after depth 7 (not yet run on the hardware); other combinations are refused (default: 0)");
+
 static bool t8132_time_trail;
 module_param(t8132_time_trail, bool, 0644);
 MODULE_PARM_DESC(t8132_time_trail, "For bring-up, with t8132_sequence and wdt_from_enter: at each step past the match, arm the watchdog again with that step's own time (20 s apart), so that the time of a reset names the step a hang came from (default: off)");
@@ -2530,6 +2569,21 @@ static void apple_s2r_t8132_clean_ram(void)
  * ANS again in its resume, as after a wake. Proves the lowering, the raise
  * and the disk coming back without a commit.
  */
+/*
+ * split_ans=2: ANS was idled and halted with its power kept. Take its own
+ * domain down and up again, so that its firmware restarts as after depth 7.
+ */
+static void apple_s2r_t8132_ans_cycle(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	void __iomem *ans = t->ps + T8132_PS_ANS;
+
+	apple_s2r_t8132_ps_lower(ans);
+	t->ans_cycle_off = apple_s2r_t8132_ps_wait_off(ans);
+	t->ans_cycle_on = apple_s2r_t8132_ps_raise_full(ans);
+	t->ans_cycled = true;
+}
+
 static void apple_s2r_t8132_raise_after_lower(struct apple_s2r *s2r)
 {
 	struct apple_s2r_t8132 *t = &s2r->t8132;
@@ -2644,6 +2698,8 @@ static int apple_s2r_t8132_finish(unsigned long arg)
 		ret = -EIO;
 	if (ret) {
 		apple_s2r_t8132_raise_after_lower(s2r);
+		if (t->split_ans == S2R_SPLIT_ANS_CYCLE && t->pcie_ans_stopped)
+			apple_s2r_t8132_ans_cycle(s2r);
 		apple_cpu_t8132_release_stopped(false);
 		apple_s2r_crumb(s2r, S2R_CRUMB_T8132_RAISE_DONE);
 		return ret;
@@ -2893,6 +2949,7 @@ static int apple_s2r_t8132_enter(struct apple_s2r *s2r)
 	t->lower_err = 0;
 	t->l2_timeouts = 0;
 	t->atc0_ret = 0;
+	t->ans_cycled = false;
 	if (!READ_ONCE(abort_before) || READ_ONCE(abort_before) == S2R_STEP_T8132_RAISE)
 		for (i = 0; i < S2R_COPROCS; i++)
 			if (apple_s2r_coprocs[i].dev && apple_s2r_coprocs[i].pcie_ans &&
@@ -2976,6 +3033,13 @@ static void apple_s2r_t8132_report(struct apple_s2r *s2r)
 				t->pcie_ans_on_ret);
 	}
 	t->raised = false;
+	if (t->split_ans == S2R_SPLIT_ANS_NOTICE)
+		dev_info(s2r->dev, "T8132: split step: ANS got its shutdown notice only (split_ans 1), not stopped\n");
+	if (t->ans_cycled)
+		dev_info(s2r->dev, "T8132: split step: ANS's domain cycled alone (split_ans 2): off %d, on %d\n",
+			 t->ans_cycle_off, t->ans_cycle_on);
+	t->ans_cycled = false;
+	t->split_ans = S2R_SPLIT_ANS_STOP;
 	if (!t->returned)
 		return;
 	t->returned = false;
@@ -3196,6 +3260,14 @@ static int apple_s2r_enter(suspend_state_t state)
 		ret = apple_s2r_t8132_refuse(s2r);
 		if (ret)
 			return ret;
+		s2r->t8132.split_ans = apple_s2r_split_ans(READ_ONCE(abort_before),
+							   READ_ONCE(split_depth),
+							   READ_ONCE(split_ans));
+		if (s2r->t8132.split_ans < 0) {
+			pr_warn("apple-s2r: split_ans=%u is not for split_depth %u: refused\n",
+				READ_ONCE(split_ans), READ_ONCE(split_depth));
+			return -EINVAL;
+		}
 	}
 
 	/*
@@ -3236,7 +3308,8 @@ static int apple_s2r_enter(suspend_state_t state)
 		apple_s2r_coprocs_stop(false);
 		apple_s2r_crumb(s2r, S2R_CRUMB_COPROCS_LAST);
 	} else if (t8132_sequence && READ_ONCE(abort_before) == S2R_STEP_T8132_RAISE) {
-		apple_s2r_coprocs_stop_ans();
+		if (s2r->t8132.split_ans != S2R_SPLIT_ANS_NOTICE)
+			apple_s2r_coprocs_stop_ans();
 		apple_s2r_crumb(s2r, S2R_CRUMB_COPROCS_LAST);
 	}
 
diff --git a/tools/asahi/run-host-tests.py b/tools/asahi/run-host-tests.py
index 7d6ee5717a..d09bc6562c 100755
--- a/tools/asahi/run-host-tests.py
+++ b/tools/asahi/run-host-tests.py
@@ -172,6 +172,9 @@ ASAHI_TESTS = {
                                    'maverick-event', 'stowe-offset'), out()),
     'perf-mmap-alias-lifecycle-tests.py': [([], PASS)],
     'qspi-nvram-tests.py': [(out('--output'), PASS)],
+    's2r-split-ans-tests.py': [(out(), PASS)]
+        + mutations('--mutation', ('notice-depth', 'depth-seven', 'depth-zero',
+                                   'not-split', 'mode-unknown'), out()),
     'rtkit-crashlog-tests.py': [(out(), PASS)]
         + mutations('--mutation', ('buffer-header', 'section-header', 'section-size', 'footer-room',
                                    'mailbox-minimum', 'version-string', 'message-string'), out()),
diff --git a/tools/asahi/s2r-split-ans-tests.py b/tools/asahi/s2r-split-ans-tests.py
new file mode 100755
index 0000000000..ca65f0e8f8
--- /dev/null
+++ b/tools/asahi/s2r-split-ans-tests.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Execute apple-s2r's split_ans selection against every abort/depth/mode.
+
+The step enum, the mode enum and apple_s2r_split_ans() are extracted from the
+driver and compiled on the host. This checks which ANS handling each bring-up
+combination gets and which ones are refused, not the hardware behind them.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+MUTATIONS = {
+    'notice-depth': ('return depth <= 2 ? S2R_SPLIT_ANS_NOTICE', 'return depth <= 3 ? S2R_SPLIT_ANS_NOTICE'),
+    'depth-seven': ('if (!depth || depth >= 7)', 'if (!depth || depth > 7)'),
+    'depth-zero': ('if (!depth || depth >= 7)', 'if (depth >= 7)'),
+    'not-split': ('ab != S2R_STEP_T8132_RAISE', 'ab < S2R_STEP_T8132_WAKE'),
+    'mode-unknown': ('\treturn -EINVAL;\n}', '\treturn S2R_SPLIT_ANS_STOP;\n}'),
+}
+
+PRELUDE = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+'''
+
+CASES = r'''
+int main(void) {
+    unsigned int d;
+    /* mode 0: today's stop, whatever the abort and depth */
+    for (d = 0; d <= 8; d++) {
+        assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, d, 0) == S2R_SPLIT_ANS_STOP);
+        assert(apple_s2r_split_ans(0, d, 0) == S2R_SPLIT_ANS_STOP);
+    }
+    /* not a split step: the switch does nothing */
+    assert(apple_s2r_split_ans(0, 1, 1) == S2R_SPLIT_ANS_STOP);
+    assert(apple_s2r_split_ans(S2R_STEP_T8132_LOWER, 1, 2) == S2R_SPLIT_ANS_STOP);
+    /* mode 1: depths 1-2 only */
+    assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, 1, 1) == S2R_SPLIT_ANS_NOTICE);
+    assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, 2, 1) == S2R_SPLIT_ANS_NOTICE);
+    for (d = 3; d <= 8; d++)
+        assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, d, 1) == -EINVAL);
+    assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, 0, 1) == -EINVAL);
+    /* mode 2: depths 1-6; 0 and 7 power ANS down anyway, 8 stops everything */
+    for (d = 1; d <= 6; d++)
+        assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, d, 2) == S2R_SPLIT_ANS_CYCLE);
+    assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, 0, 2) == -EINVAL);
+    assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, 7, 2) == -EINVAL);
+    assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, 8, 2) == -EINVAL);
+    /* unknown modes are refused */
+    assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, 1, 3) == -EINVAL);
+    assert(apple_s2r_split_ans(S2R_STEP_T8132_RAISE, 1, 0xffffffffu) == -EINVAL);
+    puts("apple-s2r split_ans: every abort/depth/mode combination selects as documented");
+    return 0;
+}
+'''
+
+
+def extract(source):
+    step = re.search(r'enum apple_s2r_step \{.*?\n\};\n', source, re.S).group(0)
+    mode = re.search(r'enum apple_s2r_split_ans_mode \{.*?\n\};\n', source, re.S).group(0)
+    start = source.index('static int apple_s2r_split_ans(')
+    end = source.index('\n}\n', start) + 3
+    return step + mode + source[start:end]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path)
+    parser.add_argument('--mutation', choices=MUTATIONS)
+    args = parser.parse_args()
+    code = extract((ROOT / 'drivers/soc/apple/apple-s2r.c').read_text())
+    if args.mutation:
+        old, new = MUTATIONS[args.mutation]
+        assert old in code, f'missing mutation site: {old}'
+        code = code.replace(old, new, 1)
+    with tempfile.TemporaryDirectory(prefix='s2r-split-ans-') as tmp:
+        out = args.out or Path(tmp)
+        out.mkdir(parents=True, exist_ok=True)
+        unit = out / 's2r-split-ans.c'
+        binary = out / 's2r-split-ans'
+        unit.write_text(PRELUDE + code + CASES)
+        subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-Wall', '-Wextra',
+                        '-Werror', str(unit), '-o', str(binary)], check=True)
+        result = subprocess.run([str(binary)])
+        raise SystemExit(1 if result.returncode else 0)
+
+
+if __name__ == '__main__':
+    main()
