+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Check apple-isp's upscale probe (debugfs upscale_probe) and the crop rules.
+
+The driver's own preset functions are compiled on the host from
+drivers/media/platform/apple/isp/isp-cam.c and run against a J604-like
+preset list (config 5, 1920x1080 and 1280x720). They must:
+- keep the call-size rule (isp_size_from_crop) exactly as before its source
+  check moved into isp_crop_in_input(), over a grid of sources and sizes;
+- cut macOS's portrait sizes, 1328x1760 and 1080x1920, from the selected
+  config 6 window as the largest even, centred crop of their shape, and
+  refuse every size that window can serve without enlarging;
+- list those two sizes only while upscale_probe is set, whatever the wide
+  view, and leave every other size and the default list as they were;
+- never let a probe size stand in for a real size of the same dimensions;
+- and the debugfs file must be root-only, T8132 wide config only, and never
+  set by the driver.
+"""
+import argparse
+from math import gcd
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+ISP = 'drivers/media/platform/apple/isp/'
+FILES = ('isp-cam.c', 'isp-drv.c', 'isp-drv.h', 'isp-v4l2.c')
+
+MUTATIONS = {
+    'offered-always': ('isp-cam.c', '\tif (preset->upscale_probe)\n\t\treturn READ_ONCE(isp->upscale_probe);\n', ''),
+    'offered-on': ('isp-cam.c', 'return READ_ONCE(isp->upscale_probe);', 'return true;'),
+    'debugfs-0644': ('isp-drv.c', 'debugfs_create_bool("upscale_probe", 0600,', 'debugfs_create_bool("upscale_probe", 0644,'),
+    'debugfs-ungated': ('isp-drv.c', '\tif (isp->hw->imx958_wide_cfg6)\n\t\tdebugfs_create_bool("upscale_probe"',
+                        '\tif (1)\n\t\tdebugfs_create_bool("upscale_probe"'),
+    'default-on': ('isp-drv.c', '\tif (isp->hw->imx958_wide_cfg6)\n\t\tdebugfs_create_bool("upscale_probe"',
+                   '\tisp->upscale_probe = true;\n\tif (isp->hw->imx958_wide_cfg6)\n\t\tdebugfs_create_bool("upscale_probe"'),
+    'odd-crop': ('isp-cam.c', '\tw = round_down(w, 2);\n\th = round_down(h, 2);\n', ''),
+    'no-clamp': ('isp-cam.c', '\tif (w > source->crop_size.x) {\n\t\tw = source->crop_size.x;\n\t\th = w * size.y / size.x;\n\t}\n', ''),
+    'no-centre': ('isp-cam.c', '\tpreset->crop_offset.x += round_down((source->crop_size.x - w) / 2, 2);\n', ''),
+    'allow-fit': ('isp-cam.c', ' || (w >= size.x && h >= size.y)', ''),
+    'no-probe-flag': ('isp-cam.c', '\tpreset->upscale_probe = true;\n', ''),
+    'probe-not-wide': ('isp-cam.c', '\t\t\t\t\t       isp_upscale_sizes[k], &cut))\n\t\t\tcontinue;\n\t\tpresets[n] = cut;\n\t\tpresets[n].wide_only = true;\n',
+                       '\t\t\t\t\t       isp_upscale_sizes[k], &cut))\n\t\t\tcontinue;\n\t\tpresets[n] = cut;\n'),
+    'dedupe-probe': ('isp-cam.c', '\t\tif (!presets[i].upscale_probe &&\n\t\t    presets[i].output_dim.x == size.x &&',
+                     '\t\tif (presets[i].output_dim.x == size.x &&'),
+    'cut-strict': ('isp-cam.c', '\tif (preset->upscale_probe)\n\t\treturn isp_size_upscaled(isp_wide_window(), preset->output_dim,\n\t\t\t\t\t wide);\n', ''),
+    'cut-fixed-window': ('isp-cam.c', 'return isp_size_upscaled(isp_wide_window(),', 'return isp_size_upscaled(&isp_wide_source,'),
+    'refactor-odd': ('isp-cam.c', '\t       !((source->crop_offset.x | source->crop_offset.y) & 1) &&\n', ''),
+    'refactor-bound': ('isp-cam.c', '\t       source->crop_size.y <= source->input_dim.y - source->crop_offset.y;', '\t       true;'),
+    'no-log': ('isp-cam.c', '"upscale probe: ', '"probe: '),
+}
+
+SHIM = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef uint32_t u32;
+#define READ_ONCE(x) (x)
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define round_down(x, y) ((x) & ~((__typeof__(x))((y) - 1)))
+#define min(a, b) ((a) < (b) ? (a) : (b))
+#define max(a, b) ((a) > (b) ? (a) : (b))
+#define GFP_KERNEL 0
+#define ENOMEM 12
+static u32 gcd(u32 a, u32 b) { while (b) { u32 t = a % b; a = b; b = t; } return a; }
+struct device { int unused; };
+static void *devm_kcalloc(struct device *dev, size_t n, size_t size, int gfp)
+{ (void)dev; (void)gfp; return calloc(n, size); }
+'''
+
+SHIM2 = r'''
+struct apple_isp_hw { bool imx958_wide_cfg6; };
+struct apple_isp { struct device *dev; const struct apple_isp_hw *hw; struct isp_preset *presets;
+		   int num_presets; bool upscale_probe; };
+static bool wide_view;
+static unsigned int wide_window;
+'''
+
+MAIN = r'''
+static void put(bool ok, const struct isp_preset *p)
+{
+	if (ok)
+		printf("1 %u %u %u %u %d\n", p->crop_offset.x, p->crop_offset.y,
+		       p->crop_size.x, p->crop_size.y, p->upscale_probe);
+	else
+		printf("0\n");
+}
+
+static const struct apple_isp_hw hw = { .imx958_wide_cfg6 = true };
+static struct device dev;
+static struct isp_preset dt[2] = {
+	{ .index = 5, .input_dim = { 1920, 2160 }, .crop_size = { 1920, 1080 }, .output_dim = { 1920, 1080 } },
+	{ .index = 5, .input_dim = { 1920, 2160 }, .crop_size = { 1920, 1080 }, .output_dim = { 1280, 720 } },
+};
+
+int main(void)
+{
+	char cmd[16];
+	struct apple_isp isp = { .dev = &dev, .hw = &hw, .presets = dt, .num_presets = 2 };
+
+	assert(apple_isp_add_wide_presets(&isp) == 0);
+	while (scanf("%15s", cmd) == 1) {
+		if (!strcmp(cmd, "F") || !strcmp(cmd, "U")) {
+			struct isp_preset s = { .index = 6 }, r;
+			struct coord size;
+
+			assert(scanf("%u %u %u %u %u %u %u %u", &s.input_dim.x, &s.input_dim.y,
+				     &s.crop_offset.x, &s.crop_offset.y, &s.crop_size.x,
+				     &s.crop_size.y, &size.x, &size.y) == 8);
+			memset(&r, 0, sizeof(r));
+			put(cmd[0] == 'F' ? isp_size_from_crop(&s, size, &r) :
+				isp_size_upscaled(&s, size, &r), &r);
+		} else if (!strcmp(cmd, "LIST")) {
+			for (int i = 0; i < isp.num_presets; i++) {
+				const struct isp_preset *p = &isp.presets[i];
+
+				printf("P %u %u %u %u %u %u %u %d %d\n", p->index, p->output_dim.x,
+				       p->output_dim.y, p->crop_offset.x, p->crop_offset.y,
+				       p->crop_size.x, p->crop_size.y, p->wide_only, p->upscale_probe);
+			}
+			printf("END\n");
+		} else if (!strcmp(cmd, "OFFER")) {
+			int wv, fl;
+
+			assert(scanf("%d %d", &wv, &fl) == 2);
+			wide_view = wv;
+			isp.upscale_probe = fl;
+			printf("O");
+			for (int i = 0; i < isp.num_presets; i++)
+				if (apple_isp_preset_offered(&isp, &isp.presets[i]))
+					printf(" %ux%u", isp.presets[i].output_dim.x,
+					       isp.presets[i].output_dim.y);
+			printf("\n");
+		} else if (!strcmp(cmd, "CUT")) {
+			assert(scanf("%u", &wide_window) == 1);
+			for (int i = 0; i < isp.num_presets; i++) {
+				struct isp_preset w;
+				bool ok;
+
+				if (!isp.presets[i].wide_only)
+					continue;
+				memset(&w, 0, sizeof(w));
+				ok = isp_cut_wide(&isp.presets[i], &w);
+				printf("%ux%u ", isp.presets[i].output_dim.x, isp.presets[i].output_dim.y);
+				put(ok, &w);
+			}
+			printf("END\n");
+		} else if (!strcmp(cmd, "DEDUP")) {
+			unsigned int n = isp.num_presets, r1, r2;
+			struct isp_preset *a = calloc(n + 3, sizeof(*a));
+
+			memcpy(a, isp.presets, n * sizeof(*a));
+			a[n] = (struct isp_preset){ .index = 3, .input_dim = { 2000, 4000 },
+						    .crop_size = { 2000, 4000 }, .output_dim = { 2000, 4000 } };
+			r1 = isp_append_size(a, n + 1, n + 1, (struct coord){ 1080, 1920 });
+			r2 = isp_append_size(a, r1, n + 1, (struct coord){ 1080, 1920 });
+			printf("D %u %u %u %d\n", n, r1, r2, r1 > n + 1 ? a[n + 1].upscale_probe : -1);
+		} else {
+			abort();
+		}
+		fflush(stdout);
+	}
+	return 0;
+}
+'''
+
+FUNCS = ('isp_crop_in_input', 'isp_size_from_crop', 'isp_size_upscaled', 'isp_append_size', 'isp_wide_window',
+         'apple_isp_wide_view', 'apple_isp_preset_offered', 'isp_preset_narrow', 'apple_isp_add_wide_presets',
+         'isp_cut_wide')
+TABLES = ('isp_wide_source', 'isp_lens_source', 'isp_wide_sizes', 'isp_upscale_sizes')
+
+
+def fail(msg):
+    raise AssertionError('Assertion failed: ' + msg)
+
+
+def func(src, name):
+    m = re.search(r'^[a-z][^\n;]*\b' + name + r'\([^;{]*?\)\n\{', src, re.M | re.S)
+    if not m:
+        fail(f'no function {name} in isp-cam.c')
+    a, b, n = m.start(), m.end(), 1
+    while n:
+        n += {'{': 1, '}': -1}.get(src[b], 0)
+        b += 1
+    return src[a:b]
+
+
+def block(src, pattern, what):
+    m = re.search(pattern, src, re.M | re.S)
+    if not m:
+        fail(f'no {what}')
+    return m.group(0)
+
+
+def rd(v):
+    return v & ~1
+
+
+def valid(s):
+    ix, iy, ox, oy, cx, cy = s
+    return bool(cx and cy and not ((ox | oy) & 1) and cx <= 16384 and cy <= 16384 and
+                ox <= ix and cx <= ix - ox and oy <= iy and cy <= iy - oy)
+
+
+def old_from_crop(s, size):
+    """isp_size_from_crop as cam-08 / cam-09 wrote it, before the source check moved."""
+    ix, iy, ox, oy, cx, cy = s
+    sx, sy = size
+    if (not sx or not sy or (sx | sy) & 1 or not cx or not cy or (ox | oy) & 1 or cx > 16384 or cy > 16384 or
+            ox > ix or cx > ix - ox or oy > iy or cy > iy - oy):
+        return None
+    d = gcd(sx, sy)
+    x, y = sx // d, sy // d
+    scale = rd(min(cx // x, cy // y))
+    if scale < d:
+        return None
+    return (ox + rd((cx - x * scale) // 2), oy + rd((cy - y * scale) // 2), x * scale, y * scale)
+
+
+def upscaled(s, size):
+    ix, iy, ox, oy, cx, cy = s
+    sx, sy = size
+    if not sx or not sy or (sx | sy) & 1 or sx > 16384 or sy > 16384 or not valid(s):
+        return None
+    h = cy
+    w = h * sx // sy
+    if w > cx:
+        w = cx
+        h = w * sy // sx
+    w, h = rd(w), rd(h)
+    if not w or not h or (w >= sx and h >= sy):
+        return None
+    return (ox + rd((cx - w) // 2), oy + rd((cy - h) // 2), w, h)
+
+
+WIDE = (3040, 5760, 0, 584, 3040, 1710)
+LENS = (3040, 5760, 176, 494, 2688, 1738)
+# Expected by hand (lead-252 / MACOS-DELTA CAM part 2 windows): offset x, y, crop w, h
+J604 = {
+    (WIDE, (1328, 1760)): (874, 584, 1290, 1710),
+    (WIDE, (1080, 1920)): (1040, 584, 960, 1710),
+    (LENS, (1328, 1760)): (864, 494, 1310, 1738),
+    (LENS, (1080, 1920)): (1032, 494, 976, 1738),
+    ((3040, 5760, 100, 0, 900, 1738), (1080, 1920)): (100, 68, 900, 1600),
+}
+REFUSED = [(LENS, (1920, 1080)), (LENS, (1760, 1328)), (LENS, (1552, 1552)), (LENS, (1328, 1761)),
+           (LENS, (0, 1760)), (LENS, (16386, 2)), ((3040, 5760, 1, 494, 2688, 1738), (1080, 1920)),
+           ((3040, 5760, 176, 494, 2688, 6000), (1080, 1920)), ((3040, 5760, 176, 494, 0, 1738), (1080, 1920))]
+
+
+def source_checks(src):
+    drv, cam = src['isp-drv.c'], src['isp-cam.c']
+    if drv.count('debugfs_create_bool("upscale_probe", 0600, isp->debugfs,') != 1:
+        fail('upscale_probe must be one root-only (0600) debugfs bool')
+    if drv.count('\tif (isp->hw->imx958_wide_cfg6)\n\t\tdebugfs_create_bool("upscale_probe"') != 1:
+        fail('upscale_probe must exist only on the IMX958 wide config (T8132)')
+    for name in FILES:
+        sets = re.findall(r'upscale_probe\s*=[^=]', src[name])
+        want = 1 if name == 'isp-cam.c' else 0
+        if len(sets) != want:
+            fail(f'{name}: {len(sets)} assignments to upscale_probe; only the probe cut may set a preset\'s flag, '
+                 'and nothing in the driver may set the debugfs one')
+    if '\tpreset->upscale_probe = true;' not in func(cam, 'isp_size_upscaled'):
+        fail('the probe cut must mark its preset')
+    res = func(cam, 'isp_resolve_stream_preset')
+    if 'isp_cut_wide(preset, &wide)' not in res:
+        fail('the stream preset must be cut by isp_cut_wide')
+    if '\tif (isp->stream_preset.upscale_probe)\n\t\tdev_info(isp->dev,\n\t\t\t "upscale probe: ' not in res:
+        fail('a probe stream must log its crop ("upscale probe: ...")')
+
+
+def run(src, work):
+    cam = src['isp-cam.c']
+    hdr = src['isp-drv.h']
+    code = [SHIM,
+            block(hdr, r'^struct coord \{.*?\n\};', 'struct coord'),
+            block(hdr, r'^struct isp_preset \{.*?\n\};', 'struct isp_preset'),
+            SHIM2]
+    for t in TABLES:
+        code.append(block(cam, r'^static const struct (?:isp_preset|coord) ' + t + r'(?:\[\])? = \{.*?\n\};', t))
+    code += [func(cam, f) for f in FUNCS]
+    code.append(MAIN)
+    c = work / 'isp-upscale.c'
+    exe = work / 'isp-upscale'
+    c.write_text('\n'.join(code))
+    p = subprocess.run(['cc', '-std=gnu11', '-O0', '-g', '-Werror=implicit-function-declaration', str(c), '-o', str(exe)],
+                       capture_output=True, text=True)
+    if p.returncode:
+        print(p.stderr)
+        fail('the extracted driver code does not build')
+
+    inputs = [(3040, 5760), (1920, 2160)]
+    offsets = [(0, 0), (176, 494), (1, 0), (0, 3), (3040, 0), (4000, 0)]
+    crops = [(3040, 1710), (2688, 1738), (1920, 1080), (0, 8), (16386, 2), (1000, 6000), (2, 2)]
+    sizes = [(640, 480), (1280, 720), (1920, 1080), (1080, 1920), (1760, 1328), (1328, 1760), (1552, 1552),
+             (1280, 960), (960, 1280), (2560, 1440), (0, 2), (3, 2), (2, 2), (16384, 2)]
+    grid = [(i + o + c, s) for i in inputs for o in offsets for c in crops for s in sizes]
+    ucases = grid + list(J604) + REFUSED
+    cmds = [f'F {" ".join(map(str, s + z))}' for s, z in grid]
+    cmds += [f'U {" ".join(map(str, s + z))}' for s, z in ucases]
+    cmds += ['LIST', 'OFFER 0 0', 'OFFER 1 0', 'OFFER 0 1', 'OFFER 1 1', 'CUT 0', 'CUT 1', 'DEDUP', 'OFFER 0 0']
+    p = subprocess.run([str(exe)], input='\n'.join(cmds) + '\n', capture_output=True, text=True, timeout=20)
+    if p.returncode:
+        print(p.stderr)
+        fail(f'the harness stopped (exit {p.returncode})')
+    out = iter(p.stdout.splitlines())
+
+    def res():
+        v = next(out).split()
+        return None if v[0] == '0' else tuple(int(x) for x in v[1:5])
+
+    for s, z in grid:
+        got = res()
+        if got != old_from_crop(s, z):
+            fail(f'call-size rule changed: {s} {z}: {got} vs {old_from_crop(s, z)}')
+    for s, z in ucases:
+        got = res()
+        if got != upscaled(s, z):
+            fail(f'probe cut {s} {z}: {got}, want {upscaled(s, z)}')
+        if (s, z) in J604 and got != J604[(s, z)]:
+            fail(f'probe cut {s} {z}: {got}, want {J604[(s, z)]}')
+        if (s, z) in REFUSED and got is not None:
+            fail(f'probe cut {s} {z} must be refused, got {got}')
+        if got:
+            ox, oy, w, h = got
+            ix, iy, sox, soy, cx, cy = s
+            if (w | h | ox | oy) & 1:
+                fail(f'odd probe crop {got}')
+            if not (sox <= ox and ox + w <= sox + cx and soy <= oy and oy + h <= soy + cy):
+                fail(f'probe crop {got} outside {s}')
+            if abs((ox - sox) - (sox + cx - ox - w)) > 3 or abs((oy - soy) - (soy + cy - oy - h)) > 3:
+                fail(f'probe crop {got} not centred in {s}')
+            if not (w < z[0] or h < z[1]):
+                fail(f'probe crop {got} does not need enlarging to {z}')
+            if abs(w * z[1] - h * z[0]) > 2 * max(z):
+                fail(f'probe crop {got} is not {z}\'s shape')
+
+    lst = []
+    for line in out:
+        if line == 'END':
+            break
+        lst.append(tuple(int(x) for x in line.split()[1:]))
+    base = [(1920, 1080), (1280, 720)]
+    wide = [(2560, 1440), (1760, 1328), (1552, 1552)]
+    port = [(1328, 1760), (1080, 1920)]
+    dims = [(p_[1], p_[2]) for p_ in lst]
+    if dims != base + wide + port:
+        fail(f'preset list {dims}, want {base + wide + port}')
+    for p_ in lst:
+        probe = (p_[1], p_[2]) in port
+        if p_[8] != int(probe) or p_[7] != int((p_[1], p_[2]) in wide + port) or p_[0] != (6 if p_[7] else 5):
+            fail(f'preset {p_}: wrong wide_only / upscale_probe / config')
+    if [p_[3:7] for p_ in lst[5:]] != [J604[(WIDE, z)] for z in port]:
+        fail(f'probe presets {lst[5:]} are not cut from the 3040x1710 window')
+
+    def offer():
+        return [tuple(int(v) for v in t.split('x')) for t in next(out).split()[1:]]
+    for want in (base, base + wide, base + port, base + wide + port):
+        got = offer()
+        if got != want:
+            fail(f'offered {got}, want {want}')
+
+    for ww, win in ((0, WIDE), (1, LENS)):
+        for line in out:
+            if line == 'END':
+                break
+            size = tuple(int(v) for v in line.split()[0].split('x'))
+            v = line.split()[1:]
+            got = None if v[0] == '0' else tuple(int(x) for x in v[1:5])
+            want = upscaled(win, size) if size in port else old_from_crop(win, size)
+            if got != want or got is None:
+                fail(f'wide_window {ww}: {size} cut {got}, want {want}')
+            if int(v[-1]) != int(size in port):
+                fail(f'wide_window {ww}: {size} probe flag {v[-1]}')
+    d = next(out).split()
+    n, r1, r2, flag = (int(x) for x in d[1:])
+    if r1 != n + 2 or flag != 0:
+        fail(f'a probe 1080x1920 blocked the real one derivable from a taller source (append {n}+1 -> {r1}, flag {flag})')
+    if r2 != r1:
+        fail('the real 1080x1920 was appended twice')
+    if offer() != base:
+        fail('turning the probe off does not restore the default list')
+    return len(grid), len(ucases)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path)
+    parser.add_argument('--mutation', choices=MUTATIONS)
+    args = parser.parse_args()
+    src = {f: (ROOT / ISP / f).read_text() for f in FILES}
+    if args.mutation:
+        f, old, new = MUTATIONS[args.mutation]
+        assert src[f].count(old) == 1, f'mutation site not found once: {old!r}'
+        src[f] = src[f].replace(old, new, 1)
+    with tempfile.TemporaryDirectory() as tmp:
+        work = args.out if args.out else Path(tmp)
+        work.mkdir(parents=True, exist_ok=True)
+        try:
+            source_checks(src)
+            ng, nu = run(src, work)
+        except (AssertionError, StopIteration, ValueError) as e:
+            print(e if str(e).startswith('Assertion') else f'Assertion failed: {type(e).__name__} {e}')
+            raise SystemExit(1)
+    line = ('isp upscale probe: call-size rule unchanged over %d cases; probe cuts of 1328x1760 / 1080x1920 even, '
+            'centred, in the window, refused when nothing needs enlarging (%d cases); listed only with upscale_probe; '
+            'debugfs 0600, wide config only, never set by the driver' % (ng, nu))
+    if args.out:
+        (args.out / 'result.txt').write_text(line + '\n')
+    print(line)
+
+
+if __name__ == '__main__':
+    main()
