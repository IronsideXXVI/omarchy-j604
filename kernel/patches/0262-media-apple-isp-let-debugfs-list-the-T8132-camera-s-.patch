 drivers/media/platform/apple/isp/isp-drv.c |   3 +
 drivers/media/platform/apple/isp/isp-drv.h |   4 +
 tools/asahi/isp-upscale-probe-tests.py     | 419 +++++++++++++++++++++
 tools/asahi/run-host-tests.py              |   5 +
 5 files changed, 527 insertions(+), 10 deletions(-)
 create mode 100755 tools/asahi/isp-upscale-probe-tests.py

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index f833358adf..0d9ab6b863 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -423,19 +423,24 @@ static const struct coord isp_call_sizes[] = {
  * rows). Use the largest exact-aspect crop, centred on the chroma grid,
  * with no upscaling. Neither command reports a scaler limit or rotation.
  */
+static bool isp_crop_in_input(const struct isp_preset *source)
+{
+	return source->crop_size.x && source->crop_size.y &&
+	       !((source->crop_offset.x | source->crop_offset.y) & 1) &&
+	       source->crop_size.x <= 16384 && source->crop_size.y <= 16384 &&
+	       source->crop_offset.x <= source->input_dim.x &&
+	       source->crop_size.x <= source->input_dim.x - source->crop_offset.x &&
+	       source->crop_offset.y <= source->input_dim.y &&
+	       source->crop_size.y <= source->input_dim.y - source->crop_offset.y;
+}
+
 static bool isp_size_from_crop(const struct isp_preset *source,
 			       struct coord size, struct isp_preset *preset)
 {
 	u32 divisor, x, y, scale;
 
 	if (!size.x || !size.y || (size.x | size.y) & 1 ||
-	    !source->crop_size.x || !source->crop_size.y ||
-	    (source->crop_offset.x | source->crop_offset.y) & 1 ||
-	    source->crop_size.x > 16384 || source->crop_size.y > 16384 ||
-	    source->crop_offset.x > source->input_dim.x ||
-	    source->crop_size.x > source->input_dim.x - source->crop_offset.x ||
-	    source->crop_offset.y > source->input_dim.y ||
-	    source->crop_size.y > source->input_dim.y - source->crop_offset.y)
+	    !isp_crop_in_input(source))
 		return false;
 
 	divisor = gcd(size.x, size.y);
@@ -454,6 +459,41 @@ static bool isp_size_from_crop(const struct isp_preset *source,
 	return true;
 }
 
+/*
+ * For the upscale probe only: the largest even-sized crop of the size's
+ * shape that the source crop holds, centred, which the scaler then has to
+ * enlarge. The shape is kept to within the pixel the even rounding costs.
+ * A size the source can serve without enlarging is refused here.
+ */
+static bool isp_size_upscaled(const struct isp_preset *source,
+			      struct coord size, struct isp_preset *preset)
+{
+	u32 w, h;
+
+	if (!size.x || !size.y || (size.x | size.y) & 1 ||
+	    size.x > 16384 || size.y > 16384 || !isp_crop_in_input(source))
+		return false;
+
+	h = source->crop_size.y;
+	w = h * size.x / size.y;
+	if (w > source->crop_size.x) {
+		w = source->crop_size.x;
+		h = w * size.y / size.x;
+	}
+	w = round_down(w, 2);
+	h = round_down(h, 2);
+	if (!w || !h || (w >= size.x && h >= size.y))
+		return false;
+
+	*preset = *source;
+	preset->output_dim = size;
+	preset->crop_size = (struct coord){ w, h };
+	preset->crop_offset.x += round_down((source->crop_size.x - w) / 2, 2);
+	preset->crop_offset.y += round_down((source->crop_size.y - h) / 2, 2);
+	preset->upscale_probe = true;
+	return true;
+}
+
 static unsigned int isp_append_size(struct isp_preset *presets, unsigned int num,
 				    unsigned int sources, struct coord size)
 {
@@ -461,7 +501,8 @@ static unsigned int isp_append_size(struct isp_preset *presets, unsigned int num
 	u32 area, best_area = 0;
 
 	for (unsigned int i = 0; i < num; i++)
-		if (presets[i].output_dim.x == size.x &&
+		if (!presets[i].upscale_probe &&
+		    presets[i].output_dim.x == size.x &&
 		    presets[i].output_dim.y == size.y)
 			return num;
 
@@ -598,6 +639,8 @@ bool apple_isp_wide_view(struct apple_isp *isp)
 bool apple_isp_preset_offered(struct apple_isp *isp,
 			      const struct isp_preset *preset)
 {
+	if (preset->upscale_probe)
+		return READ_ONCE(isp->upscale_probe);
 	return !preset->wide_only || apple_isp_wide_view(isp);
 }
 
@@ -623,6 +666,15 @@ static const struct coord isp_wide_sizes[] = {
 	{ 2560, 1440 }, { 1760, 1328 }, { 1552, 1552 },
 };
 
+/*
+ * macOS's two portrait sizes for this camera. Every window above has fewer
+ * rows than they do, so they are listed only with debugfs upscale_probe, cut
+ * for the scaler to enlarge, to find out whether it does.
+ */
+static const struct coord isp_upscale_sizes[] = {
+	{ 1328, 1760 }, { 1080, 1920 },
+};
+
 int apple_isp_add_wide_presets(struct apple_isp *isp)
 {
 	struct isp_preset *presets, cut;
@@ -637,7 +689,8 @@ int apple_isp_add_wide_presets(struct apple_isp *isp)
 	if (!narrow)
 		return 0;
 
-	presets = devm_kcalloc(isp->dev, num + ARRAY_SIZE(isp_wide_sizes),
+	presets = devm_kcalloc(isp->dev, num + ARRAY_SIZE(isp_wide_sizes) +
+			       ARRAY_SIZE(isp_upscale_sizes),
 			       sizeof(*presets), GFP_KERNEL);
 	if (!presets)
 		return -ENOMEM;
@@ -655,11 +708,34 @@ int apple_isp_add_wide_presets(struct apple_isp *isp)
 		presets[n].wide_only = true;
 		n++;
 	}
+	for (unsigned int k = 0; k < ARRAY_SIZE(isp_upscale_sizes); k++) {
+		bool have = false;
+
+		for (unsigned int i = 0; i < n; i++)
+			have |= presets[i].output_dim.x == isp_upscale_sizes[k].x &&
+				presets[i].output_dim.y == isp_upscale_sizes[k].y;
+		if (have || !isp_size_upscaled(&isp_wide_source,
+					       isp_upscale_sizes[k], &cut))
+			continue;
+		presets[n] = cut;
+		presets[n].wide_only = true;
+		n++;
+	}
 	isp->presets = presets;
 	isp->num_presets = n;
 	return 0;
 }
 
+/* A wide stream's crop from the selected window; a probe size is enlarged. */
+static bool isp_cut_wide(const struct isp_preset *preset,
+			 struct isp_preset *wide)
+{
+	if (preset->upscale_probe)
+		return isp_size_upscaled(isp_wide_window(), preset->output_dim,
+					 wide);
+	return isp_size_from_crop(isp_wide_window(), preset->output_dim, wide);
+}
+
 /* The preset a stream starts with; with the wide view, from config 6. */
 static void isp_resolve_stream_preset(struct apple_isp *isp,
 				      const struct isp_preset *preset)
@@ -687,7 +763,7 @@ static void isp_resolve_stream_preset(struct apple_isp *isp,
 	isp->stream_preset = *preset;
 	if (((apple_isp_wide_view(isp) && isp_preset_narrow(preset)) ||
 	     preset->wide_only) &&
-	    isp_size_from_crop(isp_wide_window(), preset->output_dim, &wide)) {
+	    isp_cut_wide(preset, &wide)) {
 		isp->stream_preset = wide;
 		use_wide = true;
 	}
@@ -704,6 +780,16 @@ static void isp_resolve_stream_preset(struct apple_isp *isp,
 			 isp->stream_preset.crop_offset.y,
 			 isp->stream_preset.crop_size.x,
 			 isp->stream_preset.crop_size.y);
+	if (isp->stream_preset.upscale_probe)
+		dev_info(isp->dev,
+			 "upscale probe: %ux%u from sensor config %u, crop %u,%u %ux%u\n",
+			 isp->stream_preset.output_dim.x,
+			 isp->stream_preset.output_dim.y,
+			 isp->stream_preset.index,
+			 isp->stream_preset.crop_offset.x,
+			 isp->stream_preset.crop_offset.y,
+			 isp->stream_preset.crop_size.x,
+			 isp->stream_preset.crop_size.y);
 	isp->streamed_wide = use_wide;
 	isp->streamed_crop_x = use_wide ? isp->stream_preset.crop_offset.x : 0;
 }
