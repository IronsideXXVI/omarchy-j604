From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 17:26:52 +0000
Subject: [PATCH] media: apple: avd: HEVC test switch for the 10-bit
 packed-format scratch

10-bit HEVC decodes at 80 % of macOS on the same silicon, and the cost is
the 16-bit output write. Every HEVC picture header has a packed-format
scratch address, which the driver leaves at 0. Give it a test switch,
default off: hevc_fmt_scratch_kib allocates a scratch buffer of that size
per bank when the stream starts, and 10-bit pictures point the engine at
it. 8-bit pictures and the default are unchanged.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/media/platform/apple/avd/avd-hevc.c | 24 ++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/apple/avd/avd-hevc.c b/drivers/media/platform/apple/avd/avd-hevc.c
index accabe2c64..5fdea31a90 100644
--- a/drivers/media/platform/apple/avd/avd-hevc.c
+++ b/drivers/media/platform/apple/avd/avd-hevc.c
@@ -56,6 +56,17 @@ module_param(hevc_out_hdr58, uint, 0644);
 MODULE_PARM_DESC(hevc_out_hdr58,
 		 "Test only: 10-bit HEVC picture header word 0x58 (default 0)");
 
+/*
+ * Test switch (default 0): every 10-bit HEVC picture header carries a
+ * "packed format scratch" address, which we leave at 0. With a size in KiB
+ * each bank gets a scratch buffer of that size (set before the stream
+ * starts) and 10-bit pictures point the engine at it.
+ */
+static unsigned int hevc_fmt_scratch_kib;
+module_param(hevc_fmt_scratch_kib, uint, 0644);
+MODULE_PARM_DESC(hevc_fmt_scratch_kib,
+		 "Test only: KiB of packed-format scratch per bank for 10-bit HEVC (default 0 = none)");
+
 static unsigned int hevc_out_dma;
 module_param(hevc_out_dma, uint, 0644);
 MODULE_PARM_DESC(hevc_out_dma,
@@ -146,6 +157,8 @@ struct avd_hevc_bank {
 		struct avd_buf lf_left_info;
 		struct avd_buf sw_left;
 		struct avd_buf pipe_state;
+		/* hevc_fmt_scratch_kib: packed-format scratch, 10-bit only */
+		struct avd_buf fmt_scratch;
 	} bufs;
 };
 
@@ -459,7 +472,8 @@ static void set_header(struct avd_ctx *ctx, struct avd_hevc_run *run)
 
 	push_comp(ctx, run->base.comp_out, ctx->comp.offsets);
 
-	pusha((u64)0, "packed_fmt_scratch", 0);
+	pusha(ten_bit ? (u64)hevc_ctx->b->bufs.fmt_scratch.addr : (u64)0,
+	      "packed_fmt_scratch", 0);
 
 	bytesperline = ctx->decoded_fmt.fmt.pix_mp.plane_fmt[0].bytesperline;
 	if (avd->variant->quirks & AVD_QUIRK_LSR)
@@ -1147,6 +1161,13 @@ static int avd_hevc_alloc_bufs(struct avd_ctx *ctx, struct avd_hevc_bank *bank)
 	if (ret)
 		return ret;
 
+	if (READ_ONCE(hevc_fmt_scratch_kib)) {
+		ret = avd_buf_alloc(avd, &bank->bufs.fmt_scratch,
+				    (size_t)min(READ_ONCE(hevc_fmt_scratch_kib), 65536u) * 1024);
+		if (ret)
+			return ret;
+	}
+
 	return 0;
 }
 
@@ -1173,6 +1194,7 @@ static void avd_hevc_stop(struct avd_ctx *ctx)
 		avd_buf_free(avd, &bufs->lf_left);
 		avd_buf_free(avd, &bufs->lf_left_info);
 		avd_buf_free(avd, &bufs->sw_left);
+		avd_buf_free(avd, &bufs->fmt_scratch);
 	}
 
 	kfree(hevc_ctx);
-- 
