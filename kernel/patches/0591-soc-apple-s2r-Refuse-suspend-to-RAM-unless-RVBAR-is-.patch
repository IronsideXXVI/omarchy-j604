From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 05:32:58 +0000
Subject: [PATCH] soc: apple: s2r: Refuse suspend-to-RAM unless RVBAR is the
 verified vector

A core leaves suspend-to-RAM through a warm reset into its RVBAR. If that
address does not hold the boot firmware's warm boot path, arming the
mailbox and sleeping ends in a reset into whatever is there. On the J604
the RVBAR is locked by m1n1 stage 1 before the chainloaded stage 2 runs,
and one read-only probe found the locked RVBAR inside reserved memory on
one boot while the memory layout moved between boots. Whether it holds
our m1n1 on every boot is not proven yet.

m1n1 now publishes the mailbox only when every core's RVBAR is locked to
its own vector, and names that vector in /chosen/asahi,s2r-reset-vector.
Use it on the kernel side too:

- at probe, require asahi,s2r-reset-vector next to the mailbox, map each
  CPU's RVBAR from apple,cpu-impl-reg (owned by the CPU code, so not
  claimed) and require every online core to be locked to that vector;
- in ->enter(), before anything is changed, check the live RVBAR of the
  core that is about to sleep again. Offline cores are not read, since
  their cluster may be powered down.

On a mismatch suspend-to-RAM is not offered (probe) or the suspend fails
with -EIO and the system stays up (enter). Without a mailbox, the
firmware-less bring-up mode is unchanged: it never lets the SoC sleep.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/soc/apple/apple-s2r.c | 118 +++++++++++++++++++++++++++++++++-
 1 file changed, 116 insertions(+), 2 deletions(-)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 2cde5a1cb5..48d08209c7 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -51,6 +51,7 @@
 #include <linux/bitfield.h>
 #include <linux/bits.h>
 #include <linux/cacheflush.h>
+#include <linux/cpu.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
 #include <linux/mfd/syscon.h>
@@ -109,6 +110,14 @@ static const u16 clkgen_regs[] = { 0x160, 0x168, 0x164, 0x158, 0x16c };
 #define WDT_CLK_HZ		24000000
 #define WDT_MAX_TIMEOUT		(U32_MAX / WDT_CLK_HZ)
 
+/*
+ * Per-core implementation registers ("apple,cpu-impl-reg"): the RVBAR a core
+ * resets into, the warm boot path included. The CPU code owns them; they are
+ * only read here.
+ */
+#define IMPL_RVBAR_LOCK		BIT_ULL(0)
+#define IMPL_RVBAR_ADDR		GENMASK_ULL(47, 12)
+
 /* Warm boot mailbox published by the boot firmware */
 struct apple_s2r_mailbox {
 	__le64 magic;
@@ -185,6 +194,9 @@ struct apple_s2r {
 	void __iomem *timer;
 	void __iomem *wdt;
 	struct apple_s2r_mailbox *mailbox;
+	/* The vector the boot firmware verified, and every core's RVBAR */
+	u64 reset_vector;
+	void __iomem **rvbar;
 
 	u32 cpu_clusters[S2R_MAX_CLUSTERS];
 	u32 cpu_cluster_saved[S2R_MAX_CLUSTERS];
@@ -380,6 +392,27 @@ static int apple_s2r_finish(unsigned long arg)
  * Record the step before running it: its restore undoes partial progress.
  * abort_before stops at the step without running it.
  */
+/*
+ * A core resets into its RVBAR, also on the way out of suspend-to-RAM. The
+ * boot firmware publishes the mailbox only after it found every core's RVBAR
+ * locked to its own warm boot vector, and names that vector. If the live
+ * RVBAR of @cpu is not locked to that vector, the warm reset would run
+ * something else: refuse.
+ */
+static int apple_s2r_check_rvbar(struct apple_s2r *s2r, unsigned int cpu)
+{
+	u64 val = readq(s2r->rvbar[cpu]);
+
+	if ((val & IMPL_RVBAR_LOCK) &&
+	    (val & IMPL_RVBAR_ADDR) == s2r->reset_vector)
+		return 0;
+
+	dev_err(s2r->dev, "CPU%u RVBAR is %#llx%s, not the verified reset vector %#llx\n",
+		cpu, val & IMPL_RVBAR_ADDR,
+		val & IMPL_RVBAR_LOCK ? "" : " (unlocked)", s2r->reset_vector);
+	return -EIO;
+}
+
 static int apple_s2r_check(struct apple_s2r *s2r, enum apple_s2r_step step)
 {
 	s2r->failed_step = step;
@@ -423,6 +456,15 @@ static int apple_s2r_enter(suspend_state_t state)
 
 		if (!ab || ab > S2R_STEP_CLKGEN)
 			return -EOPNOTSUPP;
+	} else {
+		/*
+		 * The core that sleeps here is the one the SoC wakes on: check
+		 * its live RVBAR before arming. Offline cores are left alone,
+		 * as their clusters may be powered down.
+		 */
+		ret = apple_s2r_check_rvbar(s2r, smp_processor_id());
+		if (ret)
+			return ret;
 	}
 
 	/* No printk from here on: the console may lose its clock */
@@ -583,6 +625,73 @@ static void __iomem *apple_s2r_optional_reg(struct platform_device *pdev,
 	return devm_platform_ioremap_resource_byname(pdev, name);
 }
 
+static void apple_s2r_unmap_rvbars(void *data)
+{
+	struct apple_s2r *s2r = data;
+	unsigned int cpu;
+
+	for_each_possible_cpu(cpu)
+		if (s2r->rvbar[cpu])
+			iounmap(s2r->rvbar[cpu]);
+}
+
+/*
+ * Map every core's RVBAR (the CPU code owns the registers: no claim) and take
+ * the reset vector the boot firmware verified. Every online core must already
+ * be locked to it; offline cores are checked by the boot firmware only.
+ */
+static int apple_s2r_verify_reset_vector(struct apple_s2r *s2r)
+{
+	struct device *dev = s2r->dev;
+	unsigned int cpu;
+	int ret;
+
+	if (of_property_read_u64(of_chosen, "asahi,s2r-reset-vector",
+				 &s2r->reset_vector))
+		return dev_err_probe(dev, -ENODEV,
+				     "boot firmware did not verify its warm boot reset vector\n");
+	if (!s2r->reset_vector || (s2r->reset_vector & ~IMPL_RVBAR_ADDR))
+		return dev_err_probe(dev, -EINVAL, "invalid reset vector %#llx\n",
+				     s2r->reset_vector);
+
+	s2r->rvbar = devm_kcalloc(dev, nr_cpu_ids, sizeof(*s2r->rvbar),
+				  GFP_KERNEL);
+	if (!s2r->rvbar)
+		return -ENOMEM;
+	ret = devm_add_action_or_reset(dev, apple_s2r_unmap_rvbars, s2r);
+	if (ret)
+		return ret;
+
+	for_each_possible_cpu(cpu) {
+		struct device_node *np = of_get_cpu_node(cpu, NULL);
+		u64 impl;
+
+		ret = np ? of_property_read_u64(np, "apple,cpu-impl-reg", &impl) :
+			   -ENODEV;
+		of_node_put(np);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "CPU%u has no apple,cpu-impl-reg\n", cpu);
+		s2r->rvbar[cpu] = ioremap_np(impl, sizeof(u64));
+		if (!s2r->rvbar[cpu])
+			return -ENOMEM;
+	}
+
+	cpus_read_lock();
+	for_each_online_cpu(cpu) {
+		ret = apple_s2r_check_rvbar(s2r, cpu);
+		if (ret)
+			break;
+	}
+	cpus_read_unlock();
+
+	if (ret)
+		return dev_err_probe(dev, -ENODEV,
+				     "warm boot would not reset into the verified vector\n");
+
+	return 0;
+}
+
 /* The watchdog driver owns the registers: map them without claiming them */
 static int apple_s2r_map_wdt(struct apple_s2r *s2r)
 {
@@ -639,6 +748,10 @@ static int apple_s2r_probe(struct platform_device *pdev)
 		if (IS_ERR(s2r->mailbox))
 			return dev_err_probe(dev, PTR_ERR(s2r->mailbox),
 					     "failed to map the warm boot mailbox\n");
+
+		ret = apple_s2r_verify_reset_vector(s2r);
+		if (ret)
+			return ret;
 	}
 
 	/*
@@ -711,8 +824,9 @@ static int apple_s2r_probe(struct platform_device *pdev)
 	suspend_set_ops(&apple_s2r_ops);
 
 	if (s2r->mailbox)
-		dev_info(dev, "suspend-to-RAM available (mailbox at %#llx)%s\n",
-			 mailbox, s2r->timer ? "" : ", without clock/PLL/timer steps");
+		dev_info(dev, "suspend-to-RAM available (mailbox at %#llx, reset vector %#llx)%s\n",
+			 mailbox, s2r->reset_vector,
+			 s2r->timer ? "" : ", without clock/PLL/timer steps");
 	else
 		dev_warn(dev, "bring-up only: no warm boot mailbox, suspend-to-RAM runs only with abort_before 1-%d\n",
 			 S2R_STEP_CLKGEN);
