From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 06:13:29 +0000
Subject: [PATCH] drm/asahi: g16: add g16_pb_probe to read what the
 firmware does to a PB manager

The parameter buffer is sized from a fixed heap per render unit. Sizing it
by use, as the macOS driver does (it grows the buffer before a submission
to three times the blocks in use and shrinks it when idle), needs to know
how many blocks a render takes and where the firmware reports it.

With g16_pb_probe=1 the driver reads, at each render retirement, the
words of the bound PB manager and of its counter record and notes which
of them differ from what was seeded, and while renders are in flight it
reads the two words of the manager's free-block ring and keeps the
widest distance seen. The stats file shows these on its pb_probe lines.

The probe only reads the firmware's records; nothing is written. The
manager image the driver seeds is kept with the manager for the
comparison. The default of 0 reads nothing.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 19 +++++++
 drivers/gpu/drm/asahi/g16/poll.rs   | 31 +++++++++++
 drivers/gpu/drm/asahi/g16/pools.rs  | 85 ++++++++++++++++++++++++-----
 3 files changed, 121 insertions(+), 14 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 059ba84028..e7afab2cdd 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2485,6 +2485,25 @@ pub(crate) fn pb_reuse() -> bool {
     "G16: let a render command reuse the PB manager its pass slot still leases from a fully retired command of the same VM, without a new InitBM (default 1; 0 = a fresh manager and InitBM for every command; runtime 0644)"
 );
 
+/// Storage of `g16_pb_probe` (runtime 0644, default 0).
+static PB_PROBE: AtomicU32 = AtomicU32::new(0);
+
+/// Read-only PB manager probe: at each render retirement, the manager and counter words the
+/// firmware changed from their seed; while renders are in flight, the free-block ring words.
+/// Measurement only: nothing is written to the firmware's records.
+pub(crate) fn pb_probe() -> bool {
+    PB_PROBE.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    PB_PROBE_PARAM,
+    PB_PROBE_PARMTYPE,
+    PB_PROBE_PARM,
+    PB_PROBE,
+    "g16_pb_probe",
+    "G16: read the PB manager and counter words at each render retirement and the free-block ring words while renders run, into the stats file; reads only (default 0; runtime 0644)"
+);
+
 /// Storage of `g16_pb_shared` (0644, default 0; latched at its first read).
 static PB_SHARED: AtomicU32 = AtomicU32::new(0);
 /// 0 until latched, then 1 (off) or 2 (on).
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index bceb1a3f83..5ad0ffd79f 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -738,6 +738,13 @@ pub(crate) fn poll(&mut self, evented: bool, done: &mut Completions) -> Result<b
                 return Ok(false);
             }
         }
+        if params::pb_probe() {
+            for f in self.engine.flights.iter().filter(|f| f.renders != 0) {
+                if let Some(epoch) = f.pb_used.as_ref() {
