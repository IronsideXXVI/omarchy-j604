From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 13:02:55 +0000
Subject: [PATCH] drm/asahi: g16: Refuse a sleep that powers the SoC down

With no sleep callbacks, a suspend-to-RAM goes through with the GPU
firmware running, and the firmware is lost with the power: the next
submit after the wake times out. G16 has no firmware stop and warm
restart yet, so refuse such a sleep in .prepare, before any device
suspends, as Aurora does for G15 and G16 (97341ccf96, which brings the
restart to G17 only). Suspend-to-idle is unchanged: the refusal only
applies when pm_suspend_via_firmware() is set.

G17's sequence is not taken: it runs two firmware instances and the
G17 bridge and gating words, none of which G16 has in this driver.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/gpu/drm/asahi/driver.rs  | 26 ++++++++++++++++++++++++++
 drivers/gpu/drm/asahi/g16/mod.rs |  5 +++++
 2 files changed, 31 insertions(+)

diff --git a/drivers/gpu/drm/asahi/driver.rs b/drivers/gpu/drm/asahi/driver.rs
index f22e1eff9c..fa55614f51 100644
--- a/drivers/gpu/drm/asahi/driver.rs
+++ b/drivers/gpu/drm/asahi/driver.rs
@@ -223,6 +223,32 @@ kernel::of_device_table!(
     ]
 );
 
+struct SleepOps(bindings::dev_pm_ops);
+
+// SAFETY: Immutable: the callbacks are plain functions.
+unsafe impl Sync for SleepOps {}
+
+/// For a driver with no firmware restart: a sleep that powers the SoC down would lose its firmware.
+unsafe extern "C" fn sleep_refuse(_dev: *mut bindings::device) -> core::ffi::c_int {
+    // SAFETY: Reads a global flag word.
+    if unsafe { bindings::pm_suspend_via_firmware() } {
+        EBUSY.to_errno()
+    } else {
+        0
+    }
+}
+
+static SLEEP_REFUSE_OPS: SleepOps = SleepOps(bindings::dev_pm_ops {
+    prepare: Some(sleep_refuse),
+    // SAFETY: All-zero is the absence of every other callback.
+    ..unsafe { core::mem::zeroed() }
+});
+
+/// The callbacks of a driver that refuses a sleep that powers the SoC down.
+pub(crate) fn sleep_refuse_ops() -> Option<&'static bindings::dev_pm_ops> {
+    Some(&SLEEP_REFUSE_OPS.0)
+}
+
 /// Platform Driver implementation for `AsahiDriver`.
 impl platform::Driver for AsahiPlatformDriver {
     type IdInfo = ProbeConfig;
diff --git a/drivers/gpu/drm/asahi/g16/mod.rs b/drivers/gpu/drm/asahi/g16/mod.rs
index c5f6362b5d..3cd72728f1 100644
--- a/drivers/gpu/drm/asahi/g16/mod.rs
+++ b/drivers/gpu/drm/asahi/g16/mod.rs
@@ -152,6 +152,11 @@ impl platform::Driver for Driver {
         true
     }
 
+    /// Nor restarted after a sleep that powers the SoC down: refuse that sleep.
+    fn pm_ops() -> Option<&'static kernel::bindings::dev_pm_ops> {
+        crate::driver::sleep_refuse_ops()
+    }
+
     fn probe<'bound>(
         pdev: &'bound platform::Device<Core<'_>>,
         info: Option<&'bound Self::IdInfo>,
