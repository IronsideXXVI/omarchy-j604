+/**
+ * apple_sleep_apcie_port_up() - a root port of ANS's APCIe block is trained again
+ * @port: the root port's number (its "portN" window)
+ *
+ * For the PCIe host, after it restarted that port following a T8132 sleep.
+ * Until then a later sleep leaves the port alone: its registers would abort.
+ */
+void apple_sleep_apcie_port_up(unsigned int port)
+{
+	if (apple_s2r && port < APCIE_MAX_PORTS)
+		WRITE_ONCE(apple_s2r->t8132.apcie_ports[port].down, false);
+}
+EXPORT_SYMBOL_GPL(apple_sleep_apcie_port_up);
+
+/* The radio's port, port 0: the name Aurora's pcie-apple calls. */
+void apple_sleep_radio_port_up(void)
+{
+	apple_sleep_apcie_port_up(0);
+}
+EXPORT_SYMBOL_GPL(apple_sleep_radio_port_up);
+
+static void __iomem *apple_s2r_t8132_apcie_block(struct apple_s2r *s2r, struct device_node *np,
+						 const char *name, const char *prop,
+						 struct apple_tunable **tun)
+{
+	int idx = of_property_match_string(np, "reg-names", name);
+	struct resource res;
+
+	if (idx < 0)
+		return NULL;
+	if (prop) {
+		struct apple_tunable *t;
+
+		if (of_address_to_resource(np, idx, &res))
+			return NULL;
+		t = devm_apple_tunable_parse(s2r->dev, np, prop, &res);
+		if (IS_ERR(t))
+			return NULL;
+		*tun = t;
+	}
+
+	return of_iomap(np, idx);
+}
+
+/*
+ * The block's registers go with the PCIe host's node (apple,apcie), whose
+ * loader publishes the tables there. Missing ones only keep the refusal of a
+ * real sleep with ANS stopped.
+ */
+static void apple_s2r_t8132_map_apcie(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	struct device_node *np = of_parse_phandle(s2r->dev->of_node, "apple,apcie", 0);
+	struct device_node *pins = of_parse_phandle(s2r->dev->of_node, "apple,pinctrl", 0);
+	struct device_node *child;
+	char name[8];
+	int i;
+
+	for (i = 0; i < APCIE_MAX_PORTS; i++)
+		t->apcie_ports[i].perst = -1;
+	if (!np)
+		goto out;
+
+	t->apcie_axi = apple_s2r_t8132_apcie_block(s2r, np, "axi2af", "apple,tunable-axi2af",
+						   &t->apcie_axi_tunable);
+	t->apcie_cio3pll = apple_s2r_t8132_apcie_block(s2r, np, "cio3pll", "apple,tunable-cio3pll",
+						       &t->apcie_cio3pll_tunable);
+	t->apcie_clkgen = apple_s2r_t8132_apcie_block(s2r, np, "clkgen", "apple,tunable-clkgen",
+						      &t->apcie_clkgen_tunable);
+	t->apcie_phy = apple_s2r_t8132_apcie_block(s2r, np, "phy-block", "apple,tunable-phy",
+						   &t->apcie_phy_tunable);
+	t->apcie_phy_ip = apple_s2r_t8132_apcie_block(s2r, np, "phy-ip", "apple,tunable-phy-ip-pll",
+						      &t->apcie_phy_ip_pll);
+	t->apcie_rc = apple_s2r_t8132_apcie_block(s2r, np, "rc", NULL, NULL);
+	if (t->apcie_phy_ip) {
+		int idx = of_property_match_string(np, "reg-names", "phy-ip");
+		struct apple_tunable *tun;
+		struct resource res;
+
+		if (idx >= 0 && !of_address_to_resource(np, idx, &res)) {
+			tun = devm_apple_tunable_parse(s2r->dev, np, "apple,tunable-phy-ip-auspma",
+						       &res);
+			if (!IS_ERR(tun))
+				t->apcie_phy_ip_lanes = tun;
+		}
+	}
+	t->apcie_ok = t->apcie_axi && t->apcie_cio3pll && t->apcie_clkgen && t->apcie_phy &&
+		      t->apcie_phy_ip && t->apcie_rc && t->apcie_axi_tunable &&
+		      t->apcie_cio3pll_tunable && t->apcie_clkgen_tunable && t->apcie_phy_tunable &&
+		      t->apcie_phy_ip_pll && t->apcie_phy_ip_lanes;
+
+	for (i = 0; i < APCIE_MAX_PORTS; i++) {
+		snprintf(name, sizeof(name), "port%d", i);
+		t->apcie_ports[i].port = apple_s2r_t8132_apcie_block(s2r, np, name, NULL, NULL);
+		snprintf(name, sizeof(name), "phy%d", i);
+		t->apcie_ports[i].phy = apple_s2r_t8132_apcie_block(s2r, np, name, NULL, NULL);
+	}
+
+	/* Each port's PERST#, on the AP pins, from its child node's reset-gpios. */
+	for_each_available_child_of_node(np, child) {
+		struct of_phandle_args args;
+		u32 reg[5];
+		int port;
+
+		if (of_property_read_u32_array(child, "reg", reg, 5))
+			continue;
+		port = (reg[0] >> 11) & 0x1f;
+		if (port >= APCIE_MAX_PORTS ||
+		    of_parse_phandle_with_args(child, "reset-gpios", "#gpio-cells", 0, &args))
+			continue;
+		if (pins && args.np == pins && args.args_count >= 2 && args.args[0] < s2r->npins &&
+		    s2r->pins_skip && !test_bit(args.args[0], s2r->pins_skip)) {
+			t->apcie_ports[port].perst = args.args[0];
+			t->apcie_ports[port].perst_low = args.args[1] & GPIO_ACTIVE_LOW;
+		}
+		of_node_put(args.np);
+	}
+	dev_info(s2r->dev, "T8132 sequence: ANS's APCIe block %s\n",
+		 t->apcie_ok ? "can be lowered and raised (tables from the boot loader)" :
+		 "has no complete tables: a real sleep with ANS stopped is refused");
+out:
+	of_node_put(pins);
+	of_node_put(np);
+}
