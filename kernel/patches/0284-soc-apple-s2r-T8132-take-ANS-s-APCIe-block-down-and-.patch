From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 01:11:48 +0000
Subject: [PATCH] soc: apple: s2r: T8132: take ANS's APCIe block down
 and back up

ANS's NAND link runs on the APCIe block, and a T8132 sleep takes that
block's power. Until now the T8132 sequence refused every real sleep with
ANS or the block on. With the loader now publishing the block's tables
from the machine's own ADT (m1n1's port of aura#112), take it down at the
commit and bring it back on the wake, as macOS does:

 - At the commit, after ATC0 and only when ANS's driver stopped it: every
   root port of the block set up by the loader or its host is stopped
   (link interrupts, L2, PERST# on the AP pin, PHY link, PERST guard,
   PHY enables and clocks), then the PHY, the PHY_SW domain, the clock
   generator, the SYS_ST and ST domains, the AXI enables with SYS_GP
   read on, GP and ANS.
 - On the wake, right after WD2 is set for the resume and before any
   driver runs: the domains, the AXI enables, the six host tables
   (axi2af, cio3pll, clkgen, phy, phy-ip PLL and lanes), the clock
   generator's start, the PHY clocks and run bits and the root complex's
   ready handshake. The ports stay down until their host trains them;
   apple_sleep_apcie_port_up(port) is the hook for that, and
   apple_sleep_radio_port_up() its port 0 form, as named by Aurora's
   pcie-apple.

ANS registers with apple_sleep_coproc_register(pcie_ans = true), which
this driver refused so far; it is accepted with t8132_sequence. Its last
check (the NVMe shutdown notice) and its stop never run in a run that
aborts on purpose, like every other coprocessor stop.

The refusal of a real sleep now follows Aurora's: refused if ANS was
idled by its driver but a table is missing, or if ANS or the block is on
with no driver to stop it. The display CPU check stays as a safety; all
three read off at ->enter on the J604 (MEASURED).

The order, values and steps follow Aurora's drivers/soc/apple/sleep.c in
aurora-silicon/linux#1314: sleep_apcie_port_stop(),
sleep_apcie_port_stop_once(), sleep_apcie_phy_off(),
sleep_apcie_clk_off(), apple_sleep_lower_apcie(),
sleep_apcie_phy_ip_apply(), apple_sleep_raise_apcie(),
apple_sleep_map_apcie(), apple_sleep_find_radio_perst() and the refusal
in apple_sleep_refuse(), from Diljit Singh's 9d13f7b130 ("t8140-sleep:
take ANS's PCIe block down and back up") and Bartosz Nitka's T8132 work.
Differences: the J604's block has two root ports, the radio's and the SD
reader's, and both are stopped; no PIODMA engine is stopped, as the J604
device tree names none. Proven on the J604 only by a real sleep.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/apple-s2r.c   | 566 +++++++++++++++++++++++++++++++-
 include/linux/soc/apple/sleep.h |   5 +
 2 files changed, 563 insertions(+), 8 deletions(-)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 6929f9343d..1e3a254bd2 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -103,10 +103,13 @@
 #include <linux/sched/task_stack.h>
 #include <linux/seq_file.h>
 #include <linux/soc/apple/sleep.h>
+#include <linux/soc/apple/tunable.h>
 #include <linux/spmi.h>
 #include <linux/suspend.h>
 #include <linux/syscore_ops.h>
 
+#include <dt-bindings/gpio/gpio.h>
+
 #include <asm/apple_cpu.h>
 #include <asm/memory.h>
 #include <asm/sections.h>
@@ -206,6 +209,64 @@
 
 #define SYS_APL_SIQ_CFG_EL1		sys_reg(3, 4, 15, 10, 4)
 
+/*
+ * ANS's APCIe block (T8132 sequence): the part of the PCIe block ANS shares,
+ * whether or not its host is bound. Offsets and bits SOURCE: Aurora's
+ * drivers/soc/apple/sleep.c (aurora-silicon/linux#1314).
+ */
+#define T8132_PS_GPIO			0x120
+#define T8132_PS_APCIE_GP		0x4d0
+#define T8132_PS_APCIE_ST		0x540
+#define T8132_PS_APCIE_SYS_ST		0x548
+#define T8132_PS_APCIE_PHY_SW		0x550
+#define APCIE_AXI_EN0			0x104
+#define APCIE_AXI_EN1			0x108
+#define APCIE_CLK_CTRL			0x0
+#define APCIE_CLK_BUSY			BIT(31)
+#define APCIE_CLK_RUN			BIT(5)
+#define APCIE_CLK_OFF			BIT(1)
+#define APCIE_CLK_OFF2			BIT(2)
+#define APCIE_CLK_START			0x4
+#define APCIE_CLK_START_GO		BIT(31)
+#define APCIE_PHY_COMMON		0x4000
+#define APCIE_PHY_CTRL			0x8000
+#define APCIE_PHY_CTRL_CLK0REQ		BIT(0)
+#define APCIE_PHY_CTRL_CLK1REQ		BIT(1)
+#define APCIE_PHY_CTRL_CLK0ACK		BIT(2)
+#define APCIE_PHY_CTRL_CLK1ACK		BIT(3)
+#define APCIE_PHY_CTRL_RESET		BIT(4)
+#define APCIE_PHY_CTRL_UP		BIT(27)
+#define APCIE_PHY_RUN			0x8004
+#define APCIE_PHY_RUN_EN		BIT(0)
+#define APCIE_PHY_RUN_EN2		BIT(4)
+#define APCIE_PHY_READY			0x8008
+#define APCIE_PHY_IP_PLL_CTL		0x90
+#define APCIE_PHY_IP_PLL_HOLD		BIT(16)
+#define APCIE_PORT_INTSTAT		0x100
+#define APCIE_PORT_INTMSK		0x104
+#define APCIE_PORT_INT_LINK		GENMASK(7, 4)
+#define APCIE_PORT_L2			0x88
+#define APCIE_PORT_L2_ENTER		0x11
+#define APCIE_PORT_L2_BUSY		BIT(0)
+#define APCIE_PORT_PERST_GUARD		0x13c
+#define APCIE_PORT_LINKSTS		0x208
+#define APCIE_PORT_LINKSTS_UP		BIT(0)
+#define APCIE_PORT_APPCLK		0x800
+#define APCIE_PORT_APPCLK_EN		BIT(0)
+#define APCIE_PORT_APPCLK_CGDIS		BIT(8)
+#define APCIE_PORT_PERST		0x82c
+#define APCIE_PORT_PHY_LINK		BIT(31)
+#define APCIE_PORT_PHY_EN0		BIT(9)
+#define APCIE_PORT_PHY_EN1		BIT(10)
+#define APCIE_PORT_STOP_US		5000
+#define APCIE_RC_ZERO			0x04
+#define APCIE_RC_READY_START		0x50
+#define APCIE_RC_READY_CFG		0x54
+#define APCIE_RC_READY_STAT		0x58
+#define APCIE_POLL_US			50000
+/* Root ports of the block: port0 (the radio) and port2 (the SD reader) on the J604 */
+#define APCIE_MAX_PORTS			4
+
 /* Every power word of the ADT, PMGR then PMGR AON */
 static const u32 t8132_ps_all[] = {
 	0x0, 0x8, 0x10, 0x18, 0x20, 0x28, 0x30, 0x38, 0x40, 0x48,
@@ -346,6 +407,33 @@ struct apple_s2r_t8132 {
 	bool pg_changed;
 	bool pg_read;
 
+	/* ANS's APCIe block, from the apple,apcie host node and its loader-published tables */
+	void __iomem *apcie_axi;
+	void __iomem *apcie_cio3pll;
+	void __iomem *apcie_clkgen;
+	void __iomem *apcie_phy;
+	void __iomem *apcie_phy_ip;
+	void __iomem *apcie_rc;
+	struct apple_tunable *apcie_axi_tunable;
+	struct apple_tunable *apcie_cio3pll_tunable;
+	struct apple_tunable *apcie_clkgen_tunable;
+	struct apple_tunable *apcie_phy_tunable;
+	struct apple_tunable *apcie_phy_ip_pll;
+	struct apple_tunable *apcie_phy_ip_lanes;
+	/* Every block mapped and all six tables parsed: the block can come back */
+	bool apcie_ok;
+	struct {
+		void __iomem *port;
+		void __iomem *phy;
+		int perst;
+		bool perst_low;
+		bool stopped;
+		bool down;
+	} apcie_ports[APCIE_MAX_PORTS];
+	bool pcie_ans_stopped;
+	int ans_off_ret;
+	int pcie_ans_on_ret;
+
 	/* PMU boot stage byte: macOS's sleep value is written at the match */
 	bool pmu_written;
 	bool pmu_orig_ok;
@@ -551,6 +639,7 @@ struct apple_s2r {
 static struct apple_s2r *apple_s2r;
 
 #define PIN_REG(n)		(4 * (n))
+#define PIN_DATA		BIT(0)
 #define PIN_LOCK		BIT(21)
 #define PIN_CTL			0xc48
 #define PIN_IRQ(g, w)		(0x800 + 0x40 * (g) + 4 * (w))
@@ -626,10 +715,15 @@ static struct apple_s2r_coproc {
 	bool stopped;
 	/* Stopped before the others; its last stop clears its own run bits */
 	bool first;
+	/* ANS: its link runs on the APCIe block the T8132 sequence lowers and raises */
+	bool pcie_ans;
 	u32 status;
 } apple_s2r_coprocs[S2R_COPROCS];
 static DEFINE_MUTEX(apple_s2r_coprocs_lock);
 
+static bool t8132_sequence;
+static uint abort_before;
+
 /* The enclave's sleep request, the very last refusal */
 static struct {
 	struct device *dev;
@@ -655,7 +749,8 @@ int apple_sleep_coproc_register(struct device *dev, void __iomem *asc, bool pcie
 	/* The warm boot path comes back at EL2 only (probe) */
 	if (!is_kernel_in_hyp_mode())
 		return -ENODEV;
-	if (pcie_ans)
+	/* Only the T8132 sequence takes ANS's APCIe block down and back up. */
+	if (pcie_ans && !t8132_sequence)
 		return -EOPNOTSUPP;
 
 	guard(mutex)(&apple_s2r_coprocs_lock);
@@ -669,6 +764,7 @@ int apple_sleep_coproc_register(struct device *dev, void __iomem *asc, bool pcie
 		.last_stop = last_stop,
 		.data = data,
 		.dev = dev,
+		.pcie_ans = pcie_ans,
 	};
 	return 0;
 }
@@ -777,6 +873,12 @@ static int apple_s2r_coprocs_check(struct apple_s2r *s2r, bool tell_enclave)
 
 		if (!c->dev || !c->ready || c->stopped || !c->last_check)
 			continue;
+		/*
+		 * ANS's last check is its shutdown notification: like a stop, never
+		 * in a run that aborts on purpose.
+		 */
+		if (c->pcie_ans && READ_ONCE(abort_before))
+			continue;
 		ret = c->last_check(c->data);
 		if (ret) {
 			dev_err(s2r->dev, "refused: %s: %d\n", dev_name(c->dev), ret);
@@ -1650,6 +1752,403 @@ static void apple_s2r_t8132_set_wd2(struct apple_s2r *s2r, unsigned int secs)
 }
 
 /* The AON domains of ATC0, deepest first, as macOS lowers ATC1's around sleep. */
+/*
+ * ANS's APCIe block across a T8132 sleep. SOURCE: Aurora's sleep.c in
+ * aurora-silicon/linux#1314, by Diljit Singh (9d13f7b130 "take ANS's PCIe
+ * block down and back up") and Bartosz Nitka: sleep_ps_lower_start/_finish(),
+ * sleep_ps_wait_on(), sleep_apcie_port_stop(), sleep_apcie_phy_off(),
+ * sleep_apcie_clk_off(), apple_sleep_lower_apcie(), sleep_apcie_phy_ip_apply()
+ * and apple_sleep_raise_apcie(). The tables are the loader's, published from
+ * this machine's own ADT (m1n1 1.611, aura#112). Ours: every root port of the
+ * block is stopped, not only the radio's (the J604 has the SD reader on it
+ * too), and no PIODMA engine is stopped (the J604 DT names none).
+ */
+static u32 apple_s2r_t8132_ps_lower_start(void __iomem *reg)
+{
+	u32 val = readl(reg);
+
+	if (val & T8132_PS_AUTO_ENABLE) {
+		val &= ~(T8132_PS_AUTO_ENABLE | T8132_PS_FLAGS);
+		writel(val, reg);
+	}
+
+	return val;
+}
+
+static void apple_s2r_t8132_ps_lower_finish(void __iomem *reg, u32 val)
+{
+	writel((val & ~T8132_PS_TARGET) | T8132_PS_FLAGS, reg);
+}
+
+/* A domain the hardware idled under AUTO_ENABLE comes back once that's cleared. */
+static bool apple_s2r_t8132_ps_wait_on(void __iomem *reg, u32 val)
+{
+	if (!FIELD_GET(T8132_PS_TARGET, val))
+		return false;
+
+	return !readl_poll_timeout_atomic(reg, val, FIELD_GET(T8132_PS_ACTUAL, val), 1,
+					  T8132_PS_TIMEOUT_US);
+}
+
+static int apple_s2r_t8132_ps_raise_full(void __iomem *reg)
+{
+	int ret = apple_s2r_t8132_ps_raise_start(reg);
+
+	writel((readl(reg) & ~(T8132_PS_AUTO_ENABLE | GENMASK(11, 0))) | T8132_PS_TARGET |
+	       T8132_PS_AUTO_ENABLE, reg);
+
+	return ret;
+}
+
+static void apple_s2r_t8132_port_stop(struct apple_s2r *s2r, int i)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	void __iomem *port = t->apcie_ports[i].port;
+	void __iomem *phy = t->apcie_ports[i].phy;
+	u32 val;
+
+	writel(readl(port + APCIE_PORT_INTMSK) | APCIE_PORT_INT_LINK, port + APCIE_PORT_INTMSK);
+	writel(APCIE_PORT_INT_LINK, port + APCIE_PORT_INTSTAT);
+
+	writel(readl(port + APCIE_PORT_APPCLK) | APCIE_PORT_APPCLK_CGDIS, port + APCIE_PORT_APPCLK);
+	/* A loader can leave the port ready with the link never trained. */
+	if (readl(port + APCIE_PORT_LINKSTS) & APCIE_PORT_LINKSTS_UP) {
+		writel(APCIE_PORT_L2_ENTER, port + APCIE_PORT_L2);
+		readl_poll_timeout_atomic(port + APCIE_PORT_L2, val, !(val & APCIE_PORT_L2_BUSY),
+					  10, APCIE_PORT_STOP_US);
+	}
+	/* The endpoint keeps its power and firmware, in reset until its host releases it. */
+	if (s2r->pins && t->apcie_ports[i].perst >= 0 &&
+	    apple_s2r_t8132_ps_on(s2r, T8132_PS_GPIO)) {
+		void __iomem *reg = s2r->pins + PIN_REG(t->apcie_ports[i].perst);
+
+		val = readl(reg);
+		writel(t->apcie_ports[i].perst_low ? val & ~PIN_DATA : val | PIN_DATA, reg);
+	}
+	writel(readl(phy) & ~APCIE_PORT_PHY_LINK, phy);
+	/* Interrupts are off here. */
+	mdelay(1);
+
+	/* What this bit does isn't known. macOS sets it around PERST#. */
+	writel(readl(port + APCIE_PORT_PERST_GUARD) | BIT(8), port + APCIE_PORT_PERST_GUARD);
+	writel(0, port + APCIE_PORT_PERST);
+	writel(readl(port + APCIE_PORT_PERST_GUARD) & ~BIT(8), port + APCIE_PORT_PERST_GUARD);
+
+	writel(readl(phy) & ~APCIE_PORT_PHY_EN1, phy);
+	writel(readl(phy) & ~APCIE_PORT_PHY_EN0, phy);
+	writel(readl(phy) | APCIE_PHY_CTRL_RESET, phy);
+	writel(readl(phy) & ~APCIE_PHY_CTRL_CLK0REQ, phy);
+	readl_poll_timeout_atomic(phy, val, !(val & APCIE_PHY_CTRL_CLK0ACK), 1, APCIE_POLL_US);
+	writel(readl(phy) & ~APCIE_PHY_CTRL_CLK1REQ, phy);
+
+	writel(readl(port + APCIE_PORT_APPCLK) & ~APCIE_PORT_APPCLK_EN, port + APCIE_PORT_APPCLK);
+	writel(readl(port + APCIE_PORT_INTSTAT), port + APCIE_PORT_INTSTAT);
+}
+
+/* Only a port set up, by the loader or by its host after a wake: else its registers abort. */
+static void apple_s2r_t8132_ports_stop(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	int i;
+
+	if (!apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_GP) ||
+	    !apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_PHY_SW))
+		return;
+	for (i = 0; i < APCIE_MAX_PORTS; i++) {
+		if (!t->apcie_ports[i].port || !t->apcie_ports[i].phy ||
+		    t->apcie_ports[i].stopped || t->apcie_ports[i].down)
+			continue;
+		t->apcie_ports[i].stopped = true;
+		apple_s2r_t8132_port_stop(s2r, i);
+	}
+}
+
+/* A poll here only paces the steps: the power goes next whatever it reads. */
+static void apple_s2r_t8132_apcie_phy_off(struct apple_s2r_t8132 *t)
+{
+	void __iomem *ctrl = t->apcie_phy + APCIE_PHY_CTRL;
+	void __iomem *run = t->apcie_phy + APCIE_PHY_RUN;
+	u32 val;
+
+	writel(readl(ctrl) | APCIE_PHY_CTRL_RESET, ctrl);
+	writel(readl(ctrl) & ~APCIE_PHY_CTRL_CLK1REQ, ctrl);
+	readl_poll_timeout_atomic(ctrl, val, !(val & APCIE_PHY_CTRL_CLK1ACK), 1, APCIE_POLL_US);
+	writel(readl(ctrl) & ~APCIE_PHY_CTRL_CLK0REQ, ctrl);
+	readl_poll_timeout_atomic(ctrl, val, !(val & APCIE_PHY_CTRL_CLK0ACK), 1, APCIE_POLL_US);
+	writel(readl(ctrl) & ~APCIE_PHY_CTRL_UP, ctrl);
+	writel(readl(run) & ~APCIE_PHY_RUN_EN2, run);
+	writel(readl(run) & ~APCIE_PHY_RUN_EN, run);
+}
+
+static void apple_s2r_t8132_apcie_clk_off(struct apple_s2r_t8132 *t)
+{
+	void __iomem *clk = t->apcie_clkgen + APCIE_CLK_CTRL;
+	u32 val;
+
+	writel(readl(clk) & ~APCIE_CLK_RUN, clk);
+	writel(readl(clk) | APCIE_CLK_OFF, clk);
+	readl_poll_timeout_atomic(clk, val, !(val & APCIE_CLK_BUSY), 1, APCIE_POLL_US);
+	writel(readl(clk) | APCIE_CLK_OFF2, clk);
+}
+
+/*
+ * ANS's own link runs on this block, and macOS takes it down with the domains,
+ * in this order. A block's registers fault with its domain off.
+ */
+static void apple_s2r_t8132_lower_apcie(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	void __iomem *gp = t->ps + T8132_PS_APCIE_SYS_GP;
+	u32 val;
+
+	apple_s2r_t8132_ports_stop(s2r);
+	/* The PHY's registers need both domains on. */
+	if (apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_PHY_SW) &&
+	    apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_SYS_ST))
+		apple_s2r_t8132_apcie_phy_off(t);
+	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_APCIE_PHY_SW);
+
+	if (apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_SYS_ST))
+		apple_s2r_t8132_apcie_clk_off(t);
+	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_APCIE_SYS_ST);
+	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_APCIE_ST);
+
+	/*
+	 * The AXI enables are the block's link into the fabric. macOS reads the
+	 * domain on before clearing them: powered off with them set, the SoC
+	 * latches a PCIe receive link error once the block's last domain goes off.
+	 */
+	val = apple_s2r_t8132_ps_lower_start(gp);
+	if (apple_s2r_t8132_ps_wait_on(gp, val)) {
+		writel(readl(t->apcie_axi + APCIE_AXI_EN0) & ~BIT(0), t->apcie_axi + APCIE_AXI_EN0);
+		writel(readl(t->apcie_axi + APCIE_AXI_EN1) & ~BIT(0), t->apcie_axi + APCIE_AXI_EN1);
+	}
+	apple_s2r_t8132_ps_lower_finish(gp, val);
+
+	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_APCIE_GP);
+	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_ANS);
+}
+
+/* Read-modify-write in table order, with no write where nothing changes. */
+static void apple_s2r_t8132_tunable_apply_changed(void __iomem *regs,
+						  const struct apple_tunable *tun)
+{
+	size_t i;
+
+	for (i = 0; i < tun->sz; i++) {
+		void __iomem *reg = regs + tun->values[i].offset;
+		u32 old = readl(reg);
+		u32 mask = tun->values[i].mask;
+		u32 val = (old & ~mask) | (tun->values[i].value & mask);
+
+		if (val != old)
+			writel(val, reg);
+	}
+}
+
+/*
+ * Brought up from power-off in macOS's order, all of it on the waking core
+ * before ANS runs: the domains, the AXI enables, the tables, the clock
+ * generator, the PHY, the root complex.
+ */
+static int apple_s2r_t8132_raise_apcie(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	void __iomem *ctrl = t->apcie_phy + APCIE_PHY_CTRL;
+	void __iomem *run = t->apcie_phy + APCIE_PHY_RUN;
+	void __iomem *gp = t->ps + T8132_PS_APCIE_SYS_GP;
+	u32 val;
+	int ret;
+
+	ret = apple_s2r_t8132_ps_raise_full(t->ps + T8132_PS_ANS);
+	ret |= apple_s2r_t8132_ps_raise_full(t->ps + T8132_PS_APCIE_GP);
+	ret |= apple_s2r_t8132_ps_raise_start(gp);
+	if (!ret) {
+		writel(readl(t->apcie_axi + APCIE_AXI_EN0) | BIT(0), t->apcie_axi + APCIE_AXI_EN0);
+		writel(readl(t->apcie_axi + APCIE_AXI_EN1) | BIT(0), t->apcie_axi + APCIE_AXI_EN1);
+	}
+	writel((readl(gp) & ~(T8132_PS_AUTO_ENABLE | GENMASK(11, 0))) | T8132_PS_TARGET |
+	       T8132_PS_AUTO_ENABLE, gp);
+	ret |= apple_s2r_t8132_ps_raise_full(t->ps + T8132_PS_APCIE_ST);
+	ret |= apple_s2r_t8132_ps_raise_full(t->ps + T8132_PS_APCIE_SYS_ST);
+	if (ret)
+		return ret;
+
+	apple_tunable_apply(t->apcie_axi, t->apcie_axi_tunable);
+	apple_tunable_apply(t->apcie_cio3pll, t->apcie_cio3pll_tunable);
+	apple_tunable_apply(t->apcie_clkgen, t->apcie_clkgen_tunable);
+	writel(readl(t->apcie_clkgen + APCIE_CLK_START) | APCIE_CLK_START_GO,
+	       t->apcie_clkgen + APCIE_CLK_START);
+	/* Both off bits: the lowering sets them, and only a power-off clears OFF. */
+	writel(readl(t->apcie_clkgen + APCIE_CLK_CTRL) & ~(APCIE_CLK_OFF2 | APCIE_CLK_OFF),
+	       t->apcie_clkgen + APCIE_CLK_CTRL);
+	ret = readl_poll_timeout_atomic(t->apcie_clkgen + APCIE_CLK_CTRL, val,
+					!(val & APCIE_CLK_BUSY), 1, APCIE_POLL_US);
+	if (ret)
+		return ret;
+
+	ret = apple_s2r_t8132_ps_raise_full(t->ps + T8132_PS_APCIE_PHY_SW);
+	if (ret)
+		return ret;
+
+	apple_tunable_apply(t->apcie_phy, t->apcie_phy_tunable);
+	writel(readl(ctrl) | APCIE_PHY_CTRL_CLK0REQ, ctrl);
+	ret = readl_poll_timeout_atomic(ctrl, val, val & APCIE_PHY_CTRL_CLK0ACK, 1, APCIE_POLL_US);
+	if (ret)
+		return ret;
+	writel(readl(ctrl) | APCIE_PHY_CTRL_CLK1REQ, ctrl);
+	ret = readl_poll_timeout_atomic(ctrl, val, val & APCIE_PHY_CTRL_CLK1ACK, 1, APCIE_POLL_US);
+	if (ret)
+		return ret;
+	writel(readl(ctrl) & ~APCIE_PHY_CTRL_RESET, ctrl);
+
+	writel(readl(run) | APCIE_PHY_RUN_EN, run);
+	/* The PLL table, then the lanes, then the PLL's hold released, as macOS does. */
+	apple_s2r_t8132_tunable_apply_changed(t->apcie_phy_ip, t->apcie_phy_ip_pll);
+	apple_s2r_t8132_tunable_apply_changed(t->apcie_phy_ip, t->apcie_phy_ip_lanes);
+	writel(readl(t->apcie_phy_ip + APCIE_PHY_IP_PLL_CTL) & ~APCIE_PHY_IP_PLL_HOLD,
+	       t->apcie_phy_ip + APCIE_PHY_IP_PLL_CTL);
+	writel(readl(run) | APCIE_PHY_RUN_EN2, run);
+	ret = readl_poll_timeout_atomic(t->apcie_phy + APCIE_PHY_READY, val, val & BIT(0), 1,
+					APCIE_POLL_US);
+	if (ret)
+		return ret;
+	writel(readl(t->apcie_phy + APCIE_PHY_COMMON) | BIT(0), t->apcie_phy + APCIE_PHY_COMMON);
+	writel(readl(ctrl) | APCIE_PHY_CTRL_UP, ctrl);
+
+	writel(0, t->apcie_rc + APCIE_RC_ZERO);
+	writel(0x140, t->apcie_rc + APCIE_RC_READY_CFG);
+	writel(1, t->apcie_rc + APCIE_RC_READY_START);
+
+	return readl_poll_timeout_atomic(t->apcie_rc + APCIE_RC_READY_STAT, val, val & BIT(0), 1,
+					 APCIE_POLL_US);
+}
