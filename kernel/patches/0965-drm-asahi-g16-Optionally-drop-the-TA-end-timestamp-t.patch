diff --git a/drivers/gpu/drm/asahi/g16/stage_stamps.rs b/drivers/gpu/drm/asahi/g16/stage_stamps.rs
new file mode 100644
index 0000000000..198ce3f2b7
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16/stage_stamps.rs
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! The stage-stamp part of a render's receipt (poll.rs retired_snapshot), as one pure rule.
+//!
+//! The firmware writes a render's internal timestamp pairs into its pass scene: TA start and end
+//! at +0x600 / +0x608, FS start and end at +0x620 / +0x628. The scene image is rewritten at
+//! publication, so a non-zero start is this render's. `g16_fs_short` drops the FS pair's records;
+//! `g16_ta_short` drops only the TA END target (TA work +0x8d0 = 0, as macOS's TA pair), so the
+//! TA start stays required. With both off the rule is the old one, case for case.
+
+/// `ta_short` / `fs_short`: the render was published in that form. `ta` and `fs`: the (start,
+/// end) stamps read from its scene.
+pub(crate) const fn proved(ta_short: bool, fs_short: bool, ta: (u64, u64), fs: (u64, u64)) -> bool {
+    ta.0 != 0 && (ta_short || ta.1 > ta.0) && (fs_short || (fs.0 != 0 && fs.1 > fs.0))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const V: [u64; 4] = [0, 1, 0x1_0000_0000, 0x1_0000_0030];
+
+    fn old(fs_short: bool, ta: (u64, u64), fs: (u64, u64)) -> bool {
+        ta.0 != 0 && ta.1 > ta.0 && (fs_short || (fs.0 != 0 && fs.1 > fs.0))
+    }
+
+    #[test]
+    fn ta_short_off_is_the_old_rule_in_every_case() {
+        for fs_short in [false, true] {
+            for a in V {
+                for b in V {
+                    for c in V {
+                        for d in V {
+                            assert_eq!(proved(false, fs_short, (a, b), (c, d)), old(fs_short, (a, b), (c, d)));
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn the_ta_start_is_always_required() {
+        for ta_short in [false, true] {
+            for fs_short in [false, true] {
+                for b in V {
+                    assert!(!proved(ta_short, fs_short, (0, b), (V[2], V[3])));
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn ta_short_drops_only_the_ta_end() {
+        let fs = (V[2], V[3]);
+        assert!(proved(true, false, (V[2], 0), fs));
+        assert!(!proved(false, false, (V[2], 0), fs));
+        // The FS pair is still required without fs_short.
+        assert!(!proved(true, false, (V[2], 0), (0, 0)));
+        assert!(!proved(true, false, (V[2], 0), (V[3], V[2])));
+    }
+
+    #[test]
+    fn both_short_need_the_ta_start_only() {
+        assert!(proved(true, true, (V[2], 0), (0, 0)));
+        assert!(!proved(true, true, (0, 0), (V[2], V[3])));
+    }
+
+    #[test]
+    fn a_stale_or_reversed_ta_pair_fails_without_ta_short() {
+        assert!(!proved(false, true, (V[3], V[2]), (0, 0)));
+        assert!(!proved(false, true, (V[2], V[2]), (0, 0)));
+    }
+}
