+/// Storage of `g16_ta_short` (runtime 0644, default 0).
+static TA_SHORT: AtomicU32 = AtomicU32::new(0);
+
+/// `g16_ta_short` 1: a render without timestamp outputs is published with no TA END timestamp
+/// target (TA work +0x8d0 = 0), as macOS's TA pair names none. Its receipt then needs the TA start
+/// and not a TA end after it (stage_stamps.rs); its vertex time is missing from the stage
+/// statistics and the client's usage. Renders with timestamp outputs never change. 0 (default):
+/// no change. Read at each render's publication.
+pub(crate) fn ta_short() -> bool {
+    TA_SHORT.load(Ordering::Relaxed) == 1
+}
+
+live_u32_param!(
