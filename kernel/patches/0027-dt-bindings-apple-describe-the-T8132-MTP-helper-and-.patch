From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eryk Wieliczko <eryk@wieliczko.ninja>
Date: Sun, 18 Oct 2026 11:17:48 +0200
Subject: [PATCH] dt-bindings: apple: describe the T8132 MTP helper and
 DockChannel

Describe the M4 MTP helper and its DockChannel FIFO, and the retained
input handoff (apple,rtkit-handoff = "mtp-live-v1" with the
apple,rtkit-buffers inventory) through the existing bindings.

Source-commit: 9251bffee1094e1c36b9f084546b828a7d2c768e
Source-snapshot: 9ffa1fbed1e052d9706ad3e13c8663bc8ffe3d8d
Assisted-by: LLM
(cherry picked from commit b811bfe35dd8405a2c7112d9b3b3911b69be69c9,
 subset: apple,rtk-helper-asc4.yaml and apple,dockchannel.yaml only;
 the other 16 binding files of that commit are not needed for the MTP
 input path and are left out)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../bindings/soc/apple/apple,dockchannel.yaml |  1 +
 .../soc/apple/apple,rtk-helper-asc4.yaml      | 67 +++++++++++++++++++
 2 files changed, 68 insertions(+)

diff --git a/Documentation/devicetree/bindings/soc/apple/apple,dockchannel.yaml b/Documentation/devicetree/bindings/soc/apple/apple,dockchannel.yaml
index a3362df34e..a70974c3e4 100644
--- a/Documentation/devicetree/bindings/soc/apple/apple,dockchannel.yaml
+++ b/Documentation/devicetree/bindings/soc/apple/apple,dockchannel.yaml
@@ -27,6 +27,7 @@ properties:
           - apple,t6031-dockchannel
           - apple,t8112-dockchannel
           - apple,t8122-dockchannel
+          - apple,t8132-dockchannel
           - apple,t8140-dockchannel
           - apple,t8142-dockchannel
       - const: apple,dockchannel
diff --git a/Documentation/devicetree/bindings/soc/apple/apple,rtk-helper-asc4.yaml b/Documentation/devicetree/bindings/soc/apple/apple,rtk-helper-asc4.yaml
index da78694e37..4ce23869e4 100644
--- a/Documentation/devicetree/bindings/soc/apple/apple,rtk-helper-asc4.yaml
+++ b/Documentation/devicetree/bindings/soc/apple/apple,rtk-helper-asc4.yaml
@@ -27,6 +27,7 @@ properties:
           - apple,t6031-mtp
           - apple,t8112-mtp
           - apple,t8122-mtp
+          - apple,t8132-mtp
           - apple,t8140-mtp
           - apple,t8142-mtp
       - enum:
@@ -34,6 +35,7 @@ properties:
           - apple,t6030-rtk-helper-asc4
           - apple,t8112-rtk-helper-asc4
           - apple,t8122-rtk-helper-asc4
+          - apple,t8132-rtk-helper-asc4
           - apple,t8140-rtk-helper-asc4
           - apple,t8142-rtk-helper-asc4
       - const: apple,mtp
@@ -59,6 +61,59 @@ properties:
   iommus:
     maxItems: 1
 
+  apple,rtkit-handoff:
+    enum:
+      - mtp-live-v1
+    description: |
+      The producer reserves firmware-visible buffers and retains their DART
+      mappings, and transfers a running RTKit session without renegotiation.
+      On T8132 it also supplies apple,rtkit-buffers, leaves the initial
+      DockChannel HID header unread, and retains the helper's identity DART
+      bypass. The host continues servicing system endpoints without restarting
+      the coprocessor or taking it to QUIESCED.
+
+  apple,rtkit-buffers:
+    oneOf:
+      - type: boolean
+      - $ref: /schemas/types.yaml#/definitions/uint32-array
+        minItems: 5
+        maxItems: 20
+    description: |
+      An empty property records that no shared buffers were negotiated.
+      Otherwise this is the inventory of every shared buffer negotiated,
+      in groups of five cells: system endpoint number, device address high
+      cell, device address low cell, exact protocol size in bytes, and the
+      original request's is-mapped flag (0 or 1). Endpoint numbers are 1 for
+      crashlog, 2 for syslog, 4 for IOReport, and 8 for OSLog, each at most once.
+      The last cell records whether firmware supplied the original address;
+      it does not classify the backing memory as SRAM or DRAM. Device
+      addresses are physical addresses under the retained identity bypass.
+      SRAM buffers must lie inside the sram register resource. Every DRAM
+      buffer must lie inside a no-map reserved-memory region referenced by
+      memory-region. The inventory is installed before mailbox RX is enabled;
+      repeating an existing request cannot replace a live allocation.
+
+  memory-region:
+    minItems: 1
+    maxItems: 4
+    description:
+      Reserved no-map DRAM buffers held by the running coprocessor. This
+      excludes buffers inside its SRAM register resource.
+
+  linux-enablement-mac,rtkit-inherited:
+    deprecated: true
+    description: |
+      Legacy J713 preservation contract. An empty property or one 32-bit
+      cell containing 1 retains the running helper. A cell containing 0
+      selects ordinary startup. This carries no buffer inventory or verified
+      reservation record; the consumer can service system notifications but
+      cannot reconstruct or replace the existing shared buffers. New
+      producers use mtp-live-v1 and may retain this marker for older kernels.
+    oneOf:
+      - type: boolean
+      - $ref: /schemas/types.yaml#/definitions/uint32
+        enum: [0, 1]
+
   '#helper-cells':
     const: 0
     description:
@@ -72,6 +127,18 @@ required:
   - mboxes
   - iommus
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8132-mtp
+      required:
+        - apple,rtkit-handoff
+    then:
+      required:
+        - apple,rtkit-buffers
+
 additionalProperties: false
 
 examples:
