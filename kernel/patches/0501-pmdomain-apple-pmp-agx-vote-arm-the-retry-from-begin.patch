From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
Date: Tue, 3 Nov 2026 10:36:16 -0600
Subject: [PATCH] pmdomain: apple: pmp-agx-vote: arm the retry from begin when
 the write path could not

chriskearney's second blocker at efff25c1: when the last operation ends during
a SET ack that then times out, applied records the failure with users already
0, so next() returns 0 on that path and no timer is armed. A begin before the
retry deadline reported "no kick" (the clock gate from 2ec389ca), so nothing
ever ran the retry: the vote stayed off until some unrelated reconcile.

agx_vote_begin() now returns the same delay contract as agx_vote_end(): 1 run
the reconcile now, N arm it N ms out, 0 nothing pending. A begin inside a
failed-set backoff arms the remaining delay; past the deadline it returns 1 as
before; a voted overlap, stopped or disabled still return 0. The glue passes
the delay to the kicker instead of a boolean, and an idle release/resume cycle
does not clear the retry state, so the next begin still arms it.

Case 24 (fb8cba35, red at line 397) walks the whole sequence including the
release/resume variant. Controls re-pointed at the new return: begin-no-retry-
arm (returns 0 where the delay belongs) and begin-backoff-kick (returns 1,
the kick storm) both die; begin-ignores-retry is gone because the delay branch
subsumes it.

Proof: plain suite 24 cases selfcheck ok; --mutations catches all nine
mutants; the tree runner passes the registered entries.

Signed-off-by: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
(cherry picked from commit a594075711234f3d512efad8d8197d7794eaa4fd)
---
 drivers/pmdomain/apple/pmp-agx-vote.h | 15 ++++++++++-----
 drivers/pmdomain/apple/pmp-report.c   |  8 ++++----
 tools/asahi/pmp-agx-vote-tests.c      | 10 +++++-----
 tools/asahi/pmp-agx-vote-tests.py     |  9 +++------
 tools/aurora-ci/host-tests.json       |  4 ++--
 5 files changed, 24 insertions(+), 22 deletions(-)

diff --git a/drivers/pmdomain/apple/pmp-agx-vote.h b/drivers/pmdomain/apple/pmp-agx-vote.h
index f6ded0e238..2f392a4480 100644
--- a/drivers/pmdomain/apple/pmp-agx-vote.h
+++ b/drivers/pmdomain/apple/pmp-agx-vote.h
@@ -60,13 +60,18 @@ static inline bool agx_vote_retry_reached(const struct agx_vote *v, agx_ms_t now
 }
 
 /* An operation starts. now is the operation's start time in ms (any wrapping clock; the caller reads it
- * under its lock). True: run the reconcile step now. During a failed-set backoff before the deadline it is
- * false (decide would return NONE, and the retry timer drives the set); once the deadline has passed it is
- * true again, so a failed set whose timer fired idle does not strand the vote. */
-static inline bool agx_vote_begin(struct agx_vote *v, agx_ms_t now)
+ * under its lock). Returns the delay in ms until the reconcile step must run, in the same terms as
+ * agx_vote_end(): 1 runs it now, N > 1 arms it N ms out, 0 means nothing is pending. A begin that lands
+ * inside a failed-set backoff arms the remaining delay when no timer is pending (the write path cannot have
+ * armed one: next returns 0 there because users is already 0), and returns 1 once the deadline has passed. */
+static inline agx_ms_t agx_vote_begin(struct agx_vote *v, agx_ms_t now)
 {
 	v->users++;
-	return v->enabled && !v->voted && !v->stopped && (!v->failures || agx_vote_retry_reached(v, now));
+	if (!v->enabled || v->stopped)
+		return 0;
+	if (v->voted)
+		return 0;
+	return (!v->failures || agx_vote_retry_reached(v, now)) ? 1 : v->retry_at - now;
 }
 
 /* An operation ends. Returns the delay in ms after which the reconcile step must run, 0 when none is needed. */
diff --git a/drivers/pmdomain/apple/pmp-report.c b/drivers/pmdomain/apple/pmp-report.c
index d4b4b493bd..3b723a658a 100644
--- a/drivers/pmdomain/apple/pmp-report.c
+++ b/drivers/pmdomain/apple/pmp-report.c
@@ -1473,14 +1473,14 @@ void apple_pmp_agx_activity_begin(void)
 {
 	struct agx_vote *v = &apple_pmp_agx_vote_state;
 	unsigned long flags;
-	bool kick;
+	agx_ms_t delay;
 
 	spin_lock_irqsave(&apple_pmp_agx_vote_lock, flags);
 	v->enabled = READ_ONCE(agx_vote);
-	kick = agx_vote_begin(v, apple_pmp_agx_now_ms());
+	delay = agx_vote_begin(v, apple_pmp_agx_now_ms());
 	spin_unlock_irqrestore(&apple_pmp_agx_vote_lock, flags);
-	if (kick)
-		apple_pmp_agx_vote_kick(0);
+	if (delay)
+		apple_pmp_agx_vote_kick(delay);
 }
 EXPORT_SYMBOL_GPL(apple_pmp_agx_activity_begin);
 
diff --git a/tools/asahi/pmp-agx-vote-tests.c b/tools/asahi/pmp-agx-vote-tests.c
index f903b32c49..bb6dce4aa6 100644
--- a/tools/asahi/pmp-agx-vote-tests.c
+++ b/tools/asahi/pmp-agx-vote-tests.c
@@ -354,13 +354,13 @@ int main(void)
 		int kicks = s.kicks;
 		for (int i = 0; i < 5; i++)
 			begin(&s);
-		CHECK(s.kicks == kicks && s.sets == 1);               // no kicks, no sets: the timer drives it
+		CHECK(s.kicks == kicks + 5 && s.sets == 1);           // each begin arms the same deadline, none reconciles early
 		advance_to(&s, AGX_VOTE_RETRY_MS);
 		CHECK(s.sets == 2 && s.bit && s.v.failures == 0);
 		// the header alone
 		struct agx_vote v = {.enabled = true, .failures = 1, .retry_at = 100};
-		CHECK(!agx_vote_begin(&v, 0));
-		CHECK(agx_vote_begin(&v, 100));
+		CHECK(agx_vote_begin(&v, 0) == 100);                   // arms the remaining delay
+		CHECK(agx_vote_begin(&v, 100) == 1);                   // past the deadline: now
 	}
 	// 23. w7X's regression repro for the first cut of the backoff gate: a failed set whose retry timer fires
 	// while the GPU is idle left failures set forever, and begin never asked for the set again. The kick
@@ -379,8 +379,8 @@ int main(void)
 		CHECK(s.kicks == kicks + 1 && s.sets == 2 && s.bit && s.v.failures == 0);
 		// the header alone: inside the window no kick, past it the kick returns
 		struct agx_vote v = {.enabled = true, .failures = 1, .retry_at = 100};
-		CHECK(!agx_vote_begin(&v, 50));
-		CHECK(agx_vote_begin(&v, 100));
+		CHECK(agx_vote_begin(&v, 50) == 50);                   // arms the remaining delay
+		CHECK(agx_vote_begin(&v, 100) == 1);
 	}
 	// 24. chriskearney's second race at efff25c1: the last operation ends during a SET ack that then times
 	// out. applied records the failure with no user and no timer (next returns 0 on that path), and a begin
diff --git a/tools/asahi/pmp-agx-vote-tests.py b/tools/asahi/pmp-agx-vote-tests.py
index fd0f1d0e3c..2e431711ff 100755
--- a/tools/asahi/pmp-agx-vote-tests.py
+++ b/tools/asahi/pmp-agx-vote-tests.py
@@ -30,16 +30,13 @@ HEADER = 'drivers/pmdomain/apple/pmp-agx-vote.h'
 CONTROLS = [
     ('owed-set-branch', '\tif (v->users && !v->voted && !v->failures)\n\t\treturn 1;\n', ''),
     ('owed-failures', 'if (v->users && !v->voted && !v->failures)\n\t\treturn 1;', 'if (v->users && !v->voted)\n\t\treturn 1;'),
-    ('stopped-in-begin', 'return v->enabled && !v->voted && !v->stopped && (!v->failures || agx_vote_retry_reached(v, now));',
-     'return v->enabled && !v->voted && (!v->failures || agx_vote_retry_reached(v, now));'),
+    ('stopped-in-begin', 'v->users++;\n	if (!v->enabled || v->stopped)\n		return 0;', 'v->users++;\n	if (!v->enabled)\n		return 0;'),
     ('stopped-in-decide', 'if (!v->enabled || v->stopped)\n\t\treturn v->voted ? AGX_VOTE_CLEAR : AGX_VOTE_NONE;',
      'if (!v->enabled)\n\t\treturn v->voted ? AGX_VOTE_CLEAR : AGX_VOTE_NONE;'),
     ('wrap-reached', 'return (agx_sms_t)(now - t) >= 0;', 'return now >= t;'),
     ('set-write-ends', 'return agx_vote_reached(now, at) ? 1 : at - now;', 'return agx_vote_reached(now, at) ? 0 : at - now;'),
-    ('begin-backoff-kick', 'return v->enabled && !v->voted && !v->stopped && (!v->failures || agx_vote_retry_reached(v, now));',
-     'return v->enabled && !v->voted && !v->stopped && ((void)now, (!v->failures || true));'),
-    ('begin-ignores-retry', 'return v->enabled && !v->voted && !v->stopped && (!v->failures || agx_vote_retry_reached(v, now));',
-     'return v->enabled && !v->voted && !v->stopped && ((void)now, !v->failures);'),
+    ('begin-backoff-kick', 'return (!v->failures || agx_vote_retry_reached(v, now)) ? 1 : v->retry_at - now;', 'return (void)now, 1;'),
+    ('begin-no-retry-arm', 'return (!v->failures || agx_vote_retry_reached(v, now)) ? 1 : v->retry_at - now;', 'return (void)now, 0;'),
     ('retry-revival', '|| (agx_sms_t)(v->retry_at - now) > (agx_sms_t)AGX_VOTE_RETRY_MS', ''),
 ]
 
diff --git a/tools/aurora-ci/host-tests.json b/tools/aurora-ci/host-tests.json
index 9287a29f8c..62d2d49026 100644
--- a/tools/aurora-ci/host-tests.json
+++ b/tools/aurora-ci/host-tests.json
@@ -2361,13 +2361,13 @@
    "note": "self-checking: exits 0 when the mutant aborts"
   },
   {
-   "name": "tools/asahi/pmp-agx-vote-tests.py --mutation begin-ignores-retry",
+   "name": "tools/asahi/pmp-agx-vote-tests.py --mutation begin-no-retry-arm",
    "group": "tools",
    "argv": [
     "python3",
     "tools/asahi/pmp-agx-vote-tests.py",
     "--mutation",
-    "begin-ignores-retry",
+    "begin-no-retry-arm",
     "--output",
     "{output}"
    ],
