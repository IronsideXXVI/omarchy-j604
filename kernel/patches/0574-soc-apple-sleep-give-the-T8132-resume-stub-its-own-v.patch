From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 15:37:09 +0000
Subject: [PATCH] soc: apple: sleep: give the T8132 resume stub its own
 vectors

The Stage 2 firmware runs on every warm wake and branches to the
resume stub with VBAR_EL2 still pointing at its own vectors, whose
handler must stay silent once the OS owns the console. A fault in the
stub or early in cpu_resume, before init_kernel_el sets the kernel's
vectors, therefore ends in the stub's 60 s watchdog exactly like a
hang: on the J604 the Mac resets 61.9 s after the RTC alarm.

At EL2, first thing in the stub, point VBAR_EL2 at a small table in
the stub's text. Every entry restarts WD2 for 10 s by its physical
address and waits, so a fault resets the Mac about 10 s after the wake
and a hang still about 60 s after it. init_kernel_el replaces the
table with the kernel's vectors, as on a cold boot.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/sleep.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index 846b55bae8..629753d500 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -3308,6 +3308,12 @@ static void t8140_wake(struct apple_sleep *s)
  * sources. At EL2, before anything else, do what SPTM's warm entry does: mask DAIF,
  * turn the guest timer FIQs off (as the AIC driver leaves them), and invalidate the
  * EL2 TLB and the I-cache.
+ *
+ * VBAR_EL2 still points at the Stage 2 firmware's vectors here, whose handler stays
+ * silent, so a fault in the stub or early in cpu_resume used to end in the 60 s
+ * watchdog like a hang. Take t8132_wake_vectors first: every entry restarts WD2 for
+ * 10 s and waits, so a fault resets the Mac about 10 s after the wake instead of 60.
+ * init_kernel_el sets the kernel's own vectors, as on a cold boot.
  */
 asm(
 "	.pushsection .text, \"ax\"\n"
@@ -3316,6 +3322,9 @@ asm(
 "	mrs	x10, CurrentEL\n"
 "	cmp	x10, #8\n"
 "	b.ne	1f\n"
+"	adr	x10, t8132_wake_vectors\n"
+"	msr	vbar_el2, x10\n"
+"	isb\n"
 "	msr	daifset, #0xf\n"
 "	msr	s3_5_c15_c1_3, xzr\n"
 "	tlbi	alle2\n"
@@ -3334,6 +3343,23 @@ asm(
 "	str	w10, [x9, #0x2c]\n"
 "	b	cpu_resume\n"
 "	.size	t8132_resume_stub, . - t8132_resume_stub\n"
+"	.balign	2048\n"
+"	.type	t8132_wake_vectors, %object\n"
+"t8132_wake_vectors:\n"
+"	.rept	16\n"
+"	.balign	0x80\n"
+"	movz	x9, #0x882b, lsl #16\n"
+"	movk	x9, #0x3, lsl #32\n"
+"	str	wzr, [x9, #0x2c]\n"
+"	str	wzr, [x9, #0x20]\n"
+"	movz	w10, #0x1c00\n"
+"	movk	w10, #0xe4e, lsl #16\n"
+"	str	w10, [x9, #0x28]\n"
+"	mov	w10, #1\n"
+"	str	w10, [x9, #0x2c]\n"
+"2:	b	2b\n"
+"	.endr\n"
+"	.size	t8132_wake_vectors, . - t8132_wake_vectors\n"
 "	.popsection\n"
 );
 void t8132_resume_stub(void);
-- 
2.43.0

