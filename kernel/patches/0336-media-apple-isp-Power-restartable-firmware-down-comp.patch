From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Fri, 30 Oct 2026 15:00:03 -0400
Subject: [PATCH] media: apple: isp: Power restartable firmware down completely

Firmware that is started again after it stopped (hw->fw_restore) has to
be stopped for good. SUSPEND leaves the camera module powered, with its
light on, and it stays so even across a reboot. Send STOP before
POWER_DOWN instead, which also powers the module down; POWER_DOWN
follows even if STOP failed. This replaces the unused STOP sequence
that was kept under #if 0.

Some coprocessors also need a quiesce before their domains go down. Its
CPU core domains otherwise stay busy after the power-down and never run
again, so the next start of the firmware fails. Add hw->coproc_quiesce,
the register whose bit 25 requests the quiesce and reads back once it
has happened, and hw->coproc_status. With a quiesce register, the
power-down of a coprocessor that was started waits for it to reach WFI,
stops it, quiesces it, and only then powers its domains down. A start
that fails after the coprocessor was started thus also leaves it ready
for the next one.

No SoC uses them yet.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit b15632556a9733c94a754ed62c752e9dcf6fabd1)
---
 drivers/media/platform/apple/isp/isp-drv.h  |  8 ++++
 drivers/media/platform/apple/isp/isp-fw.c   | 53 +++++++++++++++------
 drivers/media/platform/apple/isp/isp-regs.h |  4 ++
 3 files changed, 51 insertions(+), 14 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 2616d78338..039f51de6a 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -196,6 +196,14 @@ struct apple_isp_hw {
 	bool mbox_irq_route;
 	/* coprocessor control register, 0 for ISP_COPROC_CONTROL */
 	u32 coproc_control;
+	/* coprocessor status register, 0 for ISP_COPROC_STATUS */
+	u32 coproc_status;
+	/*
+	 * coprocessor quiesce register, 0 for none. The CPU core domains of
+	 * a coprocessor that stopped only power down cleanly once it has
+	 * quiesced; otherwise they stay busy and never run again.
+	 */
+	u32 coproc_quiesce;
 
 	/* windows mapped 1:1 for the firmware */
 	const struct isp_mmio_window *fw_mmio;
diff --git a/drivers/media/platform/apple/isp/isp-fw.c b/drivers/media/platform/apple/isp/isp-fw.c
index 149f90096c..130b0d9b85 100644
--- a/drivers/media/platform/apple/isp/isp-fw.c
+++ b/drivers/media/platform/apple/isp/isp-fw.c
@@ -54,6 +54,11 @@ static inline u32 isp_coproc_control(struct apple_isp *isp)
 	return isp->hw->coproc_control ?: ISP_COPROC_CONTROL;
 }
 
+static inline u32 isp_coproc_status(struct apple_isp *isp)
+{
+	return isp->hw->coproc_status ?: ISP_COPROC_STATUS;
+}
+
 /* Wait for the firmware to write @expected to a GPIO word. */
 static int isp_gpio_wait(struct apple_isp *isp, u32 reg, u32 expected)
 {
@@ -411,8 +416,28 @@ static void isp_restore_fw_memory(struct apple_isp *isp)
 
 static void isp_firmware_shutdown_stage1(struct apple_isp *isp)
 {
+	/* Only a coprocessor that was started has to settle and quiesce */
+	bool started = isp->hw->coproc_quiesce &&
+		       isp_coproc_read32(isp, isp_coproc_control(isp));
+	u32 val;
+
+	/* A coprocessor that powered down waits in WFI */
+	if (started &&
+	    readl_poll_timeout(isp->coproc + isp_coproc_status(isp), val,
+			       val & ISP_COPROC_IN_WFI, 100, 200 * USEC_PER_MSEC))
+		dev_warn(isp->dev, "coproc not in WFI before power-down (status 0x%x)\n",
+			 val);
+
 	isp_coproc_write32(isp, isp_coproc_control(isp), 0x0);
 
+	if (started) {
+		/* The request bit alone asks for it, and reads back once done */
+		isp_coproc_write32(isp, isp->hw->coproc_quiesce, ISP_COPROC_QUIESCED);
+		if (readl_poll_timeout(isp->coproc + isp->hw->coproc_quiesce, val,
+				       val & ISP_COPROC_QUIESCED, 10, 50 * USEC_PER_MSEC))
+			dev_warn(isp->dev, "coproc did not quiesce (0x%x)\n", val);
+	}
+
 	apple_isp_power_down_domains(isp);
 }
 
@@ -863,26 +888,26 @@ static int isp_firmware_boot_stage3(struct apple_isp *isp)
 
 static int isp_stop_command_processor(struct apple_isp *isp)
 {
-#if 0
-	int res = isp_cmd_stop(isp, 0);
-	if (res) {
-		isp_err(isp, "isp_cmd_stop() failed\n");
-		return res;
-	}
-
-	/* Wait for ISP_GPIO_0 to 0xf7fbdff9 -> 0x8042006 */
-	isp_gpio_write32(isp, ISP_GPIO_0, 0xf7fbdff9);
+	int res, ret;
 
-	isp_cmd_power_down(isp);
-#else
 	isp_gpio_write32(isp, ISP_GPIO_0, 0xf7fbdff9);
 
-	int res = isp_cmd_suspend(isp);
+	/*
+	 * Firmware that starts again (hw->fw_restore) is stopped for good:
+	 * STOP also powers the camera module down, which SUSPEND leaves on,
+	 * even across a reboot. POWER_DOWN follows even if STOP failed.
+	 */
+	if (isp->hw->fw_restore) {
+		res = isp_cmd_stop(isp, 0);
+		ret = isp_cmd_power_down(isp);
+		res = res ?: ret;
+	} else {
+		res = isp_cmd_suspend(isp);
+	}
 	if (res) {
-		isp_err(isp, "isp_cmd_suspend() failed\n");
+		isp_err(isp, "failed to stop the firmware: %d\n", res);
 		return res;
 	}
-#endif
 
 	if (isp_gpio_wait(isp, ISP_GPIO_0, 0x8042006)) {
 		isp_err(isp, "never received magic number from firmware\n");
diff --git a/drivers/media/platform/apple/isp/isp-regs.h b/drivers/media/platform/apple/isp/isp-regs.h
index f300440568..b7f9b2fb87 100644
--- a/drivers/media/platform/apple/isp/isp-regs.h
+++ b/drivers/media/platform/apple/isp/isp-regs.h
@@ -24,6 +24,10 @@
 #define ISP_COPROC_IRQ_MASK_5  0x1400a14
 
 #define ISP_COPROC_CONTROL_T8140 0x1600044
+#define ISP_COPROC_STATUS_T8140	 0x1600048
+#define ISP_COPROC_QUIESCE_T8140 0x1600040
+/* Requests the quiesce when set, and reads back once it has happened */
+#define ISP_COPROC_QUIESCED	 BIT(25)
 
 /*
  * ISP17a (T8140) reset. The fourth fabric word is at 0xa50, off the 0x100
