From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 12:45:46 +0000
Subject: [PATCH] ASoC: tas2764: apple,init-writes, and the J604 amps'
 missing init writes

macOS 26B123 initialises each of the J604's six SN012776 amplifiers
with three writes the driver does not make (traced at boot on the
J604 with the I2C3 controller recorded from the hypervisor's entry):
page 0 register 0x07 = 0x68, page 1 register 0x19 = 0x40 and page 1
register 0x47 = 0x02. Every other write of that init matches the
driver: the six enabled quirk sequences, the DC blockers and the
brownout block from the boot loader's copies of the ADT, and the TDM
setup.

Add "apple,init-writes", byte triples (page, register, value) applied
after the built-in quirks at initialisation, each checked against the
writeable-register list (page 1 register 0x19 joins it), and give the
J604's amplifiers macOS's three. With apple,shutdown-dance the dance's
init step writes 0x07 = 0x60 first; the triple then sets macOS's 0x68.

Assisted-by: LLM
(cherry picked from commit 370090b1440bcf23654f9d68de205bb6b9557ce1)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../devicetree/bindings/sound/ti,tas27xx.yaml |  9 ++++
 arch/arm64/boot/dts/apple/t8132-j604.dts      | 12 +++++
 sound/soc/codecs/tas2764.c                    | 48 +++++++++++++++++++
 sound/soc/codecs/tas2764.h                    |  3 ++
 4 files changed, 72 insertions(+)

diff --git a/Documentation/devicetree/bindings/sound/ti,tas27xx.yaml b/Documentation/devicetree/bindings/sound/ti,tas27xx.yaml
index 00cc6cc9ce..873a51c19d 100644
--- a/Documentation/devicetree/bindings/sound/ti,tas27xx.yaml
+++ b/Documentation/devicetree/bindings/sound/ti,tas27xx.yaml
@@ -114,6 +114,15 @@ properties:
       must not enter software shutdown until the bus has stopped. One shut
       down while the bus still runs can leave garbage in its sense slots.
 
+  apple,init-writes:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 3
+    maxItems: 48
+    description:
+      SN012776 only. Register writes the vendor's driver makes when it
+      initialises this amplifier and that no built-in quirk covers, as
+      (page, register, value) triples, applied after the built-in quirks.
+
   apple,shutdown-dance:
     type: boolean
     description:
diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 7f006cd97e..f2c0c51e92 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -129,6 +129,8 @@ speaker_left_woof1: codec@38 {
 		apple,sdz-group-fail-closed;
 		apple,deferred-shutdown;
 		apple,shutdown-dance;
+		/* macOS 26B123 at boot (q7-tb-bus-1): SDZ mode, then page 1 0x19 and 0x47 */
+		apple,init-writes = /bits/ 8 <0x00 0x07 0x68  0x01 0x19 0x40  0x01 0x47 0x02>;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "Left Woofer 1";
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
@@ -143,6 +145,8 @@ speaker_left_woof2: codec@39 {
 		apple,sdz-group-fail-closed;
 		apple,deferred-shutdown;
 		apple,shutdown-dance;
+		/* macOS 26B123 at boot (q7-tb-bus-1): SDZ mode, then page 1 0x19 and 0x47 */
+		apple,init-writes = /bits/ 8 <0x00 0x07 0x68  0x01 0x19 0x40  0x01 0x47 0x02>;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "Left Woofer 2";
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
@@ -157,6 +161,8 @@ speaker_left_tweet: codec@3a {
 		apple,sdz-group-fail-closed;
 		apple,deferred-shutdown;
 		apple,shutdown-dance;
+		/* macOS 26B123 at boot (q7-tb-bus-1): SDZ mode, then page 1 0x19 and 0x47 */
+		apple,init-writes = /bits/ 8 <0x00 0x07 0x68  0x01 0x19 0x40  0x01 0x47 0x02>;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "Left Tweeter";
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
@@ -171,6 +177,8 @@ speaker_right_woof1: codec@3b {
 		apple,sdz-group-fail-closed;
 		apple,deferred-shutdown;
 		apple,shutdown-dance;
+		/* macOS 26B123 at boot (q7-tb-bus-1): SDZ mode, then page 1 0x19 and 0x47 */
+		apple,init-writes = /bits/ 8 <0x00 0x07 0x68  0x01 0x19 0x40  0x01 0x47 0x02>;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "Right Woofer 1";
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
@@ -185,6 +193,8 @@ speaker_right_woof2: codec@3c {
 		apple,sdz-group-fail-closed;
 		apple,deferred-shutdown;
 		apple,shutdown-dance;
+		/* macOS 26B123 at boot (q7-tb-bus-1): SDZ mode, then page 1 0x19 and 0x47 */
+		apple,init-writes = /bits/ 8 <0x00 0x07 0x68  0x01 0x19 0x40  0x01 0x47 0x02>;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "Right Woofer 2";
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
@@ -199,6 +209,8 @@ speaker_right_tweet: codec@3d {
 		apple,sdz-group-fail-closed;
 		apple,deferred-shutdown;
 		apple,shutdown-dance;
+		/* macOS 26B123 at boot (q7-tb-bus-1): SDZ mode, then page 1 0x19 and 0x47 */
+		apple,init-writes = /bits/ 8 <0x00 0x07 0x68  0x01 0x19 0x40  0x01 0x47 0x02>;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "Right Tweeter";
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
diff --git a/sound/soc/codecs/tas2764.c b/sound/soc/codecs/tas2764.c
index 1b80c87682..a84ff861fd 100644
--- a/sound/soc/codecs/tas2764.c
+++ b/sound/soc/codecs/tas2764.c
@@ -92,6 +92,9 @@ struct tas2764_priv {
 	bool deferred_shutdown;
 	/* apple,shutdown-dance: the hidden-page writes around software shutdown */
 	bool shutdown_dance;
+	/* apple,init-writes: (page, register, value) triples applied after the init quirks */
+	u8 init_writes[3 * TAS2764_INIT_WRITES_MAX];
+	int n_init_writes;
 	/* Muted at a stream's end, until the next one: the bus clock may stop */
 	bool stream_stopped;
 	struct delayed_work shutdown_work;
@@ -987,6 +990,14 @@ static int tas2764_apply_init_quirks(struct tas2764_priv *tas2764)
 			return ret;
 	}
 
+	for (i = 0; i < tas2764->n_init_writes; i++) {
+		const u8 *w = &tas2764->init_writes[3 * i];
+
+		ret = regmap_write(tas2764->regmap, TAS2764_REG(w[0], w[1]), w[2]);
+		if (ret < 0)
+			return ret;
+	}
+
 	return 0;
 }
 
@@ -1406,6 +1417,7 @@ static bool tas2764_writeable_register(struct device *dev, unsigned int reg)
 {
 	switch (reg) {
 	case TAS2764_REG(0x0, 0x00) ... TAS2764_REG(0x0, 0x7f):
+	case TAS2764_REG(0x1, 0x19):
 	case TAS2764_REG(0x1, 0x33):
 	case TAS2764_REG(0x1, 0x37):
 	case TAS2764_SDOUT_HIZ_1 ... TAS2764_SDOUT_HIZ_9:
@@ -1463,6 +1475,39 @@ static int tas2764_parse_bop_config(struct device *dev, struct tas2764_priv *tas
 	return 0;
 }
 
+/*
+ * apple,init-writes: register writes Apple's driver makes at initialisation
+ * that no built-in quirk covers, as (page, register, value) byte triples,
+ * applied after the init quirks. Each one must be a register the driver may
+ * write (tas2764_writeable_register): a write to a reserved register can
+ * hang the bus.
+ */
+static int tas2764_parse_init_writes(struct device *dev, struct tas2764_priv *tas2764)
+{
+	int len, i, ret;
+
+	tas2764->n_init_writes = 0;
+	len = of_property_count_u8_elems(dev->of_node, "apple,init-writes");
+	if (len == -EINVAL)
+		return 0;
+	if (len <= 0 || len % 3 || len > (int)sizeof(tas2764->init_writes))
+		return dev_err_probe(dev, -EINVAL, "apple,init-writes: %d bytes\n", len);
+	ret = of_property_read_u8_array(dev->of_node, "apple,init-writes",
+					tas2764->init_writes, len);
+	if (ret)
+		return ret;
+	for (i = 0; i < len; i += 3) {
+		unsigned int reg = TAS2764_REG(tas2764->init_writes[i], tas2764->init_writes[i + 1]);
+
+		if (!tas2764->init_writes[i + 1] || !tas2764_writeable_register(dev, reg))
+			return dev_err_probe(dev, -EINVAL,
+					     "apple,init-writes: page 0x%02x register 0x%02x not writeable\n",
+					     tas2764->init_writes[i], tas2764->init_writes[i + 1]);
+	}
+	tas2764->n_init_writes = len / 3;
+	return 0;
+}
+
 /*
  * The SN012776's DC blockers, DC_BLK0 and DC_BLK1, from the device tree's
  * apple,amp-dcblocker-config: the boot loader copies it from the amp group's
@@ -1623,6 +1668,9 @@ static int tas2764_parse_dt(struct device *dev, struct tas2764_priv *tas2764)
 							   "apple,deferred-shutdown");
 	tas2764->shutdown_dance = of_property_read_bool(dev->of_node,
 							"apple,shutdown-dance");
+	ret = tas2764_parse_init_writes(dev, tas2764);
+	if (ret)
+		return ret;
 
 	ret = tas2764_parse_bop_config(dev, tas2764);
 	if (ret)
diff --git a/sound/soc/codecs/tas2764.h b/sound/soc/codecs/tas2764.h
index 19691d94c4..26e013bf99 100644
--- a/sound/soc/codecs/tas2764.h
+++ b/sound/soc/codecs/tas2764.h
@@ -15,6 +15,9 @@
 #define TAS2764_BOOKCTL_REG	127
 #define TAS2764_REG(page, reg)	((page * 128) + reg)
 
+/* apple,init-writes: at most this many (page, register, value) triples */
+#define TAS2764_INIT_WRITES_MAX	16
+
 /* Page */
 #define TAS2764_PAGE		TAS2764_REG(0X0, 0x00)
 #define TAS2764_PAGE_PAGE_MASK	255
-- 
2.43.0

