index 39cc776e16..b0bcac4c3c 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -342,6 +342,11 @@ pub(crate) struct Stats {
     pub(crate) chain_serial_n: [u64; 2],
     pub(crate) chain_serial_ns: [u64; 2],
     pub(crate) chain_ahead_hist: [[u64; 32]; 2],
+    /// `g16_subgen`, per submit pipe (TA, FS, compute): cells bumped, bumps that found the
+    /// firmware's mirror equal to the cell (caught up), and failed accesses.
+    pub(crate) subgen_bumps: [u64; 3],
+    pub(crate) subgen_caught: [u64; 3],
+    pub(crate) subgen_err: u64,
     /// The last prefix that failed that check: publication, first stage start, last stage end
     /// and retirement, raw 24 MHz ticks (to find the stamps' time base).
     pub(crate) lat_last_bad: [u64; 4],
@@ -637,6 +642,30 @@ pub(crate) fn complete(done: &mut Completions, job: &Arc<Job>, result: Result) {
 const KICKFW_DOORBELL: u64 = 0x10;
 
 impl Firmware {
+    /// `g16_subgen`: bumps the generation cells listed for submit pipe `pipe`, in order, right
+    /// before its doorbell. A failed access is counted, never fatal: the doorbell still goes out.
+    fn subgen_bump(&mut self, pipe: usize) {
+        for cell in super::params::subgen_cells(pipe) {
+            if cell == 0 {
+                continue;
+            }
+            let s = &mut self.engine.stats;
+            match self.session.regs.bump_generation_cell(cell) {
+                Ok((before, mirror)) => {
+                    if let Some(n) = s.subgen_bumps.get_mut(pipe) {
+                        *n += 1;
+                    }
+                    if mirror == before {
+                        if let Some(n) = s.subgen_caught.get_mut(pipe) {
+                            *n += 1;
+                        }
+                    }
+                }
+                Err(_) => s.subgen_err += 1,
+            }
+        }
+    }
+
     /// Sends the firmware kick, EP 0x21 `0x83 << 48 | 0x10` (`g16_kickfw`).
     fn kick_firmware(&mut self) -> Result {
         self.session.send(
@@ -1332,6 +1361,9 @@ fn publish_prefix_into(
                 } else {
                     self.channels.post(channel, &record)?;
                 }
+                if super::params::subgen() {
+                    self.subgen_bump(channel as usize);
+                }
                 self.session.ring(channel)?;
             }
             if super::params::kickfw() == 2 {
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 40e9f5b0f7..f3d9e22e8a 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -594,6 +594,192 @@ pub(crate) fn depth() -> u32 {
     "G16: render commands of one queue that may stay in flight behind the next publication (default 0: publish after retirement; 1: one in flight; runtime 0644)"
 );
 
+/// Storage of `g16_subgen` (runtime 0644, default 0).
+static SUBGEN: AtomicU32 = AtomicU32::new(0);
+
+/// The per-submission kick J604-MEASURED from macOS 26B123 (its own GPU firmware) as a guest
+/// under aura's hypervisor (aura GPU trace, 2026-11-13): before each doorbell the host reads the
+/// firmware's mirror (SGX +0xd64000 + 2 * cell), reads the 8-bit generation cell on the
+/// host-owned page SGX +0xd60000 and writes it back plus one, per cell, then rings. macOS pipe 0
+/// bumps +0x20 then +0x00, pipe 1 +0x20, pipe 2 +0x40 (pipes 8/9/0xa: +0x30+0x10 / +0x30 /
+/// +0x50). With `g16_subgen` = 1 the cells in `g16_subgen_cells` are bumped, in order, right
+/// before that pipe's doorbell. 0 (default) bumps nothing: today's protocol.
+pub(crate) fn subgen() -> bool {
+    SUBGEN.load(Ordering::Relaxed) == 1
+}
+
+live_u32_param!(
+    SUBGEN_PARAM,
+    SUBGEN_PARMTYPE,
+    SUBGEN_PARM,
+    SUBGEN,
+    "g16_subgen",
+    "G16: bump the SGX +0xd60000 generation cells in g16_subgen_cells before each doorbell, as macOS does (default 0: off; 1: on; runtime 0644)"
+);
+
+/// Per submit pipe 0 (TA), 1 (FS), 2 (compute): the first cell in the low 16 bits, the second in
+/// the high 16 bits, 0 for none. Cell 0 is the device-control generation of the 25G83 protocol
+/// this driver speaks (regs.rs `set_generation`) and is refused.
+static SUBGEN_CELLS: [AtomicU32; 3] = [AtomicU32::new(0), AtomicU32::new(0), AtomicU32::new(0)];
+
+/// The cells to bump, in order, before pipe `pipe`'s doorbell (0 = none).
+pub(crate) fn subgen_cells(pipe: usize) -> [usize; 2] {
+    let v = SUBGEN_CELLS.get(pipe).map_or(0, |a| a.load(Ordering::Relaxed));
+    [(v & 0xffff) as usize, (v >> 16) as usize]
+}
+
+/// A cell offset: hex (0x..) or decimal, 4-aligned, nonzero, below 0x2000 (its mirror then lies in
+/// the 0x4000 window at SGX +0xd64000).
+fn subgen_parse_cell(text: &str) -> Option<u32> {
+    let text = text.trim();
+    let v = match text.strip_prefix("0x").or_else(|| text.strip_prefix("0X")) {
+        Some(hex) => u32::from_str_radix(hex, 16).ok()?,
+        None => text.parse::<u32>().ok()?,
+    };
+    (v != 0 && v % 4 == 0 && v < 0x2000).then_some(v)
+}
+
+/// `set` of `g16_subgen_cells`: "pipe:cell[+cell],..." (e.g. "2:0x40,1:0x20"), or empty / "none".
+/// The whole list is checked before any of it takes effect.
+///
+/// # Safety
+///
+/// Called by the module-parameter core with `val` NULL or a NUL-terminated string.
+unsafe extern "C" fn subgen_cells_set(
+    val: *const c_char,
+    _kp: *const kernel::bindings::kernel_param,
+) -> c_int {
+    if val.is_null() {
+        return EINVAL.to_errno();
+    }
+    // SAFETY: `val` is a NUL-terminated string per the function contract.
+    let Ok(text) = unsafe { core::ffi::CStr::from_ptr(val) }.to_str() else {
+        return EINVAL.to_errno();
+    };
+    let text = text.trim();
+    let mut table = [0u32; 3];
+    if !text.is_empty() && text != "none" {
+        for item in text.split(',') {
+            let Some((pipe, cells)) = item.split_once(':') else {
+                return EINVAL.to_errno();
+            };
+            let Ok(pipe) = pipe.trim().parse::<usize>() else {
+                return EINVAL.to_errno();
+            };
+            if pipe >= table.len() {
+                return EINVAL.to_errno();
+            }
+            let mut packed = 0u32;
+            for (n, cell) in cells.split('+').enumerate() {
+                let Some(cell) = subgen_parse_cell(cell) else {
+                    return EINVAL.to_errno();
+                };
+                if n >= 2 {
+                    return EINVAL.to_errno();
+                }
+                packed |= cell << (16 * n);
+            }
+            table[pipe] = packed;
+        }
+    }
+    for (slot, v) in SUBGEN_CELLS.iter().zip(table) {
+        slot.store(v, Ordering::Relaxed);
+    }
+    0
+}
+
+fn subgen_push(out: &mut [u8], len: &mut usize, b: u8) {
+    if *len < out.len() {
+        out[*len] = b;
+        *len += 1;
+    }
+}
+
+fn subgen_push_hex(out: &mut [u8], len: &mut usize, v: u32) {
+    subgen_push(out, len, b'0');
+    subgen_push(out, len, b'x');
+    let mut started = false;
+    for shift in (0..8).rev() {
+        let d = ((v >> (shift * 4)) & 0xf) as u8;
+        if d != 0 || started || shift == 0 {
+            started = true;
+            subgen_push(out, len, if d < 10 { b'0' + d } else { b'a' + d - 10 });
+        }
+    }
+}
+
+/// `get` of `g16_subgen_cells`: the list as `set` takes it, or "none".
+///
+/// # Safety
+///
+/// `buffer` is the module-parameter core's PAGE_SIZE output buffer.
+unsafe extern "C" fn subgen_cells_get(
+    buffer: *mut c_char,
+    _kp: *const kernel::bindings::kernel_param,
+) -> c_int {
+    let mut out = [0u8; 96];
+    let mut len = 0;
+    for pipe in 0..SUBGEN_CELLS.len() {
+        let [a, b] = subgen_cells(pipe);
+        if a == 0 {
+            continue;
+        }
+        if len != 0 {
+            subgen_push(&mut out, &mut len, b',');
+        }
+        subgen_push(&mut out, &mut len, b'0' + pipe as u8);
+        subgen_push(&mut out, &mut len, b':');
+        subgen_push_hex(&mut out, &mut len, a as u32);
+        if b != 0 {
+            subgen_push(&mut out, &mut len, b'+');
+            subgen_push_hex(&mut out, &mut len, b as u32);
+        }
+    }
+    if len == 0 {
+        for &c in b"none" {
+            subgen_push(&mut out, &mut len, c);
+        }
+    }
+    subgen_push(&mut out, &mut len, b'\n');
+    // SAFETY: the buffer holds PAGE_SIZE bytes; at most 97 are written.
+    unsafe {
+        core::ptr::copy_nonoverlapping(out.as_ptr(), buffer.cast::<u8>(), len);
+        *buffer.cast::<u8>().add(len) = 0;
+    }
+    len as c_int
+}
+
+static SUBGEN_CELLS_OPS: kernel::bindings::kernel_param_ops = kernel::bindings::kernel_param_ops {
+    flags: 0,
+    set: Some(subgen_cells_set),
+    get: Some(subgen_cells_get),
+    free: None,
+};
+
+#[link_section = "__param"]
+#[used(compiler)]
+static SUBGEN_CELLS_PARAM: kernel::module_param::KernelParam =
+    kernel::module_param::KernelParam::new(kernel::bindings::kernel_param {
+        name: kernel::str::as_char_ptr_in_const_context(if cfg!(MODULE) {
+            kernel::c_str!("g16_subgen_cells")
+        } else {
+            kernel::c_str!("asahi.g16_subgen_cells")
+        }),
+        // `__this_module` is constructed by the kernel at load time and is not freed until the
+        // module is unloaded. Take its address without a reference to the mutable static.
+        #[cfg(MODULE)]
+        mod_: (&raw const kernel::bindings::__this_module).cast_mut(),
+        #[cfg(not(MODULE))]
+        mod_: core::ptr::null_mut(),
+        ops: core::ptr::from_ref(&SUBGEN_CELLS_OPS),
+        perm: 0o644,
+        level: -1,
+        flags: 0,
+        __bindgen_anon_1: kernel::bindings::kernel_param__bindgen_ty_1 {
+            arg: core::ptr::from_ref(&SUBGEN_CELLS).cast_mut().cast(),
+        },
+    });
+
 /// Storage of `g16_tail_us` (runtime 0644, default 0).
 static TAIL_US: AtomicU32 = AtomicU32::new(0);
 
