+            s.subgen_err
+        )?;
         write!(f, "first_hist_100us:")?;
         for n in s.first_hist.iter() {
             write!(f, " {}", n)?;
diff --git a/drivers/gpu/drm/asahi/g16/regs.rs b/drivers/gpu/drm/asahi/g16/regs.rs
index 15a17e61f5..79439e692c 100644
--- a/drivers/gpu/drm/asahi/g16/regs.rs
+++ b/drivers/gpu/drm/asahi/g16/regs.rs
@@ -179,6 +179,9 @@ pub(crate) struct Regs {
     status: Mapping,
     /// Host-owned generation register page (SGX +0xd60000).
     generation: Mapping,
+    /// The firmware's mirror of the generation cells (SGX +0xd64000, cell c at +2 * c;
+    /// J604-measured under macOS 26B123). Read only, for `g16_subgen`.
+    generation_mirror: Mapping,
 }
 
 impl Regs {
@@ -198,6 +201,7 @@ pub(crate) fn new(pdev: &platform::Device<Core<'_>>, res: G16Resources) -> Resul
             asc: window(c_str!("asc"), 0)?,
             status: window(c_str!("sgx"), SGX_STATUS as u64)?,
             generation: window(c_str!("sgx"), 0xd60000)?,
+            generation_mirror: window(c_str!("sgx"), 0xd64000)?,
             res,
         })
     }
@@ -226,6 +230,18 @@ pub(crate) fn pstate(&self) -> Result<u32> {
         }
     }
 
+    /// One `g16_subgen` cell bump, as macOS does it before a doorbell: the firmware's mirror,
+    /// then the 8-bit cell, written back plus one. Returns (cell before, mirror). `cell` is
+    /// checked by the parameter's parser (4-aligned, 0 < cell < 0x2000).
+    pub(crate) fn bump_generation_cell(&self, cell: usize) -> Result<(u32, u32)> {
+        let mirror = self.generation_mirror.io().try_read32(2 * cell)?;
+        let before = self.generation.io().try_read32(cell)?;
+        self.generation
+            .io()
+            .try_write32(before.wrapping_add(1) & 0xff, cell)?;
+        Ok((before, mirror))
+    }
+
     /// Publishes the host-owned device-control generation and verifies the receipt.
     pub(crate) fn set_generation(&self, value: u32) -> Result {
         self.generation.io().try_write32(value, 0)?;
