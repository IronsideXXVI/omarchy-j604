From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 04:57:33 +0000
Subject: [PATCH 351/353] soc: apple: s2r: read the T8132 ADT power gates,
 optionally write them

Four real T8132 sleeps on the J604 ended with the sleep tail complete
and a reset by WD2 5 s later: the sleep engine never took the commit.
The J604's ADT gives macOS's PMGR driver four power-gate words in
/arm-io/pmgr pwrgate-regs, value 0x80000000 each, and nothing on the
Linux side, boot loader included, writes them. The tail sets two other
power-gate words, the ones Aurora's J713 port sets.

Take the records from apple,pwrgate-regs when the device tree has them.
Read the words at probe (one log line) and before each commit, and
report both after the sleep. Behind t8132_pwrgate_adt, default off,
write each word before the sequence the way m1n1 applies the ADT's
{reg, offset, mask, value} tables (tunables_apply_global(): the mask's
bits cleared, the value's set); an abort puts them back in reverse
order, a real wake keeps them. Which bits a record's mask names is not
known, so the write stays a bring-up switch until a sleep shows it.

A record outside its window, or with mask and value sharing a bit, is
refused at probe.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/apple-s2r.c | 143 +++++++++++++++++++++++++++++++++-
 1 file changed, 141 insertions(+), 2 deletions(-)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index f62da645d5..e74bc79865 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -438,6 +438,20 @@ static const u32 t8132_ps_disp_cpu[] = { 0x10000, 0x1e8, 0x4f0 };
 
 static const u8 t8132_clk_mux[] = { 0x10, 0x14, 0x00, 0x04 };
 
+/*
+ * apple,pwrgate-regs: the ADT's pmgr pwrgate-regs records, {window, offset,
+ * mask, value}, the windows being "pmgr0" and "pmgr1" (pmgr reg[0], reg[1]).
+ */
+#define T8132_PGA_REGS			2
+#define T8132_PGA_MAX			8
+
+struct apple_s2r_t8132_pga {
+	u32 reg;
+	u32 offset;
+	u32 mask;
+	u32 value;
+};
+
 struct apple_s2r_t8132 {
 	void __iomem *ps;
 	void __iomem *ps_aon;
@@ -509,6 +523,16 @@ struct apple_s2r_t8132 {
 	u32 pg_now[2];
 	bool pg_changed;
 	bool pg_read;
+	/* apple,pwrgate-regs: at ->enter, at the commit, and which were written */
+	void __iomem *pmgr_reg[T8132_PGA_REGS];
+	resource_size_t pmgr_reg_size[T8132_PGA_REGS];
+	struct apple_s2r_t8132_pga pga[T8132_PGA_MAX];
+	unsigned int npga;
+	u32 pga_saved[T8132_PGA_MAX];
+	u32 pga_commit[T8132_PGA_MAX];
+	u8 pga_changed;
+	u8 pga_written;
+	bool pga_read;
 
 	/* ANS's APCIe block, from the apple,apcie host node and its loader-published tables */
 	void __iomem *apcie_axi;
@@ -559,6 +583,11 @@ struct apple_s2r_t8132 {
 	unsigned int pmu_err;
 };
 
+static void __iomem *apple_s2r_t8132_pga_addr(struct apple_s2r_t8132 *t, unsigned int i)
+{
+	return t->pmgr_reg[t->pga[i].reg] + t->pga[i].offset;
+}
+
 /* Busy-wait budget for each register poll */
 #define S2R_POLL_TIMEOUT_US	8000
 
@@ -1343,6 +1372,10 @@ static uint t8132_commit_code;
 module_param(t8132_commit_code, uint, 0644);
 MODULE_PARM_DESC(t8132_commit_code, "For bring-up, with t8132_sequence: read one group back around the commit and run WD2 out at 8 + 3 x the slot of the first finding (s) instead of macOS's 5, so that the time of the reset names it: 1 armed wake sources already pending (slot = index in the armed list), 2 quiesce words still on (slot = index), 3 tail invariants (0 DCS, 1 PMC voter, 2 SoC perf, 3 MCC enables, 4 NUB SRAM auto-enable, 5 RVBAR, 6 CPU clusters), 4 the commit register 3 ms after the commit (slot 0 reads 0, 1 reads 1, 2 other); 0 off, other values do nothing (default: 0)");
 
+static bool t8132_pwrgate_adt;
+module_param(t8132_pwrgate_adt, bool, 0644);
+MODULE_PARM_DESC(t8132_pwrgate_adt, "For bring-up, with t8132_sequence and apple,pwrgate-regs: before the sequence, write the ADT's pmgr pwrgate-regs records the way m1n1 applies the ADT's {reg, offset, mask, value} tables (the mask's bits cleared, the value's set); an abort puts the old values back, a real wake keeps them. They are read at probe and at the commit either way (default: off)");
+
 static bool t8132_lower_stray;
 module_param(t8132_lower_stray, bool, 0644);
 MODULE_PARM_DESC(t8132_lower_stray, "For bring-up, with t8132_sequence: on a real sleep, once every coprocessor has stopped, lower AVD_SYS, VENC_SYS, GFX and JPG if still on, as Aurora does from macOS's sequence; one that will not go off resets with stage 0x3e, as any refusal past the coprocessor stops; raised again on the wake (default: off)");
@@ -3272,6 +3305,8 @@ static int apple_s2r_t8132_finish(unsigned long arg)
 	writel(0, t->cluster + T8132_CLUSTER_E);
 	writel(0, t->cluster + T8132_CLUSTER_P);
 
+	for (i = 0; i < t->npga; i++)
+		t->pga_commit[i] = readl(apple_s2r_t8132_pga_addr(t, i));
 	t->quiesce_still_on = 0;
 	for (i = 0; i < ARRAY_SIZE(t8132_quiesce_words); i++)
 		if (apple_s2r_t8132_ps_on(s2r, t8132_quiesce_words[i]))
@@ -3464,6 +3499,48 @@ static int apple_s2r_t8132_refuse(struct apple_s2r *s2r)
  * on the J604 (MEASURED, gpu2-20 read). Set before anything of the sequence
  * runs; an abort puts the old value back, a real wake keeps it, as Aurora's.
  */
+/*
+ * The J604 ADT gives macOS's PMGR driver four power-gate words in pmgr
+ * pwrgate-regs, value 0x80000000 each; nothing on the Linux side wrote them.
+ * Read them at ->enter; with t8132_pwrgate_adt, write each as m1n1 applies
+ * the ADT's {reg, offset, mask, value} tables (tunables_apply_global():
+ * mask32(addr, mask, value)). Which bits a record's mask names is
+ * not known.
+ */
+static void apple_s2r_t8132_pga_enter(struct apple_s2r *s2r, bool write)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	unsigned int i;
+	u32 val;
+
+	t->pga_changed = 0;
+	for (i = 0; i < t->npga; i++) {
+		void __iomem *reg = apple_s2r_t8132_pga_addr(t, i);
+
+		t->pga_saved[i] = readl(reg);
+		if (!write)
+			continue;
+		val = (t->pga_saved[i] & ~t->pga[i].mask) | t->pga[i].value;
+		if (val == t->pga_saved[i])
+			continue;
+		writel(val, reg);
+		t->pga_changed |= BIT(i);
+	}
+	t->pga_written = t->pga_changed;
+	t->pga_read = t->npga;
+}
+
+static void apple_s2r_t8132_pga_undo(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	int i;
+
+	for (i = t->npga - 1; i >= 0; i--)
+		if (t->pga_changed & BIT(i))
+			writel(t->pga_saved[i], apple_s2r_t8132_pga_addr(t, i));
+	t->pga_changed = 0;
+}
+
 static void apple_s2r_t8132_pg_enable(struct apple_s2r *s2r)
 {
 	struct apple_s2r_t8132 *t = &s2r->t8132;
@@ -3476,12 +3553,14 @@ static void apple_s2r_t8132_pg_enable(struct apple_s2r *s2r)
 	t->pg_now[0] = readl(t->pwrgate + T8132_PWRGATE_CLUSTER_E);
 	t->pg_now[1] = readl(t->pwrgate + T8132_PWRGATE_CLUSTER_P);
 	t->pg_read = true;
+	apple_s2r_t8132_pga_enter(s2r, READ_ONCE(t8132_pwrgate_adt));
 }
 
 static void apple_s2r_t8132_pg_undo(struct apple_s2r *s2r)
 {
 	struct apple_s2r_t8132 *t = &s2r->t8132;
 
+	apple_s2r_t8132_pga_undo(s2r);
 	if (!t->pg_changed)
 		return;
 	t->pg_changed = false;
@@ -3544,10 +3623,12 @@ static int apple_s2r_t8132_enter(struct apple_s2r *s2r)
 
 	apple_s2r_t8132_match_undo(s2r);
 	apple_s2r_t8132_wake_restore(s2r);
-	if (ret)
+	if (ret) {
 		apple_s2r_t8132_pg_undo(s2r);
-	else
+	} else {
 		t->pg_changed = false;
+		t->pga_changed = 0;
+	}
 
 	return ret;
 }
@@ -3571,6 +3652,13 @@ static void apple_s2r_t8132_report(struct apple_s2r *s2r)
 			 t->pg_saved[0], t->pg_saved[1], t->pg_now[0], t->pg_now[1],
 			 t->returned ? "" : " (P put back after the abort)");
 	t->pg_read = false;
+	if (t->pga_read) {
+		for (i = 0; i < t->npga; i++)
+			dev_info(s2r->dev, "T8132: ADT power gate %u at ->enter %#x, at the commit %#x%s\n",
+				 i, t->pga_saved[i], t->pga_commit[i],
+				 t->pga_written & BIT(i) ? " (written)" : "");
+	}
+	t->pga_read = false;
 	if (t->wake_rb_ok)
 		dev_info(s2r->dev, "T8132: wake words read back +0x08..+0x2c: %*ph\n",
 			 (int)sizeof(t->wake_rb), t->wake_rb);
@@ -3662,6 +3750,54 @@ static void apple_s2r_t8132_begin(struct apple_s2r *s2r)
 }
 
 /* The T8132 register windows; mapped without claiming them, as other drivers own most. */
+/*
+ * apple,pwrgate-regs, optional: the J604 ADT's pmgr pwrgate-regs as they are,
+ * read once here (a log line) and at every commit, written only with
+ * t8132_pwrgate_adt. A record must lie inside its window, and its mask and
+ * value must not share a bit.
+ */
+static int apple_s2r_t8132_map_pga(struct platform_device *pdev, struct apple_s2r_t8132 *t)
+{
+	static const char * const names[T8132_PGA_REGS] = { "pmgr0", "pmgr1" };
+	struct device *dev = &pdev->dev;
+	char buf[T8132_PGA_MAX * 12 + 1];
+	int i, n, len = 0;
+
+	n = of_property_count_u32_elems(dev->of_node, "apple,pwrgate-regs");
+	if (n <= 0)
+		return 0;
+	if (n % 4 || n / 4 > T8132_PGA_MAX)
+		return dev_err_probe(dev, -EINVAL, "bad apple,pwrgate-regs\n");
+	for (i = 0; i < T8132_PGA_REGS; i++) {
+		struct resource *res;
+
+		res = platform_get_resource_byname(pdev, IORESOURCE_MEM, names[i]);
+		if (!res)
+			continue;
+		t->pmgr_reg[i] = devm_ioremap(dev, res->start, resource_size(res));
+		if (!t->pmgr_reg[i])
+			return -ENOMEM;
+		t->pmgr_reg_size[i] = resource_size(res);
+	}
+	if (of_property_read_u32_array(dev->of_node, "apple,pwrgate-regs", (u32 *)t->pga, n))
+		return -EINVAL;
+	for (i = 0; i < n / 4; i++) {
+		const struct apple_s2r_t8132_pga *p = &t->pga[i];
+
+		if (p->reg >= T8132_PGA_REGS || !t->pmgr_reg[p->reg] || p->offset % 4 ||
+		    t->pmgr_reg_size[p->reg] < 4 || p->offset > t->pmgr_reg_size[p->reg] - 4 ||
+		    (p->mask & p->value))
+			return dev_err_probe(dev, -EINVAL, "bad apple,pwrgate-regs record %d\n", i);
+	}
+	t->npga = n / 4;
+	for (i = 0; i < t->npga; i++)
+		len += scnprintf(buf + len, sizeof(buf) - len, " %#x",
+				 readl(apple_s2r_t8132_pga_addr(t, i)));
+	dev_info(dev, "T8132: ADT power gates at probe:%s\n", buf);
+
+	return 0;
+}
+
 static int apple_s2r_t8132_map(struct apple_s2r *s2r, struct platform_device *pdev)
 {
 	static const struct {
@@ -3713,6 +3849,9 @@ static int apple_s2r_t8132_map(struct apple_s2r *s2r, struct platform_device *pd
 	if (ret < 0)
 		return dev_err_probe(dev, ret, "T8132 sequence: no apple,wake-enable\n");
 	t->nwake = ret;
+	ret = apple_s2r_t8132_map_pga(pdev, t);
+	if (ret)
+		return ret;
 	apple_s2r_t8132_map_apcie(s2r);
 	t->mapped = true;
 
-- 
2.43.0

