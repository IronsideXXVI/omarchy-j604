From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 04:06:31 +0000
Subject: [PATCH] drm/apple: m4: send the J604 panel's desktop
 compensation values

The panel image-processing set came from a macOS boot that sat on the
lock screen. The same properties read on the unlocked desktop, in five
legs of a later boot (SDR, HDR full screen and windowed, a brightness
ramp, SDR again), differ in five entries: macOS's desktop runs
brightness compensation (28), temperature compensation (29), 2D
temperature correction (35) and uniformity2D (42) on, and does not
scale EDR in the GP (166). The lock screen turns these the other way.

Send the desktop values. The other 24 entries and the BLM set read the
same in all five legs.

Fixes: a5b71a977f5a ("drm/apple: m4: run the J604 panel's image processing as macOS does")
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/iomfb_m4.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index ddcc46bae6..ef9d388360 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -211,7 +211,10 @@ static unsigned int blm_props_count = 7;
  * APTPDCEnablePM 182, VUCEnable 216, disableBLKSFComp 253 and
  * enableDisplayTMDpc 254. Brightness levels, caps and counters, logging,
  * test and capability entries are left to the firmware. Sent after the BLM
- * set through the same applyProperty path; empty sends nothing.
+ * set through the same applyProperty path; empty sends nothing. The values are
+ * those of macOS's unlocked desktop: its lock screen turns brightness and
+ * temperature compensation, 2D temperature correction and uniformity2D off
+ * and scales EDR in the GP, and the desktop turns them back.
  */
 static const u16 dcp_m4_dcal_prop_ids[] = {
 	28, 29, 30, 31, 35, 36, 42, 47, 50, 67, 72, 73, 127, 128, 129,
@@ -219,10 +222,10 @@ static const u16 dcp_m4_dcal_prop_ids[] = {
 };
 
 static struct dcp_m4_blm_prop dcal_props[DCP_M4_PROPS_MAX] = {
-	{ 28, 0 }, { 29, 0 }, { 30, 1 }, { 31, 1 }, { 35, 0 }, { 36, 0 }, { 42, 0 },
+	{ 28, 1 }, { 29, 1 }, { 30, 1 }, { 31, 1 }, { 35, 1 }, { 36, 0 }, { 42, 1 },
 	{ 47, 1 }, { 50, 1 }, { 67, 1 }, { 72, 1 }, { 73, 1 }, { 127, 1 }, { 128, 9 },
 	{ 129, 50000 }, { 145, 1 }, { 147, 1 }, { 150, 0 }, { 153, 0 }, { 159, 1 },
-	{ 160, 1 }, { 161, 0 }, { 166, 1 }, { 180, 1 }, { 181, 1 }, { 182, 1 },
+	{ 160, 1 }, { 161, 0 }, { 166, 0 }, { 180, 1 }, { 181, 1 }, { 182, 1 },
 	{ 216, 1 }, { 253, 0 }, { 254, 1 },
 };
 
