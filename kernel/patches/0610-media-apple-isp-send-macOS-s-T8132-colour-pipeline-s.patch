From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 20:22:38 +0000
Subject: [PATCH] media: apple: isp: send macOS's T8132 colour pipeline
 settings

macOS sets three more colour settings on the J604's camera (M4 MacBook
Pro 14", T8132) every session that this driver leaves at the firmware's
defaults: chromatic aberration reduction on (0x0164 = 1), CPP mode 1
(0x0a4b) and the lens shading strength -1.0 as an IEEE single (0x0a4c);
read with their payloads from the ISP's command channel while macOS
streamed the camera. Indoors the picture still leans magenta after the
white balance settings, and the colour shading is where these act.

Send them after the session settings on T8132, by default. A refused
setting is warned about once and the stream starts without the rest;
macos_colour_pipeline=N leaves all three at the firmware's defaults.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-cam.c | 38 ++++++++++++++++++++++
 drivers/media/platform/apple/isp/isp-cmd.h |  3 ++
 2 files changed, 41 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 71211c2adc..4be4cb37b6 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -620,6 +620,43 @@ static const struct {
  * The firmware loaded here is not the one macOS runs, so a setting it
  * refuses is reported once and the stream goes on without the rest.
  */
+/*
+ * macOS also sets this camera's colour pipeline every session: chromatic
+ * aberration reduction on, CPP mode 1 and the lens shading strength -1.0
+ * (an IEEE single). macos_colour_pipeline=N leaves them at the firmware's
+ * defaults.
+ */
+static bool macos_colour_pipeline = true;
+module_param(macos_colour_pipeline, bool, 0644);
+MODULE_PARM_DESC(macos_colour_pipeline,
+		 "Send the colour pipeline settings macOS sends this camera each session, where known (default: on)");
+
+static const struct {
+	u16 opcode;
+	u32 value;
+} isp_macos_colour[] = {
+	{ CISP_CMD_CH_CAR_ENABLE, 1 },
+	{ CISP_CMD_CH_CPP_MODE, 1 },
+	{ CISP_CMD_CH_LSC_STRENGTH_SET, 0xbf800000 },
+};
+
+static void isp_ch_macos_colour(struct apple_isp *isp, u32 ch)
+{
+	int err;
+
+	if (!READ_ONCE(macos_colour_pipeline) || !isp->hw->macos_session_settings)
+		return;
+	for (unsigned int i = 0; i < ARRAY_SIZE(isp_macos_colour); i++) {
+		err = isp_cmd_ch_u32_set(isp, isp_macos_colour[i].opcode, ch,
+					 isp_macos_colour[i].value);
+		if (err) {
+			dev_warn_once(isp->dev, "colour setting 0x%04x refused: %d\n",
+				      isp_macos_colour[i].opcode, err);
+			return;
+		}
+	}
+}
+
 static void isp_ch_macos_session(struct apple_isp *isp, u32 ch)
 {
 	int err;
@@ -1447,6 +1484,7 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 		return err;
 
 	isp_ch_macos_session(isp, ch);
+	isp_ch_macos_colour(isp, ch);
 
 	err = isp_cmd_ch_sif_pixel_format_set(isp, ch);
 	if (err)
diff --git a/drivers/media/platform/apple/isp/isp-cmd.h b/drivers/media/platform/apple/isp/isp-cmd.h
index a14dd034cd..b173b17b5d 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.h
+++ b/drivers/media/platform/apple/isp/isp-cmd.h
@@ -47,6 +47,7 @@
 #define CISP_CMD_CH_SET_META_DATA_REQUIRED		     0x014f
 #define CISP_CMD_CH_BUFFER_POOL_RETURN			     0x015b
 #define CISP_CMD_CH_CAMERA_AGILE_FREQ_ARRAY_CURRENT_GET	     0x015e
+#define CISP_CMD_CH_CAR_ENABLE				     0x0164
 #define CISP_CMD_CH_AE_START				     0x0200
 #define CISP_CMD_CH_AE_STOP				     0x0201
 #define CISP_CMD_CH_AE_BIAS_EXPOSURE_SET		     0x0204
@@ -73,6 +74,8 @@
 #define CISP_CMD_CH_ALS_DISABLE				     0x0a1d
 #define CISP_CMD_CH_CNR_START				     0x0a2f
 #define CISP_CMD_CH_MBNR_ENABLE				     0x0a3a
+#define CISP_CMD_CH_CPP_MODE				     0x0a4b
+#define CISP_CMD_CH_LSC_STRENGTH_SET			     0x0a4c
 #define CISP_CMD_CH_HDRC_ENABLE				     0x0a48
 #define CISP_CMD_CH_LSC_IDEAL_PERCENT_SET		     0x0a4e
 #define CISP_CMD_CH_OUTPUT_CONFIG_SET			     0x0b01
-- 
