From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 07:25:30 -0600
Subject: [PATCH] thermal: core: Add a counted zone lookup by name

thermal_zone_get_zone_by_name() returns a pointer that is no longer
protected once thermal_list_lock is dropped, so a caller that samples a
zone, walks its trips or asks thermal_trip_is_bound_to_cdev() about them
races with the zone's removal.

Add thermal_zone_get_by_name(), which takes the zone device reference
under the registry lock as thermal_zone_get_by_id() does, and
thermal_zone_put() to drop it. Zone removal already waits for device
references before freeing the zone. Rebuild
thermal_zone_get_temp_by_name() on top of the new helper; its behaviour
is unchanged.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/thermal/thermal_core.c | 77 ++++++++++++++++++++++++----------
 include/linux/thermal.h        |  7 ++++
 2 files changed, 63 insertions(+), 21 deletions(-)

diff --git a/drivers/thermal/thermal_core.c b/drivers/thermal/thermal_core.c
index 3711c0e7ca..fb6c5804ae 100644
--- a/drivers/thermal/thermal_core.c
+++ b/drivers/thermal/thermal_core.c
@@ -1689,43 +1689,78 @@ struct thermal_zone_device *thermal_zone_get_zone_by_name(const char *name)
 EXPORT_SYMBOL_GPL(thermal_zone_get_zone_by_name);
 
 /**
- * thermal_zone_get_temp_by_name() - sample a uniquely named registered zone
+ * thermal_zone_get_by_name() - get a counted reference to a named zone
  * @name: thermal zone name
- * @temp: destination for the temperature in millidegrees Celsius
  *
  * Acquire the zone device reference under the registry lock, as in
  * thermal_zone_get_by_id(). Removal waits for device references before freeing
- * the zone. Sampling can therefore sleep without holding thermal_list_lock.
- * No borrowed thermal-zone pointer escapes to the caller.
+ * the zone, so the caller may sleep, sample the zone, walk its trips and query
+ * their bindings until it calls thermal_zone_put(). Unlike
+ * thermal_zone_get_zone_by_name(), no borrowed pointer escapes the lock.
+ *
+ * Return: the zone, or ERR_PTR(-EINVAL) for an invalid name, ERR_PTR(-ENODEV)
+ * for no match, ERR_PTR(-EEXIST) for duplicate names.
+ */
+struct thermal_zone_device *thermal_zone_get_by_name(const char *name)
+{
+	struct thermal_zone_device *pos, *zone = NULL;
+
+	if (!name)
+		return ERR_PTR(-EINVAL);
+
+	guard(mutex)(&thermal_list_lock);
+
+	list_for_each_entry(pos, &thermal_tz_list, node) {
+		if (strncasecmp(name, pos->type, THERMAL_NAME_LENGTH))
+			continue;
+		if (zone)
+			return ERR_PTR(-EEXIST);
+		zone = pos;
+	}
+	if (!zone)
+		return ERR_PTR(-ENODEV);
+	get_device(&zone->device);
+	return zone;
+}
+EXPORT_SYMBOL_GPL(thermal_zone_get_by_name);
+
+/**
+ * thermal_zone_put() - drop a reference taken by thermal_zone_get_by_name()
+ * @tz: the zone, or NULL
+ */
+void thermal_zone_put(struct thermal_zone_device *tz)
+{
+	if (tz)
+		put_device(&tz->device);
+}
+EXPORT_SYMBOL_GPL(thermal_zone_put);
+
+/**
+ * thermal_zone_get_temp_by_name() - sample a uniquely named registered zone
+ * @name: thermal zone name
+ * @temp: destination for the temperature in millidegrees Celsius
+ *
+ * Sampling can sleep without holding thermal_list_lock, see
+ * thermal_zone_get_by_name(). No borrowed thermal-zone pointer escapes to the
+ * caller.
  *
  * Return: 0 on success, -EINVAL for invalid arguments, -ENODEV for no match,
  * -EEXIST for duplicate names, or the temperature read error.
  */
 int thermal_zone_get_temp_by_name(const char *name, int *temp)
 {
-	struct thermal_zone_device *pos, *zone = NULL;
+	struct thermal_zone_device *zone;
 	int ret;
 
-	if (!name || !temp)
+	if (!temp)
 		return -EINVAL;
 
-	{
-		guard(mutex)(&thermal_list_lock);
-
-		list_for_each_entry(pos, &thermal_tz_list, node) {
-			if (strncasecmp(name, pos->type, THERMAL_NAME_LENGTH))
-				continue;
-			if (zone)
-				return -EEXIST;
-			zone = pos;
-		}
-		if (!zone)
-			return -ENODEV;
-		get_device(&zone->device);
-	}
+	zone = thermal_zone_get_by_name(name);
+	if (IS_ERR(zone))
+		return PTR_ERR(zone);
 
 	ret = thermal_zone_get_temp(zone, temp);
-	put_device(&zone->device);
+	thermal_zone_put(zone);
 	return ret;
 }
 EXPORT_SYMBOL_GPL(thermal_zone_get_temp_by_name);
diff --git a/include/linux/thermal.h b/include/linux/thermal.h
index e7122d12e2..fed4a76cff 100644
--- a/include/linux/thermal.h
+++ b/include/linux/thermal.h
@@ -303,6 +303,8 @@ devm_thermal_cooling_device_register(struct device *dev, const char *type, void
 void thermal_cooling_device_update(struct thermal_cooling_device *);
 void thermal_cooling_device_unregister(struct thermal_cooling_device *);
 struct thermal_zone_device *thermal_zone_get_zone_by_name(const char *name);
+struct thermal_zone_device *thermal_zone_get_by_name(const char *name);
+void thermal_zone_put(struct thermal_zone_device *tz);
 int thermal_zone_get_temp(struct thermal_zone_device *tz, int *temp);
 int thermal_zone_get_temp_by_name(const char *name, int *temp);
 int thermal_zone_get_slope(struct thermal_zone_device *tz);
@@ -357,6 +359,11 @@ static inline void thermal_cooling_device_unregister(
 static inline struct thermal_zone_device *thermal_zone_get_zone_by_name(
 		const char *name)
 { return ERR_PTR(-ENODEV); }
+static inline struct thermal_zone_device *thermal_zone_get_by_name(
+		const char *name)
+{ return ERR_PTR(-ENODEV); }
+static inline void thermal_zone_put(struct thermal_zone_device *tz)
+{ }
 static inline int thermal_zone_get_temp(
 		struct thermal_zone_device *tz, int *temp)
 { return -ENODEV; }
