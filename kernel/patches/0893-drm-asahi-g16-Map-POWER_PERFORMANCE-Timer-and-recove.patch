From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 07:30:16 +0000
Subject: [PATCH] drm/asahi: g16: Map POWER_PERFORMANCE, Timer and
 recovery cached by default

macOS 26B123 maps POWER_PERFORMANCE, Timer and the recovery activity
ASC-cached on the J604, in the same firmware-VA block as Runtime and
Main, which this driver already maps that way. Set g16_init_cached's
default to 0x7 so these three init objects get the same class.

g16_init_cached=0 restores the previous mappings.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/asahi_core.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_core.rs b/drivers/gpu/drm/asahi/asahi_core.rs
index c098783af0..a46de82822 100644
--- a/drivers/gpu/drm/asahi/asahi_core.rs
+++ b/drivers/gpu/drm/asahi/asahi_core.rs
@@ -308,8 +308,8 @@ fn init(module: &'static kernel::ThisModule) -> impl PinInit<Self, Error> {
             description: "G16: macOS INIT words beyond the Main table, bit mask (default 0: none)",
         },
         g16_init_cached: u32 {
-            default: 0,
-            description: "G16: init objects ASC-cached as on macOS, bit mask (default 0: none)",
+            default: 7,
+            description: "G16: init objects ASC-cached as on macOS, bit mask (default 0x7)",
         },
         g16_recovery: u32 {
             default: 1,
-- 
2.43.0

