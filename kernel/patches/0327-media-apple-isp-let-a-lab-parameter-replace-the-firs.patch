From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 03:15:41 +0000
Subject: [PATCH] media: apple: isp: let a lab parameter replace the
 first sensor preset

The firmware of the J604 camera reports thirteen sensor configurations,
from 1520x1440 binned windows to a 3072x3024 window of the 4032x3024
array, some with two exposures per frame and some at 60 frames per
second. The device tree offers one of them, a 1920x1080 window at the
native pixel pitch, so trying another needs a new device tree.

Add apple_isp.lab_preset, empty by default and read at probe, that
replaces the first device tree preset with a configuration index, input
size, crop and output size given on the command line. It is checked
like a device tree preset: even values, the crop inside the input and
the output at the crop's aspect ratio without enlarging it. Anything
else is refused with a warning and the device tree preset is kept; an
accepted override is logged as a warning, since it is meant for
measurements only.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-drv.c | 61 ++++++++++++++++++++++
 1 file changed, 61 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index b0c6b0c9cf..c55becb460 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -8,6 +8,7 @@
 #include <linux/io.h>
 #include <linux/iommu.h>
 #include <linux/module.h>
+#include <linux/moduleparam.h>
 #include <linux/of_address.h>
 #include <linux/of_device.h>
 #include <linux/of_platform.h>
@@ -417,6 +418,65 @@ static int isp_of_read_coord(struct device *dev, struct device_node *np,
 	return 0;
 }
 
+/*
+ * The first preset can be replaced for a lab measurement of another firmware
+ * sensor configuration, without a new device tree:
+ * "config,in_w,in_h,crop_x,crop_y,crop_w,crop_h,out_w,out_h". The crop lies
+ * inside the input (whose height may stack exposures), every value is even,
+ * and the output keeps the crop's aspect ratio without enlarging it, as for
+ * the device tree presets. Anything else is refused and the device tree
+ * preset is kept. Empty, the default, changes nothing.
+ */
+static char *lab_preset = "";
+module_param(lab_preset, charp, 0444);
+MODULE_PARM_DESC(lab_preset,
+		 "Lab: replace the first sensor preset, \"config,in_w,in_h,crop_x,crop_y,crop_w,crop_h,out_w,out_h\" (default: empty)");
+
+static void apple_isp_lab_preset(struct apple_isp *isp)
+{
+	struct isp_preset p = {};
+	u32 v[9];
+
+	if (!lab_preset || !lab_preset[0])
+		return;
+
+	if (sscanf(lab_preset, "%u,%u,%u,%u,%u,%u,%u,%u,%u", &v[0], &v[1], &v[2],
+		   &v[3], &v[4], &v[5], &v[6], &v[7], &v[8]) != 9)
+		goto refuse;
+
+	p.index = v[0];
+	p.input_dim = (struct coord){ v[1], v[2] };
+	p.crop_offset = (struct coord){ v[3], v[4] };
+	p.crop_size = (struct coord){ v[5], v[6] };
+	p.output_dim = (struct coord){ v[7], v[8] };
+
+	if (p.index >= ISP_MAX_SENSOR_CONFIGS ||
+	    (p.input_dim.x | p.input_dim.y | p.crop_offset.x | p.crop_offset.y |
+	     p.crop_size.x | p.crop_size.y | p.output_dim.x | p.output_dim.y) & 1 ||
+	    !p.crop_size.x || !p.crop_size.y || !p.output_dim.x || !p.output_dim.y ||
+	    p.input_dim.x > 16384 || p.input_dim.y > 16384 ||
+	    p.crop_offset.x > p.input_dim.x ||
+	    p.crop_size.x > p.input_dim.x - p.crop_offset.x ||
+	    p.crop_offset.y > p.input_dim.y ||
+	    p.crop_size.y > p.input_dim.y - p.crop_offset.y ||
+	    p.crop_size.x < p.output_dim.x || p.crop_size.y < p.output_dim.y ||
+	    (u64)p.crop_size.x * p.output_dim.y !=
+	    (u64)p.crop_size.y * p.output_dim.x)
+		goto refuse;
+
+	dev_warn(isp->dev,
+		 "lab preset: config %u, input %ux%u, crop %u,%u %ux%u, output %ux%u replaces %ux%u\n",
+		 p.index, p.input_dim.x, p.input_dim.y, p.crop_offset.x,
+		 p.crop_offset.y, p.crop_size.x, p.crop_size.y, p.output_dim.x,
+		 p.output_dim.y, isp->presets[0].output_dim.x,
+		 isp->presets[0].output_dim.y);
+	isp->presets[0] = p;
+	return;
+
+refuse:
+	dev_warn(isp->dev, "lab preset refused, device tree presets kept\n");
+}
+
 static int apple_isp_init_presets(struct apple_isp *isp)
 {
 	struct device *dev = isp->dev;
@@ -474,6 +534,7 @@ static int apple_isp_init_presets(struct apple_isp *isp)
 		preset++;
 	}
 
+	apple_isp_lab_preset(isp);
 	return 0;
 }
 
