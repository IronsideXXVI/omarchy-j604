             RENDER_CHAINED.load(Ordering::Relaxed),
             RENDER_NOWAIT.load(Ordering::Relaxed)
         )?;
+        {
+            let bg = &super::bell_group::N;
+            writeln!(
+                f,
+                "render_bell: group {} owed {} rung {} deferred {} paid {} settled {}",
+                super::bell_group::group(params::render_bell_group()),
+                super::bell_group::OWED.load(Ordering::Relaxed),
+                bg[0].load(Ordering::Relaxed),
+                bg[1].load(Ordering::Relaxed),
+                bg[2].load(Ordering::Relaxed),
+                bg[3].load(Ordering::Relaxed)
+            )?;
+        }
         writeln!(
             f,
             "compute_queues: n {} published {:?} last {} waits {}",
