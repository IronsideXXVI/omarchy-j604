From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 20:45:11 +0000
Subject: [PATCH] soc: apple: s2r: refuse an abort_before that no step
 reaches

abort_before stops ->enter only where a step checks it. A step left out
through skip returns before its check, T8132 has no clock generator or
PLL registers so steps 8 and 9 are never checked there, step 9 is never
checked on any SoC, and the appended coprocessor refusal number is not a
step at all. Each of these goes on into a real power-down, which is the
opposite of what a bring-up run asked for.

Refuse such a value before ->enter does anything.

abort_before is 0 by default; then nothing changes.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/apple-s2r.c | 36 +++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index efdd940abb..24504f71fd 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -976,6 +976,36 @@ static int apple_s2r_step(struct apple_s2r *s2r, enum apple_s2r_step step,
 	return fn();
 }
 
+/*
+ * Whether ->enter really stops at abort_before: a step left out by skip, a
+ * step this SoC doesn't have, or a number no step checks would go on into a
+ * real power-down instead.
+ */
+static bool apple_s2r_abort_reachable(struct apple_s2r *s2r, unsigned int ab)
+{
+	static const unsigned long step_done[] = {
+		[S2R_STEP_CPM]		= S2R_DONE_CPM,
+		[S2R_STEP_AFR]		= S2R_DONE_AFR,
+		[S2R_STEP_SOC_CLUSTERS]	= S2R_DONE_SOC_CLUSTERS,
+		[S2R_STEP_SIO]		= S2R_DONE_SIO,
+		[S2R_STEP_WAKE]		= S2R_DONE_WAKE,
+	};
+
+	switch (ab) {
+	case S2R_STEP_NONE:
+	case S2R_STEP_PARKED:
+	case S2R_STEP_ACC:
+	case S2R_STEP_SUSPEND:
+		return true;
+	case S2R_STEP_CPM ... S2R_STEP_WAKE:
+		return !(skip & step_done[ab]);
+	case S2R_STEP_CLKGEN:
+		return s2r->clkgen && s2r->pll && !(skip & S2R_DONE_CLOCKS);
+	default:
+		return false;
+	}
+}
+
 static int apple_s2r_enter(suspend_state_t state)
 {
 	struct apple_s2r *s2r = apple_s2r;
@@ -987,6 +1017,12 @@ static int apple_s2r_enter(suspend_state_t state)
 		return -EBUSY;
 	}
 
+	if (!apple_s2r_abort_reachable(s2r, READ_ONCE(abort_before))) {
+		pr_warn("apple-s2r: abort_before=%u is never reached here: refused\n",
+			READ_ONCE(abort_before));
+		return -EINVAL;
+	}
+
 	s2r->done = 0;
 	s2r->resumed = false;
 	s2r->failed_step = S2R_STEP_NONE;
