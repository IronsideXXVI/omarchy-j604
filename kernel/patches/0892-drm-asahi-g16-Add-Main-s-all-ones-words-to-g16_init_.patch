From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 07:25:45 +0000
Subject: [PATCH] drm/asahi: g16: Add Main's all-ones words to
 g16_init_macos

macOS 26B123 sets the twelve Main words after the ones the firmware's
init copies, +0x26d0..+0x26fc, to 0xffffffff on the J604. The shift
that places the copied words here (+0x11c) puts them at
+0x25b4..+0x25e0, which this encoder leaves 0.

Write them under a new g16_init_macos bit, 0x20000, default off.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/fw/initdata.rs | 21 +++++++++++++++++++--
 drivers/gpu/drm/asahi/g16/initdata.rs    |  5 +++--
 2 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/fw/initdata.rs b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
index 11068642cc..2232f99273 100644
--- a/drivers/gpu/drm/asahi/g16/fw/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
@@ -401,7 +401,9 @@ pub(crate) mod init_macos {
     /// [`PP_THERMAL`]: the two thermal-limit words of [`PP`] alone; only with
     /// `g16_fw_controllers`.
     pub(crate) const PP_THERMAL_WORDS: u32 = 1 << 16;
-    pub(crate) const ALL: u32 = 0x1ffff;
+    /// [`MAIN_ALL_ONES`]: twelve Main words macOS sets to all ones after the init-copied ones.
+    pub(crate) const MAIN_ALL_ONES_WORDS: u32 = 1 << 17;
+    pub(crate) const ALL: u32 = 0x3ffff;
 
     pub(crate) const RUNTIME_LOG: usize = 0x250;
     pub(crate) const RUNTIME_TIMER_COPY: usize = 0x8;
@@ -525,6 +527,11 @@ pub(crate) mod init_macos {
     /// +0x25ac (26B123 +0x26b4..+0x26c8) in the same order, which places them here.
     pub(crate) const MAIN_INIT_COPY: [(usize, u32); 3] = [(0x25a4, 1), (0x25a8, 1), (0x25ac, 1)];
 
+    /// 26B123 Main +0x26d0..+0x26fc = 0xffffffff, placed by the +0x11c shift that holds for
+    /// the init-copied words just before them (+0x2598..+0x25b0).
+    pub(crate) const MAIN_ALL_ONES_AT: usize = 0x25b4;
+    pub(crate) const MAIN_ALL_ONES_COUNT: usize = 12;
+
     const fn within(words: &[(usize, u32)], size: usize) -> bool {
         let mut i = 0;
         while i < words.len() {
@@ -542,6 +549,7 @@ const fn within(words: &[(usize, u32)], size: usize) -> bool {
     const _: () = assert!(RUNTIME_COUNT_TABLE + 8 <= OBJECT_SIZE[id::RUNTIME]);
     const _: () = assert!(within(&MAIN_LOW, 0x640));
     const _: () = assert!(within(&MAIN_INIT_COPY, OBJECT_SIZE[id::MAIN]));
+    const _: () = assert!(MAIN_ALL_ONES_AT + 4 * MAIN_ALL_ONES_COUNT <= 0x2604);
     const _: () = assert!(MAIN_RETENTION + 8 <= OBJECT_SIZE[id::MAIN]);
     const _: () = assert!(RUNTIME_STATS_MASK + 4 <= OBJECT_SIZE[id::RUNTIME]);
 }
@@ -1225,6 +1233,15 @@ pub(crate) fn encode(
             put32(objects[id::MAIN], at, value)?;
         }
     }
+    if bits & init_macos::MAIN_ALL_ONES_WORDS != 0 {
+        for i in 0..init_macos::MAIN_ALL_ONES_COUNT {
+            put32(
+                objects[id::MAIN],
+                init_macos::MAIN_ALL_ONES_AT + 4 * i,
+                0xffffffff,
+            )?;
+        }
+    }
     let mut groups = [
         (init_macos::POWER_WORDS, id::POWER, &init_macos::POWER[..]),
         (
@@ -1339,7 +1356,7 @@ fn the_init_macos_words_miss_the_controller_words() {
                 .iter()
                 .any(|(c, _)| c == at));
         }
-        assert_eq!(init_macos::ALL, (init_macos::PP_THERMAL_WORDS << 1) - 1);
+        assert_eq!(init_macos::ALL, (init_macos::MAIN_ALL_ONES_WORDS << 1) - 1);
         // The three Power sub-bits together are exactly POWER_WORDS's words.
         let parts = init_macos::POWER_FLOOR.len()
             + init_macos::POWER_FILTER.len()
diff --git a/drivers/gpu/drm/asahi/g16/initdata.rs b/drivers/gpu/drm/asahi/g16/initdata.rs
index 6438b17ae4..4b85319dab 100644
--- a/drivers/gpu/drm/asahi/g16/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/initdata.rs
@@ -333,11 +333,12 @@ pub(crate) fn build(
         if m >> 13 != 0 {
             dev_info!(
                 dev,
-                "M4 initdata: g16_init_macos: power-floor {} power-filter {} power-limits {} pp-thermal {}\n",
+                "M4 initdata: g16_init_macos: power-floor {} power-filter {} power-limits {} pp-thermal {} main-ff {}\n",
                 (m >> 13) & 1,
                 (m >> 14) & 1,
                 (m >> 15) & 1,
-                (m >> 16) & 1
+                (m >> 16) & 1,
+                (m >> 17) & 1
             );
         }
         if m & (wire::init_macos::PP_WORDS
