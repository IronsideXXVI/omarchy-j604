From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 06:51:27 +0000
Subject: [PATCH] drm/asahi: G16: keep the render queues on row 2 by
 default

Row 0, as macOS keeps its render queues, did not shorten render.light on J604 (155.5 us per
submit at depth 64 against 153.8 on row 2) and tripled each render job's GPU time (22.6 to
67 us; render.heavy 416 to 468 us). Make g16_render_row0=0 the default; 1 still selects
row 0.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/params.rs | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index bc2896672f..5674a7dd9b 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -1075,8 +1075,12 @@ pub(crate) fn power_late() -> bool {
     "G16: after READY, write Globals +0x84 (max_power_mw) = 26250 as macOS has it after INIT (default 1; 0: the INIT value stays; read at boot)"
 );
 
-/// Storage of `g16_render_row0` (0644, default 1; read when the queue graphs are built).
-static RENDER_ROW0: AtomicU32 = AtomicU32::new(1);
+/// Storage of `g16_render_row0` (0644, default 0; read when the queue graphs are built).
+///
+/// Off by default: on J604 1.922 row 0 left render.light at 155.5 us per submit at depth 64
+/// (153.8 on row 2) while each render job's GPU time rose from 22.6 to 67 us, render.heavy's
+/// from 416 to 468 us.
+static RENDER_ROW0: AtomicU32 = AtomicU32::new(0);
 
 /// Whether the render (TA and FS) queues carry scheduling row 0 (class 0), as macOS 26B123
 /// keeps its render queues, instead of row 2 (class 2), which it keeps on compute queues.
@@ -1090,7 +1094,7 @@ pub(crate) fn render_row0() -> bool {
     RENDER_ROW0_PARM,
     RENDER_ROW0,
     "g16_render_row0",
-    "G16: render queues on scheduling row 0 (class 0) as macOS keeps them (default 1; 0: row 2, the compute row, as before; read when the queue graphs are built)"
+    "G16: render queues on scheduling row 0 (class 0) as macOS keeps them (default 0: row 2, the compute row; 1: row 0; read when the queue graphs are built)"
 );
 
 /// Storage of `g16_globals_required` (0644, default 1; read when the initdata is built).
-- 
2.43.0

