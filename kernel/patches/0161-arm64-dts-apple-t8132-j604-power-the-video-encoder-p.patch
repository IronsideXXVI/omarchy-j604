From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 03:40:48 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: power the video
 encoder, probe only

Enable the VENC power states, both encoder DARTs and the encoder node
on the J604. m1n1 already hands over the firmware iBoot preloads (the
two memory-region reservations and their CRCs in /chosen), and the
T8132 variant of the driver is probe only: it checks the segment sizes,
the DART mappings and the CRCs, logs them, and never starts the
coprocessor or reads its registers. This is the first time the VENC
domains and DARTs are powered under Linux on this machine.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 33ec1655187fe517ad72a57c1a05c69c4e29d038)
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 23 ++++++++++++++-----
 1 file changed, 17 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index 60e42640a1..af48874a3a 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -464,8 +464,9 @@ &ps_afiaft {
 	status = "disabled";
 };
 
+/* Video encoder (probe only): VENC_SYS is the parent of VENC_DMA. */
 &ps_venc_sys {
-	status = "disabled";
+	status = "okay";
 };
 
 &ps_spi1 {
@@ -705,23 +706,23 @@ &ps_sep {
 };
 
 &ps_venc_dma {
-	status = "disabled";
+	status = "okay";
 };
 
 &ps_venc_pipe4 {
-	status = "disabled";
+	status = "okay";
 };
 
 &ps_venc_pipe5 {
-	status = "disabled";
+	status = "okay";
 };
 
 &ps_venc_me0 {
-	status = "disabled";
+	status = "okay";
 };
 
 &ps_venc_me1 {
-	status = "disabled";
+	status = "okay";
 };
 
 &ps_ane_mpm {
@@ -868,11 +869,21 @@ &dart_scaler0 {
 &dart_ave0 {
 	apple,dma-range = <0x100 0x00 0x300 0x00>;
 	power-domains = <&ps_venc_dma>;
+	status = "okay";
 };
 
 &dart_ave1 {
 	apple,dma-range = <0x100 0x00 0x300 0x00>;
 	power-domains = <&ps_venc_dma>;
+	status = "okay";
+};
+
+/*
+ * The T8132 variant of the driver is probe only: it checks the firmware
+ * m1n1 hands over (CRCs, DART mappings) and never starts the coprocessor.
+ */
+&ave {
+	status = "okay";
 };
 
 &mesa {
-- 
