+"	b	cpu_resume\n"
 "	.balign	2048\n"
 "	.globl	t8132_wake_vectors\n"
 "	.type	t8132_wake_vectors, %object\n"
@@ -3391,6 +3532,79 @@ asm(
 "	.popsection\n"
 );
 void t8132_resume_stub(void);
+void t8132_resume_stub_min(void);
+void t8132_resume_stub_nodsb(void);
+void t8132_resume_stub_ic(void);
+void t8132_resume_stub_hid(void);
+
+/*
+ * Wake variants, so one kernel can try several deep wakes back to back. Every default is
+ * today's path; each flag answers one question.
+ */
+static unsigned int wake_stub;
+module_param(wake_stub, uint, 0644);
+MODULE_PARM_DESC(wake_stub, "T8132 resume stub: 0 today, 1 #1314 as merged (WD2 60 s only), 2 no dsb after the WD2 stores, 3 I-cache invalidate before cpu_resume, 4 restore wake_hid_mask registers");
+static unsigned long wake_hid_mask;
+module_param(wake_hid_mask, ulong, 0644);
+MODULE_PARM_DESC(wake_hid_mask, "wake_stub=4: boot-core registers saved before the commit and restored by the stub (bit n = t8132_hid_regs[n]; set only bits pwrhid read on cpu0)");
+static bool wake_clean_image;
+module_param(wake_clean_image, bool, 0644);
+MODULE_PARM_DESC(wake_clean_image, "clean the whole kernel image to the PoC before the commit");
+static bool wake_init_marks;
+module_param(wake_init_marks, bool, 0644);
+MODULE_PARM_DESC(wake_init_marks, "WD2 mark (175 s) inside init_kernel_el on the wake");
+
+/* Read by the wake_stub=4 stub with the MMU off: [0] = mask, [1 + n] = register n. */
+u64 t8132_wake_hid[24] __section(".mmuoff.data.read");
+
+#define T8132_HID_SAVE(n, enc)						\
+	do {								\
+		if (wake_hid_mask & BIT(n))				\
+			t8132_wake_hid[1 + (n)] = read_sysreg_s(enc);	\
+	} while (0)
+
+static void t8132_wake_hid_save(void)
+{
+	T8132_HID_SAVE(0, sys_reg(3, 0, 15, 0, 0));
+	T8132_HID_SAVE(1, sys_reg(3, 0, 15, 1, 0));
+	T8132_HID_SAVE(2, sys_reg(3, 0, 15, 2, 0));
+	T8132_HID_SAVE(3, sys_reg(3, 0, 15, 3, 0));
+	T8132_HID_SAVE(4, sys_reg(3, 0, 15, 4, 0));
+	T8132_HID_SAVE(5, sys_reg(3, 0, 15, 5, 0));
+	T8132_HID_SAVE(6, sys_reg(3, 0, 15, 6, 0));
+	T8132_HID_SAVE(7, sys_reg(3, 0, 15, 7, 0));
+	T8132_HID_SAVE(8, sys_reg(3, 0, 15, 8, 0));
+	T8132_HID_SAVE(9, sys_reg(3, 0, 15, 9, 0));
+	T8132_HID_SAVE(10, sys_reg(3, 0, 15, 10, 0));
+	T8132_HID_SAVE(11, sys_reg(3, 0, 15, 11, 0));
+	T8132_HID_SAVE(12, sys_reg(3, 0, 15, 12, 0));
+	T8132_HID_SAVE(13, sys_reg(3, 0, 15, 14, 0));
+	T8132_HID_SAVE(14, sys_reg(3, 0, 15, 15, 0));
+	T8132_HID_SAVE(15, sys_reg(3, 0, 15, 15, 2));
+	T8132_HID_SAVE(16, sys_reg(3, 0, 15, 11, 2));
+	T8132_HID_SAVE(17, sys_reg(3, 0, 15, 1, 3));
+	T8132_HID_SAVE(18, sys_reg(3, 0, 15, 0, 3));
+	T8132_HID_SAVE(19, sys_reg(3, 0, 15, 0, 4));
+	T8132_HID_SAVE(20, sys_reg(3, 5, 15, 4, 0));
+	T8132_HID_SAVE(21, sys_reg(3, 5, 15, 5, 0));
+	T8132_HID_SAVE(22, sys_reg(3, 5, 15, 6, 0));
+	t8132_wake_hid[0] = wake_hid_mask & GENMASK(22, 0);
+	dcache_clean_inval_poc((unsigned long)t8132_wake_hid,
+			       (unsigned long)t8132_wake_hid + sizeof(t8132_wake_hid));
+}
+
+static void *t8132_wake_entry(void)
+{
+	switch (READ_ONCE(wake_stub)) {
+	case 1: return t8132_resume_stub_min;
+	case 2: return t8132_resume_stub_nodsb;
+	case 3: return t8132_resume_stub_ic;
+	case 4:
+		t8132_wake_hid_save();
+		return t8132_resume_stub_hid;
+	default: return t8132_resume_stub;
+	}
+}
 
 /* Read by cpu_resume with the MMU off: restart WD2 at each step of the wake. */
 u32 t8132_wake_marks __section(".mmuoff.data.read");
@@ -3490,8 +3704,11 @@ static int apple_sleep_enter(suspend_state_t state)
 
 	s->cntkctl = read_sysreg(cntkctl_el1);
 	pm_set_resume_via_firmware();
-	if (s->soc->ops->resume == t8132_resume_stub)
-		t8132_wake_marks_set(1);
+	if (s->soc->ops->resume == t8132_resume_stub) {
+		if (READ_ONCE(wake_clean_image))
+			dcache_clean_poc((unsigned long)_text, (unsigned long)_end);
+		t8132_wake_marks_set(READ_ONCE(wake_init_marks) ? 3 : 1);
+	}
 	ret = cpu_suspend(0, apple_sleep_commit);
 	if (ret)
 		panic("Apple committed sleep returned without physical wake: %d", ret);
