From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 19 Nov 2026 07:39:14 +0000
Subject: [PATCH] drm/asahi: g16: Run long compute on two firmware
 queues by default

Measured with g16_compute_queues=2 and g16_cq_split_us=100 against one
queue on experimental 1.1089, each on a boot of its own: compute.heavy
depth 64 557.8 -> 547.3 us (-1.9 %); compute.light depth 1 150.5 ->
153.0 us (+1.6 %), depth 8 32.6 -> 32.9 us, depth 64 19.0 -> 19.3 us;
a mixed render and compute stress load completed 61,448 -> 61,767
checked results in 12 s; every stress seed passed and no GPU fault
appeared. The render rows were not part of that comparison.

g16_compute_queues now defaults to 2 and g16_cq_split_us to 100. A
compute command that names no running command goes to the firmware
compute queue after its predecessor's when its client's recent compute
commands ran 100 us or longer each, so two long independent commands
run at once. Clients with shorter commands stay on one queue, where a
second queue gained them nothing and rotating them cost about 1 us per
command.

Each queue carries its own id, numbers its own target stamps and has
its own compute sequence slots, so the compute sequence pool and the
compute work pool stay on. g16_compute_queues=1 restores one queue, and
g16_cq_split_us=0 rotates every independent command.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index ab5edeb3a0..30a7a50b71 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -1000,8 +1000,8 @@ pub(crate) fn compute_units() -> usize {
     "G16: compute units per VM, one compute command in flight each (default 32; 2..32 with g16_compute_shared_pool 1 or 2, where unit 0 holds the pool and the others only their save areas; 2..16 with g16_compute_shared_pool 0, ~33 MiB per unit, which takes 32 as 16; 16 up to 1.1056; latched at the engine start, set it as a module option)"
 );
 
-/// Storage of `g16_compute_queues` (0644, default 1; latched at the engine start).
-static COMPUTE_QUEUES: AtomicU32 = AtomicU32::new(1);
+/// Storage of `g16_compute_queues` (0644, default 2; latched at the engine start).
+static COMPUTE_QUEUES: AtomicU32 = AtomicU32::new(2);
 /// The latched compute queues, 0 until latched.
 static COMPUTE_QUEUES_LATCH: AtomicU32 = AtomicU32::new(0);
 
@@ -1036,7 +1036,7 @@ pub(crate) fn compute_queues() -> usize {
     COMPUTE_QUEUES_PARM,
     COMPUTE_QUEUES,
     "g16_compute_queues",
-    "G16: firmware compute queues (default 1: one, as before; 2..4: a compute command that names no running command goes to the next queue, ids 16..18, each flight proved on its own queue; pool mode 2 only; latched at the engine start, set it as a module option)"
+    "G16: firmware compute queues (default 2; 1: one, as before; 2..4: a compute command that names no running command goes to the next queue, ids 16..18, each flight proved on its own queue; pool mode 2 only; latched at the engine start, set it as a module option)"
 );
 
 /// Storage of `g16_compute_shared_pool` (0644, default 2; latched at its first read).
@@ -2423,16 +2423,16 @@ pub(crate) fn check_once() -> u32 {
     "G16: 1 = within one pass, check_hangs reuses the session check that pass already ran and passed (default 1; 0 = it checks again; runtime 0644)"
 );
 
-/// Storage of `g16_cq_split_us` (runtime 0644, default 0).
-static CQ_SPLIT_US: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_cq_split_us` (runtime 0644, default 100).
+static CQ_SPLIT_US: AtomicU32 = AtomicU32::new(100);
 
 /// `g16_cq_split_us` = N, with `g16_compute_queues` above 1: a compute command whose client
 /// (VM) ran its recent compute commands in less than N us of GPU time each (a moving average
 /// of the start and end stamps of its retired commands, [`super::cqueue::span_update`]) stays
 /// on the queue of that client's previous compute command; longer ones rotate as before. Short
 /// commands gain nothing from a second queue, and rotating them costs light compute about
-/// 1 us per command (experimental 1.1075). 0: off, every independent command rotates. Read
-/// at each placement.
+/// 1 us per command (experimental 1.1075). Default 100; 0: off, every independent command
+/// rotates. Read at each placement.
 pub(crate) fn cq_split_us() -> u32 {
     CQ_SPLIT_US.load(Ordering::Relaxed)
 }
@@ -2443,7 +2443,7 @@ pub(crate) fn cq_split_us() -> u32 {
     CQ_SPLIT_US_PARM,
     CQ_SPLIT_US,
     "g16_cq_split_us",
-    "G16: with g16_compute_queues above 1, a client whose recent compute commands ran under N us each keeps its queue; longer ones rotate (default 0: off; runtime 0644)"
+    "G16: with g16_compute_queues above 1, a client whose recent compute commands ran under N us each keeps its queue; longer ones rotate (default 100; 0: off; runtime 0644)"
 );
 
 /// Storage of `g16_submit_defer` (runtime 0644, default 16).
