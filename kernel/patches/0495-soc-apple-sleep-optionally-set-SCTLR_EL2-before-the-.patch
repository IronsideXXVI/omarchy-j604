From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 12:46:30 +0000
Subject: [PATCH] soc: apple: sleep: optionally set SCTLR_EL2 before
 the T8132 stub's jump

aura never writes SCTLR_EL2 on a wake, and cpu_resume passes x0 = 0,
so init_el2 skips its "msr sctlr_el2, INIT_SCTLR_EL2_MMU_OFF" and the
wake core runs on the reset value until __enable_mmu. With
apple_sleep.t8132_stub_sctlr set (0644, off by default), the stub
writes INIT_SCTLR_EL2_MMU_OFF and an isb right before the jump.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/sleep.c | 20 +++++++++++++++++++-
 1 file changed, 19 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index 81bd0ee637..e1ec3893ec 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -3245,7 +3245,10 @@ MODULE_PARM_DESC(t8132_elchk2, "T8132 deep sleep: the resume stub also checks th
  * bit 2 t8132_stub_selftest: udf right after the catch vectors go in (a sync record,
  *       EC 0, and the 145 s window prove the catch on a real wake);
  * bit 3 t8132_stub_pet_secs (1-120): before the jump, stay that long restarting WD2
- *       for 30 s every second, then go on.
+ *       for 30 s every second, then go on;
+ * bit 4 t8132_stub_sctlr: right before the jump, SCTLR_EL2 = INIT_SCTLR_EL2_MMU_OFF and
+ *       isb (aura never writes it on a wake, and cpu_resume's x0 = 0 makes init_el2
+ *       skip it too, so the wake core otherwise runs on the reset value).
  */
 #define T8132_STUBCFG_MAGIC	0x47464353	/* "SCFG" */
 
@@ -3254,10 +3257,12 @@ struct t8132_stubcfg {
 	u32 flags;
 	u32 pet_secs;
 	u32 rsvd;
+	u64 sctlr;		/* INIT_SCTLR_EL2_MMU_OFF */
 };
 
 static_assert(offsetof(struct t8132_stubcfg, flags) == 4);
 static_assert(offsetof(struct t8132_stubcfg, pet_secs) == 8);
+static_assert(offsetof(struct t8132_stubcfg, sctlr) == 16);
 
 struct t8132_stubcfg t8132_stubcfg __aligned(64);
 
@@ -3269,6 +3274,8 @@ static bool t8132_stub_selftest;
 module_param(t8132_stub_selftest, bool, 0644);
 static unsigned int t8132_stub_pet_secs;
 module_param(t8132_stub_pet_secs, uint, 0644);
+static bool t8132_stub_sctlr;
+module_param(t8132_stub_sctlr, bool, 0644);
 
 /*
  * The first thing Linux runs after a wake, MMU off and no stack. The last wake program
@@ -3430,6 +3437,14 @@ asm(
 "\tb.lo\t67b\n"
 "\tb\t65b\n"
 "66:\n"
+/* SCTLR_EL2 (bit 4), last before the jump. */
+"\ttbz\tw22, #4, 68f\n"
+"\tadrp\tx10, t8132_stubcfg\n"
+"\tadd\tx10, x10, :lo12:t8132_stubcfg\n"
+"\tldr\tx11, [x10, #16]\n"
+"\tmsr\tsctlr_el2, x11\n"
+"\tisb\n"
+"68:\n"
 /* Both checks passed or none armed: WD2 for 105 s (0x96342600 ticks), then the jump. */
 "	str	wzr, [x9, #0x2c]\n"
 "	str	wzr, [x9, #0x20]\n"
@@ -4124,6 +4139,9 @@ static void t8132_arm_stubcfg(void)
 	c->pet_secs = min(READ_ONCE(t8132_stub_pet_secs), 120U);
 	if (c->pet_secs)
 		f |= BIT(3);
+	c->sctlr = INIT_SCTLR_EL2_MMU_OFF;
+	if (READ_ONCE(t8132_stub_sctlr))
+		f |= BIT(4);
 	c->flags = f;
 	dsb(ishst);
 	WRITE_ONCE(c->magic, f ? T8132_STUBCFG_MAGIC : 0);
-- 
2.43.0

