+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! `g16_compute_work_pool`: where a compute unit's work block goes in the session pool. Core only.
+//!
+//! Two session objects (one uncached, one ASC-cached) each hold one work block slot per compute
+//! unit index, at `k * STRIDE`. The hardware reads a block through a context-0 lower address, so
+//! each object gets a lower range reserved when the firmware session starts, before any VM exists,
+//! at the top of the per-VM work aperture, above the two render work ranges and below the
+//! self-check page. Compute units are claimed device-wide and held until their command retires, so
+//! no two commands in flight share a slot.
+
+/// Bytes per unit slot: the 0x900-byte block, padded so every block starts on its own page and no
+/// cache line is shared between two units' blocks.
+pub(crate) const STRIDE: usize = 0x1000;
+/// The block written into a slot (the work image's first 0x900 bytes).
+#[allow(dead_code)] // read only by const asserts and host tests
+pub(crate) const BLOCK: usize = 0x900;
+/// Most unit indices with a slot (the latched unit count never exceeds it).
+pub(crate) const UNITS: usize = 64;
+/// Context-0 lower addresses of the uncached [0] and ASC-cached [1] copy.
+pub(crate) const LOWER: [u64; 2] = [0x70fe100000, 0x70fe180000];
+/// The render work ranges below them (graph::RENDER_WORK_LOWER, RENDER_UNITS x 0x2000 each) and
+/// the self-check page above them; graph.rs asserts these equal its own constants.
+#[allow(dead_code)] // read only by const asserts and host tests
+pub(crate) const RENDER_LOWER: [u64; 2] = [0x70fe000000, 0x70fe080000];
+#[allow(dead_code)] // read only by const asserts and host tests
+pub(crate) const RENDER_BYTES: u64 = 18 * 0x2000;
+#[allow(dead_code)] // read only by const asserts and host tests
+pub(crate) const SELF_CHECK: u64 = 0x70ff000000;
+/// Bytes of each session object.
+pub(crate) const SIZE: usize = UNITS * STRIDE;
+
+const _: () = assert!(BLOCK <= STRIDE && STRIDE % 0x1000 == 0);
+const _: () = assert!(RENDER_LOWER[1] + RENDER_BYTES <= LOWER[0]);
+const _: () = assert!(LOWER[0] + SIZE as u64 <= LOWER[1]);
+const _: () = assert!(LOWER[1] + SIZE as u64 <= SELF_CHECK);
+
+/// Offset of unit `k`'s slot, or None above the slots (the unit then keeps its own block).
+pub(crate) fn offset(k: usize) -> Option<usize> {
+    (k < UNITS).then(|| k * STRIDE)
+}
+
+/// What a flight records about its block: 0 its unit's own block, 1 / 2 copy 0 / 1 of the pool.
+pub(crate) fn code(copy: Option<usize>) -> u8 {
+    match copy {
+        None => 0,
+        Some(c) => 1 + (c & 1) as u8,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn slots_are_distinct_page_aligned_and_inside() {
+        let mut seen = std::collections::BTreeSet::new();
+        for k in 0..UNITS {
+            let at = offset(k).unwrap();
+            assert_eq!(at % 0x1000, 0);
+            assert!(at + BLOCK <= SIZE);
+            assert!(seen.insert(at));
+            for lower in LOWER {
+                // The hardware reads the block at lower + at; the encoder needs 0x100 alignment.
+                assert_eq!((lower + at as u64) % 0x100, 0);
+            }
+        }
+        assert_eq!(offset(UNITS), None);
+        assert_eq!(offset(usize::MAX), None);
+    }
+
+    #[test]
+    fn lower_ranges_do_not_overlap() {
+        let ranges = [
+            (RENDER_LOWER[0], RENDER_LOWER[0] + RENDER_BYTES),
+            (RENDER_LOWER[1], RENDER_LOWER[1] + RENDER_BYTES),
+            (LOWER[0], LOWER[0] + SIZE as u64),
+            (LOWER[1], LOWER[1] + SIZE as u64),
+        ];
+        for (i, a) in ranges.iter().enumerate() {
+            assert!(a.1 <= SELF_CHECK);
+            for b in &ranges[i + 1..] {
+                assert!(a.1 <= b.0 || b.1 <= a.0, "{a:x?} {b:x?}");
+            }
+        }
+    }
+
+    #[test]
+    fn codes() {
+        assert_eq!(code(None), 0);
+        assert_eq!(code(Some(0)), 1);
+        assert_eq!(code(Some(1)), 2);
+    }
+}
