         if let Some(st) = stream {
@@ -2233,10 +2250,22 @@ fn prefix_compute(
             pool.write(*at, &scratch.cq[..work::compute::SEQ_SIZE])?;
             COMPUTE_SEQ_N[*copy].fetch_add(1, Ordering::Relaxed);
         }
-        s.write_work(w)?;
+        match &work_slot {
+            Some((obj, at, copy)) => {
+                let block = w.get(..work::compute::BLOCK).ok_or(EINVAL)?;
+                let rest = w.get(work::compute::BLOCK..).ok_or(EINVAL)?;
+                obj.write(*at, block)?;
+                s.work.write(work::compute::BLOCK, rest)?;
+                if let Some(c) = COMPUTE_WORK_N.get(*copy) {
+                    c.fetch_add(1, Ordering::Relaxed);
+                }
+            }
+            None => s.write_work(w)?,
+        }
+        f.cwork_copy = super::cwslot::code(work_slot.as_ref().map(|x| x.2));
         f.uma_submitted = submitted;
         wmb();
-        g.ring.w64(8 * pf.c_head as usize, s.block_va())?;
+        g.ring.w64(8 * pf.c_head as usize, work_va)?;
         pf.c_head = (pf.c_head + 1) % sizes::QUEUE_CAP;
         f.cstamp[0] = target;
         f.cwait[0] = 0;
