+/// Linux's list as an unfinished create's intent recorded it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Unfinished {
+    /// Written by a driver that did not record it.
+    Unmarked,
+    /// No guard ran with a list.
