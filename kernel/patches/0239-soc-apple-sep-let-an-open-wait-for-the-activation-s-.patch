--- /dev/null
+++ b/tools/asahi/sep-bio-open-tests.rs
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! Host tests for the hold an activating open has on /dev/sep-bio.
+
+#[path = "../../drivers/soc/apple/bio_open_gate.rs"]
+mod bio_open_gate;
+
+use bio_open_gate::Hold;
+
+/// The node's single opener, kept the way `bio::open`, `bio::opened` and
+/// `bio::release` keep it (the enrol and verify worker has its own tests).
+struct Node {
+    open: bool,
+    hold: Hold,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum Second {
+    Opens,
+    Waits,
+    Busy,
+}
+
+impl Node {
+    fn new() -> Node {
+        Node {
+            open: false,
+            hold: Hold::new(),
+        }
+    }
+
+    fn open(&mut self) -> Result<(), ()> {
+        if self.open {
+            return Err(());
+        }
+        self.open = true;
+        self.hold.begin();
+        Ok(())
+    }
+
+    fn opened(&mut self, activated: bool) {
+        if self.open {
+            self.hold.opened(activated);
+        }
+    }
+
+    fn release(&mut self) {
+        self.open = false;
+        self.hold.end();
+    }
+
+    /// What `SepData::bio_open` does with a second opener at this moment.
+    fn second(&self) -> Second {
+        if self.hold.transient(self.open) {
+            Second::Waits
+        } else if self.open {
+            Second::Busy
+        } else {
+            Second::Opens
+        }
+    }
+}
+
+// The J604 boot that failed its gate (1.841, 5a92b3b3): the activation unit
+// opened the node and was still in its restore and preflight when fprintd
+// opened it. fprintd now waits, then gets the node once the unit has closed.
+#[test]
+fn the_failed_boot_replayed_gives_fprintd_the_node() {
+    let mut node = Node::new();
+    node.open().unwrap();
+    assert_eq!(node.second(), Second::Waits, "during the activation");
+    node.opened(true);
+    assert_eq!(
+        node.second(),
+        Second::Waits,
+        "the activation's opener has not closed yet"
+    );
+    node.release();
+    assert_eq!(node.second(), Second::Opens);
+    node.open().unwrap();
+    node.opened(false);
+    assert_eq!(
+        node.second(),
+        Second::Busy,
+        "fprintd's own hold is a hold like any other"
+    );
+}
+
+// A holder that did not run the activation (it ran earlier this boot) is a
+// device in use: a second opener is refused at once, as before.
+#[test]
+fn a_holder_after_the_activation_is_busy_at_once() {
+    let mut node = Node::new();
+    node.open().unwrap();
+    node.opened(false);
+    assert_eq!(node.second(), Second::Busy);
+}
+
+// An open whose activation failed releases the node: the next opener goes on.
+#[test]
+fn a_failed_activation_frees_the_node() {
+    let mut node = Node::new();
+    node.open().unwrap();
+    node.release();
+    assert_eq!(node.second(), Second::Opens);
+    assert_eq!(node.hold, Hold::new());
+}
+
+// The activation's mark belongs to one holder: a later holder starts clean.
+#[test]
+fn a_later_holder_does_not_inherit_the_activation_mark() {
+    let mut node = Node::new();
+    node.open().unwrap();
+    node.opened(true);
+    node.release();
+    node.open().unwrap();
+    assert_eq!(node.second(), Second::Waits, "while it prepares");
+    node.opened(false);
+    assert_eq!(node.second(), Second::Busy);
+}
+
+// fprintd can be the first opener (the activation unit skipped or late): it
+// keeps the node, so a second opener's wait runs out and it is refused then.
+// The bound itself is the driver's (ACTIVATION_OPEN_WAIT_MS); here the hold
+// stays transient until fprintd closes.
+#[test]
+fn an_activating_daemon_holds_until_it_closes() {
+    let mut node = Node::new();
+    node.open().unwrap();
+    node.opened(true);
+    assert!(node.hold.transient(node.open));
+    node.release();
+    assert!(!node.hold.transient(node.open));
+}
+
+#[test]
+fn a_closed_node_is_never_waited_for() {
+    let mut hold = Hold::new();
+    hold.begin();
+    assert!(!hold.transient(false));
+    hold.opened(true);
+    assert!(!hold.transient(false));
+}
