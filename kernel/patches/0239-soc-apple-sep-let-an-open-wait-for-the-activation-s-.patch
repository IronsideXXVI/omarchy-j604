@@ -167,6 +168,11 @@
 // so it gets the same bound as a capture draining before sleep.
 const WORKER_EXIT_WAIT_MS: time::Msecs = SLEEP_DRAIN_MS;
 
+// How long an open waits for the activation's own open of /dev/sep-bio (the
+// enclave restore and the unlock preflight, then its opener's close) before it
+// is refused as busy. The activation takes under a second on a J604.
+const ACTIVATION_OPEN_WAIT_MS: time::Msecs = 5000;
+
 const SKS_ALLOC: usize = 0x8000;
 
 const SKS_SECRET_LEN: usize = 32;
