From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 21:13:58 +0000
Subject: [PATCH] soc: apple: s2r: tell each device whether its own
 power was cut

A T8132 split step from depth 2 declares the resume firmware-driven,
since ATC0 and ANS's APCIe block do lose power there. Every other user
of that flag then treats its block as reset too: the ATC PHYs of ports
1-3 restore a common block that kept its state, DARTs write back state
over live state and gate a port's DART whose port never stopped, and
the PMC and ADMAC reprogram what they kept.

Record, per split step, the power state words it lowered, and add
apple_sleep_power_lost(dev): true after a real sleep, or when one of the
device's power domains or their parents is among those words; without
the T8132 sequence it is the firmware-driven resume flag, as before. The
ATC PHY's common and CIO restores and the DART resume paths use it. The
PMC and ADMAC, which no split step touches, ask
apple_sleep_powered_down(). A host test covers which words each depth
lowers.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/dma/apple-admac.c          |   4 +-
 drivers/iommu/apple-dart.c         |  11 +--
 drivers/phy/apple/atc.c            |   7 +-
 drivers/pmdomain/apple/pmc.c       |   4 +-
 drivers/soc/apple/apple-s2r.c      | 107 +++++++++++++++++++++++++++++
 include/linux/soc/apple/sleep.h    |   6 +-
 tools/asahi/run-host-tests.py      |   3 +-
 tools/asahi/s2r-split-ans-tests.py |  31 ++++++++-
 8 files changed, 159 insertions(+), 14 deletions(-)

diff --git a/drivers/dma/apple-admac.c b/drivers/dma/apple-admac.c
index ee660cc389..d7f4833ef6 100644
--- a/drivers/dma/apple-admac.c
+++ b/drivers/dma/apple-admac.c
@@ -19,6 +19,7 @@
 #include <linux/pm_runtime.h>
 #include <linux/reset.h>
 #include <linux/spinlock.h>
+#include <linux/soc/apple/sleep.h>
 #include <linux/suspend.h>
 #include <linux/interrupt.h>
 
@@ -1126,7 +1127,8 @@ static int __maybe_unused admac_resume_early(struct device *dev)
 	unsigned long flags;
 	int i;
 
-	if (!pm_resume_via_firmware())
+	/* A split step or a refusal never takes the ADMAC's power: only a real sleep does. */
+	if (!apple_sleep_powered_down())
 		return 0;
 
 	mutex_lock(&ad->cache_alloc_lock);
diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index b27ddb6ea2..0ab9f3e893 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -32,6 +32,7 @@
 #include <linux/mm.h>
 #include <linux/module.h>
 #include <linux/soc/apple/dart.h>
+#include <linux/soc/apple/sleep.h>
 #include <linux/soc/apple/t8132.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
@@ -5838,14 +5839,14 @@ void apple_dart_sleep_restore(struct device *dev)
 			dart->sleep_unlisted = false;
 		}
 		/* Nothing was lost with the power kept; after a real sleep, all of it. */
-		if (pm_resume_via_firmware() && apple_dart_resume(dev))
+		if (apple_sleep_power_lost(dev) && apple_dart_resume(dev))
 			dev_err(dev, "restore before its consumer's restart failed\n");
 		return;
 	}
 
 	spin_lock_irqsave(&dart->lock, flags);
 	dart->sleep_saved = false;
-	if (pm_resume_via_firmware()) {
+	if (apple_sleep_power_lost(dev)) {
 		apple_dart_sleep_write_kept(dart, &dart->sleep_restore);
 		for (sid = 0; sid < dart->num_streams; sid++) {
 			if (!dart->save_tcr[sid] && !dart->save_ttbr[sid][0])
@@ -6131,7 +6132,7 @@ static __maybe_unused int apple_dart_resume_noirq(struct device *dev)
 	 * After a real sleep a DART clocked by its host's port reads nothing until the host
 	 * sets the port up again. Gate it, so that nothing touches it, until then.
 	 */
-	if (dart->host_resumes && pm_resume_via_firmware()) {
+	if (dart->host_resumes && apple_sleep_power_lost(dev)) {
 		scoped_guard(spinlock_irqsave, &dart->lock)
 			WRITE_ONCE(dart->commands_gated, true);
 		return pm_runtime_force_resume(dev);
@@ -6146,7 +6147,7 @@ static __maybe_unused int apple_dart_resume_noirq(struct device *dev)
 	 * own sleep list, as the SEP's: its consumer restores that with macOS's writes before
 	 * starting its firmware, and this would land on top.
 	 */
-	if (!ret && pm_resume_via_firmware() && pm_runtime_status_suspended(dev) &&
+	if (!ret && apple_sleep_power_lost(dev) && pm_runtime_status_suspended(dev) &&
 	    !dart->sleep_restore.count) {
 		ret = apple_dart_resume(dev);
 		if (ret)
@@ -6154,7 +6155,7 @@ static __maybe_unused int apple_dart_resume_noirq(struct device *dev)
 		else
 			dev_dbg(dev, "restored after sleep\n");
 	}
-	if (pm_resume_via_firmware())
+	if (apple_sleep_power_lost(dev))
 		apple_dart_dapf_replay(dart);
 
 	return ret;
diff --git a/drivers/phy/apple/atc.c b/drivers/phy/apple/atc.c
index fd10bd6191..f14b47cf7b 100644
--- a/drivers/phy/apple/atc.c
+++ b/drivers/phy/apple/atc.c
@@ -7064,8 +7064,8 @@ static int atcphy_resume_noirq(struct device *dev)
 	apple_sleep_usb_set_asleep(false);
 
 	atcphy_usb2_sleep_exit(atcphy);
-	/* Only a sleep that reached the commit lowered ATC0_COMMON. */
-	if (pm_resume_via_firmware()) {
+	/* Only a real sleep, or a split step that lowered this port's domains, took the common. */
+	if (apple_sleep_power_lost(atcphy->dev)) {
 		ret = atcphy_common_restore(atcphy);
 		if (ret)
 			dev_err(dev, "PHY not set up again after the sleep: %d\n", ret);
@@ -7283,7 +7283,8 @@ static void atcphy_sleep_lost_cio(struct apple_atcphy *atcphy)
 {
 	lockdep_assert_held(&atcphy->lock);
 	if (atcphy->hw->gen != ATCPHY_GENERATION_T8132 || !atcphy->hw->restore_after_pd_off ||
-	    atcphy->dp_only || !pm_resume_via_firmware() || !atcphy_mode_is_cio(atcphy->mode))
+	    atcphy->dp_only || !apple_sleep_power_lost(atcphy->dev) ||
+	    !atcphy_mode_is_cio(atcphy->mode))
 		return;
 	if (atcphy->t8132_common_owned) {
 		if (!atcphy_t8132_cold(atcphy))
diff --git a/drivers/pmdomain/apple/pmc.c b/drivers/pmdomain/apple/pmc.c
index b58091f970..478caf8f8e 100644
--- a/drivers/pmdomain/apple/pmc.c
+++ b/drivers/pmdomain/apple/pmc.c
@@ -52,6 +52,7 @@
 #include <linux/seq_file.h>
 #include <linux/slab.h>
 #include <linux/soc/apple/pmc.h>
+#include <linux/soc/apple/sleep.h>
 #include <linux/spinlock.h>
 #include <linux/string_choices.h>
 #include <linux/suspend.h>
@@ -1552,7 +1553,8 @@ static int apple_pmc_resume_early(struct device *dev)
 	unsigned int rail;
 	int ret = 0, err;
 
-	if (!pm_resume_via_firmware() || !pmc)
+	/* A split step or a refusal never takes the rails down: only a real sleep does. */
+	if (!apple_sleep_powered_down() || !pmc)
 		return 0;
 
 	raw_spin_lock_irqsave(&pmc->lock, flags);
diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 0b30df66b7..7253231b30 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -389,6 +389,9 @@ static const u8 t8132_clk_mux[] = { 0x10, 0x14, 0x00, 0x04 };
 struct apple_s2r_t8132 {
 	void __iomem *ps;
 	void __iomem *ps_aon;
+	/* Their physical bases: the PMGR nodes' own, to name what a split step lowered */
+	phys_addr_t ps_phys;
+	phys_addr_t ps_aon_phys;
 	void __iomem *pwrgate;
 	void __iomem *cluster;
 	void __iomem *commit;
@@ -660,6 +663,47 @@ static bool apple_s2r_lowers_apcie(unsigned int ab, unsigned int depth, int ans)
 	return !depth || depth >= 3;
 }
 
+/* A power state word: @aon in the always-on PMGR window, else the main one */
+struct apple_s2r_ps_word {
+	u8 aon;
+	u16 off;
+};
+
+#define S2R_LOST_MAX	9
+
+/*
+ * The power state words a split step at @depth has lowered, in lower_io() and
+ * lower_apcie()'s order: ATC0 from depth 2, ANS's APCIe block from 4 (PHY_SW),
+ * 5 (SYS_ST, ST) and 6 (SYS_GP, GP), ANS from 7 or split_ans=2's cycle.
+ * Return: how many went into @out (S2R_LOST_MAX at most).
+ */
+static unsigned int apple_s2r_split_lost(unsigned int depth, bool io, bool apcie, bool ans_cycled,
+					 struct apple_s2r_ps_word *out)
+{
+	unsigned int n = 0;
+
+	if (!depth || depth > 7)
+		depth = 7;
+	if (io && depth >= 2) {
+		out[n++] = (struct apple_s2r_ps_word){ 0, T8132_PS_ATC0_COMMON };
+		out[n++] = (struct apple_s2r_ps_word){ 1, T8132_PS_AON_ATC0_USB_AON };
+		out[n++] = (struct apple_s2r_ps_word){ 1, T8132_PS_AON_ATC0_USB };
+	}
+	if (apcie && depth >= 4)
+		out[n++] = (struct apple_s2r_ps_word){ 0, T8132_PS_APCIE_PHY_SW };
+	if (apcie && depth >= 5) {
+		out[n++] = (struct apple_s2r_ps_word){ 0, T8132_PS_APCIE_SYS_ST };
+		out[n++] = (struct apple_s2r_ps_word){ 0, T8132_PS_APCIE_ST };
+	}
+	if (apcie && depth >= 6) {
+		out[n++] = (struct apple_s2r_ps_word){ 0, T8132_PS_APCIE_SYS_GP };
+		out[n++] = (struct apple_s2r_ps_word){ 0, T8132_PS_APCIE_GP };
+	}
+	if ((apcie && depth >= 7) || ans_cycled)
+		out[n++] = (struct apple_s2r_ps_word){ 0, T8132_PS_ANS };
+	return n;
+}
+
 static const char *const apple_s2r_step_names[] = {
 	[S2R_STEP_NONE]		= "none",
 	[S2R_STEP_COPROCS]	= "coprocessor refusal",
@@ -999,6 +1043,50 @@ bool apple_sleep_powered_down(void)
 }
 EXPORT_SYMBOL_GPL(apple_sleep_powered_down);
 
+/* What a T8132 split step lowered this cycle: physical addresses of PS words */
+static phys_addr_t apple_s2r_lost[S2R_LOST_MAX];
+static unsigned int apple_s2r_lost_n;
+
+/* Whether @np's power domains, or their parents, include one of those words */
+static bool apple_s2r_np_lost(struct device_node *np, unsigned int level)
+{
+	unsigned int n = READ_ONCE(apple_s2r_lost_n);
+	int i;
+
+	for (i = 0; ; i++) {
+		struct device_node *dn = of_parse_phandle(np, "power-domains", i);
+		struct device_node *pmgr;
+		struct resource res;
+		bool lost = false;
+		unsigned int j;
+		u32 off;
+
+		if (!dn)
+			return false;
+		pmgr = of_get_parent(dn);
+		if (pmgr && !of_address_to_resource(pmgr, 0, &res) &&
+		    !of_property_read_u32(dn, "reg", &off))
+			for (j = 0; j < n && !lost; j++)
+				lost = apple_s2r_lost[j] == res.start + off;
+		of_node_put(pmgr);
+		if (!lost && level < 8)
+			lost = apple_s2r_np_lost(dn, level + 1);
+		of_node_put(dn);
+		if (lost)
+			return true;
+	}
+}
+
+bool apple_sleep_power_lost(struct device *dev)
+{
+	if (!READ_ONCE(t8132_sequence))
+		return pm_resume_via_firmware();
+	if (READ_ONCE(apple_s2r_powered_down))
+		return true;
+	return dev && dev->of_node && apple_s2r_np_lost(dev->of_node, 0);
+}
+EXPORT_SYMBOL_GPL(apple_sleep_power_lost);
+
 /*
  * The last refusals: interrupts are off and no other CPU is up, so the
  * registry is read without its lock, which no one can hold now.
@@ -2718,6 +2806,19 @@ static void __noreturn apple_s2r_t8132_fatal(struct apple_s2r *s2r, u8 stage)
 		cpu_relax();
 }
 
+/* A split step returning: name what it lowered, for apple_sleep_power_lost() */
+static void apple_s2r_t8132_record_lost(struct apple_s2r *s2r, unsigned int depth)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	struct apple_s2r_ps_word w[S2R_LOST_MAX];
+	unsigned int i, n;
+
+	n = apple_s2r_split_lost(depth, t->io_lowered, t->apcie_domains_lowered, t->ans_cycled, w);
+	for (i = 0; i < n; i++)
+		apple_s2r_lost[i] = (w[i].aon ? t->ps_aon_phys : t->ps_phys) + w[i].off;
+	WRITE_ONCE(apple_s2r_lost_n, n);
+}
+
 static int apple_s2r_t8132_finish(unsigned long arg)
 {
 	struct apple_s2r *s2r = (struct apple_s2r *)arg;
@@ -2795,6 +2896,7 @@ static int apple_s2r_t8132_finish(unsigned long arg)
 		apple_s2r_t8132_raise_after_lower(s2r);
 		if (t->split_ans == S2R_SPLIT_ANS_CYCLE && t->pcie_ans_stopped)
 			apple_s2r_t8132_ans_cycle(s2r);
+		apple_s2r_t8132_record_lost(s2r, depth);
 		apple_cpu_t8132_release_stopped(false);
 		apple_s2r_crumb(s2r, S2R_CRUMB_T8132_RAISE_DONE);
 		return ret;
@@ -3236,6 +3338,10 @@ static int apple_s2r_t8132_map(struct apple_s2r *s2r, struct platform_device *pd
 		*field = devm_ioremap(dev, res->start, resource_size(res));
 		if (!*field)
 			return -ENOMEM;
+		if (!strcmp(regs[i].name, "ps"))
+			t->ps_phys = res->start;
+		else if (!strcmp(regs[i].name, "ps-aon"))
+			t->ps_aon_phys = res->start;
 	}
 
 	ret = of_property_read_variable_u32_array(dev->of_node, "apple,wake-enable",
@@ -3656,6 +3762,7 @@ static int apple_s2r_begin(suspend_state_t state)
 	if (READ_ONCE(debug_begin_as_idle))
 		return 0;
 	WRITE_ONCE(apple_s2r_powered_down, false);
+	WRITE_ONCE(apple_s2r_lost_n, 0);
 	if (apple_s2r) {
 		if (apple_s2r->wdt) {
 			apple_s2r->wdt_begin_ctl = readl_relaxed(apple_s2r->wdt + WDT_CTL);
diff --git a/include/linux/soc/apple/sleep.h b/include/linux/soc/apple/sleep.h
index 4eeb4dc790..5379534d57 100644
--- a/include/linux/soc/apple/sleep.h
+++ b/include/linux/soc/apple/sleep.h
@@ -87,7 +87,9 @@ static inline void apple_sleep_lid_closed_wake(void) { }
  * took its domain down): one idled with its power kept does not come back.
  * apple_sleep_powered_down() tells any resume path whether the whole SoC lost
  * power: a T8132 split step or a refusal powers only some blocks down, and
- * pm_resume_via_firmware() is set for those as well.
+ * pm_resume_via_firmware() is set for those as well. apple_sleep_power_lost()
+ * tells a device's resume whether its own power domains (or their parents)
+ * lost power: a real sleep, or a split step that lowered one of them.
  * T8132 has no PCIe ANS block: @pcie_ans must be false.
  */
 #if IS_ENABLED(CONFIG_APPLE_S2R)
@@ -103,6 +105,7 @@ void apple_sleep_coproc_set_ready(struct device *dev, bool ready);
 bool apple_sleep_coproc_stopped(struct device *dev);
 bool apple_sleep_coproc_power_cycled(struct device *dev);
 bool apple_sleep_powered_down(void);
+bool apple_sleep_power_lost(struct device *dev);
 /* After a deep sleep, put back the pins it reset. ANS's driver calls it before the run bit. */
 void apple_sleep_restore_pins(void);
 /* The PCIe host retrained a root port (or the radio's, port 0) after a T8132 sleep. */
@@ -129,6 +132,7 @@ static inline void apple_sleep_coproc_set_ready(struct device *dev, bool ready)
 static inline bool apple_sleep_coproc_stopped(struct device *dev) { return false; }
 static inline bool apple_sleep_coproc_power_cycled(struct device *dev) { return false; }
 static inline bool apple_sleep_powered_down(void) { return pm_resume_via_firmware(); }
+static inline bool apple_sleep_power_lost(struct device *dev) { return pm_resume_via_firmware(); }
 static inline void apple_sleep_restore_pins(void) { }
 static inline void apple_sleep_apcie_port_up(unsigned int port) { }
 static inline void apple_sleep_radio_port_up(void) { }
diff --git a/tools/asahi/run-host-tests.py b/tools/asahi/run-host-tests.py
index 40d7bf63ae..d447a5a022 100755
--- a/tools/asahi/run-host-tests.py
+++ b/tools/asahi/run-host-tests.py
@@ -175,7 +175,8 @@ ASAHI_TESTS = {
     's2r-split-ans-tests.py': [(out(), PASS)]
         + mutations('--mutation', ('notice-depth', 'depth-seven', 'depth-zero',
                                    'not-split', 'mode-unknown', 'lowers-real',
-                                   'lowers-notice', 'lowers-depth'), out()),
+                                   'lowers-notice', 'lowers-depth', 'lost-io-depth',
+                                   'lost-ans-cycle', 'lost-gp'), out()),
     'rtkit-crashlog-tests.py': [(out(), PASS)]
         + mutations('--mutation', ('buffer-header', 'section-header', 'section-size', 'footer-room',
                                    'mailbox-minimum', 'version-string', 'message-string'), out()),
diff --git a/tools/asahi/s2r-split-ans-tests.py b/tools/asahi/s2r-split-ans-tests.py
index 667aed5b47..1c888bb262 100755
--- a/tools/asahi/s2r-split-ans-tests.py
+++ b/tools/asahi/s2r-split-ans-tests.py
@@ -23,13 +23,19 @@ MUTATIONS = {
     'lowers-real': ('\tif (!ab)\n\t\treturn true;', '\tif (!ab)\n\t\treturn false;'),
     'lowers-notice': ('ans == S2R_SPLIT_ANS_NOTICE', 'ans == S2R_SPLIT_ANS_CYCLE'),
     'lowers-depth': ('return !depth || depth >= 3;', 'return depth >= 3;'),
+    'lost-io-depth': ('if (io && depth >= 2) {', 'if (io && depth >= 3) {'),
+    'lost-ans-cycle': ('if ((apcie && depth >= 7) || ans_cycled)', 'if ((apcie && depth >= 7) && ans_cycled)'),
+    'lost-gp': ('if (apcie && depth >= 6) {', 'if (apcie && depth >= 7) {'),
 }
 
 PRELUDE = r'''
 #include <assert.h>
 #include <errno.h>
 #include <stdbool.h>
+#include <stdint.h>
 #include <stdio.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
 '''
 
 CASES = r'''
@@ -72,6 +78,23 @@ int main(void) {
     assert(!apple_s2r_lowers_apcie(S2R_STEP_T8132_RAISE, 4, S2R_SPLIT_ANS_NOTICE));
     assert(!apple_s2r_lowers_apcie(S2R_STEP_T8132_LOWER, 0, S2R_SPLIT_ANS_STOP));
     assert(!apple_s2r_lowers_apcie(S2R_STEP_T8132_STOP, 7, S2R_SPLIT_ANS_STOP));
+    /* what each split depth lowered, for apple_sleep_power_lost() */
+    {
+        struct apple_s2r_ps_word w[S2R_LOST_MAX];
+        assert(apple_s2r_split_lost(1, false, false, false, w) == 0);
+        assert(apple_s2r_split_lost(2, true, false, false, w) == 3);
+        assert(w[0].aon == 0 && w[0].off == T8132_PS_ATC0_COMMON);
+        assert(w[1].aon == 1 && w[1].off == T8132_PS_AON_ATC0_USB_AON);
+        assert(w[2].aon == 1 && w[2].off == T8132_PS_AON_ATC0_USB);
+        assert(apple_s2r_split_lost(3, true, false, false, w) == 3);
+        assert(apple_s2r_split_lost(4, true, true, false, w) == 4 && w[3].off == T8132_PS_APCIE_PHY_SW);
+        assert(apple_s2r_split_lost(5, true, true, false, w) == 6);
+        assert(apple_s2r_split_lost(6, true, true, false, w) == 8 && w[7].off == T8132_PS_APCIE_GP);
+        assert(apple_s2r_split_lost(7, true, true, false, w) == 9 && w[8].off == T8132_PS_ANS);
+        assert(apple_s2r_split_lost(0, true, true, false, w) == 9);
+        assert(apple_s2r_split_lost(1, false, false, true, w) == 1 && w[0].off == T8132_PS_ANS);
+        assert(apple_s2r_split_lost(7, true, false, false, w) == 3);
+    }
     puts("apple-s2r split_ans: every abort/depth/mode combination selects as documented");
     return 0;
 }
@@ -81,8 +104,12 @@ int main(void) {
 def extract(source):
     step = re.search(r'enum apple_s2r_step \{.*?\n\};\n', source, re.S).group(0)
     mode = re.search(r'enum apple_s2r_split_ans_mode \{.*?\n\};\n', source, re.S).group(0)
-    code = step + mode
-    for fn in ('static int apple_s2r_split_ans(', 'static bool apple_s2r_lowers_apcie('):
+    defines = ''.join(l + '\n' for l in source.splitlines() if re.match(r'#define T8132_PS_(ATC0|AON_ATC0|APCIE|ANS)', l))
+    word = re.search(r'struct apple_s2r_ps_word \{.*?\n\};\n', source, re.S).group(0)
+    lost_max = re.search(r'#define S2R_LOST_MAX\s+\d+\n', source).group(0)
+    code = defines + step + mode + word + lost_max
+    for fn in ('static int apple_s2r_split_ans(', 'static bool apple_s2r_lowers_apcie(',
+               'static unsigned int apple_s2r_split_lost('):
         start = source.index(fn)
         code += source[start:source.index('\n}\n', start) + 3]
     return code
