From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Mon, 26 Oct 2026 00:16:27 +1100
Subject: [PATCH] ASoC: apple: Give the HPAI PCM a descriptive microphone name

Use the same hpai service ID and High-Quality Microphone PCM name as the
T8140 AOP driver. Keep the existing card ID and long name for UCM and
PipeWire discovery. The card still registers only the high-quality
array; LPAI stays internal to the firmware setup.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit 412846dfc4c494567663acaf18cb122aaf477f1e)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 sound/soc/apple/aop_audio.rs | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/sound/soc/apple/aop_audio.rs b/sound/soc/apple/aop_audio.rs
index 28de9cabc4..98f93d9592 100644
--- a/sound/soc/apple/aop_audio.rs
+++ b/sound/soc/apple/aop_audio.rs
@@ -958,8 +958,10 @@ impl SndSocAopDriver {
         }
 
         let mut pcm = ptr::null_mut();
-        let ret =
-            unsafe { bindings::snd_pcm_new(this.card, longname.as_ptr() as _, 0, 0, 1, &mut pcm) };
+        // Like the T8140 card, identify the high-quality array by its service
+        // and give the PCM a readable name. Keep the card ID and long name:
+        // UCM and the existing Asahi microphone rules use them for discovery.
+        let ret = unsafe { bindings::snd_pcm_new(this.card, c"hpai".as_ptr(), 0, 0, 1, &mut pcm) };
         if ret < 0 {
             dev_err!(data.dev, "Unable to allocate PCM device");
             return Err(Error::from_errno(ret));
@@ -977,7 +979,10 @@ impl SndSocAopDriver {
             (*pcm).private_data = data.clone().into_foreign() as _;
             (*pcm).private_free = Some(aop_pcm_free_private);
             (*pcm).info_flags = 0;
-            copy_str(&mut (*pcm).name, c"aop_audio".to_bytes_with_nul());
+            copy_str(
+                &mut (*pcm).name,
+                c"High-Quality Microphone".to_bytes_with_nul(),
+            );
         }
 
         let ret = unsafe { bindings::snd_card_register(this.card) };
