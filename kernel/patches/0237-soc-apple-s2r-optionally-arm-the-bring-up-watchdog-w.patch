From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 19:39:17 +0000
Subject: [PATCH] soc: apple: s2r: optionally arm the bring-up watchdog
 when ->enter starts

The wdt_timeout safety timer is armed by the finisher, as the very last
step before the deep WFI. The coprocessor stops (enclave sleep request,
GPU and PMP commits, ANS) and the SoC steps before it run without any
timer, so a stop in them leaves a dark machine that only a forced power
off ends.

Add wdt_from_enter: with it and wdt_timeout set, the watchdog is taken
over and armed as soon as ->enter has passed its checks. The finisher
arms it again with a fresh count, and the syscore resume puts back what
the watchdog driver had programmed on every return, as before.

The parameter is off by default; without it nothing changes.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/apple-s2r.c | 30 +++++++++++++++++++++++++-----
 1 file changed, 25 insertions(+), 5 deletions(-)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 9c85cb086c..fe59f1ec59 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -55,6 +55,8 @@
  * never resumes ends in a reset instead of a hang. Both the boot firmware's
  * warm boot path and the syscore resume disarm it; the latter puts back what
  * the watchdog driver had programmed.
+ * With wdt_from_enter it is armed already when ->enter starts, so that
+ * the coprocessor stops and the SoC steps are covered as well.
  *
  * CPM gating, AFR, the non-CPU SoC clusters and SIO are shared with s2idle
  * and live in apple-sleep.
@@ -552,6 +554,10 @@ static uint wdt_timeout;
 module_param(wdt_timeout, uint, 0644);
 MODULE_PARM_DESC(wdt_timeout, "For bring-up: right before the SoC goes to sleep, arm the watchdog to reset the system after this many seconds (at most 178) unless the resume path disarms it first; needs apple,watchdog (default: 0, off)");
 
+static bool wdt_from_enter;
+module_param(wdt_from_enter, bool, 0644);
+MODULE_PARM_DESC(wdt_from_enter, "For bring-up: arm the wdt_timeout watchdog already when ->enter starts, so that a stop in the coprocessor stops or the SoC steps also ends in a reset; the finisher arms it again with a fresh count; needs wdt_timeout (default: off)");
+
 static bool bringup_no_fw;
 module_param(bringup_no_fw, bool, 0444);
 MODULE_PARM_DESC(bringup_no_fw, "For bring-up without firmware warm boot support: register anyway, but only run suspend-to-RAM with abort_before set to a step before the clock generators (1-8), so the SoC never goes to sleep (default: off)");
@@ -680,6 +686,14 @@ static void apple_s2r_wdt_arm(struct apple_s2r *s2r)
 	writel(WDT_CTL_RESET_EN, s2r->wdt + WDT_CTL);
 }
 
+/* Keep what the watchdog driver had programmed, then arm the safety timer */
+static void apple_s2r_wdt_take(struct apple_s2r *s2r)
+{
+	s2r->wdt_saved_ctl = readl_relaxed(s2r->wdt + WDT_CTL);
+	s2r->wdt_saved_alarm = readl_relaxed(s2r->wdt + WDT_ALARM);
+	s2r->wdt_armed = true;
+}
+
 /* Put back what the watchdog driver had programmed, with a fresh count */
 static void apple_s2r_wdt_restore(struct apple_s2r *s2r)
 {
@@ -850,6 +864,15 @@ static int apple_s2r_enter(suspend_state_t state)
 			return ret;
 	}
 
+	/*
+	 * Bring-up: from here on a stop anywhere in ->enter ends in a reset.
+	 * The syscore resume puts the watchdog back on every return.
+	 */
+	if (s2r->wdt && wdt_timeout && READ_ONCE(wdt_from_enter)) {
+		apple_s2r_wdt_take(s2r);
+		apple_s2r_wdt_arm(s2r);
+	}
+
 	/* The coprocessors' last refusals, before anything that can't be undone */
 	ret = apple_s2r_coprocs_check(s2r);
 	if (ret) {
@@ -910,11 +933,8 @@ static int apple_s2r_enter(suspend_state_t state)
 		writel(S2R_TIMER_START, s2r->timer);
 
 	/* Armed by the finisher, once nothing is left that could abort */
-	if (s2r->wdt && wdt_timeout) {
-		s2r->wdt_saved_ctl = readl_relaxed(s2r->wdt + WDT_CTL);
-		s2r->wdt_saved_alarm = readl_relaxed(s2r->wdt + WDT_ALARM);
-		s2r->wdt_armed = true;
-	}
+	if (s2r->wdt && wdt_timeout && !s2r->wdt_armed)
+		apple_s2r_wdt_take(s2r);
 
 	/*
 	 * From here the SoC powers down: every block's resume has to assume
