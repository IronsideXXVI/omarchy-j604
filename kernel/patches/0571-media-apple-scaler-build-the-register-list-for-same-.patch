--- a/drivers/media/platform/apple/scaler/apple-scaler-hw.c
+++ b/drivers/media/platform/apple/scaler/apple-scaler-hw.c
@@ -15,6 +15,7 @@
 #include <linux/math64.h>
 #include <linux/module.h>
 #include <linux/string.h>
+#include <linux/wordpart.h>
 
 #include <kunit/visibility.h>
 
@@ -45,7 +46,7 @@ static const struct asc_format asc_formats[] = {
 		/* 10 bits in the top of each 16-bit sample. */
 		.fourcc = V4L2_PIX_FMT_P010, .layout = 0xc, .code = 0x2,
