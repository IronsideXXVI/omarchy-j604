From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 18:42:09 +0000
Subject: [PATCH] soc: apple: sleep: mark __cpu_setup on the T8132
 wake, clear OS lock

A deep wake on the J604 reset 69.6 s after the RTC alarm: the woken
core wrote the 70 s mark after init_kernel_el and never the 80 s one
after __cpu_setup, with no fault taken. It stopped in __cpu_setup.

Split that window. With the wake flag set, restart WD2 after the local
TLB invalidate (100 s), after the CPACR/MDSCR/PMU/AMU writes (110 s)
and after the MAIR/TCR writes (130 s). The macros move to a header so
proc.S can use them; without the flag they do nothing.

At boot m1n1 clears the OS lock on every core before Linux runs. A
core coming out of reset has it set, and the resume stub never clears
it, so the woken core is the only one to run __cpu_setup locked.
Clear it on the wake before __cpu_setup and mark that step (140 s).

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/include/asm/t8132-wake.h | 65 +++++++++++++++++++++++++++++
 arch/arm64/kernel/sleep.S           | 45 ++------------------
 arch/arm64/mm/proc.S                |  4 ++
 3 files changed, 72 insertions(+), 42 deletions(-)
 create mode 100644 arch/arm64/include/asm/t8132-wake.h

diff --git a/arch/arm64/include/asm/t8132-wake.h b/arch/arm64/include/asm/t8132-wake.h
new file mode 100644
index 0000000000..6c2b4a206f
--- /dev/null
+++ b/arch/arm64/include/asm/t8132-wake.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __ASM_T8132_WAKE_H
+#define __ASM_T8132_WAKE_H
+
+#ifdef __ASSEMBLY__
+#ifdef CONFIG_APPLE_SOC_SLEEP
+/*
+ * T8132 deep wake progress, MMU off: restart WD2 by its physical address with a
+ * distinct timeout, so the reset time after a failed wake says how far cpu_resume
+ * got, and take the resume stub's fault vectors again (init_kernel_el replaced
+ * them), so a fault keeps its own short timeout. The hyp stub vectors come back
+ * before the MMU is on. Only when the sleep driver armed it for this wake.
+ */
+	.macro	t8132_wake_mark, secs
+	adr_l	x9, t8132_wake_marks
+	ldr	w9, [x9]
+	cbz	w9, .Lt8132_mark_\@
+	movz	x9, #0x882b, lsl #16
+	movk	x9, #0x3, lsl #32
+	str	wzr, [x9, #0x2c]
+	str	wzr, [x9, #0x20]
+	mov_q	x10, (\secs * 24000000)
+	str	w10, [x9, #0x28]
+	mov	w10, #1
+	str	w10, [x9, #0x2c]
+	adr_l	x10, t8132_wake_vectors
+	msr	vbar_el2, x10
+	isb
+.Lt8132_mark_\@:
+	.endm
+
+	.macro	t8132_wake_unvec
+	adr_l	x9, t8132_wake_marks
+	ldr	w9, [x9]
+	cbz	w9, .Lt8132_unvec_\@
+	adr_l	x9, __hyp_stub_vectors
+	msr	vbar_el2, x9
+	isb
+.Lt8132_unvec_\@:
+	.endm
+
+/*
+ * Clear the OS lock on the woken core before __cpu_setup. A core coming
+ * out of reset has it set; at boot m1n1 clears it on every core before
+ * Linux runs, which the resume stub does not.
+ */
+	.macro	t8132_wake_oslar
+	adr_l	x9, t8132_wake_marks
+	ldr	w9, [x9]
+	cbz	w9, .Lt8132_oslar_\@
+	msr	oslar_el1, xzr
+	isb
+.Lt8132_oslar_\@:
+	.endm
+#else
+	.macro	t8132_wake_mark, secs
+	.endm
+	.macro	t8132_wake_unvec
+	.endm
+	.macro	t8132_wake_oslar
+	.endm
+#endif
+#endif /* __ASSEMBLY__ */
+
+#endif
diff --git a/arch/arm64/kernel/sleep.S b/arch/arm64/kernel/sleep.S
index 78bef53617..077bb31381 100644
--- a/arch/arm64/kernel/sleep.S
+++ b/arch/arm64/kernel/sleep.S
@@ -3,6 +3,7 @@
 #include <linux/linkage.h>
 #include <asm/asm-offsets.h>
 #include <asm/assembler.h>
+#include <asm/t8132-wake.h>
 #include <asm/smp.h>
 
 	.text
@@ -98,48 +99,6 @@ SYM_FUNC_START(__cpu_suspend_enter)
 SYM_FUNC_END(__cpu_suspend_enter)
 
 	.pushsection ".idmap.text", "a"
-#ifdef CONFIG_APPLE_SOC_SLEEP
-/*
- * T8132 deep wake progress, MMU off: restart WD2 by its physical address with a
- * distinct timeout, so the reset time after a failed wake says how far cpu_resume
- * got, and take the resume stub's fault vectors again (init_kernel_el replaced
- * them), so a fault keeps its own short timeout. The hyp stub vectors come back
- * before the MMU is on. Only when the sleep driver armed it for this wake.
- */
-	.macro	t8132_wake_mark, secs
-	adr_l	x9, t8132_wake_marks
-	ldr	w9, [x9]
-	cbz	w9, .Lt8132_mark_\@
-	movz	x9, #0x882b, lsl #16
-	movk	x9, #0x3, lsl #32
-	str	wzr, [x9, #0x2c]
-	str	wzr, [x9, #0x20]
-	mov_q	x10, (\secs * 24000000)
-	str	w10, [x9, #0x28]
-	mov	w10, #1
-	str	w10, [x9, #0x2c]
-	adr_l	x10, t8132_wake_vectors
-	msr	vbar_el2, x10
-	isb
-.Lt8132_mark_\@:
-	.endm
-
-	.macro	t8132_wake_unvec
-	adr_l	x9, t8132_wake_marks
-	ldr	w9, [x9]
-	cbz	w9, .Lt8132_unvec_\@
-	adr_l	x9, __hyp_stub_vectors
-	msr	vbar_el2, x9
-	isb
-.Lt8132_unvec_\@:
-	.endm
-#else
-	.macro	t8132_wake_mark, secs
-	.endm
-	.macro	t8132_wake_unvec
-	.endm
-#endif
-
 SYM_CODE_START(cpu_resume)
 	mov	x0, xzr
 #ifdef CONFIG_ARM64_CTXR_EXECMEM
@@ -148,6 +107,8 @@ SYM_CODE_START(cpu_resume)
 	bl	init_kernel_el
 	mov	x19, x0			// preserve boot mode
 	t8132_wake_mark 70
+	t8132_wake_oslar
+	t8132_wake_mark 140
 	bl	__cpu_setup
 	t8132_wake_mark 80
 	t8132_wake_unvec
diff --git a/arch/arm64/mm/proc.S b/arch/arm64/mm/proc.S
index a7c717f1c0..85409e23e2 100644
--- a/arch/arm64/mm/proc.S
+++ b/arch/arm64/mm/proc.S
@@ -12,6 +12,7 @@
 #include <linux/pgtable.h>
 #include <linux/cfi_types.h>
 #include <asm/assembler.h>
+#include <asm/t8132-wake.h>
 #include <asm/asm-offsets.h>
 #include <asm/asm_pointer_auth.h>
 #include <asm/hwcap.h>
@@ -490,12 +491,14 @@ SYM_FUNC_END(wait_linear_map_split_to_ptes)
 SYM_FUNC_START(__cpu_setup)
 	tlbi	vmalle1				// Invalidate local TLB
 	dsb	nsh
+	t8132_wake_mark 100
 
 	msr	cpacr_el1, xzr			// Reset cpacr_el1
 	mov	x1, MDSCR_EL1_TDCC		// Reset mdscr_el1 and disable
 	msr	mdscr_el1, x1			// access to the DCC from EL0
 	reset_pmuserenr_el0 x1			// Disable PMU access from EL0
 	reset_amuserenr_el0 x1			// Disable AMU access from EL0
+	t8132_wake_mark 110
 
 	/*
 	 * Default values for VMSA control registers. These will be adjusted
@@ -545,6 +548,7 @@ alternative_else_nop_endif
 #endif	/* CONFIG_ARM64_HW_AFDBM */
 	msr	mair_el1, mair
 	msr	tcr_el1, tcr
+	t8132_wake_mark 130
 
 	mrs_s	x1, SYS_ID_AA64MMFR3_EL1
 	ubfx	x1, x1, #ID_AA64MMFR3_EL1_S1PIE_SHIFT, #4
-- 
2.43.0

