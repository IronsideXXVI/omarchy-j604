From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 18 Nov 2026 16:26:28 +0000
Subject: [PATCH] drm/asahi: g16: Give each VM 32 compute units by
 default

With one pool and one allocator descriptor per VM (g16_compute_shared_pool
2, the default since 1.1056), compute units 16 to 31 hold no pool of their
own. Each takes only its save areas and records: a 256 KiB context store,
16 KiB preemption and auxiliary buffers and a few small records, about
0.4 MiB, allocated with the other units at the VM's first compute
command. Set g16_compute_units to 32 by default, so that g16_horizon can
keep up to 31 compute commands of one queue behind a running one.

With g16_compute_shared_pool 0 the units stay clamped to 16, one 32 MiB
pool each, as before. Revert with g16_compute_units=16 on the boot line.

Measured so far: on 1.1056 at 16 units a compute client holds 54 MiB of
GPU memory; the 16 more units add at most about 6 MiB by the object sizes.
32 units with a horizon of 31 have run before, on 1.1005 with the shared
pool of that time, not with one descriptor per VM.

RESULT: to be filled by the release owner

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 2c1d7d7219..ffb6b85af9 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -843,13 +843,15 @@ pub(crate) fn horizon_depth() -> u64 {
     (HORIZON.load(Ordering::Relaxed) as u64).clamp(1, compute_units() as u64 - 1)
 }
 
-/// Storage of `g16_compute_units` (0644, default 16; latched at the engine start).
-static COMPUTE_UNITS: AtomicU32 = AtomicU32::new(16);
+/// Storage of `g16_compute_units` (0644, default 32; latched at the engine start).
+static COMPUTE_UNITS: AtomicU32 = AtomicU32::new(32);
 /// The latched compute units, 0 until latched.
 static COMPUTE_UNITS_LATCH: AtomicU32 = AtomicU32::new(0);
 
-/// Compute units every VM that runs compute allocates (each ~33 MiB, created at its first
-/// compute command), 2..=[`hw::sizes::COMPUTE_SLOTS`]; read once, at the engine start.
+/// Compute units every VM that runs compute allocates, all at its first compute command:
+/// 2..=[`hw::sizes::COMPUTE_UNITS_MAX`] with `g16_compute_shared_pool` 1 or 2 (only unit 0
+/// holds the 32 MiB pool; every other unit about 0.4 MiB of save areas and records), and
+/// 2..=[`hw::sizes::COMPUTE_SLOTS`] with 0 (~33 MiB each); read once, at the engine start.
 pub(crate) fn compute_units() -> usize {
     let l = COMPUTE_UNITS_LATCH.load(Ordering::Acquire);
     if l != 0 {
@@ -876,7 +878,7 @@ pub(crate) fn compute_units() -> usize {
     COMPUTE_UNITS_PARM,
     COMPUTE_UNITS,
     "g16_compute_units",
-    "G16: compute units per VM, one compute command in flight each (default 16; 2..16; 12 = k948; 8 = before; 4 = k908; 9..16 = deeper compute queue, ~33 MiB per unit, 13..16 for g16_horizon up to 15; latched at the engine start, set it as a module option)"
+    "G16: compute units per VM, one compute command in flight each (default 32; 2..32 with g16_compute_shared_pool 1 or 2, where unit 0 holds the pool and the others only their save areas; 2..16 with g16_compute_shared_pool 0, ~33 MiB per unit, which takes 32 as 16; 16 up to 1.1056; latched at the engine start, set it as a module option)"
 );
 
 /// Storage of `g16_compute_shared_pool` (0644, default 2; latched at its first read).
-- 
2.43.0

