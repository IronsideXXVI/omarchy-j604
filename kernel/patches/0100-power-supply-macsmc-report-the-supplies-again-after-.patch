From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:18 -0500
Subject: [PATCH] power: supply: macsmc: report the supplies again
 after a sleep

The battery's charge can change while the system sleeps, and nothing
told userspace after a wake. An SMC event during the sleep can queue a
uevent too, which is dropped if it runs before the SMC takes commands
again.

Send one from .complete, when the SMC is back and before the thaw.

Signed-off-by: Diljit Singh <hey@djdev.me>
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/power/supply/macsmc-power.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/drivers/power/supply/macsmc-power.c b/drivers/power/supply/macsmc-power.c
index 1e306c7bb3..da81dc08e5 100644
--- a/drivers/power/supply/macsmc-power.c
+++ b/drivers/power/supply/macsmc-power.c
@@ -1239,6 +1239,24 @@ static void macsmc_power_remove(struct platform_device *pdev)
 	blocking_notifier_chain_unregister(&power->smc->event_handlers, &power->nb);
 }
 
+/*
+ * The charge moved while asleep, and an event's uevent that ran before the SMC
+ * was back found nothing to report.
+ */
+static void macsmc_power_complete(struct device *dev)
+{
+	struct macsmc_power *power = dev_get_drvdata(dev);
+
+	if (power->batt)
+		power_supply_changed(power->batt);
+	if (power->ac)
+		power_supply_changed(power->ac);
+}
+
+static const struct dev_pm_ops macsmc_power_pm_ops = {
+	.complete = pm_sleep_ptr(macsmc_power_complete),
+};
+
 static const struct platform_device_id macsmc_power_id[] = {
 	{ .name = "macsmc-power" },
 	{ /* sentinel */ }
@@ -1248,6 +1266,7 @@ MODULE_DEVICE_TABLE(platform, macsmc_power_id);
 static struct platform_driver macsmc_power_driver = {
 	.driver = {
 		.name = "macsmc-power",
+		.pm = pm_sleep_ptr(&macsmc_power_pm_ops),
 	},
 	.id_table = macsmc_power_id,
 	.probe = macsmc_power_probe,
