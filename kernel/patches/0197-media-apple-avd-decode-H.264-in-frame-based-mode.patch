+/*
+ * An MSB-first bit writer for synthetic slice headers (no emulation
+ * prevention needed: they hold no 00 00 run).
+ */
+struct avd_bw {
+	u8 buf[64];
+	u32 bits;
+};
+
+static void bw_u(struct avd_bw *w, u32 v, unsigned int n)
+{
+	while (n--) {
+		if ((v >> n) & 1)
+			w->buf[w->bits / 8] |= 0x80 >> (w->bits % 8);
+		w->bits++;
+	}
+}
+
+static void bw_ue(struct avd_bw *w, u32 v)
+{
+	unsigned int len = fls(v + 1);
+
+	bw_u(w, 0, len - 1);
+	bw_u(w, v + 1, len);
+}
+
+static void bw_se(struct avd_bw *w, s32 v)
+{
+	bw_ue(w, v > 0 ? 2 * v - 1 : -2 * v);
+}
+
+static const struct v4l2_ctrl_h264_sps avd_syn_sps = {
+	.chroma_format_idc = 1,
+	.log2_max_frame_num_minus4 = 0,
+	.pic_order_cnt_type = 2,
+	.pic_width_in_mbs_minus1 = 79,
+	.pic_height_in_map_units_minus1 = 44,
+	.flags = V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY,
+};
+
+static const struct v4l2_ctrl_h264_pps avd_syn_pps = {
+	.pic_parameter_set_id = 1,
+	.num_ref_idx_l0_default_active_minus1 = 1,
+	.flags = V4L2_H264_PPS_FLAG_WEIGHTED_PRED |
+		 V4L2_H264_PPS_FLAG_DEBLOCKING_FILTER_CONTROL_PRESENT,
+};
+
+/* A CAVLC P slice header (nal_ref_idc 2) with explicit luma and chroma weights. */
+static u32 avd_syn_p_slice(struct avd_bw *w, u32 slice_type, u32 pps_id)
+{
+	memset(w, 0, sizeof(*w));
+	bw_u(w, 0x41, 8);		/* nal_ref_idc 2, nal_unit_type 1 */
+	bw_ue(w, 80);			/* first_mb_in_slice: second row */
+	bw_ue(w, slice_type);
+	bw_ue(w, pps_id);
+	bw_u(w, 3, 4);			/* frame_num */
+	bw_u(w, 1, 1);			/* num_ref_idx_active_override_flag */
+	bw_ue(w, 0);			/* num_ref_idx_l0_active_minus1 */
+	bw_u(w, 0, 1);			/* ref_pic_list_modification_flag_l0 */
+	bw_ue(w, 6);			/* luma_log2_weight_denom */
+	bw_ue(w, 5);			/* chroma_log2_weight_denom */
+	bw_u(w, 0, 1);			/* luma_weight_l0_flag[0]: default */
+	bw_u(w, 1, 1);			/* chroma_weight_l0_flag[0] */
+	bw_se(w, 30);			/* chroma_weight_l0[0][0] */
+	bw_se(w, -4);			/* chroma_offset_l0[0][0] */
+	bw_se(w, -7);			/* chroma_weight_l0[0][1] */
+	bw_se(w, 9);			/* chroma_offset_l0[0][1] */
+	bw_u(w, 0, 1);			/* adaptive_ref_pic_marking_mode_flag */
+	bw_se(w, -5);			/* slice_qp_delta */
+	bw_ue(w, 0);			/* disable_deblocking_filter_idc */
+	bw_se(w, 3);			/* slice_alpha_c0_offset_div2 */
+	bw_se(w, -6);			/* slice_beta_offset_div2 */
+	return w->bits;
+}
+
+static void avd_parse_synthetic_test(struct kunit *test)
+{
+	struct avd_h264_slice_hdr *h;
+	struct avd_bw *w;
+	u32 bits, len;
+
+	h = kunit_kzalloc(test, sizeof(*h), GFP_KERNEL);
+	w = kunit_kzalloc(test, sizeof(*w), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, h);
+	KUNIT_ASSERT_NOT_NULL(test, w);
+
+	bits = avd_syn_p_slice(w, 5 /* P, all slices of the picture */, 1);
+	bw_u(w, 0xff, 8);		/* slice data follows */
+	len = DIV_ROUND_UP(w->bits, 8);
+	KUNIT_ASSERT_EQ(test, avd_h264_parse_slice(w->buf, len, &avd_syn_sps, &avd_syn_pps, h), 0);
+	KUNIT_EXPECT_EQ(test, h->sl.header_bit_size, bits);
+	KUNIT_EXPECT_EQ(test, h->sl.slice_type, V4L2_H264_SLICE_TYPE_P);
+	KUNIT_EXPECT_EQ(test, h->sl.first_mb_in_slice, 80);
+	KUNIT_EXPECT_EQ(test, h->sl.num_ref_idx_l0_active_minus1, 0);
+	KUNIT_EXPECT_EQ(test, h->frame_num, 3);
+	KUNIT_EXPECT_EQ(test, h->pw.luma_log2_weight_denom, 6);
+	KUNIT_EXPECT_EQ(test, h->pw.chroma_log2_weight_denom, 5);
+	KUNIT_EXPECT_EQ(test, h->pw.weight_factors[0].luma_weight[0], 64);
+	KUNIT_EXPECT_EQ(test, h->pw.weight_factors[0].luma_offset[0], 0);
+	KUNIT_EXPECT_EQ(test, h->pw.weight_factors[0].chroma_weight[0][0], 30);
+	KUNIT_EXPECT_EQ(test, h->pw.weight_factors[0].chroma_offset[0][0], -4);
+	KUNIT_EXPECT_EQ(test, h->pw.weight_factors[0].chroma_weight[0][1], -7);
+	KUNIT_EXPECT_EQ(test, h->pw.weight_factors[0].chroma_offset[0][1], 9);
+	KUNIT_EXPECT_EQ(test, h->sl.slice_qp_delta, -5);
+	KUNIT_EXPECT_EQ(test, h->sl.slice_alpha_c0_offset_div2, 3);
+	KUNIT_EXPECT_EQ(test, h->sl.slice_beta_offset_div2, -6);
+
+	/* the bytes of the header only, no slice data */
+	KUNIT_EXPECT_EQ(test, avd_h264_parse_slice(w->buf, bits / 8, &avd_syn_sps,
+						   &avd_syn_pps, h), -EINVAL);
+	/* header cut short */
