+/* Bytes of an Annex-B start code at the front of @data, 0 for none. */
+static u32 avd_h264_start_code_len(const u8 *data, u32 len)
+{
+	if (len >= 3 && !data[0] && !data[1] && data[2] == 1)
+		return 3;
+	if (len >= 4 && !data[0] && !data[1] && !data[2] && data[3] == 1)
+		return 4;
+	return 0;
