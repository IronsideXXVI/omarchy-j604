+/* Queue one NAL unit of a frame-based picture: 1 for a slice, 0 skipped. */
+static int avd_h264_frame_nal(struct avd_ctx *ctx, struct avd_h264_run *run,
+			      const u8 *nal, u32 len)
+{
+	struct avd_h264_ctx *h264_ctx = ctx->priv;
+	struct avd_h264_slice_hdr *h = &h264_ctx->hdr;
+	int ret;
+
+	/* Only coded slices carry picture data; SEI, AUD and the like do not. */
+	if (!len || ((nal[0] & 0x1f) != 1 && (nal[0] & 0x1f) != 5))
+		return 0;
+
+	ret = avd_h264_parse_slice(nal, len, run->sps, run->pps, h);
+	if (ret) {
+		dev_err_ratelimited(ctx->dev->dev,
+				    "H.264 slice header cannot be decoded (%d)\n",
+				    ret);
+		return ret;
+	}
+	/* Redundant slices repeat the primary picture; decode it once. */
+	if (h->sl.redundant_pic_cnt)
+		return 0;
+
+	ret = avd_h264_frame_lists(h264_ctx, run, h);
+	if (ret) {
+		dev_dbg_ratelimited(ctx->dev->dev,
+				    "slice reference lists cannot be built, dropping frame\n");
+		return ret;
+	}
+
+	run->slice_params = &h->sl;
+	run->pred_weights = &h->pw;
+	ret = avd_h264_add_slice(ctx, run, nal, len);
+	return ret ? ret : 1;
+}
