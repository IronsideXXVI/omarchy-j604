+/*
+ * Final reference lists of a frame-based slice: the initial lists (8.2.4.2)
+ * from the DPB, then the slice's modifications (8.2.4.3).
+ */
+static int avd_h264_frame_lists(struct avd_h264_ctx *h264_ctx,
+				const struct avd_h264_run *run,
+				struct avd_h264_slice_hdr *h)
+{
+	struct v4l2_ctrl_h264_slice_params *sl = &h->sl;
+	struct v4l2_h264_reflist_builder builder;
+	bool b = sl->slice_type == V4L2_H264_SLICE_TYPE_B;
+	int ret;
+
+	if (sl->slice_type == V4L2_H264_SLICE_TYPE_I)
+		return 0;
+
+	v4l2_h264_init_reflist_builder(&builder, run->decode_params, run->sps,
+				       run->decode_params->dpb);
+	if (b) {
+		v4l2_h264_build_b_ref_lists(&builder, sl->ref_pic_list0,
+					    sl->ref_pic_list1);
+	} else {
+		v4l2_h264_build_p_ref_list(&builder, sl->ref_pic_list0);
+	}
+
+	ret = avd_h264_modify_list(sl->ref_pic_list0, builder.num_valid,
+				   sl->num_ref_idx_l0_active_minus1 + 1,
+				   h->mods[0], h->num_mods[0],
+				   run->decode_params, run->sps);
+	if (!ret && b)
+		ret = avd_h264_modify_list(sl->ref_pic_list1, builder.num_valid,
+					   sl->num_ref_idx_l1_active_minus1 + 1,
+					   h->mods[1], h->num_mods[1],
+					   run->decode_params, run->sps);
+	return ret;
+}
