+}
+
+static void avd_modify_list_test(struct kunit *test)
+{
+	/* initial P list: descending PicNum, then long-term: 1, -1, -2, LT0 */
+	static const u8 init[] = { 1, 3, 0, 2 };
+	struct v4l2_ctrl_h264_sps sps = { .log2_max_frame_num_minus4 = 0 };
+	struct v4l2_ctrl_h264_decode_params *d;
+	struct v4l2_h264_reference *l;
+	struct avd_h264_list_mod mods[3];
+
+	d = kunit_kzalloc(test, sizeof(*d), GFP_KERNEL);
+	l = kunit_kcalloc(test, V4L2_H264_REF_LIST_LEN, sizeof(*l), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, d);
+	KUNIT_ASSERT_NOT_NULL(test, l);
+	avd_test_dpb(d);
+
+	/* no operation: the initial list, cut to num_active */
+	avd_set_list(l, init, 4);
+	KUNIT_ASSERT_EQ(test, avd_h264_modify_list(l, 4, 3, NULL, 0, d, &sps), 0);
+	KUNIT_EXPECT_EQ(test, l[0].index, 1);
+	KUNIT_EXPECT_EQ(test, l[1].index, 3);
+	KUNIT_EXPECT_EQ(test, l[2].index, 0);
+
+	/*
+	 * idc 0, abs_diff 3: picNumNoWrap = 2 - 3 + 16 = 15, picNum -1 (frame_num
+	 * 15, wrapped) to the front; idc 2: LongTermPicNum 0 second; idc 1,
+	 * abs_diff 2 from 15: 17 - 16 = 1, PicNum 1 third.
+	 */
+	mods[0] = (struct avd_h264_list_mod){ 0, 2 };
+	mods[1] = (struct avd_h264_list_mod){ 2, 0 };
+	mods[2] = (struct avd_h264_list_mod){ 1, 1 };
+	avd_set_list(l, init, 4);
+	KUNIT_ASSERT_EQ(test, avd_h264_modify_list(l, 4, 4, mods, 3, d, &sps), 0);
+	KUNIT_EXPECT_EQ(test, l[0].index, 3);
+	KUNIT_EXPECT_EQ(test, l[1].index, 2);
+	KUNIT_EXPECT_EQ(test, l[2].index, 1);
+	KUNIT_EXPECT_EQ(test, l[3].index, 0);
+
+	/* a list longer than the references takes the first entry */
+	avd_set_list(l, init, 1);
+	KUNIT_ASSERT_EQ(test, avd_h264_modify_list(l, 1, 3, NULL, 0, d, &sps), 0);
+	KUNIT_EXPECT_EQ(test, l[1].index, 1);
+	KUNIT_EXPECT_EQ(test, l[2].index, 1);
+
+	/* PicNum 0 is no short-term reference (frame_num 0 is long-term) */
+	mods[0] = (struct avd_h264_list_mod){ 0, 1 };
+	avd_set_list(l, init, 4);
+	KUNIT_EXPECT_EQ(test, avd_h264_modify_list(l, 4, 4, mods, 1, d, &sps), -EINVAL);
+	/* LongTermPicNum 7 does not exist */
+	mods[0] = (struct avd_h264_list_mod){ 2, 7 };
+	KUNIT_EXPECT_EQ(test, avd_h264_modify_list(l, 4, 4, mods, 1, d, &sps), -EINVAL);
+	/* abs_diff_pic_num beyond MaxPicNum */
+	mods[0] = (struct avd_h264_list_mod){ 0, 16 };
+	KUNIT_EXPECT_EQ(test, avd_h264_modify_list(l, 4, 4, mods, 1, d, &sps), -EINVAL);
+	/* more operations than entries */
+	mods[0] = (struct avd_h264_list_mod){ 0, 0 };
+	mods[1] = (struct avd_h264_list_mod){ 1, 0 };
+	KUNIT_EXPECT_EQ(test, avd_h264_modify_list(l, 4, 1, mods, 2, d, &sps), -EINVAL);
+	/* no reference at all */
+	KUNIT_EXPECT_EQ(test, avd_h264_modify_list(l, 0, 1, NULL, 0, d, &sps), -EINVAL);
+}
+
+static void avd_next_nal_test(struct kunit *test)
+{
+	static const u8 s[] = {
+		0x00, 0x00, 0x00, 0x01, 0x09, 0xf0,		/* AUD, 4-byte start code */
+		0x00, 0x00, 0x01, 0x65, 0x00, 0x00, 0x03, 0x01, 0xaa,	/* IDR slice with an EPB */
+		0x00, 0x00,					/* trailing zeros */
+		0x00, 0x00, 0x01, 0x41, 0x9a,			/* P slice at the end */
+	};
+	u32 pos = 0, start, len;
+
+	KUNIT_ASSERT_TRUE(test, avd_h264_next_nal(s, sizeof(s), &pos, &start, &len));
+	KUNIT_EXPECT_EQ(test, start, 4);
+	KUNIT_EXPECT_EQ(test, len, 2);
+	KUNIT_ASSERT_TRUE(test, avd_h264_next_nal(s, sizeof(s), &pos, &start, &len));
+	KUNIT_EXPECT_EQ(test, start, 9);
+	KUNIT_EXPECT_EQ(test, len, 6);
+	KUNIT_ASSERT_TRUE(test, avd_h264_next_nal(s, sizeof(s), &pos, &start, &len));
+	KUNIT_EXPECT_EQ(test, start, 20);
+	KUNIT_EXPECT_EQ(test, len, 2);
+	KUNIT_EXPECT_FALSE(test, avd_h264_next_nal(s, sizeof(s), &pos, &start, &len));
+
+	/* no start code at all */
+	pos = 0;
+	KUNIT_EXPECT_FALSE(test, avd_h264_next_nal(s + 4, 2, &pos, &start, &len));
+}
