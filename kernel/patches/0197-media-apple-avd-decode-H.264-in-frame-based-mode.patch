+/*
+ * DPB for the list tests (MaxFrameNum 16, current frame_num 2): short-term
+ * frame_num 1 (PicNum 1), 15 (PicNum -1, wrapped) and 14 (PicNum -2), and a
+ * long-term picture with LongTermPicNum 0.
+ */
+static void avd_test_dpb(struct v4l2_ctrl_h264_decode_params *d)
+{
+	static const u16 fn[] = { 14, 1, 0, 15 };
+
+	memset(d, 0, sizeof(*d));
+	d->frame_num = 2;
+	for (unsigned int i = 0; i < ARRAY_SIZE(fn); i++) {
+		d->dpb[i].frame_num = fn[i];
+		d->dpb[i].fields = V4L2_H264_FRAME_REF;
+		d->dpb[i].flags = V4L2_H264_DPB_ENTRY_FLAG_VALID |
+				  V4L2_H264_DPB_ENTRY_FLAG_ACTIVE;
+	}
+	d->dpb[2].flags |= V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM;
+	d->dpb[5].flags = V4L2_H264_DPB_ENTRY_FLAG_VALID;	/* not a reference */
