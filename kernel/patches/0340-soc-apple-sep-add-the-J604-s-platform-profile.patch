From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 22:18:37 +0000
Subject: [PATCH] soc: apple: sep: add the J604's platform profile

Rebuilding the J604 series on integration/aurora took Aurora's
profile.rs whole, and with it the J604 entry went: the selector found no
profile for "apple,j604", so the SEP driver did not bind and the J604
had no Touch ID.

Add it back on Aurora's fields. The J604's SEP side is T8132's (J713's
ADT entries), its Mesa sensor is J613's R3 generation: SPI mode 1, no
nonce session, no signed root key. So it is T8122's profile with the
sensor at T8132's spi2 address, and it takes T8122's xART guard level,
as T8132 does.

The selector test that pinned "apple,j604" to no profile now expects it.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/profile.rs | 35 ++++++++++++++++++++++++++++++++---
 1 file changed, 32 insertions(+), 3 deletions(-)

diff --git a/drivers/soc/apple/profile.rs b/drivers/soc/apple/profile.rs
index ac5f573455..a085648543 100644
--- a/drivers/soc/apple/profile.rs
+++ b/drivers/soc/apple/profile.rs
@@ -518,6 +518,27 @@ pub(crate) const T8142: PlatformProfile = PlatformProfile {
     ..T8132
 };
 
+/// MacBook Pro 14" M4 (J604). The J604 ADTs (26.6.2 25G83, 27.2 26B123 and
+/// this Mac's 27.2 runtime tree) describe the SEP, its DART and mailbox
+/// interrupts as J713's do: `iop-sep,ascwrap-v6`, DART input aperture
+/// `0x100_0000_4000 + 0xffff0000`, ADT mailbox interrupts 390 389 392 391.
+/// The Mesa sensor sits on spi2 at `0x3ad108000`, 8 MHz, chip select 0, with
+/// the same `reg` bytes as J713's and J613's, power on NUB GPIO 28 and
+/// data-ready on AP GPIO 199.
+///
+/// Unlike J713, the sensor is J613's generation (`sensor-id` "R3", not "V3"),
+/// so the sensor side is J613's: SPI mode 1, no nonce session and no signed
+/// root key. The SoC side is the T8132 (= T8122) warm attach. On the J604 the
+/// enclave enrols, matches and restores the enrolment after a reboot.
+pub(crate) const T8132_J604: PlatformProfile = PlatformProfile {
+    name: "T8132/J604",
+    sensor: SensorProfile {
+        controller_base: 0x3_ad10_8000,
+        ..T8122.sensor
+    },
+    ..T8122
+};
+
 static_assert!(T8103.shmem_capacity == 0x30000);
 static_assert!(T6020.shmem_capacity == 0x40000);
 static_assert!(T8140.shmem_capacity == 0x40000);
@@ -538,6 +559,10 @@ static_assert!(T6040.sensor.expected_id == T8140.sensor.expected_id);
 static_assert!(T8132.sensor.controller_base == 0x3ad108000);
 static_assert!(T8132.sensor.expected_id == T8140.sensor.expected_id);
 static_assert!(T8132.nonce_session && T8132.wide_dma_mask);
+static_assert!(T8132_J604.sensor.controller_base == T8132.sensor.controller_base);
+static_assert!(T8132_J604.sensor.expected_id == T8122.sensor.expected_id);
+static_assert!(!T8132_J604.nonce_session && T8132_J604.wide_dma_mask);
+static_assert!(T8132_J604.xart_guard == T8122.xart_guard);
 static_assert!(T8142.sensor.controller_base == 0x3a5108000);
 static_assert!(T8142.sensor.expected_id == T8132.sensor.expected_id);
 static_assert!(T8142.nonce_session && T8142.wide_dma_mask);
@@ -706,7 +731,11 @@ fn select(
     if has(b"apple,t6050") && has(b"apple,j714s") {
         return Ok(&T6050);
     }
-    // Only the M4 MacBook Airs: the other T8132 Macs are unread.
+    // The M4 MacBook Pro 14": T8132's SoC side with J613's R3 sensor.
+    if has(b"apple,t8132") && has(b"apple,j604") {
+        return Ok(&T8132_J604);
+    }
+    // The M4 MacBook Airs.
     if has(b"apple,t8132") && (has(b"apple,j713") || has(b"apple,j715")) {
         return Ok(&T8132);
     }
@@ -778,10 +807,10 @@ mod tests {
     }
 
     #[test]
-    fn t8132_selection_is_limited_to_the_m4_airs() {
+    fn t8132_selection_takes_the_m4_airs_and_the_j604() {
         assert_eq!(picked(&[b"apple,j713", b"apple,t8132"]), Some(T8132.name));
         assert_eq!(picked(&[b"apple,j715", b"apple,t8132"]), Some(T8132.name));
-        assert_eq!(picked(&[b"apple,j604", b"apple,t8132"]), None);
+        assert_eq!(picked(&[b"apple,j604", b"apple,t8132"]), Some(T8132_J604.name));
         assert_eq!(picked(&[b"apple,t8132"]), None);
         assert_eq!(picked(&[b"apple,j613", b"apple,t8132"]), None);
         assert_eq!(picked(&[b"apple,j713", b"apple,t8122"]), None);
