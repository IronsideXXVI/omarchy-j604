index 0000000000..b776ca6353
--- /dev/null
+++ b/tools/asahi/m4-async-flip-tests.py
@@ -0,0 +1,244 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Host test of the J604 internal panel's asynchronous flip (iomfb_m4 int_async_flip).
+
+Compiles the production dcp_m4_int_seq() and dcp_m4_int_flight_finish() from
+drivers/gpu/drm/apple/iomfb_m4.c against stubs, then checks:
+- the frame on screen is never released: over random runs of completions whose
+  D590 says displayed or not, every frame that may be on screen stays referenced,
+  and no frame is released twice;
+- no frame leaks: after a displayed completion only that frame is still held;
+- every completion sends exactly one flip event, its sequence strictly increasing;
+- the sequence counts the panel's refreshes between flips on a jittered grid, at
+  120 Hz and at the fixed 60 Hz mode.
+--mutations runs the same checks against broken copies of the hold rule and
+fails unless every mutation is caught.
+"""
+from pathlib import Path
+import argparse
+import re
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+SRC = ROOT / 'drivers/gpu/drm/apple/iomfb_m4.c'
+
+
+def function(text, head):
+    start = text.index(head)
+    end = text.index('\n}\n', start) + 3
+    return text[start:end]
+
+
+PRELUDE = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef uint8_t u8; typedef uint32_t u32; typedef uint64_t u64; typedef int64_t s64;
+typedef s64 ktime_t;
+#define NSEC_PER_SEC 1000000000ULL
+#define READ_ONCE(x) (x)
+#define max_t(t, a, b) ((t)(a) > (t)(b) ? (t)(a) : (t)(b))
+static u64 div_u64(u64 a, u32 b) { return a / b; }
+static u64 div64_u64(u64 a, u64 b) { return a / b; }
+static bool ktime_after(ktime_t a, ktime_t b) { return a > b; }
+static ktime_t ktime_sub(ktime_t a, ktime_t b) { return a - b; }
+static s64 ktime_to_ns(ktime_t a) { return a; }
+static ktime_t now_ns;
+static ktime_t ktime_get(void) { return now_ns; }
+static s64 ktime_get_ns(void) { return now_ns; }
+static u64 __arch_counter_get_cntpct(void) { return (u64)now_ns; }
+#define dev_info_ratelimited(...) do { } while (0)
+#define DCP_M4_PREC_N 4
+struct drm_framebuffer { int id; int refs; };
+struct dcp_m4_frame { u64 dva; };
+struct dcp_m4_swap_state { u32 id; };
+struct delayed_work { int pending; };
+static void cancel_delayed_work(struct delayed_work *w) { w->pending = 0; }
+struct dcp_m4_prec { u32 id; u64 reply_cnt, done_cnt, flip_cnt, start_cnt; s64 flip_ns; u64 ret_cnt; };
+struct apple_crtc { int dummy; };
+struct apple_dcp { struct apple_crtc *crtc; };
+struct iomfb_m4 {
+	struct apple_dcp *owner;
+	void *dev;
+	struct drm_framebuffer *active_fb, *uncertain_fb, *lost_fb, *extra_fb;
+	bool active_unshown;
+	struct dcp_m4_frame active_frame;
+	u64 flips;
+};
+struct dcp_m4_runtime {
+	struct iomfb_m4 *dcp;
+	bool int_shown_valid, int_shown;
+	ktime_t int_done_kt;
+	u64 int_done_cnt;
+	struct { struct dcp_m4_swap_state swap; struct drm_framebuffer *fb;
+		 struct dcp_m4_frame frame; unsigned long deadline; bool open; } int_fl;
+	struct delayed_work int_fl_work;
+	u64 seq_last; ktime_t seq_last_kt;
+	u64 int_async_flips, int_async_unshown;
+	struct dcp_m4_prec prec_cur, prec[DCP_M4_PREC_N];
+	u64 prec_count;
+	u32 rate;
+};
+static u32 dcp_m4_live_rate(struct dcp_m4_runtime *r) { return r->rate; }
+static int puts_total;
+static bool iomfb_m4_retire(struct iomfb_m4 *dcp, struct drm_framebuffer *fb)
+{
+	if (!fb)
+		return true;
+	assert(fb->refs == 1);	/* never released twice */
+	fb->refs = 0;
+	puts_total++;
+	return true;
+}
+static int events; static u64 ev_seq; static ktime_t ev_t;
+static void dcp_drm_crtc_vblank_at(struct apple_crtc *c, u64 seq, ktime_t t)
+{ events++; ev_seq = seq; ev_t = t; }
+'''
+
+HARNESS = r'''
+#define NF 4096
+static struct drm_framebuffer fbs[NF];
+static unsigned rng = 12345;
+static unsigned rnd(void) { rng = rng * 1103515245 + 12345; return rng >> 8; }
+static bool held(struct iomfb_m4 *d, struct drm_framebuffer *f)
+{ return f && f->refs == 1 && (f == d->active_fb || f == d->lost_fb || f == d->extra_fb || f == d->uncertain_fb); }
+int main(void)
+{
+	struct apple_crtc crtc; struct apple_dcp owner = { .crtc = &crtc };
+	struct iomfb_m4 d = { .owner = &owner };
+	struct dcp_m4_runtime r = { .dcp = &d, .rate = 120u << 16 };
+	struct drm_framebuffer *displayed;
+	u64 last = 0;
+	int run, i, n = 1;
+
+	/* safety: random shown / not shown completions */
+	for (run = 0; run < 200; run++) {
+		memset(fbs, 0, sizeof(fbs)); memset(&d, 0, sizeof(d)); d.owner = &owner;
+		n = 1; fbs[0].id = 1; fbs[0].refs = 1; d.active_fb = &fbs[0]; displayed = &fbs[0];
+		for (i = 0; i < 18; i++) {
+			struct drm_framebuffer *f = &fbs[n++];
+			bool shown = rnd() % 3 != 0;
+			f->id = n; f->refs = 1;
+			r.int_fl.fb = f; r.int_fl.open = true; r.int_fl.swap.id = n;
+			r.int_shown_valid = true; r.int_shown = shown;
+			now_ns += 8333333; r.int_done_kt = now_ns;
+			int before = events;
+			dcp_m4_int_flight_finish(&r);
+			assert(events == before + 1);			/* one flip per completion */
+			assert(ev_seq > last); last = ev_seq;		/* strictly increasing */
+			assert(!r.int_fl.open && !r.int_fl.fb);
+			assert(d.active_fb == f);			/* promoted */
+			if (shown)
+				displayed = f;
+			assert(held(&d, displayed));			/* what is on screen stays */
+		}
+		/* no leak: after a displayed completion only the new frame is held */
+		{
+			struct drm_framebuffer *f = &fbs[n++];
+
+			f->id = n; f->refs = 1;
+			r.int_fl.fb = f; r.int_fl.open = true;
+			r.int_shown_valid = true; r.int_shown = true;
+			now_ns += 8333333; r.int_done_kt = now_ns;
+			dcp_m4_int_flight_finish(&r);
+			for (int k = 0; k < n - 1; k++)
+				if (fbs[k].refs) {
+					fprintf(stderr, "frame %d still held after a displayed completion\n", fbs[k].id);
+					return 1;
+				}
+			assert(d.active_fb == f && !d.lost_fb && !d.extra_fb && !d.uncertain_fb);
+		}
+	}
+	/* sequence: refreshes between flips on a jittered grid, 120 Hz then fixed 60 Hz */
+	for (int mode = 0; mode < 2; mode++) {
+		u32 hz = mode ? 60 : 120;
+		double period = 1e9 / hz;
+		double t = 1e12;
+		r.rate = hz << 16; r.seq_last = 1000; r.seq_last_kt = (ktime_t)t;
+		for (i = 0; i < 20000; i++) {
+			unsigned gap = 1 + rnd() % 6;
+			double jitter = ((int)(rnd() % 241) - 120) * 1000.0;	/* +-0.12 ms */
+			u64 before = r.seq_last;
+			t += gap * period;
+			struct drm_framebuffer *f = &fbs[i % NF];
+			f->refs = 1; d.active_fb = NULL; d.lost_fb = d.extra_fb = d.uncertain_fb = NULL;
+			r.int_fl.fb = f; r.int_fl.open = true; r.int_shown_valid = false;
+			r.int_done_kt = (ktime_t)(t + jitter);
+			dcp_m4_int_flight_finish(&r);
+			if (ev_seq - before != gap) {
+				fprintf(stderr, "seq step %llu, want %u (mode %u Hz)\n",
+					(unsigned long long)(ev_seq - before), gap, hz);
+				return 1;
+			}
+		}
+	}
+	printf("PASS async flip: hold rule over 200 random runs; seq on a jittered 120/60 Hz grid\n");
+	return 0;
+}
+'''
+
+MUTATIONS = [
+    # unshown: release the frame before it (still on screen) instead of keeping it
+    ('else if (!dcp->lost_fb)\n\t\t\tdcp->lost_fb = old;', 'else if (!dcp->lost_fb)\n\t\t\tiomfb_m4_retire(dcp, old);'),
+    # unshown after unshown: forget that the active frame was never shown (frames leak)
+    ('\t\tdcp->active_unshown = true;', '\t\tdcp->active_unshown = false;'),
+    # shown: forget to release lost_fb (a leak is not unsafe, but the extra hold then overflows)
+    ('\tdcp->active_fb = r->int_fl.fb;', '\tdcp->active_fb = r->int_fl.fb;\n\tdcp->lost_fb = NULL;'),
+    # sequence: count flips, not refreshes
+    ('\tr->seq_last += n;', '\tr->seq_last += 1;'),
+]
+
+
+def build(tmp, finish, seq, strict=True):
+    source = tmp / 'async.c'
+    source.write_text(PRELUDE + seq + finish + HARNESS)
+    binary = tmp / 'async'
+    # A mutant may leave a variable unused: only the production code builds with -Werror.
+    werror = ['-Werror'] if strict else []
+    subprocess.run(['cc', '-std=gnu11', '-O1', '-Wall', '-Wno-unused-function', *werror,
+                    '-fsanitize=address,undefined', str(source), '-o', str(binary)], check=True)
+    return subprocess.run([str(binary)], capture_output=True, text=True)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--mutations', action='store_true')
+    args = parser.parse_args()
+    text = SRC.read_text()
+    finish = function(text, 'static void dcp_m4_int_flight_finish(struct dcp_m4_runtime *r)')
+    seq = function(text, 'static u64 dcp_m4_int_seq(struct dcp_m4_runtime *r, ktime_t t)')
+    with tempfile.TemporaryDirectory(prefix='m4-async-flip-') as d:
+        tmp = Path(d)
+        res = build(tmp, finish, seq)
+        sys.stdout.write(res.stdout)
+        sys.stderr.write(res.stderr[-2000:])
+        if res.returncode:
+            print('FAIL production code')
+            return 1
+        if not args.mutations:
+            return 0
+        caught = 0
+        for i, (a, b) in enumerate(MUTATIONS):
+            body = finish + seq
+            if body.count(a) != 1:
+                print('FAIL mutation %d: anchor not found once' % i)
+                return 1
+            mutated = body.replace(a, b)
+            mf = function(mutated, 'static void dcp_m4_int_flight_finish(struct dcp_m4_runtime *r)')
+            ms = function(mutated, 'static u64 dcp_m4_int_seq(struct dcp_m4_runtime *r, ktime_t t)')
+            if build(tmp, mf, ms, strict=False).returncode:
+                caught += 1
+                print('ok mutation %d caught' % i)
+            else:
+                print('FAIL mutation %d not caught' % i)
+        print('mutations caught %d/%d' % (caught, len(MUTATIONS)))
+        return 0 if caught == len(MUTATIONS) else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
