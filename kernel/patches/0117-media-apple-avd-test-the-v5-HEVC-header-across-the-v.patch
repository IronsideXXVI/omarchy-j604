From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 17:01:12 +0000
Subject: [PATCH] media: apple: avd: test the v5 HEVC header across the
 variant table

The v5 HEVC program is a property of the firmware generation: every
variant that loads an avd-fw-v5 image must send it, and T8132 was the
one that did not. Add a KUnit suite over the match table that checks
this for every v5 variant, and pins the T8132 entry (v5-t1 image,
revision 4, v5 HEVC header, no T8140 queue pacing, HEVC offered).

KUnit builds get an accessor for the match table (avd_match_table());
the table itself stays static.

The suite passes with the T8132 change and fails on both cases without
it.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/avd/Makefile     |  2 +-
 drivers/media/platform/apple/avd/avd-drv.c    |  8 +++
 .../platform/apple/avd/avd-variant-test.c     | 70 +++++++++++++++++++
 drivers/media/platform/apple/avd/avd.h        |  1 +
 4 files changed, 80 insertions(+), 1 deletion(-)
 create mode 100644 drivers/media/platform/apple/avd/avd-variant-test.c

diff --git a/drivers/media/platform/apple/avd/Makefile b/drivers/media/platform/apple/avd/Makefile
index 60560dbab5..e8f0b9e769 100644
--- a/drivers/media/platform/apple/avd/Makefile
+++ b/drivers/media/platform/apple/avd/Makefile
@@ -4,5 +4,5 @@ apple-avd-y := avd-drv.o avd-v4l2.o avd-hw.o avd-pm.o avd-h264.o avd-vp9.o \
 	avd-hevc.o avd-av1.o avd-av1-entropymode.o avd-queue.o avd-backend-open.o \
 	avd-backend-apple.o avd-backend-queue.o
 apple-avd-$(CONFIG_VIDEO_APPLE_AVD_KUNIT_TEST) += avd-h264-test.o avd-queue-test.o \
-	avd-pm-test.o
+	avd-pm-test.o avd-variant-test.o
 obj-$(CONFIG_VIDEO_APPLE_AVD) += apple-avd.o
diff --git a/drivers/media/platform/apple/avd/avd-drv.c b/drivers/media/platform/apple/avd/avd-drv.c
index 08cf08ce69..8524ff7e86 100644
--- a/drivers/media/platform/apple/avd/avd-drv.c
+++ b/drivers/media/platform/apple/avd/avd-drv.c
@@ -637,6 +637,14 @@ static const struct of_device_id avd_of_match[] = {
 
 MODULE_DEVICE_TABLE(of, avd_of_match);
 
+#if IS_ENABLED(CONFIG_KUNIT)
+/* The variant table, for the KUnit checks in avd-variant-test.c. */
+const struct of_device_id *avd_match_table(void)
+{
+	return avd_of_match;
+}
+#endif
+
 static void avd_release_open_firmware(void *data)
 {
 	struct avd_dev *avd = data;
diff --git a/drivers/media/platform/apple/avd/avd-variant-test.c b/drivers/media/platform/apple/avd/avd-variant-test.c
new file mode 100644
index 0000000000..fb3320e6bb
--- /dev/null
+++ b/drivers/media/platform/apple/avd/avd-variant-test.c
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests for the Apple video decoder's per-SoC variant table.
+ */
+
+#include <kunit/test.h>
+#include <linux/mod_devicetable.h>
+#include <linux/string.h>
+
+#include "avd.h"
+
+static const struct avd_variant *avd_test_variant(const char *compatible)
+{
+	const struct of_device_id *id;
+
+	for (id = avd_match_table(); id->compatible[0]; id++)
+		if (!strcmp(id->compatible, compatible))
+			return id->data;
+	return NULL;
+}
+
+/*
+ * Every variant that loads a v5 firmware image takes the v5 HEVC program
+ * (DMA configuration words, reserved scratch slot): a VP fed the older
+ * layout reads every later header word from the wrong slot and stalls.
+ */
+static void avd_variant_v5_hevc_header_test(struct kunit *test)
+{
+	const struct of_device_id *id;
+	unsigned int v5 = 0;
+
+	for (id = avd_match_table(); id->compatible[0]; id++) {
+		const struct avd_variant *v = id->data;
+
+		if (!v->fw_name || !strstr(v->fw_name, "avd-fw-v5-"))
+			continue;
+		v5++;
+		KUNIT_EXPECT_TRUE_MSG(test,
+				      v->quirks & AVD_QUIRK_HEVC_V5_HEADER,
+				      "%s loads %s without the v5 HEVC header",
+				      id->compatible, v->fw_name);
+	}
+	KUNIT_EXPECT_GT(test, v5, 0U);
+}
+
+/* T8132 (M4) shares T6040's decoder, firmware generation and VP layout. */
+static void avd_variant_t8132_test(struct kunit *test)
+{
+	const struct avd_variant *v = avd_test_variant("apple,t8132-avd");
+
+	KUNIT_ASSERT_NOT_NULL(test, v);
+	KUNIT_EXPECT_STREQ(test, v->fw_name, "apple/avd-fw-v5-t1.bin");
+	KUNIT_EXPECT_EQ(test, v->revision, 4);
+	KUNIT_EXPECT_TRUE(test, v->quirks & AVD_QUIRK_HEVC_V5_HEADER);
+	KUNIT_EXPECT_FALSE(test, v->quirks & AVD_QUIRK_V5_QUEUE_PACING);
+	KUNIT_EXPECT_TRUE(test, v->capabilities & AVD_CAPABILITY_HEVC);
+}
+
+static struct kunit_case avd_variant_test_cases[] = {
+	KUNIT_CASE(avd_variant_v5_hevc_header_test),
+	KUNIT_CASE(avd_variant_t8132_test),
+	{}
+};
+
+static struct kunit_suite avd_variant_test_suite = {
+	.name = "apple-avd-variant",
+	.test_cases = avd_variant_test_cases,
+};
+
+kunit_test_suite(avd_variant_test_suite);
diff --git a/drivers/media/platform/apple/avd/avd.h b/drivers/media/platform/apple/avd/avd.h
index 020f11ec67..5d365d5872 100644
--- a/drivers/media/platform/apple/avd/avd.h
+++ b/drivers/media/platform/apple/avd/avd.h
@@ -368,6 +368,7 @@ bool avd_h264_slice_fits(const struct v4l2_ctrl_h264_sps *sps, size_t held,
 			 size_t held_bytes, u32 len, size_t decoded_size);
 bool avd_h264_scaling_is_flat(const struct v4l2_ctrl_h264_pps *pps,
 			      const struct v4l2_ctrl_h264_scaling_matrix *scaling);
+const struct of_device_id *avd_match_table(void);
 #endif
 
 extern const struct avd_coded_fmt_ops avd_h264_fmt_ops;
