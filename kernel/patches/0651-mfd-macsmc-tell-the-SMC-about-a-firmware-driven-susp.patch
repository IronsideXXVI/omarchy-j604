From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:17 -0500
Subject: [PATCH] mfd: macsmc: tell the SMC about a firmware-driven suspend

The SMC keeps running through a firmware-driven suspend. macOS tells it
first and stops it last, and on a wake it hears first. In order,
measured on T8140: MBSE = slpw before any other coprocessor is told, 800
ms before the rest; MBSE = slpa, 6 ms, then the AP idle notice after all
the others, then 30 ms; on a wake the AP on notice, MBSE and MBSW read,
and MBSE = waka. Between the two notices the firmware takes no commands,
so a command there answers -EAGAIN, which the SMC's clients take as "not
now": a battery event that ran on the boot CPU after the wake and before
the SMC's own resume logged failures from power_supply otherwise.

Do the same: the warning in .prepare, the arm and the notice in
suspend_noirq, the wake in resume_noirq, which gives that order whatever
the device order is. Those phases have the mailbox's interrupt off, so
commands there poll for their reply. The 800 ms after the warning is the
time macOS's other drivers take to get ready for the sleep, not a wait
the SMC asks for, so the warning doesn't wait: on a J700 that wait was
0.82 s of a 1.25 s entry. A refusal after the warning tells the SMC the
sleep is off. KUnit tests cover the order and the refused cases.

SMC.OutboxNotEmpty wakes the SoC while anything waits in the outbox. The
sleep's debug link cut is a cable pulled to the SMC: it queues the
port's and the charger's events and records them as wake reasons. With
the SMC's wake sources armed, a sleep whose cut came after the AP idle
notice committed and never returned. So suspend_noirq has the sleep
driver cut the link before slpa and the notice, then polls the outbox
until it has been quiet for 500 ms, up to 5 s. The events reach their
handlers through the RTKit worker. A machine without a debug cable
doesn't wait. An event that arrives later in the sleep's entry, the lid
opened or a key pressed, is left in the outbox: the line stays raised
and the sleep returns at once, as a wake would.

The lid may have moved while the AP was off, with no event to say so, so
macsmc-input reads it again after such a wake. Other sleeps don't
change.

Signed-off-by: Diljit Singh <hey@djdev.me>

[j604 backport: our e41fa86ce5 suspend-to-RAM pair (slpa + RTKit AP notice in suspend_late, wake in resume_early) replaced by this sequence (slpw in prepare, slpa + notice in suspend_noirq polled, wake in resume_noirq, waka on refusal) so the SMC is not notified twice; our key blocking kept on ap_notified (-EAGAIN) for the queued and atomic paths; s2idle path and sleep_handshake param unchanged; our WKTP=2 write is not in this sequence (TO-VERIFY on J604); apple_sleep_debug_link_cut() is a static inline false (apple-s2r stops no debug link)]
Assisted-by: Claude:claude-opus-5.5

---
 drivers/input/misc/macsmc-input.c |  11 ++
 drivers/mfd/macsmc-test.c         |  83 +++++++++
 drivers/mfd/macsmc.c              | 276 ++++++++++++++++++++++++------
 include/linux/mfd/macsmc.h        |   9 +-
 include/linux/soc/apple/sleep.h   |   9 +
 5 files changed, 331 insertions(+), 57 deletions(-)

diff --git a/drivers/input/misc/macsmc-input.c b/drivers/input/misc/macsmc-input.c
index 853dfa73b7..585ae57aca 100644
--- a/drivers/input/misc/macsmc-input.c
+++ b/drivers/input/misc/macsmc-input.c
@@ -13,6 +13,7 @@
 #include <linux/mfd/macsmc.h>
 #include <linux/module.h>
 #include <linux/reboot.h>
+#include <linux/suspend.h>
 
 /**
  * struct macsmc_input
@@ -214,6 +215,16 @@ static void macsmc_input_pm_complete(struct device *dev)
 	struct macsmc_input *smcin = dev_get_drvdata(dev);
 
 	smcin->wakeup_mode = false;
+
+	/* The lid may have moved while the AP was off and no event could arrive. */
+	if (pm_resume_via_firmware() && apple_smc_key_exists(smcin->smc, SMC_KEY(MSLD))) {
+		u8 val;
+
+		if (apple_smc_read_u8(smcin->smc, SMC_KEY(MSLD), &val) >= 0) {
+			input_report_switch(smcin->input, SW_LID, val);
+			input_sync(smcin->input);
+		}
+	}
 }
 
 static const struct dev_pm_ops macsmc_input_pm_ops = {
diff --git a/drivers/mfd/macsmc-test.c b/drivers/mfd/macsmc-test.c
index c4f9329dbc..2e0824a7c5 100644
--- a/drivers/mfd/macsmc-test.c
+++ b/drivers/mfd/macsmc-test.c
@@ -9,8 +9,15 @@ struct macsmc_test_context {
 	int result;
 	unsigned int calls;
 	bool require_sram_lock;
+	/* What the sleep tests saw, in order: keys read, values written, notices. */
+	u32 seen[8];
+	unsigned int seen_count;
+	int ap_power_result;
 };
 
+#define MACSMC_TEST_AP_IDLE	0
+#define MACSMC_TEST_AP_ON	1
+
 static int macsmc_test_command(struct apple_smc *smc, u64 cmd, u64 arg,
 			       u64 size, u64 wsize, u32 *ret_data)
 {
@@ -18,6 +25,9 @@ static int macsmc_test_command(struct apple_smc *smc, u64 cmd, u64 arg,
 
 	KUNIT_EXPECT_TRUE(kunit_get_current_test(), mutex_is_locked(&smc->mutex));
 	ctx->calls++;
+	if (ctx->seen_count < ARRAY_SIZE(ctx->seen))
+		ctx->seen[ctx->seen_count++] = cmd == SMC_MSG_WRITE_KEY ?
+			get_unaligned((u32 *)ctx->shmem) : arg;
 	if (ret_data && ctx->result >= 0)
 		*ret_data = ctx->data;
 	return ctx->result;
@@ -199,6 +209,76 @@ static void macsmc_key_info_lock_test(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, mutex_is_locked(&ctx->smc.mutex));
 }
 
+static int macsmc_test_ap_power(struct apple_smc *smc, bool on)
+{
+	struct macsmc_test_context *ctx = container_of(smc, struct macsmc_test_context, smc);
+
+	/* The answer needs a worker that may be waiting for this mutex. */
+	KUNIT_EXPECT_FALSE(kunit_get_current_test(), mutex_is_locked(&smc->mutex));
+	if (ctx->seen_count < ARRAY_SIZE(ctx->seen))
+		ctx->seen[ctx->seen_count++] = on ? MACSMC_TEST_AP_ON : MACSMC_TEST_AP_IDLE;
+	return ctx->ap_power_result;
+}
+
+static void macsmc_sleep_order_test(struct kunit *test)
+{
+	struct macsmc_test_context *ctx = test->priv;
+
+	kunit_activate_static_stub(test, apple_smc_ap_power, macsmc_test_ap_power);
+	ctx->result = 8;
+
+	apple_smc_sleep_warn(&ctx->smc);
+	KUNIT_EXPECT_EQ(test, apple_smc_sleep_commit(&ctx->smc), 0);
+	KUNIT_EXPECT_TRUE(test, ctx->smc.ap_notified);
+	apple_smc_sleep_wake(&ctx->smc);
+	KUNIT_EXPECT_FALSE(test, ctx->smc.ap_notified);
+	KUNIT_EXPECT_FALSE(test, ctx->smc.sleep_warned);
+
+	/* As in the trace, values included. */
+	KUNIT_ASSERT_EQ(test, ctx->seen_count, 7U);
+	KUNIT_EXPECT_EQ(test, ctx->seen[0], SMC_KEY(slpw));
+	KUNIT_EXPECT_EQ(test, ctx->seen[1], SMC_KEY(slpa));
+	KUNIT_EXPECT_EQ(test, ctx->seen[2], (u32)MACSMC_TEST_AP_IDLE);
+	KUNIT_EXPECT_EQ(test, ctx->seen[3], (u32)MACSMC_TEST_AP_ON);
+	KUNIT_EXPECT_EQ(test, ctx->seen[4], SMC_KEY(MBSE));
+	KUNIT_EXPECT_EQ(test, ctx->seen[5], SMC_KEY(MBSW));
+	KUNIT_EXPECT_EQ(test, ctx->seen[6], SMC_KEY(waka));
+}
+
+static void macsmc_sleep_refused_test(struct kunit *test)
+{
+	struct macsmc_test_context *ctx = test->priv;
+
+	kunit_activate_static_stub(test, apple_smc_ap_power, macsmc_test_ap_power);
+	ctx->ap_power_result = -ETIME;
+	ctx->result = 4;
+
+	/* No answer: refuse, undo the notice and leave commands working. */
+	KUNIT_EXPECT_EQ(test, apple_smc_sleep_commit(&ctx->smc), -ETIME);
+	KUNIT_EXPECT_FALSE(test, ctx->smc.ap_notified);
+	KUNIT_ASSERT_EQ(test, ctx->seen_count, 3U);
+	KUNIT_EXPECT_EQ(test, ctx->seen[0], SMC_KEY(slpa));
+	KUNIT_EXPECT_EQ(test, ctx->seen[1], (u32)MACSMC_TEST_AP_IDLE);
+	KUNIT_EXPECT_EQ(test, ctx->seen[2], (u32)MACSMC_TEST_AP_ON);
+}
+
+static void macsmc_notice_test(struct kunit *test)
+{
+	struct macsmc_test_context *ctx = test->priv;
+
+	kunit_activate_static_stub(test, apple_smc_ap_power, macsmc_test_ap_power);
+	ctx->result = 8;
+
+	/* The test trigger writes no MBSE value: those announce a real sleep. */
+	KUNIT_EXPECT_EQ(test, apple_smc_notice_idle(&ctx->smc), 0);
+	apple_smc_notice_on(&ctx->smc);
+	KUNIT_ASSERT_EQ(test, ctx->seen_count, 4U);
+	KUNIT_EXPECT_EQ(test, ctx->seen[0], (u32)MACSMC_TEST_AP_IDLE);
+	KUNIT_EXPECT_EQ(test, ctx->seen[1], (u32)MACSMC_TEST_AP_ON);
+	KUNIT_EXPECT_EQ(test, ctx->seen[2], SMC_KEY(MBSE));
+	KUNIT_EXPECT_EQ(test, ctx->seen[3], SMC_KEY(MBSW));
+}
+
 static struct kunit_case macsmc_parser_cases[] = {
 	KUNIT_CASE(macsmc_key_info_lock_test),
 	KUNIT_CASE(macsmc_key_index_test),
@@ -209,6 +289,9 @@ static struct kunit_case macsmc_parser_cases[] = {
 	KUNIT_CASE(macsmc_request_bounds_test),
 	KUNIT_CASE(macsmc_sram_value_test),
 	KUNIT_CASE(macsmc_key_info_test),
+	KUNIT_CASE(macsmc_sleep_order_test),
+	KUNIT_CASE(macsmc_sleep_refused_test),
+	KUNIT_CASE(macsmc_notice_test),
 	{}
 };
 
