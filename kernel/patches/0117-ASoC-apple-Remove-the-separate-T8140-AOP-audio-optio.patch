From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Wed, 28 Oct 2026 15:03:19 +1100
Subject: [PATCH] ASoC: apple: Remove the separate T8140 AOP audio option

aop_audio drives the T8140 services now. Drop the
SND_SOC_APPLE_T8140_AOP_AUDIO option from Kconfig, the Asahi config
fragment and the Apple firmware KUnit config, which enables aop_audio
instead to keep running the T8140 and lid test suites.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 378188c4dcdecb6fb112500c838cec96d627c668)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/configs/asahi.config                   |  1 -
 sound/soc/apple/Kconfig                           | 14 --------------
 sound/soc/apple/aop_spkr.rs                       |  2 +-
 tools/testing/kunit/configs/apple_firmware.config |  2 +-
 4 files changed, 2 insertions(+), 17 deletions(-)

diff --git a/arch/arm64/configs/asahi.config b/arch/arm64/configs/asahi.config
index 0fdaac01ba..723d46aced 100644
--- a/arch/arm64/configs/asahi.config
+++ b/arch/arm64/configs/asahi.config
@@ -58,7 +58,6 @@ CONFIG_DRM_ACCEL_ANE=m
 CONFIG_DRM_SIMPLEDRM=y
 CONFIG_SYSFB_SIMPLEFB=y
 CONFIG_SND_SOC_APPLE_AOP_AUDIO=m
-CONFIG_SND_SOC_APPLE_T8140_AOP_AUDIO=m
 CONFIG_SND_SOC_APPLE_MCA=m
 CONFIG_SND_SOC_APPLE_MACAUDIO=m
 CONFIG_SND_SOC_CS42L83=m
diff --git a/sound/soc/apple/Kconfig b/sound/soc/apple/Kconfig
index 0d8247cb05..92ffcb6073 100644
--- a/sound/soc/apple/Kconfig
+++ b/sound/soc/apple/Kconfig
@@ -14,20 +14,6 @@ config SND_SOC_APPLE_AOP_AUDIO
 	  machines, and on T8140 the back-end DAIs for the headphone jack and the
 	  internal speaker, which the macaudio driver links into its card.
 
-config SND_SOC_APPLE_T8140_AOP_AUDIO
-	tristate "Apple T8140 AOP audio driver"
-	depends on ARCH_APPLE || COMPILE_TEST
-	depends on INPUT
-	depends on RUST
-	select APPLE_AOP
-	select SND_DMAENGINE_PCM
-	help
-	  This option enables a driver for the audio paths owned by the AOP
-	  co-processor on Apple T8140 SoCs: a card with the low-power and the
-	  high-quality microphones, and ASoC back-end DAIs for the headphone
-	  jack and the internal speaker, which the macaudio driver links into
-	  its card. The microphones read as unplugged while the lid is closed.
-
 config SND_SOC_APPLE_MCA
 	tristate "Apple Silicon MCA driver"
 	depends on ARCH_APPLE || COMPILE_TEST
diff --git a/sound/soc/apple/aop_spkr.rs b/sound/soc/apple/aop_spkr.rs
index ba411c6721..9c25303287 100644
--- a/sound/soc/apple/aop_spkr.rs
+++ b/sound/soc/apple/aop_spkr.rs
@@ -56,7 +56,7 @@
 //! channels.
 //!
 //! The structure (component context with the descriptor as its first field, DAI tables, dmaengine
-//! front-ends) follows aurora's t8140_aop_audio.rs (Copyright (C) 2026 The Aurora Silicon
+//! front-ends) follows aurora's T8140 backend, aop_t8140.rs (Copyright (C) 2026 The Aurora Silicon
 //! Contributors).
 
 use core::{
diff --git a/tools/testing/kunit/configs/apple_firmware.config b/tools/testing/kunit/configs/apple_firmware.config
index 61eeab466b..1778162f70 100644
--- a/tools/testing/kunit/configs/apple_firmware.config
+++ b/tools/testing/kunit/configs/apple_firmware.config
@@ -21,7 +21,7 @@ CONFIG_RUST=y
 CONFIG_SOUND=y
 CONFIG_SND=y
 CONFIG_SND_SOC=y
-CONFIG_SND_SOC_APPLE_T8140_AOP_AUDIO=y
+CONFIG_SND_SOC_APPLE_AOP_AUDIO=y
 CONFIG_SERIAL_AMBA_PL011=y
 CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
 CONFIG_FW_LOADER=y
