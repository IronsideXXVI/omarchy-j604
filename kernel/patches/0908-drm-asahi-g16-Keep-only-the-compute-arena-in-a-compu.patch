+            }
+        }
+        writeln!(f)
+    }
     pub(crate) fn new(dev: &AsahiDrmDevice) -> Self {
         Self {
             dev: dev.as_ref().as_ref().into(),
@@ -686,6 +696,10 @@ pub(crate) fn expose(&self) {
     pub(crate) fn is_exposed(&self) -> bool {
         self.exposed.load(Ordering::Acquire)
     }
+    /// The id of the VM this manager belongs to (stats only).
+    pub(crate) fn vm_id(&self) -> u64 {
+        self._vm.id
+    }
     pub(crate) fn same_vm(&self, vm: &Arc<super::vm::VmState>) -> bool {
         Arc::ptr_eq(&self._vm, vm)
     }
diff --git a/drivers/gpu/drm/asahi/g16/resources.rs b/drivers/gpu/drm/asahi/g16/resources.rs
