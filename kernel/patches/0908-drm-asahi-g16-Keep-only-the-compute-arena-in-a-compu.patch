diff --git a/drivers/gpu/drm/asahi/g16/slots.rs b/drivers/gpu/drm/asahi/g16/slots.rs
index f0db9bc142..b1c52c2b55 100644
--- a/drivers/gpu/drm/asahi/g16/slots.rs
+++ b/drivers/gpu/drm/asahi/g16/slots.rs
@@ -531,6 +531,18 @@ pub(crate) struct SlotStats {
     pub(crate) pass_scrubs: u64,
 }
 
+/// A compute unit's last-owner lease. It keeps what the unit's last command can name: the
+/// VM's compute arena, which owns that VM's binding (page tables and ASID), its live token
+/// and every compute object. It does not keep the whole VM: a closed VM's render arena and
+/// context mapping go with the VM's other references, so a compute lease, which only another
+/// VM's compute command displaces, no longer pins the render memory of a client that exited.
+pub(crate) struct ComputeOwner {
+    id: u64,
+    slot: u32,
+    generation: u8,
+    arena: Arc<super::resources::ComputeArena>,
+}
+
 pub(crate) struct Slots {
     pub(crate) cursor: u32,
     pub(crate) pass_busy: u32,
@@ -540,11 +552,11 @@ pub(crate) struct Slots {
     pass_lifetime: Lifetime,
     // Last-owner leases remain bound through retirement and displacement. Replaced only
     // when the displaced unit is safely rebound to a new publication.
-    compute_owner: [Option<Arc<super::vm::VmState>>; sizes::COMPUTE_UNITS_MAX],
+    compute_owner: [Option<ComputeOwner>; sizes::COMPUTE_UNITS_MAX],
     pass_owner: [Option<Arc<super::vm::VmState>>; sizes::RENDER_UNITS],
     pending_compute_retarget: [Option<VmRetarget>; sizes::COMPUTE_UNITS_MAX],
     pending_pass_retarget: [Option<VmRetarget>; sizes::RENDER_UNITS],
-    pending_compute_owner: [Option<Arc<super::vm::VmState>>; sizes::COMPUTE_UNITS_MAX],
+    pending_compute_owner: [Option<ComputeOwner>; sizes::COMPUTE_UNITS_MAX],
     pending_pass_owner: [Option<Arc<super::vm::VmState>>; sizes::RENDER_UNITS],
 }
 impl Slots {
@@ -686,20 +698,39 @@ pub(crate) fn claim_ct(&mut self, _f: &mut Claims, _bytes: u64) -> Result<Option
     }
     fn vm_retarget(
         unit: usize,
-        old: &super::vm::VmState,
+        old: (u64, u32, u8),
         new: &super::vm::VmState,
     ) -> Option<VmRetarget> {
-        (old.id != new.id).then_some(VmRetarget {
+        (old.0 != new.id).then_some(VmRetarget {
             unit: unit as u32,
-            old_vm: old.id,
+            old_vm: old.0,
             new_vm: new.id,
-            old_asid: old.slot,
+            old_asid: old.1,
             new_asid: new.slot,
-            old_generation: old.generation,
+            old_generation: old.2,
             new_generation: new.generation,
         })
     }
 
+    /// Read-only: every unit that still holds a last-owner lease, by VM id (and, for compute,
+    /// the leased compute arena's bytes in MiB). Under the device lock, like all stats.
+    pub(crate) fn write_leases(&self, f: &mut impl core::fmt::Write) -> core::fmt::Result {
+        write!(f, "compute_leases:")?;
+        for (k, o) in self.compute_owner.iter().enumerate() {
+            if let Some(o) = o {
+                write!(f, " {}:{}:{}", k, o.id, o.arena.bytes >> 20)?;
+            }
+        }
+        writeln!(f)?;
+        write!(f, "render_leases:")?;
+        for (k, o) in self.pass_owner.iter().enumerate() {
+            if let Some(o) = o {
+                write!(f, " {}:{}", k, o.id)?;
+            }
+        }
+        writeln!(f)
+    }
+
     /// Records a host transfer only after every queue producer and doorbell succeeded.
     /// Full wire retirement is a separate condition for hardware qualification.
     pub(crate) fn note_published(&mut self, f: &Claims) {
@@ -722,8 +753,14 @@ pub(crate) fn note_published(&mut self, f: &Claims) {
     }
 
     /// Retains each actual owner's VM/ASID binding through the firmware's last-owner era.
-    /// A previous lease is replaced only after the new publication fully retires.
-    pub(crate) fn hold_vm(&mut self, f: &Claims, vm: &Arc<super::vm::VmState>) -> Result {
+    /// A previous lease is replaced only after the new publication fully retires. A compute
+    /// lease holds the job's compute arena (which owns the VM binding), not the VM.
+    pub(crate) fn hold_vm(
+        &mut self,
+        f: &Claims,
+        vm: &Arc<super::vm::VmState>,
+        compute: Option<&Arc<super::resources::ComputeArena>>,
+    ) -> Result {
         if f.slot_count as usize > sizes::COMPUTE_UNITS_MAX
             || f.slot[..f.slot_count as usize]
                 .iter()
@@ -734,16 +771,22 @@ pub(crate) fn hold_vm(&mut self, f: &Claims, vm: &Arc<super::vm::VmState>) -> Re
         }
         for &k in &f.slot[..f.slot_count as usize] {
             let k = k as usize;
+            let arena = compute.ok_or(EINVAL)?;
             self.pending_compute_retarget[k] = self.compute_owner[k]
                 .as_ref()
-                .and_then(|old| Self::vm_retarget(k, old, vm));
-            self.pending_compute_owner[k] = Some(vm.clone());
+                .and_then(|old| Self::vm_retarget(k, (old.id, old.slot, old.generation), vm));
+            self.pending_compute_owner[k] = Some(ComputeOwner {
+                id: vm.id,
+                slot: vm.slot,
+                generation: vm.generation,
+                arena: arena.clone(),
+            });
         }
         for k in 0..sizes::RENDER_UNITS {
             if f.pass_mask & (1 << k) != 0 {
                 self.pending_pass_retarget[k] = self.pass_owner[k]
                     .as_ref()
-                    .and_then(|old| Self::vm_retarget(k, old, vm));
+                    .and_then(|old| Self::vm_retarget(k, (old.id, old.slot, old.generation), vm));
                 self.pending_pass_owner[k] = Some(vm.clone());
             }
         }
diff --git a/drivers/gpu/drm/asahi/g16/vm.rs b/drivers/gpu/drm/asahi/g16/vm.rs
index 343986a9f3..bd4f73dbdd 100644
--- a/drivers/gpu/drm/asahi/g16/vm.rs
+++ b/drivers/gpu/drm/asahi/g16/vm.rs
@@ -282,6 +282,15 @@ fn prune(&self) {
         }
     }
 
+    /// Read-only: the ids of VMs whose handle is still registered (open).
+    pub(crate) fn write_open(&self, f: &mut impl core::fmt::Write) -> core::fmt::Result {
+        write!(f, "vm_open:")?;
+        for state in self.vms.lock().iter() {
+            write!(f, " {}", state.id)?;
+        }
+        writeln!(f)
+    }
+
     pub(crate) fn counts(&self) -> (u32, usize) {
         (self.live.load(Ordering::Acquire), self.vms.lock().len())
     }
