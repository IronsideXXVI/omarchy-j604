From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 18:01:19 +0000
Subject: [PATCH] drm/asahi: g16: Show the PMP's GFX request and
 acknowledgment words

When the GPU firmware reports itself powered down, its coprocessor
sleeps and the host does nothing, the GPU power domain can still be
held on by a request the block keeps seeing. On T8132 the PMP keeps
one such request word for the SoC devices (SOC-DEV-PS-REQ) and one
acknowledgment word (SOC-DEV-PS-ACK); GFX is bit 12 in both.

Export a read-only accessor for the two words from the PMP report
driver and add them to aurora-g16/fwpower as `psreq`, next to the GFX
power-state word, so one read shows the request, its acknowledgment
and the domain's actual state together. Nothing is written; without a
T8132 report both print as all ones.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/poll.rs    | 13 +++++++++++--
 drivers/pmdomain/apple/pmp-report.c  | 25 +++++++++++++++++++++++++
 include/linux/soc/apple/pmp-report.h |  7 +++++++
 3 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 676c2cdc15..15646fb798 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -156,6 +156,8 @@ pub(crate) struct FwPower {
 /// stopped; the read itself reaches the GPU block, so read the file slowly while the domain's idle
 /// share is measured. `rx`: the producer indices of the event ring, the nine log sub-rings
 /// (summed), ktrace and statistics; any of them moving at idle means the firmware writes records.
+/// `psreq`: the PMP's SOC-DEV-PS-REQ / PS-ACK words (T8132; GFX is bit 12), all ones where there
+/// is no such report.
 fn fwpower_show(v: &FwPower, f: &mut fmt::Formatter<'_>) -> fmt::Result {
     let [pp, power, control, globals] = &v.objects;
     let r = |o: &FwObject, at: usize| o.r32(at).unwrap_or(0xdead_beef);
@@ -183,6 +185,10 @@ fn fwpower_show(v: &FwPower, f: &mut fmt::Formatter<'_>) -> fmt::Result {
     let [rx_event, rx_log, rx_trace, rx_stats] = &v.rx;
     let produced = |o: &FwObject, at: usize| r(o, at + super::fw::channels::STATE_WRITE);
     let logs = (0..9).fold(0u32, |n, i| n.wrapping_add(produced(rx_log, i * 0x30)));
+    let (mut req, mut ack) = (u64::MAX, u64::MAX);
+    // SAFETY: both outputs are valid for the call; the provider only reads its report block and
+    // leaves both untouched (all ones) when there is no T8132 report.
+    let _ = unsafe { bindings::apple_pmp_report_t8132_gfx_words(&mut req, &mut ack) };
     let pending = v
         .rings
         .iter()
@@ -195,7 +201,8 @@ fn fwpower_show(v: &FwPower, f: &mut fmt::Formatter<'_>) -> fmt::Result {
          retries {} defer {} defer_t {} seq {} veto {} req {} hi {} \
          ctl {:#x}/{:#x}/{:#x}/{:#x}/{:#x} g {}/{}/{}/{}/{} rings {:#x} \
          fw {:#x}/{:#x}/{:#x}/{:#x} st {:#x} ipo {:#x} q {:#x}/{:#x} \
-         floor {}/{} cap {}/{} ps {:#x} cpu {:#x} rx {}/{}/{}/{}",
+         floor {}/{} cap {}/{} ps {:#x} cpu {:#x} rx {}/{}/{}/{} \
+         psreq {:#x}/{:#x}",
         counter_ticks(),
         r(pp, 0x10),
         r(pp, 0xc),
@@ -240,7 +247,9 @@ fn fwpower_show(v: &FwPower, f: &mut fmt::Formatter<'_>) -> fmt::Result {
         produced(rx_event, 0),
         logs,
         produced(rx_trace, 0),
-        produced(rx_stats, 0)
+        produced(rx_stats, 0),
+        req,
+        ack
     )
 }
 
diff --git a/drivers/pmdomain/apple/pmp-report.c b/drivers/pmdomain/apple/pmp-report.c
index 41a92d7c5f..591ca7df98 100644
--- a/drivers/pmdomain/apple/pmp-report.c
+++ b/drivers/pmdomain/apple/pmp-report.c
@@ -3229,6 +3229,31 @@ int apple_pmp_report_set_t6030_gfx(struct device *supplier, bool enable)
 	return apple_pmp_report_t6030_gfx(supplier, &enable);
 }
 EXPORT_SYMBOL_GPL(apple_pmp_report_set_t6030_gfx);
+
+/*
+ * T8132: the request (SOC-DEV-PS-REQ, the target-read word) and acknowledgment
+ * (SOC-DEV-PS-ACK, the actual word) the PMP holds for the SoC devices; GFX is
+ * bit 12. Read only: the GPU driver shows both next to its own power words.
+ * Neither output is written without a T8132 report.
+ */
+int apple_pmp_report_t8132_gfx_words(u64 *req, u64 *ack)
+{
+	struct apple_pmp_report *rep;
+	int ret = -ENODEV;
+
+	rcu_read_lock();
+	list_for_each_entry_rcu(rep, &apple_pmp_reports, list) {
+		if (rep->offsets != &apple_pmp_offsets_t8132)
+			continue;
+		*req = readq(rep->base + rep->offsets->tgt_read);
+		*ack = readq(rep->base + rep->offsets->actual);
+		ret = 0;
+		break;
+	}
+	rcu_read_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_pmp_report_t8132_gfx_words);
 /*
  * One 64-bit store of the whole request word. Never read a request entry
  * back after storing it: the read retires the pending PTD update before the
diff --git a/include/linux/soc/apple/pmp-report.h b/include/linux/soc/apple/pmp-report.h
index 196494a69c..60a1c38737 100644
--- a/include/linux/soc/apple/pmp-report.h
+++ b/include/linux/soc/apple/pmp-report.h
@@ -47,6 +47,8 @@ void apple_pmp_agx_activity_begin(void);
 void apple_pmp_agx_activity_end(void);
 void apple_pmp_agx_activity_release(void);
 void apple_pmp_agx_activity_resume(void);
+/* T8132: the SOC-DEV-PS-REQ and SOC-DEV-PS-ACK words (GFX is bit 12), read only. */
+int apple_pmp_report_t8132_gfx_words(u64 *req, u64 *ack);
 void apple_pmp_report_sleep(struct device *pmp, bool at_commit);
 void apple_pmp_report_wake(struct device *pmp, bool lost_power);
 int apple_pmp_report_entry_request(const struct device_node *entry, bool enable);
@@ -119,6 +121,11 @@ static inline void apple_pmp_agx_activity_begin(void)
 {
 }
 
+static inline int apple_pmp_report_t8132_gfx_words(u64 *req, u64 *ack)
+{
+	return -ENODEV;
+}
+
 static inline void apple_pmp_agx_activity_end(void)
 {
 }
-- 
2.43.0

