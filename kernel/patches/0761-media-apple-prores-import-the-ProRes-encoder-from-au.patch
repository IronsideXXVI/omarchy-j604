+	struct apr_ctx *active;	/* job in the engine, or NULL */
+	u32 head;		/* next free ring offset */
+	bool ring_ready;	/* engine registers programmed since power-up */
+	bool broken;		/* timed out with no way to reset */
+	unsigned long started;	/* jiffies at submission */
+	struct delayed_work watchdog;
+};
+
+struct apr_ctx {
+	struct v4l2_fh fh;
+	struct apr_dev *apr;
+	struct v4l2_ctrl_handler hdl;
+	struct v4l2_ctrl *profile;
+	struct v4l2_pix_format_mplane src_fmt;
+	struct v4l2_pix_format_mplane dst_fmt;
+	const struct apr_fmt *raw;
+	enum apr_profile stream_profile;	/* fixed while OUTPUT streams */
+	u32 sequence;
+};
+
+static struct apr_ctx *apr_file_to_ctx(struct file *file)
+{
+	return container_of(file_to_v4l2_fh(file), struct apr_ctx, fh);
+}
+
+/* ---- hardware ---------------------------------------------------------- */
+
+static void apr_write(struct apr_dev *apr, u32 reg, u32 val)
+{
+	writel_relaxed(val, apr->regs + reg);
+}
+
+static u32 apr_read(struct apr_dev *apr, u32 reg)
+{
+	return readl_relaxed(apr->regs + reg);
+}
+
+/*
+ * Program the engine from power-up state. The ring must be installed before
+ * MODE enables descriptor execution, otherwise the engine fetches from IOVA 0.
+ */
+static void apr_apply(void __iomem *base, const struct apr_tunable *t, size_t n)
+{
+	for (size_t i = 0; i < n; i++) {
+		u32 v = readl_relaxed(base + t[i].offset);
+
+		writel_relaxed((v & ~t[i].mask) | (t[i].value & t[i].mask), base + t[i].offset);
+	}
+}
+
+static void apr_hw_init(struct apr_dev *apr)
+{
+	const struct apr_variant *v = apr->variant;
+	unsigned int t, i;
+
+	apr_write(apr, APR_REG_MODE, APR_MODE_OFF);
+	apr_write(apr, APR_REG_IRQ_ENABLE, 0);
+	apr_apply(apr->regs, v->engine_tunables, v->num_engine_tunables);
+	if (v->num_wrapper_tunables)
+		apr_apply(apr->wrapper, v->wrapper_tunables, v->num_wrapper_tunables);
+	apr_write(apr, APR_REG_RING_HEAD, 0);
+	apr_write(apr, APR_REG_RING_TAIL, 0);
+	apr_write(apr, APR_REG_RING_SIZE, v->ring_bytes);
+	apr_write(apr, APR_REG_RING_LO, lower_32_bits(apr->ring_dma));
+	apr_write(apr, APR_REG_RING_HI, upper_32_bits(apr->ring_dma));
+	/* Both statistics consumers share one area. */
+	for (i = 0; i < ARRAY_SIZE(v->stats); i++) {
+		apr_write(apr, v->stats[i].lo, lower_32_bits(apr->stats_dma) & ~0x3fU);
+		apr_write(apr, v->stats[i].hi, upper_32_bits(apr->stats_dma) & 0x3ff);
+	}
+	apr_write(apr, APR_REG_MODE, APR_MODE_RUN);
+
+	for (t = 0; t < APR_QTABLES; t++) {
+		for (i = 0; i < 32; i++) {
+			apr_write(apr, APR_REG_QUANT_LUMA(t) + 4 * i,
+				  apr_qmat_reg(apr_qmat_luma[t], i));
+			apr_write(apr, APR_REG_QUANT_CHROMA(t) + 4 * i,
+				  apr_qmat_reg(apr_qmat_chroma[t], i));
+		}
+	}
+	for (i = 0; i < APR_DC_SCALE_ENTRIES; i++)
+		apr_write(apr, APR_REG_DC_SCALE(i), apr_dc_scale_reg(i));
+
+	apr_write(apr, APR_REG_IRQ_STATUS, apr_read(apr, APR_REG_IRQ_STATUS));
+	apr_write(apr, APR_REG_IRQ_ENABLE, APR_IRQ_DONE | APR_IRQ_ERROR);
+	/* Order the setup before any descriptor publication. */
+	wmb();
+	apr->head = 0;
+	apr->ring_ready = true;
+}
+
+static u32 apr_coded_size(u32 width, u32 height, bool is444)
+{
+	/* Worst case for 4444 XQ at the lowest quantiser, plus headers. */
+	u64 size = (u64)ALIGN(width, 16) * ALIGN(height, 16) * (is444 ? 4 : 3) + SZ_64K;
+
+	return min_t(u64, PAGE_ALIGN(size), SZ_256M);
+}
+
+static u8 apr_color_primaries(const struct v4l2_pix_format_mplane *f)
+{
+	switch (f->colorspace) {
+	case V4L2_COLORSPACE_REC709:
+	case V4L2_COLORSPACE_SRGB:
+		return 1;
+	case V4L2_COLORSPACE_SMPTE170M:
+		return 6;
+	case V4L2_COLORSPACE_470_SYSTEM_BG:
+		return 5;
+	case V4L2_COLORSPACE_BT2020:
+		return 9;
+	case V4L2_COLORSPACE_DCI_P3:
+		return 11;
+	default:
+		return 2;	/* unspecified */
+	}
+}
+
+static u8 apr_color_transfer(const struct v4l2_pix_format_mplane *f)
+{
+	switch (f->xfer_func) {
+	case V4L2_XFER_FUNC_709:
+		return 1;
+	case V4L2_XFER_FUNC_SMPTE2084:
+		return 16;
+	default:
+		return f->colorspace == V4L2_COLORSPACE_REC709 ? 1 : 2;
+	}
+}
+
+static u8 apr_color_matrix(const struct v4l2_pix_format_mplane *f)
+{
+	switch (f->ycbcr_enc) {
+	case V4L2_YCBCR_ENC_709:
+		return 1;
+	case V4L2_YCBCR_ENC_601:
+		return 6;
+	case V4L2_YCBCR_ENC_BT2020:
+		return 9;
+	default:
+		return f->colorspace == V4L2_COLORSPACE_REC709 ? 1 : 2;
+	}
+}
+
+static void apr_fill_frame(struct apr_ctx *ctx, struct vb2_v4l2_buffer *src,
+			   struct vb2_v4l2_buffer *dst, struct apr_frame *f)
+{
+	const struct v4l2_pix_format_mplane *s = &ctx->src_fmt;
+	u32 luma_stride = s->plane_fmt[0].bytesperline;
+	dma_addr_t in = vb2_dma_contig_plane_dma_addr(&src->vb2_buf, 0);
+
+	*f = (struct apr_frame){
+		.width = s->width,
+		.height = s->height,
+		.input = ctx->raw->input,
+		.profile = ctx->stream_profile,
+		.luma_stride = luma_stride,
+		.chroma_stride = luma_stride * (ctx->raw->is444 ? 2 : 1),
+		.luma = in,
+		.chroma = in + (u64)luma_stride * s->height,
+		.output = vb2_dma_contig_plane_dma_addr(&dst->vb2_buf, 0),
+		.output_size = vb2_plane_size(&dst->vb2_buf, 0),
+		.primaries = apr_color_primaries(s),
+		.transfer = apr_color_transfer(s),
+		.matrix = apr_color_matrix(s),
+	};
+}
+
+static void apr_finish_job(struct apr_dev *apr, struct apr_ctx *ctx, int err)
+{
+	struct v4l2_m2m_ctx *m2m = ctx->fh.m2m_ctx;
+	struct vb2_v4l2_buffer *src, *dst;
+	u32 bytes = 0;
+
+	src = v4l2_m2m_src_buf_remove(m2m);
+	dst = v4l2_m2m_dst_buf_remove(m2m);
+	if (WARN_ON(!src || !dst))
+		goto out;
+
+	if (!err) {
+		u8 *out = vb2_plane_vaddr(&dst->vb2_buf, 0);
+
+		/* The engine wrote the frame through the DART; see it now. */
+		dma_rmb();
+		err = out ? apr_check_output(out, vb2_plane_size(&dst->vb2_buf, 0),
+					     &bytes) : -EIO;
+		if (err)
+			dev_err_ratelimited(apr->dev, "engine returned no frame\n");
+	}
+	vb2_set_plane_payload(&dst->vb2_buf, 0, err ? 0 : bytes);
+	v4l2_m2m_buf_copy_metadata(src, dst);
+	dst->sequence = ctx->sequence++;
+	dst->flags |= V4L2_BUF_FLAG_KEYFRAME;
+	if (v4l2_m2m_is_last_draining_src_buf(m2m, src)) {
+		static const struct v4l2_event eos = { .type = V4L2_EVENT_EOS };
+
+		dst->flags |= V4L2_BUF_FLAG_LAST;
+		v4l2_event_queue_fh(&ctx->fh, &eos);
+		v4l2_m2m_mark_stopped(m2m);
+	}
+	v4l2_m2m_buf_done(src, err ? VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
+	v4l2_m2m_buf_done(dst, err ? VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
+out:
+	pm_runtime_mark_last_busy(apr->dev);
+	pm_runtime_put_autosuspend(apr->dev);
+	v4l2_m2m_job_finish(apr->m2m_dev, m2m);
+}
+
+/*
+ * Claim the active job if the engine has finished it. Returns the context to
+ * finish, or NULL. Called with hw_lock held.
+ */
+static struct apr_ctx *apr_take_done(struct apr_dev *apr, int *err)
+{
+	struct apr_ctx *ctx = apr->active;
+	u32 status, tail;
+
+	if (!ctx)
+		return NULL;
+	status = apr_read(apr, APR_REG_IRQ_STATUS);
+	if (!status)
+		return NULL;
+	apr_write(apr, APR_REG_IRQ_STATUS, status);
+	tail = apr_read(apr, APR_REG_RING_TAIL) & APR_RING_PTR_MASK;
+	*err = 0;
+	if (status != APR_IRQ_DONE || tail != apr->head) {
+		dev_err_ratelimited(apr->dev,
+				    "job failed: status %#x tail %#x head %#x st %#x/%#x\n",
+				    status, tail, apr->head,
+				    apr_read(apr, APR_REG_ST0), apr_read(apr, APR_REG_ST1));
+		*err = -EIO;
+	}
+	apr->active = NULL;
+	return ctx;
+}
+
+static irqreturn_t apr_irq(int irq, void *data)
+{
+	struct apr_dev *apr = data;
+	struct apr_ctx *ctx;
+	int err = 0;
+
+	spin_lock(&apr->hw_lock);
+	ctx = apr_take_done(apr, &err);
+	spin_unlock(&apr->hw_lock);
+	if (!ctx)
+		return IRQ_NONE;
+	cancel_delayed_work(&apr->watchdog);
+	apr_finish_job(apr, ctx, err);
+	return IRQ_HANDLED;
+}
+
+/*
+ * Backstop for a lost interrupt and for hangs. A hung engine is reset
+ * through its power domain and reprogrammed; without a reset line the
+ * device refuses further jobs rather than reuse memory it may still own.
+ */
+static void apr_watchdog(struct work_struct *work)
+{
+	struct apr_dev *apr = container_of(work, struct apr_dev, watchdog.work);
+	struct apr_ctx *ctx;
+	unsigned long flags;
+	int err = 0;
+
+	spin_lock_irqsave(&apr->hw_lock, flags);
+	ctx = apr_take_done(apr, &err);
+	if (ctx) {
+		spin_unlock_irqrestore(&apr->hw_lock, flags);
+		dev_warn_once(apr->dev, "completion found without an interrupt\n");
+		apr_finish_job(apr, ctx, err);
+		return;
+	}
+	ctx = apr->active;
+	if (!ctx) {
+		spin_unlock_irqrestore(&apr->hw_lock, flags);
+		return;
+	}
+	if (time_before(jiffies, apr->started + msecs_to_jiffies(APR_TIMEOUT_MS))) {
+		spin_unlock_irqrestore(&apr->hw_lock, flags);
+		schedule_delayed_work(&apr->watchdog, msecs_to_jiffies(APR_POLL_MS));
+		return;
+	}
+	dev_err(apr->dev, "job timed out: head %#x tail %#x st %#x/%#x\n",
+		apr->head, apr_read(apr, APR_REG_RING_TAIL),
+		apr_read(apr, APR_REG_ST0), apr_read(apr, APR_REG_ST1));
+	apr->active = NULL;
+	apr_write(apr, APR_REG_IRQ_ENABLE, 0);
+	apr_write(apr, APR_REG_MODE, APR_MODE_OFF);
+	apr->ring_ready = false;
+	/* No new job can start until this one is finished below. */
+	spin_unlock_irqrestore(&apr->hw_lock, flags);
+	if (!apr->reset || reset_control_reset(apr->reset)) {
+		dev_err(apr->dev, "engine cannot be reset, refusing further jobs\n");
+		spin_lock_irqsave(&apr->hw_lock, flags);
+		apr->broken = true;
+		spin_unlock_irqrestore(&apr->hw_lock, flags);
+	}
+	apr_finish_job(apr, ctx, -ETIMEDOUT);
+}
+
+static void apr_device_run(void *priv)
+{
+	struct apr_ctx *ctx = priv;
+	struct apr_dev *apr = ctx->apr;
+	struct vb2_v4l2_buffer *src, *dst;
+	struct apr_frame f;
+	unsigned long flags;
+	void *out;
+	int ret;
+
+	src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+
+	ret = pm_runtime_resume_and_get(apr->dev);
+	if (ret < 0) {
+		pm_runtime_get_noresume(apr->dev);
+		apr_finish_job(apr, ctx, ret);
+		return;
+	}
+	apr_fill_frame(ctx, src, dst, &f);
+	/* Mark the output invalid so a frame the engine never wrote is caught. */
+	out = vb2_plane_vaddr(&dst->vb2_buf, 0);
+	if (!out) {
+		apr_finish_job(apr, ctx, -EINVAL);
+		return;
+	}
+	memset(out, 0, 8);
+
+	spin_lock_irqsave(&apr->hw_lock, flags);
+	if (apr->broken) {
+		spin_unlock_irqrestore(&apr->hw_lock, flags);
+		apr_finish_job(apr, ctx, -EIO);
+		return;
+	}
+	/*
+	 * The engine's ring wrap protocol is not known, so start again at the
+	 * beginning of the ring instead of wrapping. The engine is idle here.
+	 */
+	if (!apr->ring_ready ||
+	    apr->head + apr->variant->desc_bytes > apr->variant->ring_bytes)
+		apr_hw_init(apr);
+	ret = apr->variant->build_desc(&f, apr->ring + apr->head);
+	if (ret) {
+		spin_unlock_irqrestore(&apr->hw_lock, flags);
+		apr_finish_job(apr, ctx, ret);
+		return;
+	}
+	apr->head += apr->variant->desc_bytes;
+	apr->active = ctx;
+	apr->started = jiffies;
+	/* Descriptor and buffers must be visible before the head moves. */
+	dma_wmb();
+	writel(apr->head, apr->regs + APR_REG_RING_HEAD);
+	spin_unlock_irqrestore(&apr->hw_lock, flags);
+	schedule_delayed_work(&apr->watchdog, msecs_to_jiffies(APR_POLL_MS));
+}
+
+static const struct v4l2_m2m_ops apr_m2m_ops = {
+	.device_run = apr_device_run,
+};
+
+/* ---- formats ----------------------------------------------------------- */
+
+static const struct apr_fmt *apr_find_raw(u32 fourcc)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(apr_raw_fmts); i++)
+		if (apr_raw_fmts[i].fourcc == fourcc)
+			return &apr_raw_fmts[i];
+	return NULL;
+}
+
+/*
+ * One contiguous plane: Y rows, then interleaved CbCr rows. The engine
+ * reads whole 16-row macroblocks, so space for the rows that round the
+ * height up follows the chroma region.
+ */
+static void apr_fill_raw(struct v4l2_pix_format_mplane *pix, const struct apr_fmt *fmt)
+{
+	u32 width = clamp_t(u32, ALIGN(pix->width, 2), APR_MIN_W, APR_MAX_W);
+	u32 height = clamp_t(u32, pix->height, APR_MIN_H, APR_MAX_H);
+	u32 min_stride = ALIGN(width * fmt->bytes, 64);
+	u32 stride = ALIGN(pix->plane_fmt[0].bytesperline, 64);
+	u32 cstride;
+
+	/* Accept padding up to one extra row width, as other drivers do. */
+	if (stride < min_stride || stride > 2 * min_stride)
+		stride = min_stride;
+	cstride = stride * (fmt->is444 ? 2 : 1);
+	pix->pixelformat = fmt->fourcc;
+	pix->width = width;
+	pix->height = height;
+	pix->field = V4L2_FIELD_NONE;
+	pix->num_planes = 1;
+	pix->flags = 0;
+	memset(pix->reserved, 0, sizeof(pix->reserved));
+	memset(pix->plane_fmt, 0, sizeof(pix->plane_fmt));
+	pix->plane_fmt[0].bytesperline = stride;
+	pix->plane_fmt[0].sizeimage = (stride + cstride) * ALIGN(height, 16);
+	if (pix->colorspace == V4L2_COLORSPACE_DEFAULT)
+		pix->colorspace = V4L2_COLORSPACE_REC709;
+	if (pix->xfer_func == V4L2_XFER_FUNC_DEFAULT)
+		pix->xfer_func = V4L2_MAP_XFER_FUNC_DEFAULT(pix->colorspace);
+	if (pix->ycbcr_enc == V4L2_YCBCR_ENC_DEFAULT)
+		pix->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(pix->colorspace);
+	if (pix->quantization == V4L2_QUANTIZATION_DEFAULT)
+		pix->quantization = V4L2_QUANTIZATION_LIM_RANGE;
+}
+
+static void apr_fill_coded(struct v4l2_pix_format_mplane *dst,
+			   const struct v4l2_pix_format_mplane *src, bool is444)
+{
+	*dst = *src;
+	dst->pixelformat = V4L2_PIX_FMT_PRORES;
+	dst->num_planes = 1;
+	memset(dst->plane_fmt, 0, sizeof(dst->plane_fmt));
+	dst->plane_fmt[0].sizeimage = apr_coded_size(src->width, src->height, is444);
+}
+
+static void apr_reset_fmts(struct apr_ctx *ctx)
+{
+	ctx->raw = &apr_raw_fmts[0];
+	memset(&ctx->src_fmt, 0, sizeof(ctx->src_fmt));
+	ctx->src_fmt.width = 1920;
+	ctx->src_fmt.height = 1080;
+	apr_fill_raw(&ctx->src_fmt, ctx->raw);
+	apr_fill_coded(&ctx->dst_fmt, &ctx->src_fmt, ctx->raw->is444);
+}
+
+static int apr_querycap(struct file *file, void *priv, struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, APR_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "Apple ProRes encoder", sizeof(cap->card));
+	return 0;
+}
+
+static int apr_enum_fmt_out(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	if (f->index >= ARRAY_SIZE(apr_raw_fmts))
+		return -EINVAL;
+	f->pixelformat = apr_raw_fmts[f->index].fourcc;
+	return 0;
+}
+
+static int apr_enum_fmt_cap(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+	f->pixelformat = V4L2_PIX_FMT_PRORES;
+	f->flags = V4L2_FMT_FLAG_COMPRESSED;
+	return 0;
+}
+
+static int apr_enum_framesizes(struct file *file, void *priv,
+			       struct v4l2_frmsizeenum *fs)
+{
+	if (fs->index || (fs->pixel_format != V4L2_PIX_FMT_PRORES &&
+			  !apr_find_raw(fs->pixel_format)))
+		return -EINVAL;
+	fs->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fs->stepwise = (struct v4l2_frmsize_stepwise){
+		APR_MIN_W, APR_MAX_W, 2, APR_MIN_H, APR_MAX_H, 1,
+	};
+	return 0;
+}
+
+static int apr_g_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	f->fmt.pix_mp = apr_file_to_ctx(file)->src_fmt;
+	return 0;
+}
+
+static int apr_g_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	f->fmt.pix_mp = apr_file_to_ctx(file)->dst_fmt;
+	return 0;
+}
+
+static int apr_try_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	const struct apr_fmt *fmt = apr_find_raw(f->fmt.pix_mp.pixelformat);
+
+	apr_fill_raw(&f->fmt.pix_mp, fmt ?: &apr_raw_fmts[0]);
+	return 0;
+}
+
+/* The coded size follows the raw format, as for other stateful encoders. */
+static int apr_try_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct apr_ctx *ctx = apr_file_to_ctx(file);
+
+	apr_fill_coded(&f->fmt.pix_mp, &ctx->src_fmt, ctx->raw->is444);
+	return 0;
+}
+
+static int apr_s_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct apr_ctx *ctx = apr_file_to_ctx(file);
+	struct v4l2_m2m_ctx *m2m = ctx->fh.m2m_ctx;
+
+	if (vb2_is_busy(v4l2_m2m_get_src_vq(m2m)) ||
+	    vb2_is_busy(v4l2_m2m_get_dst_vq(m2m)))
+		return -EBUSY;
+	apr_try_fmt_out(file, priv, f);
+	ctx->src_fmt = f->fmt.pix_mp;
+	ctx->raw = apr_find_raw(ctx->src_fmt.pixelformat);
+	apr_fill_coded(&ctx->dst_fmt, &ctx->src_fmt, ctx->raw->is444);
+	/* Keep the profile consistent with the chroma format. */
+	if (ctx->raw->is444 != apr_profile_is_444(v4l2_ctrl_g_ctrl(ctx->profile)))
+		v4l2_ctrl_s_ctrl(ctx->profile, ctx->raw->is444 ?
+				   V4L2_MPEG_VIDEO_PRORES_PROFILE_4444 :
+				   V4L2_MPEG_VIDEO_PRORES_PROFILE_STANDARD);
+	return 0;
+}
+
+static int apr_s_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct apr_ctx *ctx = apr_file_to_ctx(file);
+
+	if (vb2_is_busy(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
+		return -EBUSY;
+	apr_try_fmt_cap(file, priv, f);
+	ctx->dst_fmt = f->fmt.pix_mp;
+	return 0;
+}
+
+static int apr_subscribe_event(struct v4l2_fh *fh, const struct v4l2_event_subscription *sub)
+{
+	if (sub->type == V4L2_EVENT_EOS)
+		return v4l2_event_subscribe(fh, sub, 0, NULL);
+	return v4l2_ctrl_subscribe_event(fh, sub);
+}
+
+static const struct v4l2_ioctl_ops apr_ioctl_ops = {
+	.vidioc_querycap = apr_querycap,
+	.vidioc_enum_fmt_vid_out = apr_enum_fmt_out,
+	.vidioc_enum_fmt_vid_cap = apr_enum_fmt_cap,
+	.vidioc_enum_framesizes = apr_enum_framesizes,
+	.vidioc_g_fmt_vid_out_mplane = apr_g_fmt_out,
+	.vidioc_g_fmt_vid_cap_mplane = apr_g_fmt_cap,
+	.vidioc_try_fmt_vid_out_mplane = apr_try_fmt_out,
+	.vidioc_try_fmt_vid_cap_mplane = apr_try_fmt_cap,
+	.vidioc_s_fmt_vid_out_mplane = apr_s_fmt_out,
+	.vidioc_s_fmt_vid_cap_mplane = apr_s_fmt_cap,
+
+	.vidioc_reqbufs = v4l2_m2m_ioctl_reqbufs,
+	.vidioc_querybuf = v4l2_m2m_ioctl_querybuf,
+	.vidioc_qbuf = v4l2_m2m_ioctl_qbuf,
+	.vidioc_dqbuf = v4l2_m2m_ioctl_dqbuf,
+	.vidioc_prepare_buf = v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_create_bufs = v4l2_m2m_ioctl_create_bufs,
+	.vidioc_expbuf = v4l2_m2m_ioctl_expbuf,
+	.vidioc_streamon = v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff = v4l2_m2m_ioctl_streamoff,
+
+	.vidioc_try_encoder_cmd = v4l2_m2m_ioctl_try_encoder_cmd,
+	.vidioc_encoder_cmd = v4l2_m2m_ioctl_encoder_cmd,
+
+	.vidioc_subscribe_event = apr_subscribe_event,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
+};
+
+/* ---- queues ------------------------------------------------------------ */
+
+static struct v4l2_pix_format_mplane *apr_q_fmt(struct apr_ctx *ctx, u32 type)
+{
+	return V4L2_TYPE_IS_OUTPUT(type) ? &ctx->src_fmt : &ctx->dst_fmt;
+}
+
+static int apr_queue_setup(struct vb2_queue *q, unsigned int *nbufs,
+			   unsigned int *nplanes, unsigned int sizes[],
+			   struct device *alloc_devs[])
+{
+	struct apr_ctx *ctx = vb2_get_drv_priv(q);
+	u32 size = apr_q_fmt(ctx, q->type)->plane_fmt[0].sizeimage;
+
+	if (*nplanes)
+		return *nplanes == 1 && sizes[0] >= size ? 0 : -EINVAL;
+	*nplanes = 1;
+	sizes[0] = size;
+	return 0;
+}
+
+static int apr_buf_prepare(struct vb2_buffer *vb)
+{
+	struct apr_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	u32 size = apr_q_fmt(ctx, vb->type)->plane_fmt[0].sizeimage;
+
+	if (vb2_plane_size(vb, 0) < size)
+		return -EINVAL;
+	if (V4L2_TYPE_IS_OUTPUT(vb->type)) {
+		/* The engine always reads the whole padded surface. */
+		vb2_set_plane_payload(vb, 0, size);
+	} else {
+		vb2_set_plane_payload(vb, 0, 0);
+	}
+	return 0;
+}
+
+static void apr_buf_queue(struct vb2_buffer *vb)
+{
+	struct apr_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+
+	if (!V4L2_TYPE_IS_OUTPUT(vb->type) &&
+	    vb2_is_streaming(vb->vb2_queue) &&
+	    v4l2_m2m_dst_buf_is_last(ctx->fh.m2m_ctx)) {
+		vb2_set_plane_payload(vb, 0, 0);
+		vbuf->field = V4L2_FIELD_NONE;
+		v4l2_m2m_last_buffer_done(ctx->fh.m2m_ctx, vbuf);
+		return;
+	}
+	v4l2_m2m_buf_queue(ctx->fh.m2m_ctx, vbuf);
+}
+
+static int apr_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct apr_ctx *ctx = vb2_get_drv_priv(q);
+
+	if (V4L2_TYPE_IS_OUTPUT(q->type)) {
+		if (ctx->raw->is444 != apr_profile_is_444(v4l2_ctrl_g_ctrl(ctx->profile))) {
+			struct vb2_v4l2_buffer *vbuf;
+
+			while ((vbuf = v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx)))
+				v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_QUEUED);
+			return -EINVAL;
+		}
+		ctx->stream_profile = v4l2_ctrl_g_ctrl(ctx->profile);
+		v4l2_ctrl_grab(ctx->profile, true);
+		ctx->sequence = 0;
+	}
+	v4l2_m2m_update_start_streaming_state(ctx->fh.m2m_ctx, q);
+	return 0;
+}
+
+static void apr_stop_streaming(struct vb2_queue *q)
+{
+	struct apr_ctx *ctx = vb2_get_drv_priv(q);
+	struct vb2_v4l2_buffer *vbuf;
+
+	for (;;) {
+		vbuf = V4L2_TYPE_IS_OUTPUT(q->type) ?
+			v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx) :
+			v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+		if (!vbuf)
+			break;
+		v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_ERROR);
+	}
+	v4l2_m2m_update_stop_streaming_state(ctx->fh.m2m_ctx, q);
+	if (V4L2_TYPE_IS_OUTPUT(q->type))
+		v4l2_ctrl_grab(ctx->profile, false);
+	if (V4L2_TYPE_IS_OUTPUT(q->type) && v4l2_m2m_has_stopped(ctx->fh.m2m_ctx)) {
+		static const struct v4l2_event eos = { .type = V4L2_EVENT_EOS };
+
+		v4l2_event_queue_fh(&ctx->fh, &eos);
+	}
+}
+
+static const struct vb2_ops apr_qops = {
+	.queue_setup = apr_queue_setup,
+	.buf_prepare = apr_buf_prepare,
+	.buf_queue = apr_buf_queue,
+	.start_streaming = apr_start_streaming,
+	.stop_streaming = apr_stop_streaming,
+};
+
+static int apr_queue_init(void *priv, struct vb2_queue *src, struct vb2_queue *dst)
+{
+	struct apr_ctx *ctx = priv;
+	int ret;
+
+	src->type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+	src->io_modes = VB2_MMAP | VB2_DMABUF;
+	src->drv_priv = ctx;
+	src->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	src->ops = &apr_qops;
+	src->mem_ops = &vb2_dma_contig_memops;
+	src->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src->lock = &ctx->apr->vdev_lock;
+	src->dev = ctx->apr->dev;
+	ret = vb2_queue_init(src);
+	if (ret)
+		return ret;
+
+	dst->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	dst->io_modes = VB2_MMAP | VB2_DMABUF;
+	dst->drv_priv = ctx;
+	dst->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	dst->ops = &apr_qops;
+	dst->mem_ops = &vb2_dma_contig_memops;
+	dst->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst->lock = &ctx->apr->vdev_lock;
+	dst->dev = ctx->apr->dev;
+	return vb2_queue_init(dst);
+}
+
+/* ---- controls and file operations -------------------------------------- */
+
+/* Controls are read when a job is built; nothing to apply on change. */
+static int apr_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops apr_ctrl_ops = {
+	.s_ctrl = apr_s_ctrl,
+};
+
+static int apr_init_ctrls(struct apr_ctx *ctx)
+{
+	struct v4l2_ctrl_handler *hdl = &ctx->hdl;
+
+	v4l2_ctrl_handler_init(hdl, 1);
+	/* The profile must match the raw format's chroma; checked at STREAMON. */
+	ctx->profile = v4l2_ctrl_new_std_menu(hdl, &apr_ctrl_ops,
+					      V4L2_CID_MPEG_VIDEO_PRORES_PROFILE,
+					      V4L2_MPEG_VIDEO_PRORES_PROFILE_4444_XQ, 0,
+					      V4L2_MPEG_VIDEO_PRORES_PROFILE_STANDARD);
+	if (hdl->error) {
+		int ret = hdl->error;
+
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+	ctx->fh.ctrl_handler = hdl;
+	return 0;
+}
+
+static int apr_open(struct file *file)
+{
+	struct apr_dev *apr = video_drvdata(file);
+	struct apr_ctx *ctx;
+	int ret;
+
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx)
+		return -ENOMEM;
+	ctx->apr = apr;
+	apr_reset_fmts(ctx);
+	v4l2_fh_init(&ctx->fh, video_devdata(file));
+	ret = apr_init_ctrls(ctx);
+	if (ret)
+		goto err_fh;
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(apr->m2m_dev, ctx, apr_queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		goto err_ctrls;
+	}
+	v4l2_fh_add(&ctx->fh, file);
+	return 0;
+
+err_ctrls:
+	v4l2_ctrl_handler_free(&ctx->hdl);
+err_fh:
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+	return ret;
+}
+
+static int apr_release(struct file *file)
+{
+	struct apr_ctx *ctx = apr_file_to_ctx(file);
+	struct apr_dev *apr = ctx->apr;
+
+	mutex_lock(&apr->vdev_lock);
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	mutex_unlock(&apr->vdev_lock);
+	v4l2_ctrl_handler_free(&ctx->hdl);
+	v4l2_fh_del(&ctx->fh, file);
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+	return 0;
+}
+
+static const struct v4l2_file_operations apr_fops = {
+	.owner = THIS_MODULE,
+	.open = apr_open,
+	.release = apr_release,
+	.poll = v4l2_m2m_fop_poll,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = v4l2_m2m_fop_mmap,
+};
+
+/* ---- power management and probe ---------------------------------------- */
+
+static int apr_runtime_suspend(struct device *dev)
+{
+	struct apr_dev *apr = dev_get_drvdata(dev);
+	unsigned long flags;
+
+	/* Registers do not survive the power domain going off. */
+	spin_lock_irqsave(&apr->hw_lock, flags);
+	apr->ring_ready = false;
+	spin_unlock_irqrestore(&apr->hw_lock, flags);
+	return 0;
+}
+
+static int apr_runtime_resume(struct device *dev)
+{
+	return 0;
+}
+
+static int apr_suspend(struct device *dev)
+{
+	struct apr_dev *apr = dev_get_drvdata(dev);
+
+	v4l2_m2m_suspend(apr->m2m_dev);
+	return pm_runtime_force_suspend(dev);
+}
+
+static int apr_resume(struct device *dev)
+{
+	struct apr_dev *apr = dev_get_drvdata(dev);
+	int ret;
+
+	ret = pm_runtime_force_resume(dev);
+	if (ret)
+		return ret;
+	v4l2_m2m_resume(apr->m2m_dev);
+	return 0;
+}
+
+static const struct dev_pm_ops apr_pm_ops = {
+	RUNTIME_PM_OPS(apr_runtime_suspend, apr_runtime_resume, NULL)
+	SYSTEM_SLEEP_PM_OPS(apr_suspend, apr_resume)
+};
+
+static void apr_cleanup(void *data)
+{
+	struct apr_dev *apr = data;
+
+	cancel_delayed_work_sync(&apr->watchdog);
+	if (apr->m2m_dev)
+		v4l2_m2m_release(apr->m2m_dev);
+	v4l2_device_unregister(&apr->v4l2_dev);
+}
+
+static int apr_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct video_device *vdev;
+	void __iomem *regs[2] = {};
+	struct apr_dev *apr;
+	unsigned int i;
+	int ret;
+
+	apr = devm_kzalloc(dev, sizeof(*apr), GFP_KERNEL);
+	if (!apr)
+		return -ENOMEM;
+	apr->dev = dev;
+	apr->variant = of_device_get_match_data(dev);
+	if (!apr->variant)
+		return -ENODEV;
+	mutex_init(&apr->vdev_lock);
+	spin_lock_init(&apr->hw_lock);
+	INIT_DELAYED_WORK(&apr->watchdog, apr_watchdog);
+	platform_set_drvdata(pdev, apr);
+
+	for (i = 0; i < apr->variant->num_regs; i++) {
+		regs[i] = devm_platform_ioremap_resource_byname(pdev,
+							     apr->variant->reg_names[i]);
+		if (IS_ERR(regs[i]))
+			return PTR_ERR(regs[i]);
+	}
+	apr->regs = regs[0];
+	apr->wrapper = regs[1];
+	/*
+	 * A second power domain, "perf", is the SoC performance request the
+	 * engine needs for full speed. With more than one domain the core
+	 * attaches none, so attach both with runtime PM links: the request is
+	 * held exactly while the engine is runtime-active.
+	 */
+	if (of_count_phandle_with_args(dev->of_node, "power-domains",
+				       "#power-domain-cells") > 1) {
+		static const struct dev_pm_domain_attach_data pd_data = {
+			.pd_flags = PD_FLAG_DEV_LINK_ON,
+		};
+
+		ret = devm_pm_domain_attach_list(dev, &pd_data, &apr->pd_list);
+		if (ret < 0)
+			return dev_err_probe(dev, ret, "failed to attach power domains\n");
+	}
+	apr->reset = devm_reset_control_get_optional_exclusive(dev, NULL);
+	if (IS_ERR(apr->reset))
+		return dev_err_probe(dev, PTR_ERR(apr->reset), "reset\n");
+
+	/* Every buffer the engine touches goes through its DART. */
+	if (!device_iommu_mapped(dev))
+		return dev_err_probe(dev, -ENODEV, "no IOMMU\n");
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(64));
+	if (ret)
+		return ret;
+	apr->ring = dmam_alloc_coherent(dev, apr->variant->ring_bytes, &apr->ring_dma,
+					GFP_KERNEL);
+	if (!apr->ring)
+		return -ENOMEM;
+	apr->stats_size = APR_STATS_BYTES;
+	apr->stats = dmam_alloc_coherent(dev, apr->stats_size, &apr->stats_dma, GFP_KERNEL);
+	if (!apr->stats)
+		return -ENOMEM;
+
+	for (i = 0; i < apr->variant->num_irqs; i++) {
+		apr->irq[i] = platform_get_irq_optional(pdev, i);
+		if (apr->irq[i] == -ENXIO && i)
+			continue;
+		if (apr->irq[i] < 0)
+			return apr->irq[i];
+		ret = devm_request_irq(dev, apr->irq[i], apr_irq, 0,
+				       dev_name(dev), apr);
+		if (ret)
+			return ret;
+	}
+
+	ret = v4l2_device_register(dev, &apr->v4l2_dev);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, apr_cleanup, apr);
+	if (ret)
+		return ret;
+	apr->m2m_dev = v4l2_m2m_init(&apr_m2m_ops);
+	if (IS_ERR(apr->m2m_dev)) {
+		ret = PTR_ERR(apr->m2m_dev);
+		apr->m2m_dev = NULL;
+		return ret;
+	}
+
+	pm_runtime_set_autosuspend_delay(dev, APR_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(dev);
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+	/* The engine reports how much statistics space it writes. */
+	if (max(apr_read(apr, apr->variant->stats[0].size),
+		apr_read(apr, apr->variant->stats[1].size)) >
+	    apr->stats_size) {
+		pm_runtime_put_autosuspend(dev);
+		return dev_err_probe(dev, -EINVAL, "statistics area larger than %zu bytes\n",
+				     apr->stats_size);
+	}
+	dev_info(dev, "ProRes encoder, id %#x\n", apr_read(apr, APR_REG_ID));
+	pm_runtime_put_autosuspend(dev);
+
+	vdev = &apr->vdev;
+	strscpy(vdev->name, APR_NAME, sizeof(vdev->name));
+	vdev->fops = &apr_fops;
+	vdev->ioctl_ops = &apr_ioctl_ops;
+	vdev->release = video_device_release_empty;
+	vdev->lock = &apr->vdev_lock;
+	vdev->v4l2_dev = &apr->v4l2_dev;
+	vdev->vfl_dir = VFL_DIR_M2M;
+	vdev->device_caps = V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_STREAMING;
+	video_set_drvdata(vdev, apr);
+	return video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+}
+
+static void apr_remove(struct platform_device *pdev)
+{
+	struct apr_dev *apr = platform_get_drvdata(pdev);
+
+	video_unregister_device(&apr->vdev);
+}
+
+static const struct of_device_id apr_of_match[] = {
+	{ .compatible = "apple,t6000-prores", .data = &apr_t6000 },
+	{ .compatible = "apple,t8140-prores", .data = &apr_t8140 },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, apr_of_match);
+
+static struct platform_driver apr_driver = {
+	.probe = apr_probe,
+	.remove = apr_remove,
+	.driver = {
+		.name = APR_NAME,
+		.of_match_table = apr_of_match,
+		.pm = pm_ptr(&apr_pm_ops),
+	},
+};
+module_platform_driver(apr_driver);
+
+MODULE_DESCRIPTION("Apple ProRes encoder");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/apple/prores/apple-prores-test.c b/drivers/media/platform/apple/prores/apple-prores-test.c
new file mode 100644
index 0000000000..9ac7080e07
--- /dev/null
+++ b/drivers/media/platform/apple/prores/apple-prores-test.c
@@ -0,0 +1,362 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests for the Apple ProRes descriptor and table builders.
+ *
+ * Expected register words are the values the engine is known to run with
+ * (m1n1 proxyclient experiments/prores.py, MIT).
+ */
+#include <kunit/test.h>
+#include <linux/sizes.h>
+#include <linux/unaligned.h>
+
+#include "apple-prores.h"
+
+static void apr_test_qmat_regs(struct kunit *test)
+{
+	static const struct {
+		enum apr_qtable table;
+		bool chroma;
+		unsigned int index;
+		u32 value;
+	} cases[] = {
+		{ APR_QTABLE_XQ, false, 0, 0x802802 },
+		{ APR_QTABLE_XQ, false, 15, 0x803802 },
+		{ APR_QTABLE_XQ, false, 27, 0x804803 },
+		{ APR_QTABLE_XQ, true, 23, 0x806805 },
+		{ APR_QTABLE_XQ, true, 31, 0x807807 },
+		{ APR_QTABLE_HQ, false, 0, 0x804804 },
+		{ APR_QTABLE_HQ, true, 27, 0x807806 },
+		{ APR_QTABLE_STANDARD, false, 2, 0x807806 },
+		{ APR_QTABLE_STANDARD, false, 23, 0x80f80c },
+		{ APR_QTABLE_STANDARD, true, 31, 0x815811 },
+		{ APR_QTABLE_LT, false, 0, 0x805804 },
+		{ APR_QTABLE_LT, false, 27, 0x82381c },
+		{ APR_QTABLE_LT, true, 31, 0x829823 },
+		{ APR_QTABLE_PROXY, false, 0, 0x807804 },
+		{ APR_QTABLE_PROXY, false, 3, 0xfff83f },
+		{ APR_QTABLE_PROXY, false, 6, 0x83f80e },
+		{ APR_QTABLE_PROXY, true, 17, 0xfff80e },
+		{ APR_QTABLE_PROXY, true, 24, 0xfff80d },
+		{ APR_QTABLE_PROXY, true, 31, 0xffffff },
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		const u8 *qm = cases[i].chroma ? apr_qmat_chroma[cases[i].table] :
+						 apr_qmat_luma[cases[i].table];
+
+		KUNIT_EXPECT_EQ_MSG(test, apr_qmat_reg(qm, cases[i].index),
+				    cases[i].value, "case %u", i);
+	}
+	KUNIT_EXPECT_EQ(test, apr_qmat_reg(apr_qmat_luma[0], 32), 0);
+}
+
+static void apr_test_dc_scale(struct kunit *test)
+{
+	static const struct { unsigned int index; u32 value; } cases[] = {
+		{ 0, 0x401 }, { 1, 0x803 }, { 31, 0x803f }, { 62, 0xfc7d },
+		{ 63, 0x1007f }, { 64, 0x11084 }, { 79, 0x200fc },
+		{ 110, 0x3f1f4 }, { 111, 0x1fc },
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++)
+		KUNIT_EXPECT_EQ(test, apr_dc_scale_reg(cases[i].index), cases[i].value);
+	KUNIT_EXPECT_EQ(test, apr_dc_scale_reg(APR_DC_SCALE_ENTRIES), 0);
+}
+
+static void apr_test_profiles(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, apr_profile_qtable(APR_PROFILE_PROXY), APR_QTABLE_PROXY);
+	KUNIT_EXPECT_EQ(test, apr_profile_qtable(APR_PROFILE_LT), APR_QTABLE_LT);
+	KUNIT_EXPECT_EQ(test, apr_profile_qtable(APR_PROFILE_STANDARD), APR_QTABLE_STANDARD);
+	KUNIT_EXPECT_EQ(test, apr_profile_qtable(APR_PROFILE_HQ), APR_QTABLE_HQ);
+	KUNIT_EXPECT_EQ(test, apr_profile_qtable(APR_PROFILE_4444), APR_QTABLE_HQ);
+	KUNIT_EXPECT_EQ(test, apr_profile_qtable(APR_PROFILE_4444_XQ), APR_QTABLE_XQ);
+	KUNIT_EXPECT_TRUE(test, apr_profile_is_444(APR_PROFILE_4444_XQ));
+	KUNIT_EXPECT_FALSE(test, apr_profile_is_444(APR_PROFILE_HQ));
+}
+
+static struct apr_frame apr_test_frame(void)
+{
+	return (struct apr_frame){
+		.width = 320, .height = 240,
+		.input = APR_INPUT_422_16, .profile = APR_PROFILE_STANDARD,
+		.luma_stride = 640, .chroma_stride = 640,
+		.luma = 0x10000100000ULL, .chroma = 0x10000200000ULL,
+		.output = 0x10000400000ULL, .output_size = SZ_1M,
+		.primaries = 1, .transfer = 1, .matrix = 1,
+	};
+}
+
+static void apr_test_desc_422(struct kunit *test)
+{
+	struct apr_frame f = apr_test_frame();
+	u8 *d = kunit_kzalloc(test, APR_DESC_BYTES, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, d);
+	KUNIT_ASSERT_EQ(test, apr_build_desc(&f, d), 0);
+	/* Layout facts from the working T8140 job: flags, strides, header. */
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(d), 0x363b);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(d + 0x08), f.output);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(d + 0x10), SZ_1M);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(d + 0x18), 320);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(d + 0x1a), 240);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(d + 0x20), 10);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(d + 0x22), 10);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(d + 0x28), f.luma);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(d + 0x38), f.chroma);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(d + 0x48), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(d + 0x58), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(d + 0x70), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_be16(d + 0x7c), 148);
+	KUNIT_EXPECT_EQ(test, get_unaligned_be16(d + 0x84), 320);
+	KUNIT_EXPECT_EQ(test, get_unaligned_be16(d + 0x86), 240);
+	KUNIT_EXPECT_EQ(test, d[0x88], 0x80);
+	KUNIT_EXPECT_EQ(test, d[0x89], 1);
+	KUNIT_EXPECT_EQ(test, d[0x8b], 1);
+	KUNIT_EXPECT_EQ(test, d[0x8f], 0x03);
+	/* 20 macroblocks per row: two 8-wide slices and one 4-wide. */
+	KUNIT_EXPECT_EQ(test, get_unaligned_be16(d + 0x78), 45);
+	KUNIT_EXPECT_EQ(test, d[0x7a], 0x30);
+	KUNIT_EXPECT_EQ(test, d[0x7b], 2);	/* 422 starting quantiser */
+	/* 320x240 422: 174762 and 196607 bytes over 300 macroblocks. */
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(d + 0x110), 4640);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(d + 0x112), 5224);
+	KUNIT_EXPECT_EQ(test, d[0x90], 0);	/* matrices live in the engine */
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(d + 0x170), 0x23);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(d + 0x174), 0);
+}
+
+static void apr_test_desc_444(struct kunit *test)
+{
+	struct apr_frame f = apr_test_frame();
+	u8 *d = kunit_kzalloc(test, APR_DESC_BYTES, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, d);
+	f.input = APR_INPUT_444_8;
+	f.profile = APR_PROFILE_4444_XQ;
+	f.luma_stride = 320;
+	f.chroma_stride = 640;
+	KUNIT_ASSERT_EQ(test, apr_build_desc(&f, d), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(d), 0x363c);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(d + 0x20), 5);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(d + 0x22), 10);
+	KUNIT_EXPECT_EQ(test, d[0x7f], 1);
+	KUNIT_EXPECT_EQ(test, d[0x88], 0xc0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(d + 0x170), 0x03);
+}
+
+static void apr_test_desc_rejects(struct kunit *test)
+{
+	u8 *d = kunit_kzalloc(test, APR_DESC_BYTES, GFP_KERNEL);
+	struct apr_frame f;
+
+	KUNIT_ASSERT_NOT_NULL(test, d);
+	f = apr_test_frame();
+	f.profile = APR_PROFILE_4444;		/* 4:2:2 input, 4:4:4 profile */
+	KUNIT_EXPECT_EQ(test, apr_build_desc(&f, d), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apr_build_desc_v0(&f, d), -EINVAL);
+	f = apr_test_frame();
+	f.luma_stride = 600;			/* not a multiple of 64 */
+	KUNIT_EXPECT_EQ(test, apr_build_desc(&f, d), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apr_build_desc_v0(&f, d), -EINVAL);
+	f = apr_test_frame();
+	f.chroma_stride = 576;			/* shorter than a row */
+	KUNIT_EXPECT_EQ(test, apr_build_desc(&f, d), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apr_build_desc_v0(&f, d), -EINVAL);
+	f = apr_test_frame();
+	f.width = 321;
+	KUNIT_EXPECT_EQ(test, apr_build_desc(&f, d), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apr_build_desc_v0(&f, d), -EINVAL);
+	f = apr_test_frame();
+	f.output = 0;
+	KUNIT_EXPECT_EQ(test, apr_build_desc(&f, d), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apr_build_desc_v0(&f, d), -EINVAL);
+}
+
+/* Legacy words from MIT m1n1 f3ac615eb137 experiments/prores.py:607-644. */
+static void apr_test_desc_v0(struct kunit *test)
+{
+	static const u32 legacy[] = {
+		0xffffffff, 0x15100c0c, 0x80004020, 0x002c8080,
+		0x00880080, 0x004e00c5, 0x009000d0, 0x00200122,
+		0x00400200, 0x00400200, 0x00400200, 0x00400200,
+		0x00400200, 0x00400200, 0x00400200, 0x00400200,
+		0x00400200, 0x00400200, 0x00400200, 0x00400200,
+		0x00400200, 0x00400200, 0x00400200, 0x00400200, 0x23,
+	};
+	struct apr_frame f = apr_test_frame();
+	u8 *d = kunit_kmalloc(test, APR_DESC_BYTES + 1, GFP_KERNEL);
+	unsigned int i;
+	u32 budget;
+
+	KUNIT_ASSERT_NOT_NULL(test, d);
+	memset(d, 0xa5, APR_DESC_BYTES + 1);
+	KUNIT_ASSERT_EQ(test, apr_build_desc_v0(&f, d), 0);
+	KUNIT_EXPECT_EQ(test, d[APR_DESC_BYTES], 0xa5);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(d), 0x363b);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(d + 4), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(d + 8), f.output);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(d + 0x10), f.output_size);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(d + 0x18), 320);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(d + 0x1a), 240);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(d + 0x20), 10);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(d + 0x22), 10);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(d + 0x28), f.luma);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(d + 0x38), f.chroma);
+	KUNIT_EXPECT_EQ(test, get_unaligned_be16(d + 0x58), 148);
+	KUNIT_EXPECT_EQ(test, d[0x5b], 0);
+	KUNIT_EXPECT_MEMEQ(test, d + 0x5c, "aurr", 4);
+	KUNIT_EXPECT_EQ(test, get_unaligned_be16(d + 0x60), 320);
+	KUNIT_EXPECT_EQ(test, get_unaligned_be16(d + 0x62), 240);
+	KUNIT_EXPECT_EQ(test, d[0x64], 0x80);
+	KUNIT_EXPECT_EQ(test, d[0x65], 0);
+	KUNIT_EXPECT_EQ(test, d[0x66], f.primaries);
+	KUNIT_EXPECT_EQ(test, d[0x67], f.transfer);
+	KUNIT_EXPECT_EQ(test, d[0x68], f.matrix);
+	KUNIT_EXPECT_EQ(test, d[0x69], 0);
+	KUNIT_EXPECT_EQ(test, d[0x6a], 0);
+	KUNIT_EXPECT_EQ(test, d[0x6b], 3);
+	for (i = 0x6c; i < 0xee; i++)
+		KUNIT_EXPECT_EQ_MSG(test, d[i], 0, "padding/slices %#x", i);
+	KUNIT_EXPECT_EQ(test, d[0xee], 0x30);
+	KUNIT_EXPECT_EQ(test, d[0xef], 2);
+	/* Word 0 is the rate budget, checked against v1 below. */
+	for (i = 1; i < ARRAY_SIZE(legacy); i++)
+		KUNIT_EXPECT_EQ_MSG(test, get_unaligned_le32(d + 0xf0 + 4 * i),
+				    legacy[i], "legacy word %u", i);
+	budget = get_unaligned_le32(d + 0xf0);
+	for (i = 0x154; i < APR_DESC_BYTES; i++)
+		KUNIT_EXPECT_EQ_MSG(test, d[i], 0, "v0 trailing padding %#x", i);
+
+	/* Reusing the buffer for v1 must clear the old frame header. */
+	KUNIT_ASSERT_EQ(test, apr_build_desc(&f, d), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(d + 0x58), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_be16(d + 0x7c), 148);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(d + 0x170), 0x23);
+	/* v0 carries v1's target and maximum budget words. */
+	KUNIT_EXPECT_EQ(test, budget, get_unaligned_le32(d + 0x110));
+	KUNIT_EXPECT_NE(test, budget, 0xffffffff);
+}
+
+static void apr_test_desc_v0_profiles(struct kunit *test)
+{
+	struct apr_frame f = apr_test_frame();
+	u8 *d = kunit_kmalloc(test, APR_DESC_BYTES, GFP_KERNEL);
+	unsigned int profile;
+
+	KUNIT_ASSERT_NOT_NULL(test, d);
+	for (profile = 0; profile < APR_PROFILES; profile++) {
+		bool is444 = apr_profile_is_444(profile);
+
+		f.profile = profile;
+		f.input = is444 ? APR_INPUT_444_8 : APR_INPUT_422_16;
+		KUNIT_ASSERT_EQ(test, apr_build_desc_v0(&f, d), 0);
+		KUNIT_EXPECT_EQ(test, d[0x5b], is444 ? 1 : 0);
+		KUNIT_EXPECT_EQ(test, d[0x64], is444 ? 0xc0 : 0x80);
+		KUNIT_EXPECT_EQ(test, get_unaligned_le32(d + 0x150),
+				apr_profile_qtable(profile) << 4 | 3);
+		/* The v1 extension is never written into a v0 descriptor. */
+		KUNIT_EXPECT_EQ(test, get_unaligned_le32(d + 0x170), 0);
+	}
+}
+
+static void apr_test_budgets(struct kunit *test)
+{
+	/* Target, maximum and the Q3 per-macroblock words for 1080p and 2160p. */
+	static const struct {
+		enum apr_profile profile;
+		u32 w, h, target, max;
+		u16 q_target, q_max;
+	} cases[] = {
+		{ APR_PROFILE_PROXY, 1920, 1080, 189326, 212991, 176, 200 },
+		{ APR_PROFILE_LT, 1920, 1080, 425984, 479232, 408, 456 },
+		{ APR_PROFILE_STANDARD, 1920, 1080, 611669, 688127, 584, 664 },
+		{ APR_PROFILE_HQ, 1920, 1080, 917504, 1032192, 888, 1000 },
+		{ APR_PROFILE_4444, 1920, 1080, 1376256, 1548288, 1336, 1504 },
+		{ APR_PROFILE_4444_XQ, 1920, 1080, 2064384, 2322432, 2008, 2264 },
+		{ APR_PROFILE_PROXY, 3840, 2160, 757304, 851967, 176, 200 },
+		{ APR_PROFILE_LT, 3840, 2160, 1711217, 1925119, 408, 464 },
+		{ APR_PROFILE_STANDARD, 3840, 2160, 2457600, 2764800, 592, 672 },
+		{ APR_PROFILE_HQ, 3840, 2160, 3684579, 4145151, 896, 1008 },
+		{ APR_PROFILE_4444, 3840, 2160, 5526869, 6217727, 1352, 1520 },
+		{ APR_PROFILE_4444_XQ, 3840, 2160, 8293944, 9330687, 2032, 2288 },
+	};
+	u8 *d = kunit_kzalloc(test, APR_DESC_BYTES, GFP_KERNEL);
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, d);
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		struct apr_frame f = apr_test_frame();
+		bool is444 = apr_profile_is_444(cases[i].profile);
+		u32 target, max;
+
+		apr_frame_budget(cases[i].profile, cases[i].w, cases[i].h, &target, &max);
+		KUNIT_EXPECT_EQ_MSG(test, target, cases[i].target, "case %u", i);
+		KUNIT_EXPECT_EQ_MSG(test, max, cases[i].max, "case %u", i);
+		f.profile = cases[i].profile;
+		f.input = is444 ? APR_INPUT_444_8 : APR_INPUT_422_8;
+		f.width = cases[i].w;
+		f.height = cases[i].h;
+		f.luma_stride = cases[i].w;
+		f.chroma_stride = cases[i].w * (is444 ? 2 : 1);
+		KUNIT_ASSERT_EQ(test, apr_build_desc(&f, d), 0);
+		KUNIT_EXPECT_EQ_MSG(test, get_unaligned_le16(d + 0x110), cases[i].q_target,
+				    "case %u", i);
+		KUNIT_EXPECT_EQ_MSG(test, get_unaligned_le16(d + 0x112), cases[i].q_max,
+				    "case %u", i);
+	}
+}
+
+static void apr_test_slices(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, apr_slice_count(320, 240, 3), 45);
+	/* 1920x1080: 120 MBs per row = 15 slices, 68 rows. */
+	KUNIT_EXPECT_EQ(test, apr_slice_count(1920, 1080, 3), 15 * 68);
+	/* 1366 wide: 86 MBs = 10 x 8 + 4 + 2 -> 12 slices per row. */
+	KUNIT_EXPECT_EQ(test, apr_slice_count(1366, 16, 3), 12);
+}
+
+static void apr_test_output(struct kunit *test)
+{
+	u8 *out = kunit_kzalloc(test, SZ_4K, GFP_KERNEL);
+	u32 bytes = 0;
+
+	KUNIT_ASSERT_NOT_NULL(test, out);
+	put_unaligned_be32(2000, out);
+	memcpy(out + 4, "icpf", 4);
+	KUNIT_EXPECT_EQ(test, apr_check_output(out, SZ_4K, &bytes), 0);
+	KUNIT_EXPECT_EQ(test, bytes, 2000);
+	KUNIT_EXPECT_EQ(test, apr_check_output(out, 1999, &bytes), -EIO);
+	put_unaligned_be32(100, out);
+	KUNIT_EXPECT_EQ(test, apr_check_output(out, SZ_4K, &bytes), -EIO);
+	put_unaligned_be32(2000, out);
+	out[4] = 'x';
+	KUNIT_EXPECT_EQ(test, apr_check_output(out, SZ_4K, &bytes), -EIO);
+}
+
+static struct kunit_case apr_test_cases[] = {
+	KUNIT_CASE(apr_test_qmat_regs),
+	KUNIT_CASE(apr_test_dc_scale),
+	KUNIT_CASE(apr_test_profiles),
+	KUNIT_CASE(apr_test_desc_422),
+	KUNIT_CASE(apr_test_desc_444),
+	KUNIT_CASE(apr_test_desc_rejects),
+	KUNIT_CASE(apr_test_desc_v0),
+	KUNIT_CASE(apr_test_desc_v0_profiles),
+	KUNIT_CASE(apr_test_budgets),
+	KUNIT_CASE(apr_test_slices),
+	KUNIT_CASE(apr_test_output),
+	{}
+};
+
+static struct kunit_suite apr_test_suite = {
+	.name = "apple-prores",
+	.test_cases = apr_test_cases,
+};
+kunit_test_suite(apr_test_suite);
+
+MODULE_DESCRIPTION("KUnit tests for the Apple ProRes encoder");
+MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS("EXPORTED_FOR_KUNIT_TESTING");
diff --git a/drivers/media/platform/apple/prores/apple-prores.h b/drivers/media/platform/apple/prores/apple-prores.h
new file mode 100644
index 0000000000..d41fbdeff9
--- /dev/null
+++ b/drivers/media/platform/apple/prores/apple-prores.h
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Apple ProRes (APR) encoder: register map and job descriptor.
+ *
+ * The APR is a register-driven engine with no firmware. Jobs are fixed-size
+ * descriptors placed in a DMA ring; the driver installs the ring, advances a
+ * producer head and the engine reports completion through a status register
+ * and a consumer tail.
+ *
+ * Register names and descriptor fields follow the m1n1 proxyclient ProRes
+ * experiment (MIT), proxyclient/m1n1/hw/prores.py and
+ * proxyclient/experiments/prores.py. The T8140 descriptor layout (version 1,
+ * frame header moved from 0x58 to 0x7c) comes from Acelogic's J700 work.
+ */
+#ifndef _APPLE_PRORES_H
+#define _APPLE_PRORES_H
+
+#include <linux/bits.h>
+#include <linux/sizes.h>
+#include <linux/types.h>
+
+#define APR_REG_ID		0x0000
+#define APR_REG_MODE		0x0008
+#define APR_MODE_OFF		0x0
+#define APR_MODE_RUN		0xd
+#define APR_REG_IRQ_ENABLE	0x000c
+#define APR_REG_IRQ_STATUS	0x0010
+#define APR_IRQ_DONE		BIT(0)
+#define APR_IRQ_ERROR		BIT(1)
+#define APR_REG_ST0		0x0014
+#define APR_REG_ST1		0x0018
+#define APR_REG_RING_SIZE	0x0100
+#define APR_REG_RING_LO		0x0104
+#define APR_REG_RING_HI		0x0108
+#define APR_REG_RING_HEAD	0x010c
+#define APR_REG_RING_TAIL	0x0110
+#define APR_RING_PTR_MASK	GENMASK(23, 0)
+/* One statistics area, given to two consumers; their capacity reads back. */
+#define APR_REG_STATS0_LO	0x038c
+#define APR_REG_STATS0_HI	0x0390
+#define APR_REG_STATS0_SIZE	0x0394
+#define APR_REG_STATS1_LO	0x070c
+#define APR_REG_STATS1_HI	0x0710
+#define APR_REG_STATS1_SIZE	0x0714
+#define APR_STATS_BYTES		SZ_2M
+
+/* One 32-entry quantisation matrix per table, for luma and for chroma. */
+#define APR_REG_QUANT_LUMA(t)	(0x0800 + (t) * 0x80)
+#define APR_REG_QUANT_CHROMA(t)	(0x1000 + (t) * 0x80)
+#define APR_REG_DC_SCALE(i)	(0x1800 + (i) * 4)
+#define APR_DC_SCALE_ENTRIES	112
+
+#define APR_RING_BYTES		SZ_128K
+#define APR_DESC_BYTES		0x180
+
+/* Quantisation tables the engine holds, in register order. */
+enum apr_qtable {
+	APR_QTABLE_XQ,
+	APR_QTABLE_HQ,
+	APR_QTABLE_STANDARD,
+	APR_QTABLE_LT,
+	APR_QTABLE_PROXY,
+	APR_QTABLES,
+};
+
+/*
+ * A dropped coefficient: the engine always quantises it to zero. Its 12-bit
+ * field is all ones; there is no ProRes weight for it.
+ */
+#define APR_QM_ZERO		0
+
+enum apr_input {
+	APR_INPUT_422_8,	/* NV16: 8-bit Y plane, 8-bit CbCr plane */
+	APR_INPUT_444_8,	/* NV24 */
+	APR_INPUT_422_16,	/* P216: 16-bit samples, data in the MSBs */
+	APR_INPUT_444_16,	/* P416 */
+};
+
+/* V4L2 profile menu order: Proxy, LT, 422, HQ, 4444, 4444 XQ. */
+enum apr_profile {
+	APR_PROFILE_PROXY,
+	APR_PROFILE_LT,
+	APR_PROFILE_STANDARD,
+	APR_PROFILE_HQ,
+	APR_PROFILE_4444,
+	APR_PROFILE_4444_XQ,
+	APR_PROFILES,
+};
+
+struct apr_frame {
+	u32 width;
+	u32 height;
+	enum apr_input input;
+	enum apr_profile profile;
+	u32 luma_stride;	/* bytes, multiple of 64 */
+	u32 chroma_stride;	/* bytes, multiple of 64 */
+	u64 luma;
+	u64 chroma;
+	u64 output;
+	u32 output_size;
+	/* ProRes frame header colour codes (ISO/IEC 23091-2). */
+	u8 primaries;
+	u8 transfer;
+	u8 matrix;
+};
+
+/* Matrices are 8x8 in raster order, as carried in the ProRes frame header. */
+extern const u8 *const apr_qmat_luma[APR_QTABLES];
+extern const u8 *const apr_qmat_chroma[APR_QTABLES];
+
+bool apr_profile_is_444(enum apr_profile profile);
+bool apr_input_is_444(enum apr_input input);
+enum apr_qtable apr_profile_qtable(enum apr_profile profile);
+u32 apr_qmat_reg(const u8 *qmat, unsigned int index);
+u32 apr_dc_scale_reg(unsigned int index);
+void apr_frame_budget(enum apr_profile profile, u32 width, u32 height,
+		      u32 *target, u32 *max);
+u32 apr_slice_count(u32 width, u32 height, u32 log2_slice);
+int apr_build_desc(const struct apr_frame *f, u8 *desc);
+int apr_build_desc_v0(const struct apr_frame *f, u8 *desc);
+int apr_check_output(const u8 *out, size_t capacity, u32 *frame_bytes);
+
+#endif
