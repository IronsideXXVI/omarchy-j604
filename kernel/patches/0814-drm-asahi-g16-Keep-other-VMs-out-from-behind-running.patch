From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 15:50:40 +0000
Subject: [PATCH] drm/asahi: g16: Keep other VMs out from behind
 running renders by default

On J604 a client with four or more renders in flight takes the GPU
down when a second client, usually the compositor, submits a render:
the firmware raises recovery event 4, or the oldest command stops,
and the device fail-stops. Every forced compositor redraw against
render.light at depth 4 or more did this; depth 1 did not.

Turn g16_behind_initbm on, so a render of another VM, or one whose
unit needs a new InitBM, waits for the running renders to retire and
is then published alone. A single busy client keeps its full resident
depth. 0 restores the old behaviour at run time.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 7727be66ad..f136fd4b52 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -1888,12 +1888,12 @@ pub(crate) fn pb_reuse() -> bool {
     "G16: let a render command reuse the PB manager its pass slot still leases from a fully retired command of the same VM, without a new InitBM (default 1; 0 = a fresh manager and InitBM for every command; runtime 0644)"
 );
 
-/// Storage of `g16_behind_initbm` (runtime 0644, default 0).
-static BEHIND_INITBM: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_behind_initbm` (runtime 0644, default 1).
+static BEHIND_INITBM: AtomicU32 = AtomicU32::new(1);
 
 /// Whether a render command goes behind running flights only when every running flight is
 /// of its own VM and its unit still leases that VM's PB manager, so that no InitBM enters
-/// the TA ring behind running TA work (0, default: as `g16_resident` allows).
+/// the TA ring behind running TA work (1, default; 0: as `g16_resident` allows).
 pub(crate) fn behind_initbm() -> bool {
     BEHIND_INITBM.load(Ordering::Relaxed) != 0
 }
@@ -1904,7 +1904,7 @@ pub(crate) fn behind_initbm() -> bool {
     BEHIND_INITBM_PARM,
     BEHIND_INITBM,
     "g16_behind_initbm",
-    "G16: publish a render behind running renders only if they are all of its VM and its unit needs no new InitBM; otherwise it waits for them to retire (default 0; runtime 0644)"
+    "G16: publish a render behind running renders only if they are all of its VM and its unit needs no new InitBM; otherwise it waits for them to retire (default 1; 0: as g16_resident allows; runtime 0644)"
 );
 
 /// Fragment-only dependency publication has not been qualified on this backend.
