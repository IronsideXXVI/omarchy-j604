From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Tue, 10 Nov 2026 21:11:25 +1100
Subject: [PATCH] soc: apple: sep: publish the chardevs without holding
 their slot locks

register_bio(), register_rearm() and register_key() held the slot mutex
(bio_dev, rearm_dev, key_dev) across misc_register(). misc_open() calls
the shim's open with misc_mtx held, the shim runs every callback under
its per-device lock, and the release and ioctl callbacks take the slot
lock to wake pollers. Lockdep on the Neo reported the cycle

  bio_dev -> misc_mtx -> &d->lock -> bio_dev

from a close of /dev/sep-bio while the settle work published a node.

Register first and only then take the slot lock to store the device. A
device that lost the slot, or that came up after remove() emptied the
slots, is unregistered again outside the lock.

Assisted-by: LLM
(cherry picked from commit e2bc6d881e61694e87c1f63878995fe6085444c3)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/key.rs  |  35 ++++++------
 drivers/soc/apple/sbio.rs | 108 +++++++++++++++++++++++---------------
 2 files changed, 82 insertions(+), 61 deletions(-)

diff --git a/drivers/soc/apple/key.rs b/drivers/soc/apple/key.rs
index e846a02e55..059923fc72 100644
--- a/drivers/soc/apple/key.rs
+++ b/drivers/soc/apple/key.rs
@@ -496,26 +496,23 @@ mod tests {
 
 impl SepData {
     pub(crate) fn register_key(&self) -> Result<()> {
-        let mut guard = self.key_dev.lock();
-        if guard.is_some() {
-            return Ok(());
-        }
         let ctx = core::ptr::from_ref(self).cast_mut().cast::<c_void>();
-        // SAFETY: as in `register_bio`: `remove()` drops the registration
-        // before the `Arc` that keeps `ctx` alive, and the shim's unregister
-        // clears the stored context under the lock every callback takes.
-        let dev = unsafe {
-            crate::shim::BioChardev::register(
-                DEVICE_NAME,
-                DEVICE_MODE,
-                ctx,
-                key_open_trampoline,
-                key_release_trampoline,
-                key_ioctl_trampoline,
-                key_ready_trampoline,
-            )
-        }?;
-        *guard = Some(dev);
+        self.publish_chardev(&self.key_dev, || {
+            // SAFETY: as in `register_bio`: `remove()` drops the registration
+            // before the `Arc` that keeps `ctx` alive, and the shim's unregister
+            // clears the stored context under the lock every callback takes.
+            unsafe {
+                crate::shim::BioChardev::register(
+                    DEVICE_NAME,
+                    DEVICE_MODE,
+                    ctx,
+                    key_open_trampoline,
+                    key_release_trampoline,
+                    key_ioctl_trampoline,
+                    key_ready_trampoline,
+                )
+            }
+        })?;
         Ok(())
     }
 
diff --git a/drivers/soc/apple/sbio.rs b/drivers/soc/apple/sbio.rs
index 150fd1ad7a..3d7f4d92fe 100644
--- a/drivers/soc/apple/sbio.rs
+++ b/drivers/soc/apple/sbio.rs
@@ -4776,33 +4776,60 @@ impl SepData {
         }
     }
 
-    pub(crate) fn register_bio(&self) -> Result<()> {
-        let mut guard = self.bio_dev.lock();
-        if guard.is_some() {
-            return Ok(());
+    /// Publishes a chardev into `slot` (`bio_dev`, `rearm_dev`, `key_dev`).
+    ///
+    /// The slot's lock is not held across `misc_register()`. `misc_open()`
+    /// calls the shim's open under `misc_mtx`, the shim runs every callback
+    /// under its per-device lock, and the release and ioctl callbacks take the
+    /// slot lock to wake pollers. Holding the slot lock while registering
+    /// would close the cycle slot -> `misc_mtx` -> device lock -> slot.
+    ///
+    /// Only the settle work registers. A device that lost the slot, or that
+    /// came up after `remove()` emptied the slots, is dropped (unregistered)
+    /// again, outside the slot lock. Returns whether `dev` was published.
+    pub(crate) fn publish_chardev(
+        &self,
+        slot: &Mutex<Option<shim::BioChardev>>,
+        register: impl FnOnce() -> Result<shim::BioChardev>,
+    ) -> Result<bool> {
+        if slot.lock().is_some() {
+            return Ok(false);
+        }
+        let dev = register()?;
+        let mut guard = slot.lock();
+        if guard.is_some() || self.shutting_down.load(Relaxed) {
+            drop(guard);
+            drop(dev);
+            return Ok(false);
         }
+        *guard = Some(dev);
+        Ok(true)
+    }
 
+    pub(crate) fn register_bio(&self) -> Result<()> {
         let ctx = core::ptr::from_ref(self).cast_mut().cast::<c_void>();
 
-        // SAFETY: `ctx` is this `SepData`, kept alive by the `Arc` in the
-        // driver's private data. `remove()` drops the registration before that
-        // `Arc` can go, and the shim's unregister clears its stored context
-        // under the same lock every callback takes, so once it returns, no
-        // callback can observe this pointer again.
-        let dev = unsafe {
-            shim::BioChardev::register(
-                bio::DEVICE_NAME,
-                bio::DEVICE_MODE,
-                ctx,
-                bio_open_trampoline,
-                bio_release_trampoline,
-                bio_ioctl_trampoline,
-                bio_ready_trampoline,
-            )
-        }?;
-
-        *guard = Some(dev);
-        diag::bio_published();
+        let published = self.publish_chardev(&self.bio_dev, || {
+            // SAFETY: `ctx` is this `SepData`, kept alive by the `Arc` in the
+            // driver's private data. `remove()` drops the registration before that
+            // `Arc` can go, and the shim's unregister clears its stored context
+            // under the same lock every callback takes, so once it returns, no
+            // callback can observe this pointer again.
+            unsafe {
+                shim::BioChardev::register(
+                    bio::DEVICE_NAME,
+                    bio::DEVICE_MODE,
+                    ctx,
+                    bio_open_trampoline,
+                    bio_release_trampoline,
+                    bio_ioctl_trampoline,
+                    bio_ready_trampoline,
+                )
+            }
+        })?;
+        if published {
+            diag::bio_published();
+        }
         Ok(())
     }
 
@@ -5167,26 +5194,23 @@ impl SepData {
     }
 
     pub(crate) fn register_rearm(&self) -> Result<()> {
-        let mut guard = self.rearm_dev.lock();
-        if guard.is_some() {
-            return Ok(());
-        }
         let ctx = core::ptr::from_ref(self).cast_mut().cast::<c_void>();
-        // SAFETY: as in `register_bio`: `remove()` drops the registration
-        // before the `Arc` that keeps `ctx` alive, and the shim's unregister
-        // clears the stored context under the lock every callback takes.
-        let dev = unsafe {
-            shim::BioChardev::register(
-                bio::REARM_DEVICE_NAME,
-                bio::REARM_DEVICE_MODE,
-                ctx,
-                rearm_open_trampoline,
-                rearm_release_trampoline,
-                rearm_ioctl_trampoline,
-                rearm_ready_trampoline,
-            )
-        }?;
-        *guard = Some(dev);
+        self.publish_chardev(&self.rearm_dev, || {
+            // SAFETY: as in `register_bio`: `remove()` drops the registration
+            // before the `Arc` that keeps `ctx` alive, and the shim's unregister
+            // clears the stored context under the lock every callback takes.
+            unsafe {
+                shim::BioChardev::register(
+                    bio::REARM_DEVICE_NAME,
+                    bio::REARM_DEVICE_MODE,
+                    ctx,
+                    rearm_open_trampoline,
+                    rearm_release_trampoline,
+                    rearm_ioctl_trampoline,
+                    rearm_ready_trampoline,
+                )
+            }
+        })?;
         Ok(())
     }
 
