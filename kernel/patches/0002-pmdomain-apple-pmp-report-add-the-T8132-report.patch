From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sean Dolbec <sdolbec1@gmail.com>
Date: Sun, 1 Nov 2026 12:43:52 -0500
Subject: [PATCH] pmdomain: apple: pmp-report: add the T8132 report

Add the M4 (T8132) PMP report aperture: requests are read at 0x1880 and
updated at 0x10000 + 0xc40, as on T8140, and acknowledged at 0x1900. The
status word is at 0x10.

On a Mac mini (J773g) running 7.1.13 with the PMP started, the report
became ready and requests for soc-device records 12 (set) and 18
(cleared) were acknowledged through these offsets. The same values are
in aurora-silicon's m4/pr1-basic-bringup series for the J713.

No device tree in this tree has a T8132 report node yet, so nothing binds
to it. No fast die-temperature report is qualified on this generation.

Signed-off-by: Sean Dolbec <sdolbec1@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 16d04623dc3277b5a2572f2fac743a68abd15840)
---
 drivers/pmdomain/apple/pmp-report.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/pmdomain/apple/pmp-report.c b/drivers/pmdomain/apple/pmp-report.c
index 9aac3ced17..758086eb34 100644
--- a/drivers/pmdomain/apple/pmp-report.c
+++ b/drivers/pmdomain/apple/pmp-report.c
@@ -1222,6 +1222,19 @@ static const struct apple_pmp_report_offsets apple_pmp_offsets_t6031 = {
 	.devices_ordered = true,
 };
 
+/*
+ * T8132 (M4): the T8140 request window, with the acknowledgements at 0x1900.
+ * On a J773g, 7.1.13 with the PMP started: status ready, and request bits
+ * 12 (set) and 18 (cleared) were acknowledged through these offsets. No
+ * fast die-temperature report is qualified on this generation.
+ */
+static const struct apple_pmp_report_offsets apple_pmp_offsets_t8132 = {
+	.tgt_read = 0x1880,
+	.tgt_write = 0x10c40,
+	.actual = 0x1900,
+	.status = 0x10,
+};
+
 /* The fast die-temperature report is the low two bytes of entry 0x1c1. */
 static const struct apple_pmp_report_offsets apple_pmp_offsets_t8140 = {
 	.tgt_read = 0x1880,
@@ -1240,6 +1253,7 @@ static const struct of_device_id apple_pmp_report_of_match[] = {
 	{ .compatible = "apple,t6031-pmp-v2-report", .data = &apple_pmp_offsets_t6031 },
 	{ .compatible = "apple,t8112-pmp-v2-report", .data = &apple_pmp_offsets_t8112 },
 	{ .compatible = "apple,t8122-pmp-v2-report", .data = &apple_pmp_offsets_t8122 },
+	{ .compatible = "apple,t8132-pmp-v2-report", .data = &apple_pmp_offsets_t8132 },
 	{ .compatible = "apple,t8140-pmp-v2-report", .data = &apple_pmp_offsets_t8140 },
 	{}
 };
