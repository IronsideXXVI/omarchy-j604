From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Sat, 24 Oct 2026 18:42:03 -0400
Subject: [PATCH] ASoC: apple: aop_audio: Register the jack without a speaker
 stream

The jack component was only registered along with the speaker one, so a
machine whose audio node lists the jack's DMA channels but not yet the
speakers' got no jack. Register the speaker component only where the node
lists "spkr", and the jack's where it lists "cout" and "cin", each on its
own. Creating the services does not reach the firmware; nothing changes
for the J616s, which lists all of them.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 94b018aaec558a5c88f395140f25382ddf44ca3b)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 sound/soc/apple/aop_audio.rs | 14 +++++++------
 sound/soc/apple/aop_spkr.rs  | 38 +++++++++++++++++++++++-------------
 2 files changed, 32 insertions(+), 20 deletions(-)

diff --git a/sound/soc/apple/aop_audio.rs b/sound/soc/apple/aop_audio.rs
index f9b547d594..1a2a300e4a 100644
--- a/sound/soc/apple/aop_audio.rs
+++ b/sound/soc/apple/aop_audio.rs
@@ -1167,12 +1167,14 @@ impl SndSocAopDriver {
                 dev_warn!(data.dev, "decimator config refused, continuing\n");
             }
             let mut this = Self::new(data.clone())?;
-            // The speaker stream, where the node has its DMA channel.
-            if data
-                .fwnode
-                .property_match_string(c_str!("dma-names"), c_str!("spkr"))
-                .is_ok()
-            {
+            // The speaker and jack streams, where the node has their DMA
+            // channels: a machine may have the jack before its speakers.
+            let listed = |name: &CStr| {
+                data.fwnode
+                    .property_match_string(c_str!("dma-names"), name)
+                    .is_ok()
+            };
+            if listed(c_str!("spkr")) || (listed(c_str!("cout")) && listed(c_str!("cin"))) {
                 this.spkr = Some(aop_spkr::SpeakerComponent::register(data)?);
             }
             return Ok(this);
diff --git a/sound/soc/apple/aop_spkr.rs b/sound/soc/apple/aop_spkr.rs
index fcf0c166c4..0fea60ec7e 100644
--- a/sound/soc/apple/aop_spkr.rs
+++ b/sound/soc/apple/aop_spkr.rs
@@ -1611,9 +1611,9 @@ unsafe extern "C" fn jack_resume(component: *mut bindings::snd_soc_component) ->
     }
 }
 
-/// The speaker component, and the jack's where the audio node lists its DMA channels.
+/// The speaker and jack components, each where the audio node lists its DMA channels.
 pub(crate) struct SpeakerComponent {
-    _spkr: Registration,
+    _spkr: Option<Registration>,
     _jack: Option<Registration>,
 }
 
@@ -1648,19 +1648,29 @@ impl SpeakerComponent {
         } else {
             None
         };
-        let mut spkr_driver = component_driver(c_str!("t6040-aop-spkr"));
-        spkr_driver.suspend = Some(spkr_suspend);
-        spkr_driver.resume = Some(spkr_resume);
-        let spkr = Registration::new(&aop, services, spkr_driver, |ops| {
-            to_kvec(speaker_dais(ops))
-        })
-        .inspect_err(|e| {
-            dev_err!(
-                aop.dev,
-                "Unable to register the speaker ASoC component: {}\n",
-                e.to_errno()
+        let has_spkr = aop
+            .fwnode
+            .property_match_string(c_str!("dma-names"), c_str!("spkr"))
+            .is_ok();
+        let spkr = if has_spkr {
+            let mut spkr_driver = component_driver(c_str!("t6040-aop-spkr"));
+            spkr_driver.suspend = Some(spkr_suspend);
+            spkr_driver.resume = Some(spkr_resume);
+            Some(
+                Registration::new(&aop, services, spkr_driver, |ops| {
+                    to_kvec(speaker_dais(ops))
+                })
+                .inspect_err(|e| {
+                    dev_err!(
+                        aop.dev,
+                        "Unable to register the speaker ASoC component: {}\n",
+                        e.to_errno()
+                    )
+                })?,
             )
-        })?;
+        } else {
+            None
+        };
         Ok(Self {
             _spkr: spkr,
             _jack: jack,
