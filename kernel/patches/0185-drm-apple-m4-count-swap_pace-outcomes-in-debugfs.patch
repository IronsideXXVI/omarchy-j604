From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 02:19:08 +0000
Subject: [PATCH] drm/apple: m4: count swap_pace outcomes in debugfs

With swap_pace on, a 60 fps video on the J604 lands every frame on the
120 Hz grid, but frames of a page that keeps the GPU busy often land one
tick after the grid tick a held swap aimed at, which drops such a page
from about 90 to 70 frames per second. Whether the wait overshoots or the
firmware needs more time after it is not visible from outside.

Record, per internal-panel swap that swap_pace looked at, the grid tick
it aimed at and its planned start, and count held and unheld swaps,
completions on the tick, before it, one tick and two or more ticks after
it, and the time slept past the planned start (mean and maximum), with
the lead in use, in the iomfb_m4 debugfs file. No behaviour changes.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/gpu/drm/apple/iomfb_m4.c | 43 +++++++++++++++++++++++++++++++-
 1 file changed, 42 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index 867d7fce37..f561c8ee51 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -1119,6 +1119,17 @@ struct dcp_m4_runtime {
 	u64 int_lat_min;
 	u64 int_lat_win;
 	u32 int_lat_n;
+	/*
+	 * swap_pace outcomes for debugfs: the grid tick aimed at and the start
+	 * time of the swap in flight (counter, 0: none); held and unheld swaps,
+	 * completions on the tick, before it, one and two or more ticks after
+	 * it; time slept past the planned start (counter ticks).
+	 */
+	u64 pace_e;
+	u64 pace_start;
+	u64 pace_n[6];
+	u64 pace_over_sum;
+	u64 pace_over_max;
 	struct dcp_m4_properties *properties;
 	struct dcp_m4_timing timing;
 	struct dcp_m4_swap_state swap;
@@ -1747,7 +1758,14 @@ static bool dcp_m4_int_late_d590(struct dcp_m4_runtime *r, u32 id)
 static void dcp_m4_pace_learn(struct dcp_m4_runtime *r)
 {
 	u64 start = READ_ONCE(r->int_start_cnt), done = READ_ONCE(r->int_done_cnt), lat;
+	u64 e = READ_ONCE(r->pace_e);
+
+	if (e) {
+		s64 half = div_u64(arch_timer_get_cntfrq(), 240), d = (s64)(done - e);
 
+		WRITE_ONCE(r->pace_e, 0);
+		r->pace_n[d < -half / 2 ? 3 : d < half / 2 ? 2 : d < half + half / 2 ? 4 : 5]++;
+	}
 	if (!start || done <= start)
 		return;
 	WRITE_ONCE(r->int_start_cnt, 0);
@@ -2657,6 +2675,8 @@ static unsigned long dcp_m4_swap_pace_us(struct dcp_m4_runtime *r)
 
 	if (!READ_ONCE(swap_pace))
 		return 0;
+	WRITE_ONCE(r->pace_e, 0);
+	r->pace_start = 0;
 	freq = arch_timer_get_cntfrq();
 	half = div_u64(freq, 240);
 	margin = half / 4;
@@ -2674,8 +2694,13 @@ static unsigned long dcp_m4_swap_pace_us(struct dcp_m4_runtime *r)
 	k += k & 1;
 	/* Start once the tick before it, base + (k - 1) * half, is out of reach by margin. */
 	start = base + (k - 1) * half + margin - lead;
-	if (start <= now)
+	WRITE_ONCE(r->pace_e, base + k * half);
+	if (start <= now) {
+		r->pace_n[1]++;
 		return 0;
+	}
+	r->pace_n[0]++;
+	r->pace_start = start;
 	return div64_u64((start - now) * USEC_PER_SEC, freq) + 1;
 }
 /*
@@ -2760,6 +2785,12 @@ static int dcp_m4_runtime_swap_full(struct dcp_m4_runtime *r, bool primary,
 		if (pace)
 			usleep_range(pace, pace + 50);
 		WRITE_ONCE(r->int_start_cnt, __arch_counter_get_cntpct());
+		if (pace && r->pace_start && r->int_start_cnt > r->pace_start) {
+			u64 over = r->int_start_cnt - r->pace_start;
+
+			r->pace_over_sum += over;
+			r->pace_over_max = max(r->pace_over_max, over);
+		}
 	}
 	r->deadline = jiffies + msecs_to_jiffies(5000);
 	ret = dcp_m4_runtime_call(r, 406, false, start, sizeof(start), started, sizeof(started));
@@ -7394,6 +7425,16 @@ static int iomfb_m4_status_show(struct seq_file *s, void *unused)
 		seq_printf(s, "edr capable=%u output=%u peak=%u ceiling=%u hm=%u sdr=%u sent=%u swaps=%llu cll=%u\n",
 			   dcp->edr_capable, dcp->output_edr, dcp->panel_peak, dcp->edr_ceiling,
 			   dcp->edr.hm, dcp->edr.sdr, dcp->edr.sent, dcp->edr_swaps, dcp->edr.cll);
+	if (r) {
+		u64 f = arch_timer_get_cntfrq() ?: 1;
+
+		seq_printf(s, "pace waits=%llu nowait=%llu hit=%llu early=%llu late1=%llu late2=%llu over_avg_us=%llu over_max_us=%llu lead_us=%llu\n",
+			   r->pace_n[0], r->pace_n[1], r->pace_n[2], r->pace_n[3], r->pace_n[4],
+			   r->pace_n[5],
+			   div64_u64(r->pace_over_sum * USEC_PER_SEC, f * (r->pace_n[0] ?: 1)),
+			   div64_u64(r->pace_over_max * USEC_PER_SEC, f),
+			   div64_u64(READ_ONCE(r->int_lat_min) * USEC_PER_SEC, f));
+	}
 	if (r)
 		seq_printf(s, "idle_cache=%u state=%u fences=%u registered=%u entries=%llu\n",
 			   !r->idle_unavailable && READ_ONCE(idle_cache_ms), r->idle_state,
