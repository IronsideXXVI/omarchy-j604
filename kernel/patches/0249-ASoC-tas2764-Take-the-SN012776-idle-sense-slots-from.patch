From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Thu, 5 Nov 2026 18:23:29 +1100
Subject: [PATCH] ASoC: tas2764: Take the SN012776 idle sense slots from the DT

Which of an SN012776's idle sense output slots drive zeros instead of
floating comes from per-board masks in the sound card's device tree
node. The Mac's ADT carries it per amp (a row of the group's
amp-tx-zd-config: one byte per eight slots from slot 0), and the boot
loader now copies each amp's row to its node as apple,amp-tx-zd-config.

With the property, program SDOUT_HIZ_1..4 from the row's first four
bytes and enable FORCE_0 at probe, and leave the card's idle masks
unused for that amp; the bit clock ratio still crops the mask to the
frame. An all-zero row leaves every idle slot in high impedance, as an
amp without a card mask has today. Like those masks, slots from 32 on
are not driven; a row that asks for them is warned about. Without the
property nothing changes.

KUnit tas2764-bop: tas2764_tx_zd (row to mask, absent, short row, not
a TAS2764 property).

Assisted-by: LLM
Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
(cherry picked from commit 04bfb4c5621c61581d92ddc5d7e41943de899fa8)
Assisted-by: Claude:claude-opus-5.5
---
 .../devicetree/bindings/sound/ti,tas27xx.yaml | 10 +++
 sound/soc/codecs/tas2764-bop-test.h           | 41 ++++++++++--
 sound/soc/codecs/tas2764-kunit.dtso           |  2 +
 sound/soc/codecs/tas2764.c                    | 67 +++++++++++++++++++
 4 files changed, 115 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/sound/ti,tas27xx.yaml b/Documentation/devicetree/bindings/sound/ti,tas27xx.yaml
index 07ea476d4e..f26c986357 100644
--- a/Documentation/devicetree/bindings/sound/ti,tas27xx.yaml
+++ b/Documentation/devicetree/bindings/sound/ti,tas27xx.yaml
@@ -85,6 +85,16 @@ properties:
       loader; its first two bytes are DC_BLK0 and DC_BLK1. Absent when the
       ADT has none, and the registers then keep their reset values.
 
+  apple,amp-tx-zd-config:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 8
+    maxItems: 8
+    description:
+      SN012776 only. This amplifier's row of its group's amp-tx-zd-config in
+      the Mac's boot ADT, copied by the boot loader - one byte per eight SDOUT
+      slots from slot 0, a set bit driving zeros in that idle slot. It
+      replaces the sound card's TDM idle masks for this amplifier.
+
   apple,deferred-shutdown:
     type: boolean
     description:
diff --git a/sound/soc/codecs/tas2764-bop-test.h b/sound/soc/codecs/tas2764-bop-test.h
index d6fa20cedb..4c114601b3 100644
--- a/sound/soc/codecs/tas2764-bop-test.h
+++ b/sound/soc/codecs/tas2764-bop-test.h
@@ -1,10 +1,10 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 /*
- * KUnit tests of tas2764_parse_bop_config() and
- * tas2764_parse_dcblocker_config(): the SN012776 brownout block and DC
- * blockers come from the device tree's apple,bop-config and
- * apple,amp-dcblocker-config, which the boot loader copies from the Mac's
- * ADT, and from nowhere else.
+ * KUnit tests of tas2764_parse_bop_config(), tas2764_parse_dcblocker_config()
+ * and tas2764_parse_tx_zd_config(): the SN012776 brownout block, DC blockers
+ * and idle slots come from the device tree's apple,bop-config,
+ * apple,amp-dcblocker-config and apple,amp-tx-zd-config, which the boot
+ * loader copies from the Mac's ADT, and from nowhere else.
  */
 #include <kunit/of.h>
 #include <kunit/test.h>
@@ -32,6 +32,8 @@ static struct tas2764_priv *tas2764_test_priv(struct kunit *test, const char *no
 	memset(tas2764->bop_config, 0xee, sizeof(tas2764->bop_config));
 	tas2764->have_dc_blk = true;
 	memset(tas2764->dc_blk, 0xee, sizeof(tas2764->dc_blk));
+	tas2764->have_tx_zd = true;
+	tas2764->tx_zd_mask = 0xeeeeeeee;
 
 	*devp = dev;
 	return tas2764;
@@ -169,6 +171,34 @@ static void tas2764_dcb_not_sn012776(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, tas2764->have_dc_blk);
 }
 
+/* The idle slot mask is the row's first four bytes, slot 0 first */
+static void tas2764_tx_zd(struct kunit *test)
+{
+	struct tas2764_priv *tas2764;
+	struct device *dev;
+
+	tas2764 = tas2764_test_priv(test, "tas2764-kunit-bop-good", DEVID_SN012776, &dev);
+	KUNIT_EXPECT_EQ(test, tas2764_parse_tx_zd_config(dev, tas2764), 0);
+	KUNIT_EXPECT_TRUE(test, tas2764->have_tx_zd);
+	KUNIT_EXPECT_EQ(test, tas2764->tx_zd_mask, 0x5aa50ff0);
+
+	/* Absent: the sound card's own idle masks apply */
+	tas2764 = tas2764_test_priv(test, "tas2764-kunit-bop-none", DEVID_SN012776, &dev);
+	KUNIT_EXPECT_EQ(test, tas2764_parse_tx_zd_config(dev, tas2764), 0);
+	KUNIT_EXPECT_FALSE(test, tas2764->have_tx_zd);
+	KUNIT_EXPECT_EQ(test, tas2764->tx_zd_mask, 0);
+
+	/* Not a whole row: a broken device tree */
+	tas2764 = tas2764_test_priv(test, "tas2764-kunit-bop-short", DEVID_SN012776, &dev);
+	KUNIT_EXPECT_EQ(test, tas2764_parse_tx_zd_config(dev, tas2764), -EINVAL);
+	KUNIT_EXPECT_FALSE(test, tas2764->have_tx_zd);
+
+	/* Not the TAS2764's */
+	tas2764 = tas2764_test_priv(test, "tas2764-kunit-bop-good", DEVID_TAS2764, &dev);
+	KUNIT_EXPECT_EQ(test, tas2764_parse_tx_zd_config(dev, tas2764), 0);
+	KUNIT_EXPECT_FALSE(test, tas2764->have_tx_zd);
+}
+
 static struct kunit_case tas2764_bop_test_cases[] = {
 	KUNIT_CASE(tas2764_bop_from_dt),
 	KUNIT_CASE(tas2764_bop_absent),
@@ -178,6 +208,7 @@ static struct kunit_case tas2764_bop_test_cases[] = {
 	KUNIT_CASE(tas2764_dcb_absent),
 	KUNIT_CASE(tas2764_dcb_short),
 	KUNIT_CASE(tas2764_dcb_not_sn012776),
+	KUNIT_CASE(tas2764_tx_zd),
 	{}
 };
 
diff --git a/sound/soc/codecs/tas2764-kunit.dtso b/sound/soc/codecs/tas2764-kunit.dtso
index 7e9fddceac..db624a512f 100644
--- a/sound/soc/codecs/tas2764-kunit.dtso
+++ b/sound/soc/codecs/tas2764-kunit.dtso
@@ -12,11 +12,13 @@
 		apple,bop-config = [00 01 02 03 04 05 06 07 08 09 0a 0b
 				    0c 0d 0e 0f 10 11 12 13 14 15 16 17];
 		apple,amp-dcblocker-config = [5a a5 00 00];
+		apple,amp-tx-zd-config = [f0 0f a5 5a 00 00 00 00];
 	};
 
 	tas2764-kunit-bop-short {
 		compatible = "test,tas2764-kunit";
 		apple,amp-dcblocker-config = [5a];
+		apple,amp-tx-zd-config = [f0 0f a5 5a 00 00 00];
 		apple,bop-config = [00 01 02 03 04 05 06 07 08 09 0a 0b
 				    0c 0d 0e 0f 10 11 12 13 14 15 16];
 	};
diff --git a/sound/soc/codecs/tas2764.c b/sound/soc/codecs/tas2764.c
index 11523b43af..e8e2efc4e3 100644
--- a/sound/soc/codecs/tas2764.c
+++ b/sound/soc/codecs/tas2764.c
@@ -82,6 +82,9 @@ struct tas2764_priv {
 	/* apple,amp-dcblocker-config: the SN012776 DC_BLK0 and DC_BLK1 */
 	u8 dc_blk[2];
 	bool have_dc_blk;
+	/* apple,amp-tx-zd-config: the SN012776's SDOUT idle slots, driven to zero */
+	u32 tx_zd_mask;
+	bool have_tx_zd;
 
 	/* apple,deferred-shutdown: software shutdown waits for the bus clock to stop */
 	bool deferred_shutdown;
@@ -816,6 +819,10 @@ static int tas2764_set_dai_tdm_idle(struct snd_soc_dai *dai,
 	if (rx_mode)
 		return -EOPNOTSUPP;
 
+	/* The idle slots the Mac's ADT gives were set at probe and stay */
+	if (tas2764->have_tx_zd)
+		return 0;
+
 	if (tas2764->idle_slot_config.tx_mask == tx_mask &&
 	    tas2764->idle_slot_config.tx_mode == tx_mode)
 		return 0;
@@ -1123,6 +1130,20 @@ static int tas2764_codec_probe(struct snd_soc_component *component)
 				goto err_sdz;
 		}
 
+		/* The SDOUT idle slots that drive zeros, from the ADT */
+		if (tas2764->have_tx_zd && tas2764->tx_zd_mask) {
+			ret = tas2764_write_sdout_idle_mask(tas2764, tas2764->tx_zd_mask);
+			if (ret < 0)
+				goto err_sdz;
+			ret = snd_soc_component_update_bits(component, TAS2764_SDOUT_HIZ_9,
+						TAS2764_SDOUT_HIZ_9_FORCE_0_EN,
+						TAS2764_SDOUT_HIZ_9_FORCE_0_EN);
+			if (ret < 0)
+				goto err_sdz;
+			tas2764->idle_slot_config.tx_mask = tas2764->tx_zd_mask;
+			tas2764->idle_slot_config.tx_mode = SND_SOC_DAI_TDM_IDLE_ZERO;
+		}
+
 		/* Apply all enabled Apple quirks */
 		ret = tas2764_apply_init_quirks(tas2764);
 
@@ -1344,6 +1365,48 @@ static int tas2764_parse_dcblocker_config(struct device *dev, struct tas2764_pri
 	return 0;
 }
 
+/*
+ * The SN012776's SDOUT idle slots that drive zeros (SDOUT_HIZ_1..), from the
+ * device tree's apple,amp-tx-zd-config: the boot loader copies this amp's row
+ * of its group's amp-tx-zd-config in the Mac's ADT, eight bytes, one mask
+ * byte per eight slots from slot 0. Like the device tree's TDM idle masks,
+ * this driver drives slots 0 to 31 only. With the property, it replaces the
+ * idle masks of the sound card's device tree; an all-zero row leaves every
+ * idle slot in high impedance.
+ */
+#define TAS2764_TX_ZD_ROW	8
+
+static int tas2764_parse_tx_zd_config(struct device *dev, struct tas2764_priv *tas2764)
+{
+	u8 row[TAS2764_TX_ZD_ROW];
+	int len, ret, i;
+
+	tas2764->have_tx_zd = false;
+	tas2764->tx_zd_mask = 0;
+	if (tas2764->devid != DEVID_SN012776)
+		return 0;
+
+	len = of_property_count_u8_elems(dev->of_node, "apple,amp-tx-zd-config");
+	if (len == -EINVAL)
+		return 0;
+	if (len != TAS2764_TX_ZD_ROW)
+		return dev_err_probe(dev, -EINVAL,
+				     "apple,amp-tx-zd-config: %d bytes, the row has %d\n",
+				     len, TAS2764_TX_ZD_ROW);
+
+	ret = of_property_read_u8_array(dev->of_node, "apple,amp-tx-zd-config",
+					row, TAS2764_TX_ZD_ROW);
+	if (ret)
+		return ret;
+	for (i = 4; i < TAS2764_TX_ZD_ROW; i++) {
+		if (row[i])
+			dev_warn(dev, "idle slots from %d on are not supported\n", i * 8);
+	}
+	tas2764->tx_zd_mask = row[0] | row[1] << 8 | row[2] << 16 | (u32)row[3] << 24;
+	tas2764->have_tx_zd = true;
+	return 0;
+}
+
 static int tas2764_parse_dt(struct device *dev, struct tas2764_priv *tas2764)
 {
 	int ret = 0;
@@ -1400,6 +1463,10 @@ static int tas2764_parse_dt(struct device *dev, struct tas2764_priv *tas2764)
 	if (ret)
 		return ret;
 
+	ret = tas2764_parse_tx_zd_config(dev, tas2764);
+	if (ret)
+		return ret;
+
 	return tas2764_group_join(dev, tas2764);
 }
 
