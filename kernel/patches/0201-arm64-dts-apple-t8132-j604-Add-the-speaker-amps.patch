From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 21:28:04 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j604: Add the speaker amps

From the J604 ADT (25G83 and 26B123 templates and the macOS 27.2
runtime tree, which agree): six SN012776 amps, all on i2c3, at 0x38
(left woofer 1), 0x3b (right woofer 1), 0x39 (left woofer 2), 0x3c
(right woofer 2), 0x3a (left tweeter) and 0x3d (right tweeter), in that
provider order. speaker-config puts amp i's current and voltage sense at
RX bytes 4i and 4i + 2, so the slots equal the J616s ones. One fault
interrupt on AP GPIO 14, level low, as on the J713.

Every amp takes the SDZ regulator as its supply and joins the
fail-closed SDZ group. The amps carry apple,deferred-shutdown, as on the
J713: its T8132 AOP keeps the speaker serializer running after a stream
ends, so the amps go to software shutdown when the bus stops, not at
mute.

With no sound card the amps probe, reset and stay in software shutdown;
no clock reaches them.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 95 ++++++++++++++++++++++++
 1 file changed, 95 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 848a5530a5..0b6c653204 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -790,3 +790,98 @@
 		sound-name-prefix = "Jack";
 	};
 };
+
+/*
+ * The six SN012776 speaker amps, all on i2c3 (ADT /arm-io/i2c3/audio-speaker
+ * at 0x38 and its speaker1..5; the J614s/J616s split the same six over i2c1
+ * and i2c3), held in hardware shutdown until the sound card enables them:
+ * one interrupt line on AP GPIO 14, level low; sense slots from
+ * speaker-config (amp i at RX bytes 4i and 4i + 2, order LW1 RW1 LW2 RW2 LT
+ * RT). Names as on the J314 and J616s, which the speakersafetyd profile
+ * binds its controls by. Every amp joins the SDZ fail-closed group: an
+ * over-temperature or over-current fault on any one forces the shared
+ * shutdown line low. Shutdown is deferred until the speaker bus stops, as
+ * on the J713, whose T8132 AOP keeps the serializer running after a stream
+ * ends.
+ */
+&i2c3 {
+	status = "okay"; /* DTV-SPK-2 */
+
+	speaker_left_woof1: codec@38 {
+		compatible = "ti,sn012776", "ti,tas2764"; /* DTV-SPK-9a */
+		reg = <0x38>; /* DTV-SPK-10 */
+		SDZ-supply = <&speaker_sdz>;
+		apple,sdz-group-fail-closed;
+		apple,deferred-shutdown;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Woofer 1";
+		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>; /* DTV-SPK-5a */
+		ti,imon-slot-no = <0>; /* DTV-SPK-10 */
+		ti,vmon-slot-no = <2>;
+	};
+
+	speaker_left_woof2: codec@39 {
+		compatible = "ti,sn012776", "ti,tas2764"; /* DTV-SPK-9c */
+		reg = <0x39>; /* DTV-SPK-12 */
+		SDZ-supply = <&speaker_sdz>;
+		apple,sdz-group-fail-closed;
+		apple,deferred-shutdown;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Woofer 2";
+		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>; /* DTV-SPK-5c */
+		ti,imon-slot-no = <8>; /* DTV-SPK-12 */
+		ti,vmon-slot-no = <10>;
+	};
+
+	speaker_left_tweet: codec@3a {
+		compatible = "ti,sn012776", "ti,tas2764"; /* DTV-SPK-9e */
+		reg = <0x3a>; /* DTV-SPK-14 */
+		SDZ-supply = <&speaker_sdz>;
+		apple,sdz-group-fail-closed;
+		apple,deferred-shutdown;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Tweeter";
+		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>; /* DTV-SPK-5e */
+		ti,imon-slot-no = <16>; /* DTV-SPK-14 */
+		ti,vmon-slot-no = <18>;
+	};
+
+	speaker_right_woof1: codec@3b {
+		compatible = "ti,sn012776", "ti,tas2764"; /* DTV-SPK-9b */
+		reg = <0x3b>; /* DTV-SPK-11 */
+		SDZ-supply = <&speaker_sdz>;
+		apple,sdz-group-fail-closed;
+		apple,deferred-shutdown;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Woofer 1";
+		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>; /* DTV-SPK-5b */
+		ti,imon-slot-no = <4>; /* DTV-SPK-11 */
+		ti,vmon-slot-no = <6>;
+	};
+
+	speaker_right_woof2: codec@3c {
+		compatible = "ti,sn012776", "ti,tas2764"; /* DTV-SPK-9d */
+		reg = <0x3c>; /* DTV-SPK-13 */
+		SDZ-supply = <&speaker_sdz>;
+		apple,sdz-group-fail-closed;
+		apple,deferred-shutdown;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Woofer 2";
+		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>; /* DTV-SPK-5d */
+		ti,imon-slot-no = <12>; /* DTV-SPK-13 */
+		ti,vmon-slot-no = <14>;
+	};
+
+	speaker_right_tweet: codec@3d {
+		compatible = "ti,sn012776", "ti,tas2764"; /* DTV-SPK-9f */
+		reg = <0x3d>; /* DTV-SPK-15 */
+		SDZ-supply = <&speaker_sdz>;
+		apple,sdz-group-fail-closed;
+		apple,deferred-shutdown;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Tweeter";
+		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>; /* DTV-SPK-5f */
+		ti,imon-slot-no = <20>; /* DTV-SPK-15 */
+		ti,vmon-slot-no = <22>;
+	};
+};
