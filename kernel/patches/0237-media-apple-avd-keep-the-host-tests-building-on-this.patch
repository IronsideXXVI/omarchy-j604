From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 16:49:11 +0000
Subject: [PATCH] media: apple: avd: keep the host tests building on
 this series

Two changes here broke the AVD host tests, which build the codec code
against their own copies of the driver's structures and call sites:

- "apply request controls the capture buffers fit" added setup_err to
  struct avd_run; the two host tests that define one lacked the member
  (the same two lines the upstream version of that change carries).
- "decode H.264 in frame-based mode" moved the slice path of
  avd_h264_run() into avd_h264_add_slice() behind a decode-mode check,
  and avd_h264_validate_sps() now calls avd_h264_validate_sps_format().
  The run regressions extract those functions too and keep testing the
  slice-based path (no decode mode or start code set).

tools/asahi/run-host-tests.py --only avd: 1 of 12 passed before, 12 of
12 after.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 .../media/platform/apple/avd/tests/program-test.py   | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/apple/avd/tests/program-test.py b/drivers/media/platform/apple/avd/tests/program-test.py
index 666a547e2d..6a0f353e4a 100755
--- a/drivers/media/platform/apple/avd/tests/program-test.py
+++ b/drivers/media/platform/apple/avd/tests/program-test.py
@@ -419,6 +419,10 @@ static int avd_init_job(struct avd_ctx *c,unsigned int codec,size_t n) {
 }
 static void avd_job_finish(struct avd_ctx *c,enum vb2_buffer_state s) { (void)c;assert(s==VB2_BUF_STATE_DONE);held_finishes++; }
 static int avd_submit_job(struct avd_ctx *c) { submissions++;return avd_open_build_program(c); }
+/* The regressions run the slice-based path: no decode mode or start code is set. */
+static bool avd_h264_ctrl_is(struct avd_ctx *c,u32 id,s32 val) { (void)c;(void)id;(void)val;return false; }
+static int avd_h264_run_frame(struct avd_ctx *c,struct avd_h264_run *r,const u8 *d,u32 l)
+{ (void)c;(void)r;(void)d;(void)l;abort(); }
 '''
 
 RUN_MAIN = r'''
@@ -530,13 +534,17 @@ def prepare_regressions(out):
     pre = pre.replace('unsigned int bank; };', 'unsigned int bank; size_t grey_chroma_offset; bool grey_chroma_10bit; };')
     pre += 'enum vb2_buffer_state { VB2_BUF_STATE_DONE, VB2_BUF_STATE_ERROR };\n'
     code = pre + helpers + inst + h264
-    for name in ('avd_h264_alloc_bufs', 'avd_h264_validate_sps', 'avd_h264_validate_pps',
+    for name in ('avd_h264_alloc_bufs', 'avd_h264_validate_sps_format', 'avd_h264_validate_sps',
+                 'avd_h264_validate_pps',
                  'avd_h264_validate_slice', 'avd_h264_drop_bank_slices', 'avd_h264_pick_bank',
                  'avd_h264_abort_picture', 'avd_h264_refs_valid', 'avd_h264_done'):
         code += function(source, name)
     code += function((ROOT / 'avd-backend-open.c').read_text(), 'avd_open_build_program')
     code += function((ROOT / 'avd-hevc.c').read_text(), 'avd_hevc_validate_sps')
-    code += RUN_FIXTURE + function(source, 'avd_h264_run') + RUN_MAIN
+    code += RUN_FIXTURE
+    for name in ('avd_h264_start_code_len', 'avd_h264_add_slice'):
+        code += function(source, name)
+    code += function(source, 'avd_h264_run') + RUN_MAIN
     dest = out / 'prepare.c'
     dest.write_text(code)
     exe = dest.with_suffix('')
-- 
