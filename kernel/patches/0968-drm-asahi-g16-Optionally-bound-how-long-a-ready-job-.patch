diff --git a/drivers/gpu/drm/asahi/g16/age.rs b/drivers/gpu/drm/asahi/g16/age.rs
new file mode 100644
index 0000000000..4fec956a09
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16/age.rs
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! The order in which the engine picks its pending jobs, and `g16_age_ms`, an optional bound on
+//! how long a ready job waits behind higher priorities. Core only, so the host tests run it.
+//!
+//! The engine picks by priority alone. A low-priority client beside a higher-priority one that
+//! always has a job pending (a compute client 64 deep holds 32 pending beside its 32 flights)
+//! is then never picked, and the fair turns between VMs never reach it, because a turn goes only
+//! to the job that was picked.
+
+/// One pending job as [`before`] compares it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Cand {
+    /// `DRM_ASAHI_PRIORITY_REALTIME - priority`: smaller is served first.
+    pub(crate) priority: u32,
+    /// The engine turn at which its queue was last served: smaller is served first.
+    pub(crate) turn: u64,
+    /// ns waited ([`waited`]); 0 when `g16_age_ms` is 0.
+    pub(crate) waited_ns: u64,
+}
+
+/// ns a job has waited at `now`: since it entered the pending list, or since its queue was last
+/// served if that is later.
+pub(crate) fn waited(now: u64, pending_ns: u64, served_ns: u64) -> u64 {
+    now.saturating_sub(pending_ns.max(served_ns))
+}
+
+/// Whether `a` is picked before `b`, the best so far. With `age_ns` 0: the higher priority, then
+/// the queue served less recently; a tie keeps `b`, the earlier in submission order. With
+/// `age_ns` above 0, a job that has waited `age_ns` or longer goes before every job that has
+/// not, whatever the priorities, and of two such jobs the one that waited longer goes first.
+/// While no job has waited `age_ns` the order is the one without it.
+pub(crate) fn before(a: &Cand, b: &Cand, age_ns: u64) -> bool {
+    if age_ns != 0 {
+        let (aa, ba) = (a.waited_ns >= age_ns, b.waited_ns >= age_ns);
+        if aa != ba {
+            return aa;
+        }
+        if aa && a.waited_ns != b.waited_ns {
+            return a.waited_ns > b.waited_ns;
+        }
+    }
+    a.priority < b.priority || (a.priority == b.priority && a.turn < b.turn)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MS: u64 = 1_000_000;
+
+    fn c(priority: u32, turn: u64, waited_ns: u64) -> Cand {
+        Cand {
+            priority,
+            turn,
+            waited_ns,
+        }
+    }
+
+    /// The engine's loop: the first candidate, replaced by any later one [`before`] it.
+    fn pick(cands: &[Cand], age_ns: u64) -> Option<usize> {
+        let mut best: Option<usize> = None;
+        for (i, x) in cands.iter().enumerate() {
+            if best.is_none_or(|b| before(x, &cands[b], age_ns)) {
+                best = Some(i);
+            }
+        }
+        best
+    }
+
+    /// The rule before `g16_age_ms`, as the engine wrote it.
+    fn old(cands: &[Cand]) -> Option<usize> {
+        let mut best: Option<usize> = None;
+        for (i, x) in cands.iter().enumerate() {
+            let better = match best {
+                None => true,
+                Some(b) => {
+                    let y = &cands[b];
+                    x.priority < y.priority || (x.priority == y.priority && x.turn < y.turn)
+                }
+            };
+            if better {
+                best = Some(i);
+            }
+        }
+        best
+    }
+
+    #[test]
+    fn off_is_the_old_order() {
+        let mut seed = 7u64;
+        for _ in 0..2000 {
+            let mut v = [c(0, 0, 0); 6];
+            for x in v.iter_mut() {
+                seed = seed
+                    .wrapping_mul(6364136223846793005)
+                    .wrapping_add(1442695040888963407);
+                *x = c(
+                    (seed >> 33) as u32 % 3 + 1,
+                    (seed >> 40) % 5,
+                    (seed >> 20) % (900 * MS),
+                );
+            }
+            assert_eq!(pick(&v, 0), old(&v));
+        }
+    }
+
+    #[test]
+    fn on_but_nothing_aged_is_the_old_order() {
+        let mut seed = 11u64;
+        for _ in 0..2000 {
+            let mut v = [c(0, 0, 0); 6];
+            for x in v.iter_mut() {
+                seed = seed
+                    .wrapping_mul(6364136223846793005)
+                    .wrapping_add(1442695040888963407);
+                *x = c(
+                    (seed >> 33) as u32 % 3 + 1,
+                    (seed >> 40) % 5,
+                    (seed >> 20) % (250 * MS - 1),
+                );
+            }
+            assert_eq!(pick(&v, 250 * MS), old(&v));
+        }
+    }
+
+    #[test]
+    fn an_aged_low_job_goes_before_medium() {
+        let v = [c(2, 1, 5 * MS), c(3, 0, 300 * MS), c(2, 2, 1 * MS)];
+        assert_eq!(pick(&v, 0), Some(0));
+        assert_eq!(pick(&v, 250 * MS), Some(1));
+        assert_eq!(pick(&v, 400 * MS), Some(0));
+    }
+
+    #[test]
+    fn of_two_aged_jobs_the_longer_wait_goes_first() {
+        let v = [c(2, 0, 260 * MS), c(3, 1, 900 * MS)];
+        assert_eq!(pick(&v, 250 * MS), Some(1));
+        let w = [c(3, 0, 300 * MS), c(2, 1, 300 * MS)];
+        assert_eq!(
+            pick(&w, 250 * MS),
+            Some(1),
+            "equal waits fall back to priority"
+        );
+    }
+
+    #[test]
+    fn a_tie_keeps_submission_order() {
+        let v = [c(2, 4, 300 * MS), c(2, 4, 300 * MS)];
+        assert_eq!(pick(&v, 0), Some(0));
+        assert_eq!(pick(&v, 250 * MS), Some(0));
+    }
+
+    #[test]
+    fn waited_counts_from_the_later_stamp() {
+        assert_eq!(waited(10 * MS, 2 * MS, 7 * MS), 3 * MS);
+        assert_eq!(waited(10 * MS, 7 * MS, 2 * MS), 3 * MS);
+        assert_eq!(
+            waited(1 * MS, 7 * MS, 2 * MS),
+            0,
+            "a stamp after now waits 0"
+        );
+    }
+
+    /// A medium client that always has a job pending beside one low job; each pick serves one
+    /// job for 1 ms. Off, the low job is never picked in 20 s. On, it goes first once it has
+    /// waited the age, and it is never picked earlier.
+    #[test]
+    fn the_low_job_starves_without_it_and_waits_one_age_with_it() {
+        for &age in &[0u64, 100 * MS, 250 * MS, 1000 * MS] {
+            let (mut now, low_pending, mut med_served, mut low_at) = (0u64, 0u64, 0u64, None);
+            for t in 0..20_000u64 {
+                let med = c(
+                    2,
+                    t,
+                    if age != 0 {
+                        waited(now, now, med_served)
+                    } else {
+                        0
+                    },
+                );
+                let low = c(
+                    3,
+                    0,
+                    if age != 0 {
+                        waited(now, low_pending, 0)
+                    } else {
+                        0
+                    },
+                );
+                if pick(&[med, low], age) == Some(1) {
+                    low_at = Some(now);
+                    break;
+                }
+                med_served = now;
+                now += MS;
+            }
+            match age {
+                0 => assert_eq!(low_at, None),
+                a => assert_eq!(low_at, Some(a)),
+            }
+        }
+    }
+}
