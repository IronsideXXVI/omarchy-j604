             cq: new_compute_queues()?,
+            aged: 0,
             chan_wait: false,
             window_wait: false,
             cbell_owed: false,
@@ -827,14 +834,18 @@ fn queue_published(&self, job: &Job) -> u32 {
     /// Index in `pending` of the next ready job: highest queue priority, then the queue served
     /// least recently, then submission order. `QueueState::priority` is
     /// `DRM_ASAHI_PRIORITY_REALTIME - priority` as `file.rs` passes it, so a smaller value
-    /// outranks.
+    /// outranks. With `g16_age_ms`, a job that has waited that long goes first
+    /// ([`age::before`]).
     fn pick(&self) -> Option<usize> {
         self.pick_in(None)
     }
 
     /// [`Self::pick`] among the jobs of VM `vm` only, if one is given.
     fn pick_in(&self, vm: Option<u64>) -> Option<usize> {
-        let mut best: Option<usize> = None;
+        // `g16_age_ms`: one clock read per pick, none while it is 0.
+        let age_ns = u64::from(params::age_ms()) * 1_000_000;
+        let now = if age_ns != 0 { now_ns() } else { 0 };
+        let mut best: Option<(usize, age::Cand)> = None;
         for (i, job) in self.pending.iter().enumerate() {
             if vm.is_some_and(|v| v != job.vm.id) {
                 continue;
@@ -845,22 +856,25 @@ fn pick_in(&self, vm: Option<u64>) -> Option<usize> {
             {
                 continue;
             }
-            let better = match best {
