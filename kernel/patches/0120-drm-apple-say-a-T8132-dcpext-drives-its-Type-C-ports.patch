From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 9 Nov 2026 01:25:52 +0000
Subject: [PATCH] drm/apple: say a T8132 dcpext drives its Type-C
 ports, not that they are unusable

apple_probe_typec_ports() gives a Type-C port no apple_connector when no
pipeline of the DRM device can drive it, and warns
"Type-C port %u: its display pipeline is unusable". Since the T8132
dcpext routes DP Alt Mode, dcp_typec_port_unusable() also says that for
every port whose routes belong to a live T8132 dcpext. That is the
normal case on a T8132 board: the dcpext drives those routes through its
own DRM outputs (t8132_ext_drm.c). The warning is untrue there and comes
on every boot, once per port.

Tell the two cases apart. dcp_fabric_port_owner() in dcp-fabric-core
decides from the route counts: this DRM device while one of its
pipelines can drive the port (or the port has no route, as before),
else a live T8132 dcpext, else nothing (failed dcpexts only, whatever
their SoC). dcp_typec_port_owner() replaces dcp_typec_port_unusable()
and counts the routes. A port the T8132 dcpext drives is logged at the
KMS debug level, saying it belongs to that dcpext; the warning stays for
a port with failed dcpexts only. Which ports get a connector does not
change.

The apple-dcp-fabric KUnit suite gets scenario S50i for each owner and
for the route count.

Fixes: c7f99128ced1 ("drm: apple: dcp: route DP Alt Mode on a T8132 dcpext")
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
(cherry picked from commit 38a219d4e39abad28ba08290aef17b08b13e30c5)
(cherry picked from commit f8d2e0d39a0886a8f1f29c87199e441de679c8ce)
---
 drivers/gpu/drm/apple/apple_drv.c       | 13 +++++++--
 drivers/gpu/drm/apple/dcp-fabric-core.c | 31 ++++++++++++++++++++++
 drivers/gpu/drm/apple/dcp-fabric-core.h | 26 ++++++++++++++++++
 drivers/gpu/drm/apple/dcp-fabric-test.c | 35 +++++++++++++++++++++++++
 drivers/gpu/drm/apple/dcp-fabric.c      | 23 ++++++++--------
 drivers/gpu/drm/apple/dcp-fabric.h      |  2 +-
 drivers/gpu/drm/apple/dcp.c             |  4 +--
 7 files changed, 117 insertions(+), 17 deletions(-)

diff --git a/drivers/gpu/drm/apple/apple_drv.c b/drivers/gpu/drm/apple/apple_drv.c
index d5af806796..397c0c9374 100644
--- a/drivers/gpu/drm/apple/apple_drv.c
+++ b/drivers/gpu/drm/apple/apple_drv.c
@@ -1261,8 +1261,17 @@ static int apple_probe_typec_ports(struct drm_device *drm,
 		bool secondary = idx >= nr_ports;
 		u32 mask = 0;
 
-		/* Only a failed T8122 dcpext could drive it: no connector. */
-		if (dcp_typec_port_unusable(port_idx)) {
+		switch (dcp_typec_port_owner(port_idx)) {
+		case DCP_FABRIC_PORT_DRM:
+			break;
+		case DCP_FABRIC_PORT_T8132_EXT:
+			/* The normal T8132 case: t8132_ext_drm.c adds its connector. */
+			drm_dbg_kms(drm,
+				    "Type-C port %u: its display routes belong to the T8132 dcpext, which drives them\n",
+				    port_idx);
+			continue;
+		case DCP_FABRIC_PORT_DEAD:
+			/* Only a failed dcpext could drive it: no connector. */
 			drm_warn(drm, "Type-C port %u: its display pipeline is unusable\n",
 				 port_idx);
 			continue;
diff --git a/drivers/gpu/drm/apple/dcp-fabric-core.c b/drivers/gpu/drm/apple/dcp-fabric-core.c
index 95b86a132e..ad461ea786 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-core.c
+++ b/drivers/gpu/drm/apple/dcp-fabric-core.c
@@ -566,5 +566,36 @@ enum dcp_fabric_t8132_dp_alt dcp_fabric_t8132_dp_alt(int phy_lanes, bool four_la
 }
 EXPORT_SYMBOL_GPL(dcp_fabric_t8132_dp_alt);
 
+/*
+ * Count a route of a Type-C port. A failed dcpext (@dead) drives nothing,
+ * whatever its SoC; a live T8132 dcpext (@t8132_ext) drives the route through
+ * its own DRM outputs.
+ */
+void dcp_fabric_port_count_route(struct dcp_fabric_port_routes *routes, bool dead,
+				 bool t8132_ext)
+{
+	if (dead)
+		routes->dead++;
+	else if (t8132_ext)
+		routes->t8132_ext++;
+	else
+		routes->live++;
+}
+EXPORT_SYMBOL_GPL(dcp_fabric_port_count_route);
+
+/*
+ * Who drives a Type-C port's display: this DRM device while one of its
+ * pipelines can, or while the port has no route at all; else a live T8132
+ * dcpext; else nothing.
+ */
+enum dcp_fabric_port_owner
+dcp_fabric_port_owner(const struct dcp_fabric_port_routes *routes)
+{
+	if (routes->live || !(routes->t8132_ext || routes->dead))
+		return DCP_FABRIC_PORT_DRM;
+	return routes->t8132_ext ? DCP_FABRIC_PORT_T8132_EXT : DCP_FABRIC_PORT_DEAD;
+}
+EXPORT_SYMBOL_GPL(dcp_fabric_port_owner);
+
 MODULE_DESCRIPTION("Apple display fabric decisions");
 MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/gpu/drm/apple/dcp-fabric-core.h b/drivers/gpu/drm/apple/dcp-fabric-core.h
index 4d49d623e5..8e533ce63f 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-core.h
+++ b/drivers/gpu/drm/apple/dcp-fabric-core.h
@@ -239,4 +239,30 @@ enum dcp_fabric_t8132_dp_alt {
 
 enum dcp_fabric_t8132_dp_alt dcp_fabric_t8132_dp_alt(int phy_lanes, bool four_lanes);
 
+/* The routes of a Type-C port, by what drives them. */
+struct dcp_fabric_port_routes {
+	/* A live pipeline of this DRM device. */
+	unsigned int live;
+	/* A live T8132 dcpext: its DRM outputs are its own, see t8132_ext_drm.c. */
+	unsigned int t8132_ext;
+	/* A failed dcpext (ext_dead), whatever its SoC. */
+	unsigned int dead;
+};
+
+void dcp_fabric_port_count_route(struct dcp_fabric_port_routes *routes, bool dead,
+				 bool t8132_ext);
+
+/* Who drives the display of a Type-C port. */
+enum dcp_fabric_port_owner {
+	/* This DRM device (or nothing is routed there yet): an apple_connector. */
+	DCP_FABRIC_PORT_DRM,
+	/* A T8132 dcpext, through its own DRM outputs: no apple_connector. */
+	DCP_FABRIC_PORT_T8132_EXT,
+	/* Failed dcpexts only: nothing drives it, no connector. */
+	DCP_FABRIC_PORT_DEAD,
+};
+
+enum dcp_fabric_port_owner
+dcp_fabric_port_owner(const struct dcp_fabric_port_routes *routes);
+
 #endif /* __APPLE_DCP_FABRIC_CORE_H__ */
diff --git a/drivers/gpu/drm/apple/dcp-fabric-test.c b/drivers/gpu/drm/apple/dcp-fabric-test.c
index f1504d1f2b..666c48b0b4 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-test.c
+++ b/drivers/gpu/drm/apple/dcp-fabric-test.c
@@ -253,6 +253,7 @@ static const struct fabric_scenario scenarios[] = {
 	{ "S50f_unwired_m3_ports_core", 55 },
 	{ "S50g_t8132_hdmi_start_core", 56 },
 	{ "S50h_t8132_dp_alt_core", 57 },
+	{ "S50i_typec_port_owner_core", 58 },
 };
 
 static void fabric_scenario_desc(const struct fabric_scenario *scenario,
@@ -506,6 +507,40 @@ static void fabric_scenario_test(struct kunit *test)
 		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_dp_alt(-EINVAL, false),
 				DCP_FABRIC_T8132_DP_ALT_NO_PHY);
 		break;
+	case 58: {
+		static const struct {
+			struct dcp_fabric_port_routes routes;
+			enum dcp_fabric_port_owner owner;
+		} owners[] = {
+			/* No route at all: the connector stays, as it always did. */
+			{ {}, DCP_FABRIC_PORT_DRM },
+			/* J604: live T8132 dcpexts only. */
+			{ { .t8132_ext = 1 }, DCP_FABRIC_PORT_T8132_EXT },
+			/* A failed dcpext beside a live T8132 one: the T8132 one drives it. */
+			{ { .t8132_ext = 1, .dead = 1 }, DCP_FABRIC_PORT_T8132_EXT },
+			/* Failed dcpexts only: nothing drives it. */
+			{ { .dead = 2 }, DCP_FABRIC_PORT_DEAD },
+			/* A live pipeline of this DRM device: its connector. */
+			{ { .live = 1 }, DCP_FABRIC_PORT_DRM },
+			{ { .live = 1, .t8132_ext = 1, .dead = 1 }, DCP_FABRIC_PORT_DRM },
+		};
+		struct dcp_fabric_port_routes routes = {};
+		unsigned int i;
+
+		for (i = 0; i < ARRAY_SIZE(owners); i++)
+			KUNIT_EXPECT_EQ_MSG(test, dcp_fabric_port_owner(&owners[i].routes),
+					    owners[i].owner, "row %u", i);
+		/* A failed dcpext counts as failed, whatever its SoC. */
+		dcp_fabric_port_count_route(&routes, true, true);
+		dcp_fabric_port_count_route(&routes, true, false);
+		dcp_fabric_port_count_route(&routes, false, true);
+		dcp_fabric_port_count_route(&routes, false, false);
+		dcp_fabric_port_count_route(&routes, false, true);
+		KUNIT_EXPECT_EQ(test, routes.dead, 2U);
+		KUNIT_EXPECT_EQ(test, routes.t8132_ext, 2U);
+		KUNIT_EXPECT_EQ(test, routes.live, 1U);
+		break;
+	}
 	case 55:
 		f.port[0].next = NULL;
 		KUNIT_EXPECT_EQ(test, dcp_fabric_tunnel_request(f.port, 2, 0, &found), -ENODEV);
diff --git a/drivers/gpu/drm/apple/dcp-fabric.c b/drivers/gpu/drm/apple/dcp-fabric.c
index b6ced8f009..32455689be 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.c
+++ b/drivers/gpu/drm/apple/dcp-fabric.c
@@ -4258,27 +4258,26 @@ bool dcp_typec_port_has_candidate(unsigned int idx, struct platform_device *pdev
 }
 
 /*
- * Is every pipeline that can drive port @idx unusable (a failed T8122
- * dcpext, or a T8132 dcpext, whose DRM outputs are its own, see
- * t8132_ext_drm.c)? Such a port gets no connector, rather than failing the
- * DRM device of the internal panel.
+ * Who drives the display of port @idx, see dcp_fabric_port_owner(). Only a
+ * port this DRM device drives gets an apple_connector: a T8132 dcpext's DRM
+ * outputs are its own (t8132_ext_drm.c), and a port with failed dcpexts only
+ * gets none, rather than failing the DRM device of the internal panel.
  */
-bool dcp_typec_port_unusable(unsigned int idx)
+enum dcp_fabric_port_owner dcp_typec_port_owner(unsigned int idx)
 {
+	struct dcp_fabric_port_routes routes = {};
 	struct apple_dcp_typec_port *port;
 	struct apple_dcp_typec_route *route;
 
 	guard(mutex)(&dcp_typec_fabric_lock);
 
 	port = dcp_typec_port_by_index(idx);
-	if (!port || list_empty(&port->routes))
-		return false;
-
-	list_for_each_entry(route, &port->routes, port_link)
-		if (!READ_ONCE(route->dcp->ext_dead) && !dcp_typec_route_t8132(route))
-			return false;
+	if (port)
+		list_for_each_entry(route, &port->routes, port_link)
+			dcp_fabric_port_count_route(&routes, READ_ONCE(route->dcp->ext_dead),
+						    dcp_typec_route_t8132(route));
 
-	return true;
+	return dcp_fabric_port_owner(&routes);
 }
 
 static void dcp_typec_port_bind_connector(struct apple_dcp_typec_port *port,
diff --git a/drivers/gpu/drm/apple/dcp-fabric.h b/drivers/gpu/drm/apple/dcp-fabric.h
index 8cff4ae230..b121074a47 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.h
+++ b/drivers/gpu/drm/apple/dcp-fabric.h
@@ -76,7 +76,7 @@ bool dcp_has_typec_routes(struct platform_device *pdev);
 unsigned int dcp_typec_nr_ports(void);
 struct device_node *dcp_typec_port_of_node(unsigned int idx);
 bool dcp_typec_port_has_candidate(unsigned int idx, struct platform_device *pdev);
-bool dcp_typec_port_unusable(unsigned int idx);
+enum dcp_fabric_port_owner dcp_typec_port_owner(unsigned int idx);
 void dcp_typec_port_set_connector(unsigned int idx, bool secondary,
 				  struct apple_connector *connector,
 				  struct platform_device *pipeline);
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 329b295195..0b8b360a15 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -6385,8 +6385,8 @@ static int dcp_desktop_probe_routes(struct apple_dcp *dcp)
  * An adopted T8132 dcpext offers its Type-C routes. It is no component of
  * the DRM device (its outputs are added by t8132_ext_drm.c): the routes
  * follow the port modes, refuse DP alt mode and get no apple_connector (see
- * dcp_typec_route_set() and dcp_typec_port_unusable()). Its route suppliers were there before the
- * adoption, see dcp_platform_probe_t8132_ext(). A failure leaves the routes
+ * dcp_typec_route_set() and dcp_typec_port_owner()). Its route suppliers were
+ * there before the adoption, see dcp_platform_probe_t8132_ext(). A failure leaves the routes
  * disabled, so the port controllers do not wait for them; the adopted
  * session stays.
  */
-- 
