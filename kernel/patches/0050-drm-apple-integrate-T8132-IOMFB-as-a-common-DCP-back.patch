diff --git a/drivers/gpu/drm/apple/iomfb_m4_present.h b/drivers/gpu/drm/apple/iomfb_m4_present.h
new file mode 100644
index 0000000000..6f51b93613
--- /dev/null
+++ b/drivers/gpu/drm/apple/iomfb_m4_present.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* The T8132 panel's single-surface profile on common DMA GEM objects. */
+#ifndef __APPLE_IOMFB_M4_PRESENT_H__
+#define __APPLE_IOMFB_M4_PRESENT_H__
+
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_plane.h>
+
+#include "dcp-m4-frame.h"
+
+static inline int iomfb_m4_plane_frame(const struct drm_plane_state *state,
+				       u32 width, u32 height,
+				       struct dcp_m4_frame *frame)
+{
+	struct drm_framebuffer *fb = state->fb;
+	struct drm_gem_dma_object *obj;
+
+	if (!fb || fb->format->num_planes != 1 || fb->offsets[0] ||
+	    fb->modifier != DRM_FORMAT_MOD_LINEAR ||
+	    (fb->format->format != DRM_FORMAT_XRGB8888 &&
+	     fb->format->format != DRM_FORMAT_ARGB8888) ||
+	    state->src_x || state->src_y || state->crtc_x || state->crtc_y ||
+	    state->src_w != (u64)width << 16 || state->src_h != (u64)height << 16 ||
+	    state->crtc_w != width || state->crtc_h != height)
+		return -EINVAL;
+	obj = drm_fb_dma_get_gem_obj(fb, 0);
+	if (!obj)
+		return -EINVAL;
+	return dcp_m4_direct_frame(frame, obj->dma_addr, obj->base.size,
+				   fb->width, fb->height, fb->pitches[0],
+				   fb->format->format == DRM_FORMAT_ARGB8888);
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/plane.c b/drivers/gpu/drm/apple/plane.c
index cde215f62b..a0343aa5ec 100644
--- a/drivers/gpu/drm/apple/plane.c
+++ b/drivers/gpu/drm/apple/plane.c
@@ -4,6 +4,7 @@
  */
 
 #include "plane.h"
+#include "dcp.h"
 
 #include "dcp-internal.h"
 #include "iomfb_internal.h"
@@ -538,6 +539,10 @@ static int apple_plane_prepare_fb(struct drm_plane *plane,
 	if (!old || !old->crtc || !old->fb || old->fb == state->fb)
 		return 0;
 
+	/* The M4 backend retains accepted and uncertain scanout itself. */
+	if (iomfb_is_m4(platform_get_drvdata(to_apple_crtc(old->crtc)->dcp)))
+		return 0;
+
 	entry = kzalloc_obj(*entry);
 	if (!entry)
 		return -ENOMEM;
@@ -825,3 +830,62 @@ struct drm_plane *apple_plane_init_v14_7(struct drm_device *dev,
 
 	return &plane->base;
 }
+
+#if IS_ENABLED(CONFIG_DRM_APPLE_DCP_T8132)
+#include "iomfb_m4_present.h"
+
+static const u32 dcp_primary_formats_v26_6[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+};
+
+static int apple_plane_atomic_check_v26_6(struct drm_plane *plane,
+					struct drm_atomic_commit *commit)
+{
+	struct drm_plane_state *new = drm_atomic_get_new_plane_state(commit, plane);
+	struct drm_crtc_state *crtc_state;
+	struct dcp_m4_frame frame;
+	int ret;
+
+	if (!new->crtc)
+		return 0;
+	crtc_state = drm_atomic_get_crtc_state(commit, new->crtc);
+	if (IS_ERR(crtc_state))
+		return PTR_ERR(crtc_state);
+	ret = drm_atomic_helper_check_plane_state(new, crtc_state,
+						DRM_PLANE_NO_SCALING,
+						DRM_PLANE_NO_SCALING, false, true);
+	if (ret)
+		return ret;
+	if (!new->visible)
+		return crtc_state->active ? -EINVAL : 0;
+	return iomfb_m4_plane_frame(new, crtc_state->mode.hdisplay,
+				     crtc_state->mode.vdisplay, &frame);
+}
+
+static const struct drm_plane_helper_funcs apple_primary_plane_helper_funcs_v26_6 = {
+	.prepare_fb = apple_plane_prepare_fb,
+	.cleanup_fb = apple_plane_cleanup_fb,
+	.atomic_check = apple_plane_atomic_check_v26_6,
+	.atomic_update = apple_plane_atomic_update,
+	.get_scanout_buffer = drm_fb_dma_get_scanout_buffer,
+};
+
+struct drm_plane *apple_plane_init_v26_6(struct drm_device *dev,
+				      unsigned long possible_crtcs, u32 iomfb_surf)
+{
+	struct apple_plane *plane;
+
+	plane = drmm_universal_plane_alloc(dev, struct apple_plane, base,
