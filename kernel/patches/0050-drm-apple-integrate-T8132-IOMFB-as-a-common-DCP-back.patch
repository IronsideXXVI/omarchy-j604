index 0000000000..08249a9f25
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-callback.h
@@ -0,0 +1,209 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_DCP_M4_CALLBACK_H
+#define APPLE_DCP_M4_CALLBACK_H
+
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+#include "dcp-m4-profile.h"
+
+/* All hooks execute under the serialized transaction owner, never in IRQ context. */
+struct dcp_m4_callback_ops {
+	int (*call)(void *cookie, unsigned int method, bool remote,
+		    const void *input, u32 input_size, void *output, u32 output_size);
+	int (*swap_done)(void *cookie, u32 id);
+	/* Copy the bounded name and compute/retain any digest before packet ACK/reuse. */
+	int (*event)(void *cookie, const char *name, const void *dictionary, size_t size);
+	int (*property)(void *cookie, unsigned int method, const void *input, void *output);
+	int (*memory)(void *cookie, unsigned int method, const void *input, void *output);
+};
+
+struct dcp_m4_callback_shape {
+	u16 method;
+	u16 input;
+	u16 output;
+};
+
+static inline int dcp_m4_callback_result(int ret)
+{
+	return ret > 0 ? -EPROTO : ret;
+}
+
+/* Exact qualified J713 shapes. An absent behavior hook is failure, never an ACK. */
+static const struct dcp_m4_callback_shape dcp_m4_callbacks[] = {
+	{0, 0, 4}, {1, 0, 4}, {3, 4, 60}, {6, 84, 80},
+	{100, 0, 0}, {101, 0, 4}, {102, 68, 0}, {104, 68, 0}, {107, 64, 0},
+	{108, 0, 4}, {109, 0, 4}, {110, 0, 4}, {111, 0, 4}, {112, 0, 4}, {113, 0, 4},
+	{114, 4164, 4100}, {121, 0, 4}, {122, 0, 4}, {123, 0, 4},
+	{125, 100, 36}, {127, 4, 4}, {128, 4104, 4}, {129, 64, 4},
+	{201, 12, 16}, {206, 0, 4}, {207, 0, 4}, {300, 16, 0},
+	{400, 76, 3076}, {401, 80, 12}, {406, 72, 0}, {408, 8, 8},
+	{413, 4168, 4}, {414, 80, 4}, {415, 76, 4}, {451, 20, 28}, {454, 4, 4},
+	{552, 4164, 4}, {561, 4164, 4}, {563, 76, 4}, {565, 72, 4}, {567, 128, 4},
+	{575, 88, 76}, {576, 4, 0}, {582, 8, 4}, {588, 0, 0}, {590, 1840, 0}, {599, 0, 0},
+};
+
+static inline int dcp_m4_callback_method(u32 tag)
+{
+	unsigned int method = 0;
+
+	if ((tag & 0xff) != 'D')
+		return -EPROTO;
+	for (unsigned int shift = 8; shift < 32; shift += 8) {
+		u8 digit = tag >> shift;
+
+		if (digit < '0' || digit > '9')
+			return -EPROTO;
+		method = method * 10 + digit - '0';
+	}
+	return method;
+}
+
+static inline int dcp_m4_callback_shape(u32 tag, u32 input, u32 output)
+{
+	int method = dcp_m4_callback_method(tag);
+
+	const struct dcp_m4_callback_shape *table = dcp_m4_callbacks;
+	unsigned int count = ARRAY_SIZE(dcp_m4_callbacks);
+
+	if (method < 0)
+		return method;
+	for (unsigned int i = 0; i < count; i++)
+		if (table[i].method == method)
+			return input == table[i].input &&
+				output == table[i].output ? method : -EMSGSIZE;
+	return -EOPNOTSUPP;
+}
+
+static inline int dcp_m4_nested_call(const struct dcp_m4_callback_ops *ops, void *cookie,
+				    bool remote, unsigned int method, bool input_one,
+				    int expected)
+{
+	u8 input[4], output[4] = {0};
+	int ret;
+
+	if (!ops->call)
+		return -EOPNOTSUPP;
+	put_unaligned_le32(1, input);
+	/* expected: -1 no output, -2 four-byte output of any value. */
+	ret = ops->call(cookie, method, remote, input_one ? input : NULL, input_one ? 4 : 0,
+			expected == -1 ? NULL : output, expected == -1 ? 0 : 4);
+	if (ret)
+		return ret < 0 ? ret : -EPROTO;
+	if (expected >= 0 && get_unaligned_le32(output) != (u32)expected)
+		return -EPROTO;
+	return 0;
+}
+
+/*
+ * The transaction layer has already located and owns non-overlapping packet
+ * input/output spans. It must poison the session on any error here, and send an
+ * ACK only after successful dispatch and device-visible output publication.
+ */
+static inline int dcp_m4_callback_dispatch(const struct dcp_m4_callback_ops *ops, void *cookie,
+					 u32 tag, bool remote, const void *input, u32 input_size,
+					 void *output, u32 output_size)
+{
+	const u8 *in = input;
+	u8 *out = output;
+	int method, ret;
+	u32 value;
+
+	method = dcp_m4_callback_shape(tag, input_size, output_size);
+	if (method < 0)
+		return method;
+	if (!ops || (input_size && !input) || (output_size && !output))
+		return -EINVAL;
+	if (output_size)
+		memset(out, 0, output_size);
+
+	switch (method) {
+	case 0: case 1: case 108: case 109: case 110: case 111: case 112: case 113:
+		put_unaligned_le32(1, out);
+		return 0;
+	case 3:
+		put_unaligned_le32(1, out + 56); /* Decline optional bandwidth service. */
+		return 0;
+	case 6:
+		if (!(in[80] & 1))
+			memcpy(out, in, 80);
+		return 0;
+	case 575:
+		if (!(in[84] & 1))
+			memcpy(out, in + 8, 76);
+		return 0;
+	case 300: case 406: case 576: case 588:
+		return 0;
+	case 122: case 123: case 582:
+		return 0; /* False, not an unimplemented service returning success. */
+	case 101:
+		put_unaligned_le32(dcp_m4_pf->boot_stride, out);
+		return 0;
+	case 125:
+		value = get_unaligned_le32(in + 64);
+		if (value > 8)
+			return -EINVAL;
+		memcpy(out, in + 68, value * 4);
+		return 0;
+	case 408:
+		value = get_unaligned_le32(in + 4);
+		if (memcmp(in, "VORP", 4) || value > 1)
+			return -EINVAL;
+		put_unaligned_le64(value ? 24000000 : 48000000, out);
+		return 0;
+	case 590:
+		value = get_unaligned_le32(in);
+		if (!value)
+			return -EPROTO;
+		return ops->swap_done ? dcp_m4_callback_result(ops->swap_done(cookie, value)) :
+			-EOPNOTSUPP;
+	case 599:
+		return dcp_m4_nested_call(ops, cookie, remote, 412, false, 1);
+	case 100:
+		return dcp_m4_nested_call(ops, cookie, remote, 390, false, 0);
+	case 206: case 207:
+		ret = dcp_m4_nested_call(ops, cookie, remote, method == 206 ? 131 : 132, false, 0);
+		if (ret)
+			return ret;
+		put_unaligned_le32(1, out);
+		return 0;
+	case 121:
+		ret = dcp_m4_nested_call(ops, cookie, remote, 389, false, -1);
+		if (!ret)
+			ret = dcp_m4_nested_call(ops, cookie, remote, 446, false, 1);
+		if (!ret)
+			ret = dcp_m4_nested_call(ops, cookie, remote, 29, false, -1);
+		if (!ret)
+			ret = dcp_m4_nested_call(ops, cookie, remote, 468, true, -1);
+		if (!ret)
+			ret = dcp_m4_nested_call(ops, cookie, remote, 0, true, 1);
+		if (!ret)
+			ret = dcp_m4_nested_call(ops, cookie, remote, 465, false, 1);
+		if (ret)
+			return ret;
+		put_unaligned_le32(1, out);
+		return 0;
+	case 114:
+		if (!memchr(in, 0, 64) || in[4160] > 1 || (!in[4160] && in[64] != 'd'))
+			return -EINVAL;
+		if (!ops->event)
+			return -EOPNOTSUPP;
+		ret = ops->event(cookie, (const char *)in, (in[4160] & 1) ? NULL : in + 64,
+				(in[4160] & 1) ? 0 : 4096);
+		if (ret)
+			return ret < 0 ? ret : -EPROTO;
+		if (!(in[4160] & 1))
+			memcpy(out, in + 64, 4096);
+		return 0;
+	case 201: case 451: case 454:
+		return ops->memory ?
+			dcp_m4_callback_result(ops->memory(cookie, method, input, output)) : -EOPNOTSUPP;
+	default:
+		return ops->property ?
+			dcp_m4_callback_result(ops->property(cookie, method, input, output)) : -EOPNOTSUPP;
+	}
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-frame.h b/drivers/gpu/drm/apple/dcp-m4-frame.h
new file mode 100644
index 0000000000..5ea5dc47f6
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-frame.h
@@ -0,0 +1,371 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_DCP_M4_FRAME_H
+#define APPLE_DCP_M4_FRAME_H
+
+#include <linux/bits.h>
+#include <linux/errno.h>
+#include <linux/limits.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+#include "dcp-m4-profile.h"
+
+/* Qualified firmware-26.6.2 swap and physical panel dimensions. */
+#define DCP_M4_SWAP_SIZE		(dcp_m4_pf->swap_size)
+#define DCP_M4_SURFACE_SIZE	0x22cU
+#define DCP_M4_PANEL_WIDTH	(dcp_m4_pf->panel_width)
+#define DCP_M4_PANEL_HEIGHT	(dcp_m4_pf->panel_height)
+
+/* Used only after matching firmware-advertised preferred physical timing. */
+enum dcp_m4_frame_format {
+	DCP_M4_XRGB8888,
+	DCP_M4_ARGB8888,
+};
+
+struct dcp_m4_frame {
+	u64 dva;
+	u64 backing_size;
+	u32 width;
+	u32 height;
+	u32 stride;
+	enum dcp_m4_frame_format format;
+};
+
+static inline int dcp_m4_frame_check(const struct dcp_m4_frame *frame)
+{
+	u64 size = (u64)frame->stride * frame->height;
+
+	if (frame->width != DCP_M4_PANEL_WIDTH || frame->height != DCP_M4_PANEL_HEIGHT ||
+	    frame->stride < DCP_M4_PANEL_WIDTH * 4 || frame->stride % 64 ||
+	    !size || size > 0xffffffffULL || frame->backing_size < size ||
+	    !frame->dva || frame->dva % 0x4000 || frame->dva >= (1ULL << 42) ||
+	    size > (1ULL << 42) - frame->dva ||
+	    (frame->format != DCP_M4_XRGB8888 && frame->format != DCP_M4_ARGB8888))
+		return -EINVAL;
+	return 0;
+}
+
+/* Display-consumer DMA aperture: the 64-GiB DART range at its 1-TiB alias. */
+#define DCP_M4_SCANOUT_BASE	(1ULL << 40)
+#define DCP_M4_SCANOUT_SIZE	(1ULL << 36)
+
+/* Accumulate one mapped DMA segment; only one exactly contiguous extent qualifies. */
+static inline int dcp_m4_extent_add(u64 *start, u64 *length, u64 addr, u64 size)
+{
+	if (!size)
+		return -EINVAL;
+	if (!*length) {
+		if (size > U64_MAX - addr)
+			return -ERANGE;
+		*start = addr;
+		*length = size;
+		return 0;
+	}
+	/* Invariant: start + length never wraps. */
+	if (addr != *start + *length || size > U64_MAX - addr)
+		return -ERANGE;
+	*length += size;
+	return 0;
+}
+
+/* A client mapping must cover the needed bytes inside the SID0 aperture. */
+static inline int dcp_m4_direct_extent(u64 dva, u64 mapped, u64 needed)
+{
+	if (!dva || dva % 0x4000 || !needed || mapped < needed ||
+	    dva < DCP_M4_SCANOUT_BASE || dva - DCP_M4_SCANOUT_BASE >= DCP_M4_SCANOUT_SIZE ||
+	    mapped > DCP_M4_SCANOUT_SIZE - (dva - DCP_M4_SCANOUT_BASE))
+		return -ERANGE;
+	return 0;
+}
+
+/* Describe a qualified client framebuffer at its SID0 DVA; no CPU access. */
+static inline int dcp_m4_direct_frame(struct dcp_m4_frame *frame, u64 dva, u64 mapped,
+				      u32 width, u32 height, u32 pitch, bool alpha)
+{
+	*frame = (struct dcp_m4_frame) {
+		.dva = dva, .backing_size = mapped, .width = width, .height = height,
+		.stride = pitch, .format = alpha ? DCP_M4_ARGB8888 : DCP_M4_XRGB8888,
+	};
+	if (dcp_m4_direct_extent(dva, mapped, (u64)pitch * height))
+		return -ERANGE;
+	return dcp_m4_frame_check(frame);
+}
+
+/* Exact single-layer fixture, not an ABI for tiled or compressed surfaces. */
+static inline void dcp_m4_surface_encode(u8 *surface, const struct dcp_m4_frame *frame)
+{
+	u32 size = frame->stride * frame->height;
+
+	memset(surface, 0, DCP_M4_SURFACE_SIZE);
+	surface[2] = frame->format == DCP_M4_XRGB8888;
+	put_unaligned_le32(1, surface + 3);
+	put_unaligned_le32(1, surface + 7);
+	put_unaligned_le32(0x42475241, surface + 0x0b);
+	surface[0x13] = 13;
+	surface[0x14] = 12;
+	put_unaligned_le32(frame->stride, surface + 0x15);
+	put_unaligned_le16(1, surface + 0x19);
+	surface[0x1b] = 1;
+	surface[0x1c] = 1;
+	put_unaligned_le32(frame->width, surface + 0x21);
+	put_unaligned_le32(frame->height, surface + 0x25);
+	put_unaligned_le32(size, surface + 0x29);
+	put_unaligned_le32(1, surface + 0x35);
+	put_unaligned_le64(1, surface + 0x51);
+	put_unaligned_le32(frame->width, surface + 0x59);
+	put_unaligned_le32(frame->height, surface + 0x5d);
+	put_unaligned_le32(frame->stride, surface + 0x69);
+	put_unaligned_le32(size, surface + 0x6d);
+	put_unaligned_le16(4, surface + 0x71);
+	surface[0x73] = 1;
+	surface[0x74] = 1;
+	put_unaligned_le64(1, surface + 0x149);
+}
+
+/* Encode an integer development brightness without floating-point operations. */
+static inline u64 dcp_m4_nits_binary64(u32 nits)
+{
+	unsigned int bit = 0;
+
+	if (!nits)
+		return 0;
+	while ((nits >> bit) > 1)
+		bit++;
+	return ((u64)(1023 + bit) << 52) | ((u64)(nits - (1U << bit)) << (52 - bit));
+}
+
+/*
+ * External outputs: any qualified size up to 3840x2160, same surface layout.
+ * The frame must already be described at its wire DVA in an owned mapping.
+ */
+static inline int dcp_m4_frame_check_ext(const struct dcp_m4_frame *frame)
+{
+	u64 size = (u64)frame->stride * frame->height;
+
+	if (!frame->width || !frame->height || frame->width > 3840 || frame->height > 2160 ||
+	    frame->stride < frame->width * 4 || frame->stride % 64 ||
+	    !size || size > 0xffffffffULL || frame->backing_size < size ||
+	    !frame->dva || frame->dva % 0x4000 || frame->dva >= (1ULL << 42) ||
+	    size > (1ULL << 42) - frame->dva ||
+	    (frame->format != DCP_M4_XRGB8888 && frame->format != DCP_M4_ARGB8888))
+		return -EINVAL;
+	return 0;
+}
+
+/*
+ * One upper surface of an indexed swap (cursor/overlay contract): firmware
+ * surface-array index 1..3, a fully on-panel destination (the caller clips),
+ * no scaling. A NULL frame removes the surface.
+ */
+struct dcp_m4_upper {
+	const struct dcp_m4_frame *frame;
+	u32 index, x, y;
+	u32 id, flags;
+};
+
+static inline int dcp_m4_upper_check(const struct dcp_m4_upper *u)
+{
+	const struct dcp_m4_frame *f = u->frame;
+	u64 size;
+
+	if (u->index < 1 || u->index > 3)
+		return -EINVAL;
+	if (!f)
+		return 0;
+	size = (u64)f->stride * f->height;
+	/* Firmware rejects (or crashes on) visible surfaces below 32x32. */
+	if (f->width < 32 || f->height < 32 || f->width > 256 || f->height > 256 ||
+	    f->stride < f->width * 4 || f->stride % 64 || f->backing_size < size ||
+	    !f->dva || f->dva % 0x4000 || f->dva >= (1ULL << 42) ||
+	    f->format != DCP_M4_ARGB8888 ||
+	    u->x > DCP_M4_PANEL_WIDTH - f->width || u->y > DCP_M4_PANEL_HEIGHT - f->height)
+		return -EINVAL;
+	return 0;
+}
+
+/*
+ * Swap request. With primary, surface 0 is presented (frame) or everything is
+ * blanked (NULL frame, background colour): mask 0x80000007, less the upper
+ * indices in keep while presenting (so a primary flip never removes a live
+ * cursor), plus them when blanking. upper adds its own update bit: a swap
+ * without primary leaves surface 0 untouched (bit 0 clear, null byte 1).
+ */
+static inline int dcp_m4_swap_encode_full(void *output, size_t length, u32 swap_id,
+					  bool primary, const struct dcp_m4_frame *frame,
+					  const struct dcp_m4_upper *upper, u32 keep,
+					  bool brightness_change, u32 nits,
+					  int (*check)(const struct dcp_m4_frame *frame))
+{
+	u8 *data = output;
+	u32 mask = 0;
+
+	if (length != DCP_M4_SWAP_SIZE || !swap_id || (brightness_change && nits > 500) ||
+	    (!primary && !upper) || (keep & ~0xeU))
+		return -EINVAL;
+	if (primary && frame && check(frame))
+		return -EINVAL;
+	if (upper && dcp_m4_upper_check(upper))
+		return -EINVAL;
+	if (primary)
+		mask = frame ? 0x80000007 & ~keep : 0x80000007 | keep;
+	if (upper)
+		mask |= BIT(upper->index);
+	memset(data, 0, length);
+	put_unaligned_le32(swap_id, data + 0x98);
+	put_unaligned_le32(mask, data + 0x14c);
+	put_unaligned_le32(mask, data + 0x150);
+	put_unaligned_le32(primary && !frame ? dcp_m4_pf->disabled_color : 0xff000000,
+			   data + 0x154);
+	memset(data + dcp_m4_pf->swap_nullable, 1, 10);
+	data[dcp_m4_pf->swap_tail] = 1;
+	data[dcp_m4_pf->swap_tail + 1] = 1;
+	if (brightness_change) {
+		data[0x354] = 1;
+		put_unaligned_le64(dcp_m4_nits_binary64(nits), data + dcp_m4_pf->swap_nits);
+	}
+	if (primary && frame) {
+		put_unaligned_le32(1, data + 0x9c);
+		put_unaligned_le32(frame->width, data + 0xb4);
+		put_unaligned_le32(frame->height, data + 0xb8);
+		put_unaligned_le32(frame->width, data + 0x114);
+		put_unaligned_le32(frame->height, data + 0x118);
+		dcp_m4_surface_encode(data + dcp_m4_pf->swap_surface, frame);
+		put_unaligned_le64(frame->dva, data + dcp_m4_pf->swap_dva);
+		data[dcp_m4_pf->swap_nullable] = 0;
+	}
+	if (upper && upper->frame) {
+		const struct dcp_m4_frame *f = upper->frame;
+		u32 i = upper->index;
+
+		put_unaligned_le32(upper->id, data + 0x9c + 4 * i);
+		/* Source x,y,w,h then destination x,y,w,h. */
+		put_unaligned_le32(f->width, data + 0xac + 16 * i + 8);
+		put_unaligned_le32(f->height, data + 0xac + 16 * i + 12);
+		put_unaligned_le32(upper->flags, data + 0xec + 4 * i);
+		put_unaligned_le32(upper->x, data + 0x10c + 16 * i);
+		put_unaligned_le32(upper->y, data + 0x10c + 16 * i + 4);
+		put_unaligned_le32(f->width, data + 0x10c + 16 * i + 8);
+		put_unaligned_le32(f->height, data + 0x10c + 16 * i + 12);
+		dcp_m4_surface_encode(data + dcp_m4_pf->swap_surface + DCP_M4_SURFACE_SIZE * i, f);
+		put_unaligned_le64(f->dva, data + dcp_m4_pf->swap_dva + 8 * i);
+		data[dcp_m4_pf->swap_nullable + i] = 0;
+	}
+	return 0;
+}
+
+static inline int dcp_m4_swap_encode_checked(void *output, size_t length, u32 swap_id,
+					     const struct dcp_m4_frame *frame,
+					     bool brightness_change, u32 nits,
+					     int (*check)(const struct dcp_m4_frame *frame))
+{
+	return dcp_m4_swap_encode_full(output, length, swap_id, true, frame, NULL, 0,
+				       brightness_change, nits, check);
+}
+
+static inline int dcp_m4_swap_encode(void *output, size_t length, u32 swap_id,
+				     const struct dcp_m4_frame *frame,
+				     bool brightness_change, u32 nits)
+{
+	return dcp_m4_swap_encode_checked(output, length, swap_id, frame, brightness_change,
+					  nits, dcp_m4_frame_check);
+}
+
+static inline int dcp_m4_swap_start_reply(const void *input, size_t size, u32 *swap_id)
+{
+	const u8 *data = input;
+	u32 id;
+
+	if (size != 8)
+		return -EMSGSIZE;
+	id = get_unaligned_le32(data);
+	if (!id || get_unaligned_le32(data + 4))
+		return -EPROTO;
+	*swap_id = id;
+	return 0;
+}
+
+/* A407 reply and D590 are independent gates; callers must wait for both. */
+static inline int dcp_m4_swap_submit_reply(const void *input, size_t size)
+{
+	const u8 *data = input;
+
+	if (size != 12)
+		return -EMSGSIZE;
+	return get_unaligned_le32(data + 5) ? -EPROTO : 0;
+}
+
+static inline int dcp_m4_swap_complete(const void *input, size_t size, u32 pending_id)
+{
+	if (size != dcp_m4_pf->done_size)
+		return -EMSGSIZE;
+	return pending_id && get_unaligned_le32(input) == pending_id ? 0 : -EPROTO;
+}
+
+/* Serialized owner only. The caller retains both scanout buffers on any error. */
+struct dcp_m4_swap_state {
+	u32 id;
+	int error;
+	bool replied;
+	bool completed;
+	bool emitted;
+};
+
+static inline int dcp_m4_swap_fail(struct dcp_m4_swap_state *swap, int error)
+{
+	if (!swap->error)
+		swap->error = error < 0 ? error : -EPROTO;
+	return swap->error;
+}
+
+/* Begin after A406 supplies its validated ID, before publishing A407. */
+static inline int dcp_m4_swap_begin(struct dcp_m4_swap_state *swap, u32 id)
+{
+	if (swap->error)
+		return swap->error;
+	if (!id)
+		return dcp_m4_swap_fail(swap, -EINVAL);
+	if (swap->id && !swap->emitted)
+		return dcp_m4_swap_fail(swap, -EBUSY);
+	*swap = (struct dcp_m4_swap_state){.id = id};
+	return 0;
+}
+
+static inline int dcp_m4_swap_record_reply(struct dcp_m4_swap_state *swap,
+					 const void *reply, size_t size)
+{
+	int ret;
+
+	if (swap->error)
+		return swap->error;
+	if (!swap->id || swap->replied)
+		return dcp_m4_swap_fail(swap, -EPROTO);
+	ret = dcp_m4_swap_submit_reply(reply, size);
+	if (ret)
+		return dcp_m4_swap_fail(swap, ret);
+	swap->replied = true;
+	return 0;
+}
+
+/* Called by the exact-shape-validated D590 hook; callback alone is not a flip. */
+static inline int dcp_m4_swap_record_done(struct dcp_m4_swap_state *swap, u32 id)
+{
+	if (swap->error)
+		return swap->error;
+	if (!swap->id || id != swap->id || swap->completed)
+		return dcp_m4_swap_fail(swap, -EPROTO);
+	swap->completed = true;
+	return 0;
+}
+
+/* One completion event, only after both the A407 reply and matching D590. */
+static inline int dcp_m4_swap_take_completion(struct dcp_m4_swap_state *swap)
+{
+	if (swap->error)
+		return swap->error;
+	if (!swap->id || !swap->replied || !swap->completed || swap->emitted)
+		return 0;
+	swap->emitted = true;
+	return 1;
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-memory.h b/drivers/gpu/drm/apple/dcp-m4-memory.h
new file mode 100644
index 0000000000..0716c432f1
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-memory.h
@@ -0,0 +1,129 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_DCP_M4_MEMORY_H
+#define APPLE_DCP_M4_MEMORY_H
+
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+#include "dcp-m4-profile.h"
+
+#define DCP_M4_MEMORY_OBJECTS 64
+#define DCP_M4_MEMORY_LIMIT (64U << 20)
+#define DCP_M4_MEMORY_MAX (16U << 20)
+#define DCP_M4_MEMORY_PAGE 0x4000U
+
+struct dcp_m4_memory_object {
+	u64 phys, dva, size;
+	bool mapped, retired;
+};
+
+/* Heap-backed, single serialized callback owner. Retired IDs are never reused. */
+struct dcp_m4_memory {
+	struct dcp_m4_memory_object object[DCP_M4_MEMORY_OBJECTS];
+	u32 count, bytes;
+	bool failed;
+};
+
+struct dcp_m4_memory_ops {
+	/* Must reserve both SID23/SID16 slots, pin backing, then publish only SID23. */
+	int (*alloc)(void *cookie, u32 size, u64 *phys, u64 *dva);
+	/* Must map the same backing at the same DVA in SID16, flush and verify. */
+	int (*map)(void *cookie, u64 phys, u64 dva, u32 size);
+};
+
+/* Called only after the dispatcher validates exact callback input/output sizes. */
+static inline int dcp_m4_memory_callback(struct dcp_m4_memory *memory,
+					 const struct dcp_m4_memory_ops *ops, void *cookie,
+					 unsigned int method, const void *input, void *output)
+{
+	struct dcp_m4_memory_object *object;
+	const u8 *in = input;
+	u8 *out = output;
+	u64 size, phys = 0, dva = 0, id;
+	u32 align;
+	int ret = -EINVAL;
+
+	if (memory->failed)
+		return -EIO;
+	if (method == 451) {
+		size = get_unaligned_le64(in + 4);
+		align = get_unaligned_le32(in + 12);
+		/* The qualified internal firmware requests alignment exponent 4. */
+		if (get_unaligned_le32(in) != 0x703 || !size || size > DCP_M4_MEMORY_MAX ||
+		    align != 4 || in[16] || in[17] || in[18])
+			goto failed;
+		/* Byte 19 is padding, observed nonzero in otherwise valid requests. */
+		size = (size + DCP_M4_MEMORY_PAGE - 1) & ~(u64)(DCP_M4_MEMORY_PAGE - 1);
+		if (memory->count >= DCP_M4_MEMORY_OBJECTS || memory->bytes > DCP_M4_MEMORY_LIMIT - size) {
+			ret = -ENOSPC;
+			goto failed;
+		}
+		if (!ops->alloc) {
+			ret = -EOPNOTSUPP;
+			goto failed;
+		}
+		ret = ops->alloc(cookie, size, &phys, &dva);
+		if (ret)
+			goto failed;
+		/* Never publish malformed allocator output to the firmware. */
+		if (!phys || ((phys | dva) & (DCP_M4_MEMORY_PAGE - 1)) ||
+		    phys >= (1ULL << 42) || size > (1ULL << 42) - phys ||
+		    dva < 0x10000000000ULL || dva >= 0x11000000000ULL ||
+		    size > 0x11000000000ULL - dva) {
+			ret = -ERANGE;
+			goto failed;
+		}
+		for (unsigned int i = 0; i < memory->count; i++) {
+			object = &memory->object[i];
+			if ((dva < object->dva + object->size && object->dva < dva + size) ||
+			    (phys < object->phys + object->size && object->phys < phys + size)) {
+				ret = -EEXIST;
+				goto failed;
+			}
+		}
+		object = &memory->object[memory->count++];
+		*object = (struct dcp_m4_memory_object){ .phys = phys, .dva = dva, .size = size };
+		memory->bytes += size;
+		put_unaligned_le64(phys, out);
+		put_unaligned_le64(dva, out + 8);
+		put_unaligned_le64(size, out + 16);
+		put_unaligned_le32(memory->count, out + 24);
+		return 0;
+	}
+	if (method != 201 && method != 454) {
+		ret = -EOPNOTSUPP;
+		goto failed;
+	}
+	id = method == 201 ? get_unaligned_le64(in) : get_unaligned_le32(in);
+	if (!id || id > memory->count || (method == 201 && get_unaligned_le32(in + 8) != 1))
+		goto failed;
+	object = &memory->object[id - 1];
+	if (object->retired)
+		goto failed;
+	if (method == 454) {
+		/* No fence exists: retain backing, both translations and the ID. */
+		object->retired = true;
+		put_unaligned_le32(1, out);
+		return 0;
+	}
+	if (object->mapped)
+		goto failed;
+	if (!ops->map) {
+		ret = -EOPNOTSUPP;
+		goto failed;
+	}
+	ret = ops->map(cookie, object->phys, object->dva, object->size);
+	if (ret)
+		goto failed;
+	object->mapped = true;
+	put_unaligned_le32(id, out);
+	put_unaligned_le64(object->dva, out + 4);
+	put_unaligned_le32(0, out + 12);
+	return 0;
+failed:
+	memory->failed = true;
+	return ret < 0 ? ret : -EPROTO;
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-profile.h b/drivers/gpu/drm/apple/dcp-m4-profile.h
new file mode 100644
index 0000000000..a7a91c1a4f
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-profile.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_DCP_M4_PROFILE_H
+#define APPLE_DCP_M4_PROFILE_H
+
+#include <linux/types.h>
+
+/* Firmware 26.6.2 internal-panel ABI, qualified for the T8132/J713 handoff. */
+struct dcp_m4_profile {
+	const char *name;
+	u32 panel_width, panel_height;
+	u32 boot_stride;		/* D101: inherited framebuffer stride */
+	u32 swap_size;			/* A407 input */
+	u32 swap_surface;		/* plane-0 surface */
+	u32 swap_dva;			/* plane-0 surface DVA */
+	u32 swap_nullable;		/* ten nullable surface bytes */
+	u32 swap_tail;			/* final two bytes */
+	u32 swap_nits;			/* binary64 brightness */
+	u32 disabled_color;		/* background with no surface */
+	u16 done_method;		/* swap completion callback */
+	u32 done_size;
+	u16 open_method;		/* first client open */
+	u32 brightness_max, brightness_default;
+	u32 width_mm, height_mm;
+};
+
+static const struct dcp_m4_profile dcp_m4_profile_j713 = {
+	.name = "J713",
+	.panel_width = 2560, .panel_height = 1664, .boot_stride = 10240,
+	.swap_size = 0x1bd8, .swap_surface = 0x588, .swap_dva = 0xe38,
+	.swap_nullable = 0x1bcb, .swap_tail = 0x1bd6, .swap_nits = 0x35e,
+	.disabled_color = 0xff000000,
+	.done_method = 590, .done_size = 0x730, .open_method = 457,
+	.brightness_max = 500, .brightness_default = 120,
+	.width_mm = 0, .height_mm = 0,
+};
+
+/* This generation backend admits one qualified internal-panel ABI. */
+static const struct dcp_m4_profile *const dcp_m4_pf = &dcp_m4_profile_j713;
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-property.h b/drivers/gpu/drm/apple/dcp-m4-property.h
new file mode 100644
index 0000000000..8f43ea3006
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-property.h
@@ -0,0 +1,253 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_DCP_M4_PROPERTY_H
+#define APPLE_DCP_M4_PROPERTY_H
+
+#include <linux/errno.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+
+#define DCP_M4_SCALARS 256
+#define DCP_M4_RAW_PROPERTIES 32
+#define DCP_M4_RAW_LIMIT (1U << 20)
+#define DCP_M4_RAW_TOTAL (8U << 20)
+
+struct dcp_m4_scalar_property {
+	char name[64];
+	u32 service;
+	u64 value;
+	bool used;
+};
+
+struct dcp_m4_raw_property {
+	char name[64];
+	u32 service;
+	u32 size;
+	void *data;
+	bool used;
+};
+
+/* Zero-initialize in heap storage; one serialized callback owner only. */
+struct dcp_m4_properties {
+	struct dcp_m4_scalar_property scalar[DCP_M4_SCALARS];
+	struct dcp_m4_raw_property raw[DCP_M4_RAW_PROPERTIES];
+	void *chunk;
+	u32 raw_bytes;
+	u32 chunk_size;
+	u32 chunk_filled;
+	bool chunk_active;
+};
+
+static inline int dcp_m4_property_name(const void *name)
+{
+	return memchr(name, 0, 64) ? 0 : -EINVAL;
+}
+
+static inline int dcp_m4_scalar_slot(struct dcp_m4_properties *props, u32 service,
+				   const char *name, bool create)
+{
+	int free_slot = -ENOSPC;
+
+	for (unsigned int i = 0; i < DCP_M4_SCALARS; i++) {
+		if (props->scalar[i].used) {
+			if (props->scalar[i].service == service && !strcmp(props->scalar[i].name, name))
+				return i;
+		} else if (free_slot < 0) {
+			free_slot = i;
+		}
+	}
+	return create ? free_slot : -ENOENT;
+}
+
+static inline int dcp_m4_raw_slot(struct dcp_m4_properties *props, u32 service,
+				const char *name, bool create)
+{
+	int free_slot = -ENOSPC;
+
+	for (unsigned int i = 0; i < DCP_M4_RAW_PROPERTIES; i++) {
+		if (props->raw[i].used) {
+			if (props->raw[i].service == service && !strcmp(props->raw[i].name, name))
+				return i;
+		} else if (free_slot < 0) {
+			free_slot = i;
+		}
+	}
+	return create ? free_slot : -ENOENT;
+}
+
+static inline int dcp_m4_scalar_set(struct dcp_m4_properties *props, u32 service,
+				  const char *name, u64 value)
+{
+	int slot = dcp_m4_scalar_slot(props, service, name, true);
+	struct dcp_m4_scalar_property *property;
+
+	if (slot < 0)
+		return slot;
+	property = &props->scalar[slot];
+	strscpy(property->name, name, sizeof(property->name));
+	property->service = service;
+	property->value = value;
+	property->used = true;
+	return 0;
+}
+
+static inline int dcp_m4_raw_set(struct dcp_m4_properties *props, u32 service,
+			       const char *name, const void *data, u32 size, bool take_chunk)
+{
+	int slot = dcp_m4_raw_slot(props, service, name, true);
+	struct dcp_m4_raw_property *property;
+	void *copy = NULL;
+
+	if (slot < 0)
+		return slot;
+	if (size > DCP_M4_RAW_LIMIT || props->raw_bytes > DCP_M4_RAW_TOTAL - props->chunk_size)
+		return -E2BIG;
+	/* Include old values and the in-progress chunk in the allocation budget. */
+	if (!take_chunk && size > DCP_M4_RAW_TOTAL - props->raw_bytes - props->chunk_size)
+		return -ENOSPC;
+	if (take_chunk) {
+		if (!props->chunk_active || props->chunk_filled != props->chunk_size ||
+		    size != props->chunk_size || data != props->chunk)
+			return -EINVAL;
+		copy = props->chunk;
+	} else if (size) {
+		copy = kvmalloc(size, GFP_KERNEL);
+		if (!copy)
+			return -ENOMEM;
+		memcpy(copy, data, size);
+	}
+	property = &props->raw[slot];
+	if (property->used) {
+		props->raw_bytes -= property->size;
+		kvfree(property->data);
+	}
+	strscpy(property->name, name, sizeof(property->name));
+	property->service = service;
+	property->size = size;
+	property->data = copy;
+	property->used = true;
+	props->raw_bytes += size;
+	if (take_chunk) {
+		props->chunk = NULL;
+		props->chunk_active = false;
+		props->chunk_size = props->chunk_filled = 0;
+	}
+	return 0;
+}
+
+/* Only the exact-shape-validated callback dispatcher may call this hook. */
+static inline int dcp_m4_property_callback(void *cookie, unsigned int method,
+					 const void *input, void *output)
+{
+	struct dcp_m4_properties *props = cookie;
+	const u8 *in = input;
+	u8 *out = output;
+	const char *name;
+	u32 service = 0, offset = 0, size;
+	int slot, ret;
+
+	if (method == 127) {
+		size = get_unaligned_le32(in);
+		if (!size || size > DCP_M4_RAW_LIMIT + 1 || props->chunk_active)
+			return -EINVAL;
+		size--;
+		if (size > DCP_M4_RAW_TOTAL - props->raw_bytes)
+			return -ENOSPC;
+		props->chunk = size ? kvmalloc(size, GFP_KERNEL) : NULL;
+		if (size && !props->chunk)
+			return -ENOMEM;
+		props->chunk_size = size;
+		props->chunk_filled = 0;
+		props->chunk_active = true;
+		put_unaligned_le32(1, out);
+		return 0;
+	}
+	if (method == 128) {
+		offset = get_unaligned_le32(in + 4096);
+		size = get_unaligned_le32(in + 4100);
+		if (!props->chunk_active || size > 4096 || offset != props->chunk_filled ||
+		    size > props->chunk_size - props->chunk_filled)
+			return -EINVAL;
+		if (size)
+			memcpy((u8 *)props->chunk + offset, in, size);
+		props->chunk_filled += size;
+		put_unaligned_le32(1, out);
+		return 0;
+	}
+	if (method == 400 || method == 401 || method == 413 || method == 414 || method == 415) {
+		service = get_unaligned_le32(in);
+		offset = 4;
+	}
+	name = (const char *)in + offset;
+	if (dcp_m4_property_name(name))
+		return -EINVAL;
+	switch (method) {
+	case 107:
+		slot = dcp_m4_scalar_slot(props, 0, name, false);
+		if (slot >= 0)
+			props->scalar[slot].used = false;
+		return 0;
+	case 401:
+		slot = dcp_m4_scalar_slot(props, service, name, false);
+		if (slot >= 0) {
+			put_unaligned_le64(props->scalar[slot].value, out);
+			out[8] = 1;
+		}
+		return 0;
+	case 400:
+		if (in[72] & 1)
+			return -EINVAL;
+		slot = dcp_m4_raw_slot(props, service, name, false);
+		if (slot >= 0) {
+			size = props->raw[slot].size;
+			if (size > 0xc00 || size > get_unaligned_le32(in + 68))
+				return -EMSGSIZE;
+			if (size)
+				memcpy(out, props->raw[slot].data, size);
+			put_unaligned_le32(size, out + 0xc00);
+		}
+		return 0;
+	case 563: case 414:
+		ret = (in[offset + 72] & 1) ? 0 :
+			dcp_m4_scalar_set(props, service, name, get_unaligned_le64(in + offset + 64));
+		break;
+	case 565: case 415:
+		ret = (in[offset + 68] & 1) ? 0 :
+			dcp_m4_scalar_set(props, service, name, get_unaligned_le32(in + offset + 64));
+		break;
+	case 102: case 104:
+		return dcp_m4_scalar_set(props, 0, name,
+			method == 104 ? !!in[64] : get_unaligned_le32(in + 64));
+	case 413: case 552: case 561:
+		ret = (in[offset + 4160] & 1) ? 0 :
+			dcp_m4_raw_set(props, service, name, in + offset + 64, 4096, false);
+		break;
+	case 567:
+		size = strnlen((const char *)in + 64, 64);
+		if (size == 64)
+			return -EINVAL;
+		ret = dcp_m4_raw_set(props, 0, name, in + 64, size, false);
+		break;
+	case 129:
+		ret = dcp_m4_raw_set(props, 0, name, props->chunk, props->chunk_size, true);
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	if (ret)
+		return ret;
+	put_unaligned_le32(1, out);
+	return 0;
+}
+
+/* Host-only property storage: never DMA buffers or live DCP session teardown. */
+static inline void dcp_m4_properties_destroy(struct dcp_m4_properties *props)
+{
+	for (unsigned int i = 0; i < DCP_M4_RAW_PROPERTIES; i++)
+		kvfree(props->raw[i].data);
+	kvfree(props->chunk);
+	memset(props, 0, sizeof(*props));
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-protocol.h b/drivers/gpu/drm/apple/dcp-m4-protocol.h
new file mode 100644
index 0000000000..6fccff5625
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-protocol.h
@@ -0,0 +1,210 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_DCP_M4_PROTOCOL_H
+#define APPLE_DCP_M4_PROTOCOL_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+#include "dcp-m4-profile.h"
+
+/* J713 firmware 81BAF476-679D-3CC0-8C6A-E6B6FA659D5E only. */
+#define DCP_M4_RPC_SIZE		0xc0000U
+#define DCP_M4_STREAM_SIZE	0x8000U
+#define DCP_M4_ALIGNMENT		64U
+#define DCP_M4_READY_HASH		0x45bc9ef4U
+#define DCP_M4_PACKET_HEADER	12U
+#define DCP_M4_ENDPOINT		0x37U
+
+struct dcp_m4_packet {
+	u32 tag;
+	u32 input_size;
+	u32 output_size;
+	u16 offset;
+	u16 length;
+	u8 stream;
+	bool remote;
+	bool reply;
+	bool callback_flag;
+};
+
+static inline int dcp_m4_init_word(u64 address, u64 *word)
+{
+	if (!address || address >> 48 || address % DCP_M4_ALIGNMENT)
+		return -EINVAL;
+	*word = (address << 16) | 0x40;
+	return 0;
+}
+
+static inline bool dcp_m4_ready(u64 word)
+{
+	/* Firmware sets the remote flag; it is not part of the identity. */
+	return (word & 0xfeff) == 1 &&
+		((word >> 16) & 0xffffffffULL) == DCP_M4_READY_HASH &&
+		(word >> 48) == DCP_M4_ALIGNMENT;
+}
+
+/* Return zero for firmware-init, one for a fresh READY, or a protocol error. */
+static inline int dcp_m4_ready_notification(u64 word, bool init_sent, u64 previous)
+{
+	if (previous)
+		return -EPROTO;
+	if (!(word & 0xc3))
+		return 0;
+	return init_sent && dcp_m4_ready(word) ? 1 : -EPROTO;
+}
+
+/* This profile admits stream zero only, not the older context-ID encoding. */
+static inline int dcp_m4_decode_word_ext(u64 word, struct dcp_m4_packet *packet);
+
+static inline int dcp_m4_decode_word(u64 word, struct dcp_m4_packet *packet)
+{
+	u16 control = word;
+
+	u16 offset = word >> 16;
+	u16 length = word >> 32;
+
+	if (word >> 48 || (control & ~0x342U) || (control & 3) != 2)
+		return -EPROTO;
+	/* Qualified only on incoming remote-1 callbacks, never AP replies. */
+	if ((control & 0x200) && control != 0x302)
+		return -EPROTO;
+	/* Replies carry routing only; output remains in the outstanding AP packet. */
+	if (control & 0x40) {
+		if (offset || length)
+			return -EPROTO;
+	} else if (offset % DCP_M4_ALIGNMENT || offset >= DCP_M4_STREAM_SIZE ||
+		   length < DCP_M4_PACKET_HEADER ||
+		   length > DCP_M4_STREAM_SIZE - offset) {
+		return -EMSGSIZE;
+	}
+	*packet = (struct dcp_m4_packet) {
+		.offset = offset,
+		.length = length,
+		.remote = !!(control & 0x100),
+		.reply = !!(control & 0x40),
+		.callback_flag = !!(control & 0x200),
+	};
+	return 0;
+}
+
+/*
+ * External (DCPEXT) profile: incoming callbacks may use streams 0..3 and any
+ * remote/bit-9 route; AP replies stay on stream 0 and carry routing only.
+ */
+static inline int dcp_m4_decode_word_ext(u64 word, struct dcp_m4_packet *packet)
+{
+	u16 control = word;
+	u16 offset = word >> 16;
+	u16 length = word >> 32;
+	u8 stream = control >> 10;
+
+	if (word >> 48 || (control & 0x00bc) || (control & 3) != 2 || stream >= 4)
+		return -EPROTO;
+	if (control & 0x40) {
+		if (offset || length || stream || (control & 0x200))
+			return -EPROTO;
+	} else if (offset % DCP_M4_ALIGNMENT || offset >= DCP_M4_STREAM_SIZE ||
+		   length < DCP_M4_PACKET_HEADER ||
+		   length > DCP_M4_STREAM_SIZE - offset) {
+		return -EMSGSIZE;
+	}
+	*packet = (struct dcp_m4_packet) {
+		.offset = offset,
+		.length = length,
+		.stream = stream,
+		.remote = !!(control & 0x100),
+		.reply = !!(control & 0x40),
+		.callback_flag = !!(control & 0x200),
+	};
+	return 0;
+}
+
+/*
+ * Replies require their pending request record, not a new packet location.
+ * Only callbacks may name a nonzero stream (external profile); the internal
+ * decoder never produces one.
+ */
+static inline int dcp_m4_packet_offset(const struct dcp_m4_packet *packet, bool callback)
+{
+	unsigned int base;
+
+	if (packet->reply || (callback ? packet->stream >= 4 : packet->stream) ||
+	    (packet->callback_flag && (!callback || !packet->remote)) ||
+	    packet->offset % DCP_M4_ALIGNMENT ||
+	    packet->offset >= DCP_M4_STREAM_SIZE || packet->length < DCP_M4_PACKET_HEADER ||
+	    packet->length > DCP_M4_STREAM_SIZE - packet->offset)
+		return -EINVAL;
+	base = callback ? (packet->remote ? 0x40000 : 0x60000) :
+			  (packet->remote ? 0x20000 : 0);
+	return base + packet->stream * DCP_M4_STREAM_SIZE + packet->offset;
+}
+
+static inline int dcp_m4_callback_ack(const struct dcp_m4_packet *packet, u64 *word)
+{
+	if (dcp_m4_packet_offset(packet, true) < 0)
+		return -EINVAL;
+	/* Preserve the incoming route: stream, remote and bit 9. */
+	*word = 0x42 | (packet->remote ? 0x100 : 0) | (packet->callback_flag ? 0x200 : 0) |
+		((u64)packet->stream << 10);
+	return 0;
+}
+
+static inline int dcp_m4_nested_offset(const struct dcp_m4_packet *outer,
+				       bool remote, u16 length, u16 *offset)
+{
+	unsigned int next = 0;
+
+	if (outer) {
+		if (dcp_m4_packet_offset(outer, false) < 0)
+			return -EINVAL;
+		if (outer->remote == remote)
+			next = (outer->offset + outer->length + 63U) & ~63U;
+	}
+	if (length < DCP_M4_PACKET_HEADER || next >= DCP_M4_STREAM_SIZE ||
+	    length > DCP_M4_STREAM_SIZE - next)
+		return -EMSGSIZE;
+	*offset = next;
+	return 0;
+}
+
+/* Validate lengths before exposing either input or output to a handler. */
+static inline int dcp_m4_decode_packet(const void *data, size_t available,
+				       struct dcp_m4_packet *packet)
+{
+	const u8 *bytes = data;
+	u32 input, output, payload;
+	unsigned int i;
+
+	if (available < DCP_M4_PACKET_HEADER || available != packet->length)
+		return -EMSGSIZE;
+	input = get_unaligned_le32(bytes + 4);
+	output = get_unaligned_le32(bytes + 8);
+	payload = packet->length - DCP_M4_PACKET_HEADER;
+	if (input > payload || output != payload - input)
+		return -EMSGSIZE;
+	/* Remote selects a stream half, not the transaction's direction. */
+	/* Method FourCC is reversed on the wire: A457 is bytes "754A".
+	 * Keep logical tags with A/D in the low byte for the ownership helpers.
+	 * Input/output lengths remain little-endian; they are not FourCCs.
+	 */
+	if (bytes[3] != 'A' && bytes[3] != 'D')
+		return -EPROTO;
+	for (i = 0; i < 3; i++)
+		if (bytes[i] < '0' || bytes[i] > '9')
+			return -EPROTO;
+	packet->tag = get_unaligned_be32(bytes);
+	packet->input_size = input;
+	packet->output_size = output;
+	return 0;
+}
+
+static inline int dcp_m4_packet_size(u32 input, u32 output, u16 *size)
+{
+	if (input > DCP_M4_STREAM_SIZE - DCP_M4_PACKET_HEADER ||
+	    output > DCP_M4_STREAM_SIZE - DCP_M4_PACKET_HEADER - input)
+		return -EMSGSIZE;
+	*size = DCP_M4_PACKET_HEADER + input + output;
+	return 0;
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-timing.h b/drivers/gpu/drm/apple/dcp-m4-timing.h
new file mode 100644
index 0000000000..e85908b659
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-timing.h
@@ -0,0 +1,223 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_DCP_M4_TIMING_H
+#define APPLE_DCP_M4_TIMING_H
+
+#include <linux/errno.h>
+#include <linux/limits.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+#include "dcp-m4-profile.h"
+
+#define DCP_M4_TIMING_TOKENS 2048
+
+/* The first qualified J713 physical mode, not a generic panel-mode fallback. */
+struct dcp_m4_timing {
+	u32 id, color_id;
+	u32 hdisplay, hsync_start, hsync_end, htotal;
+	u32 vdisplay, vsync_start, vsync_end, vtotal;
+	u32 clock_khz, refresh_16_16;
+};
+
+struct dcp_m4_timing_token {
+	u64 value;
+	u32 offset, count;
+	u16 next;
+	u8 type;
+};
+
+/* Heap storage, so a firmware dictionary cannot consume the kernel stack. */
+struct dcp_m4_timing_parser {
+	const u8 *data;
+	u32 size, pos, used;
+	struct dcp_m4_timing_token token[DCP_M4_TIMING_TOKENS];
+};
+
+static inline int dcp_m4_timing_object(struct dcp_m4_timing_parser *p, unsigned int depth)
+{
+	struct dcp_m4_timing_token *t;
+	u32 tag, bytes = 0, children = 0;
+	unsigned int index;
+
+	if (depth > 8 || p->used == DCP_M4_TIMING_TOKENS)
+		return -E2BIG;
+	p->pos = (p->pos + 3) & ~3U;
+	if (p->pos > p->size || p->size - p->pos < 4)
+		return -EINVAL;
+	tag = get_unaligned_le32(p->data + p->pos);
+	p->pos += 4;
+	if (tag & 0x60000000)
+		return -EINVAL;
+	index = p->used++;
+	t = &p->token[index];
+	t->type = (tag >> 24) & 31;
+	t->count = tag & 0xffffff;
+	t->offset = p->pos;
+	switch (t->type) {
+	case 1:
+		if (t->count > 128)
+			return -E2BIG;
+		children = t->count * 2;
+		break;
+	case 2:
+		if (t->count > 128)
+			return -E2BIG;
+		children = t->count;
+		break;
+	case 4:
+		if (t->count != 64)
+			return -EINVAL;
+		bytes = 8;
+		break;
+	case 9:
+	case 10:
+		if (t->count > (t->type == 9 ? 256 : 65536))
+			return -E2BIG;
+		bytes = t->count;
+		break;
+	case 11:
+		if (t->count > 1)
+			return -EINVAL;
+		t->value = t->count;
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (bytes > p->size - p->pos)
+		return -EINVAL;
+	if (t->type == 4)
+		t->value = get_unaligned_le64(p->data + p->pos);
+	p->pos += bytes;
+	/* Counts bound containers; bit 31 is not used to extend or shorten them. */
+	for (unsigned int i = 0; i < children; i++) {
+		unsigned int key = p->used;
+		int ret = dcp_m4_timing_object(p, depth + 1);
+
+		if (ret)
+			return ret;
+		if (t->type == 1 && !(i & 1)) {
+			const struct dcp_m4_timing_token *k = &p->token[key];
+
+			if (k->type != 9 || !k->count ||
+			    memchr(p->data + k->offset, 0, k->count))
+				return -EINVAL;
+			/* Reject duplicate keys, including recognized optional fields. */
+			for (unsigned int previous = index + 1; previous < key;
+			     previous = p->token[p->token[previous].next].next) {
+				const struct dcp_m4_timing_token *old = &p->token[previous];
+
+				if (old->count == k->count &&
+				    !memcmp(p->data + old->offset, p->data + k->offset, k->count))
+					return -EINVAL;
+			}
+		}
+	}
+	t->next = p->used;
+	return 0;
+}
+
+static inline int dcp_m4_timing_field(const struct dcp_m4_timing_parser *p,
+				     unsigned int dict, const char *name, unsigned int type)
+{
+	if (dict >= p->used || p->token[dict].type != 1)
+		return -EINVAL;
+	for (unsigned int key = dict + 1; key < p->token[dict].next;
+	     key = p->token[p->token[key].next].next) {
+		const struct dcp_m4_timing_token *k = &p->token[key];
+
+		if (k->count == strlen(name) && !memcmp(p->data + k->offset, name, k->count))
+			return p->token[k->next].type == type ? k->next : -EINVAL;
+	}
+	return -ENOENT;
+}
+
+static inline bool dcp_m4_timing_equals(const struct dcp_m4_timing_parser *p,
+				       unsigned int dict, const char *name,
+				       unsigned int type, u64 value)
+{
+	int index = dcp_m4_timing_field(p, dict, name, type);
+
+	return index >= 0 && p->token[index].value == value;
+}
+
+static inline int dcp_m4_timing_axis(const struct dcp_m4_timing_parser *p,
+				    unsigned int mode, const char *name, bool vertical)
+{
+	static const char * const fields[] = {
+		"Active", "Total", "FrontPorch", "SyncWidth", "BackPorch", "PreciseSyncRate",
+		"SyncPolarity", "PixelRepetition",
+	};
+	static const u32 values[2][8] = {
+		{ 2560, 2640, 8, 32, 40, 6877358, 1, 0 },
+		{ 1664, 1749, 33, 8, 44, 3932166, 1, 0 },
+	};
+	int axis = dcp_m4_timing_field(p, mode, name, 1);
+
+	if (axis < 0)
+		return axis;
+	for (unsigned int i = 0; i < 8; i++)
+		if (!dcp_m4_timing_equals(p, axis, fields[i], 4, values[vertical][i]))
+			return -EINVAL;
+	/* Exact qualified values also establish active + porches + sync == total. */
+	return 0;
+}
+
+static inline int dcp_m4_parse_timing(const void *data, size_t size, struct dcp_m4_timing *out)
+{
+	struct dcp_m4_timing_parser *p;
+	static const char * const color_fields[] = {
+		"ID", "Depth", "PixelEncoding", "DynamicRange", "EOTF", "Colorimetry", "SupportsDSC",
+	};
+	static const u32 color_values[] = { 1, 8, 0, 0, 0, 16, 0 };
+	int ret = -EINVAL, colors, color;
+
+	if (!data || !out || size < 4 || size > (1U << 20) || get_unaligned_le32(data) != 0xd3)
+		return -EINVAL;
+	p = kzalloc(sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->data = data;
+	p->size = size;
+	p->pos = 4;
+	ret = dcp_m4_timing_object(p, 0);
+	if (ret)
+		goto done;
+	ret = -EINVAL;
+	if (p->pos != size || p->token[0].type != 2 || p->token[0].count != 1 ||
+	    p->token[1].type != 1 ||
+	    !dcp_m4_timing_equals(p, 1, "ID", 4, 2) ||
+	    !dcp_m4_timing_equals(p, 1, "IsVirtual", 11, 0) ||
+	    !dcp_m4_timing_equals(p, 1, "IsPreferred", 11, 1) ||
+	    !dcp_m4_timing_equals(p, 1, "IsInterlaced", 11, 0) ||
+	    !dcp_m4_timing_equals(p, 1, "IsSplit", 11, 0) ||
+	    !dcp_m4_timing_equals(p, 1, "IsOverscanned", 11, 0) ||
+	    !dcp_m4_timing_equals(p, 1, "TimingType", 4, 3) ||
+	    !dcp_m4_timing_equals(p, 1, "MinimumVariableRefreshRate", 4, 0) ||
+	    !dcp_m4_timing_equals(p, 1, "MaximumVariableRefreshRate", 4, 0) ||
+	    dcp_m4_timing_axis(p, 1, "HorizontalAttributes", false) ||
+	    dcp_m4_timing_axis(p, 1, "VerticalAttributes", true))
+		goto done;
+	colors = dcp_m4_timing_field(p, 1, "ColorModes", 2);
+	if (colors < 0 || p->token[colors].count != 1)
+		goto done;
+	color = colors + 1;
+	if (!dcp_m4_timing_equals(p, color, "IsVirtual", 11, 0))
+		goto done;
+	for (unsigned int i = 0; i < 7; i++)
+		if (!dcp_m4_timing_equals(p, color, color_fields[i], 4, color_values[i]))
+			goto done;
+	*out = (struct dcp_m4_timing) {
+		.id = 2, .color_id = 1,
+		.hdisplay = 2560, .hsync_start = 2568, .hsync_end = 2600, .htotal = 2640,
+		.vdisplay = 1664, .vsync_start = 1697, .vsync_end = 1705, .vtotal = 1749,
+		.clock_khz = ((2640ULL * 1749 * 3932166 >> 16) + 500) / 1000,
+		.refresh_16_16 = 3932166,
+	};
+	ret = 0;
+done:
+	kfree(p);
+	return ret;
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-transaction.h b/drivers/gpu/drm/apple/dcp-m4-transaction.h
new file mode 100644
index 0000000000..7736a7a50d
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-transaction.h
@@ -0,0 +1,246 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_DCP_M4_TRANSACTION_H
+#define APPLE_DCP_M4_TRANSACTION_H
+
+#include <linux/string.h>
+#include "dcp-m4-protocol.h"
+
+/*
+ * Pure ownership core: one serialized owner, not called from the mailbox IRQ.
+ * The transport must queue notifications in order, synchronize DMA before reads
+ * and before sends, enforce deadlines, and latch queue/send/firmware failures.
+ * Buffers and state must remain pinned after failure; resetting this structure
+ * is not firmware recovery. No timeout, MMIO or mailbox operation happens here.
+ */
+#define DCP_M4_CALL_DEPTH 2
+#define DCP_M4_CALLBACK_DEPTH 8
+
+struct dcp_m4_call {
+	struct dcp_m4_packet packet;
+	unsigned int callbacks;
+};
+
+struct dcp_m4_callback {
+	struct dcp_m4_packet packet;
+	unsigned int calls;
+};
+
+struct dcp_m4_transaction {
+	struct dcp_m4_call call[DCP_M4_CALL_DEPTH];
+	struct dcp_m4_callback callback[DCP_M4_CALLBACK_DEPTH];
+	unsigned int calls;
+	unsigned int callbacks;
+	int error;
+	bool external;	/* DCPEXT profile: streams 0..3 and any flagged callback route */
+};
+
+static inline int dcp_m4_transaction_decode(const struct dcp_m4_transaction *state, u64 word,
+					    struct dcp_m4_packet *packet)
+{
+	return state->external ? dcp_m4_decode_word_ext(word, packet) :
+				 dcp_m4_decode_word(word, packet);
+}
+
+static inline int dcp_m4_transaction_fail(struct dcp_m4_transaction *state, int error)
+{
+	if (!state->error)
+		state->error = error < 0 ? error : -EPROTO;
+	return state->error;
+}
+
+static inline bool dcp_m4_tag(u32 tag, u8 direction)
+{
+	if ((tag & 0xff) != direction)
+		return false;
+	for (unsigned int shift = 8; shift < 32; shift += 8)
+		if (((tag >> shift) & 0xff) < '0' || ((tag >> shift) & 0xff) > '9')
+			return false;
+	return true;
+}
+
+/* Prepare only; the caller publishes with its DMA barrier and mailbox send. */
+static inline int dcp_m4_call_begin(struct dcp_m4_transaction *state, void *rpc,
+				  size_t rpc_size, u32 tag, bool remote,
+				  const void *input, u32 input_size, u32 output_size,
+				  u64 *word)
+{
+	struct dcp_m4_packet packet = {
+		.tag = tag, .input_size = input_size, .output_size = output_size,
+		.remote = remote,
+	};
+	const struct dcp_m4_packet *outer = NULL;
+	u8 *data;
+	int ret, offset;
+
+	if (state->error)
+		return state->error;
+	if (!rpc || rpc_size != DCP_M4_RPC_SIZE || !word || (input_size && !input) ||
+	    !dcp_m4_tag(tag, 'A') || state->calls >= DCP_M4_CALL_DEPTH)
+		return dcp_m4_transaction_fail(state, -EINVAL);
+	if (state->calls) {
+		struct dcp_m4_call *pending = &state->call[state->calls - 1];
+
+		/* Merely queuing a callback does not grant nested-call ownership. */
+		if (state->callbacks <= pending->callbacks)
+			return dcp_m4_transaction_fail(state, -EBUSY);
+		outer = &pending->packet;
+	}
+	if (state->callbacks &&
+	    remote != state->callback[state->callbacks - 1].packet.remote)
+		return dcp_m4_transaction_fail(state, -EPROTO);
+	/* AP calls use stream 0; a callback on another stream cannot recurse. */
+	if (state->callbacks && state->callback[state->callbacks - 1].packet.stream)
+		return dcp_m4_transaction_fail(state, -EOPNOTSUPP);
+	ret = dcp_m4_packet_size(input_size, output_size, &packet.length);
+	if (ret)
+		return dcp_m4_transaction_fail(state, ret);
+	ret = dcp_m4_nested_offset(outer, remote, packet.length, &packet.offset);
+	if (ret)
+		return dcp_m4_transaction_fail(state, ret);
+	offset = dcp_m4_packet_offset(&packet, false);
+	if (offset < 0)
+		return dcp_m4_transaction_fail(state, offset);
+	data = (u8 *)rpc + offset;
+	/* Check before writing the header: input must not alias this AP packet. */
+	if (input_size) {
+		unsigned long src = (unsigned long)input;
+		unsigned long dst = (unsigned long)data;
+
+		if (src > ~0UL - input_size ||
+		    (src < dst + packet.length && dst < src + input_size))
+			return dcp_m4_transaction_fail(state, -EINVAL);
+	}
+	put_unaligned_be32(tag, data);
+	put_unaligned_le32(input_size, data + 4);
+	put_unaligned_le32(output_size, data + 8);
+	if (input_size)
+		memcpy(data + DCP_M4_PACKET_HEADER, input, input_size);
+	memset(data + DCP_M4_PACKET_HEADER + input_size, 0, output_size);
+	state->call[state->calls++] = (struct dcp_m4_call) {
+		.packet = packet, .callbacks = state->callbacks,
+	};
+	*word = 2 | (remote ? 0x100 : 0) | ((u64)packet.offset << 16) |
+		((u64)packet.length << 32);
+	return 0;
+}
+
+/* Firmware may write output, but must not change the owned packet header. */
+static inline int dcp_m4_owned_packet(const void *rpc, const struct dcp_m4_packet *owned,
+				    bool callback)
+{
+	struct dcp_m4_packet actual = *owned;
+	int offset = dcp_m4_packet_offset(owned, callback);
+	int ret;
+
+	if (offset < 0)
+		return offset;
+	ret = dcp_m4_decode_packet((const u8 *)rpc + offset, owned->length, &actual);
+	if (ret)
+		return ret;
+	if (actual.tag != owned->tag || actual.input_size != owned->input_size ||
+	    actual.output_size != owned->output_size)
+		return -EPROTO;
+	return offset;
+}
+
+/* Accept only the innermost matching reply; output stays in its original AP slot. */
+static inline int dcp_m4_call_reply(struct dcp_m4_transaction *state, const void *rpc,
+				  size_t rpc_size, u64 word, void *output, u32 output_size)
+{
+	struct dcp_m4_packet reply;
+	struct dcp_m4_call *call;
+	int ret, offset;
+
+	if (state->error)
+		return state->error;
+	if (!rpc || rpc_size != DCP_M4_RPC_SIZE || !state->calls)
+		return dcp_m4_transaction_fail(state, -EPROTO);
+	ret = dcp_m4_transaction_decode(state, word, &reply);
+	if (ret)
+		return dcp_m4_transaction_fail(state, ret);
+	call = &state->call[state->calls - 1];
+	if (!reply.reply || reply.remote != call->packet.remote ||
+	    state->callbacks != call->callbacks || output_size != call->packet.output_size ||
+	    (output_size && !output))
+		return dcp_m4_transaction_fail(state, -EPROTO);
+	offset = dcp_m4_owned_packet(rpc, &call->packet, false);
+	if (offset < 0)
+		return dcp_m4_transaction_fail(state, offset);
+	if (output_size)
+		memcpy(output, (const u8 *)rpc + offset + DCP_M4_PACKET_HEADER +
+		       call->packet.input_size, output_size);
+	state->calls--;
+	return 0;
+}
+
+/* Called when the serialized owner begins handling a queued callback. */
+static inline int dcp_m4_callback_begin(struct dcp_m4_transaction *state, void *rpc,
+				      size_t rpc_size, u64 word, struct dcp_m4_packet *out)
+{
+	struct dcp_m4_packet packet;
+	u8 *data;
+	int ret, offset;
+
+	if (state->error)
+		return state->error;
+	if (!rpc || rpc_size != DCP_M4_RPC_SIZE || !out ||
+	    state->callbacks >= DCP_M4_CALLBACK_DEPTH)
+		return dcp_m4_transaction_fail(state, -EINVAL);
+	ret = dcp_m4_transaction_decode(state, word, &packet);
+	if (ret)
+		return dcp_m4_transaction_fail(state, ret);
+	offset = dcp_m4_packet_offset(&packet, true);
+	if (offset < 0)
+		return dcp_m4_transaction_fail(state, offset);
+	for (unsigned int i = 0; i < state->callbacks; i++) {
+		const struct dcp_m4_packet *active = &state->callback[i].packet;
+
+		if (active->remote == packet.remote && active->stream == packet.stream &&
+		    packet.offset < active->offset + active->length &&
+		    active->offset < packet.offset + packet.length)
+			return dcp_m4_transaction_fail(state, -EPROTO);
+	}
+	data = (u8 *)rpc + offset;
+	ret = dcp_m4_decode_packet(data, packet.length, &packet);
+	if (ret)
+		return dcp_m4_transaction_fail(state, ret);
+	if (!dcp_m4_tag(packet.tag, 'D'))
+		return dcp_m4_transaction_fail(state, -EPROTO);
+	/* Bit 9 only marks a new-stream notification route; it says nothing about
+	 * the method. Firmware sends any callback that way (e.g. the hourly D114
+	 * CoreAnalyticsSendEvent), so admission is left to the exact-shape
+	 * dispatch table, as for unflagged callbacks.
+	 */
+	memset(data + DCP_M4_PACKET_HEADER + packet.input_size, 0, packet.output_size);
+	state->callback[state->callbacks++] = (struct dcp_m4_callback) {
+		.packet = packet, .calls = state->calls,
+	};
+	*out = packet;
+	return 0;
+}
+
+/* Caller must publish handler output before sending the returned ACK word. */
+static inline int dcp_m4_callback_end(struct dcp_m4_transaction *state, const void *rpc,
+				    size_t rpc_size, u64 *word)
+{
+	struct dcp_m4_callback *callback;
+	int ret;
+
+	if (state->error)
+		return state->error;
+	if (!rpc || rpc_size != DCP_M4_RPC_SIZE || !word || !state->callbacks)
+		return dcp_m4_transaction_fail(state, -EPROTO);
+	callback = &state->callback[state->callbacks - 1];
+	if (state->calls != callback->calls)
+		return dcp_m4_transaction_fail(state, -EBUSY);
