From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 01:14:12 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: give the video encoder
 and scaler their PMP requests

In the same macOS 26B123 trace that showed the decoder's request, the
video encoder sets power-request bit 19 (VENC, position 19 in the ADT's
soc-device table) for each encode session and holds SOC-DEV-DVFS entry
417 at main level 2 (its VENC-AVE-VMAX source) while it runs. The MSR
scaler that converts the encoder's frames gets entry 419 at main level
2 for each job; its request bit, 21, is already set at idle there.
Linux asks for neither.

Add both as PMP report entries in the form T6000 uses: the encoder's
as its "perf" domain under ps_venc_sys, also keeping the SoC floor that
domain carried before as a second parent, and the scaler's as its
first domain under ps_msr. Like the decoder's, neither waits for an
acknowledgement.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 30 ++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index 10487f2140..0f5bc0ffc9 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -894,6 +894,8 @@ &dart_jpeg10 {
 };
 
 &scaler0 {
+	/* MSR's PMP performance request first (see &pmp_report). */
+	power-domains = <&pmp_report_msr>, <&ps_msr_ase_core>;
 	status = "okay";
 };
 
@@ -919,7 +921,7 @@ &dart_ave1 {
  */
 &ave {
 	power-domains = <&ps_venc_dma>, <&ps_venc_pipe4>, <&ps_venc_pipe5>,
-			<&ps_venc_me0>, <&ps_venc_me1>, <&pmc_soc_max>;
+			<&ps_venc_me0>, <&ps_venc_me1>, <&pmp_report_venc_sys>;
 	power-domain-names = "dma", "pipe4", "pipe5", "me0", "me1", "perf";
 	status = "okay";
 };
@@ -1454,6 +1456,32 @@ pmp_report_avd_sys: report@14 {
 		apple,dvfs = <418 2>;
 		apple,no-ack;
 	};
+
+	/*
+	 * Encode, same trace: bit 19 (VENC, table position 19) is set for each
+	 * encode session and SOC-DEV-DVFS entry 417 held at main level 2
+	 * (VENC-AVE-VMAX) while it runs. The scaler that converts the encoder's
+	 * frames, MSR (position 21), gets entry 419 at main level 2 per job.
+	 */
+	pmp_report_venc_sys: report@13 {
+		compatible = "apple,t6000-pmp-v2-report-entry";
+		reg = <0x13>;
+		label = "pmp-venc-sys";
+		#power-domain-cells = <0>;
+		power-domains = <&ps_venc_sys>, <&pmc_soc_max>;
+		apple,dvfs = <417 2>;
+		apple,no-ack;
+	};
+
+	pmp_report_msr: report@15 {
+		compatible = "apple,t6000-pmp-v2-report-entry";
+		reg = <0x15>;
+		label = "pmp-msr";
+		#power-domain-cells = <0>;
+		power-domains = <&ps_msr>;
+		apple,dvfs = <419 2>;
+		apple,no-ack;
+	};
 };
 
 &avd {
-- 
2.43.0

