From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Wed, 28 Oct 2026 23:44:57 +1100
Subject: [PATCH] soc: apple: aop: Drop the casts clippy rejects

The T6040 firmware segment check casts resource bounds and an IOVA
between types that are all u64 already, and one cast uses "as _".
With CLIPPY=1 these fail the build under -D warnings
(unnecessary_cast, as_underscore). Drop the casts.

No change in behaviour.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 22d9a21c028e5b2ea64c6c1af503b18eade67758)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/aop.rs | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/drivers/soc/apple/aop.rs b/drivers/soc/apple/aop.rs
index 1d8b58b2f4..992cc0902f 100644
--- a/drivers/soc/apple/aop.rs
+++ b/drivers/soc/apple/aop.rs
@@ -1645,8 +1645,8 @@ impl AopData {
         if res.end < res.start {
             return Err(EINVAL);
         }
-        let phys = res.start as u64;
-        let size = (res.end - res.start) as u64 + 1;
+        let phys = res.start;
+        let size = res.end - res.start + 1;
 
         let mut len: c_int = 0;
         // SAFETY: `region` is a valid node and the name is NUL-terminated.
@@ -1781,8 +1781,7 @@ impl AopData {
             while off < size {
                 // SAFETY: `domain` is the device's domain, live while it is
                 // bound.
-                let back =
-                    unsafe { bindings::iommu_iova_to_phys(domain, (iova + off) as _) } as u64;
+                let back = unsafe { bindings::iommu_iova_to_phys(domain, iova + off) };
                 if back != phys + off {
                     dev_err!(
                         dev,
