From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 9 Nov 2026 20:11:12 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: point dcpext0 at the
 J604's ATC2 PHY

In the 7.3 tree the label atcphy2 belongs to t8132-atc23.dtsi's
phy@412a90000, which is disabled on the J604. The J604 board file still
wrote <&atcphy2 6> as dcpext0's dp-phy, meaning its own
phy@413000000 (the node the /aliases atcphy2 entry and m1n1 name, and
the dp-phy of the 1.617 tree). dcpext0 then waited for a PHY provider
that never probes: "apple-dcp 286e00000.dcp: deferred probe timeout,
ignoring dependency" and "probe ... failed with error -110".

Label the J604 node and use it. With this, every phandle reference in
the J604 tree (phys, resets, power-domains, iommus, mboxes, clocks,
gpios, supplies, endpoints) resolves to the same node path as in the
1.617 tree, except the SMC mailbox, whose node is only renamed.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index 769b03e29f..cb97e5a52b 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -247,7 +247,7 @@
 		apple,smc-wake-sources = <0xa1 0xb7>;
 		status = "okay";
 	};
-	phy@413000000 {
+	j604_atcphy2: phy@413000000 {
 		compatible = "apple,t8132-atcphy";
 		reg = <0x04 0x13000000 0x00 0x24000>, <0x04 0x10000000 0x00 0x8000>, <0x04 0x10020000 0x00 0x4000>, <0x04 0x13044000 0x00 0x4000>, <0x04 0x13050000 0x00 0x4000>;
 		reg-names = "core", "axi2af", "lioa", "fabric", "common-config";
@@ -1146,7 +1146,8 @@
 	#address-cells = <0x02>;
 	#size-cells = <0x02>;
 	apple,connector-type = "HDMI-A";
-	phys = <&atcphy2 0x06>, <&atcphy0 0x06>, <&atcphy1 0x06>, <&atcphy3 0x06>;
+	/* dp-phy is the J604's own ATC2 PHY node, not t8132-atc23.dtsi's atcphy2. */
+	phys = <&j604_atcphy2 0x06>, <&atcphy0 0x06>, <&atcphy1 0x06>, <&atcphy3 0x06>;
 	phy-names = "dp-phy", "typec0", "typec1", "typec2";
 	mux-controls = <&atc2_dpxbar 0x00>, <&atc0_dpxbar 0x00>, <&atc1_dpxbar 0x00>, <&atc3_dpxbar 0x00>, <&atc0_dpxbar 0x01>, <&atc0_dpxbar 0x02>, <&atc1_dpxbar 0x01>, <&atc1_dpxbar 0x02>, <&atc3_dpxbar 0x01>, <&atc3_dpxbar 0x02>;
 	mux-control-names = "dp-xbar", "typec0", "typec1", "typec2", "typec0-dpin0", "typec0-dpin1", "typec1-dpin0", "typec1-dpin1", "typec2-dpin0", "typec2-dpin1";
