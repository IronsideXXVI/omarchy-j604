+    match = re.search(r"^static int " + name + r"\(", source, re.M)
+    assert match, name
+    start = source.index("{", match.start())
+    depth, end = 1, start + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[match.start():end] + "\n"
+
