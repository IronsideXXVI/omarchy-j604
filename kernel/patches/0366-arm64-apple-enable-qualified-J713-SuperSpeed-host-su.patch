 	core_clear32(atcphy, ATCPHY_POWER_CTRL, ATCPHY_POWER_PHY_RESET_N);
@@ -3482,6 +3604,209 @@ static void atcphy_dp_stop_t8122(struct apple_atcphy *atcphy)
 	}
