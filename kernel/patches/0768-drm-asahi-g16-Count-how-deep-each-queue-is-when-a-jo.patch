From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 04:41:18 +0000
Subject: [PATCH] drm/asahi: g16: Count how deep each queue is when a
 job arrives

The client keeps 64 submissions in flight and the scheduler admits 24
per queue, yet a command finds fewer than two others waiting when it
starts and the engine almost never refuses one at its depth caps. So
jobs reach the engine late, before publication.

Add two diagnostic histograms to the stats file: how many jobs of its
queue the engine already owned (published or pending) when a job
arrives from the scheduler, and the gap since the previous arrival in
10 us bins. Nothing else changes.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/engine.rs | 14 ++++++++++++++
 drivers/gpu/drm/asahi/g16/poll.rs   | 10 ++++++++++
 2 files changed, 24 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 08ca1d3aba..7733ff787a 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -424,6 +424,12 @@ pub(crate) struct Stats {
     /// Why ready jobs stayed unpublished: both flights published, a channel record unconsumed,
     /// no free slot.
     pub(crate) hold: [u64; 3],
+    /// `arrival:` per job the scheduler hands over: how many jobs of its queue the engine
+    /// already owned (published or pending, 15 = 15 or more), and the gap since the previous
+    /// arrival of any queue in 10 us bins (31 = 310 us or more). Diagnostic only.
+    pub(crate) arrive_owned: [u64; 16],
+    pub(crate) arrive_gap: [u64; 32],
+    pub(crate) arrive_last_ns: u64,
 }
 
 /// Host-side phase timers of publication and polling, on with `debug_flags` bit 49
@@ -907,6 +913,14 @@ pub(crate) fn enqueue(&mut self, job: Arc<Job>) -> Result {
                 .count() as u32;
         let i = q.owned_index.fetch_add(1, Ordering::Relaxed) as usize % q.owned.len();
         q.owned[i].store(owned.min(255), Ordering::Relaxed);
+        let now = now_ns();
+        let s = &mut self.engine.stats;
+        s.arrive_owned[(owned as usize).min(15)] += 1;
+        if s.arrive_last_ns != 0 {
+            let bin = (now.saturating_sub(s.arrive_last_ns) / 10_000).min(31) as usize;
+            s.arrive_gap[bin] += 1;
+        }
+        s.arrive_last_ns = now;
         Ok(())
     }
 
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 954b97d079..07eac2a0c8 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -1300,6 +1300,16 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
             s.dep_wait[0][1],
             s.dep_wait[0][2]
         )?;
+        write!(f, "arrival_owned:")?;
+        for n in s.arrive_owned.iter() {
+            write!(f, " {}", n)?;
+        }
+        writeln!(f)?;
+        write!(f, "arrival_gap_10us:")?;
+        for n in s.arrive_gap.iter() {
+            write!(f, " {}", n)?;
+        }
+        writeln!(f)?;
         writeln!(
             f,
             "recovery_tolerant: enabled {} recoveries {} tolerated {} aborted {}",
