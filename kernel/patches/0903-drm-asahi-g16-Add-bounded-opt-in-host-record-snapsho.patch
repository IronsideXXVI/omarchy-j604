index 0000000000..fc71738da6
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16/host_records.rs
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! Bounded host-built bytes, before publication; never reads firmware or user payload.
+//! Log loss is detected by the offline decoder (BEGIN, contiguous chunks, END).
+//! These are preparation images, not proof that a later publication succeeded.
+
+use core::sync::atomic::{AtomicUsize, Ordering};
+use kernel::prelude::*;
+
+static RECORDS: AtomicUsize = AtomicUsize::new(0);
+static BYTES: AtomicUsize = AtomicUsize::new(0);
+
+/// Disabled calls perform only the parameter check. No retained pointers or allocation.
+#[inline(always)]
+pub(crate) fn capture(kind: &str, va: u64, owner: u64, ordinal: u64, data: &[u8]) {
+    if !super::params::host_records() {
+        return;
+    }
+    capture_on(kind, va, owner, ordinal, data);
+}
+
+#[inline(never)]
+fn capture_on(kind: &str, va: u64, owner: u64, ordinal: u64, data: &[u8]) {
+    if data.len() > 0x1000 {
+        return;
+    }
+    let Ok(id) = RECORDS.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+        (n < 64).then_some(n + 1)
+    }) else {
+        return;
+    };
+    if BYTES.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+        n.checked_add(data.len()).filter(|v| *v <= 0x8000)
+    }).is_err() {
+        return;
+    }
+    pr_info!("G16RAW1 BEGIN {} {} {:#x} {:#x} {} {}\n",
+             id, kind, va, owner, ordinal, data.len());
+    for (i, chunk) in data.chunks(32).enumerate() {
+        pr_info!("G16RAW1 DATA {} {} {:02x?}\n", id, i * 32, chunk);
+    }
+    pr_info!("G16RAW1 END {}\n", id);
+}
