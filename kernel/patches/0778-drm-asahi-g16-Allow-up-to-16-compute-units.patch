From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 08:07:46 +0000
Subject: [PATCH] drm/asahi: g16: Allow up to 16 compute units

Every compute command in flight holds its own compute unit until the
host retires it, so g16_compute_units bounds how many compute commands
the firmware can hold. With the 12-unit limit a small-dispatch stream
drains the firmware queue every few commands: the time from a
command's end to the host seeing its completion is longer than the
work the remaining in-flight commands represent, so the next command
is published only after the queue has gone idle.

Place compute units 12 to 15 in the unused tails of the two qualified
render units' 128 MiB intervals, which their allocators leave free
beyond +0x2074000, and raise the cap to 16. The default stays at 12
units, so nothing changes unless g16_compute_units is set at module
load; g16_horizon then accepts up to 15.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/hw.rs     | 20 ++++++++++++++++----
 drivers/gpu/drm/asahi/g16/params.rs |  2 +-
 2 files changed, 17 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/hw.rs b/drivers/gpu/drm/asahi/g16/hw.rs
index 9e514a82b0..0aa494d17d 100644
--- a/drivers/gpu/drm/asahi/g16/hw.rs
+++ b/drivers/gpu/drm/asahi/g16/hw.rs
@@ -209,10 +209,16 @@ pub(crate) const fn compute_base(k: u64) -> u64 {
             0x7001000000 + k * 0x04000000
         } else if k < 8 {
             COMPUTE_HIGH_BASE + (k - 4) * COMPUTE_HIGH_STRIDE
-        } else {
+        } else if k < 12 {
             COMPUTE_EXTRA_BASE + (k - 8) * COMPUTE_HIGH_STRIDE
+        } else {
+            render_base((k - 12) / 2) + COMPUTE_GAP_OFF + ((k - 12) % 2) * COMPUTE_HIGH_STRIDE
         }
     }
+    /// Compute units 12.. (`g16_compute_units` > 12): two in the free tail of each qualified
+    /// render unit's 128 MiB interval (that unit's allocator ends at +0x2074000), at the same
+    /// 36 MiB stride.
+    pub(crate) const COMPUTE_GAP_OFF: u64 = 0x2400000;
     /// Compute units 8.. (`g16_compute_units` > 8): the free interval after render pass slot 1's
     /// tilemap and below the dynamic client range at 0x7040000000, at the same 36 MiB stride.
     pub(crate) const COMPUTE_EXTRA_BASE: u64 = 0x7037000000;
@@ -367,8 +373,9 @@ pub(crate) mod sizes {
     /// binding its own split UMA slot (compute 1 + k of the 32 per class of the 25G83 layout).
     /// Units 0 and 1 are the qualified ones; 2 and 3 take the next 64 MiB intervals below the
     /// render units; 4..7 the free interval below render pass slot 1; 8..11 the free interval
-    /// above pass slot 1's tilemap. How many a VM allocates is `g16_compute_units` (latched).
-    pub(crate) const COMPUTE_SLOTS: usize = 12;
+    /// above pass slot 1's tilemap; 12..15 the free tails of render units 0 and 1. How many a
+    /// VM allocates is `g16_compute_units` (latched, default 12).
+    pub(crate) const COMPUTE_SLOTS: usize = 16;
     const _: () = assert!(
         super::client::compute_context(3) + 0x40000 <= super::client::render_base(0)
             && super::client::TILEMAP + super::client::TILEMAP_SIZE
@@ -377,7 +384,12 @@ pub(crate) mod sizes {
                 <= super::client::FS_WORK_PAGE + super::client::WORK_STRIDE
             && super::client::TILEMAP + super::client::TILEMAP_SIZE + super::client::WORK_STRIDE
                 <= super::client::COMPUTE_EXTRA_BASE
-            && super::client::compute_context(COMPUTE_SLOTS as u64 - 1) + 0x40000 <= 0x7040000000
+            && super::client::compute_context(11) + 0x40000 <= 0x7040000000
+            && super::client::render_base(0) + 0x2074000 <= super::client::compute_base(12)
+            && super::client::compute_context(13) + 0x40000 <= super::client::render_base(1)
+            && super::client::render_base(1) + 0x2074000 <= super::client::compute_base(14)
+            && super::client::compute_context(15) + 0x40000 <= super::client::FS_WORK_PAGE
+            && COMPUTE_SLOTS == 16
             && super::client::WORK_PAGE + COMPUTE_SLOTS as u64 * super::client::CWORK_STRIDE
                 <= super::client::compute_base(0)
     );
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 5f6434e8f8..675c278e12 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -626,7 +626,7 @@ pub(crate) fn compute_units() -> usize {
     COMPUTE_UNITS_PARM,
     COMPUTE_UNITS,
     "g16_compute_units",
-    "G16: compute units per VM, one compute command in flight each (default 12; 2..12; 8 = before; 4 = k908; 9..12 = deeper compute queue, ~33 MiB per unit; latched at the engine start, set it as a module option)"
+    "G16: compute units per VM, one compute command in flight each (default 12; 2..16; 8 = before; 4 = k908; 9..16 = deeper compute queue, ~33 MiB per unit, 13..16 for g16_horizon up to 15; latched at the engine start, set it as a module option)"
 );
 
 live_u32_param!(
