From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 20:31:10 +0000
Subject: [PATCH] media: apple: isp: add switches for macOS's SIF
 format and MBNR chroma

macOS starts this camera's streams with two settings that differ from
ours: the sensor interface pixel format is format 1, type 0, compressed
(ours: format 3, type 1, uncompressed) and MBNR runs with chroma noise
reduction off (ours: on).

Add macos_sif_format and macos_mbnr_chroma, both off by default, so the
two can be compared on the same scene before either becomes the
default. Both are read at stream start.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-cam.c | 26 ++++++++++++++++++++--
 drivers/media/platform/apple/isp/isp-cmd.c |  9 ++++----
 drivers/media/platform/apple/isp/isp-cmd.h |  3 ++-
 3 files changed, 31 insertions(+), 7 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 4be4cb37b6..121a38d6e3 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -678,6 +678,24 @@ static void isp_ch_macos_session(struct apple_isp *isp, u32 ch)
 		dev_warn_once(isp->dev, "exposure bias refused: %d\n", err);
 }
 
+/*
+ * Two stream settings macOS sends this camera differently, kept off by
+ * default until a side-by-side capture shows which is better here:
+ * macos_sif_format sends the sensor interface format macOS uses (format 1,
+ * type 0, compressed) instead of format 3, type 1, uncompressed, and
+ * macos_mbnr_chroma turns chroma noise reduction off in MBNR as macOS
+ * does. Both are read at stream start.
+ */
+static bool macos_sif_format;
+module_param(macos_sif_format, bool, 0644);
+MODULE_PARM_DESC(macos_sif_format,
+		 "Send the sensor interface pixel format macOS sends (1, 0, compressed) (default: off)");
+
+static bool macos_mbnr_chroma;
+module_param(macos_mbnr_chroma, bool, 0644);
+MODULE_PARM_DESC(macos_mbnr_chroma,
+		 "Leave MBNR chroma noise reduction off, as macOS does (default: off)");
+
 /*
  * macOS sets this Mac's auto exposure stability thresholds to 16 and 8 for
  * every camera session; macos_ae_stability=N gives back 32 and 20.
@@ -1452,7 +1470,8 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	if (err)
 		return err;
 
-	err = isp_cmd_ch_mbnr_enable(isp, ch, 0, ISP_MBNR_MODE_ENABLE, 1);
+	err = isp_cmd_ch_mbnr_enable(isp, ch, 0, ISP_MBNR_MODE_ENABLE,
+				     !READ_ONCE(macos_mbnr_chroma));
 	if (err)
 		return err;
 
@@ -1486,7 +1505,10 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	isp_ch_macos_session(isp, ch);
 	isp_ch_macos_colour(isp, ch);
 
-	err = isp_cmd_ch_sif_pixel_format_set(isp, ch);
+	if (READ_ONCE(macos_sif_format))
+		err = isp_cmd_ch_sif_pixel_format_set(isp, ch, 1, 0, 1);
+	else
+		err = isp_cmd_ch_sif_pixel_format_set(isp, ch, 3, 1, 0);
 	if (err)
 		return err;
 
diff --git a/drivers/media/platform/apple/isp/isp-cmd.c b/drivers/media/platform/apple/isp/isp-cmd.c
index b3305985d9..7158221ff1 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.c
+++ b/drivers/media/platform/apple/isp/isp-cmd.c
@@ -508,14 +508,15 @@ int isp_cmd_ch_mbnr_enable(struct apple_isp *isp, u32 chan, u32 use_case,
 	return CISP_SEND_IN(isp, args);
 }
 
-int isp_cmd_ch_sif_pixel_format_set(struct apple_isp *isp, u32 chan)
+int isp_cmd_ch_sif_pixel_format_set(struct apple_isp *isp, u32 chan,
+				    u8 format, u8 type, u16 compress)
 {
 	struct cmd_ch_sif_pixel_format_set args = {
 		.opcode = CISP_OPCODE(CISP_CMD_CH_SIF_PIXEL_FORMAT_SET),
 		.chan = chan,
-		.format = 3,
-		.type = 1,
-		.compress = 0,
+		.format = format,
+		.type = type,
+		.compress = compress,
 		.unk_10 = 0,
 	};
 	return CISP_SEND_IN(isp, args);
diff --git a/drivers/media/platform/apple/isp/isp-cmd.h b/drivers/media/platform/apple/isp/isp-cmd.h
index b173b17b5d..193d087549 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.h
+++ b/drivers/media/platform/apple/isp/isp-cmd.h
@@ -584,7 +584,8 @@ int isp_cmd_ch_als_disable(struct apple_isp *isp, u32 chan);
 int isp_cmd_ch_cnr_start(struct apple_isp *isp, u32 chan);
 int isp_cmd_ch_mbnr_enable(struct apple_isp *isp, u32 chan, u32 use_case,
 			   u32 mode, u32 enable_chroma);
-int isp_cmd_ch_sif_pixel_format_set(struct apple_isp *isp, u32 chan);
+int isp_cmd_ch_sif_pixel_format_set(struct apple_isp *isp, u32 chan,
+				    u8 format, u8 type, u16 compress);
 int isp_cmd_ch_lpdp_hs_receiver_tuning_set(struct apple_isp *isp, u32 chan, u32 unk1, u32 unk2);
 
 int isp_cmd_ch_property_read(struct apple_isp *isp, u32 chan, u32 prop, u32 *val);
-- 
2.43.0

