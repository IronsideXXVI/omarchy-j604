diff --git a/drivers/power/reset/macsmc-reboot.c b/drivers/power/reset/macsmc-reboot.c
index 9da1bac1f4..939fdd4e32 100644
--- a/drivers/power/reset/macsmc-reboot.c
+++ b/drivers/power/reset/macsmc-reboot.c
@@ -12,6 +12,7 @@
 #include <linux/nvmem-consumer.h>
 #include <linux/platform_device.h>
 #include <linux/reboot.h>
+#include <linux/soc/apple/boot-crumb.h>
 #include <linux/slab.h>
 #include <linux/unaligned.h>
 #if IS_ENABLED(CONFIG_ARM64)
@@ -72,6 +73,7 @@ struct macsmc_reboot {
 	struct notifier_block reboot_notify;
 	struct nvmem_cell *pm_setting;
 	struct mutex pm_setting_lock;
+	struct nvmem_cell *boot_crumb;
 
 	union {
 		struct macsmc_reboot_nvmem nvm;
@@ -192,6 +194,14 @@ static int macsmc_reboot_notify(struct notifier_block *this, unsigned long actio
 	    nvmem_cell_set_u8(reboot->nvm.boot_stage, BOOT_STAGE_SHUTDOWN) < 0)
 		dev_err(reboot->dev, "Failed to write boot_stage\n");
 	macsmc_reboot_resume_exception(reboot, false);
+	/* A clean shutdown leaves no boot crumbs: stop them, then clear the record. */
+	if (reboot->boot_crumb) {
+		u8 zero[APPLE_CRUMB_RECORD_LEN] = {};
+
+		apple_boot_crumb_set_writer(NULL, NULL);
+		if (nvmem_cell_write(reboot->boot_crumb, zero, sizeof(zero)) < 0)
+			dev_err(reboot->dev, "Failed to clear the boot crumbs\n");
+	}
 
 	/*
 	 * Set the PMU flag to actually reboot into the off state.
@@ -398,6 +408,49 @@ static const struct attribute_group macsmc_reboot_group = {
 };
 __ATTRIBUTE_GROUPS(macsmc_reboot);
 
+static int macsmc_reboot_crumb_write(void *ctx, const u8 *rec, size_t len)
+{
+	struct macsmc_reboot *reboot = ctx;
+	u8 buf[APPLE_CRUMB_RECORD_LEN];
+	int ret;
+
+	if (len > sizeof(buf))
+		return -EINVAL;
+	memcpy(buf, rec, len);
+	ret = nvmem_cell_write(reboot->boot_crumb, buf, len);
+	return ret < 0 ? ret : 0;
+}
+
+static void macsmc_reboot_crumb_stop(void *data)
+{
+	apple_boot_crumb_set_writer(NULL, NULL);
+}
+
+/*
+ * Optional boot crumbs (boot-crumb.c): print the previous boot's record if it
+ * did not shut down cleanly, then keep this boot's record for the next one.
+ */
+static void macsmc_reboot_boot_crumb(struct macsmc_reboot *reboot)
+{
+	struct nvmem_cell *cell = devm_nvmem_cell_get(reboot->dev, "boot_crumb");
+	char line[256];
+	size_t len = 0;
+	u8 *rec;
+
+	if (IS_ERR(cell))
+		return;
+	rec = nvmem_cell_read(cell, &len);
+	if (!IS_ERR(rec)) {
+		if (apple_boot_crumb_decode(rec, len, line, sizeof(line)) > 0)
+			dev_warn(reboot->dev, "previous boot: crumb: %s\n", line);
+		kfree(rec);
+	}
+	if (devm_add_action_or_reset(reboot->dev, macsmc_reboot_crumb_stop, NULL))
+		return;
+	reboot->boot_crumb = cell;
+	apple_boot_crumb_set_writer(macsmc_reboot_crumb_write, reboot);
+}
+
