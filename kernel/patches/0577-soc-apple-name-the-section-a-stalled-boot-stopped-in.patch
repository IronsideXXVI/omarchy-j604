diff --git a/drivers/soc/apple/boot-crumb.c b/drivers/soc/apple/boot-crumb.c
new file mode 100644
index 0000000000..0cfa6232d9
--- /dev/null
+++ b/drivers/soc/apple/boot-crumb.c
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Apple boot crumbs.
+ *
+ * A stall early in a boot that stops every CPU (or the watchdog's keepalive
+ * thread) leaves nothing behind: the journal holds only what was synced, the
+ * ramoops region does not survive the watchdog reset, and the panel shows
+ * nothing. The PMU's scratch does survive. For the first 20 s of a boot, each
+ * instrumented section sets its "entered" bit there before it runs and its
+ * "left" bit after, and a 1 Hz heartbeat records the last uptime second seen,
+ * so the next boot (macsmc-reboot) can say which sections were entered and
+ * never left, and when the boot stopped.
+ *
+ * Record (APPLE_CRUMB_RECORD_LEN bytes): magic, a little-endian u32 mask with
+ * bit 2n = section n entered and bit 2n + 1 = section n left, and the
+ * heartbeat second (APPLE_CRUMB_BEAT_DONE once the window passed). A clean
+ * shutdown clears it. Nothing is written after the window.
+ */
+
+#include <linux/atomic.h>
+#include <linux/bits.h>
+#include <linux/export.h>
+#include <linux/kernel.h>
+#include <linux/ktime.h>
+#include <linux/math64.h>
+#include <linux/mutex.h>
+#include <linux/preempt.h>
+#include <linux/rcupdate.h>
+#include <linux/soc/apple/boot-crumb.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+#define APPLE_CRUMB_MAGIC	0xc5
+#define APPLE_CRUMB_BEAT_DONE	0xff
+#define APPLE_CRUMB_WINDOW_NS	(20 * NSEC_PER_SEC)
+
+static const char *const apple_crumb_names[APPLE_CRUMB_COUNT] = {
+	[APPLE_CRUMB_DCPEXT0] = "dcpext0-power",
+	[APPLE_CRUMB_DCPEXT1] = "dcpext1-power",
+	[APPLE_CRUMB_DCPEXT_DETECT] = "dcpext-detect",
+	[APPLE_CRUMB_DRM_OPEN] = "drm-open",
+	[APPLE_CRUMB_DRM_COMMIT] = "drm-commit",
+	[APPLE_CRUMB_GPU_START] = "gpu-start",
+	[APPLE_CRUMB_WIFI_PREINIT] = "wifi-preinit",
+	[APPLE_CRUMB_WIFI_COUNTRY] = "wifi-country",
+	[APPLE_CRUMB_SEP_ATTACH] = "sep-attach",
+	[APPLE_CRUMB_SEP_SENSOR] = "sep-sensor",
+	[APPLE_CRUMB_ANE_IDLE] = "ane-idle",
+	[APPLE_CRUMB_TAS_FAULT] = "tas2764-fault",
+	[APPLE_CRUMB_PMP_THERMAL] = "pmp-thermal",
+	[APPLE_CRUMB_AUDIO_OPEN] = "audio-open",
+	[APPLE_CRUMB_AVD_OPEN] = "avd-open",
+	[APPLE_CRUMB_PCIE_LINK] = "pcie-port-irq",
+};
+
+static atomic_t apple_crumb_mask = ATOMIC_INIT(0);
+static bool apple_crumb_closed;
+
+/* Under apple_crumb_lock. */
+static DEFINE_MUTEX(apple_crumb_lock);
+static apple_boot_crumb_writer_t apple_crumb_writer;
+static void *apple_crumb_ctx;
+static u8 apple_crumb_beat;
+static u32 apple_crumb_written_mask;
+static u8 apple_crumb_written_beat;
+static bool apple_crumb_written;
+
+static bool apple_crumb_window(void)
+{
+	return !READ_ONCE(apple_crumb_closed) && ktime_get_ns() < APPLE_CRUMB_WINDOW_NS;
+}
+
+static void apple_crumb_write_locked(void)
+{
+	u32 mask = (u32)atomic_read(&apple_crumb_mask);
+	u8 rec[APPLE_CRUMB_RECORD_LEN];
+
+	lockdep_assert_held(&apple_crumb_lock);
+	if (!apple_crumb_writer || apple_crumb_closed)
+		return;
+	if (apple_crumb_written && mask == apple_crumb_written_mask &&
+	    apple_crumb_beat == apple_crumb_written_beat)
+		return;
+	rec[0] = APPLE_CRUMB_MAGIC;
+	put_unaligned_le32(mask, &rec[1]);
+	rec[5] = apple_crumb_beat;
+	if (apple_crumb_writer(apple_crumb_ctx, rec, sizeof(rec)))
+		return;
+	apple_crumb_written = true;
+	apple_crumb_written_mask = mask;
+	apple_crumb_written_beat = apple_crumb_beat;
+}
+
+static void apple_crumb_flush(void)
+{
+	mutex_lock(&apple_crumb_lock);
+	apple_crumb_write_locked();
+	mutex_unlock(&apple_crumb_lock);
+}
+
+static void apple_crumb_work_fn(struct work_struct *work)
+{
+	apple_crumb_flush();
+}
+
+static DECLARE_WORK(apple_crumb_work, apple_crumb_work_fn);
+
+static void apple_crumb_beat_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(apple_crumb_beat_work, apple_crumb_beat_fn);
+
+static void apple_crumb_beat_fn(struct work_struct *work)
+{
+	u64 now = ktime_get_ns();
+
+	mutex_lock(&apple_crumb_lock);
+	if (now >= APPLE_CRUMB_WINDOW_NS) {
+		/* The window passed: say so once, then never write again. */
+		apple_crumb_beat = APPLE_CRUMB_BEAT_DONE;
+		apple_crumb_write_locked();
+		WRITE_ONCE(apple_crumb_closed, true);
+		mutex_unlock(&apple_crumb_lock);
+		return;
+	}
+	apple_crumb_beat = div_u64(now, NSEC_PER_SEC);
+	apple_crumb_write_locked();
+	mutex_unlock(&apple_crumb_lock);
+	queue_delayed_work(system_highpri_wq, &apple_crumb_beat_work, HZ);
+}
+
+static void apple_crumb_update(u32 set, u32 clear)
+{
+	int old, new;
+
+	if (!apple_crumb_window())
+		return;
+	old = atomic_read(&apple_crumb_mask);
+	do {
+		new = (int)(((u32)old | set) & ~clear);
+		if (new == old)
+			return;
+	} while (!atomic_try_cmpxchg(&apple_crumb_mask, &old, new));
+
+	/* Before a writer exists the mask is written when it registers. */
+	if (!READ_ONCE(apple_crumb_writer))
+		return;
+	/* The "entered" bit must reach the PMU before the section runs. */
+	if (preemptible() && !rcu_preempt_depth())
+		apple_crumb_flush();
+	else
+		queue_work(system_highpri_wq, &apple_crumb_work);
+}
+
+/**
+ * apple_boot_crumb_enter() - mark a section entered, before it runs
+ * @id: the section (enum apple_boot_crumb)
+ *
+ * Any context; only atomic callers have the write deferred. Does nothing
+ * after the first 20 s of the boot.
+ */
+void apple_boot_crumb_enter(unsigned int id)
+{
+	if (id < APPLE_CRUMB_COUNT)
+		apple_crumb_update(BIT(2 * id), BIT(2 * id + 1));
+}
+EXPORT_SYMBOL_GPL(apple_boot_crumb_enter);
+
+/**
+ * apple_boot_crumb_leave() - mark a section left, after it ran
+ * @id: the section (enum apple_boot_crumb)
+ */
+void apple_boot_crumb_leave(unsigned int id)
+{
+	if (id < APPLE_CRUMB_COUNT)
+		apple_crumb_update(BIT(2 * id + 1), 0);
+}
+EXPORT_SYMBOL_GPL(apple_boot_crumb_leave);
+
+/**
+ * apple_boot_crumb_set_writer() - set or clear the PMU writer
+ * @writer: writes a record to the PMU scratch, may sleep; NULL to stop
+ * @ctx: passed to @writer
+ *
+ * The owner of the PMU cells (macsmc-reboot) reads the previous boot's record
+ * first and then registers. Clearing it stops the heartbeat and every later
+ * write, for good: a clean shutdown clears the record after this.
+ */
+void apple_boot_crumb_set_writer(apple_boot_crumb_writer_t writer, void *ctx)
+{
+	if (!writer) {
+		mutex_lock(&apple_crumb_lock);
+		WRITE_ONCE(apple_crumb_closed, true);
+		WRITE_ONCE(apple_crumb_writer, NULL);
+		apple_crumb_ctx = NULL;
+		mutex_unlock(&apple_crumb_lock);
+		cancel_delayed_work_sync(&apple_crumb_beat_work);
+		cancel_work_sync(&apple_crumb_work);
+		return;
+	}
+	if (!apple_crumb_window())
+		return;
+	mutex_lock(&apple_crumb_lock);
+	apple_crumb_ctx = ctx;
+	WRITE_ONCE(apple_crumb_writer, writer);
+	apple_crumb_beat = div_u64(ktime_get_ns(), NSEC_PER_SEC);
+	apple_crumb_write_locked();
+	mutex_unlock(&apple_crumb_lock);
+	queue_delayed_work(system_highpri_wq, &apple_crumb_beat_work, HZ);
+}
+EXPORT_SYMBOL_GPL(apple_boot_crumb_set_writer);
+
+/**
+ * apple_boot_crumb_decode() - describe a record read from the PMU
+ * @rec: the record
+ * @len: its length
+ * @buf: output
+ * @size: size of @buf
+ *
+ * Return: the length written, or -ENOENT if @rec holds no record (cleared by
+ * a clean shutdown, or never written).
+ */
+int apple_boot_crumb_decode(const u8 *rec, size_t len, char *buf, size_t size)
+{
+	unsigned int i, inside = 0, done = 0;
+	int n;
+	u32 mask;
+
+	if (len < APPLE_CRUMB_RECORD_LEN || rec[0] != APPLE_CRUMB_MAGIC)
+		return -ENOENT;
+	mask = get_unaligned_le32(&rec[1]);
+	if (rec[5] == APPLE_CRUMB_BEAT_DONE)
+		n = scnprintf(buf, size, "heartbeat passed 20 s;");
+	else
+		n = scnprintf(buf, size, "last heartbeat %u s;", rec[5]);
+
+	n += scnprintf(buf + n, size - n, " entered, not left:");
+	for (i = 0; i < APPLE_CRUMB_COUNT; i++) {
+		if ((mask & BIT(2 * i)) && !(mask & BIT(2 * i + 1))) {
+			n += scnprintf(buf + n, size - n, " %s", apple_crumb_names[i]);
+			inside++;
+		}
+	}
+	if (!inside)
+		n += scnprintf(buf + n, size - n, " none");
+
+	n += scnprintf(buf + n, size - n, "; done:");
+	for (i = 0; i < APPLE_CRUMB_COUNT; i++) {
+		if ((mask & BIT(2 * i)) && (mask & BIT(2 * i + 1))) {
+			n += scnprintf(buf + n, size - n, " %s", apple_crumb_names[i]);
+			done++;
+		}
+	}
+	if (!done)
+		n += scnprintf(buf + n, size - n, " none");
+	return n;
+}
+EXPORT_SYMBOL_GPL(apple_boot_crumb_decode);
