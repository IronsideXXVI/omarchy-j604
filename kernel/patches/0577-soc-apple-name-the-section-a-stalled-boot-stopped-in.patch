diff --git a/drivers/gpu/drm/asahi/gpu.rs b/drivers/gpu/drm/asahi/gpu.rs
index 08634c365a..8c6a265036 100644
--- a/drivers/gpu/drm/asahi/gpu.rs
+++ b/drivers/gpu/drm/asahi/gpu.rs
@@ -1383,6 +1383,7 @@ pub(crate) fn run_job(&self, job: workqueue::JobSubmission::ver<'_>) -> Result {
     }
 
     pub(crate) fn start_op(self: &Arc<GpuManager::ver>) -> Result<OpGuard> {
+        let _crumb = BootCrumb::enter();
         if self.is_crashed() {
             return Err(ENODEV);
         }
@@ -1951,3 +1952,37 @@ fn end_op(&self) {
         unsafe { kernel::bindings::apple_pmp_agx_activity_end() };
     }
 }
+
+/// Boot crumb (drivers/soc/apple/boot-crumb.c): section 5 (GPU start_op, the
+/// first power-up included) is marked entered when this is made and left when it is dropped, so a stall
+/// inside it is named by the next boot.
+struct BootCrumb;
+
+#[cfg(CONFIG_APPLE_BOOT_CRUMB)]
+extern "C" {
+    fn apple_boot_crumb_enter(id: u32);
+    fn apple_boot_crumb_leave(id: u32);
+}
+
+impl BootCrumb {
+    const ID: u32 = 5;
+
+    fn enter() -> Self {
+        #[cfg(CONFIG_APPLE_BOOT_CRUMB)]
+        // SAFETY: A plain C call with an integer argument, valid in any context.
+        unsafe {
+            apple_boot_crumb_enter(Self::ID)
+        };
+        BootCrumb
+    }
+}
+
+impl Drop for BootCrumb {
+    fn drop(&mut self) {
+        #[cfg(CONFIG_APPLE_BOOT_CRUMB)]
+        // SAFETY: As in `BootCrumb::enter`.
+        unsafe {
+            apple_boot_crumb_leave(Self::ID)
+        };
+    }
+}
