diff --git a/include/linux/soc/apple/boot-crumb.h b/include/linux/soc/apple/boot-crumb.h
new file mode 100644
index 0000000000..4c7421d6a7
--- /dev/null
+++ b/include/linux/soc/apple/boot-crumb.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Apple boot crumbs: which early-boot sections a boot entered and did not
+ * leave, kept in PMU scratch, which survives a watchdog reset.
+ */
+#ifndef _LINUX_SOC_APPLE_BOOT_CRUMB_H
+#define _LINUX_SOC_APPLE_BOOT_CRUMB_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+/* Sections; the numbers are stored and also used by Rust callers. */
+enum apple_boot_crumb {
+	APPLE_CRUMB_DCPEXT0 = 0,	/* dcpext0 power-down/up */
+	APPLE_CRUMB_DCPEXT1 = 1,	/* dcpext1 power-down/up */
+	APPLE_CRUMB_DCPEXT_DETECT = 2,	/* connector detect on a dcpext */
+	APPLE_CRUMB_DRM_OPEN = 3,	/* appledrm open */
+	APPLE_CRUMB_DRM_COMMIT = 4,	/* appledrm atomic commit (modeset) */
+	APPLE_CRUMB_GPU_START = 5,	/* GPU start_op, first power-up incl. */
+	APPLE_CRUMB_WIFI_PREINIT = 6,	/* brcmfmac preinit commands */
+	APPLE_CRUMB_WIFI_COUNTRY = 7,	/* brcmfmac country update */
+	APPLE_CRUMB_SEP_ATTACH = 8,	/* SEP attach */
+	APPLE_CRUMB_SEP_SENSOR = 9,	/* SEP biometric sensor probe */
+	APPLE_CRUMB_ANE_IDLE = 10,	/* ANE idle power-down */
+	APPLE_CRUMB_TAS_FAULT = 11,	/* tas2764 fault handler */
+	APPLE_CRUMB_PMP_THERMAL = 12,	/* apple-pmp-thermal sample */
+	APPLE_CRUMB_AUDIO_OPEN = 13,	/* macaudio PCM open */
+	APPLE_CRUMB_AVD_OPEN = 14,	/* AVD open */
+	APPLE_CRUMB_PCIE_LINK = 15,	/* pcie-apple port interrupt */
+	APPLE_CRUMB_COUNT
+};
+
+/* The PMU scratch record: magic, entered/left mask (le32), heartbeat. */
+#define APPLE_CRUMB_RECORD_LEN	6
+
+/* Writes the record to the PMU; may sleep. Registered by macsmc-reboot. */
+typedef int (*apple_boot_crumb_writer_t)(void *ctx, const u8 *rec, size_t len);
+
+#if IS_ENABLED(CONFIG_APPLE_BOOT_CRUMB)
+void apple_boot_crumb_enter(unsigned int id);
+void apple_boot_crumb_leave(unsigned int id);
+void apple_boot_crumb_set_writer(apple_boot_crumb_writer_t writer, void *ctx);
+int apple_boot_crumb_decode(const u8 *rec, size_t len, char *buf, size_t size);
+#else
+static inline void apple_boot_crumb_enter(unsigned int id) { }
+static inline void apple_boot_crumb_leave(unsigned int id) { }
+static inline void apple_boot_crumb_set_writer(apple_boot_crumb_writer_t writer, void *ctx) { }
+static inline int apple_boot_crumb_decode(const u8 *rec, size_t len, char *buf, size_t size)
+{
+	return -ENODEV;
+}
+#endif
+
+#endif
