From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 02:20:26 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j604: Enable Wi-Fi and Bluetooth

The Wi-Fi/Bluetooth module of the MacBook Pro (14-inch, M4) sits on port 0
of the internal PCIe controller, as on the other T8132 machines. Describe
it the way the J773g does in this tree ("arm64: dts: apple: t8132-j773g:
Enable the SSD, Wi-Fi, Bluetooth and Ethernet" and "arm64: dts: apple:
t8132: Power the PCIe ports with pwren-gpios", Sean Dolbec): map the port's
requester IDs to stream 1 of its DART, power the module through the SMC
GPIO 0x13 as pwren-gpios, and give the endpoints fixed bus numbers so the
loader can fill in the MAC and Bluetooth addresses, the antenna SKU and
the calibration.

From the J604 Apple device tree (26B123 and 25G83 templates):
- port 0 is apcie/pci-bridge0, PERST# GPIO 163 and CLKREQ# GPIO 160, as
  t8132.dtsi already describes;
- /amfm function-reg_on is the pKW4 action on SMC key gP13, so pwren is
  SMC GPIO 0x13;
- /arm-io/wlan module-instance is "guam", hence brcm,board-type
  "apple,guam". The J604 macOS firmware set has guam images for
  BCM4388C2 only, hence the BCM4388 Wi-Fi and Bluetooth function IDs.

Port 1 is not wired. Port 2 (the SD card reader, pcie-sdreader with its
own power enable on gP19) stays disabled.

Testing: dtc and dtbs_check only.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 41 ++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 189c141064..c5092b7a77 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -22,7 +22,9 @@
 	model = "Apple MacBook Pro (14-inch, M4, 2024)";
 
 	aliases {
+		bluetooth0 = &bluetooth0;
 		keyboard = &keyboard;
+		wifi0 = &wifi0;
 	};
 
 	led-controller {
@@ -137,6 +139,45 @@
  * cannot keep the session, as for the J713.
  */
 
+/*
+ * Internal PCIe port 0: the Wi-Fi/Bluetooth module (BCM4388, Apple module
+ * "guam"). m1n1 powers it through the same SMC action as pwren-gpios and
+ * fills in the addresses, antenna SKU and calibration below. Port 1 is not
+ * wired; port 2 (the SD card reader) stays off.
+ */
+
+&pcie0_dart {
+	status = "okay"; /* DTV-PCIE-3..5 */
+};
+
+&pcie0 {
+	iommu-map = <0x100 &pcie0_dart 1 1>;
+	status = "okay"; /* DTV-PCIE-1, DTV-PCIE-2 */
+};
+
+&pcie0_port0 {
+	pwren-gpios = <&smc_gpio 0x13 GPIO_ACTIVE_HIGH>; /* DTV-PCIE-11 */
+	bus-range = <1 1>;
+	status = "okay"; /* DTV-PCIE-6, DTV-PCIE-7 */
+
+	wifi0: wifi@0,0 {
+		compatible = "pci14e4,4434"; /* DTV-WLAN-1 */
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+		/* To be filled by the loader */
+		local-mac-address = [00 00 00 00 00 00];
+		apple,antenna-sku = "XX";
+		brcm,board-type = "apple,guam"; /* DTV-WLAN-2 */
+	};
+
+	bluetooth0: bluetooth@0,1 {
+		compatible = "pci14e4,5f72"; /* DTV-WLAN-1 */
+		reg = <0x10100 0x0 0x0 0x0 0x0>;
+		/* To be filled by the loader */
+		local-bd-address = [00 00 00 00 00 00];
+		brcm,board-type = "apple,guam"; /* DTV-WLAN-2 */
+	};
+};
+
 &mtp {
 	status = "okay"; /* DTV-MTP-3..5 */
 };
