diff --git a/drivers/gpu/drm/asahi/g16/solo.rs b/drivers/gpu/drm/asahi/g16/solo.rs
new file mode 100644
index 0000000000..1622bf211d
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16/solo.rs
@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! `g16_submit_solo_us`: `g16_submit_defer`, `g16_submit_kick` and `g16_submit_defer_render`
+//! act only for a compute submission whose client is alone on the device.
+//!
+//! A client is one submitting queue ([`super::job::Job::queue`]): two processes are two
+//! clients, and so are two queues of one process. A submission is alone when every flight in
+//! the engine belongs to its queue and no other queue has submitted, published or retired work
+//! within the last W us. Otherwise it takes the old rule: queued only from 16 compute flights
+//! up, never kicked. Beside another client a kicked pass can take the firmware just before the
+//! other client's record lands, so the other client waits a pass: on 1.1093 a render at depth
+//! 1 beside compute at depth 4 paid 2.4 %, and compute at depth 1 beside compute at depth 8
+//! paid 2.7 %.
+//!
+//! [`Recent`] keeps the latest activity and the latest activity of a different queue, so the
+//! latest activity of every queue but one is known in O(1). The flights check rides on the walk
+//! the submission already makes to count compute flights. Core only, so the rules run as host
+//! tests.
+
+use core::sync::atomic::{AtomicU64, Ordering};
+
+/// The deferral of the old defaults: queued only from this many compute flights up.
+pub(crate) const OLD_DEFER: usize = 16;
+
+/// The submission's queue is alone: the words act as set.
+pub(crate) const ALONE: u8 = 0;
+/// A flight of another queue is out.
+pub(crate) const BUSY: u8 = 1;
+/// Another queue submitted, published or retired work within the window.
+pub(crate) const QUIET: u8 = 2;
+
+/// Counters: 0 submissions decided alone, 1 of those kicked, 2 refused because a flight of
+/// another queue was out, 3 refused inside the window.
+pub(crate) static N: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+
+/// The latest activity on the device, and the latest activity of a queue other than that
+/// one's. Queue 0 means none.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Recent {
+    last: (usize, u64),
+    other: (usize, u64),
+}
+
+impl Recent {
+    /// Records an activity of `queue` (non-zero) at `now` (ns).
+    pub(crate) fn note(&mut self, queue: usize, now: u64) {
+        if queue == 0 {
+            return;
+        }
+        if self.last.0 != queue && self.last.0 != 0 {
+            self.other = self.last;
+        }
+        self.last = (queue, now);
+    }
+
+    /// The time of the latest activity of any queue but `queue`, if there was one.
+    pub(crate) fn others(&self, queue: usize) -> Option<u64> {
+        if self.last.0 == 0 {
+            None
+        } else if self.last.0 != queue {
+            Some(self.last.1)
+        } else if self.other.0 != 0 {
+            Some(self.other.1)
+        } else {
+            None
+        }
+    }
+}
+
+/// The rule for one compute submission: off (`window_ns` 0) is always ALONE; otherwise BUSY
+/// while a flight of another queue is out, QUIET while another queue acted less than
+/// `window_ns` before `now`, ALONE after that.
+pub(crate) fn decide(window_ns: u64, now: u64, other_flight: bool, others: Option<u64>) -> u8 {
+    if window_ns == 0 {
+        ALONE
+    } else if other_flight {
+        BUSY
+    } else if matches!(others, Some(t) if now.saturating_sub(t) < window_ns) {
+        QUIET
+    } else {
+        ALONE
+    }
+}
+
+/// The deferral threshold and kick limit: as the words set them while alone, the old rule
+/// (16, never kicked) otherwise.
+pub(crate) fn limits(decision: u8, set: (usize, usize)) -> (usize, usize) {
+    if decision == ALONE {
+        set
+    } else {
+        (OLD_DEFER, 0)
+    }
+}
+
+/// The counter a decision adds to.
+pub(crate) const fn slot(decision: u8) -> usize {
+    match decision {
+        ALONE => 0,
+        BUSY => 2,
+        _ => 3,
+    }
+}
+
+/// Adds one to counter `i`.
+pub(crate) fn count(i: usize) {
+    if let Some(c) = N.get(i) {
+        c.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Reads counter `i`.
+pub(crate) fn get(i: usize) -> u64 {
+    N.get(i).map_or(0, |c| c.load(Ordering::Relaxed))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const US: u64 = 1000;
+
+    #[test]
+    fn off_is_always_alone() {
+        assert_eq!(decide(0, 10, true, Some(9)), ALONE);
+        assert_eq!(limits(decide(0, 10, true, Some(9)), (2, 16)), (2, 16));
+    }
+
+    #[test]
+    fn another_flight_or_recent_work_refuses() {
+        let w = 500 * US;
+        assert_eq!(decide(w, 1_000_000, true, None), BUSY);
+        assert_eq!(decide(w, 1_000_000, false, Some(1_000_000 - 499 * US)), QUIET);
+        assert_eq!(decide(w, 1_000_000, false, Some(1_000_000 - 500 * US)), ALONE);
+        assert_eq!(decide(w, 1_000_000, false, None), ALONE);
+        // A stamp at or after `now` is inside the window.
+        assert_eq!(decide(w, 1_000_000, false, Some(1_000_001)), QUIET);
+        assert_eq!(limits(BUSY, (2, 16)), (16, 0));
+        assert_eq!(limits(QUIET, (2, 16)), (16, 0));
+        assert_eq!(limits(ALONE, (2, 16)), (2, 16));
+        assert_eq!((slot(ALONE), slot(BUSY), slot(QUIET)), (0, 2, 3));
+    }
+
+    /// `others` equals the latest activity of a different queue in every sequence of up to
+    /// seven activities by three queues.
+    #[test]
+    fn recent_matches_the_history() {
+        for n in 0..=7u32 {
+            for code in 0..3u32.pow(n) {
+                let mut r = Recent::default();
+                let mut hist = [(0usize, 0u64); 7];
+                let mut c = code;
+                for i in 0..n as usize {
+                    let q = (c % 3) as usize + 1;
+                    c /= 3;
+                    let t = 10 * (i as u64 + 1);
+                    r.note(q, t);
+                    hist[i] = (q, t);
+                }
+                for q in 1..=4usize {
+                    let want = hist[..n as usize].iter().filter(|h| h.0 != q).map(|h| h.1).max();
+                    assert_eq!(r.others(q), want, "code {} n {} queue {}", code, n, q);
+                }
+            }
+        }
+    }
+
+    /// The two measured cases stay outside "alone": a shallow client that acts at least every
+    /// 420 us (compute at depth 1 beside compute at depth 8 read 419.88 us per command on
+    /// 1.1093) and whose command is out half of the time never leaves the deep client alone
+    /// with a window of 500 us; once it stops, the deep client is alone 500 us later.
+    #[test]
+    fn a_shallow_client_keeps_the_deep_one_out() {
+        let (deep, shallow, w) = (1usize, 2usize, 500 * US);
+        let mut r = Recent::default();
+        let mut alone = 0;
+        let mut t = 0u64;
+        for k in 0..1000u64 {
+            // The shallow client publishes at 420k us and retires 200 us later.
+            let pub_t = 420 * US * k;
+            let ret_t = pub_t + 200 * US;
+            while t < pub_t + 420 * US {
+                if t == pub_t {
+                    r.note(shallow, t);
+                }
+                if t == ret_t {
+                    r.note(shallow, t);
+                }
+                let out = t >= pub_t && t < ret_t;
+                r.note(deep, t);
+                if decide(w, t, out, r.others(deep)) == ALONE {
+                    alone += 1;
+                }
+                t += 10 * US;
+            }
+        }
+        assert_eq!(alone, 0);
+        // Its last activity was the retirement of its 1000th command.
+        let last = 420 * US * 999 + 200 * US;
+        assert_eq!(r.others(deep), Some(last));
+        assert_eq!(decide(w, last + 490 * US, false, r.others(deep)), QUIET);
+        assert_eq!(decide(w, last + 500 * US, false, r.others(deep)), ALONE);
+    }
+
+    #[test]
+    fn a_queue_never_refuses_itself() {
+        let mut r = Recent::default();
+        for i in 0..100u64 {
+            r.note(7, i * 13);
+            assert_eq!(r.others(7), None);
+            assert_eq!(decide(500 * US, i * 13, false, r.others(7)), ALONE);
+        }
+        r.note(0, 5000);
+        assert_eq!(r.others(7), None);
+    }
+}
