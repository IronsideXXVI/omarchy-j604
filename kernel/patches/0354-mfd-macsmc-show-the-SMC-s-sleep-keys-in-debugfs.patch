From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 07:57:51 +0000
Subject: [PATCH 354/358] mfd: macsmc: show the SMC's sleep keys in debugfs

The SMC keeps its own record of the sleeps it registers: CLSP and CLWK
stamp the last sleep and wake on its clock CLKU (in microseconds), CLBT
the AP's boot, MPPR counts the sleeps, and MBSE / MBSW are the sleep
command and wake reason keys. Measured on macOS (J604, 26B123, three
cycles), CLSP moves within 1 ms of the last AP step of every sleep, the
CLWK - CLSP span is the sleep's length, and MPPR goes up by one. Nothing
on our side has ever read them, so whether the SMC registers one of our
sleep attempts is unknown.

Add macsmc/sleep-keys to debugfs: root-only and read-only, it reads
those seven keys and prints each as name, type, size and the raw bytes,
the same form as a macOS key dump, so the same decoder reads both. Its
path only asks the key information and reads; it never writes a key.
The file is created once the SMC answers the key count, and removed with
the device.

Assisted-by: LLM
---
 drivers/mfd/macsmc.c | 57 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 57 insertions(+)

diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
index eb9e21600d..4d49a44a4a 100644
--- a/drivers/mfd/macsmc.c
+++ b/drivers/mfd/macsmc.c
@@ -8,6 +8,7 @@
 #include <kunit/static_stub.h>
 
 #include <linux/bitfield.h>
+#include <linux/debugfs.h>
 #include <linux/delay.h>
 #include <linux/device.h>
 #include <linux/io.h>
@@ -24,6 +25,7 @@
 #include <linux/overflow.h>
 #include <linux/platform_device.h>
 #include <linux/pm.h>
+#include <linux/seq_file.h>
 #include <linux/soc/apple/rtkit.h>
 #include <linux/soc/apple/sleep.h>
 #include <linux/suspend.h>
@@ -556,6 +558,60 @@ static void apple_smc_disable_notifications(void *data)
 	apple_smc_write_flag(smc, SMC_KEY(NTAP), false);
 }
 
+/*
+ * The keys the SMC keeps about the sleeps it registers, read only, as raw bytes
+ * with their type: CLSP and CLWK stamp the last sleep and wake on the SMC's
+ * clock CLKU (us), CLBT the AP's boot; MPPR counts the sleeps; MBSE is the
+ * sleep command key and MBSW the wake reasons. On macOS (J604, 26B123) CLSP
+ * moves within 1 ms of the last AP step of every sleep and MPPR by one.
+ */
+static const smc_key apple_smc_sleep_keys[] = {
+	SMC_KEY(CLSP), SMC_KEY(CLWK), SMC_KEY(CLKU), SMC_KEY(CLBT),
+	SMC_KEY(MPPR), SMC_KEY(MBSE), SMC_KEY(MBSW),
+};
+
+static int apple_smc_sleep_keys_show(struct seq_file *m, void *unused)
+{
+	struct apple_smc *smc = m->private;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(apple_smc_sleep_keys); i++) {
+		smc_key key = apple_smc_sleep_keys[i];
+		struct apple_smc_key_info info;
+		u8 buf[8];
+		int ret;
+
+		ret = apple_smc_get_key_info(smc, key, &info);
+		if (!ret && (!info.size || info.size > sizeof(buf)))
+			ret = -EOVERFLOW;
+		if (!ret)
+			ret = apple_smc_read(smc, key, buf, info.size);
+		if (ret >= 0 && ret != info.size)
+			ret = -EIO;
+		if (ret < 0)
+			seq_printf(m, "%p4ch error %d\n", &key, ret);
+		else
+			seq_printf(m, "%p4ch %p4ch %u %*phN\n", &key, &info.type_code, info.size,
+				   info.size, buf);
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(apple_smc_sleep_keys);
+
+static void apple_smc_debugfs_remove(void *dir)
+{
+	debugfs_remove_recursive(dir);
+}
+
+static void apple_smc_debugfs_init(struct apple_smc *smc)
+{
+	struct dentry *dir = debugfs_create_dir("macsmc", NULL);
+
+	debugfs_create_file("sleep-keys", 0400, dir, smc, &apple_smc_sleep_keys_fops);
+	devm_add_action_or_reset(smc->dev, apple_smc_debugfs_remove, dir);
+}
+
 static int apple_smc_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -621,6 +677,7 @@ static int apple_smc_probe(struct platform_device *pdev)
 	if (ret < 0)
 		return dev_err_probe(smc->dev, ret, "Failed to get key count");
 	smc->key_count = be32_to_cpu(count);
+	apple_smc_debugfs_init(smc);
 
 	/* Notifications, GPIO and power management are not qualified on T8152. */
 	if (of_device_is_compatible(dev->of_node, "apple,t8152-smc"))
