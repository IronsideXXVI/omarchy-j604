From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 04:22:38 +0000
Subject: [PATCH] arm64: sleep: let a platform mark the steps of the
 resume assembly

A J604 deep sleep comes back with DRAM intact (aura's CRC over the
resume stub, the saved context and sleep_save_stash matches) and
then stops between the platform's resume stub and the first line of
__cpu_suspend_exit(), with no exception the stub's vectors could see.
That span is cpu_resume and _cpu_resume, which run with nothing but a
watchdog to tell how far they got.

Let a platform name an Apple-style watchdog in arm64_resume_wdt (its
PA, its kernel VA and its tick rate) and restart it at each step:
after init_kernel_el, after __cpu_setup, after __enable_mmu, at
_cpu_resume's entry, and before and after cpu_do_resume. The MMU-off
steps write it by PA, the rest by VA; each uses x1-x3 only, so x0
(__cpu_setup's SCTLR, cpu_do_resume's context), x19 and x29 survive.
0, the default, writes nothing, and only the resume path has marks.

The Apple sleep driver sets it on T8132, with 57, 54, 51, 48, 45 and
42 s, so the time from the wake to the reset names the instruction
range that stopped.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/include/asm/suspend.h |  7 +++++++
 arch/arm64/kernel/sleep.S        | 30 ++++++++++++++++++++++++++++++
 arch/arm64/kernel/suspend.c      |  1 +
 drivers/soc/apple/sleep.c        | 12 ++++++++++--
 4 files changed, 48 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/include/asm/suspend.h b/arch/arm64/include/asm/suspend.h
index 1501bae788..8f5c798807 100644
--- a/arch/arm64/include/asm/suspend.h
+++ b/arch/arm64/include/asm/suspend.h
@@ -58,6 +58,13 @@ extern void (*arm64_suspend_mark_hook)(enum arm64_suspend_mark mark);
  * (MMU off), and their kernel VA, installed by _cpu_resume (MMU on). 0: none.
  */
 extern u64 arm64_resume_vbar;
+/*
+ * An Apple-style watchdog (control +0x2c, count +0x20, alarm +0x28) that the resume
+ * assembly restarts at each of its steps, so that a platform which only sees a resume
+ * through that watchdog can tell where it stopped: {PA, kernel VA, ticks per second}.
+ * 0, the default, writes nothing.
+ */
+extern u64 arm64_resume_wdt[3];
 extern unsigned long arm64_resume_vbar_va;
 extern void cpu_resume(void);
 int __cpu_suspend_enter(struct sleep_stack_data *state);
diff --git a/arch/arm64/kernel/sleep.S b/arch/arm64/kernel/sleep.S
index 5d4c2232d5..153aa603db 100644
--- a/arch/arm64/kernel/sleep.S
+++ b/arch/arm64/kernel/sleep.S
@@ -98,6 +98,30 @@ SYM_FUNC_START(__cpu_suspend_enter)
 	ret
 SYM_FUNC_END(__cpu_suspend_enter)
 
+/*
+ * Restart the platform's resume watchdog (arm64_resume_wdt) for \secs seconds: by PA
+ * with the MMU off, by kernel VA with it on. Uses x1-x3 only.
+ */
+	.macro	resume_mark, secs, mmu_on
+	.if	\mmu_on
+	ldr	x1, =arm64_resume_wdt
+	ldr	x2, [x1, #8]
+	.else
+	adr_l	x1, arm64_resume_wdt
+	ldr	x2, [x1]
+	.endif
+	cbz	x2, .Lresume_mark_\@
+	ldr	w3, [x1, #16]
+	mov	w1, #\secs
+	mul	w3, w3, w1
+	str	wzr, [x2, #0x2c]
+	str	wzr, [x2, #0x20]
+	str	w3, [x2, #0x28]
+	mov	w3, #1
+	str	w3, [x2, #0x2c]
+.Lresume_mark_\@:
+	.endm
+
 	.pushsection ".idmap.text", "a"
 SYM_CODE_START(cpu_resume)
 	mov	x0, xzr
@@ -119,11 +143,14 @@ SYM_CODE_START(cpu_resume)
 	msr	vbar_el2, x1
 	isb
 0:
+	resume_mark 57, 0
 	bl	__cpu_setup
+	resume_mark 54, 0		// x0 holds the SCTLR for __enable_mmu
 	/* enable the MMU early - so we can access sleep_save_stash by va */
 	adrp	x1, swapper_pg_dir
 	adrp	x2, idmap_pg_dir
 	bl	__enable_mmu
+	resume_mark 51, 1
 	ldr	x8, =_cpu_resume
 	br	x8
 SYM_CODE_END(cpu_resume)
@@ -131,6 +158,7 @@ SYM_CODE_END(cpu_resume)
 	.popsection
 
 SYM_FUNC_START(_cpu_resume)
+	resume_mark 48, 1
 	/* The MMU is on now: the same vectors by their kernel VA (VBAR_EL2 under VHE). */
 	ldr_l	x1, arm64_resume_vbar_va
 	cbz	x1, 1f
@@ -157,10 +185,12 @@ SYM_FUNC_START(_cpu_resume)
 	/* load sp from context */
 	ldr	x2, [x0, #CPU_CTX_SP]
 	mov	sp, x2
+	resume_mark 45, 1
 	/*
 	 * cpu_do_resume expects x0 to contain context address pointer
 	 */
 	bl	cpu_do_resume
+	resume_mark 42, 1
 
 #if defined(CONFIG_KASAN) && defined(CONFIG_KASAN_STACK)
 	mov	x0, sp
diff --git a/arch/arm64/kernel/suspend.c b/arch/arm64/kernel/suspend.c
index 2a404c44ac..1c08ed25f0 100644
--- a/arch/arm64/kernel/suspend.c
+++ b/arch/arm64/kernel/suspend.c
@@ -46,6 +46,7 @@ void (*arm64_suspend_mark_hook)(enum arm64_suspend_mark mark);
 
 /* Read by cpu_resume with the MMU off: the setter cleans it to the PoC. */
 u64 arm64_resume_vbar __section(".mmuoff.data.read");
+u64 arm64_resume_wdt[3] __section(".mmuoff.data.read");
 unsigned long arm64_resume_vbar_va;
 
 static __always_inline void arm64_suspend_mark(enum arm64_suspend_mark mark)
diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index 312a1e2347..6e0d8bc891 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -192,8 +192,10 @@ static_assert(AURA_S2R_CHECKED_SIZE + sizeof(struct aura_s2r_slc) == AURA_S2R_SL
 /* Device suspend and resume can take a while, and nothing else recovers a hang in them. */
 #define WDT_SUSPEND_SECS	120
 /*
- * T8132's way back, each step its own WD2 window, 10 s apart, so the time from the
- * wake to a reset names the step: stub 60, __cpu_suspend_exit() 70 and 80, the DAIF
+ * T8132's way back, each step its own WD2 window, so the time from the wake to a reset
+ * names the step: stub 60; inside the resume assembly (sleep.S, 3 s apart) after
+ * init_kernel_el 57, __cpu_setup 54, __enable_mmu 51, _cpu_resume 48, before and after
+ * cpu_do_resume 45 and 42; then 10 s apart: __cpu_suspend_exit() 70 and 80, the DAIF
  * restore 90, apple_sleep_return() 100 and 110, device resume 120, SError unmasked
  * 130, an exception before VBAR is restored 145/160/175. WD2's alarm is 32 bits of a
  * 24 MHz count, so nothing past 178 s.
@@ -4488,6 +4490,12 @@ static void t8132_catch_init(struct platform_device *pdev, struct apple_sleep *s
 			 (unsigned long)t8132_catch_io + sizeof(t8132_catch_io));
 	arm64_resume_vbar = __pa_symbol(t8132_resume_vectors);
 	arm64_resume_vbar_va = (unsigned long)t8132_resume_vectors;
+	/* Marks inside the resume assembly: 57 54 51 48 45 42 s, see WDT_SUSPEND_SECS. */
+	arm64_resume_wdt[0] = wdt->start;
+	arm64_resume_wdt[1] = (unsigned long)s->wdt;
+	arm64_resume_wdt[2] = WDT_TICKS_PER_S;
+	dcache_clean_poc((unsigned long)arm64_resume_wdt,
+			 (unsigned long)arm64_resume_wdt + sizeof(arm64_resume_wdt));
 	dcache_clean_poc((unsigned long)&arm64_resume_vbar,
 			 (unsigned long)(&arm64_resume_vbar + 1));
 }
-- 
