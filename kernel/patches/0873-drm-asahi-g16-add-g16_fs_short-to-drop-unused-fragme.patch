         } else if f.renders != 0 {
             let g = &self.graph.render;
             if g.fw_stamp[0].r32(0)? != f.ta_target
@@ -1126,8 +1125,7 @@ fn retired_snapshot(&mut self) -> Result<Retirement> {
                 && f.job.resources.render()?.pool_retired(k)?
                 && ta_start != 0
                 && ta_end > ta_start
-                && fs_start != 0
-                && fs_end > fs_start;
+                && (f.fs_short || (fs_start != 0 && fs_end > fs_start));
         }
         if full {
             if rw_alone {
@@ -1820,6 +1818,14 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
             self.session.shared.irq_bells.load(Ordering::Relaxed)
         )?;
         super::encode::replay::stats(f)?;
+        let forms = &super::engine::FS_FORMS;
+        writeln!(
+            f,
+            "fs_short: on {} short {} long {}",
+            u32::from(params::fs_short()),
+            forms[1].load(Ordering::Relaxed),
+            forms[0].load(Ordering::Relaxed)
+        )?;
         let lazy = &super::resources::LAZY_STATS;
         writeln!(
             f,
