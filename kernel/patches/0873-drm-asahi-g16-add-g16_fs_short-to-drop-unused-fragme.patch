From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 05:18:51 +0000
Subject: [PATCH] drm/asahi: g16: add g16_fs_short to drop unused
 fragment timestamp records

Every fragment sequence this driver encodes carries a start and an end
timestamp record, even for a render whose submission asked for no
timestamp outputs. The macOS driver leaves both records out of such a
command: its fragment sequence then has the one-word record that sits
between them followed by the finalize record, which moves up by the
0x98 bytes of the two records, and ends 0x98 bytes earlier.

With g16_fs_short=1, a render without timestamp outputs gets that short
sequence, and its work record gives the shorter sequence length.

Nothing else reads the fragment timestamps of such a render except the
retirement check, which required the start and end words the records
fill in the pass scene. A short render records that fact in its flight,
and its retirement relies on the stamps, notifier words and queue
receipts that already have to agree, as for every other render. Flight
traces of short renders carry no fragment start or end.

The stats file counts the renders encoded with each form on its
fs_short line, so a run can show its renders took the short form.

The default of 0 keeps both records on every render.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/encode/render.rs | 29 ++++++++++++++--------
 drivers/gpu/drm/asahi/g16/engine.rs        | 12 +++++++++
 drivers/gpu/drm/asahi/g16/params.rs        | 18 ++++++++++++++
 drivers/gpu/drm/asahi/g16/poll.rs          | 14 ++++++++---
 drivers/gpu/drm/asahi/timestamp.rs         |  6 +++++
 5 files changed, 65 insertions(+), 14 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/encode/render.rs b/drivers/gpu/drm/asahi/g16/encode/render.rs
index 088f343127..ae01cd0950 100644
--- a/drivers/gpu/drm/asahi/g16/encode/render.rs
+++ b/drivers/gpu/drm/asahi/g16/encode/render.rs
@@ -304,6 +304,7 @@ pub(crate) fn encode_fs(
     _n: u64,
     target: u32,
     geo: &Geometry,
+    short: bool,
     w: &mut [u8; fs::WORK_SIZE],
     q: &mut [u8],
 ) {
@@ -483,16 +484,24 @@ pub(crate) fn encode_fs(
     put64(q, 0x84, work + 0xbf0);
     put32(q, 0xa0, r.uuid);
     inline_uma(q, 0x1b0, r, 1);
-    timestamps(
-        q,
-        0x1ec,
-        work,
-        r.qinfo[1],
-        ts_va[2] != 0 || ts_va[3] != 0,
-        r.uuid,
-        1,
-    );
-    let f = 0x288;
+    // `short` (g16_fs_short): no timestamp records, only the one-word record between them,
+    // so the finalize record moves up by their 0x98 bytes and the sequence ends at 0x2ac.
+    let f = if short {
+        put32(q, 0x1ec, 1);
+        put32(w, 0x1c, 0x2b0);
+        0x1f0
+    } else {
+        timestamps(
+            q,
+            0x1ec,
+            work,
+            r.qinfo[1],
+            ts_va[2] != 0 || ts_va[3] != 0,
+            r.uuid,
+            1,
+        );
+        0x288
+    };
     put32(q, f, 8);
     put32(q, f + 4, r.uuid);
     put64(q, f + 0xc, r.fw_stamp[1]);
diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
