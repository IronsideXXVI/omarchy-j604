 use super::slots::Claims;
 use super::{params, Firmware, Shared};
 
+/// Renders encoded with the long fragment sequence ([0]) and the short one ([1], `g16_fs_short`).
+pub(crate) static FS_FORMS: [AtomicU32; 2] = [const { AtomicU32::new(0) }; 2];
+
 /// `wmb()`: `dsb st` (a full fence on other architectures).
 #[inline(always)]
 pub(crate) fn wmb() {
@@ -202,6 +205,8 @@ pub(crate) struct Flight {
     pub(crate) target: u32,
     pub(crate) head: u32,
     pub(crate) c_start: u32,
+    /// The render's fragment sequence has no timestamp records (`g16_fs_short`).
+    pub(crate) fs_short: bool,
     /// Render: final TA/FS stamps, ring ends and ring positions before the prefix.
     pub(crate) ta_target: u32,
     pub(crate) fs_target: u32,
@@ -244,6 +249,7 @@ fn new(job: Arc<Job>) -> Self {
             target: 0,
             head: 0,
             c_start: 0,
+            fs_short: false,
             ta_target: 0,
             fs_target: 0,
             ta_head: 0,
@@ -2097,6 +2103,11 @@ fn prefix_render(
             .render()?
             .set_dirty(k, geometry.tpc_bytes, geometry.tilemap_bytes)?;
         let behind = !self.engine.flights.is_empty();
+        // Without timestamp outputs nothing reads the fragment timestamp records but the
+        // retirement check, which then relies on the stamps and receipts alone.
+        let short = params::fs_short() && cmd.timestamp_outputs.is_empty();
+        f.fs_short = short;
+        FS_FORMS[usize::from(short)].fetch_add(1, Ordering::Relaxed);
         let scratch = self.engine.scratch.as_deref_mut().ok_or(ENOMEM)?;
         encode::encode_ta(
             &refs,
@@ -2120,6 +2131,7 @@ fn prefix_render(
             draw,
             target,
             &geometry,
+            short,
             image(&mut scratch.fs)?,
             &mut scratch.fss[..],
         );
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index b903204e41..30413e8e35 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2354,6 +2354,24 @@ pub(crate) fn replay() -> u32 {
     "G16: mask of template pieces (aurora-g16/replay) written into each compute command's sequence record over this driver's values; addresses are never replaced (default 0: none; runtime 0644)"
 );
 
+/// Storage of `g16_fs_short` (runtime 0644, default 0).
+static FS_SHORT: AtomicU32 = AtomicU32::new(0);
+
+/// A render with no timestamp outputs gets the fragment sequence without its two timestamp
+/// records, as the macOS driver encodes such a fragment command.
+pub(crate) fn fs_short() -> bool {
+    FS_SHORT.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    FS_SHORT_PARAM,
+    FS_SHORT_PARMTYPE,
+    FS_SHORT_PARM,
+    FS_SHORT,
+    "g16_fs_short",
+    "G16: a render without timestamp outputs gets the fragment sequence without its timestamp records (default 0: always both records; runtime 0644)"
+);
+
 /// Storage of `g16_resident_units` (0644, default 0; read once, at the latch).
 static RESIDENT_UNITS: AtomicU32 = AtomicU32::new(0);
 
