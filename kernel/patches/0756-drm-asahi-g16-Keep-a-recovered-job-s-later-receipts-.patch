From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 01:16:11 +0000
Subject: [PATCH] drm/asahi: g16: Keep a recovered job's later receipts
 off the full chain

A job published as several prefixes keeps a consecutive ledger of
fully retired commands (note_full_retirement) and of retired ordinals
(command_retired). When a firmware recovery aborts one prefix, that
prefix is quarantined and never notes its range. The next prefix of
the same job then gets a normal full receipt, both compare-exchanges
miss and the device fail-stops with EIO, without a message of its own,
right after "recovery generation N resumed".

With g16_recovery_tolerant, record a passed abort on the job and treat
its later prefixes as affected: they fail the job, skip the ordinal
and full-receipt chains, and are not certified as terminally retired,
so the job stays retained with its mappings. Their storage still
retires normally. Without the parameter nothing changes.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/job.rs      | 15 +++++++++++++++
 drivers/gpu/drm/asahi/g16/poll.rs     | 11 ++++++++++-
 drivers/gpu/drm/asahi/g16/recovery.rs | 10 +++++-----
 3 files changed, 30 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/job.rs b/drivers/gpu/drm/asahi/g16/job.rs
index cdb8a30406..9f3822e3fd 100644
--- a/drivers/gpu/drm/asahi/g16/job.rs
+++ b/drivers/gpu/drm/asahi/g16/job.rs
@@ -108,6 +108,10 @@ pub(crate) struct Job {
     /// No future publication and every previously published owner fully retired. This proof
     /// is separate from an error result: an affected full receipt may still fail the job.
     terminal_retired: AtomicBool,
+    /// A published prefix of this job was retired as a passed abort: with
+    /// g16_recovery_tolerant its later receipts fail the job and never extend
+    /// `full_retired`.
+    aborted: AtomicBool,
     /// Retains the VM's mappings (deferred unmaps, deferred VM close) while the firmware may
     /// access them.
     _guard: crate::cleanup::Deferred<MappingGuard>,
@@ -157,6 +161,7 @@ pub(crate) fn new(
                 inputs,
                 full_retired: AtomicU32::new(0),
                 terminal_retired: AtomicBool::new(false),
+                aborted: AtomicBool::new(false),
                 // Scheduler free can race the final off-lock completion reference.
                 // Prepare destruction work before acceptance; dropping a completed job
                 // within SignallingGuard must not drain mappings or take reservations.
@@ -405,6 +410,16 @@ pub(crate) fn mark_terminal_retired(&self) -> Result {
         Ok(())
     }
 
+    /// Records that a published prefix of this job was retired as a passed abort.
+    pub(crate) fn mark_aborted(&self) {
+        self.aborted.store(true, Ordering::Release);
+    }
+
+    /// Whether a published prefix of this job was retired as a passed abort.
+    pub(crate) fn aborted(&self) -> bool {
+        self.aborted.load(Ordering::Acquire)
+    }
+
     /// Cancels a job the scheduler never ran (queue teardown, or a failed submission).
     fn cancel_unstarted(&self) {
         if self.started.swap(true, Ordering::AcqRel) {
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 75db584a78..c8fd0d3965 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -680,7 +680,14 @@ pub(crate) fn retire_oldest(
                     return;
                 }
             }
-            if let Err(error) = f.job.note_full_retirement(f.first as u32, f.count as u32) {
+            // After a passed abort of an earlier prefix the full-receipt chain cannot be
+            // consecutive. The job is retained and fails; its storage still retired here.
+            let chained = if params::recovery_tolerant() && f.job.aborted() {
+                Ok(())
+            } else {
+                f.job.note_full_retirement(f.first as u32, f.count as u32)
+            };
+            if let Err(error) = chained {
                 self.retain(&f.job);
                 complete(done, &f.job, Err(error));
                 self.fail_stop(error, done);
@@ -695,6 +702,7 @@ pub(crate) fn retire_oldest(
             // with a full normal receipt fails its fence without poisoning healthy storage.
             self.slots.quarantine(&mut f.claims);
             self.retain(&f.job);
+            f.job.mark_aborted();
             self.recovery.aborted_receipts = self.recovery.aborted_receipts.saturating_add(1);
         }
         if self.slots.compute_exhausted() {
@@ -739,6 +747,7 @@ pub(crate) fn retire_oldest(
                 p.count.store(p.sent(), Ordering::Relaxed);
             }
             if receipt.owner_retired()
+                && !(params::recovery_tolerant() && job.aborted())
                 && self.engine.flights.iter().all(|other| {
                     !Arc::ptr_eq(&other.job, &job)
                         && other.group.iter().all(|member| !Arc::ptr_eq(member, &job))
diff --git a/drivers/gpu/drm/asahi/g16/recovery.rs b/drivers/gpu/drm/asahi/g16/recovery.rs
index d7cfd6f3b7..151268364c 100644
--- a/drivers/gpu/drm/asahi/g16/recovery.rs
+++ b/drivers/gpu/drm/asahi/g16/recovery.rs
@@ -154,11 +154,11 @@ pub(crate) fn recovery_counts(&self) -> (u64, u64) {
     /// suspect work can complete normally; the poll owner separately proves an
     /// abort before retiring it without a full receipt.
     pub(crate) fn retire_outcome(&mut self, receipt: Retirement) -> Result {
-        let affected = self
-            .engine
-            .flights
-            .first()
-            .is_some_and(|flight| flight.doomed);
+        // g16_recovery_tolerant: once a prefix of a job was a passed abort, its later
+        // commands cannot continue the job's ordinal chain; fail them as affected.
+        let affected = self.engine.flights.first().is_some_and(|flight| {
+            flight.doomed || (params::recovery_tolerant() && flight.job.aborted())
+        });
         if receipt.job_failed(affected) {
             Err(EIO)
         } else {
