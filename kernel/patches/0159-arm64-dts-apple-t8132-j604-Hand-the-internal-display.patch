From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 07:07:42 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j604: Hand the internal display to
 the DCP

Make the J604 DCP, its mailbox and its firmware DART live, and add the
dcp, disp0 and disp0_piodma aliases plus the apple,j713-native-piodma and
apple,j713-native-scanout opt-ins, so the boot loader can hand the running
DCP session over, as on the J713.

The loader completes the nodes: it publishes the DCP firmware identity and
reservations on dcp and, after validating the inherited frontend mappings,
adds memory-region and apple,j713-inherited-mappings to piodma and
display-subsystem and enables them and disp0_dart. Those three stay
disabled in the tree. Without the handoff the DCP and frontend are refused
and the boot framebuffer stays. The display DART driver still leaves both
display DARTs untouched unless apple_dart.j713_dcp or
apple_dart.j713_display is set.

Once handed over, the running disp_sys, disp_fe and disp_cpu domains belong
to the DCP firmware: mark them apple,firmware-owned so Linux registers them
but never writes them, and enable disp_cpu, which the DCP and its mailbox
need as their power domain. The boot framebuffer keeps its own domains.

The nodes were already marked dma-noncoherent; that is unchanged.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../boot/dts/apple/t8132-j604-display.dtsi    | 58 ++++++++++++++-----
 1 file changed, 45 insertions(+), 13 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi
index fddd6b856d..a02e39b393 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi
@@ -6,17 +6,32 @@
  * against the J604 Apple device tree (25G83 and 26B123 j604ap templates).
  * DCP-<id> tags name rows of DT-VERIFY-dcp.tsv.
  *
- * Everything here is disabled and no dcp/disp0/disp0_piodma alias or
- * apple,j713-native-* opt-in is set: the boot loaders key their DCP handoff on
- * those, so the J604 keeps the boot framebuffer (simple-framebuffer) and none
- * of these nodes is probed. drm/apple has no J604 panel profile yet, and its
- * M4 backend and display DART adoption only admit the J713.
- * The DCP, PIODMA and scanout paths use non-coherent DMA only, so those
- * nodes are marked dma-noncoherent.
+ * The DCP, its mailbox and its firmware DART are live when Linux starts. The
+ * DART driver leaves both display DARTs untouched until apple_dart.j713_dcp or
+ * apple_dart.j713_display is set, and appledrm adopts the inherited session
+ * after guarded DART admission (same contract as t8132-j713-display.dtsi).
+ *
+ * The boot loader completes these nodes: on dcp it publishes
+ * apple,firmware-uuid, -version and -compat and the DCP firmware
+ * reservations; after validating the inherited frontend mappings it adds
+ * memory-region and apple,j713-inherited-mappings to piodma and
+ * display-subsystem and enables them and disp0_dart.
+ * apple,j713-native-piodma and apple,j713-native-scanout opt in to that.
+ * Without that handoff the DCP and frontend are refused and the boot
+ * framebuffer stays. The DCP, PIODMA and scanout paths use non-coherent DMA
+ * only, so those nodes are marked dma-noncoherent.
  *
  * Copyright The Asahi Linux Contributors
  */
 
+/ {
+	aliases {
+		dcp = &dcp;
+		disp0 = &display;
+		disp0_piodma = &disp0_piodma;
+	};
+};
+
 &soc {
 	dcp_mbox: mailbox@30ae08000 {
 		compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
@@ -30,7 +45,6 @@
 				  "recv-empty", "recv-not-empty";
 		power-domains = <&ps_disp_cpu>; /* DCP-MBOX-4 */
 		#mbox-cells = <0>;
-		status = "disabled";
 	};
 
 	/* DCP firmware DART: SID23. */
@@ -41,7 +55,6 @@
 		interrupts = <AIC_IRQ 678 IRQ_TYPE_LEVEL_HIGH>; /* DCP-DART-2 */
 		#iommu-cells = <1>;
 		apple,dma-range = <0x100 0x0 0x10 0x0>; /* DCP-DART-4, DCP-DART-5 */
-		status = "disabled";
 	};
 
 	/* Display frontend DART: SID0 scanout, SID16 PIODMA. */
@@ -52,7 +65,7 @@
 		interrupts = <AIC_IRQ 678 IRQ_TYPE_LEVEL_HIGH>; /* DCP-DDART-3 */
 		#iommu-cells = <1>;
 		apple,dma-range = <0x100 0x0 0x10 0x0>; /* DCP-DDART-5, DCP-DDART-6 */
-		status = "disabled";
+		status = "disabled"; /* Enabled by the loader. */
 	};
 
 	dcp: dcp@30ae00000 {
@@ -71,6 +84,8 @@
 		iommus = <&dcp_dart 23>; /* DCP-12 */
 		power-domains = <&ps_disp_cpu>; /* DCP-17 */
 		dma-noncoherent;
+		apple,j713-native-piodma; /* DCPEN-OPT-1 */
+		apple,j713-native-scanout; /* DCPEN-OPT-2 */
 		/*
 		 * Full 3024x1964 panel including the notch rows, from the
 		 * 254.6 ppi dot pitch of the J604 device tree.
@@ -79,12 +94,11 @@
 		apple,panel-height-mm = <195>; /* DCP-14 */
 		#address-cells = <2>;
 		#size-cells = <2>;
-		status = "disabled"; /* DCP-11 */
 
 		disp0_piodma: piodma {
 			iommus = <&disp0_dart 16>; /* DCP-16 */
 			dma-noncoherent;
-			status = "disabled"; /* DCP-15 */
+			status = "disabled"; /* Enabled by the loader. */
 		};
 	};
 
@@ -92,6 +106,24 @@
 		compatible = "apple,t8132-display-subsystem";
 		iommus = <&disp0_dart 0>; /* DCP-DISP-1 */
 		dma-noncoherent;
-		status = "disabled"; /* DCP-DISP-2 */
+		status = "disabled"; /* Enabled by the loader. */
 	};
 };
+
+/*
+ * The running display domains belong to the DCP firmware once it is handed
+ * over: Linux registers them but never writes them (t8132-j713-pmgr.dtsi
+ * policy for these three). The boot framebuffer keeps its own domains.
+ */
+&ps_disp_sys {
+	apple,firmware-owned; /* DCPEN-PD-1 */
+};
+
+&ps_disp_fe {
+	apple,firmware-owned; /* DCPEN-PD-2 */
+};
+
+&ps_disp_cpu {
+	status = "okay"; /* DCPEN-PD-3 */
+	apple,firmware-owned;
+};
