From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 21:23:40 +0000
Subject: [PATCH] tools/asahi: atc-usb3-tests: model the T8132 DP lanes
 and USB4 pipe switch

The ATC PHY's lane and pipe paths now call atcphy_t8132_dp_lanes(),
added with DP Alt Mode on a T8132 Type-C port (815e1a0910, dbfd68a8c7),
and read the t8132_usb4_pipe lab switch through READ_ONCE() (f9fb775fcb).
The harness extracts neither, so atc-usb3-tests no longer builds.
Extract the helper with the others and give the prelude the switch, off
as by default, and READ_ONCE().

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 tools/asahi/atc-usb3-tests.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/tools/asahi/atc-usb3-tests.py b/tools/asahi/atc-usb3-tests.py
index 668924cc6d..6a25576a5a 100644
--- a/tools/asahi/atc-usb3-tests.py
+++ b/tools/asahi/atc-usb3-tests.py
@@ -118,6 +118,9 @@ static unsigned ack_on;
 static int check_ret, bist_ret, unlock_ret, configure_ret;
 static bool concurrent_override_change;
 static bool model_t8132_off;
+#define READ_ONCE(x) (x)
+/* The lab switch of the USB3-over-USB4 path, off as by default. */
+static bool t8132_usb4_pipe;
 static u32 readl(const void *ptr) { u32 v; memcpy(&v, ptr, sizeof(v)); return v; }
 static void writel(u32 val, void *ptr) { memcpy(ptr, &val, sizeof(val)); }
 static void set32(void *ptr, u32 mask) {
@@ -690,6 +693,7 @@ def harness(source):
     scope_c = "static const enum atcphy_generation scope_generations[] = {" + ",".join(r["generation"] for r in scope) + "};\n"
     # The PIPE backend of a mode, which T8132 CIO keeps on the dummy one.
     helpers = [block(source, "static bool atcphy_mode_is_cio("),
+               block(source, "static bool atcphy_t8132_dp_lanes("),
                block(source, "static enum atcphy_pipehandler_state\natcphy_pipe_state_for(")]
     functions = "\n".join(helpers + [block(source, "static " + kind + " " + name + "(")
                                       for kind, name in function_specs])
