From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 4 Nov 2026 21:52:06 -0500
Subject: [PATCH] iommu: apple-dart: adopt the J713 external DCP firmware DARTs

The J713's two external display coprocessors (DCPs) run the same firmware
as the internal one. The boot loader starts them and leaves them quiesced,
with their firmware DARTs (SID23) set up the same way. Admit those DARTs as
the internal one is: read the ADT nodes of the matching coprocessor and its
four-segment firmware layout instead of the internal DCP's seven, and
validate the owner against apple,t8132-dcpext.

Touch one only once the boot loader has marked its DCP handed over
(apple,t8132-dcpext-firmware-ready), which it does only with the block
powered. Its fault interrupt is shared with the external display DART, so
request none.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit d50831b61172af024b8ae3388ce13672642ea0ab)
---
 drivers/iommu/apple-dart-dcp-format.h | 89 ++++++++++++++++++++++-----
 drivers/iommu/apple-dart-dcp.h        | 14 +++--
 drivers/iommu/apple-dart.c            | 41 ++++++++++--
 3 files changed, 118 insertions(+), 26 deletions(-)

diff --git a/drivers/iommu/apple-dart-dcp-format.h b/drivers/iommu/apple-dart-dcp-format.h
index 9ac3800379..f441aeff9f 100644
--- a/drivers/iommu/apple-dart-dcp-format.h
+++ b/drivers/iommu/apple-dart-dcp-format.h
@@ -41,6 +41,52 @@ struct dcp_adt_frontend {
 	u32 nodes;
 };
 
+/* One J713 display coprocessor: its ADT nodes and its firmware segments. */
+struct dcp_adt_instance {
+	const char *dart;	/* firmware DART, SID23 */
+	const char *dcp;
+	const char *nub;
+	const char *disp;	/* display DART; only the internal frontend is admitted */
+	const char *segment_names;
+	const u32 *kinds;
+	u32 num_segments;
+};
+
+static const u32 dcp_adt_kinds_internal[] = {1, 0, 10, 2, 2, 2, 2};
+static const u32 dcp_adt_kinds_external[] = {1, 0, 10, 2};
+
+static const struct dcp_adt_instance dcp_adt_internal = {
+	.dart = "dart-dcp",
+	.dcp = "dcp",
+	.nub = "iop-dcp-nub",
+	.disp = "dart-disp0",
+	.segment_names = "__TEXT;__DATA;__OS_LOG;unknown;unknown;unknown;unknown",
+	.kinds = dcp_adt_kinds_internal,
+	.num_segments = ARRAY_SIZE(dcp_adt_kinds_internal),
+};
+
+/* The external DCPs run the same firmware with a single extra segment. */
+static const struct dcp_adt_instance dcp_adt_external[] = {
+	{
+		.dart = "dart-dcpext0",
+		.dcp = "dcpext0",
+		.nub = "iop-dcpext0-nub",
+		.disp = "dart-dispext0",
+		.segment_names = "__TEXT;__DATA;__OS_LOG;unknown",
+		.kinds = dcp_adt_kinds_external,
+		.num_segments = ARRAY_SIZE(dcp_adt_kinds_external),
+	},
+	{
+		.dart = "dart-dcpext1",
+		.dcp = "dcpext1",
+		.nub = "iop-dcpext1-nub",
+		.disp = "dart-dispext1",
+		.segment_names = "__TEXT;__DATA;__OS_LOG;unknown",
+		.kinds = dcp_adt_kinds_external,
+		.num_segments = ARRAY_SIZE(dcp_adt_kinds_external),
+	},
+};
+
 static inline int dcp_dart_pte_check(u64 pte, bool leaf)
 {
 	u64 fields = leaf ? DCP_DART_LEAF_FIELDS : DCP_DART_PADDR | 1;
@@ -103,7 +149,8 @@ static inline bool dcp_dart_contains(u64 base, u64 end, u64 start, u64 size)
 	return base < end && size && start >= base && start < end && size <= end - start;
 }
 
-static inline int dcp_adt_value(struct dcp_adt_tables *out, unsigned int kind,
+static inline int dcp_adt_value(struct dcp_adt_tables *out,
+				const struct dcp_adt_instance *inst, unsigned int kind,
 				const char *name, const u8 *value, u32 length)
 {
 	u32 bit = 0;
@@ -154,11 +201,10 @@ static inline int dcp_adt_value(struct dcp_adt_tables *out, unsigned int kind,
 		if (length != sizeof(uuid) || memcmp(value, uuid, sizeof(uuid)))
 			return -ENODEV;
 	} else if (kind == 6 && !strcmp(name, "segment-names")) {
-		static const char names[] =
-			"__TEXT;__DATA;__OS_LOG;unknown;unknown;unknown;unknown";
+		size_t names = strlen(inst->segment_names) + 1;
 
 		bit = 128;
-		if (length != sizeof(names) || memcmp(value, names, sizeof(names)))
+		if (length != names || memcmp(value, inst->segment_names, names))
 			return -ENODEV;
 	}
 	if (out->seen & bit)
@@ -193,9 +239,10 @@ static inline int dcp_adt_frontend_value(struct dcp_adt_frontend *out,
 	return 0;
 }
 
-/* Bounded, read-only ADT subset: ROOT / arm-io / dart-dcp and ROOT / chosen. */
+/* Bounded, read-only ADT subset: one coprocessor's nodes under ROOT / arm-io, and ROOT / chosen. */
 static inline int dcp_adt_node(const u8 *data, size_t size, size_t *cursor,
 			       unsigned int parent, unsigned int depth,
+			       const struct dcp_adt_instance *inst,
 			       struct dcp_adt_tables *out, struct dcp_adt_frontend *frontend)
 {
 	size_t first, pos;
@@ -233,15 +280,15 @@ static inline int dcp_adt_node(const u8 *data, size_t size, size_t *cursor,
 		kind = 1;
 	else if (parent == 1 && !strcmp(node_name, "arm-io"))
 		kind = 2;
-	else if (parent == 2 && !strcmp(node_name, "dart-dcp"))
+	else if (parent == 2 && !strcmp(node_name, inst->dart))
 		kind = 3;
 	else if (parent == 1 && !strcmp(node_name, "chosen"))
 		kind = 4;
-	else if (parent == 2 && !strcmp(node_name, "dcp"))
+	else if (parent == 2 && !strcmp(node_name, inst->dcp))
 		kind = 5;
-	else if (parent == 5 && !strcmp(node_name, "iop-dcp-nub"))
+	else if (parent == 5 && !strcmp(node_name, inst->nub))
 		kind = 6;
-	else if (parent == 2 && !strcmp(node_name, "dart-disp0"))
+	else if (parent == 2 && !strcmp(node_name, inst->disp))
 		kind = 7;
 	if (kind == 7 && frontend && frontend->nodes++)
 		return -EINVAL;
@@ -250,7 +297,8 @@ static inline int dcp_adt_node(const u8 *data, size_t size, size_t *cursor,
 	for (u32 i = 0; i < props; i++) {
 		u32 length = get_unaligned_le32(data + pos + 32) & 0x7fffffff;
 
-		ret = dcp_adt_value(out, kind, (const char *)data + pos, data + pos + 36, length);
+		ret = dcp_adt_value(out, inst, kind, (const char *)data + pos, data + pos + 36,
+				    length);
 		if (ret)
 			return ret;
 		if (kind == 7 && frontend) {
@@ -262,7 +310,7 @@ static inline int dcp_adt_node(const u8 *data, size_t size, size_t *cursor,
 		pos += 36 + ((length + 3ULL) & ~3ULL);
 	}
 	for (u32 i = 0; i < children; i++) {
-		ret = dcp_adt_node(data, size, cursor, kind, depth + 1, out, frontend);
+		ret = dcp_adt_node(data, size, cursor, kind, depth + 1, inst, out, frontend);
 		if (ret)
 			return ret;
 	}
@@ -270,6 +318,7 @@ static inline int dcp_adt_node(const u8 *data, size_t size, size_t *cursor,
 }
 
 static inline int dcp_adt_parse_common(const void *data, size_t size,
+				       const struct dcp_adt_instance *inst,
 				       struct dcp_adt_tables *out,
 				       struct dcp_adt_frontend *frontend)
 {
@@ -281,10 +330,10 @@ static inline int dcp_adt_parse_common(const void *data, size_t size,
 		*frontend = (struct dcp_adt_frontend){};
 	if (size > 0x200000)
 		return -E2BIG;
-	ret = dcp_adt_node(data, size, &cursor, 0, 0, out, frontend);
+	ret = dcp_adt_node(data, size, &cursor, 0, 0, inst, out, frontend);
 	if (ret)
 		return ret;
-	if (out->seen != 255 || out->num_segments != 7 || !out->dram_size ||
+	if (out->seen != 255 || out->num_segments != inst->num_segments || !out->dram_size ||
 	    out->dram_start + out->dram_size < out->dram_start ||
 	    out->start >= out->end || out->end - out->start > 0x100000 ||
 	    ((out->start | out->end) & (DCP_DART_PAGE - 1)) ||
@@ -292,10 +341,9 @@ static inline int dcp_adt_parse_common(const void *data, size_t size,
 			       out->start, out->end - out->start))
 		return -EINVAL;
 	for (u32 i = 0; i < out->num_segments; i++) {
-		static const u32 kinds[] = {1, 0, 10, 2, 2, 2, 2};
 		const struct dcp_adt_segment *seg = &out->segment[i];
 
-		if (seg->kind != kinds[i] || (seg->phys & (DCP_DART_PAGE - 1)) ||
+		if (seg->kind != inst->kinds[i] || (seg->phys & (DCP_DART_PAGE - 1)) ||
 		    !dcp_dart_contains(out->dram_start, out->dram_start + out->dram_size,
 				       seg->phys, seg->size))
 			return -EINVAL;
@@ -319,7 +367,14 @@ static inline int dcp_adt_parse_common(const void *data, size_t size,
 
 static inline int dcp_adt_parse(const void *data, size_t size, struct dcp_adt_tables *out)
 {
-	return dcp_adt_parse_common(data, size, out, NULL);
+	return dcp_adt_parse_common(data, size, &dcp_adt_internal, out, NULL);
+}
+
+static inline int dcp_adt_parse_instance(const void *data, size_t size,
+					 const struct dcp_adt_instance *inst,
+					 struct dcp_adt_tables *out)
+{
+	return dcp_adt_parse_common(data, size, inst, out, NULL);
 }
 
 /* Parse metadata only: live MMIO, RAM exclusion and page tables remain unproven. */
@@ -327,7 +382,7 @@ static inline int dcp_adt_parse_frontend(const void *data, size_t size,
 					struct dcp_adt_tables *firmware,
 					struct dcp_adt_frontend *frontend)
 {
-	int ret = dcp_adt_parse_common(data, size, firmware, frontend);
+	int ret = dcp_adt_parse_common(data, size, &dcp_adt_internal, firmware, frontend);
 
 	if (ret)
 		return ret;
diff --git a/drivers/iommu/apple-dart-dcp.h b/drivers/iommu/apple-dart-dcp.h
index ddf976dc85..5a71933c4d 100644
--- a/drivers/iommu/apple-dart-dcp.h
+++ b/drivers/iommu/apple-dart-dcp.h
@@ -1,5 +1,9 @@
 /* SPDX-License-Identifier: GPL-2.0-only OR MIT */
-/* Included by apple-dart.c. J713 internal DCP only; foreign tables stay live. */
+/*
+ * Included by apple-dart.c. J713 display coprocessors: the internal DCP's
+ * firmware and frontend DARTs, and the external DCPs' firmware DARTs.
+ * Foreign tables stay live.
+ */
 #include <linux/mm.h>
 #include <linux/of_reserved_mem.h>
 #include "apple-dart-dcp-format.h"
@@ -142,7 +146,7 @@ static int apple_dart_dcp_read_adt(struct apple_dart *dart, struct dcp_adt_table
 		goto out_node;
 	}
 	ret = frontend ? dcp_adt_parse_frontend(data, resource_size(&res), tables, frontend) :
-		dcp_adt_parse(data, resource_size(&res), tables);
+		dcp_adt_parse_instance(data, resource_size(&res), dart->dcp_instance, tables);
 	memunmap(data);
 out_node:
 	of_node_put(found);
@@ -237,7 +241,7 @@ static int apple_dart_dcp_arena(struct apple_dart_dcp *dcp)
 static int apple_dart_dcp_leaf_regions(struct apple_dart_dcp *dcp)
 {
 	struct device_node *consumer, *node;
-	const char *alias = dcp->sid == 23 ? "dcp" :
+	const char *alias = dcp->sid == 23 ? dcp->dart->dcp_instance->dcp :
 		dcp->sid == 0 ? "disp0" : "disp0_piodma";
 	int count, ret = 0;
 
@@ -788,7 +792,9 @@ static int __apple_dart_dcp_validate(struct apple_dart_dcp *dcp, struct device *
 		return ret;
 	}
 
-	if (!of_device_is_compatible(dev->of_node, "apple,t8132-dcp") ||
+	if (!of_device_is_compatible(dev->of_node,
+				     dcp->dart->dcp_instance == &dcp_adt_internal ?
+				     "apple,t8132-dcp" : "apple,t8132-dcpext") ||
 	    of_property_read_string(dev->of_node, "apple,firmware-uuid", &uuid) ||
 	    strcmp(uuid, "81BAF476-679D-3CC0-8C6A-E6B6FA659D5E") ||
 	    (dcp->owner && dcp->owner != dev))
diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 1ae3b6d1f9..bda729defd 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -310,6 +310,8 @@ struct apple_dart {
 	/* J713 internal display DARTs, borrowed from the running DCP. */
 	struct apple_dart_dcp *dcp;
 	struct apple_dart_dcp *frontend[2];
+	/* The display coprocessor whose firmware DART (SID23) this is. */
+	const struct dcp_adt_instance *dcp_instance;
 	bool preserve_display;
 	/* Retained radio/display state left in place across suspend-to-idle. */
 	bool s2idle_kept;
@@ -4028,7 +4030,7 @@ static int apple_dart_probe(struct platform_device *pdev)
 	bool tunneled = dev->of_node->parent &&
 			 of_node_name_prefix(dev->of_node->parent,
 					     "usb4-pcie-tunnel-");
-	bool j713_display, j713_radio;
+	bool j713_display, j713_dcpext, j713_radio;
 
 	/*
 	 * The retained internal display DARTs are live: DCP firmware (SID23) and
@@ -4039,6 +4041,10 @@ static int apple_dart_probe(struct platform_device *pdev)
 	j713_display = res && !tunneled && apple_dart_retained_display_board() &&
 		of_device_is_compatible(dev->of_node, "apple,t8132-dart") &&
 		(res->start == 0x30a300000ULL || res->start == 0x30a340000ULL);
+	/* The external DCP firmware DARTs (SID23) of dcpext0 and dcpext1. */
+	j713_dcpext = res && !tunneled && of_machine_is_compatible("apple,j713") &&
+		of_device_is_compatible(dev->of_node, "apple,t8132-dart") &&
+		(res->start == 0x286340000ULL || res->start == 0x48a340000ULL);
 	/* The J713 radio DART's fault interrupt is not described by its loader. */
 	j713_radio = res && !tunneled && of_machine_is_compatible("apple,j713") &&
 		of_machine_is_compatible("apple,t8132") &&
@@ -4053,6 +4059,21 @@ static int apple_dart_probe(struct platform_device *pdev)
 		dev_info(dev, "Leaving inherited display DART untouched; explicit guarded probe required\n");
 		return -ENODEV;
 	}
+	if (j713_dcpext) {
+		/* Its block is powered only if the loader handed the DCP over. */
+		struct device_node *owner =
+			of_find_node_by_path(res->start == 0x48a340000ULL ? "dcpext1" : "dcpext0");
+		u32 ready = 0;
+		bool handed_over = owner &&
+			!of_property_read_u32(owner, "apple,t8132-dcpext-firmware-ready", &ready) &&
+			ready == 1;
+
+		of_node_put(owner);
+		if (!IS_ENABLED(CONFIG_APPLE_DART_J713_DCP) || !handed_over) {
+			dev_info(dev, "Leaving inherited external display DART untouched\n");
+			return -ENODEV;
+		}
+	}
 
 	dart = kzalloc(sizeof(*dart), GFP_KERNEL);
 	if (!dart)
@@ -4080,7 +4101,11 @@ static int apple_dart_probe(struct platform_device *pdev)
 		dart->managed_sids = BIT(1) | BIT(2);
 	}
 	spin_lock_init(&dart->managed_lock);
-	dart->preserve_display = j713_display;
+	dart->preserve_display = j713_display || j713_dcpext;
+	if (j713_dcpext)
+		dart->dcp_instance = &dcp_adt_external[res->start == 0x48a340000ULL];
+	else if (j713_display)
+		dart->dcp_instance = &dcp_adt_internal;
 	if (tunneled) {
 		pd_np = of_parse_phandle(dev->of_node, "power-domains", 0);
 		if (pd_np) {
@@ -4137,7 +4162,13 @@ static int apple_dart_probe(struct platform_device *pdev)
 		}
 	}
 
-	if (dart->preserve_display || j713_radio) {
+	if (j713_dcpext) {
+		/*
+		 * Its fault IRQ is shared with the external display DART, which is
+		 * not admitted: never enable that level IRQ for one block alone.
+		 */
+		dart->irq = -1;
+	} else if (dart->preserve_display || j713_radio) {
 		dart->irq = platform_get_irq_optional(pdev, 0);
 		if (dart->irq == -ENXIO)
 			dart->irq = -1;
@@ -4361,8 +4392,8 @@ params_done:
 		}
 		dev_info(dev, "Retained display DART version %04x, locked %d\n",
 			 dart->version, dart->locked);
-		ret = res->start == 0x30a340000ULL ? apple_dart_dcp_prepare(dart) :
-			apple_dart_frontend_prepare(dart);
+		ret = res->start == 0x30a340000ULL || j713_dcpext ?
+			apple_dart_dcp_prepare(dart) : apple_dart_frontend_prepare(dart);
 		if (ret)
 			goto err_clk_disable;
 	}
