From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 4 Nov 2026 22:27:42 -0500
Subject: [PATCH] dt-bindings: display: apple,dcp: add the T8132 external
 display coprocessors

The J713's two external display coprocessors (T8132) run the internal
DCP's firmware. The boot loader can hand them over running; it then marks
them with apple,t8132-dcpext-firmware-ready. Add their compatible and that
property. Like the internal T8132 DCP they have no PMGR bandwidth scratch
register, and like the T6030 external DCPs they name the DP IN tunnel
states of each Type-C crossbar.

Signed-off-by: Erik Bourget <erik@ebourget.net>

(backported from commit 6024a37b93b77483224ab7fbd74c134a3a6b1008)
[j604: this tree has no T6030 external DCP binding (1e4e813f64): the DP IN tunnel names are allowed for apple,t8132-dcpext only, all other DCPs keep 8 mux controls named dp-xbar/typecN, as in the source tree]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 .../bindings/display/apple,dcp.yaml           | 40 +++++++++++++++++--
 1 file changed, 36 insertions(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/display/apple,dcp.yaml b/Documentation/devicetree/bindings/display/apple,dcp.yaml
index 6c56f77873..b4cbe622ca 100644
--- a/Documentation/devicetree/bindings/display/apple,dcp.yaml
+++ b/Documentation/devicetree/bindings/display/apple,dcp.yaml
@@ -41,6 +41,12 @@ properties:
           session uses IOMFB 26.6.2. The loader publishes the firmware identity,
           reserved memory and validated display DART mappings.
         const: apple,t8132-dcp
+      - description:
+          J713 external display coprocessors (T8132), running the internal
+          DCP's firmware. The boot loader can hand them over running; it then
+          reserves their firmware memory, publishes the firmware identity and
+          sets apple,t8132-dcpext-firmware-ready.
+        const: apple,t8132-dcpext
 
   reg:
     minItems: 2
@@ -207,6 +213,14 @@ properties:
     maxItems: 5
     description: Loader-provided firmware ABI version used for IOMFB selection.
 
+  apple,t8132-dcpext-firmware-ready:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [0, 1]
+    description:
+      Set to 1 by the boot loader once it has handed a T8132 external display
+      coprocessor over running, with its firmware memory reserved. Without
+      it the coprocessor is left alone.
+
   apple,connector-type:
     enum: [HDMI-A, DP, USB-C]
 
@@ -247,13 +261,16 @@ properties:
   mux-controls:
     $ref: /schemas/types.yaml#/definitions/phandle-array
     minItems: 1
-    maxItems: 8
+    maxItems: 10
+    description: |
+      T8132 external DCPs may also name the two DP IN tunnel states of each
+      Type-C crossbar, in addition to the fixed output and Type-C routes.
 
   mux-control-names:
     minItems: 1
-    maxItems: 8
+    maxItems: 10
     items:
-      pattern: '^(dp-xbar|typec[0-9]+)$'
+      pattern: '^(dp-xbar|typec[0-9]+(-dpin[01])?)$'
 
   mux-index:
     $ref: /schemas/types.yaml#/definitions/uint32
@@ -354,12 +371,27 @@ required:
   - iommus
 
 allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8132-dcpext
+      required:
+        - compatible
+    else:
+      properties:
+        mux-controls:
+          maxItems: 8
+        mux-control-names:
+          maxItems: 8
+          items:
+            pattern: '^(dp-xbar|typec[0-9]+)$'
   - if:
       not:
         properties:
           compatible:
             contains:
-              const: apple,t8132-dcp
+              enum: ['apple,t8132-dcp', 'apple,t8132-dcpext']
     then:
       required:
         - apple,bw-scratch
