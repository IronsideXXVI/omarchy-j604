From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 21:56:43 +0000
Subject: [PATCH] accel/ane: pm: hand back the runtime-PM votes a
 device's links hold

The IOMMU core links every consumer to each of its DARTs with
DL_FLAG_PM_RUNTIME | DL_FLAG_RPM_ACTIVE. That leaves one runtime-PM vote
on every DART until the consumer first runtime-suspends. A backend that
votes for its DARTs and power domains itself, and never enables runtime
PM on the device, keeps those votes for as long as it is bound.

Add ane_pm_drop_link_votes(): enable runtime PM (device-managed), resume
once and suspend once. The suspend releases every vote a link holds above
its own; explicit votes on the suppliers work as before.

Test it against the runtime-PM and device-link core with three DART-like
suppliers: without it each supplier keeps the link's vote and stays
active; with it each one suspends and an explicit vote still powers it; a
consumer whose suspend fails keeps the votes and the error is returned.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
(cherry picked from commit 90284fb38c9b249828c52a648e41b15cf4b409e8)
(cherry picked from commit 906e62f9db838cbbec0fd5c3df9dc62b8c9d8eab)
---
 drivers/accel/ane/ane_pm.h      |  27 +++++++++
 drivers/accel/ane/ane_pm_test.c | 100 ++++++++++++++++++++++++++++++++
 2 files changed, 127 insertions(+)

diff --git a/drivers/accel/ane/ane_pm.h b/drivers/accel/ane/ane_pm.h
index ccc08c8805..a54a0e1fa0 100644
--- a/drivers/accel/ane/ane_pm.h
+++ b/drivers/accel/ane/ane_pm.h
@@ -48,4 +48,31 @@ resume:
 	return err < 0 ? err : (resume_err < 0 ? resume_err : 0);
 }
 
+/*
+ * The IOMMU core links a consumer to each of its DARTs with
+ * DL_FLAG_PM_RUNTIME | DL_FLAG_RPM_ACTIVE, which leaves one runtime-PM vote on
+ * every DART until the consumer first runtime-suspends. A backend that votes
+ * for its DARTs and domains itself and never enables runtime PM on the device
+ * keeps those votes for as long as it is bound, and with them the DARTs' power
+ * domain. Enable runtime PM (device-managed), resume once and suspend once:
+ * the suspend releases every vote a link holds above its own, and explicit
+ * votes on the suppliers keep working.
+ *
+ * Call once per binding, from probe. Returns 0 with @dev runtime-suspended and
+ * holding no reference, or a negative error; the votes may then remain.
+ */
+static inline int ane_pm_drop_link_votes(struct device *dev)
+{
+	int err;
+
+	err = devm_pm_runtime_enable(dev);
+	if (err)
+		return err;
+	err = pm_runtime_resume_and_get(dev);
+	if (err < 0)
+		return err;
+	err = pm_runtime_put_sync_suspend(dev);
+	return err < 0 ? err : 0;
+}
+
 #endif /* __ANE_PM_H__ */
diff --git a/drivers/accel/ane/ane_pm_test.c b/drivers/accel/ane/ane_pm_test.c
index 5c372a2a73..e26c44c36d 100644
--- a/drivers/accel/ane/ane_pm_test.c
+++ b/drivers/accel/ane/ane_pm_test.c
@@ -228,6 +228,103 @@ static void ane_pm_cycle_resume_error_test(struct kunit *test)
 	pm_runtime_put_noidle(ctx.consumer);
 }
 
+#define ANE_PM_TEST_DARTS 3
+
+struct ane_pm_link_ctx {
+	struct device *consumer;
+	struct device *darts[ANE_PM_TEST_DARTS];
+	struct device_link *links[ANE_PM_TEST_DARTS];
+};
+
+/*
+ * A bound H16 device as the IOMMU core leaves it: runtime PM disabled and one
+ * DL_FLAG_RPM_ACTIVE link to each of its three DARTs.
+ */
+static int ane_pm_link_setup(struct kunit *test, struct ane_pm_link_ctx *ctx)
+{
+	static const char * const names[] = { "ane-pm-dart0", "ane-pm-dart1", "ane-pm-dart2" };
+
+	ctx->consumer = ane_pm_test_register(test, "ane-pm-h16");
+	if (!ctx->consumer)
+		return -ENOMEM;
+	pm_runtime_disable(ctx->consumer);
+	for (int i = 0; i < ANE_PM_TEST_DARTS; i++) {
+		ctx->darts[i] = ane_pm_test_register(test, names[i]);
+		if (!ctx->darts[i])
+			return -ENOMEM;
+		ctx->links[i] = device_link_add(ctx->consumer, ctx->darts[i],
+						DL_FLAG_STATELESS | DL_FLAG_PM_RUNTIME |
+						DL_FLAG_RPM_ACTIVE);
+		if (!ctx->links[i])
+			return -ENOMEM;
+		if (kunit_add_action_or_reset(test, ane_pm_test_unlink, ctx->links[i]))
+			return -ENOMEM;
+	}
+	return 0;
+}
+
+/* Without the helper every DART keeps the link's vote and stays active. */
+static void ane_pm_link_votes_kept_test(struct kunit *test)
+{
+	struct ane_pm_link_ctx ctx = {};
+
+	KUNIT_ASSERT_EQ(test, ane_pm_link_setup(test, &ctx), 0);
+	for (int i = 0; i < ANE_PM_TEST_DARTS; i++) {
+		KUNIT_EXPECT_EQ(test, refcount_read(&ctx.links[i]->rpm_active), 2U);
+		KUNIT_EXPECT_EQ(test, atomic_read(&ctx.darts[i]->power.usage_count), 1);
+		KUNIT_EXPECT_EQ(test, pm_runtime_suspend(ctx.darts[i]), -EAGAIN);
+		KUNIT_EXPECT_TRUE(test, pm_runtime_active(ctx.darts[i]));
+	}
+}
+
+/*
+ * One resume and one suspend of the consumer hand the votes back: each DART
+ * then suspends, and an explicit vote (as ane_h16_acquire() takes) still
+ * powers it.
+ */
+static void ane_pm_drop_link_votes_test(struct kunit *test)
+{
+	struct ane_pm_link_ctx ctx = {};
+	struct ane_pm_test_dev *c;
+
+	KUNIT_ASSERT_EQ(test, ane_pm_link_setup(test, &ctx), 0);
+	c = container_of(ctx.consumer, struct ane_pm_test_dev, dev);
+	KUNIT_EXPECT_EQ(test, ane_pm_drop_link_votes(ctx.consumer), 0);
+	KUNIT_EXPECT_TRUE(test, pm_runtime_enabled(ctx.consumer));
+	KUNIT_EXPECT_TRUE(test, pm_runtime_suspended(ctx.consumer));
+	KUNIT_EXPECT_EQ(test, atomic_read(&ctx.consumer->power.usage_count), 0);
+	KUNIT_EXPECT_EQ(test, c->resumes, 1U);
+	KUNIT_EXPECT_EQ(test, c->suspends, 1U);
+	for (int i = 0; i < ANE_PM_TEST_DARTS; i++) {
+		KUNIT_EXPECT_EQ(test, refcount_read(&ctx.links[i]->rpm_active), 1U);
+		KUNIT_EXPECT_EQ(test, atomic_read(&ctx.darts[i]->power.usage_count), 0);
+		KUNIT_EXPECT_GE(test, pm_runtime_suspend(ctx.darts[i]), 0);
+		KUNIT_EXPECT_TRUE(test, pm_runtime_suspended(ctx.darts[i]));
+		KUNIT_EXPECT_GE(test, pm_runtime_resume_and_get(ctx.darts[i]), 0);
+		KUNIT_EXPECT_TRUE(test, pm_runtime_active(ctx.darts[i]));
+		KUNIT_EXPECT_GE(test, pm_runtime_put_sync_suspend(ctx.darts[i]), 0);
+		KUNIT_EXPECT_TRUE(test, pm_runtime_suspended(ctx.darts[i]));
+	}
+}
+
+/* A consumer whose suspend fails keeps the votes, and the error is returned. */
+static void ane_pm_drop_link_votes_error_test(struct kunit *test)
+{
+	struct ane_pm_link_ctx ctx = {};
+	struct ane_pm_test_dev *c;
+
+	KUNIT_ASSERT_EQ(test, ane_pm_link_setup(test, &ctx), 0);
+	c = container_of(ctx.consumer, struct ane_pm_test_dev, dev);
+	c->suspend_error = -EBUSY;
+	KUNIT_EXPECT_EQ(test, ane_pm_drop_link_votes(ctx.consumer), -EBUSY);
+	KUNIT_EXPECT_TRUE(test, pm_runtime_active(ctx.consumer));
+	for (int i = 0; i < ANE_PM_TEST_DARTS; i++) {
+		KUNIT_EXPECT_EQ(test, pm_runtime_suspend(ctx.darts[i]), -EAGAIN);
+		KUNIT_EXPECT_TRUE(test, pm_runtime_active(ctx.darts[i]));
+	}
+	c->suspend_error = 0;
+}
+
 static struct kunit_case ane_pm_test_cases[] = {
 	KUNIT_CASE(ane_pm_cycle_domains_test),
 	KUNIT_CASE(ane_pm_cycle_single_test),
@@ -235,6 +332,9 @@ static struct kunit_case ane_pm_test_cases[] = {
 	KUNIT_CASE(ane_pm_cycle_supplier_error_test),
 	KUNIT_CASE(ane_pm_cycle_verify_error_test),
 	KUNIT_CASE(ane_pm_cycle_resume_error_test),
+	KUNIT_CASE(ane_pm_link_votes_kept_test),
+	KUNIT_CASE(ane_pm_drop_link_votes_test),
+	KUNIT_CASE(ane_pm_drop_link_votes_error_test),
 	{}
 };
 
