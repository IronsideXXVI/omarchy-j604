From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AxxzyWasTaken <axxzytte@gmail.com>
Date: Tue, 3 Nov 2026 17:24:23 +0000
Subject: [PATCH] drm/apple: tell the PM core no VT switch is needed for system
 sleep

The display restores its own state across suspend, so switching to the
text console first only flashes the kernel log on every suspend/resume.

Signed-off-by: AxxzyWasTaken <axxzytte@gmail.com>
(cherry picked from commit 3543be41e12d779fe5c1dc5bc330dbcd39ce85bf)
Assisted-by: Claude:claude-opus-5.5
---
 drivers/gpu/drm/apple/apple_drv.c | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/apple/apple_drv.c b/drivers/gpu/drm/apple/apple_drv.c
index 745127658e..9dce123c39 100644
--- a/drivers/gpu/drm/apple/apple_drv.c
+++ b/drivers/gpu/drm/apple/apple_drv.c
@@ -42,6 +42,7 @@
 #include <drm/drm_probe_helper.h>
 #include <drm/drm_vblank.h>
 #include <drm/drm_fixed.h>
+#include <linux/pm.h>
 
 #include "apple_boot_display.h"
 #include "apple_resume.h"
@@ -1370,18 +1371,29 @@ static int apple_platform_probe(struct platform_device *pdev)
 {
 	struct device *mdev = &pdev->dev;
 	struct component_match *match = NULL;
-	int num_dcp;
+	int num_dcp, ret;
 
 	/* add DCP components, handle less than 1 as probe error */
 	num_dcp = add_dcp_components(mdev, &match);
 	if (num_dcp < 1)
 		return -ENODEV;
 
-	return component_master_add_with_match(mdev, &apple_drm_ops, match);
+	ret = component_master_add_with_match(mdev, &apple_drm_ops, match);
+	if (ret)
+		return ret;
+
+	/*
+	 * The display restores its own state across system sleep, so the PM
+	 * core need not switch to the text console first (which flashes the
+	 * kernel log on screen on every suspend and resume).
+	 */
+	pm_vt_switch_required(mdev, false);
+	return 0;
 }
 
 static void apple_platform_remove(struct platform_device *pdev)
 {
+	pm_vt_switch_unregister(&pdev->dev);
 	component_master_del(&pdev->dev, &apple_drm_ops);
 }
 
