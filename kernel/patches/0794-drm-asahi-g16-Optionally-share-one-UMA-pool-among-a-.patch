From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 12:37:24 +0000
Subject: [PATCH] drm/asahi: g16: Optionally share one UMA pool among a
 VM's compute units

Each compute unit of a VM carries its own 32 MiB UMA pool, and the
number of compute commands that can be in flight is the number of
units. Going deeper than the unit count needs units that do not each
bring a pool.

The firmware runs every compute command in the one compute ring, in
order, so only one compute command at a time allocates from a pool.
Add g16_compute_shared_pool: with 1, every unit's allocator descriptor
names unit 0's freelist and pool table. Each command keeps its own
work, descriptor, UMA slot, completion counter, context store and
preemption buffer, so nothing a running command owns is shared with a
queued one. The option is read once, at the first compute command, so
all descriptors of a run name the same pool, and the statistics line
shows its state.

The default of 0 keeps one pool per unit; nothing changes unless the
option is set.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/engine.rs | 10 ++++++--
 drivers/gpu/drm/asahi/g16/params.rs | 38 +++++++++++++++++++++++++++++
 drivers/gpu/drm/asahi/g16/poll.rs   |  9 +++++--
 3 files changed, 53 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 77de0b6696..0886148bad 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -1627,6 +1627,12 @@ fn prefix_compute(
         let generation = job.vm.generation;
         self.slots.hold_vm(&f.claims, &job.vm)?;
         let s = &job.resources.compute()?.compute[index];
+        // `g16_compute_shared_pool`: the freelist and pool table of unit 0 serve every unit.
+        let pool = if super::params::compute_shared_pool() {
+            &job.resources.compute()?.compute[0]
+        } else {
+            s
+        };
         let g = &self.graph.compute;
         let before = s.counter.r64(0)?;
         let submitted = before.checked_add(1).ok_or(EOVERFLOW)?;
@@ -1646,8 +1652,8 @@ fn prefix_compute(
             auxiliary_gva: s.aux.gva.ok_or(EINVAL)?,
             context_store_gva: s.context_store.gva.ok_or(EINVAL)?,
             counter_fw: s.counter.va,
-            pool_state_gva: s.pool_state.gva.ok_or(EINVAL)?,
-            page_list_gva: s.page_list.gva.ok_or(EINVAL)?,
+            pool_state_gva: pool.pool_state.gva.ok_or(EINVAL)?,
+            page_list_gva: pool.page_list.gva.ok_or(EINVAL)?,
             usc_base: job.queue.usc_base,
             record_fw: g.notifier.va + notifier_page::COMPUTE_RECORD as u64,
             binding_generation: generation,
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 9dd447764d..adfd063cfa 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -629,6 +629,44 @@ pub(crate) fn compute_units() -> usize {
     "G16: compute units per VM, one compute command in flight each (default 12; 2..16; 8 = before; 4 = k908; 9..16 = deeper compute queue, ~33 MiB per unit, 13..16 for g16_horizon up to 15; latched at the engine start, set it as a module option)"
 );
 
+/// Storage of `g16_compute_shared_pool` (0644, default 0; latched at its first read).
+static COMPUTE_SHARED_POOL: AtomicU32 = AtomicU32::new(0);
+/// 0 until latched, then 1 (off) or 2 (on).
+static COMPUTE_SHARED_POOL_LATCH: AtomicU32 = AtomicU32::new(0);
+
+/// Every compute unit of a VM allocates from unit 0's UMA freelist and pool table instead of
+/// its own. Each command keeps its own work, allocator descriptor, UMA slot, completion
+/// counter and context store. The firmware runs the one compute ring in order, so only one
+/// command at a time allocates from the shared pool. Read once, at the first compute command,
+/// so every descriptor of a run names the same pool.
+pub(crate) fn compute_shared_pool() -> bool {
+    let l = COMPUTE_SHARED_POOL_LATCH.load(Ordering::Acquire);
+    if l != 0 {
+        return l == 2;
+    }
+    let v = if COMPUTE_SHARED_POOL.load(Ordering::Relaxed) != 0 {
+        2
+    } else {
+        1
+    };
+    let _ = COMPUTE_SHARED_POOL_LATCH.compare_exchange(0, v, Ordering::AcqRel, Ordering::Acquire);
+    COMPUTE_SHARED_POOL_LATCH.load(Ordering::Acquire) == 2
+}
+
+/// The latch as the statistics print it: 0 not yet read, 1 off, 2 on (reading it latches nothing).
+pub(crate) fn compute_shared_pool_state() -> u32 {
+    COMPUTE_SHARED_POOL_LATCH.load(Ordering::Relaxed)
+}
+
+live_u32_param!(
+    COMPUTE_SHARED_POOL_PARAM,
+    COMPUTE_SHARED_POOL_PARMTYPE,
+    COMPUTE_SHARED_POOL_PARM,
+    COMPUTE_SHARED_POOL,
+    "g16_compute_shared_pool",
+    "G16: 1 = all compute units of a VM allocate from unit 0's UMA pool, each command keeping its own descriptor, UMA slot and context store (default 0: one pool per unit; latched at the first compute command, set it as a module option)"
+);
+
 live_u32_param!(
     HORIZON_PARAM,
     HORIZON_PARMTYPE,
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index cc82ba9e43..4c46ac2f4e 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -1557,8 +1557,13 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
         }
         writeln!(
             f,
-            "cstore: req {} compl {} last {:#x} cq_n {} cq_overlap {}",
-            s.cstore_req, s.cstore_compl, s.cstore_last, s.cq_n, s.cq_overlap
+            "cstore: req {} compl {} last {:#x} cq_n {} cq_overlap {} shared_pool {}",
+            s.cstore_req,
+            s.cstore_compl,
+            s.cstore_last,
+            s.cq_n,
+            s.cq_overlap,
+            super::params::compute_shared_pool_state()
         )?;
         writeln!(
             f,
-- 
