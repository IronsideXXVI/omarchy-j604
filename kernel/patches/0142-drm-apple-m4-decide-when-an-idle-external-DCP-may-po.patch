index 931ca172f7..4038090808 100644
--- a/drivers/gpu/drm/apple/Makefile
+++ b/drivers/gpu/drm/apple/Makefile
@@ -36,6 +36,7 @@ appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += dcp-m4-frame-test.o
 appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += dcp-m4-xdr-test.o
 appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += dcp-m4-ext-colour-test.o
 appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += dcp-m4-ext-sink-test.o
+appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += dcp-m4-ext-idle-test.o
 appledrm-y += iomfb_v26_6.o iomfb_v26_6_link.o j613_dcp_activate.o
 appledrm-y += epic/dpavservep.o
