From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 14:43:44 +0000
Subject: [PATCH] drm/asahi: g16: Show the GFX power-state word in
 fwpower

The firmware can report itself powered down while the GPU's power
domain stays fully on. The domain's PMGR word says why only in full:
the actual state, the target, whether automatic power management is
enabled and its lowest state, the busy bit and the sticky history
bits. So far it could only be read from outside the driver, through
/dev/mem.

Add the word to aurora-g16/fwpower as `ps`, read through the PMGR
regmap the probe already checks it with. The read changes nothing.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/poll.rs | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 4ffd15c875..16a5c85873 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -93,6 +93,8 @@ pub(crate) struct FwPower {
     /// A read-only view of the loaded firmware DATA segment from the firmware VA
     /// [`PRIVATE_VA`] on: the words the firmware's idle decision tests (25G83 b000).
     private: Option<super::regs::Mapping>,
+    /// The GPU device, for the PMGR GFX power-state word (`ps`).
+    dev: kernel::sync::aref::ARef<kernel::device::Device>,
 }
 
 /// The loaded DATA segment starts at firmware VA 0x60000 (the boot owner writes the loader
@@ -120,7 +122,10 @@ pub(crate) struct FwPower {
 /// (0x9208 over the bitmaps at 0x145c38). `floor` / `cap`: the reason code and value (state x 100)
 /// of the performance floor and ceiling the firmware chose last (POWER_PERFORMANCE +0x3c/+0x40,
 /// +0x44/+0x48, written by 0x1605c: 2, 3, 4, 8, 0x10, 0xc name the limiter that binds; 8 is the
-/// power budget +0xaf0). `t` is the architectural counter at the read.
+/// power budget +0xaf0). `ps`: the GFX domain's PMGR power-state word, read through the PMGR
+/// regmap (bit 28 automatic power management, 27:24 its lowest state, 11 busy, 9:8 sticky history,
+/// 7:4 actual, 3:0 target); `0xdeadbeef` when it can't be read. `t` is the architectural counter
+/// at the read.
 fn fwpower_show(v: &FwPower, f: &mut fmt::Formatter<'_>) -> fmt::Result {
     let [pp, power, control, globals] = &v.objects;
     let r = |o: &FwObject, at: usize| o.r32(at).unwrap_or(0xdead_beef);
@@ -141,6 +146,7 @@ fn fwpower_show(v: &FwPower, f: &mut fmt::Formatter<'_>) -> fmt::Result {
         | ((a(0x68) | a(0x78) | a(0x88)) & (a(8) | a(0x38)));
     let b = |o: usize| p(0x14_5c48 + o);
     let q2 = (b(0) | b(8) | b(0x10) | b(0x18)) | (b(0x60) & b(0x110)) | (b(0x68) & b(0x118));
+    let ps = super::boot::glue::power_domain_state(&v.dev).map_or(0xdead_beef, |(_, w)| w);
     let pending = v
         .rings
         .iter()
@@ -153,7 +159,7 @@ fn fwpower_show(v: &FwPower, f: &mut fmt::Formatter<'_>) -> fmt::Result {
          retries {} defer {} defer_t {} seq {} veto {} req {} hi {} \
          ctl {:#x}/{:#x}/{:#x}/{:#x}/{:#x} g {}/{}/{}/{}/{} rings {:#x} \
          fw {:#x}/{:#x}/{:#x}/{:#x} st {:#x} ipo {:#x} q {:#x}/{:#x} \
-         floor {}/{} cap {}/{}",
+         floor {}/{} cap {}/{} ps {:#x}",
         counter_ticks(),
         r(pp, 0x10),
         r(pp, 0xc),
@@ -192,7 +198,8 @@ fn fwpower_show(v: &FwPower, f: &mut fmt::Formatter<'_>) -> fmt::Result {
         r(pp, 0x3c),
         r(pp, 0x40),
         r(pp, 0x44),
-        r(pp, 0x48)
+        r(pp, 0x48),
+        ps
     )
 }
 
@@ -477,6 +484,7 @@ pub(crate) fn start_engine(self: &Arc<Self>) -> Result {
                 objects,
                 rings,
                 private,
+                dev: self.dev.clone(),
             };
             let file = KBox::pin_init(
                 dir.read_callback_file(c_str!("fwpower"), view, &fwpower_show),
-- 
2.43.0

