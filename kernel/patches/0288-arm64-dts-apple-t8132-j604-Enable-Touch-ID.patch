From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 03:12:19 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: Enable Touch ID

Add the sep alias, so m1n1 reserves the SEP firmware and publishes the
local-policy and iBoot manifests the SEP driver needs, and enable the
SEP mailbox, spi2 (and its power state) and the Mesa sensor with the
J604 ADT's wiring: power on NUB GPIO 28, data-ready on AP GPIO 199,
8 MHz, chip select 0. The ADT names the sensor "R3", J613's
generation, so it runs in SPI mode 1 rather than the mode 2 the T8132
node carries for J713's V3 sensor. The SEP itself stays off until
apple_sep loads, and nothing loads it until the owner turns Touch ID
on.

Gate before shipping: m1n1 fails the boot if the sep alias is present
and the live ADT has no /chosen/memory-map SEPFW, so the J604's live
ADT must show SEPFW first ( probe C).

Not yet run on the J604.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../arm64/boot/dts/apple/t8132-j604-pmgr.dtsi |  2 +-
 arch/arm64/boot/dts/apple/t8132-j604.dts      | 30 +++++++++++++++++++
 2 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
index 0cb60a3dcf..9faebd17bc 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
@@ -205,7 +205,7 @@
 };
 
 &ps_spi2 {
-	status = "disabled";
+	status = "okay";
 };
 
 &ps_spi3 {
diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 56ed897c4d..df5a180944 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -24,6 +24,7 @@
 	chassis-type = "laptop";
 
 	aliases {
+		sep = &sep;
 		atcphy0 = &atcphy0;
 		atcphy1 = &atcphy1;
 		atcphy3 = &atcphy3;
@@ -854,3 +855,32 @@
 		ti,vmon-slot-no = <22>;
 	};
 };
+
+/*
+ * Touch ID: the Mesa sensor on spi2 (J604 ADT /arm-io/spi2/mesa): power on
+ * NUB GPIO 28, active high; data-ready on AP GPIO 199. Native chip select
+ * only. The ADT names the sensor "R3", J613's generation, so it runs in
+ * J613's SPI mode 1 (spi-cpha), not the mode 2 the T8132 node defaults to
+ * for J713's V3 sensor. apple_sep enables the SEP and its DART itself when
+ * it loads; it loads only once the owner turns Touch ID on.
+ */
+&sep_mbox {
+	status = "okay";
+};
+
+&spi2 {
+	status = "okay";
+};
+
+&mesa {
+	status = "okay";
+	/delete-property/ spi-cpol;
+	spi-cpha;
+	enable-gpios = <&pinctrl_nub 28 GPIO_ACTIVE_HIGH>;
+	interrupt-parent = <&pinctrl_ap>;
+	interrupts = <199 IRQ_TYPE_EDGE_RISING>;
+	spi-cs-setup-delay-ns = <20>;
+	spi-cs-hold-delay-ns = <20>;
+	/* Per-device factory data from this Mac's own iBoot system container. */
+	firmware-name = "apple/mesacal-j604.bin";
+};
