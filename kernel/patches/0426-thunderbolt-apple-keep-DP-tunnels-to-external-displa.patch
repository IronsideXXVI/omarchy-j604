From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 4 Nov 2026 22:19:15 -0500
Subject: [PATCH] thunderbolt: apple: keep DP tunnels to external displays
 across suspend-to-idle

With the routers awake through suspend-to-idle, the tunnels are kept only
if the PCIe-C tunnel's link was kept; otherwise tb_suspend_noirq() releases
the DP tunnels. Releasing a DP tunnel from an Apple host DP IN adapter has
its DCP release the display route (its locks, firmware calls and waits) in
the noirq phase, with the DCP already suspended.

With a DP tunnel from an Apple host DP IN adapter up, keep the tunnels
across the sleep: the routers stay awake. If a PCIe-C tunnel exists whose
link is not kept, it is rebuilt at resume, which would tear down the others
too: refuse the sleep (-EBUSY, logged) instead. With router_sleep set the
routers sleep and every tunnel goes, so the sleep is refused while such a
DP tunnel is up.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 604dd3bd1c4fb876655181f168289624098751b4)
---
 drivers/thunderbolt/apple.c | 33 +++++++++++++++++++++++++++++++++
 drivers/thunderbolt/tb.c    | 21 +++++++++++++++++++++
 drivers/thunderbolt/tb.h    |  2 ++
 3 files changed, 56 insertions(+)

diff --git a/drivers/thunderbolt/apple.c b/drivers/thunderbolt/apple.c
index 96b1aafd3a..6132585975 100644
--- a/drivers/thunderbolt/apple.c
+++ b/drivers/thunderbolt/apple.c
@@ -2351,6 +2351,18 @@ static bool apple_nhi_pcie_link_kept(struct apple_cio *acio)
 	return kept;
 }
 
+/* Whether this port has a PCIe-C tunnel host at all. */
+static bool apple_nhi_has_pcie_tunnel(struct apple_cio *acio)
+{
+	struct platform_device *pcie_pdev;
+
+	guard(mutex)(&acio->pcie_tunnel_lock);
+	pcie_pdev = apple_cio_find_pcie_tunnel(acio);
+	if (pcie_pdev)
+		put_device(&pcie_pdev->dev);
+	return pcie_pdev;
+}
+
 static int apple_nhi_suspend_noirq(struct device *dev)
 {
 	struct apple_nhi *anhi = dev_get_drvdata(dev);
@@ -2361,6 +2373,27 @@ static int apple_nhi_suspend_noirq(struct device *dev)
 		/* PCIe-C suspends first; its tunnel must then survive resume. */
 		if (apple_nhi_pcie_link_kept(anhi->acio))
 			anhi->nhi.quirks |= QUIRK_KEEP_TUNNELS;
+		/*
+		 * A DP tunnel to an external display behind a dock is never
+		 * released here: that would have its DCP release the route (its
+		 * locks, AFK calls and waits) with the DCP already suspended. With
+		 * the routers awake every tunnel stays as it is: keep them all,
+		 * unless a PCIe-C tunnel's link is not kept (it is then rebuilt at
+		 * resume, which tears down the others too): refuse the sleep.
+		 */
+		if (!(anhi->nhi.quirks & QUIRK_KEEP_TUNNELS) &&
+		    tb_has_apple_host_dp_tunnel(anhi->tb)) {
+			if (apple_nhi_has_pcie_tunnel(anhi->acio)) {
+				dev_warn(dev, "refusing system sleep: a DP tunnel to an external display cannot be kept (the PCIe-C link is not kept)\n");
+				return -EBUSY;
+			}
+			anhi->nhi.quirks |= QUIRK_KEEP_TUNNELS;
+			dev_dbg(dev, "tunnels kept across sleep for an external display\n");
+		}
+	} else if (tb_has_apple_host_dp_tunnel(anhi->tb)) {
+		/* The routers sleep: the DP tunnels would go here, see above. */
+		dev_warn(dev, "refusing system sleep: a DP tunnel to an external display is up and router_sleep is set\n");
+		return -EBUSY;
 	}
 
 	return tb_domain_suspend_noirq(anhi->tb);
diff --git a/drivers/thunderbolt/tb.c b/drivers/thunderbolt/tb.c
index ec5a3f67f1..60189c9cab 100644
--- a/drivers/thunderbolt/tb.c
+++ b/drivers/thunderbolt/tb.c
@@ -3272,6 +3272,27 @@ static int tb_start(struct tb *tb, bool reset)
 	return 0;
 }
 
+/*
+ * Whether a DP tunnel from an Apple host router's DP IN adapter (an external
+ * display through a dock) is up. Takes the domain lock.
+ */
+bool tb_has_apple_host_dp_tunnel(struct tb *tb)
+{
+	struct tb_cm *tcm = tb_priv(tb);
+	struct tb_tunnel *tunnel;
+	bool found = false;
+
+	mutex_lock(&tb->lock);
+	list_for_each_entry(tunnel, &tcm->tunnel_list, list)
+		if (tb_tunnel_is_dp(tunnel) && tb_port_is_apple_host_dpin(tunnel->src_port)) {
+			found = true;
+			break;
+		}
+	mutex_unlock(&tb->lock);
+	return found;
+}
+EXPORT_SYMBOL_FOR_MODULES(tb_has_apple_host_dp_tunnel, "thunderbolt_apple");
+
 static int tb_suspend_noirq(struct tb *tb)
 {
 	struct tb_cm *tcm = tb_priv(tb);
diff --git a/drivers/thunderbolt/tb.h b/drivers/thunderbolt/tb.h
index 9c2269f1df..ce0dca3a33 100644
--- a/drivers/thunderbolt/tb.h
+++ b/drivers/thunderbolt/tb.h
@@ -1144,6 +1144,8 @@ static inline bool tb_port_is_apple_host_dpin(const struct tb_port *port)
 	return tb->nhi->host_dp_policy & TB_HOST_DP_NOTIFY;
 }
 
+bool tb_has_apple_host_dp_tunnel(struct tb *tb);
+
 static inline bool tb_port_needs_host_dp_credits(const struct tb_port *port)
 {
 	const struct tb *tb = port->sw->tb;
