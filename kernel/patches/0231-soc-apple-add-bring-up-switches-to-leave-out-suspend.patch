From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 06:42:20 +0000
Subject: [PATCH] soc: apple: add bring-up switches to leave out
 suspend-to-RAM notices

A suspend-to-RAM on the J604 resets the machine. The kernel's pm_test
puts the fault in the devices stage: it resets with mem and survives
with suspend-to-idle at the same stage. In that stage only three things
differ for suspend-to-RAM and talk to firmware: the SMC sleep warning
(MBSE = slpw), the AP idle notice to the MTP coprocessor, and the sleep
host state to the MTP input firmware.

Add one runtime switch for each, default off, so a test can leave one
out at a time:

  macsmc.debug_skip_sleep_warn
  apple_rtkit_helper.debug_skip_ap_notice
  dockchannel_hid.debug_skip_host_sleep

With a switch off (the default) nothing changes. A sleep with one on is
for locating the fault only.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/hid/dockchannel-hid/dockchannel-hid.c | 11 ++++++++++-
 drivers/mfd/macsmc.c                          | 13 ++++++++++++-
 drivers/soc/apple/rtkit-helper.c              | 11 ++++++++++-
 3 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid.c b/drivers/hid/dockchannel-hid/dockchannel-hid.c
index fcdcdc1d2c..35a431cbe5 100644
--- a/drivers/hid/dockchannel-hid/dockchannel-hid.c
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid.c
@@ -1790,6 +1790,15 @@ static void dockchannel_hid_remove(struct platform_device *pdev)
  * helper's .resume has sent the on notice, the device link ordering the two. That
  * is macOS's order.
  */
+/*
+ * Bring-up: do not tell the input firmware the host sleeps for a
+ * suspend-to-RAM. Only for locating a sleep fault. Default off.
+ */
+static bool debug_skip_host_sleep;
+module_param(debug_skip_host_sleep, bool, 0644);
+MODULE_PARM_DESC(debug_skip_host_sleep,
+		 "Bring-up: do not send the sleep host state for a suspend-to-RAM, to locate sleep faults (default: off)");
+
 static int dockchannel_hid_suspend(struct device *dev)
 {
 	struct dockchannel_hid *dchid = dev_get_drvdata(dev);
@@ -1805,7 +1814,7 @@ static int dockchannel_hid_suspend(struct device *dev)
 		if (ret)
 			goto unwind;
 	}
-	if (pm_suspend_via_firmware()) {
+	if (pm_suspend_via_firmware() && !READ_ONCE(debug_skip_host_sleep)) {
 		/* A firmware that doesn't answer isn't a reason to stay awake. */
 		ret = dchid_host_state(dchid, HOST_STATE_SLEEP);
 		if (ret)
diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
index 548d6620ed..f19e7c2a53 100644
--- a/drivers/mfd/macsmc.c
+++ b/drivers/mfd/macsmc.c
@@ -943,11 +943,22 @@ static void apple_smc_sleep_wake(struct apple_smc *smc)
 		pm_wakeup_event(smc->dev, 0);
 }
 
+/*
+ * Bring-up: leave the SMC out of a suspend-to-RAM. Without the warning
+ * nothing of the SMC's sleep sequence is sent (the noirq commit and the wake
+ * follow from it). Only for locating a sleep fault; such a sleep cannot
+ * complete. Default off: nothing changes.
+ */
+static bool debug_skip_sleep_warn;
+module_param(debug_skip_sleep_warn, bool, 0644);
+MODULE_PARM_DESC(debug_skip_sleep_warn,
+		 "Bring-up: send the SMC nothing for a suspend-to-RAM, to locate sleep faults (default: off)");
+
 static int apple_smc_prepare(struct device *dev)
 {
 	struct apple_smc *smc = dev_get_drvdata(dev);
 
-	if (pm_suspend_via_firmware())
+	if (pm_suspend_via_firmware() && !READ_ONCE(debug_skip_sleep_warn))
 		apple_smc_sleep_warn(smc);
 
 	return 0;
diff --git a/drivers/soc/apple/rtkit-helper.c b/drivers/soc/apple/rtkit-helper.c
index 498d1413e1..feeaa6f758 100644
--- a/drivers/soc/apple/rtkit-helper.c
+++ b/drivers/soc/apple/rtkit-helper.c
@@ -400,11 +400,20 @@ static int apple_rtkit_helper_ap_power(struct apple_rtkit_helper *helper, bool o
 	return ret;
 }
 
+/*
+ * Bring-up: do not tell the coprocessor the AP goes idle for a sleep (nor, so,
+ * that it is on again). Only for locating a sleep fault. Default off.
+ */
+static bool debug_skip_ap_notice;
+module_param(debug_skip_ap_notice, bool, 0644);
+MODULE_PARM_DESC(debug_skip_ap_notice,
+		 "Bring-up: send no AP idle/on notice for a sleep, to locate sleep faults (default: off)");
+
 static int apple_rtkit_helper_ap_idle(struct apple_rtkit_helper *helper)
 {
 	int ret;
 
-	if (helper->ap_idle)
+	if (helper->ap_idle || READ_ONCE(debug_skip_ap_notice))
 		return 0;
 	ret = apple_rtkit_helper_ap_power(helper, false);
 	if (ret)
