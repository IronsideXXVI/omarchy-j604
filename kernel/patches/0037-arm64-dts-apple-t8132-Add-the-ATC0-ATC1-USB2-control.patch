From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 02:19:29 -0600
Subject: [PATCH] arm64: dts: apple: t8132: Add the ATC0/ATC1 USB2 controllers
 and SPMI A0

Describe the first two Type-C ports of T8132: the nub SPMI A0 bus that
carries their port controllers, the ATC0/ATC1 PHYs, the two DWC3 DARTs
of each port and the DWC3 controllers. All disabled; boards enable what
they wire.

The PHYs are USB2-only for now (apple,t8132-atcphy describes the USB2
PHY and the pipehandler, and DWC3 runs at high speed), as on
integration/aurora where the node layout comes from (c6b301adf, "arm64:
dts: apple: describe T8132 platform controllers", Eryk Wieliczko).
Unlike that tree, every node carries its ps_atcN_usb power domain, as
t8112.dtsi does, because no board pmgr policy owns these domains here.

Addresses and interrupts are the ones of the J604 and J713 Apple device
trees (26B123 and 25G83 templates; the nodes are identical on both
boards): atc-phyN reg[0], usb-drdN reg[0] (core and glue) and reg[3]
(pipehandler) and its first interrupt, dart-usbN reg[0..1] and interrupt,
nub-spmi-a0 reg[0] and its second interrupt.

Testing: dtc and dtbs_check only.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 118 +++++++++++++++++++++++++++
 1 file changed, 118 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 0fb1a20ba1..8d33fba5f4 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -8,6 +8,7 @@
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/apple-aic.h>
 #include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/phy/phy.h>
 #include <dt-bindings/pinctrl/apple.h>
 #include <dt-bindings/spmi/spmi.h>
 
@@ -541,6 +542,19 @@
 			status = "disabled";
 		};
 
+		nub_spmi_a0: spmi@388908000 {
+			compatible = "apple,t8132-spmi", "apple,t8103-spmi";
+			reg = <0x3 0x88908000 0x0 0x4000>;
+			#address-cells = <2>;
+			#size-cells = <0>;
+			#interrupt-cells = <2>;
+			interrupt-controller;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 520 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_nub_spmi_a0>;
+			status = "disabled";
+		};
+
 		smc_mbox: mailbox@38c608000 {
 			compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
 			reg = <0x3 0x8c608000 0x0 0x4000>;
@@ -570,6 +584,110 @@
 			};
 		};
 
+		atcphy0: phy@402a90000 {
+			compatible = "apple,t8132-atcphy";
+			reg = <0x4 0x02a90000 0x0 0x4000>,
+			      <0x4 0x02a84000 0x0 0x4000>;
+			reg-names = "usb2phy", "pipehandler";
+			#phy-cells = <1>;
+			#reset-cells = <0>;
+			orientation-switch;
+			mode-switch;
+			power-domains = <&ps_atc0_usb>;
+			status = "disabled";
+		};
+
+		dwc3_0_dart_0: iommu@402f00000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x02f00000 0x0 0xc000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1283 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			power-domains = <&ps_atc0_usb>;
+			status = "disabled";
+		};
+
+		dwc3_0_dart_1: iommu@402f80000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x02f80000 0x0 0xc000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1283 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			power-domains = <&ps_atc0_usb>;
+			status = "disabled";
+		};
+
+		dwc3_0: usb@402280000 {
+			compatible = "apple,t8132-dwc3";
+			reg = <0x4 0x02280000 0x0 0xcd00>,
+			      <0x4 0x0228cd00 0x0 0x3200>;
+			reg-names = "dwc3-core", "dwc3-apple";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1279 IRQ_TYPE_LEVEL_HIGH>;
+			dr_mode = "otg";
+			maximum-speed = "high-speed";
+			usb-role-switch;
+			role-switch-default-mode = "host";
+			iommus = <&dwc3_0_dart_0 0>, <&dwc3_0_dart_1 1>;
+			power-domains = <&ps_atc0_usb>;
+			resets = <&atcphy0>;
+			phys = <&atcphy0 PHY_TYPE_USB2>;
+			phy-names = "usb2-phy";
+			status = "disabled";
+		};
+
+		atcphy1: phy@40aa90000 {
+			compatible = "apple,t8132-atcphy";
+			reg = <0x4 0x0aa90000 0x0 0x4000>,
+			      <0x4 0x0aa84000 0x0 0x4000>;
+			reg-names = "usb2phy", "pipehandler";
+			#phy-cells = <1>;
+			#reset-cells = <0>;
+			orientation-switch;
+			mode-switch;
+			power-domains = <&ps_atc1_usb>;
+			status = "disabled";
+		};
+
+		dwc3_1_dart_0: iommu@40af00000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x0af00000 0x0 0xc000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1345 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			power-domains = <&ps_atc1_usb>;
+			status = "disabled";
+		};
+
+		dwc3_1_dart_1: iommu@40af80000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x0af80000 0x0 0xc000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1345 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			power-domains = <&ps_atc1_usb>;
+			status = "disabled";
+		};
+
+		dwc3_1: usb@40a280000 {
+			compatible = "apple,t8132-dwc3";
+			reg = <0x4 0x0a280000 0x0 0xcd00>,
+			      <0x4 0x0a28cd00 0x0 0x3200>;
+			reg-names = "dwc3-core", "dwc3-apple";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1341 IRQ_TYPE_LEVEL_HIGH>;
+			dr_mode = "otg";
+			maximum-speed = "high-speed";
+			usb-role-switch;
+			role-switch-default-mode = "host";
+			iommus = <&dwc3_1_dart_0 0>, <&dwc3_1_dart_1 1>;
+			power-domains = <&ps_atc1_usb>;
+			resets = <&atcphy1>;
+			phys = <&atcphy1 PHY_TYPE_USB2>;
+			phy-names = "usb2-phy";
+			status = "disabled";
+		};
+
 		ans_mbox: mailbox@481608000 {
 			compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
 			reg = <0x4 0x81608000 0x0 0x4000>;
