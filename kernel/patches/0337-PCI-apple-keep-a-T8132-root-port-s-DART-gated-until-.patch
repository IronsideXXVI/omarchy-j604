diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 0ab9f3e893..cd111cd6cb 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -6129,10 +6129,13 @@ static __maybe_unused int apple_dart_resume_noirq(struct device *dev)
 	int ret;
 
 	/*
-	 * After a real sleep a DART clocked by its host's port reads nothing until the host
-	 * sets the port up again. Gate it, so that nothing touches it, until then.
+	 * A DART clocked by its host's port aborts every access until the host sets the port
+	 * up again, and a sleep that runs the firmware's path may have stopped that port even
+	 * where it kept the DART's power (T8132: the root ports stop before ANS's APCIe block
+	 * is lowered). Gate it, so that nothing touches it, until apple_dart_host_resume();
+	 * the host calls that for every port that is up, stopped or not.
 	 */
-	if (dart->host_resumes && apple_sleep_power_lost(dev)) {
+	if (dart->host_resumes && pm_resume_via_firmware()) {
 		scoped_guard(spinlock_irqsave, &dart->lock)
 			WRITE_ONCE(dart->commands_gated, true);
 		return pm_runtime_force_resume(dev);
diff --git a/drivers/pci/controller/pcie-apple.c b/drivers/pci/controller/pcie-apple.c
index d382044a3a..af477027a6 100644
--- a/drivers/pci/controller/pcie-apple.c
+++ b/drivers/pci/controller/pcie-apple.c
@@ -561,6 +561,8 @@ struct apple_pcie_port {
 	u32			saved_dbi[APPLE_PCIE_T8132_DBI];
 	bool			restart_ok;
 	bool			restart_saved;
+	/* T8132 built-in host: the DART this port clocks, resumed by the host after a deep sleep */
+	struct device		*dart;
 };
 
 static int apple_pcie_managed_admit(struct apple_pcie_port *port);
@@ -2571,6 +2573,56 @@ static void apple_pcie_t8132_restart_tables(struct apple_pcie *pcie,
 	port->restart_ok = true;
 }
 
+static void apple_pcie_put_dart(void *data)
+{
+	put_device(data);
+}
+
+/*
+ * A T8132 built-in root port clocks the DART behind it (the iommu-map target of the port's
+ * secondary bus). A deep sleep stops the port, and its power-on does not set it up again: until
+ * this host does, every register of that DART aborts. So the DART is told that its host resumes
+ * it (apple_dart_set_host_resumes()): it stays gated after such a sleep until
+ * apple_pcie_t8132_darts_resume().
+ */
+static int apple_pcie_t8132_port_dart(struct apple_pcie *pcie, struct apple_pcie_port *port)
+{
+	struct of_phandle_args spec = {};
+	struct platform_device *dart;
+	u32 bus;
+	int ret;
+
+	if (pcie->hw != &t602x_hw || pcie->managed_sids ||
+	    !of_device_is_compatible(pcie->dev->of_node, "apple,t8132-pcie"))
+		return 0;
+	if (of_property_read_u32_index(port->np, "bus-range", 0, &bus) || bus > 0xff)
+		return 0;
+	ret = of_map_iommu_id(pcie->dev->of_node, bus << 8, &spec);
+	if (ret || !spec.np)
+		return 0;
+	dart = of_find_device_by_node(spec.np);
+	of_node_put(spec.np);
+	if (!dart)
+		return -EPROBE_DEFER;
+	ret = apple_dart_set_host_resumes(&dart->dev);
+	if (ret) {
+		put_device(&dart->dev);
+		if (ret == -EPROBE_DEFER)
+			return ret;
+		if (ret != -EOPNOTSUPP)
+			dev_warn(pcie->dev, "port %pOF: its DART is not gated over a deep sleep: %d\n",
+				 port->np, ret);
+		return 0;
+	}
+	ret = devm_add_action_or_reset(pcie->dev, apple_pcie_put_dart, &dart->dev);
+	if (ret)
+		return ret;
+	port->dart = &dart->dev;
+	dev_info(pcie->dev, "port %pOF: DART %s stays gated after a deep sleep until this port is up\n",
+		 port->np, dev_name(port->dart));
+	return 0;
+}
+
 static int apple_pcie_setup_port(struct apple_pcie *pcie,
 				 struct device_node *np)
 {
@@ -2657,6 +2709,9 @@ static int apple_pcie_setup_port(struct apple_pcie *pcie,
 			goto err_teardown;
 		}
 		apple_pcie_t8132_restart_tables(pcie, port);
+		ret = apple_pcie_t8132_port_dart(pcie, port);
+		if (ret)
+			goto err_teardown;
 	}
 	if (pcie->hw->tunneled) {
 		bool preinit_ok;
@@ -5209,6 +5264,27 @@ static void apple_pcie_t8132_restart(struct apple_pcie *pcie)
 	}
 }
 
+/*
+ * After apple_pcie_t8132_restart(): a port that is up clocks its DART again, which gets its
+ * state back now, before any endpoint behind the port resumes. A port the sleep left down keeps
+ * its DART gated, as it keeps its configuration space blocked.
+ */
+static void apple_pcie_t8132_darts_resume(struct apple_pcie *pcie)
+{
+	struct apple_pcie_port *port;
+
+	list_for_each_entry(port, &pcie->ports, entry) {
+		if (!port->dart)
+			continue;
+		if (apple_sleep_apcie_port_down(port->idx)) {
+			dev_info(pcie->dev, "port %pOF: down after the sleep, its DART stays gated\n",
+				 port->np);
+			continue;
+		}
+		apple_dart_host_resume(port->dart);
+	}
+}
+
 static int apple_pcie_suspend_noirq(struct device *dev)
 {
 	struct apple_pcie *pcie = apple_pcie_lookup(dev);
@@ -5307,6 +5383,7 @@ static int apple_pcie_resume_noirq(struct device *dev)
 	}
 	if (!pcie->hw->tunneled) {
 		apple_pcie_t8132_restart(pcie);
+		apple_pcie_t8132_darts_resume(pcie);
 		return 0;
 	}
 	if (pcie->resume_failed)
