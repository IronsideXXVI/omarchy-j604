+        + mutations('--mutation', ('gate-power-lost', 'gate-off', 'host-down', 'host-skip',
+                                   'host-no-ungate'), out()),
     't6030-display-admission-tests.py': [(out('--output'), PASS), (out('--output') + ['--mutations'], PASS)],
     't6030-display-linkage-tests.py': [(out('--output') + ['--conf', '{conf}'], PASS)],
     't6030-pmp-dt-tests.py': [(out('--output') + ['--dtc', '{dtc}'], PASS)],
diff --git a/tools/asahi/t8132-apcie-dart-resume-tests.py b/tools/asahi/t8132-apcie-dart-resume-tests.py
new file mode 100755
index 0000000000..ddadd443af
--- /dev/null
+++ b/tools/asahi/t8132-apcie-dart-resume-tests.py
@@ -0,0 +1,365 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Check that a T8132 APCIe port's DART is never touched before its port is up after a sleep.
+
+apple_dart_resume_noirq() and apple_dart_host_resume() (apple-dart.c) and
+apple_pcie_t8132_darts_resume() (pcie-apple.c) are extracted and compiled on the host
+against a model: each DART's registers abort while its port's clock is off, and the
+model counts every register access made then. The cases are the split depths, a real
+sleep, suspend-to-idle, a runtime-active DART, a port the host did or did not set up
+again, and a DART with no host. With --dtc, the T8132 device trees are compiled and
+every root port of the built-in host is checked to map, through iommu-map, to its own
+enabled DART, which is what the host marks at probe.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+BOARDS = ('t8132-j604', 't8132-j713', 't8132-j715')
+MUTATIONS = {
+    'gate-power-lost': ('if (dart->host_resumes && pm_resume_via_firmware()) {',
+                        'if (dart->host_resumes && apple_sleep_power_lost(dev)) {'),
+    'gate-off': ('if (dart->host_resumes && pm_resume_via_firmware()) {', 'if (0) {'),
+    'host-down': ('if (apple_sleep_apcie_port_down(port->idx)) {', 'if (0) {'),
+    'host-skip': ('\t\tapple_dart_host_resume(port->dart);\n', '\t\t(void)port;\n'),
+    'host-no-ungate': ('\t\tWRITE_ONCE(dart->commands_gated, false);\n\tret = apple_dart_resume(dev);',
+                       '\t\t;\n\tret = apple_dart_resume(dev);'),
+}
+
+PRELUDE = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdio.h>
+#define __maybe_unused __attribute__((unused))
+#define READ_ONCE(x) (x)
+#define WRITE_ONCE(x, v) ((x) = (v))
+#define scoped_guard(...)
+#define dev_err(...) ((void)0)
+#define dev_dbg(...) ((void)0)
+#define dev_info(...) ((void)0)
+#define EINVAL 22
+
+struct device { int idx; };
+struct device_node { int unused; };
+struct apple_dart_list { unsigned int count; };
+struct apple_dart {
+	int idx;
+	bool host_resumes;
+	bool commands_gated;
+	int lock;
+	struct apple_dart_list sleep_restore;
+};
+
+/* the model */
+static struct apple_dart darts[2];
+static struct device dart_devs[2] = { { 0 }, { 1 } };
+static bool clocked[2];		/* the port's clock, which the DART's registers need */
+static bool lost[2];		/* apple_sleep_power_lost() */
+static bool rt_suspended[2];	/* runtime PM status */
+static bool rt_needs_force[2];	/* force_resume runs the runtime resume */
+static bool via_firmware;	/* pm_resume_via_firmware() */
+static int port_down[4];	/* apple_sleep_apcie_port_down(), by root port number */
+static int access_unclocked, access_clocked, restores[2];
+
+static struct apple_dart *dev_get_drvdata(struct device *dev) { return &darts[dev->idx]; }
+static bool pm_resume_via_firmware(void) { return via_firmware; }
+static bool apple_sleep_power_lost(struct device *dev) { return lost[dev->idx]; }
+static int apple_sleep_apcie_port_down(int idx) { return port_down[idx]; }
+static bool pm_runtime_status_suspended(struct device *dev) { return rt_suspended[dev->idx]; }
+
+static void reg_access(int idx)
+{
+	if (clocked[idx])
+		access_clocked++;
+	else
+		access_unclocked++;
+}
+
+/* The real one gates on the same flag first, then reads TCR/TTBR (apple_dart_state_retained()). */
+static int apple_dart_resume(struct device *dev)
+{
+	struct apple_dart *dart = dev_get_drvdata(dev);
+
+	if (dart->host_resumes && READ_ONCE(dart->commands_gated))
+		return 0;
+	reg_access(dev->idx);
+	restores[dev->idx]++;
+	return 0;
+}
+
+static int pm_runtime_force_resume(struct device *dev)
+{
+	if (rt_needs_force[dev->idx]) {
+		rt_needs_force[dev->idx] = false;
+		rt_suspended[dev->idx] = false;
+		return apple_dart_resume(dev);
+	}
+	return 0;
+}
+
+static void apple_dart_dapf_replay(struct apple_dart *dart)
+{
+	if (dart->commands_gated)
+		return;
+	reg_access(dart->idx);
+}
+
+struct apple_pcie_port {
+	struct apple_pcie_port *next;
+	struct device *dart;
+	struct device_node *np;
+	int idx;
+};
+struct apple_pcie {
+	struct device *dev;
+	struct { struct apple_pcie_port *first; } ports;
+};
+#define list_for_each_entry(pos, head, member) for (pos = (head)->first; pos; pos = pos->next)
+'''
+
+CASES = r'''
+static struct apple_pcie_port ports[2];
+static struct apple_pcie host;
+static struct device host_dev;
+
+static void reset(bool host_resumes, bool firmware)
+{
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		darts[i] = (struct apple_dart){ .idx = i, .host_resumes = host_resumes };
+		clocked[i] = true;
+		lost[i] = false;
+		rt_suspended[i] = true;
+		rt_needs_force[i] = false;
+		port_down[2 * i] = 0;
+		restores[i] = 0;
+		ports[i] = (struct apple_pcie_port){ .dart = host_resumes ? &dart_devs[i] : NULL,
+						     .idx = 2 * i };
+	}
+	ports[0].next = &ports[1];
+	ports[1].next = NULL;
+	host.dev = &host_dev;
+	host.ports.first = &ports[0];
+	via_firmware = firmware;
+	access_unclocked = access_clocked = 0;
+}
+
+/* the sleep stopped both ports (split depth >= 3, or a real sleep) */
+static void ports_stopped(bool power_cut)
+{
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		clocked[i] = false;
+		port_down[2 * i] = 1;
+		lost[i] = power_cut;
+	}
+}
+
+/* the host sets DART i's port (root port 2 * i) up again (apple_pcie_t8132_restart() -> apple_sleep_apcie_port_up()) */
+static void host_restarts(int i)
+{
+	clocked[i] = true;
+	port_down[2 * i] = 0;
+}
+
+static void resume(void)
+{
+	int i;
+
+	/* device order: each DART (supplier) before its host */
+	for (i = 0; i < 2; i++)
+		apple_dart_resume_noirq(&dart_devs[i]);
+}
+
+int main(void)
+{
+	/* 1: split depth 7 (ROWS (107)), runtime-suspended DARTs, the host restarts nothing */
+	reset(true, true);
+	ports_stopped(true);
+	resume();
+	assert(access_unclocked == 0);
+	assert(darts[0].commands_gated && darts[1].commands_gated);
+	apple_pcie_t8132_darts_resume(&host);
+	assert(access_unclocked == 0 && restores[0] == 0 && restores[1] == 0);
+	assert(darts[0].commands_gated && darts[1].commands_gated);
+
+	/* 2: the same, the host sets both ports up: each DART is restored once, clocked */
+	reset(true, true);
+	ports_stopped(true);
+	resume();
+	host_restarts(0);
+	host_restarts(1);
+	apple_pcie_t8132_darts_resume(&host);
+	assert(access_unclocked == 0 && access_clocked >= 2);
+	assert(restores[0] == 1 && restores[1] == 1);
+	assert(!darts[0].commands_gated && !darts[1].commands_gated);
+
+	/* 3: depths 3-5, ports stopped with the power kept: still gated until the port is up */
+	reset(true, true);
+	ports_stopped(false);
+	resume();
+	assert(access_unclocked == 0);
+	host_restarts(1);
+	apple_pcie_t8132_darts_resume(&host);
+	assert(access_unclocked == 0 && restores[1] == 1 && restores[0] == 0);
+	assert(darts[0].commands_gated && !darts[1].commands_gated);
+
+	/* 4: runtime-active DARTs: force_resume's runtime resume finds them gated */
+	reset(true, true);
+	ports_stopped(true);
+	rt_suspended[0] = rt_suspended[1] = false;
+	rt_needs_force[0] = rt_needs_force[1] = true;
+	resume();
+	assert(access_unclocked == 0);
+	host_restarts(0);
+	apple_pcie_t8132_darts_resume(&host);
+	assert(access_unclocked == 0 && restores[0] == 1 && restores[1] == 0);
+
+	/* 5: split depth 2 (ATC0 only): the ports keep running; gated, then restored at once */
+	reset(true, true);
+	resume();
+	apple_pcie_t8132_darts_resume(&host);
+	assert(access_unclocked == 0 && restores[0] == 1 && restores[1] == 1);
+	assert(!darts[0].commands_gated && !darts[1].commands_gated);
+
+	/* 6: suspend-to-idle / depth 1: no gate, nothing for the host to do */
+	reset(true, false);
+	resume();
+	assert(!darts[0].commands_gated && !darts[1].commands_gated);
+	apple_pcie_t8132_darts_resume(&host);
+	assert(access_unclocked == 0 && restores[0] == 0 && restores[1] == 0);
+
+	/* 7: a DART with no host keeps the restore it had (power lost, runtime-suspended) */
+	reset(false, true);
+	lost[0] = lost[1] = true;
+	resume();
+	assert(restores[0] == 1 && restores[1] == 1 && access_unclocked == 0);
+	assert(!darts[0].commands_gated);
+
+	/* 8: apple_dart_host_resume() on a DART that is not the host's is refused */
+	reset(false, true);
+	assert(apple_dart_host_resume(&dart_devs[0]) == -EINVAL);
+
+	puts("t8132 APCIe DART resume: no DART register is touched before its port is up");
+	return 0;
+}
+'''
+
+
+def function(source, signature):
+    start = source.index(signature)
+    return source[start:source.index('\n}\n', start) + 3]
+
+
+def extract(dart, pcie):
+    return (function(dart, 'static __maybe_unused int apple_dart_resume_noirq(struct device *dev)') +
+            function(dart, 'int apple_dart_host_resume(struct device *dev)') +
+            function(pcie, 'static void apple_pcie_t8132_darts_resume(struct apple_pcie *pcie)'))
+
+
+def parse_dts(text):
+    nodes, stack, phandles = {}, [], {}
+    for line in text.splitlines():
+        s = line.strip()
+        m = re.match(r'^(?:[\w]+:\s*)?([\w@,.\-+]+|/)\s*\{$', s)
+        if m:
+            name = m.group(1)
+            path = '/' if not stack else (stack[-1].rstrip('/') + '/' + name)
+            stack.append(path)
+            nodes[path] = {}
+            continue
+        if s == '};':
+            stack.pop()
+            continue
+        m = re.match(r'^([\w,#\-.]+)\s*=\s*(.*);$', s)
+        if m and stack:
+            nodes[stack[-1]][m.group(1)] = m.group(2)
+            if m.group(1) == 'phandle':
+                phandles[int(m.group(2).strip('<>'), 0)] = stack[-1]
+    return nodes, phandles
+
+
+def cells(value):
+    return [int(x, 0) for x in re.findall(r'0x[0-9a-fA-F]+|\b\d+\b', value)]
+
+
+def check_board(dtc, out, board):
+    source = subprocess.check_output([
+        'cpp', '-nostdinc', '-undef', '-D__DTS__',
+        '-I', str(ROOT / 'scripts/dtc/include-prefixes'), '-x', 'assembler-with-cpp',
+        str(ROOT / f'arch/arm64/boot/dts/apple/{board}.dts')])
+    dtb = out / f'{board}.dtb'
+    subprocess.run([str(dtc), '-q', '-I', 'dts', '-O', 'dtb', '-o', str(dtb)],
+                   input=source, check=True)
+    text = subprocess.check_output([str(dtc), '-q', '-I', 'dtb', '-O', 'dts', str(dtb)], text=True)
+    nodes, phandles = parse_dts(text)
+    hosts = [p for p, d in nodes.items() if '"apple,t8132-pcie"' in d.get('compatible', '')
+             and 'okay' in d.get('status', '"okay"')]
+    if not hosts:
+        raise AssertionError(f'{board}: no enabled apple,t8132-pcie host')
+    for host in hosts:
+        imap = cells(nodes[host].get('iommu-map', ''))
+        mask = cells(nodes[host].get('iommu-map-mask', '0xffffffff'))[0]
+        seen = set()
+        for port, d in nodes.items():
+            if not port.startswith(host + '/') or port.count('/') != host.count('/') + 1:
+                continue
+            if 'bus-range' not in d or 'disabled' in d.get('status', ''):
+                continue
+            rid = (cells(d['bus-range'])[0] << 8) & mask
+            target = [imap[i + 1] for i in range(0, len(imap), 4)
+                      if imap[i] <= rid < imap[i] + imap[i + 3]]
+            if len(target) != 1 or target[0] not in phandles:
+                raise AssertionError(f'{board}: {port}: RID {rid:#x} maps to {target}')
+            dart = nodes[phandles[target[0]]]
+            if 'dart' not in dart.get('compatible', '') or 'okay' not in dart.get('status', '"okay"'):
+                raise AssertionError(f'{board}: {port}: {phandles[target[0]]} is not an enabled DART')
+            if target[0] in seen:
+                raise AssertionError(f'{board}: {port}: shares its DART with another port')
+            seen.add(target[0])
+            print(f'{board}: {port.split("/")[-1]} RID {rid:#x} -> {phandles[target[0]].split("/")[-1]}')
+        if not seen:
+            raise AssertionError(f'{board}: {host}: no root port with a DART')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path)
+    parser.add_argument('--dtc', type=Path)
+    parser.add_argument('--mutation', choices=MUTATIONS)
+    args = parser.parse_args()
+    code = extract((ROOT / 'drivers/iommu/apple-dart.c').read_text(),
+                   (ROOT / 'drivers/pci/controller/pcie-apple.c').read_text())
+    if args.mutation:
+        old, new = MUTATIONS[args.mutation]
+        assert old in code, f'missing mutation site: {old}'
+        code = code.replace(old, new, 1)
+    with tempfile.TemporaryDirectory(prefix='t8132-apcie-dart-') as tmp:
+        out = args.out or Path(tmp)
+        out.mkdir(parents=True, exist_ok=True)
+        if args.dtc and not args.mutation:
+            for board in BOARDS:
+                if (ROOT / f'arch/arm64/boot/dts/apple/{board}.dts').exists():
+                    try:
+                        check_board(args.dtc, out, board)
+                    except AssertionError as e:
+                        print(f'Assertion failed: {e}')
+                        raise SystemExit(1)
+        unit = out / 't8132-apcie-dart.c'
+        binary = out / 't8132-apcie-dart'
+        unit.write_text(PRELUDE + code + CASES)
+        subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-Wall', '-Wextra', '-Werror',
+                        '-Wno-unused-function', '-Wno-unused-parameter', str(unit), '-o', str(binary)],
+                       check=True)
+        result = subprocess.run([str(binary)])
+        raise SystemExit(1 if result.returncode else 0)
+
+
+if __name__ == '__main__':
+    main()
