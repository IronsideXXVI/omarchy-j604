From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 05:18:06 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j604: Mark GPU and DCP
 dma-noncoherent

The G16 GPU, DCP, PIODMA and display scanout drivers only support
non-coherent DMA and refuse coherent devices. Since commit 233b5554e07b
("arm64: mm: Treat all devices as dma-coherent when CLIDR_EL1.LoC == 0"),
T8132 devices become coherent unless their node says otherwise. Mark the
J604 nodes dma-noncoherent, as the J713 ones are, so they keep the DMA
path these drivers were written for once they are enabled.

All of these nodes are still disabled. On kernels without that commit
non-coherent DMA is the arm64 default and the property changes nothing.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604-display.dtsi | 5 +++++
 arch/arm64/boot/dts/apple/t8132-j604-gpu.dtsi     | 2 ++
 2 files changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi
index 5cae908c1a..fddd6b856d 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi
@@ -11,6 +11,8 @@
  * those, so the J604 keeps the boot framebuffer (simple-framebuffer) and none
  * of these nodes is probed. drm/apple has no J604 panel profile yet, and its
  * M4 backend and display DART adoption only admit the J713.
+ * The DCP, PIODMA and scanout paths use non-coherent DMA only, so those
+ * nodes are marked dma-noncoherent.
  *
  * Copyright The Asahi Linux Contributors
  */
@@ -68,6 +70,7 @@
 		mbox-names = "mbox";
 		iommus = <&dcp_dart 23>; /* DCP-12 */
 		power-domains = <&ps_disp_cpu>; /* DCP-17 */
+		dma-noncoherent;
 		/*
 		 * Full 3024x1964 panel including the notch rows, from the
 		 * 254.6 ppi dot pitch of the J604 device tree.
@@ -80,6 +83,7 @@
 
 		disp0_piodma: piodma {
 			iommus = <&disp0_dart 16>; /* DCP-16 */
+			dma-noncoherent;
 			status = "disabled"; /* DCP-15 */
 		};
 	};
@@ -87,6 +91,7 @@
 	display: display-subsystem {
 		compatible = "apple,t8132-display-subsystem";
 		iommus = <&disp0_dart 0>; /* DCP-DISP-1 */
+		dma-noncoherent;
 		status = "disabled"; /* DCP-DISP-2 */
 	};
 };
diff --git a/arch/arm64/boot/dts/apple/t8132-j604-gpu.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-gpu.dtsi
index 397a275882..ea5a870c40 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-gpu.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-gpu.dtsi
@@ -77,6 +77,8 @@
 		reg-names = "asc", "sgx";
 		mboxes = <&agx_mbox>;
 		power-domains = <&ps_gfx>; /* DTV-GPU-6 */
+		/* G16 is admitted on non-coherent DMA only. */
+		dma-noncoherent;
 		apple,pmp = <&pmp>;
 		memory-region = <&gpu_ttbs>, <&gpu_pagetables>, <&gpu_handoff>,
 				<&gpu_shared_l2>, <&gpu_fw_text>, <&gpu_fw_data>;
