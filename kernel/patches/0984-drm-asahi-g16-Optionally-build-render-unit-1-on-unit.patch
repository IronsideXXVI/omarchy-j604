From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 21 Nov 2026 07:34:12 +0000
Subject: [PATCH] drm/asahi: g16: Optionally build render unit 1 on
 unit 0's pool

A VM builds render units 0 and 1 at its first render, each with its
own 32 MiB render UMA pool. Every render client therefore holds at
least 64 MiB of pools, even one that never has a second render in
flight.

Add g16_unit1_one_pool (runtime, default 0). When it is set, unit 1
binds unit 0's descriptor, pool and submitted counter, as
g16_unit_one_pool does for the units built later, and builds only its
own PB heap and scene list. The switch is read when a VM builds its
first render units: VMs that already rendered keep unit 1's own pool.
Nothing changes while it is 0.

Not yet measured on a device.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 21 +++++++++++++++++++++
 drivers/gpu/drm/asahi/g16/pools.rs  |  9 ++++++++-
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index b980ee37c2b..71ff27614fa 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2961,6 +2961,27 @@ pub(crate) fn unit_one_pool() -> bool {
     "G16: render units a VM builds after its first render share unit 0's render UMA pool instead of a 32 MiB pool each (default 0; read when a unit is built; runtime 0644)"
 );
 
+/// Storage of `g16_unit1_one_pool` (runtime 0644, default 0; read when a VM builds its first
+/// render units).
+static UNIT1_ONE_POOL: AtomicU32 = AtomicU32::new(0);
+
+/// Whether render unit 1, which a VM builds with unit 0 at its first render, binds unit 0's
+/// render UMA descriptor, pool and submitted counter (as `g16_unit_one_pool` does for the
+/// units built later) instead of building its own 32 MiB pool. Read when the VM builds its
+/// first render units, so VMs that already rendered keep unit 1's own pool.
+pub(crate) fn unit1_one_pool() -> bool {
+    UNIT1_ONE_POOL.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    UNIT1_ONE_POOL_PARAM,
+    UNIT1_ONE_POOL_PARMTYPE,
+    UNIT1_ONE_POOL_PARM,
+    UNIT1_ONE_POOL,
+    "g16_unit1_one_pool",
+    "G16: render unit 1 shares unit 0's render UMA pool instead of a 32 MiB pool of its own (default 0; read when a VM builds its first render units; runtime 0644)"
+);
+
 /// Storage of `g16_resident` (runtime 0644, default 8).
 static RESIDENT: AtomicU32 = AtomicU32::new(8);
 
diff --git a/drivers/gpu/drm/asahi/g16/pools.rs b/drivers/gpu/drm/asahi/g16/pools.rs
index 111043ae147..94886820b06 100644
--- a/drivers/gpu/drm/asahi/g16/pools.rs
+++ b/drivers/gpu/drm/asahi/g16/pools.rs
@@ -675,7 +675,14 @@ pub(crate) fn new(o: &mut Objects, count: usize, compact: bool) -> Result<Self>
         let count = count.clamp(2, super::hw::sizes::RENDER_UNITS);
         let mut units = KVec::with_capacity(count, GFP_KERNEL)?;
         for k in 0..count as u64 {
-            units.push(Allocator::new(o, k, compact)?, GFP_KERNEL)?;
+            // g16_unit1_one_pool: unit 1 binds unit 0's render UMA pool instead of its own.
+            let unit = match units.first() {
+                Some(first) if k == 1 && super::params::unit1_one_pool() => {
+                    Allocator::new_shared(o, k, compact, first)?
+                }
+                _ => Allocator::new(o, k, compact)?,
+            };
+            units.push(unit, GFP_KERNEL)?;
         }
         Ok(Self { units })
     }
