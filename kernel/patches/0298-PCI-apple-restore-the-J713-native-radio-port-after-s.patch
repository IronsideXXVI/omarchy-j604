+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise the production retained-link snapshot, including an operating link with BUSY set."""
+
+from pathlib import Path
+import sleep_test_utils as x
+import re
+import resource
+import subprocess
+import tempfile
+
+resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+root = Path(__file__).resolve().parents[2]
+radio = (root / "drivers/pci/controller/pcie-apple-radio.c").read_text()
+pcie = (root / "drivers/pci/controller/pcie-apple.c").read_text()
+constants = (
+    "PORT_INTMSK",
+    "PORT_APPCLK",
+    "PORT_STATUS",
+    "PORT_STATUS_READY",
+    "PORT_LINKSTS",
+    "PORT_LINKSTS_UP",
+    "PORT_LINKSTS_BUSY",
+    "PORT_MSICFG",
+    "PORT_MSICFG_EN",
+    "PORT_MSIBASE",
+    "PORT_RID2SID_VALID",
+    "PORT_RID2SID_SID_SHIFT",
