From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 06:02:13 +0000
Subject: [PATCH] drm/apple: m4: clear a dcpext's gated-sleep mark at
 its own resume

apple_dart_cio_gated() marks an idle-gated dcpext's display DART for one
deep sleep, and the DART clears the mark in its noirq resume. A sleep
refused after the DCP's suspend but before the DART's noirq suspend runs
no noirq resume for it, so the mark stayed set: a later deep sleep with
that dcpext ungated and no session would then pass with live state.

Add apple_dart_cio_ungated() and call it from the dcpext's resume, which
runs whenever its suspend did, so the side that sets the mark clears it.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/iomfb_m4.c   |  2 ++
 drivers/iommu/apple-dart-cio.c     | 11 +++++++++++
 include/linux/soc/apple/dart-cio.h |  5 +++++
 3 files changed, 18 insertions(+)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index 3a7097add3..ad11fdd291 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -8438,6 +8438,8 @@ int iomfb_m4_resume(struct apple_dcp *owner)
 		 * next request powers it up (dcp_m4_ext_up()).
 		 */
 		mutex_lock(&dcp->lock);
+		/* The mark this DCP set for a gated sleep, if any (suspend). */
+		apple_dart_cio_ungated(dcp->ext_darts[1]);
 		ret = dcp->gated && dcp->ext_sleep_gated ?
 		      iomfb_m4_ext_power_ungate(dcp, "resume") : 0;
 		dcp->ext_sleep_gated = false;
diff --git a/drivers/iommu/apple-dart-cio.c b/drivers/iommu/apple-dart-cio.c
index 713adf6b8f..4ddf77f872 100644
--- a/drivers/iommu/apple-dart-cio.c
+++ b/drivers/iommu/apple-dart-cio.c
@@ -122,6 +122,17 @@ int apple_dart_cio_gated(struct apple_dart_cio *s)
 }
 EXPORT_SYMBOL_GPL(apple_dart_cio_gated);
 
+/*
+ * The owner's resume: also when the sleep was refused before the DART's own
+ * noirq suspend, whose resume then never runs to clear the mark.
+ */
+void apple_dart_cio_ungated(struct apple_dart_cio *s)
+{
+	if (s && s->dart)
+		WRITE_ONCE(s->dart->cio_gated, false);
+}
+EXPORT_SYMBOL_GPL(apple_dart_cio_ungated);
+
 static int apple_dart_cio_gapf(struct apple_dart_cio *s, bool on)
 {
 	u32 value;
diff --git a/include/linux/soc/apple/dart-cio.h b/include/linux/soc/apple/dart-cio.h
index cc08f887d1..3534bacf7c 100644
--- a/include/linux/soc/apple/dart-cio.h
+++ b/include/linux/soc/apple/dart-cio.h
@@ -21,6 +21,7 @@ int apple_dart_cio_bind(struct device *owner, struct device *provider,
 			struct apple_dart_cio **state);
 int apple_dart_cio_prepare(struct apple_dart_cio *state);
 int apple_dart_cio_gated(struct apple_dart_cio *state);
+void apple_dart_cio_ungated(struct apple_dart_cio *state);
 int apple_dart_cio_off(struct apple_dart_cio *state);
 int apple_dart_cio_on(struct apple_dart_cio *state);
 int apple_dart_cio_finish(struct apple_dart_cio *state);
@@ -41,6 +42,10 @@ static inline int apple_dart_cio_gated(struct apple_dart_cio *s)
 	return -EOPNOTSUPP;
 }
 
+static inline void apple_dart_cio_ungated(struct apple_dart_cio *s)
+{
+}
+
 static inline int apple_dart_cio_off(struct apple_dart_cio *s)
 {
 	return -EOPNOTSUPP;
-- 
