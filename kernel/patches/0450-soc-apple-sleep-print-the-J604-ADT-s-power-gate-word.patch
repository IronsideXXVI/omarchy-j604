From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 06:13:51 +0000
Subject: [PATCH] soc: apple: sleep: print the J604 ADT's power-gate
 words

The J604 ADT's pmgr pwrgate-regs names four power-gate enable words that
macOS's PMGR driver is given, 0x80000000 each. No Linux code writes
three of them, and a /dev/mem read on an earlier kernel found all four
at 0. Whether they matter to a deep sleep's wake is open.

Read them on the J604 only, at probe and in the last step before the
deep commit, and print each raw value. Nothing writes them. The reads
are of always-on PMGR registers that read with no fault before.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/sleep.c | 39 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 38 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index 2b8d67dc50..99c351eecd 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -732,6 +732,8 @@ struct apple_sleep {
 	unsigned int ps_unlatched_count;
 	/* T8132: what macOS polls off after its complex words, still on at that point. */
 	u32 quiesce_still_on;
+	/* J604: the ADT's pwrgate-regs words, read only (j604_adt_pwrgate_print()). */
+	void __iomem *adt_pg[4];
 };
 
 static struct apple_sleep *apple_sleep;
@@ -3535,6 +3537,37 @@ module_param(t8132_cpu_perf_down, bool, 0644);
 MODULE_PARM_DESC(t8132_cpu_perf_down,
 		 "T8132: step the SoC perf state and DCS down from the CPU at the commit if the firmware has not (default: on)");
 
+/*
+ * J604, read only: the four power-gate enable words that the J604 ADT's pmgr
+ * pwrgate-regs gives macOS's PMGR driver, 0x80000000 each (the first with
+ * field 0x00402001). Nothing here writes them; the first is also "pwrgate" +
+ * 0x104c, which the commit writes for the first display. All four read 0
+ * through /dev/mem with no fault on 1.850.
+ */
+static const phys_addr_t j604_adt_pwrgate[] = {
+	0x38072504c, 0x38072604c, 0x38072704c, 0x38829c01c,
+};
+
+static void j604_adt_pwrgate_init(struct apple_sleep *s)
+{
+	int i;
+
+	if (!of_machine_is_compatible("apple,j604"))
+		return;
+	for (i = 0; i < ARRAY_SIZE(j604_adt_pwrgate); i++)
+		s->adt_pg[i] = devm_ioremap(s->dev, j604_adt_pwrgate[i], sizeof(u32));
+}
+
+static void j604_adt_pwrgate_print(struct apple_sleep *s, const char *when)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(j604_adt_pwrgate); i++)
+		if (s->adt_pg[i])
+			dev_info(s->dev, "ADT pwrgate word %d at %pa, %s: %#010x (macOS: 0x80000000)\n",
+				 i + 1, &j604_adt_pwrgate[i], when, readl(s->adt_pg[i]));
+}
+
 static int t8132_sleep_commit(unsigned long unused)
 {
 	struct apple_sleep *s = apple_sleep;
@@ -3731,6 +3764,7 @@ static int apple_sleep_enter(suspend_state_t state)
 	if (s->deep_once)
 		sleep_slp_ddr_set_deep_once(true);
 
+	j604_adt_pwrgate_print(s, "before the commit");
 	s->cntkctl = read_sysreg(cntkctl_el1);
 	pm_set_resume_via_firmware();
 	/*
@@ -4595,8 +4629,11 @@ static int apple_sleep_probe(struct platform_device *pdev)
 
 	/* Last: the exported helpers take it as a probed driver, and a failure frees s. */
 	apple_sleep = s;
-	if (s->soc->commit == t8132_sleep_commit)
+	if (s->soc->commit == t8132_sleep_commit) {
 		t8132_catch_init(pdev, s);
+		j604_adt_pwrgate_init(s);
+		j604_adt_pwrgate_print(s, "at boot");
+	}
 	/* Deep becomes the default sleep state, unless mem_sleep_default= chose another. */
 	suspend_set_ops(&apple_sleep_ops);
 	/* Userspace may still pick deep through /sys/power/mem_sleep. */
-- 
2.43.0

