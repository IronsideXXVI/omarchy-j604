From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 03:28:34 +0000
Subject: [PATCH] accel/ane: identify the T8132 (M4) Neural Engine
 firmware

Add the T8132 H16 platform and match apple,t8132-ane.

From the J604 runtime ADT (MEASURED): ane-type 0x100; six windows, the
T6041 list without aux-3; ANE_SYS at PMGR +0x570 and ANE_MPM/CPU/TD/BASE
at +0xc000..0xc018 (power words 0x570, 0xc008, 0xc000, 0xc010, 0xc018);
the preload at the T6041's device addresses and sizes; five DAPF records.

From the 26.6.2 (25G83) restore image (MEASURED, offsets only): iBoot
preloads h16_ane_fw_leto_j7x on the T8132, built from the same RTKit
3255.160.4 as the T604x aether image, with the same 42 patchbay records
0x4f0 bytes later in DATA and its rewritten range (_rtk_tunables) at DATA
0x1c0f0 + 0x6a0. Add that layout as the T8132 25G83 preload rule. Its
digest also covers the values iBoot writes into the immutable records, so
it can only be measured on the machine: the rule carries no digest yet,
matches no preload, and the existing "H16 preload has the %s layout but
digest %*phN" message names the live digest for the next build to pin.

The H16 backend's later stages do not fit the T8132 yet: it maps aux-3 as
its XL window and applies T6041 tunables to it, and it programs four DAPF
records. So the T8132 platform sets identify_only: probe runs the
preflight (resources, preload hand-off, DAPF count) and the preload
identity, then stops with -EOPNOTSUPP before any power domain, DART or
engine register is touched. The preflight takes the DAPF range count from
the platform (five here, four by default).

KUnit: the leto rule frames the leto layout, rejects the aether layout of
the same build (and the aether rule rejects leto), and its unmeasured
digest authenticates nothing.

Nothing binds until a board enables an apple,t8132-ane node and the boot
loader hands over the preload.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/accel/ane/ane_fw_platform.c         | 62 +++++++++++++++-
 drivers/accel/ane/ane_fw_platform.h         |  8 +++
 drivers/accel/ane/ane_h16_backend.c         |  4 ++
 drivers/accel/ane/ane_h16_boot_data.h       | 78 +++++++++++++++++++++
 drivers/accel/ane/ane_h16_preload_test.c    | 49 +++++++++++++
 drivers/accel/ane/ane_t6021_rtclient_main.c |  5 ++
 6 files changed, 205 insertions(+), 1 deletion(-)

diff --git a/drivers/accel/ane/ane_fw_platform.c b/drivers/accel/ane/ane_fw_platform.c
index 1f0d50a1f0..caf7d3eb22 100644
--- a/drivers/accel/ane/ane_fw_platform.c
+++ b/drivers/accel/ane/ane_fw_platform.c
@@ -75,6 +75,65 @@ const struct ane_fw_platform ane_h16_platform = {
 	.safe_reset = false,
 };
 
+/*
+ * T8132 (M4), from the J604 runtime ADT /arm-io/ane and /arm-io/dart-ane:
+ * ane-type 0x100, six windows (the T6041 list without its second 32 MiB
+ * engine window, aux-3), ANE_SYS at PMGR +0x570 and ANE_MPM/CPU/TD/BASE at
+ * +0xc000..0xc018, preload TEXT 0xc0000 at 0x10000000000 and DATA 0x2ac000
+ * at 0x100000c0000, and five DAPF records in dapf-instance-0 where the
+ * T6041 has four. The H16 backend maps aux-3 as its XL window, programs
+ * four DAPF records and applies T6041 tunables, none of which fits the
+ * T8132 yet: the platform identifies the preload and stops.
+ */
+static const char * const ane_h16_t8132_reg_names[] = {
+	"engine", "pmgr", "aux-0", "aux-1", "aux-2", "aux-4",
+};
+
+static const u32 ane_h16_t8132_reg_sizes[] = {
+	0x2000000, 0x18000, 0x4000, 0x30000, 0xff4000, 0x4000,
+};
+
+static const u32 ane_h16_t8132_power_words[] = {
+	0x570, 0xc008, 0xc000, 0xc010, 0xc018,
+};
+
+const struct ane_fw_platform ane_h16_t8132_platform = {
+	.h16_profiles = ane_h16_profiles_t8132,
+	.h16_profile_count = ARRAY_SIZE(ane_h16_profiles_t8132),
+	.h16_mmio = ane_h16_mmio_t6041,
+	.h16_mmio_count = ARRAY_SIZE(ane_h16_mmio_t6041),
+	.dart_params = 0x8,
+	.dapf_dart = 0,
+	.dapf_offset = 0x10000,
+	.dapf_size = SZ_16K,
+	.soc = 0x8132,
+	.chip_family = 16,
+	.ane_type = 0x100,
+	.hwx_subtype = 7,
+	.task_generation = 17,
+	.interrupt_count = 1,
+	.irq_role = ANE_FW_IRQ_CHANNELS,
+	.owner = ANE_FW_OWNER_AP,
+	.reg_names = ane_h16_t8132_reg_names,
+	.reg_sizes = ane_h16_t8132_reg_sizes,
+	.reg_count = ARRAY_SIZE(ane_h16_t8132_reg_names),
+	.wrapper = 0x1600000,
+	.mailbox = 0x1608000,
+	.scratch = 0x1880020,
+	.doorbell = 0x1884000,
+	.irq_status = 0x188c000,
+	.irq_ack = 0x1890000,
+	.power_words = ane_h16_t8132_power_words,
+	.power_count = ARRAY_SIZE(ane_h16_t8132_power_words),
+	.preload_dva = { 0x10000000000, 0x100000c0000 },
+	.preload_size = { 0xc0000, 0x2ac000 },
+	.stream_mask = BIT(0) | BIT(11),
+	.firmware_preloaded = true,
+	.safe_reset = false,
+	.dapf_range_count = 5,
+	.identify_only = true,
+};
+
 const struct ane_fw_platform ane_h17_platform = {
 	.soc = 0x8140,
 	.chip_family = 17,
@@ -225,7 +284,8 @@ int ane_fw_platform_preflight(struct platform_device *pdev,
 			"H16 requires bootloader-reserved no-map TEXT/DATA preload ranges\n");
 
 	if (!soc->h16_profile_count || !soc->h16_mmio_count || soc->dapf_dart >= 3 ||
-	    !soc->dapf_size || of_property_count_u64_elems(np, "apple,dapf-ranges") != 8)
+	    !soc->dapf_size || of_property_count_u64_elems(np, "apple,dapf-ranges") !=
+	    2 * (soc->dapf_range_count ?: 4))
 		return -ENODATA;
 	return 0;
 }
diff --git a/drivers/accel/ane/ane_fw_platform.h b/drivers/accel/ane/ane_fw_platform.h
index 6978b1b6fe..0bd1747571 100644
--- a/drivers/accel/ane/ane_fw_platform.h
+++ b/drivers/accel/ane/ane_fw_platform.h
@@ -77,6 +77,13 @@ struct ane_fw_platform {
 	 * Without either, H16 refuses system sleep.
 	 */
 	bool sleep_cold;
+	/* Number of apple,dapf-ranges pairs; 0 means four. */
+	u8 dapf_range_count;
+	/*
+	 * Stop after the preload identity: preflight, resource geometry and the
+	 * firmware digest only, no power, DART or engine access.
+	 */
+	bool identify_only;
 };
 
 /* Pure range check: the boot loader supplies the physical addresses. */
@@ -124,6 +131,7 @@ ane_fw_sleep_path(const struct ane_fw_platform *platform)
 }
 
 extern const struct ane_fw_platform ane_h16_platform, ane_h17_platform;
+extern const struct ane_fw_platform ane_h16_t8132_platform;
 int ane_fw_platform_preflight(struct platform_device *pdev,
 			      const struct ane_fw_platform *soc);
 
diff --git a/drivers/accel/ane/ane_h16_backend.c b/drivers/accel/ane/ane_h16_backend.c
index 4b52a4a5fe..19aa484bc8 100644
--- a/drivers/accel/ane/ane_h16_backend.c
+++ b/drivers/accel/ane/ane_h16_backend.c
@@ -1618,6 +1618,10 @@ static int ane_h16_advance(struct ane_h16_device *h, enum ane_h16_stage stage)
 	if (!h->acquired) {
 		h->acquired = true;
 		ret = ane_h16_preload_identity(h);
+		if (!ret && h->boot.soc->identify_only) {
+			dev_info(h->dev, "H16 preload identified; this SoC stops before power-up\n");
+			ret = -EOPNOTSUPP;
+		}
 		if (!ret)
 			ret = ane_h16_acquire(to_platform_device(h->dev), h);
 		if (ret)
diff --git a/drivers/accel/ane/ane_h16_boot_data.h b/drivers/accel/ane/ane_h16_boot_data.h
index e11a02c6a4..46eb142d07 100644
--- a/drivers/accel/ane/ane_h16_boot_data.h
+++ b/drivers/accel/ane/ane_h16_boot_data.h
@@ -367,4 +367,82 @@ static const struct ane_h16_profile ane_h16_profiles[] __maybe_unused = {
 	},
 };
 
+/*
+ * T8132 (M4; J604, J713 and the other T8132 Macs): the 26.6.2 (25G83) build
+ * of h16_ane_fw_leto_j7x, the image iBoot preloads on the T8132. Measured on
+ * the 25G83 restore image: RTKit 3255.160.4 like the T604x aether build,
+ * TEXT 0xc0000 and DATA 0x2ac000, the same 42 patchbay records, each 0x4f0
+ * bytes later in DATA, and the rewritten range (_rtk_tunables) at DATA
+ * 0x1c0f0 + 0x6a0. The digest of the live preload also covers the values
+ * iBoot writes into the immutable records and is not measured yet: until
+ * it is, no preload matches this rule, and the driver logs the live digest
+ * ("H16 preload has the ... layout but digest ...") so it can be pinned.
+ */
+static const struct ane_h16_preload_cell ane_h16_patchbay_25g83_t8132[] = {
+	{ "BECA", 0x9e90, 8, true },
+	{ "SECA", 0x9ea0, 8, false },
+	{ "GKTS", 0x9eb0, 8, true },
+	{ "otcd", 0x9ec0, 8, false },
+	{ "oscd", 0x9ed0, 8, false },
+	{ "oecd", 0x9ee0, 8, false },
+	{ "DILS", 0x9ef0, 8, true },
+	{ "SRSA", 0x9f00, 8, false },
+	{ "GFCM", 0x9f10, 8, false },
+	{ "SSSC", 0x9f20, 8, true },
+	{ "qF8v", 0x9f30, 4, true },
+	{ "LRSD", 0x9f3c, 1, false },
+	{ "SVSD", 0x9f45, 8, false },
+	{ "LCSD", 0x9f55, 8, false },
+	{ "ZSTR", 0x9f65, 4, false },
+	{ "BPTP", 0x9f71, 8, false },
+	{ "TNGI", 0x9f81, 1, false },
+	{ "oeNS", 0x9f8a, 1, false },
+	{ "SEBC", 0x9f93, 8, false },
+	{ "ECAP", 0x9fa3, 8, true },
+	{ "BVTP", 0x9fb3, 8, true },
+	{ "sP1T", 0x9fc3, 8, true },
+	{ "BtpG", 0x9fd3, 8, true },
+	{ "StpG", 0x9fe3, 8, false },
+	{ "BlpP", 0x9ff3, 8, true },
+	{ "SPTP", 0xa003, 8, false },
+	{ "SZSD", 0xa013, 8, false },
+	{ "LZSD", 0xa023, 8, false },
+	{ "S2xG", 0xa033, 8, true },
+	{ "SNUT", 0xa043, 8, true },
+	{ "ZNUT", 0xa053, 4, false },
+	{ "OTTR", 0xa05f, 8, true },
+	{ "LLTR", 0xa06f, 1, false },
+	{ "_COS", 0xa078, 4, true },
+	{ "RCOS", 0xa084, 4, true },
+	{ "dApC", 0xa090, 8, true },
+	{ "dArW", 0xa0a0, 8, true },
+	{ "fVED", 0xa0b0, 1, true },
+	{ "GLFp", 0xa0b9, 8, true },
+	{ "ABOI", 0xa0c9, 8, false },
+	{ "ZSOI", 0xa0d9, 4, false },
+	{ "ARcM", 0xa0e5, 4, true },
+};
+
+static const struct ane_h16_preload_rule ane_h16_preload_25g83_t8132 = {
+	.cells = ane_h16_patchbay_25g83_t8132,
+	.cell_count = ARRAY_SIZE(ane_h16_patchbay_25g83_t8132),
+	.zero_start = 0x1c0f0,
+	.zero_end = 0x1c790,
+	/* Not measured: the J604 boot that first binds the driver logs it. */
+	.digest = { 0 },
+};
+
+/*
+ * T8132 builds. The build values are the 26A428 ones the T604x 25G83 build
+ * uses (same RTKit, same DATA end); the T8132 platform stops after the
+ * preload identity, before any of them is used (see ane_h16_t8132_platform).
+ */
+static const struct ane_h16_profile ane_h16_profiles_t8132[] __maybe_unused = {
+	{
+		.identity = "H16 26.6.2 25G83 T8132",
+		.preload = &ane_h16_preload_25g83_t8132,
+		.build = &ane_h16_build_26a428,
+	},
+};
+
 #endif /* __ANE_H16_BOOT_DATA_H__ */
diff --git a/drivers/accel/ane/ane_h16_preload_test.c b/drivers/accel/ane/ane_h16_preload_test.c
index 184b444a53..958b4b5bf7 100644
--- a/drivers/accel/ane/ane_h16_preload_test.c
+++ b/drivers/accel/ane/ane_h16_preload_test.c
@@ -330,6 +330,54 @@ static void preload_profiles_test(struct kunit *test)
 	}
 }
 
+/*
+ * The T8132 leto rule (25G83) frames the leto layout, rejects the T604x
+ * aether layout of the same build and the other way round, and its
+ * unmeasured digest authenticates nothing.
+ */
+static void preload_t8132_layout_test(struct kunit *test)
+{
+	struct preload_fixture *f = test->priv;
+	const struct ane_h16_preload_rule *leto = &ane_h16_preload_25g83_t8132;
+	const struct ane_h16_preload_rule *aether = &ane_h16_preload_25g83;
+	u8 digest[SHA256_DIGEST_SIZE];
+	unsigned int k;
+
+	KUNIT_ASSERT_EQ(test, ARRAY_SIZE(ane_h16_profiles_t8132), 1);
+	KUNIT_EXPECT_PTR_EQ(test, ane_h16_profiles_t8132[0].preload, leto);
+	KUNIT_ASSERT_EQ(test, leto->cell_count, aether->cell_count);
+	for (k = 0; k < leto->cell_count; k++) {
+		KUNIT_EXPECT_EQ(test, leto->cells[k].value, aether->cells[k].value + 0x4f0);
+		KUNIT_EXPECT_EQ(test, leto->cells[k].width, aether->cells[k].width);
+		KUNIT_EXPECT_EQ(test, leto->cells[k].mutable, aether->cells[k].mutable);
+		KUNIT_EXPECT_EQ(test, memcmp(leto->cells[k].tag, aether->cells[k].tag, 4), 0);
+	}
+	KUNIT_EXPECT_EQ(test, leto->zero_end - leto->zero_start, 0x6a0);
+
+	memset(f->data, 0xa5, ANE_H16_PRELOAD_DATA_SIZE);
+	for (k = 0; k < leto->cell_count; k++) {
+		memcpy(f->data + leto->cells[k].value - 8, leto->cells[k].tag, 4);
+		put_unaligned_le32(leto->cells[k].width, f->data + leto->cells[k].value - 4);
+	}
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_digest(leto, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+						     f->data, ANE_H16_PRELOAD_DATA_SIZE, digest), 0);
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_digest(aether, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+						     f->data, ANE_H16_PRELOAD_DATA_SIZE, digest),
+			-ENOEXEC);
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_validate(leto, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+						       f->data, ANE_H16_PRELOAD_DATA_SIZE),
+			-ENOEXEC);
+
+	memset(f->data, 0xa5, ANE_H16_PRELOAD_DATA_SIZE);
+	for (k = 0; k < aether->cell_count; k++) {
+		memcpy(f->data + aether->cells[k].value - 8, aether->cells[k].tag, 4);
+		put_unaligned_le32(aether->cells[k].width, f->data + aether->cells[k].value - 4);
+	}
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_digest(leto, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+						     f->data, ANE_H16_PRELOAD_DATA_SIZE, digest),
+			-ENOEXEC);
+}
+
 static struct kunit_case preload_cases[] = {
 	KUNIT_CASE(preload_identity_test),
 	KUNIT_CASE(preload_mutable_test),
@@ -339,6 +387,7 @@ static struct kunit_case preload_cases[] = {
 	KUNIT_CASE(preload_rule_shape_test),
 	KUNIT_CASE(preload_layout_select_test),
 	KUNIT_CASE(preload_profiles_test),
+	KUNIT_CASE(preload_t8132_layout_test),
 	{}
 };
 
