 drivers/gpu/drm/asahi/g16/poll.rs   | 72 ++++++++++++++++++++++++++++-
 5 files changed, 228 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/boot.rs b/drivers/gpu/drm/asahi/g16/boot.rs
index 83399114b9..4d52aca230 100644
--- a/drivers/gpu/drm/asahi/g16/boot.rs
+++ b/drivers/gpu/drm/asahi/g16/boot.rs
@@ -60,6 +60,12 @@ fn asahi_g16_rt_start(
             cookie: *mut core::ffi::c_void,
         ) -> core::ffi::c_int;
         fn asahi_g16_rt_kick() -> bool;
+        fn asahi_g16_big_init() -> core::ffi::c_int;
+        fn asahi_g16_big_wq() -> *mut kernel::bindings::workqueue_struct;
+        fn asahi_g16_big_cpu() -> core::ffi::c_int;
+        fn asahi_g16_cpu_is_big(cpu: core::ffi::c_int) -> bool;
+        fn asahi_g16_this_cpu() -> core::ffi::c_int;
+        fn asahi_g16_big_mask() -> *const kernel::bindings::cpumask;
         fn asahi_g16_ram_disjoint(start: u64, size: u64) -> bool;
         fn asahi_g16_ioremap_wc(start: u64, size: usize) -> *mut core::ffi::c_void;
         fn asahi_g16_dma_unsupported(dev: *mut core::ffi::c_void) -> bool;
@@ -125,6 +131,50 @@ pub(crate) fn rt_kick() -> bool {
         unsafe { asahi_g16_rt_kick() }
     }
 
+    /// `g16_worker_big`: builds the max-capacity CPU mask and the `aurora_g16_big` queue.
+    /// Process context, at probe.
+    pub(crate) fn big_init() -> Result {
+        // SAFETY: Reads CPU capacities and allocates a workqueue; no driver state.
+        kernel::error::to_result(unsafe { asahi_g16_big_init() })?;
+        restrict(big_wq(), false)
+    }
+    /// Limits the unbound queue `wq` to the big CPUs, keeping high priority (and order if
+    /// `ordered`), through the kernel's exported workqueue_restrict helper. May sleep.
+    fn restrict(wq: *mut kernel::bindings::workqueue_struct, ordered: bool) -> Result {
+        if wq.is_null() {
+            return Err(EINVAL);
+        }
+        // SAFETY: `wq` is a live unbound workqueue; the mask is static and the helper copies it.
+        kernel::error::to_result(unsafe {
+            kernel::bindings::workqueue_restrict(wq, asahi_g16_big_mask(), ordered, true)
+        })
+    }
+    /// The `aurora_g16_big` queue (unbound, high priority, big CPUs only), or null.
+    pub(crate) fn big_wq() -> *mut kernel::bindings::workqueue_struct {
+        // SAFETY: Returns a pointer set once at probe and never freed.
+        unsafe { asahi_g16_big_wq() }
+    }
+    /// The big CPU chosen at init (re-chosen only if offline), or -1. Any context.
+    pub(crate) fn big_cpu() -> i32 {
+        // SAFETY: Reads the init-time choice and the online mask.
+        unsafe { asahi_g16_big_cpu() }
+    }
+    /// Whether `cpu` is one of the max-capacity CPUs. Any context.
+    pub(crate) fn cpu_is_big(cpu: i32) -> bool {
+        // SAFETY: Bounds-checked mask test.
+        unsafe { asahi_g16_cpu_is_big(cpu) }
+    }
+    /// The CPU running the caller (raw_smp_processor_id). Any context.
+    pub(crate) fn this_cpu() -> i32 {
+        // SAFETY: No preconditions.
+        unsafe { asahi_g16_this_cpu() }
+    }
+    /// Restricts the caller's unbound ORDERED high-priority queue (`aurora_g16_hi`) to the big
+    /// CPUs. Process context; `wq` must stay live for the call.
+    pub(crate) fn big_apply(wq: *mut kernel::bindings::workqueue_struct) -> Result {
+        restrict(wq, true)
+    }
+
     /// A qualified T8132 board (J713, J773g).
     pub(crate) fn board() -> bool {
         // SAFETY: Reads the machine compatible strings only.
@@ -426,6 +476,15 @@ fn new(dev: &device::Device, shared: &Arc<Shared>) -> Result<Self> {
                         e
                     );
                 }
+                // g16_worker_big: the big-core queue is built here (process context) whatever
+                // the switch, so it can be turned on at runtime.
+                if let Err(e) = glue::big_init() {
+                    dev_warn!(
+                        dev,
+                        "G16: big-core poll queue not built ({:?}); g16_worker_big has no effect\n",
+                        e
+                    );
+                }
                 shared.rtk.store(rtk, Ordering::Release);
                 Ok(Self { rtk })
             }
diff --git a/drivers/gpu/drm/asahi/g16/glue.c b/drivers/gpu/drm/asahi/g16/glue.c
index 1e169b0523..698c1668a3 100644
--- a/drivers/gpu/drm/asahi/g16/glue.c
+++ b/drivers/gpu/drm/asahi/g16/glue.c
@@ -29,6 +29,10 @@
 #include <linux/soc/apple/pmp-cooling.h>
 #include <linux/soc/apple/pmp-telemetry.h>
 #include <linux/thermal.h>
+#include <linux/arch_topology.h>
+#include <linux/cpumask.h>
+#include <linux/smp.h>
+#include <linux/workqueue.h>
 
 #include "glue.h"
 
@@ -41,6 +45,12 @@ int asahi_g16_lat_qos(int us);
 int asahi_g16_cpu_floor(bool on);
 int asahi_g16_rt_start(void (*fn)(void *cookie), void *cookie);
 bool asahi_g16_rt_kick(void);
+int asahi_g16_big_init(void);
+struct workqueue_struct *asahi_g16_big_wq(void);
+int asahi_g16_big_cpu(void);
+bool asahi_g16_cpu_is_big(int cpu);
+int asahi_g16_this_cpu(void);
+const struct cpumask *asahi_g16_big_mask(void);
 bool asahi_g16_ram_disjoint(u64 start, u64 size);
 void __iomem *asahi_g16_ioremap_wc(u64 start, size_t size);
 bool asahi_g16_dma_unsupported(struct device *dev);
@@ -578,3 +588,62 @@ int asahi_g16_lat_qos(int us)
 	cpu_latency_qos_update_request(req, us < 0 ? PM_QOS_DEFAULT_VALUE : us);
 	return 0;
 }
+
+/* g16_worker_big: run the completion/poll work on the CPUs of maximum capacity.
+ * The mask is taken from arch_scale_cpu_capacity() once, at probe (no CPU numbers are
+ * hardcoded); nothing here runs while no GPU work is queued.
+ */
+static struct cpumask g16_big_mask;
+static struct workqueue_struct *g16_big_wq;
+static int g16_big_cpu = -1;
+
+int asahi_g16_big_init(void)
+{
+	unsigned long max = 0;
+	int cpu;
+
+	if (g16_big_wq)
+		return 0;
+	for_each_possible_cpu(cpu)
+		max = max_t(unsigned long, max, arch_scale_cpu_capacity(cpu));
+	cpumask_clear(&g16_big_mask);
+	for_each_possible_cpu(cpu)
+		if (arch_scale_cpu_capacity(cpu) == max)
+			cpumask_set_cpu(cpu, &g16_big_mask);
+	/* The last big CPU: away from CPU 0's boot-time housekeeping. */
+	g16_big_cpu = cpumask_last(&g16_big_mask);
+	/* Restricted to g16_big_mask by the caller (workqueue_restrict, the exported helper). */
+	g16_big_wq = alloc_workqueue("aurora_g16_big", WQ_UNBOUND | WQ_HIGHPRI, 0);
+	return g16_big_wq ? 0 : -ENOMEM;
+}
+
+const struct cpumask *asahi_g16_big_mask(void)
+{
+	return &g16_big_mask;
+}
+
+struct workqueue_struct *asahi_g16_big_wq(void)
+{
+	return g16_big_wq;
+}
+
+/* The big CPU for queue_work_on(), or -1: chosen at init, re-chosen only if it went offline. */
+int asahi_g16_big_cpu(void)
+{
+	int cpu = READ_ONCE(g16_big_cpu);
+
+	if (cpu >= 0 && cpu < nr_cpu_ids && cpu_online(cpu))
+		return cpu;
+	cpu = cpumask_any_and(&g16_big_mask, cpu_online_mask);
+	return cpu < nr_cpu_ids ? cpu : -1;
+}
+
+bool asahi_g16_cpu_is_big(int cpu)
+{
+	return cpu >= 0 && cpu < nr_cpu_ids && cpumask_test_cpu(cpu, &g16_big_mask);
+}
+
+int asahi_g16_this_cpu(void)
+{
+	return raw_smp_processor_id();
+}
