             None
         };
+        // g16_worker_big: a submit queue (unbound, ordered) created while the switch is on
+        // runs its run-job/free-job work on the max-capacity CPUs too. Failure keeps it as is.
+        if let (Some(q), true) = (submit_wq.as_ref(), super::params::worker_big() != 0) {
+            let _ = super::boot::glue::big_apply(q.as_raw());
+        }
         let scheduler = sched::Scheduler::new_with_queues(
             dev,
