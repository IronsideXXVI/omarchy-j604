diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index eeaf836b92..d0e6ae4c1c 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -940,6 +940,31 @@ pub(crate) fn rt_poll() -> bool {
     "G16: retire after a firmware event on the SCHED_FIFO poller thread instead of the CFS worker (default 0; 1: on; runtime 0644)"
 );
 
+/// Storage of `g16_worker_big` (runtime 0644, default 0).
+static WORKER_BIG: AtomicU32 = AtomicU32::new(0);
+
+/// Where the poll/completion work runs: 0 (default) `system_highpri_wq` on the CPU that
+/// queued it (the mailbox interrupt's or the hrtimer's CPU, often an efficiency core); 1 the
+/// unbound high-priority `aurora_g16_big` queue limited to the CPUs of maximum capacity;
+/// 2 `system_highpri_wq` on one such CPU chosen at probe (no migration between passes).
+/// With 1 or 2, scheduler submit queues (`aurora_g16_hi`) created afterwards are limited to
+/// the same CPUs. Read per queueing.
+pub(crate) fn worker_big() -> u32 {
+    match WORKER_BIG.load(Ordering::Relaxed) {
+        v @ 1..=2 => v,
+        _ => 0,
+    }
+}
+
+live_u32_param!(
+    WORKER_BIG_PARAM,
+    WORKER_BIG_PARMTYPE,
+    WORKER_BIG_PARM,
+    WORKER_BIG,
+    "g16_worker_big",
+    "G16: run the completion/poll work on the max-capacity CPUs (default 0: where queued; 1: unbound high-priority queue on those CPUs; 2: one such CPU chosen at probe; runtime 0644)"
+);
+
 /// Storage of `g16_pmp_agx` (runtime 0644, default 1).
 static PMP_AGX: AtomicU32 = AtomicU32::new(1);
 
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 2e1350bd3b..6ced625f47 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -61,6 +61,39 @@ fn tailcut_stats(f: &mut fmt::Formatter<'_>) -> fmt::Result {
     )
 }
 
+
+/// `g16_worker_big` counters: [0] poll passes on a max-capacity CPU, [1] on another CPU,
+/// [2] summed and [3] longest ns from an immediate queueing to the pass that ran it,
+/// [4] immediate queueings, [5] queueings that fell back to the default (switch on, but no
+/// big queue or online big CPU). Kept whatever the switch, so 0 shows where passes run today.
+static WBIG_N: [core::sync::atomic::AtomicU64; 6] =
+    [const { core::sync::atomic::AtomicU64::new(0) }; 6];
+/// Poll passes per CPU (CPUs above 15 counted as 15).
+static WBIG_CPU: [core::sync::atomic::AtomicU64; 16] =
+    [const { core::sync::atomic::AtomicU64::new(0) }; 16];
+/// Time of the oldest immediate queueing not yet run (0: none).
+static WBIG_QUEUED_NS: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+
+/// The `wbig:` line of the stats file.
+fn wbig_stats(f: &mut fmt::Formatter<'_>) -> fmt::Result {
+    let v = |i: usize| WBIG_N[i].load(Ordering::Relaxed);
+    write!(
+        f,
+        "wbig: on {} big_cpu {} passes_big {} passes_little {} lat_us {} lat_max_us {} queued {} fallback {} cpu",
+        params::worker_big(),
+        super::boot::glue::big_cpu(),
+        v(0),
+        v(1),
+        v(2) / 1000,
+        v(3) / 1000,
+        v(4),
+        v(5)
+    )?;
+    for c in &WBIG_CPU {
+        write!(f, " {}", c.load(Ordering::Relaxed))?;
+    }
+    writeln!(f)
+}
 /// The tile-buffer words of the last render published, for the stats line `fswords:`: the
 /// FS record's tilebuffer control, tile mode and ISP control, the utile config, sample size
 /// and samples, ZLS control, PPP multisample control and the framebuffer size.
@@ -367,6 +400,20 @@ pub(crate) fn run_poll(self: Arc<Self>) {
         if self.sleeping.load(Ordering::Acquire) {
             return;
         }
+        // g16_worker_big accounting: the CPU running this pass, and the time since the
+        // immediate queueing it serves (reads and counters only).
+        {
+            let cpu = super::boot::glue::this_cpu();
+            let big = super::boot::glue::cpu_is_big(cpu);
+            WBIG_N[if big { 0 } else { 1 }].fetch_add(1, Ordering::Relaxed);
+            WBIG_CPU[(cpu.max(0) as usize).min(15)].fetch_add(1, Ordering::Relaxed);
+            let queued = WBIG_QUEUED_NS.swap(0, Ordering::Relaxed);
+            if queued != 0 {
+                let ns = now_ns().saturating_sub(queued);
+                WBIG_N[2].fetch_add(ns, Ordering::Relaxed);
+                WBIG_N[3].fetch_max(ns, Ordering::Relaxed);
+            }
+        }
         self.work_ticks.store(counter_ticks(), Ordering::Relaxed);
         let signalling = kernel::dma_fence::SignallingGuard::new();
         let mut done = Completions::new();
@@ -559,15 +606,35 @@ pub(crate) fn poll_now(self: &Arc<Self>) {
     /// Queues the poll on `system_highpri_wq` after `delay` jiffies, or moves an already
     /// pending one to that expiry.
     fn mod_poll(self: &Arc<Self>, delay: Jiffies) {
+        // g16_worker_big: 1 the unbound big-CPU queue, 2 one big CPU on system_highpri_wq,
+        // else (or without them) the queueing CPU's system_highpri_wq worker, as before.
+        let unbound = bindings::wq_misc_consts_WORK_CPU_UNBOUND as kernel::ffi::c_int;
+        let mode = params::worker_big();
+        let (big_wq, big_cpu) = (super::boot::glue::big_wq(), super::boot::glue::big_cpu());
+        let target = match mode {
+            1 if !big_wq.is_null() => Some((unbound, big_wq)),
+            2 if big_cpu >= 0 => Some((big_cpu, core::ptr::null_mut())),
+            _ => None,
+        };
+        if mode != 0 && target.is_none() {
+            WBIG_N[5].fetch_add(1, Ordering::Relaxed);
+        }
+        if delay == 0 {
+            WBIG_N[4].fetch_add(1, Ordering::Relaxed);
+            let _ =
+                WBIG_QUEUED_NS.compare_exchange(0, now_ns(), Ordering::Relaxed, Ordering::Relaxed);
+        }
+        let (cpu, wq) = target.unwrap_or((unbound, core::ptr::null_mut()));
         // SAFETY: The closure returns false only when `mod_delayed_work_on` found the work
         // already pending (it then only modified its timer), so the queue keeps the reference
         // it took when it was queued; otherwise the work is queued and owns this reference.
+        // `aurora_g16_big` is created at probe and never destroyed.
         let _ = unsafe {
             <Arc<Shared> as RawWorkItem<POLL_WORK>>::__enqueue(self.clone(), |work| {
                 let dwork = kernel::container_of!(work, bindings::delayed_work, work);
                 !bindings::mod_delayed_work_on(
-                    bindings::wq_misc_consts_WORK_CPU_UNBOUND as kernel::ffi::c_int,
-                    bindings::system_highpri_wq,
+                    cpu,
+                    if wq.is_null() { bindings::system_highpri_wq } else { wq },
                     dwork,
                     delay,
                 )
@@ -1861,6 +1928,7 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
             self.session.shared.irq_bells.load(Ordering::Relaxed)
         )?;
         super::encode::replay::stats(f)?;
+        wbig_stats(f)?;
         let probe = &super::pools::PROBE;
         writeln!(
             f,
