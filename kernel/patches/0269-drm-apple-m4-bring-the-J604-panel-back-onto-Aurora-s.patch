+#include <linux/of.h>
+#include <linux/of_address.h>
 #include <linux/string.h>
 #include <linux/sizes.h>
 #include <linux/unaligned.h>
@@ -63,6 +67,16 @@ static enum dcp_panel_gamut dcp_adt_gamut(const u8 *value, u32 size)
 	return DCP_PANEL_GAMUT_UNSPECIFIED;
 }
 
+/* Whole units of a positive binary32 below 2^24; 0 for anything else. */
+static u32 dcp_adt_binary32_int(u32 bits)
+{
+	int exponent = (int)((bits >> 23) & 0xff) - 127;
+
+	if (bits >> 31 || exponent < 0 || exponent > 23)
+		return 0;
+	return ((bits & GENMASK(22, 0)) | BIT(23)) >> (23 - exponent);
+}
+
 static const u8 *dcp_adt_bytes(struct dcp_adt_cursor *c, size_t size)
 {
 	const u8 *p;
@@ -123,6 +137,8 @@ static int dcp_adt_node(struct dcp_adt_cursor *c, struct dcp_panel_adt *panel,
 	char node_name[33] = {};
 	enum dcp_panel_gamut gamut = DCP_PANEL_GAMUT_UNSPECIFIED;
 	bool gamut_seen = false, matrix_seen = false, matrix_valid = false;
+	bool aurora = false;
+	u32 aurora_nits = 0;
 	bool product, selected, backlight;
 
 	if (IS_ERR(header))
@@ -173,12 +189,21 @@ static int dcp_adt_node(struct dcp_adt_cursor *c, struct dcp_panel_adt *panel,
 			matrix_valid = !matrix_seen &&
 				dcp_adt_calibration_matrix(prop + 36, size);
 			matrix_seen = true;
-		} else if (backlight && !strcmp(name, "EDRPotentialHeadroom") && size == 4)
+		} else if (backlight && !strcmp(name, "EDRPotentialHeadroom") && size == 4) {
 			panel->edr_potential_headroom = get_unaligned_le32(prop + 36);
-		else if (backlight && !strcmp(name, "LmaxProduct") && size == 4)
+		} else if (backlight && !strcmp(name, "LmaxProduct") && size == 4) {
 			panel->lmax_product = get_unaligned_le32(prop + 36);
+		} else if (backlight && !strcmp(name, "supports-aurora") && size == 4) {
+			aurora = get_unaligned_le32(prop + 36) == 1;
+		} else if (backlight && !strcmp(name, "aurora-maximum-nits") && size == 4) {
+			aurora_nits = dcp_adt_binary32_int(get_unaligned_le32(prop + 36));
+		} else if (backlight && !strcmp(name, "thermal-mitigation-min-cap") && size == 4) {
+			panel->thermal_min_cap = get_unaligned_le32(prop + 36) >> 16;
+		}
 		c->pos += 36 + ALIGN((size_t)size, 4);
 	}
+	if (backlight)
+		panel->aurora_max_nits = aurora ? aurora_nits : 0;
 	if (product)
 		panel->gamut = gamut_seen && matrix_seen && matrix_valid ?
 			gamut : DCP_PANEL_GAMUT_UNSPECIFIED;
@@ -207,3 +232,37 @@ int dcp_panel_adt_parse(const void *data, size_t size, struct dcp_panel_adt *pan
 		*panel = parsed;
 	return ret;
 }
+
+/*
+ * m1n1 reserves the original ADT as a phram node labelled "adt" (as
+ * dcp_panel_read_adt() in dcp.c reads it). Read it without an MTD dependency,
+ * for a backend that reads the panel properties itself (T8132).
+ */
+int dcp_panel_adt_read(struct dcp_panel_adt *panel)
+{
+	struct device_node *np;
+	const char *label;
+	struct resource res;
+	void *data;
+	int ret = -ENODATA;
+
+	for_each_compatible_node(np, NULL, "phram") {
+		if (of_property_read_string(np, "label", &label) || strcmp(label, "adt"))
+			continue;
+		if (of_address_to_resource(np, 0, &res) ||
+		    !resource_size(&res) || resource_size(&res) > SZ_16M) {
+			ret = -EINVAL;
+			break;
+		}
+		data = memremap(res.start, resource_size(&res), MEMREMAP_WB);
+		if (!data) {
+			ret = -ENOMEM;
+			break;
+		}
+		ret = dcp_panel_adt_parse(data, resource_size(&res), panel);
+		memunmap(data);
+		break;
+	}
+	of_node_put(np);
+	return ret;
+}
