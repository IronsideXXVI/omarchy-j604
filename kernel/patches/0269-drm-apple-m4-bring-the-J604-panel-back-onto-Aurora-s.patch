diff --git a/drivers/gpu/drm/apple/dcp-m4-edr-test.c b/drivers/gpu/drm/apple/dcp-m4-edr-test.c
new file mode 100644
index 0000000000..e292488001
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-edr-test.c
@@ -0,0 +1,281 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/*
+ * EDR words of the T8132 panel swap (dcp-m4-edr.h) with the J604's ADT
+ * values: a 1600 nit peak (LmaxProduct), a potential headroom of 16.0, a 600
+ * nit SDR maximum.  The binary64 encoding, where each word lands in the
+ * record, the start ramp, a brightness change during EDR, the end of EDR in
+ * one swap, the ramp after a blank, that SDR frames carry nothing, and that
+ * the headroom follows the content's MaxCLL.
+ */
+
+#include <kunit/test.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "dcp-m4-edr.h"
+
+#define J604_PEAK	1600U
+#define J604_CEILING	dcp_edr_ceiling(16U << 16)
+#define SWAP_SIZE	0x588
+
+static void edr_binary64(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(1, 1), 0x3ff0000000000000ULL);
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(16, 1), 0x4030000000000000ULL);
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(1600, 1), 0x4099000000000000ULL);
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(1000, 16000), 0x3fb0000000000000ULL);
+	/* 1 / 3 rounds to nearest. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(1, 3), 0x3fd5555555555555ULL);
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(0, 1), 0ULL);
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(1, 0), 0ULL);
+}
+
+/* The desktop 26.x dcp_swap offsets (Aurora iomfb_template.h static_asserts). */
+static void edr_words_land_at_the_desktop_offsets(struct kunit *test)
+{
+	const struct dcp_m4_edr_words w = { .nits = 1600, .hm = 16000, .used = 16000,
+					    .limit = 1600 * 13 };
+	u8 *swap = kunit_kzalloc(test, SWAP_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, swap);
+	dcp_m4_swap_set_edr(swap, &w);
+	KUNIT_EXPECT_EQ(test, swap[0x354], 1);
+	KUNIT_EXPECT_EQ(test, swap[0x358], 0);
+	KUNIT_EXPECT_EQ(test, swap[0x359], 1);
+	KUNIT_EXPECT_EQ(test, swap[0x35a], 1);
+	KUNIT_EXPECT_EQ(test, swap[0x35b], 0);
+	KUNIT_EXPECT_EQ(test, swap[0x35c], 1);
+	KUNIT_EXPECT_EQ(test, swap[0x35d], 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x35e), 0x4099000000000000ULL);
+	/* limit 2080 nits, scale 1 / 16, headroom used 16 */
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x376), 0x40a0400000000000ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x37e), 0x3fb0000000000000ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x3e6), 0x4030000000000000ULL);
+}
+
+/* Words left out leave their flag and value alone. */
+static void edr_words_left_out(struct kunit *test)
+{
+	const struct dcp_m4_edr_words w = { .nits = 140, .hm = 1000 };
+	u8 *swap = kunit_kzalloc(test, SWAP_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, swap);
+	dcp_m4_swap_set_edr(swap, &w);
+	KUNIT_EXPECT_EQ(test, swap[0x359], 0);
+	KUNIT_EXPECT_EQ(test, swap[0x35c], 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x376), 0ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x3e6), 0ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x37e), 0x3ff0000000000000ULL);
+}
+
+static void edr_sdr_frames_carry_nothing(struct kunit *test)
+{
+	struct dcp_m4_edr_state st = {};
+	struct dcp_m4_edr_words w;
+
+	for (unsigned int i = 0; i < 10; i++)
+		KUNIT_EXPECT_FALSE(test, dcp_m4_edr_step(&st, false, i & 1, 140, J604_PEAK,
+							 J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, st.hm, 0U);
+	/* The colour tags of an SDR frame stay the ones 1.607 sends. */
+	KUNIT_EXPECT_EQ(test, DCP_M4_XFER_SRGB, 13);
+	KUNIT_EXPECT_EQ(test, DCP_M4_PRIMARIES_P3_D65, 12);
+}
+
+/* At 140 nits SDR white the panel reaches its peak: H = 1600 / 140. */
+static void edr_ramp_to_the_peak(struct kunit *test)
+{
+	struct dcp_m4_edr_state st = {};
+	struct dcp_m4_edr_words w;
+	unsigned int swaps = 0;
+	u32 last = 0;
+
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(J604_PEAK, 140, J604_CEILING), 11428U);
+	while (dcp_m4_edr_step(&st, true, false, 140, J604_PEAK, J604_CEILING, &w)) {
+		KUNIT_EXPECT_GT(test, w.hm, last);
+		KUNIT_EXPECT_EQ(test, w.used, w.hm);
+		KUNIT_EXPECT_LE(test, w.nits, J604_PEAK);
+		KUNIT_EXPECT_EQ(test, w.nits, 140 * w.hm / 1000);
+		/* The brightness limit runs with the ramp only. */
+		KUNIT_EXPECT_EQ(test, w.limit, w.hm == 11428 ? 0 : w.nits * 13);
+		last = w.hm;
+		KUNIT_ASSERT_LT(test, ++swaps, 100U);
+	}
+	KUNIT_EXPECT_EQ(test, st.hm, 11428U);
+	KUNIT_EXPECT_EQ(test, 140 * st.hm / 1000, 1599U);
+	KUNIT_EXPECT_TRUE(test, st.sent);
+}
+
+/* Dim SDR white: the potential headroom caps H; bright: the peak does. */
+static void edr_ceiling_and_sdr_maximum(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, J604_CEILING, 16000U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(J604_PEAK, 50, J604_CEILING), 16000U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(J604_PEAK, 600, J604_CEILING), 2666U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(J604_PEAK, 1600, J604_CEILING), 1000U);
+}
+
+static void edr_settle(struct dcp_m4_edr_state *st, u32 sdr)
+{
+	struct dcp_m4_edr_words w;
+
+	for (unsigned int i = 0; i < 100; i++)
+		if (!dcp_m4_edr_step(st, true, false, sdr, J604_PEAK, J604_CEILING, &w))
+			break;
+}
+
+/* A brightness change during EDR carries SDR white x H, not SDR white. */
+static void edr_brightness_change(struct kunit *test)
+{
+	struct dcp_m4_edr_state st = {};
+	struct dcp_m4_edr_words w;
+
+	edr_settle(&st, 400);
+	KUNIT_EXPECT_EQ(test, st.hm, 4000U);
+	KUNIT_ASSERT_TRUE(test, dcp_m4_edr_step(&st, true, true, 400, J604_PEAK,
+						 J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, w.nits, 1600U);
+	/* Brighter SDR white: less headroom at once, the level holds the peak. */
+	KUNIT_ASSERT_TRUE(test, dcp_m4_edr_step(&st, true, true, 500, J604_PEAK,
+						 J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, w.hm, 3200U);
+	KUNIT_EXPECT_EQ(test, w.nits, 1600U);
+}
+
+/* EDR ends in one swap: H 1.0, headroom used 1.0, then the firmware's values. */
+static void edr_ends_in_one_swap(struct kunit *test)
+{
+	struct dcp_m4_edr_state st = {};
+	struct dcp_m4_edr_words w;
+
+	edr_settle(&st, 140);
+	KUNIT_ASSERT_TRUE(test, dcp_m4_edr_step(&st, false, false, 140, J604_PEAK,
+						 J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, w.hm, 1000U);
+	KUNIT_EXPECT_EQ(test, w.used, 1000U);
+	KUNIT_EXPECT_EQ(test, w.nits, 140U);
+	KUNIT_EXPECT_EQ(test, w.limit, 0U);
+	KUNIT_EXPECT_EQ(test, st.hm, 0U);
+	KUNIT_EXPECT_FALSE(test, st.sent);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_edr_step(&st, false, false, 140, J604_PEAK,
+						  J604_CEILING, &w));
+}
+
+/* After a blank the ramp starts from 1.0 again; an unlit panel gets nothing. */
+static void edr_restart_and_unlit(struct kunit *test)
+{
+	struct dcp_m4_edr_state st = {};
+	struct dcp_m4_edr_words w;
+
+	edr_settle(&st, 140);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_edr_step(&st, true, false, 0, J604_PEAK,
+						  J604_CEILING, &w));
+	st.restart = true;
+	KUNIT_ASSERT_TRUE(test, dcp_m4_edr_step(&st, true, false, 140, J604_PEAK,
+						 J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, w.hm, 1048U);
+	KUNIT_EXPECT_FALSE(test, st.restart);
+}
+
+/* MaxCLL over PQ 100 (SDR white), within [1.0, the bound]; 0: the bound. */
+static void edr_content_headroom(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 0), 16000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(3333, 0), 3333U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 100), 1000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 80), 1000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 1), 1000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 203), 2030U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 1000), 10000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(3333, 1000), 3333U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 65535), 16000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(1000, 400), 1000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(0, 400), 1000U);
+}
+
+/*
+ * An SDR desktop kept in PQ (MaxCLL at SDR white) runs at H 1.0: the panel
+ * level is SDR white and the scale 1, as without EDR.  HDR content raises H
+ * to what it needs, in steps; when it goes, H is 1.0 again in one swap while
+ * the frames stay PQ.
+ */
+static void edr_follows_the_content(struct kunit *test)
+{
+	struct dcp_m4_edr_state st = { .cll = 100 };
+	struct dcp_m4_edr_words w;
+
+	KUNIT_ASSERT_TRUE(test, dcp_m4_edr_step(&st, true, false, 480, J604_PEAK,
+						J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, w.hm, 1000U);
+	KUNIT_EXPECT_EQ(test, w.used, 1000U);
+	KUNIT_EXPECT_EQ(test, w.nits, 480U);
+	KUNIT_EXPECT_EQ(test, w.limit, 0U);
+	KUNIT_EXPECT_TRUE(test, st.sent);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_edr_step(&st, true, false, 480, J604_PEAK,
+						 J604_CEILING, &w));
+	/* A 1000 nit clip at 140 nits SDR white: H 10.0, below the peak's 11.428. */
+	st.cll = 1000;
+	edr_settle(&st, 140);
+	KUNIT_EXPECT_EQ(test, st.hm, 10000U);
+	/* Brighter than the panel: the peak bounds it, as before. */
+	st.cll = 4000;
+	edr_settle(&st, 140);
+	KUNIT_EXPECT_EQ(test, st.hm, 11428U);
+	/* The clip goes, the desktop stays PQ: H 1.0 in one swap. */
+	st.cll = 100;
+	KUNIT_ASSERT_TRUE(test, dcp_m4_edr_step(&st, true, false, 140, J604_PEAK,
+						J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, w.hm, 1000U);
+	KUNIT_EXPECT_EQ(test, w.used, 1000U);
+	KUNIT_EXPECT_EQ(test, w.nits, 140U);
+	KUNIT_EXPECT_EQ(test, st.hm, 1000U);
+	KUNIT_EXPECT_TRUE(test, st.sent);
+	/* No MaxCLL: the bound, as before this change. */
+	st.cll = 0;
+	edr_settle(&st, 140);
+	KUNIT_EXPECT_EQ(test, st.hm, 11428U);
+}
+
+/* Bright surroundings: the user's 600 nit full scale shows the ADT 1001. */
+static void boost_scales_the_user_level(struct kunit *test)
+{
+	u8 *swap = kunit_kzalloc(test, SWAP_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, swap);
+	KUNIT_EXPECT_EQ(test, dcp_m4_boost_level(600, 600, 1001), 1001U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_boost_level(300, 600, 1001), 501U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_boost_level(0, 600, 1001), 0U);
+	/* No ceiling, or none above the user maximum: the level stands. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_boost_level(140, 600, 0), 140U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_boost_level(140, 600, 600), 140U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_boost_level(700, 600, 1001), 1001U);
+	dcp_m4_swap_set_level(swap, 1001);
+	KUNIT_EXPECT_EQ(test, swap[0x354], 1);
+	KUNIT_EXPECT_EQ(test, swap[0x359], 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x35e), dcp_m4_binary64_ratio(1001, 1));
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x35e), 0x408f480000000000ULL);
+}
+
+static struct kunit_case m4_edr_cases[] = {
+	KUNIT_CASE(edr_binary64),
+	KUNIT_CASE(edr_words_land_at_the_desktop_offsets),
+	KUNIT_CASE(edr_words_left_out),
+	KUNIT_CASE(edr_sdr_frames_carry_nothing),
+	KUNIT_CASE(edr_ramp_to_the_peak),
+	KUNIT_CASE(edr_ceiling_and_sdr_maximum),
+	KUNIT_CASE(edr_brightness_change),
+	KUNIT_CASE(edr_ends_in_one_swap),
+	KUNIT_CASE(edr_restart_and_unlit),
+	KUNIT_CASE(edr_content_headroom),
+	KUNIT_CASE(edr_follows_the_content),
+	KUNIT_CASE(boost_scales_the_user_level),
+	{}
+};
+
+static struct kunit_suite m4_edr_suite = {
+	.name = "apple-dcp-m4-edr",
+	.test_cases = m4_edr_cases,
+};
+
+kunit_test_suite(m4_edr_suite);
diff --git a/drivers/gpu/drm/apple/dcp-m4-edr.h b/drivers/gpu/drm/apple/dcp-m4-edr.h
new file mode 100644
index 0000000000..864509b8fc
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-edr.h
@@ -0,0 +1,209 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * EDR on the internal panel of the T8132 backend (firmware 26.6.2): the swap
+ * words and the per-swap headroom, as the desktop 26.x driver drives them
+ * (Aurora's dcp_edr_prepare(), ae07fd5bb6 / 7e6b33aa91 / 43f112d09a).  The
+ * 26.6.2 A407 record opens with the desktop 26.x dcp_swap layout (0x588 bytes,
+ * then the surfaces; dcp-m4-frame.h), so the words sit at its offsets.
+ *
+ * With applied headroom H (x1000), a swap asks for brightness SDR white x H,
+ * display EDR scale 1 / H and, while the frame uses EDR, headroom used H; the
+ * firmware shows a PQ surface at (PQ nits / 100) x the scale x the panel level,
+ * so PQ 100 lands at SDR white and highlights reach the panel peak.  H rises
+ * one step per swap (dcp_edr_next()), never above the ADT potential headroom.
+ *
+ * Pure functions on a byte record, for the KUnit suite.
+ */
+#ifndef APPLE_DCP_M4_EDR_H
+#define APPLE_DCP_M4_EDR_H
+
+#include <linux/bits.h>
+#include <linux/math.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+
+#include "dcp-edr.h"
+
+#define DCP_M4_SWAP_BL_UPDATE		0x354	/* u8: the panel level is valid */
+#define DCP_M4_SWAP_BL_FLAGS		0x358	/* u8[6]: which of the words below */
+#define DCP_M4_SWAP_BL_NITS		0x35e	/* binary64: the panel level, nits */
+#define DCP_M4_SWAP_BL_LIMIT		0x376	/* binary64, bl_flags[1]: brightness limit */
+#define DCP_M4_SWAP_EDR_SCALE		0x37e	/* binary64, bl_flags[2]: SDR white / level */
+#define DCP_M4_SWAP_EDR_HEADROOM	0x3e6	/* binary64, bl_flags[4]: headroom used */
+
+/*
+ * The IOSurface colour tags of a surface record: ITU-T H.273
+ * TransferCharacteristics and ColourPrimaries code points.
+ */
+#define DCP_M4_SURFACE_XFER		0x13
+#define DCP_M4_SURFACE_PRIMARIES	0x14
+#define DCP_M4_XFER_SRGB		13
+#define DCP_M4_XFER_PQ			16
+#define DCP_M4_PRIMARIES_BT709		1
+#define DCP_M4_PRIMARIES_BT2020		9
+#define DCP_M4_PRIMARIES_P3_D65		12
+
+/* The highest panel level an EDR swap may ask for (PQ's own ceiling). */
+#define DCP_M4_EDR_MAX_NITS		10000U
+
+/* The binary64 nearest @num / @den, for small positive integers; 0 for 0. */
+static inline u64 dcp_m4_binary64_ratio(u64 num, u64 den)
+{
+	u64 mantissa = 0;
+	int exponent = 0;
+
+	if (!num || !den)
+		return 0;
+	while (num >= 2 * den) {
+		den <<= 1;
+		exponent++;
+	}
+	while (num < den) {
+		num <<= 1;
+		exponent--;
+	}
+	/* den <= num < 2 den: 53 quotient bits, then round to nearest */
+	for (unsigned int i = 0; i < 53; i++) {
+		mantissa <<= 1;
+		if (num >= den) {
+			mantissa |= 1;
+			num -= den;
+		}
+		num <<= 1;
+	}
+	if (num >= den && ++mantissa == 1ULL << 53) {
+		mantissa >>= 1;
+		exponent++;
+	}
+	return (u64)(exponent + 1023) << 52 | (mantissa & GENMASK_ULL(51, 0));
+}
+
+/* What one swap carries; 0 leaves a word out (the firmware keeps it). */
+struct dcp_m4_edr_words {
+	u32 nits;	/* the panel level: SDR white x hm / 1000 */
+	u32 hm;		/* applied headroom x1000: display EDR scale 1000 / hm */
+	u32 used;	/* headroom used x1000 */
+	u32 limit;	/* brightness limit x10, while the ramp runs */
+};
+
+struct dcp_m4_edr_state {
+	u32 hm;		/* applied headroom x1000; 0: none, the firmware's values */
+	u32 sdr;	/* SDR white of the last EDR swap */
+	u32 cll;	/* MaxCLL of the frames in nits; 0: not given */
+	bool sent;	/* swaps carry headroom used */
+	bool restart;	/* the next EDR ramp starts again from 1.0 */
+};
+
+/*
+ * The firmware shows PQ n nits at n / 100 of SDR white (above), so PQ 100 is
+ * SDR white, and content whose brightest pixel is @cll nits (the MaxCLL of
+ * HDR_OUTPUT_METADATA) needs headroom @cll / 100.  The headroom of a frame is
+ * that, within [1.0, @bound], @bound being what the panel allows
+ * (dcp_edr_target()).  0: the compositor gave no MaxCLL, so @bound, as before.
+ * A compositor that keeps an SDR desktop in PQ and sends MaxCLL 100 or less
+ * keeps the panel at SDR white with the scale at 1, as without EDR, and the
+ * headroom rises only while brighter content is on screen.
+ */
+#define DCP_M4_EDR_SDR_PQ_NITS		100U
+
+static inline u32 dcp_m4_edr_content(u32 bound, u32 cll)
+{
+	u64 hm;
+
+	if (!cll)
+		return bound;
+	hm = div_u64((u64)cll * DCP_EDR_UNITY, DCP_M4_EDR_SDR_PQ_NITS);
+	if (hm > bound)
+		hm = bound;
+	if (hm < DCP_EDR_UNITY)
+		hm = DCP_EDR_UNITY;
+	return hm;
+}
+
+/*
+ * dcp_edr_prepare() for one present.  @edr: the frame is BT.2020 PQ shown as
+ * EDR; @carries: the swap carries a new SDR white @sdr, otherwise @sdr is the
+ * level that stands; @st->cll the content's MaxCLL (dcp_m4_edr_content()).
+ * Returns true with @w set when the swap carries words.
+ */
+static inline bool dcp_m4_edr_step(struct dcp_m4_edr_state *st, bool edr, bool carries,
+				   u32 sdr, u32 peak, u32 ceiling,
+				   struct dcp_m4_edr_words *w)
+{
+	u32 cur = st->hm ?: DCP_EDR_UNITY, target = DCP_EDR_UNITY, next, nits;
+	u32 prev_sdr = st->sdr;
+	bool restart = st->restart;
+
+	st->restart = false;
+	if (!edr && !st->hm)
+		return false;	/* no EDR, and none to wind down */
+	if (!sdr)
+		return false;	/* off: a swap that turns the panel off keeps its zero */
+	if (edr)
+		target = dcp_m4_edr_content(dcp_edr_target(peak, sdr, ceiling), st->cll);
+	if (restart && edr) {
+		cur = DCP_EDR_UNITY;
+		prev_sdr = sdr;
+	}
+	st->sdr = sdr;
+	if (cur == target && !carries && !restart && st->sent == edr)
+		return false;
+
+	/* Up in steps; down at once (a still desktop may send no further swap). */
+	next = dcp_edr_next(cur, target, prev_sdr, sdr);
+	nits = min_t(u64, (u64)sdr * next / DCP_EDR_UNITY, DCP_M4_EDR_MAX_NITS);
+	*w = (struct dcp_m4_edr_words) { .nits = nits, .hm = next };
+	if (edr) {
+		w->used = next;
+		st->sent = true;
+	} else if (st->sent) {
+		w->used = DCP_EDR_UNITY;
+		st->sent = false;
+	}
+	if (next != target && next != cur)
+		w->limit = nits * 13;
+	/* Back at 1.0 without EDR: leave the firmware's values alone again. */
+	st->hm = (!edr && next == DCP_EDR_UNITY) ? 0 : next;
+	return true;
+}
+
+/*
+ * The panel level with a raised SDR ceiling (bright surroundings): the user's
+ * full scale @user_max shows @ceiling nits, the rest in proportion.
+ * 0 (no ceiling) keeps the level.
+ */
+static inline u32 dcp_m4_boost_level(u32 nits, u32 user_max, u32 ceiling)
+{
+	if (!ceiling || !user_max || ceiling <= user_max)
+		return nits;
+	return min_t(u64, DIV_ROUND_CLOSEST_ULL((u64)nits * ceiling, user_max), ceiling);
+}
+
+/* A panel level above the user maximum, written after the encoder's own. */
+static inline void dcp_m4_swap_set_level(u8 *swap, u32 nits)
+{
+	swap[DCP_M4_SWAP_BL_UPDATE] = 1;
+	put_unaligned_le64(dcp_m4_binary64_ratio(nits, 1), swap + DCP_M4_SWAP_BL_NITS);
+}
+
+/* Write @w into an encoded swap record (after dcp_m4_swap_encode_full()). */
+static inline void dcp_m4_swap_set_edr(u8 *swap, const struct dcp_m4_edr_words *w)
+{
+	swap[DCP_M4_SWAP_BL_UPDATE] = 1;
+	put_unaligned_le64(dcp_m4_binary64_ratio(w->nits, 1), swap + DCP_M4_SWAP_BL_NITS);
+	swap[DCP_M4_SWAP_BL_FLAGS + 2] = 1;
+	put_unaligned_le64(dcp_m4_binary64_ratio(DCP_EDR_UNITY, w->hm),
+			   swap + DCP_M4_SWAP_EDR_SCALE);
+	if (w->used) {
+		swap[DCP_M4_SWAP_BL_FLAGS + 4] = 1;
+		put_unaligned_le64(dcp_m4_binary64_ratio(w->used, DCP_EDR_UNITY),
+				   swap + DCP_M4_SWAP_EDR_HEADROOM);
+	}
+	if (w->limit) {
+		swap[DCP_M4_SWAP_BL_FLAGS + 1] = 1;
+		put_unaligned_le64(dcp_m4_binary64_ratio(w->limit, 10),
+				   swap + DCP_M4_SWAP_BL_LIMIT);
+	}
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-ext-colour-test.c b/drivers/gpu/drm/apple/dcp-m4-ext-colour-test.c
new file mode 100644
index 0000000000..398ff9a11b
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-ext-colour-test.c
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/*
+ * The colour of a T8132 external link (dcp-m4-ext-colour.h): which elements
+ * count as deep SDR or HDR10, and which one a commit runs for its HDR state,
+ * max bpc and the link's capacity.
+ */
+
+#include <kunit/test.h>
+
+#include "dcp-m4-ext-colour.h"
+
+/* A 4K60 timing (594 MHz) on a link of 24 Gbit/s (in kHz x bits). */
+#define CLOCK	594000U
+#define ROOM	(594000ULL * 30)
+#define TIGHT	(594000ULL * 24)
+
+static struct dcp_color_element el(s64 id, s64 depth, s64 eotf, s64 colorimetry)
+{
+	return (struct dcp_color_element){ .id = id, .depth = depth, .eotf = eotf,
+					   .colorimetry = colorimetry, .score = 1,
+					   .encoding = DCP_COLOR_FORMAT_RGB,
+					   .range = DCP_COLOR_YCBCR_RANGE_FULL };
+}
+
+/* A sink with HDR10: an 8 bpc SDR (id 1), 10 bpc SDR (2) and 10 bpc PQ BT.2020 (3) element. */
+static void hdr_sink(struct dcp_m4_ext_colours *c)
+{
+	struct dcp_color_element sdr10 = el(2, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	struct dcp_color_element pq = el(3, 10, DCP_EOTF_ST_2084, DCP_COLORIMETRY_BT2020_RGB);
+
+	*c = (struct dcp_m4_ext_colours){};
+	dcp_m4_ext_colour_take(c, &sdr10);
+	dcp_m4_ext_colour_take(c, &pq);
+}
+
+static void ext_colour_classes(struct kunit *test)
+{
+	struct dcp_color_element e = el(5, 10, DCP_EOTF_ST_2084, DCP_COLORIMETRY_BT2020_RGB);
+
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_colour_pq(&e));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	/* HLG, or PQ in another colorimetry, or at 12 bpc: not HDR10 here. */
+	e.eotf = DCP_EOTF_BT_2100;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_pq(&e));
+	e = el(5, 10, DCP_EOTF_ST_2084, DCP_COLORIMETRY_BT2020_YCC);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_pq(&e));
+	e = el(5, 12, DCP_EOTF_ST_2084, DCP_COLORIMETRY_BT2020_RGB);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_pq(&e));
+	/* DSC, YCbCr, virtual, unsafe, no ID or a negative score: never. */
+	e = el(6, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_colour_sdr10(&e));
+	e.dsc_required = true;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	e = el(6, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	e.encoding = DCP_COLOR_FORMAT_YCBCR444;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	e = el(6, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	e.is_virtual = true;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	e = el(6, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	e.unsafe = true;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	e = el(-1, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	e = el(6, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	e.score = -1;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	/* 8 bpc is the existing element's, not a deep one. */
+	e = el(6, 8, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+}
+
+static void ext_colour_takes_the_best(struct kunit *test)
+{
+	struct dcp_m4_ext_colours c = {};
+	struct dcp_color_element a = el(7, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_BT601);
+	struct dcp_color_element b = el(8, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	struct dcp_color_element lim = el(9, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+
+	dcp_m4_ext_colour_take(&c, &a);
+	KUNIT_EXPECT_TRUE(test, c.has_sdr10);
+	KUNIT_EXPECT_EQ(test, c.sdr10.id, 7);
+	/* sRGB over BT.601 at one range. */
+	dcp_m4_ext_colour_take(&c, &b);
+	KUNIT_EXPECT_EQ(test, c.sdr10.id, 8);
+	/* Limited range never over full range. */
+	lim.range = DCP_COLOR_YCBCR_RANGE_LIMITED;
+	lim.score = 100;
+	dcp_m4_ext_colour_take(&c, &lim);
+	KUNIT_EXPECT_EQ(test, c.sdr10.id, 8);
+	/* The same rank: the higher score. */
+	lim = el(10, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	lim.score = 5;
+	dcp_m4_ext_colour_take(&c, &lim);
+	KUNIT_EXPECT_EQ(test, c.sdr10.id, 10);
+	KUNIT_EXPECT_FALSE(test, c.has_pq);
+}
+
+static void ext_colour_sdr_is_deep_by_default(struct kunit *test)
+{
+	struct dcp_m4_ext_colours c;
+	struct dcp_m4_ext_want w = { .max_bpc = 10 };
+	struct dcp_m4_ext_choice ch;
+
+	hdr_sink(&c);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, ROOM, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.color, 2U);
+	KUNIT_EXPECT_EQ(test, ch.depth, 10U);
+	KUNIT_EXPECT_FALSE(test, ch.pq);
+	/* max bpc 8 (or unset): the 8 bpc element. */
+	w.max_bpc = 8;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, ROOM, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.color, 1U);
+	KUNIT_EXPECT_EQ(test, ch.depth, 8U);
+	w.max_bpc = 0;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, ROOM, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.depth, 8U);
+}
+
+static void ext_colour_link_bounds_depth(struct kunit *test)
+{
+	struct dcp_m4_ext_colours c;
+	struct dcp_m4_ext_want w = { .max_bpc = 10 };
+	struct dcp_m4_ext_choice ch;
+
+	hdr_sink(&c);
+	/* 24 bits per pixel fit, 30 do not: 8 bpc. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, TIGHT, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.depth, 8U);
+	KUNIT_EXPECT_EQ(test, ch.color, 1U);
+	/* The 8 bpc element needs DSC: no deep element over it. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, true, &c, CLOCK, ROOM, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.depth, 8U);
+	/* Capacity unknown (0): the deep element. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, 0, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.depth, 10U);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_fits_bpp(CLOCK, 30, ROOM));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_fits_bpp(CLOCK, 30, ROOM - 1));
+}
+
+static void ext_colour_pq(struct kunit *test)
+{
+	struct dcp_m4_ext_colours c;
+	struct dcp_m4_ext_want w = { .pq = true, .max_bpc = 10 };
+	struct dcp_m4_ext_choice ch = {};
+
+	hdr_sink(&c);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, ROOM, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.color, 3U);
+	KUNIT_EXPECT_EQ(test, ch.depth, 10U);
+	KUNIT_EXPECT_TRUE(test, ch.pq);
+	/* Refused, never SDR in its place: no PQ element, no room, max bpc 8. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, TIGHT, &ch),
+			-EINVAL);
+	w.max_bpc = 8;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, ROOM, &ch),
+			-EINVAL);
+	w.max_bpc = 10;
+	c.has_pq = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, ROOM, &ch),
+			-EINVAL);
+}
+
+static void ext_colour_known(struct kunit *test)
+{
+	struct dcp_m4_ext_colours c;
+
+	hdr_sink(&c);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_colour_known(1, 1, &c));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_colour_known(2, 1, &c));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_colour_known(3, 1, &c));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_known(4, 1, &c));
+	c.has_pq = false;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_known(3, 1, &c));
+}
+
+static struct kunit_case m4_ext_colour_cases[] = {
+	KUNIT_CASE(ext_colour_classes),
+	KUNIT_CASE(ext_colour_takes_the_best),
+	KUNIT_CASE(ext_colour_sdr_is_deep_by_default),
+	KUNIT_CASE(ext_colour_link_bounds_depth),
+	KUNIT_CASE(ext_colour_pq),
+	KUNIT_CASE(ext_colour_known),
+	{}
+};
+
+static struct kunit_suite m4_ext_colour_suite = {
+	.name = "apple-dcp-m4-ext-colour",
+	.test_cases = m4_ext_colour_cases,
+};
+
+kunit_test_suite(m4_ext_colour_suite);
diff --git a/drivers/gpu/drm/apple/dcp-m4-ext-colour.h b/drivers/gpu/drm/apple/dcp-m4-ext-colour.h
new file mode 100644
index 0000000000..a2b4df047f
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-ext-colour.h
@@ -0,0 +1,142 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The colour of a T8132 external output's link (firmware 26.6.2): which of
+ * the colour elements the firmware lists for a timing (from the sink's EDID)
+ * a commit runs, and which bits per pixel that takes on the link.
+ *
+ * Besides the 8 bpc RGB SDR element every offered timing has, a timing may
+ * list a 10 bpc RGB SDR one (deep colour) and, for a sink with HDR, a 10 bpc
+ * RGB ST 2084 (PQ) one in BT.2020 colorimetry (HDR10).  A commit asking for
+ * PQ in BT.2020 RGB (HDR_OUTPUT_METADATA EOTF ST 2084 and Colorspace
+ * BT2020_RGB, as the internal panel takes them) runs the PQ element, and
+ * fails its check where the timing has none; any other commit runs the
+ * deepest SDR element up to its max bpc that fits the link.  Elements that
+ * need DSC are not taken above 8 bpc; 12 bpc is not offered.
+ *
+ * Pure functions, for the KUnit suite.
+ */
+#ifndef APPLE_DCP_M4_EXT_COLOUR_H
+#define APPLE_DCP_M4_EXT_COLOUR_H
+
+#include <linux/errno.h>
+#include <linux/limits.h>
+#include <linux/types.h>
+
+#include "parser.h"
+
+#define DCP_M4_EXT_DEEP_BPC	10U	/* the deepest link depth taken */
+
+/* The deep and the HDR element of one timing, as the firmware lists them. */
+struct dcp_m4_ext_colours {
+	struct dcp_color_element sdr10, pq;
+	bool has_sdr10, has_pq;
+};
+
+/* What a commit asks of the link. */
+struct dcp_m4_ext_want {
+	bool pq;	/* ST 2084 in BT.2020 RGB */
+	u32 max_bpc;	/* the connector's max bpc (0: 8) */
+};
+
+/* The element chosen: its ID, depth and whether it is the PQ one. */
+struct dcp_m4_ext_choice {
+	u32 color, depth;
+	bool pq;
+};
+
+/* An element any choice may take: RGB, real, safe, with an ID and a score. */
+static inline bool dcp_m4_ext_colour_usable(const struct dcp_color_element *e)
+{
+	return !e->is_virtual && !e->unsafe && e->id >= 0 && e->id <= U32_MAX &&
+	       e->score >= 0 && e->encoding == DCP_COLOR_FORMAT_RGB;
+}
+
+/* A 10 bpc SDR element without DSC. */
+static inline bool dcp_m4_ext_colour_sdr10(const struct dcp_color_element *e)
+{
+	return dcp_m4_ext_colour_usable(e) && e->eotf == DCP_EOTF_SDR_GAMMA &&
+	       e->depth == DCP_M4_EXT_DEEP_BPC && !e->dsc_required;
+}
+
+/* A 10 bpc ST 2084 element in BT.2020 RGB colorimetry without DSC. */
+static inline bool dcp_m4_ext_colour_pq(const struct dcp_color_element *e)
+{
+	return dcp_m4_ext_colour_usable(e) && e->eotf == DCP_EOTF_ST_2084 &&
+	       e->colorimetry == DCP_COLORIMETRY_BT2020_RGB &&
+	       e->depth == DCP_M4_EXT_DEEP_BPC && !e->dsc_required;
+}
+
+/* At one depth: full range first, then sRGB/BT.709 colorimetry (SDR), then the score. */
+static inline unsigned int dcp_m4_ext_colour_rank(const struct dcp_color_element *e)
+{
+	return (e->range == DCP_COLOR_YCBCR_RANGE_FULL ? 2 : 0) +
+	       (e->colorimetry == DCP_COLORIMETRY_SRGB ||
+		e->colorimetry == DCP_COLORIMETRY_BT709 ? 1 : 0);
+}
+
+static inline bool dcp_m4_ext_colour_better(const struct dcp_color_element *e,
+					    const struct dcp_color_element *best)
+{
+	unsigned int a = dcp_m4_ext_colour_rank(e), b = dcp_m4_ext_colour_rank(best);
+
+	return a > b || (a == b && e->score > best->score);
+}
+
+/* Take @e into @c where it is a better deep or HDR element. */
+static inline void dcp_m4_ext_colour_take(struct dcp_m4_ext_colours *c,
+					  const struct dcp_color_element *e)
+{
+	if (dcp_m4_ext_colour_sdr10(e) &&
+	    (!c->has_sdr10 || dcp_m4_ext_colour_better(e, &c->sdr10))) {
+		c->sdr10 = *e;
+		c->has_sdr10 = true;
+	}
+	if (dcp_m4_ext_colour_pq(e) && (!c->has_pq || dcp_m4_ext_colour_better(e, &c->pq))) {
+		c->pq = *e;
+		c->has_pq = true;
+	}
+}
+
+/* Whether a timing of @clock kHz fits a link of @capacity (0: unknown) at @bpp. */
+static inline bool dcp_m4_ext_fits_bpp(u32 clock, u32 bpp, u64 capacity)
+{
+	return !capacity || (u64)clock * bpp <= capacity;
+}
+
+/*
+ * The element a commit asking @w runs on a timing of @clock kHz whose 8 bpc
+ * element is @color8 (@dsc: it needs DSC) with the deep and HDR ones of @c,
+ * on a link of @capacity.  -EINVAL: PQ asked, and the timing has no PQ element
+ * that fits.
+ */
+static inline int dcp_m4_ext_colour_choose(const struct dcp_m4_ext_want *w, u32 color8, bool dsc,
+					   const struct dcp_m4_ext_colours *c, u32 clock,
+					   u64 capacity, struct dcp_m4_ext_choice *out)
+{
+	bool fits10 = dcp_m4_ext_fits_bpp(clock, 3 * DCP_M4_EXT_DEEP_BPC, capacity);
+
+	if (w->pq) {
+		if (!c->has_pq || !fits10 || w->max_bpc < DCP_M4_EXT_DEEP_BPC)
+			return -EINVAL;
+		*out = (struct dcp_m4_ext_choice){ .color = (u32)c->pq.id,
+						   .depth = DCP_M4_EXT_DEEP_BPC, .pq = true };
+		return 0;
+	}
+	if (c->has_sdr10 && fits10 && !dsc && w->max_bpc >= DCP_M4_EXT_DEEP_BPC) {
+		*out = (struct dcp_m4_ext_choice){ .color = (u32)c->sdr10.id,
+						   .depth = DCP_M4_EXT_DEEP_BPC };
+		return 0;
+	}
+	*out = (struct dcp_m4_ext_choice){ .color = color8, .depth = 8 };
+	return 0;
+}
+
+/* Whether @color is one of the elements this timing's choices may run. */
+static inline bool dcp_m4_ext_colour_known(u32 color, u32 color8,
+					   const struct dcp_m4_ext_colours *c)
+{
+	return color == color8 || (c->has_sdr10 && color == (u32)c->sdr10.id) ||
+	       (c->has_pq && color == (u32)c->pq.id);
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-ext-idle-test.c b/drivers/gpu/drm/apple/dcp-m4-ext-idle-test.c
new file mode 100644
index 0000000000..f28d164e00
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-ext-idle-test.c
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/*
+ * A T8132 dcpext with nothing attached (dcp-m4-ext-idle.h): when it may be
+ * powered down, and what keeps it up.
+ */
+
+#include <kunit/test.h>
+#include <linux/stddef.h>
+
+#include "dcp-m4-ext-idle.h"
+
+/* A started session on a board with the power-down, nothing attached. */
+static struct dcp_m4_ext_idle_in idle(void)
+{
+	return (struct dcp_m4_ext_idle_in) {
+		.enabled = true,
+		.capable = true,
+		.session = true,
+		.services = true,
+	};
+}
+
+struct idle_flag {
+	size_t offset;
+	bool value;
+	enum dcp_m4_ext_idle_verdict verdict;
+	const char *reason;
+};
+
+#define FLAG(f, v, verdict, reason) \
+	{ offsetof(struct dcp_m4_ext_idle_in, f), v, DCP_M4_EXT_IDLE_##verdict, reason }
+
+/* Each input on its own, from the idle state. */
+static const struct idle_flag flags[] = {
+	FLAG(enabled, false, NEVER, "dcpext_idle_ms is 0"),
+	FLAG(capable, false, NEVER, "no power-down on this board"),
+	FLAG(failed, true, NEVER, "session failed"),
+	FLAG(gated, true, DOWN, "down"),
+	FLAG(stopping, true, RECHECK, "stopping"),
+	FLAG(session, false, RECHECK, "session starting"),
+	FLAG(services, false, RECHECK, "DPTX service not published yet"),
+	FLAG(hdmi_starting, true, RECHECK, "HDMI output starting"),
+	FLAG(reconnect, true, RECHECK, "Type-C reconnect queued"),
+	FLAG(orphans, true, RECHECK, "teardown calls unanswered"),
+	FLAG(busy, true, RECHECK, "firmware call or swap in flight"),
+	FLAG(connected, true, ATTACHED, "DPTX port connected"),
+	FLAG(route, true, ATTACHED, "Type-C route active"),
+	FLAG(hpd, true, ATTACHED, "HDMI hot-plug high"),
+	FLAG(sink, true, ATTACHED, "sink reported"),
+	FLAG(powered, true, ATTACHED, "display powered"),
+	FLAG(dart_on, true, ATTACHED, "display DART on"),
+};
+
+static void set_flag(struct dcp_m4_ext_idle_in *in, const struct idle_flag *f)
+{
+	*(bool *)((u8 *)in + f->offset) = f->value;
+}
+
+static void ext_idle_nothing_attached(struct kunit *test)
+{
+	struct dcp_m4_ext_idle_in in = idle();
+
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_check(&in), DCP_M4_EXT_IDLE_GATE);
+	KUNIT_EXPECT_STREQ(test, dcp_m4_ext_idle_reason(&in), "nothing attached");
+}
+
+/* Every input decides on its own, and the reason names it. */
+static void ext_idle_each_input(struct kunit *test)
+{
+	for (unsigned int i = 0; i < ARRAY_SIZE(flags); i++) {
+		struct dcp_m4_ext_idle_in in = idle();
+
+		set_flag(&in, &flags[i]);
+		KUNIT_EXPECT_EQ_MSG(test, dcp_m4_ext_idle_check(&in), flags[i].verdict,
+				    "input %u (%s)", i, flags[i].reason);
+		KUNIT_EXPECT_STREQ_MSG(test, dcp_m4_ext_idle_reason(&in), flags[i].reason,
+				       "input %u", i);
+	}
+}
+
+/* An attached display keeps it up whatever else is going on, and is re-checked by its event. */
+static void ext_idle_attached_waits_for_event(struct kunit *test)
+{
+	struct dcp_m4_ext_idle_in in = idle();
+
+	in.hpd = true;
+	in.sink = true;
+	in.connected = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_check(&in), DCP_M4_EXT_IDLE_ATTACHED);
+	/* Something passing is re-checked by time: it may also clear without an event. */
+	in.busy = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_check(&in), DCP_M4_EXT_IDLE_RECHECK);
+	/* Unplugged with the call done: power-down. */
+	in = idle();
+	in.hpd = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_check(&in), DCP_M4_EXT_IDLE_ATTACHED);
+	in.hpd = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_check(&in), DCP_M4_EXT_IDLE_GATE);
+}
+
+/* Down is down: it is never powered down twice, and a failed session is left alone. */
+static void ext_idle_down_and_failed(struct kunit *test)
+{
+	struct dcp_m4_ext_idle_in in = idle();
+
+	in.gated = true;
+	in.hpd = true;
+	in.busy = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_check(&in), DCP_M4_EXT_IDLE_DOWN);
+	in.failed = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_check(&in), DCP_M4_EXT_IDLE_NEVER);
+	KUNIT_EXPECT_STREQ(test, dcp_m4_ext_idle_reason(&in), "session failed");
+	in = idle();
+	in.enabled = false;
+	in.gated = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_check(&in), DCP_M4_EXT_IDLE_NEVER);
+}
+
+/* Every verdict but GATE leaves the DCP as it is: no input set reaches GATE. */
+static void ext_idle_gate_only_when_idle(struct kunit *test)
+{
+	for (unsigned int i = 0; i < ARRAY_SIZE(flags); i++) {
+		for (unsigned int j = 0; j < ARRAY_SIZE(flags); j++) {
+			struct dcp_m4_ext_idle_in in = idle();
+
+			set_flag(&in, &flags[i]);
+			set_flag(&in, &flags[j]);
+			KUNIT_EXPECT_NE_MSG(test, dcp_m4_ext_idle_check(&in), DCP_M4_EXT_IDLE_GATE,
+					    "inputs %u and %u", i, j);
+		}
+	}
+}
+
+static void ext_idle_delay(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_delay_ms(0), 0U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_delay_ms(1), DCP_M4_EXT_IDLE_MS_MIN);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_delay_ms(999), DCP_M4_EXT_IDLE_MS_MIN);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_delay_ms(DCP_M4_EXT_IDLE_MS_DEFAULT),
+			DCP_M4_EXT_IDLE_MS_DEFAULT);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_delay_ms(600001), DCP_M4_EXT_IDLE_MS_MAX);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_idle_delay_ms(~0U), DCP_M4_EXT_IDLE_MS_MAX);
+}
+
+static struct kunit_case m4_ext_idle_cases[] = {
+	KUNIT_CASE(ext_idle_nothing_attached),
+	KUNIT_CASE(ext_idle_each_input),
+	KUNIT_CASE(ext_idle_attached_waits_for_event),
+	KUNIT_CASE(ext_idle_down_and_failed),
+	KUNIT_CASE(ext_idle_gate_only_when_idle),
+	KUNIT_CASE(ext_idle_delay),
+	{}
+};
+
+static struct kunit_suite m4_ext_idle_suite = {
+	.name = "apple-dcp-m4-ext-idle",
+	.test_cases = m4_ext_idle_cases,
+};
+
+kunit_test_suite(m4_ext_idle_suite);
diff --git a/drivers/gpu/drm/apple/dcp-m4-ext-idle.h b/drivers/gpu/drm/apple/dcp-m4-ext-idle.h
new file mode 100644
index 0000000000..acd61e3c46
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-ext-idle.h
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * A T8132 external display coprocessor (dcpext) with nothing attached.
+ *
+ * Its session starts at probe whether or not a display is attached, and
+ * until now its CPU kept running and its firmware DART and dispext CPU,
+ * frontend and system domains stayed powered for as long as the machine was
+ * up. Nothing needs them then: a display only appears through the AP, by
+ * the HDMI port's hot-plug GPIO or a Type-C route (DP alt mode or a DP
+ * tunnel), and every one of those asks the firmware to connect (DPTX), which
+ * can power it up first. So once nothing is attached for dcpext_idle_ms the
+ * DCP takes the power-down it takes for a SoC power-down sleep
+ * (iomfb_m4_ext_power_gate()), and the next request to its firmware powers
+ * it up again (iomfb_m4_ext_power_ungate()).
+ *
+ * Which of those it may do now: decisions only, no hardware, for the KUnit
+ * suite (dcp-m4-ext-idle-test.c).
+ */
+#ifndef APPLE_DCP_M4_EXT_IDLE_H
+#define APPLE_DCP_M4_EXT_IDLE_H
+
+#include <linux/minmax.h>
+#include <linux/types.h>
+
+/* appledrm.dcpext_idle_ms: 0 never powers a dcpext down while idle. */
+#define DCP_M4_EXT_IDLE_MS_DEFAULT	5000U
+#define DCP_M4_EXT_IDLE_MS_MIN		1000U
+#define DCP_M4_EXT_IDLE_MS_MAX		600000U
+
+struct dcp_m4_ext_idle_in {
+	/* Of the DCP driver (dcp.c), under its hpd_mutex. */
+	bool enabled;		/* dcpext_idle_ms is not 0 */
+	bool stopping;		/* system sleep, remove or shutdown under way */
+	bool services;		/* the DPTX service of port 0 is published */
+	bool connected;		/* a DPTX port is connected */
+	bool route;		/* a Type-C route drives this DCP */
+	bool hpd;		/* the HDMI port's hot-plug level is high */
+	bool hdmi_starting;	/* the HDMI output has not started yet */
+	bool reconnect;		/* a Type-C reconnect is queued */
+	bool orphans;		/* teardown calls the firmware has not answered */
+	/* Of the session (iomfb_m4.c), under its lock. */
+	bool capable;		/* the board describes its power-down */
+	bool session;		/* the session finished starting */
+	bool failed;		/* the session failed */
+	bool gated;		/* the DCP and its domains are down */
+	bool sink;		/* the firmware reports a sink (D575) */
+	bool powered;		/* its display is powered on */
+	bool dart_on;		/* its display DART is on (last D572 was 1) */
+	bool busy;		/* a swap or a firmware call is under way */
+};
+
+enum dcp_m4_ext_idle_verdict {
+	/* Power it down now. */
+	DCP_M4_EXT_IDLE_GATE,
+	/* Down already. */
+	DCP_M4_EXT_IDLE_DOWN,
+	/* Not now, for a while: look again after dcpext_idle_ms. */
+	DCP_M4_EXT_IDLE_RECHECK,
+	/* Something is attached: the event that removes it looks again. */
+	DCP_M4_EXT_IDLE_ATTACHED,
+	/* Never on this DCP (until the knob is set again). */
+	DCP_M4_EXT_IDLE_NEVER,
+};
+
+/*
+ * The reason, for the log and debugfs. One input decides, checked in this
+ * order: what rules it out for good, then down already, then what passes
+ * by itself (start-up, a sleep, calls in flight), then what is attached.
+ */
+static inline const char *
+dcp_m4_ext_idle_reason(const struct dcp_m4_ext_idle_in *in)
+{
+	if (!in->enabled)
+		return "dcpext_idle_ms is 0";
+	if (!in->capable)
+		return "no power-down on this board";
+	if (in->failed)
+		return "session failed";
+	if (in->gated)
+		return "down";
+	if (in->stopping)
+		return "stopping";
+	if (!in->session)
+		return "session starting";
+	if (!in->services)
+		return "DPTX service not published yet";
+	if (in->hdmi_starting)
+		return "HDMI output starting";
+	if (in->reconnect)
+		return "Type-C reconnect queued";
+	if (in->orphans)
+		return "teardown calls unanswered";
+	if (in->busy)
+		return "firmware call or swap in flight";
+	if (in->connected)
+		return "DPTX port connected";
+	if (in->route)
+		return "Type-C route active";
+	if (in->hpd)
+		return "HDMI hot-plug high";
+	if (in->sink)
+		return "sink reported";
+	if (in->powered)
+		return "display powered";
+	if (in->dart_on)
+		return "display DART on";
+	return "nothing attached";
+}
+
+static inline enum dcp_m4_ext_idle_verdict
+dcp_m4_ext_idle_check(const struct dcp_m4_ext_idle_in *in)
+{
+	if (!in->enabled || !in->capable || in->failed)
+		return DCP_M4_EXT_IDLE_NEVER;
+	if (in->gated)
+		return DCP_M4_EXT_IDLE_DOWN;
+	if (in->stopping || !in->session || !in->services || in->hdmi_starting ||
+	    in->reconnect || in->orphans || in->busy)
+		return DCP_M4_EXT_IDLE_RECHECK;
+	if (in->connected || in->route || in->hpd || in->sink || in->powered ||
+	    in->dart_on)
+		return DCP_M4_EXT_IDLE_ATTACHED;
+	return DCP_M4_EXT_IDLE_GATE;
+}
+
+/* The knob as a delay: 0 stays 0 (off), others are kept in range. */
+static inline unsigned int dcp_m4_ext_idle_delay_ms(unsigned int ms)
+{
+	if (!ms)
+		return 0;
+	return clamp(ms, DCP_M4_EXT_IDLE_MS_MIN, DCP_M4_EXT_IDLE_MS_MAX);
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-ext-sink-test.c b/drivers/gpu/drm/apple/dcp-m4-ext-sink-test.c
new file mode 100644
index 0000000000..d06af45aa7
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-ext-sink-test.c
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/*
+ * The sink of a T8132 external output (dcp-m4-ext-sink.h): which EDID its
+ * connector publishes, whether the sink is wide gamut, and which primaries
+ * its frames carry.
+ */
+
+#include <kunit/test.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_modes.h>
+
+#include "dcp-m4-ext-sink.h"
+
+#define XY3(rx, ry, gx, gy, bx, by) {						\
+	{ DCP_M4_XY(rx), DCP_M4_XY(ry) }, { DCP_M4_XY(gx), DCP_M4_XY(gy) },	\
+	{ DCP_M4_XY(bx), DCP_M4_XY(by) } }
+
+static const u32 srgb[3][2] = XY3(6400, 3300, 3000, 6000, 1500, 600);
+static const u32 p3[3][2] = XY3(6800, 3200, 2650, 6900, 1500, 600);
+static const u32 bt2020[3][2] = XY3(7080, 2920, 1700, 7970, 1310, 460);
+static const u32 adobe[3][2] = XY3(6400, 3300, 2100, 7100, 1500, 600);
+/* A typical office monitor, a little beyond sRGB */
+static const u32 office[3][2] = XY3(6500, 3300, 3100, 6200, 1500, 500);
+/* Display P3 listed blue, green, red: the other winding */
+static const u32 p3_reversed[3][2] = XY3(1500, 600, 2650, 6900, 6800, 3200);
+static const u32 none[3][2] = {};
+static const u32 line[3][2] = XY3(1000, 1000, 2000, 2000, 3000, 3000);
+
+static void ext_sink_edid_pick(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_edid_pick(true, true, 4, 4), DCP_M4_EXT_EDID_SINK);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_edid_pick(true, false, 4, 4), DCP_M4_EXT_EDID_SINK);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_edid_pick(false, true, 4, 4), DCP_M4_EXT_EDID_BUILT);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_edid_pick(false, false, 4, 4), DCP_M4_EXT_EDID_NONE);
+	/* DisplayAttributes of an earlier sink describe nothing now */
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_edid_pick(true, true, 3, 4), DCP_M4_EXT_EDID_NONE);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_edid_pick(false, true, 3, 4), DCP_M4_EXT_EDID_NONE);
+}
+
+static void ext_sink_wide_by_area(struct kunit *test)
+{
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(srgb, false));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(office, false));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(p3, false));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(p3_reversed, false));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(bt2020, false));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(adobe, false));
+}
+
+/* Chromaticity decides where it is usable; BT.2020 RGB only without it. */
+static void ext_sink_wide_without_chromaticity(struct kunit *test)
+{
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xy_usable(none));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xy_usable(line));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xy_usable(srgb));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(none, true));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(none, false));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(line, true));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(line, false));
+	/* An sRGB panel that takes BT.2020 RGB signalling stays an sRGB sink */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(srgb, true));
+}
+
+static void ext_sink_edid_chromaticity(struct kunit *test)
+{
+	u8 b[EDID_LENGTH] = {};
+	u32 c[3][2];
+
+	/* 10-bit red 655,338 green 307,614 blue 154,61 */
+	b[25] = 3 << 6 | 2 << 4 | 3 << 2 | 2;
+	b[26] = 2 << 6 | 1 << 4;
+	b[27] = 655 >> 2;
+	b[28] = 338 >> 2;
+	b[29] = 307 >> 2;
+	b[30] = 614 >> 2;
+	b[31] = 154 >> 2;
+	b[32] = 61 >> 2;
+	dcp_m4_edid_chromaticity(b, c);
+	KUNIT_EXPECT_EQ(test, c[0][0], 655U * 64);
+	KUNIT_EXPECT_EQ(test, c[0][1], 338U * 64);
+	KUNIT_EXPECT_EQ(test, c[1][0], 307U * 64);
+	KUNIT_EXPECT_EQ(test, c[1][1], 614U * 64);
+	KUNIT_EXPECT_EQ(test, c[2][0], 154U * 64);
+	KUNIT_EXPECT_EQ(test, c[2][1], 61U * 64);
+	/* ... which is an sRGB-sized panel */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(c, false));
+}
+
+static void ext_sink_primaries(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, DCP_M4_PRIMARIES_BT709, 1);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_primaries(true, false, false), DCP_M4_PRIMARIES_BT2020);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_primaries(true, true, true), DCP_M4_PRIMARIES_BT2020);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_primaries(false, true, false), DCP_M4_PRIMARIES_BT2020);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_primaries(false, true, true), DCP_M4_PRIMARIES_BT2020);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_primaries(false, false, true), DCP_M4_PRIMARIES_P3_D65);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_primaries(false, false, false), DCP_M4_PRIMARIES_BT709);
+	KUNIT_EXPECT_STREQ(test, dcp_m4_primaries_name(DCP_M4_PRIMARIES_BT709), "BT.709 (sRGB)");
+	KUNIT_EXPECT_STREQ(test, dcp_m4_primaries_name(DCP_M4_PRIMARIES_P3_D65), "Display P3");
+	KUNIT_EXPECT_STREQ(test, dcp_m4_primaries_name(DCP_M4_PRIMARIES_BT2020), "BT.2020");
+}
+
+/* DisplayAttributes of an HDR10 television, and 1080p60 for its timing. */
+static void hdr_tv(struct dcp_display_metadata *m, struct drm_display_mode *mode)
+{
+	*m = (struct dcp_display_metadata){
+		.width_cm = 121, .height_cm = 68, .gamma = 144179,
+		.product = 0x7101, .serial = 1, .week = 10, .year = 2024,
+		.manufacturer = "SAM", .name = "TEST TV",
+		.pq = true, .static_metadata_type1 = true, .bt2020_rgb = true,
+		.max_luminance = 800U << 16, .max_fall = 400U << 16, .min_luminance = 1U << 12,
+	};
+	memcpy(m->chromaticity, p3, sizeof(p3));
+	m->white[0] = DCP_M4_XY(3127);
+	m->white[1] = DCP_M4_XY(3290);
+	*mode = (struct drm_display_mode){
+		.clock = 148500, .hdisplay = 1920, .hsync_start = 2008, .hsync_end = 2052,
+		.htotal = 2200, .vdisplay = 1080, .vsync_start = 1084, .vsync_end = 1089,
+		.vtotal = 1125, .flags = DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC,
+	};
+}
+
+/* The data block of extended @tag in CTA extension @cta, NULL if none. */
+static const u8 *cta_block(const u8 *cta, u8 tag)
+{
+	for (unsigned int i = 4; i < cta[2] && i < EDID_LENGTH; i += 1 + (cta[i] & 31))
+		if (cta[i] >> 5 == 7 && (cta[i] & 31) >= 1 && cta[i + 1] == tag)
+			return cta + i;
+	return NULL;
+}
+
+/* What a compositor reads for HDR is in the EDID built for a PQ sink. */
+static void ext_sink_built_edid_hdr(struct kunit *test)
+{
+	struct dcp_display_metadata m;
+	struct drm_display_mode mode;
+	const struct drm_edid *edid;
+	const u8 *raw, *db;
+	u32 c[3][2];
+
+	hdr_tv(&m, &mode);
+	edid = dcp_metadata_edid(&m, &mode);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(edid));
+	KUNIT_EXPECT_TRUE(test, drm_edid_valid(edid));
+	raw = (const u8 *)drm_edid_raw(edid);
+	KUNIT_ASSERT_NOT_NULL(test, raw);
+	KUNIT_ASSERT_EQ(test, raw[126], 1);
+	KUNIT_EXPECT_EQ(test, raw[EDID_LENGTH], 0x02);
+	db = cta_block(raw + EDID_LENGTH, 0x06);
+	KUNIT_ASSERT_NOT_NULL(test, db);
+	KUNIT_EXPECT_EQ(test, db[2] & 0x05, 0x05);	/* SDR and ST 2084 */
+	KUNIT_EXPECT_EQ(test, db[3] & 1, 1);		/* static metadata type 1 */
+	db = cta_block(raw + EDID_LENGTH, 0x05);
+	KUNIT_ASSERT_NOT_NULL(test, db);
+	KUNIT_EXPECT_EQ(test, db[2] & 0x80, 0x80);	/* BT.2020 RGB */
+	/* ... and the sink's primaries, read back as wide gamut */
+	dcp_m4_edid_chromaticity(raw, c);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(c, false));
+	drm_edid_free(edid);
+
+	/* A sink without PQ: the base block alone, still with its primaries */
+	m.pq = false;
+	memcpy(m.chromaticity, srgb, sizeof(srgb));
+	edid = dcp_metadata_edid(&m, &mode);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(edid));
+	raw = (const u8 *)drm_edid_raw(edid);
+	KUNIT_ASSERT_NOT_NULL(test, raw);
+	KUNIT_EXPECT_EQ(test, raw[126], 0);
+	dcp_m4_edid_chromaticity(raw, c);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(c, false));
+	drm_edid_free(edid);
+}
+
+static struct kunit_case m4_ext_sink_cases[] = {
+	KUNIT_CASE(ext_sink_edid_pick),
+	KUNIT_CASE(ext_sink_wide_by_area),
+	KUNIT_CASE(ext_sink_wide_without_chromaticity),
+	KUNIT_CASE(ext_sink_edid_chromaticity),
+	KUNIT_CASE(ext_sink_primaries),
+	KUNIT_CASE(ext_sink_built_edid_hdr),
+	{}
+};
+
+static struct kunit_suite m4_ext_sink_suite = {
+	.name = "apple-dcp-m4-ext-sink",
+	.test_cases = m4_ext_sink_cases,
+};
+
+kunit_test_suite(m4_ext_sink_suite);
diff --git a/drivers/gpu/drm/apple/dcp-m4-ext-sink.h b/drivers/gpu/drm/apple/dcp-m4-ext-sink.h
new file mode 100644
index 0000000000..5f543e6178
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-ext-sink.h
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * What a T8132 external output (firmware 26.6.2) tells user space and its
+ * frames about the sink: the EDID its DRM connector publishes, and the
+ * primaries its SDR frames are tagged with.
+ *
+ * Like the desktop 26.x external processors (dcp.c), the dcpext hands out
+ * no EDID blob; it sends the sink's DisplayAttributes as a property, as it
+ * sends TimingElements.  The sink's own EDID, where DisplayAttributes carry
+ * one, is published as it is; else an EDID is built from their identity
+ * and colour (dcp_metadata_edid(): with PQ, a CTA-861 extension with the
+ * colorimetry and HDR static metadata data blocks a compositor reads);
+ * else none.
+ *
+ * A frame's primaries are an H.273 ColourPrimaries code point (surface
+ * +0x14, dcp-m4-edr.h): BT.2020 for PQ and for a BT2020_RGB Colorspace;
+ * Display P3 for a wide gamut sink; BT.709 (sRGB) for any other sink and
+ * when nothing is known about it.  Wide gamut: the sink's primaries span a
+ * CIE 1931 xy triangle at least as large as the mean of the sRGB and the
+ * Display P3 triangles; without usable chromaticity, a sink that takes
+ * BT.2020 RGB.
+ *
+ * Pure functions, for the KUnit suite.
+ */
+#ifndef APPLE_DCP_M4_EXT_SINK_H
+#define APPLE_DCP_M4_EXT_SINK_H
+
+#include <linux/math.h>
+#include <linux/types.h>
+
+#include "dcp-display-metadata.h"
+#include "dcp-m4-edr.h"
+
+/* The EDID an external connector publishes. */
+enum dcp_m4_ext_edid {
+	DCP_M4_EXT_EDID_NONE,
+	DCP_M4_EXT_EDID_SINK,	/* the sink's own, found in its DisplayAttributes */
+	DCP_M4_EXT_EDID_BUILT,	/* built from its DisplayAttributes */
+};
+
+/*
+ * For the sink of generation @gen, from its DisplayAttributes received in
+ * generation @attr_gen: the sink's own EDID if they carried one
+ * (@sink_edid), else one built from their identity and colour (@metadata).
+ */
+static inline enum dcp_m4_ext_edid dcp_m4_ext_edid_pick(bool sink_edid, bool metadata,
+							int attr_gen, int gen)
+{
+	if (attr_gen != gen)
+		return DCP_M4_EXT_EDID_NONE;
+	if (sink_edid)
+		return DCP_M4_EXT_EDID_SINK;
+	return metadata ? DCP_M4_EXT_EDID_BUILT : DCP_M4_EXT_EDID_NONE;
+}
+
+/* CIE 1931 x or y given in units of 1/10000, in the metadata's 1/65536. */
+#define DCP_M4_XY(v)	((u32)(((v) * 65536U + 5000U) / 10000U))
+
+/* Twice the signed area of a triangle of xy points in 1/65536 units. */
+static inline s64 dcp_m4_xy_area2(const u32 c[3][2])
+{
+	return ((s64)c[1][0] - c[0][0]) * ((s64)c[2][1] - c[0][1]) -
+	       ((s64)c[1][1] - c[0][1]) * ((s64)c[2][0] - c[0][0]);
+}
+
+/* Primaries every coordinate of which lies in (0, 1), not on one line. */
+static inline bool dcp_m4_xy_usable(const u32 c[3][2])
+{
+	for (unsigned int i = 0; i < 3; i++)
+		for (unsigned int j = 0; j < 2; j++)
+			if (!c[i][j] || c[i][j] >= 65536)
+				return false;
+	return dcp_m4_xy_area2(c) != 0;
+}
+
+/* Whether a sink with primaries @c (1/65536) is a wide gamut one. */
+static inline bool dcp_m4_ext_sink_wide(const u32 c[3][2], bool bt2020_rgb)
+{
+	static const u32 srgb[3][2] = {
+		{ DCP_M4_XY(6400), DCP_M4_XY(3300) },
+		{ DCP_M4_XY(3000), DCP_M4_XY(6000) },
+		{ DCP_M4_XY(1500), DCP_M4_XY(600) },
+	};
+	static const u32 p3[3][2] = {
+		{ DCP_M4_XY(6800), DCP_M4_XY(3200) },
+		{ DCP_M4_XY(2650), DCP_M4_XY(6900) },
+		{ DCP_M4_XY(1500), DCP_M4_XY(600) },
+	};
+
+	if (!dcp_m4_xy_usable(c))
+		return bt2020_rgb;
+	return 2 * abs(dcp_m4_xy_area2(c)) >=
+	       abs(dcp_m4_xy_area2(srgb)) + abs(dcp_m4_xy_area2(p3));
+}
+
+/*
+ * The red, green and blue chromaticity of an EDID base block @b (bytes
+ * 25-32, ten bits each) in 1/65536 units.
+ */
+static inline void dcp_m4_edid_chromaticity(const u8 *b, u32 c[3][2])
+{
+	c[0][0] = (b[27] << 2 | (b[25] >> 6 & 3)) * 64;
+	c[0][1] = (b[28] << 2 | (b[25] >> 4 & 3)) * 64;
+	c[1][0] = (b[29] << 2 | (b[25] >> 2 & 3)) * 64;
+	c[1][1] = (b[30] << 2 | (b[25] & 3)) * 64;
+	c[2][0] = (b[31] << 2 | (b[26] >> 6 & 3)) * 64;
+	c[2][1] = (b[32] << 2 | (b[26] >> 4 & 3)) * 64;
+}
+
+/*
+ * The primaries of the frames on a link: BT.2020 for PQ or a BT2020_RGB
+ * Colorspace (@bt2020), else per the sink (@wide).
+ */
+static inline u8 dcp_m4_ext_primaries(bool pq, bool bt2020, bool wide)
+{
+	if (pq || bt2020)
+		return DCP_M4_PRIMARIES_BT2020;
+	return wide ? DCP_M4_PRIMARIES_P3_D65 : DCP_M4_PRIMARIES_BT709;
+}
+
+static inline const char *dcp_m4_primaries_name(u8 primaries)
+{
+	switch (primaries) {
+	case DCP_M4_PRIMARIES_BT2020:
+		return "BT.2020";
+	case DCP_M4_PRIMARIES_P3_D65:
+		return "Display P3";
+	case DCP_M4_PRIMARIES_BT709:
+		return "BT.709 (sRGB)";
+	default:
+		return "unknown";
+	}
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-frame-test.c b/drivers/gpu/drm/apple/dcp-m4-frame-test.c
new file mode 100644
index 0000000000..a038520ad8
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-frame-test.c
@@ -0,0 +1,291 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/*
+ * Primary surface formats of the T8132 panel (dcp-m4-frame.h): which DRM
+ * formats the single-surface path takes, and that the surface it encodes
+ * differs between 8 and 10 bits a component only in the firmware OSType
+ * ('BGRA' or 'l10r') at +0x0b, with the 8888 surface byte for byte as before.
+ */
+
+#include <kunit/test.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+#include <drm/drm_fourcc.h>
+
+#include "dcp-m4-frame.h"
+
+static void frame_drm_formats(struct kunit *test)
+{
+	static const struct { u32 drm; int ret; enum dcp_m4_frame_format m4; } t[] = {
+		{ DRM_FORMAT_XRGB8888, 0, DCP_M4_XRGB8888 },
+		{ DRM_FORMAT_ARGB8888, 0, DCP_M4_ARGB8888 },
+		{ DRM_FORMAT_XRGB2101010, 0, DCP_M4_XRGB2101010 },
+		{ DRM_FORMAT_ARGB2101010, 0, DCP_M4_ARGB2101010 },
+		/* No firmware format with this component order or depth. */
+		{ DRM_FORMAT_XBGR2101010, -EINVAL },
+		{ DRM_FORMAT_ABGR2101010, -EINVAL },
+		{ DRM_FORMAT_BGRX1010102, -EINVAL },
+		{ DRM_FORMAT_ABGR16161616F, -EINVAL },
+		{ DRM_FORMAT_XBGR8888, -EINVAL },
+		{ DRM_FORMAT_RGB565, -EINVAL },
+	};
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(t); i++) {
+		enum dcp_m4_frame_format f = DCP_M4_XRGB8888;
+
+		KUNIT_EXPECT_EQ(test, dcp_m4_drm_format(t[i].drm, &f), t[i].ret);
+		if (!t[i].ret)
+			KUNIT_EXPECT_EQ(test, f, t[i].m4);
+	}
+}
+
+static void frame_format_helpers(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_fourcc(DCP_M4_XRGB8888), 0x42475241U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_fourcc(DCP_M4_ARGB8888), 0x42475241U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_fourcc(DCP_M4_XRGB2101010), 0x6c313072U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_fourcc(DCP_M4_ARGB2101010), 0x6c313072U);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_format_opaque(DCP_M4_XRGB8888));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_format_opaque(DCP_M4_ARGB8888));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_format_opaque(DCP_M4_XRGB2101010));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_format_opaque(DCP_M4_ARGB2101010));
+	/* The idle cache keeps the frame's depth. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_opaque_of(DCP_M4_ARGB8888), DCP_M4_XRGB8888);
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_opaque_of(DCP_M4_XRGB8888), DCP_M4_XRGB8888);
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_opaque_of(DCP_M4_ARGB2101010), DCP_M4_XRGB2101010);
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_opaque_of(DCP_M4_XRGB2101010), DCP_M4_XRGB2101010);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_format_valid(DCP_M4_ARGB2101010));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_format_valid((enum dcp_m4_frame_format)4));
+}
+
+/* The 8888 surface as the encoder wrote it before 10-bit formats existed. */
+static void frame_surface_8888_reference(u8 *s, const struct dcp_m4_frame *f)
+{
+	u32 size = f->stride * f->height;
+
+	memset(s, 0, DCP_M4_SURFACE_SIZE);
+	s[2] = f->format == DCP_M4_XRGB8888;
+	put_unaligned_le32(1, s + 3);
+	put_unaligned_le32(1, s + 7);
+	put_unaligned_le32(0x42475241, s + 0x0b);
+	s[DCP_M4_SURFACE_XFER] = DCP_M4_XFER_SRGB;
+	s[DCP_M4_SURFACE_PRIMARIES] = DCP_M4_PRIMARIES_P3_D65;
+	put_unaligned_le32(f->stride, s + 0x15);
+	put_unaligned_le16(1, s + 0x19);
+	s[0x1b] = 1;
+	s[0x1c] = 1;
+	put_unaligned_le32(f->width, s + 0x21);
+	put_unaligned_le32(f->height, s + 0x25);
+	put_unaligned_le32(size, s + 0x29);
+	put_unaligned_le32(1, s + 0x35);
+	put_unaligned_le64(1, s + 0x51);
+	put_unaligned_le32(f->width, s + 0x59);
+	put_unaligned_le32(f->height, s + 0x5d);
+	put_unaligned_le32(f->stride, s + 0x69);
+	put_unaligned_le32(size, s + 0x6d);
+	put_unaligned_le16(4, s + 0x71);
+	s[0x73] = 1;
+	s[0x74] = 1;
+	put_unaligned_le64(1, s + 0x149);
+}
+
+static void frame_surface_encoding(struct kunit *test)
+{
+	static const enum dcp_m4_frame_format fmts[] = {
+		DCP_M4_XRGB8888, DCP_M4_ARGB8888, DCP_M4_XRGB2101010, DCP_M4_ARGB2101010,
+	};
+	u8 *s = kunit_kzalloc(test, DCP_M4_SURFACE_SIZE, GFP_KERNEL);
+	u8 *ref = kunit_kzalloc(test, DCP_M4_SURFACE_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_NOT_NULL(test, ref);
+	for (unsigned int i = 0; i < ARRAY_SIZE(fmts); i++) {
+		struct dcp_m4_frame f = {
+			.dva = 1ULL << 40, .backing_size = 3072ULL * 4 * 1964,
+			.width = 3024, .height = 1964, .stride = 3072 * 4, .format = fmts[i],
+		};
+		bool ten = dcp_m4_format_10bit(fmts[i]);
+
+		dcp_m4_surface_encode(s, &f);
+		/* The reference has the 8888 component of the same alpha rule. */
+		f.format = dcp_m4_format_opaque(fmts[i]) ? DCP_M4_XRGB8888 : DCP_M4_ARGB8888;
+		frame_surface_8888_reference(ref, &f);
+		if (ten)
+			put_unaligned_le32(0x6c313072, ref + 0x0b);
+		KUNIT_EXPECT_MEMEQ(test, s, ref, DCP_M4_SURFACE_SIZE);
+		/* 'l10r' in memory is 72 30 31 6c. */
+		if (ten) {
+			KUNIT_EXPECT_EQ(test, s[0x0b], 0x72);
+			KUNIT_EXPECT_EQ(test, s[0x0e], 0x6c);
+		}
+		/* 4 bytes a pixel and the SDR colour tags for every format. */
+		KUNIT_EXPECT_EQ(test, get_unaligned_le16(s + 0x71), 4);
+		KUNIT_EXPECT_EQ(test, s[DCP_M4_SURFACE_XFER], 13);
+		KUNIT_EXPECT_EQ(test, s[DCP_M4_SURFACE_PRIMARIES], 12);
+	}
+}
+
+/* The J604 panel's display defaults, each from the J604 itself (see the profile). */
+static void frame_j604_profile(struct kunit *test)
+{
+	const struct dcp_m4_profile *pf = &dcp_m4_profile_j604;
+
+	/* macOS: 24-120 Hz refresh intervals. */
+	KUNIT_EXPECT_EQ(test, pf->vrr_min_hz, 24);
+	/* macOS: colour element Depth 8. */
+	KUNIT_EXPECT_EQ(test, pf->panel_bpc, 8);
+	KUNIT_EXPECT_TRUE(test, pf->edr);
+	/* Fixed-rate panels on the same backend keep VRR off. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_profile_j713.vrr_min_hz, 0);
+	KUNIT_EXPECT_EQ(test, dcp_m4_profile_j715.vrr_min_hz, 0);
+}
+
+/* Colorspace and EOTF of the connector -> how the frame is tagged. */
+static void frame_output_colour(struct kunit *test)
+{
+	static const struct { bool pq, bt2020, on, edr, sdr2020; } t[] = {
+		{ false, false, true, false, false },	/* Default SDR: P3 */
+		{ false, true, true, false, true },	/* wide SDR: BT.2020 */
+		{ true, true, true, true, false },	/* HDR: EDR */
+		{ true, true, false, false, false },	/* HDR, panel_edr off */
+		{ true, false, true, false, false },	/* PQ metadata left, Default */
+		{ false, true, false, false, true },
+	};
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(t); i++) {
+		bool edr = !t[i].edr, sdr2020 = !t[i].sdr2020;
+
+		dcp_m4_output_colour(t[i].pq, t[i].bt2020, t[i].on, &edr, &sdr2020);
+		KUNIT_EXPECT_EQ(test, edr, t[i].edr);
+		KUNIT_EXPECT_EQ(test, sdr2020, t[i].sdr2020);
+	}
+}
+
+/* The surface tags: P3-D65/sRGB, BT.2020/sRGB (wide SDR), BT.2020/PQ (EDR). */
+static void frame_surface_colour_tags(struct kunit *test)
+{
+	static const struct { bool pq, bt2020; u8 prim, xfer; } t[] = {
+		{ false, false, 12, 13 }, { false, true, 9, 13 }, { true, false, 9, 16 },
+		{ true, true, 9, 16 },
+	};
+	u8 *s = kunit_kzalloc(test, DCP_M4_SURFACE_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	for (unsigned int i = 0; i < ARRAY_SIZE(t); i++) {
+		struct dcp_m4_frame f = {
+			.dva = 1ULL << 40, .backing_size = 3072ULL * 4 * 1964,
+			.width = 3024, .height = 1964, .stride = 3072 * 4,
+			.format = DCP_M4_XRGB2101010, .pq = t[i].pq, .bt2020 = t[i].bt2020,
+		};
+
+		dcp_m4_surface_encode(s, &f);
+		KUNIT_EXPECT_EQ(test, s[DCP_M4_SURFACE_PRIMARIES], t[i].prim);
+		KUNIT_EXPECT_EQ(test, s[DCP_M4_SURFACE_XFER], t[i].xfer);
+		KUNIT_EXPECT_EQ(test, get_unaligned_le32(s + 0x0b), 0x6c313072U);
+	}
+}
+
+/* BT.709 on an SDR frame only: PQ and BT.2020 SDR keep BT.2020. */
+static void frame_surface_bt709_tag(struct kunit *test)
+{
+	static const struct { bool pq, bt2020, bt709; u8 prim, xfer; } t[] = {
+		{ false, false, true, 1, 13 }, { false, true, true, 9, 13 },
+		{ true, false, true, 9, 16 }, { false, false, false, 12, 13 },
+	};
+	u8 *s = kunit_kzalloc(test, DCP_M4_SURFACE_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	for (unsigned int i = 0; i < ARRAY_SIZE(t); i++) {
+		struct dcp_m4_frame f = {
+			.dva = 1ULL << 40, .backing_size = 3840ULL * 4 * 2160,
+			.width = 3840, .height = 2160, .stride = 3840 * 4,
+			.format = DCP_M4_XRGB8888, .pq = t[i].pq, .bt2020 = t[i].bt2020,
+			.bt709 = t[i].bt709,
+		};
+
+		KUNIT_EXPECT_EQ(test, dcp_m4_frame_primaries(&f), t[i].prim);
+		dcp_m4_surface_encode(s, &f);
+		KUNIT_EXPECT_EQ(test, s[DCP_M4_SURFACE_PRIMARIES], t[i].prim);
+		KUNIT_EXPECT_EQ(test, s[DCP_M4_SURFACE_XFER], t[i].xfer);
+	}
+}
+
+/* External frames: 8 or 10 bits per component, presented opaque. */
+static void frame_ext_formats(struct kunit *test)
+{
+	static const struct { u32 fourcc; enum dcp_m4_frame_format format; } t[] = {
+		{ DRM_FORMAT_XRGB8888, DCP_M4_XRGB8888 },
+		{ DRM_FORMAT_ARGB8888, DCP_M4_XRGB8888 },
+		{ DRM_FORMAT_XRGB2101010, DCP_M4_XRGB2101010 },
+		{ DRM_FORMAT_ARGB2101010, DCP_M4_XRGB2101010 },
+	};
+	enum dcp_m4_frame_format format;
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(t); i++) {
+		KUNIT_EXPECT_EQ(test, dcp_m4_ext_format(t[i].fourcc, &format), 0);
+		KUNIT_EXPECT_EQ(test, format, t[i].format);
+	}
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_format(DRM_FORMAT_NV12, &format), -EINVAL);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_format(DRM_FORMAT_RGB565, &format), -EINVAL);
+}
+
+static void frame_ext_check_10bit(struct kunit *test)
+{
+	struct dcp_m4_frame f = {
+		.dva = 1ULL << 40, .backing_size = 3840ULL * 4 * 2160,
+		.width = 3840, .height = 2160, .stride = 3840 * 4,
+		.format = DCP_M4_XRGB2101010, .bt709 = true,
+	};
+	u8 *s = kunit_kzalloc(test, DCP_M4_SURFACE_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_EXPECT_EQ(test, dcp_m4_frame_check_ext(&f), 0);
+	dcp_m4_surface_encode(s, &f);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(s + 0x0b), 0x6c313072U);	/* 'l10r' */
+	KUNIT_EXPECT_EQ(test, s[2], 1);
+	KUNIT_EXPECT_EQ(test, s[DCP_M4_SURFACE_PRIMARIES], DCP_M4_PRIMARIES_BT709);
+	f.format = DCP_M4_XRGB8888;
+	KUNIT_EXPECT_EQ(test, dcp_m4_frame_check_ext(&f), 0);
+	f.format = DCP_M4_ARGB2101010;
+	KUNIT_EXPECT_EQ(test, dcp_m4_frame_check_ext(&f), 0);
+	f.format = (enum dcp_m4_frame_format)7;
+	KUNIT_EXPECT_EQ(test, dcp_m4_frame_check_ext(&f), -EINVAL);
+	/* Still 4 bytes a pixel: a pitch under that is refused */
+	f.format = DCP_M4_XRGB2101010;
+	f.stride = 3840 * 3 + 64 - (3840 * 3) % 64;
+	KUNIT_EXPECT_EQ(test, dcp_m4_frame_check_ext(&f), -EINVAL);
+}
+
+static void frame_ext_retag(struct kunit *test)
+{
+	struct dcp_m4_frame f = { .format = DCP_M4_XRGB8888 };
+
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_retag(&f, DCP_M4_XRGB8888));
+	KUNIT_EXPECT_EQ(test, f.format, DCP_M4_XRGB8888);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_retag(&f, DCP_M4_XRGB2101010));
+	KUNIT_EXPECT_EQ(test, f.format, DCP_M4_XRGB2101010);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_retag(&f, DCP_M4_XRGB2101010));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_retag(&f, DCP_M4_XRGB8888));
+	KUNIT_EXPECT_EQ(test, f.format, DCP_M4_XRGB8888);
+}
+
+static struct kunit_case m4_frame_cases[] = {
+	KUNIT_CASE(frame_drm_formats),
+	KUNIT_CASE(frame_format_helpers),
+	KUNIT_CASE(frame_surface_encoding),
+	KUNIT_CASE(frame_j604_profile),
+	KUNIT_CASE(frame_output_colour),
+	KUNIT_CASE(frame_surface_colour_tags),
+	KUNIT_CASE(frame_surface_bt709_tag),
+	KUNIT_CASE(frame_ext_formats),
+	KUNIT_CASE(frame_ext_check_10bit),
+	KUNIT_CASE(frame_ext_retag),
+	{}
+};
+
+static struct kunit_suite m4_frame_suite = {
+	.name = "apple-dcp-m4-frame",
+	.test_cases = m4_frame_cases,
+};
+
+kunit_test_suite(m4_frame_suite);
diff --git a/drivers/gpu/drm/apple/dcp-m4-frame.h b/drivers/gpu/drm/apple/dcp-m4-frame.h
index e51fe0a239..53fbc6193f 100644
--- a/drivers/gpu/drm/apple/dcp-m4-frame.h
+++ b/drivers/gpu/drm/apple/dcp-m4-frame.h
@@ -9,6 +9,8 @@
 #include <linux/types.h>
 #include <linux/unaligned.h>
 #include "dcp-m4-profile.h"
+#include "dcp-m4-edr.h"
+#include <drm/drm_fourcc.h>
 
 /* Qualified firmware-26.6.2 swap and physical panel dimensions. */
 #define DCP_M4_SWAP_SIZE		(dcp_m4_pf->swap_size)
@@ -20,8 +22,76 @@
 enum dcp_m4_frame_format {
 	DCP_M4_XRGB8888,
 	DCP_M4_ARGB8888,
+	DCP_M4_XRGB2101010,
+	DCP_M4_ARGB2101010,
 };
 
+/*
+ * Surface pixel formats, as the firmware's u32 OSType at surface +0x0b:
+ *  'BGRA' 0x42475241: DRM [A|X]RGB8888 (B, G, R, A bytes in memory).
+ *  'l10r' 0x6c313072: CoreVideo kCVPixelFormatType_ARGB2101010LEPacked,
+ *         "little-endian ARGB2101010 full-range": DRM [A|X]RGB2101010
+ *         (A 31:30, R 29:20, G 19:10, B 9:0 of a little-endian u32).
+ * Both are 4 bytes a pixel, one linear plane; nothing else in the surface
+ * differs. The extended-range 'w30r' and FP16 'RGhA' are not used.
+ */
+#define DCP_M4_FOURCC_BGRA	0x42475241U
+#define DCP_M4_FOURCC_L10R	0x6c313072U
+
+static inline bool dcp_m4_format_valid(enum dcp_m4_frame_format format)
+{
+	switch (format) {
+	case DCP_M4_XRGB8888:
+	case DCP_M4_ARGB8888:
+	case DCP_M4_XRGB2101010:
+	case DCP_M4_ARGB2101010:
+		return true;
+	}
+	return false;
+}
+
+static inline bool dcp_m4_format_10bit(enum dcp_m4_frame_format format)
+{
+	return format == DCP_M4_XRGB2101010 || format == DCP_M4_ARGB2101010;
+}
+
+static inline u32 dcp_m4_format_fourcc(enum dcp_m4_frame_format format)
+{
+	return dcp_m4_format_10bit(format) ? DCP_M4_FOURCC_L10R : DCP_M4_FOURCC_BGRA;
+}
+
+/* X formats carry don't-care alpha: present them premultiplied (surface +2). */
+static inline bool dcp_m4_format_opaque(enum dcp_m4_frame_format format)
+{
+	return format == DCP_M4_XRGB8888 || format == DCP_M4_XRGB2101010;
+}
+
+/* The opaque format of the same depth (a cache of a frame keeps its depth). */
+static inline enum dcp_m4_frame_format dcp_m4_format_opaque_of(enum dcp_m4_frame_format format)
+{
