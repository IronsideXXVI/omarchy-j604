diff --git a/drivers/gpu/drm/apple/dcp-m4-sleep-test.c b/drivers/gpu/drm/apple/dcp-m4-sleep-test.c
new file mode 100644
index 0000000000..011dbdd99e
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-sleep-test.c
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * KUnit tests for the T8132 display's part in a sleep that powers the SoC
+ * down (dcp-m4-sleep.h). No hardware.
+ */
+#include <kunit/test.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include "dcp-m4-sleep.h"
+
+/* A J604 with a running, blanked session and power_gate_ms set: may sleep. */
+static struct dcp_m4_fw_sleep_state ready(void)
+{
+	return (struct dcp_m4_fw_sleep_state) {
+		.runtime = true,
+		.gate_capable = true,
+		.gate_enabled = true,
+		.display_off = true,
+	};
+}
+
+static void dcp_m4_sleep_blanked_ok(struct kunit *test)
+{
+	struct dcp_m4_fw_sleep_state s = ready();
+
+	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_OK);
+}
+
+/* Each missing condition refuses on its own, with its own reason. */
+static void dcp_m4_sleep_each_refusal(struct kunit *test)
+{
+	struct dcp_m4_fw_sleep_state s;
+
+	s = ready();
+	s.runtime = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_NO_SESSION);
+	s = ready();
+	s.failed = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_FAILED);
+	s = ready();
+	s.gate_capable = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_NO_GATE);
+	s = ready();
+	s.gate_enabled = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_GATE_OFF);
+	s = ready();
+	s.scanning = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_SCANNING);
+	s = ready();
+	s.display_off = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_NOT_BLANKED);
+}
+
+/* Down already (a blank longer than power_gate_ms): OK even if the knob went to 0 since. */
+static void dcp_m4_sleep_gated_ok(struct kunit *test)
+{
+	struct dcp_m4_fw_sleep_state s = ready();
+
+	s.gated = true;
+	s.gate_enabled = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_OK);
+	/* But never for a failed or missing session. */
+	s.failed = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_FAILED);
+	s.runtime = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_NO_SESSION);
+}
+
+/* No power-down on the board (no apple,pmc-interface): refused whatever else holds, as before. */
+static void dcp_m4_sleep_no_gate_board(struct kunit *test)
+{
+	struct dcp_m4_fw_sleep_state s = ready();
+
+	s.gate_capable = false;
+	s.scanning = true;
+	s.display_off = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_NO_GATE);
+	KUNIT_EXPECT_NOT_NULL(test, strstr(dcp_m4_fw_sleep_reason(DCP_M4_FW_SLEEP_NO_GATE),
+					   "no display firmware stop"));
+}
+
+/* A J604 dcpext with a started session and its providers described. */
+static struct dcp_m4_ext_sleep_inputs dcpext(void)
+{
+	return (struct dcp_m4_ext_sleep_inputs) {
+		.runtime = true,
+		.gate_capable = true,
+	};
+}
+
+static enum dcp_m4_fw_sleep_verdict dcpext_verdict(const struct dcp_m4_ext_sleep_inputs *in)
+{
+	struct dcp_m4_fw_sleep_state s = dcp_m4_ext_sleep_state(in);
+
+	return dcp_m4_fw_sleep_check(&s);
+}
+
+/*
+ * (a) No display attached: never powered, its display DART off since the
+ * session started. It does not block the sleep, and power_gate_ms (the
+ * internal panel's) plays no part.
+ */
+static void dcp_m4_sleep_dcpext_no_display(struct kunit *test)
+{
+	struct dcp_m4_ext_sleep_inputs in = dcpext();
+
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_OK);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sleep_state(&in).gate_enabled);
+}
+
+/*
+ * (b) HDMI attached: after iomfb_m4_ext_sleep_down() (A473 0, D572(0)) it
+ * may sleep; while its display is still powered, its display DART still on
+ * or a swap in flight, it refuses with the matching reason.
+ */
+static void dcp_m4_sleep_dcpext_hdmi(struct kunit *test)
+{
+	struct dcp_m4_ext_sleep_inputs in = dcpext();
+
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_OK);
+	in.powered = true;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_NOT_BLANKED);
+	in = dcpext();
+	in.dart_on = true;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_SCANNING);
+	in = dcpext();
+	in.swaps = 1;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_SCANNING);
+}
+
+/* What still refuses a dcpext, each with its own reason; and down already is OK. */
+static void dcp_m4_sleep_dcpext_refusals(struct kunit *test)
+{
+	struct dcp_m4_ext_sleep_inputs in;
+
+	in = dcpext();
+	in.gate_capable = false;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_NO_GATE);
+	in = dcpext();
+	in.failed = true;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_FAILED);
+	in = dcpext();
+	in.runtime = false;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_NO_SESSION);
+	in = dcpext();
+	in.gated = true;
+	in.powered = true;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_OK);
+	in.failed = true;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_FAILED);
+}
+
+static void dcp_m4_sleep_reasons(struct kunit *test)
+{
+	enum dcp_m4_fw_sleep_verdict v;
+
+	for (v = DCP_M4_FW_SLEEP_OK; v <= DCP_M4_FW_SLEEP_PMP_REFUSED; v++)
+		KUNIT_EXPECT_STRNEQ(test, dcp_m4_fw_sleep_reason(v), "unknown");
+	KUNIT_EXPECT_NOT_NULL(test, strstr(dcp_m4_fw_sleep_reason(DCP_M4_FW_SLEEP_GATE_OFF),
+					   "power_gate_ms=0"));
+}
+
+static struct kunit_case dcp_m4_sleep_cases[] = {
+	KUNIT_CASE(dcp_m4_sleep_blanked_ok),
+	KUNIT_CASE(dcp_m4_sleep_each_refusal),
+	KUNIT_CASE(dcp_m4_sleep_gated_ok),
+	KUNIT_CASE(dcp_m4_sleep_no_gate_board),
+	KUNIT_CASE(dcp_m4_sleep_dcpext_no_display),
+	KUNIT_CASE(dcp_m4_sleep_dcpext_hdmi),
+	KUNIT_CASE(dcp_m4_sleep_dcpext_refusals),
+	KUNIT_CASE(dcp_m4_sleep_reasons),
+	{}
+};
+
+static struct kunit_suite dcp_m4_sleep_suite = {
+	.name = "apple-dcp-m4-sleep",
+	.test_cases = dcp_m4_sleep_cases,
+};
+
+kunit_test_suite(dcp_m4_sleep_suite);
+
+MODULE_DESCRIPTION("Apple T8132 display system sleep decision tests");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/gpu/drm/apple/dcp-m4-sleep.h b/drivers/gpu/drm/apple/dcp-m4-sleep.h
new file mode 100644
index 0000000000..0e73f34fc8
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-sleep.h
@@ -0,0 +1,130 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * T8132 (M4) display and a system sleep that powers the SoC down
+ * (pm_suspend_via_firmware()). Decisions only, no hardware: unit tested by
+ * dcp-m4-sleep-test.c.
+ *
+ * Such a sleep cuts the power of the display coprocessor and its domains.
+ * The display power-down of iomfb_m4_power_gate() already brings the DCP to
+ * that state on purpose: CPU stopped, display DARTs, PMP DISP vote, PMC
+ * interface and PMGR domains down, firmware and shared buffers left in DRAM
+ * for iomfb_m4_power_ungate(). So the sleep may go ahead only once that
+ * power-down has happened (or can happen now) for a live, unfailed session
+ * on a board that has it, with nothing scanned out and the display blanked.
+ */
+#ifndef _DCP_M4_SLEEP_H
+#define _DCP_M4_SLEEP_H
+
+#include <linux/types.h>
+
+enum dcp_m4_fw_sleep_verdict {
+	DCP_M4_FW_SLEEP_OK,
+	/* No display session was started: nothing here can stop that firmware. */
+	DCP_M4_FW_SLEEP_NO_SESSION,
+	/* The session failed. */
+	DCP_M4_FW_SLEEP_FAILED,
+	/* The board has no display power-down (no apple,pmc-interface). */
+	DCP_M4_FW_SLEEP_NO_GATE,
+	/* appledrm.power_gate_ms = 0: the display is never powered down. */
+	DCP_M4_FW_SLEEP_GATE_OFF,
+	/* A frame, or the startup surface, is still scanned out. */
+	DCP_M4_FW_SLEEP_SCANNING,
+	/* The display was not powered down by a blank. */
+	DCP_M4_FW_SLEEP_NOT_BLANKED,
+	/* The power-down did not complete (iomfb_m4_power_gate()). */
+	DCP_M4_FW_SLEEP_GATE_FAILED,
+	/* The PMP did not take the arming (apple_pmp_j713_display_sleep_enable()). */
+	DCP_M4_FW_SLEEP_PMP_REFUSED,
+};
+
+struct dcp_m4_fw_sleep_state {
+	bool runtime;		/* a display session was started */
+	bool failed;		/* it failed */
+	bool gated;		/* the DCP and its domains are down already */
+	bool gate_capable;	/* the board has the power-down */
+	bool gate_enabled;	/* appledrm.power_gate_ms is not 0 */
+	bool scanning;		/* a frame or the startup surface is scanned out */
+	bool display_off;	/* blanked: setPowerState(0) done by the blank */
+};
+
+/* Whether the sleep may go ahead, before the power-down is started. */
+static inline enum dcp_m4_fw_sleep_verdict
+dcp_m4_fw_sleep_check(const struct dcp_m4_fw_sleep_state *s)
+{
+	if (!s->runtime)
+		return DCP_M4_FW_SLEEP_NO_SESSION;
+	if (s->failed)
+		return DCP_M4_FW_SLEEP_FAILED;
+	/* Down already (a blank longer than power_gate_ms): nothing left to do. */
+	if (s->gated)
+		return DCP_M4_FW_SLEEP_OK;
+	if (!s->gate_capable)
+		return DCP_M4_FW_SLEEP_NO_GATE;
+	if (!s->gate_enabled)
+		return DCP_M4_FW_SLEEP_GATE_OFF;
+	if (s->scanning)
+		return DCP_M4_FW_SLEEP_SCANNING;
+	if (!s->display_off)
+		return DCP_M4_FW_SLEEP_NOT_BLANKED;
+	return DCP_M4_FW_SLEEP_OK;
+}
+
+static inline const char *dcp_m4_fw_sleep_reason(enum dcp_m4_fw_sleep_verdict verdict)
+{
+	switch (verdict) {
+	case DCP_M4_FW_SLEEP_OK:
+		return "display powered down";
+	case DCP_M4_FW_SLEEP_NO_SESSION:
+		return "no display session to stop";
+	case DCP_M4_FW_SLEEP_FAILED:
+		return "the display session failed";
+	case DCP_M4_FW_SLEEP_NO_GATE:
+		return "no display firmware stop on this board (no display power-down)";
+	case DCP_M4_FW_SLEEP_GATE_OFF:
+		return "display power-down disabled (appledrm.power_gate_ms=0)";
+	case DCP_M4_FW_SLEEP_SCANNING:
+		return "panel still scanning out";
+	case DCP_M4_FW_SLEEP_NOT_BLANKED:
+		return "display not blanked";
+	case DCP_M4_FW_SLEEP_GATE_FAILED:
+		return "display power-down failed";
+	case DCP_M4_FW_SLEEP_PMP_REFUSED:
+		return "the PMP did not release the display for this sleep";
+	}
+	return "unknown";
+}
+
+/*
+ * An external DCP (T8132 dcpext) takes the same checks with its own inputs:
+ * no blank of its own and no power_gate_ms (that knob is the internal
+ * panel's), but its display powered off for the sleep (A473 0, done by
+ * iomfb_m4_ext_sleep_down() before the freeze, or never powered on: no
+ * display attached, the fast path) and its display DART off (the
+ * firmware's last D572 was 0) with no swap in flight. Its providers are its
+ * own: apple,pmc-interface and its DARTs' and domains' (gate_capable).
+ */
+struct dcp_m4_ext_sleep_inputs {
+	bool runtime;		/* its session was started */
+	bool failed;		/* it failed */
+	bool gated;		/* the DCP and its domains are down already */
+	bool gate_capable;	/* the board describes its power-down */
+	bool powered;		/* its display is powered on */
+	bool dart_on;		/* its display DART is on (last D572 was 1) */
+	unsigned int swaps;	/* swaps in flight */
+};
+
+static inline struct dcp_m4_fw_sleep_state
+dcp_m4_ext_sleep_state(const struct dcp_m4_ext_sleep_inputs *in)
+{
+	return (struct dcp_m4_fw_sleep_state) {
+		.runtime = in->runtime,
+		.failed = in->failed,
+		.gated = in->gated,
+		.gate_capable = in->gate_capable,
+		.gate_enabled = true,
+		.scanning = in->swaps || in->dart_on,
+		.display_off = !in->powered,
+	};
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-timing.h b/drivers/gpu/drm/apple/dcp-m4-timing.h
index 13af59e83c..5429dc1db1 100644
--- a/drivers/gpu/drm/apple/dcp-m4-timing.h
+++ b/drivers/gpu/drm/apple/dcp-m4-timing.h
@@ -241,4 +241,133 @@ static inline int dcp_m4_parse_timing(const void *data, size_t size, struct dcp_
 	return ret;
 }
 
+/* The most fixed-rate timings kept beside the preferred one. */
+#define DCP_M4_FIXED_MAX 8
+
+/*
+ * One axis of a catalog timing: Active, Total, FrontPorch, SyncWidth,
+ * BackPorch and PreciseSyncRate into @v, with the qualified active size, no
+ * pixel repetition, and porches and sync that add up to the total.
+ */
+static inline int dcp_m4_fixed_axis(const struct dcp_m4_timing_parser *p, unsigned int mode,
+				    const char *name, u32 active, u32 v[6])
+{
+	static const char * const fields[] = {
+		"Active", "Total", "FrontPorch", "SyncWidth", "BackPorch", "PreciseSyncRate",
+	};
+	int axis = dcp_m4_timing_field(p, mode, name, 1);
+
+	if (axis < 0)
+		return axis;
+	for (unsigned int i = 0; i < ARRAY_SIZE(fields); i++) {
+		int index = dcp_m4_timing_field(p, axis, fields[i], 4);
+
+		if (index < 0 || p->token[index].value > U32_MAX)
+			return -EINVAL;
+		v[i] = p->token[index].value;
+	}
+	if (!dcp_m4_timing_equals(p, axis, "PixelRepetition", 4, 0) || v[0] != active ||
+	    (u64)v[0] + v[2] + v[3] + v[4] != v[1] || !v[5])
+		return -EINVAL;
+	return 0;
+}
+
+/* Whether a timing's ColorModes has colour ID 1, 8 bpc RGB SDR, as ID 2's. */
+static inline bool dcp_m4_fixed_colour(const struct dcp_m4_timing_parser *p, unsigned int mode)
+{
+	static const char * const fields[] = {
+		"ID", "Depth", "PixelEncoding", "DynamicRange", "EOTF", "Colorimetry",
+		"SupportsDSC",
+	};
+	static const u32 values[] = { 1, 8, 0, 0, 0, 16, 0 };
+	int colors = dcp_m4_timing_field(p, mode, "ColorModes", 2);
+	unsigned int color;
+
+	if (colors < 0)
+		return false;
+	color = colors + 1;
+	for (unsigned int j = 0; j < p->token[colors].count; j++, color = p->token[color].next) {
+		unsigned int i;
+
+		if (!dcp_m4_timing_equals(p, color, "IsVirtual", 11, 0))
+			continue;
+		for (i = 0; i < ARRAY_SIZE(fields); i++)
+			if (!dcp_m4_timing_equals(p, color, fields[i], 4, values[i]))
+				break;
+		if (i == ARRAY_SIZE(fields))
+			return true;
+	}
+	return false;
+}
+
+/*
+ * The panel's other fixed-rate timings, from its TimingElements catalog:
+ * promoted, not preferred, virtual, interlaced, split or overscanned, timing
+ * type 3, no variable range, the qualified timing's active size, colour ID 1
+ * as ID 2 has it, and a rate from 24 Hz to below ID 2's. On the J604 these
+ * are IDs 3 to 7: 60, 48, 59.94, 47.952 and 50 Hz. Returns how many were
+ * taken into @out, or an error for a catalog that does not parse.
+ */
+static inline int dcp_m4_parse_fixed_timings(const void *data, size_t size,
+					     struct dcp_m4_timing *out, unsigned int max)
+{
+	struct dcp_m4_timing_parser *p;
+	const u32 (*q)[8] = dcp_m4_pf->timing;
+	unsigned int element = 1;
+	int ret, n = 0;
+
+	if (!q)
+		return -ENODEV;
+	if (!data || !out || size < 4 || size > (1U << 20) || get_unaligned_le32(data) != 0xd3)
+		return -EINVAL;
+	p = kzalloc_obj(*p);
+	if (!p)
+		return -ENOMEM;
+	p->data = data;
+	p->size = size;
+	p->pos = 4;
+	ret = dcp_m4_timing_object(p, 0);
+	if (!ret && (p->pos != size || p->token[0].type != 2))
+		ret = -EINVAL;
+	if (ret)
+		goto done;
+	for (unsigned int i = 0; i < p->token[0].count && n < max;
+	     i++, element = p->token[element].next) {
+		int index = dcp_m4_timing_field(p, element, "ID", 4);
+		u32 h[6], v[6];
+		u64 id;
+
+		if (index < 0)
+			continue;
+		id = p->token[index].value;
+		if (id == 2 || id > U32_MAX ||
+		    !dcp_m4_timing_equals(p, element, "IsPromoted", 11, 1) ||
+		    !dcp_m4_timing_equals(p, element, "IsPreferred", 11, 0) ||
+		    !dcp_m4_timing_equals(p, element, "IsVirtual", 11, 0) ||
+		    !dcp_m4_timing_equals(p, element, "IsInterlaced", 11, 0) ||
+		    !dcp_m4_timing_equals(p, element, "IsSplit", 11, 0) ||
+		    !dcp_m4_timing_equals(p, element, "IsOverscanned", 11, 0) ||
+		    !dcp_m4_timing_equals(p, element, "TimingType", 4, 3) ||
+		    !dcp_m4_timing_equals(p, element, "MinimumVariableRefreshRate", 4, 0) ||
+		    !dcp_m4_timing_equals(p, element, "MaximumVariableRefreshRate", 4, 0) ||
+		    dcp_m4_fixed_axis(p, element, "HorizontalAttributes", q[0][0], h) ||
+		    dcp_m4_fixed_axis(p, element, "VerticalAttributes", q[1][0], v) ||
+		    v[5] < (24U << 16) || v[5] >= q[1][5] || !dcp_m4_fixed_colour(p, element))
+			continue;
+		out[n++] = (struct dcp_m4_timing) {
+			.id = id, .color_id = 1,
+			.hdisplay = h[0], .hsync_start = h[0] + h[2],
+			.hsync_end = h[0] + h[2] + h[3], .htotal = h[1],
+			.vdisplay = v[0], .vsync_start = v[0] + v[2],
+			.vsync_end = v[0] + v[2] + v[3], .vtotal = v[1],
+			.clock_khz = (((u64)h[1] * v[1] * v[5] >> 16) + 500) / 1000,
+			.refresh_16_16 = v[5],
+		};
+	}
+	ret = n;
+done:
+	kfree(p);
+	return ret;
+}
+
 #endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-xdr-test.c b/drivers/gpu/drm/apple/dcp-m4-xdr-test.c
new file mode 100644
index 0000000000..0cc7eeb3fe
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-xdr-test.c
@@ -0,0 +1,428 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/*
+ * The XDR guard (dcp-m4-xdr.h) with the J604's ADT values: a 600 nit user
+ * maximum, the 1000 nit aurora maximum and a 300 nit thermal minimum cap.
+ * The ladder, what a stalled, hidden or failed swap does, that ordinary
+ * swaps never move it, the thermal cap and starting over; which internal
+ * swaps are given up with the session kept, and their late D590s.
+ */
+
+#include <kunit/test.h>
+
+#include "dcp-m4-xdr.h"
+
+#define USER	600U
+#define TOP	1000U
+#define MINCAP	300U
+#define FAST	8000U	/* us: one 120 Hz frame */
+#define SLOW	(DCP_M4_XDR_STALL_US + 1)
+
+static void j604(struct dcp_m4_xdr *x)
+{
+	dcp_m4_xdr_init(x, USER, TOP, MINCAP, true);
+}
+
+/* @n taken swaps at @level; returns how many changed the cap. */
+static unsigned int taken(struct dcp_m4_xdr *x, u32 level, unsigned int n)
+{
+	unsigned int changed = 0;
+
+	while (n--)
+		changed += dcp_m4_xdr_swap(x, level, true, true, FAST);
+	return changed;
+}
+
+static void xdr_off(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+
+	dcp_m4_xdr_init(&x, USER, TOP, MINCAP, false);
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_OFF);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), USER);
+	/* Asking for more changes nothing: the cap never let it out. */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, 800, true, true, FAST));
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), USER);
+	/* No aurora maximum (or one not above the user maximum): off too. */
+	dcp_m4_xdr_init(&x, USER, 0, MINCAP, true);
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_OFF);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), USER);
+	dcp_m4_xdr_init(&x, USER, USER, MINCAP, true);
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_OFF);
+}
+
+static void xdr_climbs_the_ladder(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+
+	j604(&x);
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_RAMP);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), 800U);
+	KUNIT_EXPECT_EQ(test, taken(&x, 800, DCP_M4_XDR_GOOD_SWAPS - 1), 0U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), 800U);
+	KUNIT_EXPECT_EQ(test, taken(&x, 800, 1), 1U);
+	KUNIT_EXPECT_EQ(test, x.taken, 800U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), TOP);
+	KUNIT_EXPECT_EQ(test, taken(&x, TOP, DCP_M4_XDR_GOOD_SWAPS), 1U);
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_TRUSTED);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), TOP);
+	/* Trusted: nothing moves it any more, a stall included. */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, TOP, true, false, SLOW));
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), TOP);
+	KUNIT_EXPECT_EQ(test, x.reverts, 0U);
+}
+
+/* What the swaps asked for is taken, not the rung: 700 taken, 900 tried. */
+static void xdr_takes_the_level_asked_for(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+
+	j604(&x);
+	taken(&x, 650, DCP_M4_XDR_GOOD_SWAPS / 2);
+	taken(&x, 700, DCP_M4_XDR_GOOD_SWAPS / 2);
+	KUNIT_EXPECT_EQ(test, x.taken, 700U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), 900U);
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_RAMP);
+}
+
+static void xdr_stalls_refuse_after_three(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+
+	j604(&x);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, 800, true, true, SLOW));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, 800, true, true, SLOW));
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), 800U);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_swap(&x, 800, true, true, SLOW));
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_REFUSED);
+	KUNIT_EXPECT_EQ(test, x.reason, DCP_M4_XDR_STALLED);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), USER);
+	KUNIT_EXPECT_EQ(test, x.reverts, 1U);
+	/* Refused stays refused: the swaps it allows never climb again. */
+	KUNIT_EXPECT_EQ(test, taken(&x, USER, 3 * DCP_M4_XDR_GOOD_SWAPS), 0U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), USER);
+	/* At the threshold exactly a swap has not stalled. */
+	j604(&x);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, 800, true, true, DCP_M4_XDR_STALL_US));
+	KUNIT_EXPECT_EQ(test, x.bad, 0U);
+}
+
+/* Not in a row: a taken swap in between starts the count again. */
+static void xdr_stalls_must_be_in_a_row(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+
+	j604(&x);
+	for (unsigned int i = 0; i < 10; i++) {
+		KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, 800, true, true, SLOW));
+		KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, 800, true, true, SLOW));
+		KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, 800, true, true, FAST));
+	}
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_RAMP);
+	/* ... and a stall starts the taken count again. */
+	KUNIT_EXPECT_EQ(test, x.good, 1U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), 800U);
+}
+
+/*
+ * The D590's displayed byte counts only once a D590 has said "displayed"
+ * for an ordinary swap: a firmware that never sets it does not refuse.
+ */
+static void xdr_hidden_counts_once_the_byte_is_known(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+
+	j604(&x);
+	for (unsigned int i = 0; i < DCP_M4_XDR_GOOD_SWAPS; i++)
+		dcp_m4_xdr_swap(&x, 800, true, false, FAST);
+	KUNIT_EXPECT_EQ(test, x.taken, 800U);
+	KUNIT_EXPECT_FALSE(test, x.shown_seen);
+
+	j604(&x);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, USER, true, true, FAST));
+	KUNIT_EXPECT_TRUE(test, x.shown_seen);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, 800, true, false, FAST));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, 800, true, false, FAST));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_swap(&x, 800, true, false, FAST));
+	KUNIT_EXPECT_EQ(test, x.reason, DCP_M4_XDR_NOT_SHOWN);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), USER);
+}
+
+static void xdr_failed_swap_refuses_at_once(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+
+	j604(&x);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_swap(&x, 700, false, false, FAST));
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_REFUSED);
+	KUNIT_EXPECT_EQ(test, x.reason, DCP_M4_XDR_FAILED);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), USER);
+}
+
+/* A rung refused after one taken: back to that one, not to the user maximum. */
+static void xdr_refused_keeps_the_rung_taken(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+
+	j604(&x);
+	taken(&x, 800, DCP_M4_XDR_GOOD_SWAPS);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), TOP);
+	taken(&x, 900, 5);
+	dcp_m4_xdr_swap(&x, 950, true, true, SLOW);
+	dcp_m4_xdr_swap(&x, 950, true, true, SLOW);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_swap(&x, 950, true, true, SLOW));
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_REFUSED);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), 800U);
+	/* Levels up to the one taken are ordinary swaps again. */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, 800, true, false, SLOW));
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), 800U);
+}
+
+/* Swaps at or below the level taken never move the guard, whatever they do. */
+static void xdr_ordinary_swaps(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+
+	j604(&x);
+	for (unsigned int i = 0; i < 100; i++) {
+		KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, 0, true, true, SLOW));
+		KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, USER, true, false, SLOW));
+		KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, 400, false, false, FAST));
+	}
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_RAMP);
+	KUNIT_EXPECT_EQ(test, x.good, 0U);
+	KUNIT_EXPECT_EQ(test, x.bad, 0U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), 800U);
+}
+
+static void xdr_thermal_cap(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+
+	j604(&x);
+	/* 1000 down to 300 in 100 nit steps: 7 states. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_max_state(&x), 7U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_thermal_cap(&x, 0), 0U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_thermal_cap(&x, 1), 900U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_thermal_cap(&x, 4), USER);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_thermal_cap(&x, 6), 400U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_thermal_cap(&x, 7), MINCAP);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_thermal_cap(&x, 1000), MINCAP);
+	/* The limit: the lower of the guard's cap and the thermal one. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_limit(&x, 0), 800U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_limit(&x, 1), 800U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_limit(&x, 3), 700U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_limit(&x, 5), 500U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_limit(&x, 7), MINCAP);
+	/* With the guard off the thermal cap still holds, on SDR too. */
+	dcp_m4_xdr_init(&x, USER, TOP, MINCAP, false);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_limit(&x, 0), USER);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_limit(&x, 6), 400U);
+	/* No minimum cap in the ADT: no thermal cap. */
+	dcp_m4_xdr_init(&x, USER, TOP, 0, true);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_max_state(&x), 0U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_thermal_cap(&x, 3), 0U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_limit(&x, 3), 800U);
+	/* No aurora maximum: down from the user maximum, 3 states. */
+	dcp_m4_xdr_init(&x, USER, 0, MINCAP, true);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_max_state(&x), 3U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_limit(&x, 1), 500U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_limit(&x, 3), MINCAP);
+}
+
+static void xdr_rearm(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+
+	j604(&x);
+	dcp_m4_xdr_swap(&x, USER, true, true, FAST);
+	dcp_m4_xdr_swap(&x, 800, false, false, FAST);
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_REFUSED);
+	dcp_m4_xdr_rearm(&x, true);
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_RAMP);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), 800U);
+	KUNIT_EXPECT_TRUE(test, x.shown_seen);
+	KUNIT_EXPECT_EQ(test, x.reverts, 1U);
+	dcp_m4_xdr_rearm(&x, false);
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_OFF);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), USER);
+}
+
+static void xdr_names(struct kunit *test)
+{
+	KUNIT_EXPECT_STREQ(test, dcp_m4_xdr_state_name(DCP_M4_XDR_RAMP), "ramp");
+	KUNIT_EXPECT_STREQ(test, dcp_m4_xdr_state_name(DCP_M4_XDR_REFUSED), "refused");
+	KUNIT_EXPECT_STREQ(test, dcp_m4_xdr_reason_name(DCP_M4_XDR_STALLED), "swap stalled");
+	KUNIT_EXPECT_STREQ(test, dcp_m4_xdr_reason_name(DCP_M4_XDR_NONE), "none");
+}
+
+/* A probe answered by A407, its D590 not in by the deadline. */
+static struct dcp_m4_xdr_end stalled(u32 id)
+{
+	return (struct dcp_m4_xdr_end){ .id = id, .error = -ETIMEDOUT, .probe = true,
+					.quiet = true, .replied = true };
+}
+
+/* A probe whose A407 came back with an error status. */
+static struct dcp_m4_xdr_end refused(u32 id)
+{
+	return (struct dcp_m4_xdr_end){ .id = id, .error = -EPROTO, .probe = true,
+					.quiet = true, .refused = true };
+}
+
+static void xdr_give_up_stalled_probe(struct kunit *test)
+{
+	struct dcp_m4_xdr_lost l = {};
+	struct dcp_m4_xdr_end e = stalled(41);
+
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_STALLED);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_lost_add(&l, 41));
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_lost_find(&l, 41), 0);
+	KUNIT_EXPECT_EQ(test, l.given_up, 1U);
+	/* Its late D590 is dropped once, then the ID is free again. */
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_lost_drop(&l, 41));
+	KUNIT_EXPECT_EQ(test, l.late, 1U);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_lost_drop(&l, 41));
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_lost_find(&l, 41), -1);
+	KUNIT_EXPECT_EQ(test, l.late, 1U);
+}
+
+static void xdr_give_up_refused_probe(struct kunit *test)
+{
+	struct dcp_m4_xdr_lost l = {};
+	struct dcp_m4_xdr_end e = refused(42);
+
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_REFUSED);
+	/* Refused is an A407 error status: neither answered with 0 nor another error. */
+	e.replied = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	e = refused(42);
+	e.error = -EMSGSIZE;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+}
+
+/* An ordinary swap (no level above the one taken) is never given up. */
+static void xdr_give_up_ordinary_swap_fails(struct kunit *test)
+{
+	struct dcp_m4_xdr_lost l = {};
+	struct dcp_m4_xdr_end e = stalled(43);
+
+	e.probe = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	e = refused(43);
+	e.probe = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+}
+
+/* Only with nothing else outstanding, and only for what the probe itself did. */
+static void xdr_give_up_needs_a_quiet_session(struct kunit *test)
+{
+	struct dcp_m4_xdr_lost l = {};
+	struct dcp_m4_xdr_end e = stalled(44);
+
+	e.quiet = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	e = stalled(44);
+	e.completed = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	e = stalled(0);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	/* A407 itself unanswered (no reply, no status): not given up. */
+	e = stalled(44);
+	e.replied = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	/* Any other error of the probe: the session fails. */
+	e = stalled(44);
+	e.error = -EIO;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	e.error = -EPROTO;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+}
+
+static void xdr_give_up_slots(struct kunit *test)
+{
+	struct dcp_m4_xdr_lost l = {};
+	struct dcp_m4_xdr_end e;
+
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_lost_add(&l, 51));
+	/* The same ID again: its first D590 could not be told apart. */
+	e = stalled(51);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_lost_add(&l, 52));
+	/* Every slot taken: not given up. */
+	e = refused(53);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_lost_add(&l, 53));
+	KUNIT_EXPECT_EQ(test, l.given_up, 2U);
+	/* A late D590 frees its slot. */
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_lost_drop(&l, 51));
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_REFUSED);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_lost_add(&l, 53));
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_lost_find(&l, 53), 0);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_lost_find(&l, 52), 1);
+}
+
+static void xdr_lost_ids(struct kunit *test)
+{
+	struct dcp_m4_xdr_lost l = {};
+
+	/* ID 0 is never kept nor dropped (it marks a free slot). */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_lost_add(&l, 0));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_lost_drop(&l, 0));
+	/* A D590 of a swap never given up is not dropped. */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_lost_drop(&l, 77));
+	KUNIT_EXPECT_EQ(test, l.given_up, 0U);
+	KUNIT_EXPECT_EQ(test, l.late, 0U);
+	KUNIT_EXPECT_STREQ(test, dcp_m4_xdr_give_up_name(DCP_M4_XDR_KEEP_REFUSED), "refused");
+	KUNIT_EXPECT_STREQ(test, dcp_m4_xdr_give_up_name(DCP_M4_XDR_KEEP_STALLED),
+			   "left without its D590");
+	KUNIT_EXPECT_STREQ(test, dcp_m4_xdr_give_up_name(DCP_M4_XDR_KEEP_NONE), "none");
+}
+
+/* A probe given up: the guard refuses, levels back to the one taken, once. */
+static void xdr_give_up_reverts_the_guard(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+	struct dcp_m4_xdr_lost l = {};
+	struct dcp_m4_xdr_end e = stalled(61);
+
+	j604(&x);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_STALLED);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_swap(&x, 800, false, true, FAST));
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_REFUSED);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), USER);
+	KUNIT_EXPECT_EQ(test, x.reverts, 1U);
+	/* The next swap asks no more than the level taken: no probe, no change. */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, USER, true, true, FAST));
+	KUNIT_EXPECT_EQ(test, x.reverts, 1U);
+}
+
+static struct kunit_case m4_xdr_cases[] = {
+	KUNIT_CASE(xdr_off),
+	KUNIT_CASE(xdr_climbs_the_ladder),
+	KUNIT_CASE(xdr_takes_the_level_asked_for),
+	KUNIT_CASE(xdr_stalls_refuse_after_three),
+	KUNIT_CASE(xdr_stalls_must_be_in_a_row),
+	KUNIT_CASE(xdr_hidden_counts_once_the_byte_is_known),
+	KUNIT_CASE(xdr_failed_swap_refuses_at_once),
+	KUNIT_CASE(xdr_refused_keeps_the_rung_taken),
+	KUNIT_CASE(xdr_ordinary_swaps),
+	KUNIT_CASE(xdr_thermal_cap),
+	KUNIT_CASE(xdr_rearm),
+	KUNIT_CASE(xdr_names),
+	KUNIT_CASE(xdr_give_up_stalled_probe),
+	KUNIT_CASE(xdr_give_up_refused_probe),
+	KUNIT_CASE(xdr_give_up_ordinary_swap_fails),
+	KUNIT_CASE(xdr_give_up_needs_a_quiet_session),
+	KUNIT_CASE(xdr_give_up_slots),
+	KUNIT_CASE(xdr_lost_ids),
+	KUNIT_CASE(xdr_give_up_reverts_the_guard),
+	{}
+};
+
+static struct kunit_suite m4_xdr_suite = {
+	.name = "apple-dcp-m4-xdr",
+	.test_cases = m4_xdr_cases,
+};
+
+kunit_test_suite(m4_xdr_suite);
diff --git a/drivers/gpu/drm/apple/dcp-m4-xdr.h b/drivers/gpu/drm/apple/dcp-m4-xdr.h
new file mode 100644
index 0000000000..23ca184570
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-xdr.h
@@ -0,0 +1,321 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The XDR guard of the T8132 internal panel (firmware 26.6.2).
+ *
+ * The panel takes levels above the user maximum (600 nits on the J604):
+ * EDR highlights and a raised SDR ceiling in bright surroundings, up to the
+ * ADT aurora maximum (1000 nits, what macOS sustains).  Whether the 26.6.2
+ * firmware takes such a level in a swap has not been measured.  So a level above
+ * the user maximum is asked for only as far as the firmware has been seen to
+ * take one, up a ladder of rungs of DCP_M4_XDR_STEP_NITS:
+ *
+ *  - a swap that asks for a level above the last one taken counts as taken
+ *    when its A407 is answered, its D590 comes within DCP_M4_XDR_STALL_US
+ *    and, once a D590 has said so for an ordinary swap, it was displayed;
+ *  - DCP_M4_XDR_GOOD_SWAPS taken in a row: the highest of their levels is
+ *    taken, and the next rung is tried (the top: trusted);
+ *  - DCP_M4_XDR_BAD_SWAPS in a row that stalled or were not displayed, or
+ *    one that failed: refused, every level goes back at once to the last one
+ *    taken and stays there (until panel_xdr is written again).
+ *
+ * Thermal mitigation caps every level, SDR ones included, one
+ * DCP_M4_XDR_THERMAL_STEP per cooling state and never below the ADT
+ * thermal-mitigation-min-cap (300 nits on the J604), as macOS does.
+ *
+ * A swap asking for a level above the one taken (a probe) that the firmware
+ * refuses or leaves without its D590 is given up without ending the session
+ * (dcp_m4_xdr_give_up() below): the guard refuses and the panel goes back to
+ * the level taken, as for any failed probe.
+ *
+ * Pure functions, for the KUnit suite.
+ */
+#ifndef APPLE_DCP_M4_XDR_H
+#define APPLE_DCP_M4_XDR_H
+
+#include <linux/errno.h>
+#include <linux/math.h>
+#include <linux/minmax.h>
+#include <linux/types.h>
+
+#define DCP_M4_XDR_STEP_NITS	200U	/* one rung of the ladder */
+#define DCP_M4_XDR_GOOD_SWAPS	48U	/* taken swaps at a rung: 2 s of 24 fps video */
+#define DCP_M4_XDR_BAD_SWAPS	3U	/* stalled or hidden swaps in a row: refused */
+#define DCP_M4_XDR_STALL_US	250000U	/* A407 to D590; a 120 Hz swap takes ~8 ms */
+#define DCP_M4_XDR_THERMAL_STEP	100U	/* nits per cooling state */
+
+enum dcp_m4_xdr_state {
+	DCP_M4_XDR_OFF,		/* off, or no level above the user maximum */
+	DCP_M4_XDR_RAMP,	/* up to the rung being tried */
+	DCP_M4_XDR_TRUSTED,	/* up to the top */
+	DCP_M4_XDR_REFUSED,	/* up to the last level taken */
+};
+
+enum dcp_m4_xdr_reason {
+	DCP_M4_XDR_NONE,
+	DCP_M4_XDR_NOT_SHOWN,
+	DCP_M4_XDR_STALLED,
+	DCP_M4_XDR_FAILED,
+};
+
+struct dcp_m4_xdr {
+	u32 user_max;	/* the user maximum: always allowed */
+	u32 top;	/* the ADT aurora maximum (0: none) */
+	u32 min_cap;	/* the ADT thermal minimum cap (0: no thermal cap) */
+	u32 taken;	/* the highest level taken, the user maximum at first */
+	u32 trying;	/* the rung being tried, above taken (0: none) */
+	u32 best;	/* the highest level taken at this rung so far */
+	u32 good, bad;	/* taken / stalled-or-hidden swaps in a row at this rung */
+	u32 reverts;
+	enum dcp_m4_xdr_state state;
+	enum dcp_m4_xdr_reason reason;
+	bool shown_seen; /* a D590 said "displayed" for an ordinary swap */
+};
+
+static inline const char *dcp_m4_xdr_state_name(enum dcp_m4_xdr_state state)
+{
+	switch (state) {
+	case DCP_M4_XDR_RAMP:
+		return "ramp";
+	case DCP_M4_XDR_TRUSTED:
+		return "trusted";
+	case DCP_M4_XDR_REFUSED:
+		return "refused";
+	default:
+		return "off";
+	}
+}
+
+static inline const char *dcp_m4_xdr_reason_name(enum dcp_m4_xdr_reason reason)
+{
+	switch (reason) {
+	case DCP_M4_XDR_NOT_SHOWN:
+		return "not displayed";
+	case DCP_M4_XDR_STALLED:
+		return "swap stalled";
+	case DCP_M4_XDR_FAILED:
+		return "swap failed";
+	default:
+		return "none";
+	}
+}
+
+/* A fresh guard; @on false, or no top above the user maximum: off. */
+static inline void dcp_m4_xdr_init(struct dcp_m4_xdr *x, u32 user_max, u32 top,
+				   u32 min_cap, bool on)
+{
+	*x = (struct dcp_m4_xdr){ .user_max = user_max, .top = top,
+				  .min_cap = min_cap, .taken = user_max };
+	if (!on || top <= user_max)
+		return;
+	x->state = DCP_M4_XDR_RAMP;
+	x->trying = min(top, user_max + DCP_M4_XDR_STEP_NITS);
+}
+
+/* Start over (panel_xdr written): what the D590 says stays known. */
+static inline void dcp_m4_xdr_rearm(struct dcp_m4_xdr *x, bool on)
+{
+	bool shown_seen = x->shown_seen;
+	u32 reverts = x->reverts;
+
+	dcp_m4_xdr_init(x, x->user_max, x->top, x->min_cap, on);
+	x->shown_seen = shown_seen;
+	x->reverts = reverts;
+}
+
+/* The highest panel level a swap may ask for, before thermal mitigation. */
+static inline u32 dcp_m4_xdr_cap(const struct dcp_m4_xdr *x)
+{
+	switch (x->state) {
+	case DCP_M4_XDR_RAMP:
+		return x->trying;
+	case DCP_M4_XDR_TRUSTED:
+		return x->top;
+	default:
+		return x->taken;
+	}
+}
+
+/* The deepest cooling state, one DCP_M4_XDR_THERMAL_STEP each down to the minimum cap. */
+static inline u32 dcp_m4_xdr_max_state(const struct dcp_m4_xdr *x)
+{
+	u32 top = max(x->top, x->user_max);
+
+	if (!x->min_cap || x->min_cap >= top)
+		return 0;
+	return DIV_ROUND_UP(top - x->min_cap, DCP_M4_XDR_THERMAL_STEP);
+}
+
+/* The thermal cap of cooling state @state, in nits; 0: none. */
+static inline u32 dcp_m4_xdr_thermal_cap(const struct dcp_m4_xdr *x, u32 state)
+{
+	u32 top = max(x->top, x->user_max), deepest = dcp_m4_xdr_max_state(x);
+
+	if (!state || !deepest)
+		return 0;
+	state = min(state, deepest);
+	if (state * DCP_M4_XDR_THERMAL_STEP >= top - x->min_cap)
+		return x->min_cap;
+	return top - state * DCP_M4_XDR_THERMAL_STEP;
+}
+
+/* The highest level a swap may ask for: the guard's, under the thermal cap. */
+static inline u32 dcp_m4_xdr_limit(const struct dcp_m4_xdr *x, u32 thermal_state)
+{
+	u32 cap = dcp_m4_xdr_cap(x), t = dcp_m4_xdr_thermal_cap(x, thermal_state);
+
+	return t ? min(cap, t) : cap;
+}
+
+/*
+ * After a swap that asked for panel level @level (0: none).  @ok: the swap
+ * was taken (A407 answered, its D590 in); @shown: its D590 said displayed;
+ * @us: A407 to D590.  Returns true when the cap changed.
+ */
+static inline bool dcp_m4_xdr_swap(struct dcp_m4_xdr *x, u32 level, bool ok,
+				   bool shown, u32 us)
+{
+	if (level <= x->taken) {
+		if (ok && shown)
+			x->shown_seen = true;
+		return false;
+	}
+	/* Only a ramp lets a swap ask for more than the level taken. */
+	if (x->state != DCP_M4_XDR_RAMP)
+		return false;
+	if (!ok) {
+		x->reason = DCP_M4_XDR_FAILED;
+		goto refused;
+	}
+	if (us > DCP_M4_XDR_STALL_US || (x->shown_seen && !shown)) {
+		x->good = 0;
+		if (++x->bad < DCP_M4_XDR_BAD_SWAPS)
+			return false;
+		x->reason = us > DCP_M4_XDR_STALL_US ? DCP_M4_XDR_STALLED :
+						       DCP_M4_XDR_NOT_SHOWN;
+		goto refused;
+	}
+	x->bad = 0;
+	x->best = max(x->best, level);
+	if (++x->good < DCP_M4_XDR_GOOD_SWAPS)
+		return false;
+	x->taken = x->best;
+	x->good = 0;
+	x->best = 0;
+	if (x->taken >= x->top) {
+		x->taken = x->top;
+		x->trying = 0;
+		x->state = DCP_M4_XDR_TRUSTED;
+	} else {
+		x->trying = min(x->top, x->taken + DCP_M4_XDR_STEP_NITS);
+	}
+	return true;
+
+refused:
+	x->state = DCP_M4_XDR_REFUSED;
+	x->trying = 0;
+	x->good = 0;
+	x->bad = 0;
+	x->best = 0;
+	x->reverts++;
+	return true;
+}
+
+/*
+ * Giving up an internal probe swap.  A swap that asks for a level above the
+ * one taken while the guard ramps, and that the firmware refuses (A407
+ * answered with an error status) or leaves without its D590 until the swap's
+ * deadline (A407 answered), is given up without ending the session, as
+ * dcpext gives up a swap whose D590 is missing: the guard refuses, every
+ * level goes back to the level taken and the next present re-sends the
+ * standing one.  Only when nothing else of it is outstanding (no session or
+ * transaction error, no call or callback open, the swap not completed) and
+ * with a slot free to keep its ID until its D590 comes late, so that the late
+ * D590 is dropped instead of failing the session.  Any other failure, and
+ * every failure of an ordinary swap, fails the session as before.
+ */
+#define DCP_M4_XDR_LOST		2U	/* given-up probe swaps still without their D590 */
+
+enum dcp_m4_xdr_give_up {
+	DCP_M4_XDR_KEEP_NONE,		/* not given up: the session fails */
+	DCP_M4_XDR_KEEP_STALLED,	/* A407 answered, no D590 by the deadline */
+	DCP_M4_XDR_KEEP_REFUSED,	/* A407 answered with an error status */
+};
+
+struct dcp_m4_xdr_lost {
+	u32 id[DCP_M4_XDR_LOST];	/* 0: a free slot */
+	u32 given_up, late;		/* probes given up; late D590s dropped */
+};
+
+/* How a swap ended, for dcp_m4_xdr_give_up(). */
+struct dcp_m4_xdr_end {
+	u32 id;		/* its ID (0: A406 gave none) */
+	int error;	/* what the swap returned */
+	bool probe;	/* it asked for a level above the one taken */
+	bool quiet;	/* no session or transaction error, no call or callback open */
+	bool replied;	/* A407 answered with status 0 */
+	bool refused;	/* A407 answered with an error status */
+	bool completed;	/* its D590 came */
+};
+
+/* The slot of @id among the given-up swaps (0: a free one), or -1. */
+static inline int dcp_m4_xdr_lost_find(const struct dcp_m4_xdr_lost *l, u32 id)
+{
+	for (unsigned int i = 0; i < DCP_M4_XDR_LOST; i++)
+		if (l->id[i] == id)
+			return i;
+	return -1;
+}
+
+/* Whether the swap that ended so is given up, and how. */
+static inline enum dcp_m4_xdr_give_up
+dcp_m4_xdr_give_up(const struct dcp_m4_xdr_lost *l, const struct dcp_m4_xdr_end *e)
+{
+	if (!e->probe || !e->quiet || !e->id || e->completed)
+		return DCP_M4_XDR_KEEP_NONE;
+	/* Its ID kept already (two D590s could not be told apart), or no slot. */
+	if (dcp_m4_xdr_lost_find(l, e->id) >= 0 || dcp_m4_xdr_lost_find(l, 0) < 0)
+		return DCP_M4_XDR_KEEP_NONE;
+	if (e->refused && !e->replied && e->error == -EPROTO)
+		return DCP_M4_XDR_KEEP_REFUSED;
+	if (e->replied && !e->refused && e->error == -ETIMEDOUT)
+		return DCP_M4_XDR_KEEP_STALLED;
+	return DCP_M4_XDR_KEEP_NONE;
+}
+
+/* Keep the ID of a swap given up; false with no slot (or no ID). */
+static inline bool dcp_m4_xdr_lost_add(struct dcp_m4_xdr_lost *l, u32 id)
+{
+	int slot = id ? dcp_m4_xdr_lost_find(l, 0) : -1;
+
+	if (slot < 0)
+		return false;
+	l->id[slot] = id;
+	l->given_up++;
+	return true;
+}
+
+/* The D590 of swap @id: true, and its ID forgotten, if that swap was given up. */
+static inline bool dcp_m4_xdr_lost_drop(struct dcp_m4_xdr_lost *l, u32 id)
+{
+	int slot = id ? dcp_m4_xdr_lost_find(l, id) : -1;
+
+	if (slot < 0)
+		return false;
+	l->id[slot] = 0;
+	l->late++;
+	return true;
+}
+
+static inline const char *dcp_m4_xdr_give_up_name(enum dcp_m4_xdr_give_up how)
+{
+	switch (how) {
+	case DCP_M4_XDR_KEEP_STALLED:
+		return "left without its D590";
+	case DCP_M4_XDR_KEEP_REFUSED:
+		return "refused";
+	default:
+		return "none";
+	}
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-panel-adt-test.c b/drivers/gpu/drm/apple/dcp-panel-adt-test.c
new file mode 100644
index 0000000000..1cc9309214
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-panel-adt-test.c
@@ -0,0 +1,261 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/*
+ * The raw-ADT panel parser on synthetic trees in m1n1's src/adt.h layout:
+ * the /product colour target only with a valid version-1 calibration matrix,
+ * the /backlight EDR headroom, and malformed trees refused without touching
+ * the result.  No captured device tree is used.
+ */
+
+#include <kunit/test.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "dcp-panel-adt.h"
+
+#define ADT_Q24_ONE	(1U << 24)
+
+struct adt_buf {
+	u8 data[1024];
+	size_t len;
+};
+
+static void adt_node(struct adt_buf *b, u32 props, u32 children)
+{
+	put_unaligned_le32(props, b->data + b->len);
+	put_unaligned_le32(children, b->data + b->len + 4);
+	b->len += 8;
+}
+
+static void adt_prop(struct adt_buf *b, const char *name, const void *value, u32 size)
+{
+	memset(b->data + b->len, 0, 36 + ALIGN(size, 4));
+	strscpy((char *)b->data + b->len, name, 32);
+	put_unaligned_le32(size, b->data + b->len + 32);
+	memcpy(b->data + b->len + 36, value, size);
+	b->len += 36 + ALIGN(size, 4);
+}
+
+static void adt_name(struct adt_buf *b, const char *name)
+{
+	adt_prop(b, "name", name, strlen(name) + 1);
+}
+
+static void adt_u32(struct adt_buf *b, const char *name, u32 value)
+{
+	u8 v[4];
+
+	put_unaligned_le32(value, v);
+	adt_prop(b, name, v, sizeof(v));
+}
+
+/* A version-@version matrix: the identity, or rows of [1 0 0] if @singular. */
+static void adt_matrix(struct adt_buf *b, u32 version, bool singular)
+{
+	u8 m[40] = {};
+
+	put_unaligned_le32(version, m);
+	for (unsigned int i = 0; i < 3; i++)
+		put_unaligned_le32(ADT_Q24_ONE, m + 4 + 4 * (singular ? 3 * i : 4 * i));
+	adt_prop(b, "primary-calibration-matrix", m, sizeof(m));
+}
+
+struct adt_spec {
+	const char *gamut;	/* NULL: no artwork-display-gamut */
+	int matrix;		/* 0: none, else the matrix version */
+	bool singular;
+	u32 headroom;		/* 0: no EDRPotentialHeadroom */
+	u32 lmax;		/* 0: no LmaxProduct */
+	u32 aurora;		/* 0: no supports-aurora, else its value */
+	u32 aurora_nits;	/* 0: no aurora-maximum-nits, else binary32 bits */
+	u32 min_cap;		/* 0: no thermal-mitigation-min-cap, else 16.16 */
+	bool gamut_in_child;	/* the target one level too deep */
+};
+
+/* / { product { ... } backlight { ... } } */
+static size_t adt_build(struct adt_buf *b, const struct adt_spec *s)
+{
+	u32 props = 1 + !!s->gamut + !!s->matrix;
+
+	b->len = 0;
+	adt_node(b, 1, 2);
+	adt_name(b, "device-tree");
+
+	if (s->gamut_in_child) {
+		adt_node(b, 1, 1);
+		adt_name(b, "product");
+		adt_node(b, props, 0);
+		adt_name(b, "product");
+	} else {
+		adt_node(b, props, 0);
+		adt_name(b, "product");
+	}
+	if (s->gamut)
+		adt_prop(b, "artwork-display-gamut", s->gamut, strlen(s->gamut) + 1);
+	if (s->matrix)
+		adt_matrix(b, s->matrix, s->singular);
+
+	adt_node(b, 1 + !!s->headroom + !!s->lmax + !!s->aurora + !!s->aurora_nits +
+		 !!s->min_cap, 0);
+	adt_name(b, "backlight");
+	if (s->headroom)
+		adt_u32(b, "EDRPotentialHeadroom", s->headroom);
+	if (s->lmax)
+		adt_u32(b, "LmaxProduct", s->lmax);
+	if (s->aurora)
+		adt_u32(b, "supports-aurora", s->aurora);
+	if (s->aurora_nits)
+		adt_u32(b, "aurora-maximum-nits", s->aurora_nits);
+	if (s->min_cap)
+		adt_u32(b, "thermal-mitigation-min-cap", s->min_cap);
+	return b->len;
+}
+
+static void adt_parse(struct kunit *test, const struct adt_spec *s,
+		      struct dcp_panel_adt *panel)
+{
+	struct adt_buf *b = kunit_kzalloc(test, sizeof(*b), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, b);
+	*panel = (struct dcp_panel_adt) {};
+	KUNIT_ASSERT_EQ(test, dcp_panel_adt_parse(b->data, adt_build(b, s), panel), 0);
+}
+
+static void panel_adt_p3_and_headroom(struct kunit *test)
+{
+	const struct adt_spec s = { .gamut = "P3", .matrix = 1, .headroom = 16 << 16 };
+	struct dcp_panel_adt panel;
+
+	adt_parse(test, &s, &panel);
+	KUNIT_EXPECT_EQ(test, panel.gamut, DCP_PANEL_GAMUT_DISPLAY_P3);
+	KUNIT_EXPECT_EQ(test, panel.edr_potential_headroom, 16U << 16);
+}
+
+/* The J604 /backlight values: a 1600 nit peak at a potential headroom of 16. */
+static void panel_adt_peak(struct kunit *test)
+{
+	const struct adt_spec s = { .gamut = "P3", .matrix = 1, .headroom = 16 << 16,
+				    .lmax = 1600 << 16 };
+	const struct adt_spec none = { .gamut = "P3", .matrix = 1 };
+	struct dcp_panel_adt panel;
+
+	adt_parse(test, &s, &panel);
+	KUNIT_EXPECT_EQ(test, panel.lmax_product, 1600U << 16);
+	KUNIT_EXPECT_EQ(test, panel.edr_potential_headroom, 16U << 16);
+	adt_parse(test, &none, &panel);
+	KUNIT_EXPECT_EQ(test, panel.lmax_product, 0U);
+}
+
+/* The J604 value 0x447a7c7c is 1001.94 nits; without supports-aurora none. */
+static void panel_adt_aurora_maximum(struct kunit *test)
+{
+	const struct adt_spec s = { .gamut = "P3", .matrix = 1, .aurora = 1,
+				    .aurora_nits = 0x447a7c7c };
+	const struct adt_spec off = { .gamut = "P3", .matrix = 1, .aurora_nits = 0x447a7c7c };
+	const struct adt_spec bad = { .gamut = "P3", .matrix = 1, .aurora = 1,
+				      .aurora_nits = 0xc47a0000 };
+	struct dcp_panel_adt panel;
+
+	adt_parse(test, &s, &panel);
+	KUNIT_EXPECT_EQ(test, panel.aurora_max_nits, 1001U);
+	adt_parse(test, &off, &panel);
+	KUNIT_EXPECT_EQ(test, panel.aurora_max_nits, 0U);
+	/* A negative value is not a ceiling. */
+	adt_parse(test, &bad, &panel);
+	KUNIT_EXPECT_EQ(test, panel.aurora_max_nits, 0U);
+}
+
+/* The J604 thermal-mitigation-min-cap, 300 nits in 16.16; absent: 0. */
+static void panel_adt_thermal_min_cap(struct kunit *test)
+{
+	const struct adt_spec s = { .gamut = "P3", .matrix = 1, .lmax = 1600 << 16,
+				    .min_cap = 300 << 16 };
+	const struct adt_spec none = { .gamut = "P3", .matrix = 1, .lmax = 1600 << 16 };
+	struct dcp_panel_adt panel;
+
+	adt_parse(test, &s, &panel);
+	KUNIT_EXPECT_EQ(test, panel.thermal_min_cap, 300U);
+	KUNIT_EXPECT_EQ(test, panel.lmax_product, 1600U << 16);
+	adt_parse(test, &none, &panel);
+	KUNIT_EXPECT_EQ(test, panel.thermal_min_cap, 0U);
+}
+
+static void panel_adt_srgb(struct kunit *test)
+{
+	const struct adt_spec s = { .gamut = "sRGB", .matrix = 1 };
+	struct dcp_panel_adt panel;
+
+	adt_parse(test, &s, &panel);
+	KUNIT_EXPECT_EQ(test, panel.gamut, DCP_PANEL_GAMUT_SRGB);
+	KUNIT_EXPECT_EQ(test, panel.edr_potential_headroom, 0U);
+}
+
+/* The named target counts only with its factory matrix as provenance. */
+static void panel_adt_target_needs_a_valid_v1_matrix(struct kunit *test)
+{
+	const struct adt_spec cases[] = {
+		{ .gamut = "P3", .matrix = 0, .headroom = 16 << 16 },
+		{ .gamut = "P3", .matrix = 2, .headroom = 16 << 16 },
+		{ .gamut = "P3", .matrix = 1, .singular = true, .headroom = 16 << 16 },
+	};
+	struct dcp_panel_adt panel;
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(cases); i++) {
+		adt_parse(test, &cases[i], &panel);
+		KUNIT_EXPECT_EQ_MSG(test, panel.gamut, DCP_PANEL_GAMUT_UNSPECIFIED, "case %u", i);
+		/* The headroom does not depend on the colour target. */
+		KUNIT_EXPECT_EQ_MSG(test, panel.edr_potential_headroom, 16U << 16, "case %u", i);
+	}
+}
+
+static void panel_adt_unknown_or_misplaced_target(struct kunit *test)
+{
+	const struct adt_spec unknown = { .gamut = "XYZ", .matrix = 1 };
+	const struct adt_spec deep = { .gamut = "P3", .matrix = 1, .gamut_in_child = true };
+	struct dcp_panel_adt panel;
+
+	adt_parse(test, &unknown, &panel);
+	KUNIT_EXPECT_EQ(test, panel.gamut, DCP_PANEL_GAMUT_UNSPECIFIED);
+	adt_parse(test, &deep, &panel);
+	KUNIT_EXPECT_EQ(test, panel.gamut, DCP_PANEL_GAMUT_UNSPECIFIED);
+}
+
+/* A cut-off or oversized tree is refused and leaves the result alone. */
+static void panel_adt_malformed_tree(struct kunit *test)
+{
+	const struct adt_spec s = { .gamut = "P3", .matrix = 1, .headroom = 16 << 16 };
+	struct adt_buf *b = kunit_kzalloc(test, sizeof(*b), GFP_KERNEL);
+	struct dcp_panel_adt panel = { .gamut = DCP_PANEL_GAMUT_SRGB, .edr_potential_headroom = 7 };
+	size_t len;
+
+	KUNIT_ASSERT_NOT_NULL(test, b);
+	len = adt_build(b, &s);
+	KUNIT_EXPECT_LT(test, dcp_panel_adt_parse(b->data, len - 1, &panel), 0);
+	KUNIT_EXPECT_LT(test, dcp_panel_adt_parse(b->data, 7, &panel), 0);
+	KUNIT_EXPECT_EQ(test, dcp_panel_adt_parse(NULL, len, &panel), -EINVAL);
+	/* A child count the data cannot hold. */
+	put_unaligned_le32(5000, b->data + 4);
+	KUNIT_EXPECT_LT(test, dcp_panel_adt_parse(b->data, len, &panel), 0);
+	KUNIT_EXPECT_EQ(test, panel.gamut, DCP_PANEL_GAMUT_SRGB);
+	KUNIT_EXPECT_EQ(test, panel.edr_potential_headroom, 7U);
+}
+
+static struct kunit_case panel_adt_cases[] = {
+	KUNIT_CASE(panel_adt_p3_and_headroom),
+	KUNIT_CASE(panel_adt_peak),
+	KUNIT_CASE(panel_adt_aurora_maximum),
+	KUNIT_CASE(panel_adt_thermal_min_cap),
+	KUNIT_CASE(panel_adt_srgb),
+	KUNIT_CASE(panel_adt_target_needs_a_valid_v1_matrix),
+	KUNIT_CASE(panel_adt_unknown_or_misplaced_target),
+	KUNIT_CASE(panel_adt_malformed_tree),
+	{}
+};
+
+static struct kunit_suite panel_adt_suite = {
+	.name = "apple-dcp-panel-adt",
+	.test_cases = panel_adt_cases,
+};
+
+kunit_test_suite(panel_adt_suite);
diff --git a/drivers/gpu/drm/apple/dcp-panel-adt.c b/drivers/gpu/drm/apple/dcp-panel-adt.c
