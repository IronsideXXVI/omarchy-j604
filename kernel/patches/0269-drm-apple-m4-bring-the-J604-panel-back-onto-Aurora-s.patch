+/*
+ * int_async_flip. The internal panel's present returns once the firmware has
+ * accepted its swap (A407); the swap waits in r->int_fl, at most one, until
+ * its D590, which puts its frame on screen and sends the flip event. The
+ * previous frame stays dcp->active_fb, referenced, until then: it is scanned
+ * out until the D590, and DRM hands it back to the compositor with the flip
+ * event, so it is handed back only once off screen. Every other host call
+ * first waits for that D590 (dcp_m4_int_settle()), so the firmware never has
+ * two internal swaps open, as with the synchronous path.
+ */
+
+/* Framebuffers retired by a D590, put outside dcp->lock. */
+static void iomfb_m4_retire_work(struct work_struct *work)
+{
+	struct iomfb_m4 *dcp = container_of(work, struct iomfb_m4, retire_work);
+	struct drm_framebuffer *q[ARRAY_SIZE(dcp->retire_q)];
+	unsigned int n, i;
+
+	spin_lock_irq(&dcp->retire_lock);
+	n = dcp->retire_n;
+	memcpy(q, dcp->retire_q, n * sizeof(*q));
+	dcp->retire_n = 0;
+	spin_unlock_irq(&dcp->retire_lock);
+	for (i = 0; i < n; i++)
+		drm_framebuffer_put(q[i]);
+}
+
+/* False when the queue is full: the caller keeps the reference. */
+static bool iomfb_m4_retire(struct iomfb_m4 *dcp, struct drm_framebuffer *fb)
+{
+	bool queued = true;
+
+	if (!fb)
+		return true;
+	spin_lock_irq(&dcp->retire_lock);
+	if (dcp->retire_n < ARRAY_SIZE(dcp->retire_q))
+		dcp->retire_q[dcp->retire_n++] = fb;
+	else
+		queued = false;
+	spin_unlock_irq(&dcp->retire_lock);
+	if (queued)
+		schedule_work(&dcp->retire_work);
+	else
+		dev_warn_ratelimited(dcp->dev, "retire queue full: a framebuffer kept until teardown\n");
+	return queued;
+}
