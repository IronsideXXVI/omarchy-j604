--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-panel-edid-test.c
@@ -0,0 +1,527 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/*
+ * The built-in panel's EDID, read back with the DRM EDID helpers: the make,
+ * product, model year and native timing come from the panel's compatible and
+ * the model table; the base block holds the panel's geometry at 60 Hz with P3
+ * colour and gamma 2.2, the DisplayID extension the 120 Hz timing; an update
+ * publishes both blocks on the connector and adds no mode.
+ */
+
+#include <kunit/test.h>
+#include <linux/unaligned.h>
+#include <linux/errno.h>
+#include <linux/hdmi.h>
+#include <linux/string.h>
+
+#include <drm/drm_atomic_state_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_kunit_helpers.h>
+#include <drm/drm_property.h>
+
+#include "dcp-panel-edid.h"
+
+#define J516_W_MM 346
+#define J516_H_MM 216
+
+static void panel_id_j516(struct kunit *test, struct dcp_panel_id *id)
+{
+	KUNIT_ASSERT_EQ(test, dcp_panel_id_from_compatible(id, "apple,panel-j516"), 0);
+}
+
+static void panel_id_from_compatible(struct kunit *test)
+{
+	struct dcp_panel_id id;
+
+	panel_id_j516(test, &id);
+	KUNIT_EXPECT_STREQ(test, id.vendor, "APP");
+	KUNIT_EXPECT_STREQ(test, id.name, "J516");
+	KUNIT_EXPECT_EQ(test, id.model_year, 2023);
+	KUNIT_EXPECT_EQ(test, id.timing.clock_khz, 1042130);
+	KUNIT_EXPECT_EQ(test, id.timing.vtotal, 2456);
+	/* A model without a known year and timing gets none, and no EDID. */
+	KUNIT_ASSERT_EQ(test, dcp_panel_id_from_compatible(&id, "apple,panel-j999"), 0);
+	KUNIT_EXPECT_EQ(test, id.model_year, 0);
+	KUNIT_EXPECT_EQ(test, id.timing.clock_khz, 0);
+}
+
+static void panel_id_needs_a_model_and_a_known_vendor(struct kunit *test)
+{
+	struct dcp_panel_id id;
+
+	KUNIT_EXPECT_EQ(test, dcp_panel_id_from_compatible(&id, "apple,panel"), -EINVAL);
+	KUNIT_EXPECT_EQ(test, dcp_panel_id_from_compatible(&id, "apple,panel-"), -EINVAL);
+	KUNIT_EXPECT_EQ(test, dcp_panel_id_from_compatible(&id, "panel-j516"), -EINVAL);
+	KUNIT_EXPECT_EQ(test, dcp_panel_id_from_compatible(&id, "acme,panel-j516"), -ENOENT);
+	KUNIT_EXPECT_EQ(test, dcp_panel_id_from_compatible(&id, "apple,panel-j516 x"), -EINVAL);
+	KUNIT_EXPECT_EQ(test, dcp_panel_id_from_compatible(&id,
+							   "apple,panel-j5160000000000"),
+			-EINVAL);
+}
+
+static const struct drm_edid *panel_edid_j516(struct kunit *test,
+					      u8 e[DCP_PANEL_EDID_BLOCKS * EDID_LENGTH])
+{
+	struct dcp_panel_id id;
+	const struct drm_edid *edid;
+
+	panel_id_j516(test, &id);
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	edid = drm_edid_alloc(e, DCP_PANEL_EDID_BLOCKS * EDID_LENGTH);
+	KUNIT_ASSERT_NOT_NULL(test, edid);
+	return edid;
+}
+
+static u8 sum(const u8 *p, size_t len)
+{
+	u8 s = 0;
+
+	while (len--)
+		s += *p++;
+	return s;
+}
+
+static void panel_edid_parses_with_make_product_and_size(struct kunit *test)
+{
+	struct drm_edid_product_id product;
+	u8 e[DCP_PANEL_EDID_BLOCKS * EDID_LENGTH];
+	const struct drm_edid *edid = panel_edid_j516(test, e);
+	const struct edid *raw;
+	char vendor[4], name[14];
+
+	KUNIT_EXPECT_TRUE(test, drm_edid_valid(edid));
+	drm_edid_get_product_id(edid, &product);
+	drm_edid_decode_mfg_id(be16_to_cpu(product.manufacturer_name), vendor);
+	KUNIT_EXPECT_STREQ(test, vendor, "APP");
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(product.product_code), 0);
+	KUNIT_EXPECT_EQ(test, le32_to_cpu(product.serial_number), 0);
+
+	raw = drm_edid_raw(edid);
+	KUNIT_ASSERT_NOT_NULL(test, raw);
+	drm_edid_get_monitor_name(raw, name, sizeof(name));
+	KUNIT_EXPECT_STREQ(test, name, "J516");
+	/* The connector's size (the firmware's), in whole centimetres. */
+	KUNIT_EXPECT_EQ(test, raw->width_cm, 35);
+	KUNIT_EXPECT_EQ(test, raw->height_cm, 22);
+	/* Gamma 2.2, not 1.00 (0) and not "in an extension" (0xff). */
+	KUNIT_EXPECT_EQ(test, raw->gamma, 0x78);
+	/* Model year 2023: week 0xff, year 2023 - 1990. */
+	KUNIT_EXPECT_EQ(test, raw->mfg_week, 0xff);
+	KUNIT_EXPECT_EQ(test, raw->mfg_year, 33);
+	/* P3 red (0.680, 0.320) and the D65 white point (0.3127, 0.3290), 10-bit. */
+	KUNIT_EXPECT_EQ(test, raw->red_x << 2 | raw->red_green_lo >> 6, 696);
+	KUNIT_EXPECT_EQ(test, raw->red_y << 2 | (raw->red_green_lo >> 4 & 3), 328);
+	KUNIT_EXPECT_EQ(test, raw->white_x << 2 | (raw->blue_white_lo >> 2 & 3), 320);
+	KUNIT_EXPECT_EQ(test, raw->white_y << 2 | (raw->blue_white_lo & 3), 337);
+	/* One extension; both blocks sum to 0. */
+	KUNIT_EXPECT_EQ(test, raw->extensions, 1);
+	KUNIT_EXPECT_EQ(test, sum(e, EDID_LENGTH), 0);
+	KUNIT_EXPECT_EQ(test, sum(e + EDID_LENGTH, EDID_LENGTH), 0);
+	drm_edid_free(edid);
+}
+
+/*
+ * The base block's first descriptor is the panel's geometry at 60 Hz (its 120 Hz
+ * clock does not fit the 16-bit field); the DisplayID extension holds the real
+ * 120 Hz timing as its preferred Type VII timing.
+ */
+static void panel_edid_timings_are_the_panels(struct kunit *test)
+{
+	u8 e[DCP_PANEL_EDID_BLOCKS * EDID_LENGTH];
+	const struct drm_edid *edid = panel_edid_j516(test, e);
+	const struct edid *raw = drm_edid_raw(edid);
+	const struct detailed_timing *d = &raw->detailed_timings[0];
+	const struct detailed_pixel_timing *pt = &d->data.pixel_data;
+	const u8 *ext = e + EDID_LENGTH, *section = ext + 1, *t;
+	unsigned int i, names = 0;
+
+	/* 3536 x 2456 x 60 Hz = 521.06 MHz, in 10 kHz. */
+	KUNIT_EXPECT_EQ(test, le16_to_cpu(d->pixel_clock), 52106);
+	KUNIT_EXPECT_EQ(test, pt->hactive_lo | (pt->hactive_hblank_hi >> 4) << 8, 3456);
+	KUNIT_EXPECT_EQ(test, pt->hblank_lo | (pt->hactive_hblank_hi & 0xf) << 8, 80);
+	KUNIT_EXPECT_EQ(test, pt->vactive_lo | (pt->vactive_vblank_hi >> 4) << 8, 2234);
+	KUNIT_EXPECT_EQ(test, pt->vblank_lo | (pt->vactive_vblank_hi & 0xf) << 8, 222);
+	KUNIT_EXPECT_EQ(test, pt->hsync_offset_lo, 8);
+	KUNIT_EXPECT_EQ(test, pt->hsync_pulse_width_lo, 32);
+	/* The front porch at the field's 63, the sync width the panel's 8. */
+	KUNIT_EXPECT_EQ(test, (pt->vsync_offset_pulse_width_lo >> 4) |
+			(pt->hsync_vsync_offset_pulse_width_hi >> 2 & 3) << 4, 63);
+	KUNIT_EXPECT_EQ(test, pt->vsync_offset_pulse_width_lo & 0xf, 8);
+	KUNIT_EXPECT_EQ(test, pt->width_mm_lo | (pt->width_height_mm_hi >> 4) << 8, J516_W_MM);
+	KUNIT_EXPECT_EQ(test, pt->height_mm_lo | (pt->width_height_mm_hi & 0xf) << 8, J516_H_MM);
+	/* It is not the preferred mode with its refresh rate. */
+	KUNIT_EXPECT_EQ(test, raw->features & DRM_EDID_FEATURE_PREFERRED_TIMING, 0);
+	for (i = 1; i < ARRAY_SIZE(raw->detailed_timings); i++) {
+		const struct detailed_timing *o = &raw->detailed_timings[i];
+
+		KUNIT_EXPECT_EQ(test, le16_to_cpu(o->pixel_clock), 0);
+		KUNIT_EXPECT_NE(test, o->data.other_data.type, EDID_DETAIL_MONITOR_SERIAL);
+		KUNIT_EXPECT_NE(test, o->data.other_data.type, EDID_DETAIL_MONITOR_RANGE);
+		names += o->data.other_data.type == EDID_DETAIL_MONITOR_NAME;
+	}
+	KUNIT_EXPECT_EQ(test, names, 1);
+	for (i = 0; i < sizeof(raw->established_timings); i++)
+		KUNIT_EXPECT_EQ(test, ((const u8 *)&raw->established_timings)[i], 0);
+
+	/* DisplayID 2.0, generic display, Display Parameters then one Type VII timing. */
+	KUNIT_EXPECT_EQ(test, ext[0], 0x70);
+	KUNIT_EXPECT_EQ(test, section[0], 0x20);
+	KUNIT_EXPECT_EQ(test, section[2], 0x02);
+	KUNIT_ASSERT_EQ(test, section[1], 3 + 29 + 3 + 20);
+	KUNIT_EXPECT_EQ(test, sum(section, 4 + section[1] + 1), 0);
+	KUNIT_EXPECT_EQ(test, section[4], 0x21);
+	KUNIT_EXPECT_EQ(test, section[6], 29);
+	/* Image size in 0.1 mm, the native pixels, gamma 2.2. */
+	KUNIT_EXPECT_EQ(test, section[7] | section[8] << 8, J516_W_MM * 10);
+	KUNIT_EXPECT_EQ(test, section[9] | section[10] << 8, J516_H_MM * 10);
+	KUNIT_EXPECT_EQ(test, section[11] | section[12] << 8, 3456);
+	KUNIT_EXPECT_EQ(test, section[13] | section[14] << 8, 2234);
+	KUNIT_EXPECT_EQ(test, section[7 + 28], 0x78);
+	t = section + 4 + 3 + 29;
+	KUNIT_EXPECT_EQ(test, t[0], 0x22);
+	KUNIT_EXPECT_EQ(test, t[2], 20);
+	t += 3;
+	/* 1042130 kHz, preferred, and the DCP mode line's porches (each minus one). */
+	KUNIT_EXPECT_EQ(test, t[0] | t[1] << 8 | t[2] << 16, 1042130 - 1);
+	KUNIT_EXPECT_EQ(test, t[3] & 0x80, 0x80);
+	KUNIT_EXPECT_EQ(test, t[4] | t[5] << 8, 3456 - 1);
+	KUNIT_EXPECT_EQ(test, t[6] | t[7] << 8, 3536 - 3456 - 1);
+	KUNIT_EXPECT_EQ(test, (t[8] | t[9] << 8) & 0x7fff, 3464 - 3456 - 1);
+	KUNIT_EXPECT_EQ(test, t[10] | t[11] << 8, 3496 - 3464 - 1);
+	KUNIT_EXPECT_EQ(test, t[12] | t[13] << 8, 2234 - 1);
+	KUNIT_EXPECT_EQ(test, t[14] | t[15] << 8, 2456 - 2234 - 1);
+	KUNIT_EXPECT_EQ(test, (t[16] | t[17] << 8) & 0x7fff, 2352 - 2234 - 1);
+	KUNIT_EXPECT_EQ(test, t[18] | t[19] << 8, 2360 - 2352 - 1);
+	drm_edid_free(edid);
+}
+
+static void panel_edid_refuses_a_size_it_cannot_hold(struct kunit *test)
+{
+	u8 e[DCP_PANEL_EDID_BLOCKS * EDID_LENGTH];
+	struct dcp_panel_id id;
+
+	panel_id_j516(test, &id);
+	KUNIT_EXPECT_EQ(test, dcp_panel_edid_build(&id, 0, J516_H_MM, e), -EINVAL);
+	KUNIT_EXPECT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, 2560, e), -EINVAL);
+	id.model_year = 2005;
+	KUNIT_EXPECT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), -EINVAL);
+	id.model_year = 2023;
+	id.timing.clock_khz = 0;
+	KUNIT_EXPECT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), -EINVAL);
+	panel_id_j516(test, &id);
+	id.vendor[0] = '\0';
+	KUNIT_EXPECT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), -EINVAL);
+}
+
+struct panel_edid_test {
+	struct drm_device drm;
+	struct drm_connector connector;
+};
+
+/* The DRM KUnit device is atomic: a connector needs its state helpers. */
+static const struct drm_connector_funcs panel_edid_connector_funcs = {
+	.reset = drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+static void panel_edid_update_publishes_the_block(struct kunit *test)
+{
+	struct panel_edid_test *t;
+	struct drm_connector *connector;
+	struct dcp_panel_id id;
+	struct device *dev;
+	int ret;
+
+	dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	t = drm_kunit_helper_alloc_drm_device(test, dev, struct panel_edid_test, drm,
+					      DRIVER_MODESET);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, t);
+	connector = &t->connector;
+	ret = drmm_connector_init(&t->drm, connector, &panel_edid_connector_funcs,
+				  DRM_MODE_CONNECTOR_eDP, NULL);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	panel_id_j516(test, &id);
+	mutex_lock(&t->drm.mode_config.mutex);
+	ret = dcp_panel_edid_update(connector, &id, J516_W_MM, J516_H_MM);
+	mutex_unlock(&t->drm.mode_config.mutex);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	/* The update sets 350x220 from the block; dcp_get_modes() restores the mm. */
+	KUNIT_EXPECT_EQ(test, connector->display_info.width_mm, 350);
+	KUNIT_EXPECT_EQ(test, connector->display_info.height_mm, 220);
+	KUNIT_ASSERT_NOT_NULL(test, connector->edid_blob_ptr);
+	KUNIT_EXPECT_EQ(test, connector->edid_blob_ptr->length, 2 * EDID_LENGTH);
+	/* The update adds no mode: the modes stay the firmware's. */
+	KUNIT_EXPECT_TRUE(test, list_empty(&connector->probed_modes));
+}
+
+/*
+ * An HDR panel (T8132 panel_edr): a third, CTA-861 block with BT.2020 RGB and
+ * HDR static metadata for SDR and PQ, the peak as maximum luminance.
+ */
+static void panel_edid_hdr_block(struct kunit *test)
+{
+	u8 *e = kunit_kzalloc(test, DCP_PANEL_EDID_HDR_BLOCKS * EDID_LENGTH, GFP_KERNEL);
+	const u8 *cta = e + 2 * EDID_LENGTH;
+	const struct drm_edid *edid;
+	struct dcp_panel_id id;
+
+	KUNIT_ASSERT_NOT_NULL(test, e);
+	panel_id_j516(test, &id);
+	KUNIT_EXPECT_EQ(test, dcp_panel_edid_build_hdr(&id, J516_W_MM, J516_H_MM, e), -EINVAL);
+	id.hdr_max_nits = 1600;
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build_hdr(&id, J516_W_MM, J516_H_MM, e), 0);
+	edid = drm_edid_alloc(e, DCP_PANEL_EDID_HDR_BLOCKS * EDID_LENGTH);
+	KUNIT_ASSERT_NOT_NULL(test, edid);
+	KUNIT_EXPECT_TRUE(test, drm_edid_valid(edid));
+	drm_edid_free(edid);
+	KUNIT_EXPECT_EQ(test, e[126], 2);
+	for (unsigned int i = 0; i < DCP_PANEL_EDID_HDR_BLOCKS; i++)
+		KUNIT_EXPECT_EQ(test, sum(e + i * EDID_LENGTH, EDID_LENGTH), 0);
+	KUNIT_EXPECT_EQ(test, cta[0], 0x02);
+	KUNIT_EXPECT_EQ(test, cta[1], 3);
+	/* Colorimetry: BT2020_RGB. */
+	KUNIT_EXPECT_EQ(test, cta[4], 0xe3);
+	KUNIT_EXPECT_EQ(test, cta[5], 0x05);
+	KUNIT_EXPECT_EQ(test, cta[6], 0x80);
+	/* HDR static metadata: SDR + ST 2084, type 1, 1600 nits = 50 x 2^(160 / 32). */
+	KUNIT_EXPECT_EQ(test, cta[8], 0xe6);
+	KUNIT_EXPECT_EQ(test, cta[9], 0x06);
+	KUNIT_EXPECT_EQ(test, cta[10], 0x05);
+	KUNIT_EXPECT_EQ(test, cta[11], 0x01);
+	KUNIT_EXPECT_EQ(test, cta[12], 160);
+	KUNIT_EXPECT_EQ(test, cta[13], 160);
+	KUNIT_EXPECT_EQ(test, cta[14], 0);
+	KUNIT_EXPECT_EQ(test, cta[2], 15);
+}
+
+/* The connector reads the HDR capability back from the published EDID. */
+static void panel_edid_update_publishes_hdr(struct kunit *test)
+{
+	struct panel_edid_test *t;
+	struct drm_connector *connector;
+	struct dcp_panel_id id;
+	struct device *dev;
+	int ret;
+
+	dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	t = drm_kunit_helper_alloc_drm_device(test, dev, struct panel_edid_test, drm,
+					      DRIVER_MODESET);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, t);
+	connector = &t->connector;
+	ret = drmm_connector_init(&t->drm, connector, &panel_edid_connector_funcs,
+				  DRM_MODE_CONNECTOR_eDP, NULL);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	panel_id_j516(test, &id);
+	id.hdr_max_nits = 1600;
+	mutex_lock(&t->drm.mode_config.mutex);
+	ret = dcp_panel_edid_update(connector, &id, J516_W_MM, J516_H_MM);
+	mutex_unlock(&t->drm.mode_config.mutex);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_NOT_NULL(test, connector->edid_blob_ptr);
+	KUNIT_EXPECT_EQ(test, connector->edid_blob_ptr->length, 3 * EDID_LENGTH);
+	KUNIT_EXPECT_TRUE(test, connector->display_info.hdr_sink_metadata.hdmi_type1.eotf &
+				BIT(HDMI_EOTF_SMPTE_ST2084));
+	KUNIT_EXPECT_EQ(test, connector->display_info.hdr_sink_metadata.hdmi_type1.max_cll, 160);
+	KUNIT_EXPECT_TRUE(test, list_empty(&connector->probed_modes));
+}
+
+/*
+ * A panel with a variable refresh rate (T8132 panel_vrr_min_hz): the third
+ * base descriptor is a "range limits only" Display Range Limits descriptor
+ * with the VRR range, and the base block says continuous frequency. A
+ * fixed-rate panel keeps the third descriptor unused. A half range is refused.
+ */
+static void panel_edid_vrr_range(struct kunit *test)
+{
+	u8 *e = kunit_kzalloc(test, DCP_PANEL_EDID_HDR_BLOCKS * EDID_LENGTH, GFP_KERNEL);
+	const struct edid *base = (const struct edid *)e;
+	const u8 *d = e + 0x36 + 2 * 18;
+	struct dcp_panel_id id;
+
+	KUNIT_ASSERT_NOT_NULL(test, e);
+	panel_id_j516(test, &id);
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	KUNIT_EXPECT_EQ(test, d[3], 0x10);
+	KUNIT_EXPECT_EQ(test, base->features & DRM_EDID_FEATURE_CONTINUOUS_FREQ, 0);
+
+	id.vrr_min_hz = 48;
+	KUNIT_EXPECT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), -EINVAL);
+	id.vrr_max_hz = 48;
+	KUNIT_EXPECT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), -EINVAL);
+	id.vrr_max_hz = 120;
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	KUNIT_EXPECT_EQ(test, sum(e, EDID_LENGTH), 0);
+	KUNIT_EXPECT_TRUE(test, base->features & DRM_EDID_FEATURE_CONTINUOUS_FREQ);
+	KUNIT_EXPECT_EQ(test, d[0] | d[1] | d[2], 0);
+	KUNIT_EXPECT_EQ(test, d[3], EDID_DETAIL_MONITOR_RANGE);
+	KUNIT_EXPECT_EQ(test, d[5], 48);
+	KUNIT_EXPECT_EQ(test, d[6], 120);
+	/* J516: 1042130 kHz, vtotal 2456: line rate 147.36 kHz at 60 Hz, 294.7 at 120. */
+	KUNIT_EXPECT_EQ(test, d[7], 147);
+	KUNIT_EXPECT_EQ(test, d[8], 295 - 255);
+	KUNIT_EXPECT_EQ(test, d[4], DRM_EDID_RANGE_OFFSET_MAX_HFREQ);
+	KUNIT_EXPECT_EQ(test, d[9], 105);
+	KUNIT_EXPECT_EQ(test, d[10], DRM_EDID_RANGE_LIMITS_ONLY_FLAG);
+	/* The HDR form carries the same base block. */
+	id.hdr_max_nits = 1600;
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build_hdr(&id, J516_W_MM, J516_H_MM, e), 0);
+	KUNIT_EXPECT_EQ(test, d[3], EDID_DETAIL_MONITOR_RANGE);
+	KUNIT_EXPECT_EQ(test, sum(e, EDID_LENGTH), 0);
+}
+
+/* The connector reads the VRR range back from the published EDID. */
+static void panel_edid_update_publishes_vrr_range(struct kunit *test)
+{
+	struct panel_edid_test *t;
+	struct drm_connector *connector;
+	struct dcp_panel_id id;
+	struct device *dev;
+	int ret;
+
+	dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	t = drm_kunit_helper_alloc_drm_device(test, dev, struct panel_edid_test, drm,
+					      DRIVER_MODESET);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, t);
+	connector = &t->connector;
+	ret = drmm_connector_init(&t->drm, connector, &panel_edid_connector_funcs,
+				  DRM_MODE_CONNECTOR_eDP, NULL);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	panel_id_j516(test, &id);
+	id.vrr_min_hz = 48;
+	id.vrr_max_hz = 120;
+	mutex_lock(&t->drm.mode_config.mutex);
+	ret = dcp_panel_edid_update(connector, &id, J516_W_MM, J516_H_MM);
+	mutex_unlock(&t->drm.mode_config.mutex);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, connector->display_info.monitor_range.min_vfreq, 48);
+	KUNIT_EXPECT_EQ(test, connector->display_info.monitor_range.max_vfreq, 120);
+	KUNIT_EXPECT_TRUE(test, list_empty(&connector->probed_modes));
+
+	/* The J604's 24-120 Hz. */
+	id.vrr_min_hz = 24;
+	mutex_lock(&t->drm.mode_config.mutex);
+	ret = dcp_panel_edid_update(connector, &id, J516_W_MM, J516_H_MM);
+	mutex_unlock(&t->drm.mode_config.mutex);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, connector->display_info.monitor_range.min_vfreq, 24);
+	KUNIT_EXPECT_EQ(test, connector->display_info.monitor_range.max_vfreq, 120);
+}
+
+/* The DisplayID display parameters: binary16 luminances and the native depth. */
+static void panel_edid_luminance_and_depth(struct kunit *test)
+{
+	static const struct { u16 nits; u16 half; } t[] = {
+		{ 1, 0x3c00 }, { 600, 0x60b0 }, { 1000, 0x63d0 }, { 1600, 0x6640 },
+		{ 2047, 0x67ff }, { 4095, 0x6c00 }, { 65504, 0x7bff }, { 0, 0 },
+	};
+	u8 *e = kunit_kzalloc(test, DCP_PANEL_EDID_HDR_BLOCKS * EDID_LENGTH, GFP_KERNEL);
+	const struct edid *base = (const struct edid *)e;
+	/* Extension tag, section header (4), block header (3): parameters at 136. */
+	const u8 *p = e + EDID_LENGTH + 8;
+	struct dcp_panel_id id;
+
+	KUNIT_ASSERT_NOT_NULL(test, e);
+	panel_id_j516(test, &id);
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	/* Nothing known: as before. */
+	KUNIT_EXPECT_EQ(test, base->input, DRM_EDID_INPUT_DIGITAL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(p + 21) | get_unaligned_le16(p + 23), 0);
+	KUNIT_EXPECT_EQ(test, p[27], 0x10);
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(t); i++) {
+		id.full_nits = t[i].nits;
+		id.peak_nits = t[i].nits;
+		KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+		KUNIT_EXPECT_EQ(test, get_unaligned_le16(p + 21), t[i].half);
+		KUNIT_EXPECT_EQ(test, get_unaligned_le16(p + 23), t[i].half);
+	}
+	/* The J604: 1000 over the full screen, 1600 over 10 %, input 8 bits. */
+	id.full_nits = 1000;
+	id.peak_nits = 1600;
+	id.bpc = 8;
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(p + 21), 0x63d0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(p + 23), 0x6640);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(p + 25), 0);
+	KUNIT_EXPECT_EQ(test, p[27], 0x10 | 2);
+	KUNIT_EXPECT_EQ(test, base->input, DRM_EDID_INPUT_DIGITAL | DRM_EDID_DIGITAL_DEPTH_8);
+	KUNIT_EXPECT_EQ(test, sum(e, EDID_LENGTH), 0);
+	KUNIT_EXPECT_EQ(test, sum(e + EDID_LENGTH, EDID_LENGTH), 0);
+	id.bpc = 10;
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	KUNIT_EXPECT_EQ(test, p[27], 0x10 | 3);
+	KUNIT_EXPECT_EQ(test, base->input, DRM_EDID_INPUT_DIGITAL | DRM_EDID_DIGITAL_DEPTH_10);
+	/* An unknown depth is not given. */
+	id.bpc = 7;
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	KUNIT_EXPECT_EQ(test, p[27], 0x10);
+	KUNIT_EXPECT_EQ(test, base->input, DRM_EDID_INPUT_DIGITAL);
+}
+
+/* The connector reads back the depth and the HDR maximum and frame average. */
+static void panel_edid_update_publishes_luminances(struct kunit *test)
+{
+	struct panel_edid_test *t;
+	struct drm_connector *connector;
+	struct dcp_panel_id id;
+	struct device *dev;
+	int ret;
+
+	dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	t = drm_kunit_helper_alloc_drm_device(test, dev, struct panel_edid_test, drm,
+					      DRIVER_MODESET);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, t);
+	connector = &t->connector;
+	ret = drmm_connector_init(&t->drm, connector, &panel_edid_connector_funcs,
+				  DRM_MODE_CONNECTOR_eDP, NULL);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	panel_id_j516(test, &id);
+	id.hdr_max_nits = 1600;
+	id.peak_nits = 1600;
+	id.full_nits = 1000;
+	id.bpc = 8;
+	mutex_lock(&t->drm.mode_config.mutex);
+	ret = dcp_panel_edid_update(connector, &id, J516_W_MM, J516_H_MM);
+	mutex_unlock(&t->drm.mode_config.mutex);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, connector->display_info.bpc, 8);
+	/* CTA-861.3 codes: 50 x 2^(cv / 32) <= nits: 1600 -> 160, 1000 -> 138. */
+	KUNIT_EXPECT_EQ(test, connector->display_info.hdr_sink_metadata.hdmi_type1.max_cll, 160);
+	KUNIT_EXPECT_EQ(test, connector->display_info.hdr_sink_metadata.hdmi_type1.max_fall, 138);
+	KUNIT_EXPECT_TRUE(test, list_empty(&connector->probed_modes));
+}
+
+static struct kunit_case panel_edid_cases[] = {
+	KUNIT_CASE(panel_id_from_compatible),
+	KUNIT_CASE(panel_id_needs_a_model_and_a_known_vendor),
+	KUNIT_CASE(panel_edid_parses_with_make_product_and_size),
+	KUNIT_CASE(panel_edid_timings_are_the_panels),
+	KUNIT_CASE(panel_edid_refuses_a_size_it_cannot_hold),
+	KUNIT_CASE(panel_edid_update_publishes_the_block),
+	KUNIT_CASE(panel_edid_hdr_block),
+	KUNIT_CASE(panel_edid_update_publishes_hdr),
+	KUNIT_CASE(panel_edid_vrr_range),
+	KUNIT_CASE(panel_edid_update_publishes_vrr_range),
+	KUNIT_CASE(panel_edid_luminance_and_depth),
+	KUNIT_CASE(panel_edid_update_publishes_luminances),
+	{}
+};
+
+static struct kunit_suite panel_edid_suite = {
+	.name = "apple-dcp-panel-edid",
+	.test_cases = panel_edid_cases,
+};
+
+kunit_test_suite(panel_edid_suite);
diff --git a/drivers/gpu/drm/apple/dcp-panel-edid.c b/drivers/gpu/drm/apple/dcp-panel-edid.c
new file mode 100644
index 0000000000..79a89b2de2
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-panel-edid.c
@@ -0,0 +1,530 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * An EDID for a built-in panel.
+ *
+ * The DCP gives no EDID for a built-in panel, so a compositor sees no make,
+ * model or physical size for it. This builds one from what the panel's
+ * device-tree node and a table of the known panel models say: the vendor and
+ * model of its most specific compatible ("apple,panel-j516": make APP, name
+ * J516), the size the connector has, the model year, the panel's native timing
+ * as the DCP's mode line gives it with all rows shown, and the colour of a P3
+ * wide-colour panel (P3 primaries, D65 white point and a nominal gamma of
+ * 2.2, which the sRGB transfer function of Display P3 approximates).
+ *
+ * The native timing is 3456x2234 at 120 Hz with a pixel clock of 1042 MHz.
+ * The base block's detailed timing cannot hold it: its pixel clock field is
+ * 16 bits in 10 kHz units (at most 655.35 MHz) and its vertical front porch 6
+ * bits. The base block therefore carries the panel's geometry at 60 Hz (the
+ * same totals and horizontal porches, the vertical front porch at most 63
+ * lines), and a DisplayID 2.0 extension carries the real 120 Hz timing as its
+ * preferred timing, with the display parameters. Neither is a mode source:
+ * the driver publishes the firmware's modes and never adds modes from this
+ * EDID. It makes no other claim: no product code or serial number, no
+ * manufacture week and no luminance. A panel with a variable refresh rate
+ * gets its range as an EDID 1.4 Display Range Limits descriptor ("range
+ * limits only", continuous frequency), the form drm_edid.c takes as the VRR
+ * range; a fixed-rate panel gets no range.
+ */
+
+#include <linux/ctype.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/minmax.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_edid.h>
+
+#include "dcp-panel-edid.h"
+
+/* Device-tree vendor prefixes and their PNP IDs. */
+static const struct {
+	const char *prefix;
+	const char *pnp;
+} dcp_panel_vendors[] = {
+	{ "apple", "APP" },
+};
+
+/*
+ * Panel models: the year their machines came out (the EDID model year) and the
+ * native timing of the DCP's mode line, with the rows the notch hides shown.
+ */
+static const struct {
+	const char *name;
+	u16 year;
+	struct dcp_panel_timing timing;
+} dcp_panel_models[] = {
+	/* MacBook Pro (16-inch, M3 Pro or M3 Max): 3456x2234 at 120 Hz */
+	{ "J516", 2023, { 1042130, 3456, 3464, 3496, 3536, 2234, 2352, 2360, 2456 } },
+};
+
+/* EDID 1.4: a nominal gamma of 2.2 is (2.2 - 1) * 100 = 120. */
+#define DCP_PANEL_EDID_GAMMA 120
+/* EDID 1.4: week 0xff marks the year byte as the model year, from 1990. */
+#define DCP_PANEL_EDID_MODEL_YEAR 0xff
+/* The base block's detailed timing: the panel's geometry at this rate. */
+#define DCP_PANEL_EDID_DTD_HZ 60
+/* EDID 1.4 detailed timing: the vertical front porch field is 6 bits. */
+#define DCP_PANEL_EDID_DTD_VFP_MAX 63
+
+/* P3 primaries and the D65 white point, CIE 1931 x and y in 1/10000. */
+static const u16 dcp_panel_p3[8] = { 6800, 3200, 2650, 6900, 1500, 600, 3127, 3290 };
+
+/* DisplayID 2.0 (VESA DisplayID Standard v2.0). */
+#define DISPLAYID_EXT		0x70	/* EDID extension tag */
+#define DISPLAYID_V20		0x20	/* structure version 2, revision 0 */
+#define DISPLAYID_GENERIC	0x02	/* primary use case: generic display */
+#define DISPLAYID_PARAMS	0x21	/* Display Parameters data block */
+#define DISPLAYID_PARAMS_LEN	29
+#define DISPLAYID_TYPE7		0x22	/* Type VII detailed timing data block */
+#define DISPLAYID_TYPE7_LEN	20
+#define DISPLAYID_PREFERRED	0x80	/* timing options: preferred */
+#define DISPLAYID_ASPECT_NONE	0x08	/* aspect ratio not given (from the pixels) */
+#define DISPLAYID_SYNC_POS	0x8000	/* front porch word: positive sync */
+#define DISPLAYID_NO_SPEAKERS	0x80	/* features: audio not integrated */
+#define DISPLAYID_TECH_LCD	0x10	/* device technology: active-matrix LCD */
+
+/*
+ * DisplayID 2.0 luminance: an IEEE 754 binary16 value in cd/m2, here from
+ * whole nits (1 to 65504), rounded to nearest; 0 stays 0 (not given).
+ */
+static u16 displayid_luminance(u32 nits)
+{
+	u32 e, m;
+
+	if (!nits)
+		return 0;
+	nits = min(nits, 65504U);
+	e = fls(nits) - 1;
+	m = DIV_ROUND_CLOSEST(nits << 10, 1U << e);
+	if (m == 2048) {
+		m = 1024;
+		e++;
+	}
+	return (e + 15) << 10 | (m - 1024);
+}
+
+/* DisplayID 2.0 native colour depth (bits 2:0 of the depth/technology byte). */
+static u8 displayid_depth(u8 bpc)
+{
+	switch (bpc) {
+	case 6: return 1;
+	case 8: return 2;
+	case 10: return 3;
+	case 12: return 4;
+	case 16: return 5;
+	default: return 0;
+	}
+}
+
+/* EDID 1.4 digital input: the colour bit depth field. */
+static u8 base_depth(u8 bpc)
+{
+	switch (bpc) {
+	case 6: return DRM_EDID_DIGITAL_DEPTH_6;
+	case 8: return DRM_EDID_DIGITAL_DEPTH_8;
+	case 10: return DRM_EDID_DIGITAL_DEPTH_10;
+	case 12: return DRM_EDID_DIGITAL_DEPTH_12;
+	case 16: return DRM_EDID_DIGITAL_DEPTH_16;
+	default: return DRM_EDID_DIGITAL_DEPTH_UNDEF;
+	}
+}
+
+int dcp_panel_id_from_compatible(struct dcp_panel_id *id, const char *compatible)
+{
+	const char *comma = strchr(compatible, ','), *model;
+	size_t vendor_len, len, i;
+
+	memset(id, 0, sizeof(*id));
+	if (!comma)
+		return -EINVAL;
+	vendor_len = comma - compatible;
+	model = comma + 1;
+	if (str_has_prefix(model, "panel-"))
+		model += strlen("panel-");
+	else
+		return -EINVAL;
+	len = strlen(model);
+	if (!len || len > DCP_PANEL_NAME_LEN)
+		return -EINVAL;
+	for (i = 0; i < len; i++) {
+		if (!isalnum(model[i]) && model[i] != '-')
+			return -EINVAL;
+		id->name[i] = toupper(model[i]);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(dcp_panel_models); i++) {
+		if (!strcmp(id->name, dcp_panel_models[i].name)) {
+			id->model_year = dcp_panel_models[i].year;
+			id->timing = dcp_panel_models[i].timing;
+		}
+	}
+	for (i = 0; i < ARRAY_SIZE(dcp_panel_vendors); i++) {
+		if (strlen(dcp_panel_vendors[i].prefix) == vendor_len &&
+		    !strncmp(compatible, dcp_panel_vendors[i].prefix, vendor_len)) {
+			strscpy(id->vendor, dcp_panel_vendors[i].pnp);
+			return 0;
+		}
+	}
+	memset(id, 0, sizeof(*id));
+	return -ENOENT;
+}
+
+static void put_le16(u8 *p, u16 v)
+{
+	p[0] = v;
+	p[1] = v >> 8;
+}
+
+static void checksum(u8 *start, size_t len)
+{
+	u8 sum = 0;
+	size_t i;
+
+	for (i = 0; i < len - 1; i++)
+		sum += start[i];
+	start[len - 1] = -sum;
+}
+
+static bool timing_valid(const struct dcp_panel_timing *t)
+{
+	return t->clock_khz && t->hdisplay < t->hsync_start && t->hsync_start < t->hsync_end &&
+	       t->hsync_end < t->htotal && t->htotal - t->hdisplay < 4096 &&
+	       t->vdisplay < t->vsync_start && t->vsync_start < t->vsync_end &&
+	       t->vsync_end < t->vtotal && t->vtotal - t->vdisplay < 4096 &&
+	       t->hsync_start - t->hdisplay < 1024 && t->hsync_end - t->hsync_start < 1024 &&
+	       t->vsync_end - t->vsync_start < 64;
+}
+
+/* The base block's detailed timing: the panel's geometry at DCP_PANEL_EDID_DTD_HZ. */
+static void base_dtd(u8 *d, const struct dcp_panel_timing *t, int width_mm, int height_mm)
+{
+	u32 clock = DIV_ROUND_CLOSEST((u32)t->htotal * t->vtotal * DCP_PANEL_EDID_DTD_HZ, 10000);
+	u16 hblank = t->htotal - t->hdisplay, vblank = t->vtotal - t->vdisplay;
+	u16 hfp = t->hsync_start - t->hdisplay, hsw = t->hsync_end - t->hsync_start;
+	u16 vfp = min_t(u16, t->vsync_start - t->vdisplay, DCP_PANEL_EDID_DTD_VFP_MAX);
+	u16 vsw = t->vsync_end - t->vsync_start;
+
+	put_le16(d, clock);
+	d[2] = t->hdisplay;
+	d[3] = hblank;
+	d[4] = (t->hdisplay >> 8) << 4 | hblank >> 8;
+	d[5] = t->vdisplay;
+	d[6] = vblank;
+	d[7] = (t->vdisplay >> 8) << 4 | vblank >> 8;
+	d[8] = hfp;
+	d[9] = hsw;
+	d[10] = (vfp & 0xf) << 4 | (vsw & 0xf);
+	d[11] = (hfp >> 8) << 6 | (hsw >> 8) << 4 | (vfp >> 4) << 2 | (vsw >> 4);
+	d[12] = width_mm;
+	d[13] = height_mm;
+	d[14] = (width_mm >> 8) << 4 | height_mm >> 8;
+	/* Digital separate sync, positive vertical and horizontal sync. */
+	d[17] = 0x1e;
+}
+
+/* The P3/D65 chromaticity of the base block, in 10-bit fractions. */
+static void base_chromaticity(struct edid *block)
+{
+	u16 v[8];
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(v); i++)
+		v[i] = DIV_ROUND_CLOSEST(dcp_panel_p3[i] * 1024, 10000);
+	block->red_green_lo = (v[0] & 3) << 6 | (v[1] & 3) << 4 | (v[2] & 3) << 2 | (v[3] & 3);
+	block->blue_white_lo = (v[4] & 3) << 6 | (v[5] & 3) << 4 | (v[6] & 3) << 2 | (v[7] & 3);
+	block->red_x = v[0] >> 2;
+	block->red_y = v[1] >> 2;
+	block->green_x = v[2] >> 2;
+	block->green_y = v[3] >> 2;
+	block->blue_x = v[4] >> 2;
+	block->blue_y = v[5] >> 2;
+	block->white_x = v[6] >> 2;
+	block->white_y = v[7] >> 2;
+}
+
+/* The most an EDID 1.4 range field holds: 255 plus its 255 offset. */
+#define DCP_PANEL_EDID_RANGE_MAX 510
+
+/* One rate of a range descriptor: the field, and whether it needs the offset. */
+static u8 range_rate(u32 v, bool *offset)
+{
+	*offset = v > 255;
+	return *offset ? v - 255 : v;
+}
+
+/*
+ * EDID 1.4 Display Range Limits, "range limits only": the vertical range is
+ * the panel's VRR range. The line rate is the panel's own at every rate (a
+ * lower rate stretches the vertical blank) and the base DTD's at
+ * DCP_PANEL_EDID_DTD_HZ, which has the same totals; the pixel clock is the
+ * panel's.
+ */
+static void base_range(u8 *d, const struct dcp_panel_id *id)
+{
+	const struct dcp_panel_timing *t = &id->timing;
+	u32 h_lo = t->vtotal * DCP_PANEL_EDID_DTD_HZ / 1000;
+	u32 h_hi = min_t(u32, DIV_ROUND_UP(t->clock_khz, t->htotal), DCP_PANEL_EDID_RANGE_MAX);
+	bool off_vlo, off_vhi, off_hlo, off_hhi;
+	unsigned int i;
+
+	memset(d, 0, 18);
+	d[3] = EDID_DETAIL_MONITOR_RANGE;
+	d[5] = range_rate(id->vrr_min_hz, &off_vlo);
+	d[6] = range_rate(id->vrr_max_hz, &off_vhi);
+	d[7] = range_rate(min(h_lo, h_hi), &off_hlo);
+	d[8] = range_rate(h_hi, &off_hhi);
+	/* A minimum may use its offset only with its maximum's (EDID 1.4). */
+	d[4] = (off_vlo ? DRM_EDID_RANGE_OFFSET_MIN_VFREQ : 0) |
+	       (off_vhi ? DRM_EDID_RANGE_OFFSET_MAX_VFREQ : 0) |
+	       (off_hlo ? DRM_EDID_RANGE_OFFSET_MIN_HFREQ : 0) |
+	       (off_hhi ? DRM_EDID_RANGE_OFFSET_MAX_HFREQ : 0);
+	/* Maximum pixel clock in 10 MHz units. */
+	d[9] = min_t(u32, DIV_ROUND_UP(t->clock_khz, 10000), 255);
+	d[10] = DRM_EDID_RANGE_LIMITS_ONLY_FLAG;
+	d[11] = '\n';
+	for (i = 12; i < 18; i++)
+		d[i] = ' ';
+}
+
+static int base_block(const struct dcp_panel_id *id, int width_mm, int height_mm,
+		      struct edid *block)
+{
+	struct detailed_non_pixel *name;
+	u16 manufacturer = 0;
+	size_t len = strnlen(id->name, sizeof(id->name));
+	unsigned int i;
+
+	for (i = 0; i < 3; i++) {
+		if (id->vendor[i] < 'A' || id->vendor[i] > 'Z')
+			return -EINVAL;
+		manufacturer = manufacturer << 5 | (id->vendor[i] - '@');
+	}
+
+	memset(block, 0, sizeof(*block));
+	memcpy(block->header, "\x00\xff\xff\xff\xff\xff\xff\x00", sizeof(block->header));
+	block->product_id.manufacturer_name = cpu_to_be16(manufacturer);
+	block->mfg_week = DCP_PANEL_EDID_MODEL_YEAR;
+	block->mfg_year = id->model_year - 1990;
+	block->version = 1;
+	block->revision = 4;
+	block->input = DRM_EDID_INPUT_DIGITAL | base_depth(id->bpc);
+	block->width_cm = DIV_ROUND_CLOSEST(width_mm, 10);
+	block->height_cm = DIV_ROUND_CLOSEST(height_mm, 10);
+	block->gamma = DCP_PANEL_EDID_GAMMA;
+	base_chromaticity(block);
+	/* Standard timings 0x0101 are unused slots. */
+	memset(block->standard_timings, 0x01, sizeof(block->standard_timings));
+
+	/* EDID 1.4: the first descriptor is a detailed timing; the second names the panel. */
+	base_dtd((u8 *)&block->detailed_timings[0], &id->timing, width_mm, height_mm);
+	name = &block->detailed_timings[1].data.other_data;
+	name->type = EDID_DETAIL_MONITOR_NAME;
+	memset(name->data.str.str, ' ', sizeof(name->data.str.str));
+	memcpy(name->data.str.str, id->name, len);
+	if (len < sizeof(name->data.str.str))
+		name->data.str.str[len] = '\n';
+	for (i = 2; i < ARRAY_SIZE(block->detailed_timings); i++)
+		block->detailed_timings[i].data.other_data.type = 0x10;
+	/* A variable refresh range: the third descriptor, and continuous frequency. */
+	if (id->vrr_max_hz) {
+		base_range((u8 *)&block->detailed_timings[2], id);
+		block->features |= DRM_EDID_FEATURE_CONTINUOUS_FREQ;
+	}
+	block->extensions = DCP_PANEL_EDID_BLOCKS - 1;
+	checksum((u8 *)block, EDID_LENGTH);
+	return 0;
+}
+
+/* DisplayID 2.0 CIE 1931 x/y pair in 12-bit fractions, packed in 3 bytes. */
+static void displayid_xy(u8 *p, u16 x, u16 y)
+{
+	u16 X = DIV_ROUND_CLOSEST(x * 4095, 10000), Y = DIV_ROUND_CLOSEST(y * 4095, 10000);
+
+	p[0] = X;
+	p[1] = (X >> 8) | (Y & 0xf) << 4;
+	p[2] = Y >> 4;
+}
+
+/* The DisplayID 2.0 extension: display parameters and the 120 Hz Type VII timing. */
+static void displayid_block(const struct dcp_panel_id *id, int width_mm, int height_mm,
+			    u8 *ext)
+{
+	const struct dcp_panel_timing *t = &id->timing;
+	u8 *section = ext + 1, *p, *b;
+	unsigned int i;
+
+	memset(ext, 0, EDID_LENGTH);
+	ext[0] = DISPLAYID_EXT;
+	section[0] = DISPLAYID_V20;
+	section[1] = 3 + DISPLAYID_PARAMS_LEN + 3 + DISPLAYID_TYPE7_LEN;
+	section[2] = DISPLAYID_GENERIC;
+	section[3] = 0;	/* no further DisplayID extensions */
+
+	b = section + 4;
+	b[0] = DISPLAYID_PARAMS;
+	b[2] = DISPLAYID_PARAMS_LEN;
+	p = b + 3;
+	put_le16(p + 0, width_mm * 10);	/* 0.1 mm */
+	put_le16(p + 2, height_mm * 10);
+	put_le16(p + 4, t->hdisplay);
+	put_le16(p + 6, t->vdisplay);
+	/* Left to right, top to bottom; CIE 1931; the speakers are not the panel's. */
+	p[8] = DISPLAYID_NO_SPEAKERS;
+	for (i = 0; i < 4; i++)
+		displayid_xy(p + 9 + 3 * i, dcp_panel_p3[2 * i], dcp_panel_p3[2 * i + 1]);
+	/* Bytes 21-26: maximum over the full screen and over 10 %, minimum (not given). */
+	put_le16(p + 21, displayid_luminance(id->full_nits));
+	put_le16(p + 23, displayid_luminance(id->peak_nits));
+	p[27] = DISPLAYID_TECH_LCD | displayid_depth(id->bpc);
+	p[28] = DCP_PANEL_EDID_GAMMA;
+
+	b = p + DISPLAYID_PARAMS_LEN;
+	b[0] = DISPLAYID_TYPE7;
+	b[2] = DISPLAYID_TYPE7_LEN;
+	p = b + 3;
+	/* Pixel clock in kHz minus one, 24 bits. */
+	p[0] = (t->clock_khz - 1);
+	p[1] = (t->clock_khz - 1) >> 8;
+	p[2] = (t->clock_khz - 1) >> 16;
+	p[3] = DISPLAYID_PREFERRED | DISPLAYID_ASPECT_NONE;
+	/* Each field minus one; the front porch words carry the sync polarity. */
+	put_le16(p + 4, t->hdisplay - 1);
+	put_le16(p + 6, t->htotal - t->hdisplay - 1);
+	put_le16(p + 8, (t->hsync_start - t->hdisplay - 1) | DISPLAYID_SYNC_POS);
+	put_le16(p + 10, t->hsync_end - t->hsync_start - 1);
+	put_le16(p + 12, t->vdisplay - 1);
+	put_le16(p + 14, t->vtotal - t->vdisplay - 1);
+	put_le16(p + 16, (t->vsync_start - t->vdisplay - 1) | DISPLAYID_SYNC_POS);
+	put_le16(p + 18, t->vsync_end - t->vsync_start - 1);
+
+	/* The section's checksum after its payload, then the block's. */
+	checksum(section, 4 + section[1] + 1);
+	checksum(ext, EDID_LENGTH);
+}
+
+int dcp_panel_edid_build(const struct dcp_panel_id *id, int width_mm, int height_mm,
+			 u8 edid[DCP_PANEL_EDID_BLOCKS * EDID_LENGTH])
+{
+	size_t len = strnlen(id->name, sizeof(id->name));
+	int ret;
+
+	if (width_mm <= 0 || height_mm <= 0 || width_mm > 4095 || height_mm > 4095 ||
+	    DIV_ROUND_CLOSEST(width_mm, 10) > 255 || DIV_ROUND_CLOSEST(height_mm, 10) > 255)
+		return -EINVAL;
+	if (strnlen(id->vendor, sizeof(id->vendor)) != 3 || !len || len > DCP_PANEL_NAME_LEN)
+		return -EINVAL;
+	/* EDID 1.4 reserves the years before 2006. */
+	if (id->model_year < 2006 || id->model_year > 1990 + 255)
+		return -EINVAL;
+	if (!timing_valid(&id->timing))
+		return -EINVAL;
+	/* A range is both rates or neither, the minimum below the maximum. */
+	if ((id->vrr_min_hz || id->vrr_max_hz) &&
+	    (!id->vrr_min_hz || id->vrr_min_hz >= id->vrr_max_hz ||
+	     id->vrr_max_hz > DCP_PANEL_EDID_RANGE_MAX))
+		return -EINVAL;
+	ret = base_block(id, width_mm, height_mm, (struct edid *)edid);
+	if (ret)
+		return ret;
+	displayid_block(id, width_mm, height_mm, edid + EDID_LENGTH);
+	return 0;
+}
+
+/* CTA-861.3 luminance code: 50 x 2^(cv / 32) cd/m2, the highest not above @nits. */
+static u8 cta_luminance(u32 nits)
+{
+	/* 1000 x 2^(i / 32) */
+	static const u16 frac[32] = {
+		1000, 1022, 1044, 1067, 1091, 1114, 1139, 1164, 1189, 1215, 1242,
+		1269, 1297, 1325, 1354, 1384, 1414, 1445, 1477, 1509, 1542, 1576,
+		1610, 1646, 1682, 1719, 1756, 1795, 1834, 1874, 1915, 1957,
+	};
+	u32 cv = 0;
+
+	while (cv < 255 && div_u64((50ULL * frac[(cv + 1) % 32]) << ((cv + 1) / 32), 1000) <= nits)
+		cv++;
+	return cv;
+}
+
+/*
+ * The CTA-861 extension of an HDR panel: a Colorimetry block with BT.2020
+ * RGB and an HDR Static Metadata block with the SDR and SMPTE ST 2084
+ * transfer functions, metadata type 1, the peak as maximum luminance, the
+ * full-screen maximum (else the peak) as maximum frame-average luminance,
+ * and no minimum (as Aurora's desktop 26.x panels).
+ */
+static void cta_hdr_block(u16 max_nits, u16 avg_nits, u8 *ext)
+{
+	u8 *d = ext + 4, cv = cta_luminance(max_nits);
+	u8 avg = avg_nits && avg_nits < max_nits ? cta_luminance(avg_nits) : cv;
+
+	memset(ext, 0, EDID_LENGTH);
+	ext[0] = CEA_EXT;
+	ext[1] = 3;
+	/* Use extended tag 7, length 3: Colorimetry (5), BT2020_RGB, no metadata. */
+	d[0] = 7 << 5 | 3;
+	d[1] = 0x05;
+	d[2] = BIT(7);
+	d[3] = 0;
+	d += 4;
+	/* Extended tag 7, length 6: HDR Static Metadata (6). */
+	d[0] = 7 << 5 | 6;
+	d[1] = 0x06;
+	d[2] = BIT(0) | BIT(2);	/* traditional gamma SDR, SMPTE ST 2084 */
+	d[3] = BIT(0);		/* static metadata type 1 */
+	d[4] = cv;
+	d[5] = avg;
+	d[6] = 0;
+	d += 7;
+	/* No detailed timings: they would start where the data blocks end. */
+	ext[2] = d - ext;
+	checksum(ext, EDID_LENGTH);
+}
+
+int dcp_panel_edid_build_hdr(const struct dcp_panel_id *id, int width_mm, int height_mm,
+			     u8 edid[DCP_PANEL_EDID_HDR_BLOCKS * EDID_LENGTH])
+{
+	int ret;
+
+	if (!id->hdr_max_nits)
+		return -EINVAL;
+	ret = dcp_panel_edid_build(id, width_mm, height_mm, edid);
+	if (ret)
+		return ret;
+	((struct edid *)edid)->extensions = DCP_PANEL_EDID_HDR_BLOCKS - 1;
+	checksum(edid, EDID_LENGTH);
+	cta_hdr_block(id->hdr_max_nits, id->full_nits, edid + 2 * EDID_LENGTH);
+	return 0;
+}
+
+int dcp_panel_edid_update(struct drm_connector *connector, const struct dcp_panel_id *id,
+			  int width_mm, int height_mm)
+{
+	size_t size = (id->hdr_max_nits ? DCP_PANEL_EDID_HDR_BLOCKS : DCP_PANEL_EDID_BLOCKS) *
+		      EDID_LENGTH;
+	const struct drm_edid *edid;
+	u8 *blocks;
+	int ret;
+
+	blocks = kmalloc(DCP_PANEL_EDID_HDR_BLOCKS * EDID_LENGTH, GFP_KERNEL);
+	if (!blocks)
+		return -ENOMEM;
+	ret = id->hdr_max_nits ? dcp_panel_edid_build_hdr(id, width_mm, height_mm, blocks) :
+				 dcp_panel_edid_build(id, width_mm, height_mm, blocks);
+	if (ret)
+		goto out;
+	edid = drm_edid_alloc(blocks, size);
+	if (!edid) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	/* This sets the connector's size from the block, in whole centimetres. */
+	ret = drm_edid_connector_update(connector, edid);
+	drm_edid_free(edid);
+out:
+	kfree(blocks);
+	return ret;
+}
