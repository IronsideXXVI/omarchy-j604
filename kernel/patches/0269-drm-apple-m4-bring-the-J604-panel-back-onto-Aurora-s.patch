diff --git a/drivers/gpu/drm/apple/apple_blend.h b/drivers/gpu/drm/apple/apple_blend.h
new file mode 100644
index 0000000000..71cfaef490
--- /dev/null
+++ b/drivers/gpu/drm/apple/apple_blend.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Blend modes the Apple display planes offer.
+ *
+ * drm_plane_create_blend_mode_property() refuses, with a WARN and -EINVAL,
+ * any mask that lacks "Pre-multiplied": the core makes it the default of
+ * every plane state. A plane that cannot honour it offers no property.
+ */
+#ifndef __APPLE_BLEND_H__
+#define __APPLE_BLEND_H__
+
+#include <linux/bits.h>
+#include <drm/drm_blend.h>
+
+/*
+ * T8132 dcpext: one bottom plane whose frames go out opaque. Nothing reads
+ * the mode, and with no plane alpha "Pre-multiplied" over the black
+ * background gives the same pixels as "None".
+ */
+#define T8132_EXT_BLEND_MODES \
+	(BIT(DRM_MODE_BLEND_PIXEL_NONE) | BIT(DRM_MODE_BLEND_PREMULTI))
+
+/*
+ * apple_plane_init(): firmware whose swap surface has is_premultiplied
+ * offers both modes. Without the flag (H17P) DCP blends only by coverage,
+ * which the core cannot take alone: 0, no property.
+ */
+static inline unsigned int apple_plane_blend_modes(bool premultiplied)
+{
+	if (!premultiplied)
+		return 0;
+	return BIT(DRM_MODE_BLEND_COVERAGE) | BIT(DRM_MODE_BLEND_PREMULTI);
+}
+
+#endif /* __APPLE_BLEND_H__ */
diff --git a/drivers/gpu/drm/apple/apple_blend_test.c b/drivers/gpu/drm/apple/apple_blend_test.c
new file mode 100644
index 0000000000..9aa749cfec
--- /dev/null
+++ b/drivers/gpu/drm/apple/apple_blend_test.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * KUnit tests for the blend modes the Apple display planes offer
+ * (apple_blend.h). Each mask goes through the DRM core's own
+ * drm_plane_create_blend_mode_property() on a KUnit DRM device. No hardware.
+ */
+#include <kunit/test.h>
+#include <linux/bits.h>
+#include <linux/list.h>
+#include <linux/module.h>
+
+#include <drm/drm_blend.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_kunit_helpers.h>
+#include <drm/drm_mode_object.h>
+#include <drm/drm_plane.h>
+#include <drm/drm_property.h>
+
+#include "apple_blend.h"
+
+struct blend_test {
+	struct drm_device drm;
+};
+
+static struct drm_plane *blend_test_plane(struct kunit *test)
+{
+	struct blend_test *priv;
+	struct drm_plane *plane;
+	struct device *dev;
+
+	dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	priv = drm_kunit_helper_alloc_drm_device(test, dev, struct blend_test,
+						 drm,
+						 DRIVER_MODESET | DRIVER_ATOMIC);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, priv);
+	plane = drm_kunit_helper_create_primary_plane(test, &priv->drm, NULL,
+						      NULL, NULL, 0, NULL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, plane);
+	return plane;
+}
+
+/*
+ * Create the property for @modes and check what the core attached: it lists
+ * exactly @modes and defaults to "Pre-multiplied".
+ */
+static void expect_blend_property(struct kunit *test, unsigned int modes)
+{
+	struct drm_plane *plane = blend_test_plane(test);
+	struct drm_property_enum *e;
+	struct drm_property *prop;
+	unsigned int seen = 0;
+	u64 val = ~0ULL;
+
+	KUNIT_ASSERT_EQ(test,
+			drm_plane_create_blend_mode_property(plane, modes), 0);
+	prop = plane->blend_mode_property;
+	KUNIT_ASSERT_NOT_NULL(test, prop);
+	list_for_each_entry(e, &prop->enum_list, head)
+		seen |= BIT(e->value);
+	KUNIT_EXPECT_EQ(test, seen, modes);
+	KUNIT_EXPECT_EQ(test,
+			drm_object_property_get_default_value(&plane->base,
+							      prop, &val), 0);
+	KUNIT_EXPECT_EQ(test, val, (u64)DRM_MODE_BLEND_PREMULTI);
+}
+
+/* A dcpext output probes: its blend property is accepted by the core. */
+static void blend_t8132_ext_accepted(struct kunit *test)
+{
+	expect_blend_property(test, T8132_EXT_BLEND_MODES);
+}
+
+/* ...and still offers "None", the mode its scanout actually has. */
+static void blend_t8132_ext_offers_none(struct kunit *test)
+{
+	KUNIT_EXPECT_TRUE(test, T8132_EXT_BLEND_MODES &
+				BIT(DRM_MODE_BLEND_PIXEL_NONE));
+	KUNIT_EXPECT_FALSE(test, T8132_EXT_BLEND_MODES &
+				 BIT(DRM_MODE_BLEND_COVERAGE));
+}
+
+/* Planes on firmware with is_premultiplied probe, offering both modes. */
+static void blend_apple_plane_premultiplied(struct kunit *test)
+{
+	unsigned int modes = apple_plane_blend_modes(true);
+
+	KUNIT_EXPECT_TRUE(test, modes & BIT(DRM_MODE_BLEND_COVERAGE));
+	expect_blend_property(test, modes);
+}
+
+/*
+ * H17P planes blend only by coverage: they offer no property, so they
+ * neither fail to probe nor advertise "Pre-multiplied".
+ */
+static void blend_apple_plane_coverage_only(struct kunit *test)
+{
+	unsigned int modes = apple_plane_blend_modes(false);
+
+	if (modes)
+		expect_blend_property(test, modes);
+	KUNIT_EXPECT_EQ(test, modes, 0U);
+}
+
+static struct kunit_case blend_cases[] = {
+	KUNIT_CASE(blend_t8132_ext_accepted),
+	KUNIT_CASE(blend_t8132_ext_offers_none),
+	KUNIT_CASE(blend_apple_plane_premultiplied),
+	KUNIT_CASE(blend_apple_plane_coverage_only),
+	{}
+};
+
+static struct kunit_suite blend_suite = {
+	.name = "apple-drm-blend",
+	.test_cases = blend_cases,
+};
+
+kunit_test_suite(blend_suite);
