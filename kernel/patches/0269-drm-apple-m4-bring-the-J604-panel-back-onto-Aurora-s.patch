+static void dcp_m4_int_flight_finish(struct dcp_m4_runtime *r)
+{
+	struct iomfb_m4 *dcp = r->dcp;
+	struct apple_crtc *crtc = READ_ONCE(dcp->owner->crtc);
+	bool shown = !r->int_shown_valid || r->int_shown;
+	struct drm_framebuffer *old = dcp->active_fb;
+	ktime_t t = r->int_done_kt ?: ktime_get();
