+static int dcp_m4_int_flight_done(struct dcp_m4_runtime *r)
+{
+	int ret = dcp_m4_swap_record_done(&r->int_fl.swap, r->int_fl.swap.id);
+
+	if (!ret && dcp_m4_swap_take_completion(&r->int_fl.swap) != 1)
+		ret = -EPROTO;
+	if (ret)
+		return ret;
+	dcp_m4_int_flight_finish(r);
+	return 0;
+}
