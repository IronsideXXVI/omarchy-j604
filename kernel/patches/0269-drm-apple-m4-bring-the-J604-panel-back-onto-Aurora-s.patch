+	mutex_lock(&dcp->lock);
+	if (r->int_fl.open) {
+		ret = READ_ONCE(dcp->error) ?: dcp_m4_runtime_drain(r, 32);
+		if (r->int_fl.open && (ret < 0 || time_after_eq(jiffies, r->int_fl.deadline)))
+			dcp_m4_int_flight_lost(r, ret < 0 ? ret : -ETIMEDOUT);
+		else if (r->int_fl.open)
