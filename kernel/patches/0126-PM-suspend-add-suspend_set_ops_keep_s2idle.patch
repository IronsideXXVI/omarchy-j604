From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 9 Nov 2026 23:33:04 +0000
Subject: [PATCH] PM: suspend: add suspend_set_ops_keep_s2idle()

suspend_set_ops() makes "deep" the default mem sleep as soon as a
platform offers it, unless mem_sleep_default= says otherwise. A platform
whose suspend-to-RAM some device still refuses at run time wants to
offer "deep" in /sys/power/mem_sleep without making every default
suspend take it, and fail.

Add suspend_set_ops_keep_s2idle(): the same, but with no
mem_sleep_default= on the command line s2idle stays the default. An
explicit mem_sleep_default=deep still selects "deep".

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 8bf80ae264dbee16827b058027ed8ab3b648cb1b)
---
 include/linux/suspend.h |  2 ++
 kernel/power/suspend.c  | 21 +++++++++++++++++++++
 2 files changed, 23 insertions(+)

diff --git a/include/linux/suspend.h b/include/linux/suspend.h
index 365437ce2c..1dd20cd5a2 100644
--- a/include/linux/suspend.h
+++ b/include/linux/suspend.h
@@ -152,6 +152,7 @@ extern suspend_state_t mem_sleep_default;
  * @ops: The new suspend operations to set.
  */
 extern void suspend_set_ops(const struct platform_suspend_ops *ops);
+extern void suspend_set_ops_keep_s2idle(const struct platform_suspend_ops *ops);
 extern int suspend_valid_only_mem(suspend_state_t state);
 
 extern unsigned int pm_suspend_global_flags;
@@ -319,6 +320,7 @@ static inline bool pm_dark_wake(void) { return false; }
 static inline bool pm_suspend_default_s2idle(void) { return false; }
 
 static inline void suspend_set_ops(const struct platform_suspend_ops *ops) {}
+static inline void suspend_set_ops_keep_s2idle(const struct platform_suspend_ops *ops) {}
 static inline int pm_suspend(suspend_state_t state) { return -ENOSYS; }
 static inline bool sync_on_suspend_enabled(void) { return true; }
 static inline bool idle_should_enter_s2idle(void) { return false; }
diff --git a/kernel/power/suspend.c b/kernel/power/suspend.c
index 34253036bb..a05242a5e3 100644
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -241,6 +241,27 @@ void suspend_set_ops(const struct platform_suspend_ops *ops)
 }
 EXPORT_SYMBOL_GPL(suspend_set_ops);
 
+/**
+ * suspend_set_ops_keep_s2idle - Set suspend operations, keep s2idle the default.
+ * @ops: Sleep operations to use.
+ *
+ * Like suspend_set_ops(), but "deep" is only offered in mem_sleep: it becomes
+ * the default only if mem_sleep_default= asked for it on the command line. For
+ * platforms whose suspend-to-RAM some device still refuses at run time.
+ */
+void suspend_set_ops_keep_s2idle(const struct platform_suspend_ops *ops)
+{
+	unsigned int sleep_flags;
+
+	sleep_flags = lock_system_sleep();
+	if (mem_sleep_default == PM_SUSPEND_MAX)
+		mem_sleep_default = PM_SUSPEND_TO_IDLE;
+	unlock_system_sleep(sleep_flags);
+
+	suspend_set_ops(ops);
+}
+EXPORT_SYMBOL_GPL(suspend_set_ops_keep_s2idle);
+
 /**
  * suspend_valid_only_mem - Generic memory-only valid callback.
  * @state: Target system sleep state.
-- 
2.43.0

