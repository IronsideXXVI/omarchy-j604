From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:08 -0500
Subject: [PATCH] arm64: restore Apple CPU state after a
 firmware-driven suspend

The enable callbacks of these features run through hotplug, and a
context switch only writes ACTLR when the thread's value changes. A
firmware-driven system suspend really resets the boot CPU, which comes
back through cpu_resume and not through hotplug, so it keeps reset
values with nothing to correct them. With AMX, that can leave EL0 access
in the wrong state for the current thread.

Restore them in __cpu_suspend_exit when pm_resume_via_firmware() says
the CPU was reset. That's only set during such a system suspend, and the
restore does nothing on a CPU without these features, so other machines
don't change.

Signed-off-by: Diljit Singh <hey@djdev.me>
(cherry picked from commit 4f12b82fa99515450ec1d8a19963add5df29cc5d)
(cherry picked from commit 4da5fa657e3b37f8ef3452f8a2a006461f9e59ce)
(cherry picked from commit 23d6f7e1ddef45e4502610182b29c19c2d819af0)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/include/asm/cpufeature.h   |  1 +
 arch/arm64/kernel/cpufeature_impdef.c | 18 ++++++++++++++++++
 arch/arm64/kernel/suspend.c           |  8 ++++++++
 3 files changed, 27 insertions(+)

diff --git a/arch/arm64/include/asm/cpufeature.h b/arch/arm64/include/asm/cpufeature.h
index 0a421a88b3..65982bd36a 100644
--- a/arch/arm64/include/asm/cpufeature.h
+++ b/arch/arm64/include/asm/cpufeature.h
@@ -1089,6 +1089,7 @@ static inline bool cpu_has_lpa2(void)
 }
 
 void __init init_cpucap_indirect_list_impdef(void);
+void arm64_impdef_cpu_reset_restore(void);
 void __init init_cpucap_indirect_list_from_array(const struct arm64_cpu_capabilities *caps);
 bool cpufeature_matches(u64 reg, const struct arm64_cpu_capabilities *entry);
 
diff --git a/arch/arm64/kernel/cpufeature_impdef.c b/arch/arm64/kernel/cpufeature_impdef.c
index 4078f95146..f08e210bcb 100644
--- a/arch/arm64/kernel/cpufeature_impdef.c
+++ b/arch/arm64/kernel/cpufeature_impdef.c
@@ -7,6 +7,7 @@
 
 #include <linux/arm-smccc.h>
 
+#include <linux/sched.h>
 #include <asm/cpufeature.h>
 #include <asm/apple_amx.h>
 #include <asm/apple_cpufeature.h>
@@ -363,6 +364,23 @@ static const struct arm64_cpu_capabilities arm64_impdef_features[] = {
 	{},
 };
 
+/*
+ * Restore what these features keep per CPU, on a CPU that was reset without
+ * going through CPU hotplug: its enable callbacks do not run again, and a
+ * context switch only writes ACTLR when the thread's value changes.
+ */
+void arm64_impdef_cpu_reset_restore(void)
+{
+#ifdef CONFIG_ARM64_ACTLR_STATE
+	if (system_has_actlr_state())
+		write_sysreg(current->thread.actlr, actlr_el1);
+#endif
+#ifdef CONFIG_ARM64_APPLE_AMX
+	if (cpus_have_cap(ARM64_HAS_AMX_APPLE))
+		cpu_disable_el0_amx(NULL);
+#endif
+}
+
 void __init init_cpucap_indirect_list_impdef(void)
 {
 	init_cpucap_indirect_list_from_array(arm64_impdef_features);
diff --git a/arch/arm64/kernel/suspend.c b/arch/arm64/kernel/suspend.c
index c41724a40b..2a69c79b4e 100644
--- a/arch/arm64/kernel/suspend.c
+++ b/arch/arm64/kernel/suspend.c
@@ -2,6 +2,7 @@
 #include <linux/ftrace.h>
 #include <linux/percpu.h>
 #include <linux/slab.h>
+#include <linux/suspend.h>
 #include <linux/uaccess.h>
 #include <linux/pgtable.h>
 #include <linux/cpuidle.h>
@@ -85,6 +86,13 @@ void notrace __cpu_suspend_exit(void)
 
 	/* Restore additional feature-specific configuration */
 	ptrauth_suspend_exit();
+
+	/*
+	 * A firmware-driven system suspend really reset this CPU. Nothing else on
+	 * this path restores implementation-defined state.
+	 */
+	if (pm_resume_via_firmware())
+		arm64_impdef_cpu_reset_restore();
 }
 
