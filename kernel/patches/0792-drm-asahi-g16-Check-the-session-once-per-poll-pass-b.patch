From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 11:46:58 +0000
Subject: [PATCH] drm/asahi: g16: Check the session once per poll pass
 by default

A poll pass verified the firmware session and the adopted UAT bindings
four times under the same device lock. One check per pass covers the
same state.

Default g16_pass_check_once to 1. Set it to 0 for the four checks.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index e0631663ad..9dd447764d 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -835,8 +835,8 @@ pub(crate) fn fs_event0() -> bool {
     "G16: write the FS completion block's producing event (+0x14) as 0, as macOS does, instead of 0x71, which no barrier waits on (default 0: 0x71; 1: 0; runtime 0644)"
 );
 
-/// Storage of `g16_pass_check_once` (runtime 0644, default 0).
-static PASS_CHECK_ONCE: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_pass_check_once` (runtime 0644, default 1).
+static PASS_CHECK_ONCE: AtomicU32 = AtomicU32::new(1);
 
 /// Whether a poll pass verifies the session and the adopted UAT bindings once, instead of
 /// once in the session check, again in the object health check and twice more in the
@@ -852,7 +852,7 @@ pub(crate) fn pass_check_once() -> bool {
     PASS_CHECK_ONCE_PARM,
     PASS_CHECK_ONCE,
     "g16_pass_check_once",
-    "G16: verify the firmware session and the adopted UAT bindings once per poll pass instead of four times under the same lock (default 0: four; 1: once; runtime 0644)"
+    "G16: verify the firmware session and the adopted UAT bindings once per poll pass instead of four times under the same lock (0: four; default 1: once; runtime 0644)"
 );
 
 /// Storage of `g16_drain_first` (runtime 0644, default 0).
-- 
2.43.0

