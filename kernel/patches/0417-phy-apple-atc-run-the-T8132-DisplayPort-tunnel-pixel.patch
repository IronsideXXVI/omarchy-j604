From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 4 Nov 2026 22:04:59 -0500
Subject: [PATCH] phy: apple: atc: run the T8132 DisplayPort tunnel pixel
 clocks

The T8132 PHY has the T8122 tunnel pixel clock: the same AUSPLL descriptor,
APB handshake, lock bit and TX_DP_CTRL0 selects. Use it on T8132 as on
T6030. The T8132 sources are display crossbar states 2 (dcpext0) and 4
(dcpext1), each feeding DP IN 0 through PCLK1 and DP IN 1 through PCLK2:
add apple_dp_tunnel_t8132_pclk(). apple_atc_dp_tunnel_rate() passes source
0, which T8132 refuses, so its callers name their source.

As on T6030, a DP IN 1 stream needs PCLK1 at its rate as well as PCLK2:
without PCLK1 its picture is lost. PCLK1 is set up with DP IN 1 when it
starts alone, and stays on while DP IN 1 runs, also when DP IN 0 is
released; releasing DP IN 1 clears PCLK2, and PCLK1 only with DP IN 0 gone
too. apple_dp_tunnel_pclks() names the gates the running streams need.

Both DP IN streams of a PHY need one link rate: next to a DP IN 0 stream at
another rate, the DP IN 1 stream stays dark. A stream at another rate than
the one running is refused (-EBUSY) before anything is programmed.

The T8132 ATC domain switches off at runtime outside a CIO mode. There a
rate request is refused with -EBUSY and a stop only drops the bookkeeping,
with no register access; and leaving a CIO mode stops a running tunnel
clock first, since the PHY stop takes its PLL with it.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 97081f77e9a0d70b85ea3a0f8f16f4094cba78c8)
---
 drivers/phy/apple/atc-tunnel-test.c | 50 +++++++++++++++
 drivers/phy/apple/atc.c             | 95 +++++++++++++++++++++++++----
 include/linux/soc/apple/dp-tunnel.h | 38 +++++++++++-
 3 files changed, 170 insertions(+), 13 deletions(-)

diff --git a/drivers/phy/apple/atc-tunnel-test.c b/drivers/phy/apple/atc-tunnel-test.c
index 15f1055707..6cd41acc2e 100644
--- a/drivers/phy/apple/atc-tunnel-test.c
+++ b/drivers/phy/apple/atc-tunnel-test.c
@@ -104,8 +104,58 @@ static void atc_tunnel_t6030_clock_sources(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t6030_pclk(0, ~0U), -EOPNOTSUPP);
 }
 
+static void atc_tunnel_t8132_clock_sources(struct kunit *test)
+{
+	/* dcpext0 (2) and dcpext1 (4): PCLK1 for DP IN 0, PCLK2 for DP IN 1 */
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_pclk(2, 0), 0);
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_pclk(4, 0), 0);
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_pclk(2, 1), 1);
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_pclk(4, 1), 1);
+	/* No other source, and no third DP IN */
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_pclk(0, 0), -EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_pclk(3, 0), -EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_pclk(2, 2), -EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_pclk(~0U, 0), -EOPNOTSUPP);
+}
+
+static void atc_tunnel_pclk_gates(struct kunit *test)
+{
+	/* DP IN 0 alone: PCLK1 */
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_pclks(BIT(0)), APPLE_DP_TUNNEL_PCLK1);
+	/* DP IN 1 alone: PCLK2, and PCLK1 at its rate */
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_pclks(BIT(1)),
+			APPLE_DP_TUNNEL_PCLK1 | APPLE_DP_TUNNEL_PCLK2);
+	/* both: both */
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_pclks(BIT(0) | BIT(1)),
+			APPLE_DP_TUNNEL_PCLK1 | APPLE_DP_TUNNEL_PCLK2);
+	/* DP IN 0 released with DP IN 1 up: PCLK1 stays */
+	KUNIT_EXPECT_TRUE(test, apple_dp_tunnel_pclks((BIT(0) | BIT(1)) & ~BIT(0)) &
+			  APPLE_DP_TUNNEL_PCLK1);
+	/* DP IN 1 released with DP IN 0 up: PCLK2 goes, PCLK1 stays */
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_pclks((BIT(0) | BIT(1)) & ~BIT(1)),
+			APPLE_DP_TUNNEL_PCLK1);
+	/* all released: neither */
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_pclks(0), 0U);
+}
+
+static void atc_tunnel_t8132_one_rate(struct kunit *test)
+{
+	/* HBR2 (0x14) next to HBR2, or alone: allowed */
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_rate_ok(0x14, 0x14), 0);
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_rate_ok(0x14, 0), 0);
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_rate_ok(0x0a, 0), 0);
+	/* a stop is never refused */
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_rate_ok(0, 0x14), 0);
+	/* another rate next to a running stream: refused */
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_rate_ok(0x0a, 0x14), -EBUSY);
+	KUNIT_EXPECT_EQ(test, apple_dp_tunnel_t8132_rate_ok(0x1e, 0x0a), -EBUSY);
+}
+
 static struct kunit_case atc_tunnel_cases[] = {
 	KUNIT_CASE(atc_tunnel_t6030_clock_sources),
+	KUNIT_CASE(atc_tunnel_t8132_clock_sources),
+	KUNIT_CASE(atc_tunnel_t8132_one_rate),
+	KUNIT_CASE(atc_tunnel_pclk_gates),
 	KUNIT_CASE(atc_tunnel_soc_qualification),
 	KUNIT_CASE(atc_tunnel_core_qualification),
 	KUNIT_CASE(atc_tunnel_wiring_gate),
diff --git a/drivers/phy/apple/atc.c b/drivers/phy/apple/atc.c
index cf841cf2d2..e7f3c39cbb 100644
--- a/drivers/phy/apple/atc.c
+++ b/drivers/phy/apple/atc.c
@@ -2843,7 +2843,10 @@ static void atc_t8122_tunnel_pclk(struct apple_atcphy *atcphy,
 			   FIELD_PREP(DPTX_PCLK1_SELECT, selector);
 
 	lockdep_assert_held(&atcphy->lock);
-	/* PCLK1 is also DPIN1's prerequisite: retuning DPIN0 must not gate it. */
+	/*
+	 * PCLK1 is also DPIN1's prerequisite, on T6030 and T8132 alike (see
+	 * apple_dp_tunnel_pclks()): retuning DPIN0 must not gate it.
+	 */
 	if (!pclk && (atcphy->tunnel_users & BIT(1)))
 		value |= DPTX_PCLK1_ENABLE;
 	core_mask32(atcphy, ACIOPHY_LANE_DP_CFG_BLK_TX_DP_CTRL0,
@@ -2898,7 +2901,9 @@ static int atc_t8122_tunnel_start(struct apple_atcphy *atcphy,
 	    ((saved_tx & T8122_PCLK_ENABLES) && (saved_tx & 0xffff) != 0xe001))
 		return -EBUSY;
 
-	/* Inactive slots use selector zero; all gates stay off during PLL setup. */
+	/*
+	 * Inactive slots use selector zero; all gates stay off during PLL setup.
+	 */
 	core_mask32(atcphy, ACIOPHY_LANE_DP_CFG_BLK_TX_DP_CTRL0, GENMASK(15, 4),
 		    FIELD_PREP(DPTX_PCLK1_SELECT, selector) |
 		    (pclk ? FIELD_PREP(DPTX_PCLK2_SELECT, selector) : 0));
@@ -3417,11 +3422,25 @@ static int atc_tunnel_set_t602x(struct apple_atcphy *atcphy, unsigned int dpin,
 	return 0;
 }
 
-/* T6030 (M3 Pro) uses T8122-generation PHYs for both DP IN clock outputs. */
-static bool apple_atc_tunnel_is_t6030(struct apple_atcphy *atcphy)
+/*
+ * T6030 (M3 Pro) uses T8122-generation PHYs for both DP IN clock outputs.
+ * The T8132 (M4) PHY has the same tunnel clock: AUSPLL descriptor, APB
+ * handshake, lock bit and TX_DP_CTRL0 selects are at the same offsets.
+ */
+static bool apple_atc_tunnel_t8122_clock(struct apple_atcphy *atcphy)
 {
-	return of_machine_is_compatible("apple,t6030") &&
-	       atcphy->hw->gen == ATCPHY_GENERATION_T8122;
+	return (of_machine_is_compatible("apple,t6030") &&
+		atcphy->hw->gen == ATCPHY_GENERATION_T8122) ||
+	       atcphy->hw->gen == ATCPHY_GENERATION_T8132;
+}
+
+/* Which pixel clock (0: PCLK1, 1: PCLK2) source @source uses for DP IN @dpin. */
+static int apple_atc_tunnel_pclk(struct apple_atcphy *atcphy, unsigned int source,
+				 unsigned int dpin)
+{
+	if (atcphy->hw->gen == ATCPHY_GENERATION_T8132)
+		return apple_dp_tunnel_t8132_pclk(source, dpin);
+	return apple_dp_tunnel_t6030_pclk(source, dpin);
 }
 
 /*
@@ -3815,6 +3834,10 @@ static int atcphy_configure_t8132(struct apple_atcphy *atcphy, enum atcphy_mode
 
 	if (atcphy->t8132_common_owned && atcphy->host_active)
 		return -EBUSY;
+	/* The PHY stop below takes a DP tunnel pixel clock's PLL with it. */
+	ret = atc_t8122_tunnel_stop(atcphy);
+	if (ret)
+		return ret;
 	atcphy->mode_dirty = true;
 	if (atcphy->t8132_common_owned) {
 		if (atcphy->mode == APPLE_ATCPHY_MODE_USB3_DP)
@@ -4666,15 +4689,33 @@ int apple_atc_dp_tunnel_rate_source(struct phy *phy, unsigned int source,
 				    unsigned int dpin, u8 rate)
 {
 	struct apple_atcphy *atcphy;
+	unsigned int gates;
 	int pclk, ret;
 
 	if (!phy || phy->ops != &apple_atc_dp_phy_ops || dpin > 1)
 		return -EINVAL;
 	atcphy = phy_get_drvdata(phy);
-	pclk = apple_dp_tunnel_t6030_pclk(source, dpin);
-	if (!apple_atc_tunnel_is_t6030(atcphy) || pclk < 0)
+	pclk = apple_atc_tunnel_pclk(atcphy, source, dpin);
+	if (!apple_atc_tunnel_t8122_clock(atcphy) || pclk < 0)
 		return -EOPNOTSUPP;
 	guard(mutex)(&atcphy->lock);
+	/*
+	 * The T8132 ATC domain goes off at runtime unless the PHY is in a CIO
+	 * mode, and leaving one stops the tunnel clock (atcphy_configure_t8132()):
+	 * outside one there is nothing to stop and no register to touch.
+	 */
+	if (atcphy->hw->gen == ATCPHY_GENERATION_T8132 &&
+	    atcphy->mode != APPLE_ATCPHY_MODE_USB4 &&
+	    atcphy->mode != APPLE_ATCPHY_MODE_TBT) {
+		if (rate)
+			return -EBUSY;
+		if ((atcphy->tunnel_users & BIT(dpin)) &&
+		    atcphy->tunnel_source[dpin] != source)
+			return -ESTALE;
+		atcphy->tunnel_users &= ~BIT(dpin);
+		atcphy->tunnel_dpin_rate[dpin] = 0;
+		return 0;
+	}
 	atcphy_restore_after_pd_off(atcphy);
 	/* A stale source must not retune or stop another source's clock. */
 	if ((atcphy->tunnel_users & BIT(dpin)) &&
@@ -4685,10 +4726,17 @@ int apple_atc_dp_tunnel_rate_source(struct phy *phy, unsigned int source,
 			return 0;
 		if (!(atcphy->tunnel_users & ~BIT(dpin)))
 			return atc_t8122_tunnel_stop(atcphy);
-		/* Release only this stream; the other stream keeps its PLL and gates. */
-		if (pclk)
+		/*
+		 * Release only this stream; the other stream keeps its PLL and the
+		 * gates it needs: a DP IN 1 stream keeps PCLK1 too.
+		 */
+		gates = apple_dp_tunnel_pclks(atcphy->tunnel_users & ~BIT(dpin));
+		if (!(gates & APPLE_DP_TUNNEL_PCLK2))
 			core_clear32(atcphy, ACIOPHY_LANE_DP_CFG_BLK_TX_DP_CTRL0,
 				     DPTX_PCLK2_ENABLE);
+		if (!(gates & APPLE_DP_TUNNEL_PCLK1))
+			core_clear32(atcphy, ACIOPHY_LANE_DP_CFG_BLK_TX_DP_CTRL0,
+				     DPTX_PCLK1_ENABLE);
 		atcphy->tunnel_users &= ~BIT(dpin);
 		atcphy->tunnel_dpin_rate[dpin] = 0;
 		return 0;
@@ -4705,6 +4753,22 @@ int apple_atc_dp_tunnel_rate_source(struct phy *phy, unsigned int source,
 	if ((atcphy->tunnel_users & BIT(dpin)) &&
 	    atcphy->tunnel_dpin_rate[dpin] == rate && atcphy->tunnel_rate)
 		return 0;
+	/*
+	 * The DP IN 1 stream of a T8132 PHY only shows with both pixel clocks
+	 * at its own rate: refuse a stream at another rate than the one
+	 * running, before anything is programmed.
+	 */
+	if (atcphy->hw->gen == ATCPHY_GENERATION_T8132) {
+		u8 other = atcphy->tunnel_users & BIT(1 - dpin) ?
+			   atcphy->tunnel_dpin_rate[1 - dpin] : 0;
+
+		ret = apple_dp_tunnel_t8132_rate_ok(rate, other);
+		if (ret) {
+			dev_warn(atcphy->dev, "DP tunnel dpin%u at rate 0x%x refused: dpin%u runs at 0x%x\n",
+				 dpin, rate, 1 - dpin, other);
+			return ret;
+		}
+	}
 	atcphy->tunnel_source[dpin] = source;
 	ret = atc_t8122_tunnel_start(atcphy, pclk, rate);
 	if (!ret || (atcphy->tunnel_clock_on && !atcphy->tunnel_rate)) {
@@ -4727,8 +4791,11 @@ int apple_atc_dp_tunnel_rate(struct phy *phy, unsigned int dpin, u8 rate)
 	if (!phy || phy->ops != &apple_atc_dp_phy_ops || dpin > 1)
 		return -EINVAL;
 	atcphy = phy_get_drvdata(phy);
-	/* Keep each supported SoC on its qualified clock sequence. */
-	if (apple_atc_tunnel_is_t6030(atcphy))
+	/*
+	 * Keep each supported SoC on its qualified clock sequence. Source 0
+	 * is no T8132 source, so this refuses there: T8132 callers name theirs.
+	 */
+	if (apple_atc_tunnel_t8122_clock(atcphy))
 		return apple_atc_dp_tunnel_rate_source(phy, 0, dpin, rate);
 	if (!apple_atc_tunnel_is_t8103_style()) {
 		bool valid_core = apple_atc_t602x_core_valid(atcphy->np, atcphy->res.core->start,
@@ -6385,6 +6452,10 @@ static int atcphy_resume(struct device *dev)
 	if (atcphy->t8132_common_owned && atcphy->host_active &&
 	    READ_ONCE(atcphy->pd_was_off))
 		dev_warn(dev, "power domain went off under an active USB3 link\n");
+	/* DP tunnel pixel clocks are then set up again at their next rate change. */
+	if (atcphy->tunnel_users && READ_ONCE(atcphy->pd_was_off))
+		dev_dbg(dev, "power domain went off across sleep under DP tunnel clocks (users %#x)\n",
+			atcphy->tunnel_users);
 	/*
 	 * A suspended PHY holds nothing, and its domain may drop again once system
 	 * resume completes: leave the restore to its next operation.
diff --git a/include/linux/soc/apple/dp-tunnel.h b/include/linux/soc/apple/dp-tunnel.h
index 540d48fe8e..1893337de5 100644
--- a/include/linux/soc/apple/dp-tunnel.h
+++ b/include/linux/soc/apple/dp-tunnel.h
@@ -50,7 +50,43 @@ static inline int apple_dp_tunnel_t6030_pclk(unsigned int source, unsigned int d
 	return dpin < 2 && (source == 0 || source == 2) ? (int)dpin : -EOPNOTSUPP;
 }
 
-/* T6030: keep the source owning the pixel clock across rate changes and stop. */
+/*
+ * T8132's external pipes are crossbar sources 2 (dcpext0) and 4 (dcpext1).
+ * Either feeds DP IN0 through DPTX PCLK1 and DP IN1 through PCLK2.
+ */
+static inline int apple_dp_tunnel_t8132_pclk(unsigned int source, unsigned int dpin)
+{
+	return dpin < 2 && (source == 2 || source == 4) ? (int)dpin : -EOPNOTSUPP;
+}
+
+/*
+ * T6030 and T8132 tunnel pixel clocks: the TX_DP_CTRL0 gates the DP IN
+ * streams in @users (bit n: DP IN n) need. DP IN 0 runs on PCLK1; DP IN 1 on
+ * PCLK2, and needs PCLK1 at its own rate as well: without it its video stops.
+ */
+#define APPLE_DP_TUNNEL_PCLK1	BIT(0)
+#define APPLE_DP_TUNNEL_PCLK2	BIT(1)
+
+static inline unsigned int apple_dp_tunnel_pclks(unsigned int users)
+{
+	return (users & 3 ? APPLE_DP_TUNNEL_PCLK1 : 0) |
+	       (users & 2 ? APPLE_DP_TUNNEL_PCLK2 : 0);
+}
+
+/*
+ * T8132: both DP IN streams of a PHY must run at one link rate, or the
+ * DP IN 1 stream stays dark. 0 if a stream may run at link rate code @rate
+ * next to the other stream's @other (0: none running), -EBUSY if not.
+ */
+static inline int apple_dp_tunnel_t8132_rate_ok(u8 rate, u8 other)
+{
+	return !rate || !other || rate == other ? 0 : -EBUSY;
+}
+
+/*
+ * T6030 and T8132: keep the source owning the pixel clock across rate changes
+ * and stop.
+ */
 int apple_atc_dp_tunnel_rate_source(struct phy *phy, unsigned int source,
 				    unsigned int dpin, u8 rate);
 
