From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 19:20:53 +0000
Subject: [PATCH] drm/apple: read the panel's thermal minimum cap from
 the ADT

The backlight node of an XDR panel's Apple device tree gives
thermal-mitigation-min-cap, in 16.16 nits: the lowest level macOS
caps the panel to under thermal mitigation (300 nits on the J604,
macOS 27.2). Keep it in whole nits next to the aurora maximum, for
the panel level guard that follows. Absent, it stays 0.

[j604] Value from the live J604 ADT (macOS 27.2): 300 nits.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/dcp-panel-adt-test.c | 22 +++++++++++++++++++++-
 drivers/gpu/drm/apple/dcp-panel-adt.c      |  2 ++
 drivers/gpu/drm/apple/dcp-panel-adt.h      |  6 ++++++
 3 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/apple/dcp-panel-adt-test.c b/drivers/gpu/drm/apple/dcp-panel-adt-test.c
index facf4954bf..1cc9309214 100644
--- a/drivers/gpu/drm/apple/dcp-panel-adt-test.c
+++ b/drivers/gpu/drm/apple/dcp-panel-adt-test.c
@@ -69,6 +69,7 @@ struct adt_spec {
 	u32 lmax;		/* 0: no LmaxProduct */
 	u32 aurora;		/* 0: no supports-aurora, else its value */
 	u32 aurora_nits;	/* 0: no aurora-maximum-nits, else binary32 bits */
+	u32 min_cap;		/* 0: no thermal-mitigation-min-cap, else 16.16 */
 	bool gamut_in_child;	/* the target one level too deep */
 };
 
@@ -95,7 +96,8 @@ static size_t adt_build(struct adt_buf *b, const struct adt_spec *s)
 	if (s->matrix)
 		adt_matrix(b, s->matrix, s->singular);
 
-	adt_node(b, 1 + !!s->headroom + !!s->lmax + !!s->aurora + !!s->aurora_nits, 0);
+	adt_node(b, 1 + !!s->headroom + !!s->lmax + !!s->aurora + !!s->aurora_nits +
+		 !!s->min_cap, 0);
 	adt_name(b, "backlight");
 	if (s->headroom)
 		adt_u32(b, "EDRPotentialHeadroom", s->headroom);
@@ -105,6 +107,8 @@ static size_t adt_build(struct adt_buf *b, const struct adt_spec *s)
 		adt_u32(b, "supports-aurora", s->aurora);
 	if (s->aurora_nits)
 		adt_u32(b, "aurora-maximum-nits", s->aurora_nits);
+	if (s->min_cap)
+		adt_u32(b, "thermal-mitigation-min-cap", s->min_cap);
 	return b->len;
 }
 
@@ -162,6 +166,21 @@ static void panel_adt_aurora_maximum(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, panel.aurora_max_nits, 0U);
 }
 
+/* The J604 thermal-mitigation-min-cap, 300 nits in 16.16; absent: 0. */
+static void panel_adt_thermal_min_cap(struct kunit *test)
+{
+	const struct adt_spec s = { .gamut = "P3", .matrix = 1, .lmax = 1600 << 16,
+				    .min_cap = 300 << 16 };
+	const struct adt_spec none = { .gamut = "P3", .matrix = 1, .lmax = 1600 << 16 };
+	struct dcp_panel_adt panel;
+
+	adt_parse(test, &s, &panel);
+	KUNIT_EXPECT_EQ(test, panel.thermal_min_cap, 300U);
+	KUNIT_EXPECT_EQ(test, panel.lmax_product, 1600U << 16);
+	adt_parse(test, &none, &panel);
+	KUNIT_EXPECT_EQ(test, panel.thermal_min_cap, 0U);
+}
+
 static void panel_adt_srgb(struct kunit *test)
 {
 	const struct adt_spec s = { .gamut = "sRGB", .matrix = 1 };
@@ -226,6 +245,7 @@ static struct kunit_case panel_adt_cases[] = {
 	KUNIT_CASE(panel_adt_p3_and_headroom),
 	KUNIT_CASE(panel_adt_peak),
 	KUNIT_CASE(panel_adt_aurora_maximum),
+	KUNIT_CASE(panel_adt_thermal_min_cap),
 	KUNIT_CASE(panel_adt_srgb),
 	KUNIT_CASE(panel_adt_target_needs_a_valid_v1_matrix),
 	KUNIT_CASE(panel_adt_unknown_or_misplaced_target),
diff --git a/drivers/gpu/drm/apple/dcp-panel-adt.c b/drivers/gpu/drm/apple/dcp-panel-adt.c
index c853bf31be..1a841b1755 100644
--- a/drivers/gpu/drm/apple/dcp-panel-adt.c
+++ b/drivers/gpu/drm/apple/dcp-panel-adt.c
@@ -197,6 +197,8 @@ static int dcp_adt_node(struct dcp_adt_cursor *c, struct dcp_panel_adt *panel,
 			aurora = get_unaligned_le32(prop + 36) == 1;
 		} else if (backlight && !strcmp(name, "aurora-maximum-nits") && size == 4) {
 			aurora_nits = dcp_adt_binary32_int(get_unaligned_le32(prop + 36));
+		} else if (backlight && !strcmp(name, "thermal-mitigation-min-cap") && size == 4) {
+			panel->thermal_min_cap = get_unaligned_le32(prop + 36) >> 16;
 		}
 		c->pos += 36 + ALIGN((size_t)size, 4);
 	}
diff --git a/drivers/gpu/drm/apple/dcp-panel-adt.h b/drivers/gpu/drm/apple/dcp-panel-adt.h
index 9396ac7da4..93f454e288 100644
--- a/drivers/gpu/drm/apple/dcp-panel-adt.h
+++ b/drivers/gpu/drm/apple/dcp-panel-adt.h
@@ -18,6 +18,12 @@ struct dcp_panel_adt {
 	 * is absent or off.
 	 */
 	u32 aurora_max_nits;
+	/*
+	 * /backlight thermal-mitigation-min-cap (16.16 nits, here whole nits):
+	 * the lowest the panel is capped to under thermal mitigation; 0 if
+	 * absent.
+	 */
+	u32 thermal_min_cap;
 	/* /product target, only when its calibration matrix is also valid */
 	enum dcp_panel_gamut gamut;
 	bool found;
