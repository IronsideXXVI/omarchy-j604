From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Fri, 13 Nov 2026 01:35:40 +1100
Subject: [PATCH] selftests: apple-dcp, apple-afkv2: kvzalloc() and
 kvfree() for the call buffers

The AFK service call and audio osobject call buffers now come from
kvzalloc(); give the host harnesses that compile those functions the
same calloc()/free() shims they have for kzalloc().

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 tools/testing/selftests/drivers/gpu/apple-afkv2/extract-edid.py | 2 ++
 tools/testing/selftests/drivers/gpu/apple-afkv2/extract-hpd.py  | 2 ++
 .../selftests/drivers/gpu/apple-afkv2/extract-service.py        | 2 ++
 tools/testing/selftests/drivers/gpu/apple-dcp/audio.py          | 2 +-
 4 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/tools/testing/selftests/drivers/gpu/apple-afkv2/extract-edid.py b/tools/testing/selftests/drivers/gpu/apple-afkv2/extract-edid.py
index bcced2f684..5448555012 100644
--- a/tools/testing/selftests/drivers/gpu/apple-afkv2/extract-edid.py
+++ b/tools/testing/selftests/drivers/gpu/apple-afkv2/extract-edid.py
@@ -27,6 +27,8 @@ prefix = r'''
 #include "epic/dpavserv-edid.h"
 #define GFP_KERNEL 0
 #define kzalloc(n,f) calloc(1,n)
+#define kvzalloc(n,f) calloc(1,n)
+#define kvfree(p) free(p)
 #define cpu_to_le64(x) (x)
 #define le64_to_cpu(x) (x)
 #define READ_ONCE(x) (x)
diff --git a/tools/testing/selftests/drivers/gpu/apple-afkv2/extract-hpd.py b/tools/testing/selftests/drivers/gpu/apple-afkv2/extract-hpd.py
index b21cba6c76..7a9881784a 100644
--- a/tools/testing/selftests/drivers/gpu/apple-afkv2/extract-hpd.py
+++ b/tools/testing/selftests/drivers/gpu/apple-afkv2/extract-hpd.py
@@ -36,6 +36,8 @@ prefix = r'''
 typedef u32 __le32;
 #define GFP_KERNEL 0
 #define kzalloc(n,f) calloc(1,n)
+#define kvzalloc(n,f) calloc(1,n)
+#define kvfree(p) free(p)
 #define kfree(p) free(p)
 #define max(a,b) ((a)>(b)?(a):(b))
 #define min(a,b) ((a)<(b)?(a):(b))
diff --git a/tools/testing/selftests/drivers/gpu/apple-afkv2/extract-service.py b/tools/testing/selftests/drivers/gpu/apple-afkv2/extract-service.py
index 19381f919d..4c0164dce1 100644
--- a/tools/testing/selftests/drivers/gpu/apple-afkv2/extract-service.py
+++ b/tools/testing/selftests/drivers/gpu/apple-afkv2/extract-service.py
@@ -24,6 +24,8 @@ prefix = r'''
 #define GFP_KERNEL 0
 #define kzalloc(n,f) calloc(1,n)
 #define kfree(p) free(p)
+#define kvzalloc(n,f) calloc(1,n)
+#define kvfree(p) free(p)
 #define max(a,b) ((a)>(b)?(a):(b))
 #define min(a,b) ((a)<(b)?(a):(b))
 #define cpu_to_le16(x) (x)
diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/audio.py b/tools/testing/selftests/drivers/gpu/apple-dcp/audio.py
index 44e2bd9768..8b0af0f255 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/audio.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/audio.py
@@ -24,7 +24,7 @@ typedef uint64_t __le64;
 #define GFP_KERNEL 0
 static void free_buffer(void *p) {free(*(void **)p);}
 #define __free(x) __attribute__((cleanup(free_buffer)))
-static void *kzalloc(size_t n, int flags) {(void)flags;return calloc(1,n);}
+static void *kvzalloc(size_t n, int flags) {(void)flags;return calloc(1,n);}
 #define cpu_to_le64(x) (x)
 #define le64_to_cpu(x) (x)
 struct apple_dcp_afkep {bool compact;};
-- 
2.43.0

