+/// Storage of `g16_unit_large_lazy` (runtime 0644, default 0; read when a VM builds its first
+/// render units).
+static UNIT_LARGE_LAZY: AtomicU32 = AtomicU32::new(0);
+
+/// `g16_unit_large_lazy` 1: render units 0 and 1 get a 1 MiB TPC and a 1 MiB tilemap at their
+/// usual addresses instead of 16 / 8 MiB; the first render no unit's own set fits builds a
+/// 16 MiB TPC and an 8 MiB tilemap for unit 0 (in SUBMIT, before publication), which unit 0
+/// then uses for the life of the arena. Read when a VM builds its first render units, so VMs
+/// that already rendered keep the units they have.
+pub(crate) fn unit_large_lazy() -> bool {
+    UNIT_LARGE_LAZY.load(Ordering::Relaxed) == 1
+}
+
+live_u32_param!(
+    UNIT_LARGE_LAZY_PARAM,
+    UNIT_LARGE_LAZY_PARMTYPE,
+    UNIT_LARGE_LAZY_PARM,
+    UNIT_LARGE_LAZY,
+    "g16_unit_large_lazy",
+    "G16: 1 = render units 0/1 start with a 1 MiB TPC and tilemap; unit 0 builds the full set on demand (default 0; read when a VM builds its first render units; runtime 0644)"
+);
+
