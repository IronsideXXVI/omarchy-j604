+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! A render unit built after a VM's first render, in a slot that can be emptied again
+//! (`g16_unit_trim`).
+//!
+//! The arena's later units used to sit in `SetOnce` slots: filled once, never emptied, read
+//! without a lock. This slot keeps those reads (an acquire load, then a shared reference) and
+//! adds `take`, which empties it. The rules, kept by resources.rs:
+//! - One writer at a time fills a slot: the SUBMIT path under the VM's resource mutex, or the
+//!   one build worker the arena's `building` flag admits.
+//! - `take` runs only under that mutex, with `building` held and no render command of the VM
+//!   outstanding. Every reader of a unit outside resources.rs reaches it through a job of the
+//!   VM (publication, retirement, statistics of a flight), so no reader exists then.
+
+use core::cell::UnsafeCell;
+use core::sync::atomic::{AtomicBool, Ordering};
+
+/// One later unit of a render arena: empty, then filled, and possibly emptied again.
+pub(crate) struct UnitSlot<T> {
+    full: AtomicBool,
+    cell: UnsafeCell<Option<T>>,
+}
+
+// SAFETY: the value is written only while no reader exists (see the module rules) and read
+// through shared references after an acquire load of `full`.
+unsafe impl<T: Send + Sync> Sync for UnitSlot<T> {}
+// SAFETY: as above; the slot owns its value.
+unsafe impl<T: Send> Send for UnitSlot<T> {}
+
+impl<T> UnitSlot<T> {
+    pub(crate) const fn new() -> Self {
+        Self {
+            full: AtomicBool::new(false),
+            cell: UnsafeCell::new(None),
+        }
+    }
+
+    /// The unit, if the slot holds one.
+    pub(crate) fn as_ref(&self) -> Option<&T> {
+        if !self.full.load(Ordering::Acquire) {
+            return None;
+        }
+        // SAFETY: `full` is set only after the value was written, and the value is replaced
+        // only by `take`, which no reader can overlap.
+        unsafe { (*self.cell.get()).as_ref() }
+    }
+
+    /// Fills an empty slot. False (and `value` dropped) when it already holds a unit.
+    pub(crate) fn populate(&self, value: T) -> bool {
+        if self.full.load(Ordering::Acquire) {
+            return false;
+        }
+        // SAFETY: one writer at a time (module rules), and no reader looks at an empty slot.
+        unsafe { *self.cell.get() = Some(value) };
+        self.full.store(true, Ordering::Release);
+        true
+    }
+
+    /// Empties the slot and returns its unit.
+    ///
+    /// # Safety
+    ///
+    /// No reference returned by `as_ref` may be alive, and no other thread may call any method
+    /// of this slot until `take` returns (the module rules).
+    #[cfg(test)]
+    pub(crate) unsafe fn take(&self) -> Option<T> {
+        self.full.store(false, Ordering::Release);
+        // SAFETY: the caller guarantees exclusive access.
+        unsafe { (*self.cell.get()).take() }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn empty_filled_emptied_filled() {
+        let s: UnitSlot<u32> = UnitSlot::new();
+        assert!(s.as_ref().is_none());
+        assert!(s.populate(7));
+        assert_eq!(s.as_ref(), Some(&7));
+        // A racing second build is refused and leaves the first unit in place.
+        assert!(!s.populate(8));
+        assert_eq!(s.as_ref(), Some(&7));
+        // SAFETY: single-threaded test, no reference alive.
+        assert_eq!(unsafe { s.take() }, Some(7));
+        assert!(s.as_ref().is_none());
+        // SAFETY: as above.
+        assert_eq!(unsafe { s.take() }, None);
+        assert!(s.populate(9));
+        assert_eq!(s.as_ref(), Some(&9));
+    }
+
+    #[test]
+    fn take_drops_nothing_twice() {
+        use std::rc::Rc;
+        let v = Rc::new(1);
+        let s = UnitSlot::new();
+        assert!(s.populate(v.clone()));
+        assert_eq!(Rc::strong_count(&v), 2);
+        // SAFETY: single-threaded test.
+        let t = unsafe { s.take() };
+        assert_eq!(Rc::strong_count(&v), 2);
+        drop(t);
+        assert_eq!(Rc::strong_count(&v), 1);
+        drop(s);
+        assert_eq!(Rc::strong_count(&v), 1);
+    }
+}
