+    /// `g16_unit_large_lazy`: builds unit 0's large set when a render of `commands` fits no
+    /// unit's own set but fits the large one. Called in SUBMIT under the VM's resource lock.
+    fn large_for(&self, factory: &Factory, vm: &mmu::Vm, commands: &[Command]) {
+        let Some(p0) = self.passes.first() else {
+            return;
+        };
+        if !p0.large_lazy || p0.large.as_ref().is_some() {
+            return;
+        }
+        if !self.large_wanted(commands) {
+            return;
+        }
+        LARGE_STATS[3].fetch_add(1, Ordering::Relaxed);
+        let start = super::engine::now_ns();
+        let r = Self::large_objects_new(factory, vm).and_then(|mut objects| {
+            p0.build_large(&mut objects)?;
+            objects.finish_private()?;
+            Ok(objects)
+        });
+        if let Ok(objects) = r {
+            // The mappings live with the arena, as the first units' do.
+            let _ = self.large_objects.populate(Some(objects));
+            LARGE_STATS[0].fetch_add(1, Ordering::Relaxed);
+            LARGE_STATS[2].fetch_add(
+                super::engine::now_ns().wrapping_sub(start),
+                Ordering::Relaxed,
+            );
+        } else {
+            LARGE_STATS[1].fetch_add(1, Ordering::Relaxed);
+        }
+    }
+
+    /// `g16_unit_large_lazy`: true when a render of `commands` fits no unit's own set but fits
+    /// the large one. Out of line, so its geometry stays off the frame of `large_for`.
+    #[inline(never)]
+    fn large_wanted(&self, commands: &[Command]) -> bool {
+        let units = self.unit_count();
+        commands.iter().any(|c| match c {
+            Command::Render(r) => {
+                let g = super::encode::Geometry::new(&r.cmd, 0);
+                (0..units).filter_map(|k| self.pass(k)).all(|p| {
+                    g.validate_capacity(p.tpc().size as u64, p.tilemap().size as u64)
+                        .is_err()
+                }) && g
+                    .validate_capacity(super::hw::client::TPC_SIZE, super::hw::client::TILEMAP_SIZE)
+                    .is_ok()
+            }
+            _ => false,
+        })
+    }
+
+    /// `g16_unit_large_lazy`: the object set for unit 0's large set, built on the heap. Out of
+    /// line, so the set itself never sits on the frame of `large_for`.
+    #[inline(never)]
+    fn large_objects_new(factory: &Factory, vm: &mmu::Vm) -> Result<KBox<Objects>> {
+        // Allocated first and initialised field by field in place: no Objects on this frame.
+        let mut objects = KBox::<Objects>::new_uninit(GFP_KERNEL)?;
+        factory.objects_into(vm, &mut objects);
+        // SAFETY: `objects_into` initialised every field of `objects`.
+        Ok(unsafe { objects.assume_init() })
+    }
     pub(crate) fn set_dirty(&self, k: usize, tpc: u64, tilemap: u64) -> Result {
         let pass = self.pass(k).ok_or(EINVAL)?;
-        if tpc > pass.tpc.size as u64 || tilemap > pass.tilemap.size as u64 {
+        if tpc > pass.tpc().size as u64 || tilemap > pass.tilemap().size as u64 {
             return Err(E2BIG);
         }
         self.tpc_dirty[k].fetch_max(tpc, Ordering::Relaxed);
@@ -485,6 +554,9 @@ pub(crate) fn prepare(&self, vm: &Arc<VmState>, commands: &[Command]) -> Result<
                 } else if want && !arena.building.load(Ordering::Acquire) {
                     let _ = arena.extend(&self.factory, &vm.vm, built);
                 }
+                // g16_unit_large_lazy: unit 0's large set for a render no unit's set fits.
+                // Under the VM's resource lock; the set is populated once.
+                arena.large_for(&self.factory, &vm.vm, commands);
                 if super::params::pb_lazy().is_some() {
                     arena.grow_pb(&self.factory, &vm.vm);
                 }
