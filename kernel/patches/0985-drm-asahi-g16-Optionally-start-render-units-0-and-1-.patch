+    /// [`Factory::objects`] written field by field into `out`, so no whole [`Objects`] value is
+    /// built on the caller's frame. Every field of `out` is initialised when this returns.
+    pub(crate) fn objects_into(&self, vm: &mmu::Vm, out: &mut MaybeUninit<Objects>) {
+        // Does not compile when a field is added to `Objects` and not written below.
+        #[allow(dead_code)]
+        fn all_fields(o: &Objects) {
+            let Objects {
+                dev: _,
+                uat: _,
+                window: _,
+                private: _,
+                sealed: _,
+                fw_next: _,
+                retained: _,
+                clients: _,
+                mappings: _,
+                error: _,
+                pages: _,
+                backing_limit: _,
+                client_align_shift: _,
+                backing_charged: _,
+            } = o;
+        }
+        let p = out.as_mut_ptr();
+        // SAFETY: `p` comes from `out`, so it is valid, aligned and exclusive for one `Objects`.
+        // Each field is written exactly once through `addr_of_mut!`, which neither reads nor
+        // drops the uninitialised old value.
+        unsafe {
+            addr_of_mut!((*p).dev).write(self.dev.clone());
+            addr_of_mut!((*p).uat).write(self.uat.clone());
+            addr_of_mut!((*p).window).write(self.window.clone());
+            addr_of_mut!((*p).private).write(Some(Private {
+                vm: vm.clone(),
+                firmware: self.firmware.clone(),
+                pending: None,
+            }));
+            addr_of_mut!((*p).sealed).write(false);
+            addr_of_mut!((*p).fw_next).write(self.firmware.start);
+            addr_of_mut!((*p).retained).write(KVec::new());
+            addr_of_mut!((*p).clients).write(KVec::new());
+            addr_of_mut!((*p).mappings).write(KVec::new());
+            addr_of_mut!((*p).error).write(None);
+            addr_of_mut!((*p).pages).write(0);
+            addr_of_mut!((*p).backing_limit).write(usize::MAX);
+            addr_of_mut!((*p).client_align_shift).write(PAGE_SHIFT);
+            addr_of_mut!((*p).backing_charged).write(0);
+        }
+    }
 }
 
