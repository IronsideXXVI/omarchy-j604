From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 11:27:20 +0000
Subject: [PATCH] drm/asahi: g16: Keep the engine statistics off the
 probe stack

Firmware::start_backend builds the engine and the other backend parts
by value before moving them into the boxed Firmware, so every byte of
the engine is held on its frame, more than once. The engine statistics
are several KiB of counters and histograms, and with the recent
additions the frame grew from about 19 KiB to about 23 KiB. Together
with the probe path above it, that exceeded the 32 KiB kernel stack and
the kernel panicked with a stack overflow while the driver probed.

Allocate the statistics in a box of their own, made in a small
non-inlined helper, so the engine that start_backend moves carries
only a pointer.

Fixes: 9037de9b1b8a ("drm/asahi: g16: Count how deep each queue is when a job arrives")
Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/engine.rs | 19 ++++++++++++++-----
 drivers/gpu/drm/asahi/g16/poll.rs   |  8 ++++----
 2 files changed, 18 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 78f84e6f9d..7edc9fb3a7 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -518,6 +518,13 @@ fn new() -> Result<Self> {
     <&mut [u8; N]>::try_from(&mut v[..]).map_err(|_| EINVAL)
 }
 
+/// Allocates the engine statistics. Not inlined, so the zeroed temporary lives in this
+/// short-lived frame and never in the probe path's long-lived ones.
+#[inline(never)]
+fn new_stats() -> Result<KBox<Stats>> {
+    KBox::new(Stats::default(), GFP_KERNEL).map_err(|_| ENOMEM)
+}
+
 /// Engine state.
 pub(crate) struct Engine {
     /// Runnable jobs of every queue, in arrival order.
@@ -559,7 +566,9 @@ pub(crate) struct Engine {
     /// Progress tracking of the oldest prefix.
     pub(crate) progress_flight: u64,
     pub(crate) progress: [Option<u32>; 3],
-    pub(crate) stats: Stats,
+    /// Boxed: the statistics are several KiB, and the engine is built by value on the probe
+    /// path (Firmware::start_backend), whose frame must stay small.
+    pub(crate) stats: KBox<Stats>,
     /// Phase timers (debug_flags bit 49).
     pub(crate) prof: Prof,
     /// The `aurora-g16/stats` file.
@@ -602,7 +611,7 @@ pub(crate) fn new() -> Result<Self> {
             pass_checked: false,
             progress_flight: 0,
             progress: [None; 3],
-            stats: Stats::default(),
+            stats: new_stats()?,
             prof: Prof::default(),
             debugfs: None,
             // Allocate host encoder buffers before any submitted fence can depend on
@@ -687,7 +696,7 @@ fn subgen_bump(&mut self, pipe: usize) {
             if cell == 0 {
                 continue;
             }
-            let s = &mut self.engine.stats;
+            let s = &mut *self.engine.stats;
             match self.session.regs.bump_generation_cell(cell) {
                 Ok((before, mirror)) => {
                     if let Some(n) = s.subgen_bumps.get_mut(pipe) {
@@ -926,7 +935,7 @@ pub(crate) fn enqueue(&mut self, job: Arc<Job>) -> Result {
         let i = q.owned_index.fetch_add(1, Ordering::Relaxed) as usize % q.owned.len();
         q.owned[i].store(owned.min(255), Ordering::Relaxed);
         let now = now_ns();
-        let s = &mut self.engine.stats;
+        let s = &mut *self.engine.stats;
         s.arrive_owned[(owned as usize).min(15)] += 1;
         if s.arrive_last_ns != 0 {
             let bin = (now.saturating_sub(s.arrive_last_ns) / 10_000).min(31) as usize;
@@ -1806,7 +1815,7 @@ fn prefix_render(
 
     /// Records the publication time of `f` and the preparation, gap and starvation times.
     fn stat_publish(&mut self, f: &mut Flight) {
-        let s = &mut self.engine.stats;
+        let s = &mut *self.engine.stats;
         s.pub_ns = now_ns();
         f.published_ns = s.pub_ns;
         f.published_ticks = counter_ticks();
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 9f61263b43..dee9fb3e27 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -337,7 +337,7 @@ pub(crate) fn poll(&mut self, evented: bool, done: &mut Completions) -> Result<b
         // Not left set when publish() returned before taking it (system sleep).
         self.engine.pass_checked = false;
         lap.lap(&mut self.engine.prof.publish_ns);
-        let s = &mut self.engine.stats;
+        let s = &mut *self.engine.stats;
         if self.engine.flights.is_empty() && s.idle_from_ns != 0 {
             // Idle with nothing ready is not a gap: the clients are late.
             s.starve_from_ns = s.idle_from_ns;
@@ -810,7 +810,7 @@ pub(crate) fn retire_oldest(
         if p.next() < p.sent() || p.sent() < p.count() {
             return; // more of it published or still to publish
         }
-        let s = &mut self.engine.stats;
+        let s = &mut *self.engine.stats;
         if result.is_ok() {
             s.jobs += 1;
             s.job_cmds += u64::from(p.count());
@@ -932,7 +932,7 @@ fn stat_retire(&mut self, f: &Flight) {
         };
         let (mut lo, mut hi) = (u64::MAX, 0u64);
         let (mut first, mut last) = (u64::MAX, 0u64);
-        let s = &mut self.engine.stats;
+        let s = &mut *self.engine.stats;
 
         // Add one stage interval read from internal timestamp cells (start, end).
         let mut stage = |o: &super::object::FwObject,
@@ -1153,7 +1153,7 @@ pub(crate) fn report(&self, what: &str) {
 
     /// The `aurora-g16/stats` contents. Scripts parse the keys: keep them stable.
     pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
-        let s = &self.engine.stats;
+        let s = &*self.engine.stats;
         let slots = &self.slots.stats;
         let (recoveries, hang_kills) = self.recovery_counts();
         let us = |ns: u64| ns / 1000;
-- 
