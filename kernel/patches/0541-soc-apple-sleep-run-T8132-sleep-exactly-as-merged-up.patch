-#define T8132_STUBCFG_CANARY	0x5354415449433031ULL	/* "STATIC01" */
-/* In .data, with a link-time canary next to the commit-time magic (the probe reads both). */
-struct t8132_stubcfg t8132_stubcfg __aligned(64) = { .canary = T8132_STUBCFG_CANARY };
