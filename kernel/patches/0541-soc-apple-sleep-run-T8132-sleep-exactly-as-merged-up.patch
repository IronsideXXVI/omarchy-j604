-		p = j604_p_cluster_pwrgate(s);
-		was = readl(p);
-		writel(was | PWRGATE_ON, p);
-		dev_info(s->dev, "P cluster power-gate enable at pwrgate + %#x: %#010x, wrote %#010x, reads %#010x\n",
-			 s->soc->pwrgate_wake[1], was, was | PWRGATE_ON, readl(p));
-	}
