-/* PA of a table entry pointer: swapper_pg_dir is in the image, the rest in the linear map. */
-static u64 t8132_elchk2_pa(const void *p)
-{
-	unsigned long v = (unsigned long)p;
-
-	return __is_lm_address(v) ? __pa(v) : __pa_symbol(v);
