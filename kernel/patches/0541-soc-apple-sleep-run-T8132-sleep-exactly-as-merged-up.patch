+ * under aura.
  *
  * What's left out on purpose, because the same trace shows macOS doesn't write it in
- * this window: DVFM, CLLT, DCS, PTD and an AVE complex, and the AMCC error enables (no error
- * turned a T8132 sleep around under the hypervisor). The SoC's perf word at clk-perf is
- * left out too; that page wasn't hooked, so the trace says nothing about it.
+ * this window: DVFM, CLLT, PTD and an AVE complex, and the AMCC error enables (no error
+ * turned a T8132 sleep around under the hypervisor).
  *
- * A hang from here ends at the watchdog, as on T8140.
- */
-/* The kernel's writable image, the per-CPU areas and where cpu_resume finds its context. */
-static void t8132_clean_ram(void)
-{
-	unsigned long base = (unsigned long)sleep_save_stash;
-	unsigned int cpu;
-
-	dcache_clean_poc((unsigned long)_sdata, (unsigned long)_end);
-	for_each_possible_cpu(cpu) {
-		unsigned long area = (unsigned long)__per_cpu_start + per_cpu_offset(cpu);
-
-		dcache_clean_poc(area, area + (__per_cpu_end - __per_cpu_start));
-	}
-	dcache_clean_poc(base, base + mpidr_hash_size() * sizeof(*sleep_save_stash));
-	dsb(sy);
-}
-
-/*
- * A PA for a kernel VA: the kernel image (inside the vmalloc range on arm64, but block
- * mapped), the vmap'd stack, or the linear map.
- */
-static phys_addr_t sleep_check_pa(const void *va)
-{
-	unsigned long a = (unsigned long)va;
-
-	if (a >= (unsigned long)_text && a < (unsigned long)_end)
-		return __pa_symbol(a);
-	if (is_vmalloc_addr(va))
-		return page_to_phys(vmalloc_to_page(va)) + offset_in_page(va);
-	return virt_to_phys(va);
-}
-
-static void sleep_check_add(struct aura_s2r_check *c, const void **va, const void *p,
-			    size_t len)
-{
-	unsigned int n = c->nranges;
-
-	if (n >= AURA_S2R_CHECK_RANGES || !len)
-		return;
-	va[n] = p;
-	c->range[n].pa = sleep_check_pa(p);
-	c->range[n].len = len;
-	c->nranges = n + 1;
-}
-
-/*
- * What a wake needs first, and a fresh pattern, for aura to check before it takes
- * resume_pa: the resume stub's 4 KiB, this CPU's saved cpu_suspend() context (in
- * cpu_suspend()'s frame, written before the commit and not again until cpu_resume reads
- * it), a 4 KiB pattern written now, and the stash that points cpu_resume at the context.
- * None of them changes after this. Last before the commit's own cleaning.
- */
-static void t8132_arm_dram_check(struct apple_sleep *s)
-{
-	struct aura_s2r_check *c = s->mbox_check;
-	unsigned long stack = (unsigned long)task_stack_page(current);
-	unsigned long stub = (unsigned long)t8132_resume_vectors;
-	unsigned long stub_end = ALIGN((unsigned long)t8132_resume_end, SZ_4K);
-	const size_t ctx_len = sizeof(struct sleep_stack_data);
-	const void *va[AURA_S2R_CHECK_RANGES];
-	unsigned long ctx = 0;
-	u64 *word = s->check_pattern;
-	u64 x = get_cycles() | 1;
-	unsigned int i;
-	u32 crc = ~0U;
-
-	s->check_ranges = 0;
-	if (!c)
-		return;
-
-	WRITE_ONCE(c->magic, 0);
-	c->nranges = 0;
-	/* The vectors start a page; everything the stub runs is between them and the end. */
-	if (stub & (SZ_4K - 1) || (unsigned long)t8132_resume_stub < stub ||
-	    stub_end <= (unsigned long)t8132_resume_stub || stub_end - stub > 3 * SZ_4K) {
-		stub = (unsigned long)t8132_resume_stub & ~(SZ_4K - 1UL);
-		stub_end = stub + SZ_4K;
-	}
-	sleep_check_add(c, va, (void *)stub, stub_end - stub);
-	/* Written at .prepare_late: only what nothing writes before the wake. */
-	if (s->wake_prep) {
-		sleep_check_add(c, va, __idmap_text_start,
-				(__idmap_text_end - __idmap_text_start) & ~3UL);
-		goto crc;
-	}
-
-	for (i = 0; i < mpidr_hash_size(); i++) {
-		unsigned long v = sleep_save_stash[i];
-
-		if (v >= stack && v + ctx_len <= stack + THREAD_SIZE) {
-			ctx = v;
-			break;
-		}
-	}
-	if (ctx) {
-		size_t first = min_t(size_t, ctx_len, PAGE_SIZE - offset_in_page(ctx));
-
-		sleep_check_add(c, va, (void *)ctx, first);
-		sleep_check_add(c, va, (void *)(ctx + first), ctx_len - first);
-	}
-
-	for (i = 0; i < SZ_4K / sizeof(*word); i++) {
-		x ^= x << 13;
-		x ^= x >> 7;
-		x ^= x << 17;
-		word[i] = x;
-	}
-	/* A second copy of the stub config, where the check proves it arrives. */
-	if (READ_ONCE(t8132_stubcfg.magic))
-		memcpy(word, &t8132_stubcfg, sizeof(t8132_stubcfg));
-	sleep_check_add(c, va, word, SZ_4K);
-	sleep_check_add(c, va, sleep_save_stash, mpidr_hash_size() * sizeof(*sleep_save_stash));
-
-crc:
-	for (i = 0; i < c->nranges; i++)
-		crc = crc32_le(crc, va[i], c->range[i].len);
-	c->crc32 = ~crc;
-	dsb(ishst);
-	WRITE_ONCE(c->magic, AURA_S2R_CHECK_MAGIC);
-
-	for (i = 0; i < c->nranges; i++)
-		dcache_clean_poc((unsigned long)va[i], (unsigned long)va[i] + c->range[i].len);
-	dcache_clean_poc((unsigned long)s->mbox, (unsigned long)s->mbox + AURA_S2R_CHECKED_SIZE);
-	dsb(sy);
-	s->check_crc = c->crc32;
-	s->check_ranges = c->nranges;
-}
-
-/* The two ranges as the stub reads them: whole words, from each start. */
-static void t8132_el_ranges(const u8 **base, u32 *len)
-{
-	base[0] = (const u8 *)__idmap_text_start;
-	len[0] = (__idmap_text_end - __idmap_text_start) & ~3UL;
-	base[1] = (const u8 *)__mmuoff_data_start;
-	len[1] = (__mmuoff_data_end - __mmuoff_data_start) & ~3UL;
-}
-
-static bool t8132_el_check_fits(const u32 *len)
-{
-	return len[0] && len[1] &&
-	       DIV_ROUND_UP(len[0], T8132_ELCHK_CHUNK) + DIV_ROUND_UP(len[1], T8132_ELCHK_CHUNK) <=
-	       T8132_ELCHK_MAX;
-}
-
-/*
- * After arm64_resume_armed, last before the commit: nothing writes either range from
- * here to the stub. Read through the kernel's mapping; nothing is cleaned for it.
- */
-static void t8132_arm_el_check(void)
-{
-	struct t8132_elchk *e = &t8132_elchk;
