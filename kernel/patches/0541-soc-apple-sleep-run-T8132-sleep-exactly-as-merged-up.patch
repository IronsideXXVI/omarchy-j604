-/*
- * Stub instruments, each off unless its apple_sleep param is set (0644, read at each
- * commit, written here and cleaned to the PoC for the stub to read by PA):
- * bit 0 t8132_stub_mask_daif: mask DAIF right after reading it;
- * bit 1 t8132_stub_entry_rec: write the entry state to PMU scratch once WD2 runs:
- *       0xf805 = DAIF[9:6] | CurrentEL << 4, 0xf806-0xf809 = SCTLR_EL2[31:0],
- *       0xf80a-0xf80e = CNTPCT[39:0], then 0x3e in 0xf804 (a later catch or check
- *       record overwrites it);
- * bit 2 t8132_stub_selftest: udf right after the catch vectors go in (a sync record,
- *       EC 0, and the 145 s window prove the catch on a real wake);
- * bit 3 t8132_stub_pet_secs (1-120): before the jump, stay that long restarting WD2
- *       for 30 s every second, then go on;
- * bit 4 t8132_stub_sctlr: right before the jump, SCTLR_EL2 = INIT_SCTLR_EL2_MMU_OFF and
- *       isb (aura never writes it on a wake, and cpu_resume's x0 = 0 makes init_el2
- *       skip it too, so the wake core otherwise runs on the reset value);
- * bit 5 t8132_stub_early_wake: before the SCTLR step, the first writes of macOS's own
- *       wake (J713 trace, aura#109) by PA: cluster E on (0x380780000 <- 0xf), its READY
- *       polled for up to 5 ms, cluster P on (+4), then the power-gate wake words
- *       (0x380724000 and +0x60 <- 0x80000000). apple_sleep_return() writes the same
- *       words again later, with the MMU on.
- * bit 6 t8132_stub_ladder: right after the entry record, one read at a time, each
- *       followed by its own WD2 window: a byte of .idmap.text by PA, then 140 s; a
- *       byte of .mmuoff.data, 150 s; a byte of _stext (the far end of the image), 87.5 s;
- *       a byte of a page outside the image (allocated at probe, PA logged), 97.5 s; then
- *       elchk as before (75 s once it passed). The first window that never comes names
- *       the first read that did not return.
- * bit 9 t8132_stub_wake_first: the bit 5 writes (CLUSTER_E on and polled, CLUSTER_P on, both
- *       pwrgate wake words) as the stub's first action, before the vectors and the 60 s WD2
- *       write: macOS raises the clusters first on every J604 wake (hv trace).
- * bit 8 t8132_stub_harden: first, before the vectors go in: DAIF all masked again, the VM
- *       timer FIQ enable (s3_5_c15_c1_3) cleared, tlbi alle2, ic iallu, dsb sy, isb: what
- *       SPTM's warm entry does before its MMU-on on the J604 (macOS 26B123, TB).
- * bit 7 t8132_stub_regs: right after the ladder, the woken core's own CTRR_D (CTL
- *       s3_0_c11_c1_5, bounds s3_0_c11_c1_2/3) and CTXR_D (CTL s3_0_c11_c5_5, bounds
- *       s3_0_c11_c3_0/1) against the PA of .idmap.text, as WD2 = 20 + 15 * code s, then
- *       the stub parks (no resume): code bit 0 CTRR_D enabled, bit 1 CTRR_D covers it,
- *       bit 2 CTXR_D armed with .idmap.text outside its window. A measurement run only.
- */
-#define T8132_STUBCFG_MAGIC	0x47464353	/* "SCFG" */
-
-struct t8132_stubcfg {
-	u32 magic;
-	u32 flags;
-	u32 pet_secs;
-	u32 rsvd;
-	u64 sctlr;		/* INIT_SCTLR_EL2_MMU_OFF */
-	u64 ladder_pa;		/* the ladder's page outside the image, 0 = skip that read */
-	u64 canary;		/* link time, never written: T8132_STUBCFG_CANARY */
-};
-
