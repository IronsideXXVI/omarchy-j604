-/* With t8132_pwrgate_adt, at probe: each write, then its read-back. */
-static void j604_adt_pwrgate_write(struct apple_sleep *s)
-{
-	unsigned int set = READ_ONCE(t8132_pwrgate_adt);
-	void __iomem *p;
-	u32 was, val;
-	int i;
-
-	if (!s->adt_pg[0] || !set)
-		return;
-	for (i = 0; (set & J604_PWRGATE_ADT_WORDS) && i < ARRAY_SIZE(j604_adt_pwrgate); i++) {
-		was = readl(s->adt_pg[i]);
-		val = (was & ~j604_adt_pwrgate[i].mask) | J604_ADT_PWRGATE_VALUE;
-		writel(val, s->adt_pg[i]);
-		dev_info(s->dev, "ADT pwrgate word %d at %pa: %#010x, wrote %#010x, reads %#010x\n",
-			 i + 1, &j604_adt_pwrgate[i].pa, was, val, readl(s->adt_pg[i]));
-	}
