-static_assert(offsetof(struct t8132_stubcfg, pet_secs) == 8);
-static_assert(offsetof(struct t8132_stubcfg, sctlr) == 16);
-static_assert(offsetof(struct t8132_stubcfg, ladder_pa) == 24);
-static_assert(offsetof(struct t8132_stubcfg, canary) == 32);
