-/*
- * apple_sleep.t8132_commit_clean (0644, read at .prepare, default 0 = as before):
- * t8132_clean_ram() cleans to the PoC only the writable image, the per-CPU areas and the
- * stash; the rest relies on the hardware writing its caches back at the collapse. Bit 0
- * also cleans _stext.._etext and the swapper pages on the walks to _cpu_resume and
- * sleep_save_stash. Bit 1 cleans every System RAM range
- * through the linear map (memblock, no-map ranges left out), the other cores stopped, then
- * t8132_clean_ram() again for what that dirtied. Bit 1 is also timed once at each .prepare.
- */
-static unsigned int t8132_commit_clean;
-module_param(t8132_commit_clean, uint, 0644);
-MODULE_PARM_DESC(t8132_commit_clean,
-		 "T8132 bring-up: 1 = also clean text and its tables to the PoC at the commit, 2 = all System RAM");
-
-static void t8132_clean_text_tables(void)
-{
-	u64 pa[T8132_ELCHK2_TAB_MAX];
-	unsigned int n, i;
-
-	dcache_clean_poc((unsigned long)_stext, (unsigned long)_etext);
-	n = t8132_elchk2_tables((unsigned long)_cpu_resume, pa, 0);
-	n = t8132_elchk2_tables((unsigned long)&sleep_save_stash, pa, n);
-	for (i = 0; i < n; i++) {
-		unsigned long va = (unsigned long)phys_to_virt(pa[i]);
-
-		dcache_clean_poc(va, va + PAGE_SIZE);
-	}
-	dsb(sy);
-}
-
-/* Returns the bytes covered. With @resched, in 64 MiB steps that may sleep (process context). */
-static u64 t8132_clean_all_ram(bool resched)
-{
-	phys_addr_t start, end;
-	u64 i, bytes = 0;
-
-	for_each_mem_range(i, &start, &end) {
-		unsigned long va = (unsigned long)__va(start), e = (unsigned long)__va(end);
-
-		bytes += end - start;
-		while (va < e) {
-			unsigned long n = min_t(unsigned long, e - va, SZ_64M);
-
-			dcache_clean_poc(va, va + n);
-			va += n;
-			if (resched)
-				cond_resched();
-		}
-	}
-	dsb(sy);
-	return bytes;
-}
-
-static void t8132_clean_extra(struct apple_sleep *s)
-{
-	u64 t0 = __arch_counter_get_cntvct();
-
-	if (s->clean & BIT(0))
-		t8132_clean_text_tables();
-	if (s->clean & BIT(1)) {
-		t8132_clean_all_ram(false);
-		t8132_clean_ram();
-	}
-	s->clean_ticks = __arch_counter_get_cntvct() - t0;
-}
-
-/*
- * apple_sleep.t8132_dirty_probe = N (0644, default 0 = off): with no sleep, compare the cached view
- * with DRAM (an uncached alias of the same page) over the kernel text, the swapper pages elchk2
- * checks and N random linear-map pages, and log the pages and bytes that differ: a difference is a
- * line still dirty in a cache. Runs when written, and at each .prepare while non-zero. The text
- * pass is also timed, as the stub's elchk2 reads it with the MMU off. Random pages can differ only
- * because something writes them now.
- */
-struct sleep_dirty {
-	unsigned int pages, differ;
-	u64 bytes;
-	phys_addr_t first;
-};
-
-static void sleep_dirty_page(phys_addr_t pa, struct sleep_dirty *d, u32 *crc)
-{
-	unsigned long pfn = PHYS_PFN(pa);
-	struct page *pg;
-	const u64 *cv, *nc;
-	unsigned int i, n = 0;
-	void *v;
-
-	if (!pfn_valid(pfn))
-		return;
-	pg = pfn_to_page(pfn);
-	if (PageHighMem(pg))
-		return;
-	v = vmap(&pg, 1, VM_MAP, pgprot_noncached(PAGE_KERNEL));
-	if (!v)
-		return;
-	cv = page_address(pg);
-	nc = v;
-	for (i = 0; i < PAGE_SIZE / sizeof(u64); i++) {
-		u64 x = READ_ONCE(cv[i]) ^ READ_ONCE(nc[i]);
-
-		while (x) {
-			if (x & 0xff)
-				n++;
-			x >>= 8;
-		}
-	}
-	if (crc)
-		*crc = crc32_le(*crc, v, PAGE_SIZE);
-	vunmap(v);
-	d->pages++;
-	if (n) {
-		if (!d->differ)
-			d->first = pa;
-		d->differ++;
-		d->bytes += n;
-	}
-}
-
-static void t8132_dirty_probe_run(struct apple_sleep *s, unsigned int nrand)
-{
-	struct sleep_dirty t = {}, g = {}, r = {};
-	phys_addr_t pa, start, end, total = 0;
-	u64 pt[T8132_ELCHK2_TAB_MAX], i;
-	unsigned int n, k;
-	u32 crc = ~0U;
-	ktime_t t0;
-
-	t0 = ktime_get();
-	for (pa = __pa_symbol(_stext); pa < __pa_symbol(_etext); pa += PAGE_SIZE) {
-		sleep_dirty_page(pa, &t, &crc);
-		cond_resched();
-	}
-	t0 = ktime_sub(ktime_get(), t0);
-	n = t8132_elchk2_tables((unsigned long)_cpu_resume, pt, 0);
-	n = t8132_elchk2_tables((unsigned long)&sleep_save_stash, pt, n);
-	for (k = 0; k < n; k++)
-		sleep_dirty_page(pt[k], &g, NULL);
-	for_each_mem_range(i, &start, &end)
-		total += end - start;
-	for (k = 0; k < nrand && total; k++) {
-		phys_addr_t off = ((phys_addr_t)get_random_u64() % total) & PAGE_MASK;
-
-		for_each_mem_range(i, &start, &end) {
-			if (off < end - start) {
-				sleep_dirty_page(start + off, &r, NULL);
-				break;
-			}
-			off -= end - start;
-		}
-		cond_resched();
-	}
-	dev_info(s->dev, "dirty-probe: text %u pages, %u differ (%llu bytes, first %pa), uncached pass %lld ms; tables %u, %u differ (%llu bytes); random %u, %u differ (%llu bytes, live writes count too)\n",
-		 t.pages, t.differ, t.bytes, &t.first, ktime_to_ms(t0), g.pages, g.differ, g.bytes,
-		 r.pages, r.differ, r.bytes);
-}
-
-static unsigned int t8132_dirty_pages;
-
-static int t8132_dirty_set(const char *val, const struct kernel_param *kp)
-{
-	int ret = param_set_uint(val, kp);
-
-	if (!ret && t8132_dirty_pages && apple_sleep && apple_sleep->soc->commit_mask)
-		t8132_dirty_probe_run(apple_sleep, t8132_dirty_pages);
-	return ret;
-}
-
-static const struct kernel_param_ops t8132_dirty_ops = {
-	.set = t8132_dirty_set,
-	.get = param_get_uint,
-};
-module_param_cb(t8132_dirty_probe, &t8132_dirty_ops, &t8132_dirty_pages, 0644);
-MODULE_PARM_DESC(t8132_dirty_probe,
-		 "T8132: N > 0 = log where DRAM differs from the cached view (text, tables, N random pages)");
-
-
-/*
- * Per-core power overrides macOS's kernel sets on the last core before a deep sleep
- * (XNU arm64_prepare_for_sleep): ACC_OVRD (s3_5_c15_c6_0) and, where it exists, CPU_OVRD/
- * CYC_OVRD (s3_5_c15_c5_0, undefined on T8132 per #1314). #1314 itself writes only
- * s3_5_c15_c6_2 (bits 0 and 63) on every core. Every access here is fault-safe: an
- * undefined register reads as an error, not an oops.
- */
-#define SLEEP_ACC_OVRD_EN_DEEP_SLEEP	BIT_ULL(34)
-#define SLEEP_ACC_OVRD_DIS_PIO_WFI	BIT_ULL(32)
-#define SLEEP_ACC_OVRD_TRDN_LNK		GENMASK_ULL(18, 17)
-#define SLEEP_ACC_OVRD_DIS_L2_FLUSH	GENMASK_ULL(16, 15)
-#define SLEEP_ACC_OVRD_PWRDN_SRM	GENMASK_ULL(14, 13)
-#define SLEEP_ACC_OVRD_PWRDN_CPM	GENMASK_ULL(26, 25)
-#define SLEEP_CYC_OVRD_FORCE_DOWN	GENMASK_ULL(25, 24)
-#define SLEEP_CYC_OVRD_DIS_WFI_RETN	BIT_ULL(0)
-
-static unsigned int t8132_commit_ovrd;
-module_param(t8132_commit_ovrd, uint, 0644);
-MODULE_PARM_DESC(t8132_commit_ovrd,
-		 "T8132 bring-up: 1 = XNU's deep-sleep ACC_OVRD fields on the last core before the commit, 2 = also CYC_OVRD, 4 = also disPioOnWfiCpu");
-
-enum { SLEEP_SR_ACC_OVRD, SLEEP_SR_CYC_OVRD, SLEEP_SR_DEEP_SLEEP };
-
-static int sleep_sr_read(int r, u64 *val)
-{
-	int err = 0;
-	u64 v = 0;
-
-	switch (r) {
-	case SLEEP_SR_ACC_OVRD:
-		asm volatile("1:	mrs	%1, s3_5_c15_c6_0\n2:\n"
-			     _ASM_EXTABLE_KACCESS_ERR_ZERO(1b, 2b, %w0, %w1)
-			     : "+r" (err), "=r" (v));
-		break;
-	case SLEEP_SR_CYC_OVRD:
-		asm volatile("1:	mrs	%1, s3_5_c15_c5_0\n2:\n"
-			     _ASM_EXTABLE_KACCESS_ERR_ZERO(1b, 2b, %w0, %w1)
-			     : "+r" (err), "=r" (v));
-		break;
-	default:
-		asm volatile("1:	mrs	%1, s3_5_c15_c6_2\n2:\n"
-			     _ASM_EXTABLE_KACCESS_ERR_ZERO(1b, 2b, %w0, %w1)
-			     : "+r" (err), "=r" (v));
-		break;
-	}
-	*val = v;
-	return err;
-}
-
-static int sleep_sr_write(int r, u64 v)
-{
-	int err = 0;
-
-	if (r == SLEEP_SR_ACC_OVRD)
-		asm volatile("1:	msr	s3_5_c15_c6_0, %1\n2:\n"
-			     _ASM_EXTABLE_KACCESS_ERR(1b, 2b, %w0)
-			     : "+r" (err) : "r" (v));
-	else
-		asm volatile("1:	msr	s3_5_c15_c5_0, %1\n2:\n"
-			     _ASM_EXTABLE_KACCESS_ERR(1b, 2b, %w0)
-			     : "+r" (err) : "r" (v));
-	isb();
-	return err;
-}
-
-struct sleep_sr_vals {
-	u64 v[3];
-	int err[3];
-};
-
-static void sleep_sr_read_cpu(void *arg)
-{
-	struct sleep_sr_vals *r = arg;
-	int i;
-
-	for (i = 0; i < 3; i++)
-		r->err[i] = sleep_sr_read(i, &r->v[i]);
-}
-
-static void sleep_ovrd_log(struct apple_sleep *s, const char *when)
-{
-	int cpu;
-
-	for_each_online_cpu(cpu) {
-		struct sleep_sr_vals r = {};
-
-		if (smp_call_function_single(cpu, sleep_sr_read_cpu, &r, 1))
-			continue;
-		dev_info(s->dev, "ovrd %s cpu%d: ACC_OVRD %s%#llx CYC_OVRD %s%#llx s3_5_c15_c6_2 %s%#llx\n",
-			 when, cpu, r.err[0] ? "fault " : "", r.v[0], r.err[1] ? "fault " : "",
-			 r.v[1], r.err[2] ? "fault " : "", r.v[2]);
-	}
-}
-
-/* On the committing core, right before the commit write, as XNU before its WFI. */
-static void t8132_ovrd_apply(u32 m)
-{
-	u64 v;
-
-	if ((m & BIT(0)) && !sleep_sr_read(SLEEP_SR_ACC_OVRD, &v)) {
-		v |= SLEEP_ACC_OVRD_EN_DEEP_SLEEP;
-		v = (v & ~SLEEP_ACC_OVRD_DIS_L2_FLUSH) | FIELD_PREP(SLEEP_ACC_OVRD_DIS_L2_FLUSH, 2);
-		v = (v & ~SLEEP_ACC_OVRD_PWRDN_SRM) | FIELD_PREP(SLEEP_ACC_OVRD_PWRDN_SRM, 3);
-		v = (v & ~SLEEP_ACC_OVRD_TRDN_LNK) | FIELD_PREP(SLEEP_ACC_OVRD_TRDN_LNK, 3);
-		v = (v & ~SLEEP_ACC_OVRD_PWRDN_CPM) | FIELD_PREP(SLEEP_ACC_OVRD_PWRDN_CPM, 3);
-		if (m & BIT(2))
-			v |= SLEEP_ACC_OVRD_DIS_PIO_WFI;
-		sleep_sr_write(SLEEP_SR_ACC_OVRD, v);
-	}
-	if ((m & BIT(1)) && !sleep_sr_read(SLEEP_SR_CYC_OVRD, &v)) {
-		v = (v & ~SLEEP_CYC_OVRD_FORCE_DOWN) | FIELD_PREP(SLEEP_CYC_OVRD_FORCE_DOWN, 3);
-		v |= SLEEP_CYC_OVRD_DIS_WFI_RETN;
-		sleep_sr_write(SLEEP_SR_CYC_OVRD, v);
-	}
-}
-
-static void t8132_commit_arm(struct apple_sleep *s);
-static void __noreturn t8132_commit_tail(struct apple_sleep *s);
-
-/*
- * #1314's apple_sleep_commit() with t8132_sleep_ops, step for step: the other cores stopped,
- * the RAM clean that starts its lower_io, ATC0 and ANS lowered, WD2, the still-on wait and
- * the power-state unlatch, its last mile (SoC and DCS down, the memory controller, the gates
- * and voter, the clusters, the quiesce read, the clock muxes, the power-state save, AON 0xa0),
- * then resume_pa = its own stub after all of that, the mailbox, stack and driver state
- * cleaned, the commit, the AIC masked, the boot core's WFI. Only our own leftovers are
- * cleared first, so nothing of ours runs at the wake: checks, config, marks, the DRAM check.
- */
-static void __noreturn t8132_team_sleep_commit(struct apple_sleep *s)
-{
-	int i;
-
-	t8132_team_armed = true;
-	t8132_team_marks(true);
-	t8132_disarm_el_check();
-	t8132_disarm_el_check2();
-	t8132_disarm_stubcfg();
-	if (s->mbox_check) {
-		WRITE_ONCE(s->mbox_check->magic, 0);
-		dcache_clean_poc((unsigned long)s->mbox,
-				 (unsigned long)s->mbox + AURA_S2R_CHECKED_SIZE);
