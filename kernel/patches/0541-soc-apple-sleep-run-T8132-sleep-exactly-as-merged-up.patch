-/*
- * J604: the four power-gate words that the J604 ADT's pmgr pwrgate-regs gives macOS's
- * PMGR driver as {window, offset, mask, value}: pmgr0 + 0x2504c (mask 0x00402001),
- * + 0x2604c, + 0x2704c and pmgr1 + 0x1c01c, value 0x80000000 each. The first is
- * "pwrgate" + 0x104c, the first display's word, which the commit writes. All four read
- * 0 at boot on 1.850 and 1.879. None of them is a CPU cluster's: those are "pwrgate"
- * + 0x0 (E) and + 0x60 (P), the SoC's pwrgate_wake, which iBoot sets for E only and
- * which this driver writes only on the way back from a sleep. The J604 boots on P.
- *
- * t8132_pwrgate_adt, for bring-up (default 0): bit 0 writes the four at probe the way
- * m1n1 applies the ADT's tables (the mask's bits cleared, the value's set); bit 1 sets
- * the P cluster's enable at probe, as apple-cluster-pwrgate sets the boot core's word
- * at boot on T6050. Each write is read back at once, and every word again just before
- * the commit.
- */
-static const struct {
-	phys_addr_t pa;
-	u32 mask;
-} j604_adt_pwrgate[] = {
-	{ 0x38072504c, 0x00402001 },
-	{ 0x38072604c, 0 },
-	{ 0x38072704c, 0 },
-	{ 0x38829c01c, 0 },
-};
-
-#define J604_ADT_PWRGATE_VALUE	0x80000000
-#define J604_PWRGATE_ADT_WORDS	BIT(0)
-#define J604_PWRGATE_P_CLUSTER	BIT(1)
-
-static unsigned int t8132_pwrgate_adt;
-module_param(t8132_pwrgate_adt, uint, 0444);
-MODULE_PARM_DESC(t8132_pwrgate_adt,
-		 "J604 bring-up, at probe: bit 0 writes the ADT's four pmgr pwrgate-regs words, bit 1 sets the P cluster's power-gate enable; each is read back (default: 0)");
-
-static void j604_adt_pwrgate_init(struct apple_sleep *s)
-{
-	int i;
-
-	if (!of_machine_is_compatible("apple,j604"))
-		return;
-	for (i = 0; i < ARRAY_SIZE(j604_adt_pwrgate); i++)
-		s->adt_pg[i] = devm_ioremap(s->dev, j604_adt_pwrgate[i].pa, sizeof(u32));
-}
-
-static void __iomem *j604_p_cluster_pwrgate(struct apple_sleep *s)
-{
-	return s->pwrgate + s->soc->pwrgate_wake[1];
-}
-
-static void j604_adt_pwrgate_print(struct apple_sleep *s, const char *when)
-{
-	int i;
-
-	for (i = 0; i < ARRAY_SIZE(j604_adt_pwrgate); i++)
-		if (s->adt_pg[i])
-			dev_info(s->dev, "ADT pwrgate word %d at %pa, %s: %#010x (macOS: 0x80000000)\n",
-				 i + 1, &j604_adt_pwrgate[i].pa, when, readl(s->adt_pg[i]));
-	if (s->adt_pg[0])
-		dev_info(s->dev, "P cluster power-gate enable at pwrgate + %#x, %s: %#010x\n",
-			 s->soc->pwrgate_wake[1], when, readl(j604_p_cluster_pwrgate(s)));
-}
