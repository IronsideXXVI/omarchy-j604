-	const u8 *base[2];
-	unsigned int r, i, k = 0;
-	u32 len[2];
-
-	WRITE_ONCE(e->magic, 0);
-	t8132_el_ranges(base, len);
-	if (t8132_el_check_fits(len)) {
-		for (r = 0; r < 2; r++) {
-			t.len[r] = len[r];
-			t.n[r] = DIV_ROUND_UP(len[r], T8132_ELCHK_CHUNK);
-			for (i = 0; i < t.n[r]; i++) {
-				u32 off = i * T8132_ELCHK_CHUNK;
