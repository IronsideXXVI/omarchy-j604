- * J604, 26B123); this shows what a cold secondary has on the Linux chain, to compare with the
- * stub's bit 7 reading of the woken core.
- */
-#define SLEEP_SR_SAFE(enc, v, err)						\
-	asm volatile("1:	mrs	%1, " enc "\n2:\n"				\
-		     _ASM_EXTABLE_KACCESS_ERR_ZERO(1b, 2b, %w0, %w1)		\
-		     : "+r" (err), "=r" (v))
-
-struct sleep_conf_vals {
-	u64 v[10];
-	int err;
-};
