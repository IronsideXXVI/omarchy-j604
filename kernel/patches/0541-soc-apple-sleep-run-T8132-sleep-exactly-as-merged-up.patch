-/* A write-combine (non-cacheable) view of [pa, pa + len): vmap for mapped RAM, else ioremap_wc. */
-static void *t8132_nc_map(phys_addr_t pa, size_t len, bool *io)
-{
-	phys_addr_t base = pa & PAGE_MASK;
-	unsigned int n = DIV_ROUND_UP(offset_in_page(pa) + len, PAGE_SIZE), i;
-	struct page *pg[16];
-	void *v;
-
-	*io = !pfn_is_map_memory(PHYS_PFN(base));
-	if (*io) {
-		v = (void __force *)ioremap_wc(base, (size_t)n * PAGE_SIZE);
-		return v ? v + offset_in_page(pa) : NULL;
-	}
-	if (n > ARRAY_SIZE(pg))
-		return NULL;
-	for (i = 0; i < n; i++)
-		pg[i] = pfn_to_page(PHYS_PFN(base) + i);
-	v = vmap(pg, n, VM_MAP, pgprot_writecombine(PAGE_KERNEL));
-	return v ? v + offset_in_page(pa) : NULL;
-}
-
-static void t8132_nc_unmap(void *p, bool io)
-{
-	void *base = (void *)((unsigned long)p & PAGE_MASK);
-
-	if (!p)
-		return;
-	if (io)
-		iounmap((void __iomem __force *)base);
-	else
-		vunmap(base);
-}
