-
-/*
- * The steps of the generic return from a suspend that went through firmware, for a
- * platform that can only tell where a resume stopped from a watchdog's timing. The hook
- * runs with the MMU on, nothing traced, and must not sleep or fault.
- */
-enum arm64_suspend_mark {
-	ARM64_SUSPEND_EXIT_FIRST,	/* cpu_resume and cpu_do_resume done */
-	ARM64_SUSPEND_EXIT_LAST,	/* __cpu_suspend_exit() done */
-	ARM64_SUSPEND_DAIF_RESTORE,	/* right before cpu_suspend() restores DAIF */
-};
-
-extern void (*arm64_suspend_mark_hook)(enum arm64_suspend_mark mark);
-
-/*
- * Vectors a platform wants for the way back from a firmware resume, until cpu_do_resume
- * restores VBAR: their PA, installed at EL2 by cpu_resume right after init_kernel_el
- * (MMU off), and their kernel VA, installed by cpu_resume as soon as the MMU is on.
- * 0: none. The setter cleans both to the PoC.
- */
-extern u64 arm64_resume_vbar;
-/*
- * An Apple-style watchdog (control +0x2c, count +0x20, alarm +0x28) that the resume
- * assembly restarts at each of its steps, so that a platform which only sees a resume
- * through that watchdog can tell where it stopped: {PA, kernel VA, ticks per second}.
- * 0, the default, writes nothing.
- */
-extern u64 arm64_resume_wdt[3];
-extern u32 arm64_resume_armed;
-extern unsigned long arm64_resume_vbar_va;
 extern void cpu_resume(void);
 int __cpu_suspend_enter(struct sleep_stack_data *state);
 void __cpu_suspend_exit(void);
