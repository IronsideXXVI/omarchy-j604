-/*
- * What init_kernel_el runs, and reads by PA, on T8132's way back: .idmap.text and
- * .mmuoff.data. aura's DRAM check (t8132_arm_dram_check()) covers neither. The commit
- * leaves a CRC-32 per 256-byte chunk of each here, and the resume stub recomputes them
- * with the MMU off before it branches to cpu_resume. A match changes nothing. On a
- * mismatch the stub stays: it restarts WD2 for 46 s, which no other step of the way
- * back uses, and leaves a record in PMU scratch, read by macsmc-reboot on the next
- * boot: the region in 0xf805 (1 .idmap.text, 2 .mmuoff.data, 3 this table), the first
- * chunk that differs in 0xf806, log2 of the chunk size in 0xf807, then 0x3c in 0xf804.
- * Nothing is cleaned for the check, so a mismatch means DRAM at the wake is not what the
- * kernel saw at the commit, whether the bytes changed across the collapse or a line
- * never reached DRAM.
- */
-#define T8132_ELCHK_MAGIC	0x4b434c45	/* "ELCK" */
-#define T8132_ELCHK_CHUNK	256
-#define T8132_ELCHK_MAX		32
-
-struct t8132_elchk {
-	u32 magic;		/* last at the commit, cleared after cpu_suspend() returns */
-	u32 n[2];		/* chunks of .idmap.text, .mmuoff.data */
-	u32 len[2];		/* bytes checked, a multiple of 4 */
-	u32 crc[T8132_ELCHK_MAX];	/* crc32_le(~0, chunk), .idmap.text's first */
-	u32 self;		/* crc32_le(~0) over everything above, magic set */
-};
-
-/* The stub's offsets. */
-static_assert(offsetof(struct t8132_elchk, n) == 4);
-static_assert(offsetof(struct t8132_elchk, len) == 12);
-static_assert(offsetof(struct t8132_elchk, crc) == 20);
-static_assert(offsetof(struct t8132_elchk, self) == 148);
-
-struct t8132_elchk t8132_elchk __aligned(64);
-
-/*
- * elchk2, for the first memory the way back uses past those 5788 bytes: the kernel
- * text (_stext.._etext, 1 MiB chunks) and the swapper table pages that map _cpu_resume
- * and sleep_save_stash, each CRC-32 taken at the commit through the kernel's mapping
- * and checked by the stub by PA, after elchk. A mismatch restarts WD2 for 115 s
- * (0xa4824200 ticks) and leaves the region in 0xf805 (1 text, 2 table page, 3 this
- * table), the first chunk or page that differs in 0xf806, log2 of its size in 0xf807,
- * then 0x3d in 0xf804. Off with apple_sleep.t8132_elchk2=0 (read at each commit).
- */
-#define T8132_ELCHK2_MAGIC	0x324b4345	/* "ECK2" */
-#define T8132_ELCHK2_TEXT_SHIFT	20
-#define T8132_ELCHK2_TEXT_MAX	32
-#define T8132_ELCHK2_TAB_MAX	8
-
-struct t8132_elchk2 {
-	u32 magic;		/* last at the commit, cleared after cpu_suspend() returns */
-	u32 n_text;		/* 1 MiB chunks of text */
-	u32 n_tab;		/* table pages */
-	u32 rsvd;
-	u64 text_pa;
-	u64 text_len;		/* bytes checked, a multiple of 16 */
-	u64 tab_pa[T8132_ELCHK2_TAB_MAX];
-	u32 crc_text[T8132_ELCHK2_TEXT_MAX];
-	u32 crc_tab[T8132_ELCHK2_TAB_MAX];
-	u32 self;		/* crc32_le(~0) over everything above, magic set */
-};
-
-/* The stub's offsets. */
-static_assert(offsetof(struct t8132_elchk2, n_text) == 4);
-static_assert(offsetof(struct t8132_elchk2, n_tab) == 8);
-static_assert(offsetof(struct t8132_elchk2, text_pa) == 16);
-static_assert(offsetof(struct t8132_elchk2, text_len) == 24);
-static_assert(offsetof(struct t8132_elchk2, tab_pa) == 32);
-static_assert(offsetof(struct t8132_elchk2, crc_text) == 96);
-static_assert(offsetof(struct t8132_elchk2, crc_tab) == 224);
-static_assert(offsetof(struct t8132_elchk2, self) == 256);
-
-struct t8132_elchk2 t8132_elchk2_tab __aligned(64);
-
-static bool t8132_elchk2 = true;
-module_param(t8132_elchk2, bool, 0644);
-MODULE_PARM_DESC(t8132_elchk2, "T8132 deep sleep: the resume stub also checks the kernel text and the swapper pages for _cpu_resume and sleep_save_stash (default on)");
