-/* The table pages on swapper's walk to va, added to pa[0..n) once each. */
-static unsigned int t8132_elchk2_tables(unsigned long va, u64 *pa, unsigned int n)
-{
-	pgd_t *pgdp = pgd_offset_k(va);
