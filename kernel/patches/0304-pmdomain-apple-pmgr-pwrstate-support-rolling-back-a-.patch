From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Tue, 10 Nov 2026 01:37:00 -0500
Subject: [PATCH] pmdomain: apple: pmgr-pwrstate: support rolling back
 a partial consumer power-off

apple_pmgr_ps_consumer_on() walks the consumer's chain parent first and
stops at the first state it cannot switch. A state that is not off gives
-EALREADY. After a consumer power-off that stopped partway, for example
with the CPU state off and the frontend refusing because it was not fully
on, a rollback power-on stops at the system state, which never went off,
and leaves the CPU state off.

Treat -EALREADY as done in the power-on walk, so that a rollback after a
partial power-off switches back on every state that went off.

A consumer rolling back also has to know whether its own block went
through reset, which decides how its coprocessor is started again. Add
apple_pmgr_ps_consumer_is_off() for that: whether the first state of its
chain, its own domain, was powered off.

Signed-off-by: Erik Bourget <erik@ebourget.net>
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 8ff9bdc22fea2e208e4cac466b243fc736817aa0)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/pmdomain/apple/pmgr-pwrstate.c  | 23 ++++++++++++++++++++++-
 include/linux/soc/apple/pmgr-pwrstate.h |  2 ++
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/drivers/pmdomain/apple/pmgr-pwrstate.c b/drivers/pmdomain/apple/pmgr-pwrstate.c
index cfc8c520d8..12fa9d0033 100644
--- a/drivers/pmdomain/apple/pmgr-pwrstate.c
+++ b/drivers/pmdomain/apple/pmgr-pwrstate.c
@@ -1336,13 +1336,34 @@ int apple_pmgr_ps_consumer_on(struct device *consumer)
 		return n;
 	for (int i = n - 1; i >= 0; i--) {
 		ret = apple_pmgr_ps_consumer_switch(chain[i], true);
-		if (ret)
+		/* Also a rollback after a power-off that stopped partway: skip what stayed on. */
+		if (ret && ret != -EALREADY)
 			return ret;
 	}
 	return 0;
 }
 EXPORT_SYMBOL_GPL(apple_pmgr_ps_consumer_on);
 
+/*
+ * Whether @consumer's own state, the first of its chain, is powered off: after
+ * a power-off that stopped partway, whether its block went through reset.
+ */
+bool apple_pmgr_ps_consumer_is_off(struct device *consumer)
+{
+	struct apple_pmgr_ps *chain[APPLE_PMGR_PS_MAX_CHAIN];
+	int n = apple_pmgr_ps_consumer_chain(consumer, chain);
+	unsigned long flags;
+	bool off;
+
+	if (n < 0)
+		return false;
+	spin_lock_irqsave(&chain[0]->genpd.slock, flags);
+	off = chain[0]->consumer_off;
+	spin_unlock_irqrestore(&chain[0]->genpd.slock, flags);
+	return off;
+}
+EXPORT_SYMBOL_GPL(apple_pmgr_ps_consumer_is_off);
+
 static const struct of_device_id apple_pmgr_ps_of_match[] = {
 	{ .compatible = "apple,t8103-pmgr-pwrstate" },
 	{ .compatible = "apple,pmgr-pwrstate" },
diff --git a/include/linux/soc/apple/pmgr-pwrstate.h b/include/linux/soc/apple/pmgr-pwrstate.h
index fdf852b475..c86cba6c24 100644
--- a/include/linux/soc/apple/pmgr-pwrstate.h
+++ b/include/linux/soc/apple/pmgr-pwrstate.h
@@ -20,6 +20,7 @@ int apple_pmgr_ps_verify_state(struct device *domain_dev, bool on);
 int apple_pmgr_ps_consumer_check(struct device *consumer);
 int apple_pmgr_ps_consumer_off(struct device *consumer);
 int apple_pmgr_ps_consumer_on(struct device *consumer);
+bool apple_pmgr_ps_consumer_is_off(struct device *consumer);
 #else
 static inline int apple_pmgr_ps_verify_state(struct device *domain_dev, bool on)
 {
@@ -29,6 +30,7 @@ static inline int apple_pmgr_ps_cycle(struct device_node *np) { return -EOPNOTSU
 static inline int apple_pmgr_ps_consumer_check(struct device *consumer) { return -EOPNOTSUPP; }
 static inline int apple_pmgr_ps_consumer_off(struct device *consumer) { return -EOPNOTSUPP; }
 static inline int apple_pmgr_ps_consumer_on(struct device *consumer) { return -EOPNOTSUPP; }
+static inline bool apple_pmgr_ps_consumer_is_off(struct device *consumer) { return false; }
 #endif
 
 #endif
-- 
