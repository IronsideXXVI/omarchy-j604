From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 23:02:21 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: wake only from the
 sources macOS uses

The J604 suspend-to-RAM node listed every source in the ADT's
/arm-io/pmgr ap-wake-sources as a wake source, 25 of them, including
the AP watchdog, the AOP and NUB GPIO and SPMI lines and the CIO wake
of every type-C port. macOS on T8132 leaves only six of them unmasked
for a sleep: the PMU (NUB.SPMI0.SW3), the SMC (CPUWakeupAP and its
outbox), the internal keyboard and trackpad (the MTP dock channel and
its outbox) and USB on the first type-C port (ATC0.USBWakeup).

Keep only those six, with the J604 ADT's ids. The SMC's own sources do
not change. The masks are written only when the system enters
suspend-to-RAM, so s2idle is not affected.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index fe3ddf0737..90d74c483c 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -278,7 +278,14 @@ pmgr_sleep: power-management@3882c8000 {
 		compatible = "apple,t8132-pmgr-sleep";
 		reg = <0x03 0x882c8000 0x00 0x1000>, <0x03 0x88004000 0x00 0x60>, <0x03 0x80760000 0x00 0x530>;
 		reg-names = "events", "wake", "wake-time";
-		apple,ap-wake-sources = <0x05 0x0c 0x0e 0x2a 0x3c 0x40 0x44 0x45 0x46 0x47 0x48 0x49 0x4a 0x4b 0x55 0x68 0x7a 0x7b 0x8a 0x91 0x96 0x9c 0xa1 0xb7 0xe5>;
+		/*
+		 * Of the 25 sources in the ADT's /arm-io/pmgr ap-wake-sources, only
+		 * the six macOS leaves unmasked on T8132: ATC0.USBWakeup (0x45),
+		 * MTP.DOCK.CHANNELS.AP0.IRQ (0x55), MTP.OutboxNotEmpty (0x68),
+		 * NUB.SPMI0.SW3 (0x91), SMC.CPUWakeupAP (0xa1) and
+		 * SMC.OutboxNotEmpty (0xb7). The ids are the J604 ADT's.
+		 */
+		apple,ap-wake-sources = <0x45 0x55 0x68 0x91 0xa1 0xb7>;
 		apple,smc-wake-sources = <0xa1 0xb7>;
 		status = "okay";
 	};
