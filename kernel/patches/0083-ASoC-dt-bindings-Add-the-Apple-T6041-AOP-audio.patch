+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/apple,t6041-aop-audio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple T6041 AOP audio
+
+maintainers:
+  - Jonathan Goyvaerts <jonathan.goyvaerts@gmail.com>
+
+description: |
+  The Always-On Processor on Apple T6041 SoCs runs the machine's audio
+  streams in its firmware: the microphone array, the internal speakers with
+  their voltage and current sense, and the 3.5 mm headset jack in both
+  directions. This node is a child of the AOP node and names the ADMAC
+  channels the host moves each stream's data over while the firmware runs
+  its serializer. The parent AOP binding describes the firmware transport.
+
+  The headset jack's channels are optional: a node without them has no jack
+  streams.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    items:
+      - const: apple,t6041-aop-audio
+      - const: apple,t6030-aop-audio
+
+  dmas:
+    minItems: 3
+    items:
+      - description: Microphone array input
+      - description: Internal speaker output
+      - description: Speaker voltage and current sense input
+      - description: Headset jack output
+      - description: Headset microphone input
+
+  dma-names:
+    minItems: 3
+    items:
+      - const: dma
+      - const: spkr
+      - const: sense
+      - const: cout
+      - const: cin
+
+  "#sound-dai-cells":
+    const: 1
+    description: |
+      AOP audio DAI identifier:
+        0, 1, 2 - the speaker card's front-ends: unused, the speakers and
+                  their sense
+        3 - the internal speaker back-end
+        4 - the headset jack back-end
+
+  apple,chassis-name:
+    $ref: /schemas/types.yaml#/definitions/string
+    description:
+      Chassis identifier used to name the microphone sound card.
+
+  apple,machine-kind:
+    $ref: /schemas/types.yaml#/definitions/string
+    description:
+      Human-readable machine name used in the microphone sound card's
+      description.
+
+required:
+  - compatible
+  - dmas
+  - dma-names
+  - "#sound-dai-cells"
+  - apple,chassis-name
+  - apple,machine-kind
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    aop {
+        audio {
+            compatible = "apple,t6041-aop-audio", "apple,t6030-aop-audio";
+            apple,chassis-name = "J616";
+            apple,machine-kind = "MacBook Pro";
+            dmas = <&admac0 1>, <&admac1 0>, <&admac1 1>,
+                   <&admac1 4>, <&admac1 5>;
+            dma-names = "dma", "spkr", "sense", "cout", "cin";
+            #sound-dai-cells = <1>;
+        };
+    };
