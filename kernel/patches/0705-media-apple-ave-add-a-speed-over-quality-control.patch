 - The level control is a minimum: the driver raises it to what the size,
diff --git a/drivers/media/platform/apple/ave/ave-abi-test.c b/drivers/media/platform/apple/ave/ave-abi-test.c
index 5e3ed8e212..255ec6e995 100644
--- a/drivers/media/platform/apple/ave/ave-abi-test.c
+++ b/drivers/media/platform/apple/ave/ave-abi-test.c
@@ -225,6 +225,81 @@ static void ave_9003_hevc_main10(struct kunit *test)
 	}
 }
 
+/* One 1080p HEVC Start or first Process image, with speed mode @speed. */
+static void ave_speed_image(struct kunit *test, struct ave_ctx *ctx,
+			    enum ave_image image, bool bframes, bool speed,
+			    u8 *cmd, size_t len)
+{
+	ave_test_session(ctx->sess, AVE_CODEC_HEVC, 1920, 1080, bframes);
+	ctx->sess->p.speed = speed;
+	memset(cmd, 0, len);
+	if (image == AVE_IMAGE_START)
+		KUNIT_ASSERT_EQ(test, ave_build_start(ctx, cmd, len), 0);
+	else
+		KUNIT_ASSERT_EQ(test, ave_build_process(ctx, cmd, len, 0,
+							0x8f0000000ULL, 8000000,
+							false), 0);
+	ave_stamp_command(ctx->ave->layout->abi, cmd, 1, 2);
+}
+
+/*
+ * Speed over quality on 9003: HEVC Start changes only the throughput mode
+ * (+0x320, 3 -> 5); Process stays the same, with and without B-frames.
+ */
+static void ave_9003_speed(struct kunit *test)
+{
+	struct ave_dev *ave = kunit_kzalloc(test, sizeof(*ave), GFP_KERNEL);
+	struct ave_ctx *ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	struct ave_session *sess = kunit_kzalloc(test, sizeof(*sess), GFP_KERNEL);
+	u8 *quality = kunit_kzalloc(test, 0x14000, GFP_KERNEL);
+	u8 *speed = kunit_kzalloc(test, 0x14000, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, ave);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	KUNIT_ASSERT_NOT_NULL(test, sess);
+	KUNIT_ASSERT_NOT_NULL(test, quality);
+	KUNIT_ASSERT_NOT_NULL(test, speed);
+	ave->layout = &ave_layout_9003_78_0;
+	ctx->ave = ave;
+	ctx->sess = sess;
+
+	for (unsigned int i = 0; i < 4; i++) {
+		enum ave_image image = i & 1 ? AVE_IMAGE_PROCESS : AVE_IMAGE_START;
+		bool bframes = i & 2;
+		size_t len = ave->layout->bytes[AVE_CODEC_HEVC - 1][image];
+		u32 changed = image == AVE_IMAGE_START ? 0x320 : 0;
+
+		ave_speed_image(test, ctx, image, bframes, false, quality, len);
+		ave_speed_image(test, ctx, image, bframes, true, speed, len);
+		if (changed) {
+			KUNIT_EXPECT_EQ(test, get_unaligned_le32(quality + changed), 3);
+			KUNIT_EXPECT_EQ(test, get_unaligned_le32(speed + changed), 5);
+		}
+		for (size_t off = 0; off < len; off += 4) {
+			if (changed && off == changed)
+				continue;
+			KUNIT_EXPECT_EQ_MSG(test, get_unaligned_le32(quality + off),
+					    get_unaligned_le32(speed + off),
+					    "case %u word +%#zx", i, off);
+		}
+	}
+}
+
+/* Constant quality uses the measured macOS table: anchors and shape. */
+static void ave_cq_table(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, ave_cq_initial_qp(0), 48);
+	KUNIT_EXPECT_EQ(test, ave_cq_initial_qp(30), 40);
+	KUNIT_EXPECT_EQ(test, ave_cq_initial_qp(50), 33);
+	KUNIT_EXPECT_EQ(test, ave_cq_initial_qp(60), 28);
+	KUNIT_EXPECT_EQ(test, ave_cq_initial_qp(90), 10);
+	KUNIT_EXPECT_EQ(test, ave_cq_initial_qp(100), 0);
+	KUNIT_EXPECT_EQ(test, ave_cq_initial_qp(1000), 0);
+	for (unsigned int q = 1; q <= 100; q++)
+		KUNIT_EXPECT_LE(test, ave_cq_initial_qp(q),
+				ave_cq_initial_qp(q - 1));
+}
+
 static void ave_6070_images(struct kunit *test)
 {
 	const struct ave_fw_abi *abi = &ave_abi_6070;
@@ -462,6 +537,7 @@ static void ave_6070_variants(struct kunit *test)
 
 static struct kunit_case ave_abi_cases[] = {
 	KUNIT_CASE(ave_9003_byte_equality), KUNIT_CASE(ave_9003_hevc_main10),
+	KUNIT_CASE(ave_9003_speed),	    KUNIT_CASE(ave_cq_table),
 	KUNIT_CASE(ave_6070_images),
 	KUNIT_CASE(ave_6070_replies),	    KUNIT_CASE(ave_6070_split_surfaces),
 	KUNIT_CASE(ave_6070_gate),	    KUNIT_CASE(ave_6070_channels),
diff --git a/drivers/media/platform/apple/ave/ave-sess.c b/drivers/media/platform/apple/ave/ave-sess.c
index 583d5c1998..dde038a812 100644
--- a/drivers/media/platform/apple/ave/ave-sess.c
+++ b/drivers/media/platform/apple/ave/ave-sess.c
@@ -124,6 +124,11 @@ static const u8 ave_cq_qp[101] = {
 
 #define AVE_CQ_MAX_QP 48
 
+u32 ave_cq_initial_qp(u32 quality)
+{
+	return ave_cq_qp[min(quality, 100U)];
+}
+
 static int ave_sess_params(struct ave_ctx *ctx, struct ave_params *p)
 {
 	bool baseline = false;
@@ -193,6 +198,15 @@ static int ave_sess_params(struct ave_ctx *ctx, struct ave_params *p)
 	p->reorder_off = !ctx->b_frames;
 	p->refs = p->intra_only ? 1 : p->bframes ? 5 : 2;
 	p->slots = p->bframes ? 5 : 3;
+	/*
+	 * Speed over quality changes the firmware's throughput mode from 3 to
+	 * 5, as macOS does. It is measured for 8-bit HEVC above 720p on the
+	 * 9003 layout only; H.264 does not get faster from it (on macOS
+	 * either).
+	 */
+	p->speed = ctx->prioritize_speed && p->codec == AVE_CODEC_HEVC &&
+		   p->sample_bytes == 1 && !ctx->ave->layout->counted &&
+		   p->width * p->height > 1280 * 720;
 	p->gop = ctx->gop_size ?: 120;
 
 	p->bitrate = ctx->bitrate;
@@ -200,7 +214,7 @@ static int ave_sess_params(struct ave_ctx *ctx, struct ave_params *p)
 		/* One QP for every frame, no data-rate limit, as macOS sets it. */
 		p->rc_mode = AVE_RC_CQ;
 		p->limit_bytes = 0;
-		p->initial_qp = ave_cq_qp[min(ctx->quality, 100U)];
+		p->initial_qp = ave_cq_initial_qp(ctx->quality);
 		p->max_qp = min_t(u32, p->max_qp, AVE_CQ_MAX_QP);
 		if (p->min_qp > (s32)p->max_qp)
 			p->min_qp = p->max_qp;
diff --git a/drivers/media/platform/apple/ave/ave-v4l2.c b/drivers/media/platform/apple/ave/ave-v4l2.c
index 0faf1cc707..d46a810e24 100644
--- a/drivers/media/platform/apple/ave/ave-v4l2.c
+++ b/drivers/media/platform/apple/ave/ave-v4l2.c
@@ -462,6 +462,9 @@ static int ave_s_ctrl(struct v4l2_ctrl *ctrl)
 	case V4L2_CID_MPEG_VIDEO_HEVC_PROFILE:
 		ctx->hevc_profile = ctrl->val;
 		break;
+	case V4L2_CID_APPLE_AVE_PRIORITIZE_SPEED:
+		ctx->prioritize_speed = ctrl->val;
+		break;
 	case V4L2_CID_MPEG_VIDEO_HEADER_MODE:
 	case V4L2_CID_MIN_BUFFERS_FOR_OUTPUT:
 		break;
@@ -475,13 +478,22 @@ static const struct v4l2_ctrl_ops ave_ctrl_ops = {
 	.s_ctrl = ave_s_ctrl,
 };
 
+static const struct v4l2_ctrl_config ave_ctrl_prioritize_speed = {
+	.ops = &ave_ctrl_ops,
+	.id = V4L2_CID_APPLE_AVE_PRIORITIZE_SPEED,
+	.name = "Prioritize Speed Over Quality",
+	.type = V4L2_CTRL_TYPE_BOOLEAN,
+	.max = 1,
+	.step = 1,
+};
+
 static int ave_init_ctrls(struct ave_ctx *ctx)
 {
 	struct v4l2_ctrl_handler *hdl = &ctx->hdl;
 	const struct v4l2_ctrl_ops *ops = &ave_ctrl_ops;
 	struct v4l2_ctrl *c;
 
-	v4l2_ctrl_handler_init(hdl, 18);
+	v4l2_ctrl_handler_init(hdl, 19);
 
 	v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_MPEG_VIDEO_BITRATE_MODE,
 			       V4L2_MPEG_VIDEO_BITRATE_MODE_CQ, 0,
@@ -534,6 +546,9 @@ static int ave_init_ctrls(struct ave_ctx *ctx)
 	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_HEVC_MIN_QP, 0, 51, 1, 0);
 	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_HEVC_MAX_QP, 0, 51, 1, 51);
 
+	/* Off by default: macOS also codes for quality unless asked. */
+	v4l2_ctrl_new_custom(hdl, &ave_ctrl_prioritize_speed, NULL);
+
 	/* The firmware holds up to five frames; one more keeps it fed. */
 	c = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MIN_BUFFERS_FOR_OUTPUT, 1, 32, 1,
 			      AVE_MAX_SLOTS + 1);
diff --git a/drivers/media/platform/apple/ave/ave-writer.c b/drivers/media/platform/apple/ave/ave-writer.c
index 1e69481057..60883b7376 100644
--- a/drivers/media/platform/apple/ave/ave-writer.c
+++ b/drivers/media/platform/apple/ave/ave-writer.c
@@ -153,6 +153,10 @@ void ave_stamp_command(const struct ave_fw_abi *abi, u8 *cmd, u64 timeout,
 	ave_put64(cmd, abi->created_offset, created);
 }
 
+/* Throughput modes: 3 codes for quality, 5 prioritizes speed (as macOS) */
+#define AVE_THROUGHPUT_QUALITY 3
+#define AVE_THROUGHPUT_SPEED 5
+
 #define AVE_START_ARRAY_LEN 30
 #define AVE_START_INIT_QP_VALUE 26
 
@@ -306,9 +310,11 @@ static void ave_start_config(const struct ave_params *p, u8 *cmd,
 	ave_start_put32(cmd, l->ref_depth, p->bframes ? 3 : 1);
 	ave_start_put32(cmd, l->idr_interval, p->gop);
 
-	/* Picture size */
+	/* Picture size class, which is also the throughput mode */
 	ave_start_put32(cmd, l->size_class,
-			p->width * p->height > 1280 * 720 ? 3 : 1);
+			p->speed ? AVE_THROUGHPUT_SPEED :
+			p->width * p->height > 1280 * 720 ? AVE_THROUGHPUT_QUALITY :
+							    1);
 	ave_start_put32(cmd, l->coded_w, p->cw);
 	ave_start_put32(cmd, l->coded_h, p->ch);
 	ave_start_put32(cmd, l->coded_h2, p->ch);
diff --git a/drivers/media/platform/apple/ave/ave.h b/drivers/media/platform/apple/ave/ave.h
index bda3949208..8abe90415f 100644
--- a/drivers/media/platform/apple/ave/ave.h
+++ b/drivers/media/platform/apple/ave/ave.h
@@ -128,6 +128,16 @@ enum ave_opcode {
 
 #include "ave-layout.h"
 
+/*
+ * Driver-private codec-class controls.
+ *
+ * PRIORITIZE_SPEED is VideoToolbox's PrioritizeEncodingSpeedOverQuality:
+ * off (the default) codes for quality, on trades some compression
+ * efficiency for encoding speed. It is read when streaming starts.
+ */
+#define V4L2_CID_APPLE_AVE_BASE (V4L2_CTRL_CLASS_CODEC | 0x1200)
+#define V4L2_CID_APPLE_AVE_PRIORITIZE_SPEED (V4L2_CID_APPLE_AVE_BASE + 0)
+
 /* The firmware build whose command layouts the driver generates */
 #define AVE_FW_TEXT_CRC_9003_78_0 0x69c54454
 /* The M4 Pro (T6040) build of the same 25G83 firmware. */
@@ -263,6 +273,7 @@ struct ave_params {
 	u32 coded_cap;
 	u32 bit_depth; /* zero also means the existing 8-bit API */
 	u32 initial_qp; /* CQ only; bit-rate modes use 26 */
+	bool speed; /* prioritize encoding speed over quality */
 };
 
 struct ave_slot {
@@ -346,6 +357,7 @@ struct ave_ctx {
 	u32 hevc_min_qp;
 	u32 hevc_max_qp;
 	bool force_key_frame;
+	bool prioritize_speed;
 
 	struct ave_session *sess;
 	atomic_t ready; /* outputs waiting for a CAPTURE buffer */
@@ -434,6 +446,7 @@ struct ave_vb2_mem *ave_vb2_get(struct vb2_buffer *vb);
 void ave_vb2_put(void *buf_priv);
 
 /* ave-sess.c */
+u32 ave_cq_initial_qp(u32 quality);
 struct ave_session *ave_sess_create(struct ave_ctx *ctx);
 void ave_sess_destroy(struct ave_ctx *ctx);
 void ave_sess_reap(struct ave_dev *ave);
