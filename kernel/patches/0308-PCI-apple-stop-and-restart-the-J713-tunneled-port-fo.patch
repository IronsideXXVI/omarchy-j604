From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Tue, 10 Nov 2026 00:00:48 -0500
Subject: [PATCH] PCI: apple: stop and restart the J713 tunneled port
 for a deep sleep

The tunneled PCIe port behind a Thunderbolt dock loses its clocks and
its DART in a deep sleep, and nothing brings them back.

With pcie_apple.cio_s2r=1 on the J713, the port's DART is owned by the
port instead of linked for runtime PM, and the ACIO host prepares and
finishes a native transaction around the sleep. In it the port's noirq
suspend drains the port, closes config space, asserts the tunnel reset
and PERST, powers the DART down and stops the port clock. The noirq
resume runs the cold port setup again (tunables, port reset table,
PERST and clock, root tunables, interrupt routing), restores the
requester and MSI routes and the DART, releases the tunnel reset and
waits for the link. If the suspend is abandoned after the local PERST,
the same full setup runs. Config space is closed under a lock that
config accesses hold from map_bus() to the access.

A port whose link does not come back, for a dock unplugged or powered
off during the sleep, ends like a surprise removal: the port stays
stopped, its hierarchy is marked disconnected and removed with the
tunnel after resume, and the DART transaction still ends. When the ACIO
host already knows the dock is gone, the port does not wait for the
link.

A deep sleep that the ACIO host did not prepare for this port is
refused in .prepare, before any other device suspends.

T8132 acknowledges the tunnel PERST by setting bit 1, and the link wait
is bounded to one second.

The parameter defaults to off: the ACIO host, PHY and DART parts have
to be present and enabled together.

Signed-off-by: Erik Bourget <erik@ebourget.net>
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit a53bbd8805b860497b6063d6399316a19b0b0523)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/pci/controller/pcie-apple-cio.c | 206 ++++++++++++++++++++++++
 drivers/pci/controller/pcie-apple.c     |  85 +++++++++-
 include/linux/pci-apple.h               |   6 +
 3 files changed, 292 insertions(+), 5 deletions(-)
 create mode 100644 drivers/pci/controller/pcie-apple-cio.c

diff --git a/drivers/pci/controller/pcie-apple-cio.c b/drivers/pci/controller/pcie-apple-cio.c
new file mode 100644
index 0000000000..949e70eb43
--- /dev/null
+++ b/drivers/pci/controller/pcie-apple-cio.c
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Included by pcie-apple.c. The NHI owns this system-sleep transaction. */
+static void apple_pcie_cio_set_changed(struct apple_pcie *pcie, bool changed)
+{
+	/* Config cycles run under the lock, from map_bus() to the access. */
+	scoped_guard(raw_spinlock_irqsave, &pcie->cio_cfg_lock)
+		WRITE_ONCE(pcie->cio_changed, changed);
+}
+
+int apple_pcie_tunnel_cio_prepare(struct device *dev)
+{
+	struct apple_pcie *pcie = apple_pcie_lookup(dev);
+	int ret;
+
+	if (!pcie || !pcie->cio_dart || pm_suspend_target_state != PM_SUSPEND_MEM)
+		return -EOPNOTSUPP;
+	if (pcie->cio_prepared || !list_is_singular(&pcie->ports) ||
+	    pcie->bus_stopped || pcie->resume_failed ||
+	    !apple_pcie_tunnel_link_healthy(pcie))
+		return -EBUSY;
+	/* ACIO's syscore domain devices hold the supplies until the NHI stops. */
+	ret = apple_dart_cio_prepare(pcie->cio_dart);
+	if (ret)
+		return ret;
+	apple_pcie_cio_set_changed(pcie, false);
+	pcie->cio_stopped = false;
+	pcie->cio_port_reset = false;
+	pcie->cio_lost = false;
+	pcie->cio_prepared = true;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_pcie_tunnel_cio_prepare);
+
+bool apple_pcie_tunnel_cio_stopped(struct device *dev)
+{
+	struct apple_pcie *pcie = apple_pcie_lookup(dev);
+
+	return pcie && pcie->cio_prepared && pcie->cio_stopped;
+}
+EXPORT_SYMBOL_GPL(apple_pcie_tunnel_cio_stopped);
+
+/* The NHI found the tunnel's peer gone: do not wait for this link. */
+void apple_pcie_tunnel_cio_lost(struct device *dev)
+{
+	struct apple_pcie *pcie = apple_pcie_lookup(dev);
+
+	if (pcie && pcie->cio_prepared)
+		pcie->cio_lost = true;
+}
+EXPORT_SYMBOL_GPL(apple_pcie_tunnel_cio_lost);
+
+int apple_pcie_tunnel_cio_finish(struct device *dev)
+{
+	struct apple_pcie *pcie = apple_pcie_lookup(dev);
+	int ret;
+
+	if (!pcie || !pcie->cio_prepared)
+		return -EINVAL;
+	/* Only a port that failed to resume may still be changed. */
+	if (pcie->cio_changed && !pcie->resume_failed)
+		return -EUCLEAN;
+	/* This ends the DART transaction whatever it reports. */
+	ret = apple_dart_cio_finish(pcie->cio_dart);
+	pcie->cio_prepared = false;
+	/* A failed port was retired like a surprise removal; its DART logged. */
+	return pcie->resume_failed ? 0 : ret;
+}
+EXPORT_SYMBOL_GPL(apple_pcie_tunnel_cio_finish);
+
+/* All descendants are still suspended; the NHI has restored the router paths. */
+static int apple_pcie_cio_resume(struct apple_pcie *pcie)
+{
+	struct apple_pcie_port *port;
+	u32 stat;
+	int i, ret;
+
+	if (!pcie->cio_changed)
+		return 0;
+	port = list_first_entry(&pcie->ports, struct apple_pcie_port, entry);
+	/* Until it is back, a later teardown must still stop the port. */
+	port->needs_stop = true;
+	if (pcie->cio_port_reset) {
+		/*
+		 * Rebuild after local PERST even if APPCLK never went off.
+		 * Keep tunneled PERST asserted throughout the register replay.
+		 */
+		apple_pcie_port_rmw_set(port, PORT_TUNCTRL_PERST_ON,
+					apple_pcie_port_tunctrl(port));
+		ret = apple_pcie_tunnel_cold_init(port);
+		if (ret)
+			return ret;
+	} else {
+		apple_pcie_tunnel_pulse_intr2axi(pcie);
+	}
+	apple_pcie_tunnel_restore_irq_hw(port);
+	for_each_set_bit(i, port->sid_map, port->sid_map_sz)
+		apple_pcie_rid2sid_write(port, i, port->saved_rid2sid[i]);
+	ret = apple_dart_cio_on(pcie->cio_dart);
+	if (ret)
+		return ret;
+	/* Do not use tunnel_start(): its lost-power branch resets these maps. */
+	apple_pcie_port_rmw_set(port, PORT_APPCLK_EN, PORT_APPCLK);
+	apple_pcie_port_rmw_set(port, PORT_PERST_OFF, pcie->hw->port_perst);
+	ret = read_poll_timeout(apple_pcie_port_readl, stat,
+				stat & PORT_STATUS_READY,
+				10, 250000, false, port, PORT_STATUS);
+	if (ret) {
+		dev_err(pcie->dev, "CIO PCIe-C READY timeout: status=%#x\n", stat);
+		return ret;
+	}
+	/* The DART is back; the tunneled reset stays asserted with no peer. */
+	if (pcie->cio_lost)
+		return -ENOTCONN;
+	ret = apple_pcie_tunnel_release_reset(port);
+	if (ret)
+		return ret;
+	apple_pcie_port_writel(port, BIT(PORT_INT_LINK_UP) | BIT(PORT_INT_LINK_DOWN) |
+			      BIT(PORT_INT_TUNNEL_ERR), PORT_INTSTAT);
+	apple_pcie_port_writel(port, PORT_LTSSMCTL_START, PORT_LTSSMCTL);
+	ret = read_poll_timeout(apple_pcie_port_readl, stat,
+				stat & PORT_LINKSTS_UP,
+				1000, 1000000, false, port, PORT_LINKSTS);
+	if (ret) {
+		dev_err(pcie->dev, "CIO PCIe-C link timeout: link=%#x events=%#x reset=%#x\n",
+			stat, apple_pcie_port_readl(port, PORT_INTSTAT),
+			apple_pcie_port_readl(port, apple_pcie_port_tunstat(port)));
+		return ret;
+	}
+	apple_pcie_tunnel_link_up(pcie);
+	apple_pcie_tunnel_wait_ready(pcie);
+	if (!(apple_pcie_port_readl(port, PORT_LINKSTS) & PORT_LINKSTS_UP))
+		return -ENOLINK;
+	WRITE_ONCE(port->started, true);
+	port->needs_stop = false;
+	/* Publish the usable port before an interrupt can schedule link work. */
+	wmb();
+	apple_pcie_port_writel(port, port->saved_intmask, PORT_INTMSK);
+	apple_pcie_port_enable_irq(port);
+	apple_pcie_cio_set_changed(pcie, false);
+	pcie->cio_stopped = false;
+	pcie->cio_port_reset = false;
+	dev_info(pcie->dev, "CIO PCIe-C link and DMA restored\n");
+	return 0;
+}
+
+static int apple_pcie_cio_suspend(struct apple_pcie *pcie)
+{
+	struct apple_pcie_port *port;
+	bool idle;
+	u32 stat;
+	int i, ret, recover;
+
+	port = list_first_entry(&pcie->ports, struct apple_pcie_port, entry);
+	dev_info(pcie->dev, "CIO PCIe-C drain and reset\n");
+	apple_pcie_port_disable_irq(port);
+	port->saved_intmask = apple_pcie_port_readl(port, PORT_INTMSK);
+	for_each_set_bit(i, port->sid_map, port->sid_map_sz)
+		port->saved_rid2sid[i] = apple_pcie_port_readl(port, port_rid2sid_offset(port, i));
+	apple_pcie_cio_set_changed(pcie, true);
+	apple_pcie_port_writel(port, ~0, PORT_INTMSK);
+	apple_pcie_port_rmw_clear(port, PORT_LTSSMCTL_START, PORT_LTSSMCTL);
+	ret = read_poll_timeout(apple_pcie_tunnel_transactions_idle, idle,
+				idle, 10, 20000, false, port);
+	if (ret)
+		goto unwind;
+	apple_pcie_port_rmw_set(port, PORT_TUNCTRL_PERST_ON, apple_pcie_port_tunctrl(port));
+	/* PERST may reset descendants even when the acknowledgment times out. */
+	apple_pcie_tunnel_hierarchy_lost(pcie->dev);
+	ret = read_poll_timeout(apple_pcie_port_readl, stat,
+				stat & PORT_TUNSTAT_PERST_ON,
+				1000, 100000, false, port, apple_pcie_port_tunstat(port));
+	if (ret)
+		goto unwind;
+	pcie->cio_port_reset = true;
+	apple_pcie_port_rmw_clear(port, PORT_PERST_OFF, pcie->hw->port_perst);
+	/* The DART window is still clocked here. GAPF goes down before APPCLK. */
+	ret = apple_dart_cio_off(pcie->cio_dart);
+	if (ret)
+		goto unwind;
+	apple_pcie_port_rmw_clear(port, PORT_APPCLK_EN, PORT_APPCLK);
+	ret = read_poll_timeout(apple_pcie_port_readl, stat,
+				!(stat & PORT_STATUS_READY),
+				10, 100000, false, port, PORT_STATUS);
+	if (ret)
+		goto unwind;
+	apple_pcie_port_rmw_set(port, PORT_TUNCTRL_PERST_ACK_REQ,
+				apple_pcie_port_tunctrl(port));
+	/* T8132 reports the completed acknowledgment with bit 1 set. */
+	ret = read_poll_timeout(apple_pcie_port_readl, stat,
+				stat & PORT_TUNSTAT_PERST_ACK_PEND,
+				1000, 1000000, false, port, apple_pcie_port_tunstat(port));
+	apple_pcie_port_rmw_clear(port, PORT_TUNCTRL_PERST_ACK_REQ,
+				  apple_pcie_port_tunctrl(port));
+	if (ret)
+		goto unwind;
+	WRITE_ONCE(port->started, false);
+	pcie->cio_stopped = true;
+	dev_info(pcie->dev, "CIO PCIe-C stopped\n");
+	return 0;
+unwind:
+	/* PM does not resume a device whose own suspend callback failed. */
+	recover = apple_pcie_cio_resume(pcie);
+	if (recover)
+		panic("Apple PCIe-C: suspend %d, recovery %d; DMA remains closed", ret, recover);
+	return ret;
+}
diff --git a/drivers/pci/controller/pcie-apple.c b/drivers/pci/controller/pcie-apple.c
index 7245b5eb10..4938ad8acc 100644
--- a/drivers/pci/controller/pcie-apple.c
+++ b/drivers/pci/controller/pcie-apple.c
@@ -40,6 +40,7 @@
 #include <linux/rcupdate.h>
 #include <linux/reset.h>
 #include <linux/soc/apple/dart.h>
+#include <linux/soc/apple/dart-cio.h>
 #include <linux/soc/apple/dart-sleep.h>
 #include <linux/soc/apple/radio-sleep.h>
 #include <linux/soc/apple/sleep.h>
@@ -69,6 +70,11 @@ static bool s2idle_keep_link = true;
 module_param(s2idle_keep_link, bool, 0644);
 MODULE_PARM_DESC(s2idle_keep_link, "Keep tunneled links up through suspend-to-idle");
 
+/* Opt-in until the NHI, PHY and DART power cycle is qualified together. */
+static bool cio_s2r;
+module_param(cio_s2r, bool, 0400);
+MODULE_PARM_DESC(cio_s2r, "Enable NHI-owned J713 PCIe-C system sleep");
+
 static int link_up_timeout = 500;
 /* Fundamental resets of a conventional port whose endpoint does not train. */
 #define LINK_RESET_RETRIES	2
@@ -519,6 +525,10 @@ struct apple_pcie {
 	struct reset_control	*reset;
 	u16			managed_sids;
 	struct apple_radio_sleep *radio;
+	struct apple_dart_cio *cio_dart;
+	/* orders cio_changed against config cycles already past map_bus() */
+	raw_spinlock_t cio_cfg_lock;
+	bool cio_prepared, cio_changed, cio_stopped, cio_port_reset, cio_lost;
 	unsigned int radio_writers;
 	bool radio_closed;
 	bool			neo_config_ready;
@@ -3761,6 +3771,8 @@ static void __iomem *apple_pcie_map_bus(struct pci_bus *bus,
 	struct apple_pcie *pcie = apple_pcie_lookup(cfg->parent);
 	struct apple_pcie_port *port;
 
+	if (READ_ONCE(pcie->cio_changed))
+		return NULL;
 	if (!apple_radio_config_allowed(pcie))
 		return NULL;
 	if (pcie->hw->adopt_link) {
@@ -3818,7 +3830,9 @@ static int apple_pcie_config_read(struct pci_bus *bus, unsigned int devfn, int w
 {
 	struct pci_config_window *cfg = bus->sysdata;
 	struct apple_pcie *pcie = apple_pcie_lookup(cfg->parent);
+	unsigned long flags;
 	u8 pm_cap;
+	int ret;
 
 	if (pcie && READ_ONCE(pcie->neo_radio_waking) && bus->number == pcie->neo_secondary_bus &&
 	    !PCI_SLOT(devfn) && PCI_FUNC(devfn) <= 1) {
@@ -3828,7 +3842,13 @@ static int apple_pcie_config_read(struct pci_bus *bus, unsigned int devfn, int w
 			return PCIBIOS_SUCCESSFUL;
 		}
 	}
-	return pci_generic_config_read(bus, devfn, where, size, val);
+	if (!pcie || !pcie->cio_dart)
+		return pci_generic_config_read(bus, devfn, where, size, val);
+	/* A deep-sleep stop closes config space under this lock. */
+	raw_spin_lock_irqsave(&pcie->cio_cfg_lock, flags);
+	ret = pci_generic_config_read(bus, devfn, where, size, val);
+	raw_spin_unlock_irqrestore(&pcie->cio_cfg_lock, flags);
+	return ret;
 }
 
 static int apple_pcie_config_write(struct pci_bus *bus, unsigned int devfn,
@@ -3837,9 +3857,16 @@ static int apple_pcie_config_write(struct pci_bus *bus, unsigned int devfn,
 	struct pci_config_window *cfg = bus->sysdata;
 	struct apple_pcie *pcie = apple_pcie_lookup(cfg->parent);
 	struct apple_pcie_port *port;
+	unsigned long flags;
 	int ret;
 
-	ret = pci_generic_config_write(bus, devfn, where, size, val);
+	if (pcie && pcie->cio_dart) {
+		raw_spin_lock_irqsave(&pcie->cio_cfg_lock, flags);
+		ret = pci_generic_config_write(bus, devfn, where, size, val);
+		raw_spin_unlock_irqrestore(&pcie->cio_cfg_lock, flags);
+	} else {
+		ret = pci_generic_config_write(bus, devfn, where, size, val);
+	}
 	if (ret || !pcie)
 		return ret;
 	if (bus->number != cfg->busr.start || devfn)
@@ -4192,7 +4219,12 @@ static int apple_pcie_tunnel_add_links(struct apple_pcie *pcie)
 		return dev_err_probe(pcie->dev, -EPROBE_DEFER,
 				     "PCIe-C DART device is not ready\n");
 
-	ret = apple_pcie_tunnel_add_link(pcie, &dart_pdev->dev, pcie->dev);
+	raw_spin_lock_init(&pcie->cio_cfg_lock);
+	if (cio_s2r && pcie->hw == &t8132_pciec_hw &&
+	    of_machine_is_compatible("apple,j713"))
+		ret = apple_dart_cio_bind(pcie->dev, &dart_pdev->dev, &pcie->cio_dart);
+	else
+		ret = apple_pcie_tunnel_add_link(pcie, &dart_pdev->dev, pcie->dev);
 	put_device(&dart_pdev->dev);
 	if (ret)
 		return dev_err_probe(pcie->dev, ret,
@@ -5707,6 +5739,8 @@ static bool apple_pcie_keep_link(struct apple_pcie *pcie)
 	return false;
 }
 
+#include "pcie-apple-cio.c"
+
 static void apple_pcie_stop_for_sleep(struct device *dev)
 {
 	struct apple_pcie *pcie = apple_pcie_lookup(dev);
@@ -5805,6 +5839,11 @@ static int apple_pcie_suspend_noirq(struct device *dev)
 {
 	struct apple_pcie *pcie = apple_pcie_lookup(dev);
 
+	if (pcie->cio_prepared)
+		return apple_pcie_cio_suspend(pcie);
+	/* The reversed DART link is safe only with retained clocks or native PM. */
+	if (pcie->cio_dart && (!pm_suspend_no_platform() || !s2idle_keep_link))
+		return -EBUSY;
 	if (pcie->neo_sleep_armed) {
 		struct apple_pcie_port *port;
 
@@ -5852,8 +5891,11 @@ static int apple_pcie_suspend_noirq(struct device *dev)
 	}
 	pcie->reset_on_resume = false;
 	pcie->link_kept = apple_pcie_keep_link(pcie);
-	if (!pcie->link_kept)
+	if (!pcie->link_kept) {
+		if (pcie->cio_dart)
+			return -EBUSY;
 		apple_pcie_stop_for_sleep(dev);
+	}
 	return 0;
 }
 
@@ -6303,6 +6345,21 @@ static int apple_pcie_resume_noirq(struct device *dev)
 
 	/* The domain's hold for the sleep ends first, whatever follows. */
 	apple_pcie_release_domains(pcie);
+	if (pcie->cio_prepared) {
+		ret = apple_pcie_cio_resume(pcie);
+		if (!ret)
+			return 0;
+		/*
+		 * A dock that left or lost power during the sleep. End like a
+		 * surprise removal: the port stays stopped and config space
+		 * closed, and the hierarchy is removed with the tunnel after
+		 * resume. The NHI still ends the DART transaction.
+		 */
+		dev_err(dev, "PCIe-C not back after deep sleep: %d\n", ret);
+		pcie->resume_failed = true;
+		apple_pcie_tunnel_hierarchy_gone(dev);
+		return ret;
+	}
 	if (pcie->managed_sids)
 		return apple_radio_resume_noirq(pcie);
 	if (pcie->neo_sleep_armed)
@@ -6388,8 +6445,26 @@ static int apple_pcie_resume_noirq(struct device *dev)
 	return ret;
 }
 
+static int apple_pcie_prepare(struct device *dev)
+{
+	struct apple_pcie *pcie = apple_pcie_lookup(dev);
+
+	/*
+	 * A host-owned PCIe-C DART sleeps only inside the NHI's deep-sleep
+	 * transaction, prepared before this, or with a kept s2idle link.
+	 * Refuse anything else now, before other devices suspend.
+	 */
+	if (pcie && pcie->cio_dart && !pcie->cio_prepared &&
+	    pm_suspend_target_state != PM_SUSPEND_ON &&
+	    (!pm_suspend_no_platform() || !s2idle_keep_link)) {
+		dev_warn(dev, "no CIO sleep transaction from the NHI; refusing sleep\n");
+		return -EBUSY;
+	}
+	return apple_radio_prepare(dev);
+}
+
 static const struct dev_pm_ops apple_pcie_pm_ops = {
-	.prepare = apple_radio_prepare,
+	.prepare = apple_pcie_prepare,
 	.complete = apple_radio_complete,
 	.suspend_noirq = apple_pcie_suspend_noirq,
 	.resume_noirq = apple_pcie_resume_noirq,
diff --git a/include/linux/pci-apple.h b/include/linux/pci-apple.h
index b446c5e222..7e90cc2de5 100644
--- a/include/linux/pci-apple.h
+++ b/include/linux/pci-apple.h
@@ -19,4 +19,10 @@ int apple_pcie_tunnel_restore(struct device *dev);
 int apple_pcie_tunnel_check_state(struct device *dev);
 bool apple_pcie_tunnel_link_kept(struct device *dev);
 
+/* NHI prepares/finishes; PCIe device noirq callbacks own the port and DART. */
+int apple_pcie_tunnel_cio_prepare(struct device *dev);
+bool apple_pcie_tunnel_cio_stopped(struct device *dev);
+void apple_pcie_tunnel_cio_lost(struct device *dev);
+int apple_pcie_tunnel_cio_finish(struct device *dev);
+
 #endif /* _LINUX_PCI_APPLE_H */
-- 
