From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 14:19:52 +0000
Subject: [PATCH] drm/asahi: g16: Count why a render command is not
 posted ahead

render.light on the M4 runs at about a third of macOS's rate while its
GPU time per command is half of macOS's whole per-command time: about
two thirds of the commands reach the firmware only after the previous
one ended, and those posted ahead start 10-20 us after it where macOS
starts the next one about 2 us after. The engine's hold count does not
say which condition of the render ahead rule refused a command.

Count it, as the previous commit does for compute: the resident or
flight depth, a flight that is not a healthy render-only one, no draw
ordinal yet or a frozen engine, or none of those; and for each render
command posted behind running flights, count it and the flights it
found. A new stats line "rhorizon:" prints them. Statistics only;
publication is unchanged.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/engine.rs | 39 +++++++++++++++++++++++++++++
 drivers/gpu/drm/asahi/g16/poll.rs   |  5 ++++
 2 files changed, 44 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index ba8b393a93..1f0bf43c27 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -409,6 +409,12 @@ pub(crate) struct Stats {
     pub(crate) hz_stop: [u64; 4],
     pub(crate) hz_behind: u64,
     pub(crate) hz_ahead: u64,
+    /// Render: why a render command was held behind running flights (the resident depth,
+    /// a flight that is not a healthy render-only one, no draw ordinal yet or frozen, none of
+    /// those); render commands posted behind running flights and the flights they found.
+    pub(crate) rz_stop: [u64; 4],
+    pub(crate) rz_behind: u64,
+    pub(crate) rz_ahead: u64,
     /// Why ready jobs stayed unpublished: both flights published, a channel record unconsumed,
     /// no free slot.
     pub(crate) hold: [u64; 3],
@@ -961,6 +967,31 @@ fn compute_ahead_refusal(&self) -> usize {
         }
     }
 
+    /// Why [`Self::ahead_ok`] refuses a render command behind running flights, for the stats
+    /// line `rhorizon: stop a/b/c/d`: 0 the resident / flight depth, 1 a flight that is not a
+    /// healthy render-only one, 2 no draw ordinal yet or the engine frozen, 3 none of those.
+    fn render_ahead_refusal(&self) -> usize {
+        let n = self.engine.flights.len();
+        let limit = match params::resident() {
+            0 => params::flights().max(1 + params::depth() as usize),
+            r => r,
+        };
+        if n >= limit.min(sizes::FLIGHTS) {
+            0
+        } else if !self
+            .engine
+            .flights
+            .iter()
+            .all(|f| f.computes == 0 && f.renders != 0 && !f.doomed && !f.recovery_suspect)
+        {
+            1
+        } else if self.engine.draw == 0 || self.engine.frozen {
+            2
+        } else {
+            3
+        }
+    }
+
     /// Publishes one command after the preceding command's complete wire receipt. Ordinary
     /// preparation failures fail the affected job, including after its earlier commands
     /// retired. A publication marked uncertain denotes potentially visible firmware state
@@ -1005,6 +1036,11 @@ pub(crate) fn publish(&mut self, done: &mut Completions) -> Result {
                 {
                     let reason = self.compute_ahead_refusal();
                     self.engine.stats.hz_stop[reason] += 1;
+                } else if job.vm.status.get() == 0
+                    && matches!(command(&job, job.progress.sent()), Some(Command::Render(_)))
+                {
+                    let reason = self.render_ahead_refusal();
+                    self.engine.stats.rz_stop[reason] += 1;
                 }
                 break;
             }
@@ -1067,6 +1103,9 @@ pub(crate) fn publish(&mut self, done: &mut Completions) -> Result {
                     if compute && behind != 0 {
                         self.engine.stats.hz_behind += 1;
                         self.engine.stats.hz_ahead += behind;
+                    } else if !compute && behind != 0 {
+                        self.engine.stats.rz_behind += 1;
+                        self.engine.stats.rz_ahead += behind;
                     }
                     self.recovery.publication_wait_deadline = None;
                     if job.progress.sent() == job.progress.count() {
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 0d7b970840..c95c6071ea 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -1266,6 +1266,11 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
             s.hold[2],
             s.hz_ahead
         )?;
+        writeln!(
+            f,
+            "rhorizon: stop {}/{}/{}/{} behind {} ahead {}",
+            s.rz_stop[0], s.rz_stop[1], s.rz_stop[2], s.rz_stop[3], s.rz_behind, s.rz_ahead
+        )?;
         self.pools.write_stats(f)?;
         writeln!(
             f,
