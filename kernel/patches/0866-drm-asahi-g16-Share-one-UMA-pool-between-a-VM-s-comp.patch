From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 00:39:10 +0000
Subject: [PATCH] drm/asahi: g16: Share one UMA pool between a VM's
 compute units by default

Every compute unit of a VM allocates its own 32 MiB UMA pool, pool state
and page list at the VM's first compute command, so a compute client
costs about 519 MiB with the 16 units of the default window. The
firmware runs the compute ring in order, and with g16_compute_shared_pool
the units after the first take unit 0's pool, keeping only their own
descriptor, UMA slot, context store and per-command buffers (about 297
KiB each): about 37 MiB per compute VM for the same 16 units.

Make the shared pool the default. The window is unchanged. The module
option g16_compute_shared_pool=0 restores one pool per unit.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index f2bc617769..35bbaa6f93 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -820,8 +820,8 @@ pub(crate) fn compute_units() -> usize {
     "G16: compute units per VM, one compute command in flight each (default 16; 2..16; 12 = k948; 8 = before; 4 = k908; 9..16 = deeper compute queue, ~33 MiB per unit, 13..16 for g16_horizon up to 15; latched at the engine start, set it as a module option)"
 );
 
-/// Storage of `g16_compute_shared_pool` (0644, default 0; latched at its first read).
-static COMPUTE_SHARED_POOL: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_compute_shared_pool` (0644, default 1; latched at its first read).
+static COMPUTE_SHARED_POOL: AtomicU32 = AtomicU32::new(1);
 /// 0 until latched, then 1 (off) or 2 (on).
 static COMPUTE_SHARED_POOL_LATCH: AtomicU32 = AtomicU32::new(0);
 
@@ -855,7 +855,7 @@ pub(crate) fn compute_shared_pool_state() -> u32 {
     COMPUTE_SHARED_POOL_PARM,
     COMPUTE_SHARED_POOL,
     "g16_compute_shared_pool",
-    "G16: 1 = all compute units of a VM allocate from unit 0's UMA pool, each command keeping its own descriptor, UMA slot and context store (default 0: one pool per unit; latched at the first compute command, set it as a module option)"
+    "G16: 1 (default) = all compute units of a VM allocate from unit 0's UMA pool, each command keeping its own descriptor, UMA slot and context store; 0 = one 32 MiB pool per unit; latched at the first compute command, set it as a module option"
 );
 
 live_u32_param!(
