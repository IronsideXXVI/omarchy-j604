From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Sun, 8 Nov 2026 22:32:16 -0500
Subject: [PATCH] usb: typec: tipd: preserve dry result during LDCM
 startup

An empty SN201202x port can take 1.6 seconds to acknowledge LDCM at startup. Allow five seconds so a command still running is not treated as a failed mitigation change.

Removing mitigation can start a new measurement after a valid dry snapshot. Preserve that result while the new measurement is in progress, as the existing entry path does for a published result. Re-enabling mitigation immediately can hold the detector in the measuring state and permanently suppress a later dock attachment.

Keep failures and liquid results mitigated. Exercise the dry-to-measuring transition from every previous state and the failed re-read path in KUnit.

Developed with Claude Code.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit a442efa4477ad2f39086f53c854839cc3e0a09fb)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/usb/typec/tipd/core.c              |  5 +-
 drivers/usb/typec/tipd/sn201202x-pm-test.c | 53 ++++++++++++++++++++++
 drivers/usb/typec/tipd/spmi.c              | 18 +++++++-
 3 files changed, 72 insertions(+), 4 deletions(-)

diff --git a/drivers/usb/typec/tipd/core.c b/drivers/usb/typec/tipd/core.c
index 6c8f5cdc26..a6582cf365 100644
--- a/drivers/usb/typec/tipd/core.c
+++ b/drivers/usb/typec/tipd/core.c
@@ -3080,8 +3080,9 @@ int tipd_init(struct tps6598x *tps)
 	if (tps->contaminant_ops) {
 		ret = tps->contaminant_ops->update(tps);
 		if (ret) {
-			dev_warn(tps->dev,
-				 "connector contaminant state unavailable: %d\n", ret);
+			if (ret != -EINPROGRESS)
+				dev_warn(tps->dev,
+					 "connector contaminant state unavailable: %d\n", ret);
 			ret = 0;
 		}
 	}
diff --git a/drivers/usb/typec/tipd/sn201202x-pm-test.c b/drivers/usb/typec/tipd/sn201202x-pm-test.c
index 68e36f6d95..ae55166c33 100644
--- a/drivers/usb/typec/tipd/sn201202x-pm-test.c
+++ b/drivers/usb/typec/tipd/sn201202x-pm-test.c
@@ -826,6 +826,57 @@ static void sn201202x_ldcm_dry_order_test(struct kunit *test)
 	sn201202x_ldcm_test_actions(test, &t, actions, ARRAY_SIZE(actions));
 }
 
+static void sn201202x_ldcm_dry_then_busy_test(struct kunit *test)
+{
+	static const enum typec_contaminant last[] = {
+		TYPEC_CONTAMINANT_UNKNOWN,
+		TYPEC_CONTAMINANT_NONE,
+		TYPEC_CONTAMINANT_LIQUID,
+	};
+	const enum sn201202x_ldcm_test_action actions[] = {
+		LDCM_TEST_READ,
+		LDCM_TEST_MITIGATE_OFF,
+		LDCM_TEST_READ,
+		LDCM_TEST_PUBLISH_NONE,
+	};
+	unsigned int i;
+
+	/* Removing mitigation can start a measurement after a fresh dry result. */
+	for (i = 0; i < ARRAY_SIZE(last); i++) {
+		struct sn201202x_ldcm_test t = {
+			.reads = { TYPEC_CONTAMINANT_NONE, TYPEC_CONTAMINANT_UNKNOWN },
+		};
+
+		KUNIT_EXPECT_EQ(test, sn201202x_ldcm_update_state(&t,
+								  &sn201202x_ldcm_test_ops,
+								  last[i]),
+				-EINPROGRESS);
+		sn201202x_ldcm_test_actions(test, &t, actions,
+					    ARRAY_SIZE(actions));
+	}
+}
+
+static void sn201202x_ldcm_dry_then_read_failure_test(struct kunit *test)
+{
+	const enum sn201202x_ldcm_test_action actions[] = {
+		LDCM_TEST_READ,
+		LDCM_TEST_MITIGATE_OFF,
+		LDCM_TEST_READ,
+		LDCM_TEST_MITIGATE_ON,
+		LDCM_TEST_PUBLISH_UNKNOWN,
+	};
+	struct sn201202x_ldcm_test t = {
+		.reads = { TYPEC_CONTAMINANT_NONE, TYPEC_CONTAMINANT_UNKNOWN },
+		.read_rets = { 0, -EIO },
+	};
+
+	/* A failed second read must still mitigate, even after a dry result. */
+	KUNIT_EXPECT_EQ(test, sn201202x_ldcm_update_state(&t,
+							  &sn201202x_ldcm_test_ops,
+							  TYPEC_CONTAMINANT_UNKNOWN), -EIO);
+	sn201202x_ldcm_test_actions(test, &t, actions, ARRAY_SIZE(actions));
+}
+
 static void sn201202x_ldcm_dry_race_test(struct kunit *test)
 {
 	const enum sn201202x_ldcm_test_action actions[] = {
@@ -945,6 +996,8 @@ static struct kunit_case sn201202x_pm_cases[] = {
 	KUNIT_CASE(sn201202x_ldcm_read_failure_order_test),
 	KUNIT_CASE(sn201202x_ldcm_mitigation_failure_order_test),
 	KUNIT_CASE(sn201202x_ldcm_dry_order_test),
+	KUNIT_CASE(sn201202x_ldcm_dry_then_busy_test),
+	KUNIT_CASE(sn201202x_ldcm_dry_then_read_failure_test),
 	KUNIT_CASE(sn201202x_ldcm_dry_race_test),
 	KUNIT_CASE(sn201202x_ldcm_dry_race_mitigation_failure_test),
 	KUNIT_CASE(sn201202x_ldcm_busy_keeps_result_test),
diff --git a/drivers/usb/typec/tipd/spmi.c b/drivers/usb/typec/tipd/spmi.c
index fba55637d9..1b9cc31692 100644
--- a/drivers/usb/typec/tipd/spmi.c
+++ b/drivers/usb/typec/tipd/spmi.c
@@ -300,9 +300,13 @@ static int sn201202x_ldcm_set_mitigation(void *ctx, bool enable)
 	if (sn->ldcm_mitigation_known && sn->ldcm_mitigated == enable)
 		return 0;
 
-	/* Successful task completion is the controller's mitigation ACK. */
+	/*
+	 * Successful task completion is the controller's mitigation ACK.
+	 * Startup commands can take more than a second on SN201202x. Wait for
+	 * completion before a retry can request the opposite mitigation state.
+	 */
 	ret = tps6598x_exec_cmd_tmo(tps, "LDCM", sizeof(command), &command,
-				   0, NULL, 1000, 0);
+				   0, NULL, 5000, 0);
 	sn->ldcm_mitigation_known = !ret;
 	if (!ret)
 		sn->ldcm_mitigated = enable;
@@ -354,6 +358,16 @@ sn201202x_ldcm_update_state(void *ctx, const struct sn201202x_ldcm_ops *ops,
 
 	/* Do not report dry if liquid appeared while mitigation was removed. */
 	read_ret = ops->read(ctx, &contaminant);
+	if (!read_ret && contaminant == TYPEC_CONTAMINANT_UNKNOWN) {
+		/*
+		 * Removing mitigation can start another measurement. The dry
+		 * snapshot above is still the latest result; preserve it just
+		 * as we preserve a previously published result at entry. Forcing
+		 * mitigation back on here can prevent the measurement finishing.
+		 */
+		ops->publish(ctx, TYPEC_CONTAMINANT_NONE);
+		return -EINPROGRESS;
+	}
 	if (read_ret || contaminant != TYPEC_CONTAMINANT_NONE) {
 		ret = ops->set_mitigation(ctx, true);
 		if (ret) {
