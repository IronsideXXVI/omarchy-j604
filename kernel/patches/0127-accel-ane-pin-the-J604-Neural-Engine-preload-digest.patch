From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 18:33:14 +0000
Subject: [PATCH] accel/ane: pin the J604 Neural Engine preload digest

The T8132 rule for the 25G83 leto preload has no pinned digest, so on the
J604 no preload matched once the bootloader handed the preload over:

  H16 preload has the H16 26.6.2 25G83 T8132 layout but digest 460ca9d3...
  H16 preload matches none of 1 firmware profiles, error -8

The digest also covers the values iBoot writes into the immutable patchbay
records, so it can only be read on the board itself, which is why the rule
was left for the first J604 boot to log. That boot logged it. Add it as a
J604 rule with the same records and rewritten range, listed before the
generic T8132 rule. The generic rule stays unpinned: another T8132 board
still logs its own digest, and h16_preload_digest still applies only there.

The T8132 platform still stops after the identity, before any power-up.

Test: ane-h16-preload gets a J604 case: same framing as the generic rule,
first in the list, pinned, distinct from every other build; a synthetic
preload validates against its own digest, fails after one immutable byte
changes, survives a mutable change, and never matches the J604 value.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
(cherry picked from commit 0217659554b93ccd0f2c6eb8968fb4bd85a0bc80)
(cherry picked from commit 98a6212357a555eaf96bfdc27654995b858007cf)
---
 drivers/accel/ane/ane_h16_boot_data.h    | 31 +++++++++--
 drivers/accel/ane/ane_h16_preload_test.c | 67 ++++++++++++++++++++++--
 2 files changed, 92 insertions(+), 6 deletions(-)

diff --git a/drivers/accel/ane/ane_h16_boot_data.h b/drivers/accel/ane/ane_h16_boot_data.h
index 46eb142d07..0ce8b0f48f 100644
--- a/drivers/accel/ane/ane_h16_boot_data.h
+++ b/drivers/accel/ane/ane_h16_boot_data.h
@@ -374,8 +374,9 @@ static const struct ane_h16_profile ane_h16_profiles[] __maybe_unused = {
  * TEXT 0xc0000 and DATA 0x2ac000, the same 42 patchbay records, each 0x4f0
  * bytes later in DATA, and the rewritten range (_rtk_tunables) at DATA
  * 0x1c0f0 + 0x6a0. The digest of the live preload also covers the values
- * iBoot writes into the immutable records and is not measured yet: until
- * it is, no preload matches this rule, and the driver logs the live digest
+ * iBoot writes into the immutable records, so it is pinned per board, from
+ * that board's own log. A board with no pinned digest matches only this
+ * generic rule, which authenticates nothing: the driver logs the live digest
  * ("H16 preload has the ... layout but digest ...") so it can be pinned.
  */
 static const struct ane_h16_preload_cell ane_h16_patchbay_25g83_t8132[] = {
@@ -428,16 +429,40 @@ static const struct ane_h16_preload_rule ane_h16_preload_25g83_t8132 = {
 	.cell_count = ARRAY_SIZE(ane_h16_patchbay_25g83_t8132),
 	.zero_start = 0x1c0f0,
 	.zero_end = 0x1c790,
-	/* Not measured: the J604 boot that first binds the driver logs it. */
+	/* Unpinned: a board without its own rule below logs its digest. */
 	.digest = { 0 },
 };
 
+/*
+ * The same leto preload as iBoot leaves it on the J604 (MacBook Pro 14-inch,
+ * M4): the generic records and rewritten range, and the digest the J604 logged
+ * on its first boot with the bootloader hand-over ("H16 preload has the H16
+ * 26.6.2 25G83 T8132 layout but digest ...").
+ */
+static const struct ane_h16_preload_rule ane_h16_preload_25g83_j604 = {
+	.cells = ane_h16_patchbay_25g83_t8132,
+	.cell_count = ARRAY_SIZE(ane_h16_patchbay_25g83_t8132),
+	.zero_start = 0x1c0f0,
+	.zero_end = 0x1c790,
+	.digest = {
+		0x46, 0x0c, 0xa9, 0xd3, 0x1c, 0x93, 0xd6, 0x97,
+		0x06, 0x58, 0x28, 0x96, 0xb5, 0x94, 0x1d, 0xc5,
+		0x27, 0xb8, 0x1a, 0xbb, 0xe7, 0x3c, 0x91, 0xa2,
+		0x59, 0x5f, 0x19, 0x67, 0x22, 0x4b, 0x71, 0xd5,
+	},
+};
+
 /*
  * T8132 builds. The build values are the 26A428 ones the T604x 25G83 build
  * uses (same RTKit, same DATA end); the T8132 platform stops after the
  * preload identity, before any of them is used (see ane_h16_t8132_platform).
  */
 static const struct ane_h16_profile ane_h16_profiles_t8132[] __maybe_unused = {
+	{
+		.identity = "H16 26.6.2 25G83 J604",
+		.preload = &ane_h16_preload_25g83_j604,
+		.build = &ane_h16_build_26a428,
+	},
 	{
 		.identity = "H16 26.6.2 25G83 T8132",
 		.preload = &ane_h16_preload_25g83_t8132,
diff --git a/drivers/accel/ane/ane_h16_preload_test.c b/drivers/accel/ane/ane_h16_preload_test.c
index 958b4b5bf7..f135acd5f0 100644
--- a/drivers/accel/ane/ane_h16_preload_test.c
+++ b/drivers/accel/ane/ane_h16_preload_test.c
@@ -333,7 +333,7 @@ static void preload_profiles_test(struct kunit *test)
 /*
  * The T8132 leto rule (25G83) frames the leto layout, rejects the T604x
  * aether layout of the same build and the other way round, and its
- * unmeasured digest authenticates nothing.
+ * unpinned digest authenticates nothing. It is the last T8132 profile.
  */
 static void preload_t8132_layout_test(struct kunit *test)
 {
@@ -343,8 +343,9 @@ static void preload_t8132_layout_test(struct kunit *test)
 	u8 digest[SHA256_DIGEST_SIZE];
 	unsigned int k;
 
-	KUNIT_ASSERT_EQ(test, ARRAY_SIZE(ane_h16_profiles_t8132), 1);
-	KUNIT_EXPECT_PTR_EQ(test, ane_h16_profiles_t8132[0].preload, leto);
+	KUNIT_ASSERT_EQ(test, ARRAY_SIZE(ane_h16_profiles_t8132), 2);
+	KUNIT_EXPECT_PTR_EQ(test, ane_h16_profiles_t8132[1].preload, leto);
+	KUNIT_EXPECT_FALSE(test, memchr_inv(leto->digest, 0, SHA256_DIGEST_SIZE));
 	KUNIT_ASSERT_EQ(test, leto->cell_count, aether->cell_count);
 	for (k = 0; k < leto->cell_count; k++) {
 		KUNIT_EXPECT_EQ(test, leto->cells[k].value, aether->cells[k].value + 0x4f0);
@@ -378,6 +379,65 @@ static void preload_t8132_layout_test(struct kunit *test)
 			-ENOEXEC);
 }
 
+/*
+ * The J604 rule frames exactly the generic leto layout, is pinned, comes
+ * first, and differs from every other build's digest. On a synthetic leto
+ * preload a rule carrying that preload's own digest validates (positive
+ * control); changing one immutable byte refuses it (negative control);
+ * changing a mutable value does not; the pinned J604 value authenticates
+ * no synthetic preload.
+ */
+static void preload_j604_pin_test(struct kunit *test)
+{
+	struct preload_fixture *f = test->priv;
+	const struct ane_h16_preload_rule *j604 = &ane_h16_preload_25g83_j604;
+	const struct ane_h16_preload_rule *leto = &ane_h16_preload_25g83_t8132;
+	struct ane_h16_preload_rule pinned = *j604;
+	unsigned int i, k, immutable = 0, mutable = 0;
+
+	KUNIT_ASSERT_EQ(test, ARRAY_SIZE(ane_h16_profiles_t8132), 2);
+	KUNIT_EXPECT_PTR_EQ(test, ane_h16_profiles_t8132[0].preload, j604);
+	KUNIT_EXPECT_PTR_EQ(test, j604->cells, leto->cells);
+	KUNIT_EXPECT_EQ(test, j604->cell_count, leto->cell_count);
+	KUNIT_EXPECT_EQ(test, j604->zero_start, leto->zero_start);
+	KUNIT_EXPECT_EQ(test, j604->zero_end, leto->zero_end);
+	KUNIT_EXPECT_PTR_EQ(test, ane_h16_profiles_t8132[0].build,
+			    ane_h16_profiles_t8132[1].build);
+	KUNIT_EXPECT_STRNEQ(test, ane_h16_profiles_t8132[0].identity,
+			    ane_h16_profiles_t8132[1].identity);
+	KUNIT_EXPECT_TRUE(test, memchr_inv(j604->digest, 0, SHA256_DIGEST_SIZE));
+	for (i = 0; i < ARRAY_SIZE(ane_h16_profiles); i++)
+		KUNIT_EXPECT_NE(test, memcmp(j604->digest, ane_h16_profiles[i].preload->digest,
+					     SHA256_DIGEST_SIZE), 0);
+
+	memset(f->data, 0xa5, ANE_H16_PRELOAD_DATA_SIZE);
+	for (k = 0; k < j604->cell_count; k++) {
+		memcpy(f->data + j604->cells[k].value - 8, j604->cells[k].tag, 4);
+		put_unaligned_le32(j604->cells[k].width, f->data + j604->cells[k].value - 4);
+		if (!j604->cells[k].mutable && !immutable)
+			immutable = j604->cells[k].value;
+		if (j604->cells[k].mutable && !mutable)
+			mutable = j604->cells[k].value;
+	}
+	KUNIT_ASSERT_NE(test, immutable, 0);
+	KUNIT_ASSERT_NE(test, mutable, 0);
+	KUNIT_ASSERT_EQ(test, ane_h16_preload_digest(j604, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+						     f->data, ANE_H16_PRELOAD_DATA_SIZE,
+						     pinned.digest), 0);
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_validate(&pinned, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+						       f->data, ANE_H16_PRELOAD_DATA_SIZE), 0);
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_validate(j604, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+						       f->data, ANE_H16_PRELOAD_DATA_SIZE),
+			-ENOEXEC);
+	f->data[mutable] ^= 0xff;
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_validate(&pinned, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+						       f->data, ANE_H16_PRELOAD_DATA_SIZE), 0);
+	f->data[immutable] ^= 0xff;
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_validate(&pinned, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+						       f->data, ANE_H16_PRELOAD_DATA_SIZE),
+			-ENOEXEC);
+}
+
 static struct kunit_case preload_cases[] = {
 	KUNIT_CASE(preload_identity_test),
 	KUNIT_CASE(preload_mutable_test),
@@ -388,6 +448,7 @@ static struct kunit_case preload_cases[] = {
 	KUNIT_CASE(preload_layout_select_test),
 	KUNIT_CASE(preload_profiles_test),
 	KUNIT_CASE(preload_t8132_layout_test),
+	KUNIT_CASE(preload_j604_pin_test),
 	{}
 };
 
