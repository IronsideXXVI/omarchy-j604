From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bartosz Nitka <niteria@gmail.com>
Date: Fri, 6 Nov 2026 17:50:08 +0100
Subject: [PATCH] pmdomain: apple: pmgr-pwrstate: let a consumer switch
 firmware-owned states

Add apple_pmgr_ps_consumer_off() and apple_pmgr_ps_consumer_on() for the
chain of apple,consumer-switched power states that starts at a consumer's
power domain: off child first, on parent first. genpd still sees the
states as firmware-owned and always on; the consumer has stopped its
coprocessor before power-off and restarts it after power-on.

Each state follows the native sequence. Power-off requires the state fully
on and not in reset, disables automatic power management while staying on
(when it was enabled), sets the apple,retention-workaround registers and
then power gates, clearing the history bits. Power-on powers on with
automatic power management disabled, gives the retention registers'
workaround bits back the values they had (no other bit: power-off changed
none) and then automatic power management as it was. Every write is read
back or waited for; a failure leaves the state failed until reboot, and
nothing is retried. A state that is not fully on is refused without being
touched. apple_pmgr_ps_consumer_check() says, changing nothing, whether
the chain can be powered off at all: consumer-switched, not failed and
not off. Whether a state is fully on is known only at power-off: under
automatic power management the J713 DCP CPU state reads level 0 while its
CPU idles.

KUnit: the J713 DCP CPU state reproduces the native power-off and power-on
writes as captured on macOS, and keeps retention bits outside the
workaround that change while it is off; a state without automatic power
management or retention keeps its other bits; and a state that is not on,
one whose actual state does not follow and a retention register that does
not take its value are refused or failed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit f65f779ce1c8fbb4e20a8b2a42552d0dc2d71984)
[j604: conflict resolved on a15y 0f06dbf809: context only (a15y lacks Aurora 8c2ba08c75 10 ms handshake, e8643eee08 parent wait); the patch adds were applied unchanged, verified identical to f65f779ce1 adds, no a15y line removed]
---
 drivers/pmdomain/apple/pmgr-pwrstate-test.c | 191 +++++++++++++
 drivers/pmdomain/apple/pmgr-pwrstate.c      | 285 ++++++++++++++++++++
 include/linux/soc/apple/pmgr-pwrstate.h     |  24 ++
 3 files changed, 500 insertions(+)
 create mode 100644 include/linux/soc/apple/pmgr-pwrstate.h

diff --git a/drivers/pmdomain/apple/pmgr-pwrstate-test.c b/drivers/pmdomain/apple/pmgr-pwrstate-test.c
index 64eceb75ed..0e0ec02b57 100644
--- a/drivers/pmdomain/apple/pmgr-pwrstate-test.c
+++ b/drivers/pmdomain/apple/pmgr-pwrstate-test.c
@@ -130,10 +130,201 @@ static void pmgr_ps_power_on_fails_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, r->auto_writes, 0U);
 }
 
+/*
+ * Consumer-switched states: a state word at offset 0 whose actual state
+ * follows the target (the history bits are set by a power-gate and cleared
+ * by writing them), retention registers as plain words, and a write log.
+ */
+struct pmgr_ps_test_bank {
+	u32 word[0x30000 / 4];
+	bool stuck;		/* the actual state no longer follows the target */
+	bool ignore_retention;	/* retention writes are dropped */
+	unsigned int nr_log;
+	struct { u32 reg, val; } log[16];
+};
+
+static int pmgr_ps_test_bank_read(void *ctx, unsigned int reg, unsigned int *val)
+{
+	struct pmgr_ps_test_bank *b = ctx;
+
+	*val = b->word[reg / 4];
+	return 0;
+}
+
+static int pmgr_ps_test_bank_write(void *ctx, unsigned int reg, unsigned int val)
+{
+	struct pmgr_ps_test_bank *b = ctx;
+	u32 old = b->word[reg / 4], target, cleared;
+
+	if (b->nr_log < ARRAY_SIZE(b->log)) {
+		b->log[b->nr_log].reg = reg;
+		b->log[b->nr_log++].val = val;
+	}
+	if (reg) {
+		if (!b->ignore_retention)
+			b->word[reg / 4] = val;
+		return 0;
+	}
+	target = FIELD_GET(APPLE_PMGR_PS_TARGET, val);
+	cleared = val & APPLE_PMGR_FLAGS;	/* written as 1: cleared */
+	val &= ~(APPLE_PMGR_PS_ACTUAL | APPLE_PMGR_FLAGS);
+	val |= old & APPLE_PMGR_FLAGS & ~cleared;
+	val |= FIELD_PREP(APPLE_PMGR_PS_ACTUAL,
+			  b->stuck ? FIELD_GET(APPLE_PMGR_PS_ACTUAL, old) : target);
+	if (!b->stuck && target == APPLE_PMGR_PS_PWRGATE)
+		val |= APPLE_PMGR_FLAGS;
+	b->word[0] = val;
+	return 0;
+}
+
+static const struct regmap_config pmgr_ps_test_bank_regmap = {
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.max_register = 0x30000 - 4,
+	.reg_read = pmgr_ps_test_bank_read,
+	.reg_write = pmgr_ps_test_bank_write,
+	.fast_io = true,
+};
+
+/* The J713 DCP CPU state: AUTO on, with its two retention workaround words. */
+static struct apple_pmgr_ps *pmgr_ps_test_consumer(struct kunit *test, u32 word,
+						   struct pmgr_ps_test_bank **bank)
+{
+	static atomic_t instance = ATOMIC_INIT(0);
+	struct pmgr_ps_test_bank *b;
+	struct apple_pmgr_ps *ps;
+	struct device *dev;
+	char name[32];
+
+	b = kunit_kzalloc(test, sizeof(*b), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, b);
+	b->word[0] = word;
+	b->word[0x2504c / 4] = 0;
+	b->word[0x25070 / 4] = 1;
+	snprintf(name, sizeof(name), "apple-pmgr-consumer-%d", atomic_inc_return(&instance));
+	dev = kunit_device_register(test, name);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	ps = kunit_kzalloc(test, sizeof(*ps), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ps);
+	ps->dev = dev;
+	ps->genpd.name = "disp-cpu";
+	ps->firmware_owned = true;
+	ps->consumer_switched = true;
+	ps->nr_retention = 2;
+	ps->retention[0].offset = 0x2504c;
+	ps->retention[0].mask = 3;
+	ps->retention[0].value = 3;
+	ps->retention[1].offset = 0x25070;
+	ps->retention[1].mask = 1;
+	ps->retention[1].value = 0;
+	ps->regmap = devm_regmap_init(dev, NULL, b, &pmgr_ps_test_bank_regmap);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ps->regmap);
+	*bank = b;
+	return ps;
+}
+
+static void pmgr_ps_test_expect_log(struct kunit *test, struct pmgr_ps_test_bank *b,
+				    const u32 (*want)[2], unsigned int n)
+{
+	KUNIT_ASSERT_EQ(test, b->nr_log, n);
+	for (unsigned int i = 0; i < n; i++) {
+		KUNIT_EXPECT_EQ_MSG(test, b->log[i].reg, want[i][0], "write %u", i);
+		KUNIT_EXPECT_EQ_MSG(test, b->log[i].val, want[i][1], "write %u", i);
+	}
+	b->nr_log = 0;
+}
+
+/* The native J713 DCP CPU writes, as captured on macOS, in order. */
+static void pmgr_ps_consumer_native_test(struct kunit *test)
+{
+	static const u32 off[][2] = {
+		{ 0, 0x0f0000ff }, { 0x2504c, 3 }, { 0x25070, 0 }, { 0, 0x0f0003f0 },
+	};
+	static const u32 on[][2] = {
+		{ 0, 0x0f00000f }, { 0x2504c, 0 }, { 0x25070, 1 }, { 0, 0x1f00000f },
+	};
+	struct pmgr_ps_test_bank *b;
+	struct apple_pmgr_ps *ps = pmgr_ps_test_consumer(test, 0x1f0003ff, &b);
+
+	KUNIT_ASSERT_EQ(test, apple_pmgr_ps_consumer_state_off(ps), 0);
+	pmgr_ps_test_expect_log(test, b, off, ARRAY_SIZE(off));
+	KUNIT_EXPECT_EQ(test, b->word[0] & (APPLE_PMGR_PS_TARGET | APPLE_PMGR_PS_ACTUAL), 0U);
+	KUNIT_EXPECT_EQ(test, apple_pmgr_ps_consumer_state_off(ps), -EALREADY);
+
+	KUNIT_ASSERT_EQ(test, apple_pmgr_ps_consumer_state_on(ps), 0);
+	pmgr_ps_test_expect_log(test, b, on, ARRAY_SIZE(on));
+	KUNIT_EXPECT_EQ(test, b->word[0] & ~APPLE_PMGR_FLAGS, 0x1f0000ffU);
+	KUNIT_EXPECT_EQ(test, b->word[0x2504c / 4], 0U);
+	KUNIT_EXPECT_EQ(test, b->word[0x25070 / 4], 1U);
+	KUNIT_EXPECT_EQ(test, apple_pmgr_ps_consumer_state_on(ps), -EALREADY);
+}
+
+/* Retention bits outside the workaround's mask that change while off are kept. */
+static void pmgr_ps_consumer_retention_mask_test(struct kunit *test)
+{
+	struct pmgr_ps_test_bank *b;
+	struct apple_pmgr_ps *ps = pmgr_ps_test_consumer(test, 0x1f0003ff, &b);
+
+	KUNIT_ASSERT_EQ(test, apple_pmgr_ps_consumer_state_off(ps), 0);
+	b->word[0x2504c / 4] |= 0x100;
+	b->word[0x25070 / 4] |= 0x10;
+	KUNIT_ASSERT_EQ(test, apple_pmgr_ps_consumer_state_on(ps), 0);
+	KUNIT_EXPECT_EQ(test, b->word[0x2504c / 4], 0x100U);
+	KUNIT_EXPECT_EQ(test, b->word[0x25070 / 4], 0x11U);
+}
+
+/* FE and SYS: no AUTO and no retention; other bits are kept. */
+static void pmgr_ps_consumer_plain_test(struct kunit *test)
+{
+	static const u32 off[][2] = { { 0, 0x23f0 } };
+	static const u32 on[][2] = { { 0, 0x200f } };
+	struct pmgr_ps_test_bank *b;
+	struct apple_pmgr_ps *ps = pmgr_ps_test_consumer(test, 0x20ff, &b);
+
+	ps->nr_retention = 0;
+	KUNIT_ASSERT_EQ(test, apple_pmgr_ps_consumer_state_off(ps), 0);
+	pmgr_ps_test_expect_log(test, b, off, ARRAY_SIZE(off));
+	KUNIT_ASSERT_EQ(test, apple_pmgr_ps_consumer_state_on(ps), 0);
+	pmgr_ps_test_expect_log(test, b, on, ARRAY_SIZE(on));
+}
+
+static void pmgr_ps_consumer_refused_test(struct kunit *test)
+{
+	struct pmgr_ps_test_bank *b;
+	struct apple_pmgr_ps *ps;
+
+	/* Not fully on: left alone, and not failed. */
+	ps = pmgr_ps_test_consumer(test, 0x1f000044, &b);
+	KUNIT_EXPECT_EQ(test, apple_pmgr_ps_consumer_state_off(ps), -EBUSY);
+	KUNIT_EXPECT_EQ(test, b->nr_log, 0U);
+	KUNIT_EXPECT_FALSE(test, ps->consumer_failed);
+	KUNIT_EXPECT_EQ(test, apple_pmgr_ps_consumer_state_on(ps), -EALREADY);
+
+	/* The actual state does not follow: failed, and stays failed. */
+	ps = pmgr_ps_test_consumer(test, 0x1f0003ff, &b);
+	b->stuck = true;
+	KUNIT_EXPECT_EQ(test, apple_pmgr_ps_consumer_state_off(ps), -ETIMEDOUT);
+	KUNIT_EXPECT_TRUE(test, ps->consumer_failed);
+	KUNIT_EXPECT_EQ(test, apple_pmgr_ps_consumer_state_on(ps), -EIO);
+
+	/* A retention register that does not take the value: failed before power-off. */
+	ps = pmgr_ps_test_consumer(test, 0x1f0003ff, &b);
+	b->ignore_retention = true;
+	KUNIT_EXPECT_EQ(test, apple_pmgr_ps_consumer_state_off(ps), -EIO);
+	KUNIT_EXPECT_TRUE(test, ps->consumer_failed);
+	KUNIT_EXPECT_EQ(test, FIELD_GET(APPLE_PMGR_PS_TARGET, b->word[0]),
+			APPLE_PMGR_PS_ACTIVE);
+}
+
 static struct kunit_case pmgr_ps_test_cases[] = {
 	KUNIT_CASE(pmgr_ps_power_on_test),
 	KUNIT_CASE(pmgr_ps_power_off_undo_test),
 	KUNIT_CASE(pmgr_ps_power_on_fails_test),
+	KUNIT_CASE(pmgr_ps_consumer_native_test),
+	KUNIT_CASE(pmgr_ps_consumer_retention_mask_test),
+	KUNIT_CASE(pmgr_ps_consumer_plain_test),
+	KUNIT_CASE(pmgr_ps_consumer_refused_test),
 	{}
 };
 
diff --git a/drivers/pmdomain/apple/pmgr-pwrstate.c b/drivers/pmdomain/apple/pmgr-pwrstate.c
index fae56d91ca..ed8522b405 100644
--- a/drivers/pmdomain/apple/pmgr-pwrstate.c
+++ b/drivers/pmdomain/apple/pmgr-pwrstate.c
@@ -10,6 +10,7 @@
 #include <linux/err.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
+#include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
 #include <linux/pm_runtime.h>
@@ -17,6 +18,7 @@
 #include <linux/mfd/syscon.h>
 #include <linux/reset-controller.h>
 #include <linux/module.h>
+#include <linux/soc/apple/pmgr-pwrstate.h>
 
 #define APPLE_PMGR_RESET        BIT(31)
 #define APPLE_PMGR_AUTO_ENABLE  BIT(28)
@@ -37,6 +39,14 @@
 #define APPLE_PMGR_PS_PWRGATE   0x0
 
 #define APPLE_PMGR_PS_SET_TIMEOUT 100
+#define APPLE_PMGR_PS_CONSUMER_TIMEOUT 1000
+#define APPLE_PMGR_PS_MAX_RETENTION 4
+#define APPLE_PMGR_PS_MAX_CHAIN 4
+
+#define APPLE_PMGR_PS_LEVELS	(APPLE_PMGR_PS_TARGET | APPLE_PMGR_PS_ACTUAL)
+/* Target and actual state both on (or both power gated). */
+#define APPLE_PMGR_PS_ALL_ON	(FIELD_PREP(APPLE_PMGR_PS_TARGET, APPLE_PMGR_PS_ACTIVE) | \
+				 FIELD_PREP(APPLE_PMGR_PS_ACTUAL, APPLE_PMGR_PS_ACTIVE))
 #define APPLE_PMGR_RESET_TIME 1
 
 struct apple_pmgr_ps {
@@ -55,6 +65,20 @@ struct apple_pmgr_ps {
 	bool sleep_retained;
 	/* Never enable automatic power management (apple,no-auto-pm). */
 	bool no_auto_pm;
+	/*
+	 * apple,consumer-switched: firmware-owned, but powered off and on by its
+	 * consumer (apple_pmgr_ps_consumer_off()). The state word before
+	 * power-off, and the retention workaround registers with their values
+	 * before power-off. A failed transition leaves it failed until reboot.
+	 */
+	bool consumer_switched;
+	bool consumer_off;
+	bool consumer_failed;
+	u32 consumer_saved;
+	unsigned int nr_retention;
+	struct {
+		u32 offset, mask, value, saved;
+	} retention[APPLE_PMGR_PS_MAX_RETENTION];
 };
 
 #define genpd_to_apple_pmgr_ps(_genpd) container_of(_genpd, struct apple_pmgr_ps, genpd)
@@ -405,6 +429,28 @@ static int apple_pmgr_ps_probe(struct platform_device *pdev)
 	 * it, keep it on and never change its target or automatic gating.
 	 */
 	ps->firmware_owned = of_property_read_bool(node, "apple,firmware-owned");
+	ps->consumer_switched = of_property_read_bool(node, "apple,consumer-switched");
+	if (ps->consumer_switched) {
+		int n = of_property_count_u32_elems(node, "apple,retention-workaround");
+
+		if (!ps->firmware_owned ||
+		    (n > 0 && (n % 3 || n / 3 > APPLE_PMGR_PS_MAX_RETENTION)))
+			return dev_err_probe(dev, -EINVAL, "bad consumer-switched policy\n");
+		for (int i = 0; n > 0 && i < n / 3; i++) {
+			of_property_read_u32_index(node, "apple,retention-workaround", 3 * i,
+						   &ps->retention[i].offset);
+			of_property_read_u32_index(node, "apple,retention-workaround", 3 * i + 1,
+						   &ps->retention[i].mask);
+			of_property_read_u32_index(node, "apple,retention-workaround", 3 * i + 2,
+						   &ps->retention[i].value);
+			if (ps->retention[i].value & ~ps->retention[i].mask)
+				return dev_err_probe(dev, -EINVAL, "bad retention workaround\n");
+		}
+		ps->nr_retention = n > 0 ? n / 3 : 0;
+	} else if (of_property_present(node, "apple,retention-workaround")) {
+		return dev_err_probe(dev, -EINVAL,
+				     "retention workaround needs a consumer switch\n");
+	}
 	ps->sleep_retained = of_property_read_bool(node, "apple,sleep-retained");
 
 	ret = of_property_read_u32(node, "apple,min-state", &ps->min_state);
@@ -525,6 +571,245 @@ err_remove:
 	return ret;
 }
 
+static struct platform_driver apple_pmgr_ps_driver;
+
+/* Wait for the masked state word to read @want; @cur gets the last value. */
+static int apple_pmgr_ps_wait(struct apple_pmgr_ps *ps, u32 mask, u32 want, u32 *cur)
+{
+	return regmap_read_poll_timeout_atomic(ps->regmap, ps->offset, *cur,
+					       (*cur & mask) == want, 1,
+					       APPLE_PMGR_PS_CONSUMER_TIMEOUT);
+}
+
+/* Write a retention register and read it back. */
+static int apple_pmgr_ps_retention_set(struct apple_pmgr_ps *ps, unsigned int i, u32 value)
+{
+	u32 now;
+	int ret;
+
+	ret = regmap_write(ps->regmap, ps->retention[i].offset, value);
+	if (!ret)
+		ret = regmap_read(ps->regmap, ps->retention[i].offset, &now);
+	return ret ?: now == value ? 0 : -EIO;
+}
+
+/* Fully on (target and actual), and not in reset, busy or disabled. */
+static bool apple_pmgr_ps_consumer_ready(u32 reg)
+{
+	return (reg & APPLE_PMGR_PS_LEVELS) == APPLE_PMGR_PS_ALL_ON &&
+	       !(reg & (APPLE_PMGR_RESET | APPLE_PMGR_PS_RESET | APPLE_PMGR_BUSY |
+			APPLE_PMGR_DEV_DISABLE));
+}
+
+/*
+ * The native power-off of a consumer-switched state: from fully on, disable
+ * automatic power management while staying on, set the retention workaround,
+ * then power off (clearing the history bits) and wait for it.
+ */
+static int apple_pmgr_ps_consumer_state_off(struct apple_pmgr_ps *ps)
+{
+	u32 reg, cur;
+	int ret;
+
+	if (ps->consumer_failed)
+		return -EIO;
+	if (ps->consumer_off)
+		return -EALREADY;
+	ret = regmap_read(ps->regmap, ps->offset, &reg);
+	if (ret)
+		goto fail;
+	if (!apple_pmgr_ps_consumer_ready(reg))
+		return -EBUSY;	/* Not touched: not a failure of this state. */
+	for (unsigned int i = 0; i < ps->nr_retention; i++) {
+		ret = regmap_read(ps->regmap, ps->retention[i].offset, &ps->retention[i].saved);
+		if (ret)
+			goto fail;
+	}
+	ps->consumer_saved = reg;
+	reg &= ~(APPLE_PMGR_AUTO_ENABLE | APPLE_PMGR_FLAGS);
+	if (ps->consumer_saved & APPLE_PMGR_AUTO_ENABLE) {
+		ret = regmap_write(ps->regmap, ps->offset, reg);
+		if (!ret)
+			ret = apple_pmgr_ps_wait(ps, APPLE_PMGR_AUTO_ENABLE | APPLE_PMGR_PS_LEVELS,
+						 APPLE_PMGR_PS_ALL_ON, &cur);
+		if (ret)
+			goto fail;
+	}
+	for (unsigned int i = 0; i < ps->nr_retention; i++) {
+		ret = apple_pmgr_ps_retention_set(ps, i, (ps->retention[i].saved &
+							   ~ps->retention[i].mask) |
+							  ps->retention[i].value);
+		if (ret)
+			goto fail;
+	}
+	ps->consumer_off = true;
+	reg = (reg & ~APPLE_PMGR_PS_TARGET) | APPLE_PMGR_FLAGS |
+	      FIELD_PREP(APPLE_PMGR_PS_TARGET, APPLE_PMGR_PS_PWRGATE);
+	ret = regmap_write(ps->regmap, ps->offset, reg);
+	if (!ret)
+		ret = apple_pmgr_ps_wait(ps, APPLE_PMGR_PS_LEVELS | APPLE_PMGR_AUTO_ENABLE, 0,
+					 &cur);
+	if (ret)
+		goto fail;
+	dev_dbg(ps->dev, "PS %s: consumer power-off: %#x -> %#x\n", ps->genpd.name,
+		ps->consumer_saved, cur);
+	return 0;
+fail:
+	ps->consumer_failed = true;
+	dev_err(ps->dev, "PS %s: consumer power-off failed: %d\n", ps->genpd.name, ret);
+	return ret;
+}
+
+/*
+ * The native power-on: power on with automatic power management disabled,
+ * give the retention registers' workaround bits back the values they had
+ * (only those: power-off changed no other), then automatic power management
+ * as it was.
+ */
+static int apple_pmgr_ps_consumer_state_on(struct apple_pmgr_ps *ps)
+{
+	u32 reg, cur, now;
+	int ret;
+
+	if (ps->consumer_failed)
+		return -EIO;
+	if (!ps->consumer_off)
+		return -EALREADY;
+	reg = (ps->consumer_saved & ~(APPLE_PMGR_AUTO_ENABLE | APPLE_PMGR_FLAGS |
+				      APPLE_PMGR_BUSY | APPLE_PMGR_PS_ACTUAL)) |
+	      FIELD_PREP(APPLE_PMGR_PS_TARGET, APPLE_PMGR_PS_ACTIVE);
+	ret = regmap_write(ps->regmap, ps->offset, reg);
+	if (!ret)
+		ret = apple_pmgr_ps_wait(ps, APPLE_PMGR_PS_LEVELS, APPLE_PMGR_PS_ALL_ON, &cur);
+	if (ret)
+		goto fail;
+	for (unsigned int i = 0; i < ps->nr_retention; i++) {
+		u32 mask = ps->retention[i].mask;
+
+		ret = regmap_read(ps->regmap, ps->retention[i].offset, &now);
+		if (!ret)
+			ret = apple_pmgr_ps_retention_set(ps, i, (now & ~mask) |
+							  (ps->retention[i].saved & mask));
+		if (ret)
+			goto fail;
+	}
+	if (ps->consumer_saved & APPLE_PMGR_AUTO_ENABLE) {
+		ret = regmap_write(ps->regmap, ps->offset, reg | APPLE_PMGR_AUTO_ENABLE);
+		if (!ret)
+			ret = apple_pmgr_ps_wait(ps, APPLE_PMGR_AUTO_ENABLE, APPLE_PMGR_AUTO_ENABLE,
+						 &cur);
+		if (ret)
+			goto fail;
+	}
+	ps->consumer_off = false;
+	dev_dbg(ps->dev, "PS %s: consumer power-on: %#x\n", ps->genpd.name, cur);
+	return 0;
+fail:
+	ps->consumer_failed = true;
+	dev_err(ps->dev, "PS %s: consumer power-on failed: %d\n", ps->genpd.name, ret);
+	return ret;
+}
+
+/* The consumer-switched states from @consumer's domain up, child first. */
+static int apple_pmgr_ps_consumer_chain(struct device *consumer,
+					struct apple_pmgr_ps **chain)
+{
+	struct device_node *np = of_parse_phandle(consumer->of_node, "power-domains", 0);
+	int n = 0;
+
+	while (np) {
+		struct platform_device *pdev = of_find_device_by_node(np);
+		struct apple_pmgr_ps *ps = NULL;
+		struct device_node *parent;
+
+		if (pdev && pdev->dev.driver == &apple_pmgr_ps_driver.driver)
+			ps = platform_get_drvdata(pdev);
+		if (pdev)
+			put_device(&pdev->dev);
+		if (!ps || !ps->consumer_switched || n == APPLE_PMGR_PS_MAX_CHAIN) {
+			of_node_put(np);
+			break;
+		}
+		chain[n++] = ps;
+		parent = of_parse_phandle(np, "power-domains", 0);
+		of_node_put(np);
+		np = parent;
+	}
+	return n ?: -ENODEV;
+}
+
+static int apple_pmgr_ps_consumer_switch(struct apple_pmgr_ps *ps, bool on)
+{
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&ps->genpd.slock, flags);
+	ret = on ? apple_pmgr_ps_consumer_state_on(ps) : apple_pmgr_ps_consumer_state_off(ps);
+	spin_unlock_irqrestore(&ps->genpd.slock, flags);
+	return ret;
+}
+
+/*
+ * Whether apple_pmgr_ps_consumer_off() can run for @consumer, changing
+ * nothing: the whole chain consumer-switched, not failed and not off. Not
+ * whether each state is fully on: under automatic power management the
+ * J713 DCP CPU state reads level 0 while its CPU idles, and is fully on
+ * again once the CPU has been stopped, which the power-off then requires.
+ */
+int apple_pmgr_ps_consumer_check(struct device *consumer)
+{
+	struct apple_pmgr_ps *chain[APPLE_PMGR_PS_MAX_CHAIN];
+	int n = apple_pmgr_ps_consumer_chain(consumer, chain), ret = 0;
+
+	if (n < 0)
+		return n;
+	for (int i = 0; i < n && !ret; i++) {
+		struct apple_pmgr_ps *ps = chain[i];
+		unsigned long flags;
+
+		spin_lock_irqsave(&ps->genpd.slock, flags);
+		if (ps->consumer_failed)
+			ret = -EIO;
+		else if (ps->consumer_off)
+			ret = -EALREADY;
+		spin_unlock_irqrestore(&ps->genpd.slock, flags);
+	}
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_pmgr_ps_consumer_check);
+
+int apple_pmgr_ps_consumer_off(struct device *consumer)
+{
+	struct apple_pmgr_ps *chain[APPLE_PMGR_PS_MAX_CHAIN];
+	int n = apple_pmgr_ps_consumer_chain(consumer, chain), ret;
+
+	if (n < 0)
+		return n;
+	for (int i = 0; i < n; i++) {
+		ret = apple_pmgr_ps_consumer_switch(chain[i], false);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_pmgr_ps_consumer_off);
+
+int apple_pmgr_ps_consumer_on(struct device *consumer)
+{
+	struct apple_pmgr_ps *chain[APPLE_PMGR_PS_MAX_CHAIN];
+	int n = apple_pmgr_ps_consumer_chain(consumer, chain), ret;
+
+	if (n < 0)
+		return n;
+	for (int i = n - 1; i >= 0; i--) {
+		ret = apple_pmgr_ps_consumer_switch(chain[i], true);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_pmgr_ps_consumer_on);
+
