+              reg-names:
+                minItems: 3
+                items:
+                  - const: codec
+                  - const: mailbox
+                  - const: coproc
+                  - enum: [pmgr, power-control]
+                  - enum: [fabric, pio]
+
+              clocks:
+                maxItems: 1
+
+              interrupts:
+                items:
+                  - description: Mailbox, raised when the firmware posts to a host ring
+                  - description: Codec interrupt handled by the firmware
+                  - description: Codec interrupt handled by the firmware
+                  - description: Codec interrupt handled by the firmware
+                  - description: Codec interrupt handled by the firmware
+
+              power-domains:
+                minItems: 1
+                maxItems: 6
+
+              power-domain-names:
+                minItems: 5
+                items:
+                  - const: dma
+                  - const: pipe4
+                  - const: pipe5
+                  - const: me0
+                  - const: me1
+                  - const: perf
+                    description: |
+                      A performance floor the encoder needs to run at full speed, held
+                      while the encoder is powered (for example the SoC rail floor of a
+                      PMC).
+
+              iommus:
+                minItems: 2
+                maxItems: 4
+
+              memory-region:
+                items:
+                  - description: Preloaded firmware text
+                  - description: Preloaded firmware data
+
+            required:
+              - compatible
+              - reg
+              - interrupts
+              - power-domains
+              - iommus
+
+            allOf:
+              - if:
+                  properties:
+                    compatible:
+                      contains:
+                        enum:
+                          - apple,t6020-ave
+                          - apple,t6021-ave
+                          - apple,t6022-ave
+                          - apple,t6030-ave
+                          - apple,t6031-ave
+                          - apple,t8122-ave
+                then:
+                  properties:
+                    reg:
+                      minItems: 5
+                else:
+                  properties:
+                    power-domains:
+                      minItems: 5
+                  required:
+                    - reg-names
+                    - power-domain-names
+              - if:
+                  properties:
+                    compatible:
+                      contains:
+                        enum:
+                          - apple,t6041-ave
+                          - apple,t8112-ave
+                          - apple,t8140-ave
+                then:
+                  properties:
+                    reg:
+                      maxItems: 3
+                    reg-names:
+                      maxItems: 3
+
+            additionalProperties: false
+
+unevaluatedProperties: false
