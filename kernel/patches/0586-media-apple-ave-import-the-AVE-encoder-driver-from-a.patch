+
+/* Controls */
+
+static int ave_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ave_ctx *ctx = container_of(ctrl->handler, struct ave_ctx, hdl);
+
+	switch (ctrl->id) {
+	case V4L2_CID_MPEG_VIDEO_BITRATE_MODE:
+		ctx->bitrate_mode = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_BITRATE:
+		WRITE_ONCE(ctx->bitrate, ctrl->val);
+		break;
+	case V4L2_CID_MPEG_VIDEO_BITRATE_PEAK:
+		ctx->bitrate_peak = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_GOP_SIZE:
+		ctx->gop_size = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME:
+		WRITE_ONCE(ctx->force_key_frame, true);
+		break;
+	case V4L2_CID_MPEG_VIDEO_B_FRAMES:
+		ctx->b_frames = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_H264_PROFILE:
+		ctx->h264_profile = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_H264_LEVEL:
+		ctx->h264_level = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_H264_MIN_QP:
+		ctx->h264_min_qp = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_H264_MAX_QP:
+		ctx->h264_max_qp = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_HEVC_LEVEL:
+		ctx->hevc_level = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_HEVC_MIN_QP:
+		ctx->hevc_min_qp = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_HEVC_MAX_QP:
+		ctx->hevc_max_qp = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_HEVC_PROFILE:
+		ctx->hevc_profile = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_HEADER_MODE:
+	case V4L2_CID_MIN_BUFFERS_FOR_OUTPUT:
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops ave_ctrl_ops = {
+	.s_ctrl = ave_s_ctrl,
+};
+
+static int ave_init_ctrls(struct ave_ctx *ctx)
+{
+	struct v4l2_ctrl_handler *hdl = &ctx->hdl;
+	const struct v4l2_ctrl_ops *ops = &ave_ctrl_ops;
+	struct v4l2_ctrl *c;
+
+	v4l2_ctrl_handler_init(hdl, 17);
+
+	/* Constant quality needs a quality-to-QP mapping that is not known yet. */
+	v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_MPEG_VIDEO_BITRATE_MODE,
+			       V4L2_MPEG_VIDEO_BITRATE_MODE_CBR,
+			       BIT(V4L2_MPEG_VIDEO_BITRATE_MODE_CQ),
+			       V4L2_MPEG_VIDEO_BITRATE_MODE_VBR);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_BITRATE, 100000, 100000000, 1,
+			  4000000);
+	/*
+	 * In VBR mode the peak caps the data rate over any one second;
+	 * 0 means twice the average, as macOS sets it.
+	 */
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_BITRATE_PEAK, 0, 200000000, 1, 0);
+	/* 0 means no limit; the firmware then uses 120 frames. */
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_GOP_SIZE, 0, 65535, 1, 30);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME, 0, 0, 0, 0);
+	/*
+	 * The firmware either uses up to three B-frames (reordering them
+	 * itself) or none. Baseline and intra-only H.264 never have any.
+	 */
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_B_FRAMES, 0, 3, 3, 3);
+	v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_MPEG_VIDEO_HEADER_MODE,
+			       V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME,
+			       BIT(V4L2_MPEG_VIDEO_HEADER_MODE_SEPARATE),
+			       V4L2_MPEG_VIDEO_HEADER_MODE_JOINED_WITH_1ST_FRAME);
+
+	v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_MPEG_VIDEO_H264_PROFILE,
+			       V4L2_MPEG_VIDEO_H264_PROFILE_HIGH,
+			       ~(BIT(V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE) |
+				 BIT(V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE) |
+				 BIT(V4L2_MPEG_VIDEO_H264_PROFILE_MAIN) |
+				 BIT(V4L2_MPEG_VIDEO_H264_PROFILE_HIGH)),
+			       V4L2_MPEG_VIDEO_H264_PROFILE_MAIN);
+	/* A minimum: the driver raises it to what size, rate and bit rate need. */
+	v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_MPEG_VIDEO_H264_LEVEL,
+			       V4L2_MPEG_VIDEO_H264_LEVEL_5_2, 0,
+			       V4L2_MPEG_VIDEO_H264_LEVEL_1_0);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_H264_MIN_QP, 0, 51, 1, 0);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_H264_MAX_QP, 0, 51, 1, 51);
+
+	/* Main 10 takes P010 input; the profile is checked against it at STREAMON. */
+	v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_MPEG_VIDEO_HEVC_PROFILE,
+			       V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_10,
+			       ~(BIT(V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN) |
+				 BIT(V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_10)),
+			       V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN);
+	v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_MPEG_VIDEO_HEVC_LEVEL,
+			       V4L2_MPEG_VIDEO_HEVC_LEVEL_5_1, 0,
+			       V4L2_MPEG_VIDEO_HEVC_LEVEL_1);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_HEVC_MIN_QP, 0, 51, 1, 0);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_HEVC_MAX_QP, 0, 51, 1, 51);
+
+	/* The firmware holds up to five frames; one more keeps it fed. */
+	c = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MIN_BUFFERS_FOR_OUTPUT, 1, 32, 1,
+			      AVE_MAX_SLOTS + 1);
+	if (c)
+		c->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	if (hdl->error) {
+		int ret = hdl->error;
+
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+	ctx->fh.ctrl_handler = hdl;
+	return v4l2_ctrl_handler_setup(hdl);
+}
+
+/* Queues */
+
+static int ave_queue_setup(struct vb2_queue *vq, unsigned int *nbufs, unsigned int *nplanes,
+			   unsigned int sizes[], struct device *alloc_devs[])
+{
+	struct ave_ctx *ctx = vb2_get_drv_priv(vq);
+	const struct v4l2_pix_format_mplane *f =
+		V4L2_TYPE_IS_OUTPUT(vq->type) ? &ctx->src_fmt : &ctx->dst_fmt;
+	unsigned int have = vb2_get_num_buffers(vq);
+	unsigned long slot = roundup_pow_of_two(PAGE_ALIGN(f->plane_fmt[0].sizeimage));
+	unsigned int max = (V4L2_TYPE_IS_OUTPUT(vq->type) ? AVE_OUTPUT_BUDGET :
+							    AVE_CAPTURE_BUDGET) / slot;
+
+	max = clamp(max, V4L2_TYPE_IS_OUTPUT(vq->type) ? AVE_MAX_SLOTS + 1U : 2U,
+		    AVE_MAX_QUEUE_BUFS);
+
+	/* Frames stay with the firmware until encoded; keep one spare. */
+	if (V4L2_TYPE_IS_OUTPUT(vq->type) && have + *nbufs < AVE_MAX_SLOTS + 1)
+		*nbufs = AVE_MAX_SLOTS + 1 - have;
+	/* A full set of both queues must fit the budget for the DART window. */
+	if (have >= max) {
+		dev_dbg(ctx->ave->dev, "%s queue already has its %u buffers\n",
+			V4L2_TYPE_IS_OUTPUT(vq->type) ? "OUTPUT" : "CAPTURE", max);
+		return -ENOMEM;
+	}
+	if (*nbufs > max - have)
+		dev_dbg(ctx->ave->dev, "%s queue: %u buffers asked, %u given\n",
+			V4L2_TYPE_IS_OUTPUT(vq->type) ? "OUTPUT" : "CAPTURE", *nbufs, max - have);
+	*nbufs = min(*nbufs, max - have);
+	if (*nplanes)
+		return (*nplanes != 1 || sizes[0] < f->plane_fmt[0].sizeimage) ? -EINVAL : 0;
+	*nplanes = 1;
+	sizes[0] = f->plane_fmt[0].sizeimage;
+	return 0;
+}
+
+static int ave_buf_prepare(struct vb2_buffer *vb)
+{
+	struct ave_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	const struct v4l2_pix_format_mplane *f =
+		V4L2_TYPE_IS_OUTPUT(vb->type) ? &ctx->src_fmt : &ctx->dst_fmt;
+
+	if (vb2_plane_size(vb, 0) < f->plane_fmt[0].sizeimage)
+		return -EINVAL;
+	/* Keep what the client filled in, so its layout can be checked. */
+	if (V4L2_TYPE_IS_OUTPUT(vb->type) && !vb2_get_plane_payload(vb, 0))
+		vb2_set_plane_payload(vb, 0, f->plane_fmt[0].sizeimage);
+	return 0;
+}
+
+static void ave_buf_queue(struct vb2_buffer *vb)
+{
+	struct ave_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	unsigned long flags;
+
+	spin_lock_irqsave(&ctx->queue_lock, flags);
+	if (ctx->failed)
+		v4l2_m2m_buf_done(to_vb2_v4l2_buffer(vb), VB2_BUF_STATE_ERROR);
+	else
+		v4l2_m2m_buf_queue(ctx->fh.m2m_ctx, to_vb2_v4l2_buffer(vb));
+	spin_unlock_irqrestore(&ctx->queue_lock, flags);
+}
+
+static void ave_return_bufs(struct ave_ctx *ctx, struct vb2_queue *q,
+			    enum vb2_buffer_state state)
+{
+	struct vb2_v4l2_buffer *vbuf;
+
+	for (;;) {
+		vbuf = V4L2_TYPE_IS_OUTPUT(q->type) ?
+			v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx) :
+			v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+		if (!vbuf)
+			break;
+		v4l2_m2m_buf_done(vbuf, state);
+	}
+}
+
+/* Sessions */
+
+static int ave_session_index(struct ave_dev *ave, struct ave_ctx *ctx)
+{
+	for (unsigned int i = 0; i < AVE_MAX_SESSIONS; i++)
+		if (ave->sessions[i] == ctx)
+			return i;
+	return -1;
+}
+
+static unsigned int ave_session_count(struct ave_dev *ave)
+{
+	unsigned int n = 0;
+
+	for (unsigned int i = 0; i < AVE_MAX_SESSIONS; i++)
+		n += !!ave->sessions[i];
+	return n;
+}
+
+/*
+ * Drain (with @flush), stop and close the session in the firmware. The
+ * last session to go halts the firmware. Caller holds hw_lock.
+ */
+static void ave_session_close(struct ave_ctx *ctx, bool flush)
+{
+	struct ave_dev *ave = ctx->ave;
+	struct ave_session *sess = ctx->sess;
+	int idx = ave_session_index(ave, ctx);
+
+	lockdep_assert_held(&ave->hw_lock);
+	if (!sess || idx < 0)
+		return;
+	if (sess->fw_open && ave->fw_state == AVE_FW_RUNNING) {
+		/* Complete is a barrier: answered after every frame before it. */
+		if (flush && sess->frames && !ave_cmd_complete(ctx, AVE_DRAIN_COMPLETES))
+			ave_ipc_settle(ave, AVE_FRAME_WAIT_MS);
+		if (ave->fw_state == AVE_FW_RUNNING)
+			ave_cmd_close(ctx);
+	}
+	sess->fw_open = false;
+	ave->sessions[idx] = NULL;
+	if (!ave_session_count(ave))
+		ave_fw_halt(ave);
+}
+
+/*
+ * Open and Start the session in the firmware, booting the firmware first
+ * if no other session runs. Returns -EAGAIN when a halted coprocessor has
+ * not lost power yet. Caller holds hw_lock.
+ */
+static int ave_session_attach(struct ave_ctx *ctx)
+{
+	struct ave_dev *ave = ctx->ave;
+	struct ave_session *sess = ctx->sess;
+	int idx = -1, ret;
+
+	lockdep_assert_held(&ave->hw_lock);
+	for (unsigned int i = 0; i < AVE_MAX_SESSIONS && idx < 0; i++)
+		if (!ave->sessions[i])
+			idx = i;
+	if (idx < 0) {
+		dev_err(ave->dev, "already encoding %u streams\n", AVE_MAX_SESSIONS);
+		return -EBUSY;
+	}
+	if (!ave_session_count(ave)) {
+		ret = ave_fw_ensure_running(ave);
+		if (ret)
+			return ret;
+	} else if (ave->fw_state != AVE_FW_RUNNING) {
+		dev_err(ave->dev, "firmware state %d, cannot add a session\n", ave->fw_state);
+		return -EIO;
+	}
+
+	sess->index = idx;
+	sess->frames = 0;
+	sess->nudged = false;
+	ave->sessions[idx] = ctx;
+	ret = ave_cmd_open(ctx);
+	if (!ret)
+		ret = ave_cmd_start(ctx);
+	if (ret)
+		ave_session_close(ctx, false);
+	return ret;
+}
+
+/*
+ * Attach with the device runtime active and one PM reference held by the
+ * caller. A halted coprocessor restarts only from reset, and its power can
+ * take a moment to go (the DARTs suspend a little later), so drop the
+ * reference and cycle the power a few times before giving up. On return
+ * the reference is still held, unless *pm_lost says otherwise.
+ */
+static int ave_session_attach_cycled(struct ave_ctx *ctx, bool *pm_lost)
+{
+	struct ave_dev *ave = ctx->ave;
+	int ret = -EAGAIN;
+
+	*pm_lost = false;
+	for (unsigned int i = 0; i < AVE_RESTART_TRIES && ret == -EAGAIN; i++) {
+		if (i) {
+			pm_runtime_put_sync_suspend(ave->dev);
+			msleep(AVE_RESTART_WAIT_MS);
+			ret = pm_runtime_resume_and_get(ave->dev);
+			if (ret) {
+				*pm_lost = true;
+				return ret;
+			}
+		}
+		mutex_lock(&ave->hw_lock);
+		ret = ave_session_attach(ctx);
+		mutex_unlock(&ave->hw_lock);
+	}
+	if (ret == -EAGAIN)
+		dev_err(ave->dev, "coprocessor did not power down; cannot restart it\n");
+	return ret;
+}
+
+/* Return frames the firmware never answered; then drop the session. */
+static void ave_session_free(struct ave_ctx *ctx)
+{
+	struct ave_dev *ave = ctx->ave;
+	struct ave_session *sess = ctx->sess;
+
+	if (!sess)
+		return;
+	for (unsigned int i = 0; i < sess->p.slots; i++) {
+		struct ave_slot *s = &sess->slot[i];
+
+		if (s->src)
+			v4l2_m2m_buf_done(s->src, VB2_BUF_STATE_ERROR);
+		s->src = NULL;
+	}
+	atomic_set(&ctx->ready, 0);
+	ave_sess_destroy(ctx);
+	pm_runtime_mark_last_busy(ave->dev);
+	pm_runtime_put_autosuspend(ave->dev);
+}
+
+/* Boot the firmware if needed, then Open and Start a session. */
+static int ave_session_begin(struct ave_ctx *ctx)
+{
+	struct ave_dev *ave = ctx->ave;
+	struct ave_session *sess;
+	bool pm_lost;
+	int ret;
+
+	if (ctx->sess)
+		return 0;
+	ret = ave_fw_check_build(ave);
+	if (ret)
+		return ret;
+	if (READ_ONCE(ave->sessions[0]) && READ_ONCE(ave->sessions[1]))
+		return -EBUSY;
+	/* A halted firmware restarts only from reset: let the power go first. */
+	if (READ_ONCE(ave->fw_state) == AVE_FW_HALTED ||
+	    READ_ONCE(ave->fw_state) == AVE_FW_BROKEN ||
+	    READ_ONCE(ave->fw_state) == AVE_FW_RECOVERING)
+		pm_runtime_suspend(ave->dev);
+	sess = ave_sess_create(ctx);
+	if (IS_ERR(sess)) {
+		dev_err(ave->dev, "cannot set up a session: %ld\n", PTR_ERR(sess));
+		return PTR_ERR(sess);
+	}
+
+	ctx->sess = sess;
+	ret = pm_runtime_resume_and_get(ave->dev);
+	if (ret) {
+		ave_sess_destroy(ctx);
+		return ret;
+	}
+	ret = ave_session_attach_cycled(ctx, &pm_lost);
+	if (ret) {
+		dev_err(ave->dev, "cannot start an encoding session: %d\n", ret);
+		if (pm_lost)
+			ave_sess_destroy(ctx);
+		else
+			ave_session_free(ctx);
+	}
+	return ret;
+}
+
+/*
+ * After system sleep: the session was closed when the firmware went down.
+ * Open and Start it again with the same parameters; its next frame is an
+ * IDR with fresh parameter sets, so the stream stays decodable.
+ */
+static int ave_session_reopen(struct ave_ctx *ctx)
+{
+	bool pm_lost;
+	int ret;
+
+	ret = ave_session_attach_cycled(ctx, &pm_lost);
+	if (ret) {
+		if (pm_lost) {
+			/* The session's PM reference is gone; do not drop it again. */
+			pm_runtime_get_noresume(ctx->ave->dev);
+		}
+		return ret;
+	}
+	ctx->sess->resume = false;
+	dev_dbg(ctx->ave->dev, "session reopened after system sleep\n");
+	return 0;
+}
+
+/*
+ * System sleep: drain every open session, close it and halt the firmware,
+ * as at the end of a stream. Sessions reopen on their next frame.
+ * Caller holds hw_lock.
+ */
+void ave_v4l2_suspend(struct ave_dev *ave)
+{
+	lockdep_assert_held(&ave->hw_lock);
+	for (unsigned int i = 0; i < AVE_MAX_SESSIONS; i++) {
+		struct ave_ctx *ctx = ave->sessions[i];
+
+		if (!ctx)
+			continue;
+		cancel_delayed_work(&ctx->poll_work);
+		ave_session_close(ctx, true);
+		ctx->sess->resume = true;
+	}
+}
+
+static void ave_session_end(struct ave_ctx *ctx)
+{
+	struct ave_dev *ave = ctx->ave;
+
+	cancel_delayed_work_sync(&ctx->poll_work);
+	mutex_lock(&ave->hw_lock);
+	ave_session_close(ctx, true);
+	mutex_unlock(&ave->hw_lock);
+	ave_session_free(ctx);
+}
+
+static void ave_reset_drain(struct ave_ctx *ctx)
+{
+	ctx->draining = false;
+	WRITE_ONCE(ctx->flush_pending, false);
+	ctx->stopped = false;
+	ctx->drain_src = NULL;
+}
+
+static int ave_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct ave_ctx *ctx = vb2_get_drv_priv(q);
+	struct vb2_queue *other = V4L2_TYPE_IS_OUTPUT(q->type) ?
+		v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx) :
+		v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx);
+	int ret = 0;
+
+	if (V4L2_TYPE_IS_OUTPUT(q->type))
+		ctx->src_sequence = 0;
+	else
+		ctx->dst_sequence = 0;
+	ave_reset_drain(ctx);
+
+	/* The session starts once both queues stream; errors show up here. */
+	if (vb2_is_streaming(other))
+		ret = ave_session_begin(ctx);
+	if (ret)
+		ave_return_bufs(ctx, q, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void ave_stop_streaming(struct vb2_queue *q)
+{
+	struct ave_ctx *ctx = vb2_get_drv_priv(q);
+	struct vb2_queue *other = V4L2_TYPE_IS_OUTPUT(q->type) ?
+		v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx) :
+		v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx);
+
+	ave_session_end(ctx);
+	ave_reset_drain(ctx);
+	ave_return_bufs(ctx, q, VB2_BUF_STATE_ERROR);
+	/* vb2 hands queued buffers to buf_queue before the next STREAMON callback. */
+	if (!vb2_is_streaming(other))
+		WRITE_ONCE(ctx->failed, false);
+}
+
+static const struct vb2_ops ave_qops = {
+	.queue_setup = ave_queue_setup,
+	.buf_prepare = ave_buf_prepare,
+	.buf_queue = ave_buf_queue,
+	.start_streaming = ave_start_streaming,
+	.stop_streaming = ave_stop_streaming,
+};
+
+static int ave_queue_init(void *priv, struct vb2_queue *src, struct vb2_queue *dst)
+{
+	struct ave_ctx *ctx = priv;
+	int ret;
+
+	src->type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+	src->io_modes = VB2_MMAP | VB2_DMABUF;
+	src->drv_priv = ctx;
+	src->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	src->ops = &ave_qops;
+	src->mem_ops = &ave_vb2_memops;
+	src->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src->lock = &ctx->ave->vdev_lock;
+	src->dev = ctx->ave->dev;
+	ret = vb2_queue_init(src);
+	if (ret)
+		return ret;
+
+	dst->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	dst->io_modes = VB2_MMAP | VB2_DMABUF;
+	dst->drv_priv = ctx;
+	dst->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	dst->ops = &ave_qops;
+	dst->mem_ops = &vb2_dma_contig_memops;
+	dst->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst->lock = &ctx->ave->vdev_lock;
+	dst->dev = ctx->ave->dev;
+	return vb2_queue_init(dst);
+}
+
+/*
+ * Jobs. A job delivers finished frames to CAPTURE buffers and sends at most
+ * one new frame. Up to five frames are inside the firmware at once; their
+ * answers are collected by the job and, between jobs, by the poll work, which
+ * the mailbox interrupt queues. While frames are outstanding the poll work
+ * also runs every AVE_WATCH_MS to catch a stuck or starved session.
+ */
+
+#define AVE_WATCH_MS		25
+
+static int ave_job_ready(void *priv)
+{
+	struct ave_ctx *ctx = priv;
+	struct v4l2_m2m_ctx *m2m = ctx->fh.m2m_ctx;
+
+	if (READ_ONCE(ctx->failed))
+		return 0;
+	if (atomic_read(&ctx->ready) || READ_ONCE(ctx->flush_pending))
+		return 1;
+	if (ctx->stopped || (ctx->draining && !ctx->drain_src))
+		return 0;
+	return v4l2_m2m_num_src_bufs_ready(m2m) > 0;
+}
+
+/*
+ * Hand finished frames, in bitstream order, to CAPTURE buffers. Returns
+ * true when the frame that ends a drain went out (with the LAST flag).
+ */
+static bool ave_deliver(struct ave_ctx *ctx)
+{
+	struct v4l2_m2m_ctx *m2m = ctx->fh.m2m_ctx;
+	struct ave_session *sess = ctx->sess;
+	bool last = false;
+
+	while (sess && sess->done_count) {
+		unsigned int slot = sess->done_fifo[sess->done_head];
+		struct ave_slot *s = &sess->slot[slot];
+		struct vb2_v4l2_buffer *dst;
+		enum vb2_buffer_state state = VB2_BUF_STATE_DONE;
+		bool key = false;
+
+		dst = v4l2_m2m_dst_buf_remove(m2m);
+		if (!dst)
+			break;
+		if (ave_sess_output(ctx, slot, dst, &key)) {
+			vb2_set_plane_payload(&dst->vb2_buf, 0, 0);
+			state = VB2_BUF_STATE_ERROR;
+		}
+		v4l2_m2m_buf_copy_metadata(s->src, dst);
+		dst->flags &= ~(V4L2_BUF_FLAG_KEYFRAME | V4L2_BUF_FLAG_PFRAME |
+				V4L2_BUF_FLAG_BFRAME | V4L2_BUF_FLAG_LAST);
+		dst->flags |= key ? V4L2_BUF_FLAG_KEYFRAME : V4L2_BUF_FLAG_PFRAME;
+		dst->sequence = ctx->dst_sequence++;
+
+		sess->done_head = (sess->done_head + 1) % AVE_MAX_SLOTS;
+		sess->done_count--;
+		atomic_dec(&ctx->ready);
+		s->done = false;
+		ave_sess_prepare_slot(sess, slot);
+
+		/* The last frame of a drain carries the LAST flag. */
+		if (READ_ONCE(ctx->flush_pending) && !sess->fw_open && !sess->done_count) {
+			dst->flags |= V4L2_BUF_FLAG_LAST;
+			last = true;
+		}
+		ave_vb2_put(s->input_mem);
+		s->input_mem = NULL;
+		v4l2_m2m_buf_done(s->src, state);
+		s->src = NULL;
+		v4l2_m2m_buf_done(dst, state);
+	}
+	return last;
+}
+
+static bool ave_slot_answered(struct ave_dev *ave, void *arg)
+{
+	struct ave_session *sess = arg;
+
+	return sess->busy < sess->p.slots || sess->done_count;
+}
+
+static bool ave_frame_answered(struct ave_dev *ave, void *arg)
+{
+	struct ave_slot *s = arg;
+
+	return !s->busy;
+}
+
+/* Send the next OUTPUT frame. Caller holds hw_lock. */
+static int ave_encode_one(struct ave_ctx *ctx)
+{
+	struct ave_dev *ave = ctx->ave;
+	struct ave_session *sess = ctx->sess;
+	struct v4l2_m2m_ctx *m2m = ctx->fh.m2m_ctx;
+	struct vb2_v4l2_buffer *src;
+	dma_addr_t input;
+	bool last;
+	int slot, ret;
+
+	slot = ave_sess_free_slot(sess);
+	if (slot < 0 && sess->busy == sess->p.slots) {
+		/* Every slot is inside the firmware: wait for one to come back. */
+		ret = ave_ipc_pump(ave, AVE_FRAME_WAIT_MS, ave_slot_answered, sess);
+		if (ret)
+			return ret;
+		ave_deliver(ctx);
+		slot = ave_sess_free_slot(sess);
+	}
+	if (slot < 0)
+		return 0;	/* waiting for CAPTURE buffers */
+
+	src = v4l2_m2m_src_buf_remove(m2m);
+	if (!src)
+		return 0;
+	last = src == ctx->drain_src;
+	src->sequence = ctx->src_sequence++;
+
+	ret = ave_sess_input(ctx, slot, src, &input);
+	if (!ret)
+		ret = ave_cmd_process(ctx, slot, src, input, READ_ONCE(ctx->bitrate),
+				      xchg(&ctx->force_key_frame, false));
+	if (ret) {
+		v4l2_m2m_buf_done(src, VB2_BUF_STATE_ERROR);
+		return ret;
+	}
+
+	/* Like macOS: the first frame goes alone, then a Complete. */
+	if (sess->frames == 1) {
+		ret = ave_ipc_pump(ave, AVE_FRAME_WAIT_MS, ave_frame_answered, &sess->slot[slot]);
+		if (!ret)
+			ret = ave_cmd_complete(ctx, 1);
+		if (!ret)
+			ret = ave_ipc_settle(ave, AVE_FRAME_WAIT_MS);
+		if (ret)
+			return ret;
+	} else {
+		ret = ave_ipc_pump(ave, 0, NULL, NULL);
+		if (ret)
+			return ret;
+	}
+
+	if (last) {
+		ctx->drain_src = NULL;
+		WRITE_ONCE(ctx->flush_pending, true);
+	}
+	return 0;
+}
+
+/*
+ * End of a drain: flush and close the session, deliver what is left and
+ * finish with a LAST buffer. Caller holds hw_lock; returns true once the
+ * LAST buffer is out.
+ */
+static bool ave_finish_drain(struct ave_ctx *ctx)
+{
+	struct ave_dev *ave = ctx->ave;
+	struct ave_session *sess = ctx->sess;
+	struct vb2_v4l2_buffer *dst;
+
+	if (sess && sess->fw_open)
+		ave_session_close(ctx, true);
+	if (sess && sess->busy) {
+		/* The run job fails the session. */
+		dev_err(ave->dev, "%u frames never came back from the firmware\n", sess->busy);
+		return false;
+	}
+	if (sess && sess->done_count)
+		return ave_deliver(ctx);	/* false: waiting for CAPTURE buffers */
+
+	/* Nothing left to deliver: an empty buffer carries the LAST flag. */
+	dst = v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+	if (!dst)
+		return false;
+	vb2_set_plane_payload(&dst->vb2_buf, 0, 0);
+	dst->flags |= V4L2_BUF_FLAG_LAST;
+	dst->sequence = ctx->dst_sequence++;
+	v4l2_m2m_buf_done(dst, VB2_BUF_STATE_DONE);
+	return true;
+}
+
+/* The firmware or the session failed: return everything, fail the queues. */
+static void ave_job_fail(struct ave_ctx *ctx, int err)
+{
+	struct ave_dev *ave = ctx->ave;
+	struct v4l2_m2m_ctx *m2m = ctx->fh.m2m_ctx;
+	unsigned long flags;
+
+	/* Publish the fatal error before any teardown that can wait on PM/IPC. */
+	spin_lock_irqsave(&ctx->queue_lock, flags);
+	WRITE_ONCE(ctx->failed, true);
+	vb2_queue_error(v4l2_m2m_get_src_vq(m2m));
+	vb2_queue_error(v4l2_m2m_get_dst_vq(m2m));
+	ave_return_bufs(ctx, v4l2_m2m_get_src_vq(m2m), VB2_BUF_STATE_ERROR);
+	ave_return_bufs(ctx, v4l2_m2m_get_dst_vq(m2m), VB2_BUF_STATE_ERROR);
+	spin_unlock_irqrestore(&ctx->queue_lock, flags);
+	cancel_delayed_work(&ctx->poll_work);
+	dev_err(ave->dev, "encoding failed: %d\n", err);
+	mutex_lock(&ave->hw_lock);
+	ave_session_close(ctx, false);
+	mutex_unlock(&ave->hw_lock);
+	ave_session_free(ctx);
+	ave_reset_drain(ctx);
+}
+
+static void ave_run_work(struct work_struct *work)
+{
+	struct ave_ctx *ctx = container_of(work, struct ave_ctx, run_work);
+	struct ave_dev *ave = ctx->ave;
+	struct v4l2_m2m_ctx *m2m = ctx->fh.m2m_ctx;
+	bool eos = false, poll = false;
+	int ret = 0;
+
+	if (READ_ONCE(ctx->failed))
+		goto finish;
+
+	/*
+	 * After a drain the next frame starts a new session; after system
+	 * sleep it reopens the old one in the restarted firmware.
+	 */
+	if (!READ_ONCE(ctx->flush_pending) && v4l2_m2m_num_src_bufs_ready(m2m)) {
+		if (!ctx->sess)
+			ret = ave_session_begin(ctx);
+		else if (ctx->sess->resume)
+			ret = ave_session_reopen(ctx);
+	}
+
+	mutex_lock(&ave->hw_lock);
+	/*
+	 * A closed session (after a drain or for sleep) may still hold frames
+	 * for CAPTURE buffers; only an open one must still own the firmware.
+	 */
+	if (!ret && ctx->sess && ctx->sess->fw_open && ave_session_index(ave, ctx) < 0) {
+		dev_err(ave->dev, "session lost the firmware\n");
+		ret = -EIO;
+	}
+	if (!ret) {
+		eos = ave_deliver(ctx);
+		if (!eos && !READ_ONCE(ctx->flush_pending) && ctx->sess &&
+		    v4l2_m2m_num_src_bufs_ready(m2m) && v4l2_m2m_num_dst_bufs_ready(m2m))
+			ret = ave_encode_one(ctx);
+	}
+	if (!ret && !eos) {
+		eos = ave_deliver(ctx);
+		if (!eos && READ_ONCE(ctx->flush_pending))
+			eos = ave_finish_drain(ctx);
+		/* Frames outstanding need a running firmware. */
+		if (!eos && ctx->sess && ctx->sess->busy && ave->fw_state != AVE_FW_RUNNING) {
+			dev_err(ave->dev, "%u frames outstanding, firmware state %d\n",
+				ctx->sess->busy, ave->fw_state);
+			ret = -EIO;
+		}
+		poll = !ret && !eos && ctx->sess && ctx->sess->busy;
+	}
+	mutex_unlock(&ave->hw_lock);
+
+	if (ret) {
+		ave_job_fail(ctx, ret);
+	} else if (eos) {
+		ave_session_free(ctx);
+		ctx->draining = false;
+		WRITE_ONCE(ctx->flush_pending, false);
+		ctx->stopped = true;
+		v4l2_event_queue_fh(&ctx->fh, &ave_eos_event);
+	} else if (poll) {
+		mod_delayed_work(ave->wq, &ctx->poll_work, msecs_to_jiffies(AVE_WATCH_MS));
+	}
+finish:
+	pm_runtime_mark_last_busy(ave->dev);
+	v4l2_m2m_job_finish(ave->m2m_dev, m2m);
+}
+
+/*
+ * Collect frame answers that came in while no job ran, and watch sessions
+ * with frames outstanding.
+ */
+static void ave_poll_work(struct work_struct *work)
+{
+	struct ave_ctx *ctx = container_of(to_delayed_work(work), struct ave_ctx, poll_work);
+	struct ave_dev *ave = ctx->ave;
+	bool again = false, fail = false;
+
+	mutex_lock(&ave->hw_lock);
+	if (ctx->sess && ave->fw_state == AVE_FW_BROKEN) {
+		fail = true;
+	} else if (ctx->sess && ave_session_index(ave, ctx) >= 0) {
+		fail = ave_ipc_pump(ave, 0, NULL, NULL) != 0;
+		if (!fail && ave_sess_starved(ctx->sess) &&
+		    !v4l2_m2m_num_src_bufs_ready(ctx->fh.m2m_ctx)) {
+			dev_dbg(ave->dev, "no input, flushing %u held frames\n", ctx->sess->busy);
+			ctx->sess->nudged = true;
+			ctx->sess->progress = jiffies;
+			fail = ave_cmd_complete(ctx, 1) != 0;
+		}
+		if (!fail && ave_sess_stalled(ctx->sess)) {
+			/*
+			 * The firmware holds frames it should have answered.
+			 * Treat it as stuck, so the session fails now instead
+			 * of leaving the client waiting.
+			 */
+			dev_err(ave->dev, "%u frames unanswered for %u ms; firmware is stuck\n",
+				ctx->sess->busy, AVE_FRAME_WAIT_MS);
+			ave_fw_mark_broken(ave, -ETIMEDOUT, "frame timeout");
+			fail = true;
+		}
+		again = !fail && ctx->sess->busy;
+	} else if (ctx->sess && ctx->sess->busy) {
+		dev_err(ave->dev, "%u frames outstanding in a session that lost the firmware\n",
+			ctx->sess->busy);
+		fail = true;
+	}
+	mutex_unlock(&ave->hw_lock);
+
+	/* Jobs run on the same ordered queue, so none runs right now. */
+	if (fail)
+		ave_job_fail(ctx, -EIO);
+	else if (atomic_read(&ctx->ready))
+		v4l2_m2m_try_schedule(ctx->fh.m2m_ctx);
+	if (again)
+		queue_delayed_work(ave->wq, &ctx->poll_work, msecs_to_jiffies(AVE_WATCH_MS));
+}
+
+/*
+ * The mailbox interrupt came while no ring wait ran: take the event and let
+ * the sessions it may concern deliver. Jobs and poll work run on the same
+ * ordered queue, so none runs right now.
+ */
+static void ave_irq_work(struct work_struct *work)
+{
+	struct ave_dev *ave = container_of(work, struct ave_dev, irq_work);
+
+	mutex_lock(&ave->hw_lock);
+	if (ave->fw_state == AVE_FW_RUNNING)
+		ave_ipc_pump(ave, 0, NULL, NULL);
+	for (unsigned int i = 0; i < AVE_MAX_SESSIONS; i++)
+		if (ave->sessions[i] && atomic_read(&ave->sessions[i]->ready))
+			mod_delayed_work(ave->wq, &ave->sessions[i]->poll_work, 0);
+	mutex_unlock(&ave->hw_lock);
+}
+
+static void ave_device_run(void *priv)
+{
+	struct ave_ctx *ctx = priv;
+
+	queue_work(ctx->ave->wq, &ctx->run_work);
+}
+
+static const struct v4l2_m2m_ops ave_m2m_ops = {
+	.device_run = ave_device_run,
+	.job_ready = ave_job_ready,
+};
+
+/* File operations */
+
+static int ave_open(struct file *file)
+{
+	struct ave_dev *ave = video_drvdata(file);
+	struct ave_ctx *ctx;
+	int ret;
+
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx)
+		return -ENOMEM;
+	ctx->ave = ave;
+	spin_lock_init(&ctx->queue_lock);
+	INIT_WORK(&ctx->run_work, ave_run_work);
+	INIT_DELAYED_WORK(&ctx->poll_work, ave_poll_work);
+	atomic_set(&ctx->ready, 0);
+	ave_reset_fmts(ctx);
+
+	v4l2_fh_init(&ctx->fh, video_devdata(file));
+	ret = ave_init_ctrls(ctx);
+	if (ret)
+		goto err_fh;
+
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(ave->m2m_dev, ctx, ave_queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		goto err_ctrls;
+	}
+	/* Finished frames can be delivered with no new OUTPUT buffer queued. */
+	v4l2_m2m_set_src_buffered(ctx->fh.m2m_ctx, true);
+	v4l2_fh_add(&ctx->fh, file);
+	return 0;
+
+err_ctrls:
+	v4l2_ctrl_handler_free(&ctx->hdl);
+err_fh:
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+	return ret;
+}
+
+static int ave_release(struct file *file)
+{
+	struct ave_ctx *ctx = ave_file_to_ctx(file);
+	struct ave_dev *ave = ctx->ave;
+
+	mutex_lock(&ave->vdev_lock);
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	mutex_unlock(&ave->vdev_lock);
+	cancel_delayed_work_sync(&ctx->poll_work);
+	cancel_work_sync(&ctx->run_work);
+	v4l2_ctrl_handler_free(&ctx->hdl);
+	v4l2_fh_del(&ctx->fh, file);
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+	return 0;
+}
+
+static const struct v4l2_file_operations ave_fops = {
+	.owner = THIS_MODULE,
+	.open = ave_open,
+	.release = ave_release,
+	.poll = v4l2_m2m_fop_poll,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = v4l2_m2m_fop_mmap,
+};
+
+int ave_v4l2_register(struct ave_dev *ave)
+{
+	struct video_device *vdev = &ave->vdev;
+	int ret;
+
+	mutex_init(&ave->vdev_lock);
+	ave->wq = alloc_ordered_workqueue("apple-ave", WQ_MEM_RECLAIM);
+	if (!ave->wq)
+		return -ENOMEM;
+	INIT_WORK(&ave->irq_work, ave_irq_work);
+	ret = ave_ipc_irq_init(ave, to_platform_device(ave->dev));
+	if (ret) {
+		dev_err_probe(ave->dev, ret, "cannot get the mailbox interrupt\n");
+		goto err_wq;
+	}
+
+	ret = v4l2_device_register(ave->dev, &ave->v4l2_dev);
+	if (ret)
+		goto err_irq;
+
+	ave->m2m_dev = v4l2_m2m_init(&ave_m2m_ops);
+	if (IS_ERR(ave->m2m_dev)) {
+		ret = PTR_ERR(ave->m2m_dev);
+		goto err_v4l2;
+	}
+
+	strscpy(vdev->name, AVE_NAME, sizeof(vdev->name));
+	vdev->fops = &ave_fops;
+	vdev->ioctl_ops = &ave_ioctl_ops;
+	vdev->release = video_device_release_empty;
+	vdev->lock = &ave->vdev_lock;
+	vdev->v4l2_dev = &ave->v4l2_dev;
+	vdev->vfl_dir = VFL_DIR_M2M;
+	vdev->device_caps = V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_STREAMING;
+	video_set_drvdata(vdev, ave);
+
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_m2m;
+	return 0;
+
+err_m2m:
+	v4l2_m2m_release(ave->m2m_dev);
+err_v4l2:
+	v4l2_device_unregister(&ave->v4l2_dev);
+err_irq:
+	free_irq(ave->irq, ave);
+	cancel_work_sync(&ave->irq_work);
+err_wq:
+	destroy_workqueue(ave->wq);
+	return ret;
+}
+
+void ave_v4l2_unregister(struct ave_dev *ave)
+{
+	video_unregister_device(&ave->vdev);
+	v4l2_m2m_release(ave->m2m_dev);
+	v4l2_device_unregister(&ave->v4l2_dev);
+	free_irq(ave->irq, ave);
+	cancel_work_sync(&ave->irq_work);
+	destroy_workqueue(ave->wq);
+}
diff --git a/drivers/media/platform/apple/ave/ave-vb2.c b/drivers/media/platform/apple/ave/ave-vb2.c
new file mode 100644
index 0000000000..ba0325c9c8
--- /dev/null
+++ b/drivers/media/platform/apple/ave/ave-vb2.c
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Keep OUTPUT mappings alive independently of vb2 buffer completion.
+ *
+ * Copyright The Aurora Silicon Contributors
+ */
+#include <linux/dma-buf.h>
+#include <linux/refcount.h>
+#include <linux/slab.h>
+
+#include <media/videobuf2-dma-contig.h>
+
+#include "ave.h"
+
+/*
+ * vb2 owns one reference, each submitted Process owns another. A failed
+ * session keeps its references in quarantine until the coprocessor and DART
+ * have lost power. In particular, DQBUF/REQBUFS/close may release vb2's
+ * reference without unmapping an imported attachment or freeing an MMAP IOVA.
+ */
+struct ave_vb2_mem {
+	refcount_t refs;
+	void *priv;
+	struct dma_buf *dbuf;
+	struct device *dev;
+	bool mapped;
+};
+
+struct ave_vb2_mem *ave_vb2_get(struct vb2_buffer *vb)
+{
+	struct ave_vb2_mem *mem = vb->planes[0].mem_priv;
+
+	refcount_inc(&mem->refs);
+	return mem;
+}
+
+void ave_vb2_put(void *buf_priv)
+{
+	struct ave_vb2_mem *mem = buf_priv;
+
+	if (!mem || !refcount_dec_and_test(&mem->refs))
+		return;
+	if (mem->dbuf) {
+		if (mem->mapped)
+			vb2_dma_contig_memops.unmap_dmabuf(mem->priv);
+		vb2_dma_contig_memops.detach_dmabuf(mem->priv);
+		dma_buf_put(mem->dbuf);
+		put_device(mem->dev);
+	} else {
+		vb2_dma_contig_memops.put(mem->priv);
+	}
+	kfree(mem);
+}
+
+static void *ave_vb2_alloc(struct vb2_buffer *vb, struct device *dev,
+			 unsigned long size)
+{
+	struct ave_vb2_mem *mem;
+
+	mem = kzalloc_obj(*mem);
+	if (!mem)
+		return ERR_PTR(-ENOMEM);
+	mem->priv = vb2_dma_contig_memops.alloc(vb, dev, size);
+	if (IS_ERR(mem->priv)) {
+		void *err = mem->priv;
+
+		kfree(mem);
+		return err;
+	}
+	refcount_set(&mem->refs, 1);
+	return mem;
+}
+
+static void *ave_vb2_attach(struct vb2_buffer *vb, struct device *dev,
+			  struct dma_buf *dbuf, unsigned long size)
+{
+	struct ave_vb2_mem *mem;
+
+	mem = kzalloc_obj(*mem);
+	if (!mem)
+		return ERR_PTR(-ENOMEM);
+	mem->priv = vb2_dma_contig_memops.attach_dmabuf(vb, dev, dbuf, size);
+	if (IS_ERR(mem->priv)) {
+		void *err = mem->priv;
+
+		kfree(mem);
+		return err;
+	}
+	/* vb2 can drop its dma_buf and device references before quarantine ends. */
+	get_dma_buf(dbuf);
+	mem->dbuf = dbuf;
+	mem->dev = get_device(dev);
+	refcount_set(&mem->refs, 1);
+	return mem;
+}
+
+static int ave_vb2_map(void *buf_priv)
+{
+	struct ave_vb2_mem *mem = buf_priv;
+	int ret;
+
+	if (mem->mapped)
+		return 0;
+	ret = vb2_dma_contig_memops.map_dmabuf(mem->priv);
+	if (!ret)
+		mem->mapped = true;
+	return ret;
+}
+
+static void ave_vb2_unmap(void *buf_priv)
+{
+	/* The final put unmaps, after both vb2 and firmware have let go. */
+}
+
+static void *ave_vb2_cookie(struct vb2_buffer *vb, void *buf_priv)
+{
+	struct ave_vb2_mem *mem = buf_priv;
+
+	return vb2_dma_contig_memops.cookie(vb, mem->priv);
+}
+
+static void *ave_vb2_vaddr(struct vb2_buffer *vb, void *buf_priv)
+{
+	struct ave_vb2_mem *mem = buf_priv;
+
+	return vb2_dma_contig_memops.vaddr(vb, mem->priv);
+}
+
+static int ave_vb2_mmap(void *buf_priv, struct vm_area_struct *vma)
+{
+	struct ave_vb2_mem *mem = buf_priv;
+
+	return vb2_dma_contig_memops.mmap(mem->priv, vma);
+}
+
+static struct dma_buf *ave_vb2_export(struct vb2_buffer *vb, void *buf_priv,
+				      unsigned long flags)
+{
+	struct ave_vb2_mem *mem = buf_priv;
+
+	return vb2_dma_contig_memops.get_dmabuf(vb, mem->priv, flags);
+}
+
+static unsigned int ave_vb2_num_users(void *buf_priv)
+{
+	struct ave_vb2_mem *mem = buf_priv;
+
+	return vb2_dma_contig_memops.num_users(mem->priv);
+}
+
+static void ave_vb2_prepare(void *buf_priv)
+{
+	struct ave_vb2_mem *mem = buf_priv;
+
+	vb2_dma_contig_memops.prepare(mem->priv);
+}
+
+static void ave_vb2_finish(void *buf_priv)
+{
+	struct ave_vb2_mem *mem = buf_priv;
+
+	vb2_dma_contig_memops.finish(mem->priv);
+}
+
+/* OUTPUT supports MMAP and DMABUF; CAPTURE never goes to the firmware. */
+const struct vb2_mem_ops ave_vb2_memops = {
+	.alloc = ave_vb2_alloc,
+	.put = ave_vb2_put,
+	.get_dmabuf = ave_vb2_export,
+	.cookie = ave_vb2_cookie,
+	.vaddr = ave_vb2_vaddr,
+	.mmap = ave_vb2_mmap,
+	.prepare = ave_vb2_prepare,
+	.finish = ave_vb2_finish,
+	.map_dmabuf = ave_vb2_map,
+	.unmap_dmabuf = ave_vb2_unmap,
+	.attach_dmabuf = ave_vb2_attach,
+	.detach_dmabuf = ave_vb2_put,
+	.num_users = ave_vb2_num_users,
+};
diff --git a/drivers/media/platform/apple/ave/ave-writer.c b/drivers/media/platform/apple/ave/ave-writer.c
new file mode 100644
index 0000000000..1e69481057
--- /dev/null
+++ b/drivers/media/platform/apple/ave/ave-writer.c
@@ -0,0 +1,520 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple AVE video encoder: firmware commands
+ *
+ * Start and Process are large command images. Each is built in a zeroed
+ * buffer: the header, the constant words (ave-image.c), then every field
+ * that depends on the session or the frame.
+ *
+ * Copyright The Aurora Silicon Contributors
+ */
+#include <linux/device.h>
+#include <linux/math64.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include <media/videobuf2-v4l2.h>
+
+#include "ave.h"
+#include "ave-regs.h"
+
+/*
+ * IEEE 754 double for the positive value @num / @den (0 for 0), built with
+ * integer arithmetic; the firmware takes rates and limits as doubles.
+ */
+static u64 ave_f64(u64 num, u64 den)
+{
+	u64 mant = 0, rem;
+	int exp = 0;
+
+	if (!num || !den)
+		return 0;
+	while (num >= den << 1) {
+		den <<= 1;
+		exp++;
+	}
+	while (num < den) {
+		num <<= 1;
+		exp--;
+	}
+	/* 1 <= num/den < 2: take 53 significant bits by long division. */
+	rem = num;
+	for (unsigned int i = 0; i < 53; i++) {
+		mant <<= 1;
+		if (rem >= den) {
+			mant |= 1;
+			rem -= den;
+		}
+		rem <<= 1;
+	}
+	return (u64)(exp + 1023) << 52 | (mant & GENMASK_ULL(51, 0));
+}
+
+#define AVE_F64_NEG BIT_ULL(63)
+
+static void ave_put32(u8 *cmd, u32 off, u32 val)
+{
+	put_unaligned_le32(val, cmd + off);
+}
+
+static void ave_put64(u8 *cmd, u32 off, u64 val)
+{
+	put_unaligned_le64(val, cmd + off);
+}
+
+void ave_write_surface(const struct ave_fw_layout *fw, u8 *cmd,
+		       const struct ave_surface_layout *l, unsigned int index,
+		       dma_addr_t addr, u32 size)
+{
+	u32 address_off = l->address + l->address_stride * index;
+	u32 size_off = l->size + l->size_stride * index;
+
+	ave_put64(cmd, address_off, addr);
+	ave_put32(cmd, size_off, size);
+	if (fw->abi->padded_surfaces)
+		ave_put32(cmd, size_off + 4, 0);
+}
+
+static void ave_put_buf(const struct ave_fw_layout *fw, u8 *cmd,
+			const struct ave_surface_layout *l, unsigned int index,
+			const struct ave_buf *b, u32 size)
+{
+	ave_write_surface(fw, cmd, l, index, b->dma, size);
+}
+
+/* Is another session open in the firmware besides @ctx's? */
+static bool ave_cmd_others_open(struct ave_ctx *ctx)
+{
+	struct ave_dev *ave = ctx->ave;
+
+	for (unsigned int i = 0; i < AVE_MAX_SESSIONS; i++)
+		if (ave->sessions[i] && ave->sessions[i] != ctx &&
+		    ave->sessions[i]->sess->fw_open)
+			return true;
+	return false;
+}
+
+/*
+ * Header word +0x2c depends on the set of open sessions: 0x1e0 on Open and
+ * Start (0x140 when another session is open), the codec value on every
+ * other command of a lone session, and 0 while another one is open.
+ */
+u32 ave_session_arg2(struct ave_ctx *ctx)
+{
+	if (ctx->ave->layout->counted && ctx->sess->p.codec == AVE_CODEC_H264)
+		return ctx->sess->p.bframes ? AVE_SESSION_ARG2_H264 : 0x140;
+	if (ave_cmd_others_open(ctx))
+		return 0;
+	return ctx->sess->p.codec == AVE_CODEC_HEVC ? AVE_SESSION_ARG2_HEVC :
+						      AVE_SESSION_ARG2_H264;
+}
+
+u32 ave_session_setup_arg2(struct ave_ctx *ctx)
+{
+	return ave_cmd_others_open(ctx) ? AVE_SESSION_ARG2_SETUP_SHARED :
+					  AVE_SESSION_ARG2_SETUP;
+}
+
+void ave_write_header(struct ave_ctx *ctx, u8 *cmd, enum ave_opcode op,
+		      u32 echo, u32 arg0, u32 arg2)
+{
+	const struct ave_fw_abi *abi = ctx->ave->layout->abi;
+	struct ave_command header = {
+		.op = op,
+		.codec = ctx->sess->p.codec,
+		.client = ctx->sess->client,
+		.subtype = echo,
+		.arg0 = arg0,
+		.arg2 = arg2,
+	};
+
+	ctx->sess->token += AVE_TOKEN_STEP;
+	header.token = ctx->sess->token;
+	abi->write_header(cmd, abi, &header);
+}
+
+void ave_write_global(struct ave_dev *ave, u8 *cmd, enum ave_opcode op)
+{
+	const struct ave_fw_abi *abi = ave->layout->abi;
+	struct ave_command header = {
+		.op = op,
+		.codec = AVE_CODEC_H264,
+		.subtype = U32_MAX,
+	};
+
+	abi->write_header(cmd, abi, &header);
+}
+
+void ave_stamp_command(const struct ave_fw_abi *abi, u8 *cmd, u64 timeout,
+		       u64 created)
+{
+	ave_put64(cmd, abi->timeout_offset, timeout);
+	ave_put64(cmd, abi->created_offset, created);
+}
+
+#define AVE_START_ARRAY_LEN 30
+#define AVE_START_INIT_QP_VALUE 26
+
+static void ave_start_surfaces(struct ave_session *sess, u8 *cmd,
+			       const struct ave_fw_layout *fw)
+{
+	const struct ave_params *p = &sess->p;
+	bool hevc = p->codec == AVE_CODEC_HEVC;
+	unsigned int tiles = hevc ? 4 : AVE_TILE_BUFS;
+	const struct ave_start_layout *l = &fw->start[p->codec - 1];
+
+	/* Clear every descriptor the image may carry, then fill ours. */
+	for (unsigned int i = 0; i < AVE_MAX_REFS; i++) {
+		ave_write_surface(fw, cmd, &l->ref_a, i, 0, 0);
+		ave_write_surface(fw, cmd, &l->ref_b, i, 0, 0);
+		ave_write_surface(fw, cmd, &l->ref_c, i, 0, 0);
+		ave_write_surface(fw, cmd, &l->ref_c_alias, i, 0, 0);
+		ave_write_surface(fw, cmd, &l->ref_d, i, 0, 0);
+	}
+	for (unsigned int s = 0; s < AVE_START_ARRAY_LEN; s++) {
+		ave_write_surface(fw, cmd, &l->coded, s, 0, 0);
+		ave_write_surface(fw, cmd, &l->meta, s, 0, 0);
+	}
+
+	ave_put_buf(fw, cmd, &l->header, 0, &sess->hdr, fw->hdr_bytes);
+	ave_write_surface(fw, cmd, &l->secondary, 0, 0, 0);
+	for (unsigned int i = 0; i < p->refs; i++) {
+		ave_put_buf(fw, cmd, &l->ref_a, i, &sess->ref_a[i],
+			    sess->ref_a[i].size);
+		ave_put_buf(fw, cmd, &l->ref_b, i, &sess->ref_b[i],
+			    sess->ref_b[i].size);
+		ave_put_buf(fw, cmd, &l->ref_c, i, &sess->ref_c[i],
+			    sess->ref_c[i].size);
+		ave_write_surface(fw, cmd, &l->ref_c_alias, i,
+				  sess->ref_c[i].dma, 0);
+		ave_put_buf(fw, cmd, &l->ref_d, i, &sess->ref_d[i],
+			    sess->ref_d[i].size);
+	}
+	if (fw->counted) {
+		ave_put32(cmd, l->refs_count, p->refs);
+		ave_put32(cmd, l->work_count, p->refs);
+		ave_put32(cmd, l->lfs_count, p->refs);
+		ave_put32(cmd, l->slots_count, p->slots);
+		ave_put32(cmd, l->meta_count, p->slots);
+		ave_put32(cmd, l->mb_count, p->rc_mode == 3 ? 3 : 1);
+		if (p->rc_mode == 3)
+			for (unsigned int i = 0; i < 2; i++)
+				ave_put_buf(fw, cmd, &l->mb, i + 1,
+					    &sess->mb_extra[i],
+					    sess->mb_extra[i].size);
+		ave_put32(cmd, l->tiles_count, tiles);
+		for (unsigned int i = 0; i < p->refs; i++) {
+			ave_put_buf(fw, cmd, &l->ref_e, i, &sess->ref_e[i],
+				    sess->ref_e[i].size);
+			ave_put_buf(fw, cmd, &l->ref_f, i, &sess->ref_f[i],
+				    sess->ref_f[i].size);
+		}
+	}
+	ave_put_buf(fw, cmd, &l->mb, 0, &sess->mb, sess->mb.size);
+	for (unsigned int s = 0; s < p->slots; s++) {
+		ave_put_buf(fw, cmd, &l->coded, s, &sess->slot[s].coded,
+			    p->coded_cap);
+		ave_put_buf(fw, cmd, &l->meta, s, &sess->slot[s].meta,
+			    sess->slot[s].meta.size);
+	}
+	ave_put_buf(fw, cmd, &l->row_a, 0, &sess->row_a, sess->row_a.size);
+	ave_put_buf(fw, cmd, &l->row_b, 0, &sess->row_b, sess->row_b.size);
+	ave_put_buf(fw, cmd, &l->fixed, 0, &sess->fixed, SZ_16K);
+	for (unsigned int i = 0; i < AVE_TILE_BUFS; i++) {
+		if (i < tiles) {
+			ave_put_buf(fw, cmd, &l->tiles[i], 0, &sess->tile[i],
+				    sess->tile[i].size);
+			ave_put_buf(fw, cmd, &l->tiles[i], 1,
+				    &sess->tile_aux[i], sess->tile_aux[i].size);
+		} else {
+			ave_write_surface(fw, cmd, &l->tiles[i], 0, 0, 0);
+			ave_write_surface(fw, cmd, &l->tiles[i], 1, 0, 0);
+		}
+	}
+	if (hevc)
+		for (unsigned int i = 0; i < 2; i++)
+			ave_put_buf(fw, cmd, &l->hevc_extra, i,
+				    &sess->hevc_extra[i],
+				    sess->hevc_extra[i].size);
+}
+
+static void ave_start_put32(u8 *cmd, u32 off, u32 val)
+{
+	if (off)
+		ave_put32(cmd, off, val);
+}
+
+static void ave_start_config(const struct ave_params *p, u8 *cmd,
+			     const struct ave_fw_layout *fw)
+{
+	bool hevc = p->codec == AVE_CODEC_HEVC;
+	bool cq = p->rc_mode == 3;
+	u32 depth = p->bit_depth ?: 8;
+	u32 crop_r = (p->cw - p->width) / 2, crop_b = (p->ch - p->height) / 2;
+	bool crop = crop_r || crop_b;
+	const struct ave_start_layout *l = &fw->start[p->codec - 1];
+
+	ave_start_put32(cmd, l->codec, p->codec);
+	ave_start_put32(
+		cmd, l->flag_8bit,
+		fw->counted ?
+			0x10000 | (hevc ? (depth == 8 ? 0x41 : 0x40) : 0) |
+				(cq ? 0x10 : 0) :
+		hevc ? depth == 8 :
+		       0);
+	ave_start_put32(cmd, l->geometry_mode,
+			(hevc ? 0x40 : 0) | (cq ? 0 : 2));
+	ave_start_put32(cmd, l->geometry_depth, depth);
+	ave_start_put32(cmd, l->const_214, 0x39d);
+	ave_start_put32(cmd, l->const_218, 0x18);
+	ave_start_put32(cmd, l->fps, p->fps_int);
+
+	/* Rate control */
+	ave_start_put32(cmd, l->rc_mode, p->rc_mode);
+	ave_start_put32(cmd, l->bitrate, p->bitrate);
+	for (unsigned int i = 0; i < 3; i++)
+		ave_put32(cmd, (l->init_qp + 4 * i),
+			  cq ? p->initial_qp : AVE_START_INIT_QP_VALUE);
+	ave_start_put32(cmd, l->limits, p->limit_bytes ? 1 : 0);
+	if (l->limit_bytes && p->limit_bytes) {
+		ave_put64(cmd, l->limit_bytes,
+			  ave_f64((u64)p->limit_bytes * (fw->counted ? 8 : 1),
+				  1));
+		ave_put64(cmd, l->limit_secs, ave_f64(1, 1));
+	}
+	ave_put64(cmd, l->f64_288, ave_f64(1, 1));
+	ave_put64(cmd, l->f64_290, ave_f64(1, 2));
+	ave_put64(cmd, l->f64_2c0, AVE_F64_NEG | ave_f64(1, 1));
+	ave_put64(cmd, l->f64_2c8, AVE_F64_NEG | ave_f64(1, 1));
+	ave_start_put32(cmd, l->min_qp, p->min_qp);
+	ave_start_put32(cmd, l->max_qp, p->max_qp);
+	ave_start_put32(cmd, l->min_qp2, p->min_qp);
+	ave_start_put32(cmd, l->max_qp2, p->max_qp);
+	ave_start_put32(cmd, l->rc_flags, cq ? 0 : hevc ? 0x736 : 0x8202);
+	ave_start_put32(cmd, l->rc_310, cq ? 0 : 30);
+	if (!hevc)
+		ave_start_put32(cmd, l->h264_380, 1);
+
+	/* GOP structure: with B-frames as captured, or P-only, or intra-only. */
+	ave_start_put32(
+		cmd, l->gop_flags,
+		(p->bframes ? 0x600 : 0x200) |
+			(fw->counted && cq ? 0x10000 | (hevc ? 0x100 : 0) : 0));
+	ave_start_put32(cmd, l->p_frames, p->intra_only ? 0 : 1);
+	ave_start_put32(cmd, l->max_b, p->bframes ? 3 : 0);
+	ave_start_put32(cmd, l->ref_depth, p->bframes ? 3 : 1);
+	ave_start_put32(cmd, l->idr_interval, p->gop);
+
+	/* Picture size */
+	ave_start_put32(cmd, l->size_class,
+			p->width * p->height > 1280 * 720 ? 3 : 1);
+	ave_start_put32(cmd, l->coded_w, p->cw);
+	ave_start_put32(cmd, l->coded_h, p->ch);
+	ave_start_put32(cmd, l->coded_h2, p->ch);
+	ave_start_put32(cmd, l->codec_flags, hevc ? 0x2000002 : 2);
+	ave_start_put32(cmd, l->bit_depth, depth);
+
+	if (!hevc) {
+		ave_start_put32(cmd, l->h264_384,
+				p->width * p->height <= 320 * 240 ? 0x40 :
+								    0x10);
+		ave_start_put32(cmd, l->codec_2588, p->high ? 2 : 0);
+		ave_start_put32(cmd, l->h264_profile, p->profile);
+		ave_start_put32(cmd, l->h264_level, p->level);
+		ave_start_put32(cmd, l->h264_max_refs,
+				(p->refs - 1) |
+					(fw->counted ? (p->cw / 16) << 16 : 0));
+		if (fw->counted) {
+			static const u8 level_idc[] = {
+				10, 9,	11, 12, 13, 20, 21, 22, 30,
+				31, 32, 40, 41, 42, 50, 51, 52,
+			};
+
+			ave_put32(cmd, l->profile_idc,
+				  p->high	  ? 100 :
+				  p->profile == 2 ? 66 :
+						    77);
+			ave_put32(cmd, l->level_idc, level_idc[p->level - 1]);
+			put_unaligned_le16(p->refs - 1, cmd + l->max_refs_copy);
+			ave_put32(cmd, l->mb_size,
+				  ((p->ch / 16 - 1) << 16) | (p->cw / 16 - 1));
+			cmd[l->mb_height] = p->ch / 16;
+			cmd[l->mb_height + 2] = 1;
+			cmd[l->mb_height + 3] = 1;
+			cmd[l->crop_copy] = crop;
+			put_unaligned_le16(crop_r, cmd + l->crop_right_copy);
+			put_unaligned_le16(crop_b, cmd + l->crop_bottom_copy);
+			cmd[l->codec_byte] = !cq;
+			/* CABAC flag in the second, packed picture structure. */
+			cmd[l->cabac_copy] = p->profile != 2;
+			cmd[l->transform_copy] = p->high;
+		}
+		ave_start_put32(cmd, l->h264_width_mbs, p->cw / 16 - 1);
+		ave_start_put32(cmd, l->h264_height_mbs, p->ch / 16 - 1);
+		ave_start_put32(cmd, l->h264_crop, crop);
+		ave_start_put32(cmd, l->h264_crop_left, 0);
+		ave_start_put32(cmd, l->h264_crop_right, crop_r);
+		ave_start_put32(cmd, l->h264_crop_top, 0);
+		ave_start_put32(cmd, l->h264_crop_bottom, crop_b);
+		ave_start_put32(cmd, l->h264_cabac, p->profile != 2);
+		cmd[l->h264_8x8] = p->high;
+		return;
+	}
+
+	ave_start_put32(cmd, l->hevc_pad,
+			1 | (p->cw > p->width ? BIT(16) | BIT(18) : 0) |
+				(p->ch > p->height ? BIT(17) | BIT(19) : 0));
+	ave_start_put32(cmd, l->hevc_profile_a, p->profile);
+	ave_start_put32(cmd, l->hevc_profile_b, p->profile);
+	cmd[l->hevc_compat_a] = depth == 8;
+	cmd[l->hevc_compat_a + 1] = 1;
+	cmd[l->hevc_compat_b] = depth == 8;
+	cmd[l->hevc_compat_b + 1] = 1;
+	cmd[l->hevc_8bit_a] = depth == 8;
+	cmd[l->hevc_8bit_b] = depth == 8;
+	/* Rate-control words that only change in constant-quality mode */
+	ave_start_put32(cmd, l->hevc_cq, cq);
+	ave_start_put32(cmd, l->hevc_cq_copy, cq);
+	ave_start_put32(cmd, l->hevc_cq_codec, cq);
+	ave_start_put32(cmd, l->hevc_cq_picture, cq ? 0x100 : 0);
+	ave_start_put32(cmd, l->hevc_rc_270c, 2);
+	ave_start_put32(cmd, l->hevc_rc_9604, cq ? 2 : 0);
+	ave_start_put32(cmd, l->hevc_rc_9608, cq ? 0 : 0x10000);
+	ave_start_put32(cmd, l->hevc_level_a, p->level);
+	ave_start_put32(cmd, l->hevc_level_b, p->level);
+	ave_start_put32(cmd, l->hevc_width, p->cw);
+	ave_start_put32(cmd, l->hevc_height, p->ch);
+	ave_start_put32(cmd, l->hevc_width_ctb, DIV_ROUND_UP(p->cw, 32));
+	ave_start_put32(cmd, l->hevc_height_ctb, DIV_ROUND_UP(p->ch, 32));
+	ave_start_put32(cmd, l->hevc_conf, crop);
+	ave_start_put32(cmd, l->hevc_conf_left, 0);
+	ave_start_put32(cmd, l->hevc_conf_right, crop_r);
+	ave_start_put32(cmd, l->hevc_conf_top, 0);
+	ave_start_put32(cmd, l->hevc_conf_bottom, crop_b);
+	ave_start_put32(cmd, l->hevc_depth_luma, depth - 8);
+	ave_start_put32(cmd, l->hevc_depth_chroma, depth - 8);
+	/* Reference structure: B-frame pyramid or low-delay P (ave-image.c) */
+	ave_start_put32(cmd, l->hevc_refs, p->bframes ? 4 : 1);
+	ave_start_put32(cmd, l->hevc_dpb_minus1, 4);
+	ave_start_put32(cmd, l->hevc_reorder, p->bframes ? 2 : 0);
+	ave_start_put32(cmd, l->hevc_reorder_copy, p->bframes ? 2 : 0);
+	ave_start_put32(cmd, l->hevc_reorder_on, p->bframes);
+}
+
+int ave_build_start(struct ave_ctx *ctx, u8 *cmd, size_t len)
+{
+	struct ave_dev *ave = ctx->ave;
+	struct ave_session *sess = ctx->sess;
+	const struct ave_params *p = &sess->p;
+	const struct ave_fw_layout *fw = ave->layout;
+
+	if (!fw->encode_ready)
+		return -EOPNOTSUPP;
+	if (len != fw->bytes[p->codec - 1][AVE_IMAGE_START] || !p->refs ||
+	    p->refs > AVE_MAX_REFS || !p->slots || p->slots > fw->max_slots)
+		return -EINVAL;
+	ave_image_start(cmd, len, fw, p->codec, p->reorder_off,
+			p->codec == AVE_CODEC_HEVC && !p->bframes);
+	ave_write_header(ctx, cmd, AVE_OP_START, AVE_OP_START, AVE_SESSION_ARG0,
+			 ave_session_setup_arg2(ctx));
+	ave_start_surfaces(sess, cmd, fw);
+	ave_start_config(p, cmd, fw);
+	return 0;
+}
+
+#define AVE_PROC_TIMESCALE 14400000ULL
+#define AVE_PROC_SHDR_ENTRIES 256
+#define AVE_PROC_SHDR_STRIDE 0x400
+#define AVE_PROC_FORCED_TYPE 2
+#define AVE_PROC_LOW_DELAY 3
+
+int ave_build_process(struct ave_ctx *ctx, u8 *cmd, size_t len,
+		      unsigned int slot, dma_addr_t input, u32 bitrate,
+		      bool force_key)
+{
+	struct ave_session *sess = ctx->sess;
+	const struct ave_params *p = &sess->p;
+	const struct ave_fw_layout *fw = ctx->ave->layout;
+	const struct ave_proc_layout *l = &fw->process[p->codec - 1];
+	struct ave_slot *s;
+	dma_addr_t y = input;
+	u64 pts;
+
+	if (!fw->encode_ready)
+		return -EOPNOTSUPP;
+	if (len != fw->bytes[p->codec - 1][AVE_IMAGE_PROCESS] ||
+	    slot >= p->slots || p->slots > fw->max_slots)
+		return -EINVAL;
+	if ((!l->force_key && force_key) ||
+	    (!l->bitrate && bitrate != p->bitrate))
+		return -EOPNOTSUPP;
+	s = &sess->slot[slot];
+	ave_image_process(cmd, len, fw, p->codec);
+	ave_write_header(ctx, cmd, AVE_OP_PROCESS, fw->process_subtype + slot,
+			 0, ave_session_arg2(ctx));
+	/* Input picture: NV12, chroma right after p->height luma lines. */
+	ave_put64(cmd, l->y, y);
+	ave_put32(cmd, l->y + 8, p->stride * p->height);
+	ave_put32(cmd, l->y + 12, p->stride);
+	ave_put64(cmd, l->uv, y + p->stride * p->height);
+	ave_put32(cmd, l->uv + 8, p->stride * p->height / 2);
+	ave_put32(cmd, l->uv + 12, p->stride);
+	ave_put32(cmd, l->in_w, p->width);
+	ave_put32(cmd, l->in_h, p->height);
+
+	/* Session values repeated in every frame */
+	ave_put32(cmd, l->coded_cap, p->coded_cap);
+	ave_put32(cmd, l->fps_int, p->fps_int);
+	/* The bit rate may change while streaming; it takes effect here. */
+	if (l->bitrate)
+		ave_put32(cmd, l->bitrate, bitrate);
+	if (l->limits)
+		ave_put32(cmd, l->limits, p->limit_bytes ? 1 : 0);
+	if (l->limit_bytes && p->limit_bytes) {
+		ave_put64(cmd, l->limit_bytes, ave_f64(p->limit_bytes, 1));
+		ave_put64(cmd, l->limit_secs, ave_f64(1, 1));
+	}
+	ave_put32(cmd, l->const5, 5);
+	ave_put64(cmd, l->fps, ave_f64(p->fps_num, p->fps_den));
+	ave_put64(cmd, l->timescale, AVE_PROC_TIMESCALE);
+	if (l->crop)
+		ave_put32(cmd, l->crop,
+			  p->cw != p->width || p->ch != p->height);
+
+	/* This frame */
+	ave_put32(cmd, l->first_frame, sess->frames == 0);
+	ave_put32(cmd, l->slot, slot);
+	ave_put64(cmd, l->coded, s->coded.dma);
+	ave_put64(cmd, l->meta, s->meta.dma);
+	if (l->meta_size)
+		ave_put32(cmd, l->meta_size, s->meta.size);
+	if (l->extra)
+		ave_write_surface(
+			fw, cmd,
+			&(struct ave_surface_layout)AVE_SURFACE(l->extra, 0), 0,
+			s->extra.dma, SZ_16K);
+	if (l->frame_size)
+		ave_put32(cmd, l->frame_size,
+			  p->rc_mode == 3 ? 0 : s->aux.size);
+	if (l->frame_buf)
+		ave_put64(cmd, l->frame_buf,
+			  fw->counted && p->rc_mode == 3 ? 0 : s->aux.dma);
+	if (l->shdr_table)
+		for (unsigned int i = 0; i < AVE_PROC_SHDR_ENTRIES; i++)
+			ave_put64(cmd, l->shdr_table + 8 * i,
+				  s->aux.dma + i * AVE_PROC_SHDR_STRIDE);
+	ave_put32(cmd, l->ordinal, sess->frames);
+	pts = mul_u64_u64_div_u64((u64)sess->frames * p->fps_den,
+				  AVE_PROC_TIMESCALE, p->fps_num);
+	ave_put64(cmd, l->pts, pts);
+	if (l->force_key)
+		ave_put32(cmd, l->force_key, force_key);
+	if (l->force_type)
+		ave_put32(cmd, l->force_type,
+			  force_key ? AVE_PROC_FORCED_TYPE : 0);
+	if (l->low_delay)
+		ave_put32(cmd, l->low_delay,
+			  p->bframes ? 0 : AVE_PROC_LOW_DELAY);
+	return 0;
+}
diff --git a/drivers/media/platform/apple/ave/ave.h b/drivers/media/platform/apple/ave/ave.h
new file mode 100644
index 0000000000..0f654aa842
--- /dev/null
+++ b/drivers/media/platform/apple/ave/ave.h
@@ -0,0 +1,466 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Apple AVE video encoder
+ *
+ * Copyright The Aurora Silicon Contributors
+ */
+#ifndef _APPLE_AVE_H_
+#define _APPLE_AVE_H_
+
+#include <linux/atomic.h>
+#include <linux/platform_device.h>
+#include <linux/sizes.h>
+#include <linux/spinlock.h>
+#include <linux/mutex.h>
+#include <linux/sizes.h>
+#include <linux/types.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fh.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-v4l2.h>
+
+#include "ave-sizes.h"
+#include "ave-recovery.h"
+
+struct debugfs_blob_wrapper;
+struct dentry;
+struct dev_pm_domain_list;
+struct iommu_domain;
+struct ave_vb2_mem;
+
+/* Frames the firmware can hold at once per session (Process "slots"). */
+#define AVE_MAX_SLOTS 7
+/* Sessions one firmware boot serves at once (macOS was seen running two). */
+#define AVE_MAX_SESSIONS 2
+
+/*
+ * Coprocessor memory every firmware boot uses, all inside one allocation.
+ * Host commands live in three areas: one large buffer for Start, small
+ * buffers for the scalar commands and one buffer per Process slot, so a
+ * command stays untouched until the firmware acknowledges it.
+ */
+#define AVE_IPC_BYTES (20 * SZ_1M)
+#define AVE_IPC_CHANNEL_OFF 0x4000
+#define AVE_IPC_HANDSHAKE_OFF 0x24000
+#define AVE_IPC_SHARED_OFF 0x28000
+#define AVE_IPC_SHARED_BYTES SZ_64K
+#define AVE_IPC_CMD_OFF 0x40000
+#define AVE_IPC_CMD_BYTES 0x1c000
+#define AVE_IPC_SCALAR_OFF 0x5c000
+#define AVE_IPC_SCALAR_BYTES 0x100
+#define AVE_IPC_SCALAR_BUFS 16
+#define AVE_IPC_PROC_OFF 0x60000
+#define AVE_IPC_PROC_BYTES 0x10000
+#define AVE_IPC_PROC_BUFS (AVE_MAX_SESSIONS * AVE_MAX_SLOTS)
+#define AVE_IPC_END (AVE_IPC_PROC_OFF + AVE_IPC_PROC_BUFS * AVE_IPC_PROC_BYTES)
+
+/* Command buffer ids, one bit each in ave_dev.unacked. */
+#define AVE_BUF_CMD 0
+#define AVE_BUF_SCALAR(i) (1 + (i))
+#define AVE_BUF_PROC(s) (1 + AVE_IPC_SCALAR_BUFS + (s))
+#define AVE_BUF_COUNT AVE_BUF_PROC(AVE_IPC_PROC_BUFS)
+
+#define AVE_MSG_MAX SZ_4K
+
+enum ave_codec {
+	AVE_CODEC_H264 = 1,
+	AVE_CODEC_HEVC = 2,
+};
+
+struct ave_buf {
+	void *cpu;
+	dma_addr_t dma;
+	size_t size; /* what the firmware is told */
+	size_t alloc; /* what is mapped, page rounded */
+	unsigned long attrs;
+};
+
+struct ave_fw_segment {
+	phys_addr_t phys;
+	u64 iova;
+	size_t size;
+};
+
+struct ave_ring {
+	char name[16];
+	u32 mode;
+	u32 doorbell;
+	u32 slots;
+	u32 offset;
+	int consumer;
+	int producer;
+};
+
+enum ave_fw_state {
+	AVE_FW_OFF, /* coprocessor in reset */
+	AVE_FW_RUNNING,
+	AVE_FW_HALTED, /* told to halt; restarts through the boot path */
+	AVE_FW_BROKEN,
+	AVE_FW_RECOVERING,	/* control off; awaiting a runtime power cycle */
+};
+
+/* The two large session commands, and their sizes per codec */
+enum ave_image {
+	AVE_IMAGE_START,
+	AVE_IMAGE_PROCESS,
+	AVE_IMAGE_COUNT,
+};
+
+/* Logical operations; wire IDs are selected by the firmware ABI. */
+enum ave_opcode {
+	AVE_OP_CONFIG = 1,
+	AVE_OP_HALT,
+	AVE_OP_OPEN,
+	AVE_OP_CLOSE,
+	AVE_OP_START = 6,
+	AVE_OP_STOP,
+	AVE_OP_PROCESS,
+	AVE_OP_COMPLETE,
+	AVE_OP_PRIORITY,
+	AVE_OP_RESET,
+	AVE_OP_FLUSH,
+	AVE_OP_COUNT,
+};
+
+#include "ave-layout.h"
+
+/* The firmware build whose command layouts the driver generates */
+#define AVE_FW_TEXT_CRC_9003_78_0 0x69c54454
+/* The M4 Pro (T6040) build of the same 25G83 firmware. */
+#define AVE_FW_TEXT_CRC_T6040_25G83 0x68d5f9f6
+
+struct ave_ctx;
+
+/* Register offsets for the shared 0x40 coprocessor architecture. */
+struct ave_coproc_regs {
+	u32 vcbar;
+	u32 timebase_freq;
+	u32 timebase;
+	u32 ctrl;
+	u32 status;
+	u32 boot_arg;
+	u32 keep_mappings;
+};
+
+struct ave_variant {
+	const struct ave_coproc_regs *regs;
+	u32 fw_text_size;
+	u32 fw_data_size;
+	u32 boot_device_id;
+	u32 device_type;
+	u32 lfs_ref_scale;
+	u32 text_crc;
+	u32 boot_arg_value;
+	u32 timebase_multiplier;
+	u64 vcbar_mask;
+	u64 vcbar_flags;
+
+	size_t extra0_size;
+	/* Register sequence and boot/hello configuration have been qualified. */
+	bool boot_qualified;
+};
+
+struct ave_dev {
+	struct device *dev;
+	const struct ave_variant *variant;
+	const struct ave_fw_layout *layout;
+	void __iomem *codec;
+	void __iomem *mbox;
+	void __iomem *coproc;
+	struct dev_pm_domain_list *pd_list;
+	struct iommu_domain *domain;
+
+	struct ave_fw_segment text;
+	struct ave_fw_segment data;
+	u32 text_crc;
+	u32 data_crc;
+	void *data_pristine;
+	bool data_dirty;
+
+	/* hw_lock protects recovery history and quarantined DMA allocations. */
+	struct ave_recovery_history recovery;
+	unsigned int recovery_count;
+	struct ave_session *failed_sessions;
+	bool inject_wedge;
+
+	/* debugfs: the last Start and first Process built, per codec */
+	struct dentry *debugfs;
+	void *dump[2][AVE_IMAGE_COUNT];
+
+	/* Serialises every firmware and ring access. */
+	struct mutex hw_lock;
+	enum ave_fw_state fw_state;
+	struct ave_buf ipc;
+	struct ave_buf boot_cfg;
+	struct ave_buf log;
+	struct ave_buf heap;
+	dma_addr_t extra0_dma;
+	size_t extra0_map_size;
+	bool extra0_mapped;
+	bool module_pinned;
+	/* A 6070 lifecycle command is serialized per logical operation. */
+	struct ave_reply expected[AVE_OP_COUNT];
+	u64 ipc_fw_base;
+	u32 channel_bytes;
+	struct ave_ring ring[2];
+	u32 next_client;
+	u32 unacked;
+	u8 want[AVE_OP_COUNT];
+	int reply_err;
+	unsigned int scalar_next;
+	struct ave_ctx *sessions[AVE_MAX_SESSIONS];
+	u8 msg[AVE_MSG_MAX];
+	u32 msg_len;
+
+	struct v4l2_device v4l2_dev;
+	struct video_device vdev;
+	struct v4l2_m2m_dev *m2m_dev;
+	/* The video device's ioctl and queue lock. */
+	struct mutex vdev_lock;
+	struct workqueue_struct *wq;
+
+	/*
+	 * The mailbox interrupt: masked by its handler until the next ring
+	 * poll has cleared the mailbox status (irq_lock). irq_kick wakes a
+	 * waiting ave_ipc_pump(); irq_work handles events nobody waits for.
+	 */
+	int irq;
+	spinlock_t irq_lock;
+	bool irq_masked;
+	bool irq_kick;
+	wait_queue_head_t irq_wait;
+	struct work_struct irq_work;
+};
+
+/* Encoding parameters, fixed for the lifetime of a session. */
+struct ave_params {
+	enum ave_codec codec;
+	u32 width, height; /* visible picture */
+	u32 cw, ch; /* coded size, multiples of 16 */
+	u32 stride; /* NV12 or P010 line stride in bytes, both planes */
+	u32 sample_bytes; /* 1 for NV12, 2 for P010 */
+	u32 mbs; /* 16x16 macroblocks */
+	u32 fps_num, fps_den; /* frames per second = num / den */
+	u32 fps_int; /* the same, rounded */
+	u32 slots;
+	u32 refs; /* max_num_ref_frames + 1 */
+	bool bframes;
+	bool intra_only;
+	bool reorder_off; /* the client asked for no B-frames */
+	u32 gop;
+	u32 rc_mode;
+	u32 bitrate;
+	u32 limit_bytes; /* 0: no data-rate limit */
+	s32 min_qp;
+	u32 max_qp;
+	u32 profile; /* H.264: 2, 4, 6; HEVC: 1 */
+	u32 level; /* firmware level enum, 1-based */
+	bool high;
+	u32 coded_cap;
