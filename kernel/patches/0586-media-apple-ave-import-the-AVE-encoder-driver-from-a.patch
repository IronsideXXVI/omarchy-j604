+/* Channel descriptors the firmware writes into the channel area */
+#define AVE_CHAN_DESC_STRIDE		0x100
+#define AVE_CHAN_DESC_NAME_LEN		0x40
+#define AVE_CHAN_DESC_DIR		0x40
+#define AVE_CHAN_DESC_IRQ		0x44
