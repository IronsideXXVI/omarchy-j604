@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Publishing a Process must already own the mapping it references. */
+static struct ave_ctx *submit_ctx;
+static unsigned int submit_slot;
+static int submit_result;
+static u8 command[256];
+static void *ave_ipc_cmd(struct ave_dev *ave, unsigned int buf, size_t len)
+{
+	return command;
+}
+static int ave_ipc_wait_ack(struct ave_dev *ave, unsigned int buf)
+{
+	return 0;
+}
+static int ave_build_start(struct ave_ctx *ctx, void *cmd, size_t len)
+{
+	return 0;
+}
+static int ave_build_process(struct ave_ctx *ctx, void *cmd, size_t len,
+			     unsigned int slot, dma_addr_t input, u32 bitrate, bool force_key)
+{
+	return 0;
+}
+static void ave_debugfs_save(struct ave_dev *ave, enum ave_codec codec,
+			     enum ave_image kind, const void *cmd, size_t len)
+{
+}
+static int ave_ipc_submit(struct ave_dev *ave, unsigned int buf, size_t len,
+			  u64 timeout, bool reply)
+{
+	struct ave_vb2_mem *mem = submit_ctx->sess->slot[submit_slot].input_mem;
+	struct test_mapping *mapping;
+
+	if (reply) {
+		assert(submit_ctx->sess->handed);
+	} else {
+		assert(mem && mem->refs == 2);
+		mapping = mem->priv;
+		mapping->firmware_visible = true;
+	}
+	if (submit_result)
+		ave_fw_mark_broken(ave, submit_result, "test submission");
+	return submit_result;
+}
diff --git a/drivers/media/platform/apple/ave/tests/recovery-boundary.h b/drivers/media/platform/apple/ave/tests/recovery-boundary.h
new file mode 100644
index 0000000000..51788e915e
--- /dev/null
+++ b/drivers/media/platform/apple/ave/tests/recovery-boundary.h
@@ -0,0 +1,332 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Fake PM, MMIO and vb2 boundary for unmodified production function bodies. */
+#include <stddef.h>
+#define container_of(p, t, m) ((t *)((char *)(p) - offsetof(t, m)))
+#define READ_ONCE(x) (x)
+#define WRITE_ONCE(x, v) ((x) = (v))
+#define dev_err_ratelimited(...) test_log(__VA_ARGS__)
+#define lockdep_assert_held(p) assert((p)->held)
+#define MEMREMAP_WC 0
+/* Host memory is coherent; the production write barrier is simulated. */
+#define wmb() ((void)0)
+#define msecs_to_jiffies(x) (x)
+#define ktime_add_ms(a, b) ((a) + (b))
+#define ktime_after(a, b) ((a) > (b))
+#define atomic_set(p, v) (*(p) = (v))
+#define atomic_read(p) (*(p))
+#define to_delayed_work(p) container_of(p, struct delayed_work, work)
+struct work_struct { int unused; };
+
+struct delayed_work { struct work_struct work; bool scheduled; };
+
+struct mutex { bool held; };
+
+static void mutex_lock(struct mutex *m)
+{
+	assert(!m->held);
+	m->held = true;
+}
+
+static void mutex_unlock(struct mutex *m)
+{
+	assert(m->held);
+	m->held = false;
+}
+
+#define spin_lock_irqsave(p, flags) do { (flags) = 0; mutex_lock(p); } while (0)
+#define spin_unlock_irqrestore(p, flags) do { (void)(flags); mutex_unlock(p); } while (0)
+struct ave_dev;
+struct device { struct ave_dev *drvdata; unsigned int refs, dma_refs; };
+
+static void *dev_get_drvdata(struct device *dev)
+{
+	return dev->drvdata;
+}
+
+struct vb2_queue { unsigned int type; bool error, streaming; void *priv; };
+
+struct vb2_buffer {
+	struct vb2_queue *vb2_queue;
+	void *priv;
+	struct { void *mem_priv; } planes[1];
+};
+
+struct vb2_v4l2_buffer { struct vb2_buffer vb2_buf; unsigned int completions; int state; };
+
+struct v4l2_m2m_ctx {
+	struct vb2_queue src, dst;
+	struct vb2_v4l2_buffer *input[4], *output[4];
+	unsigned int nsrc, ndst;
+};
+
+struct v4l2_fh { struct v4l2_m2m_ctx *m2m_ctx; };
+
+struct ave_ctx {
+	struct ave_dev *ave;
+	struct v4l2_fh fh;
+	struct ave_session *sess;
+	struct delayed_work poll_work;
+	struct mutex queue_lock;
+	int ready;
+	bool failed, draining, flush_pending, stopped;
+	struct vb2_v4l2_buffer *drain_src;
+};
+
+struct ave_dev {
+	struct device *dev;
+	struct mutex hw_lock;
+	enum ave_fw_state fw_state;
+	struct ave_ctx *sessions[AVE_MAX_SESSIONS];
+	struct ave_session *failed_sessions;
+	struct ave_recovery_history recovery;
+	unsigned int recovery_count;
+	bool inject_wedge, data_dirty;
+	void *wq, *m2m_dev, *coproc, *mbox;
+	const struct ave_variant *variant;
+	const struct ave_fw_layout *layout;
+	u32 data_crc;
+	struct ave_fw_segment text, data;
+	void *data_pristine;
+	struct ave_ring ring[2];
+	u64 ipc_fw_base;
+	bool irq_kick;
+	int irq_wait;
+};
+
+static void *test_ctrl_addr;
+static int halt_result, close_result;
+static unsigned int halts, closes, freed, suspends, resumes, schedules, barriers;
+static unsigned int polls, sleep_ms;
+static bool map_fail, ctrl_sticky, stopped_for_sleep;
+static int poll_result;
+typedef unsigned long ktime_t;
+static ktime_t ticks;
+static ktime_t ktime_get(void)
+{
+	return ++ticks;
+}
+
+static void msleep(unsigned int ms)
+{
+	sleep_ms += ms;
+}
+
+static void usleep_range(unsigned int lo, unsigned int hi) { }
+
+/* Ring waits: the mailbox interrupt never comes, so each wait times out. */
+static unsigned int irq_waits;
+static unsigned long irq_wait_max;
+#define smp_mb() __sync_synchronize()
+#define clamp_t(t, v, lo, hi) ((t)(v) < (t)(lo) ? (t)(lo) : (t)(v) > (t)(hi) ? (t)(hi) : (t)(v))
+static s64 ktime_ms_delta(ktime_t a, ktime_t b)
+{
+	return (s64)(a - b);
+}
+#define wait_event_timeout(wq, cond, timeout) ({			\
+	unsigned long __t = (timeout);					\
+	irq_waits++;							\
+	if (__t > irq_wait_max)						\
+		irq_wait_max = __t;					\
+	(cond) ? 1 : 0;							\
+})
+
+static u32 readl(const void *p)
+{
+	return *(const u32 *)p;
+}
+
+static u64 readq(const void *p)
+{
+	return *(const u64 *)p;
+}
+
+static void writel(u32 v, void *p)
+{
+	if (!ctrl_sticky) {
+		*(u32 *)p = v;
+		if (p == test_ctrl_addr)
+			stop_seen = !v;
+	}
+}
+
+static void *memremap(phys_addr_t p, size_t size, unsigned int mode)
+{
+	return map_fail ? NULL : (void *)p;
+}
+
+static void memunmap(void *p)
+{
+	barriers++;
+}
+
+static bool mod_delayed_work(void *wq, struct delayed_work *work, unsigned long delay)
+{
+	work->scheduled = true;
+	return true;
+}
+
+static bool cancel_delayed_work(struct delayed_work *work)
+{
+	work->scheduled = false;
+	return true;
+}
+
+static bool cancel_delayed_work_sync(struct delayed_work *work)
+{
+	return cancel_delayed_work(work);
+}
+
+static bool queue_delayed_work(void *wq, struct delayed_work *work, unsigned long delay)
+{
+	return mod_delayed_work(wq, work, delay);
+}
+
+static int ave_cmd_halt(struct ave_dev *ave)
+{
+	halts++;
+	return halt_result;
+}
+
+static int ave_cmd_close(struct ave_ctx *ctx)
+{
+	closes++;
+	return close_result;
+}
+
+static int ave_cmd_complete(struct ave_ctx *ctx, unsigned int n)
+{
+	return 0;
+}
+
+static int ave_ipc_settle(struct ave_dev *ave, unsigned int ms)
+{
+	return 0;
+}
+
+static int ave_ipc_poll_once(struct ave_dev *ave)
+{
+	/* A deadline bug must fail, rather than leave the test spinning. */
+	assert(++polls < 100);
+	return poll_result;
+}
+
+static bool ave_sess_starved(struct ave_session *sess)
+{
+	return false;
+}
+
+static bool ave_sess_stalled(struct ave_session *sess)
+{
+	return false;
+}
+
+static void ave_free(struct ave_dev *ave, struct ave_buf *buf)
+{
+	if (buf->cpu) {
+		assert(stop_seen && power_seen);
+		freed++;
+		buf->cpu = NULL;
+	}
+}
+
+static void pm_runtime_mark_last_busy(struct device *dev) { }
+
+static void pm_runtime_put_autosuspend(struct device *dev)
+{
+	assert(dev->refs);
+	dev->refs--;
+}
+
+static void v4l2_m2m_suspend(void *dev)
+{
+	suspends++;
+}
+
+static void v4l2_m2m_resume(void *dev)
+{
+	resumes++;
+}
+
+static void ave_v4l2_suspend(struct ave_dev *ave)
+{
+	stopped_for_sleep = true;
+}
+
+static void v4l2_m2m_try_schedule(struct v4l2_m2m_ctx *ctx)
+{
+	schedules++;
+}
+
+static struct vb2_queue *v4l2_m2m_get_src_vq(struct v4l2_m2m_ctx *ctx)
+{
+	return &ctx->src;
+}
+
+static struct vb2_queue *v4l2_m2m_get_dst_vq(struct v4l2_m2m_ctx *ctx)
+{
+	return &ctx->dst;
+}
+
+#define V4L2_TYPE_IS_OUTPUT(t) ((t) == 1)
+enum vb2_buffer_state { VB2_BUF_STATE_ERROR = 1 };
+
+static struct vb2_v4l2_buffer *v4l2_m2m_src_buf_remove(struct v4l2_m2m_ctx *ctx)
+{
+	return ctx->nsrc ? ctx->input[--ctx->nsrc] : NULL;
+}
+
+static struct vb2_v4l2_buffer *v4l2_m2m_dst_buf_remove(struct v4l2_m2m_ctx *ctx)
+{
+	return ctx->ndst ? ctx->output[--ctx->ndst] : NULL;
+}
+
+static unsigned int v4l2_m2m_num_src_bufs_ready(struct v4l2_m2m_ctx *ctx)
+{
+	return ctx->nsrc;
+}
+
+static void v4l2_m2m_buf_done(struct vb2_v4l2_buffer *buf, enum vb2_buffer_state state)
+{
+	assert(++buf->completions == 1);
+	buf->state = state;
+}
+
+static bool vb2_is_streaming(struct vb2_queue *q)
+{
+	return q->streaming;
+}
+
+static void vb2_queue_error(struct vb2_queue *q)
+{
+	q->error = true;
+}
+
+static void *vb2_get_drv_priv(struct vb2_queue *q)
+{
+	return q->priv;
+}
+#define to_vb2_v4l2_buffer(p) container_of(p, struct vb2_v4l2_buffer, vb2_buf)
+static void v4l2_m2m_buf_queue(struct v4l2_m2m_ctx *ctx, struct vb2_v4l2_buffer *buf)
+{
+	assert(!ctx->src.error && ctx->nsrc < 3);
+	ctx->input[ctx->nsrc++] = buf;
+}
+/* Forward declarations between the extracted, otherwise unchanged callbacks. */
+void ave_fw_mark_broken(struct ave_dev *ave, int err, const char *what);
+void ave_sess_reap(struct ave_dev *ave);
+static void ave_reset_drain(struct ave_ctx *ctx);
+int ave_ipc_pump(struct ave_dev *ave, unsigned int wait_ms,
+		 bool (*cond)(struct ave_dev *, void *), void *arg);
+
+/* ABI-selected helpers are unreachable in the 9003 recovery fixtures. */
+#define readl_poll_timeout(addr, value, condition, delay, timeout) \
+ ((value) = readl(addr), (condition) ? 0 : -ETIMEDOUT)
+static int ave_fw_crc(const struct ave_fw_segment *segment, u32 *crc, void *copy)
+{
+ assert(!"6070 CRC readback reached a 9003 recovery fixture");
+ return -EIO;
+}
+static void ave_fw_release_boot(struct ave_dev *ave)
+{
+ assert(!"6070 boot teardown reached a 9003 recovery fixture");
+}
diff --git a/drivers/media/platform/apple/ave/tests/recovery-test.c b/drivers/media/platform/apple/ave/tests/recovery-test.c
new file mode 100644
index 0000000000..a51bc90a87
--- /dev/null
+++ b/drivers/media/platform/apple/ave/tests/recovery-test.c
@@ -0,0 +1,413 @@
+// SPDX-License-Identifier: GPL-2.0-only
+static const struct ave_coproc_regs regs = { .ctrl = 0, .boot_arg = 4, .vcbar = 8 };
+static const struct ave_variant variant = {
+ .regs = &regs, .vcbar_mask = ~0ULL, .vcbar_flags = AVE_COPROC_VCBAR_VALID,
+};
+static const struct ave_fw_transport test_transport = { .boot_config = true };
+static const struct ave_fw_abi test_abi = { .transport = &test_transport };
+static const struct ave_fw_layout test_layout = {
+	.abi = &test_abi, .encode_ready = true, .max_slots = 2,
+};
+static u64 coproc[4];
+static u32 mailbox[16];
+static struct ave_dev ave;
+static struct device dev;
+static struct ave_ctx ctx[2];
+static struct v4l2_m2m_ctx m2m[2];
+
+static void init(void)
+{
+	memset(&ave, 0, sizeof(ave));
+	memset(&dev, 0, sizeof(dev));
+	memset(ctx, 0, sizeof(ctx));
+	memset(m2m, 0, sizeof(m2m));
+	memset(coproc, 0, sizeof(coproc));
+	memset(mailbox, 0, sizeof(mailbox));
+	halts = closes = freed = suspends = resumes = schedules = polls = sleep_ms = 0;
+	halt_result = close_result = poll_result = 0;
+	irq_waits = 0;
+	irq_wait_max = 0;
+	map_fail = ctrl_sticky = stopped_for_sleep = false;
+	stop_seen = power_seen = dma_alloc_fail = dma_attach_fail = dma_map_fail = false;
+	mapping_frees = mapping_unmaps = mapping_detaches = 0;
+	submit_result = 0;
+	test_ctrl_addr = (char *)coproc + regs.ctrl;
+	ave.dev = &dev;
+	dev.drvdata = &ave;
+	ave.variant = &variant;
+	ave.layout = &test_layout;
+	ave.coproc = coproc;
+	ave.mbox = mailbox;
+	ave.text.iova = 0x100000000;
+	*(u64 *)((char *)coproc + regs.vcbar) = ave.text.iova | AVE_COPROC_VCBAR_VALID;
+	for (unsigned int i = 0; i < 2; i++) {
+		ctx[i].ave = &ave;
+		ctx[i].fh.m2m_ctx = &m2m[i];
+		m2m[i].src.type = 1;
+		m2m[i].src.priv = &ctx[i];
+		m2m[i].dst.priv = &ctx[i];
+	}
+}
+
+static void owners(void)
+{
+	for (unsigned int i = 0; i < 2; i++) {
+		ctx[i].sess = calloc(1, sizeof(*ctx[i].sess));
+		assert(ctx[i].sess);
+		ctx[i].sess->handed = ctx[i].sess->fw_open = true;
+		ctx[i].sess->p.slots = 2;
+		ctx[i].sess->p.codec = AVE_CODEC_H264;
+		ctx[i].sess->hdr.cpu = (void *)1;
+		ave.sessions[i] = &ctx[i];
+		dev.refs++;
+	}
+	ave.fw_state = AVE_FW_RUNNING;
+	*(u32 *)((char *)coproc + regs.ctrl) = AVE_COPROC_CTRL_RUN;
+	*(u32 *)((char *)coproc + regs.boot_arg) = AVE_COPROC_BOOT_ARG_VALUE;
+	ave.ring[0].slots = 4;
+	ave.ipc_fw_base = 0x1234;
+}
+
+static void buffer_failure(void)
+{
+	struct vb2_v4l2_buffer input[2][3] = {}, output[2][2] = {};
+	struct dma_buf imported = { .refs = 1 };
+
+	init();
+	owners();
+	for (unsigned int i = 0; i < 2; i++) {
+		struct vb2_buffer *vb = &input[i][0].vb2_buf;
+
+		vb->planes[0].mem_priv = i ?
+			ave_vb2_memops.attach_dmabuf(vb, &dev, &imported, SZ_16K) :
+			ave_vb2_memops.alloc(vb, &dev, SZ_16K);
+		assert(!IS_ERR(vb->planes[0].mem_priv));
+		if (i)
+			assert(!ave_vb2_memops.map_dmabuf(vb->planes[0].mem_priv));
+		submit_ctx = &ctx[i];
+		submit_slot = 0;
+		mutex_lock(&ave.hw_lock);
+		assert(!ave_cmd_process(&ctx[i], 0, &input[i][0], 0, 0, false));
+		mutex_unlock(&ave.hw_lock);
+		ctx[i].sess->slot[0].src = &input[i][0];
+		/* One idle owner and one with a firmware-owned frame. */
+		ctx[i].sess->busy = i;
+		ctx[i].ready = i;
+		m2m[i].input[0] = &input[i][1];
+		m2m[i].input[1] = &input[i][2];
+		m2m[i].nsrc = 2;
+		m2m[i].output[0] = &output[i][0];
+		m2m[i].output[1] = &output[i][1];
+		m2m[i].ndst = 2;
+	}
+	assert(!ave_inject_wedge(&ave, 1));
+	assert(ave.fw_state == AVE_FW_BROKEN);
+	assert(ctx[0].poll_work.scheduled && ctx[1].poll_work.scheduled);
+	/* No runtime recovery is permitted while either owner remains. */
+	assert(ave_runtime_suspend(&dev) == -EBUSY);
+	assert(!ave.recovery_count && !halts);
+	for (unsigned int i = 0; i < 2; i++) {
+		ave_poll_work(&ctx[i].poll_work.work);
+		assert(ctx[i].failed && !ctx[i].sess && !ave.sessions[i]);
+		assert(m2m[i].src.error && m2m[i].dst.error);
+		assert(!m2m[i].nsrc && !m2m[i].ndst && !ctx[i].ready);
+		assert(!ctx[i].poll_work.scheduled && !ave_job_ready(&ctx[i]));
+		for (unsigned int n = 0; n < 3; n++)
+			assert(input[i][n].completions == 1 &&
+			       input[i][n].state == VB2_BUF_STATE_ERROR);
+		for (unsigned int n = 0; n < 2; n++)
+			assert(output[i][n].completions == 1 &&
+			       output[i][n].state == VB2_BUF_STATE_ERROR);
+		/* DQBUF/REQBUFS/close immediately after ERROR: vb2 lets go. */
+		if (i) {
+			ave_vb2_memops.unmap_dmabuf(input[i][0].vb2_buf.planes[0].mem_priv);
+			ave_vb2_memops.detach_dmabuf(input[i][0].vb2_buf.planes[0].mem_priv);
+		} else {
+			ave_vb2_memops.put(input[i][0].vb2_buf.planes[0].mem_priv);
+		}
+		input[i][0].vb2_buf.planes[0].mem_priv = NULL;
+		assert(!mapping_frees && !mapping_unmaps && !mapping_detaches);
+	}
+	/* Even dropping the importing fd cannot destroy its retained attachment. */
+	dma_buf_put(&imported);
+	assert(imported.refs == 1 && dev.dma_refs == 1);
+	assert(!dev.refs && !freed && ave.failed_sessions && !closes);
+	/* A QBUF racing the failure is returned instead of silently requeued. */
+	{
+		struct vb2_v4l2_buffer extra = {};
+
+		extra.vb2_buf.vb2_queue = &m2m[0].src;
+		ave_buf_queue(&extra.vb2_buf);
+		assert(extra.completions == 1 && extra.state == VB2_BUF_STATE_ERROR);
+	}
+	*(u32 *)(ave.coproc + regs.boot_arg) = 0;
+	assert(!ave_runtime_suspend(&dev));
+	assert(readl(ave.coproc + regs.boot_arg) == AVE_COPROC_BOOT_ARG_VALUE);
+	assert(ave.fw_state == AVE_FW_RECOVERING && ave.recovery_count == 1);
+	assert(!readl(ave.coproc + regs.ctrl));
+	mutex_lock(&ave.hw_lock);
+	/* CTRL=0 alone is not proof of a power cycle. */
+	assert(ave_fw_prepare_restart(&ave) == -EAGAIN && !freed);
+	*(u32 *)(ave.coproc + regs.boot_arg) = 0;
+	power_seen = true; /* VENC and its DART have now lost power. */
+	assert(!ave_fw_prepare_restart(&ave));
+	mutex_unlock(&ave.hw_lock);
+	assert(freed == 2 && !ave.failed_sessions && !ave.inject_wedge);
+	assert(stop_seen && mapping_frees == 2 && mapping_unmaps == 1 && mapping_detaches == 1);
+	assert(!imported.refs && !dev.dma_refs);
+	assert(ave.fw_state == AVE_FW_HALTED);
+	m2m[0].dst.streaming = true;
+	ave_stop_streaming(&m2m[0].src);
+	assert(ctx[0].failed); /* STREAMOFF one queue cannot clear the failure. */
+	m2m[0].dst.streaming = false;
+	ave_stop_streaming(&m2m[0].dst);
+	assert(!ctx[0].failed);
+	m2m[0].src.error = false; /* vb2 clears queue errors on STREAMOFF. */
+	{
+		struct vb2_v4l2_buffer extra = {};
+
+		extra.vb2_buf.vb2_queue = &m2m[0].src;
+		ave_buf_queue(&extra.vb2_buf); /* Before start_streaming on STREAMON. */
+		assert(!extra.completions && m2m[0].nsrc == 1);
+	}
+}
+
+static void sleep_guarantees(void)
+{
+	init();
+	ave.fw_state = AVE_FW_RUNNING;
+	halt_result = -ETIMEDOUT;
+	assert(ave_suspend(&dev) == -EBUSY);
+	assert(suspends == 1 && resumes == 1 && stopped_for_sleep);
+	assert(ave.fw_state == AVE_FW_BROKEN && !ave.recovery_count);
+	assert(ave_suspend(&dev) == -EBUSY && halts == 1);
+	assert(suspends == 2 && resumes == 2);
+	ave.fw_state = AVE_FW_RECOVERING;
+	assert(ave_suspend(&dev) == -EBUSY);
+	assert(resumes == 3);
+	ave.fw_state = AVE_FW_RUNNING;
+	halt_result = 0;
+	assert(!ave_suspend(&dev));
+	assert(ave.fw_state == AVE_FW_HALTED && resumes == 3);
+	assert(!ave_resume(&dev) && resumes == 4);
+}
+
+static void recovery_failures(void)
+{
+	init();
+	jiffies = 100;
+	for (unsigned int i = 0; i < AVE_RECOVERY_ATTEMPTS; i++) {
+		ave.fw_state = AVE_FW_BROKEN;
+		ave.ipc_fw_base = 1;
+		ave.ring[0].slots = 4;
+		halt_result = -ETIMEDOUT;
+		assert(!ave_runtime_suspend(&dev));
+		assert(ave.fw_state == AVE_FW_RECOVERING);
+	}
+	assert(halts == 3 && ave.recovery_count == 3);
+	ave.fw_state = AVE_FW_BROKEN;
+	assert(ave_runtime_suspend(&dev) == -EBUSY && halts == 3);
+	jiffies += AVE_RECOVERY_WINDOW;
+	ctrl_sticky = true;
+	*(u32 *)(ave.coproc + regs.ctrl) = AVE_COPROC_CTRL_RUN;
+	assert(ave_runtime_suspend(&dev) == -EIO);
+	assert(ave.fw_state == AVE_FW_BROKEN && ave.recovery_count == 4);
+	ctrl_sticky = false;
+	assert(!ave_runtime_suspend(&dev));
+	assert(!ave_runtime_suspend(&dev)); /* Does not count the PM retry again. */
+	assert(ave.recovery_count == 5);
+}
+
+static bool never_answered(struct ave_dev *dev, void *arg) { return false; }
+
+/*
+ * A quiet ring: the pump sleeps on the mailbox interrupt between polls, never
+ * longer than the deadline left or the recheck interval, and still gives up
+ * at the deadline.
+ */
+static void quiet_ring_deadline(void)
+{
+	init();
+	owners();
+	mutex_lock(&ave.hw_lock);
+	assert(ave_ipc_pump(&ave, 50, never_answered, NULL) == -ETIMEDOUT);
+	mutex_unlock(&ave.hw_lock);
+	assert(irq_waits > 0 && irq_waits == polls);
+	assert(irq_wait_max >= 1 && irq_wait_max <= 50);
+	assert(ave.fw_state == AVE_FW_BROKEN);
+	ave_poll_work(&ctx[0].poll_work.work);
+	ave_poll_work(&ctx[1].poll_work.work);
+	mutex_lock(&ave.hw_lock);
+	stop_seen = power_seen = true;
+	ave_sess_reap(&ave);
+	mutex_unlock(&ave.hw_lock);
+}
+static void busy_ring_deadline(void)
+{
+	init();
+	owners();
+	poll_result = 1; /* A continuous stream of unrelated acks/messages. */
+	mutex_lock(&ave.hw_lock);
+	assert(ave_ipc_pump(&ave, 5, never_answered, NULL) == -ETIMEDOUT);
+	mutex_unlock(&ave.hw_lock);
+	assert(polls < 10 && ave.fw_state == AVE_FW_BROKEN);
+	assert(!irq_waits); /* Each poll found an event: no wait in between. */
+	assert(ctx[0].poll_work.scheduled && ctx[1].poll_work.scheduled);
+	ave_poll_work(&ctx[0].poll_work.work);
+	ave_poll_work(&ctx[1].poll_work.work);
+	mutex_lock(&ave.hw_lock);
+	stop_seen = power_seen = true;
+	ave_sess_reap(&ave); /* Fake reset for test cleanup only. */
+	mutex_unlock(&ave.hw_lock);
+}
+
+static void restore_data(void)
+{
+	u8 pristine[64], live[64];
+
+	init();
+	memset(pristine, 0xa5, sizeof(pristine));
+	memset(live, 0x3c, sizeof(live));
+	ave.data_pristine = pristine;
+	ave.data.phys = (phys_addr_t)live;
+	ave.data.size = sizeof(live);
+	ave.data_dirty = true;
+	map_fail = true;
+	assert(ave_fw_restore_data(&ave) == -ENOMEM && ave.data_dirty);
+	map_fail = false;
+	assert(!ave_fw_restore_data(&ave) && !ave.data_dirty);
+	assert(!memcmp(live, pristine, sizeof(live)));
+	assert(!ave_fw_restore_data(&ave));
+}
+
+static void strict_6070_recovery(void)
+{
+ static const struct ave_fw_transport transport = { .scratch_halt = true };
+ static const struct ave_fw_abi abi = { .transport = &transport };
+ static const struct ave_fw_layout layout = { .abi = &abi };
+
+ init();
+ ave.layout = &layout;
+ ave.fw_state = AVE_FW_BROKEN;
+ *(u32 *)(ave.coproc + regs.ctrl) = AVE_COPROC_CTRL_RUN;
+ assert(ave_runtime_suspend(&dev) == -EBUSY);
+ assert(ave.fw_state == AVE_FW_BROKEN && !halts && !ave.recovery_count);
+ assert(readl(ave.coproc + regs.ctrl) == AVE_COPROC_CTRL_RUN);
+ ave.fw_state = AVE_FW_RECOVERING;
+ assert(ave_runtime_suspend(&dev) == -EBUSY);
+ assert(readl(ave.coproc + regs.ctrl) == AVE_COPROC_CTRL_RUN);
+}
+
+/* An uncertain send failure must keep its pin even without a slot src. */
+static void failed_submission(void)
+{
+	struct vb2_v4l2_buffer input = {};
+	void *mem;
+
+	init();
+	owners();
+	mem = ave_vb2_memops.alloc(&input.vb2_buf, &dev, SZ_16K);
+	assert(!IS_ERR(mem));
+	input.vb2_buf.planes[0].mem_priv = mem;
+	submit_ctx = &ctx[0];
+	submit_slot = 0;
+	submit_result = -EIO;
+	mutex_lock(&ave.hw_lock);
+	assert(ave_cmd_process(&ctx[0], 0, &input, 0, 0, false) == -EIO);
+	mutex_unlock(&ave.hw_lock);
+	assert(!ctx[0].sess->slot[0].src && ctx[0].sess->slot[0].input_mem);
+	ave_vb2_memops.put(mem); /* The caller returns this failed submission. */
+	ave_poll_work(&ctx[0].poll_work.work);
+	ave_poll_work(&ctx[1].poll_work.work);
+	assert(!mapping_frees);
+	for (unsigned int i = 0; i < AVE_RECOVERY_ATTEMPTS; i++)
+		assert(ave_recovery_allow(&ave.recovery, jiffies));
+	assert(ave_runtime_suspend(&dev) == -EBUSY);
+	assert(!stop_seen && !mapping_frees && !freed);
+	jiffies += AVE_RECOVERY_WINDOW;
+	ctrl_sticky = true;
+	assert(ave_runtime_suspend(&dev) == -EIO);
+	assert(!stop_seen && !mapping_frees && !freed);
+	ctrl_sticky = false;
+	assert(!ave_runtime_suspend(&dev));
+	assert(stop_seen && !mapping_frees);
+	assert(ave_fw_prepare_restart(&ave) == -EAGAIN);
+	*(u32 *)(ave.coproc + regs.boot_arg) = 0;
+	power_seen = true;
+	mutex_lock(&ave.hw_lock);
+	assert(!ave_fw_prepare_restart(&ave));
+	mutex_unlock(&ave.hw_lock);
+	assert(mapping_frees == 1 && freed == 2);
+}
+
+/* Start can expose scratch even if submission reports failure. */
+static void failed_start(void)
+{
+	init();
+	owners();
+	submit_ctx = &ctx[0];
+	ctx[0].sess->handed = false;
+	submit_result = -EIO;
+	mutex_lock(&ave.hw_lock);
+	assert(ave_cmd_start(&ctx[0]) == -EIO);
+	assert(ctx[0].sess->handed);
+	mutex_unlock(&ave.hw_lock);
+	ave_poll_work(&ctx[0].poll_work.work);
+	ave_poll_work(&ctx[1].poll_work.work);
+	assert(!freed && ave.failed_sessions);
+	assert(!ave_runtime_suspend(&dev));
+	assert(stop_seen && !freed);
+	*(u32 *)(ave.coproc + regs.boot_arg) = 0;
+	power_seen = true;
+	mutex_lock(&ave.hw_lock);
+	assert(!ave_fw_prepare_restart(&ave));
+	mutex_unlock(&ave.hw_lock);
+	assert(freed == 2);
+}
+
+/* Allocator failures and normal vb2-only lifetimes do not leak references. */
+static void mapping_lifetimes(void)
+{
+	struct vb2_buffer vb = {};
+	struct dma_buf dbuf = { .refs = 1 };
+	void *mem;
+
+	init();
+	dma_alloc_fail = true;
+	assert(IS_ERR(ave_vb2_memops.alloc(&vb, &dev, SZ_16K)));
+	dma_alloc_fail = false;
+	dma_attach_fail = true;
+	assert(IS_ERR(ave_vb2_memops.attach_dmabuf(&vb, &dev, &dbuf, SZ_16K)));
+	assert(dbuf.refs == 1 && !dev.dma_refs);
+	dma_attach_fail = false;
+	mem = ave_vb2_memops.attach_dmabuf(&vb, &dev, &dbuf, SZ_16K);
+	assert(!IS_ERR(mem));
+	dma_map_fail = true;
+	assert(ave_vb2_memops.map_dmabuf(mem) == -EIO);
+	dma_map_fail = false;
+	assert(!ave_vb2_memops.map_dmabuf(mem));
+	ave_vb2_memops.unmap_dmabuf(mem);
+	assert(!mapping_unmaps);
+	assert(!ave_vb2_memops.map_dmabuf(mem)); /* Reuses the retained mapping. */
+	ave_vb2_memops.unmap_dmabuf(mem);
+	ave_vb2_memops.detach_dmabuf(mem);
+	assert(mapping_unmaps == 1 && mapping_detaches == 1 && mapping_frees == 1);
+	assert(dbuf.refs == 1 && !dev.dma_refs);
+}
+
+int main(void)
+{
+	mapping_lifetimes();
+	failed_submission();
+	failed_start();
+	strict_6070_recovery();
+	buffer_failure();
+	sleep_guarantees();
+	recovery_failures();
+	busy_ring_deadline();
+	quiet_ring_deadline();
+	restore_data();
+	puts("ok: recovery ownership, queues, quarantine, reset proof, rate limit, "
+	     "PM rollback, DATA, IPC deadline and interrupt wait, MMAP/dma-buf release ordering");
+	return 0;
+}
diff --git a/drivers/media/platform/apple/ave/tests/run-recovery.py b/drivers/media/platform/apple/ave/tests/run-recovery.py
new file mode 100644
index 0000000000..0ae9833039
--- /dev/null
+++ b/drivers/media/platform/apple/ave/tests/run-recovery.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise production AVE recovery, PM and queue callbacks at a fake boundary."""
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+from run import declaration, function, source
+
+
+def main():
+    here = Path(__file__).resolve().parent
+    src = here.parent
+    header = (src / 'ave.h').read_text()
+    code = (here / 'shim.h').read_text()
+    code += '\ntypedef uintptr_t phys_addr_t;\n'
