+/* Coprocessor window */
+#define AVE_COPROC_VCBAR		0x50000
+#define AVE_COPROC_VCBAR_VALID		BIT(0)
+#define AVE_COPROC_TIMEBASE_FREQ	0x360020
+#define AVE_COPROC_TIMEBASE		0x378000
