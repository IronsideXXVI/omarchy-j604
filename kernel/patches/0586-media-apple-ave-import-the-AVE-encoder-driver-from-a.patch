diff --git a/drivers/media/platform/apple/ave/abi.rst b/drivers/media/platform/apple/ave/abi.rst
new file mode 100644
index 0000000000..7717bbab48
--- /dev/null
+++ b/drivers/media/platform/apple/ave/abi.rst
@@ -0,0 +1,65 @@
+.. SPDX-License-Identifier: GPL-2.0-only
+
+Apple AVE firmware ABIs
+======================
+
+The firmware TEXT CRC chooses the wire layout. SoC match data supplies register
+addresses, boot arguments and device identity. These are separate from streaming
+qualification: identifying a firmware does not qualify its encoder payloads.
+
+9003.78.0 keeps its existing boot request, host clock synchronization, command
+IDs, contiguous surface descriptors and reply envelope. The KUnit oracle in
+``tests/ave-9003-reference.h`` freezes the driver builders and layout from Linux
+commit 23e431a98962. Tests compare every byte of AVC and HEVC Start and Process
+at 1920x1080 with B-frames enabled/disabled, and 3840x2160 with B-frames enabled.
+They compare both deterministic synthetic DART addresses and masked images.
+The constant image tables in ave-image.c are unchanged by this refactor.
+
+6070.11.1 is selected only for T6000 TEXT CRC 460c7a7c or T8112 TEXT CRC 25bfd039,
+with the corresponding SoC identity. Boot, seven-channel discovery, Config,
+Open, Close and scratch-confirmed Halt are implemented from the clean derived
+SPEC-6070-lifecycle.md ledger. Start and Process return EOPNOTSUPP before writing
+a payload or submitting a command. Reset also remains unavailable: its request
+has a codec-dependent body, rather than a scalar header. No Priority command is
+sent for this ABI. The split surface writer supports separate address and size
+arrays, without assuming a semantic mapping for the unqualified fields.
+
+Lifecycle-only validation
+-------------------------
+
+Build with CONFIG_DEBUG_FS. On a supported 6070 device, write ``1`` (AVC) or ``2``
+(HEVC) to ``/sys/kernel/debug/apple-ave/lifecycle_test``. This synchronous operation
+runs boot, Config, Open, Close and Halt, then requests runtime suspend. It does
+not allocate encoding surfaces or issue Start, Process or uninit for an encoder
+that was never initialized. A second write exercises a cold restart and DATA
+restore. An existing session makes the operation return EBUSY.
+
+The platform must supply the extra-0 register resource as ``extra0`` or register
+resource index 3, with at least 0x24 bytes on T6000 or 0x4000 bytes on T8112.
+The driver uses the translated platform resource address, maps its containing
+16 KiB page through the device DMA API and puts that dynamically allocated IOVA
+in Config. Platform DT/binding changes are separate from this driver change.
+No fixed firmware or register IOVA is used as an ordinary DMA allocation.
+
+Before every boot the driver checks the firmware's IOMMU translations. DATA must
+match the loader-exported pre-start CRC at probe; subsequent cold boots restore
+that pristine image and verify its CRC. Firmware reservations and translations
+remain persistent. IPC and extra-0 mappings are per-boot resources.
+
+Halt clears scratch0, sends ID 14 without expecting a ring reply, and waits up to
+five seconds for scratch0 0x08042006. Only then does the driver stop the IOP and
+check control readback. Runtime PM performs the power transition; a second boot
+is refused until suspend/resume has intervened. A missing Halt confirmation or
+failed lifecycle leaves the firmware broken and retains DMA mappings, runtime
+power and the module reference. A forced unload or in-place restart is not a
+recovery procedure.
+
+Hardware acceptance remains independent of KUnit: check both SoC VCBAR readbacks,
+exact hello, ring dimensions, Config/Open/Close completion IDs and status, Halt
+scratch confirmation, actual power gating and a second cold boot. Encoding on
+9003 requires the existing hardware regression lane; these software tests do not
+establish hardware equivalence.
+
+The 9003 runtime recovery path retains its upstream quarantine and reset-witness
+checks. It is deliberately unavailable for 6070: a broken lifecycle must keep
+its mappings and power until scratch-confirmed Halt can establish quiescence.
diff --git a/drivers/media/platform/apple/ave/ave-abi-test.c b/drivers/media/platform/apple/ave/ave-abi-test.c
new file mode 100644
index 0000000000..5e3ed8e212
--- /dev/null
+++ b/drivers/media/platform/apple/ave/ave-abi-test.c
@@ -0,0 +1,477 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Byte equality against the pre-ABI-refactor 9003 command builders. */
+#include <kunit/test.h>
+#include <linux/module.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "ave.h"
+#include "ave-regs.h"
+#include "tests/ave-9003-reference.h"
+
+static void ave_test_buf(struct ave_buf *b, unsigned int *index)
+{
+	b->dma = 0x820000000ULL + (u64)(*index) * 0x2000000;
+	b->size = SZ_16K * (1 + (*index)++);
+}
+
+static void ave_test_session(struct ave_session *sess, enum ave_codec codec,
+			     u32 width, u32 height, bool bframes)
+{
+	struct ave_params *p = &sess->p;
+	unsigned int index = 0;
+
+	*p = (struct ave_params){
+		.codec = codec,
+		.width = width,
+		.height = height,
+		.cw = ALIGN(width, 16),
+		.ch = ALIGN(height, 16),
+		.stride = ALIGN(width, 64),
+		.fps_num = 30,
+		.fps_den = 1,
+		.fps_int = 30,
+		.bframes = bframes,
+		.reorder_off = !bframes,
+		.slots = bframes ? 5 : 3,
+		.refs = bframes ? 5 : 2,
+		.gop = 120,
+		.rc_mode = 4,
+		.bitrate = 8000000,
+		.limit_bytes = 2000000,
+		.min_qp = -1,
+		.max_qp = 51,
+		.profile = codec == AVE_CODEC_H264 ? 6 : 1,
+		.level = codec == AVE_CODEC_H264 ? 13 : 7,
+		.high = codec == AVE_CODEC_H264,
+	};
+	p->mbs = p->cw / 16 * (p->ch / 16);
+	p->coded_cap = ALIGN(3 * p->cw * p->ch / 2, SZ_16K);
+	sess->token = 400;
+	sess->client = 10;
+	ave_test_buf(&sess->hdr, &index);
+	for (unsigned int i = 0; i < AVE_MAX_REFS; i++) {
+		ave_test_buf(&sess->ref_a[i], &index);
+		ave_test_buf(&sess->ref_b[i], &index);
+		ave_test_buf(&sess->ref_c[i], &index);
+		ave_test_buf(&sess->ref_d[i], &index);
+	}
+	ave_test_buf(&sess->mb, &index);
+	ave_test_buf(&sess->row_a, &index);
+	ave_test_buf(&sess->row_b, &index);
+	ave_test_buf(&sess->fixed, &index);
+	for (unsigned int i = 0; i < AVE_TILE_BUFS; i++) {
+		ave_test_buf(&sess->tile[i], &index);
+		ave_test_buf(&sess->tile_aux[i], &index);
+	}
+	for (unsigned int i = 0; i < 2; i++)
+		ave_test_buf(&sess->hevc_extra[i], &index);
+	for (unsigned int i = 0; i < p->slots; i++) {
+		ave_test_buf(&sess->slot[i].coded, &index);
+		ave_test_buf(&sess->slot[i].meta, &index);
+		ave_test_buf(&sess->slot[i].aux, &index);
+	}
+}
+
+/* These are synthetic DART addresses, never addresses from a device capture. */
+static void ave_mask_dart(u8 *cmd, size_t len)
+{
+	for (size_t off = 0; off + 8 <= len; off += 8) {
+		u64 val = get_unaligned_le64(cmd + off);
+
+		if (val >= 0x800000000ULL && val < 0x1000000000ULL)
+			put_unaligned_le64(0, cmd + off);
+	}
+}
+
+static void ave_9003_byte_equality(struct kunit *test)
+{
+	struct ave_dev *ave = kunit_kzalloc(test, sizeof(*ave), GFP_KERNEL);
+	struct ave_ctx *ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	struct ave_session *sess =
+		kunit_kzalloc(test, sizeof(*sess), GFP_KERNEL);
+	u8 *actual = kunit_kmalloc(test, 0x14000, GFP_KERNEL);
+	u8 *expected = kunit_kmalloc(test, 0x14000, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, ave);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	KUNIT_ASSERT_NOT_NULL(test, sess);
+	KUNIT_ASSERT_NOT_NULL(test, actual);
+	KUNIT_ASSERT_NOT_NULL(test, expected);
+	ave->layout = &ave_layout_9003_78_0;
+	ctx->ave = ave;
+	ctx->sess = sess;
+	for (unsigned int codec = AVE_CODEC_H264; codec <= AVE_CODEC_HEVC;
+	     codec++) {
+		for (unsigned int setting = 0; setting < 3; setting++) {
+			size_t len =
+				ave->layout->bytes[codec - 1][AVE_IMAGE_START];
+
+			ave_test_session(sess, codec,
+					 setting == 2 ? 3840 : 1920,
+					 setting == 2 ? 2160 : 1080,
+					 setting != 1);
+			memset(actual, 0, len);
+			memset(expected, 0, len);
+			KUNIT_ASSERT_EQ(test, ave_build_start(ctx, actual, len),
+					0);
+			sess->token = 400;
+			ave_reference_start(ctx, expected, len);
+			ave_stamp_command(ave->layout->abi, actual, 94400000,
+					  0x12345678);
+			put_unaligned_le64(94400000, expected + 0x30);
+			put_unaligned_le64(0x12345678, expected + 0x38);
+			KUNIT_EXPECT_MEMEQ(test, actual, expected, len);
+			ave_mask_dart(actual, len);
+			ave_mask_dart(expected, len);
+			KUNIT_EXPECT_MEMEQ(test, actual, expected, len);
+			for (unsigned int frame = 0; frame < 2; frame++) {
+				unsigned int slot = frame ? sess->p.slots - 1 :
+							    0;
+
+				len = ave->layout->bytes[codec - 1]
+							[AVE_IMAGE_PROCESS];
+				sess->frames = frame ? 7 : 0;
+				sess->token = 500;
+				memset(actual, 0, len);
+				memset(expected, 0, len);
+				KUNIT_ASSERT_EQ(
+					test,
+					ave_build_process(ctx, actual, len,
+							  slot, 0x8f0000000ULL,
+							  9000000, !!frame),
+					0);
+				sess->token = 500;
+				ave_reference_process(ctx, expected, len, slot,
+						      0x8f0000000ULL, 9000000,
+						      !!frame);
+				ave_stamp_command(ave->layout->abi, actual,
+						  94400000, 0x12345678);
+				put_unaligned_le64(94400000, expected + 0x30);
+				put_unaligned_le64(0x12345678, expected + 0x38);
+				KUNIT_EXPECT_MEMEQ(test, actual, expected, len);
+				ave_mask_dart(actual, len);
+				ave_mask_dart(expected, len);
+				KUNIT_EXPECT_MEMEQ(test, actual, expected, len);
+			}
+		}
+	}
+}
+
+/*
+ * HEVC Main 10 on 9003: compared with the same Main session, Start differs
+ * only in the fields the 10-30 capture showed changing with bit depth.
+ */
+static void ave_9003_hevc_main10(struct kunit *test)
+{
+	static const u32 changed[] = {
+		0x208, 0x298, 0x308, 0x2598, 0x2938, 0x293c, 0x2960,
+		0x5904, 0x5908, 0x592c, 0x5ad8, 0x5adc,
+	};
+	struct ave_dev *ave = kunit_kzalloc(test, sizeof(*ave), GFP_KERNEL);
+	struct ave_ctx *ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	struct ave_session *sess = kunit_kzalloc(test, sizeof(*sess), GFP_KERNEL);
+	u8 *main8 = kunit_kzalloc(test, 0x14000, GFP_KERNEL);
+	u8 *main10 = kunit_kzalloc(test, 0x14000, GFP_KERNEL);
+	size_t len;
+
+	KUNIT_ASSERT_NOT_NULL(test, ave);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	KUNIT_ASSERT_NOT_NULL(test, sess);
+	KUNIT_ASSERT_NOT_NULL(test, main8);
+	KUNIT_ASSERT_NOT_NULL(test, main10);
+	ave->layout = &ave_layout_9003_78_0;
+	ctx->ave = ave;
+	ctx->sess = sess;
+	len = ave->layout->bytes[AVE_CODEC_HEVC - 1][AVE_IMAGE_START];
+
+	ave_test_session(sess, AVE_CODEC_HEVC, 1920, 1080, true);
+	sess->p.min_qp = 0;
+	KUNIT_ASSERT_EQ(test, ave_build_start(ctx, main8, len), 0);
+	ave_test_session(sess, AVE_CODEC_HEVC, 1920, 1080, true);
+	sess->p.min_qp = -12;
+	sess->p.profile = 2;
+	sess->p.bit_depth = 10;
+	KUNIT_ASSERT_EQ(test, ave_build_start(ctx, main10, len), 0);
+	ave_stamp_command(ave->layout->abi, main8, 1, 2);
+	ave_stamp_command(ave->layout->abi, main10, 1, 2);
+
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(main8 + 0x208), 1);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(main10 + 0x208), 0);
+	KUNIT_EXPECT_EQ(test, (s32)get_unaligned_le32(main10 + 0x298), -12);
+	KUNIT_EXPECT_EQ(test, (s32)get_unaligned_le32(main10 + 0x308), -12);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(main10 + 0x2598), 10);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(main10 + 0x2938), 2);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(main10 + 0x5904), 2);
+	KUNIT_EXPECT_EQ(test, main10[0x293d], 0);
+	KUNIT_EXPECT_EQ(test, main10[0x293e], 1);
+	KUNIT_EXPECT_EQ(test, main10[0x5909], 0);
+	KUNIT_EXPECT_EQ(test, main10[0x590a], 1);
+	KUNIT_EXPECT_EQ(test, main10[0x2962], 0);
+	KUNIT_EXPECT_EQ(test, main10[0x592e], 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(main10 + 0x5ad8), 2);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(main10 + 0x5adc), 2);
+
+	for (size_t off = 0; off < len; off += 4) {
+		bool expected = false;
+
+		for (unsigned int i = 0; i < ARRAY_SIZE(changed); i++)
+			expected |= off == changed[i];
+		if (!expected)
+			KUNIT_EXPECT_EQ_MSG(test, get_unaligned_le32(main8 + off),
+					    get_unaligned_le32(main10 + off),
+					    "word +%#zx", off);
+	}
+}
+
+static void ave_6070_images(struct kunit *test)
+{
+	const struct ave_fw_abi *abi = &ave_abi_6070;
+	struct ave_dev *ave = kunit_kzalloc(test, sizeof(*ave), GFP_KERNEL);
+	struct ave_ctx *ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	struct ave_session *sess =
+		kunit_kzalloc(test, sizeof(*sess), GFP_KERNEL);
+	u8 actual[0x70] = {}, expected[0x70] = {};
+
+	KUNIT_ASSERT_NOT_NULL(test, ave);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	KUNIT_ASSERT_NOT_NULL(test, sess);
+	ave->layout = &ave_layout_6070_11_1;
+	ave->extra0_dma = 0x876540000ULL;
+	ctx->ave = ave;
+	ctx->sess = sess;
+	abi->write_config(ave, actual);
+	ave_stamp_command(abi, actual, 3000000, 0x123456);
+	put_unaligned_le16(1, expected);
+	put_unaligned_le32(U32_MAX, expected + 0x1c);
+	put_unaligned_le64(3000000, expected + 0x28);
+	put_unaligned_le64(0x123456, expected + 0x30);
+	expected[0x41] = 1;
+	put_unaligned_le64(ave->extra0_dma, expected + 0x48);
+	KUNIT_EXPECT_MEMEQ(test, actual, expected, sizeof(actual));
+	for (unsigned int codec = AVE_CODEC_H264; codec <= AVE_CODEC_HEVC;
+	     codec++) {
+		static const enum ave_opcode ops[] = { AVE_OP_OPEN,
+						       AVE_OP_CLOSE,
+						       AVE_OP_HALT };
+		static const u16 wire[] = { 2, 12, 14 };
+		static const u32 semantic[] = { 3, 4, U32_MAX };
+
+		for (unsigned int i = 0; i < ARRAY_SIZE(ops); i++) {
+			memset(actual, 0, sizeof(actual));
+			memset(expected, 0, sizeof(expected));
+			sess->p.codec = codec;
+			sess->client = 10;
+			sess->token = 300;
+			if (ops[i] == AVE_OP_HALT)
+				ave_write_global(ave, actual, ops[i]);
+			else
+				ave_write_header(ctx, actual, ops[i], ops[i],
+						 0xc8, 0x1e0);
+			ave_stamp_command(abi, actual, 3000000, 0x123456);
+			put_unaligned_le16(wire[i], expected);
+			if (ops[i] != AVE_OP_HALT) {
+				put_unaligned_le64(400, expected + 0x08);
+				put_unaligned_le32(10, expected + 0x10);
+				put_unaligned_le32(codec - 1, expected + 0x18);
+				put_unaligned_le32(0xc8, expected + 0x20);
+			}
+			put_unaligned_le32(semantic[i], expected + 0x1c);
+			put_unaligned_le64(3000000, expected + 0x28);
+			put_unaligned_le64(0x123456, expected + 0x30);
+			KUNIT_EXPECT_MEMEQ(test, actual, expected,
+					   abi->scalar_bytes[ops[i]]);
+		}
+	}
+	KUNIT_EXPECT_EQ(test, abi->wire_id[0][AVE_OP_PRIORITY], 0U);
+	KUNIT_EXPECT_EQ(test, abi->scalar_bytes[AVE_OP_RESET], 0U);
+	KUNIT_EXPECT_EQ(test, abi->reply_id[AVE_OP_HALT], 0U);
+}
+
+static void ave_6070_replies(struct kunit *test)
+{
+	const struct ave_fw_abi *abi = &ave_abi_6070;
+	struct ave_reply reply;
+	u8 msg[0x48] = {};
+
+	for (unsigned int op = 1; op < AVE_OP_COUNT; op++) {
+		u32 len = op == AVE_OP_PROCESS ? 0x48 : 0x40;
+
+		if (!abi->reply_id[op])
+			continue;
+		put_unaligned_le16(abi->reply_id[op], msg);
+		put_unaligned_le32(10, msg + 0x10);
+		put_unaligned_le32(abi->semantic[op], msg + 0x1c);
+		put_unaligned_le32(0x00ee0000, msg + 0x38);
+		KUNIT_ASSERT_EQ(test, abi->parse_reply(abi, msg, len, &reply),
+				0);
+		KUNIT_EXPECT_EQ(test, reply.op, (enum ave_opcode)op);
+		KUNIT_EXPECT_EQ(test, reply.client, 10ULL);
+		KUNIT_EXPECT_EQ(test, reply.subtype, abi->semantic[op]);
+		KUNIT_EXPECT_EQ(test, reply.status, 0U);
+		KUNIT_EXPECT_EQ(test,
+				abi->parse_reply(abi, msg, len - 1, &reply),
+				-EPROTO);
+		KUNIT_EXPECT_EQ(test,
+				abi->parse_reply(abi, msg, len + 1, &reply),
+				-EPROTO);
+		put_unaligned_le32(0, msg + 0x38);
+		KUNIT_ASSERT_EQ(test, abi->parse_reply(abi, msg, len, &reply),
+				0);
+		KUNIT_EXPECT_NE(test, reply.status, 0U);
+	}
+	put_unaligned_le16(2, msg); /* Request IDs are not completion IDs. */
+	KUNIT_EXPECT_EQ(test, abi->parse_reply(abi, msg, 0x40, &reply),
+			-EPROTO);
+}
+
+static void ave_6070_split_surfaces(struct kunit *test)
+{
+	const struct ave_surface_layout bank = {
+		.address = 0x4b8,
+		.size = 0x558,
+		.address_stride = 8,
+		.size_stride = 4,
+	};
+	u8 *cmd = kunit_kzalloc(test, 0x600, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, cmd);
+	for (unsigned int i = 0; i < 20; i++)
+		ave_write_surface(&ave_layout_6070_11_1, cmd, &bank, i,
+				  0x800000000ULL + i * SZ_16K,
+				  (i + 1) * SZ_16K);
+	for (unsigned int i = 0; i < 20; i++) {
+		KUNIT_EXPECT_EQ(test, get_unaligned_le64(cmd + 0x4b8 + i * 8),
+				0x800000000ULL + i * SZ_16K);
+		KUNIT_EXPECT_EQ(test, get_unaligned_le32(cmd + 0x558 + i * 4),
+				(i + 1) * SZ_16K);
+	}
+}
+
+static void ave_6070_gate(struct kunit *test)
+{
+	struct ave_dev *ave = kunit_kzalloc(test, sizeof(*ave), GFP_KERNEL);
+	struct ave_ctx *ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	struct ave_session *sess =
+		kunit_kzalloc(test, sizeof(*sess), GFP_KERNEL);
+	u8 cmd[0x70], before[0x70];
+
+	KUNIT_ASSERT_NOT_NULL(test, ave);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	KUNIT_ASSERT_NOT_NULL(test, sess);
+	ave->layout = &ave_layout_6070_11_1;
+	ctx->ave = ave;
+	ctx->sess = sess;
+	sess->p.codec = AVE_CODEC_H264;
+	memset(cmd, 0xa5, sizeof(cmd));
+	memcpy(before, cmd, sizeof(cmd));
+	KUNIT_EXPECT_PTR_EQ(test, ave_layout_for_crc(0x460c7a7c),
+			    &ave_layout_6070_11_1);
+	KUNIT_EXPECT_PTR_EQ(test, ave_layout_for_crc(0x25bfd039),
+			    &ave_layout_6070_11_1);
+	KUNIT_EXPECT_PTR_EQ(test, ave_layout_for_crc(0), NULL);
+	KUNIT_EXPECT_EQ(test, ave_build_start(ctx, cmd, sizeof(cmd)),
+			-EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(
+		test, ave_build_process(ctx, cmd, sizeof(cmd), 0, 0, 0, false),
+		-EOPNOTSUPP);
+	KUNIT_EXPECT_MEMEQ(test, cmd, before, sizeof(cmd));
+	KUNIT_EXPECT_EQ(test, sess->token, 0ULL);
+}
+
+static void ave_6070_channels(struct kunit *test)
+{
+	const struct ave_fw_transport *t = ave_abi_6070.transport;
+	struct ave_dev *ave = kunit_kzalloc(test, sizeof(*ave), GFP_KERNEL);
+	u32 hello[4] = { 7, 0x9bc0, 0x100, 0 };
+	u8 *desc;
+
+	KUNIT_ASSERT_NOT_NULL(test, ave);
+	ave->layout = &ave_layout_6070_11_1;
+	ave->ipc.cpu = kunit_kzalloc(test, SZ_64K, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, ave->ipc.cpu);
+	ave->ipc.size = t->ipc_bytes;
+	ave->ipc_fw_base = 0x100000000ULL;
+	ave->channel_bytes = hello[1];
+	KUNIT_EXPECT_EQ(test, ave_ipc_check_hello(t, hello), 0);
+	for (unsigned int word = 0; word < 4; word++) {
+		hello[word]++;
+		KUNIT_EXPECT_EQ(test, ave_ipc_check_hello(t, hello), -EPROTO);
+		hello[word]--;
+	}
+	for (unsigned int i = 0; i < 7; i++) {
+		int id = i == 1 ? 0 : 1;
+		bool io = i == 1 || i == 5;
+		u64 address = ave->ipc_fw_base + AVE_IPC_CHANNEL_OFF +
+			      (io ? t->offsets[id] : 0x1000 + i * 0x400);
+
+		desc = ave->ipc.cpu + AVE_IPC_CHANNEL_OFF + i * 0x100;
+		strscpy(desc, io ? (id ? "IO_T2H" : "IO") : "UNUSED", 0x40);
+		put_unaligned_le32(io ? id : U32_MAX, desc + 0x40);
+		put_unaligned_le32(io ? t->doorbells[id] : U32_MAX,
+				   desc + 0x44);
+		put_unaligned_le32(io ? t->slots[id] : 4, desc + 0x48);
+		put_unaligned_le64(address, desc + 0x4c);
+	}
+	KUNIT_ASSERT_EQ(test, ave_ipc_parse_channels(ave), 0);
+	KUNIT_EXPECT_EQ(test, ave->ring[0].slots, 32U);
+	KUNIT_EXPECT_EQ(test, ave->ring[1].slots, 8U);
+	KUNIT_EXPECT_EQ(test, ave->ring[0].doorbell, 1U);
+	KUNIT_EXPECT_EQ(test, ave->ring[1].doorbell, 3U);
+	desc = ave->ipc.cpu + AVE_IPC_CHANNEL_OFF + 0x100;
+	put_unaligned_le32(33, desc + 0x48);
+	KUNIT_EXPECT_EQ(test, ave_ipc_parse_channels(ave), -EPROTO);
+	put_unaligned_le32(32, desc + 0x48);
+	desc = ave->ipc.cpu + AVE_IPC_CHANNEL_OFF;
+	put_unaligned_le64(ave->ipc_fw_base + ave->ipc.size, desc + 0x4c);
+	KUNIT_EXPECT_EQ(test, ave_ipc_parse_channels(ave), -EPROTO);
+}
+
+static void ave_6070_variants(struct kunit *test)
+{
+	const struct ave_fw_transport *t = ave_abi_6070.transport;
+
+	KUNIT_EXPECT_EQ(test, ave_t6000.boot_device_id, 11U);
+	KUNIT_EXPECT_EQ(test, ave_t6000.device_type, 9U);
+	KUNIT_EXPECT_EQ(test, ave_t6000.boot_arg_value, 0x400U);
+	KUNIT_EXPECT_EQ(test, ave_t6000.timebase_multiplier, 1000000U);
+	KUNIT_EXPECT_EQ(test, ave_t6000.text_crc, 0x460c7a7cU);
+	KUNIT_EXPECT_EQ(test, ave_t8112.boot_device_id, 15U);
+	KUNIT_EXPECT_EQ(test, ave_t8112.device_type, 13U);
+	KUNIT_EXPECT_EQ(test, ave_t8112.boot_arg_value, 0x10000U);
+	KUNIT_EXPECT_EQ(test, ave_t8112.timebase_multiplier, 1U);
+	KUNIT_EXPECT_EQ(test, ave_t8112.text_crc, 0x25bfd039U);
+	KUNIT_EXPECT_EQ(test, ave_fw_vcbar(&ave_t6000, 0x10000b28000ULL),
+			0x0102000000b28000ULL);
+	KUNIT_EXPECT_EQ(test, ave_fw_vcbar(&ave_t8112, 0x800000000ULL),
+			0x0102000800000000ULL);
+	KUNIT_EXPECT_EQ(test, ave_t6000.regs->ctrl, 0x400044U);
+	KUNIT_EXPECT_EQ(test, ave_t8112.regs->timebase, 0x178000U);
+	KUNIT_EXPECT_GE(test, t->command_bytes, 0x32dc8U);
+	KUNIT_EXPECT_LE(test, t->command_offset + t->command_bytes,
+			t->scalar_offset);
+	KUNIT_EXPECT_LE(test,
+			t->scalar_offset +
+				AVE_IPC_SCALAR_BUFS * AVE_IPC_SCALAR_BYTES,
+			t->process_offset);
+	KUNIT_EXPECT_LE(
+		test, t->process_offset + AVE_IPC_PROC_BUFS * t->process_bytes,
+		t->ipc_bytes);
+}
+
+static struct kunit_case ave_abi_cases[] = {
+	KUNIT_CASE(ave_9003_byte_equality), KUNIT_CASE(ave_9003_hevc_main10),
+	KUNIT_CASE(ave_6070_images),
+	KUNIT_CASE(ave_6070_replies),	    KUNIT_CASE(ave_6070_split_surfaces),
+	KUNIT_CASE(ave_6070_gate),	    KUNIT_CASE(ave_6070_channels),
+	KUNIT_CASE(ave_6070_variants),	    {}
+};
+
+static struct kunit_suite ave_abi_suite = {
+	.name = "apple-ave-abi",
+	.test_cases = ave_abi_cases,
+};
+kunit_test_suite(ave_abi_suite);
+
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/apple/ave/ave-abi.c b/drivers/media/platform/apple/ave/ave-abi.c
new file mode 100644
index 0000000000..5aca710f0e
--- /dev/null
+++ b/drivers/media/platform/apple/ave/ave-abi.c
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Firmware command envelopes and transport descriptions. */
+#include <linux/errno.h>
+#include <linux/limits.h>
+#include <linux/unaligned.h>
+
+#include "ave.h"
+#include "ave-regs.h"
+
+static const struct ave_fw_transport ave_transport_9003 = {
+	.ipc_bytes = AVE_IPC_BYTES,
+	.command_offset = AVE_IPC_CMD_OFF,
+	.command_bytes = AVE_IPC_CMD_BYTES,
+	.scalar_offset = AVE_IPC_SCALAR_OFF,
+	.process_offset = AVE_IPC_PROC_OFF,
+	.process_bytes = AVE_IPC_PROC_BYTES,
+	.hello = { 2, 0, 0x100, 0 },
+	.descriptors = 2,
+	.io_index = 0,
+	.t2h_index = 1,
+	.boot_config = true,
+	.sync_host_clock = true,
+};
+
+static const struct ave_fw_transport ave_transport_6070 = {
+	.ipc_bytes = 0x700000,
+	.command_offset = 0x40000,
+	.command_bytes = 0x34000,
+	.scalar_offset = 0x74000,
+	.process_offset = 0x78000,
+	.process_bytes = 0x10000,
+	.hello = { 7, 0x9bc0, 0x100, 0 },
+	.descriptors = 7,
+	.io_index = 1,
+	.t2h_index = 5,
+	.slots = { 32, 8 },
+	.doorbells = { 1, 3 },
+	.offsets = { 0x8700, 0x9180 },
+	.scratch_halt = true,
+};
+
+static void ave_header_9003(u8 *cmd, const struct ave_fw_abi *abi,
+			    const struct ave_command *h)
+{
+	put_unaligned_le32(abi->wire_id[h->codec - 1][h->op], cmd);
+	put_unaligned_le64(h->token, cmd + 0x08);
+	put_unaligned_le64(h->client, cmd + 0x10);
+	if (h->op != AVE_OP_CONFIG && h->op != AVE_OP_HALT) {
+		put_unaligned_le32(1, cmd + 0x18);
+		put_unaligned_le32(h->codec, cmd + 0x1c);
+		put_unaligned_le32(h->arg0, cmd + 0x24);
+		put_unaligned_le32(0x36, cmd + 0x28);
+		put_unaligned_le32(h->arg2, cmd + 0x2c);
+	}
+	put_unaligned_le32(h->subtype, cmd + 0x20);
+}
+
+static void ave_header_6070(u8 *cmd, const struct ave_fw_abi *abi,
+			    const struct ave_command *h)
+{
+	bool global = h->op == AVE_OP_CONFIG || h->op == AVE_OP_HALT;
+
+	put_unaligned_le16(abi->wire_id[h->codec - 1][h->op], cmd);
+	put_unaligned_le64(h->token, cmd + 0x08);
+	if (!global) {
+		put_unaligned_le32(h->client, cmd + 0x10);
+		put_unaligned_le32(h->codec - 1, cmd + 0x18);
+	}
+	put_unaligned_le32(h->op == AVE_OP_PROCESS ? h->subtype :
+						     abi->semantic[h->op],
+			   cmd + 0x1c);
+	put_unaligned_le32(global ? 0 : 0xc8, cmd + 0x20);
+}
+
+static void ave_config_9003(struct ave_dev *ave, u8 *cmd)
+{
+	ave_write_global(ave, cmd, AVE_OP_CONFIG);
+	cmd[0x49] = 1;
+	cmd[0x4a] = 1;
+	put_unaligned_le32(ave->layout->mcc_dsid, cmd + 0x60);
+}
+
+static void ave_config_6070(struct ave_dev *ave, u8 *cmd)
+{
+	ave_write_global(ave, cmd, AVE_OP_CONFIG);
+	cmd[0x41] = 1;
+	put_unaligned_le64(ave->extra0_dma, cmd + 0x48);
+	/* No MCC, host heap, shared area or optional firmware log. */
+}
+
+static int ave_reply_9003(const struct ave_fw_abi *abi, const u8 *msg, u32 len,
+			  struct ave_reply *reply)
+{
+	u32 id;
+
+	if (len < 0x48)
+		return -EPROTO;
+	id = get_unaligned_le16(msg);
+	reply->op = id < AVE_OP_COUNT ? id : 0;
+	reply->client = get_unaligned_le64(msg + 0x10);
+	reply->subtype = get_unaligned_le32(msg + 0x20);
+	reply->raw_status = get_unaligned_le32(msg + 0x40);
+	reply->status = reply->raw_status;
+	reply->bytes = len;
+	return 0;
+}
+
+static int ave_reply_6070(const struct ave_fw_abi *abi, const u8 *msg, u32 len,
+			  struct ave_reply *reply)
+{
+	u32 id;
+
+	if (len < 0x40)
+		return -EPROTO;
+	id = get_unaligned_le16(msg);
+	for (unsigned int op = 1; op < AVE_OP_COUNT; op++) {
+		if (!abi->reply_id[op] || abi->reply_id[op] != id)
+			continue;
+		if (len != (op == AVE_OP_PROCESS ? 0x48 : 0x40))
+			return -EPROTO;
+		reply->op = op;
+		reply->client = get_unaligned_le32(msg + 0x10);
+		reply->subtype = get_unaligned_le32(msg + 0x1c);
+		reply->raw_status = get_unaligned_le32(msg + 0x38);
+		reply->status = reply->raw_status;
+		reply->bytes = len;
+		if (reply->status == 0x00ee0000)
+			reply->status = 0;
+		else if (!reply->status)
+			reply->status = U32_MAX;
+		return 0;
+	}
+	return -EPROTO;
+}
+
+#define AVE_9003_IDS                                                      \
+	{ [AVE_OP_CONFIG] = 1,	[AVE_OP_HALT] = 2,     [AVE_OP_OPEN] = 3, \
+	  [AVE_OP_CLOSE] = 4,	[AVE_OP_START] = 6,    [AVE_OP_STOP] = 7, \
+	  [AVE_OP_PROCESS] = 8, [AVE_OP_COMPLETE] = 9, [AVE_OP_PRIORITY] = 10 }
+
+const struct ave_fw_abi ave_abi_9003 = {
+	.transport = &ave_transport_9003,
+	.wire_id = { AVE_9003_IDS, AVE_9003_IDS },
+	.reply_id = AVE_9003_IDS,
+	.scalar_bytes = {
+		[AVE_OP_CONFIG] = 0x78,
+		[AVE_OP_HALT] = 0x48,
+		[AVE_OP_OPEN] = 0x48,
+		[AVE_OP_CLOSE] = 0x48,
+		[AVE_OP_STOP] = 0x48,
+		[AVE_OP_COMPLETE] = 0x48,
+		[AVE_OP_PRIORITY] = 0x48,
+	},
+	.header_bytes = 0x48,
+	.timeout_offset = 0x30,
+	.created_offset = 0x38,
+	.padded_surfaces = true,
+	.write_header = ave_header_9003,
+	.write_config = ave_config_9003,
+	.parse_reply = ave_reply_9003,
+};
+
+#define AVE_6070_IDS(start, process)                            \
+	{ [AVE_OP_CONFIG] = 1,	  [AVE_OP_OPEN] = 2,            \
+	  [AVE_OP_RESET] = 3,	  [AVE_OP_START] = (start),     \
+	  [AVE_OP_STOP] = 6,	  [AVE_OP_PROCESS] = (process), \
+	  [AVE_OP_FLUSH] = 11,	  [AVE_OP_CLOSE] = 12,          \
+	  [AVE_OP_COMPLETE] = 13, [AVE_OP_HALT] = 14 }
+
+const struct ave_fw_abi ave_abi_6070 = {
+	.transport = &ave_transport_6070,
+	.wire_id = { AVE_6070_IDS(4, 7), AVE_6070_IDS(5, 8) },
+	.reply_id = {
+		[AVE_OP_CONFIG] = 0xe01,
+		[AVE_OP_OPEN] = 0xe02,
+		[AVE_OP_RESET] = 0xe03,
+		[AVE_OP_START] = 0xe04,
+		[AVE_OP_STOP] = 0xe05,
+		[AVE_OP_PROCESS] = 0xe06,
+		[AVE_OP_FLUSH] = 0xe09,
+		[AVE_OP_CLOSE] = 0xe0a,
+		[AVE_OP_COMPLETE] = 0xe0b,
+	},
+	.scalar_bytes = {
+		[AVE_OP_CONFIG] = 0x70,
+		[AVE_OP_OPEN] = 0x40,
+		[AVE_OP_STOP] = 0x40,
+		[AVE_OP_FLUSH] = 0x40,
+		[AVE_OP_CLOSE] = 0x48,
+		[AVE_OP_COMPLETE] = 0x40,
+		[AVE_OP_HALT] = 0x40,
+	},
+	.semantic = {
+		[AVE_OP_CONFIG] = U32_MAX,
+		[AVE_OP_OPEN] = 3,
+		[AVE_OP_RESET] = 11,
+		[AVE_OP_START] = 6,
+		[AVE_OP_STOP] = 7,
+		[AVE_OP_FLUSH] = 10,
+		[AVE_OP_CLOSE] = 4,
+		[AVE_OP_COMPLETE] = 9,
+		[AVE_OP_HALT] = U32_MAX,
+	},
+	.header_bytes = 0x40,
+	.timeout_offset = 0x28,
+	.created_offset = 0x30,
+	.write_header = ave_header_6070,
+	.write_config = ave_config_6070,
+	.parse_reply = ave_reply_6070,
+};
diff --git a/drivers/media/platform/apple/ave/ave-cmd.c b/drivers/media/platform/apple/ave/ave-cmd.c
new file mode 100644
index 0000000000..a7fb9672a1
--- /dev/null
+++ b/drivers/media/platform/apple/ave/ave-cmd.c
@@ -0,0 +1,216 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple AVE video encoder: firmware commands
+ *
+ * Start and Process are large command images. Each is built in a zeroed
+ * buffer: the header, the constant words (ave-image.c), then every field
+ * that depends on the session or the frame.
+ *
+ * Copyright The Aurora Silicon Contributors
+ */
+#include <linux/device.h>
+#include <linux/math64.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include <media/videobuf2-v4l2.h>
+
+#include "ave.h"
+#include "ave-regs.h"
+
+/* Firmware-wide configuration, sent once after every firmware boot. */
+int ave_cmd_config(struct ave_dev *ave)
+{
+	int buf = ave_ipc_scalar_buf(ave);
+	u8 *cmd;
+	int ret;
+
+	if (buf < 0)
+		return buf;
+	cmd = ave_ipc_cmd(ave, buf,
+			  ave->layout->abi->scalar_bytes[AVE_OP_CONFIG]);
+	if (!cmd)
+		return -EBUSY;
+	ave->layout->abi->write_config(ave, cmd);
+	ret = ave_ipc_submit(ave, buf,
+			     ave->layout->abi->scalar_bytes[AVE_OP_CONFIG],
+			     AVE_CMD_GLOBAL_TIMEOUT_US, true);
+	return ret ?: ave_ipc_settle(ave, AVE_CMD_WAIT_MS);
+}
+
+/*
+ * Firmware-wide stop, sent after every session has closed. The firmware
+ * neither acknowledges nor answers it.
+ */
+int ave_cmd_halt(struct ave_dev *ave)
+{
+	int buf = ave_ipc_scalar_buf(ave);
+	u8 *cmd;
+
+	if (buf < 0)
+		return buf;
+	cmd = ave_ipc_cmd(ave, buf, ave->layout->abi->header_bytes);
+	if (!cmd)
+		return -EBUSY;
+	ave_write_global(ave, cmd, AVE_OP_HALT);
+	return ave_ipc_submit(ave, buf, ave->layout->abi->header_bytes,
+			      AVE_CMD_GLOBAL_TIMEOUT_US, false);
+}
+
+static int ave_cmd_scalar(struct ave_ctx *ctx, enum ave_opcode op, u32 arg0,
+			  u32 arg2)
+{
+	struct ave_dev *ave = ctx->ave;
+	int buf = ave_ipc_scalar_buf(ave);
+	u8 *cmd;
+
+	if (buf < 0)
+		return buf;
+	if (!ave->layout->abi->scalar_bytes[op])
+		return -EOPNOTSUPP;
+	cmd = ave_ipc_cmd(ave, buf, ave->layout->abi->scalar_bytes[op]);
+	if (!cmd)
+		return -EBUSY;
+	ave_write_header(ctx, cmd, op, op, arg0, arg2);
+	return ave_ipc_submit(ave, buf, ave->layout->abi->scalar_bytes[op],
+			      ave->layout->abi->transport->boot_config ?
+				      AVE_CMD_SESSION_TIMEOUT_US :
+				      AVE_CMD_GLOBAL_TIMEOUT_US,
+			      true);
+}
+
+int ave_cmd_open(struct ave_ctx *ctx)
+{
+	struct ave_dev *ave = ctx->ave;
+	int ret;
+
+	ave->next_client += AVE_CLIENT_STEP;
+	ctx->sess->client = ave->next_client;
+	ctx->sess->token = AVE_TOKEN_BASE;
+	ret = ave_cmd_scalar(ctx, AVE_OP_OPEN, AVE_SESSION_ARG0,
+			     ave_session_setup_arg2(ctx));
+	if (ave->layout->abi->transport->boot_config) {
+		if (!ret)
+			ctx->sess->fw_open = true;
+		return ret ?: ave_ipc_settle(ave, AVE_CMD_WAIT_MS);
+	}
+	ret = ret ?: ave_ipc_settle(ave, AVE_CMD_WAIT_MS);
+	if (!ret)
+		ctx->sess->fw_open = true;
+	return ret;
+}
+
+/* Drain barrier: answered once every Process sent before it is answered. */
+int ave_cmd_complete(struct ave_ctx *ctx, unsigned int count)
+{
+	int ret = 0;
+
+	for (unsigned int i = 0; i < count && !ret; i++)
+		ret = ave_cmd_scalar(ctx, AVE_OP_COMPLETE, 0, ave_session_arg2(ctx));
+	return ret;
+}
+
+/* Priority and Stop go out together, Close after Stop is answered. */
+int ave_cmd_close(struct ave_ctx *ctx)
+{
+	u32 arg2 = ave_session_arg2(ctx);
+	bool legacy = ctx->ave->layout->abi->transport->boot_config;
+	int ret = 0, err;
+
+	if (legacy)
+		ret = ave_cmd_scalar(ctx, AVE_OP_PRIORITY, AVE_SESSION_ARG0,
+				     arg2);
+	if (!ret && (legacy || ctx->sess->handed))
+		ret = ave_cmd_scalar(ctx, AVE_OP_STOP, AVE_SESSION_ARG0, arg2);
+	err = ave_ipc_settle(ctx->ave, AVE_CMD_WAIT_MS);
+	ret = ret ?: err;
+	if (ctx->ave->fw_state != AVE_FW_RUNNING)
+		return ret;
+	/* A failed 6070 Stop cannot establish a safe Close/Halt boundary. */
+	if (ret && !legacy)
+		return ret;
+	err = ave_cmd_scalar(ctx, AVE_OP_CLOSE, AVE_SESSION_ARG0, arg2);
+	if (!err)
+		err = ave_ipc_settle(ctx->ave, AVE_CMD_WAIT_MS);
+	if (legacy || !err)
+		ctx->sess->fw_open = false;
+	return ret ?: err;
+}
+
+int ave_cmd_start(struct ave_ctx *ctx)
+{
+	struct ave_dev *ave = ctx->ave;
+	struct ave_session *sess = ctx->sess;
+	const struct ave_params *p = &sess->p;
+	const struct ave_fw_layout *fw = ave->layout;
+	size_t len = fw->bytes[p->codec - 1][AVE_IMAGE_START];
+	u8 *cmd;
+	int ret;
+
+	if (!fw->encode_ready)
+		return -EOPNOTSUPP;
+	cmd = ave_ipc_cmd(ave, AVE_BUF_CMD, len);
+	if (!cmd)
+		return -EBUSY;
+	ret = ave_build_start(ctx, cmd, len);
+	if (ret)
+		return ret;
+	ave_debugfs_save(ave, p->codec, AVE_IMAGE_START, cmd, len);
+
+	/* A failed submission may already have exposed the Start buffers. */
+	sess->handed = true;
+	ret = ave_ipc_submit(ave, AVE_BUF_CMD, len, AVE_CMD_SESSION_TIMEOUT_US,
+			     true);
+	if (ret)
+		return ret;
+	return ave_ipc_settle(ave, AVE_START_WAIT_MS);
+}
+
+int ave_cmd_process(struct ave_ctx *ctx, unsigned int slot,
+		    struct vb2_v4l2_buffer *src, dma_addr_t input, u32 bitrate,
+		    bool force_key)
+{
+	struct ave_dev *ave = ctx->ave;
+	struct ave_session *sess = ctx->sess;
+	const struct ave_params *p = &sess->p;
+	const struct ave_fw_layout *fw = ave->layout;
+	size_t len = fw->bytes[p->codec - 1][AVE_IMAGE_PROCESS];
+	struct ave_slot *s;
+	unsigned int buf = AVE_BUF_PROC(sess->index * AVE_MAX_SLOTS + slot);
+	u8 *cmd;
+	int ret;
+
+	if (!fw->encode_ready)
+		return -EOPNOTSUPP;
+
+	if (slot >= p->slots || p->slots > fw->max_slots)
+		return -EINVAL;
+	s = &sess->slot[slot];
+	ret = ave_ipc_wait_ack(ave, buf);
+	if (ret)
+		return ret;
+	cmd = ave_ipc_cmd(ave, buf, len);
+	if (!cmd)
+		return -EBUSY;
+	ret = ave_build_process(ctx, cmd, len, slot, input, bitrate, force_key);
+	if (ret)
+		return ret;
+	if (!sess->frames)
+		ave_debugfs_save(ave, p->codec, AVE_IMAGE_PROCESS, cmd, len);
+
+	/* Pin before publishing the command, including an uncertain send failure. */
+	s->input_mem = ave_vb2_get(&src->vb2_buf);
+	ret = ave_ipc_submit(ave, buf, len, fw->process_timeout_us, false);
+	if (ret)
+		return ret;
+	s->src = src;
+	s->busy = true;
+	s->status = 0;
+	sess->progress = jiffies;
+	sess->last_sent = jiffies;
+	sess->nudged = false;
+	sess->busy++;
+	sess->frames++;
+	return 0;
+}
diff --git a/drivers/media/platform/apple/ave/ave-drv.c b/drivers/media/platform/apple/ave/ave-drv.c
new file mode 100644
index 0000000000..c145e29538
--- /dev/null
+++ b/drivers/media/platform/apple/ave/ave-drv.c
@@ -0,0 +1,414 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple AVE video encoder
+ *
+ * The AVE block runs an encoder firmware on its own coprocessor, which the
+ * bootloader loads but does not start. This driver starts it on first use,
+ * talks to it over two shared-memory rings and exposes it as a V4L2
+ * stateful encoder.
+ *
+ * Copyright The Aurora Silicon Contributors
+ */
+#include <linux/debugfs.h>
+#include <linux/dma-mapping.h>
+#include <linux/fs.h>
+#include <linux/limits.h>
+#include <linux/iommu.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+
+#include "ave.h"
+#include "ave-regs.h"
+
+#define AVE_AUTOSUSPEND_MS 2000
+
+static const struct ave_coproc_regs ave_coproc_v40 = {
+	.vcbar = AVE_COPROC_VCBAR,
+	.timebase_freq = AVE_COPROC_TIMEBASE_FREQ,
+	.timebase = AVE_COPROC_TIMEBASE,
+	.ctrl = AVE_COPROC_CTRL,
+	.status = AVE_COPROC_STATUS,
+	.boot_arg = AVE_COPROC_BOOT_ARG,
+	.keep_mappings = AVE_COPROC_KEEP_MAPPINGS,
+};
+
+/* Panda/Castor register family used by 6070.11.1. */
+static const struct ave_coproc_regs ave_coproc_6070 = {
+	.vcbar = 0x50000,
+	.timebase_freq = 0x160020,
+	.timebase = 0x178000,
+	.ctrl = 0x400044,
+	.status = 0x400048,
+	.boot_arg = 0x400400,
+	.keep_mappings = 0x400808,
+};
+
+const struct ave_variant ave_t6000 = {
+	.regs = &ave_coproc_6070,
+	.fw_text_size = 0xd0000,
+	.fw_data_size = 0x128000,
+	.boot_device_id = 11,
+	.device_type = 9,
+	.lfs_ref_scale = 1,
+	.text_crc = 0x460c7a7c,
+	.boot_arg_value = 0x400,
+	.timebase_multiplier = 1000000,
+	.vcbar_mask = 0x0000000ffffff800ULL,
+	.vcbar_flags = 0x0102000000000000ULL,
+
+	.extra0_size = 0x24,
+	.boot_qualified = true,
+};
+
+const struct ave_variant ave_t8112 = {
+	.regs = &ave_coproc_6070,
+	.fw_text_size = 0xd0000,
+	.fw_data_size = 0x128000,
+	.boot_device_id = 15,
+	.device_type = 13,
+	.lfs_ref_scale = 1,
+	.text_crc = 0x25bfd039,
+	.boot_arg_value = 0x10000,
+	.timebase_multiplier = 1,
+	.vcbar_mask = 0x000003fffffff800ULL,
+	.vcbar_flags = 0x0102000000000000ULL,
+
+	.extra0_size = 0x4000,
+	.boot_qualified = true,
+};
+
+/*
+ * The M4 Pro (T6040 in the ADT, apple,t6041 in the DT) starts its encoder
+ * like the A18 Pro: same coprocessor registers and boot sequence, its own
+ * device ID and type.
+ */
+static const struct ave_variant ave_t6041 = {
+	.regs = &ave_coproc_v40,
+	.fw_text_size = 0x14c000,
+	.fw_data_size = 0x12c000,
+	.boot_device_id = 27,
+	.boot_arg_value = AVE_COPROC_BOOT_ARG_VALUE,
+	.timebase_multiplier = 1,
+	.vcbar_mask = U64_MAX,
+	.vcbar_flags = AVE_COPROC_VCBAR_VALID,
+	.device_type = 25,
+	.lfs_ref_scale = 2,
+	.boot_qualified = true,
+};
+
+static const struct ave_variant ave_t8140 = {
+	.regs = &ave_coproc_v40,
+	.fw_text_size = 0x14c000,
+	.fw_data_size = 0x130000,
+	.boot_device_id = 29,
+	.boot_arg_value = AVE_COPROC_BOOT_ARG_VALUE,
+	.timebase_multiplier = 1,
+	.vcbar_mask = U64_MAX,
+	.vcbar_flags = AVE_COPROC_VCBAR_VALID,
+	.device_type = 27,
+	.lfs_ref_scale = 2,
+	.boot_qualified = true,
+};
+
+/*
+ * debugfs: apple-ave/last_start_{h264,hevc} hold the last Start built and
+ * last_process0_{h264,hevc} the first Process of the last session, so the
+ * generated commands can be compared with reference captures.
+ */
+void ave_debugfs_save(struct ave_dev *ave, enum ave_codec codec,
+		      enum ave_image kind, const void *cmd, size_t len)
+{
+	void *dst = ave->dump[codec - 1][kind];
+
+	if (ave->layout && dst && len == ave->layout->bytes[codec - 1][kind])
+		memcpy(dst, cmd, len);
+}
+
+static ssize_t ave_lifecycle_write(struct file *file, const char __user *user,
+				   size_t count, loff_t *ppos)
+{
+	struct ave_dev *ave = file->private_data;
+	unsigned int codec;
+	int ret = kstrtouint_from_user(user, count, 0, &codec);
+
+	if (ret)
+		return ret;
+	if (codec != AVE_CODEC_H264 && codec != AVE_CODEC_HEVC)
+		return -EINVAL;
+	ret = ave_fw_lifecycle_test(ave, codec);
+	return ret ?: count;
+}
+
+static const struct file_operations ave_lifecycle_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = ave_lifecycle_write,
+};
+
+/* Root-only software timeout injection; does not send malformed firmware commands. */
+static int ave_inject_wedge(void *data, u64 value)
+{
+	struct ave_dev *ave = data;
+	int ret = 0;
+
+	if (value != 1)
+		return -EINVAL;
+	mutex_lock(&ave->hw_lock);
+	if (ave->fw_state != AVE_FW_RUNNING) {
+		ret = -EBUSY;
+	} else {
+		ave->inject_wedge = true;
+		ave_fw_mark_broken(ave, -ETIMEDOUT, "debugfs injection");
+	}
+	mutex_unlock(&ave->hw_lock);
+	return ret;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(ave_inject_wedge_fops, NULL, ave_inject_wedge, "%llu\n");
+
+static void ave_debugfs_init(struct ave_dev *ave)
+{
+	static const char *const names[2][AVE_IMAGE_COUNT] = {
+		{ "last_start_h264", "last_process0_h264" },
+		{ "last_start_hevc", "last_process0_hevc" },
+	};
+
+	if (!IS_ENABLED(CONFIG_DEBUG_FS) || !ave->layout)
+		return;
+	ave->debugfs = debugfs_create_dir("apple-ave", NULL);
+	if (ave->layout->abi == &ave_abi_6070) {
+		debugfs_create_file("lifecycle_test", 0200, ave->debugfs, ave,
+				    &ave_lifecycle_fops);
+		return;
+	}
+	debugfs_create_file("inject_wedge", 0200, ave->debugfs, ave,
+			    &ave_inject_wedge_fops);
+	for (unsigned int c = 0; c < 2; c++)
+		for (unsigned int k = 0; k < AVE_IMAGE_COUNT; k++) {
+			struct debugfs_blob_wrapper *blob;
+			size_t size = ave->layout->bytes[c][k];
+
+			blob = devm_kzalloc(ave->dev, sizeof(*blob),
+					    GFP_KERNEL);
+			ave->dump[c][k] =
+				devm_kzalloc(ave->dev, size, GFP_KERNEL);
+			if (!blob || !ave->dump[c][k]) {
+				ave->dump[c][k] = NULL;
+				continue;
+			}
+			blob->data = ave->dump[c][k];
+			blob->size = ave->layout->bytes[c][k];
+			debugfs_create_blob(names[c][k], 0400, ave->debugfs,
+					    blob);
+		}
+}
+
+/*
+ * The encoder pipes, the DMA block and the motion engines, then optionally
+ * "perf": a performance floor the encoder needs to run at full speed, such
+ * as the SoC rail floor on the M4 Pro. It is held while the encoder is
+ * powered, like the other domains, so it ends with the last session.
+ */
+static const char *const ave_pd_names[] = { "dma", "pipe4", "pipe5", "me0",
+					    "me1", "perf" };
+
+static int ave_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	bool perf = of_property_match_string(dev->of_node, "power-domain-names",
+					     "perf") >= 0;
+	const struct dev_pm_domain_attach_data pd_data = {
+		.pd_names = ave_pd_names,
+		.num_pd_names = ARRAY_SIZE(ave_pd_names) - !perf,
+		.pd_flags = PD_FLAG_DEV_LINK_ON,
+	};
+	struct ave_dev *ave;
+	int ret;
+
+	ave = devm_kzalloc(dev, sizeof(*ave), GFP_KERNEL);
+	if (!ave)
+		return -ENOMEM;
+	ave->dev = dev;
+	ave->variant = of_device_get_match_data(dev);
+	if (!ave->variant)
+		return -ENODEV;
+	mutex_init(&ave->hw_lock);
+	platform_set_drvdata(pdev, ave);
+
+	ave->codec = devm_platform_ioremap_resource_byname(pdev, "codec");
+	if (IS_ERR(ave->codec))
+		return PTR_ERR(ave->codec);
+	ave->mbox = devm_platform_ioremap_resource_byname(pdev, "mailbox");
+	if (IS_ERR(ave->mbox))
+		return PTR_ERR(ave->mbox);
+	ave->coproc = devm_platform_ioremap_resource_byname(pdev, "coproc");
+	if (IS_ERR(ave->coproc))
+		return PTR_ERR(ave->coproc);
+
+	ave->domain = iommu_get_domain_for_dev(dev);
+	if (!ave->domain || !(ave->domain->type & __IOMMU_DOMAIN_PAGING))
+		return dev_err_probe(dev, -ENODEV, "needs a translating IOMMU\n");
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(42));
+	if (ret)
+		return ret;
+
+	ret = devm_pm_domain_attach_list(dev, &pd_data, &ave->pd_list);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "cannot attach power domains\n");
+
+	ret = ave_fw_probe(ave);
+	if (ret)
+		return ret;
+
+	/*
+	 * Domain attachment took active supplier references, but the driver
+	 * starts firmware only on first use and begins suspended. Reconcile that
+	 * state before enabling runtime PM, otherwise those references survive
+	 * until the first session has resumed and suspended the encoder.
+	 */
+	ret = pm_runtime_set_suspended(dev);
+	if (ret)
+		goto err_fw;
+
+	pm_runtime_set_autosuspend_delay(dev, AVE_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(dev);
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		goto err_pm;
+
+	ret = ave_v4l2_register(ave);
+	if (ret)
+		goto err_pm;
+	ave_debugfs_init(ave);
+	return 0;
+
+err_pm:
+	pm_runtime_dont_use_autosuspend(dev);
+err_fw:
+	ave_fw_remove(ave);
+	return ret;
+}
+
+static void ave_remove(struct platform_device *pdev)
+{
+	struct ave_dev *ave = platform_get_drvdata(pdev);
+
+	debugfs_remove_recursive(ave->debugfs);
+	ave_v4l2_unregister(ave);
+
+	/*
+	 * The coprocessor memory can only go once the firmware never ran or
+	 * was reset by a power cycle. A halted coprocessor may keep power
+	 * (its domain is shared with the DARTs), so its memory stays.
+	 */
+	pm_runtime_dont_use_autosuspend(ave->dev);
+	mutex_lock(&ave->hw_lock);
+	if (ave->fw_state != AVE_FW_OFF) {
+		mutex_unlock(&ave->hw_lock);
+		dev_warn(ave->dev,
+			 "firmware was started, keeping its memory\n");
+		return;
+	}
+	mutex_unlock(&ave->hw_lock);
+	ave_fw_remove(ave);
+}
+
+static int ave_runtime_suspend(struct device *dev)
+{
+	struct ave_dev *ave = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&ave->hw_lock);
+	ret = ave_fw_runtime_suspend(ave);
+	if (!ret && ave->layout && ave->layout->abi->transport->scratch_halt)
+		ave_fw_release_boot(ave);
+	mutex_unlock(&ave->hw_lock);
+	return ret;
+}
+
+static int ave_runtime_resume(struct device *dev)
+{
+	struct ave_dev *ave = dev_get_drvdata(dev);
+
+	mutex_lock(&ave->hw_lock);
+	if (ave->layout && ave->layout->abi->transport->scratch_halt &&
+	    ave->fw_state == AVE_FW_HALTED)
+		ave_fw_lost(ave);
+	mutex_unlock(&ave->hw_lock);
+	return 0;
+}
+
+static int ave_suspend(struct device *dev)
+{
+	struct ave_dev *ave = dev_get_drvdata(dev);
+	int ret;
+
+	/* Let a running job finish; the m2m core holds back new ones. */
+	v4l2_m2m_suspend(ave->m2m_dev);
+
+	/*
+	 * The firmware does not survive the power going down. Drain and close
+	 * every open session and halt the firmware, as at the end of a stream;
+	 * each session reopens in a cold-started firmware on its next frame.
+	 */
+	mutex_lock(&ave->hw_lock);
+	ave_v4l2_suspend(ave);
+	ret = ave_fw_shutdown(ave);
+	if (!ret && ave->layout && ave->layout->abi->transport->scratch_halt)
+		ave_fw_release_boot(ave);
+	mutex_unlock(&ave->hw_lock);
+	if (ret) {
+		/*
+		 * genpd may gate the encoder and its DARTs after this callback.
+		 * A stuck firmware may still DMA, so abort before that happens.
+		 * PM does not resume a device whose suspend callback failed.
+		 */
+		dev_err(dev, "firmware cannot be stopped for sleep: %d\n", ret);
+		v4l2_m2m_resume(ave->m2m_dev);
+	}
+	return ret;
+}
+
+static int ave_resume(struct device *dev)
+{
+	struct ave_dev *ave = dev_get_drvdata(dev);
+
+	/* The next boot checks the coprocessor state itself. */
+	ave_runtime_resume(dev);
+	v4l2_m2m_resume(ave->m2m_dev);
+	return 0;
+}
+
+static const struct dev_pm_ops ave_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(ave_suspend, ave_resume)
+		RUNTIME_PM_OPS(ave_runtime_suspend, ave_runtime_resume, NULL)
+};
+
+static const struct of_device_id ave_of_match[] = {
+	{ .compatible = "apple,t6000-ave", .data = &ave_t6000 },
+	{ .compatible = "apple,t6041-ave", .data = &ave_t6041 },
+	{ .compatible = "apple,t8112-ave", .data = &ave_t8112 },
+	{ .compatible = "apple,t8140-ave", .data = &ave_t8140 },
+	{}
+};
+MODULE_DEVICE_TABLE(of, ave_of_match);
+
+static struct platform_driver ave_driver = {
+	.probe = ave_probe,
+	.remove = ave_remove,
+	.driver = {
+		.name = "apple-ave",
+		.of_match_table = ave_of_match,
+		.pm = pm_ptr(&ave_pm_ops),
+		/* A started coprocessor keeps its memory; do not unbind at will. */
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(ave_driver);
+
+MODULE_DESCRIPTION("Apple AVE video encoder");
+MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS("DMA_BUF");
diff --git a/drivers/media/platform/apple/ave/ave-fw.c b/drivers/media/platform/apple/ave/ave-fw.c
new file mode 100644
index 0000000000..4311e8874a
--- /dev/null
+++ b/drivers/media/platform/apple/ave/ave-fw.c
@@ -0,0 +1,822 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple AVE video encoder: firmware lifecycle
+ *
+ * The bootloader leaves the coprocessor firmware in two reserved, DART-mapped
+ * segments: TEXT and DATA. Running the firmware changes DATA, so the driver
+ * keeps a copy of DATA taken before the first boot and puts it back before
+ * every later boot. That lets the coprocessor lose power (runtime PM, system
+ * sleep) and start again from the same state as the first time.
+ *
+ * Copyright The Aurora Silicon Contributors
+ */
+#include <linux/crc32.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/iommu.h>
+#include <linux/iopoll.h>
+#include <linux/limits.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/sizes.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+
+#include "ave.h"
+#include "ave-regs.h"
+
+/*
+ * Legacy TEXT CRCs accepted at T8140 probe. Encoding separately requires
+ * a layout from ave_layout_for_crc(); command formats change between builds.
+ */
+static const u32 ave_known_text_crc[] = {
+	0x2ce7359e, /* AppleAVE2FW 9003.78.0 */
+	0x69c54454, /* AppleAVE2FW 9003.78.0 (macOS 26.0.x) */
+	AVE_FW_TEXT_CRC_T6040_25G83, /* AppleAVE2FW 9003.78.0 / T6040 */
+	0x460c7a7c, /* AppleAVE2FW 6070.11.1 / T6000 */
+	0x25bfd039, /* AppleAVE2FW 6070.11.1 / T8112 */
+};
+
+static int ave_fw_chosen_crc(struct ave_dev *ave, const char *name, u32 *crc)
+{
+	struct device_node *chosen = of_find_node_by_path("/chosen");
+	const char *str;
+	int ret;
+
+	if (!chosen)
+		return -ENOENT;
+	ret = of_property_read_string(chosen, name, &str);
+	of_node_put(chosen);
+	if (ret)
+		return ret;
+	return kstrtou32(str, 16, crc);
+}
+
+static int ave_fw_segment(struct ave_dev *ave, unsigned int index,
+			  struct ave_fw_segment *seg)
+{
+	struct device_node *np;
+	struct resource res;
+	const __be32 *prop;
+	int len, ret;
+
+	np = of_parse_phandle(ave->dev->of_node, "memory-region", index);
+	if (!np)
+		return -ENOENT;
+	if (!of_node_name_eq(np->parent, "reserved-memory") ||
+	    !of_device_is_compatible(np, "apple,asc-mem") ||
+	    !of_property_read_bool(np, "no-map")) {
+		ret = -EINVAL;
+		goto out;
+	}
+	ret = of_address_to_resource(np, 0, &res);
+	if (ret)
+		goto out;
+
+	/* iommu-addresses = <&ave iova-hi iova-lo size-hi size-lo> */
+	prop = of_get_property(np, "iommu-addresses", &len);
+	if (!prop || len != 5 * sizeof(u32) ||
+	    be32_to_cpup(prop) != ave->dev->of_node->phandle) {
+		ret = -EINVAL;
+		goto out;
+	}
+	seg->phys = res.start;
+	seg->size = resource_size(&res);
+	seg->iova = of_read_number(prop + 1, 2);
+	if (!seg->size || seg->phys > PHYS_ADDR_MAX - seg->size ||
+	    seg->iova > U64_MAX - seg->size ||
+	    of_read_number(prop + 3, 2) != seg->size ||
+	    !IS_ALIGNED(seg->phys, SZ_16K) || !IS_ALIGNED(seg->iova, SZ_16K))
+		ret = -EINVAL;
+out:
+	of_node_put(np);
+	return ret;
+}
+
+static int ave_fw_check_mapping(struct ave_dev *ave,
+				const struct ave_fw_segment *seg)
+{
+	for (size_t off = 0; off < seg->size; off += SZ_16K)
+		if (iommu_iova_to_phys(ave->domain, seg->iova + off) !=
+		    seg->phys + off)
+			return -EIO;
+	return 0;
+}
+
+static int ave_fw_crc(const struct ave_fw_segment *seg, u32 *crc, void *copy)
+{
+	void *va = memremap(seg->phys, seg->size, MEMREMAP_WB);
+
+	if (!va)
+		return -ENOMEM;
+	*crc = crc32_le(~0U, va, seg->size) ^ ~0U;
+	if (copy)
+		memcpy(copy, va, seg->size);
+	memunmap(va);
+	return 0;
+}
+
+/*
+ * Find the firmware, check that it is a build we speak to and that DATA is
+ * still as the bootloader left it, and keep a copy of DATA for restarts.
+ */
+int ave_fw_probe(struct ave_dev *ave)
+{
+	struct device *dev = ave->dev;
+	u32 text_crc, data_crc, want;
+	bool known = !ave->variant->boot_qualified;
+	int ret;
+
+	if (of_count_phandle_with_args(dev->of_node, "memory-region", NULL) !=
+	    2)
+		return dev_err_probe(dev, -ENODEV, "no preloaded firmware\n");
+
+	ret = ave_fw_segment(ave, 0, &ave->text);
+	if (!ret)
+		ret = ave_fw_segment(ave, 1, &ave->data);
+	if (ret)
+		return dev_err_probe(dev, ret, "bad firmware reservation\n");
+
+	if (ave->text.size != ave->variant->fw_text_size ||
+	    ave->data.size != ave->variant->fw_data_size)
+		return dev_err_probe(dev, -EINVAL,
+				     "unexpected firmware segment sizes\n");
+	if ((ave->text.phys < ave->data.phys + ave->data.size &&
+	     ave->data.phys < ave->text.phys + ave->text.size) ||
+	    (ave->text.iova < ave->data.iova + ave->data.size &&
+	     ave->data.iova < ave->text.iova + ave->text.size))
+		return dev_err_probe(dev, -EINVAL,
+				     "overlapping firmware segments\n");
+
+	if (ave_fw_check_mapping(ave, &ave->text) ||
+	    ave_fw_check_mapping(ave, &ave->data))
+		return dev_err_probe(
+			dev, -EIO,
+			"firmware is not mapped where it was loaded\n");
+
+	ret = ave_fw_crc(&ave->text, &text_crc, NULL);
+	if (ret)
+		return ret;
+	ret = ave_fw_chosen_crc(ave, "aurora,ave-text-crc32", &want);
+	if (ret || text_crc != want)
+		return dev_err_probe(dev, -ENODEV,
+				     "firmware text differs from loader CRC\n");
+	for (unsigned int i = 0; i < ARRAY_SIZE(ave_known_text_crc); i++)
+		known |= text_crc == ave_known_text_crc[i];
+	if (!known ||
+	    (ave->variant->text_crc && text_crc != ave->variant->text_crc))
+		return dev_err_probe(dev, -ENODEV,
+				     "unsupported firmware (text CRC %08x)\n",
+				     text_crc);
+	ave->text_crc = text_crc;
+	ave->layout = ave_layout_for_crc(text_crc);
+
+	ave->data_pristine = vmalloc(ave->data.size);
+	if (!ave->data_pristine)
+		return -ENOMEM;
+	ret = ave_fw_crc(&ave->data, &data_crc, ave->data_pristine);
+	if (ret)
+		goto free_data;
+
+	/*
+	 * The loader records the DATA checksum before anything runs. If it
+	 * differs, the firmware already ran and there is no clean copy left.
+	 */
+	ret = ave_fw_chosen_crc(ave, "aurora,ave-data-crc32", &want);
+	if (ret || data_crc != want) {
+		ret = dev_err_probe(dev, -ENODEV,
+				    "firmware data is not in its boot state\n");
+		goto free_data;
+	}
+
+	ave->data_crc = data_crc;
+	ave->fw_state = AVE_FW_OFF;
+	if (!ave->variant->boot_qualified || !ave->layout)
+		dev_info(
+			dev,
+			"probe only: firmware TEXT %08x DATA %08x needs qualification\n",
+			text_crc, data_crc);
+	else if (!ave->layout->encode_ready)
+		dev_info(
+			dev,
+			"%s: TEXT %08x pristine DATA %08x; encoding disabled\n",
+			ave->layout->name, text_crc, data_crc);
+	return 0;
+
+free_data:
+	vfree(ave->data_pristine);
+	ave->data_pristine = NULL;
+	return ret;
+}
+
+static int ave_fw_restore_data(struct ave_dev *ave)
+{
+	void *va;
+
+	if (!ave->data_dirty)
+		return 0;
+	va = memremap(ave->data.phys, ave->data.size, MEMREMAP_WC);
+	if (!va)
+		return -ENOMEM;
+	memcpy(va, ave->data_pristine, ave->data.size);
+	/* The restored image must be in memory before the coprocessor starts. */
+	wmb();
+	memunmap(va);
+	if (ave->layout && ave->layout->abi->transport->scratch_halt) {
+		u32 crc;
+		int ret = ave_fw_crc(&ave->data, &crc, NULL);
+
+		if (ret || crc != ave->data_crc)
+			return ret ?: -EIO;
+		dev_dbg(ave->dev, "restored DATA CRC %08x\n", ave->data_crc);
+	}
+	ave->data_dirty = false;
+	return 0;
+}
+
+void ave_free(struct ave_dev *ave, struct ave_buf *b)
+{
+	if (b->cpu)
+		dma_free_attrs(ave->dev, b->alloc, b->cpu, b->dma, b->attrs);
+	b->cpu = NULL;
+}
+
+/*
+ * Firmware-visible memory, zeroed and 16 KiB aligned in the encoder's DART.
+ * @size is what the firmware is told; @alloc (at least @size) is mapped.
+ */
+int ave_alloc_padded(struct ave_dev *ave, struct ave_buf *b, size_t size,
+		     size_t alloc, unsigned long attrs)
+{
+	if (b->cpu)
+		return 0;
+	b->size = size;
+	b->alloc = PAGE_ALIGN(max(size, alloc));
+	b->attrs = attrs;
+	b->cpu =
+		dma_alloc_attrs(ave->dev, b->alloc, &b->dma, GFP_KERNEL, attrs);
+	if (!b->cpu)
+		return -ENOMEM;
+	if (!IS_ALIGNED(b->dma, SZ_16K)) {
+		ave_free(ave, b);
+		return -EINVAL;
+	}
+	return 0;
+}
+
+int ave_alloc(struct ave_dev *ave, struct ave_buf *b, size_t size,
+	      unsigned long attrs)
+{
+	return ave_alloc_padded(ave, b, size, size, attrs);
+}
+
+/*
+ * Lifecycle support and streaming qualification are independent: a known
+ * transport is not enough to send unqualified Start/Process payloads.
+ */
+int ave_fw_check_boot(struct ave_dev *ave)
+{
+	if (ave->variant->boot_qualified && ave->variant->regs && ave->layout &&
+	    ave->layout == ave_layout_for_crc(ave->text_crc))
+		return 0;
+	return -EOPNOTSUPP;
+}
+
+int ave_fw_check_build(struct ave_dev *ave)
+{
+	if (!ave_fw_check_boot(ave) && ave->layout->encode_ready)
+		return 0;
+	dev_info(
+		ave->dev,
+		"encoding refused: firmware TEXT %08x DATA %08x has no qualified command payload\n",
+		ave->text_crc, ave->data_crc);
+	return -EOPNOTSUPP;
+}
+
+/* Only after confirmed Halt, or before the firmware was ever started. */
+void ave_fw_release_boot(struct ave_dev *ave)
+{
+	if (ave->extra0_mapped) {
+		dma_unmap_resource(ave->dev, ave->extra0_dma,
+				   ave->extra0_map_size, DMA_BIDIRECTIONAL, 0);
+		ave->extra0_mapped = false;
+	}
+	ave_free(ave, &ave->heap);
+	ave_free(ave, &ave->log);
+	ave_free(ave, &ave->boot_cfg);
+	ave_free(ave, &ave->ipc);
+	if (ave->module_pinned) {
+		ave->module_pinned = false;
+		module_put(THIS_MODULE);
+	}
+}
+
+static int ave_fw_map_extra0(struct ave_dev *ave)
+{
+	struct platform_device *pdev = to_platform_device(ave->dev);
+	struct resource *res;
+
+	if (!ave->variant->extra0_size || ave->extra0_mapped)
+		return 0;
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "extra0");
+	if (!res)
+		res = platform_get_resource(pdev, IORESOURCE_MEM, 3);
+	if (!res || resource_size(res) < ave->variant->extra0_size ||
+	    !IS_ALIGNED(res->start, SZ_16K))
+		return dev_err_probe(
+			ave->dev, -EINVAL,
+			"missing or invalid extra0 register resource\n");
+	/* The platform resource supplies the translated physical address. */
+	ave->extra0_map_size = ALIGN(ave->variant->extra0_size, SZ_16K);
+	ave->extra0_dma = dma_map_resource(ave->dev, res->start,
+					   ave->extra0_map_size,
+					   DMA_BIDIRECTIONAL, 0);
+	if (dma_mapping_error(ave->dev, ave->extra0_dma))
+		return -EIO;
+	ave->extra0_mapped = true;
+	return 0;
+}
+
+void ave_fw_remove(struct ave_dev *ave)
+{
+	ave_fw_release_boot(ave);
+	vfree(ave->data_pristine);
+	ave->data_pristine = NULL;
+}
+
+u64 ave_fw_vcbar(const struct ave_variant *variant, u64 text_iova)
+{
+	return (text_iova & variant->vcbar_mask) | variant->vcbar_flags;
+}
+
+static bool ave_fw_idle(struct ave_dev *ave)
+{
+	if (readq(ave->coproc + ave->variant->regs->vcbar) !=
+	    ave_fw_vcbar(ave->variant, ave->text.iova))
+		return false;
+	if (readl(ave->coproc + ave->variant->regs->ctrl) ||
+	    readl(ave->mbox + AVE_MBOX_STATUS))
+		return false;
+	for (unsigned int i = 0; i < AVE_MBOX_SCRATCH_COUNT; i++)
+		if (readl(ave->mbox + AVE_MBOX_SCRATCH(i)))
+			return false;
+	return true;
+}
+
+/*
+ * After a Halt the firmware is restarted from a power cycle, as macOS does
+ * for every session: the encoder must have been runtime suspended in
+ * between, which puts the coprocessor back in reset. Hardware runs showed
+ * that a restart while it kept power gets no answer, so that is refused
+ * (-EAGAIN) and the state stays halted until the power really went. The
+ * 9003 code base register must still be set: that ABI uses the loader value.
+ */
+static int ave_fw_prepare_restart(struct ave_dev *ave)
+{
+	u32 status;
+
+	if (!ave->layout->abi->transport->boot_config) {
+		if (ave->fw_state == AVE_FW_HALTED)
+			return -EAGAIN; /* A runtime PM suspend/resume must intervene. */
+		if (readl(ave->coproc + ave->variant->regs->ctrl))
+			return -EBUSY;
+		status = readl(ave->mbox + AVE_MBOX_STATUS);
+		if (status)
+			writel(status, ave->mbox + AVE_MBOX_STATUS);
+		for (unsigned int i = 0; i < AVE_MBOX_SCRATCH_COUNT; i++)
+			writel(0, ave->mbox + AVE_MBOX_SCRATCH(i));
+		return 0;
+	}
+	if (readq(ave->coproc + ave->variant->regs->vcbar) !=
+	    ave_fw_vcbar(ave->variant, ave->text.iova)) {
+		dev_err(ave->dev,
+			"coprocessor lost its code base (vcbar %#llx)\n",
+			readq(ave->coproc + ave->variant->regs->vcbar));
+		return -EIO;
+	}
+	if (ave->fw_state == AVE_FW_RECOVERING) {
+		/*
+		 * Recovery cleared CTRL itself and re-armed BOOT_ARG as a
+		 * reset witness with control off: require it to have lost
+		 * power too, before reusing DMA memory or restoring DATA. DARTs
+		 * sharing VENC power may suspend later than the consumer.
+		 */
+		if (readl(ave->coproc + ave->variant->regs->ctrl) ||
+		    readl(ave->coproc + ave->variant->regs->boot_arg))
+			return -EAGAIN;
+		ave_sess_reap(ave);
+		ave->fw_state = AVE_FW_HALTED;
+		ave->inject_wedge = false;
+		dev_info(ave->dev, "firmware recovery power cycle confirmed\n");
+	}
+	if (ave->fw_state != AVE_FW_HALTED)
+		return 0;
+
+	if (readl(ave->coproc + ave->variant->regs->ctrl)) {
+		dev_dbg(ave->dev,
+			"coprocessor kept power after its halt; retry once it suspends\n");
+		return -EAGAIN;
+	}
+	status = readl(ave->mbox + AVE_MBOX_STATUS);
+	if (status)
+		writel(status, ave->mbox + AVE_MBOX_STATUS);
+	for (unsigned int i = 0; i < AVE_MBOX_SCRATCH_COUNT; i++)
+		writel(0, ave->mbox + AVE_MBOX_SCRATCH(i));
+	return 0;
+}
+
+/* Boot the coprocessor and bring up its command rings. Caller holds hw_lock. */
+static int ave_fw_boot(struct ave_dev *ave)
+{
+	const struct ave_fw_transport *t = ave->layout->abi->transport;
+	__le32 *cfg, *log;
+	u32 status, hello[4];
+	int ret;
+
+	ret = ave_alloc(ave, &ave->ipc, t->ipc_bytes, 0);
+	if (!ret && t->boot_config)
+		ret = ave_alloc(ave, &ave->boot_cfg, SZ_16K, 0);
+	if (!ret && t->boot_config)
+		ret = ave_alloc(ave, &ave->log, AVE_LOG_BYTES, 0);
+	if (!ret)
+		ret = ave_fw_map_extra0(ave);
+	if (ret)
+		return ret;
+
+	if (ave_fw_check_mapping(ave, &ave->text) ||
+	    ave_fw_check_mapping(ave, &ave->data)) {
+		dev_err(ave->dev, "firmware segments are no longer mapped\n");
+		return -EIO;
+	}
+
+	ret = ave_fw_prepare_restart(ave);
+	if (ret)
+		return ret;
+
+	/*
+	 * The bootloader leaves the coprocessor stopped with its code base
+	 * set. Do not start it from any other state.
+	 */
+	if (t->boot_config && !ave_fw_idle(ave)) {
+		dev_err(ave->dev,
+			"coprocessor is not in its reset state (vcbar %#llx ctrl %#x)\n",
+			readq(ave->coproc + ave->variant->regs->vcbar),
+			readl(ave->coproc + ave->variant->regs->ctrl));
+		return -EIO;
+	}
+
+	memset(ave->ring, 0, sizeof(ave->ring));
+	ave->unacked = 0;
+	memset(ave->want, 0, sizeof(ave->want));
+	ave->reply_err = 0;
+	ave->scalar_next = 0;
+
+	ret = ave_fw_restore_data(ave);
+	if (ret)
+		return ret;
+
+	if (t->boot_config) {
+		cfg = ave->boot_cfg.cpu;
+		log = ave->log.cpu;
+		memset(cfg, 0, AVE_BOOT_CFG_BYTES);
+		memset(log, 0, ave->log.size);
+		cfg[AVE_BOOT_CFG_DEVICE] =
+			cpu_to_le32(ave->variant->boot_device_id);
+		cfg[AVE_BOOT_CFG_UNITS] = cpu_to_le32(1);
+		cfg[AVE_BOOT_CFG_GROUPS] = cpu_to_le32(1);
+		cfg[AVE_BOOT_CFG_SUBID_MASK] = cpu_to_le32(1);
+		cfg[AVE_BOOT_CFG_LOG_LO] =
+			cpu_to_le32(lower_32_bits(ave->log.dma));
+		cfg[AVE_BOOT_CFG_LOG_HI] =
+			cpu_to_le32(upper_32_bits(ave->log.dma));
+		cfg[AVE_BOOT_CFG_LOG_BYTES] = cpu_to_le32(AVE_LOG_BYTES);
+		cfg[AVE_BOOT_CFG_OPTIONS] =
+			cpu_to_le32(AVE_BOOT_CFG_OPTIONS_VALUE);
+		log[0] = cpu_to_le32(AVE_LOG_HDR_USED);
+		log[1] = cpu_to_le32(AVE_LOG_HDR_BYTES);
+		log[2] = cpu_to_le32(AVE_LOG_RING_BYTES);
+		dma_wmb();
+
+		writel(AVE_BOOT_MAGIC, ave->mbox + AVE_MBOX_SCRATCH(0));
+		writel(lower_32_bits(ave->boot_cfg.dma),
+		       ave->mbox + AVE_MBOX_SCRATCH(1));
+		writel(upper_32_bits(ave->boot_cfg.dma),
+		       ave->mbox + AVE_MBOX_SCRATCH(2));
+
+	} else {
+		writel(AVE_BOOT_MAGIC, ave->mbox + AVE_MBOX_SCRATCH(0));
+		writel(0, ave->mbox + AVE_MBOX_SCRATCH(1));
+		writel(ave->variant->boot_device_id,
+		       ave->mbox + AVE_MBOX_SCRATCH(2));
+	}
+	if (!t->boot_config) {
+		writeq(ave_fw_vcbar(ave->variant, ave->text.iova),
+		       ave->coproc + ave->variant->regs->vcbar);
+		if (readq(ave->coproc + ave->variant->regs->vcbar) !=
+		    ave_fw_vcbar(ave->variant, ave->text.iova))
+			return -EIO;
+		dev_dbg(ave->dev, "VCBAR %#llx boot argument %#x\n",
+			ave_fw_vcbar(ave->variant, ave->text.iova),
+			ave->variant->boot_arg_value);
+	}
+
+	if (!t->boot_config && !ave->module_pinned) {
+		if (!try_module_get(THIS_MODULE))
+			return -ENODEV;
+		ave->module_pinned = true;
+	}
+	ave->data_dirty = true;
+	writel(1, ave->coproc + ave->variant->regs->keep_mappings);
+	writel(0, ave->coproc + ave->variant->regs->ctrl);
+	writel(ave->variant->boot_arg_value,
+	       ave->coproc + ave->variant->regs->boot_arg);
+	writel(AVE_COPROC_CTRL_RUN, ave->coproc + ave->variant->regs->ctrl);
+
+	ret = readl_poll_timeout(ave->mbox + AVE_MBOX_STATUS, status,
+				 status & AVE_MBOX_STATUS_PENDING, 50,
+				 AVE_MBOX_TIMEOUT_US);
+	if (ret) {
+		dev_err(ave->dev, "firmware did not answer (status %#x)\n",
+			readl(ave->coproc + ave->variant->regs->status));
+		return ret;
+	}
+	for (unsigned int i = 0; i < 4; i++)
+		hello[i] = readl(ave->mbox + AVE_MBOX_SCRATCH(i));
+	dma_rmb();
+
+	ret = ave_ipc_negotiate(ave, hello);
+	if (ret) {
+		dev_err(ave->dev, "firmware start-up failed: %d\n", ret);
+		return ret;
+	}
+
+	ave->fw_state = AVE_FW_RUNNING;
+	ret = ave_cmd_config(ave);
+	if (ret)
+		return ret;
+
+	dev_dbg(ave->dev, "firmware running, %u/%u ring slots\n",
+		ave->ring[0].slots, ave->ring[1].slots);
+	return 0;
+}
+
+/* Caller holds hw_lock. */
+int ave_fw_ensure_running(struct ave_dev *ave)
+{
+	enum ave_fw_state prev;
+	int ret;
+
+	lockdep_assert_held(&ave->hw_lock);
+	ret = ave_fw_check_boot(ave);
+	if (ret)
+		return ret;
+	switch (ave->fw_state) {
+	case AVE_FW_RUNNING:
+		return 0;
+	case AVE_FW_BROKEN:
+		dev_err_ratelimited(ave->dev, "firmware recovery is waiting for idle runtime suspend\n");
+		return -EIO;
+	case AVE_FW_OFF:
+	case AVE_FW_HALTED:
+	case AVE_FW_RECOVERING:
+		break;
+	}
+
+	/* A boot that reached RUN must use the same recovery as a session fault. */
+	prev = ave->fw_state;
+	ret = ave_fw_boot(ave);
+	if (ret && ret != -EAGAIN) {
+		if (ave->layout->abi->transport->scratch_halt &&
+		    (ave->module_pinned ||
+		     readl(ave->coproc + ave->variant->regs->ctrl))) {
+			if (!ave->module_pinned && try_module_get(THIS_MODULE))
+				ave->module_pinned = true;
+			ave_fw_mark_broken(ave, ret, "boot");
+			return ret;
+		}
+		if (readl(ave->coproc + ave->variant->regs->ctrl))
+			ave_fw_mark_broken(ave, ret, "boot");
+		else
+			ave->fw_state = prev;
+	}
+	return ret;
+}
+
+/*
+ * Tell the firmware to stop, once every session is closed. Halt gets no
+ * ring reply. 6070 confirms quiescence through scratch0 before the host
+ * stops the IOP; 9003 retains its existing settle interval.
+ * Caller holds hw_lock.
+ */
+void ave_fw_halt(struct ave_dev *ave)
+{
+	lockdep_assert_held(&ave->hw_lock);
+	if (ave->fw_state != AVE_FW_RUNNING)
+		return;
+	if (ave->layout->abi->transport->scratch_halt) {
+		for (unsigned int i = 0; i < AVE_MAX_SESSIONS; i++)
+			if (ave->sessions[i] &&
+			    ave->sessions[i]->sess->fw_open) {
+				ave->fw_state = AVE_FW_BROKEN;
+				return;
+			}
+		writel(0, ave->mbox + AVE_MBOX_SCRATCH(0));
+	}
+	if (ave_cmd_halt(ave)) {
+		dev_err(ave->dev, "cannot send Halt; firmware treated as stuck\n");
+		ave_fw_mark_broken(ave, -EIO, "Halt");
+		return;
+	}
+	if (ave->layout->abi->transport->scratch_halt) {
+		u32 status;
+		int ret;
+
+		ret = readl_poll_timeout(ave->mbox + AVE_MBOX_SCRATCH(0),
+					 status, status == AVE_BOOT_MAGIC, 100,
+					 AVE_MBOX_TIMEOUT_US);
+		if (ret) {
+			dev_err(ave->dev,
+				"Halt not confirmed; retaining firmware mappings and power\n");
+			ave->fw_state = AVE_FW_BROKEN;
+			return;
+		}
+		dev_dbg(ave->dev, "Halt confirmed: scratch0 %#x\n", status);
+		/* Scratch confirmation establishes quiescence; stop and read back the IOP.
+		 */
+		writel(0, ave->coproc + ave->variant->regs->ctrl);
+		ret = readl_poll_timeout(ave->coproc + ave->variant->regs->ctrl,
+					 status, !status, 100,
+					 AVE_MBOX_TIMEOUT_US);
+		if (ret) {
+			ave->fw_state = AVE_FW_BROKEN;
+			return;
+		}
+	} else {
+		msleep(AVE_HALT_SETTLE_MS);
+	}
+	ave->fw_state = AVE_FW_HALTED;
+	memset(ave->ring, 0, sizeof(ave->ring));
+	ave->ipc_fw_base = 0;
+}
+
+/*
+ * Stop the firmware before its power goes away. Caller holds hw_lock.
+ *
+ * Sessions keep the device runtime active, so the firmware has normally
+ * been halted already. A firmware that stopped answering keeps its power:
+ * system sleep must not silently force-stop a potentially live DMA engine.
+ * Runtime recovery is separate and only runs after all owners have gone.
+ */
+int ave_fw_shutdown(struct ave_dev *ave)
+{
+	lockdep_assert_held(&ave->hw_lock);
+	switch (ave->fw_state) {
+	case AVE_FW_RUNNING:
+		ave_fw_halt(ave);
+		return ave->fw_state == AVE_FW_HALTED ? 0 : -EBUSY;
+	case AVE_FW_BROKEN:
+	case AVE_FW_RECOVERING:
+		return -EBUSY;
+	default:
+		return 0;
+	}
+}
+
+/* Caller holds hw_lock. Wake even idle sessions so none pins a broken boot. */
+void ave_fw_mark_broken(struct ave_dev *ave, int err, const char *what)
+{
+	lockdep_assert_held(&ave->hw_lock);
+	if (ave->fw_state != AVE_FW_BROKEN)
+		dev_err(ave->dev, "firmware failed (%s: %d); scheduling recovery\n", what, err);
+	ave->fw_state = AVE_FW_BROKEN;
+	for (unsigned int i = 0; i < AVE_MAX_SESSIONS; i++)
+		if (ave->sessions[i])
+			mod_delayed_work(ave->wq, &ave->sessions[i]->poll_work, 0);
+}
+
+/*
+ * Only runtime PM may force-stop a broken firmware, with no session owners
+ * and no runtime references. genpd and the IOMMU's PM device links then drop
+ * the VENC domains and DARTs; AVE must not reset or reprogram the DART itself.
+ * System sleep continues to use the strict ave_fw_shutdown() above.
+ */
+int ave_fw_runtime_suspend(struct ave_dev *ave)
+{
+	int ret;
+
+	lockdep_assert_held(&ave->hw_lock);
+	/* 6070 requires scratch-confirmed Halt; never force its power gate. */
+	if (ave->layout && ave->layout->abi->transport->scratch_halt)
+		return ave_fw_shutdown(ave);
+	if (ave->fw_state != AVE_FW_BROKEN && ave->fw_state != AVE_FW_RECOVERING)
+		return ave_fw_shutdown(ave);
+	for (unsigned int i = 0; i < AVE_MAX_SESSIONS; i++)
+		if (ave->sessions[i])
+			return -EBUSY;
+	if (ave->fw_state == AVE_FW_RECOVERING)
+		return 0;
+	if (!ave_recovery_allow(&ave->recovery, jiffies)) {
+		dev_err_ratelimited(ave->dev, "firmware recovery limit: 3 attempts per 10 minutes\n");
+		return -EBUSY;
+	}
+	ave->recovery_count++;
+	dev_warn(ave->dev, "firmware recovery %u: stopping coprocessor and cycling VENC power\n",
+		 ave->recovery_count);
+
+	/* A ring may not exist after a failed boot. Never wait for Halt's reply. */
+	ret = ave->inject_wedge ? -ETIMEDOUT : -EIO;
+	if (ave->ipc_fw_base && ave->ring[0].slots && !ave->inject_wedge) {
+		ave->fw_state = AVE_FW_RUNNING;
+		ret = ave_cmd_halt(ave);
+	}
+	if (ret)
+		dev_warn(ave->dev, "recovery Halt failed: %d; forcing control off\n", ret);
+	else
+		msleep(AVE_HALT_SETTLE_MS);
+	writel(0, ave->coproc + ave->variant->regs->ctrl);
+	if (readl(ave->coproc + ave->variant->regs->ctrl)) {
+		ave->fw_state = AVE_FW_BROKEN;
+		return -EIO;
+	}
+	/* CTRL=0 must not masquerade as power loss on the next attach. */
+	writel(AVE_COPROC_BOOT_ARG_VALUE, ave->coproc + ave->variant->regs->boot_arg);
+	if (readl(ave->coproc + ave->variant->regs->boot_arg) != AVE_COPROC_BOOT_ARG_VALUE) {
+		ave->fw_state = AVE_FW_BROKEN;
+		return -EIO;
+	}
+	ave->fw_state = AVE_FW_RECOVERING;
+	return 0;
+}
+
+/* The coprocessor lost power behind the firmware's back. Caller holds hw_lock. */
+void ave_fw_lost(struct ave_dev *ave)
+{
+	lockdep_assert_held(&ave->hw_lock);
+	ave->fw_state = AVE_FW_OFF;
+	memset(ave->ring, 0, sizeof(ave->ring));
+	ave->ipc_fw_base = 0;
+}
+
+/* Explicit lifecycle-only validation, without allocating encoder surfaces. */
+int ave_fw_lifecycle_test(struct ave_dev *ave, enum ave_codec codec)
+{
+	struct ave_ctx *ctx;
+	struct ave_session *sess;
+	int ret;
+
+	if (!ave->layout || ave->layout->abi != &ave_abi_6070)
+		return -EOPNOTSUPP;
+	ctx = kzalloc_obj(*ctx);
+	sess = kzalloc_obj(*sess);
+	if (!ctx || !sess) {
+		ret = -ENOMEM;
+		goto free;
+	}
+	ctx->ave = ave;
+	ctx->sess = sess;
+	sess->p.codec = codec;
+	ret = pm_runtime_resume_and_get(ave->dev);
+	if (ret < 0)
+		goto free;
+	mutex_lock(&ave->hw_lock);
+	for (unsigned int i = 0; i < AVE_MAX_SESSIONS; i++)
+		if (ave->sessions[i]) {
+			ret = -EBUSY;
+			goto unlock;
+		}
+	ret = ave_fw_ensure_running(ave);
+	if (!ret)
+		ret = ave_cmd_open(ctx);
+	if (!ret)
+		ret = ave_cmd_close(ctx);
+	if (!ret) {
+		ave_fw_halt(ave);
+		if (ave->fw_state != AVE_FW_HALTED)
+			ret = -EIO;
+	} else if (ave->fw_state == AVE_FW_RUNNING) {
+		/* Unconfirmed client lifetime: do not Halt or free anything it may own. */
+		ave->fw_state = AVE_FW_BROKEN;
+	}
+unlock:
+	mutex_unlock(&ave->hw_lock);
+	/* Runtime suspend refuses broken firmware, retaining its DMA and power. */
+	if (ave->fw_state != AVE_FW_BROKEN) {
+		int err = pm_runtime_put_sync_suspend(ave->dev);
+
+		if (!ret && err < 0)
+			ret = err;
+	} else {
+		dev_err(ave->dev,
+			"lifecycle failed (%d); retaining runtime power reference\n",
+			ret);
+	}
+	dev_info(ave->dev, "6070 lifecycle codec %u: %d\n", codec, ret);
+free:
+	kfree(sess);
+	kfree(ctx);
+	return ret;
+}
