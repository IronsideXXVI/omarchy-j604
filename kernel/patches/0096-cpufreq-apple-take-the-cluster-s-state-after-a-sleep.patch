From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:11 -0500
Subject: [PATCH] cpufreq: apple: take the cluster's state after a
 sleep as the expected one

A firmware-driven sleep powers the cluster down, and it came back in
pstate 2 with the driver expecting 1, the suspend state. The first
request after the wake then stopped all requests as if another owner
held the cluster, and the next suspend failed. Read the state again on
resume, before the governor starts.

Signed-off-by: Diljit Singh <hey@djdev.me>
(cherry picked from commit d5f8cc25149ecb65c6406a7ea2c743761930678e)
(cherry picked from commit 16ed93a20b629a0e8aa2b3425b825d28a64e4775)
(cherry picked from commit a18f233e4bfa67a7d697d2dbd2e85ebf8cf2a6f9)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/cpufreq/apple-soc-cpufreq.c | 33 +++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/drivers/cpufreq/apple-soc-cpufreq.c b/drivers/cpufreq/apple-soc-cpufreq.c
index 85e592faa0..9a16751974 100644
--- a/drivers/cpufreq/apple-soc-cpufreq.c
+++ b/drivers/cpufreq/apple-soc-cpufreq.c
@@ -27,6 +27,7 @@
 #include <linux/pm_opp.h>
 #include <linux/pm_qos.h>
 #include <linux/slab.h>
+#include <linux/suspend.h>
 #include <linux/soc/apple/cpufreq-thermal.h>
 #include <linux/soc/apple/pmp-report.h>
 #include <linux/spinlock.h>
@@ -841,6 +842,37 @@ static int apple_soc_cpufreq_suspend(struct cpufreq_policy *policy)
 	return cpufreq_generic_suspend(policy);
 }
 
+/*
+ * A firmware-driven sleep powers the cluster down, and it comes back in a performance state
+ * of the hardware's choosing, not the one asked for at suspend. Take what it reads as the
+ * expected state again, before the governor starts, rather than stopping every request as if
+ * someone else owned it.
+ */
+static int apple_soc_cpufreq_resume(struct cpufreq_policy *policy)
+{
+	struct apple_cpu_priv *priv = policy->driver_data;
+	unsigned long flags;
+	u64 reg;
+
+	if (!priv->info->verify_transition || !pm_resume_via_firmware())
+		return 0;
+
+	raw_spin_lock_irqsave(&priv->lock, flags);
+	reg = readq_relaxed(priv->reg_base + APPLE_DVFS_CMD);
+	if (!(reg & APPLE_DVFS_CMD_BUSY)) {
+		unsigned int now = FIELD_GET(APPLE_DVFS_CMD_PS1, reg);
+
+		if (now != priv->expected_pstate)
+			dev_info(priv->cpu_dev, "DVFS state %u after the sleep, %u before\n",
+				 now, priv->expected_pstate);
+		priv->expected_pstate = now;
+		priv->transition_failed = false;
+	}
+	raw_spin_unlock_irqrestore(&priv->lock, flags);
+
+	return 0;
+}
+
 static unsigned int apple_soc_cpufreq_fast_switch(struct cpufreq_policy *policy,
 						  unsigned int target_freq)
 {
@@ -1548,6 +1580,7 @@ static struct cpufreq_driver apple_soc_cpufreq_driver = {
 	.register_em	= cpufreq_register_em_with_opp,
 	.set_boost	= cpufreq_boost_set_sw,
 	.suspend	= apple_soc_cpufreq_suspend,
+	.resume		= apple_soc_cpufreq_resume,
 };
 
 static int __init apple_soc_cpufreq_module_init(void)
