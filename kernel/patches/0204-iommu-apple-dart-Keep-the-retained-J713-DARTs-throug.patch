From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Sun, 25 Oct 2026 20:20:13 -0400
Subject: [PATCH] iommu/apple-dart: Keep the retained J713 DARTs through
 suspend-to-idle

The J713's retained DMA owners refuse system sleep: the radio's DART
with managed streams, and the display DARTs, which borrow the running
DCP's live page-table root. Neither has a suspend boundary of its own,
and their state cannot be restored from a copy.

Suspend-to-idle does not need one. These DARTs have no power domain of
their own in the tree, and the DCP keeps the display domains on across
s2idle, so their state stays where it is. Let them through for
suspend-to-idle only, saving their registers solely for resume to check
that nothing moved. Every other sleep state is still refused.

A DART whose retained state changed cannot be trusted with its live DMA,
and a resume error does not stop the PM core from resuming consumers.
Quarantine the managed streams and the borrowed display consumers
through the same paths as a translation fault before failing resume, so
that their later maps are refused. A host test exercises the extracted
check, quarantine and map functions.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 07a949f1170e18a9da547eae987d8936092047c3)
[dylan: dropped the cold_ane context of the original; this tree has no
 cold ANE DARTs. On the J604 the path is reached by the retained display
 DARTs (preserve_display through apple_dart_retained_display_board(),
 which admits the J604) once the DCP opt-in has probed them; the J604
 radio DART has no apple,managed-sids here and keeps the ordinary
 save/restore path.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/iommu/apple-dart.c                    |  68 ++++--
 .../drivers/apple/dart-s2idle-retention.py    | 218 ++++++++++++++++++
 2 files changed, 272 insertions(+), 14 deletions(-)
 create mode 100755 tools/testing/selftests/drivers/apple/dart-s2idle-retention.py

diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 7ee43fb49b..b643e411a2 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -40,6 +40,7 @@
 #include <linux/pm_runtime.h>
 #include <linux/slab.h>
 #include <linux/soc/apple/tunable.h>
+#include <linux/suspend.h>
 #include <linux/swab.h>
 #include <linux/sysfs.h>
 #include <linux/types.h>
@@ -310,6 +311,8 @@ struct apple_dart {
 	struct apple_dart_dcp *dcp;
 	struct apple_dart_dcp *frontend[2];
 	bool preserve_display;
+	/* Retained radio/display state left in place across suspend-to-idle. */
+	bool s2idle_kept;
 	/* Resources reachable by a retained domain outlive device removal. */
 	bool retained;
 	bool retained_mtp;
@@ -4687,17 +4690,40 @@ static const struct apple_dart_hw apple_dart_hw_t8110 = {
 	.ttbr_count = 1,
 };
 
+static void apple_dart_save_state(struct apple_dart *dart)
+{
+	unsigned int sid, idx;
+
+	for (sid = 0; sid < dart->num_streams; sid++) {
+		dart->save_tcr[sid] = apple_dart_readl(dart,
+						       DART_TCR(dart, sid));
+		for (idx = 0; idx < dart->hw->ttbr_count; idx++)
+			dart->save_ttbr[sid][idx] =
+				apple_dart_readl(dart,
+						 DART_TTBR(dart, sid, idx));
+	}
+}
+
 static __maybe_unused int apple_dart_suspend(struct device *dev)
 {
 	struct apple_dart *dart = dev_get_drvdata(dev);
-	unsigned int sid, idx;
 
 	dart->tunnel_state_restored = false;
 	if (READ_ONCE(dart->commands_gated))
 		return 0;
-	/* Neither retained radio nor display has a qualified suspend boundary. */
-	if (dart->managed_sids || dart->preserve_display || apple_dart_has_borrowed(dart))
-		return -EBUSY;
+	/*
+	 * Retained radio and display DMA has no suspend boundary of its own.
+	 * Suspend-to-idle leaves it running in place: these DARTs have no
+	 * power domain here, and the DCP keeps the display domains on. The
+	 * registers are saved only for resume to check.
+	 */
+	if (dart->managed_sids || dart->preserve_display || apple_dart_has_borrowed(dart)) {
+		if (pm_suspend_target_state != PM_SUSPEND_TO_IDLE)
+			return -EBUSY;
+		apple_dart_save_state(dart);
+		dart->s2idle_kept = true;
+		return 0;
+	}
 	/* The tunneled DART has no state to save when its domain stays on. */
 	if (dart->power_retained || dart->retained_mtp)
 		return 0;
@@ -4706,15 +4732,7 @@ static __maybe_unused int apple_dart_suspend(struct device *dev)
 	if (dart->locked)
 		return 0;
 
-	for (sid = 0; sid < dart->num_streams; sid++) {
-		dart->save_tcr[sid] = apple_dart_readl(dart,
-						       DART_TCR(dart, sid));
-		for (idx = 0; idx < dart->hw->ttbr_count; idx++)
-			dart->save_ttbr[sid][idx] =
-				apple_dart_readl(dart,
-						 DART_TTBR(dart, sid, idx));
-	}
-
+	apple_dart_save_state(dart);
 	return 0;
 }
 
@@ -4778,6 +4796,28 @@ static int apple_dart_invalidate_each_stream(struct apple_dart *dart)
 	return 0;
 }
 
+/*
+ * Resume of a DART whose live DMA stayed in place through suspend-to-idle. It
+ * cannot be restored from the saved copy. If the translations changed, the
+ * consumers' DMA is no longer what they set up: refuse their further use
+ * through the same paths as a translation fault before failing resume, since
+ * a resume error does not stop the PM core from resuming them.
+ */
+static int apple_dart_resume_retained(struct apple_dart *dart)
+{
+	if (!dart->s2idle_kept)
+		return -EBUSY;
+	dart->s2idle_kept = false;
+	if (apple_dart_state_retained(dart))
+		return 0;
+
+	dev_err(dart->dev, "retained DMA state lost in suspend-to-idle\n");
+	if (dart->managed_sids)
+		apple_dart_managed_quarantine(dart);
+	apple_dart_quarantine_borrowed(dart);
+	return -EIO;
+}
+
 static __maybe_unused int apple_dart_resume(struct device *dev)
 {
 	struct apple_dart *dart = dev_get_drvdata(dev);
@@ -4785,7 +4825,7 @@ static __maybe_unused int apple_dart_resume(struct device *dev)
 	int ret;
 
 	if (dart->managed_sids || dart->preserve_display || apple_dart_has_borrowed(dart))
-		return -EBUSY;
+		return apple_dart_resume_retained(dart);
 
 	/* PCIe-C restored these mappings before starting its downstream link. */
 	if (dart->tunnel_state_restored) {
diff --git a/tools/testing/selftests/drivers/apple/dart-s2idle-retention.py b/tools/testing/selftests/drivers/apple/dart-s2idle-retention.py
new file mode 100755
index 0000000000..44682a977f
--- /dev/null
+++ b/tools/testing/selftests/drivers/apple/dart-s2idle-retention.py
@@ -0,0 +1,218 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Exercise the suspend-to-idle resume check of retained DARTs on the host.
+
+The actual state check, quarantine and map functions are extracted from
+apple-dart.c. A retained DART whose translation registers changed must fail
+resume and quarantine its consumers, so that later maps are refused. These CPU
+tests do not qualify physical retention on a J713.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def definition(source, name):
+    start = source.index(name)
+    start = source.rfind('\n', 0, start) + 1
+    brace = source.index('{', start)
+    depth, end = 1, brace + 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+
+PRELUDE = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef uint64_t u64;
+typedef u64 phys_addr_t;
+typedef unsigned int gfp_t;
+#define BIT(n) (1UL << (n))
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define WRITE_ONCE(x, v) ((x) = (v))
+#define READ_ONCE(x) (x)
+#define DART_MAX_STREAMS 32
+#define DART_MAX_TTBR 4
+#define DART_TCR(d, sid) (0x100 + 4 * (sid))
+#define DART_TTBR(d, sid, idx) (0x200 + 16 * (sid) + 4 * (idx))
+#define container_of(p, t, m) ((t *)((char *)(p) - offsetof(t, m)))
+#define lockdep_assert_held(l) ((void)(l))
+#define spin_lock_irqsave(l, f) ((void)(l), (f) = 0)
+#define spin_unlock_irqrestore(l, f) ((void)(l), (void)(f))
+static int errors;
+#define dev_err(dev, ...) (errors++)
+static void __set_bit(unsigned int n, unsigned long *p) { p[n / 64] |= 1UL << (n % 64); }
+
+struct apple_dart_hw { u32 tcr_bypass, ttbr_valid; unsigned int ttbr_count; };
+struct apple_dart;
+struct apple_dart_dcp { bool failed; struct apple_dart *dart; };
+struct apple_dart {
+    const struct apple_dart_hw *hw;
+    u16 managed_sids;
+    bool managed_failed, supports_bypass, s2idle_kept;
+    int managed_lock;
+    struct { bool ready; } iommu;
+    struct apple_dart_dcp *dcp, *frontend[2];
+    void *dev;
+    unsigned int num_streams;
+    u32 save_tcr[DART_MAX_STREAMS], save_ttbr[DART_MAX_STREAMS][DART_MAX_TTBR];
+    u32 regs[0x400 / 4];
+};
+struct apple_dart_stream_map { struct apple_dart *dart; unsigned long sidmap[4]; };
+static u32 apple_dart_readl(struct apple_dart *d, unsigned int o) { return d->regs[o / 4]; }
+static unsigned long disabled;
+static void apple_dart_hw_disable_dma(struct apple_dart_stream_map *m) { disabled |= m->sidmap[0]; }
+
+struct iommu_domain { int unused; };
+struct io_pgtable_ops {
+    int (*map_pages)(struct io_pgtable_ops *, unsigned long, phys_addr_t, size_t, size_t, int,
+                     gfp_t, size_t *);
+};
+struct apple_dart_domain {
+    struct iommu_domain domain;
+    struct io_pgtable_ops *pgtbl_ops;
+    struct apple_dart_dcp *dcp;
+    struct apple_dart_stream_map stream_maps[1];
+    u64 dma_offset, mask;
+};
+#define to_dart_domain(d) container_of(d, struct apple_dart_domain, domain)
+static int apple_dart_check_fw_map(struct apple_dart_domain *d, u64 dva, phys_addr_t pa,
+                                   size_t size, int prot) { return 0; }
+static int apple_dart_dcp_map(struct apple_dart_dcp *dcp, unsigned long iova, phys_addr_t pa,
+                              size_t pgsize, size_t count, int prot, gfp_t gfp, size_t *mapped)
+{ assert(!"the managed radio domain is not a borrowed display domain"); return 0; }
+static int maps;
+static int test_map(struct io_pgtable_ops *ops, unsigned long iova, phys_addr_t pa, size_t pgsize,
+                    size_t count, int prot, gfp_t gfp, size_t *mapped)
+{ maps++; *mapped = pgsize * count; return 0; }
+'''
+
+TEST = r'''
+static const struct apple_dart_hw hw = { .tcr_bypass = 0, .ttbr_valid = 1, .ttbr_count = 1 };
+static struct apple_dart_dcp dcp, front0, front1;
+static struct apple_dart d;
+static struct io_pgtable_ops ops = { .map_pages = test_map };
+static struct apple_dart_domain radio;
+
+static void setup(void)
+{
+    memset(&d, 0, sizeof(d));
+    dcp.failed = front0.failed = front1.failed = false;
+    d.hw = &hw;
+    d.num_streams = 16;
+    d.managed_sids = BIT(1) | BIT(2);
+    d.dcp = &dcp;
+    d.frontend[0] = &front0;
+    d.frontend[1] = &front1;
+    d.iommu.ready = true;
+    /* Live translations on the radio's streams and on an ordinary one. */
+    d.regs[DART_TCR(&d, 1) / 4] = d.regs[DART_TCR(&d, 2) / 4] = d.regs[DART_TCR(&d, 5) / 4] = 1;
+    d.regs[DART_TTBR(&d, 1, 0) / 4] = 0x1001;
+    d.regs[DART_TTBR(&d, 2, 0) / 4] = 0x2001;
+    d.regs[DART_TTBR(&d, 5, 0) / 4] = 0x5001;
+    for (unsigned int sid = 0; sid < d.num_streams; sid++) {
+        d.save_tcr[sid] = d.regs[DART_TCR(&d, sid) / 4];
+        d.save_ttbr[sid][0] = d.regs[DART_TTBR(&d, sid, 0) / 4];
+    }
+    d.s2idle_kept = true;
+    disabled = 0;
+    maps = 0;
+    errors = 0;
+    radio = (struct apple_dart_domain){ .pgtbl_ops = &ops, .mask = ~0ULL,
+                                        .stream_maps = {{ .dart = &d }} };
+}
+
+static int map_16k(void)
+{
+    size_t mapped = 0;
+    return apple_dart_map_pages(&radio.domain, 0x10000, 0x800000000ULL, 0x4000, 1, 3, 0, &mapped);
+}
+
+static void expect_quarantined(int ret)
+{
+    assert(ret == -EIO && errors == 1);
+    assert(d.managed_failed && disabled == d.managed_sids);
+    assert(dcp.failed && front0.failed && front1.failed);
+    assert(map_16k() == -EIO && maps == 0);
+}
+
+int main(void)
+{
+    /* Retained: resume succeeds and the radio maps as before. */
+    setup();
+    assert(apple_dart_resume_retained(&d) == 0 && !d.s2idle_kept);
+    assert(!d.managed_failed && !disabled && !dcp.failed && !errors);
+    assert(map_16k() == 0 && maps == 1);
+
+    /* A changed TTBR on a managed stream. */
+    setup();
+    d.regs[DART_TTBR(&d, 1, 0) / 4] = 0x9001;
+    expect_quarantined(apple_dart_resume_retained(&d));
+
+    /* A changed TCR on an ordinary stream of the same DART. */
+    setup();
+    d.regs[DART_TCR(&d, 5) / 4] = 0;
+    expect_quarantined(apple_dart_resume_retained(&d));
+
+    /* A DART that lost power reads back as reset. */
+    setup();
+    memset(d.regs, 0, sizeof(d.regs));
+    memset(d.save_tcr, 0, sizeof(d.save_tcr));
+    memset(d.save_ttbr, 0, sizeof(d.save_ttbr));
+    expect_quarantined(apple_dart_resume_retained(&d));
+
+    /* No suspend-to-idle suspend: refused, nothing quarantined. */
+    setup();
+    d.s2idle_kept = false;
+    assert(apple_dart_resume_retained(&d) == -EBUSY);
+    assert(!d.managed_failed && !dcp.failed && map_16k() == 0);
+
+    puts("PASS retained DART resume: kept state resumes; lost state quarantines and refuses maps");
+    return 0;
+}
+'''
+
+
+def main():
+    root = Path(__file__).resolve().parents[5]
+    dart = (root / 'drivers/iommu/apple-dart.c').read_text()
+    code = PRELUDE
+    for name in ('static bool apple_dart_state_retained(',
+                 'static void apple_dart_managed_quarantine_locked(',
+                 'static void apple_dart_managed_quarantine(',
+                 'static void apple_dart_quarantine_borrowed(',
+                 'static int apple_dart_resume_retained(',
+                 'static int apple_dart_map_pages('):
+        code += definition(dart, name) + '\n'
+    code += TEST
+    quarantine = ('\tif (dart->managed_sids)\n\t\tapple_dart_managed_quarantine(dart);\n'
+                  '\tapple_dart_quarantine_borrowed(dart);\n')
+    assert code.count(quarantine) == 1, 'the resume quarantine was not found'
+    with tempfile.TemporaryDirectory() as directory:
+        c, exe = Path(directory) / 'resume.c', Path(directory) / 'resume'
+        for control in ('production', 'missing-quarantine'):
+            tested = code if control == 'production' else code.replace(quarantine, '')
+            c.write_text(tested)
+            subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Werror',
+                            '-Wno-unused-parameter', '-Wno-unused-function',
+                            str(c), '-o', str(exe)], check=True)
+            result = subprocess.run([str(exe)], capture_output=True, text=True)
+            if control == 'production':
+                assert result.returncode == 0, result.stderr
+                print(result.stdout.strip())
+            else:
+                assert result.returncode and 'Assertion' in result.stderr, result
+                print('Retained DART resume ' + control + ' negative control: detected at runtime')
+
+
+if __name__ == '__main__':
+    main()
