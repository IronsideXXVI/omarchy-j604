From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 03:11:44 +0000
Subject: [PATCH] soc: apple: sep: Add the J604 (MacBook Pro 14-inch M4)
 profile

The J604 ADTs (26.6.2 25G83, 27.2 26B123 and the Mac's own 27.2
runtime tree) describe the SEP, its DART window and its mailbox
interrupts as J713's do, and put the Mesa sensor on spi2 at
0x3ad108000, 8 MHz, chip select 0, power on NUB GPIO 28 and
data-ready on AP GPIO 199, as on J713.

The sensor differs: the J604 ADT names it "R3", J613's generation,
where J713's and J614s's name "V3". So the J604 takes the T8132 SoC
side and J613's sensor side: SPI mode 1, the 0x3352 part, no nonce
session and no signed root key. Select it only on apple,t8132 with
apple,j604.

Not yet run on the J604. The R3-on-T8132 combination has not been
run on any Mac; a SESSION_SHARE refusal (0x16) at attach would mean
the sensor needs J713's V3 protocol instead.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/profile.rs | 44 ++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/drivers/soc/apple/profile.rs b/drivers/soc/apple/profile.rs
index e37935572e..44388d0a5b 100644
--- a/drivers/soc/apple/profile.rs
+++ b/drivers/soc/apple/profile.rs
@@ -449,6 +449,26 @@ pub(crate) const T8132: PlatformProfile = PlatformProfile {
     ..T8122
 };
 
+/// MacBook Pro 14" M4 (J604). The J604 ADTs (26.6.2 25G83, 27.2 26B123 and
+/// this Mac's 27.2 runtime tree) describe the SEP, its DART and mailbox
+/// interrupts as J713's do: `iop-sep,ascwrap-v6`, DART input aperture
+/// `0x100_0000_4000 + 0xffff0000`, ADT mailbox interrupts 390 389 392 391.
+/// The Mesa sensor sits on spi2 at `0x3ad108000`, 8 MHz, chip select 0, with
+/// the same `reg` bytes as J713's and J613's, power on NUB GPIO 28 and
+/// data-ready on AP GPIO 199.
+///
+/// Unlike J713, the sensor is J613's generation (`sensor-id` "R3", not "V3"),
+/// so the sensor side is J613's: SPI mode 1, no nonce session and no signed
+/// root key. The SoC side is the T8132 (= T8122) warm attach.
+pub(crate) const T8132_J604: PlatformProfile = PlatformProfile {
+    name: "T8132/J604",
+    sensor: SensorProfile {
+        controller_base: 0x3_ad10_8000,
+        ..T8122.sensor
+    },
+    ..T8122
+};
+
 static_assert!(T8103.shmem_capacity == 0x30000);
 static_assert!(T6020.shmem_capacity == 0x40000);
 static_assert!(T8140.shmem_capacity == 0x40000);
@@ -467,6 +487,9 @@ static_assert!(T8122.wide_dma_mask);
 static_assert!(T8132.sensor.controller_base == 0x3ad108000);
 static_assert!(T8132.sensor.expected_id == T8140.sensor.expected_id);
 static_assert!(T8132.nonce_session && T8132.wide_dma_mask);
+static_assert!(T8132_J604.sensor.controller_base == T8132.sensor.controller_base);
+static_assert!(T8132_J604.sensor.expected_id == T8122.sensor.expected_id);
+static_assert!(!T8132_J604.nonce_session && T8132_J604.wide_dma_mask);
 
 /// Whether the machine root declares `compatible`.
 ///
@@ -626,6 +649,10 @@ fn select(
     if has(b"apple,t8132") && has(b"apple,j713") {
         return Ok(&T8132);
     }
+    // J604 carries the R3 sensor on the T8132 SoC; only its ADTs were read.
+    if has(b"apple,t8132") && has(b"apple,j604") {
+        return Ok(&T8132_J604);
+    }
     Err(ENODEV)
 }
 
@@ -681,6 +708,8 @@ mod tests {
     #[test]
     fn t8132_selection_is_limited_to_j713() {
         assert_eq!(picked(&[b"apple,j713", b"apple,t8132"]), Some(T8132.name));
+        assert_eq!(picked(&[b"apple,j604", b"apple,t8132"]), Some(T8132_J604.name));
+        assert_eq!(picked(&[b"apple,j604", b"apple,t8122"]), None);
         assert_eq!(picked(&[b"apple,t8132"]), None);
         assert_eq!(picked(&[b"apple,j613", b"apple,t8132"]), None);
         assert_eq!(picked(&[b"apple,j713", b"apple,t8122"]), None);
@@ -697,6 +726,20 @@ mod tests {
         assert!(T8132.xart_guard == T8122.xart_guard);
         assert!(core::ptr::eq(T8132.dart_window, T8122.dart_window));
     }
+
+    #[test]
+    fn j604_takes_the_r3_sensor_on_the_t8132_soc_side() {
+        assert!(T8132_J604.sensor.controller_base == T8132.sensor.controller_base);
+        assert!(T8132_J604.sensor.expected_id == T8122.sensor.expected_id);
+        assert!(T8132_J604.sensor.mode == SpiMode::Mode1);
+        assert!(!T8132_J604.nonce_session);
+        assert!(T8132_J604.wide_dma_mask && T8132_J604.persistent_enrol);
+        assert!(T8132_J604.shmem_capacity == T8132.shmem_capacity);
+        assert!(T8132_J604.xart_guard == T8132.xart_guard);
+        assert!(T8132_J604.bootstrap == Bootstrap::WarmRegister);
+        assert!(T8132_J604.identity == IdentitySource::Chosen);
+        assert!(core::ptr::eq(T8132_J604.dart_window, T8132.dart_window));
+    }
 }
 
 #[cfg(CONFIG_APPLE_SEP_KUNIT_TEST)]
@@ -734,6 +777,7 @@ mod dart_window_tests {
             &T6020_SEPOS13,
             &T8122,
             &T8132,
+            &T8132_J604,
         ] {
             assert_eq!(offset(profile.dart_window), 1 << 40);
             assert_eq!(range(profile.dart_window), (0, 1 << 32));
