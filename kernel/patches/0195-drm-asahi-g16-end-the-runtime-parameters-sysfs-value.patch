From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 10:46:39 +0000
Subject: [PATCH] drm/asahi: g16: end the runtime parameters' sysfs
 values with a newline

The G16 runtime parameters with their own get callback (g16_idle_power_off,
g16_idle_floor, and g16_ta_first, g16_resnap_live_us, g16_deep_sleep,
g16_flights, g16_pb_reuse through live_u32_get()) write their value without
a trailing newline, on the assumption that the module-parameter core adds
one. It does not: param_attr_show() returns the callback's count as is, and
every standard getter ends its value with "\n" itself (param_get_bool(),
STANDARD_PARAM_DEF).

So these files read differently from every other module parameter, and
reading two of them in a row runs the values together:

  $ cat .../g16_ta_first .../g16_resnap_live_us
  10

which made a check expecting "1 0" fail on every boot since these
parameters were added.

Write the newline in the three callbacks and count it, as the standard
getters do. The values and their parsing are unchanged.

Fixes: d9cf5973fb34 ("drm/asahi: g16: post the TA record before the FS record")
Fixes: f4e890353fcb ("drm/asahi: g16: expose g16_idle_power_off in sysfs and switch it at runtime")
Fixes: 0dec7bc7edd1 ("drm/asahi: g16: make the governor's idle floor a runtime parameter")
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
(cherry picked from commit 5cd2bf1c4923aef16bfd7c4b074bf75f5c9c3253)
---
 drivers/gpu/drm/asahi/g16/params.rs | 27 +++++++++++++++++----------
 1 file changed, 17 insertions(+), 10 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 9537820b91..1678dea9df 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -122,12 +122,14 @@ unsafe extern "C" fn idle_power_off_get(
     _kp: *const kernel::bindings::kernel_param,
 ) -> c_int {
     let level = IDLE_POWER_OFF.load(Ordering::Relaxed).min(2) as u8;
-    // SAFETY: the buffer holds PAGE_SIZE bytes; two are written. The core appends the newline.
+    // SAFETY: the buffer holds PAGE_SIZE bytes; three are written. The core adds nothing: the
+    // newline is ours, as in the standard getters.
     unsafe {
         *buffer.cast::<u8>() = b'0' + level;
-        *buffer.cast::<u8>().add(1) = 0;
+        *buffer.cast::<u8>().add(1) = b'\n';
+        *buffer.cast::<u8>().add(2) = 0;
     }
-    1
+    2
 }
 
 static IDLE_POWER_OFF_OPS: kernel::bindings::kernel_param_ops = kernel::bindings::kernel_param_ops {
@@ -267,12 +269,14 @@ unsafe extern "C" fn idle_floor_get(
     _kp: *const kernel::bindings::kernel_param,
 ) -> c_int {
     let state = idle_floor() as u8;
-    // SAFETY: the buffer holds PAGE_SIZE bytes; two are written. The core appends the newline.
+    // SAFETY: the buffer holds PAGE_SIZE bytes; three are written. The core adds nothing: the
+    // newline is ours, as in the standard getters.
     unsafe {
         *buffer.cast::<u8>() = b'0' + state;
-        *buffer.cast::<u8>().add(1) = 0;
+        *buffer.cast::<u8>().add(1) = b'\n';
+        *buffer.cast::<u8>().add(2) = 0;
     }
-    1
+    2
 }
 
 static IDLE_FLOOR_OPS: kernel::bindings::kernel_param_ops = kernel::bindings::kernel_param_ops {
@@ -384,12 +388,15 @@ unsafe extern "C" fn live_u32_get(
         }
     }
     for (i, digit) in digits[..n].iter().rev().enumerate() {
-        // SAFETY: the buffer holds PAGE_SIZE bytes; at most 11 are written.
+        // SAFETY: the buffer holds PAGE_SIZE bytes; at most 12 are written.
         unsafe { *buffer.cast::<u8>().add(i) = *digit };
     }
-    // SAFETY: as above. The core appends the newline.
-    unsafe { *buffer.cast::<u8>().add(n) = 0 };
-    n as c_int
+    // SAFETY: as above. The core adds nothing: the newline is ours, as in the standard getters.
+    unsafe {
+        *buffer.cast::<u8>().add(n) = b'\n';
+        *buffer.cast::<u8>().add(n + 1) = 0;
+    }
+    (n + 1) as c_int
 }
 
 static LIVE_U32_OPS: kernel::bindings::kernel_param_ops = kernel::bindings::kernel_param_ops {
-- 
2.43.0

