+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Check the gated T8132 system level cache write-back in the MCC driver.
+
+The write-back (both multicast apertures to 0, then each of the four planes
+polled down to 0, a timeout refusing the sleep) may only run at a
+firmware-driven suspend, on an enabled cache, and for T8132 only when
+apple_mcc.t8132_writeback is set (default off) and the boot can commit a
+T8132 sleep (apple_cpu_t8132_dse_allowed()). Suspend-to-idle and every case
+with the parameter off must return before any register is touched, as before
+the write-back existed. The resume turns T8132's cache back on through its
+own enable.
+"""
+import argparse
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+MCC = 'drivers/soc/apple/mcc.c'
+SUSPEND = 'static int apple_mcc_suspend_noirq(struct device *dev)'
+RESUME = 'static int apple_mcc_resume_noirq(struct device *dev)'
+DISABLE = 'static int apple_mcc_disable_t8132(struct apple_mcc *mcc)'
+GATE = '\tif (mcc->retained && !apple_mcc_t8132_writeback())\n\t\treturn 0;\n'
+FIRST = '\tif (!pm_suspend_via_firmware() || !mcc->enabled)\n\t\treturn 0;\n'
+# name: (function head or None, old, new)
+MUTATIONS = {
+    'param-on': (None, 'static bool t8132_writeback;', 'static bool t8132_writeback = true;'),
+    'no-dse': (None, 'READ_ONCE(t8132_writeback) && apple_cpu_t8132_dse_allowed()', 'READ_ONCE(t8132_writeback)'),
+    'non-arm64-on': (None, '#else\n\treturn false;\n#endif', '#else\n\treturn true;\n#endif'),
+    'no-gate': (SUSPEND, GATE, ''),
+    's2idle-runs': (SUSPEND, FIRST, '\tif (!mcc->enabled)\n\t\treturn 0;\n'),
+    'gate-after-act': (SUSPEND, GATE + '\tif (mcc->retained) {\n\t\tret = apple_mcc_disable_t8132(mcc);\n',
+                       '\tif (mcc->retained) {\n\t\tret = apple_mcc_disable_t8132(mcc);\n' + GATE),
+    'one-aperture': (DISABLE, '\twritel(0, mcc->planes[1] + 0x1c1c00);\n', ''),
+    'no-barrier': (DISABLE, '\tmb();\n', ''),
+    'three-planes': (DISABLE, 'for (p = 0; p < 4; p++)', 'for (p = 0; p < 3; p++)'),
+    'timeout-ignored': (DISABLE, '\t\t\treturn -ETIMEDOUT;', '\t\t\tbreak;'),
+    'refusal-swallowed': (SUSPEND, '\t\tret = apple_mcc_disable_t8132(mcc);\n\t\tif (ret)\n\t\t\treturn ret;\n',
+                          '\t\tret = apple_mcc_disable_t8132(mcc);\n'),
+    'resume-wrong-enable': (RESUME, 'ret = mcc->retained ? apple_mcc_enable_t8132(mcc) : apple_mcc_enable(mcc);',
+                            'ret = apple_mcc_enable(mcc);'),
+}
+
+
+def fn_body(src, head):
+    at = src.index(head)
+    return src[at:src.index('\n}\n', at)]
+
+
+def check(src):
+    assert re.search(r'^static bool t8132_writeback;$', src, re.M), 'Assertion failed: t8132_writeback must default to off'
+    assert 'module_param(t8132_writeback, bool, 0644);' in src
+    hp = fn_body(src, 'static bool apple_mcc_t8132_writeback(void)')
+    assert '#ifdef CONFIG_ARM64\n\treturn READ_ONCE(t8132_writeback) && apple_cpu_t8132_dse_allowed();\n#else\n\treturn false;\n#endif' in hp, \
+        'Assertion failed: the write-back needs the parameter AND a boot that can commit (and never off arm64)'
+    sp = fn_body(src, SUSPEND)
+    first, gate = sp.find(FIRST), sp.find(GATE)
+    act = sp.find('ret = apple_mcc_disable_t8132(mcc);')
+    assert 0 <= first < gate < act, 'Assertion failed: firmware/enabled check, then the T8132 gate, then the write-back'
+    pre = sp[:gate]
+    assert not re.search(r'writel|readl|apple_mcc_quiesce|apple_mcc_disable', pre), \
+        'Assertion failed: nothing may touch the cache before the gate'
+    assert '\t\tret = apple_mcc_disable_t8132(mcc);\n\t\tif (ret)\n\t\t\treturn ret;\n\t\tmcc->enabled = false;' in sp, \
+        'Assertion failed: a write-back that does not finish must refuse the sleep, and only a finished one turns the cache off'
+    assert sp.find('mcc->sleep_disabled = true;') > act, 'Assertion failed: the resume must know the cache was turned off'
+    dp = fn_body(src, DISABLE)
+    w0, w1 = dp.find('writel(0, mcc->planes[0] + 0x1c1c00);'), dp.find('writel(0, mcc->planes[1] + 0x1c1c00);')
+    b, loop = dp.find('\tmb();\n'), dp.find('for (p = 0; p < 4; p++)')
+    assert 0 <= w0 < w1 < b < loop, 'Assertion failed: both apertures to 0, a barrier, then the four planes polled'
+    assert 'return -ETIMEDOUT;' in dp[loop:], 'Assertion failed: a plane that does not drain must refuse'
+    rp = fn_body(src, RESUME)
+    assert 'if (!mcc->sleep_disabled)\n\t\treturn 0;' in rp and \
+        'ret = mcc->retained ? apple_mcc_enable_t8132(mcc) : apple_mcc_enable(mcc);' in rp, \
+        'Assertion failed: the resume must turn T8132\'s cache on through its own enable, and only after a write-back'
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path)
+    parser.add_argument('--mutation', choices=MUTATIONS)
+    args = parser.parse_args()
+    src = (ROOT / MCC).read_text()
+    if args.mutation:
+        head, old, new = MUTATIONS[args.mutation]
+        at = src.index(head) if head else 0
+        end = src.index('\n}\n', at) if head else len(src)
+        assert old in src[at:end], f'missing mutation site: {old}'
+        src = src[:at] + src[at:end].replace(old, new, 1) + src[end:]
+    try:
+        check(src)
+    except (AssertionError, ValueError, AttributeError) as e:
+        print(e if str(e).startswith('Assertion') else f'Assertion failed: {e}')
+        raise SystemExit(1)
+    line = ('t8132 cache write-back: only at a firmware-driven suspend with apple_mcc.t8132_writeback on and a boot '
+            'that can commit; both apertures, a barrier, four planes polled, a timeout refuses; off and s2idle touch nothing')
+    if args.out:
+        args.out.write_text(line + '\n')
+    print(line)
+
+
+if __name__ == '__main__':
+    main()
