From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 21:44:12 +0000
Subject: [PATCH] drm/asahi: g16: Optionally set two FS words as macOS
 does

On macOS an application's render.light FS record differs from ours in
two size-independent words: bit 16 of the tile mode (register 0x10039,
0x10280 against our 0x280) and bit 0 of the ISP control (register
0x15021, 0xc001 against our 0xc000). WindowServer's full-screen
renders leave both clear, so they follow the render, not the OS.

Add g16_fs_tile_bit16 and g16_fs_isp_bit0, runtime switches read per
render, which set the bit in the register table entry and in the copy
at the fixed FS offset (+0x9d8 and +0x9c0). Both default to off, which
leaves the records unchanged.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/engine.rs | 17 ++++++++++++++
 drivers/gpu/drm/asahi/g16/params.rs | 36 +++++++++++++++++++++++++++++
 2 files changed, 53 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index b796d7ad02..a24df89ba8 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -2030,6 +2030,23 @@ fn prefix_render(
                 .ok_or(EINVAL)?
                 .copy_from_slice(&u32::from(cmd.cmd.sample_size_B).to_le_bytes());
         }
+        // g16_fs_tile_bit16 / g16_fs_isp_bit0: the two FS words where macOS's application
+        // renders differ from ours; each is in the register table and at a fixed offset.
+        for (on, sel, bit, at) in [
+            (params::fs_tile_bit16(), 0x10039, 1 << 16, 0x9d8),
+            (params::fs_isp_bit0(), 0x15021, 1, 0x9c0),
+        ] {
+            if !on {
+                continue;
+            }
+            let i = work::fs::SEL.iter().position(|&s| s == sel).ok_or(EINVAL)?;
+            for at in [work::fs::REGS + work::REG_RECORD * i + 4, at] {
+                let w = scratch.fs.get_mut(at..at + 8).ok_or(EINVAL)?;
+                let mut v = [0u8; 8];
+                v.copy_from_slice(w);
+                w.copy_from_slice(&(u64::from_le_bytes(v) | bit).to_le_bytes());
+            }
+        }
         encode::render_attachments(&mut scratch.tas[..], 0, &cmd.vertex_attachments);
         encode::render_attachments(&mut scratch.fss[..], 1, &cmd.fragment_attachments);
         params::render_patch_apply(&mut scratch.tas[..], &mut scratch.fss[..]);
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 202a8ae533..dead195160 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -947,6 +947,42 @@ pub(crate) fn fs_sample_size() -> bool {
     "G16: write the tile-buffer sample size into the FS record (+0xa30) as the G15 backend does (default 0: left 0; 1: written; runtime 0644)"
 );
 
+/// Storage of `g16_fs_tile_bit16` (runtime 0644, default 0).
+static FS_TILE_BIT16: AtomicU32 = AtomicU32::new(0);
+
+/// Whether each FS record sets bit 16 of its tile mode word (register 0x10039 and +0x9d8), as
+/// macOS 26B123 does on an application's renders (0x10280 against WindowServer's 0x280).
+pub(crate) fn fs_tile_bit16() -> bool {
+    FS_TILE_BIT16.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    FS_TILE_BIT16_PARAM,
+    FS_TILE_BIT16_PARMTYPE,
+    FS_TILE_BIT16_PARM,
+    FS_TILE_BIT16,
+    "g16_fs_tile_bit16",
+    "G16: set bit 16 of the FS tile mode word (register 0x10039, +0x9d8) as macOS does on application renders (default 0: off; 1: set; runtime 0644, read per render)"
+);
+
+/// Storage of `g16_fs_isp_bit0` (runtime 0644, default 0).
+static FS_ISP_BIT0: AtomicU32 = AtomicU32::new(0);
+
+/// Whether each FS record sets bit 0 of its ISP control word (register 0x15021 and +0x9c0), as
+/// macOS 26B123 does on an application's renders (0xc001 against our 0xc000).
+pub(crate) fn fs_isp_bit0() -> bool {
+    FS_ISP_BIT0.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    FS_ISP_BIT0_PARAM,
+    FS_ISP_BIT0_PARMTYPE,
+    FS_ISP_BIT0_PARM,
+    FS_ISP_BIT0,
+    "g16_fs_isp_bit0",
+    "G16: set bit 0 of the FS ISP control word (register 0x15021, +0x9c0) as macOS does on application renders (default 0: off; 1: set; runtime 0644, read per render)"
+);
+
 /// Storage of `g16_job_ahead` (runtime 0644, default 0).
 static JOB_AHEAD: AtomicU32 = AtomicU32::new(0);
 
-- 
