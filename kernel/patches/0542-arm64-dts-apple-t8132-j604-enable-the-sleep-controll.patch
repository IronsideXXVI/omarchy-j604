From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 08:05:32 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: enable the sleep
 controller

As upstream has it, keep the T8132 sleep controller disabled in
t8132.dtsi and enable it per machine. Enable it on the J604, which
already turns on both CPU clusters' power gates that a deep sleep
needs.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 5 +++++
 arch/arm64/boot/dts/apple/t8132.dtsi     | 1 +
 2 files changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 0549485d29..0dd5c26808 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -433,3 +433,8 @@ opp-4464000000 {
 		/delete-property/ turbo-mode;
 	};
 };
+
+/* Deep sleep: the T8132 sleep controller, as the J713 enables it upstream. */
+&sleep {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 25d89d3ccb..0f8ee8a517 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -624,6 +624,7 @@ sleep: sleep-controller@380700000 {
 			apple,apcie = <&pcie0>;
 			/* The ADT has no no-restore-gpio-pins here: every pin goes back. */
 			apple,pinctrl = <&pinctrl_ap>;
+			status = "disabled";
 		};
 
 		wdt: watchdog@3882b0000 {
-- 
2.43.0

