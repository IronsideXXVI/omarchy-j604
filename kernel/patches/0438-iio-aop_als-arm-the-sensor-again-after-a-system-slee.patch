+use core::{
+    ffi::{c_int, c_void},
+    ptr,
+};
 use kernel::{
     bindings, c_str,
-    device::Core,
+    device::{self, Core},
     firmware::Firmware,
     iio::common::aop_sensors::{AopSensorData, IIORegistration, MessageProcessor, MICRO},
     module_platform_driver, of, platform,
     prelude::*,
     soc::apple::aop::{EPICService, FakehidRegistration, AOP},
-    sync::Arc,
+    sync::{
+        aref::ARef,
+        atomic::{Atomic, Relaxed},
