From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 17:30:33 +0000
Subject: [PATCH] efi/libstub: arm64: report an Image outside aura's
 execute window

aura publishes /chosen/aurora,ctxr-exec-window, a base and a size, for
an OS it started from its boot object. That OS must run its code from
inside the window, and the loader puts the Image there: U-Boot serves a
UKI's kernel from the window.

After the stub has placed the Image, warn if the property is present and
the Image is not inside the window. The check places nothing and fails
nothing; a first boot then says whether the loader or the kernel missed
the window. Without the property nothing changes.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/firmware/efi/libstub/arm64-stub.c | 43 +++++++++++++++++++++--
 1 file changed, 40 insertions(+), 3 deletions(-)

diff --git a/drivers/firmware/efi/libstub/arm64-stub.c b/drivers/firmware/efi/libstub/arm64-stub.c
index 2c38693561..04caa0500b 100644
--- a/drivers/firmware/efi/libstub/arm64-stub.c
+++ b/drivers/firmware/efi/libstub/arm64-stub.c
@@ -8,12 +8,45 @@
 
 
 #include <linux/efi.h>
+#include <linux/libfdt.h>
 #include <asm/efi.h>
 #include <asm/memory.h>
 #include <asm/sections.h>
 
 #include "efistub.h"
 
+/*
+ * aura publishes /chosen/aurora,ctxr-exec-window, a base and a size, for an
+ * OS it started from its boot object: that OS must run its code from inside
+ * the window, and the loader is the one to put the Image there. Only report
+ * a loader that did not, so a first boot says which side failed.
+ */
+static void efi_check_ctxr_window(unsigned long image_addr,
+				  unsigned long image_memsize)
+{
+	unsigned long fdt_size;
+	const fdt64_t *prop;
+	u64 base, size;
+	int node, len;
+	void *fdt;
+
+	fdt = get_fdt(&fdt_size);
+	if (!fdt)
+		return;
+	node = fdt_path_offset(fdt, "/chosen");
+	if (node < 0)
+		return;
+	prop = fdt_getprop(fdt, node, "aurora,ctxr-exec-window", &len);
+	if (!prop || len != 2 * sizeof(*prop))
+		return;
+	base = fdt64_to_cpu(prop[0]);
+	size = fdt64_to_cpu(prop[1]);
+	if (image_addr < base || image_memsize > size ||
+	    image_addr - base > size - image_memsize)
+		efi_warn("Image at 0x%lx is outside the execute window [0x%llx, +0x%llx): the loader did not place it\n",
+			 image_addr, base, size);
+}
+
 efi_status_t handle_kernel_image(unsigned long *image_addr,
 				 unsigned long *image_size,
 				 unsigned long *reserve_addr,
@@ -22,6 +55,7 @@ efi_status_t handle_kernel_image(unsigned long *image_addr,
 				 efi_handle_t image_handle)
 {
 	unsigned long kernel_size, kernel_codesize, kernel_memsize;
+	efi_status_t status;
 
 	if (image->image_base != _text) {
 		efi_err("FIRMWARE BUG: efi_loaded_image_t::image_base has bogus value\n");
@@ -38,9 +72,12 @@ efi_status_t handle_kernel_image(unsigned long *image_addr,
 	*reserve_size = kernel_memsize;
 	*image_addr = (unsigned long)_text;
 
-	return efi_kaslr_relocate_kernel(image_addr, reserve_addr, reserve_size,
-					 kernel_size, kernel_codesize, kernel_memsize,
-					 efi_kaslr_get_phys_seed(image_handle));
+	status = efi_kaslr_relocate_kernel(image_addr, reserve_addr, reserve_size,
+					   kernel_size, kernel_codesize, kernel_memsize,
+					   efi_kaslr_get_phys_seed(image_handle));
+	if (status == EFI_SUCCESS)
+		efi_check_ctxr_window(*image_addr, kernel_memsize);
+	return status;
 }
 
 asmlinkage void primary_entry(void);
-- 
2.43.0

