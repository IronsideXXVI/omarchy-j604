From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:14 -0500
Subject: [PATCH] soc: apple: set the CPU clusters' power-gate enables at boot

Each CPU cluster has a PMGR word whose top bit lets its cores power down
in WFI. A core that PMGR powers on comes up allowed to, but the boot CPU
was started by the boot ROM and only follows the word, which iBoot
leaves clear for T8140's P cluster. Without it the boot CPU only
clock-gates in WFI, and a system sleep's engine, which waits for every
core to power down, never starts: measured on a J700, the watchdog reset
the machine 5 s into every sleep until this bit was set, and with it set
the boot CPU power-gates in idle too.

An early initcall sets the bit in every word an apple,cluster-pwrgate
node lists, before the secondaries start.

Signed-off-by: Diljit Singh <hey@djdev.me>

[j604 backport: Makefile: kept our apple-sleep/apple-s2r lines beside the new one]
Assisted-by: Claude:claude-opus-5.5

---
 drivers/soc/apple/Kconfig                 | 10 +++++
 drivers/soc/apple/Makefile                |  1 +
 drivers/soc/apple/apple-cluster-pwrgate.c | 50 +++++++++++++++++++++++
 3 files changed, 61 insertions(+)
 create mode 100644 drivers/soc/apple/apple-cluster-pwrgate.c

diff --git a/drivers/soc/apple/Kconfig b/drivers/soc/apple/Kconfig
index 9e6788ed4c..66eb055b2a 100644
--- a/drivers/soc/apple/Kconfig
+++ b/drivers/soc/apple/Kconfig
@@ -83,6 +83,16 @@ config APPLE_S2R
 	  Off unless enabled with apple_s2r.enable=1 on the kernel
 	  command line.
 
+config APPLE_CLUSTER_PWRGATE
+	bool "Apple SoC CPU cluster power gates"
+	depends on OF
+	default ARCH_APPLE
+	help
+	  Sets the power-gate enable of each CPU cluster the device tree
+	  lists, early in boot. Without it, a core that the boot loader
+	  started and PMGR never powered on, such as the boot CPU, only
+	  clock-gates in WFI.
+
 config APPLE_RTKIT
 	tristate "Apple RTKit co-processor IPC protocol"
 	depends on APPLE_MAILBOX
diff --git a/drivers/soc/apple/Makefile b/drivers/soc/apple/Makefile
index 3158c687b9..d9f12314d6 100644
--- a/drivers/soc/apple/Makefile
+++ b/drivers/soc/apple/Makefile
@@ -10,6 +10,7 @@ obj-$(CONFIG_APPLE_PMGR_MISC)	+= apple-pmgr-misc.o
 
 obj-$(CONFIG_APPLE_SLEEP)	+= apple-sleep.o
 obj-$(CONFIG_APPLE_S2R)		+= apple-s2r.o
+obj-$(CONFIG_APPLE_CLUSTER_PWRGATE) += apple-cluster-pwrgate.o
 
 obj-$(CONFIG_APPLE_RTKIT) += apple-rtkit.o
 apple-rtkit-y = rtkit.o rtkit-crashlog.o
diff --git a/drivers/soc/apple/apple-cluster-pwrgate.c b/drivers/soc/apple/apple-cluster-pwrgate.c
new file mode 100644
index 0000000000..67d493cff8
--- /dev/null
+++ b/drivers/soc/apple/apple-cluster-pwrgate.c
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Apple SoC CPU cluster power gates
+ *
+ * Each CPU cluster has a PMGR word whose top bit lets its cores power down
+ * in WFI. A core PMGR powers on comes up allowed to, but the boot CPU was
+ * started by the boot ROM, so it only follows the word, which the boot
+ * loader may leave clear. Set it for every cluster the device tree lists.
+ */
+
+#include <linux/bits.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/printk.h>
+
+#define CLUSTER_PWRGATE_EN	BIT(31)
+
+static const struct of_device_id apple_cluster_pwrgate_of_match[] __initconst = {
+	{ .compatible = "apple,cluster-pwrgate" },
+	{ }
+};
+
+/* Before the secondaries start. A core picks the word up at its next WFI. */
+static int __init apple_cluster_pwrgate_init(void)
+{
+	struct device_node *np;
+
+	for_each_matching_node(np, apple_cluster_pwrgate_of_match) {
+		void __iomem *gate;
+		int i;
+
+		if (!of_device_is_available(np))
+			continue;
+
+		/* One word per cluster. Shared with the sleep code, so not claimed. */
+		for (i = 0; (gate = of_iomap(np, i)); i++) {
+			u32 was = readl(gate);
+
+			writel(was | CLUSTER_PWRGATE_EN, gate);
+			pr_debug("%pOF: cluster %d power gate %#x, now %#x\n", np, i, was,
+				 readl(gate));
+			iounmap(gate);
+		}
+	}
+
+	return 0;
+}
+early_initcall(apple_cluster_pwrgate_init);
