From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 4 Nov 2026 21:52:07 -0500
Subject: [PATCH] arm64: dts: apple: t8132: add the display crossbars

Describe the display crossbar of each ATC, disabled. Boards enable them
with the external display coprocessors whose Type-C routes use them.

Signed-off-by: Erik Bourget <erik@ebourget.net>

(backported from commit a1d5e9ba6146cc427bfb4d20a71581486a1e92ec)
[j604: the nodes go in front of dwc3_0_dart_0 and dwc3_1_dart_0 as
 upstream, re-indented: in this tree the ATC nodes sit inside &soc. The
 addresses match the J604 ADT (arm-io/atc0-dpxbar, atc1-dpxbar).]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 4eb29d0852..cf440c54e5 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -925,6 +925,18 @@
 			status = "disabled";
 		};
 
+		/*
+		 * The ATC's display crossbar. Boards enable it with the external
+		 * display coprocessors whose Type-C routes use it.
+		 */
+		atc0_dpxbar: mux@40304c000 {
+			compatible = "apple,t8132-display-crossbar";
+			reg = <0x4 0x0304c000 0x0 0x4000>;
+			#mux-control-cells = <1>;
+			power-domains = <&ps_atc0_usb>;
+			status = "disabled";
+		};
+
 		dwc3_0_dart_0: iommu@402f00000 {
 			compatible = "apple,t8132-dart", "apple,t8110-dart";
 			reg = <0x4 0x02f00000 0x0 0xc000>;
@@ -977,6 +989,18 @@
 			status = "disabled";
 		};
 
+		/*
+		 * The ATC's display crossbar. Boards enable it with the external
+		 * display coprocessors whose Type-C routes use it.
+		 */
+		atc1_dpxbar: mux@40b04c000 {
+			compatible = "apple,t8132-display-crossbar";
+			reg = <0x4 0x0b04c000 0x0 0x4000>;
+			#mux-control-cells = <1>;
+			power-domains = <&ps_atc1_usb>;
+			status = "disabled";
+		};
+
 		dwc3_1_dart_0: iommu@40af00000 {
 			compatible = "apple,t8132-dart", "apple,t8110-dart";
 			reg = <0x4 0x0af00000 0x0 0xc000>;
