From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 10:02:15 +0000
Subject: [PATCH] drm/asahi: g16: Report the configured command cache
 mask at boot

Print the load-time mask when nonzero so a default-on build has an
explicit receipt without enabling generic parameter debug output.
Keep allocation policy and the zero-mask boot unchanged.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/initdata.rs | 4 ++++
 drivers/gpu/drm/asahi/g16/params.rs   | 7 ++++++-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/asahi/g16/initdata.rs b/drivers/gpu/drm/asahi/g16/initdata.rs
index 67a5c04072..7b7c238995 100644
--- a/drivers/gpu/drm/asahi/g16/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/initdata.rs
@@ -229,6 +229,10 @@ pub(crate) fn build(
     // The top row: S9 on J713, S10 on J773g.
     let ceiling = performance.count as u32 - 1;
     let max_khz = performance.frequency[ceiling as usize] * 1000;
+    let command_cache = super::params::fw_cached_mask();
+    if command_cache != 0 {
+        dev_info!(dev, "M4 initdata: g16_fw_cached={:#x}\n", command_cache);
+    }
     let cached = super::params::init_cached();
     if cached != 0 {
         dev_info!(
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 24355df51b..d431c648d8 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -663,11 +663,16 @@ pub(crate) fn main_nap() -> bool {
 /// blocks and work records. 25G83 cleans and invalidates queue info and scheduler contexts when a
 /// queue registers, and cleans each work block after its command; it does not invalidate work
 /// images, sequences or barriers before reading them. Whether every bit in `kind` is set. 0 (the
-/// default) keeps today's uncached classes for every kind.
+/// uncached selection) keeps today's uncached classes for every kind.
 pub(crate) fn fw_cached(kind: u32) -> bool {
     kind != 0 && module_parameters::g16_fw_cached.value() & kind == kind
 }
 
+/// The configured load-time command-object cache mask, for the boot receipt.
+pub(crate) fn fw_cached_mask() -> u32 {
+    module_parameters::g16_fw_cached.value()
+}
+
 /// `g16_ktrace_mask` (load time): the word written to CONTROL+0 at init. 25G83 copies it into
 /// its trace gate (0x192db4) from fn 0x3350, which INIT points at CONTROL through init-block
 /// +0xa8. Bit 0 enables the event-handler trace points, bit 1 the scheduler ones, bit 2 the power
-- 
2.43.0

