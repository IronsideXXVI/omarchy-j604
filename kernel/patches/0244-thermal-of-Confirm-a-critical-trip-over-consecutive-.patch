From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Tue, 3 Nov 2026 19:36:11 +1100
Subject: [PATCH] thermal: of: Confirm a critical trip over consecutive samples

A critical trip acts on the first reading at or above it. Some sensors
read a hot spot that follows power within a second: the SMC die maxima
of the Apple M4 Pro move by 9-10 C (one standard deviation) between
1 s samples under a mixed load, so one reading can shut the system down
while the die is well within its limits.

Add a critical-samples property for polled zones. With it, the core
acts on a critical trip only once that many updates in a row have read
at or above it, once per excursion; a reading below the trip starts the
count again. A sustained excursion still shuts down, after about that
many polling periods. Without the property, or with 1, nothing changes.
A zone that is not polled cannot count updates and keeps acting on the
first reading.

The counting lives in a helper in thermal_core.h, which KUnit tests
cover: first-sample behaviour, a confirmed run acting once, single
excursions among lower readings never acting, re-arming after a drop
and counter saturation.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>

(cherry picked from commit 4efb8c012f6c5b4718df3f2b5b0de8e222102b7d)
[j604 backport: non-built files kept as in our tree: Documentation/devicetree/bindings/thermal/thermal-zones.yaml]
Assisted-by: Claude:claude-opus-5.5
---
 drivers/thermal/Kconfig                      | 10 +++
 drivers/thermal/thermal_core.c               | 42 ++++++++++-
 drivers/thermal/thermal_core.h               | 25 +++++++
 drivers/thermal/thermal_core_critical_test.c | 78 ++++++++++++++++++++
 drivers/thermal/thermal_of.c                 |  2 +
 include/linux/thermal.h                      |  6 ++
 6 files changed, 161 insertions(+), 2 deletions(-)
 create mode 100644 drivers/thermal/thermal_core_critical_test.c

diff --git a/drivers/thermal/Kconfig b/drivers/thermal/Kconfig
index 40c4be5354..d7d03fa915 100644
--- a/drivers/thermal/Kconfig
+++ b/drivers/thermal/Kconfig
@@ -184,6 +184,16 @@ config THERMAL_GOV_POWER_ALLOCATOR_KUNIT_TEST
 	  The tests use synthetic thermal zones and do not need hardware.
 	  Only useful for kernel developers; say N unless testing the governor.
 
+config THERMAL_CRITICAL_SAMPLES_KUNIT_TEST
+	bool "KUnit tests for critical trip confirmation" if !KUNIT_ALL_TESTS
+	depends on KUNIT=y
+	default KUNIT_ALL_TESTS
+	help
+	  Test that a zone with critical-samples acts on a critical trip only
+	  after that many consecutive updates at or above it, once, and again
+	  only after it has dropped below the trip. The tests need no hardware.
+	  Only useful for kernel developers; say N unless testing the core.
+
 config CPU_THERMAL
 	bool "Generic cpu cooling support"
 	depends on THERMAL_OF
diff --git a/drivers/thermal/thermal_core.c b/drivers/thermal/thermal_core.c
index 1fb8c74342..6bd642c1b8 100644
--- a/drivers/thermal/thermal_core.c
+++ b/drivers/thermal/thermal_core.c
@@ -407,6 +407,37 @@ static void thermal_governor_trip_crossed(struct thermal_governor *governor,
 		governor->trip_crossed(tz, trip, upward);
 }
 
+/*
+ * A zone with critical_samples above one acts on a critical trip only once
+ * that many updates in a row have read at or above it, so that one noisy
+ * sample cannot shut the system down. Polling keeps the updates coming.
+ */
+static bool thermal_zone_confirms_critical(struct thermal_zone_device *tz)
+{
+	return tz->tzp && tz->tzp->critical_samples > 1 &&
+	       (tz->polling_delay_jiffies || tz->passive_delay_jiffies);
+}
+
+static void thermal_zone_confirm_critical(struct thermal_zone_device *tz)
+{
+	struct thermal_trip_desc *td;
+
+	if (!thermal_zone_confirms_critical(tz))
+		return;
+
+	for_each_trip_desc(tz, td) {
+		const struct thermal_trip *trip = &td->trip;
+
+		if (trip->type != THERMAL_TRIP_CRITICAL)
+			continue;
+
+		if (thermal_critical_confirm(&td->critical_count, tz->temperature,
+					     trip->temperature,
+					     tz->tzp->critical_samples))
+			handle_critical_trips(tz, trip);
+	}
+}
+
 static void thermal_trip_crossed(struct thermal_zone_device *tz,
 				 struct thermal_trip_desc *td,
 				 struct thermal_governor *governor,
@@ -417,8 +448,9 @@ static void thermal_trip_crossed(struct thermal_zone_device *tz,
 	if (upward) {
 		if (trip->type == THERMAL_TRIP_PASSIVE)
 			tz->passive++;
-		else if (trip->type == THERMAL_TRIP_CRITICAL ||
-			 trip->type == THERMAL_TRIP_HOT)
+		else if (trip->type == THERMAL_TRIP_HOT ||
+			 (trip->type == THERMAL_TRIP_CRITICAL &&
+			  !thermal_zone_confirms_critical(tz)))
 			handle_critical_trips(tz, trip);
 
 		thermal_notify_tz_trip_up(tz, trip);
@@ -585,6 +617,8 @@ void __thermal_zone_device_update(struct thermal_zone_device *tz,
 
 	thermal_zone_handle_trips(tz, governor, &low, &high);
 
+	thermal_zone_confirm_critical(tz);
+
 	thermal_thresholds_handle(tz, &low, &high);
 
 	thermal_zone_set_trips(tz, low, high);
@@ -1949,3 +1983,7 @@ error:
 	return result;
 }
 postcore_initcall(thermal_init);
+
+#if IS_ENABLED(CONFIG_THERMAL_CRITICAL_SAMPLES_KUNIT_TEST)
+#include "thermal_core_critical_test.c"
+#endif
diff --git a/drivers/thermal/thermal_core.h b/drivers/thermal/thermal_core.h
index e98b0aa5aa..35ed94b0d5 100644
--- a/drivers/thermal/thermal_core.h
+++ b/drivers/thermal/thermal_core.h
@@ -11,6 +11,8 @@
 
 #include <linux/cleanup.h>
 #include <linux/device.h>
+#include <linux/limits.h>
+#include <linux/minmax.h>
 #include <linux/thermal.h>
 
 #include "thermal_netlink.h"
@@ -34,8 +36,31 @@ struct thermal_trip_desc {
 	struct list_head list_node;
 	struct list_head thermal_instances;
 	int threshold;
+	unsigned int critical_count;
 };
 
+/*
+ * thermal_critical_confirm - count updates at or above a critical trip
+ * @count:	consecutive updates at or above the trip so far
+ * @temp:	zone temperature of this update
+ * @trip_temp:	critical trip temperature
+ * @samples:	updates in a row that confirm the trip, 0 or 1 for the first
+ *
+ * Return: true on the update that confirms the trip, and only on that one:
+ * the zone has to drop below the trip and rise again to confirm it anew.
+ */
+static inline bool thermal_critical_confirm(unsigned int *count, int temp,
+					    int trip_temp, unsigned int samples)
+{
+	if (temp < trip_temp) {
+		*count = 0;
+		return false;
+	}
+	if (*count < UINT_MAX)
+		(*count)++;
+	return *count == max(samples, 1U);
+}
+
 /**
  * struct thermal_governor - structure that holds thermal governor information
  * @name:	name of the governor
diff --git a/drivers/thermal/thermal_core_critical_test.c b/drivers/thermal/thermal_core_critical_test.c
new file mode 100644
index 0000000000..0509aa53ad
--- /dev/null
+++ b/drivers/thermal/thermal_core_critical_test.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Included by thermal_core.c to exercise critical trip confirmation. */
+
+#include <kunit/test.h>
+
+static void thermal_critical_test_first_sample(struct kunit *test)
+{
+	unsigned int count = 0;
+
+	/* 0 and 1 keep the existing behaviour: the first sample acts. */
+	KUNIT_EXPECT_TRUE(test, thermal_critical_confirm(&count, 125000, 125000, 0));
+	count = 0;
+	KUNIT_EXPECT_TRUE(test, thermal_critical_confirm(&count, 125000, 125000, 1));
+}
+
+static void thermal_critical_test_consecutive(struct kunit *test)
+{
+	unsigned int count = 0;
+
+	KUNIT_EXPECT_FALSE(test, thermal_critical_confirm(&count, 126000, 125000, 3));
+	KUNIT_EXPECT_FALSE(test, thermal_critical_confirm(&count, 125000, 125000, 3));
+	KUNIT_EXPECT_TRUE(test, thermal_critical_confirm(&count, 130000, 125000, 3));
+	/* Confirmed once: staying above does not act again. */
+	KUNIT_EXPECT_FALSE(test, thermal_critical_confirm(&count, 130000, 125000, 3));
+	KUNIT_EXPECT_EQ(test, count, 4U);
+}
+
+static void thermal_critical_test_noise(struct kunit *test)
+{
+	static const int samples[] = {
+		119000, 126000, 117000, 125500, 110000, 127000, 124999, 128000,
+	};
+	unsigned int count = 0;
+	int i;
+
+	/* Single excursions separated by readings below the trip never act. */
+	for (i = 0; i < ARRAY_SIZE(samples); i++)
+		KUNIT_EXPECT_FALSE(test, thermal_critical_confirm(&count, samples[i],
+								  125000, 2));
+	KUNIT_EXPECT_EQ(test, count, 1U);
+}
+
+static void thermal_critical_test_rearm(struct kunit *test)
+{
+	unsigned int count = 0;
+
+	KUNIT_EXPECT_FALSE(test, thermal_critical_confirm(&count, 125000, 125000, 2));
+	KUNIT_EXPECT_TRUE(test, thermal_critical_confirm(&count, 125000, 125000, 2));
+	KUNIT_EXPECT_FALSE(test, thermal_critical_confirm(&count, 100000, 125000, 2));
+	KUNIT_EXPECT_EQ(test, count, 0U);
+	KUNIT_EXPECT_FALSE(test, thermal_critical_confirm(&count, 125000, 125000, 2));
+	KUNIT_EXPECT_TRUE(test, thermal_critical_confirm(&count, 125000, 125000, 2));
+}
+
+static void thermal_critical_test_saturates(struct kunit *test)
+{
+	unsigned int count = UINT_MAX - 1;
+
+	KUNIT_EXPECT_FALSE(test, thermal_critical_confirm(&count, 125000, 125000, 3));
+	KUNIT_EXPECT_FALSE(test, thermal_critical_confirm(&count, 125000, 125000, 3));
+	KUNIT_EXPECT_EQ(test, count, UINT_MAX);
+}
+
+static struct kunit_case thermal_critical_test_cases[] = {
+	KUNIT_CASE(thermal_critical_test_first_sample),
+	KUNIT_CASE(thermal_critical_test_consecutive),
+	KUNIT_CASE(thermal_critical_test_noise),
+	KUNIT_CASE(thermal_critical_test_rearm),
+	KUNIT_CASE(thermal_critical_test_saturates),
+	{}
+};
+
+static struct kunit_suite thermal_critical_test_suite = {
+	.name = "thermal_critical_samples",
+	.test_cases = thermal_critical_test_cases,
+};
+
+kunit_test_suite(thermal_critical_test_suite);
diff --git a/drivers/thermal/thermal_of.c b/drivers/thermal/thermal_of.c
index 6e870d217d..7dcd42f459 100644
--- a/drivers/thermal/thermal_of.c
+++ b/drivers/thermal/thermal_of.c
@@ -210,6 +210,8 @@ static void thermal_of_parameters_init(struct device_node *np,
 	of_property_read_u32(np, "integral-time-constant-ms",
 			     &tzp->integral_time_constant_ms);
 
+	of_property_read_u32(np, "critical-samples", &tzp->critical_samples);
+
 	/*
 	 * For now, the thermal framework supports only one sensor per
 	 * thermal zone. Thus, we are considering only the first two
diff --git a/include/linux/thermal.h b/include/linux/thermal.h
index ae83ddbb78..d99ac3103a 100644
--- a/include/linux/thermal.h
+++ b/include/linux/thermal.h
@@ -195,6 +195,12 @@ struct thermal_zone_params {
 
 	/* Integral time relative to k_pu, in ms; 0 keeps the per-poll estimate. */
 	u32 integral_time_constant_ms;
+
+	/*
+	 * Consecutive zone updates at or above a critical trip before it
+	 * acts; 0 or 1 act on the first. Only meaningful for a polled zone.
+	 */
+	u32 critical_samples;
 };
 
 /* Function declarations */
