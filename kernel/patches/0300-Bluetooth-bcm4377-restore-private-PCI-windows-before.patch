 tools/asahi/bcm4377-resume/fixture.h      |  10 ++
 tools/asahi/bcm4377-sleep-config-tests.c  | 120 ++++++++++++++++++++++
 tools/asahi/bcm4377-sleep-config-tests.py |  36 +++++++
 4 files changed, 167 insertions(+)
 create mode 100644 tools/asahi/bcm4377-sleep-config-tests.c
