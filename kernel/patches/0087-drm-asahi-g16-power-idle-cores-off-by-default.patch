From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 03:33:56 +0000
Subject: [PATCH] drm/asahi: g16: power idle cores off by default

macOS powers the M4 GPU cores off at idle: the GPU rail reads 0 mW at
the desktop under macOS 27.2, against about 278 mW on the J604 with the
qualified initdata. The firmware uses the same Globals layout as G17
region C, where idle_power_off at +0x30 is 1 by default. The G16 Globals
already carry the power-off delay of 40 at +0x9bc.

Make g16_idle_power_off default to 1. Booting with
asahi.g16_idle_power_off=0, or writing 0 to the sysfs node, restores the
qualified always-powered behaviour.

Taken only after the J604 GPU idle check passes. That check needs all
of the following:
- Globals +0x30 is published;
- the idle GPU rail is <= 50 mW;
- 120 Hz rendering is >= 119 fps;
- the first frame after idle costs <= +2 ms at p50 and <= 8.3 ms at max;
- there are no G16 health faults.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
(cherry picked from commit dc0336f6153f1a8f12f2d2b0654502e9005286f4)
(cherry picked from commit 0ad1709f648d5a12bbdc76312d33195426130bb7)
---
 drivers/gpu/drm/asahi/g16/params.rs | 9 +++++----
 drivers/gpu/drm/asahi/g16/power.rs  | 3 ++-
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 9394c421b2..5008bdc82d 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -56,8 +56,9 @@ pub(crate) fn sampler_heap() -> bool {
     *module_parameters::g16_sampler_heap.value() != 0
 }
 
-/// Default of `asahi.g16_idle_power_off`.
-pub(crate) const IDLE_POWER_OFF_DEFAULT: u32 = 0;
+/// Default of `asahi.g16_idle_power_off`: 1, the firmware powers idle cores off as under macOS
+/// (measured on the J604: idle GPU rail, 120 Hz rendering, first-frame latency and G16 health).
+pub(crate) const IDLE_POWER_OFF_DEFAULT: u32 = 1;
 
 /// Storage of `asahi.g16_idle_power_off`, always in 0..=2.
 static IDLE_POWER_OFF: AtomicU32 = AtomicU32::new(IDLE_POWER_OFF_DEFAULT);
@@ -168,11 +169,11 @@ const fn modinfo<const N: usize>(text: &[u8]) -> [u8; N] {
 #[cfg(MODULE)]
 const PARMTYPE: &[u8] = b"parmtype=g16_idle_power_off:u32\0";
 #[cfg(MODULE)]
-const PARM: &[u8] = b"parm=g16_idle_power_off:G16: idle core power-off (default 0; runtime 0644). 0: qualified 25G83 initdata (cores stay powered); 1: Globals +0x30 = 1 (G17 region C idle_power_off), also switchable at runtime; 2: 1 and clear the SGX +0xd06030 gating-disable bits before init (G17 pattern; boot only)\0";
+const PARM: &[u8] = b"parm=g16_idle_power_off:G16: idle core power-off (default 1; runtime 0644). 0: qualified 25G83 initdata (cores stay powered); 1: Globals +0x30 = 1 (G17 region C idle_power_off), also switchable at runtime; 2: 1 and clear the SGX +0xd06030 gating-disable bits before init (G17 pattern; boot only)\0";
 #[cfg(not(MODULE))]
 const BUILTIN_PARMTYPE: &[u8] = b"asahi.parmtype=g16_idle_power_off:u32\0";
 #[cfg(not(MODULE))]
-const BUILTIN_PARM: &[u8] = b"asahi.parm=g16_idle_power_off:G16: idle core power-off (default 0; runtime 0644)\0";
+const BUILTIN_PARM: &[u8] = b"asahi.parm=g16_idle_power_off:G16: idle core power-off (default 1; runtime 0644)\0";
 
 #[cfg(MODULE)]
 #[link_section = ".modinfo"]
diff --git a/drivers/gpu/drm/asahi/g16/power.rs b/drivers/gpu/drm/asahi/g16/power.rs
index fdb8da7093..51bb4da859 100644
--- a/drivers/gpu/drm/asahi/g16/power.rs
+++ b/drivers/gpu/drm/asahi/g16/power.rs
@@ -11,7 +11,8 @@
 //! The firmware runs at the published state, busy or not, so the host requests
 //! one from the GPU's busy share of each window, bounded by the ceiling.
 //!
-//! Under the qualified initdata (`g16_idle_power_off=0`, see `params::idle_power_off`)
+//! By default (`g16_idle_power_off=1`, see `params::idle_power_off`) the firmware
+//! powers the idle GPU cores off. Under the qualified initdata (`g16_idle_power_off=0`)
 //! the firmware keeps GFX powered while the GPU idles, so the host reports
 //! when it has work in flight to the DT-selected CLPC, which holds the memory
 //! and fabric floor for that work. A runtime change of `g16_idle_power_off`
