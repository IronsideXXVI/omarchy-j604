+/// `g16_main_macos` (load time): the index range of [`super::fw::initdata::main_macos::WORDS`]
+/// to write into Main after the encoder, `g16_main_macos_from..=g16_main_macos_to`, or `None`.
+pub(crate) fn main_macos() -> Option<(usize, usize)> {
+    if module_parameters::g16_main_macos.value() == 0 {
+        return None;
+    }
+    Some((
+        module_parameters::g16_main_macos_from.value() as usize,
+        module_parameters::g16_main_macos_to.value() as usize,
+    ))
+}
+
+/// Most `g16_main_poke` pairs.
+pub(crate) const MAIN_POKE_MAX: usize = 32;
+/// `g16_main_poke` pairs: offset in even cells, value in odd cells.
+static MAIN_POKE: [AtomicU32; 2 * MAIN_POKE_MAX] = [const { AtomicU32::new(0) }; 2 * MAIN_POKE_MAX];
+/// How many `g16_main_poke` pairs were accepted (all or none).
+static MAIN_POKE_N: AtomicU32 = AtomicU32::new(0);
+/// Set when `g16_main_poke` was given but rejected (malformed, misaligned or outside Main).
+static MAIN_POKE_BAD: AtomicU32 = AtomicU32::new(0);
+
+fn parse_u32(text: &str) -> Option<u32> {
+    let t = text.trim();
+    match t.strip_prefix("0x").or_else(|| t.strip_prefix("0X")) {
+        Some(hex) => u32::from_str_radix(hex, 16).ok(),
+        None => t.parse::<u32>().ok(),
+    }
+}
+
+/// `set` of `g16_main_poke`: "off:val,off:val,..." (hex with 0x or decimal), 32-bit words in
+/// Main, 4-byte aligned, at most [`MAIN_POKE_MAX`]. A bad list is ignored as a whole and reported
+/// at INIT; it never fails the module load.
+///
+/// # Safety
+///
+/// Called by the module-parameter core with `val` NULL or a NUL-terminated string.
+unsafe extern "C" fn main_poke_set(
+    val: *const c_char,
+    _kp: *const kernel::bindings::kernel_param,
+) -> c_int {
+    MAIN_POKE_N.store(0, Ordering::Relaxed);
+    MAIN_POKE_BAD.store(1, Ordering::Relaxed);
+    if val.is_null() {
+        return 0;
+    }
+    // SAFETY: `val` is a NUL-terminated string per the function contract.
+    let Ok(text) = unsafe { core::ffi::CStr::from_ptr(val) }.to_str() else {
+        return 0;
+    };
+    let size = super::fw::initdata::hwdata::SIZE as u32;
+    let mut n = 0;
+    for pair in text.split(',').filter(|p| !p.trim().is_empty()) {
+        let Some((a, v)) = pair.split_once(':') else {
+            return 0;
+        };
+        let (Some(at), Some(value)) = (parse_u32(a), parse_u32(v)) else {
+            return 0;
+        };
+        if n == MAIN_POKE_MAX || at % 4 != 0 || at.checked_add(4).is_none_or(|end| end > size) {
+            return 0;
+        }
+        MAIN_POKE[2 * n].store(at, Ordering::Relaxed);
+        MAIN_POKE[2 * n + 1].store(value, Ordering::Relaxed);
+        n += 1;
+    }
+    MAIN_POKE_N.store(n as u32, Ordering::Relaxed);
+    MAIN_POKE_BAD.store(0, Ordering::Relaxed);
+    0
+}
+
+static MAIN_POKE_OPS: kernel::bindings::kernel_param_ops = kernel::bindings::kernel_param_ops {
+    flags: 0,
+    set: Some(main_poke_set),
+    // Reads back the number of accepted pairs.
+    get: Some(live_u32_get),
+    free: None,
+};
+
+#[link_section = "__param"]
+#[used(compiler)]
+static MAIN_POKE_PARAM: kernel::module_param::KernelParam =
+    kernel::module_param::KernelParam::new(kernel::bindings::kernel_param {
+        name: kernel::str::as_char_ptr_in_const_context(if cfg!(MODULE) {
+            kernel::c_str!("g16_main_poke")
+        } else {
+            kernel::c_str!("asahi.g16_main_poke")
+        }),
+        // See IDLE_POWER_OFF_PARAM.
+        #[cfg(MODULE)]
+        mod_: (&raw const kernel::bindings::__this_module).cast_mut(),
+        #[cfg(not(MODULE))]
+        mod_: core::ptr::null_mut(),
+        ops: core::ptr::from_ref(&MAIN_POKE_OPS),
+        perm: 0o444,
+        level: -1,
+        flags: 0,
+        __bindgen_anon_1: kernel::bindings::kernel_param__bindgen_ty_1 {
+            arg: core::ptr::from_ref(&MAIN_POKE_N).cast_mut().cast(),
+        },
+    });
+
+#[cfg(MODULE)]
+const MAIN_POKE_TYPE: &[u8] = b"parmtype=g16_main_poke:charp\0";
+#[cfg(MODULE)]
+const MAIN_POKE_DESC: &[u8] =
+    b"parm=g16_main_poke:G16: off:val,... Main words written after the encoder (load time)\0";
+#[cfg(MODULE)]
+#[link_section = ".modinfo"]
+#[used(compiler)]
+static MAIN_POKE_PARMTYPE: [u8; MAIN_POKE_TYPE.len()] = modinfo(MAIN_POKE_TYPE);
+#[cfg(MODULE)]
+#[link_section = ".modinfo"]
+#[used(compiler)]
+static MAIN_POKE_PARM: [u8; MAIN_POKE_DESC.len()] = modinfo(MAIN_POKE_DESC);
+
+/// The accepted `g16_main_poke` pairs, and whether a given list was rejected.
+pub(crate) fn main_poke() -> ([(u32, u32); MAIN_POKE_MAX], usize, bool) {
+    let mut out = [(0, 0); MAIN_POKE_MAX];
+    let n = (MAIN_POKE_N.load(Ordering::Relaxed) as usize).min(MAIN_POKE_MAX);
+    for (i, pair) in out.iter_mut().enumerate().take(n) {
+        *pair = (
+            MAIN_POKE[2 * i].load(Ordering::Relaxed),
+            MAIN_POKE[2 * i + 1].load(Ordering::Relaxed),
+        );
+    }
+    (out, n, MAIN_POKE_BAD.load(Ordering::Relaxed) != 0)
+}
+
 /// `g16_main_nap` (load time): write the two Main words macOS 26B123 has on the J604 where ours
 /// keeps the J713's: +0xf38 = 1 and +0x2568 = the enabled core count. 25G83 reads +0xf38 at its
 /// init to register the perf-state completion interrupts (0x34420) and later both waits on them
