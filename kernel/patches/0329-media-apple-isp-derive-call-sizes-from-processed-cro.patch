From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sat, 31 Oct 2026 17:22:51 +1100
Subject: [PATCH] media: apple-isp: derive call sizes from processed crop
 extents

Add common call resolutions when an established processed crop contains
an exact-aspect, chroma-aligned crop at least as large as the output.
Keep the sensor configuration, pixel-format eligibility and original
preset order, and avoid duplicate sizes. Also offer a sensor-sized
square and smaller 4:3 outputs when larger call sizes do not fit.

Do not use sensor input heights as output capabilities: they can include
stacked exposures. Leave sizes requiring enlargement or unestablished
crop extents unavailable. Add KUnit tests for geometry and size tables,
and document enumeration and capture qualification.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit aaab795be06fc5bb03d974aca636dc5012e72fe7)
---
 .../media/drivers/apple-isp-j616s.rst         |  51 ++++++++
 .../media/platform/apple/isp/isp-cam-test.c   | 112 ++++++++++++++++++
 drivers/media/platform/apple/isp/isp-cam.c    | 104 ++++++++++++++++
 3 files changed, 267 insertions(+)

diff --git a/Documentation/driver-api/media/drivers/apple-isp-j616s.rst b/Documentation/driver-api/media/drivers/apple-isp-j616s.rst
index c119fc86f5..5b0ddf5fe4 100644
--- a/Documentation/driver-api/media/drivers/apple-isp-j616s.rst
+++ b/Documentation/driver-api/media/drivers/apple-isp-j616s.rst
@@ -359,3 +359,54 @@ The T6040 device tree's current fixed TEXT/DATA reservations should eventually
 come from a bootloader handoff describing the loaded image and mapping lifetimes.
 They are firmware-build-specific. This change does not implement that handoff
 or replace those reservations with 25G76 addresses.
+
+Capture size enumeration
+------------------------
+
+The shared driver preserves the order of its device-tree presets and any
+validated firmware output modes. It then adds common video-call sizes that
+fit within those presets' processed crop extents. The added preset retains
+its source firmware configuration and pixel-format eligibility. Crops are
+centred on even coordinates, have the exact output aspect ratio and never
+require upscaling. Sensor input dimensions alone are not a processed output
+capability: input rows can contain stacked exposures.
+
+The common sizes include 640x480, 1280x720, 1920x1080, 1080x1920,
+1760x1328, 1328x1760, 1552x1552, 1280x960 and 960x1280. A sensor that
+cannot provide the larger square also gets the largest even square that
+fits its established crops. Existing sizes are not duplicated. This is a
+shared output policy, not a list indexed by board or sensor model.
+
+Neither the crop nor output-configuration command reports scaler limits
+or rotation support. The driver does not infer a larger processed image
+from raw input dimensions, rotate a portrait image into a landscape one,
+or advertise a size that requires enlargement. Consequently, an exact
+macOS size may remain unavailable even though a smaller size with the
+same aspect ratio can be offered.
+
+Read-only inspection on the running kernel::
+
+    v4l2-ctl -d /dev/video0 --list-formats-ext
+    v4l2-ctl -d /dev/video0 --log-status
+    dmesg | grep -A20 'sensor config'
+
+The status ioctl prints already cached firmware configuration replies;
+it does not start capture or send additional firmware queries. The cache
+is currently populated only on the existing supported P010 discovery path.
+A missing cache is not evidence that the sensor has no other modes.
+
+After booting a test kernel, enumerate again and qualify each added size
+that is actually offered. For example, for 640x480 NV12::
+
+    v4l2-ctl -d /dev/video0 \
+        --set-fmt-video=width=640,height=480,pixelformat=NV12 \
+        --get-fmt-video --stream-mmap=4 --stream-count=30 --stream-to=/dev/null
+    gst-launch-1.0 -v v4l2src device=/dev/video0 num-buffers=30 ! \
+        video/x-raw,format=NV12,width=640,height=480,framerate=30/1 ! \
+        fakesink sync=false
+
+Repeat with each added width and height and, when offered, P010. Check
+that the negotiated dimensions equal the requested dimensions: S_FMT may
+otherwise choose a nearby preset. Confirm 30 completed frames, correct
+aspect ratio and chroma, and no new ISP or DART errors. Enumeration and unit tests do not establish successful capture at a
+new size; capture qualification must be performed separately.
diff --git a/drivers/media/platform/apple/isp/isp-cam-test.c b/drivers/media/platform/apple/isp/isp-cam-test.c
index f0be0f0fb2..b97fa7b06c 100644
--- a/drivers/media/platform/apple/isp/isp-cam-test.c
+++ b/drivers/media/platform/apple/isp/isp-cam-test.c
@@ -379,7 +379,119 @@ static void isp_test_command_ack_failures(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, state.calls, 0);
 }
 
+static void isp_test_call_crop(struct kunit *test)
+{
+	struct isp_preset source = {
+		.index = 7, .input_dim = { 1936, 1096 },
+		.output_dim = { 1920, 1080 }, .crop_offset = { 8, 8 },
+		.crop_size = { 1920, 1080 }, .p010 = true,
+	};
+	struct isp_preset result;
+
+	KUNIT_ASSERT_TRUE(test,
+			  isp_size_from_crop(&source, (struct coord){ 640, 480 }, &result));
+	KUNIT_EXPECT_EQ(test, result.index, 7);
+	KUNIT_EXPECT_TRUE(test, result.p010);
+	KUNIT_EXPECT_EQ(test, result.crop_offset.x, 248);
+	KUNIT_EXPECT_EQ(test, result.crop_offset.y, 8);
+	KUNIT_EXPECT_EQ(test, result.crop_size.x, 1440);
+	KUNIT_EXPECT_EQ(test, result.crop_size.y, 1080);
+	KUNIT_EXPECT_EQ(test, result.output_dim.x, 640);
+	KUNIT_EXPECT_EQ(test, result.output_dim.y, 480);
+}
+
+static void isp_test_call_crop_bounds(struct kunit *test)
+{
+	struct isp_preset source = {
+		.input_dim = { 1920, 2160 }, .output_dim = { 1920, 1080 },
+		.crop_size = { 1920, 1080 },
+	};
+	struct isp_preset result;
+	static const struct coord rejected[] = {
+		{ 1080, 1920 }, { 1760, 1328 }, { 1552, 1552 },
+		{ 1922, 1080 }, { 0, 480 }, { 641, 480 },
+	};
+
+	/* Stacked input rows do not make a portrait or a larger square. */
+	for (unsigned int i = 0; i < ARRAY_SIZE(rejected); i++)
+		KUNIT_EXPECT_FALSE(test, isp_size_from_crop(&source, rejected[i], &result));
+	source.crop_offset.x = 2;
+	KUNIT_EXPECT_FALSE(test,
+			   isp_size_from_crop(&source, (struct coord){ 640, 480 }, &result));
+	source.crop_offset.x = U32_MAX;
+	KUNIT_EXPECT_FALSE(test,
+			   isp_size_from_crop(&source, (struct coord){ 640, 480 }, &result));
+}
+
+static void isp_test_call_size_table(struct kunit *test)
+{
+	struct apple_isp *isp = isp_test_capture_alloc(test);
+	struct isp_preset source = {
+		.index = 7, .input_dim = { 1920, 1920 },
+		.output_dim = { 1920, 1920 }, .crop_size = { 1920, 1920 },
+	};
+
+	isp->presets = &source;
+	isp->num_presets = 1;
+	KUNIT_ASSERT_EQ(test, isp_add_call_sizes(isp), 0);
+	KUNIT_EXPECT_EQ(test, isp->num_presets, ARRAY_SIZE(isp_call_sizes) + 1);
+	KUNIT_EXPECT_EQ(test, isp->presets[0].output_dim.x, 1920);
+	KUNIT_EXPECT_EQ(test, isp->presets[0].output_dim.y, 1920);
+	for (unsigned int i = 0; i < ARRAY_SIZE(isp_call_sizes); i++) {
+		struct isp_preset *preset = &isp->presets[i + 1];
+
+		KUNIT_EXPECT_EQ(test, preset->output_dim.x, isp_call_sizes[i].x);
+		KUNIT_EXPECT_EQ(test, preset->output_dim.y, isp_call_sizes[i].y);
+		KUNIT_EXPECT_EQ(test, preset->index, 7);
+		KUNIT_EXPECT_FALSE(test, preset->p010);
+		KUNIT_EXPECT_EQ(test, preset->crop_size.x * preset->output_dim.y,
+				preset->crop_size.y * preset->output_dim.x);
+		KUNIT_EXPECT_EQ(test, (preset->crop_offset.x | preset->crop_offset.y |
+				       preset->crop_size.x | preset->crop_size.y) & 1, 0);
+		KUNIT_EXPECT_LE(test, preset->crop_offset.x + preset->crop_size.x, 1920);
+		KUNIT_EXPECT_LE(test, preset->crop_offset.y + preset->crop_size.y, 1920);
+	}
+	/* Rebuilding preserves order and never duplicates an existing size. */
+	KUNIT_ASSERT_EQ(test, isp_add_call_sizes(isp), 0);
+	KUNIT_EXPECT_EQ(test, isp->num_presets, ARRAY_SIZE(isp_call_sizes) + 1);
+}
+
+static void isp_test_call_size_capabilities(struct kunit *test)
+{
+	struct apple_isp *isp = isp_test_capture_alloc(test);
+	struct isp_preset sources[] = {
+		{ .index = 5, .input_dim = { 1920, 2160 },
+		  .output_dim = { 1920, 1080 }, .crop_size = { 1920, 1080 }, .p010 = true },
+		{ .index = 5, .input_dim = { 1920, 2160 },
+		  .output_dim = { 1280, 720 }, .crop_size = { 1280, 720 }, .p010 = true },
+		{ .index = 9, .input_dim = { 1536, 3024 },
+		  .output_dim = { 1536, 3024 }, .crop_size = { 1536, 3024 }, .p010 = true },
+	};
+
+	isp->presets = sources;
+	isp->num_presets = ARRAY_SIZE(sources);
+	KUNIT_ASSERT_EQ(test, isp_add_call_sizes(isp), 0);
+	KUNIT_EXPECT_EQ(test, isp->num_presets, 9);
+	for (unsigned int i = 0; i < ARRAY_SIZE(sources); i++)
+		KUNIT_EXPECT_MEMEQ(test, &isp->presets[i], &sources[i], sizeof(sources[i]));
+	for (unsigned int i = ARRAY_SIZE(sources); i < isp->num_presets; i++) {
+		struct isp_preset *preset = &isp->presets[i];
+
+		KUNIT_EXPECT_TRUE(test, preset->p010);
+		KUNIT_EXPECT_FALSE(test, preset->output_dim.x == 1760 &&
+				   preset->output_dim.y == 1328);
+		KUNIT_EXPECT_FALSE(test, preset->output_dim.x == 1552 &&
+				   preset->output_dim.y == 1552);
+	}
+	KUNIT_EXPECT_EQ(test, isp->presets[8].output_dim.x, 1536);
+	KUNIT_EXPECT_EQ(test, isp->presets[8].output_dim.y, 1536);
+}
+
 static struct kunit_case isp_cam_test_cases[] = {
+	KUNIT_CASE(isp_test_call_crop),
+	KUNIT_CASE(isp_test_call_crop_bounds),
+	KUNIT_CASE(isp_test_call_size_table),
+	KUNIT_CASE(isp_test_call_size_capabilities),
 	KUNIT_CASE(isp_test_setfile_failure_stops_setup),
 	KUNIT_CASE(isp_test_optional_setfile_continues_setup),
 	KUNIT_CASE(isp_test_command_ack_failures),
diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index ebd5607843..67691cc884 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -2,6 +2,7 @@
 /* Copyright 2023 Eileen Yoon <eyn@gmx.com> */
 
 #include <linux/firmware.h>
+#include <linux/gcd.h>
 #include <linux/unaligned.h>
 #include <kunit/static_stub.h>
 
@@ -333,6 +334,107 @@ free_configs:
 	return err;
 }
 
+/* Common call sizes, offered only when a known processed crop contains them. */
+static const struct coord isp_call_sizes[] = {
+	{ 640, 480 }, { 1280, 720 }, { 1920, 1080 }, { 1080, 1920 },
+	{ 1760, 1328 }, { 1328, 1760 }, { 1552, 1552 },
+	{ 1280, 960 }, { 960, 1280 },
+};
+
+/*
+ * CH_CROP[_SCL1]_SET takes x/y/width/height independently of the output
+ * dimensions in CH_OUTPUT_CONFIG[_SCL1]_SET. Stay within an established
+ * processed crop, rather than the sensor input (which may contain stacked
+ * rows). Use the largest exact-aspect crop, centred on the chroma grid,
+ * with no upscaling. Neither command reports a scaler limit or rotation.
+ */
+static bool isp_size_from_crop(const struct isp_preset *source,
+			       struct coord size, struct isp_preset *preset)
+{
+	u32 divisor, x, y, scale;
+
+	if (!size.x || !size.y || (size.x | size.y) & 1 ||
+	    !source->crop_size.x || !source->crop_size.y ||
+	    (source->crop_offset.x | source->crop_offset.y) & 1 ||
+	    source->crop_size.x > 16384 || source->crop_size.y > 16384 ||
+	    source->crop_offset.x > source->input_dim.x ||
+	    source->crop_size.x > source->input_dim.x - source->crop_offset.x ||
+	    source->crop_offset.y > source->input_dim.y ||
+	    source->crop_size.y > source->input_dim.y - source->crop_offset.y)
+		return false;
+
+	divisor = gcd(size.x, size.y);
+	x = size.x / divisor;
+	y = size.y / divisor;
+	scale = round_down(min(source->crop_size.x / x,
+			       source->crop_size.y / y), 2);
+	if (scale < divisor)
+		return false;
+
+	*preset = *source;
+	preset->output_dim = size;
+	preset->crop_size = (struct coord){ x * scale, y * scale };
+	preset->crop_offset.x += round_down((source->crop_size.x - x * scale) / 2, 2);
+	preset->crop_offset.y += round_down((source->crop_size.y - y * scale) / 2, 2);
+	return true;
+}
+
+static unsigned int isp_append_size(struct isp_preset *presets, unsigned int num,
+				    unsigned int sources, struct coord size)
+{
+	struct isp_preset candidate, best;
+	u32 area, best_area = 0;
+
+	for (unsigned int i = 0; i < num; i++)
+		if (presets[i].output_dim.x == size.x &&
+		    presets[i].output_dim.y == size.y)
+			return num;
+
+	/* Never use a generated size as evidence for another generated size. */
+	for (unsigned int i = 0; i < sources; i++) {
+		if (!isp_size_from_crop(&presets[i], size, &candidate))
+			continue;
+		area = candidate.crop_size.x * candidate.crop_size.y;
+		if (area > best_area) {
+			best = candidate;
+			best_area = area;
+		}
+	}
+	if (best_area)
+		presets[num++] = best;
+	return num;
+}
+
+static int isp_add_call_sizes(struct apple_isp *isp)
+{
+	unsigned int sources = isp->num_presets, num = sources;
+	struct isp_preset *presets;
+	struct isp_preset candidate;
+	u32 square = 0;
+
+	presets = devm_kcalloc(isp->dev, sources + ARRAY_SIZE(isp_call_sizes) + 1,
+			       sizeof(*presets), GFP_KERNEL);
+	if (!presets)
+		return -ENOMEM;
+	memcpy(presets, isp->presets, sources * sizeof(*presets));
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(isp_call_sizes); i++)
+		num = isp_append_size(presets, num, sources, isp_call_sizes[i]);
+
+	/* A smaller sensor can still offer a square without enlarging pixels. */
+	for (unsigned int i = 0; i < sources; i++) {
+		u32 side = round_down(min(presets[i].crop_size.x,
+					  presets[i].crop_size.y), 2);
+
+		if (isp_size_from_crop(&presets[i], (struct coord){ side, side }, &candidate))
+			square = max(square, side);
+	}
+	num = isp_append_size(presets, num, sources, (struct coord){ square, square });
+	isp->presets = presets;
+	isp->num_presets = num;
+	return 0;
+}
+
 static int isp_ch_cache_sensor_info(struct apple_isp *isp, u32 ch)
 {
 	struct isp_format *fmt = isp_get_format(isp, ch);
@@ -382,6 +484,8 @@ static int isp_ch_cache_sensor_info(struct apple_isp *isp, u32 ch)
 	err = isp_check_presets(isp, args->num_presets);
 	if (!err)
 		err = isp_ch_cache_sensor_configs(isp, ch, args->num_presets);
+	if (!err)
+		err = isp_add_call_sizes(isp);
 
 exit:
 	kfree(args);
