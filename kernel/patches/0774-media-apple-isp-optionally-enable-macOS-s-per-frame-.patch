From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 06:58:23 +0000
Subject: [PATCH] media: apple: isp: optionally enable macOS's
 per-frame metadata sections

Before every preview stream on this camera, macOS resets the metadata
section list twice and then enables fourteen sections with
META_DATA_ENABLE, marking three of them required with
SET_META_DATA_REQUIRED, all right before it sets the view and the
output. The driver sends none of these, and with face detection on the
metadata it gets back has the same sections as with it off.

Add macos_meta_ids (default off), which sends the same commands with
the same values and in the same order, just before the crop and output
of the stream, so that the face detection output can be found and read.

Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-cam.c | 48 ++++++++++++++++++++++
 drivers/media/platform/apple/isp/isp-cmd.h |  1 +
 2 files changed, 49 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 8909151929..5dc51e015d 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -1532,6 +1532,51 @@ static void isp_ch_macos_stream_config(struct apple_isp *isp, u32 ch)
 		dev_warn_once(isp->dev, "stream setting refused: %d\n", err);
 }
 
+/*
+ * macOS switches on these per-frame metadata sections of this camera before
+ * every preview stream, in this order, and marks three of them required
+ * (META_DATA_ENABLE 0x0126, SET_META_DATA_REQUIRED 0x014f), after resetting
+ * the section list twice (META_DATA_SECTION_RESET 0x0157). The driver sends
+ * none of them, and the face detection output stays out of the metadata.
+ * macos_meta_ids sends macOS's set, for tests (default: off).
+ */
+static bool macos_meta_ids;
+module_param(macos_meta_ids, bool, 0644);
+MODULE_PARM_DESC(macos_meta_ids,
+		 "Enable the per-frame metadata sections macOS enables on this camera (default: off)");
+
+static const u32 isp_macos_meta_ids[] = {
+	0x3c, 0x1003c, 0x13, 0x18, 0x25, 0x3f, 0x16,
+	0x0d, 0x15, 0x30, 0x22, 0x32, 0x1001e, 0x10036,
+};
+
+static bool isp_macos_meta_required(u32 id)
+{
+	return id == 0x13 || id == 0x18 || id == 0x25;
+}
+
+static void isp_ch_macos_meta_ids(struct apple_isp *isp, u32 ch)
+{
+	int i, err;
+
+	if (!READ_ONCE(macos_meta_ids) || !isp->hw->macos_session_settings)
+		return;
+	err = isp_cmd_ch_u32_set(isp, CISP_CMD_CH_META_DATA_SECTION_RESET, ch, 0);
+	if (!err)
+		err = isp_cmd_ch_u32_set(isp, CISP_CMD_CH_META_DATA_SECTION_RESET,
+					 ch, 0);
+	for (i = 0; !err && i < ARRAY_SIZE(isp_macos_meta_ids); i++) {
+		u32 id = isp_macos_meta_ids[i];
+
+		err = isp_ch_u32x2_set(isp, CISP_CMD_CH_META_DATA_ENABLE, ch, id, 0);
+		if (!err && isp_macos_meta_required(id))
+			err = isp_ch_u32x2_set(isp, CISP_CMD_CH_SET_META_DATA_REQUIRED,
+					       ch, 0, id);
+	}
+	if (err)
+		dev_warn_once(isp->dev, "metadata section enable refused: %d\n", err);
+}
+
 /*
  * A floor on the auto exposure gain (1/256 steps, as AE_GAIN_CAP_SET), for
  * tests: with it a lit scene is taken at the sensor gain of a dark room,
@@ -2041,6 +2086,9 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	if (err)
 		return err;
 
+	/* macOS enables the metadata sections right before the view and output. */
+	isp_ch_macos_meta_ids(isp, ch);
+
 	isp_zoom_start_crop(isp, &crop);
 	err = isp_cmd_ch_crop_set(isp, ch, crop.x, crop.y, crop.w, crop.h);
 	if (err)
diff --git a/drivers/media/platform/apple/isp/isp-cmd.h b/drivers/media/platform/apple/isp/isp-cmd.h
index 117ca2c0ec..c3b8b016f6 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.h
+++ b/drivers/media/platform/apple/isp/isp-cmd.h
@@ -46,6 +46,7 @@
 #define CISP_CMD_CH_CAMERA_CONTROL			     0x0141
 #define CISP_CMD_CH_LSC_POLYNOMIAL_COEFF_GET		     0x0142
 #define CISP_CMD_CH_SET_META_DATA_REQUIRED		     0x014f
+#define CISP_CMD_CH_META_DATA_SECTION_RESET		     0x0157
 #define CISP_CMD_CH_BUFFER_POOL_RETURN			     0x015b
 #define CISP_CMD_CH_CAMERA_AGILE_FREQ_ARRAY_CURRENT_GET	     0x015e
 #define CISP_CMD_CH_CAR_ENABLE				     0x0164
-- 
2.43.0

