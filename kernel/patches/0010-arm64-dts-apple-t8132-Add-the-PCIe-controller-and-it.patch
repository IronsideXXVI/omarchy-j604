From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yureka Lilian <yureka@cyberchaos.dev>
Date: Sat, 25 Jul 2026 15:42:41 +0200
Subject: [PATCH] arm64: dts: apple: t8132: Add the PCIe controller and its
 DARTs

Describe the T8132 internal PCIe controller, its three root ports and
the DART of each port. On the M4 machines port 0 carries the Wi-Fi and
Bluetooth module, and on the Mac mini port 2 carries the Ethernet
controller. Give the SoC bus the same dma-ranges as T8112, T8122 and
T6030 so that devices behind DARTs get DMA above 4 GiB, and include
gpio.h for the PERST# lines.

Everything stays disabled. A board enables the controller, the ports it
wires and their DARTs, and maps their requester IDs (iommu-map), because
the stream IDs differ between boards.

[sdolbec: Ported from GravityLinux gravity-m4 commit 9edf52c13ea3
 ("t8132 pcie") and commit bdafece9eddb ("t8132 wifi pwren"),
 cherry-picks of Yureka's commit 19103645439f ("t8132 pcie") and commit
 c59a7a826661 ("t8132 wifi pwren"). SoC part only; the board parts move
 to t8132-j773g.dts in a later commit. Changes: port labels pcie0_portN
 as in t8140.dtsi, status = "disabled" on the controller, its ports and
 DARTs, iommu-map left to the board, and the controller's power domain
 apcie_phy_sw instead of apcie_gp, which is what the J773g runs with
 today under gravity-m4 (changed there after these commits). The
 original commits carry no Signed-off-by; they are forwarded here under
 DCO clause (b), and Yureka's Signed-off-by should be added before this
 is merged.]
Signed-off-by: Sean Dolbec <sdolbec1@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

---
 arch/arm64/boot/dts/apple/t8132.dtsi | 142 +++++++++++++++++++++++++++
 1 file changed, 142 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index d7f643d495..d211b40d19 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -5,6 +5,7 @@
  * Copyright The Asahi Linux Contributors
  */
 
+#include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/apple-aic.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/pinctrl/apple.h>
@@ -196,6 +197,8 @@
 
 		ranges;
 		nonposted-mmio;
+		/* Required to get >32-bit DMA via DARTs */
+		dma-ranges = <0 0 0 0 0xffffffff 0xffffc000>;
 
 		pmgr: power-management@380700000 {
 			compatible = "apple,t8132-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
@@ -352,6 +355,13 @@
 				pinmux = <APPLE_PINMUX(108, 1)>,
 				         <APPLE_PINMUX(107, 1)>;
 			};
+
+			pcie_pins: pcie-pins {
+				/* CLKREQ# of ports 0-2 */
+				pinmux = <APPLE_PINMUX(160, 1)>,
+					 <APPLE_PINMUX(161, 1)>,
+					 <APPLE_PINMUX(162, 1)>;
+			};
 		};
 
 		i2c0: i2c@3ad010000 {
@@ -529,6 +539,138 @@
 			apple,sart = <&sart>;
 			status = "disabled";
 		};
+
+		pcie0_dart: iommu@490000000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x90000000 0x0 0x4000>;
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1232 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_apcie_gp>;
+			status = "disabled";
+		};
+
+		pcie1_dart: iommu@491000000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x91000000 0x0 0x4000>;
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1236 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_apcie_gp>;
+			status = "disabled";
+		};
+
+		pcie2_dart: iommu@492000000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x92000000 0x0 0x4000>;
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1250 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_apcie_gp>;
+			status = "disabled";
+		};
+
+		pcie0: pcie@1cb0000000 {
+			compatible = "apple,t8132-pcie", "apple,t6020-pcie";
+			device_type = "pci";
+
+			reg = <0x1c 0xb0000000 0x0 0x1000000>,
+			      <0x4 0x94000000 0x0 0x4000>,
+			      <0x4 0x90028000 0x0 0x4000>,
+			      <0x4 0x91028000 0x0 0x4000>,
+			      <0x4 0x92028000 0x0 0x4000>,
+			      <0x4 0x97020000 0x0 0x4000>,
+			      <0x4 0x97024000 0x0 0x4000>,
+			      <0x4 0x97028000 0x0 0x4000>;
+			reg-names = "config", "rc", "port0", "port1", "port2",
+				    "phy0", "phy1", "phy2";
+
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1231 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1240 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1249 IRQ_TYPE_LEVEL_HIGH>;
+
+			msi-controller;
+			msi-parent = <&pcie0>;
+			msi-ranges = <&aic AIC_IRQ 1506 IRQ_TYPE_EDGE_RISING 32>;
+
+			/* Boards map the requester IDs of the ports they use. */
+			iommu-map-mask = <0xff00>;
+
+			bus-range = <0 3>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges = <0x43000000 0xb 0xc0000000 0xb 0xc0000000 0x0 0x20000000>,
+				 <0x02000000 0x0 0x80000000 0xb 0x80000000 0x0 0x40000000>;
+
+			power-domains = <&ps_apcie_phy_sw>;
+			pinctrl-0 = <&pcie_pins>;
+			pinctrl-names = "default";
+			status = "disabled";
+
+			pcie0_port0: pci@0,0 {
+				compatible = "pciclass,0604";
+				device_type = "pci";
+				reg = <0x0 0x0 0x0 0x0 0x0>;
+				reset-gpios = <&pinctrl_ap 163 GPIO_ACTIVE_LOW>;
+
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+
+				interrupt-controller;
+				#interrupt-cells = <1>;
+
+				interrupt-map-mask = <0 0 0 7>;
+				interrupt-map = <0 0 0 1 &pcie0_port0 0 0 0 0>,
+						<0 0 0 2 &pcie0_port0 0 0 0 1>,
+						<0 0 0 3 &pcie0_port0 0 0 0 2>,
+						<0 0 0 4 &pcie0_port0 0 0 0 3>;
+				status = "disabled";
+			};
+
+			pcie0_port1: pci@1,0 {
+				compatible = "pciclass,0604";
+				device_type = "pci";
+				reg = <0x800 0x0 0x0 0x0 0x0>;
+				reset-gpios = <&pinctrl_ap 164 GPIO_ACTIVE_LOW>;
+
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+
+				interrupt-controller;
+				#interrupt-cells = <1>;
+
+				interrupt-map-mask = <0 0 0 7>;
+				interrupt-map = <0 0 0 1 &pcie0_port1 0 0 0 0>,
+						<0 0 0 2 &pcie0_port1 0 0 0 1>,
+						<0 0 0 3 &pcie0_port1 0 0 0 2>,
+						<0 0 0 4 &pcie0_port1 0 0 0 3>;
+				status = "disabled";
+			};
+
+			pcie0_port2: pci@2,0 {
+				compatible = "pciclass,0604";
+				device_type = "pci";
+				reg = <0x1000 0x0 0x0 0x0 0x0>;
+				reset-gpios = <&pinctrl_ap 165 GPIO_ACTIVE_LOW>;
+
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+
+				interrupt-controller;
+				#interrupt-cells = <1>;
+
+				interrupt-map-mask = <0 0 0 7>;
+				interrupt-map = <0 0 0 1 &pcie0_port2 0 0 0 0>,
+						<0 0 0 2 &pcie0_port2 0 0 0 1>,
+						<0 0 0 3 &pcie0_port2 0 0 0 2>,
+						<0 0 0 4 &pcie0_port2 0 0 0 3>;
+				status = "disabled";
+			};
+		};
 	};
 
 	timer {
