From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 04:33:24 +0000
Subject: [PATCH] drm/apple: m4: optional real-time sleep for held J604
 panel swaps

A swap held by swap_pace sleeps in the commit worker until its planned
start, at normal priority. With a fullscreen 60 fps video decoded in
software beside it, held swaps woke up to 2.6 ms late (debugfs pace
over_max_us), and one that starts late by more than the margin misses
its 120 Hz tick: 160 of 1220 swaps landed one tick late in such a run
on the J604, and 18 percent of the video's frames were off cadence.

Add swap_pace_rt (default off): sleep a held swap at low SCHED_FIFO
priority and restore the worker's own priority afterwards, so that a
busy CPU wakes it on time. Also count held swaps in debugfs by how late
they woke (under 0.1, 0.25, 0.5, 1 and 2 ms, and later), to tell late
wake-ups apart from the firmware's own swap latency.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/gpu/drm/apple/iomfb_m4.c | 29 ++++++++++++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index d2747db9cf..22bee3da17 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -13,6 +13,7 @@
 #include <linux/iommu.h>
 #include <linux/io.h>
 #include <linux/mutex.h>
+#include <linux/sched.h>
 #include <linux/of_address.h>
 #include <linux/of_device.h>
 #include <linux/of_reserved_mem.h>
@@ -204,6 +205,11 @@ module_param(swap_pace_margin_us, uint, 0644);
 MODULE_PARM_DESC(swap_pace_margin_us,
 		 "J604: with swap_pace, how far past the reach of the tick between two refreshes a held swap starts, us (default 520; at most a quarter tick)");
 
+static bool swap_pace_rt;
+module_param(swap_pace_rt, bool, 0644);
+MODULE_PARM_DESC(swap_pace_rt,
+		 "J604: with swap_pace, sleep a held swap at low real-time priority (SCHED_FIFO), so that busy CPUs do not wake it late (default off)");
+
 static unsigned int swap_pace_lead_us;
 module_param(swap_pace_lead_us, uint, 0644);
 MODULE_PARM_DESC(swap_pace_lead_us,
@@ -1148,6 +1154,8 @@ struct dcp_m4_runtime {
 	u64 pace_n[6];
 	u64 pace_over_sum;
 	u64 pace_over_max;
+	/* Held swaps by how late they woke: < 0.1, 0.25, 0.5, 1, 2 ms and later */
+	u64 pace_over_hist[6];
 	/* Smoothed interval between internal-panel swap completions (1/8 EWMA, 0 after idle) */
 	u64 int_prev_done;
 	u64 int_iv_ewma;
@@ -2829,15 +2837,31 @@ static int dcp_m4_runtime_swap_full(struct dcp_m4_runtime *r, bool primary,
 	if (!ext && primary && frame) {
 		unsigned long pace = dcp_m4_swap_pace_us(r);
 
-		if (pace)
+		if (pace) {
+			/*
+			 * The commit worker runs at normal priority beside
+			 * whatever loads the CPUs (a software video decoder),
+			 * and a late wake-up costs the frame its tick.
+			 */
+			bool rt = READ_ONCE(swap_pace_rt) && !rt_task(current);
+			int nice = task_nice(current);
+
+			if (rt)
+				sched_set_fifo_low(current);
 			usleep_range(pace, pace + 50);
+			if (rt)
+				sched_set_normal(current, nice);
+		}
 		r->int_held = pace != 0;
 		WRITE_ONCE(r->int_start_cnt, __arch_counter_get_cntpct());
 		if (pace && r->pace_start && r->int_start_cnt > r->pace_start) {
 			u64 over = r->int_start_cnt - r->pace_start;
+			u64 us = div64_u64(over * USEC_PER_SEC, arch_timer_get_cntfrq() ?: 1);
 
 			r->pace_over_sum += over;
 			r->pace_over_max = max(r->pace_over_max, over);
+			r->pace_over_hist[us < 100 ? 0 : us < 250 ? 1 : us < 500 ? 2 :
+					   us < 1000 ? 3 : us < 2000 ? 4 : 5]++;
 		}
 	}
 	r->deadline = jiffies + msecs_to_jiffies(5000);
@@ -7493,6 +7517,9 @@ static int iomfb_m4_status_show(struct seq_file *s, void *unused)
 			   div64_u64(r->pace_over_max * USEC_PER_SEC, f),
 			   div64_u64(READ_ONCE(r->int_lat_min) * USEC_PER_SEC, f),
 			   div64_u64(READ_ONCE(r->int_iv_ewma) * USEC_PER_SEC, f));
+		seq_printf(s, "pace_over_hist lt100us=%llu lt250us=%llu lt500us=%llu lt1ms=%llu lt2ms=%llu ge2ms=%llu\n",
+			   r->pace_over_hist[0], r->pace_over_hist[1], r->pace_over_hist[2],
+			   r->pace_over_hist[3], r->pace_over_hist[4], r->pace_over_hist[5]);
 	}
 	if (r)
 		seq_printf(s, "idle_cache=%u state=%u fences=%u registered=%u entries=%llu\n",
