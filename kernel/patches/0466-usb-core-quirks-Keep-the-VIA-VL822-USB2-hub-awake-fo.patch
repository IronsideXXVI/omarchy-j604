From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 28 Oct 2026 19:19:03 -0400
Subject: [PATCH] usb: core: quirks: Keep the VIA VL822 USB2 hub awake for
 wakeups

The USB 2.0 hub of the VIA Labs VL822 (2109:2822), as in Anker USB-C
hubs, does not pass on a remote wakeup from a device below it while it
is suspended itself, like the VL122. A USB keyboard behind it cannot
wake the system from suspend-to-idle.

Give it USB_QUIRK_HUB_NO_SUSPENDED_WAKEUP, so that it is kept awake in
suspend-to-idle while a device below it may wake the system. Its
autosuspend is unchanged. A KUnit case checks the entry.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 3578bc3697370e7e2ddc0d6555a536fc29decf94)
---
 drivers/usb/core/quirks.c          |  4 ++++
 drivers/usb/core/usb-quirks-test.c | 14 ++++++++++++++
 2 files changed, 18 insertions(+)

diff --git a/drivers/usb/core/quirks.c b/drivers/usb/core/quirks.c
index 50c564c46b..a374ff625a 100644
--- a/drivers/usb/core/quirks.c
+++ b/drivers/usb/core/quirks.c
@@ -592,6 +592,10 @@ static const struct usb_device_id usb_quirk_list[] = {
 	/* VIA Labs, Inc. USB2.0 Hub */
 	{ USB_DEVICE(0x2109, 0x2817), .driver_info = USB_QUIRK_NO_LPM },
 
+	/* VIA Labs, Inc. VL822 USB2.0 Hub */
+	{ USB_DEVICE(0x2109, 0x2822), .driver_info =
+			USB_QUIRK_HUB_NO_SUSPENDED_WAKEUP },
+
 	/* Raydium Touchscreen */
 	{ USB_DEVICE(0x2386, 0x3114), .driver_info = USB_QUIRK_NO_LPM },
 
diff --git a/drivers/usb/core/usb-quirks-test.c b/drivers/usb/core/usb-quirks-test.c
index 5587e1d4cf..9073f6bd31 100644
--- a/drivers/usb/core/usb-quirks-test.c
+++ b/drivers/usb/core/usb-quirks-test.c
@@ -53,6 +53,19 @@ static void usb_quirks_vl122_test(struct kunit *test)
 	KUNIT_EXPECT_TRUE(test, usb_hub_id_quirks(&t->intf) & HUB_QUIRK_DISABLE_AUTOSUSPEND);
 }
 
+/*
+ * The VIA Labs VL822 USB 2.0 hub passes on no remote wakeup from below while it
+ * is suspended. It is kept awake in suspend-to-idle and keeps its autosuspend.
+ */
+static void usb_quirks_vl822_test(struct kunit *test)
+{
+	struct usb_quirks_test *t = usb_quirks_test_hub(test, 0x2109, 0x2822);
+
+	KUNIT_EXPECT_EQ(test, usb_detect_device_list_quirks(&t->udev),
+			USB_QUIRK_HUB_NO_SUSPENDED_WAKEUP);
+	KUNIT_EXPECT_EQ(test, usb_hub_id_quirks(&t->intf), 0UL);
+}
+
 /* Another VIA Labs hub keeps its own device quirk and no hub quirk. */
 static void usb_quirks_other_via_hub_test(struct kunit *test)
 {
@@ -73,6 +86,7 @@ static void usb_quirks_generic_hub_test(struct kunit *test)
 
 static struct kunit_case usb_quirks_test_cases[] = {
 	KUNIT_CASE(usb_quirks_vl122_test),
+	KUNIT_CASE(usb_quirks_vl822_test),
 	KUNIT_CASE(usb_quirks_other_via_hub_test),
 	KUNIT_CASE(usb_quirks_generic_hub_test),
 	{}
