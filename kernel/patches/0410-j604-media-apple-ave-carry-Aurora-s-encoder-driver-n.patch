+	ave->layout = fw;
+	ctx->ave = ave;
+	ctx->sess = sess;
+	ave_test_session(sess, codec, width, height, true);
+	sess->p.rc_mode = 3;
+	sess->p.bitrate = 4000000;
+	sess->p.limit_bytes = 0;
+	sess->p.initial_qp = 33;
+	sess->p.min_qp = 0;
+	sess->p.max_qp = 48;
+	sess->p.gop = 30;
+	sess->p.profile = codec == AVE_CODEC_H264 ? 4 : 1;
+	sess->p.level = codec == AVE_CODEC_H264 ? 13 : 7;
+	sess->p.high = false;
+	sess->p.bit_depth = 8;
