+#define AVE_6070_HEVC_CHROMA_420		1  /* H.265 chroma_format_idc */
+#define AVE_6070_HEVC_LOG2_MAX_POC_LSB_MINUS4 4 /* eight-bit POC lsb */
+#define AVE_6070_HEVC_SAO_ALL		GENMASK(15, 0)	/* SAO on for every CTB class */
