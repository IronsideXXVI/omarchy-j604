+	/* M4 Pro (T6040): same carrier sizes, no capture yet */
+	AVE_MCTF_25G83(AVE_FW_TEXT_CRC_T6040_25G83, false),
+	/* M4 Max (J575c): same build, no capture yet */
+	AVE_MCTF_25G83(AVE_FW_TEXT_CRC_T6041_25G83, false),
+};
