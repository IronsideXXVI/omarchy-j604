+++ b/drivers/media/platform/apple/ave/abi.rst
@@ -18,11 +18,22 @@ The constant image tables in ave-image.c are unchanged by this refactor.
 6070.11.1 is selected only for T6000 TEXT CRC 460c7a7c or T8112 TEXT CRC 25bfd039,
 with the corresponding SoC identity. Boot, seven-channel discovery, Config,
 Open, Close and scratch-confirmed Halt are implemented from the clean derived
-SPEC-6070-lifecycle.md ledger. Start and Process return EOPNOTSUPP before writing
-a payload or submitting a command. Reset also remains unavailable: its request
-has a codec-dependent body, rather than a scalar header. No Priority command is
-sent for this ABI. The split surface writer supports separate address and size
-arrays, without assuming a semantic mapping for the unqualified fields.
+SPEC-6070-lifecycle.md ledger. Start and ordinary Process writers implement the
+clean revision-2/P1 field ledgers: fixed-capacity address banks, split output
+arrays, four interleaved entropy sets, rational frame rate, one initial-QP word,
+retained codec-state partitions and per-slot HEVC slice-header tables. The
+session allocator provides distinct backing for every live bank and rejects
+non-16-KiB-aligned IOVAs.
+
+Streaming is enabled for one quality-first NV12 constant-quality session of
+8-bit H.264 (Baseline, Main or High) with low delay: I and P pictures, two
+reconstruction slots that alternate, frame widths in whole macroblocks. B
+pictures, HEVC, Main 10, bit-rate modes, speed priority, standalone LRME and
+Reset remain unavailable; a session asking for B pictures is encoded without
+them, the others are refused. No Priority command is sent. Complete is the
+normal drain barrier; Flush is reserved for cancellation before Stop and Close.
+KUnit checks the 1080p and 4K fields directly from the clean ledgers and embeds
+no Apple command image.
 
 Lifecycle-only validation
 -------------------------
diff --git a/drivers/media/platform/apple/ave/apple-ave-dma.c b/drivers/media/platform/apple/ave/apple-ave-dma.c
new file mode 100644
index 0000000000..8483045031
--- /dev/null
+++ b/drivers/media/platform/apple/ave/apple-ave-dma.c
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Apple AVE auxiliary DMA fault reporting. */
+
+#include <linux/bitops.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#define AVE_DMA_ERROR_STATUS		0x40
+#define AVE_DMA_ERROR_PENDING		BIT(31)
+#define AVE_DMA_ERROR_ACK_MASK		0x27c
+#define AVE_DMA_ERROR_INFO0		0x44
+#define AVE_DMA_ERROR_INFO1		0x48
+#define AVE_DMA_ERROR_INFO2		0x4c
+#define AVE_DMA_ERROR_ADDRESS		0x50
+#define AVE_DMA_ERROR_INFO3		0x58
+#define AVE_DMA_ERROR_INFO4		0x60
+#define AVE_DMA_ERROR_INFO5		0x64
+
+struct apple_ave_dma {
+	struct device *dev;
+	void __iomem *base;
+};
+
+static irqreturn_t apple_ave_dma_irq(int irq, void *data)
+{
+	struct apple_ave_dma *dma = data;
+	u32 status = readl(dma->base + AVE_DMA_ERROR_STATUS);
+
+	if (!(status & AVE_DMA_ERROR_PENDING))
+		return IRQ_NONE;
+
+	dev_err_ratelimited(dma->dev,
+			    "DMA fault: status %08x info %08x %08x %08x address %08x info %08x %08x %08x\n",
+			    status, readl(dma->base + AVE_DMA_ERROR_INFO0),
+			    readl(dma->base + AVE_DMA_ERROR_INFO1),
+			    readl(dma->base + AVE_DMA_ERROR_INFO2),
+			    readl(dma->base + AVE_DMA_ERROR_ADDRESS),
+			    readl(dma->base + AVE_DMA_ERROR_INFO3),
+			    readl(dma->base + AVE_DMA_ERROR_INFO4),
+			    readl(dma->base + AVE_DMA_ERROR_INFO5));
+
+	/* The implemented error bits are write-one-to-clear. */
+	writel(status & AVE_DMA_ERROR_ACK_MASK,
+	       dma->base + AVE_DMA_ERROR_STATUS);
+	readl(dma->base + AVE_DMA_ERROR_STATUS);
+	return IRQ_HANDLED;
+}
+
+static int apple_ave_dma_probe(struct platform_device *pdev)
+{
+	struct apple_ave_dma *dma;
+	int irq;
+
+	dma = devm_kzalloc(&pdev->dev, sizeof(*dma), GFP_KERNEL);
+	if (!dma)
+		return -ENOMEM;
+
+	dma->dev = &pdev->dev;
+	dma->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(dma->base))
+		return PTR_ERR(dma->base);
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	return devm_request_irq(&pdev->dev, irq, apple_ave_dma_irq,
+				IRQF_SHARED, dev_name(&pdev->dev), dma);
+}
+
+static const struct of_device_id apple_ave_dma_of_match[] = {
+	{ .compatible = "apple,t6000-ave-dma" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, apple_ave_dma_of_match);
+
+static struct platform_driver apple_ave_dma_driver = {
+	.probe = apple_ave_dma_probe,
+	.driver = {
+		.name = "apple-ave-dma",
+		.of_match_table = apple_ave_dma_of_match,
+	},
+};
+module_platform_driver(apple_ave_dma_driver);
+
+MODULE_DESCRIPTION("Apple AVE auxiliary DMA fault handler");
+MODULE_LICENSE("GPL");
