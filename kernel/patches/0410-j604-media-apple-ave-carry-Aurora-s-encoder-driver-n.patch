+const struct ave_mctf_layout *ave_mctf_layout_for_crc(u32 text_crc)
+{
+	for (unsigned int i = 0; i < ARRAY_SIZE(ave_mctf_layouts); i++)
+		if (ave_mctf_layouts[i].text_crc == text_crc)
+			return &ave_mctf_layouts[i];
+	return NULL;
+}
+
+const struct ave_mctf_layout *ave_mctf_qualified(u32 text_crc)
+{
+	const struct ave_mctf_layout *l = ave_mctf_layout_for_crc(text_crc);
+
+	return l && l->qualified ? l : NULL;
+}
+
+static int ave_mctf_words(u8 *cmd, size_t len, const struct ave_mctf_word *w,
+			  unsigned int n)
+{
+	for (unsigned int i = 0; i < n; i++) {
+		if (w[i].off + 4 > len)
+			return -EINVAL;
+		put_unaligned_le32(w[i].val, cmd + w[i].off);
+	}
+	return 0;
+}
+
+/* Index of the Start surface whose address goes to @off, or -ENOENT */
+static int ave_mctf_surface_index(const struct ave_mctf_layout *l, u32 off)
+{
+	for (unsigned int i = 0; i < l->n_surfaces; i++)
+		if (l->surfaces[i].off == off)
+			return l->surfaces[i].alloc ? i :
+			       ave_mctf_surface_index(l, l->surfaces[i].alias);
+	return -ENOENT;
+}
+
+/*
+ * Start: the constant words and every surface address, from @surf (indexed
+ * like the layout's surface table; alias rows are ignored). The caller
+ * writes the header.
+ */
+int ave_mctf_build_start(const struct ave_mctf_layout *l, u8 *cmd, size_t len,
+			 const dma_addr_t *surf, u32 strength)
+{
+	int ret;
+
+	if (!l || !l->qualified)
+		return -EOPNOTSUPP;
+	if (len != l->start_bytes || l->n_surfaces > AVE_MCTF_BUFS ||
+	    strength > AVE_MCTF_STRENGTH_MAX)
+		return -EINVAL;
+	memset(cmd, 0, len);
+	ret = ave_mctf_words(cmd, len, l->start_words, l->n_start_words);
+	if (ret)
+		return ret;
+	for (unsigned int i = 0; i < l->n_surfaces; i++) {
+		int at = ave_mctf_surface_index(l, l->surfaces[i].off);
+
+		if (at < 0 || l->surfaces[i].off + 8 > len || !surf[at])
+			return -EINVAL;
+		put_unaligned_le64(surf[at], cmd + l->surfaces[i].off);
+	}
+	put_unaligned_le32(strength, cmd + l->strength);
+	return 0;
+}
+
+static void ave_mctf_put_surface(u8 *cmd, const struct ave_mctf_picture *p,
+				 const struct ave_mctf_surface_form *form, u64 base)
+{
+	put_unaligned_le64(base, cmd + p->y);
+	put_unaligned_le64(base + form->y_hdr, cmd + p->y_hdr);
+	put_unaligned_le64(base + form->c, cmd + p->c);
+	put_unaligned_le64(base + form->c_hdr, cmd + p->c_hdr);
+}
+
+/* Process for one frame; the caller writes the header (subtype base + slot). */
+int ave_mctf_build_process(const struct ave_mctf_layout *l, u8 *cmd,
+			   size_t len, const dma_addr_t *surf,
+			   const struct ave_mctf_frame *f)
+{
+	int ret;
+
+	if (!l || !l->qualified)
+		return -EOPNOTSUPP;
+	if (len != l->process_bytes || f->slot >= l->slots ||
+	    f->level < AVE_MCTF_LEVEL_MIN || f->level > AVE_MCTF_LEVEL_MAX ||
+	    f->width != AVE_MCTF_WIDTH ||
+	    f->height != AVE_MCTF_HEIGHT || f->stride < f->width ||
+	    f->stride % 64 || !f->in || !f->out)
+		return -EINVAL;
+	memset(cmd, 0, len);
+	ret = ave_mctf_words(cmd, len, l->process_words, l->n_process_words);
+	if (ret)
+		return ret;
+	ave_mctf_put_surface(cmd, &l->input, &l->form, f->in);
+	ave_mctf_put_surface(cmd, &l->output, &l->form, f->out);
+	put_unaligned_le32(f->width, cmd + l->width);
+	put_unaligned_le32(f->height, cmd + l->height);
+	put_unaligned_le32(f->frame ? l->next_value : l->first_value,
+			   cmd + l->first_frame);
+	put_unaligned_le32(f->slot, cmd + l->slot);
+	for (unsigned int i = 0; i < ARRAY_SIZE(l->slot_refs); i++) {
+		const struct ave_mctf_slot_ref *r = &l->slot_refs[i];
+		int at = ave_mctf_surface_index(l, r->start + r->stride * f->slot);
+
+		if (at < 0 || !surf[at])
+			return -EINVAL;
+		put_unaligned_le64(surf[at], cmd + r->off);
+	}
+	put_unaligned_le32(f->frame, cmd + l->frame);
+	put_unaligned_le32(f->level, cmd + l->level);
+	return 0;
+}
+
+/*
+ * MCTF needs a qualified boot, a qualified MCTF layout for this build and
+ * the layout's DART stream attached on every encoder DART.
+ */
+int ave_mctf_check_build(struct ave_dev *ave)
+{
+	const struct ave_mctf_layout *l;
+	int ret = ave_fw_check_boot(ave);
+
+	if (ret)
+		return ret;
+	l = ave_mctf_qualified(ave->text_crc);
+	if (!l)
+		return -EOPNOTSUPP;
+	if (!ave->n_darts)
+		goto no_stream;
+	for (unsigned int d = 0; d < ave->n_darts; d++)
+		if (l->stream >= 32 || !(ave->dart_sid_mask[d] & BIT(l->stream)))
+			goto no_stream;
+	return 0;
+
+no_stream:
+	dev_warn_once(ave->dev,
+		      "MCTF disabled: DART stream %u is not attached on every encoder DART\n",
+		      l->stream);
+	return -EOPNOTSUPP;
+}
+
+int ave_mctf_cmd_start(struct ave_ctx *ctx)
+{
+	struct ave_dev *ave = ctx->ave;
+	struct ave_session *sess = ctx->sess;
+	const struct ave_mctf_layout *l = sess->mctf;
+	size_t len;
+	u8 *cmd;
+	int ret;
+
+	if (!l)
+		return -EOPNOTSUPP;
+	len = l->start_bytes;
+	cmd = ave_ipc_cmd(ave, AVE_BUF_CMD, len);
+	if (!cmd)
+		return -EBUSY;
+	ret = ave_mctf_build_start(l, cmd, len, sess->mctf_iova,
+				   READ_ONCE(ctx->mctf_strength));
+	if (ret)
+		return ret;
+	ave_write_header(ctx, cmd, AVE_OP_START, AVE_OP_START, AVE_SESSION_ARG0,
+			 ave_session_setup_arg2(ctx));
+	ave_debugfs_save_mctf(ave, AVE_IMAGE_START, cmd, len);
+	dev_dbg(ave->dev, "MCTF Start: client %u token %llu\n", sess->client,
+		sess->token);
+
+	/* A failed submission may already have exposed the Start buffers. */
+	sess->handed = true;
+	ret = ave_ipc_submit(ave, AVE_BUF_CMD, len, AVE_CMD_SESSION_TIMEOUT_US,
+			     true);
+	if (ret)
+		return ret;
+	return ave_ipc_settle(ave, AVE_START_WAIT_MS);
+}
+
+/*
+ * Fill input surface @n from @src: a lossless picture as it is, an NV12
+ * picture written with every tile raw. The
+ * conversion runs in cached memory; the DMA surfaces see only bulk copies.
+ */
+static int ave_mctf_put_picture(struct ave_ctx *ctx, struct vb2_v4l2_buffer *src,
+				unsigned int n)
+{
+	struct ave_session *sess = ctx->sess;
+	const struct ave_cmp420_geom *g = &sess->mctf_geom;
+	const struct ave_params *p = &sess->p;
+	size_t luma = (size_t)p->stride * p->height;
+	u8 *to = sess->mctf_in[n].cpu;
+	const u8 *from = vb2_plane_vaddr(&src->vb2_buf, 0);
+
+	if (!to || !from || !sess->mctf_surf || !sess->mctf_lin)
+		return -EFAULT;
+	if (ctx->src_fmt.pixelformat == V4L2_PIX_FMT_APPLE_L8V0) {
+		if (src->vb2_buf.planes[0].data_offset + g->bytes >
+		    vb2_plane_size(&src->vb2_buf, 0))
+			return -EINVAL;
+		memcpy(to, from + src->vb2_buf.planes[0].data_offset, g->bytes);
+		return 0;
+	}
+	if (src->vb2_buf.planes[0].data_offset + luma * 3 / 2 >
+	    vb2_plane_size(&src->vb2_buf, 0))
+		return -EINVAL;
+	from += src->vb2_buf.planes[0].data_offset;
+	memcpy(sess->mctf_lin, from, luma * 3 / 2);
+	ave_cmp420_pack(g, sess->mctf_surf, sess->mctf_lin, sess->mctf_lin + luma,
+			p->stride);
+	memcpy(to, sess->mctf_surf, g->bytes);
+	return 0;
+}
+
+/*
+ * Filter @src into @dst in @slot. With @same_input, the picture of the last
+ * command goes again (its surface still holds it). A NULL @dst sends the
+ * companion command whose output is not delivered. Caller holds hw_lock.
+ */
+int ave_mctf_cmd_process(struct ave_ctx *ctx, unsigned int slot,
+			 struct vb2_v4l2_buffer *src,
+			 struct vb2_v4l2_buffer *dst, bool same_input)
+{
+	struct ave_dev *ave = ctx->ave;
+	struct ave_session *sess = ctx->sess;
+	const struct ave_mctf_layout *l = sess->mctf;
+	unsigned int buf = AVE_BUF_PROC(sess->index * AVE_MAX_SLOTS + slot);
+	struct ave_slot *s = &sess->slot[slot];
+	struct ave_mctf_frame f = {
+		.stride = sess->p.stride,
+		.width = sess->p.width,
+		.height = sess->p.height,
+		.slot = slot,
+		.frame = sess->frames,
+		.level = READ_ONCE(ctx->mctf_level),
+	};
+	u8 *cmd;
+	int ret;
+
+	if (!l || slot >= sess->p.slots)
+		return -EINVAL;
+	if (same_input) {
+		s->mctf_input = sess->mctf_last_input;
+	} else {
+		ret = ave_mctf_put_picture(ctx, src, sess->frames % AVE_MCTF_INPUTS);
+		if (ret)
+			return ret;
+		s->mctf_input = sess->frames % AVE_MCTF_INPUTS;
+		sess->mctf_last_input = s->mctf_input;
+	}
+	f.in = sess->mctf_in[s->mctf_input].dma;
+	/*
+	 * A lossless CAPTURE buffer takes slot 1's output directly: the engine
+	 * keeps no reference to it (slot 0's surface is the firmware's own).
+	 */
+	s->mctf_direct = dst && slot == 1 &&
+			  ctx->dst_fmt.pixelformat == V4L2_PIX_FMT_APPLE_L8V0 &&
+			  vb2_plane_size(&dst->vb2_buf, 0) >= sess->mctf_geom.bytes;
+	f.out = s->mctf_direct ? vb2_dma_contig_plane_dma_addr(&dst->vb2_buf, 0) :
+				 sess->mctf_out[slot].dma;
+	ret = ave_ipc_wait_ack(ave, buf);
+	if (ret)
+		return ret;
+	cmd = ave_ipc_cmd(ave, buf, l->process_bytes);
+	if (!cmd)
+		return -EBUSY;
+	ret = ave_mctf_build_process(l, cmd, l->process_bytes, sess->mctf_iova,
+				     &f);
+	if (ret)
+		return ret;
+	ave_write_header(ctx, cmd, AVE_OP_PROCESS, l->subtype + slot,
+			 sess->frame_arg0, ave_session_arg2(ctx));
+	if (!sess->frames)
+		ave_debugfs_save_mctf(ave, AVE_IMAGE_PROCESS, cmd,
+				      l->process_bytes);
+
+	/* Pin both pictures before publishing the command. */
+	s->input_mem = dst ? ave_vb2_get(&src->vb2_buf) : NULL;
+	s->output_mem = dst ? ave_vb2_get(&dst->vb2_buf) : NULL;
+	ret = ave_ipc_submit(ave, buf, l->process_bytes,
+			     ave->layout->process_timeout_us, false);
+	dev_dbg(ave->dev,
+		"MCTF Process frame %u slot %u token %llu level %d in %pad out %pad: %d\n",
+		f.frame, slot, sess->token, f.level, &f.in, &f.out, ret);
+	if (ret)
+		return ret;
+	s->src = dst ? src : NULL;
+	s->dst = dst;
+	s->busy = true;
+	s->status = 0;
+	sess->progress = jiffies;
+	sess->last_sent = jiffies;
+	sess->busy++;
+	sess->frames++;
+	return 0;
+}
diff --git a/drivers/media/platform/apple/ave/ave-mctf.h b/drivers/media/platform/apple/ave/ave-mctf.h
new file mode 100644
index 0000000000..d5449d1572
--- /dev/null
+++ b/drivers/media/platform/apple/ave/ave-mctf.h
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * AVE motion-compensated temporal filter (MCTF): the camera's temporal noise
+ * filter runs as a separate firmware client (work type 3) on the selector-2
+ * Start/Process carriers of the encoder firmware. Layouts are keyed by the
+ * firmware TEXT CRC; only a layout qualified against captured command images
+ * is ever sent, every other build refuses MCTF sessions.
+ *
+ * Copyright The Aurora Silicon Contributors
+ */
+#ifndef _APPLE_AVE_MCTF_H_
+#define _APPLE_AVE_MCTF_H_
+
+#include <linux/types.h>
+#include <linux/videodev2.h>
+
+#define AVE_MCTF_WORK_TYPE	3
+#define AVE_MCTF_WIDTH		1920
+#define AVE_MCTF_HEIGHT		1080
+#define AVE_MCTF_SLOTS		2
+#define AVE_MCTF_INPUTS		5
+
+/*
+ * Per-frame filter level, written raw to Process +0xad68. -1 (0xffffffff)
+ * means "use the session strength", as the VideoToolbox filter sends it.
+ */
+#define V4L2_CID_APPLE_AVE_MCTF_LEVEL	(V4L2_CID_USER_BASE + 0x1240)
+#define AVE_MCTF_LEVEL_MIN	-1
+#define AVE_MCTF_LEVEL_MAX	31
+#define AVE_MCTF_LEVEL_DEFAULT	-1
+/*
+ * Session strength, Start +0x26f8: round(24 x strength) for the
+ * VideoToolbox filter strength 0..1. Takes effect at the next STREAMON.
+ */
+#define V4L2_CID_APPLE_AVE_MCTF_STRENGTH	(V4L2_CID_USER_BASE + 0x1241)
+#define AVE_MCTF_STRENGTH_MAX	24
+#define AVE_MCTF_STRENGTH_DEFAULT	16
+
+/* One constant u32 word of a command image */
+struct ave_mctf_word {
+	u32 off, val;
+};
+
+/*
+ * A Start surface: a driver-allocated, zeroed, device-only buffer of @alloc
+ * bytes whose u64 address goes to @off. Its size word, when the firmware
+ * has one, is a constant word. An alias row (@alloc zero) repeats the
+ * address of the surface at Start offset @alias.
+ */
+struct ave_mctf_surface {
+	u32 off, alloc, alias;
+};
+
+/* Process u64 address taken from the Start surface at @start + @stride * slot */
+struct ave_mctf_slot_ref {
+	u32 off, start, stride;
+};
+
+/*
+ * A picture is a compressed surface in four planes, each {u64 address,
+ * u32 bytes, u32 row bytes}: Y data, Y header, CbCr data, CbCr header, at
+ * these Process offsets. Sizes, row bytes and dimensions are constant words.
+ */
+struct ave_mctf_picture {
+	u32 y, y_hdr, c, c_hdr;
+};
+
+/* Where the planes sit inside one driver-owned surface (as macOS lays them) */
+struct ave_mctf_surface_form {
+	u32 y_hdr, c, c_hdr, bytes;
+};
+
+struct ave_mctf_layout {
+	u32 text_crc;
+	u32 start_bytes, process_bytes;
+	/* Header: work type, then the +0x24 and +0x28 arguments */
+	u32 unit, arg1, frame_arg0;
+	u32 subtype;	/* Process subtype base, plus the slot */
+	u32 slots;
+	const struct ave_mctf_word *start_words, *process_words;
+	unsigned int n_start_words, n_process_words;
+	const struct ave_mctf_surface *surfaces;
+	unsigned int n_surfaces;
+	struct ave_mctf_slot_ref slot_refs[2];
+	struct ave_mctf_picture input, output;
+	struct ave_mctf_surface_form form;
+	u32 inputs;	/* input surfaces, used in turn */
+	u32 width, height;	/* input geometry */
+	u32 first_frame, first_value, next_value;
+	u32 slot, frame, level;
+	u32 strength;	/* Start offset */
+	/*
+	 * DART stream the MCTF engines use on both encoder DARTs. Unless it
+	 * is attached to the encoder's domain it is left in bypass, and the
+	 * engines then write our IOVAs to physical memory.
+	 */
+	u32 stream;
+	/* Start and Process images match captures of this build at 1080p. */
+	bool qualified;
+};
+
+struct ave_mctf_frame {
+	dma_addr_t in, out;	/* input and output surfaces (base addresses) */
+	u32 stride, width, height;
+	u32 slot, frame;
+	s32 level;	/* AVE_MCTF_LEVEL_MIN..AVE_MCTF_LEVEL_MAX */
+};
+
+const struct ave_mctf_layout *ave_mctf_layout_for_crc(u32 text_crc);
+const struct ave_mctf_layout *ave_mctf_qualified(u32 text_crc);
+int ave_mctf_build_start(const struct ave_mctf_layout *l, u8 *cmd, size_t len,
+			 const dma_addr_t *surf, u32 strength);
+int ave_mctf_build_process(const struct ave_mctf_layout *l, u8 *cmd,
+			   size_t len, const dma_addr_t *surf,
+			   const struct ave_mctf_frame *f);
+
+#endif
diff --git a/drivers/media/platform/apple/ave/ave-recovery-test.c b/drivers/media/platform/apple/ave/ave-recovery-test.c
index 0dbcd1b0be..0dd63846ec 100644
--- a/drivers/media/platform/apple/ave/ave-recovery-test.c
+++ b/drivers/media/platform/apple/ave/ave-recovery-test.c
@@ -45,7 +45,49 @@ static void ave_recovery_wrap_test(struct kunit *test)
 	KUNIT_EXPECT_TRUE(test, ave_recovery_allow(&h, start + AVE_RECOVERY_WINDOW));
 }
 
+static void ave_recovery_domain_test(struct kunit *test)
+{
+	KUNIT_EXPECT_TRUE(test, ave_domain_type_safe(IOMMU_DOMAIN_DMA));
+	KUNIT_EXPECT_FALSE(test, ave_domain_type_safe(IOMMU_DOMAIN_DMA_FQ));
+	KUNIT_EXPECT_FALSE(test, ave_domain_type_safe(IOMMU_DOMAIN_IDENTITY));
+	KUNIT_EXPECT_FALSE(test, ave_domain_type_safe(IOMMU_DOMAIN_BLOCKED));
+	KUNIT_EXPECT_FALSE(test, ave_domain_type_safe(IOMMU_DOMAIN_UNMANAGED));
+	KUNIT_EXPECT_FALSE(test, ave_domain_type_safe(0));
+}
+
+static void ave_recovery_witness_dart_test(struct kunit *test)
+{
+	KUNIT_EXPECT_TRUE(test, ave_witness_armed(0x10000));
+	KUNIT_EXPECT_TRUE(test, ave_witness_armed(0x10400));
+	KUNIT_EXPECT_FALSE(test, ave_witness_armed(0));
+
+	/* Linux's own stream, translating */
+	KUNIT_EXPECT_EQ(test, ave_dart_classify(0x1, 0x40001, true, 0, 0x40001),
+			AVE_DART_STREAM_OURS);
+	/* Off streams fault */
+	KUNIT_EXPECT_EQ(test, ave_dart_classify(0, 0, false, 0, 0x40001),
+			AVE_DART_STREAM_OFF);
+	/* Bypass on any stream, ours included */
+	KUNIT_EXPECT_EQ(test, ave_dart_classify(0x6, 0, false, 0, 0x40001),
+			AVE_DART_STREAM_UNSAFE);
+	KUNIT_EXPECT_EQ(test, ave_dart_classify(0x2, 0, true, 0, 0x40001),
+			AVE_DART_STREAM_UNSAFE);
+	/* Another stream translating through other tables */
+	KUNIT_EXPECT_EQ(test, ave_dart_classify(0x1, 0x90001, false, 0, 0x40001),
+			AVE_DART_STREAM_UNSAFE);
+	/* ... or through ours */
+	KUNIT_EXPECT_EQ(test, ave_dart_classify(0x1, 0x40001, false, 0, 0x40001),
+			AVE_DART_STREAM_OURS);
+	/* Remapped onto ours, or onto another stream */
+	KUNIT_EXPECT_EQ(test, ave_dart_classify(0x80, 0, false, 0, 0x40001),
+			AVE_DART_STREAM_OURS);
+	KUNIT_EXPECT_EQ(test, ave_dart_classify(0x280, 0, false, 0, 0x40001),
+			AVE_DART_STREAM_UNSAFE);
+}
+
 static struct kunit_case ave_recovery_cases[] = {
+	KUNIT_CASE(ave_recovery_witness_dart_test),
+	KUNIT_CASE(ave_recovery_domain_test),
 	KUNIT_CASE(ave_recovery_limit_test),
 	KUNIT_CASE(ave_recovery_sliding_test),
 	KUNIT_CASE(ave_recovery_wrap_test),
diff --git a/drivers/media/platform/apple/ave/ave-recovery.h b/drivers/media/platform/apple/ave/ave-recovery.h
index 93de1e2471..b2253060df 100644
--- a/drivers/media/platform/apple/ave/ave-recovery.h
+++ b/drivers/media/platform/apple/ave/ave-recovery.h
@@ -2,6 +2,7 @@
 #ifndef _APPLE_AVE_RECOVERY_H_
 #define _APPLE_AVE_RECOVERY_H_
 
+#include <linux/iommu.h>
 #include <linux/jiffies.h>
 #include <linux/types.h>
 
@@ -27,4 +28,54 @@ static inline bool ave_recovery_allow(struct ave_recovery_history *h, unsigned l
 	return true;
 }
 
+/*
+ * The encoder may only run on a strict translating DMA domain: an unmap
+ * invalidates the DART before the pages go back. A flush queue (DMA-FQ),
+ * a bypass or no domain at all would let a late firmware write reach memory
+ * the kernel has reused.
+ */
+static inline bool ave_domain_type_safe(unsigned int type)
+{
+	return type == IOMMU_DOMAIN_DMA;
+}
+
+/* A coprocessor-set BOOT_ARG: nonzero while it has power, zero after reset. */
+static inline bool ave_witness_armed(u32 boot_arg)
+{
+	return boot_arg != 0;
+}
+
+/* T8110 DART stream control bits, as the audit reads them */
+#define AVE_DART_TCR_TRANSLATE	0x001U
+#define AVE_DART_TCR_BYPASS	0x002U
+#define AVE_DART_TCR_BYPASS_DAPF	0x004U
+#define AVE_DART_TCR_REMAP_EN	0x080U
+#define AVE_DART_TCR_REMAP	0xf00U
+
+enum ave_dart_stream {
+	AVE_DART_STREAM_OFF,	/* no translation, no bypass: faults */
+	AVE_DART_STREAM_OURS,	/* Linux's domain (or remapped onto it) */
+	AVE_DART_STREAM_UNSAFE,	/* bypass, or tables that are not Linux's */
+};
+
+/*
+ * @own is the stream Linux attached, @own_ttbr its table base. Any bypass
+ * is unsafe. Translation is ours only on @own, or on another stream using
+ * the same table base. A remap is ours only onto @own.
+ */
+static inline enum ave_dart_stream ave_dart_classify(u32 tcr, u32 ttbr, bool is_own,
+						     u32 own, u32 own_ttbr)
+{
+	if (tcr & (AVE_DART_TCR_BYPASS | AVE_DART_TCR_BYPASS_DAPF))
+		return AVE_DART_STREAM_UNSAFE;
+	if (tcr & AVE_DART_TCR_REMAP_EN)
+		return ((tcr & AVE_DART_TCR_REMAP) >> 8) == own ?
+			AVE_DART_STREAM_OURS : AVE_DART_STREAM_UNSAFE;
+	if (!(tcr & AVE_DART_TCR_TRANSLATE))
+		return AVE_DART_STREAM_OFF;
+	if (is_own || ttbr == own_ttbr)
+		return AVE_DART_STREAM_OURS;
+	return AVE_DART_STREAM_UNSAFE;
+}
+
 #endif
