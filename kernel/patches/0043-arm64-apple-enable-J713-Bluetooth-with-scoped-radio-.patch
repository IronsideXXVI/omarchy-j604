 		pm_runtime_put(stream.dart->dev);
 		err = err ?: ret;
 	}
@@ -1762,6 +2089,9 @@ static int apple_dart_map_pages(struct iommu_domain *domain, unsigned long iova,
 
 	if (!ops)
 		return -ENODEV;
+	if (dart_domain->stream_maps[0].dart &&
+	    READ_ONCE(dart_domain->stream_maps[0].dart->managed_failed))
