From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sean Dolbec <sdolbec1@gmail.com>
Date: Sun, 1 Nov 2026 21:03:05 -0500
Subject: [PATCH] arm64: dts: apple: t8132-j773g: Enable the SSD, Wi-Fi,
 Bluetooth and Ethernet

Enable the internal NVMe SSD (ANS2, its SART and mailbox) and the
internal PCIe controller on the M4 Mac mini, with the BCM4388 Wi-Fi and
Bluetooth module on port 0 and the Ethernet controller on port 2. With
this the mini boots from its own SSD and reaches the network, with the
display on the boot framebuffer.

- Port 0 is powered by SMC GPIO 19 (pwren-pcie0-port0). Its Wi-Fi and
  Bluetooth functions use the "apple,sakhalin" firmware.
- Port 2 has its own DART. The requester IDs map to stream 1 of the
  port 0 and port 2 DARTs.
- The ethernet0, wifi0 and bluetooth0 aliases let m1n1 fill in the MAC
  and Bluetooth addresses and the Wi-Fi calibration.

The board wiring follows Yureka Lilian's J773g PCIe description ("t8132
pcie", picked into GravityLinux gravity-m4 as 9edf52c13ea3) and the
board-type fix in gravity-m4's current J773g tree. The ATC (USB-C) ports,
HDMI, audio, CPU frequency scaling and the GPU are not part of this
change.

A J773g runs these board nodes today under gravity-m4 7.1.13 (AQC113 on
the atlantic driver, BCM4388 on brcmfmac and hci_bcm4377, NVMe root
file system); this tree with this commit has not been booted yet.

Signed-off-by: Sean Dolbec <sdolbec1@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t8132-j773g.dts | 82 +++++++++++++++++++++++
 1 file changed, 82 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j773g.dts b/arch/arm64/boot/dts/apple/t8132-j773g.dts
index 12ba8b854b..e8e05f8d9a 100644
--- a/arch/arm64/boot/dts/apple/t8132-j773g.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j773g.dts
@@ -15,6 +15,19 @@
 / {
 	compatible = "apple,j773g", "apple,t8132", "apple,arm-platform";
 	model = "Apple Mac mini (M4, 2024)";
+
+	aliases {
+		bluetooth0 = &bluetooth0;
+		ethernet0 = &ethernet0;
+		wifi0 = &wifi0;
+	};
+
+	vreg_pcie0_port0: regulator-pcie0-port0 {
+		compatible = "regulator-fixed";
+		regulator-name = "pwren-pcie0-port0";
+		gpio = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
 };
 
 /*
@@ -95,3 +108,72 @@
 		};
 	};
 };
+
+/* Internal SSD */
+
+&ans_mbox {
+	status = "okay";
+};
+
+&sart {
+	status = "okay";
+};
+
+&nvme {
+	status = "okay";
+};
+
+/*
+ * Internal PCIe: Wi-Fi and Bluetooth (BCM4388) on port 0 and Ethernet on
+ * port 2 (an AQC113 on the 10 Gb Ethernet model). Port 1 is not wired.
+ * Fixed bus numbers let the device nodes below carry the MAC and
+ * Bluetooth addresses and the calibration the loader fills in.
+ */
+
+&pcie0 {
+	iommu-map = <0x100 &pcie0_dart 1 1>,
+		    <0x200 &pcie2_dart 1 1>;
+	status = "okay";
+};
+
+&pcie0_dart {
+	status = "okay";
+};
+
+&pcie2_dart {
+	status = "okay";
+};
+
+&pcie0_port0 {
+	power-supply = <&vreg_pcie0_port0>;
+	bus-range = <1 1>;
+	status = "okay";
+
+	wifi0: wifi@0,0 {
+		compatible = "pci14e4,4434";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+		/* To be filled by the loader */
+		local-mac-address = [00 00 00 00 00 00];
+		apple,antenna-sku = "XX";
+		brcm,board-type = "apple,sakhalin";
+	};
+
+	bluetooth0: bluetooth@0,1 {
+		compatible = "pci14e4,5f72";
+		reg = <0x10100 0x0 0x0 0x0 0x0>;
+		/* To be filled by the loader */
+		local-bd-address = [00 00 00 00 00 00];
+		brcm,board-type = "apple,sakhalin";
+	};
+};
+
+&pcie0_port2 {
+	bus-range = <2 2>;
+	status = "okay";
+
+	ethernet0: ethernet@0,0 {
+		reg = <0x20000 0x0 0x0 0x0 0x0>;
+		/* To be filled by the loader */
+		local-mac-address = [00 10 18 00 00 00];
+	};
+};
