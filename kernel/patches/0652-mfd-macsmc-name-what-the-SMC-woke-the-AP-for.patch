From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:17 -0500
Subject: [PATCH] mfd: macsmc: name what the SMC woke the AP for

MBSW is a bitmap of why the SMC had the AP woken, little-endian. macOS
names each set bit from smc-pmu's event_name properties and passes it on
as the wake reason. Do the same with T8140's numbering, from its ADT:
the names go on the wake record's line, and a set record is a wakeup
event on the SMC's device, which is now wakeup capable.

Measured on a J700: the power button wakes with pwrbtn, the lid with
lid, a USB keyboard with USB2_wake and a Wi-Fi magic packet with wifibt.

Signed-off-by: Diljit Singh <hey@djdev.me>

[j604 backport: MBSW names per SoC: Aurora's T8140 table kept as the default (its KUnit case expects it), a T8132 table added from the J604 ADT (25G83 template, arm-io/smc/iop-smc-nub/smc-pmu event_name-bitN, MEASURED: lid is bit 8, codec bit 10), picked with of_machine_is_compatible(apple,t8132); the T8152 telemetry-only probe branch in the conflict is Aurora-only and not taken]
Assisted-by: Claude:claude-opus-5.5

---
 drivers/mfd/macsmc-test.c  | 13 +++++++++
 drivers/mfd/macsmc.c       | 59 +++++++++++++++++++++++++++++++++++++-
 include/linux/mfd/macsmc.h |  2 ++
 3 files changed, 73 insertions(+), 1 deletion(-)

diff --git a/drivers/mfd/macsmc-test.c b/drivers/mfd/macsmc-test.c
index 2e0824a7c5..5e38da0dab 100644
--- a/drivers/mfd/macsmc-test.c
+++ b/drivers/mfd/macsmc-test.c
@@ -279,6 +279,18 @@ static void macsmc_notice_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, ctx->seen[3], SMC_KEY(MBSW));
 }
 
+static void macsmc_wake_reason_test(struct kunit *test)
+{
+	char names[128];
+
+	KUNIT_EXPECT_EQ(test, apple_smc_wake_reason_names(0, names, sizeof(names)), 0);
+	KUNIT_EXPECT_STREQ(test, names, "");
+
+	/* A bit with no name is left out. */
+	apple_smc_wake_reason_names(BIT_ULL(23) | BIT_ULL(42) | BIT_ULL(1), names, sizeof(names));
+	KUNIT_EXPECT_STREQ(test, names, "wifibt USB-C_plug");
+}
+
 static struct kunit_case macsmc_parser_cases[] = {
 	KUNIT_CASE(macsmc_key_info_lock_test),
 	KUNIT_CASE(macsmc_key_index_test),
@@ -292,6 +304,7 @@ static struct kunit_case macsmc_parser_cases[] = {
 	KUNIT_CASE(macsmc_sleep_order_test),
 	KUNIT_CASE(macsmc_sleep_refused_test),
 	KUNIT_CASE(macsmc_notice_test),
+	KUNIT_CASE(macsmc_wake_reason_test),
 	{}
 };
 
diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
index a258275fcd..659a92c8ac 100644
--- a/drivers/mfd/macsmc.c
+++ b/drivers/mfd/macsmc.c
@@ -572,6 +572,10 @@ static int apple_smc_probe(struct platform_device *pdev)
 		return dev_err_probe(smc->dev, ret, "Failed to get key count");
 	smc->key_count = be32_to_cpu(count);
 
+	ret = devm_device_init_wakeup(dev);
+	if (ret)
+		return ret;
+
 	/* Enable notifications */
 	apple_smc_write_flag(smc, SMC_KEY(NTAP), true);
 	ret = devm_add_action_or_reset(dev, apple_smc_disable_notifications, smc);
@@ -807,9 +811,56 @@ static int apple_smc_sleep_commit(struct apple_smc *smc)
 	return ret;
 }
 
+struct apple_smc_wake_reason {
+	u8 bit;
+	const char *name;
+};
+
+/* MBSW's bits, as smc-pmu's event_name properties number them on T8140. Other SoCs differ. */
+static const struct apple_smc_wake_reason apple_smc_wake_reasons[] = {
+	{ 0, "pwrbtn" }, { 9, "ipd_touch" }, { 10, "lid" }, { 16, "ipd_kbd" },
+	{ 18, "charger" }, { 23, "wifibt" }, { 40, "acattach" }, { 41, "acdetach" },
+	{ 42, "USB-C_plug" }, { 43, "USB2_plug" }, { 44, "USB2_wake" }, { 45, "aupo" },
+	{ 48, "rtc" },
+};
+
+/* The same on T8132, from the J604's ADT (smc-pmu, event_name-bitN). */
+static const struct apple_smc_wake_reason apple_smc_wake_reasons_t8132[] = {
+	{ 0, "pwrbtn" }, { 8, "lid" }, { 9, "sdconn" }, { 10, "codec" },
+	{ 11, "charger" }, { 12, "ipd" }, { 13, "wifibt" }, { 40, "acattach" },
+	{ 41, "acdetach" }, { 42, "USB-C_plug" }, { 43, "USB2_plug" }, { 44, "USB2_wake" },
+	{ 45, "aupo" }, { 48, "rtc" },
+};
+
+static const struct apple_smc_wake_reason *apple_smc_wake_table(unsigned int *count)
+{
+	if (of_machine_is_compatible("apple,t8132")) {
+		*count = ARRAY_SIZE(apple_smc_wake_reasons_t8132);
+		return apple_smc_wake_reasons_t8132;
+	}
+	*count = ARRAY_SIZE(apple_smc_wake_reasons);
+	return apple_smc_wake_reasons;
+}
+
+static int apple_smc_wake_reason_names(u64 record, char *buf, size_t size)
+{
+	const struct apple_smc_wake_reason *r;
+	unsigned int i, n;
+	int len = 0;
+
+	r = apple_smc_wake_table(&n);
+	buf[0] = 0;
+	for (i = 0; i < n; i++)
+		if (record & BIT_ULL(r[i].bit))
+			len += scnprintf(buf + len, size - len, "%s%s", len ? " " : "", r[i].name);
+
+	return len;
+}
+
 static void apple_smc_notice_on(struct apple_smc *smc)
 {
 	u8 record[8] = {};
+	char names[128];
 	u32 event = 0;
 	int ret;
 
@@ -824,7 +875,13 @@ static void apple_smc_notice_on(struct apple_smc *smc)
 	ret = apple_smc_read(smc, SMC_KEY(MBSW), record, sizeof(record));
 	if (ret < 0)
 		dev_warn(smc->dev, "Failed to read MBSW after a wake: %d\n", ret);
-	dev_dbg(smc->dev, "wake record: MBSE %#x, MBSW %8ph\n", event, record);
+
+	smc->wake_record = get_unaligned_le64(record);
+	apple_smc_wake_reason_names(smc->wake_record, names, sizeof(names));
+	dev_info(smc->dev, "wake record: MBSE %#x, MBSW %8ph%s%s\n", event, record,
+		 names[0] ? ": " : "", names);
+	if (smc->wake_record)
+		pm_wakeup_event(smc->dev, 0);
 }
 
 static void apple_smc_sleep_wake(struct apple_smc *smc)
diff --git a/include/linux/mfd/macsmc.h b/include/linux/mfd/macsmc.h
index eb34447ab9..0f9cd33b46 100644
--- a/include/linux/mfd/macsmc.h
+++ b/include/linux/mfd/macsmc.h
@@ -119,6 +119,8 @@ struct apple_smc {
 	bool sleep_warned;
 	/* In a noirq phase: replies are polled for. */
 	bool polled;
+	/* MBSW at the last wake: what the SMC had woken the AP for. */
+	u64 wake_record;
 
 	struct completion init_done;
 	enum apple_smc_boot_stage boot_stage;
