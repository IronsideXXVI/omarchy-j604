From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 07:50:48 +0000
Subject: [PATCH] drm/apple: test which timings fit a firmware-derived
 EDID

Based on the KUnit case of 64b5791c7133 ("drm/apple: Give a sink with a
fast preferred mode a firmware-derived EDID", Diljit Singh), whose
parser-test.c hunk does not apply to this tree's parser-test.c: the
same case, parser_metadata_timing_fits, placed before
parser_color_presence and listed after it. A 3840x2160 timing at
594 MHz with explicit sync polarity fits an EDID detailed timing; the
same timing at 1188 MHz (120 Hz) and one without polarity do not.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/parser-test.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/gpu/drm/apple/parser-test.c b/drivers/gpu/drm/apple/parser-test.c
index 42727597ac..0de795414c 100644
--- a/drivers/gpu/drm/apple/parser-test.c
+++ b/drivers/gpu/drm/apple/parser-test.c
@@ -307,6 +307,23 @@ static void parser_sdr_default_rgb(struct kunit *test)
 	}
 }
 
+/* Only a timing at most 655.35 MHz, with explicit polarity, fits an EDID detailed timing. */
+static void parser_metadata_timing_fits(struct kunit *test)
+{
+	struct drm_display_mode mode = {
+		.clock = 594000, .hdisplay = 3840, .hsync_start = 4016, .hsync_end = 4104,
+		.htotal = 4400, .vdisplay = 2160, .vsync_start = 2168, .vsync_end = 2178,
+		.vtotal = 2250, .flags = DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC,
+	};
+
+	KUNIT_EXPECT_TRUE(test, dcp_metadata_timing_fits(&mode));
+	mode.clock = 1188000;	/* the same timing at 120 Hz */
+	KUNIT_EXPECT_FALSE(test, dcp_metadata_timing_fits(&mode));
+	mode.clock = 594000;
+	mode.flags = 0;
+	KUNIT_EXPECT_FALSE(test, dcp_metadata_timing_fits(&mode));
+}
+
 static void parser_color_presence(struct kunit *test)
 {
 	struct parser_record record = valid_record(7, 10);
@@ -1981,6 +1998,7 @@ static struct kunit_case parser_cases[] = {
 	KUNIT_CASE(parser_score_presence),
 	KUNIT_CASE(parser_legacy_ties),
 	KUNIT_CASE(parser_color_presence),
+	KUNIT_CASE(parser_metadata_timing_fits),
 	KUNIT_CASE(parser_sdr_default_rgb),
 	KUNIT_CASE(parser_geometry),
 	KUNIT_CASE(parser_bad_geometry),
-- 
