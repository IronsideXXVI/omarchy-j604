+/*
+ * The first 28 bytes of frame 0 of two prores_ks streams (FFmpeg 9.0.2,
+ * 10-bit input): 1920x1080 422 HQ and 3840x2160 4444, no alpha.
+ */
+static const u8 apr_ks_422_1080[28] = {
+	0x00, 0x0e, 0x91, 0xca, 'i', 'c', 'p', 'f', 0x00, 0x94, 0x00, 0x00,
+	'L', 'a', 'v', 'c', 0x07, 0x80, 0x04, 0x38, 0x80, 0x00, 0x02, 0x02,
+	0x02, 0x00, 0x00, 0x03,
+};
+
+static const u8 apr_ks_4444_4k[28] = {
+	0x00, 0x57, 0x95, 0xaa, 'i', 'c', 'p', 'f', 0x00, 0x94, 0x00, 0x01,
+	'L', 'a', 'v', 'c', 0x0f, 0x00, 0x08, 0x70, 0xc0, 0x00, 0x02, 0x02,
+	0x02, 0x00, 0x00, 0x03,
+};
+
+KUNIT_DEFINE_ACTION_WRAPPER(apr_test_vfree, vfree, const void *);
+
+/* A real frame of @bytes bytes whose first 28 bytes are @hdr. */
+static u8 *apr_ks_frame(struct kunit *test, const u8 *hdr, size_t bytes)
+{
+	u8 *b = vzalloc(bytes);
+
+	KUNIT_ASSERT_NOT_NULL(test, b);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, apr_test_vfree, b), 0);
+	memcpy(b, hdr, 28);
+	return b;
+}
+
+static void apr_test_frame_header_ks(struct kunit *test)
+{
+	struct apr_frame_info fi;
+	u8 *b;
+
+	b = apr_ks_frame(test, apr_ks_422_1080, 0x0e91ca);
+	KUNIT_ASSERT_EQ(test, apr_parse_frame_header(b, 0x0e91ca, &fi), 0);
+	KUNIT_EXPECT_EQ(test, fi.frame_bytes, 0x0e91ca);
+	KUNIT_EXPECT_EQ(test, fi.width, 1920);
+	KUNIT_EXPECT_EQ(test, fi.height, 1080);
+	KUNIT_EXPECT_FALSE(test, fi.is444);
+	KUNIT_EXPECT_EQ(test, fi.interlace, 0);
+	KUNIT_EXPECT_EQ(test, fi.alpha, 0);
+	/* A buffer one byte short of the frame is refused. */
+	KUNIT_EXPECT_EQ(test, apr_parse_frame_header(b, 0x0e91c9, &fi), -EINVAL);
+
+	b = apr_ks_frame(test, apr_ks_4444_4k, 0x5795aa);
+	KUNIT_ASSERT_EQ(test, apr_parse_frame_header(b, 0x5795aa, &fi), 0);
+	KUNIT_EXPECT_EQ(test, fi.width, 3840);
+	KUNIT_EXPECT_EQ(test, fi.height, 2160);
+	KUNIT_EXPECT_TRUE(test, fi.is444);
+	KUNIT_EXPECT_EQ(test, fi.interlace, 0);
+	KUNIT_EXPECT_EQ(test, fi.alpha, 0);
+}
+
+/*
+ * CAPTURE layout and the decode descriptor for both fixtures: chroma after
+ * the 16-row rounded luma, frame size at 0x14/0x16, planes at 0x28/0x38.
+ */
+static void apr_test_dec_layout(struct kunit *test)
+{
+	struct apr_frame_info fi;
+	struct apr_dec_layout l;
+	struct apr_dec_frame f;
+	u8 desc[APR_DEC_DESC_BYTES];
+
+	KUNIT_ASSERT_EQ(test, apr_parse_frame_header(apr_ks_422_1080, 28, &fi),
+			-EINVAL);	/* only 28 bytes of a larger frame */
+	fi = (struct apr_frame_info){ .width = 1920, .height = 1080 };
+	KUNIT_ASSERT_EQ(test, apr_dec_layout(&fi, APR_INPUT_422_16, &l), 0);
+	KUNIT_EXPECT_EQ(test, l.luma_stride, 3840);
+	KUNIT_EXPECT_EQ(test, l.chroma_stride, 3840);
+	KUNIT_EXPECT_EQ(test, l.coded_height, 1088);
+	KUNIT_EXPECT_EQ(test, l.chroma_offset, 3840 * 1088);
+	KUNIT_EXPECT_EQ(test, l.size, 7680 * 1088);
+	KUNIT_ASSERT_EQ(test, apr_dec_layout(&fi, APR_INPUT_422_8, &l), 0);
+	KUNIT_EXPECT_EQ(test, l.luma_stride, 1920);
+	KUNIT_EXPECT_EQ(test, l.size, 3840 * 1088);
+
+	f = (struct apr_dec_frame){
+		.width = 1920, .height = 1080, .output = APR_INPUT_422_16,
+		.luma_stride = 3840, .chroma_stride = 3840,
+		.input = 0x100000000ULL, .luma = 0x200000000ULL,
+		.chroma = 0x200000000ULL + 3840 * 1088, .fid = 7,
+	};
+	KUNIT_ASSERT_EQ(test, apr_build_decode_desc(&f, desc), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(desc + 0x14), 1920);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(desc + 0x16), 1080);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(desc + 0x28), 0x200000000ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(desc + 0x38),
+			0x200000000ULL + 3840 * 1088);
+	/* Opcode 2 in bits 11:8, 4:2:2, 16-bit, interrupt, fid 7. */
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(desc), 0x00071000 | 0x200 | 2 << 2 | 3);
+
+	fi = (struct apr_frame_info){ .width = 3840, .height = 2160, .is444 = true };
+	KUNIT_ASSERT_EQ(test, apr_dec_layout(&fi, APR_INPUT_444_16, &l), 0);
+	KUNIT_EXPECT_EQ(test, l.luma_stride, 7680);
+	KUNIT_EXPECT_EQ(test, l.chroma_stride, 15360);
+	KUNIT_EXPECT_EQ(test, l.coded_height, 2160);
+	KUNIT_EXPECT_EQ(test, l.size, 23040 * 2160);
+
+	/* No 4:2:2 <-> 4:4:4 conversion, no odd widths, no oversize frames. */
+	KUNIT_EXPECT_EQ(test, apr_dec_layout(&fi, APR_INPUT_422_16, &l), -EINVAL);
+	fi.is444 = false;
+	KUNIT_EXPECT_EQ(test, apr_dec_layout(&fi, APR_INPUT_444_8, &l), -EINVAL);
+	fi.width = 3841;
+	KUNIT_EXPECT_EQ(test, apr_dec_layout(&fi, APR_INPUT_422_8, &l), -EINVAL);
+	fi.width = APR_DEC_MAX_DIM + 2;
+	KUNIT_EXPECT_EQ(test, apr_dec_layout(&fi, APR_INPUT_422_8, &l), -EINVAL);
+}
