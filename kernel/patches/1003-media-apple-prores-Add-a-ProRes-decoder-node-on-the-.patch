From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 24 Nov 2026 04:49:10 +0000
Subject: [PATCH] media: apple: prores: Add a ProRes decoder node on
 the same engine

The engine also runs YCbCr decode jobs. Register a second
memory-to-memory node, apple-prores-dec, on SoCs whose variant can
decode (T8132): OUTPUT takes one ProRes frame per buffer, CAPTURE is
NV16, NV24, P216 or P416 in one buffer, luma then chroma, each over
the height rounded up to whole macroblocks.

The frame header is parsed when an OUTPUT buffer is prepared, so a
frame that cannot be placed is refused at QBUF. A new size or chroma
format resizes an idle CAPTURE queue and raises SOURCE_CHANGE, and a
job waits in job_ready() until CAPTURE matches its frame.

Both nodes share the descriptor ring, hw_lock and one m2m device, so
encode and decode jobs run one at a time. Encode is unchanged.
---
 .../platform/apple/prores/apple-prores-desc.c |  25 +
 .../platform/apple/prores/apple-prores-drv.c  | 457 +++++++++++++++++-
 .../platform/apple/prores/apple-prores-test.c | 113 +++++
 .../platform/apple/prores/apple-prores.h      |  14 +
 4 files changed, 598 insertions(+), 11 deletions(-)

diff --git a/drivers/media/platform/apple/prores/apple-prores-desc.c b/drivers/media/platform/apple/prores/apple-prores-desc.c
index e88884007ce..9ac831a4212 100644
--- a/drivers/media/platform/apple/prores/apple-prores-desc.c
+++ b/drivers/media/platform/apple/prores/apple-prores-desc.c
@@ -589,6 +589,31 @@ int apr_parse_frame_header(const u8 *buf, size_t len, struct apr_frame_info *inf
 }
 EXPORT_SYMBOL_IF_KUNIT(apr_parse_frame_header);
 
+/*
+ * Where a decoded frame goes in one CAPTURE buffer. The engine works in
+ * 16-row macroblocks, so luma and chroma each cover the height rounded up
+ * to 16 and chroma starts after the rounded luma: a write of the padding
+ * rows can never reach the other plane. The chroma format must match the
+ * stream; the decoder does not convert between 4:2:2 and 4:4:4.
+ */
+int apr_dec_layout(const struct apr_frame_info *fi, enum apr_input out,
+		   struct apr_dec_layout *l)
+{
+	bool deep = out == APR_INPUT_422_16 || out == APR_INPUT_444_16;
+
+	if ((unsigned int)out > APR_INPUT_444_16 || !fi->width ||
+	    !fi->height || fi->width & 1 || fi->width > APR_DEC_MAX_DIM ||
+	    fi->height > APR_DEC_MAX_DIM || apr_input_is_444(out) != fi->is444)
+		return -EINVAL;
+	l->coded_height = ALIGN(fi->height, 16);
+	l->luma_stride = ALIGN(fi->width * (deep ? 2 : 1), 64);
+	l->chroma_stride = l->luma_stride * (fi->is444 ? 2 : 1);
+	l->chroma_offset = l->luma_stride * l->coded_height;
+	l->size = (l->luma_stride + l->chroma_stride) * l->coded_height;
+	return 0;
+}
+EXPORT_SYMBOL_IF_KUNIT(apr_dec_layout);
+
 /*
  * A finished frame starts with its big-endian length, which counts the whole
  * frame, followed by the 'icpf' frame identifier.
diff --git a/drivers/media/platform/apple/prores/apple-prores-drv.c b/drivers/media/platform/apple/prores/apple-prores-drv.c
index e1cda094df1..e2561dc5f7a 100644
--- a/drivers/media/platform/apple/prores/apple-prores-drv.c
+++ b/drivers/media/platform/apple/prores/apple-prores-drv.c
@@ -494,6 +494,8 @@ struct apr_variant {
 	unsigned int num_irqs;
 	u32 ring_bytes;
 	u32 desc_bytes;
+	/* The engine runs YCbCr decode jobs too (second video node). */
+	bool can_decode;
 	/* Optional per-machine APRI file that replaces the built-in rows. */
 	const char *firmware_name;
 	const struct apri_layout *apri;
@@ -561,6 +563,7 @@ static const struct apr_variant apr_t8132 = {
 	.num_irqs = 1,
 	.ring_bytes = APR_RING_BYTES,
 	.desc_bytes = APR_DESC_BYTES,
+	.can_decode = true,
 	.firmware_name = APRI_T8132_FIRMWARE_NAME,
 	.apri = &apri_t8132,
 };
@@ -598,7 +601,8 @@ struct apr_dev {
 
 	struct v4l2_device v4l2_dev;
 	struct video_device vdev;
-	struct v4l2_m2m_dev *m2m_dev;
+	struct video_device dec_vdev;	/* decoder node, same engine and ring */
+	struct v4l2_m2m_dev *m2m_dev;	/* shared: one job at a time on both nodes */
 	struct mutex vdev_lock;	/* serialises ioctls and queue state */
 
 	/* Descriptor ring, written by the CPU and read by the engine. */
@@ -628,8 +632,22 @@ struct apr_ctx {
 	const struct apr_fmt *raw;
 	enum apr_profile stream_profile;	/* fixed while OUTPUT streams */
 	u32 sequence;
+	bool dec;			/* opened through the decoder node */
+	struct apr_frame_info info;	/* stream header CAPTURE follows */
+	bool have_info;			/* a header has been announced */
 };
 
+/* A decoder buffer and, on OUTPUT, the frame header parsed at prepare. */
+struct apr_dec_buf {
+	struct v4l2_m2m_buffer m2m;
+	struct apr_frame_info info;
+};
+
+static struct apr_dec_buf *to_apr_dec_buf(struct vb2_v4l2_buffer *vbuf)
+{
+	return container_of(vbuf, struct apr_dec_buf, m2m.vb);
+}
+
 static struct apr_ctx *apr_file_to_ctx(struct file *file)
 {
 	return container_of(file_to_v4l2_fh(file), struct apr_ctx, fh);
@@ -797,7 +815,9 @@ static void apr_finish_job(struct apr_dev *apr, struct apr_ctx *ctx, int err)
 	if (WARN_ON(!src || !dst))
 		goto out;
 
-	if (!err) {
+	if (!err && ctx->dec) {
+		bytes = ctx->dst_fmt.plane_fmt[0].sizeimage;
+	} else if (!err) {
 		u8 *out = vb2_plane_vaddr(&dst->vb2_buf, 0);
 
 		/* The engine wrote the frame through the DART; see it now. */
@@ -947,6 +967,84 @@ static void apr_ring_publish(struct apr_dev *apr, struct apr_ctx *ctx, u32 next)
 	writel(apr->head, apr->regs + APR_REG_RING_HEAD);
 }
 
+/*
+ * Fill a decode job from the frame header parsed at prepare and the CAPTURE
+ * format. job_ready() only lets a job through when they agree.
+ */
+static int apr_dec_fill_frame(struct apr_ctx *ctx, struct vb2_v4l2_buffer *src,
+			      struct vb2_v4l2_buffer *dst, struct apr_dec_frame *f)
+{
+	const struct apr_frame_info *fi = &to_apr_dec_buf(src)->info;
+	const struct v4l2_pix_format_mplane *d = &ctx->dst_fmt;
+	struct apr_dec_layout l;
+	dma_addr_t out;
+	int ret;
+
+	ret = apr_dec_layout(fi, ctx->raw->input, &l);
+	if (ret)
+		return ret;
+	if (d->width != fi->width || d->height != l.coded_height ||
+	    d->plane_fmt[0].bytesperline != l.luma_stride ||
+	    vb2_plane_size(&dst->vb2_buf, 0) < l.size)
+		return -EINVAL;
+	out = vb2_dma_contig_plane_dma_addr(&dst->vb2_buf, 0);
+	*f = (struct apr_dec_frame){
+		.width = fi->width,
+		.height = fi->height,
+		.output = ctx->raw->input,
+		.luma_stride = l.luma_stride,
+		.chroma_stride = l.chroma_stride,
+		.input = vb2_dma_contig_plane_dma_addr(&src->vb2_buf, 0),
+		.luma = out,
+		.chroma = out + l.chroma_offset,
+		.fid = ctx->sequence,
+		.interlaced = fi->interlace != 0,
+	};
+	return 0;
+}
+
+static void apr_dec_run(struct apr_ctx *ctx)
+{
+	struct apr_dev *apr = ctx->apr;
+	struct vb2_v4l2_buffer *src, *dst;
+	struct apr_dec_frame f;
+	unsigned long flags;
+	u32 next;
+	int ret;
+
+	src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+
+	ret = pm_runtime_resume_and_get(apr->dev);
+	if (ret < 0) {
+		pm_runtime_get_noresume(apr->dev);
+		apr_finish_job(apr, ctx, ret);
+		return;
+	}
+	ret = apr_dec_fill_frame(ctx, src, dst, &f);
+	if (ret) {
+		apr_finish_job(apr, ctx, ret);
+		return;
+	}
+
+	spin_lock_irqsave(&apr->hw_lock, flags);
+	if (apr->broken) {
+		spin_unlock_irqrestore(&apr->hw_lock, flags);
+		apr_finish_job(apr, ctx, -EIO);
+		return;
+	}
+	next = apr_ring_reserve(apr, APR_DEC_DESC_BYTES);
+	ret = apr_build_decode_desc(&f, apr->ring + next - APR_DEC_DESC_BYTES);
+	if (ret) {
+		spin_unlock_irqrestore(&apr->hw_lock, flags);
+		apr_finish_job(apr, ctx, ret);
+		return;
+	}
+	apr_ring_publish(apr, ctx, next);
+	spin_unlock_irqrestore(&apr->hw_lock, flags);
+	schedule_delayed_work(&apr->watchdog, msecs_to_jiffies(APR_POLL_MS));
+}
+
 static void apr_device_run(void *priv)
 {
 	struct apr_ctx *ctx = priv;
@@ -958,6 +1056,11 @@ static void apr_device_run(void *priv)
 	void *out;
 	int ret;
 
+	if (ctx->dec) {
+		apr_dec_run(ctx);
+		return;
+	}
+
 	src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
 	dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
 
@@ -995,8 +1098,32 @@ static void apr_device_run(void *priv)
 	schedule_delayed_work(&apr->watchdog, msecs_to_jiffies(APR_POLL_MS));
 }
 
+/*
+ * A decode job waits while CAPTURE is laid out for another stream header;
+ * the client follows the SOURCE_CHANGE event first. Encode jobs always run.
+ */
+static int apr_job_ready(void *priv)
+{
+	struct apr_ctx *ctx = priv;
+	const struct apr_frame_info *fi;
+	struct vb2_v4l2_buffer *src;
+	struct apr_dec_layout l;
+
+	if (!ctx->dec)
+		return 1;
+	src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	if (!src)
+		return 0;
+	fi = &to_apr_dec_buf(src)->info;
+	if (apr_dec_layout(fi, ctx->raw->input, &l))
+		return 0;
+	return ctx->dst_fmt.width == fi->width &&
+	       ctx->dst_fmt.height == l.coded_height;
+}
+
 static const struct v4l2_m2m_ops apr_m2m_ops = {
 	.device_run = apr_device_run,
+	.job_ready = apr_job_ready,
 };
 
 /* ---- formats ----------------------------------------------------------- */
@@ -1201,6 +1328,240 @@ static const struct v4l2_ioctl_ops apr_ioctl_ops = {
 	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
 };
 
+/* ---- decoder formats ---------------------------------------------------- */
+
+static const struct apr_fmt *apr_dec_pick_raw(const struct apr_ctx *ctx, u32 fourcc)
+{
+	const struct apr_fmt *fmt = apr_find_raw(fourcc);
+
+	/* 16-bit planes keep all 10 or 12 bits; 8-bit is on request only. */
+	if (!fmt || fmt->is444 != ctx->info.is444)
+		fmt = &apr_raw_fmts[ctx->info.is444 ? 3 : 1];
+	return fmt;
+}
+
+static void apr_dec_fill_raw(const struct apr_ctx *ctx,
+			     struct v4l2_pix_format_mplane *pix,
+			     const struct apr_fmt *fmt)
+{
+	struct apr_dec_layout l = {};
+
+	/* ctx->info always has a valid layout: checked when it was taken. */
+	WARN_ON(apr_dec_layout(&ctx->info, fmt->input, &l));
+	pix->pixelformat = fmt->fourcc;
+	pix->width = ctx->info.width;
+	pix->height = l.coded_height;
+	pix->field = V4L2_FIELD_NONE;
+	pix->num_planes = 1;
+	pix->flags = 0;
+	memset(pix->reserved, 0, sizeof(pix->reserved));
+	memset(pix->plane_fmt, 0, sizeof(pix->plane_fmt));
+	pix->plane_fmt[0].bytesperline = l.luma_stride;
+	pix->plane_fmt[0].sizeimage = l.size;
+	pix->colorspace = V4L2_COLORSPACE_REC709;
+	pix->xfer_func = V4L2_MAP_XFER_FUNC_DEFAULT(pix->colorspace);
+	pix->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(pix->colorspace);
+	pix->quantization = V4L2_QUANTIZATION_LIM_RANGE;
+}
+
+static void apr_dec_fill_coded(struct v4l2_pix_format_mplane *pix)
+{
+	u32 width = clamp_t(u32, ALIGN(pix->width, 2), APR_MIN_W, APR_MAX_W);
+	u32 height = clamp_t(u32, pix->height, APR_MIN_H, APR_MAX_H);
+	u32 size = max_t(u32, pix->plane_fmt[0].sizeimage,
+			 apr_coded_size(width, height, true));
+
+	pix->pixelformat = V4L2_PIX_FMT_PRORES;
+	pix->width = width;
+	pix->height = height;
+	pix->field = V4L2_FIELD_NONE;
+	pix->num_planes = 1;
+	pix->flags = 0;
+	memset(pix->reserved, 0, sizeof(pix->reserved));
+	memset(pix->plane_fmt, 0, sizeof(pix->plane_fmt));
+	pix->plane_fmt[0].sizeimage = min_t(u32, size, SZ_256M);
+	if (pix->colorspace == V4L2_COLORSPACE_DEFAULT)
+		pix->colorspace = V4L2_COLORSPACE_REC709;
+}
+
+static void apr_dec_reset_fmts(struct apr_ctx *ctx)
+{
+	ctx->have_info = false;
+	ctx->info = (struct apr_frame_info){ .width = 1920, .height = 1080 };
+	ctx->raw = &apr_raw_fmts[1];
+	memset(&ctx->src_fmt, 0, sizeof(ctx->src_fmt));
+	ctx->src_fmt.width = 1920;
+	ctx->src_fmt.height = 1080;
+	apr_dec_fill_coded(&ctx->src_fmt);
+	apr_dec_fill_raw(ctx, &ctx->dst_fmt, ctx->raw);
+}
+
+/*
+ * A header with a new size or chroma format resizes an idle CAPTURE queue
+ * and raises SOURCE_CHANGE (stateful decoder interface); so does the first.
+ */
+static void apr_dec_announce(struct apr_ctx *ctx, const struct apr_frame_info *fi)
+{
+	static const struct v4l2_event ev = {
+		.type = V4L2_EVENT_SOURCE_CHANGE,
+		.u.src_change.changes = V4L2_EVENT_SRC_CH_RESOLUTION,
+	};
+
+	if (ctx->have_info && ctx->info.width == fi->width &&
+	    ctx->info.height == fi->height && ctx->info.is444 == fi->is444)
+		return;
+	ctx->info = *fi;
+	ctx->have_info = true;
+	if (!vb2_is_busy(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx))) {
+		ctx->raw = apr_dec_pick_raw(ctx, ctx->raw->fourcc);
+		apr_dec_fill_raw(ctx, &ctx->dst_fmt, ctx->raw);
+	}
+	v4l2_event_queue_fh(&ctx->fh, &ev);
+}
+
+static int apr_dec_querycap(struct file *file, void *priv, struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, APR_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "Apple ProRes decoder", sizeof(cap->card));
+	return 0;
+}
+
+static int apr_dec_enum_fmt_out(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+	f->pixelformat = V4L2_PIX_FMT_PRORES;
+	f->flags = V4L2_FMT_FLAG_COMPRESSED | V4L2_FMT_FLAG_DYN_RESOLUTION;
+	return 0;
+}
+
+/* Once a header is known, only layouts with its chroma format. */
+static int apr_dec_enum_fmt_cap(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	struct apr_ctx *ctx = apr_file_to_ctx(file);
+	unsigned int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(apr_raw_fmts); i++) {
+		if (ctx->have_info && apr_raw_fmts[i].is444 != ctx->info.is444)
+			continue;
+		if (n++ == f->index) {
+			f->pixelformat = apr_raw_fmts[i].fourcc;
+			return 0;
+		}
+	}
+	return -EINVAL;
+}
+
+static int apr_dec_try_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	apr_dec_fill_coded(&f->fmt.pix_mp);
+	return 0;
+}
+
+static int apr_dec_try_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct apr_ctx *ctx = apr_file_to_ctx(file);
+
+	apr_dec_fill_raw(ctx, &f->fmt.pix_mp,
+			 apr_dec_pick_raw(ctx, f->fmt.pix_mp.pixelformat));
+	return 0;
+}
+
+/* Before the first header, CAPTURE follows the size given on OUTPUT. */
+static int apr_dec_s_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct apr_ctx *ctx = apr_file_to_ctx(file);
+	struct v4l2_m2m_ctx *m2m = ctx->fh.m2m_ctx;
+
+	if (vb2_is_busy(v4l2_m2m_get_src_vq(m2m)))
+		return -EBUSY;
+	apr_dec_fill_coded(&f->fmt.pix_mp);
+	ctx->src_fmt = f->fmt.pix_mp;
+	if (!ctx->have_info) {
+		ctx->info.width = ctx->src_fmt.width;
+		ctx->info.height = ctx->src_fmt.height;
+		if (!vb2_is_busy(v4l2_m2m_get_dst_vq(m2m)))
+			apr_dec_fill_raw(ctx, &ctx->dst_fmt, ctx->raw);
+	}
+	return 0;
+}
+
+static int apr_dec_s_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct apr_ctx *ctx = apr_file_to_ctx(file);
+
+	if (vb2_is_busy(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
+		return -EBUSY;
+	ctx->raw = apr_dec_pick_raw(ctx, f->fmt.pix_mp.pixelformat);
+	apr_dec_fill_raw(ctx, &f->fmt.pix_mp, ctx->raw);
+	ctx->dst_fmt = f->fmt.pix_mp;
+	return 0;
+}
+
+/* The visible frame; the CAPTURE height is rounded up to 16 rows. */
+static int apr_dec_g_selection(struct file *file, void *priv, struct v4l2_selection *s)
+{
+	struct apr_ctx *ctx = apr_file_to_ctx(file);
+
+	if (s->type != V4L2_BUF_TYPE_VIDEO_CAPTURE)
+		return -EINVAL;
+	switch (s->target) {
+	case V4L2_SEL_TGT_COMPOSE:
+	case V4L2_SEL_TGT_COMPOSE_DEFAULT:
+	case V4L2_SEL_TGT_COMPOSE_BOUNDS:
+		s->r = (struct v4l2_rect){ 0, 0, ctx->info.width, ctx->info.height };
+		return 0;
+	case V4L2_SEL_TGT_COMPOSE_PADDED:
+		s->r = (struct v4l2_rect){ 0, 0, ctx->dst_fmt.width, ctx->dst_fmt.height };
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int apr_dec_subscribe_event(struct v4l2_fh *fh,
+				   const struct v4l2_event_subscription *sub)
+{
+	switch (sub->type) {
+	case V4L2_EVENT_EOS:
+		return v4l2_event_subscribe(fh, sub, 0, NULL);
+	case V4L2_EVENT_SOURCE_CHANGE:
+		return v4l2_src_change_event_subscribe(fh, sub);
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct v4l2_ioctl_ops apr_dec_ioctl_ops = {
+	.vidioc_querycap = apr_dec_querycap,
+	.vidioc_enum_fmt_vid_out = apr_dec_enum_fmt_out,
+	.vidioc_enum_fmt_vid_cap = apr_dec_enum_fmt_cap,
+	.vidioc_enum_framesizes = apr_enum_framesizes,
+	.vidioc_g_fmt_vid_out_mplane = apr_g_fmt_out,
+	.vidioc_g_fmt_vid_cap_mplane = apr_g_fmt_cap,
+	.vidioc_try_fmt_vid_out_mplane = apr_dec_try_fmt_out,
+	.vidioc_try_fmt_vid_cap_mplane = apr_dec_try_fmt_cap,
+	.vidioc_s_fmt_vid_out_mplane = apr_dec_s_fmt_out,
+	.vidioc_s_fmt_vid_cap_mplane = apr_dec_s_fmt_cap,
+	.vidioc_g_selection = apr_dec_g_selection,
+
+	.vidioc_reqbufs = v4l2_m2m_ioctl_reqbufs,
+	.vidioc_querybuf = v4l2_m2m_ioctl_querybuf,
+	.vidioc_qbuf = v4l2_m2m_ioctl_qbuf,
+	.vidioc_dqbuf = v4l2_m2m_ioctl_dqbuf,
+	.vidioc_prepare_buf = v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_create_bufs = v4l2_m2m_ioctl_create_bufs,
+	.vidioc_expbuf = v4l2_m2m_ioctl_expbuf,
+	.vidioc_streamon = v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff = v4l2_m2m_ioctl_streamoff,
+
+	.vidioc_try_decoder_cmd = v4l2_m2m_ioctl_try_decoder_cmd,
+	.vidioc_decoder_cmd = v4l2_m2m_ioctl_decoder_cmd,
+
+	.vidioc_subscribe_event = apr_dec_subscribe_event,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
+};
+
 /* ---- queues ------------------------------------------------------------ */
 
 static struct v4l2_pix_format_mplane *apr_q_fmt(struct apr_ctx *ctx, u32 type)
@@ -1258,7 +1619,9 @@ static int apr_start_streaming(struct vb2_queue *q, unsigned int count)
 {
 	struct apr_ctx *ctx = vb2_get_drv_priv(q);
 
-	if (V4L2_TYPE_IS_OUTPUT(q->type)) {
+	if (V4L2_TYPE_IS_OUTPUT(q->type) && ctx->dec)
+		ctx->sequence = 0;
+	if (V4L2_TYPE_IS_OUTPUT(q->type) && !ctx->dec) {
 		if (ctx->raw->is444 != apr_profile_is_444(v4l2_ctrl_g_ctrl(ctx->profile))) {
 			struct vb2_v4l2_buffer *vbuf;
 
@@ -1288,7 +1651,7 @@ static void apr_stop_streaming(struct vb2_queue *q)
