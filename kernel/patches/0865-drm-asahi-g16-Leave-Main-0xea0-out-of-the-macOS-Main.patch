From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 03:11:09 +0000
Subject: [PATCH] drm/asahi: g16: Leave Main +0xea0 out of the macOS
 Main table

With g16_main_macos=1 the firmware stopped in an asynchronous abort
during its own init. Halving the table one boot at a time found one
word: Main +0xea0, which macOS 26B123 sets to 0 on the J604 and we set
to 1. 25G83 copies it once at init into a mode word. At zero the
firmware leaves out most of its own GPU power-up sequence (the
performance state, GCPMS enable and more), and on our host nothing
else does that work, so init aborts. The other 130 words boot.

Keep the word in the table, so that its indices do not move, but skip
it when g16_main_macos writes a range, and say so in the journal.
g16_main_poke can still write it explicitly. Without g16_main_macos
nothing changes.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/fw/initdata.rs |  7 +++++++
 drivers/gpu/drm/asahi/g16/initdata.rs    | 12 +++++++++++-
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/asahi/g16/fw/initdata.rs b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
index 02fbd7bc28..b71accba8a 100644
--- a/drivers/gpu/drm/asahi/g16/fw/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
@@ -236,6 +236,10 @@ pub(crate) mod j604 {
 /// index, our value, its 25G83 readers and the words left out (pointers, macOS allocation
 /// descriptors and loader records, firmware-written words). `g16_main_macos`.
 pub(crate) mod main_macos {
+    /// Words the table holds but g16_main_macos leaves out even inside its range, because
+    /// macOS's value stops 25G83 on this host: +0xea0 = 0 (index 8) ends the firmware's init in
+    /// an asynchronous abort. g16_main_poke can still write such a word explicitly.
+    pub(crate) const SKIP: [u16; 1] = [0x0ea0];
     pub(crate) const WORDS: [(u16, u32); 131] = [
         (0x0d64, 0x2), (0x0d8c, 0x2), (0x0db4, 0x2), (0x0ddc, 0x2), (0x0e54, 0x2),
         (0x0e94, 0x8132), (0x0e98, 0x1), (0x0e9c, 0x1), (0x0ea0, 0x0), (0x0ea8, 0x1),
@@ -817,6 +821,9 @@ pub(crate) fn encode(
     }
     if let Some((from, to)) = input.main_macos {
         for &(at, value) in main_macos::WORDS.iter().take(to.saturating_add(1)).skip(from) {
+            if main_macos::SKIP.contains(&at) {
+                continue;
+            }
             put32(main, usize::from(at), value)?;
         }
     }
diff --git a/drivers/gpu/drm/asahi/g16/initdata.rs b/drivers/gpu/drm/asahi/g16/initdata.rs
index e4766f8826..154dacce45 100644
--- a/drivers/gpu/drm/asahi/g16/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/initdata.rs
@@ -191,7 +191,11 @@ pub(crate) fn build(
     if let Some((from, to)) = super::params::main_macos() {
         let words = wire::main_macos::WORDS.len();
         let last = to.min(words.saturating_sub(1));
-        let written = if from <= last { last - from + 1 } else { 0 };
+        let in_range = || wire::main_macos::WORDS.iter().take(last.saturating_add(1)).skip(from);
+        let skipped = in_range()
+            .filter(|(at, _)| wire::main_macos::SKIP.contains(at))
+            .count();
+        let written = in_range().count() - skipped;
         if input.performance.count != 11 {
             dev_info!(dev, "M4 initdata: g16_main_macos=1 needs eleven rows; none written\n");
         } else {
@@ -204,6 +208,12 @@ pub(crate) fn build(
                 from,
                 last
             );
+            if skipped > 0 {
+                dev_info!(
+                    dev,
+                    "M4 initdata: g16_main_macos: Main +0xea0 left out (stops this firmware at init)\n"
+                );
+            }
         }
     }
     let (poke, poke_n, poke_bad) = super::params::main_poke();
-- 
