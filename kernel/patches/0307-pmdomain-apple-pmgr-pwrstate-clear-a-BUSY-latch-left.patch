From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Tue, 10 Nov 2026 08:21:11 -0500
Subject: [PATCH] pmdomain: apple: pmgr-pwrstate: clear a BUSY latch
 left on a powered-off domain

A domain can reach off with BUSY latched: on the T8140 both ISP CPU
cores do, every time they go down under Linux. macOS leaves them off
with it clear, and the sleep engine, which powers them up itself in a
wake that keeps DRAM up, stalls on a latched one until its watchdog
resets the SoC. Only a PS reset clears it, and the domain is off, so
pulse one as the power-on path already does, never in a system sleep
transition.

Signed-off-by: Diljit Singh <hey@djdev.me>
(cherry picked from commit d9b438c4ca41fec09a61fc5c15ad3ccda3402ccd)
[Dylan: only the off-with-BUSY unlatch is taken from that commit; it
 runs only when the new pmgr_pwrstate.unlatch_off parameter is set,
 default off, until the J604 shows a domain latched (busy_report)]
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/pmdomain/apple/pmgr-pwrstate.c | 37 ++++++++++++++++++++++++++
 1 file changed, 37 insertions(+)

diff --git a/drivers/pmdomain/apple/pmgr-pwrstate.c b/drivers/pmdomain/apple/pmgr-pwrstate.c
index 633f61103c..36e99926b3 100644
--- a/drivers/pmdomain/apple/pmgr-pwrstate.c
+++ b/drivers/pmdomain/apple/pmgr-pwrstate.c
@@ -137,6 +137,33 @@ static int apple_pmgr_ps_wait_parent(struct apple_pmgr_ps *ps, u32 *cur)
  * power-on then fails as it did before, and genpd, which ignores errors in
  * that phase, keeps the domain requested on.
  */
+/*
+ * Bring-up switch, default off: a domain can reach off with BUSY latched. On the
+ * T8140 both ISP CPU cores do, every time they go down under Linux; macOS leaves
+ * them off with it clear, and the sleep engine, which powers them up itself in a
+ * wake that keeps DRAM up, stalls on a latched one until its watchdog resets the
+ * SoC. Whether a J604 domain does this is not measured yet (busy_report reads it).
+ */
+static bool unlatch_off;
+module_param(unlatch_off, bool, 0644);
+MODULE_PARM_DESC(unlatch_off, "Bring-up: pulse the PS reset of a domain that powers off with BUSY latched (default off)");
+
+/* Pulse the PS reset of a domain that is off with BUSY latched; it stays off. */
+static void apple_pmgr_ps_unlatch_off(struct apple_pmgr_ps *ps, u32 *cur)
+{
+	u32 off = *cur & ~(APPLE_PMGR_AUTO_ENABLE | APPLE_PMGR_FLAGS | APPLE_PMGR_BUSY |
+			   APPLE_PMGR_PS_RESET | APPLE_PMGR_DEV_DISABLE | APPLE_PMGR_PS_TARGET);
+
+	regmap_write(ps->regmap, ps->offset, off | APPLE_PMGR_PS_RESET);
+	regmap_read_poll_timeout_atomic(ps->regmap, ps->offset, *cur,
+					!(*cur & APPLE_PMGR_BUSY), 1, APPLE_PMGR_PS_SET_TIMEOUT);
+	regmap_write(ps->regmap, ps->offset, off);
+	regmap_read(ps->regmap, ps->offset, cur);
+	if (*cur & APPLE_PMGR_BUSY)
+		dev_warn_ratelimited(ps->dev, "PS %s: off with BUSY latched: %#x\n",
+				     ps->genpd.name, *cur);
+}
+
 static int apple_pmgr_ps_clear_latch(struct apple_pmgr_ps *ps, u32 reg, u32 *cur)
 {
 	u32 off = (reg & ~APPLE_PMGR_PS_TARGET) | APPLE_PMGR_PS_PWRGATE;
@@ -269,6 +296,16 @@ static int apple_pmgr_ps_set(struct generic_pm_domain *genpd, u32 pstate, bool a
 		}
 	}
 
+	/*
+	 * Only a PS reset clears the latch, and the domain is off, so pulse one as
+	 * on the power-on path (not in a system sleep transition, see
+	 * apple_pmgr_ps_clear_latch()).
+	 */
+	if (unlatch_off && !ret && pstate != APPLE_PMGR_PS_ACTIVE && (cur & APPLE_PMGR_BUSY) &&
+	    !FIELD_GET(APPLE_PMGR_PS_ACTUAL, cur) && !ps->system_sleep &&
+	    !ps->wait_parent && !ps->strict_state && !ps->externally_clocked)
+		apple_pmgr_ps_unlatch_off(ps, &cur);
+
 report:
 	if (ret < 0)
 		dev_err_ratelimited(ps->dev,
