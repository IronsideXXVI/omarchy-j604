From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 22:09:04 +0000
Subject: [PATCH] media: apple: isp: drop the debugfs copy of a frame's
 metadata block

The debugfs frame_metadata file copied one returned metadata block, to
locate the firmware's white balance fields in it. On the J604 the block
holds several gain triples beside a green gain of 4096, one of them close
to macOS's own white balance, but which one the firmware applies cannot be
told from the block alone. Nothing reads the file in normal use, so drop it
rather than ship a debug hook; the firmware's auto white balance itself is
unaffected.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/media/platform/apple/isp/isp-drv.c  | 64 ---------------------
 drivers/media/platform/apple/isp/isp-drv.h  |  4 --
 drivers/media/platform/apple/isp/isp-v4l2.c | 15 -----
 3 files changed, 83 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index a1d154d9a0..1c1a332f68 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -520,77 +520,13 @@ static const struct file_operations isp_stream_config_fops = {
 	.llseek = default_llseek,
 };
 
-/*
- * frame_metadata: write 1 to copy the next returned frame metadata block;
- * read returns that copy (hw->meta_size bytes) once it has been taken.
- */
-static ssize_t isp_frame_metadata_write(struct file *file,
-					const char __user *ubuf, size_t len,
-					loff_t *ppos)
-{
-	struct apple_isp *isp = file->private_data;
-	unsigned long flags;
-	bool arm;
-	int err;
-
-	err = kstrtobool_from_user(ubuf, len, &arm);
-	if (err)
-		return err;
-	if (!isp->meta_snap)
-		return -ENOMEM;
-	spin_lock_irqsave(&isp->buf_lock, flags);
-	isp->meta_snap_armed = arm;
-	if (arm)
-		isp->meta_snap_ready = false;
-	spin_unlock_irqrestore(&isp->buf_lock, flags);
-	return len;
-}
-
-static ssize_t isp_frame_metadata_read(struct file *file, char __user *ubuf,
-				       size_t len, loff_t *ppos)
-{
-	struct apple_isp *isp = file->private_data;
-	size_t size = isp->hw->meta_size;
-	unsigned long flags;
-	bool ready;
-	ssize_t ret;
-	u8 *copy;
-
-	if (!isp->meta_snap || !size)
-		return 0;
-	copy = kvmalloc(size, GFP_KERNEL);
-	if (!copy)
-		return -ENOMEM;
-	spin_lock_irqsave(&isp->buf_lock, flags);
-	ready = isp->meta_snap_ready && !isp->meta_snap_armed;
-	if (ready)
-		memcpy(copy, isp->meta_snap, size);
-	spin_unlock_irqrestore(&isp->buf_lock, flags);
-	ret = ready ? simple_read_from_buffer(ubuf, len, ppos, copy, size) : 0;
-	kvfree(copy);
-	return ret;
-}
-
-static const struct file_operations isp_frame_metadata_fops = {
-	.owner = THIS_MODULE,
-	.open = simple_open,
-	.read = isp_frame_metadata_read,
-	.write = isp_frame_metadata_write,
-	.llseek = default_llseek,
-};
-
 static void apple_isp_debugfs_init(struct apple_isp *isp)
 {
-	if (isp->hw->meta_size)
-		isp->meta_snap = devm_kzalloc(isp->dev, isp->hw->meta_size, GFP_KERNEL);
 	isp->debugfs = debugfs_create_dir(dev_name(isp->dev), NULL);
 	debugfs_create_file("stream_config", 0600, isp->debugfs, isp,
 			    &isp_stream_config_fops);
 	debugfs_create_u32("extra_frame_rate", 0600, isp->debugfs,
 			   &isp->extra_frame_rate);
-	if (isp->meta_snap)
-		debugfs_create_file("frame_metadata", 0600, isp->debugfs, isp,
-				    &isp_frame_metadata_fops);
 }
 
 static int apple_isp_init_presets(struct apple_isp *isp)
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 5a10970b41..968b0b3923 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -443,10 +443,6 @@ struct apple_isp {
 	bool stream_config_set;
 	u32 extra_frame_rate;
 	struct dentry *debugfs;
-	/* one-shot copy of a returned metadata block for debugfs, under buf_lock */
-	u8 *meta_snap;
-	bool meta_snap_armed;
-	bool meta_snap_ready;
 	/* configurations the firmware has, once a deferred start detected them */
 	u32 num_fw_presets;
 
diff --git a/drivers/media/platform/apple/isp/isp-v4l2.c b/drivers/media/platform/apple/isp/isp-v4l2.c
index d9d0fdb890..e484b94e46 100644
--- a/drivers/media/platform/apple/isp/isp-v4l2.c
+++ b/drivers/media/platform/apple/isp/isp-v4l2.c
@@ -154,20 +154,6 @@ static void isp_meta_read_exposure(struct apple_isp *isp,
 	WRITE_ONCE(isp->frame_gain, gain);
 }
 
-/*
- * Copy one returned metadata block when debugfs asked for it (see
- * apple_isp_debugfs_init()), so the fields beyond the exposure report can be
- * located. Called with buf_lock held.
- */
-static void isp_meta_snapshot(struct apple_isp *isp, const struct isp_surf *meta)
-{
-	if (!isp->meta_snap_armed || !isp->meta_snap || !meta->virt)
-		return;
-	memcpy(isp->meta_snap, meta->virt, min_t(size_t, meta->size, isp->hw->meta_size));
-	isp->meta_snap_armed = false;
-	isp->meta_snap_ready = true;
-}
-
 void ipc_bt_complete(struct apple_isp *isp)
 {
 	struct isp_buffer *buf, *tmp;
@@ -229,7 +215,6 @@ int ipc_bt_handle(struct apple_isp *isp, struct isp_channel *chan)
 				if ((u32)bufd->iovas[0] == (u32)meta->iova) {
 					WARN_ON(!meta->submitted);
 					isp_meta_read_exposure(isp, meta);
-					isp_meta_snapshot(isp, meta);
 					if (isp_is_p010(isp))
 						__set_bit(j, &isp->meta_returned);
 					else
-- 
2.43.0

