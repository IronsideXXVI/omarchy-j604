From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bartosz Nitka <niteria@gmail.com>
Date: Mon, 9 Nov 2026 11:34:51 +0100
Subject: [PATCH] arm64: dts: apple: t8132: describe what a deep sleep
 needs

The clusters' power-gate enables, the clock-protection bank, the pin
controller, the PCIe windows ANS's block needs back after a sleep, the
PMU RTC with the nub SPMI controller as its interrupt controller (the
alarm is peripheral interrupt 2, and only an enabled one raises the
wake line), the whole of the PMP's SRAM, and the SEP's power domains.

The APCIe tables for those windows come from the bootloader, which
copies them from the ADT; without them the sleep driver refuses a deep
sleep that stops ANS.

Assisted-by: LLM
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 1b698e43c4cdd092dd16d8004070efc26eed9934)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../arm64/boot/dts/apple/t8132-j713-j715.dtsi | 11 +++++++
 arch/arm64/boot/dts/apple/t8132-jxxx.dtsi     | 13 +++++++-
 arch/arm64/boot/dts/apple/t8132.dtsi          | 32 ++++++++++++++++---
 3 files changed, 51 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi b/arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi
index adf78e23ba..e4e5e7c10b 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi
@@ -142,7 +142,18 @@ &sep_dart {
 	status = "okay";
 };
 
+/* Only named: the sleep's last refusal reads its state to see the enclave gate. */
+&ps_sep {
+	apple,firmware-owned;
+	status = "okay";
+};
+
 &sep {
+	/*
+	 * Without a domain the driver tells the enclave at .suspend, and a sleep
+	 * refused after that finds it gated with its mailbox gone.
+	 */
+	power-domains = <&ps_sep>, <&ps_gpio>;
 	status = "okay";
 };
 
diff --git a/arch/arm64/boot/dts/apple/t8132-jxxx.dtsi b/arch/arm64/boot/dts/apple/t8132-jxxx.dtsi
index 772a8b8656..03a129758b 100644
--- a/arch/arm64/boot/dts/apple/t8132-jxxx.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-jxxx.dtsi
@@ -25,6 +25,8 @@ aliases {
 		nvram = &nvram;
 		pmu-primary = &pmic1;
 		pmp = &pmp;
+		rtc0 = &smc_rtc;
+		rtc1 = &pmu_rtc;
 		sart-ans = &sart;
 		spmi-primary = &nub_spmi;
 		wifi0 = &wifi0;
@@ -184,7 +186,7 @@ smc_hwmon: hwmon {
 		compatible = "apple,smc-hwmon";
 	};
 
-	rtc {
+	smc_rtc: rtc {
 		compatible = "apple,smc-rtc";
 		nvmem-cells = <&rtc_offset>;
 		nvmem-cell-names = "rtc_offset";
@@ -210,6 +212,15 @@ pmic1: pmic@0 {
 		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
 		reg = <0x0 SPMI_USID>; /* To be filled by loader */
 
+		pmu_rtc: rtc {
+			compatible = "apple,t8132-pmu-rtc", "apple,t6041-pmu-rtc";
+			interrupt-parent = <&nub_spmi>;
+			interrupts = <2 IRQ_TYPE_EDGE_RISING>;
+			nvmem-cells = <&rtc_offset>;
+			nvmem-cell-names = "rtc_offset";
+			wakeup-source;
+		};
+
 		nvmem-layout {
 			compatible = "fixed-layout";
 			#address-cells = <1>;
diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index e90ad620cc..0982e40370 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -500,6 +500,10 @@ nub_spmi: spmi@0 {
 			reg = <0x0 0x0 0x0 0x1000>; /* To be filled by loader */
 			#address-cells = <2>;
 			#size-cells = <0>;
+			#interrupt-cells = <2>;
+			interrupt-controller;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 513 IRQ_TYPE_LEVEL_HIGH>;
 			status = "disabled";
 		};
 
@@ -563,6 +567,16 @@ pmgr_mini: power-management@388280000 {
 			/* child nodes are added in t8132-pmgr.dtsi */
 		};
 
+		/*
+		 * The CPU clusters' power-gate enables, in /arm-io/pmgr reg[34]:
+		 * cluster-id 0 (E) at +0x0, 1 (P) at +0x60. iBoot sets E's only.
+		 */
+		cluster_pwrgate: power-gate@380724000 {
+			compatible = "apple,t8132-cluster-pwrgate", "apple,cluster-pwrgate";
+			reg = <0x3 0x80724000 0x0 0x4>,
+			      <0x3 0x80724060 0x0 0x4>;
+		};
+
 		sleep: sleep-controller@380700000 {
 			compatible = "apple,t8132-sleep";
 			reg = <0x3 0x80700000 0x0 0x18000>,
@@ -589,13 +603,14 @@ sleep: sleep-controller@380700000 {
 			      <0x2 0x20800580 0x0 0x10>,
 			      <0x3 0x803d0bc8 0x0 0x10>,
 			      <0x3 0x80058000 0x0 0x10004>,
-			      <0x3 0x80780010 0x0 0x4>;
+			      <0x3 0x80780010 0x0 0x4>,
+			      <0x3 0x8079c000 0x0 0x4000>;
 			reg-names = "ps", "pwrgate", "cpu-start", "cllt", "cluster",
 				    "commit", "wdt", "aon-misc", "wake",
 				    "amcc0", "amcc1", "pmc-dcp",
 				    "dvfm-e", "dvfm-p", "spmi", "pmc-voters", "dcs",
 				    "ps-aon", "spmi-a0", "clk-mux", "mcc0", "mcc1",
-				    "ptd", "clk-perf", "cluster-dcs";
+				    "ptd", "clk-perf", "cluster-dcs", "ps-prot";
 			/*
 			 * The same sources as T8140's, by name, from the J713 ADT's
 			 * /arm-io/pmgr ap-wake-sources: NUB.SPMI0.SW3, ATC0.USBWakeup,
@@ -604,6 +619,9 @@ sleep: sleep-controller@380700000 {
 			 */
 			apple,wake-enable = <145 69 161 183 85 104>;
 			apple,display-coprocessors = <&dcp>, <&dcpext0>, <&dcpext1>;
+			apple,apcie = <&pcie0>;
+			/* The ADT has no no-restore-gpio-pins here: every pin goes back. */
+			apple,pinctrl = <&pinctrl_ap>;
 		};
 
 		wdt: watchdog@3882b0000 {
@@ -1433,8 +1451,14 @@ pcie0: pcie@1cb0000000 {
 		reg = <0x1c 0xb0000000 0x0 0x10000000>, /* config */
 		      <0x4 0x94000000 0x0 0x4000>,     /* common */
 		      <0x4 0x90028000 0x0 0x8000>,     /* port 0 */
-		      <0x4 0x97020000 0x0 0x4000>;     /* port 0 PHY glue */
-		reg-names = "config", "rc", "port0", "phy0";
+		      <0x4 0x97020000 0x0 0x4000>,     /* port 0 PHY glue */
+		      <0x4 0x96000000 0x0 0x1000000>,
+		      <0x4 0x95046200 0x0 0x4000>,
+		      <0x4 0x95044000 0x0 0x4000>,
+		      <0x4 0x97000000 0x0 0x40000>,
+		      <0x4 0x97040000 0x0 0x20000>;
+		reg-names = "config", "rc", "port0", "phy0",
+			    "axi2af", "cio3pll", "clkgen", "phy-block", "phy-ip";
 
 		interrupt-parent = <&aic>;
 		interrupts = <AIC_IRQ 1231 IRQ_TYPE_LEVEL_HIGH>;
-- 
2.43.0

