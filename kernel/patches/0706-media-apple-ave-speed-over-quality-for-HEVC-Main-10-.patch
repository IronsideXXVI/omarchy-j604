From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Mon, 9 Nov 2026 02:12:44 +1100
Subject: [PATCH] media: apple: ave: speed over quality for HEVC Main 10 too

The speed-over-quality control was limited to 8-bit HEVC because Main 10
had not been measured. Main 10 behaves like Main: the same Start word
(3 -> 5) makes it 1.6-1.8 times faster, its pictures stay intact, and
the bit-rate cost is lower than for 8-bit (+7.2% BD-rate PSNR-Y
against +12.4%). Apply the control to Main 10 as well. It still applies
only to HEVC above 1280x720.

With the control off, every command is byte-identical to before.

Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Assisted-by: LLM
(cherry picked from commit f349347cb6db61acd082b3c34e7c6f6480468b0f)
---
 Documentation/admin-guide/media/apple-ave.rst |  5 ++---
 .../media/platform/apple/ave/ave-abi-test.c   | 21 ++++++++++++-------
 drivers/media/platform/apple/ave/ave-sess.c   |  8 +++----
 3 files changed, 20 insertions(+), 14 deletions(-)

diff --git a/Documentation/admin-guide/media/apple-ave.rst b/Documentation/admin-guide/media/apple-ave.rst
index 02eede3115..41aeaadc71 100644
--- a/Documentation/admin-guide/media/apple-ave.rst
+++ b/Documentation/admin-guide/media/apple-ave.rst
@@ -146,9 +146,8 @@ Limits
 - ``Prioritize Speed Over Quality`` (driver-private boolean,
   ``V4L2_CID_APPLE_AVE_PRIORITIZE_SPEED`` = codec class base ``0x1200``, off by
   default) is VideoToolbox's PrioritizeEncodingSpeedOverQuality: it sets the
-  firmware's throughput mode to 5 instead of 3. It applies to 8-bit HEVC
-  above 1280x720 (Main 10 is not measured yet) and is read when streaming
-  starts. H.264 is not faster with it, on macOS either, so it has no effect
+  firmware's throughput mode to 5 instead of 3. It applies to HEVC (Main
+  and Main 10) above 1280x720 and is read when streaming starts. H.264 is not faster with it, on macOS either, so it has no effect
   there.
 - Either three B-frames or none (``B_FRAMES`` 3 or 0). H.264 Baseline and a
   GOP size of 1 never use them.
diff --git a/drivers/media/platform/apple/ave/ave-abi-test.c b/drivers/media/platform/apple/ave/ave-abi-test.c
index 255ec6e995..06e6a1df05 100644
--- a/drivers/media/platform/apple/ave/ave-abi-test.c
+++ b/drivers/media/platform/apple/ave/ave-abi-test.c
@@ -227,10 +227,15 @@ static void ave_9003_hevc_main10(struct kunit *test)
 
 /* One 1080p HEVC Start or first Process image, with speed mode @speed. */
 static void ave_speed_image(struct kunit *test, struct ave_ctx *ctx,
-			    enum ave_image image, bool bframes, bool speed,
-			    u8 *cmd, size_t len)
+			    enum ave_image image, bool bframes, bool main10,
+			    bool speed, u8 *cmd, size_t len)
 {
 	ave_test_session(ctx->sess, AVE_CODEC_HEVC, 1920, 1080, bframes);
+	if (main10) {
+		ctx->sess->p.min_qp = -12;
+		ctx->sess->p.profile = 2;
+		ctx->sess->p.bit_depth = 10;
+	}
 	ctx->sess->p.speed = speed;
 	memset(cmd, 0, len);
 	if (image == AVE_IMAGE_START)
@@ -244,7 +249,8 @@ static void ave_speed_image(struct kunit *test, struct ave_ctx *ctx,
 
 /*
  * Speed over quality on 9003: HEVC Start changes only the throughput mode
- * (+0x320, 3 -> 5); Process stays the same, with and without B-frames.
+ * (+0x320, 3 -> 5); Process stays the same, with and without B-frames, for
+ * Main and Main 10.
  */
 static void ave_9003_speed(struct kunit *test)
 {
@@ -263,14 +269,15 @@ static void ave_9003_speed(struct kunit *test)
 	ctx->ave = ave;
 	ctx->sess = sess;
 
-	for (unsigned int i = 0; i < 4; i++) {
+	for (unsigned int i = 0; i < 8; i++) {
 		enum ave_image image = i & 1 ? AVE_IMAGE_PROCESS : AVE_IMAGE_START;
-		bool bframes = i & 2;
+		bool bframes = i & 2, main10 = i & 4;
 		size_t len = ave->layout->bytes[AVE_CODEC_HEVC - 1][image];
 		u32 changed = image == AVE_IMAGE_START ? 0x320 : 0;
 
-		ave_speed_image(test, ctx, image, bframes, false, quality, len);
-		ave_speed_image(test, ctx, image, bframes, true, speed, len);
+		ave_speed_image(test, ctx, image, bframes, main10, false, quality,
+				len);
+		ave_speed_image(test, ctx, image, bframes, main10, true, speed, len);
 		if (changed) {
 			KUNIT_EXPECT_EQ(test, get_unaligned_le32(quality + changed), 3);
 			KUNIT_EXPECT_EQ(test, get_unaligned_le32(speed + changed), 5);
diff --git a/drivers/media/platform/apple/ave/ave-sess.c b/drivers/media/platform/apple/ave/ave-sess.c
index dde038a812..e47337b611 100644
--- a/drivers/media/platform/apple/ave/ave-sess.c
+++ b/drivers/media/platform/apple/ave/ave-sess.c
@@ -200,12 +200,12 @@ static int ave_sess_params(struct ave_ctx *ctx, struct ave_params *p)
 	p->slots = p->bframes ? 5 : 3;
 	/*
 	 * Speed over quality changes the firmware's throughput mode from 3 to
-	 * 5, as macOS does. It is measured for 8-bit HEVC above 720p on the
-	 * 9003 layout only; H.264 does not get faster from it (on macOS
-	 * either).
+	 * 5, as macOS does. It is measured for HEVC (Main and Main 10) above
+	 * 720p on the 9003 layout only; H.264 does not get faster from it (on
+	 * macOS either).
 	 */
 	p->speed = ctx->prioritize_speed && p->codec == AVE_CODEC_HEVC &&
-		   p->sample_bytes == 1 && !ctx->ave->layout->counted &&
+		   !ctx->ave->layout->counted &&
 		   p->width * p->height > 1280 * 720;
 	p->gop = ctx->gop_size ?: 120;
 
