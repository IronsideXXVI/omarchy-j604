+/*
+ * T8132 sequence: register layouts and values, SOURCE (Aurora's
+ * drivers/soc/apple/sleep.c, aurora-silicon/linux#1314, from macOS's sleep
+ * on a J713). Power word offsets are relative to the "ps" (PMGR) and
+ * "ps-aon" (PMGR AON) windows; the J604's ADT has the same words with the
+ * same names.
+ */
+#define T8132_PS_AUTO_ENABLE		BIT(28)
+#define T8132_PS_AUTO_STATE		GENMASK(27, 24)
+#define T8132_PS_PARENT_MISSING		BIT(11)
