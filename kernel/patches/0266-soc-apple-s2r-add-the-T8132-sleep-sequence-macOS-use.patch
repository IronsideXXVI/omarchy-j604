+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Apple T8132 suspend-to-RAM: the first code Linux runs after a wake.
+ *
+ * Entered by the boot firmware's warm boot path at EL2, MMU and caches off, no
+ * stack. The wake program leaves the watchdog's WD2 running for 5 s: restart
+ * it for 60 s (1440000000 ticks of 24 MHz), in the order that arms it, then go
+ * on to cpu_resume. The watchdog block at 0x3882b0000 is the J604 ADT's
+ * /arm-io/wdt reg[0], as on the J713.
+ *
+ * SOURCE: Aurora's t8132_resume_stub in drivers/soc/apple/sleep.c
+ * (aurora-silicon/linux#1314), by Bartosz Nitka and Diljit Singh, from the
+ * aura#109 trace of macOS's wake on a J713.
+ */
+
+#include <linux/linkage.h>
+
+#define T8132_WDT_BASE_HI	0x3
+#define T8132_WDT_BASE_MID	0x882b
+
+	.text
+SYM_CODE_START(apple_s2r_t8132_resume)
+	movz	x9, #T8132_WDT_BASE_MID, lsl #16
+	movk	x9, #T8132_WDT_BASE_HI, lsl #32
+	str	wzr, [x9, #0x2c]		/* WD2 control: off */
+	str	wzr, [x9, #0x20]		/* WD2 count */
+	movz	w10, #0xa800
+	movk	w10, #0x55d4, lsl #16
+	str	w10, [x9, #0x28]		/* WD2 alarm: 60 s */
+	mov	w10, #1
+	str	w10, [x9, #0x2c]		/* WD2 control: on */
+	b	cpu_resume
+SYM_CODE_END(apple_s2r_t8132_resume)
diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 329753dc0d..d113fa7bfc 100644
--- a/drivers/soc/apple/apple-s2r.c
