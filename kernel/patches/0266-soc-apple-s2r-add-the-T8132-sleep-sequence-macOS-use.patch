+/*
+ * T8132 sequence (t8132_sequence). Layouts, values and order are SOURCE:
+ * Aurora's drivers/soc/apple/sleep.c in aurora-silicon/linux#1314 (head
+ * 17161ffa69: apple_sleep_match(), t8132_sleep_commit(),
+ * apple_sleep_return() and their helpers), by Bartosz Nitka and Diljit
+ * Singh, from the aura#109 trace of macOS 25G83 sleeping on a J713, where
+ * it took 8 of 8 real sleeps. Here they are proven only by bring-up cycles.
+ * Every register window comes from the device tree, which takes it from the
+ * machine's ADT; the power word offsets below are the same in the J604's and
+ * the J713's ADT, name for name.
+ */
+static int apple_s2r_t8132_perf_wait(void __iomem *reg, unsigned int state)
+{
+	u32 val;
+
+	return readl_poll_timeout_atomic(reg, val,
+					 (val & (T8132_DCS_BUSY | T8132_DCS_STATE)) ==
+					 FIELD_PREP(T8132_DCS_STATE, state),
+					 1, T8132_DCS_TIMEOUT_US);
+}
+
+static bool apple_s2r_t8132_ps_on(struct apple_s2r *s2r, u32 offset)
+{
+	return FIELD_GET(T8132_PS_ACTUAL, readl(s2r->t8132.ps + offset));
+}
+
+/* As macOS lowers a domain: AUTO_ENABLE off first if it's set, then target 0. */
+static void apple_s2r_t8132_ps_lower(void __iomem *reg)
+{
+	u32 val = readl(reg);
+
+	if (val & T8132_PS_AUTO_ENABLE) {
+		val &= ~(T8132_PS_AUTO_ENABLE | T8132_PS_FLAGS);
+		writel(val, reg);
+	}
+	writel((val & ~T8132_PS_TARGET) | T8132_PS_FLAGS, reg);
+}
+
+/* As macOS raises a domain: the target, then AUTO_ENABLE once it reads on. */
+static int apple_s2r_t8132_ps_raise_start(void __iomem *reg)
+{
+	u32 now;
+
+	writel((readl(reg) & ~(T8132_PS_AUTO_ENABLE | GENMASK(11, 0))) | T8132_PS_TARGET, reg);
+
+	return readl_poll_timeout_atomic(reg, now, (now & T8132_PS_ACTUAL) == T8132_PS_ACTUAL,
+					 1, T8132_PS_TIMEOUT_US);
+}
+
+static void apple_s2r_t8132_ps_raise(void __iomem *reg)
+{
+	apple_s2r_t8132_ps_raise_start(reg);
+	writel((readl(reg) & ~(T8132_PS_AUTO_ENABLE | GENMASK(11, 0))) | T8132_PS_TARGET |
+	       T8132_PS_AUTO_ENABLE, reg);
+}
+
+static int apple_s2r_t8132_ps_wait_off(void __iomem *reg)
+{
+	u32 val;
+
+	return readl_poll_timeout_atomic(reg, val, !FIELD_GET(T8132_PS_ACTUAL, val), 10,
+					 T8132_PS_TIMEOUT_US);
+}
+
+/*
+ * Never DEV_DISABLE, which keeps a domain off: the SEP's is set at the
+ * commit, and macOS's wake writes that word without it. A word that was off
+ * under AUTO_ENABLE at the commit gets AUTO_ENABLE back only.
+ */
+static int apple_s2r_t8132_ps_restore(void __iomem *reg, u32 saved)
+{
+	u32 keep = (saved & ~(T8132_PS_AUTO_ENABLE | T8132_PS_AUTO_STATE |
+			      T8132_PS_PARENT_MISSING | T8132_PS_DEV_DISABLE |
+			      T8132_PS_FLAGS | T8132_PS_ACTUAL)) |
+		   (readl(reg) & T8132_PS_AUTO_STATE);
+	u32 now;
+	int ret;
+
+	if ((saved & T8132_PS_AUTO_ENABLE) && !FIELD_GET(T8132_PS_ACTUAL, saved)) {
+		writel(keep | T8132_PS_AUTO_ENABLE, reg);
+		return 0;
+	}
+
+	writel(keep, reg);
+	ret = readl_poll_timeout_atomic(reg, now,
+					FIELD_GET(T8132_PS_ACTUAL, now) ==
+					FIELD_GET(T8132_PS_TARGET, saved),
+					1, T8132_PS_TIMEOUT_US);
+	if (saved & T8132_PS_AUTO_ENABLE)
+		writel(keep | T8132_PS_AUTO_ENABLE, reg);
+
+	return ret;
+}
+
+static int apple_s2r_t8132_find(const u32 *all, int n, u32 offset)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		if (all[i] == offset)
+			return i;
+	return -1;
+}
+
+/* Linux had it on and the wake left it otherwise. With AUTO_ENABLE, off is allowed. */
+static bool apple_s2r_t8132_ps_dropped(u32 saved, u32 woke)
+{
+	u32 control = T8132_PS_AUTO_ENABLE | T8132_PS_DEV_DISABLE | T8132_PS_TARGET;
+
+	if (!FIELD_GET(T8132_PS_TARGET, saved))
+		return false;
+	if ((saved ^ woke) & control)
+		return true;
+	return !(saved & T8132_PS_AUTO_ENABLE) &&
+	       FIELD_GET(T8132_PS_ACTUAL, woke) != FIELD_GET(T8132_PS_TARGET, saved);
+}
+
+static void apple_s2r_t8132_ps_save(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(t8132_ps_all); i++)
+		t->ps_commit[i] = readl(t->ps + t8132_ps_all[i]);
+	for (i = 0; i < ARRAY_SIZE(t8132_ps_aon_all); i++)
+		t->ps_aon_commit[i] = readl(t->ps_aon + t8132_ps_aon_all[i]);
+}
+
+/*
+ * Every domain back as it was at the commit, before any driver's resume reads
+ * its block: macOS's wake words first, in its order, if Linux had them on.
+ * Then any other domain the wake left otherwise, twice for one whose parent
+ * came later.
+ */
+static void apple_s2r_t8132_ps_rewake(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	const int n = ARRAY_SIZE(t8132_ps_all), naon = ARRAY_SIZE(t8132_ps_aon_all);
+	bool *redo = t->ps_late, *redo_aon = t->ps_aon_late;
+	bool *done = t->ps_done, *done_aon = t->ps_aon_done;
+	int i, j, pass;
+
+	memset(t->ps_done, 0, sizeof(t->ps_done));
+	memset(t->ps_aon_done, 0, sizeof(t->ps_aon_done));
+	memset(t->ps_late, 0, sizeof(t->ps_late));
+	memset(t->ps_aon_late, 0, sizeof(t->ps_aon_late));
+	t->ps_rewoken = 0;
+	t->ps_rewake_timeouts = 0;
+	for (i = 0; i < n; i++)
+		t->ps_woke[i] = readl(t->ps + t8132_ps_all[i]);
+	for (i = 0; i < naon; i++)
+		t->ps_aon_woke[i] = readl(t->ps_aon + t8132_ps_aon_all[i]);
+
+	for (j = 0; j < ARRAY_SIZE(t8132_ps_wake_order); j++) {
+		i = apple_s2r_t8132_find(t8132_ps_all, n, t8132_ps_wake_order[j]);
+		if (i < 0 || !FIELD_GET(T8132_PS_TARGET, t->ps_commit[i]))
+			continue;
+		done[i] = true;
+		t->ps_rewoken++;
+		if (apple_s2r_t8132_ps_restore(t->ps + t8132_ps_all[i], t->ps_commit[i]))
+			redo[i] = true;
+	}
+	for (j = 0; j < ARRAY_SIZE(t8132_ps_aon_wake_order); j++) {
+		i = apple_s2r_t8132_find(t8132_ps_aon_all, naon, t8132_ps_aon_wake_order[j]);
+		if (i < 0 || !FIELD_GET(T8132_PS_TARGET, t->ps_aon_commit[i]))
+			continue;
+		done_aon[i] = true;
+		t->ps_rewoken++;
+		if (apple_s2r_t8132_ps_restore(t->ps_aon + t8132_ps_aon_all[i],
+					       t->ps_aon_commit[i]))
+			redo_aon[i] = true;
+	}
+
+	for (pass = 0; pass < T8132_PS_REWAKE_PASSES; pass++) {
+		for (i = 0; i < n; i++) {
+			if (!redo[i] &&
+			    (done[i] ||
+			     !apple_s2r_t8132_ps_dropped(t->ps_commit[i], t->ps_woke[i])))
+				continue;
+			if (!done[i]) {
+				done[i] = true;
+				t->ps_rewoken++;
+			}
+			redo[i] = apple_s2r_t8132_ps_restore(t->ps + t8132_ps_all[i],
+							     t->ps_commit[i]);
+		}
+		for (i = 0; i < naon; i++) {
+			if (!redo_aon[i] &&
+			    (done_aon[i] ||
+			     !apple_s2r_t8132_ps_dropped(t->ps_aon_commit[i], t->ps_aon_woke[i])))
+				continue;
+			if (!done_aon[i]) {
+				done_aon[i] = true;
+				t->ps_rewoken++;
+			}
+			redo_aon[i] = apple_s2r_t8132_ps_restore(t->ps_aon + t8132_ps_aon_all[i],
+								 t->ps_aon_commit[i]);
+		}
+	}
+
+	for (i = 0; i < n; i++)
+		t->ps_rewake_timeouts += redo[i];
+	for (i = 0; i < naon; i++)
+		t->ps_rewake_timeouts += redo_aon[i];
+}
+
+/* Every source masked but the apple,wake-enable ones (sleep_wake_arm()). */
+static void apple_s2r_t8132_wake_arm(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	u32 val[T8132_WAKE_WORDS];
+	unsigned int i;
+
+	for (i = 0; i < T8132_WAKE_WORDS; i++)
+		val[i] = i == T8132_WAKE_WORDS - 1 ? T8132_WAKE_LAST_WORD : U32_MAX;
+	for (i = 0; i < t->nwake; i++)
+		if (t->wake_enable[i] / 32 < T8132_WAKE_WORDS)
+			val[t->wake_enable[i] / 32] &= ~BIT(t->wake_enable[i] % 32);
+
+	for (i = 0; i < T8132_WAKE_WORDS; i++) {
+		t->wake_saved[i] = readl(t->wake + T8132_WAKE_MASK(i));
+		writel(val[i], t->wake + T8132_WAKE_MASK(i));
+		t->wake_armed[i] = ~val[i];
+	}
+	t->wake_done = true;
+}
+
+static void apple_s2r_t8132_wake_restore(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	unsigned int i;
+
+	if (!t->wake_done)
+		return;
+	t->wake_done = false;
+	for (i = 0; i < T8132_WAKE_WORDS; i++)
+		writel(t->wake_saved[i], t->wake + T8132_WAKE_MASK(i));
+}
+
+/*
+ * Before the commit, the power words where macOS has them at that point
+ * (apple_sleep_match()). The PMU boot stage byte gets macOS's sleep value
+ * 0x50; from here no breadcrumb is written until the wake, as macOS leaves
+ * that bus alone.
+ */
+static void apple_s2r_t8132_match(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	u8 stage = T8132_PMU_BOOT_STAGE_SLEEP;
+	int i;
+
+	/* WD1 here is the bring-up watchdog's: a fresh count, nothing disarmed. */
+	writel(0, s2r->wdt + T8132_WD0_COUNT);
+	writel(0, s2r->wdt + T8132_WD1_COUNT);
+	if (spmi_ext_register_writel(s2r->crumb_dev, s2r->crumb_addr, &stage, 1))
+		t->pmu_err++;
+	else
+		t->pmu_written = true;
+
+	t->spmi_saved[0] = readl(t->spmi + T8132_SPMI_NOTIFY_ENABLE);
+	t->spmi_saved[1] = readl(t->spmi_a0);
+	writel(T8132_SPMI_NOTIFY_ENABLE_SLEEP, t->spmi + T8132_SPMI_NOTIFY_ENABLE);
+	writel(T8132_SPMI_NOTIFY_ENABLE_SLEEP, t->spmi_a0);
+
+	for (i = 0; i < ARRAY_SIZE(t8132_ps_macos_on); i++) {
+		u32 offset = t8132_ps_macos_on[i];
+
+		t->ps_on_saved[i] = readl(t->ps + offset);
+		/* State 4 reads as on, and macOS has these at f. */
+		if (FIELD_GET(T8132_PS_ACTUAL, t->ps_on_saved[i]) == 0xf)
+			continue;
+		apple_s2r_t8132_ps_raise_start(t->ps + offset);
+	}
+	for (i = 0; i < ARRAY_SIZE(t8132_ps_macos_off); i++) {
+		u32 offset = t8132_ps_macos_off[i];
+
+		t->ps_off_saved[i] = readl(t->ps + offset);
+		if (apple_s2r_t8132_ps_on(s2r, offset))
+			apple_s2r_t8132_ps_lower(t->ps + offset);
+	}
+	for (i = 0; i < ARRAY_SIZE(t8132_ps_aon_macos_off); i++) {
+		void __iomem *reg = t->ps_aon + t8132_ps_aon_macos_off[i];
+
+		t->ps_aon_saved[i] = readl(reg);
+		if (FIELD_GET(T8132_PS_ACTUAL, t->ps_aon_saved[i]))
+			apple_s2r_t8132_ps_lower(reg);
+	}
+	/* T8132's audio words stand at state 4 under macOS, not at f. */
+	for (i = 0; i < ARRAY_SIZE(t8132_ps_aon_macos_on); i++) {
+		void __iomem *reg = t->ps_aon + t8132_ps_aon_macos_on[i];
+		u32 val = readl(reg), now;
+
+		t->ps_aon_on_saved[i] = val;
+		if (FIELD_GET(T8132_PS_ACTUAL, val) == T8132_PS_AON_ON_STATE)
+			continue;
+		writel((val & ~(T8132_PS_AUTO_ENABLE | GENMASK(11, 0))) | T8132_PS_AON_ON_STATE,
+		       reg);
+		readl_poll_timeout_atomic(reg, now,
+					  FIELD_GET(T8132_PS_ACTUAL, now) == T8132_PS_AON_ON_STATE,
+					  1, T8132_PS_TIMEOUT_US);
+	}
+	t->matched = true;
+
+	for (i = 0; i < ARRAY_SIZE(t8132_ps_macos_off); i++)
+		apple_s2r_t8132_ps_wait_off(t->ps + t8132_ps_macos_off[i]);
+}
+
+/* Back as they were, after an abort past the match or a real wake. */
+static void apple_s2r_t8132_match_undo(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	int i;
+
+	if (!t->matched)
+		return;
+	t->matched = false;
+
+	for (i = ARRAY_SIZE(t8132_ps_aon_macos_on) - 1; i >= 0; i--)
+		writel(t->ps_aon_on_saved[i] & ~T8132_PS_FLAGS,
+		       t->ps_aon + t8132_ps_aon_macos_on[i]);
+	for (i = ARRAY_SIZE(t8132_ps_aon_macos_off) - 1; i >= 0; i--)
+		if (FIELD_GET(T8132_PS_ACTUAL, t->ps_aon_saved[i]))
+			writel(t->ps_aon_saved[i] & ~T8132_PS_FLAGS,
+			       t->ps_aon + t8132_ps_aon_macos_off[i]);
+	for (i = ARRAY_SIZE(t8132_ps_macos_off) - 1; i >= 0; i--)
+		if (FIELD_GET(T8132_PS_ACTUAL, t->ps_off_saved[i]))
+			apple_s2r_t8132_ps_raise(t->ps + t8132_ps_macos_off[i]);
+	for (i = ARRAY_SIZE(t8132_ps_macos_on) - 1; i >= 0; i--) {
+		u32 val = t->ps_on_saved[i];
+
+		if (!FIELD_GET(T8132_PS_ACTUAL, val))
+			apple_s2r_t8132_ps_lower(t->ps + t8132_ps_macos_on[i]);
+		else if (FIELD_GET(T8132_PS_ACTUAL, val) != 0xf)
+			writel(val & ~T8132_PS_FLAGS, t->ps + t8132_ps_macos_on[i]);
+	}
+	writel(t->spmi_saved[0], t->spmi + T8132_SPMI_NOTIFY_ENABLE);
+	writel(t->spmi_saved[1], t->spmi_a0);
+}
+
+/* WD2, as macOS programs it: the S2R path's own safety net (apple_sleep_set_wd2()). */
+static void apple_s2r_t8132_set_wd2(struct apple_s2r *s2r, unsigned int secs)
+{
+	writel(0, s2r->wdt + T8132_WD2_CTL);
+	writel(0, s2r->wdt + T8132_WD2_COUNT);
+	writel(secs * WDT_CLK_HZ, s2r->wdt + T8132_WD2_ALARM);
+	writel(1, s2r->wdt + T8132_WD2_CTL);
+}
+
+/* The AON domains of ATC0, deepest first, as macOS lowers ATC1's around sleep. */
+static void apple_s2r_t8132_lower_io(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+
+	t->atc0_saved[0] = readl(t->ps_aon + T8132_PS_AON_ATC0_USB);
+	t->atc0_saved[1] = readl(t->ps_aon + T8132_PS_AON_ATC0_USB_AON);
+	t->atc0_saved[2] = readl(t->ps + T8132_PS_ATC0_COMMON);
+	apple_s2r_t8132_ps_lower(t->ps_aon + T8132_PS_AON_ATC0_USB);
+	apple_s2r_t8132_ps_lower(t->ps_aon + T8132_PS_AON_ATC0_USB_AON);
+	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_ATC0_COMMON);
+}
+
+/* The engine's first step polls DCS at its sleep state; macOS has every voter at 0. */
+static void apple_s2r_t8132_dcs_down(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	unsigned int state;
+	int agent;
+
+	for (agent = 0; agent < T8132_PMC_VOTER_AGENTS; agent++)
+		if (readl(t->pmc_voters + agent * T8132_PMC_VOTER_STRIDE))
+			writel(0, t->pmc_voters + agent * T8132_PMC_VOTER_STRIDE);
+	if (!apple_s2r_t8132_perf_wait(t->dcs, T8132_DCS_SLEEP_STATE))
+		return;
+
+	state = FIELD_GET(T8132_DCS_STATE, readl(t->dcs));
+	if (state > T8132_DCS_STEP_STATE) {
+		writel(T8132_DCS_STEP_STATE, t->dcs);
+		apple_s2r_t8132_perf_wait(t->dcs, T8132_DCS_STEP_STATE);
+	}
+	if (state > T8132_DCS_SLEEP_STATE) {
+		writel(T8132_DCS_SLEEP_STATE, t->dcs);
+		apple_s2r_t8132_perf_wait(t->dcs, T8132_DCS_SLEEP_STATE);
+	}
+}
+
+/* Each 64-bit word cleared one bit at a time, from a fresh read each time. */
+static void apple_s2r_t8132_amcc_clear(void __iomem *reg, u8 bit)
+{
+	u64 val = readq(reg);
+
+	if (val & BIT_ULL(bit))
+		writeq(val & ~BIT_ULL(bit), reg);
+}
+
+static void apple_s2r_t8132_mcc_step_down(void __iomem *reg)
+{
+	u32 val = readl(reg);
+	int n;
+
+	for (n = 0; val && n < 32; n++) {
+		writel(val & (val - 1), reg);
+		val = readl(reg);
+	}
+}
+
+/* The memory controller before the gates (t8132_sleep_mcc_stop()). */
+static void apple_s2r_t8132_mcc_stop(struct apple_s2r *s2r)
+{
+	static const u8 order[] = { 8, 0, 1, 2, 3, 4, 9, 5, 6, 7 };
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	int i, plane, ch, stage;
+
+	for (i = 0; i < ARRAY_SIZE(order); i++)
+		for (plane = 0; plane < T8132_AMCC_PLANES; plane++)
+			apple_s2r_t8132_amcc_clear(t->amcc[plane] + T8132_AMCC_ENABLES, order[i]);
+
+	for (ch = 0; ch < T8132_MCC_CHANNELS; ch++)
+		apple_s2r_t8132_mcc_step_down(t->mcc[ch] + T8132_MCC_ENABLES);
+
+	apple_s2r_t8132_mcc_step_down(t->mcc[0] + T8132_MCC_LANES);
+
+	for (plane = 0; plane < T8132_AMCC_PLANES; plane++)
+		for (stage = 0; stage < 3; stage++)
+			apple_s2r_t8132_amcc_clear(t->amcc[plane] + T8132_AMCC_STAGES, stage);
+}
+
+/* The kernel's writable image, the per-CPU areas and cpu_resume's context. */
+static void apple_s2r_t8132_clean_ram(void)
+{
+	unsigned long base = (unsigned long)sleep_save_stash;
+	unsigned int cpu;
+
+	dcache_clean_poc((unsigned long)_sdata, (unsigned long)_end);
+	for_each_possible_cpu(cpu) {
+		unsigned long area = (unsigned long)__per_cpu_start + per_cpu_offset(cpu);
+
+		dcache_clean_poc(area, area + (__per_cpu_end - __per_cpu_start));
+	}
+	dcache_clean_poc(base, base + mpidr_hash_size() * sizeof(*sleep_save_stash));
+	dsb(sy);
+}
+
+/*
+ * The last mile, in macOS's order (t8132_sleep_commit()). From the IO
+ * lowering on nothing returns: a hang ends at a watchdog. abort_before stops
+ * before the parked CPUs are stopped, or after it, before the IO lowering;
+ * the stopped CPUs then power down and stay down until a reboot.
+ */
+static int apple_s2r_t8132_finish(unsigned long arg)
+{
+	struct apple_s2r *s2r = (struct apple_s2r *)arg;
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	struct apple_s2r_mailbox *mb = s2r->mailbox;
+	u64 flags = S2R_FLAG_QUIET | (warm_flags & S2R_FLAGS_OS);
+	int i, ret;
+
+	t->siq_cfg = read_sysreg_s(SYS_APL_SIQ_CFG_EL1);
+
+	ret = apple_s2r_check(s2r, S2R_STEP_T8132_STOP);
+	if (ret)
+		return ret;
+	ret = apple_cpu_t8132_stop_parked();
+	if (ret) {
+		/* Ours, not Aurora's: a core left awake would hold the engine. */
+		apple_cpu_t8132_release_stopped(false);
+		return ret;
+	}
+	ret = apple_s2r_check(s2r, S2R_STEP_T8132_LOWER);
+	if (ret) {
+		apple_cpu_t8132_release_stopped(false);
+		return ret;
+	}
+
+	/* From here the SoC powers down. */
+	pm_set_resume_via_firmware();
+	apple_s2r_t8132_clean_ram();
+	apple_s2r_t8132_lower_io(s2r);
+
+	/* The safety net, as macOS arms it (apple_sleep_arm_wd2()) */
+	writel(0, s2r->wdt + T8132_WD0_CTL);
+	apple_s2r_t8132_set_wd2(s2r, T8132_WD2_SLEEP_SECS);
+	writel(0, t->aon_misc + T8132_AON_AP_DEADLINE);
+
+	if (apple_s2r_t8132_perf_wait(t->clk_perf + T8132_CLK_PERF_SOC, T8132_SOC_SLEEP_STATE)) {
+		writel(T8132_SOC_SLEEP_STATE, t->clk_perf + T8132_CLK_PERF_SOC);
+		apple_s2r_t8132_perf_wait(t->clk_perf + T8132_CLK_PERF_SOC, T8132_SOC_SLEEP_STATE);
+	}
+	apple_s2r_t8132_dcs_down(s2r);
+	apple_s2r_t8132_mcc_stop(s2r);
+
+	/* Gates twice, the fourth voter, gates. On macOS the voter reads 0 already. */
+	for (i = 0; i < 2; i++) {
+		writel(T8132_PWRGATE_ON, t->pwrgate + T8132_PWRGATE_CPM_0);
+		writel(T8132_PWRGATE_ON, t->pwrgate + T8132_PWRGATE_CPM_1);
+	}
+	readl(t->pmc_voters + T8132_PMC_VOTER3);
+	writel(0, t->pmc_voters + T8132_PMC_VOTER3);
+	readl(t->pmc_voters + T8132_PMC_VOTER3_B);
+	writel(T8132_PWRGATE_ON, t->pwrgate + T8132_PWRGATE_CPM_0);
+	writel(T8132_PWRGATE_ON, t->pwrgate + T8132_PWRGATE_CPM_1);
+
+	writel(0, t->cluster + T8132_CLUSTER_E);
+	writel(0, t->cluster + T8132_CLUSTER_P);
+
+	t->quiesce_still_on = 0;
+	for (i = 0; i < ARRAY_SIZE(t8132_quiesce_words); i++)
+		if (apple_s2r_t8132_ps_on(s2r, t8132_quiesce_words[i]))
+			t->quiesce_still_on |= BIT(i);
+
+	/* All four read back unchanged on macOS. */
+	for (i = 0; i < ARRAY_SIZE(t8132_clk_mux); i++)
+		writel(T8132_CLK_MUX_PARKED, t->clk_mux + t8132_clk_mux[i]);
+
+	apple_s2r_t8132_ps_save(s2r);
+	/* macOS leaves this one to AUTO_ENABLE at the commit. */
+	writel((readl(t->ps_aon + T8132_PS_AON_NUB_SRAM) & ~T8132_PS_FLAGS) | T8132_PS_AUTO_ENABLE,
+	       t->ps_aon + T8132_PS_AON_NUB_SRAM);
+
+	/* Our boot firmware's mailbox; the wake comes back through the WD2 stub. */
+	if (!s2r->wdt_armed)
+		flags &= ~S2R_FLAG_WDT_THROUGH;
+	WRITE_ONCE(mb->entry, cpu_to_le64(__pa_symbol(apple_s2r_t8132_resume)));
+	WRITE_ONCE(mb->arg, 0);
+	WRITE_ONCE(mb->flags, cpu_to_le64(flags));
+	WRITE_ONCE(mb->magic, cpu_to_le64(S2R_MAGIC));
+	dcache_clean_poc((unsigned long)mb, (unsigned long)(mb + 1));
+	if (s2r->wdt_armed)
+		apple_s2r_wdt_arm(s2r);
+
+	/* What this path has dirtied since the sweep. */
+	dcache_clean_poc((unsigned long)task_stack_page(current),
+			 (unsigned long)task_stack_page(current) + THREAD_SIZE);
+	dcache_clean_poc((unsigned long)s2r, (unsigned long)(s2r + 1));
+	dsb(sy);
+
+	writel(S2R_TIMER_START, t->commit);
+
+	/*
+	 * Each core's deep WFI comes after the commit, this one last. The AIC
+	 * was masked whole by its syscore suspend already.
+	 */
+	apple_cpu_t8132_release_stopped(true);
+	mdelay(T8132_POST_COMMIT_MS);
+	apple_cpu_t8132_deep_sleep();
+}
+
+/* Back on the boot CPU through cpu_resume, in macOS's order (apple_sleep_return()). */
+static void apple_s2r_t8132_return(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	u32 val;
+	int i;
+
+	write_sysreg(t->cntkctl, cntkctl_el1);
+	isb();
+	write_sysreg_s(t->siq_cfg, SYS_APL_SIQ_CFG_EL1);
+
+	writel(T8132_CLUSTER_ON, t->cluster + T8132_CLUSTER_E);
+	t->cluster_e_ret = readl_poll_timeout_atomic(t->cluster + T8132_CLUSTER_E, val,
+						     val & T8132_CLUSTER_E_READY, 1,
+						     T8132_CLUSTER_TIMEOUT_US);
+	writel(T8132_CLUSTER_ON, t->cluster + T8132_CLUSTER_P);
+
+	writel(T8132_PWRGATE_ON, t->pwrgate + T8132_PWRGATE_WAKE_0);
+	writel(T8132_PWRGATE_ON, t->pwrgate + T8132_PWRGATE_WAKE_1);
+
+	apple_s2r_t8132_ps_rewake(s2r);
+	/* ATC0's words were saved already lowered: back in reverse order. */
+	apple_s2r_t8132_ps_restore(t->ps + T8132_PS_ATC0_COMMON, t->atc0_saved[2]);
+	apple_s2r_t8132_ps_restore(t->ps_aon + T8132_PS_AON_ATC0_USB_AON, t->atc0_saved[1]);
+	apple_s2r_t8132_ps_restore(t->ps_aon + T8132_PS_AON_ATC0_USB, t->atc0_saved[0]);
+
+	val = readl(t->ps + T8132_PS_SEP);
+	if (val & T8132_PS_DEV_DISABLE)
+		writel(val & ~T8132_PS_DEV_DISABLE, t->ps + T8132_PS_SEP);
+
+	writel(T8132_PWRGATE_ON, t->pwrgate + T8132_PWRGATE_CPM_0);
+	writel(T8132_PWRGATE_ON, t->pwrgate + T8132_PWRGATE_CPM_1);
+
+	/* macOS stops it here. Keep a longer one over device resume, until ->end. */
+	apple_s2r_t8132_set_wd2(s2r, T8132_WD2_SUSPEND_SECS);
+
+	apple_cpu_power_cycled();
+	s2r->pins_lost = s2r->pins_saved_valid;
+
+	for (i = 0; i < T8132_WAKE_WORDS; i++)
+		t->wake_status[i] = readl(t->wake + T8132_WAKE_STATUS(i));
+	t->returned = true;
+}
+
+/*
+ * What the T8132 sequence needs before anything is told or stopped. Checked
+ * with interrupts off in ->enter, so it reads and logs only.
+ */
+static int apple_s2r_t8132_refuse(struct apple_s2r *s2r)
+{
+	int i;
+
+	if (READ_ONCE(abort_tells_enclave) || READ_ONCE(spin_instead_of_sleep)) {
+		pr_warn("apple-s2r: T8132 sequence: abort_tells_enclave and spin_instead_of_sleep are for the CPU complex sequence: refused\n");
+		return -EINVAL;
+	}
+	if (!s2r->wdt) {
+		pr_warn("apple-s2r: T8132 sequence: no apple,watchdog: refused\n");
+		return -ENODEV;
+	}
+	if (apple_s2r_crumb_find(s2r)) {
+		pr_warn("apple-s2r: T8132 sequence: PMU boot stage byte not usable: refused\n");
+		return -ENODEV;
+	}
+	if (READ_ONCE(abort_before))
+		return 0;
+
+	/*
+	 * A real sleep. The engine waits for the display CPUs with no timeout
+	 * (SOURCE), and the IO lowering here does not stop ANS's PCIe block
+	 * yet: refused while either is on, so only bring-up runs with
+	 * abort_before go ahead.
+	 */
+	for (i = 0; i < ARRAY_SIZE(t8132_ps_disp_cpu); i++)
+		if (apple_s2r_t8132_ps_on(s2r, t8132_ps_disp_cpu[i])) {
+			pr_warn("apple-s2r: T8132 sequence: display CPU domain %#x is on: refused\n",
+				t8132_ps_disp_cpu[i]);
+			return -EBUSY;
+		}
+	if (apple_s2r_t8132_ps_on(s2r, T8132_PS_ANS) ||
+	    apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_SYS_GP)) {
+		pr_warn("apple-s2r: T8132 sequence: ANS or its PCIe block is on, and this path can't lower them yet: refused\n");
+		return -EBUSY;
+	}
+
+	return 0;
+}
+
+/* ->enter's T8132 part, past the coprocessors' refusals and stops. */
+static int apple_s2r_t8132_enter(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	int ret;
+
+	t->returned = false;
+	t->cpus_stop_ret = 0;
+	t->cluster_e_ret = 0;
+
+	ret = apple_s2r_check(s2r, S2R_STEP_T8132_WAKE);
+	if (ret)
+		return ret;
+	apple_s2r_t8132_wake_arm(s2r);
+
+	ret = apple_s2r_check(s2r, S2R_STEP_T8132_MATCH);
+	if (!ret) {
+		apple_s2r_t8132_match(s2r);
+		ret = apple_s2r_check(s2r, S2R_STEP_SUSPEND);
+	}
+	if (!ret) {
+		t->cntkctl = read_sysreg(cntkctl_el1);
+		if (s2r->wdt && wdt_timeout && !s2r->wdt_armed)
+			apple_s2r_wdt_take(s2r);
+		ret = cpu_suspend((unsigned long)s2r, apple_s2r_t8132_finish);
+		if (!ret)
+			apple_s2r_t8132_return(s2r);
+	}
+
+	apple_s2r_t8132_match_undo(s2r);
+	apple_s2r_t8132_wake_restore(s2r);
+
+	return ret;
+}
+
+/* After ->enter: what the wake found, and what didn't go as macOS has it. */
+static void apple_s2r_t8132_report(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	unsigned int i, id;
+
+	if (t->pmu_err)
+		dev_warn(s2r->dev, "T8132: PMU boot stage write failed %u time(s)\n", t->pmu_err);
+	t->pmu_err = 0;
+	if (!t->returned)
+		return;
+	t->returned = false;
+
+	for (id = 0; id < 32 * T8132_WAKE_WORDS; id++)
+		if (t->wake_status[id / 32] & t->wake_armed[id / 32] & BIT(id % 32))
+			dev_info(s2r->dev, "T8132: woken by AP wake source %u\n", id);
+	dev_info(s2r->dev, "T8132: power words: %u written back, %u not on in time\n",
+		 t->ps_rewoken, t->ps_rewake_timeouts);
+	for (i = 0; i < ARRAY_SIZE(t8132_ps_all); i++)
+		if (t->ps_late[i])
+			dev_err(s2r->dev, "T8132: power word %#x not on in time: %#x at the commit, %#x now\n",
+				t8132_ps_all[i], t->ps_commit[i], readl(t->ps + t8132_ps_all[i]));
+	for (i = 0; i < ARRAY_SIZE(t8132_quiesce_words); i++)
+		if (t->quiesce_still_on & BIT(i))
+			dev_err(s2r->dev, "T8132: power word %#x was on at the last step\n",
+				t8132_quiesce_words[i]);
+	if (t->cluster_e_ret)
+		dev_err(s2r->dev, "T8132: E cluster power timed out: %d\n", t->cluster_e_ret);
+}
+
+/*
+ * ->begin: WD2 as the T8132 path's own net from here to ->end, as macOS and
+ * Aurora arm it, and the PMU boot stage byte read, to be put back after the
+ * sleep when no breadcrumb does it.
+ */
+static void apple_s2r_t8132_begin(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+
+	t->pmu_written = false;
+	t->pmu_orig_ok = !apple_s2r_crumb_find(s2r) &&
+			 !spmi_ext_register_readl(s2r->crumb_dev, s2r->crumb_addr, &t->pmu_orig, 1);
+	if (t->mapped && s2r->wdt) {
+		apple_s2r_t8132_set_wd2(s2r, T8132_WD2_SUSPEND_SECS);
+		t->wd2_armed = true;
+	}
+}
+
+/* The T8132 register windows; mapped without claiming them, as other drivers own most. */
+static int apple_s2r_t8132_map(struct apple_s2r *s2r, struct platform_device *pdev)
+{
+	static const struct {
+		const char *name;
+		size_t offset;
+	} regs[] = {
+		{ "ps", offsetof(struct apple_s2r_t8132, ps) },
+		{ "ps-aon", offsetof(struct apple_s2r_t8132, ps_aon) },
+		{ "pwrgate", offsetof(struct apple_s2r_t8132, pwrgate) },
+		{ "cluster", offsetof(struct apple_s2r_t8132, cluster) },
+		{ "commit", offsetof(struct apple_s2r_t8132, commit) },
+		{ "aon-misc", offsetof(struct apple_s2r_t8132, aon_misc) },
+		{ "wake", offsetof(struct apple_s2r_t8132, wake) },
+		{ "spmi", offsetof(struct apple_s2r_t8132, spmi) },
+		{ "spmi-a0", offsetof(struct apple_s2r_t8132, spmi_a0) },
+		{ "pmc-voters", offsetof(struct apple_s2r_t8132, pmc_voters) },
+		{ "dcs", offsetof(struct apple_s2r_t8132, dcs) },
+		{ "clk-mux", offsetof(struct apple_s2r_t8132, clk_mux) },
+		{ "clk-perf", offsetof(struct apple_s2r_t8132, clk_perf) },
+		{ "amcc0", offsetof(struct apple_s2r_t8132, amcc[0]) },
+		{ "amcc1", offsetof(struct apple_s2r_t8132, amcc[1]) },
+		{ "mcc0", offsetof(struct apple_s2r_t8132, mcc[0]) },
+		{ "mcc1", offsetof(struct apple_s2r_t8132, mcc[1]) },
+	};
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	struct device *dev = &pdev->dev;
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		void __iomem **field = (void __iomem **)((u8 *)t + regs[i].offset);
+		struct resource *res;
+
+		res = platform_get_resource_byname(pdev, IORESOURCE_MEM, regs[i].name);
+		if (!res)
+			return dev_err_probe(dev, -ENODEV, "T8132 sequence: no %s registers\n",
+					     regs[i].name);
+		*field = devm_ioremap(dev, res->start, resource_size(res));
+		if (!*field)
+			return -ENOMEM;
+	}
+
+	ret = of_property_read_variable_u32_array(dev->of_node, "apple,wake-enable",
+						  t->wake_enable, 1,
+						  ARRAY_SIZE(t->wake_enable));
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "T8132 sequence: no apple,wake-enable\n");
+	t->nwake = ret;
+	t->mapped = true;
+
+	return 0;
+}
