 kernel/sched/fair.c     | 133 ++++++++++++++++++++++++++++++++++++++++
 kernel/sched/features.h |   7 +++
 kernel/sched/sched.h    |  23 ++++++-
 4 files changed, 169 insertions(+), 4 deletions(-)

diff --git a/kernel/sched/core.c b/kernel/sched/core.c
