From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
Date: Tue, 3 Nov 2026 10:57:50 -0600
Subject: [PATCH] pmdomain: apple: pmp-agx-vote: arm the retry when the write
 outlasts the operation

The residual from the delay-contract review: when the last operation ends
inside a failed SET write, applied records the failure with users already 0,
and next() returned 0 on that path, so no timer existed and a begin before the
deadline reported "no kick" (2ec389ca's clock gate) - the retry never ran.

next() now arms the retry from the failure state itself (users 0, not voted,
failures set): the remaining delay, or 1 when the deadline is already reached.
That alone would re-arm forever once the retry fired idle, so the work
function also clears a spent backoff: a reconcile that finds nobody waiting
and an expired deadline (decide returned NONE) sets failures to 0, and the
state settles. A later operation then starts a fresh attempt, exactly like
the first.

Case 25 (4574c14c, red at s.armed) walks the sequence through the
release/resume cycle; the retry-dropped-when-idle mutant removes the new
branch and dies there. The sim's begin helper now arms the returned delay
(delay 1 is "due now" within a tick), case 23's spent-backoff assert and
case 24's next() assert updated to the new contract. Plain suite 25 cases,
ten mutants, all caught; the tree runner passes the registered entries.

Signed-off-by: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
(cherry picked from commit 85a68bf69d05cdbdd4ba89b0764f1f063da87cef)
---
 drivers/pmdomain/apple/pmp-agx-vote.h |  5 +++++
 drivers/pmdomain/apple/pmp-report.c   |  3 +++
 tools/asahi/pmp-agx-vote-tests.c      | 13 +++++++++----
 tools/asahi/pmp-agx-vote-tests.py     |  6 ++++++
 tools/aurora-ci/host-tests.json       | 14 ++++++++++++++
 5 files changed, 37 insertions(+), 4 deletions(-)

diff --git a/drivers/pmdomain/apple/pmp-agx-vote.h b/drivers/pmdomain/apple/pmp-agx-vote.h
index 2f392a4480..4bd3ed6836 100644
--- a/drivers/pmdomain/apple/pmp-agx-vote.h
+++ b/drivers/pmdomain/apple/pmp-agx-vote.h
@@ -117,6 +117,11 @@ static inline agx_ms_t agx_vote_next(const struct agx_vote *v, agx_ms_t now)
 		at = agx_vote_retry_reached(v, now) ? now : v->retry_at;
 	else if (!v->users && v->voted)
 		at = v->idle_at + v->idle_ms;
+	else if (!v->users && !v->voted && v->failures)
+		/* The write outlasted the operation: arm the retry from the failure state
+		 * itself. The caller clears failures when this reconcile finds nobody waiting
+		 * (decide returns NONE), so it fires once. */
+		at = agx_vote_retry_reached(v, now) ? now : v->retry_at;
 	else
 		return 0;
 	/* An already-reached deadline returns 1: there is work, due now. The SET-write race leaves exactly
diff --git a/drivers/pmdomain/apple/pmp-report.c b/drivers/pmdomain/apple/pmp-report.c
index 3b723a658a..cf0322bd0a 100644
--- a/drivers/pmdomain/apple/pmp-report.c
+++ b/drivers/pmdomain/apple/pmp-report.c
@@ -1444,6 +1444,9 @@ static void apple_pmp_agx_vote_fn(struct work_struct *work)
 	v->idle_ms = READ_ONCE(agx_vote_idle_ms);
 	now = apple_pmp_agx_now_ms();
 	act = agx_vote_decide(v, now);
+	if (act == AGX_VOTE_NONE && v->failures && !v->users && !v->voted &&
+	    agx_vote_retry_reached(v, now))
+		v->failures = 0;	/* the backoff fired with nobody waiting: it is spent */
 	spin_unlock_irqrestore(&apple_pmp_agx_vote_lock, flags);
 
 	if (act != AGX_VOTE_NONE) {
diff --git a/tools/asahi/pmp-agx-vote-tests.c b/tools/asahi/pmp-agx-vote-tests.c
index d4dae0cac9..a41d97d097 100644
--- a/tools/asahi/pmp-agx-vote-tests.c
+++ b/tools/asahi/pmp-agx-vote-tests.c
@@ -51,6 +51,9 @@ static void reconcile(struct sim *s)
 	} else if (act == AGX_VOTE_CLEAR) {
 		s->clears++;
 		s->bit = false;
+	} else if (s->v.failures && !s->v.users && !s->v.voted &&
+		   agx_vote_retry_reached(&s->v, s->now)) {
+		s->v.failures = 0;     // the glue clears a spent backoff when the retry fires idle
 	}
 	while (s->end_in_write > 0) {
 		s->end_in_write--;
@@ -69,9 +72,11 @@ static void reconcile(struct sim *s)
 
 static void begin(struct sim *s)
 {
-	if (agx_vote_begin(&s->v, s->now)) {
+	agx_ms_t d = agx_vote_begin(&s->v, s->now);
+	if (d) {
 		s->kicks++;
-		arm(s, 0);
+		/* delay 1 is "due now": the glue runs it within the same tick */
+		arm(s, d == 1 ? 0 : d);
 	}
 }
 
@@ -378,7 +383,7 @@ int main(void)
 		CHECK(s.v.failures == 1 && s.armed);
 		end(&s);                                               // the operation ends long before the retry
 		advance_to(&s, AGX_VOTE_RETRY_MS);                     // the timer fires idle: nothing to do
-		CHECK(s.v.failures == 1 && !s.armed && !s.bit);
+		CHECK(s.v.failures == 0 && !s.armed && !s.bit);   // the spent backoff cleared at the idle fire
 		int kicks = s.kicks;
 		begin(&s);                                             // a later operation: the kick must come back
 		advance_to(&s, s.now + 1);
@@ -398,7 +403,7 @@ int main(void)
 		CHECK(agx_vote_decide(&v, 5000) == AGX_VOTE_SET);
 		CHECK(agx_vote_end(&v, 5001) == 0);                   // the end during the ack: no timer
 		agx_vote_applied(&v, AGX_VOTE_SET, -110, 5000);       // the ack times out
-		CHECK(v.failures == 1 && agx_vote_next(&v, 5001) == 0);   // nothing armed by the write path
+		CHECK(v.failures == 1 && agx_vote_next(&v, 5001) == 999);  // next arms the retry from the failure state
 		unsigned delay = agx_vote_begin(&v, 5002);
 		CHECK(delay == 998);                                  // the begin arms the remaining delay
 		CHECK(v.users == 1);
diff --git a/tools/asahi/pmp-agx-vote-tests.py b/tools/asahi/pmp-agx-vote-tests.py
index 2e431711ff..37eec88d71 100755
--- a/tools/asahi/pmp-agx-vote-tests.py
+++ b/tools/asahi/pmp-agx-vote-tests.py
@@ -35,6 +35,12 @@ CONTROLS = [
      'if (!v->enabled)\n\t\treturn v->voted ? AGX_VOTE_CLEAR : AGX_VOTE_NONE;'),
     ('wrap-reached', 'return (agx_sms_t)(now - t) >= 0;', 'return now >= t;'),
     ('set-write-ends', 'return agx_vote_reached(now, at) ? 1 : at - now;', 'return agx_vote_reached(now, at) ? 0 : at - now;'),
+    ('retry-dropped-when-idle',
+     '\telse if (!v->users && !v->voted && v->failures)\n'
+     '\t\t/* The write outlasted the operation: arm the retry from the failure state\n'
+     '\t\t * itself. The caller clears failures when this reconcile finds nobody waiting\n'
+     '\t\t * (decide returns NONE), so it fires once. */\n'
+     '\t\tat = agx_vote_retry_reached(v, now) ? now : v->retry_at;\n', ''),
     ('begin-backoff-kick', 'return (!v->failures || agx_vote_retry_reached(v, now)) ? 1 : v->retry_at - now;', 'return (void)now, 1;'),
     ('begin-no-retry-arm', 'return (!v->failures || agx_vote_retry_reached(v, now)) ? 1 : v->retry_at - now;', 'return (void)now, 0;'),
     ('retry-revival', '|| (agx_sms_t)(v->retry_at - now) > (agx_sms_t)AGX_VOTE_RETRY_MS', ''),
