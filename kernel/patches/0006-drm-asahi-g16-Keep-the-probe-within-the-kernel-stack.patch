From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 5 Nov 2026 20:19:08 +0000
Subject: [PATCH] drm/asahi: g16: Keep the probe within the kernel
 stack

The G16 probe can overflow the 32 KiB task stack once the firmware is
at READY. On the J604 (MacBook Pro 14-inch, M4) modprobe asahi ends in

  Kernel panic - not syncing: kernel stack overflow
  ...
  __bad_stack+0x80/0x84
  asahi_core::g16::Firmware::start_backend+0x34/0x1ea0 [asahi] (P)
  asahi_core::driver::AsahiPlatformDriver::probe_g16+0x2e5c/0x3140 [asahi]
  ...
  __arm64_sys_finit_module+0x234/0x358

The fault is the third stack probe of start_backend, 12 KiB into its
frame.

Most of the probe's stack holds copies of the session parts. InitData
carries the 1680-byte loader table inline, so InitData is 1808 bytes,
Booted 3224, Orphan 3200 and Firmware 5048. start_backend destructures
Booted, builds Firmware on the stack for KBox::write, moves it back
out with KBox::into_inner on a failure path and builds an Orphan on
each failure path; Gpu::new also inlines admission and the firmware
start, with Booted, the initdata builder and their own Orphan. With
rustc 1.85.0 the result depends on inlining: here probe_g16 is
0x42e0 bytes and the out-of-line start_backend 0x4270, two frames of
about 17 KiB live at once. (Without the J604 board gate in Gpu::new,
start_backend is inlined into a single 0x4ef0-byte Gpu::new instead.)

Keep the probe within the stack whatever is inlined:

 - box the loader table, so that InitData and everything that carries
   it is 1672 bytes smaller;
 - initialise the boxed Firmware in place, the session parts moving
   straight from Booted, and give the two failure paths, which take
   the parts back as an Orphan, their own cold frames;
 - keep boot::admit and boot::start out of line, so that the probe
   frame does not also hold their locals while the backend starts.

Frames from the function prologues, same configuration and toolchain:

                                       before            after
  Driver::probe (+ probe_g16, Gpu::new) 0xd0 + 0x42e0     0x1040
  Firmware::start_backend               0x4270            0x12f0
  boot::start                           (inlined)         0xf40
  boot::start closure                   0x1440            0x830

and the static worst case below Driver::probe, driver frames only,
drops from 39184 to 14800 bytes.

The same parts are retained on each failure path as before, and the
loader table is published from the box unchanged.

Fixes: e91a1f07c8eb ("drm/asahi: add the T8132 G16 firmware backend")
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit f52e65b9c3d9b0aaf0f5383fa700b8abac8ab175)
---
 drivers/gpu/drm/asahi/g16/initdata.rs |   6 +-
 drivers/gpu/drm/asahi/g16/mod.rs      | 146 +++++++++++++++-----------
 2 files changed, 91 insertions(+), 61 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/initdata.rs b/drivers/gpu/drm/asahi/g16/initdata.rs
index ecdde05791..3a404222c8 100644
--- a/drivers/gpu/drm/asahi/g16/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/initdata.rs
@@ -38,7 +38,9 @@ pub(crate) struct InitData {
     #[allow(dead_code)]
     pub(crate) parameter: Arc<FwObject>,
     root: Arc<FwObject>,
-    loader: [u8; wire::LOADER_BYTES],
+    /// Boxed: `InitData` moves through the probe by value (in `Booted`, `Orphan` and
+    /// `Firmware`), and the probe runs within the 32 KiB task stack.
+    loader: KBox<[u8; wire::LOADER_BYTES]>,
     /// The complete inventory, including firmware-only log and retention data.
     _graph: KVec<Arc<FwObject>>,
 }
@@ -186,7 +188,7 @@ pub(crate) fn build(
             (&mut slices[..]).try_into().map_err(|_| EINVAL)?;
         wire::encode(array, &input, 9).map_err(|()| EINVAL)?;
     }
-    let mut loader = [0u8; wire::LOADER_BYTES];
+    let mut loader = KBox::<[u8; wire::LOADER_BYTES]>::zeroed(GFP_KERNEL)?;
     loader.copy_from_slice(&images[id::MAIN][0x640..0x640 + wire::LOADER_BYTES]);
     // Host startup policy: Main and PowerPerformance contain S9, but the
     // published selectors remain S1 until the thermal owner admits a raise.
diff --git a/drivers/gpu/drm/asahi/g16/mod.rs b/drivers/gpu/drm/asahi/g16/mod.rs
index 0600485cdb..bff3d29bde 100644
--- a/drivers/gpu/drm/asahi/g16/mod.rs
+++ b/drivers/gpu/drm/asahi/g16/mod.rs
@@ -446,45 +446,16 @@ impl Firmware {
     #[inline(never)]
     fn start_backend(
         dev: &AsahiDrmDevice,
-        booted: boot::Booted,
+        mut booted: boot::Booted,
         shared: &Arc<Shared>,
         power: power::Power,
     ) -> Result<KBox<Firmware>> {
-        let boot::Booted {
-            session,
-            init,
-            mut objects,
-            channels,
-            events,
-            ..
-        } = booted;
         dev_info!(
             dev.as_ref(),
             "G16: firmware at READY, starting the backend\n"
         );
-        let orphan = |session: boot::Session,
-                      objects: object::Objects,
-                      channels: channel::Channels,
-                      init: initdata::InitData,
-                      events: event::Events,
-                      error: Error|
-         -> Error {
-            dev_err!(
-                dev.as_ref(),
-                "G16: backend start failed ({:?}); firmware retained at READY until reboot\n",
-                error
-            );
-            shared.orphan(boot::Orphan {
-                session,
-                _objects: objects,
-                channels: Some(channels),
-                _init: Some(init),
-                events,
-            });
-            error
-        };
         let backend = (|| -> Result<_> {
-            let graph = graph::Graphs::new(dev, &mut objects)?;
+            let graph = graph::Graphs::new(dev, &mut booted.objects)?;
             let slots = slots::Slots::new()?;
             let pools = pools::Pools::new(dev);
             let vms = vm::Registry::new()?;
@@ -494,39 +465,96 @@ fn start_backend(
         })();
         let (graph, slots, pools, vms, engine, slot) = match backend {
             Ok(backend) => backend,
-            Err(e) => return Err(orphan(session, objects, channels, init, events, e)),
+            Err(e) => return Err(Self::orphan_booted(dev, shared, booted, e)),
         };
-        let mut firmware = KBox::write(
-            slot,
-            Firmware {
-                session,
-                init,
-                private_factory: objects.private_factory(),
-                objects,
-                channels,
-                events,
-                graph,
-                slots,
-                engine,
-                recovery: recovery::Recovery::new(),
-                power,
-                pools,
-                vms,
-            },
-        );
+        let private_factory = booted.objects.private_factory();
+        let Ok(mut firmware) = slot.write_init(init!(Firmware {
+            session: booted.session,
+            init: booted.init,
+            private_factory,
+            objects: booted.objects,
+            channels: booted.channels,
+            events: booted.events,
+            graph,
+            slots,
+            engine,
+            recovery: recovery::Recovery::new(),
+            power,
+            pools,
+            vms,
+        }));
         if let Err(e) = firmware.init_graphs() {
-            let Firmware {
-                session,
-                init,
-                objects,
-                channels,
-                events,
-                ..
-            } = KBox::into_inner(firmware);
-            return Err(orphan(session, objects, channels, init, events, e));
+            return Err(Self::orphan_firmware(dev, shared, firmware, e));
         }
         Ok(firmware)
     }
+
+    /// The backend parts could not be built: retains the booted session as an orphan.
+    #[cold]
+    #[inline(never)]
+    fn orphan_booted(
+        dev: &AsahiDrmDevice,
+        shared: &Arc<Shared>,
+        booted: boot::Booted,
+        error: Error,
+    ) -> Error {
+        let boot::Booted {
+            session,
+            init,
+            objects,
+            channels,
+            events,
+            ..
+        } = booted;
+        Self::orphan(dev, shared, session, objects, channels, init, events, error)
+    }
+
+    /// The graphs could not be initialised: retains the session parts of `firmware` as an
+    /// orphan and drops the rest of the backend.
+    #[cold]
+    #[inline(never)]
+    fn orphan_firmware(
+        dev: &AsahiDrmDevice,
+        shared: &Arc<Shared>,
+        firmware: KBox<Firmware>,
+        error: Error,
+    ) -> Error {
+        let Firmware {
+            session,
+            init,
+            objects,
+            channels,
+            events,
+            ..
+        } = KBox::into_inner(firmware);
+        Self::orphan(dev, shared, session, objects, channels, init, events, error)
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn orphan(
+        dev: &AsahiDrmDevice,
+        shared: &Arc<Shared>,
+        session: boot::Session,
+        objects: object::Objects,
+        channels: channel::Channels,
+        init: initdata::InitData,
+        events: event::Events,
+        error: Error,
+    ) -> Error {
+        dev_err!(
+            dev.as_ref(),
+            "G16: backend start failed ({:?}); firmware retained at READY until reboot\n",
+            error
+        );
+        shared.orphan(boot::Orphan {
+            session,
+            _objects: objects,
+            channels: Some(channels),
+            _init: Some(init),
+            events,
+        });
+        error
+    }
 }
 
 impl gpu::Gpu for Gpu {
