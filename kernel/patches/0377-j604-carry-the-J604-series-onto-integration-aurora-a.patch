index 4439321382..d05750b9dd 100644
--- a/drivers/media/platform/apple/ave/ave.h
+++ b/drivers/media/platform/apple/ave/ave.h
@@ -144,6 +144,13 @@ enum ave_opcode {
 #define AVE_FW_TEXT_CRC_T6040_25G83 0x68d5f9f6
 /* H16G (T8132) AppleAVE2FW 9003.78.0 from 25G83: start-up values not known yet. */
 #define AVE_FW_TEXT_CRC_T8132_25G83 0x9308d2ab
+/*
+ * The M4 Max (J575c) build of AppleAVE2FW 9003.78.0, as iBoot 25G83 loads it:
