From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 09:06:53 +0000
Subject: [PATCH] drm/asahi: g16: Pack compute work blocks by default

Keep compute work blocks 0x900 apart, matching the macOS layout.
The 1.1012 experiment completed three rounds of all four rows with
zero firmware faults and two passing repro runs. No speed gain is
claimed for this layout change.

Set aurora.g16_cwork_pack=0 before the first compute units are built
to restore separate work-block allocations.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 3d6ab32aac..24355df51b 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -1385,7 +1385,7 @@ pub(crate) fn pb_heap16() -> bool {
 );
 
 /// Storage of `g16_cwork_pack` (0644, default 0; latched at its first read).
-static CWORK_PACK: AtomicU32 = AtomicU32::new(0);
+static CWORK_PACK: AtomicU32 = AtomicU32::new(1);
 /// 0 until latched, then 1 (off) or 2 (on).
 static CWORK_PACK_LATCH: AtomicU32 = AtomicU32::new(0);
 
-- 
