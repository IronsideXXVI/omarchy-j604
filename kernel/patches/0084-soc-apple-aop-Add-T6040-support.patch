--- a/drivers/soc/apple/aop.rs
+++ b/drivers/soc/apple/aop.rs
@@ -91,6 +91,17 @@ const AOP_MMIO_SIZE: usize = 0x1e0000;
 const ASC_MMIO_SIZE: usize = 0x4000;
 const BOOTARGS_OFFSET: usize = 0x22c;
