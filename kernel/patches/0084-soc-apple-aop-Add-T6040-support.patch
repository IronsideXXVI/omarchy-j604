+    map_etext: false,
+    halt_on_failed_start: false,
 };
 const HW_CFG_T8112: AopHwConfig = AopHwConfig {
     ec0p: 0x020000,
@@ -2272,6 +2430,8 @@ const HW_CFG_T8112: AopHwConfig = AopHwConfig {
     setup_port: false,
     quiesce_on_unbind: false,
