From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 00:30:12 +0000
Subject: [PATCH] arm64: dts: apple: t8132: keep the APCIE sleep
 windows with port 2

t8132-apcie-port2.dtsi replaces the PCIe node's reg and reg-names to
add port 2, and drops the five blocks t8132.dtsi lists after the port
0 PHY: axi2af, cio3pll, clkgen, phy-block and phy-ip. The sleep
controller maps those by name through apple,apcie to bring the link
back after a real power loss, so on a board with port 2 it finds none
of them and refuses every deep sleep:

  apple-sleep 380700000.sleep-controller: refused: no tunables to
  bring ANS's PCIe block back

List them again after port 2. The addresses are t8132.dtsi's, and the
J604's ADT apcie node has the same five windows.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-apcie-port2.dtsi | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-apcie-port2.dtsi b/arch/arm64/boot/dts/apple/t8132-apcie-port2.dtsi
index 2a1fcd3ba4..163d85a311 100644
--- a/arch/arm64/boot/dts/apple/t8132-apcie-port2.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-apcie-port2.dtsi
@@ -32,8 +32,14 @@ &pcie0 {
 	      <0x4 0x90028000 0x0 0x8000>,     /* port 0 */
 	      <0x4 0x97020000 0x0 0x4000>,     /* port 0 PHY glue */
 	      <0x4 0x92028000 0x0 0x8000>,     /* port 2 */
-	      <0x4 0x97028000 0x0 0x4000>;     /* port 2 PHY glue */
-	reg-names = "config", "rc", "port0", "phy0", "port2", "phy2";
+	      <0x4 0x97028000 0x0 0x4000>,     /* port 2 PHY glue */
+	      <0x4 0x96000000 0x0 0x1000000>,
+	      <0x4 0x95046200 0x0 0x4000>,
+	      <0x4 0x95044000 0x0 0x4000>,
+	      <0x4 0x97000000 0x0 0x40000>,
+	      <0x4 0x97040000 0x0 0x20000>;
+	reg-names = "config", "rc", "port0", "phy0", "port2", "phy2",
+		    "axi2af", "cio3pll", "clkgen", "phy-block", "phy-ip";
 
 	/* One per port, in port order; port 1 is unused. */
 	interrupts = <AIC_IRQ 1231 IRQ_TYPE_LEVEL_HIGH>,
-- 
2.43.0

