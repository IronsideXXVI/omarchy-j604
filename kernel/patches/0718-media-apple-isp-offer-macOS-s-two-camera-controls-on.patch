From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 15:21:28 +0000
Subject: [PATCH] media: apple: isp: offer macOS's two camera controls
 on T8132

Before the preview stream, macOS sends this camera two CAMERA_CONTROL
(0x0141) settings: control 3 at 1 and control 4 at 0. The firmware does
not name the controls, and the driver sends neither.

Add macos_camera_control to send the pair before the preview stream, so
a dark-room test can tell whether they bear on the camera's low-light
magenta cast. It is off by default.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-cam.c | 26 ++++++++++++++++++++++
 drivers/media/platform/apple/isp/isp-cmd.h |  1 +
 2 files changed, 27 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 609bcbe2cd..2acf313655 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -1349,6 +1349,31 @@ static void isp_ch_macos_fep_thumb(struct apple_isp *isp, u32 ch)
 			      err);
 }
 
+/*
+ * Before the preview stream, macOS sends this camera two CAMERA_CONTROL
+ * (0x0141) settings, control 3 at 1 and control 4 at 0. The firmware does
+ * not name the controls; macos_camera_control sends the pair for tests
+ * (default: off).
+ */
+static bool macos_camera_control;
+module_param(macos_camera_control, bool, 0644);
+MODULE_PARM_DESC(macos_camera_control,
+		 "Send the two camera controls macOS sends this camera (default: off)");
+
+static void isp_ch_macos_camera_control(struct apple_isp *isp, u32 ch)
+{
+	int err;
+
+	if (!READ_ONCE(macos_camera_control) ||
+	    !isp->hw->macos_session_settings)
+		return;
+	err = isp_ch_u32x2_set(isp, CISP_CMD_CH_CAMERA_CONTROL, ch, 3, 1);
+	if (!err)
+		err = isp_ch_u32x2_set(isp, CISP_CMD_CH_CAMERA_CONTROL, ch, 4, 0);
+	if (err)
+		dev_warn_once(isp->dev, "camera control refused: %d\n", err);
+}
+
 /*
  * A floor on the auto exposure gain (1/256 steps, as AE_GAIN_CAP_SET), for
  * tests: with it a lit scene is taken at the sensor gain of a dark room,
@@ -1867,6 +1892,7 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	}
 
 	isp_ch_macos_fep_thumb(isp, ch);
+	isp_ch_macos_camera_control(isp, ch);
 
 	err = isp_cmd_ch_preview_stream_set(isp, ch, 1);
 	if (err)
diff --git a/drivers/media/platform/apple/isp/isp-cmd.h b/drivers/media/platform/apple/isp/isp-cmd.h
index c21172c654..901a8133e5 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.h
+++ b/drivers/media/platform/apple/isp/isp-cmd.h
@@ -43,6 +43,7 @@
 #define CISP_CMD_CH_CAMERA_MIPI_FREQUENCY_TOTAL_GET	     0x0133
 #define CISP_CMD_CH_MASTER_SLAVE_SYNC_MODE_SET		     0x0138
 #define CISP_CMD_CH_SBS_ENABLE				     0x013b
+#define CISP_CMD_CH_CAMERA_CONTROL			     0x0141
 #define CISP_CMD_CH_LSC_POLYNOMIAL_COEFF_GET		     0x0142
 #define CISP_CMD_CH_SET_META_DATA_REQUIRED		     0x014f
 #define CISP_CMD_CH_BUFFER_POOL_RETURN			     0x015b
-- 
2.43.0

