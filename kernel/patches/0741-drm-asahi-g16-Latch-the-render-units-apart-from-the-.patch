From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 15:46:16 +0000
Subject: [PATCH] drm/asahi: g16: Latch the render units apart from the
 resident depth

macOS keeps about 18 render commands queued in the M4 firmware ring at
depth 64 (29 at most) in a hypervisor trace; this driver keeps at most
g16_resident, 8 by default, one per render unit. The units every VM
allocates are latched from g16_resident at the first GPU use, and a
later g16_resident only lowers the depth, so comparing depths needs a
boot per depth.

Add g16_resident_units (default 0: follow g16_resident, as before),
read once at that latch. With 16 units latched and g16_resident left at
8, one boot can run depth 8 and depth 16 by changing g16_resident at
runtime. Units stay bounded by the client aperture (18 with compact
units); each costs about 51 MiB per VM that renders.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/params.rs | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 6c677db5ee..8cb869a85f 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -1395,7 +1395,10 @@ fn resident_latch() -> u32 {
     if l != 0 {
         return l;
     }
-    let v = RESIDENT.load(Ordering::Relaxed);
+    let v = match RESIDENT_UNITS.load(Ordering::Relaxed) {
+        0 => RESIDENT.load(Ordering::Relaxed),
+        u => u,
+    };
     let compact = RESIDENT_COMPACT.load(Ordering::Relaxed) != 0;
     let max = if compact {
         hw::sizes::RENDER_UNITS
@@ -1408,6 +1411,18 @@ fn resident_latch() -> u32 {
     RESIDENT_LATCH.load(Ordering::Acquire)
 }
 
+/// Storage of `g16_resident_units` (0644, default 0; read once, at the latch).
+static RESIDENT_UNITS: AtomicU32 = AtomicU32::new(0);
+
+live_u32_param!(
+    RESIDENT_UNITS_PARAM,
+    RESIDENT_UNITS_PARMTYPE,
+    RESIDENT_UNITS_PARM,
+    RESIDENT_UNITS,
+    "g16_resident_units",
+    "G16: render units every VM allocates, latched at the first GPU use (default 0: follow g16_resident; 3..18 with compact units, ~51 MiB each per VM that renders). With more units than g16_resident, g16_resident can be raised at runtime up to them; set at module load"
+);
+
 /// Storage of `g16_resident_compact` (0644, default 1; read with `g16_resident` at the latch).
 static RESIDENT_COMPACT: AtomicU32 = AtomicU32::new(1);
 
-- 
