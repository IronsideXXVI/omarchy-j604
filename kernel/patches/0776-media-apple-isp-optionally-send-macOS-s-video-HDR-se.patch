From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 07:05:47 +0000
Subject: [PATCH] media: apple: isp: optionally send macOS's video HDR
 settings

Right after its highlight recovery setup, macOS sends this camera
VHDR_DOVI_METADATA_ENABLE and VHDR_ENABLE, each with the channel and a
0, in every session. The driver sends neither, so the camera runs with
the firmware's own video HDR default, which is not known. How the dark
end of the picture is handled may depend on it, and the cause of the
camera's low-light colour cast is not found yet.

Add macos_vhdr (default off), which sends the two commands as macOS
does, right after the highlight recovery setup, for a side by side test.

Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-cam.c | 28 ++++++++++++++++++++++
 drivers/media/platform/apple/isp/isp-cmd.h |  2 ++
 2 files changed, 30 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 5dc51e015d..bd43dc571c 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -1392,6 +1392,33 @@ static void isp_ch_macos_hr(struct apple_isp *isp, u32 ch)
 		dev_warn_once(isp->dev, "highlight recovery refused: %d\n", err);
 }
 
+/*
+ * Right after its highlight recovery setup, macOS sends this camera
+ * VHDR_DOVI_METADATA_ENABLE (0x1007) and VHDR_ENABLE (0x1006), each with
+ * the channel and a 0, every session. The driver leaves video HDR at the
+ * firmware's default, which is not known; how the dark end of the picture is
+ * handled may depend on it (the low-light colour cast), so macos_vhdr sends
+ * macOS's two commands as they are, for tests (default: off).
+ */
+static bool macos_vhdr;
+module_param(macos_vhdr, bool, 0644);
+MODULE_PARM_DESC(macos_vhdr,
+		 "Send the video HDR settings macOS sends this camera (default: off)");
+
+static void isp_ch_macos_vhdr(struct apple_isp *isp, u32 ch)
+{
+	int err;
+
+	if (!READ_ONCE(macos_vhdr) || !isp->hw->macos_session_settings)
+		return;
+	err = isp_cmd_ch_u32_set(isp, CISP_CMD_CH_VHDR_DOVI_METADATA_ENABLE, ch,
+				 0);
+	if (!err)
+		err = isp_cmd_ch_u32_set(isp, CISP_CMD_CH_VHDR_ENABLE, ch, 0);
+	if (err)
+		dev_warn_once(isp->dev, "video HDR setting refused: %d\n", err);
+}
+
 /*
  * Right after the local raw buffers, macOS also enables the ISP-local raw
  * buffers of the front end's thumbnail (LOCAL_FEP_THUMBNAIL_RAW_BUFFER_ENABLE,
@@ -2197,6 +2224,7 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	isp_ch_ae_gain_min(isp, ch);
 	isp_ch_desk_view(isp, ch);
 	isp_ch_macos_hr(isp, ch);
+	isp_ch_macos_vhdr(isp, ch);
 	isp_ch_macos_stream_config(isp, ch);
 
 	isp_ch_macos_knobs_done(isp, ch);
diff --git a/drivers/media/platform/apple/isp/isp-cmd.h b/drivers/media/platform/apple/isp/isp-cmd.h
index c3b8b016f6..bebd34491b 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.h
+++ b/drivers/media/platform/apple/isp/isp-cmd.h
@@ -120,6 +120,8 @@
 #define CISP_CMD_CH_AE_CONTROL_BODY_DETECTION		     0x0249
 #define CISP_CMD_CH_BODY_DETECTION_CONTROL		     0x5006
 #define CISP_CMD_CH_HR_ENABLE				     0x1005
+#define CISP_CMD_CH_VHDR_ENABLE				     0x1006
+#define CISP_CMD_CH_VHDR_DOVI_METADATA_ENABLE		     0x1007
 #define CISP_CMD_CH_SIFR_SKIP_INTERVAL_SET		     0x1008
 #define CISP_CMD_CH_LTM_MODE_SET			     0x2004
 #define CISP_CMD_CH_LTM_GAMMA_SET			     0x200a
-- 
2.43.0

