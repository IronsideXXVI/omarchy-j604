         firmware.engine.shared = Some(self.clone());
         firmware.engine.debugfs = Some(file);
         let objects = firmware.init.fwpower_objects();
+        let dump = firmware.init.take_dump()?;
         let mut rings = KVec::with_capacity(firmware.channels.submit.len() + 1, GFP_KERNEL)?;
         for ring in firmware.channels.submit.iter() {
             rings.push(ring.state.clone(), GFP_KERNEL)?;
@@ -661,6 +662,13 @@ pub(crate) fn start_engine(self: &Arc<Self>) -> Result {
             )?;
             *self.fwpower.lock() = Some(file);
         }
+        if let Some(view) = dump {
+            let file = KBox::pin_init(
+                dir.read_callback_file(c_str!("initdata"), view, &super::initdata::dump_show),
+                GFP_KERNEL,
+            )?;
+            *self.initdump.lock() = Some(file);
+        }
         Ok(())
     }
