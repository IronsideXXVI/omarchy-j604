+        dev_info!(
+            dev,
+            "M4 initdata: g16_init_dump=1: images kept for aurora-g16/initdata\n"
+        );
+        Some(images)
+    } else {
+        None
+    };
 
     dev_info!(
         dev,
@@ -342,6 +457,7 @@ pub(crate) fn build(
             idle_power_off_changes: 0,
             loader,
             _graph: graph,
+            encoded,
         },
         channels,
         max_khz,
