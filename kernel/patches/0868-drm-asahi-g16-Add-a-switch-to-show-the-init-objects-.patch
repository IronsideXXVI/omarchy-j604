 }
 
+/// The `aurora-g16/initdata` file (`g16_init_dump`): the 31 init objects, read only.
+pub(crate) struct InitDump {
+    objects: KVec<Arc<FwObject>>,
+    encoded: KVec<KVVec<u8>>,
+}
+
+/// Inventory names, in [`id`] order.
+const NAMES: [&str; wire::OBJECT_COUNT] = [
+    "root",
+    "brn",
+    "runtime",
+    "globals",
+    "control",
+    "firmware_data",
+    "power",
+    "dynamic",
+    "main",
+    "power_performance",
+    "timer",
+    "activity_tiler",
+    "activity_fragment",
+    "activity_compute",
+    "activity_recovery",
+    "log_state",
+    "log_entries",
+    "log_data",
+    "fwctl",
+    "devctrl_state",
+    "devctrl_ring",
+    "ktrace_state",
+    "ktrace_data",
+    "statistics_state",
+    "statistics_data",
+    "temperature",
+    "event_state",
+    "event_data",
+    "retention",
+    "uma",
+    "parameter",
+];
+
+/// Objects above this size (the log entries and data) print their header line only.
+const DUMP_MAX: usize = 0x10000;
+
+/// One `obj` line per object (id, name, GPU VA, size), then its non-zero 32-byte rows: `e`
+/// rows are the encoder's image (what the host wrote, before the firmware started), `l` rows
+/// the live bytes at the read. A row left out is all zero. Nothing is written.
+pub(crate) fn dump_show(v: &InitDump, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+    writeln!(
+        f,
+        "initdata: {} objects, e = encoded, l = live",
+        v.objects.len()
+    )?;
+    for (i, object) in v.objects.iter().enumerate() {
+        let size = wire::OBJECT_SIZE[i];
+        writeln!(
+            f,
+            "obj {} {} va {:#x} size {:#x}",
+            i, NAMES[i], object.va, size
+        )?;
+        if size > DUMP_MAX {
+            continue;
+        }
+        let encoded = v.encoded.get(i);
+        for at in (0..size).step_by(32) {
+            let n = core::cmp::min(32, size - at);
+            let mut live = [0u8; 32];
+            let live = match object.read(at, &mut live[..n]) {
+                Ok(()) => Some(&live[..n]),
+                Err(_) => None,
+            };
+            let image = encoded.and_then(|e| e.get(at..at + n));
+            for (tag, row) in [("e", image), ("l", live)] {
+                let Some(row) = row else { continue };
+                if row.iter().all(|&b| b == 0) {
+                    continue;
+                }
+                write!(f, "{} {} +{:#06x}:", tag, i, at)?;
+                for b in row {
+                    write!(f, " {:02x}", b)?;
+                }
+                writeln!(f)?;
+            }
+        }
+    }
+    Ok(())
+}
+
 fn pair(graph: &[Arc<FwObject>], state: usize, ring: usize) -> Ring {
     Ring {
         state: graph[state].clone(),
@@ -316,6 +422,15 @@ pub(crate) fn build(
     for i in 0..wire::OBJECT_COUNT {
         graph[i].write(0, &images[i])?;
     }
