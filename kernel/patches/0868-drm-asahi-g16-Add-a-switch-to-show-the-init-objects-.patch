+/// `g16_init_dump` (load time): keep the encoder's images of the 31 init objects (the host's
+/// own bytes, before the firmware starts) and serve them with the live bytes, read only, in
+/// debugfs `aurora-g16/initdata`, for a byte compare with the macOS bundle. 0 (the default):
+/// nothing is kept and the file does not exist.
+pub(crate) fn init_dump() -> bool {
+    module_parameters::g16_init_dump.value() != 0
+}
+
 /// Enabled GPU cores, from the identity read at power-up (0 before it).
 static CORES: AtomicU32 = AtomicU32::new(0);
 
