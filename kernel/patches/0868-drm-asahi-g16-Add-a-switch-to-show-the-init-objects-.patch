+    /// The `aurora-g16/initdata` view (`g16_init_dump`): every inventory object with its encoded
+    /// image. `None` when the switch is off or the view was already taken.
+    pub(crate) fn take_dump(&mut self) -> Result<Option<InitDump>> {
+        let Some(encoded) = self.encoded.take() else {
