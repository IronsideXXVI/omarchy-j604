From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 13:06:33 +0000
Subject: [PATCH] drm/asahi: g16: Remove the FS completion event switch

g16_fs_event0 wrote 0 as the FS completion block's producing event. Set
on a running device, it stopped render work within the first sixteen
renders: the firmware posted a recovery, the driver fail-stopped, and
every client lost its device until reboot. Writing the switch back to 0
did not recover it.

Remove the switch so the block always names event 0x71 and nobody can
wedge the GPU by setting it.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/engine.rs |  5 -----
 drivers/gpu/drm/asahi/g16/params.rs | 19 -------------------
 2 files changed, 24 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 0886148bad..bdbc6ccb85 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -1768,11 +1768,6 @@ fn prefix_render(
                 v.get_mut(at..at + 4).ok_or(EINVAL)?.fill(0);
             }
         }
-        // g16_fs_event0: the FS completion block names no producing event (+0x14 = 0, the
-        // value macOS's completion blocks carry). No barrier of ours waits on FS event 0x71.
-        if params::fs_event0() {
-            scratch.fs.get_mut(0xbc0 + 0x14..0xbc0 + 0x18).ok_or(EINVAL)?.fill(0);
-        }
         encode::render_attachments(&mut scratch.tas[..], 0, &cmd.vertex_attachments);
         encode::render_attachments(&mut scratch.fss[..], 1, &cmd.fragment_attachments);
         params::render_patch_apply(&mut scratch.tas[..], &mut scratch.fss[..]);
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index f20f2f4ea3..82e91c1fa8 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -855,25 +855,6 @@ pub(crate) fn first_kick_idle() -> bool {
     "G16: ask for the per-pass host notification (+0x1c of the TA/FS completion blocks) only for a render published with nothing in flight, as G17 does (default 0: every render; 1: idle only; runtime 0644)"
 );
 
-/// Storage of `g16_fs_event0` (runtime 0644, default 0).
-static FS_EVENT0: AtomicU32 = AtomicU32::new(0);
-
-/// Whether the FS completion block's producing event (+0x14, 0x71 by default) is written as 0,
-/// the value macOS's render completion blocks carry. Only the FS block: the FS barrier of each
-/// render waits on the TA event 0x70, and no barrier waits on 0x71.
-pub(crate) fn fs_event0() -> bool {
-    FS_EVENT0.load(Ordering::Relaxed) != 0
-}
-
-live_u32_param!(
-    FS_EVENT0_PARAM,
-    FS_EVENT0_PARMTYPE,
-    FS_EVENT0_PARM,
-    FS_EVENT0,
-    "g16_fs_event0",
-    "G16: write the FS completion block's producing event (+0x14) as 0, as macOS does, instead of 0x71, which no barrier waits on (default 0: 0x71; 1: 0; runtime 0644)"
-);
-
 /// Storage of `g16_pass_check_once` (runtime 0644, default 1).
 static PASS_CHECK_ONCE: AtomicU32 = AtomicU32::new(1);
 
-- 
