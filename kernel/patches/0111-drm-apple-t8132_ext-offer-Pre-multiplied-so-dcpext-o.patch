From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 18:01:33 +0000
Subject: [PATCH] drm/apple: t8132_ext: offer Pre-multiplied so dcpext
 outputs probe

t8132_ext_out_init() gave drm_plane_create_blend_mode_property() only
"None". The core refuses every mask without "Pre-multiplied"
(drm_blend.c: WARN_ON and -EINVAL), so each dcpext output went to
err_plane: the m1n1 1.604 boot shows the drm_blend.c:608 WARN and
"no DRM output: -22" for the dcpext.

Offer "None" and "Pre-multiplied" (T8132_EXT_BLEND_MODES, in the new
apple_blend.h). Scanout stays opaque: nothing in t8132_ext_drm.c reads
pixel_blend_mode, the plane has no alpha property and it is the only
plane of its CRTC, so "Pre-multiplied" over the black background gives
the pixels "None" gives. The state default after reset was already
"Pre-multiplied".

The apple-drm-blend KUnit suite drives the core's own
drm_plane_create_blend_mode_property() with the mask on a KUnit DRM
device and checks the enum list and the default. With the old mask
the suite fails.

Fixes: f55cd5650824 ("drm/apple: sync to Aurora integration/aurora 50d5865ea6 (file-level)")
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/Makefile           |  1 +
 drivers/gpu/drm/apple/apple_blend.h      | 23 ++++++
 drivers/gpu/drm/apple/apple_blend_test.c | 94 ++++++++++++++++++++++++
 drivers/gpu/drm/apple/t8132_ext_drm.c    |  9 ++-
 4 files changed, 125 insertions(+), 2 deletions(-)
 create mode 100644 drivers/gpu/drm/apple/apple_blend.h
 create mode 100644 drivers/gpu/drm/apple/apple_blend_test.c

diff --git a/drivers/gpu/drm/apple/Makefile b/drivers/gpu/drm/apple/Makefile
index 72cb0ee56b..9fa470fcb5 100644
--- a/drivers/gpu/drm/apple/Makefile
+++ b/drivers/gpu/drm/apple/Makefile
@@ -21,6 +21,7 @@ appledrm-y += iomfb_h17p.o
 appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += iomfb_h17p_test.o parser_test.o
 appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += apple_resume_test.o
 appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += apple_boot_display_test.o
+appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += apple_blend_test.o
 appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += dcp-syslog-test.o
 appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += parser_mode_test.o
 appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += dcp_external_resume_test.o
diff --git a/drivers/gpu/drm/apple/apple_blend.h b/drivers/gpu/drm/apple/apple_blend.h
new file mode 100644
index 0000000000..fcfd93d99a
--- /dev/null
+++ b/drivers/gpu/drm/apple/apple_blend.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Blend modes the Apple display planes offer.
+ *
+ * drm_plane_create_blend_mode_property() refuses, with a WARN and -EINVAL,
+ * any mask that lacks "Pre-multiplied": the core makes it the default of
+ * every plane state. A plane that cannot honour it offers no property.
+ */
+#ifndef __APPLE_BLEND_H__
+#define __APPLE_BLEND_H__
+
+#include <linux/bits.h>
+#include <drm/drm_blend.h>
+
+/*
+ * T8132 dcpext: one bottom plane whose frames go out opaque. Nothing reads
+ * the mode, and with no plane alpha "Pre-multiplied" over the black
+ * background gives the same pixels as "None".
+ */
+#define T8132_EXT_BLEND_MODES \
+	(BIT(DRM_MODE_BLEND_PIXEL_NONE) | BIT(DRM_MODE_BLEND_PREMULTI))
+
+#endif /* __APPLE_BLEND_H__ */
diff --git a/drivers/gpu/drm/apple/apple_blend_test.c b/drivers/gpu/drm/apple/apple_blend_test.c
new file mode 100644
index 0000000000..96ab3b821e
--- /dev/null
+++ b/drivers/gpu/drm/apple/apple_blend_test.c
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * KUnit tests for the blend modes the Apple display planes offer
+ * (apple_blend.h). Each mask goes through the DRM core's own
+ * drm_plane_create_blend_mode_property() on a KUnit DRM device. No hardware.
+ */
+#include <kunit/test.h>
+#include <linux/bits.h>
+#include <linux/list.h>
+#include <linux/module.h>
+
+#include <drm/drm_blend.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_kunit_helpers.h>
+#include <drm/drm_mode_object.h>
+#include <drm/drm_plane.h>
+#include <drm/drm_property.h>
+
+#include "apple_blend.h"
+
+struct blend_test {
+	struct drm_device drm;
+};
+
+static struct drm_plane *blend_test_plane(struct kunit *test)
+{
+	struct blend_test *priv;
+	struct drm_plane *plane;
+	struct device *dev;
+
+	dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	priv = drm_kunit_helper_alloc_drm_device(test, dev, struct blend_test,
+						 drm,
+						 DRIVER_MODESET | DRIVER_ATOMIC);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, priv);
+	plane = drm_kunit_helper_create_primary_plane(test, &priv->drm, NULL,
+						      NULL, NULL, 0, NULL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, plane);
+	return plane;
+}
+
+/*
+ * Create the property for @modes and check what the core attached: it lists
+ * exactly @modes and defaults to "Pre-multiplied".
+ */
+static void expect_blend_property(struct kunit *test, unsigned int modes)
+{
+	struct drm_plane *plane = blend_test_plane(test);
+	struct drm_property_enum *e;
+	struct drm_property *prop;
+	unsigned int seen = 0;
+	u64 val = ~0ULL;
+
+	KUNIT_ASSERT_EQ(test,
+			drm_plane_create_blend_mode_property(plane, modes), 0);
+	prop = plane->blend_mode_property;
+	KUNIT_ASSERT_NOT_NULL(test, prop);
+	list_for_each_entry(e, &prop->enum_list, head)
+		seen |= BIT(e->value);
+	KUNIT_EXPECT_EQ(test, seen, modes);
+	KUNIT_EXPECT_EQ(test,
+			drm_object_property_get_default_value(&plane->base,
+							      prop, &val), 0);
+	KUNIT_EXPECT_EQ(test, val, (u64)DRM_MODE_BLEND_PREMULTI);
+}
+
+/* A dcpext output probes: its blend property is accepted by the core. */
+static void blend_t8132_ext_accepted(struct kunit *test)
+{
+	expect_blend_property(test, T8132_EXT_BLEND_MODES);
+}
+
+/* ...and still offers "None", the mode its scanout actually has. */
+static void blend_t8132_ext_offers_none(struct kunit *test)
+{
+	KUNIT_EXPECT_TRUE(test, T8132_EXT_BLEND_MODES &
+				BIT(DRM_MODE_BLEND_PIXEL_NONE));
+	KUNIT_EXPECT_FALSE(test, T8132_EXT_BLEND_MODES &
+				 BIT(DRM_MODE_BLEND_COVERAGE));
+}
+
+static struct kunit_case blend_cases[] = {
+	KUNIT_CASE(blend_t8132_ext_accepted),
+	KUNIT_CASE(blend_t8132_ext_offers_none),
+	{}
+};
+
+static struct kunit_suite blend_suite = {
+	.name = "apple-drm-blend",
+	.test_cases = blend_cases,
+};
+
+kunit_test_suite(blend_suite);
diff --git a/drivers/gpu/drm/apple/t8132_ext_drm.c b/drivers/gpu/drm/apple/t8132_ext_drm.c
index 7bece4989a..d190e23eef 100644
--- a/drivers/gpu/drm/apple/t8132_ext_drm.c
+++ b/drivers/gpu/drm/apple/t8132_ext_drm.c
@@ -48,6 +48,7 @@
 #include <drm/drm_simple_kms_helper.h>
 #include <drm/drm_vblank.h>
 
+#include "apple_blend.h"
 #include "iomfb_m4.h"
 #include "t8132_ext_drm.h"
 
@@ -1037,10 +1038,14 @@ static int t8132_ext_out_init(struct drm_device *drm, struct platform_device *pd
 	drm_plane_enable_fb_damage_clips(&out->plane);
 	/* Every plane of the device has a zpos, or none may: the panel's do. */
 	ret = drm_plane_create_zpos_immutable_property(&out->plane, 0);
-	/* Frames go out opaque, ARGB8888 ones too. */
+	/*
+	 * Frames go out opaque, ARGB8888 ones too. The core will not take
+	 * "None" alone: T8132_EXT_BLEND_MODES adds "Pre-multiplied", which
+	 * gives the same pixels on this plane (apple_blend.h).
+	 */
 	if (!ret)
 		ret = drm_plane_create_blend_mode_property(&out->plane,
-							   BIT(DRM_MODE_BLEND_PIXEL_NONE));
+							   T8132_EXT_BLEND_MODES);
 	if (ret)
 		goto err_plane;
 	ret = drm_crtc_init_with_planes(drm, &out->crtc, &out->plane, NULL,
