From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sun, 1 Nov 2026 10:26:47 +1100
Subject: [PATCH] soc: apple: aop: Write the T6040 firmware's own nCal boot
 argument

The AOP core writes nCal 0 into the firmware's boot arguments on every
SoC whose arguments it patches. The T6040 firmware's own default for it,
in the boot argument table it ships with, is 1. With 0, its
accelerometer and gyroscope services accept the calibration and the
report interval, and the sensor starts sampling, but no report ever
reaches the application processor, so both IIO devices read ENODATA.

Make nCal part of the per-SoC data and write the firmware's default, 1,
on the T6040. The other SoCs keep 0. The T6040 comment claimed macOS
writes the same arguments as on the T6020; that is not established for
nCal, so drop it. Note the symptom in the AOP sensor documentation.

On J616s (7.3.0-aurora-tt3), both devices report with this change.
The accelerometer at rest reads |a| = 9.64 m/s^2 (291 samples, 9.62
to 9.65), and the gyroscope shows a static bias of about 0.4 deg/s.
ALS, lid angle, the three DCPs and the audio cards are unchanged, and
the boot logs no errors.

Fixes: e82a608ad0b0 ("soc: apple: aop: Add T6040 support")
Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit 28174f88bdc408527712e9625392d19582ba16e1)
[dylan: Dropped the Documentation/iio/aop-sensors.rst hunk. That file
 comes with the AOP accelerometer/gyroscope driver (d2da58eb2), which is
 not part of this tree. The aop.rs nCal change is taken unchanged.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/aop.rs | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/drivers/soc/apple/aop.rs b/drivers/soc/apple/aop.rs
index 992cc0902f..0f455a9530 100644
--- a/drivers/soc/apple/aop.rs
+++ b/drivers/soc/apple/aop.rs
@@ -2502,6 +2502,8 @@ struct AopDriver(Arc<dyn AOP>);
 
 struct AopHwConfig {
     ec0p: u64,
+    /// The `nCal` boot argument.
+    ncal: u64,
     alig: u64,
     aopt: u64,
     /// Complete the firmware's boot arguments before starting it.
@@ -2525,6 +2527,7 @@ struct AopHwConfig {
 
 const HW_CFG_T8103: AopHwConfig = AopHwConfig {
     ec0p: 0x020000,
+    ncal: 0,
     aopt: 1,
     alig: 128,
     patch_bootargs: true,
@@ -2537,6 +2540,7 @@ const HW_CFG_T8103: AopHwConfig = AopHwConfig {
 };
 const HW_CFG_T8112: AopHwConfig = AopHwConfig {
     ec0p: 0x020000,
+    ncal: 0,
     aopt: 0,
     alig: 128,
     patch_bootargs: true,
@@ -2549,6 +2553,7 @@ const HW_CFG_T8112: AopHwConfig = AopHwConfig {
 };
 const HW_CFG_T6000: AopHwConfig = AopHwConfig {
     ec0p: 0x020000,
+    ncal: 0,
     aopt: 0,
     alig: 64,
     patch_bootargs: true,
@@ -2561,6 +2566,7 @@ const HW_CFG_T6000: AopHwConfig = AopHwConfig {
 };
 const HW_CFG_T6020: AopHwConfig = AopHwConfig {
     ec0p: 0x0100_00000000,
+    ncal: 0,
     aopt: 0,
     alig: 64,
     patch_bootargs: true,
@@ -2571,12 +2577,14 @@ const HW_CFG_T6020: AopHwConfig = AopHwConfig {
     fw_regions: false,
     halt_on_failed_start: false,
 };
-/// T6040 (J616s): macOS writes the same four boot arguments as for the
-/// T6020. The firmware's external code and log live in DRAM, mapped through
-/// the reserved regions the bootloader describes; the RTKit firmware is shut
-/// down on unbind.
+/// T6040 (J616s): the firmware's external code and log live in DRAM, mapped
+/// through the reserved regions the bootloader describes; the RTKit firmware
+/// is shut down on unbind. `nCal` keeps the firmware's own default of 1:
+/// with 0 the accelerometer and gyroscope services accept their calibration
+/// and report interval but never send a report.
 const HW_CFG_T6040: AopHwConfig = AopHwConfig {
     ec0p: 0x0100_00000000,
+    ncal: 1,
     aopt: 0,
     alig: 64,
     patch_bootargs: true,
@@ -2594,6 +2602,7 @@ const HW_CFG_T6040: AopHwConfig = AopHwConfig {
 /// are started if they will.
 const HW_CFG_T8140: AopHwConfig = AopHwConfig {
     ec0p: 0,
+    ncal: 0,
     aopt: 0,
     alig: 0,
     patch_bootargs: false,
@@ -2658,7 +2667,7 @@ impl platform::Driver for AopDriver {
                 &aop_mmio,
                 &[
                     (from_fourcc(b"EC0p"), cfg.ec0p),
-                    (from_fourcc(b"nCal"), 0x0),
+                    (from_fourcc(b"nCal"), cfg.ncal),
                     (from_fourcc(b"alig"), cfg.alig),
                     (from_fourcc(b"AOPt"), cfg.aopt),
                 ],
