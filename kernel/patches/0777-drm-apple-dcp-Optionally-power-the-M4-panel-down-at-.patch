From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 07:27:47 +0000
Subject: [PATCH] drm/apple: dcp: Optionally power the M4 panel down at
 shutdown

On the T8132 internal display, the platform shutdown hook only quiesces
the host side: the firmware is left running with whatever the session
last asked of it, and the panel stays in that state across the reset.
On the older parts, component removal runs the DRM shutdown (a CRTC
disable) and iomfb_shutdown(), which ask the firmware to power the
display down first.

Add shutdown_display_off (default off). When set, shutdown runs the
calls a DPMS off already makes, before the quiesce: the blank swap
(A406, its own fixed 5 s deadline), then setPowerState(0) (A473) with
a fixed 1 s deadline. The lock is tried for 1 s at most. A refusal or
timeout is logged and the shutdown goes on, so a reboot never waits on
the firmware for more than about 7 s. An already blanked or powered
down display is left alone.

Assisted-by: LLM
---
 drivers/gpu/drm/apple/dcp.c      |  3 ++
 drivers/gpu/drm/apple/iomfb_m4.c | 87 ++++++++++++++++++++++++++++++++
 drivers/gpu/drm/apple/iomfb_m4.h |  3 ++
 3 files changed, 93 insertions(+)

diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 9f76c70d49..c095e73620 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -7564,6 +7564,9 @@ VISIBLE_IF_KUNIT void dcp_platform_shutdown(struct platform_device *pdev)
 	if (dcp && iomfb_is_m4(dcp)) {
 		dcp_t8132_idle_stop(dcp);
 		dcp_t8132_idle_wake(dcp);
+		/* Before the quiesce, which stops every call to the firmware. */
+		if (!dcp->external)
+			iomfb_m4_shutdown_off(dcp);
 		dcp_comp_unbind(&pdev->dev, NULL, NULL);
 		return;
 	}
diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index 10b89486c0..417a17d6d3 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -343,6 +343,14 @@ module_param(quarantine_recover, uint, 0644);
 MODULE_PARM_DESC(quarantine_recover,
 		 "Internal display: bring a quarantined session back without a reboot, from a worker after the failure and before a system sleep (0: never; 1: only when it failed with the coprocessor powered down, the firmware untouched; 2: also try the normal power-down first when it failed running with the display off; default 0; experimental)");
 
+static bool shutdown_display_off;
+module_param(shutdown_display_off, bool, 0644);
+MODULE_PARM_DESC(shutdown_display_off,
+		 "Internal display: at shutdown and reboot, blank and power the panel down as a DPMS off does (A406 blank swap, then A473 off) before the host side is quiesced; each wait is bounded and a refusal or timeout only logs (default N; experimental)");
+
+/* The longest a shutdown waits for the lock, and for the power-down call. */
+#define DCP_M4_SHUTDOWN_MS	1000
+
 /*
  * DCP CPU control and status, in the coprocessor's ASC block. The idle bit
  * is dcp.c's APPLE_DCP_COPROC_CPU_STATUS_IDLE; macOS read status 0x6e at
@@ -8988,6 +8996,85 @@ int iomfb_m4_suspend(struct apple_dcp *owner)
 	return ret;
 }
 
+/*
+ * At shutdown and reboot, with shutdown_display_off set: blank and power the
+ * panel down as iomfb_m4_blank() does for a DPMS off, so the next loader's
+ * display init finds it off rather than in whatever state the session left.
+ * Never blocks the reboot: the lock is tried for DCP_M4_SHUTDOWN_MS, the
+ * blank swap (A406) keeps its own fixed 5 s deadline and the power-down
+ * (A473) gets a fixed DCP_M4_SHUTDOWN_MS one; any failure only logs.
+ */
+int iomfb_m4_shutdown_off(struct apple_dcp *owner)
+{
+	struct iomfb_m4 *dcp = owner->v26_6;
+	struct drm_framebuffer *retire = NULL, *retire_lost = NULL, *retire_extra = NULL;
+	unsigned long end = jiffies + msecs_to_jiffies(DCP_M4_SHUTDOWN_MS);
+	ktime_t start = ktime_get();
+	const char *step = "lock";
+	struct dcp_m4_runtime *r;
+	int ret = 0;
+
+	if (!READ_ONCE(shutdown_display_off))
+		return 0;
+	if (!dcp || dcp->external || !dcp->runtime)
+		return -ENODEV;
+	r = dcp->runtime;
+	while (!mutex_trylock(&dcp->lock)) {
+		if (time_after_eq(jiffies, end)) {
+			ret = -EBUSY;
+			goto out;
+		}
+		usleep_range(1000, 2000);
+	}
+	step = "check";
+	ret = dcp_m4_runtime_live(r);
+	/* Powered down already, or blanked and off: nothing to do. */
+	if (!ret && (dcp->gated || (dcp->display_off && !dcp->active_frame.dva)))
+		goto unlock;
+	/* A call of our own still open: a new one would nest in it. */
+	if (!ret && (r->deadline || dcp->transaction.calls))
+		ret = -EBUSY;
+	if (!ret) {
+		step = "blank";
+		ret = iomfb_m4_swap(dcp, NULL);
+	}
+	if (!ret) {
+		retire = dcp->active_fb;
+		retire_lost = dcp->lost_fb;
+		retire_extra = dcp->extra_fb;
+		dcp->active_fb = NULL;
+		dcp->lost_fb = NULL;
+		dcp->extra_fb = NULL;
+		dcp->active_unshown = false;
+		memset(&dcp->active_frame, 0, sizeof(dcp->active_frame));
+	}
+	if (!ret && !dcp->display_off) {
+		step = "power-down";
+		/* A fixed deadline: no firmware message extends it. */
+		r->deadline = jiffies + msecs_to_jiffies(DCP_M4_SHUTDOWN_MS);
+		ret = dcp_m4_set_power_state(dcp, false);
+		r->deadline = 0;
+		if (!ret)
+			dcp->display_off = true;
+	}
+unlock:
+	mutex_unlock(&dcp->lock);
+	if (retire)
+		drm_framebuffer_put(retire);
+	if (retire_lost)
+		drm_framebuffer_put(retire_lost);
+	if (retire_extra)
+		drm_framebuffer_put(retire_extra);
+out:
+	if (ret)
+		dev_warn(dcp->dev, "shutdown display off: %s failed (%d) after %lld us; going on\n",
+			 step, ret, ktime_us_delta(ktime_get(), start));
+	else
+		dev_info(dcp->dev, "shutdown display off: done in %lld us\n",
+			 ktime_us_delta(ktime_get(), start));
+	return ret;
+}
+
 /*
  * An external DCP and a sleep that powers the SoC down: the same checks with
  * its own inputs (dcp_m4_ext_sleep_state()), then its own power-down. What
diff --git a/drivers/gpu/drm/apple/iomfb_m4.h b/drivers/gpu/drm/apple/iomfb_m4.h
index d15c506f67..54b19ad1f3 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.h
+++ b/drivers/gpu/drm/apple/iomfb_m4.h
@@ -123,6 +123,8 @@ int iomfb_m4_present(struct apple_dcp *dcp, struct drm_framebuffer *fb,
 		     dma_addr_t dva, size_t mapped);
 int iomfb_m4_blank(struct apple_dcp *dcp);
 int iomfb_m4_suspend(struct apple_dcp *dcp);
+/* At shutdown: blank and power the panel down if shutdown_display_off, bounded. */
+int iomfb_m4_shutdown_off(struct apple_dcp *dcp);
 /* A sleep that powers the SoC down: 0 once the DCP is down and the PMP armed, else -EBUSY. */
 int iomfb_m4_suspend_firmware(struct apple_dcp *dcp);
 int iomfb_m4_resume(struct apple_dcp *dcp);
@@ -251,6 +253,7 @@ static inline int iomfb_m4_present(struct apple_dcp *dcp, struct drm_framebuffer
 }
 static inline int iomfb_m4_blank(struct apple_dcp *dcp) { return -ENODEV; }
 static inline int iomfb_m4_suspend(struct apple_dcp *dcp) { return -ENODEV; }
+static inline int iomfb_m4_shutdown_off(struct apple_dcp *dcp) { return 0; }
 static inline int iomfb_m4_suspend_firmware(struct apple_dcp *dcp) { return -EBUSY; }
 static inline int iomfb_m4_resume(struct apple_dcp *dcp) { return -ENODEV; }
 static inline void iomfb_m4_configure_backlight(struct apple_dcp *dcp) { }
-- 
