From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 22 Nov 2026 08:53:41 +0000
Subject: [PATCH] drm/asahi: g16: Default g16_render_fs_run to 1

Turn the switch on by default.

---
 drivers/gpu/drm/asahi/g16/params.rs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index aa059d6e55..54ea29b344 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2438,8 +2438,8 @@ pub(crate) fn render_bell_group() -> u32 {
     "G16: k = renders behind k others ring once per k publications (2-16; default 4; 0 = off)"
 );
 
-/// Storage of `g16_render_fs_run` (runtime 0644, default 0).
-static RENDER_FS_RUN: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_render_fs_run` (runtime 0644, default 1).
+static RENDER_FS_RUN: AtomicU32 = AtomicU32::new(1);
 
 /// `g16_render_fs_run`: a render published behind running flights and at least one firmware
 /// run (4 renders) of exposed, unfinished FS work shares one FS-ring Stamp barrier, re-encoded
@@ -2457,7 +2457,7 @@ pub(crate) fn render_fs_run() -> u32 {
     RENDER_FS_RUN_PARM,
     RENDER_FS_RUN,
     "g16_render_fs_run",
-    "G16: one FS barrier, record and doorbell per firmware run of renders behind a run of queued FS work (1 = on, 0 = off)"
+    "G16: one FS barrier, record and doorbell per firmware run of renders behind a run of queued FS work (1 = on, the default; 0 = off)"
 );
 
 /// Storage of `g16_window_poll_us` (runtime 0644, default 0).
-- 
2.43.0

