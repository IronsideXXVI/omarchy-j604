+/// `g16_notifier_cached` (load time, default 0). 1: the render graph's TA and FS notifier
+/// records (the objects the work records name at +0x10 and +0x20) live in their own session
+/// page mapped ASC-cached, the attribute index macOS gives its per-queue objects. The service
+/// stamps the host reads (+0x620, +0x630) and the threshold cells stay in uncached objects.
+/// The firmware cleans and invalidates a record at each stage's prepare and in the scan's
+/// equality branch. The session page is never dropped. Values other than 0 and 1 act as 0: the
+/// split records (2) are not supported on this kernel.
+pub(crate) fn notifier_cached() -> bool {
+    module_parameters::g16_notifier_cached.value() == 1
+}
+
 /// `g16_render_seq_pool` (load time, default 1). 1: at boot two session objects, one uncached
 /// and one ASC-cached, each hold one TA and one FS microsequence slot per render unit, and every
