 impl RenderGraph {
+    /// The object holding the TA (+0) and FS (+0x200) notifier records: the ASC-cached
+    /// `records` with `g16_notifier_cached`, else the notifier page itself.
+    pub(crate) fn record_page(&self) -> &FwObject {
+        match self.records.as_ref() {
+            Some(records) => records,
+            None => &self.notifier,
+        }
+    }
+
