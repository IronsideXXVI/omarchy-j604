From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Sun, 8 Nov 2026 01:36:48 +1100
Subject: [PATCH] soc: apple: aop: Wait for the endpoint map before requesting
 AP power

The setup port requested AP power as soon as RTKit reached AP power on
and warned "endpoint map incomplete before the AP power request" when
the firmware's last endpoint map fragment had not arrived yet. The map
normally completes first; on some boots (about 1 in 8 on the Neo) its
last fragment lands a few milliseconds later, the boot still completes,
and the only effect was a warning in every such boot log.

Wait up to one second for the map to complete before the AP power
request, so the request always follows the map as it does on other
boots, and warn only if the map never completes.

Assisted-by: LLM
Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
(cherry picked from commit fc655ffe1881137defaa714aaa39ca89314ac67c)
---
 drivers/soc/apple/aop.rs | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/apple/aop.rs b/drivers/soc/apple/aop.rs
index 3fe0eacbcd..f7015d7f64 100644
--- a/drivers/soc/apple/aop.rs
+++ b/drivers/soc/apple/aop.rs
@@ -170,6 +170,8 @@ const SETUP_BUFFER_ENTRY_SIZE: usize = 16;
 /// them have theirs.
 const SETUP_ENDPOINTS: [u8; 5] = [0x20, 0x21, 0x23, 0x30, 0x32];
 const SETUP_BOOT_TIMEOUT_MS: u32 = 15000;
+/// How long the AP power request waits for the last endpoint map fragment.
+const SETUP_MAP_TIMEOUT_MS: u32 = 1000;
 // A request to a service endpoint: the payload goes into the endpoint's
 // message page, (3 << 60) | length announces it, the firmware answers with a
 // result word after writing a status byte at the start of the reply window,
@@ -2437,7 +2439,15 @@ impl AopData {
     /// buffers.
     fn setup_finish_boot(&self) -> Result<()> {
         let mut st = self.setup.lock();
-        if !st.map_done {
+        // The firmware sends the endpoint map right after HELLO, normally
+        // before RTKit reaches AP power on, but on some boots its last
+        // fragment arrives a few milliseconds later. Request AP power only
+        // once the map is complete, and warn only if it never completes.
+        if !st.map_done
+            && self
+                .setup_wait(&mut st, SETUP_MAP_TIMEOUT_MS, |s| s.map_done)
+                .is_err()
+        {
             dev_warn!(
                 self.dev,
                 "setup port: endpoint map incomplete before the AP power request"
