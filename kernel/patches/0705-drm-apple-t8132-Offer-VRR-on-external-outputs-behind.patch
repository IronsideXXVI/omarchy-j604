From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 14:29:57 +0000
Subject: [PATCH] drm: apple: t8132: Offer VRR on external outputs
 behind a switch

A T8132 external output (HDMI, or USB-C DP alt mode) never offers VRR.
The external get_modes path never sets vrr_capable, and a commit that
asks for VRR_ENABLED on it is refused. A FreeSync or Adaptive-Sync
monitor therefore runs at a fixed rate under Linux. macOS runs such a
monitor variable.

Add appledrm.t8132_ext_vrr, off by default. With it on:
 - a sink whose EDID gives a refresh range is offered as vrr_capable,
   with the EDID's minimum;
 - VRR_ENABLED is accepted on that output;
 - a change of it is a full mode set, because the external processors
   ignore a new minimum on a live mode and macOS also moves between a
   timing's fixed and variable form with a mode set;
 - after the mode set, the adaptive-sync minimum (IOMFBParameter 14,
   as already sent for the internal panel) is the EDID's minimum while
   VRR is on and the timing's own rate while it is off.

With the switch off, nothing changes: no property write, no call to
the firmware.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/gpu/drm/apple/dcp.c      |  6 ++++
 drivers/gpu/drm/apple/iomfb_m4.c | 56 ++++++++++++++++++++++++++++----
 drivers/gpu/drm/apple/iomfb_m4.h |  2 ++
 3 files changed, 58 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 623a75e038..9f76c70d49 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -1886,6 +1886,12 @@ int dcp_crtc_atomic_check(struct drm_crtc *crtc, struct drm_atomic_commit *commi
 			return -EINVAL;
 		if (!crtc_state->enable)
 			return 0;
+		if (iomfb_m4_ext_vrr_modeset(dcp)) {
+			struct drm_crtc_state *old = drm_atomic_get_old_crtc_state(commit, crtc);
+
+			if (old && old->vrr_enabled != crtc_state->vrr_enabled)
+				crtc_state->mode_changed = true;
+		}
 		if (!(crtc_state->plane_mask & drm_plane_mask(crtc->primary)))
 			return -EINVAL;
 		ret = iomfb_m4_atomic_check_hdr(dcp, crtc, commit);
diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index a6b2497983..8b6b798337 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -439,6 +439,19 @@ module_param(swap_pace_lead_us, uint, 0644);
 MODULE_PARM_DESC(swap_pace_lead_us,
 		 "J604: with swap_pace, the time from starting a swap to the first panel tick it can make, us (default 0 = the shortest start-to-completion time of recent swaps)");
 
+/*
+ * VRR on a T8132 external output (HDMI or USB-C DP alt mode), off by default. With it on, a sink
+ * whose EDID gives a refresh range is offered as vrr_capable, VRR_ENABLED is accepted, a change of
+ * it is a full mode set (the external processors ignore a new minimum on a live mode; macOS also
+ * moves between a timing's fixed and variable form with a mode set), and the adaptive-sync minimum
+ * (A442 IOMFBParameter 14, as for the panel) is the EDID's minimum while VRR is on, the timing's
+ * own rate while it is off. Read at the next EDID publication and the next commit.
+ */
+static bool t8132_ext_vrr;
+module_param(t8132_ext_vrr, bool, 0644);
+MODULE_PARM_DESC(t8132_ext_vrr,
+		 "T8132 external outputs: offer VRR for a sink whose EDID has a refresh range (experimental; default: off)");
+
 static bool panel_adaptive;
 module_param(panel_adaptive, bool, 0644);
 MODULE_PARM_DESC(panel_adaptive,
@@ -4915,10 +4928,20 @@ bool iomfb_m4_panel_vrr_requested(struct apple_dcp *owner)
 	struct iomfb_m4 *dcp = iomfb_is_m4(owner) ? owner->v26_6 : NULL;
 
 	/*
-	 * The internal panel only, when it offered VRR: an external T8132
-	 * output takes no VRR here. A run-time 0 keeps VRR_ENABLED valid.
+	 * The internal panel when it offered VRR; an external T8132 output
+	 * only with t8132_ext_vrr and an EDID range. A run-time 0 keeps
+	 * VRR_ENABLED valid.
 	 */
-	return dcp && !dcp->external && READ_ONCE(dcp->vrr_offered_hz);
+	return dcp && READ_ONCE(dcp->vrr_offered_hz) &&
+	       (!dcp->external || READ_ONCE(t8132_ext_vrr));
+}
+
+/* An external output with VRR offered: a change of VRR_ENABLED needs a mode set. */
+bool iomfb_m4_ext_vrr_modeset(struct apple_dcp *owner)
+{
+	struct iomfb_m4 *dcp = iomfb_is_m4(owner) ? owner->v26_6 : NULL;
+
+	return dcp && dcp->external && READ_ONCE(t8132_ext_vrr) && READ_ONCE(dcp->vrr_offered_hz);
 }
 
 /*
@@ -4936,17 +4959,24 @@ void iomfb_m4_atomic_vrr(struct apple_dcp *owner, bool vrr_enabled)
 	bool adaptive = vrr_enabled || READ_ONCE(panel_adaptive);
 	u32 media, min, fixed;
 
-	if (!dcp || dcp->external || !READ_ONCE(dcp->vrr_offered_hz))
+	if (!dcp || !READ_ONCE(dcp->vrr_offered_hz))
 		return;
+	if (dcp->external) {
+		if (!READ_ONCE(t8132_ext_vrr))
+			return;
+		/* The EDID minimum while VRR is on; no media rate; nothing held while off. */
+		hz = READ_ONCE(dcp->vrr_offered_hz);
+		adaptive = vrr_enabled;
+	}
 	mutex_lock(&dcp->lock);
 	/* The fixed rate is the running timing's: 120 Hz unless panel_fixed_modes. */
 	fixed = dcp->runtime && dcp_m4_live_fixed(dcp->runtime) ?
 		dcp_m4_live_rate(dcp->runtime) : DCP_M4_VRR_FIXED_HZ << 16;
-	media = min_t(u32, READ_ONCE(panel_media_hz) << 16, fixed) & ~0xffffU;
+	media = dcp->external ? 0 : min_t(u32, READ_ONCE(panel_media_hz) << 16, fixed) & ~0xffffU;
 	/* panel_vrr_min_hz written 0 at run time holds the panel at its fixed rate. */
 	min = adaptive && hz && (hz << 16) < fixed ? hz << 16 : fixed;
 	if ((dcp->vrr_min_sent || (adaptive && hz) || media ||
-	     READ_ONCE(panel_hold_fixed)) &&
+	     (!dcp->external && READ_ONCE(panel_hold_fixed))) &&
 	    (min != dcp->vrr_min_sent || media != dcp->vrr_media_sent) &&
 	    dcp->runtime && !dcp->powered_off && !dcp->gated &&
 	    !dcp_m4_set_adaptive_sync(dcp, min, media)) {
@@ -5464,6 +5494,20 @@ int iomfb_m4_ext_get_modes(struct apple_dcp *owner, struct drm_connector *connec
 	dcp_m4_ext_publish_edid(dcp, connector, src, raw, raw_size, meta_ok ? &meta : NULL,
 				preferred ?: fallback);
 	kfree(raw);
+	if (READ_ONCE(t8132_ext_vrr) || READ_ONCE(dcp->vrr_offered_hz)) {
+		/* The EDID's range (filled in by the publication above) makes the offer. */
+		const struct drm_monitor_range_info *r = &connector->display_info.monitor_range;
+		u32 offer = 0;
+
+		if (READ_ONCE(t8132_ext_vrr) && r->min_vfreq && r->max_vfreq > r->min_vfreq)
+			offer = r->min_vfreq;
+
+		if (offer != READ_ONCE(dcp->vrr_offered_hz))
+			dev_info(dcp->dev, "external VRR %s (EDID range %u-%u Hz, t8132_ext_vrr)\n",
+				 offer ? "offered" : "not offered", r->min_vfreq, r->max_vfreq);
+		WRITE_ONCE(dcp->vrr_offered_hz, offer);
+		drm_connector_set_vrr_capable_property(connector, offer);
+	}
 	return added;
 }
 
diff --git a/drivers/gpu/drm/apple/iomfb_m4.h b/drivers/gpu/drm/apple/iomfb_m4.h
index 871375350b..d15c506f67 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.h
+++ b/drivers/gpu/drm/apple/iomfb_m4.h
@@ -75,6 +75,7 @@ bool iomfb_m4_panel_edr_requested(struct apple_dcp *dcp);
 bool iomfb_m4_panel_edr_capable(struct apple_dcp *dcp);
 /* VRR on the internal panel: experiment (appledrm.panel_vrr_min_hz). */
 bool iomfb_m4_panel_vrr_requested(struct apple_dcp *dcp);
+bool iomfb_m4_ext_vrr_modeset(struct apple_dcp *dcp);
 void iomfb_m4_atomic_vrr(struct apple_dcp *dcp, bool vrr_enabled);
 int iomfb_m4_atomic_check_hdr(struct apple_dcp *dcp, struct drm_crtc *crtc,
 			      struct drm_atomic_commit *commit);
@@ -165,6 +166,7 @@ static inline int iomfb_m4_panel_edid(struct apple_dcp *dcp, struct drm_connecto
 static inline bool iomfb_m4_panel_edr_requested(struct apple_dcp *dcp) { return false; }
 static inline bool iomfb_m4_panel_edr_capable(struct apple_dcp *dcp) { return false; }
 static inline bool iomfb_m4_panel_vrr_requested(struct apple_dcp *dcp) { return false; }
+static inline bool iomfb_m4_ext_vrr_modeset(struct apple_dcp *dcp) { return false; }
 static inline void iomfb_m4_atomic_vrr(struct apple_dcp *dcp, bool vrr_enabled) { }
 static inline int iomfb_m4_atomic_check_hdr(struct apple_dcp *dcp, struct drm_crtc *crtc,
 					    struct drm_atomic_commit *commit)
-- 
2.43.0

