From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 16:51:54 +0000
Subject: [PATCH] pmdomain: apple: pmgr-pwrstate: report domains that
 are off with BUSY latched

A power domain can reach off with its BUSY bit latched. On T8140 both
ISP CPU cores do every time Linux powers them down, and the sleep
engine, which powers them up itself in a wake that keeps DRAM up, then
stalls on a latched one until its watchdog resets the SoC. Whether any
T8132 domain does the same cannot be read from the existing debug
output: the power-state message prints the word to be written, with
BUSY masked.

Add busy_report, a write-only bring-up parameter: writing 1 reads the
state word of every domain this driver registered and logs each one
that reads off with BUSY set, and how many were read. It only reads.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/pmdomain/apple/pmgr-pwrstate.c | 45 ++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/drivers/pmdomain/apple/pmgr-pwrstate.c b/drivers/pmdomain/apple/pmgr-pwrstate.c
index 6bcaa4cd1c..7d656c2eb4 100644
--- a/drivers/pmdomain/apple/pmgr-pwrstate.c
+++ b/drivers/pmdomain/apple/pmgr-pwrstate.c
@@ -1338,6 +1338,51 @@ static struct platform_driver apple_pmgr_ps_driver = {
 	},
 };
 
+/*
+ * Bring-up, read-only. A domain can reach off with BUSY latched, and a sleep engine that
+ * powers it up itself in a wake that keeps DRAM up then stalls on it until its watchdog
+ * resets the SoC (aurora-silicon/linux#1445, on T8140's ISP CPU cores). Writing 1 logs every
+ * domain of this driver whose state word reads off with BUSY set, and how many were read.
+ * Only the state words are read.
+ */
+static int apple_pmgr_ps_busy_one(struct device *dev, void *data)
+{
+	struct apple_pmgr_ps *ps = dev_get_drvdata(dev);
+	unsigned int *n = data;
+	u32 reg;
+
+	if (!ps || !ps->regmap || regmap_read(ps->regmap, ps->offset, &reg))
+		return 0;
+	n[0]++;
+	if ((reg & APPLE_PMGR_BUSY) && !FIELD_GET(APPLE_PMGR_PS_ACTUAL, reg)) {
+		n[1]++;
+		dev_info(dev, "PS %s: off with BUSY latched: %#x\n", ps->genpd.name, reg);
+	}
+	return 0;
+}
+
+static int apple_pmgr_ps_busy_report_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int n[2] = {};
+	bool go;
+	int ret;
+
+	ret = kstrtobool(val, &go);
+	if (ret || !go)
+		return ret;
+	ret = driver_for_each_device(&apple_pmgr_ps_driver.driver, NULL, n,
+				     apple_pmgr_ps_busy_one);
+	pr_info("apple-pmgr-pwrstate: busy report: %u of %u domains off with BUSY latched\n",
+		n[1], n[0]);
+	return ret;
+}
+
+static const struct kernel_param_ops apple_pmgr_ps_busy_report_ops = {
+	.set = apple_pmgr_ps_busy_report_set,
+};
+module_param_cb(busy_report, &apple_pmgr_ps_busy_report_ops, NULL, 0200);
+MODULE_PARM_DESC(busy_report, "Bring-up, read-only: write 1 to log every power domain that reads off with BUSY latched");
+
 MODULE_AUTHOR("Hector Martin <marcan@marcan.st>");
 MODULE_DESCRIPTION("PMGR power state driver for Apple SoCs");
 
-- 
