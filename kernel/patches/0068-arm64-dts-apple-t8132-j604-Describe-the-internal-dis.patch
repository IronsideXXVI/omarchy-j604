From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 04:42:52 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j604: Describe the internal display
 coprocessor

Describe the internal display coprocessor (DCP) of the MacBook Pro
(14-inch, M4), its mailbox, its firmware and frontend DARTs and the
display subsystem, laid out the same way as t8132-j713-display.dtsi on
integration/aurora ("arm64: dts: apple: wire J713 native graphics and
power ownership", Eryk Wieliczko).

From the J604 Apple device tree (25G83 and 26B123 templates), which
matches the J713 for all of these blocks:
- dcp: coproc 0x30ae00000, iop-vbar 0x30a850000, interrupts 653-656;
  disp0: 0x308000000, 0x30a240000, 0x30a3a8000, 0x30a800000, 0x382800000;
- dart-dcp 0x30a340000 (SID 23) and dart-disp0 0x30a300000 (SID 0
  scanout, SID 16 PIODMA), interrupt 678, VM base 0x10000000000 and
  size 0x1000000000 for these streams;
- power domain DISP_CPU (ps_disp_cpu);
- disp0 dot-pitch-float 254.6 ppi, so the full 3024x1964 panel is
  301 x 195 mm (rounded down).

Every node is disabled, and neither the dcp/disp0/disp0_piodma aliases
nor the apple,j713-native-* opt-ins are added. m1n1 and U-Boot only hand
the running DCP over when those are present, so the J604 keeps the boot
framebuffer exactly as before, with its power domains unchanged. The
drm/apple M4 backend has no J604 panel profile yet and only admits the
J713, so enabling these nodes is left for a separate change once the
J604 has first-boot evidence.

The HDMI port (dp2hdmi, dcpext) is not described: drm/apple has no T8132
external display backend.

Testing: dtc and dtbs_check only.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../boot/dts/apple/t8132-j604-display.dtsi    | 92 +++++++++++++++++++
 arch/arm64/boot/dts/apple/t8132-j604.dts      |  6 ++
 2 files changed, 98 insertions(+)
 create mode 100644 arch/arm64/boot/dts/apple/t8132-j604-display.dtsi

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi
new file mode 100644
index 0000000000..5cae908c1a
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Apple MacBook Pro (14-inch, M4) internal display coprocessor (DCP).
+ *
+ * Same node layout as t8132-j713-display.dtsi; every value below was checked
+ * against the J604 Apple device tree (25G83 and 26B123 j604ap templates).
+ * DCP-<id> tags name rows of DT-VERIFY-dcp.tsv.
+ *
+ * Everything here is disabled and no dcp/disp0/disp0_piodma alias or
+ * apple,j713-native-* opt-in is set: the boot loaders key their DCP handoff on
+ * those, so the J604 keeps the boot framebuffer (simple-framebuffer) and none
+ * of these nodes is probed. drm/apple has no J604 panel profile yet, and its
+ * M4 backend and display DART adoption only admit the J713.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+&soc {
+	dcp_mbox: mailbox@30ae08000 {
+		compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x3 0x0ae08000 0x0 0x4000>; /* DCP-MBOX-1 */
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 653 IRQ_TYPE_LEVEL_HIGH>, /* DCP-MBOX-2 */
+			     <AIC_IRQ 654 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 655 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 656 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		power-domains = <&ps_disp_cpu>; /* DCP-MBOX-4 */
+		#mbox-cells = <0>;
+		status = "disabled";
+	};
+
+	/* DCP firmware DART: SID23. */
+	dcp_dart: iommu@30a340000 {
+		compatible = "apple,t8132-dart", "apple,t8110-dart";
+		reg = <0x3 0x0a340000 0x0 0x20000>; /* DCP-DART-1 */
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 678 IRQ_TYPE_LEVEL_HIGH>; /* DCP-DART-2 */
+		#iommu-cells = <1>;
+		apple,dma-range = <0x100 0x0 0x10 0x0>; /* DCP-DART-4, DCP-DART-5 */
+		status = "disabled";
+	};
+
+	/* Display frontend DART: SID0 scanout, SID16 PIODMA. */
+	disp0_dart: iommu@30a300000 {
+		compatible = "apple,t8132-dart", "apple,t8110-dart";
+		reg = <0x3 0x0a300000 0x0 0xc000>; /* DCP-DDART-1 */
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 678 IRQ_TYPE_LEVEL_HIGH>; /* DCP-DDART-3 */
+		#iommu-cells = <1>;
+		apple,dma-range = <0x100 0x0 0x10 0x0>; /* DCP-DDART-5, DCP-DDART-6 */
+		status = "disabled";
+	};
+
+	dcp: dcp@30ae00000 {
+		compatible = "apple,t8132-dcp";
+		reg = <0x3 0x0ae00000 0x0 0x4000>, /* DCP-1, DCP-2 */
+		      <0x3 0x08000000 0x0 0xc20000>, /* DCP-3 */
+		      <0x3 0x0a240000 0x0 0x10000>, /* DCP-4 */
+		      <0x3 0x0a3a8000 0x0 0x4000>, /* DCP-5 */
+		      <0x3 0x0a800000 0x0 0x800000>, /* DCP-6 */
+		      <0x3 0x82800000 0x0 0xbc000>, /* DCP-7 */
+		      <0x3 0x0a850000 0x0 0x4000>; /* DCP-8 */
+		reg-names = "coproc", "disp-0", "disp-1", "disp-2", "disp-3",
+			    "disp-4", "iop-vbar";
+		mboxes = <&dcp_mbox>;
+		mbox-names = "mbox";
+		iommus = <&dcp_dart 23>; /* DCP-12 */
+		power-domains = <&ps_disp_cpu>; /* DCP-17 */
+		/*
+		 * Full 3024x1964 panel including the notch rows, from the
+		 * 254.6 ppi dot pitch of the J604 device tree.
+		 */
+		apple,panel-width-mm = <301>; /* DCP-13 */
+		apple,panel-height-mm = <195>; /* DCP-14 */
+		#address-cells = <2>;
+		#size-cells = <2>;
+		status = "disabled"; /* DCP-11 */
+
+		disp0_piodma: piodma {
+			iommus = <&disp0_dart 16>; /* DCP-16 */
+			status = "disabled"; /* DCP-15 */
+		};
+	};
+
+	display: display-subsystem {
+		compatible = "apple,t8132-display-subsystem";
+		iommus = <&disp0_dart 0>; /* DCP-DISP-1 */
+		status = "disabled"; /* DCP-DISP-2 */
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 1b1e360613..0f80e2f7c0 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -378,3 +378,9 @@
 	};
 };
 #include "t8132-j604-gpu.dtsi"
+
+/*
+ * Internal display coprocessor nodes, all disabled; the boot framebuffer of
+ * t8132-jxxx.dtsi keeps the panel (see t8132-j604-display.dtsi).
+ */
+#include "t8132-j604-display.dtsi"
