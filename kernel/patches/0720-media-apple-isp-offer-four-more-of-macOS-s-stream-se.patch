From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 15:21:34 +0000
Subject: [PATCH] media: apple: isp: offer four more of macOS's stream
 settings on T8132

macOS sends this camera four stream settings that the driver leaves at
the firmware's defaults:
FES_OUTPUT_SIZE_AUTO_ADJUST_ENABLE (0x0903) at 1, MAX_FRAME_RATE_ALLOW
(0x0167) at 0x1e01, CONTEXTSWITCH_ENABLE (0x8102) at 0, 0 and
SCALER_CHROMA_SAMPLE_OFFSET_SET (0x0b0a) at 0x100, 0.

Add macos_stream_config to send them with macOS's values at stream
start, the last of five candidates for the camera's low-light magenta
cast. It is off by default.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-cam.c | 39 ++++++++++++++++++++++
 drivers/media/platform/apple/isp/isp-cmd.h |  4 +++
 2 files changed, 43 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index c944026bd4..1d8d496f66 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -1425,6 +1425,44 @@ static void isp_ch_macos_knobs_done(struct apple_isp *isp, u32 ch)
 		dev_warn_once(isp->dev, "manual knobs not released: %d\n", err);
 }
 
+/*
+ * macOS sends this camera four more stream settings that the driver leaves
+ * at the firmware's defaults: FES_OUTPUT_SIZE_AUTO_ADJUST_ENABLE (0x0903)
+ * at 1, MAX_FRAME_RATE_ALLOW (0x0167) at 0x1e01, CONTEXTSWITCH_ENABLE
+ * (0x8102) at 0, 0 and SCALER_CHROMA_SAMPLE_OFFSET_SET (0x0b0a) at 0x100, 0.
+ * macos_stream_config sends them, with macOS's values, for tests (default:
+ * off).
+ */
+static bool macos_stream_config;
+module_param(macos_stream_config, bool, 0644);
+MODULE_PARM_DESC(macos_stream_config,
+		 "Send four more stream settings macOS sends this camera (default: off)");
+
+static void isp_ch_macos_stream_config(struct apple_isp *isp, u32 ch)
+{
+	int err;
+
+	if (!READ_ONCE(macos_stream_config) ||
+	    !isp->hw->macos_session_settings)
+		return;
+	err = isp_cmd_ch_u32_set(isp,
+				 CISP_CMD_CH_FES_OUTPUT_SIZE_AUTO_ADJUST_ENABLE,
+				 ch, 1);
+	if (!err)
+		err = isp_cmd_ch_u32_set(isp, CISP_CMD_CH_MAX_FRAME_RATE_ALLOW,
+					 ch, 0x1e01);
+	if (!err)
+		err = isp_ch_u32x2_set(isp,
+				       CISP_CMD_APPLE_CH_CONTEXTSWITCH_ENABLE,
+				       ch, 0, 0);
+	if (!err)
+		err = isp_ch_u32x2_set(isp,
+				       CISP_CMD_CH_SCALER_CHROMA_SAMPLE_OFFSET_SET,
+				       ch, 0x100, 0);
+	if (err)
+		dev_warn_once(isp->dev, "stream setting refused: %d\n", err);
+}
+
 /*
  * A floor on the auto exposure gain (1/256 steps, as AE_GAIN_CAP_SET), for
  * tests: with it a lit scene is taken at the sensor gain of a dark room,
@@ -2016,6 +2054,7 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	isp_ch_ae_gain_min(isp, ch);
 	isp_ch_desk_view(isp, ch);
 	isp_ch_macos_hr(isp, ch);
+	isp_ch_macos_stream_config(isp, ch);
 
 	isp_ch_macos_knobs_done(isp, ch);
 
diff --git a/drivers/media/platform/apple/isp/isp-cmd.h b/drivers/media/platform/apple/isp/isp-cmd.h
index 809f9d0fc0..117ca2c0ec 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.h
+++ b/drivers/media/platform/apple/isp/isp-cmd.h
@@ -49,6 +49,7 @@
 #define CISP_CMD_CH_BUFFER_POOL_RETURN			     0x015b
 #define CISP_CMD_CH_CAMERA_AGILE_FREQ_ARRAY_CURRENT_GET	     0x015e
 #define CISP_CMD_CH_CAR_ENABLE				     0x0164
+#define CISP_CMD_CH_MAX_FRAME_RATE_ALLOW		     0x0167
 #define CISP_CMD_CH_LOCAL_FEP_THUMBNAIL_RAW_BUFFER_ENABLE    0x0169
 #define CISP_CMD_CH_AE_START				     0x0200
 #define CISP_CMD_CH_AE_STOP				     0x0201
@@ -84,6 +85,7 @@
 #define CISP_CMD_CH_MAX_ZOOM_FACTOR_GET			     0x080f
 #define CISP_CMD_CH_ZOOM_FACTOR_SET			     0x0810
 #define CISP_CMD_CH_CURRENT_ZOOM_FACTOR_GET		     0x0811
+#define CISP_CMD_CH_FES_OUTPUT_SIZE_AUTO_ADJUST_ENABLE	     0x0903
 #define CISP_CMD_CH_SHARPNESS_SET			     0x0a09
 #define CISP_CMD_CH_KNOB_MANUAL_CONTROL_ENABLE		     0x0a13
 #define CISP_CMD_CH_KNOB_MANUAL_CONTROL_DISABLE		     0x0a14
@@ -104,6 +106,7 @@
 #define CISP_CMD_CH_DESKVIEW_MODE_SET			     0x0a50
 #define CISP_CMD_CH_OUTPUT_CONFIG_SET			     0x0b01
 #define CISP_CMD_CH_OUTPUT_CONFIG_SCL1_SET		     0x0b09
+#define CISP_CMD_CH_SCALER_CHROMA_SAMPLE_OFFSET_SET	     0x0b0a
 #define CISP_CMD_CH_PREVIEW_STREAM_SET			     0x0b0d
 #define CISP_CMD_CH_SEMANTIC_VIDEO_ENABLE		     0x0b17
 #define CISP_CMD_CH_SEMANTIC_AWB_ENABLE			     0x0b18
@@ -126,6 +129,7 @@
 #define CISP_CMD_SET_DSID_CLR_REG_BASE2			     0x3204
 #define CISP_CMD_SET_DSID_CLR_REG_BASE			     0x3205
 #define CISP_CMD_SET_DSID_CLR_MULTI_BC_REG_BASE		     0x3206
+#define CISP_CMD_APPLE_CH_CONTEXTSWITCH_ENABLE		     0x8102
 #define CISP_CMD_APPLE_CH_AE_METERING_MODE_SET		     0x8206
 #define CISP_CMD_APPLE_CH_AE_FD_SCENE_METERING_CONFIG_SET    0x820e
 #define CISP_CMD_APPLE_CH_AE_FLICKER_FREQ_UPDATE_CURRENT_SET 0x8212
-- 
2.43.0

