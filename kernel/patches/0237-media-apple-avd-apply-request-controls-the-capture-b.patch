From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 07:41:25 +0000
Subject: [PATCH] media: apple: avd: apply request controls the capture
 buffers fit

A stateless client that allocates CAPTURE buffers before its first
request (Chromium's V4L2VideoDecoder does) never moved the picture
format control off its default: the control framework skips a set to
the current value, so s_ctrl did not run and ctx->image_fmt stayed ANY.
The first request then carries the real picture format, which counts
as a change; CAPTURE is busy, so s_ctrl returned -EBUSY and
v4l2_ctrl_request_setup() failed. The driver ignored that result and
decoded with the controls left over from probing (1x1), parameter
validation failed, the context was marked broken and every later
buffer came back with an error.

Accept the format when the allocated CAPTURE buffers already suit it:
the negotiated pixel format is the one for that picture format and the
compressed reference area after the picture is laid out the same. Keep
-EBUSY for a format the buffers cannot hold.

Also stop decoding with stale controls: keep the request setup result
in struct avd_run, log it, and fail the frame for H.264, HEVC, VP9 and
AV1.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/avd/avd-av1.c  |  2 +
 drivers/media/platform/apple/avd/avd-h264.c |  4 ++
 drivers/media/platform/apple/avd/avd-hevc.c |  2 +
 drivers/media/platform/apple/avd/avd-v4l2.c | 44 +++++++++++++++++++--
 drivers/media/platform/apple/avd/avd-vp9.c  |  2 +
 drivers/media/platform/apple/avd/avd.h      |  2 +
 6 files changed, 53 insertions(+), 3 deletions(-)

diff --git a/drivers/media/platform/apple/avd/avd-av1.c b/drivers/media/platform/apple/avd/avd-av1.c
index 8ea584fbcb..41e4f3a29f 100644
--- a/drivers/media/platform/apple/avd/avd-av1.c
+++ b/drivers/media/platform/apple/avd/avd-av1.c
@@ -1431,6 +1431,8 @@ static int avd_av1_run_preamble(struct avd_ctx *ctx, struct avd_av1_run *run)
 	int dst_len, ret, tlb_len;
 
 	avd_run_preamble(ctx, &run->base);
+	if (run->base.setup_err)
+		return run->base.setup_err;
 
 	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl, V4L2_CID_STATELESS_AV1_SEQUENCE);
 	if (WARN_ON(!ctrl))
diff --git a/drivers/media/platform/apple/avd/avd-h264.c b/drivers/media/platform/apple/avd/avd-h264.c
index f764b13104..db4830e7ac 100644
--- a/drivers/media/platform/apple/avd/avd-h264.c
+++ b/drivers/media/platform/apple/avd/avd-h264.c
@@ -997,6 +997,10 @@ static int avd_h264_run(struct avd_ctx *ctx)
 
 	avd_h264_run_preamble(ctx, &run);
 
+	if (run.base.setup_err) {
+		ret = run.base.setup_err;
+		goto err_free_jobs;
+	}
 	if (!run.sps || !run.pps || !run.slice_params || !run.decode_params) {
 		ret = -EINVAL;
 		goto err_free_jobs;
diff --git a/drivers/media/platform/apple/avd/avd-hevc.c b/drivers/media/platform/apple/avd/avd-hevc.c
index 1a14010b89..009ff9821c 100644
--- a/drivers/media/platform/apple/avd/avd-hevc.c
+++ b/drivers/media/platform/apple/avd/avd-hevc.c
@@ -1405,6 +1405,8 @@ static int avd_hevc_run_preamble(struct avd_ctx *ctx, struct avd_hevc_run *run)
 	 * larger array can move their storage.
 	 */
 	avd_run_preamble(ctx, &run->base);
+	if (run->base.setup_err)
+		return run->base.setup_err;
 
 	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
 			      V4L2_CID_STATELESS_HEVC_DECODE_PARAMS);
diff --git a/drivers/media/platform/apple/avd/avd-v4l2.c b/drivers/media/platform/apple/avd/avd-v4l2.c
index d59d042c7a..dbd500e0f4 100644
--- a/drivers/media/platform/apple/avd/avd-v4l2.c
+++ b/drivers/media/platform/apple/avd/avd-v4l2.c
@@ -35,6 +35,36 @@ static bool avd_image_fmt_changed(struct avd_ctx *ctx,
 	return ctx->image_fmt != image_fmt;
 }
 
+/*
+ * Whether the allocated CAPTURE buffers already suit @image_fmt: the
+ * negotiated pixel format is the one for it and the compressed reference
+ * area after the picture is laid out the same. A request applied when its
+ * job starts always finds CAPTURE buffers allocated; its picture format is
+ * no change then. (ctx->image_fmt can still say ANY there: a client that
+ * set the format control only to its default value never reached s_ctrl,
+ * as the control framework skips values that equal the current one.)
+ */
+static bool avd_image_fmt_fits_capture(struct avd_ctx *ctx,
+				       enum avd_image_fmt image_fmt)
+{
+	const struct avd_coded_fmt_desc *desc = ctx->coded_fmt_desc;
+	const struct v4l2_pix_format_mplane *pix = &ctx->decoded_fmt.fmt.pix_mp;
+	struct avd_comp comp = {};
+	bool fourcc_ok = false;
+	unsigned int i;
+
+	for (i = 0; i < desc->num_decoded_fmts; i++)
+		if (desc->decoded_fmts[i].image_fmt == image_fmt &&
+		    desc->decoded_fmts[i].fourcc == pix->pixelformat)
+			fourcc_ok = true;
+	if (!fourcc_ok)
+		return false;
+
+	fill_comp(&comp, image_fmt, pix->width, pix->height);
+	return comp.size == ctx->comp.size &&
+	       !memcmp(comp.offsets, ctx->comp.offsets, sizeof(comp.offsets));
+}
+
 static u32 avd_enum_decoded_fmt(struct avd_ctx *ctx, int index,
 				enum avd_image_fmt image_fmt)
 {
@@ -139,8 +169,12 @@ static int avd_s_ctrl(struct v4l2_ctrl *ctrl)
 	if (avd_image_fmt_changed(ctx, image_fmt)) {
 		vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx,
 				     V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
-		if (vb2_is_busy(vq))
-			return -EBUSY;
+		if (vb2_is_busy(vq)) {
+			if (!avd_image_fmt_fits_capture(ctx, image_fmt))
+				return -EBUSY;
+			ctx->image_fmt = image_fmt;
+			return 0;
+		}
 
 		ctx->image_fmt = image_fmt;
 		avd_reset_decoded_fmt(ctx);
@@ -1017,7 +1051,11 @@ void avd_run_preamble(struct avd_ctx *ctx, struct avd_run *run)
 	/* Apply request(s) controls if needed. */
 	src_req = run->bufs.src->vb2_buf.req_obj.req;
 	if (src_req)
-		v4l2_ctrl_request_setup(src_req, &ctx->ctrl_hdl);
+		run->setup_err = v4l2_ctrl_request_setup(src_req, &ctx->ctrl_hdl);
+	if (run->setup_err)
+		dev_err_ratelimited(ctx->dev->dev,
+				    "request controls not applied (%d), failing the frame\n",
+				    run->setup_err);
 
 	v4l2_m2m_buf_copy_metadata(run->bufs.src, run->bufs.dst);
 }
diff --git a/drivers/media/platform/apple/avd/avd-vp9.c b/drivers/media/platform/apple/avd/avd-vp9.c
index 58b0106371..4535508d9c 100644
--- a/drivers/media/platform/apple/avd/avd-vp9.c
+++ b/drivers/media/platform/apple/avd/avd-vp9.c
@@ -776,6 +776,8 @@ static int avd_vp9_run_preamble(struct avd_ctx *ctx, struct avd_vp9_run *run)
 	int ret;
 
 	avd_run_preamble(ctx, &run->base);
+	if (run->base.setup_err)
+		return run->base.setup_err;
 
 	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl,
 			      V4L2_CID_STATELESS_VP9_COMPRESSED_HDR);
diff --git a/drivers/media/platform/apple/avd/avd.h b/drivers/media/platform/apple/avd/avd.h
index 5d365d5872..6c82966b8a 100644
--- a/drivers/media/platform/apple/avd/avd.h
+++ b/drivers/media/platform/apple/avd/avd.h
@@ -79,6 +79,8 @@ struct avd_run {
 	dma_addr_t y_out;
 	dma_addr_t uv_out;
 	dma_addr_t comp_out;
+	/* v4l2_ctrl_request_setup() result: nonzero, the controls are stale */
+	int setup_err;
 };
 
 struct avd_ctrl_desc {
