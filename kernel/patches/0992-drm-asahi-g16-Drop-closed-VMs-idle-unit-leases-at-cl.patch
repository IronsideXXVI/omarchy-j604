From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 22 Nov 2026 03:04:04 +0000
Subject: [PATCH] drm/asahi: g16: Drop closed VMs' idle unit leases at
 close by default

A closed VM's render and PB-slot last-owner leases stayed on every unit
index until another publication retired there, and those leases were the
last references to its render arena, so the arena outlived the client.
Turn on g16_close_disp: a VM handle close drops those leases on idle,
fully retired indices and the arena goes with them.

The word stays runtime 0644, and writing 0 brings back the old behaviour.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index f149da455fc..27a6beeca69 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -3166,8 +3166,8 @@ pub(crate) fn close_trim() -> bool {
     "G16: 1 = a VM handle close gives back the later render units of closed VMs that still hold unit leases (default 1; 0: kept until a deep client displaces them)"
 );
 
-/// Storage of `g16_close_disp` (runtime 0644, default 0).
-static CLOSE_DISP: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_close_disp` (runtime 0644, default 1).
+static CLOSE_DISP: AtomicU32 = AtomicU32::new(1);
 
 /// `g16_close_disp`: when any VM's handle closes, the render and PB-slot last-owner leases
 /// that closed VMs still hold are dropped on every unit index with no flight, no publication
@@ -3186,7 +3186,7 @@ pub(crate) fn close_disp() -> bool {
     CLOSE_DISP_PARM,
     CLOSE_DISP,
     "g16_close_disp",
-    "G16: 1 = a VM handle close drops closed VMs' render and PB-slot leases on idle, fully retired unit indices, freeing their arenas (default 0: kept until another publication retires there)"
+    "G16: 1 = a VM handle close drops closed VMs' render and PB-slot leases on idle, fully retired unit indices, freeing their arenas (default 1; 0: kept until another publication retires there)"
 );
 
 /// Storage of `g16_loader_macos` (0644, default 7; read once, when initdata is built).
-- 
2.43.0

