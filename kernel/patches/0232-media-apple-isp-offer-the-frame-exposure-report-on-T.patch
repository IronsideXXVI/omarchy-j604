From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 02:23:14 +0000
Subject: [PATCH] media: apple: isp: offer the frame exposure report on
 T8132 on request

T6040 and T8140 report each frame's gain and exposure time as read-only
V4L2 controls, read from the fourth section of the frame metadata of
the H17 firmware. T8132 runs T6040's firmware interface, so its
metadata most likely carries the same report, but that has not been
measured on it.

Mark T8132 as having an unverified exposure report and read it only
with the new apple_isp.unverified_meta_exposure parameter, off by
default and taken at probe, where the controls are created. The reader
already bounds the section by the buffer size and ignores an unwritten
one. Once measured on the hardware, T8132 can take meta_exposure like
the others.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-drv.c  |  1 +
 drivers/media/platform/apple/isp/isp-drv.h  |  6 ++++++
 drivers/media/platform/apple/isp/isp-v4l2.c | 19 ++++++++++++++++++-
 3 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index 7d67a7f2d7..d242afc9ff 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -1293,6 +1293,7 @@ static const struct apple_isp_hw apple_isp_hw_t8132 = {
 	.shared_size = 0xdec00000,
 	.fw_restore = true,
 	.deferred_start = true,
+	.meta_exposure_unverified = true,
 };
 
 /*
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index a5f834e947..b92b4ae659 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -242,6 +242,12 @@ struct apple_isp_hw {
 	/* metadata buffers carry the frame's exposure report (H17 firmware) */
 	bool meta_exposure;
 
+	/*
+	 * The same report is expected but not yet measured on this SoC: it is
+	 * read only with the apple_isp.unverified_meta_exposure parameter.
+	 */
+	bool meta_exposure_unverified;
+
 	/*
 	 * The firmware leaves its data segment changed when it stops, and
 	 * does not start from it again. Keep a copy of the segment as the
diff --git a/drivers/media/platform/apple/isp/isp-v4l2.c b/drivers/media/platform/apple/isp/isp-v4l2.c
index 41e63a487c..d0769f8e55 100644
--- a/drivers/media/platform/apple/isp/isp-v4l2.c
+++ b/drivers/media/platform/apple/isp/isp-v4l2.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /* Copyright 2023 Eileen Yoon <eyn@gmx.com> */
 
+#include <linux/moduleparam.h>
 #include <linux/math.h>
 #include <linux/module.h>
 #include <linux/unaligned.h>
@@ -77,6 +78,22 @@ static bool isp_p010_buffer_matches(const struct isp_format *fmt,
  * fixed scene and with the frame rate capping the integration time.
  */
 #define ISP_META_SECTIONS		0x10
+/*
+ * T8132 runs T6040's H17 firmware interface, so its metadata most likely
+ * carries the same exposure report, but that is not measured there yet.
+ * Read at probe, where the controls are created.
+ */
+static bool unverified_meta_exposure;
+module_param(unverified_meta_exposure, bool, 0444);
+MODULE_PARM_DESC(unverified_meta_exposure,
+		 "Report frame gain and exposure where the metadata layout is not yet verified, e.g. T8132 (default: off)");
+
+static bool isp_meta_exposure(const struct apple_isp *isp)
+{
+	return isp->hw->meta_exposure ||
+	       (isp->hw->meta_exposure_unverified && unverified_meta_exposure);
+}
+
 #define ISP_META_SECTION_EXPOSURE	3
 #define ISP_META_EXPOSURE_TIME		0x0
 #define ISP_META_EXPOSURE_GAIN		0x6
@@ -1276,7 +1293,7 @@ int apple_isp_setup_video(struct apple_isp *isp)
 					       V4L2_CID_POWER_LINE_FREQUENCY_60HZ,
 					       BIT(V4L2_CID_POWER_LINE_FREQUENCY_DISABLED),
 					       V4L2_CID_POWER_LINE_FREQUENCY_50HZ);
-	if (isp->hw->meta_exposure)
+	if (isp_meta_exposure(isp))
 		isp_init_exposure_ctrls(isp);
 	if (isp->ctrl_handler.error) {
 		err = isp->ctrl_handler.error;
-- 
2.43.0

