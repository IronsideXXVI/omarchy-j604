From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 22:04:29 +0000
Subject: [PATCH] soc: apple: mcc: log T8132's AMCC region locks at
 probe

The J604's ADT lists four AMCC region locks under
/chosen/lock-regs/amcc (amcc-ctrr-a to -d): per plane, a lower and an
upper limit in 16 KiB pages from the start of DRAM, then enable, lock
and write-disable words, at plane offsets 0x6a0, 0x6b4, 0x6c8 and
0x450. The cache apertures this driver maps already cover them.

Read every set once at probe, on both AMCCs' two planes, and log the
ones that are not all zero, plus a count. That shows in one boot log
whether a region is armed, locked and write-disabled over some part of
DRAM, and where. Nothing is written; the cache handling is unchanged.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/mcc.c | 36 ++++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/drivers/soc/apple/mcc.c b/drivers/soc/apple/mcc.c
index a13f8b85eb..5628aefd2e 100644
--- a/drivers/soc/apple/mcc.c
+++ b/drivers/soc/apple/mcc.c
@@ -217,6 +217,40 @@ static void apple_mcc_quiesce(struct apple_mcc *mcc)
 	mcc->enabled = false;
 }
 
+/*
+ * T8132's AMCC region locks, at the offsets the ADT's /chosen/lock-regs/amcc/amcc-ctrr-{a,b,c,d}
+ * give: lower, upper, enable, lock and write-disable words, one set per plane, the limits in
+ * 16 KiB pages from the start of DRAM. Read once at probe and logged, so that a boot log shows
+ * whether a region is armed, locked and write-disabled, and where. Nothing is written.
+ */
+static const u16 apple_mcc_t8132_ctrr[] = { 0x6a0, 0x6b4, 0x6c8, 0x450 };
+
+static void apple_mcc_log_locks_t8132(struct apple_mcc *mcc)
+{
+	unsigned int p, r, armed = 0;
+
+	for (p = 0; p < 2 * mcc->nr_planes; p++) {
+		void __iomem *plane = mcc->planes[p / 2] + (p % 2) * 0x40000;
+
+		for (r = 0; r < ARRAY_SIZE(apple_mcc_t8132_ctrr); r++) {
+			void __iomem *reg = plane + apple_mcc_t8132_ctrr[r];
+			u32 lower = readl(reg), upper = readl(reg + 0x4);
+			u32 enable = readl(reg + 0x8), lock = readl(reg + 0xc);
+			u32 wdis = readl(reg + 0x10);
+
+			if (!lower && !upper && !enable && !lock && !wdis)
+				continue;
+			armed++;
+			dev_info(mcc->dev,
+				 "plane %u ctrr-%c: lower %#x upper %#x (DRAM +%#llx..+%#llx) enable %#x lock %#x write-disable %#x\n",
+				 p, 'a' + r, lower, upper, (u64)lower << 14,
+				 ((u64)upper + 1) << 14, enable, lock, wdis);
+		}
+	}
+	dev_info(mcc->dev, "%u of %u region lock sets non-zero\n", armed,
+		 2 * mcc->nr_planes * (unsigned int)ARRAY_SIZE(apple_mcc_t8132_ctrr));
+}
+
 static int apple_mcc_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -247,6 +281,8 @@ static int apple_mcc_probe(struct platform_device *pdev)
 	ret = apple_mcc_wait_boot_dma(dev);
 	if (ret)
 		return ret;
+	if (mcc->retained && mcc->nr_planes == 2)
+		apple_mcc_log_locks_t8132(mcc);
 
 	platform_set_drvdata(pdev, mcc);
 
-- 
2.43.0

