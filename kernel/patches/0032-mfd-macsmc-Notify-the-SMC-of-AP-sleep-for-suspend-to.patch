From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RJ Skerry-Ryan <rryan@alum.mit.edu>
Date: Wed, 14 Oct 2026 21:10:40 -0700
Subject: [PATCH] mfd: macsmc: Notify the SMC of AP sleep for
 suspend-to-RAM

The SMC remains running while the application processor sleeps. Send the
RTKit AP-state notification with state 0x201 after the key-based sleep
announcement, and restore state 0x20 before accessing application keys on
wake. Leave the IOP state and the existing endpoints intact.

Use suspend_late/resume_early so children have completed their suspend
callbacks while interrupts and the non-freezable RTKit worker can still
complete the management handshake. Keep the s2idle handshake unchanged.
Serialize the final slpa key with background users and block subsequent
key commands until the AP wake acknowledgment succeeds.

A failed sleep acknowledgment leaves the remote state uncertain. Attempt
the AP wake handshake within the failing callback, since PM core will not
invoke its resume_early callback. Keep keys blocked if that recovery fails.

Expose an AP-only sleep helper in RTKit rather than using idle/quiesce,
which also change the co-processor's own power state.

Assisted-by: OpenAI:Codex
Signed-off-by: RJ Skerry-Ryan <rryan@alum.mit.edu>
[dylan: conflict in apple_smc_write_atomic() with omacom's late-reply
 handling of an earlier pending atomic command; kept both, the new
 ap_sleep refusal first, then the existing pending-reply wait]

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/mfd/macsmc.c            | 113 ++++++++++++++++++++++++++++++--
 drivers/soc/apple/rtkit.c       |   8 +++
 include/linux/mfd/macsmc.h      |   2 +
 include/linux/soc/apple/rtkit.h |  10 +++
 4 files changed, 127 insertions(+), 6 deletions(-)

diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
index 0cfa2fbc70..39fb1c7073 100644
--- a/drivers/mfd/macsmc.c
+++ b/drivers/mfd/macsmc.c
@@ -26,6 +26,7 @@
 #include <linux/pm.h>
 #include <linux/soc/apple/rtkit.h>
 #include <linux/unaligned.h>
+#include <linux/suspend.h>
 
 #define SMC_ENDPOINT			0x20
 
@@ -138,6 +139,8 @@ static int apple_smc_cmd_locked(struct apple_smc *smc, u64 cmd, u64 arg,
 		return -EIO;
 	if (smc->atomic_mode)
 		return -EIO;
+	if (smc->ap_sleep)
+		return -EBUSY;
 
 	reinit_completion(&smc->cmd_done);
 
@@ -194,6 +197,9 @@ static int apple_smc_rw_locked(struct apple_smc *smc, smc_key key,
 
 	lockdep_assert_held(&smc->mutex);
 
+	if (smc->ap_sleep)
+		return -EBUSY;
+
 	if (rsize > SMC_MAX_SIZE)
 		return -EINVAL;
 	if (wsize > SMC_MAX_SIZE)
@@ -348,6 +354,8 @@ int apple_smc_write_atomic(struct apple_smc *smc, smc_key key, const void *buf,
 		return -EIO;
 	if (!smc->atomic_mode)
 		return -EIO;
+	if (READ_ONCE(smc->ap_sleep))
+		return -EBUSY;
 	/*
 	 * A poll timeout or a mismatched reply does not cancel the command or
 	 * release its SRAM. Its late reply does: take it if it has arrived.
@@ -636,12 +644,17 @@ static int apple_smc_probe(struct platform_device *pdev)
  * The announcement only tells the SMC that the system is asleep; it does not
  * by itself power anything down under s2idle. It can be disabled with the
  * sleep_handshake module parameter. MBSW is read-only and always logged.
+ *
+ * For suspend-to-RAM, defer the announcement to suspend_late and then notify
+ * RTKit that the AP is asleep, leaving the SMC itself running. Block key
+ * commands until resume_early acknowledges the AP wake, including on abort.
+ * The RTKit acknowledgment needs interrupts and its non-freezable worker.
  */
 static bool sleep_handshake = true;
 module_param(sleep_handshake, bool, 0644);
 MODULE_PARM_DESC(sleep_handshake, "Announce system sleep and wake to the SMC (default: on)");
 
-static int apple_smc_suspend(struct device *dev)
+static int apple_smc_announce_sleep(struct device *dev)
 {
 	struct apple_smc *smc = dev_get_drvdata(dev);
 	int ret;
@@ -656,22 +669,40 @@ static int apple_smc_suspend(struct device *dev)
 			dev_warn(dev, "Failed to write WKTP (%d)\n", ret);
 	}
 
-	ret = apple_smc_write_u32(smc, SMC_KEY(MBSE), SMC_KEY(slpa));
+	/*
+	 * Serialize the last key command with background power/thermal work.
+	 * Do not hold the mutex while waiting for an RTKit management reply:
+	 * queued notifications on that worker may themselves try to read keys.
+	 */
+	scoped_guard(mutex, &smc->mutex) {
+		u32 command = SMC_KEY(slpa);
+
+		ret = apple_smc_rw_locked(smc, SMC_KEY(MBSE), &command,
+					  sizeof(command), NULL, 0);
+		if (ret >= 0) {
+			smc->sleep_announced = true;
+			if (pm_suspend_target_state == PM_SUSPEND_MEM)
+				WRITE_ONCE(smc->ap_sleep, true);
+		}
+	}
 	if (ret < 0) {
 		dev_warn(dev, "Failed to announce sleep (MBSE = slpa): %d\n", ret);
-		return 0;
+		return pm_suspend_target_state == PM_SUSPEND_MEM ? ret : 0;
 	}
-	smc->sleep_announced = true;
 
 	return 0;
 }
 
-static int apple_smc_resume(struct device *dev)
+static int apple_smc_announce_wake(struct device *dev)
 {
 	struct apple_smc *smc = dev_get_drvdata(dev);
 	u64 wake_reasons;
 	int ret;
 
+	/* A failed AP wake notification must leave application keys blocked. */
+	if (smc->ap_sleep)
+		return -EIO;
+
 	ret = apple_smc_read_u64(smc, SMC_KEY(MBSW), &wake_reasons);
 	if (ret < 0)
 		dev_dbg(dev, "Failed to read MBSW (%d)\n", ret);
@@ -689,7 +720,77 @@ static int apple_smc_resume(struct device *dev)
 	return 0;
 }
 
-static DEFINE_SIMPLE_DEV_PM_OPS(apple_smc_pm_ops, apple_smc_suspend, apple_smc_resume);
+static int apple_smc_suspend(struct device *dev)
+{
+	if (pm_suspend_target_state == PM_SUSPEND_MEM)
+		return 0;
+
+	return apple_smc_announce_sleep(dev);
+}
+
+static int apple_smc_resume(struct device *dev)
+{
+	if (pm_suspend_target_state == PM_SUSPEND_MEM)
+		return 0;
+
+	return apple_smc_announce_wake(dev);
+}
+
+static int apple_smc_resume_early(struct device *dev)
+{
+	struct apple_smc *smc = dev_get_drvdata(dev);
+	int ret;
+
+	if (pm_suspend_target_state != PM_SUSPEND_MEM)
+		return 0;
+
+	if (!smc->ap_sleep)
+		return apple_smc_announce_wake(dev);
+
+	ret = apple_rtkit_set_ap_sleep(smc->rtk, false);
+	if (ret) {
+		dev_err(dev, "SMC AP wake acknowledgment failed: %d\n", ret);
+		return ret;
+	}
+
+	scoped_guard(mutex, &smc->mutex)
+		WRITE_ONCE(smc->ap_sleep, false);
+
+	dev_info(dev, "SMC acknowledged AP wake\n");
+	return apple_smc_announce_wake(dev);
+}
+
+static int apple_smc_suspend_late(struct device *dev)
+{
+	struct apple_smc *smc = dev_get_drvdata(dev);
+	int ret;
+
+	if (pm_suspend_target_state != PM_SUSPEND_MEM)
+		return 0;
+
+	ret = apple_smc_announce_sleep(dev);
+	if (ret || !smc->ap_sleep)
+		return ret;
+
+	ret = apple_rtkit_set_ap_sleep(smc->rtk, true);
+	if (ret) {
+		dev_err(dev, "SMC AP sleep acknowledgment failed: %d\n", ret);
+		/*
+		 * A lost acknowledgment does not mean the request was ignored.
+		 * This callback's failure skips its paired resume_early callback.
+		 */
+		apple_smc_resume_early(dev);
+		return ret;
+	}
+
+	dev_info(dev, "SMC acknowledged AP sleep\n");
+	return 0;
+}
+
+static const struct dev_pm_ops apple_smc_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(apple_smc_suspend, apple_smc_resume)
+	LATE_SYSTEM_SLEEP_PM_OPS(apple_smc_suspend_late, apple_smc_resume_early)
+};
 
 static const struct of_device_id apple_smc_of_match[] = {
 	{ .compatible = "apple,t8152-smc" },
diff --git a/drivers/soc/apple/rtkit.c b/drivers/soc/apple/rtkit.c
index 65faedc3da..bc3797c529 100644
--- a/drivers/soc/apple/rtkit.c
+++ b/drivers/soc/apple/rtkit.c
@@ -1823,6 +1823,14 @@ static int apple_rtkit_set_ap_power_state(struct apple_rtkit *rtk,
 	return 0;
 }
 
+int apple_rtkit_set_ap_sleep(struct apple_rtkit *rtk, bool sleep)
+{
+	return apple_rtkit_set_ap_power_state(rtk, sleep ?
+					     APPLE_RTKIT_PWR_STATE_IDLE :
+					     APPLE_RTKIT_PWR_STATE_ON);
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_set_ap_sleep);
+
 static int apple_rtkit_set_iop_power_state(struct apple_rtkit *rtk,
 					   unsigned int state)
 {
diff --git a/include/linux/mfd/macsmc.h b/include/linux/mfd/macsmc.h
index 426af9b52b..8b0835673b 100644
--- a/include/linux/mfd/macsmc.h
+++ b/include/linux/mfd/macsmc.h
@@ -101,6 +101,7 @@ enum apple_smc_boot_stage {
  * @mutex: Mutex for non-atomic mode
  * @lock: Spinlock for atomic mode
  * @sleep_announced: MBSE = 'slpa' was sent at suspend; send 'waka' at resume
+ * @ap_sleep: Key traffic blocked until RTKit acknowledges the AP wake notification
  */
 struct apple_smc {
 	struct device *dev;
@@ -131,6 +132,7 @@ struct apple_smc {
 	spinlock_t lock;
 
 	bool sleep_announced;
+	bool ap_sleep;
 };
 
 /**
diff --git a/include/linux/soc/apple/rtkit.h b/include/linux/soc/apple/rtkit.h
index ac646240f8..d9bedcabef 100644
--- a/include/linux/soc/apple/rtkit.h
+++ b/include/linux/soc/apple/rtkit.h
@@ -259,6 +259,16 @@ int apple_rtkit_poweroff(struct apple_rtkit *rtk);
  */
 int apple_rtkit_idle(struct apple_rtkit *rtk);
 
+/*
+ * Notify the co-processor that the application processor is sleeping or awake,
+ * without changing the co-processor's own power state or restarting endpoints.
+ * Waits for acknowledgment; requires interrupts and the RTKit worker to run.
+ * The caller must serialize power transitions and stop application messages
+ * before sleeping, until a wake notification succeeds. On failure, the remote
+ * state is uncertain: attempt a wake notification before reusing endpoints.
+ */
+int apple_rtkit_set_ap_sleep(struct apple_rtkit *rtk, bool sleep);
+
 /*
  * Checks if RTKit is running and ready to handle messages.
  */
