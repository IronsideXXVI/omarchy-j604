diff --git a/drivers/media/platform/apple/jpeg/apple-jpeg-hw.h b/drivers/media/platform/apple/jpeg/apple-jpeg-hw.h
index 38d8b20eb9..7e15ef5f72 100644
--- a/drivers/media/platform/apple/jpeg/apple-jpeg-hw.h
+++ b/drivers/media/platform/apple/jpeg/apple-jpeg-hw.h
@@ -9,7 +9,12 @@
 #ifndef APPLE_JPEG_HW_H
 #define APPLE_JPEG_HW_H
 
+#include <linux/align.h>
 #include <linux/limits.h>
+#include <linux/math.h>
+#include <linux/minmax.h>
+#include <linux/mm.h>
+#include <linux/sizes.h>
 #include <linux/types.h>
 
 #define APPLE_JPEG_REG_SIZE		0x4000
@@ -136,6 +141,48 @@ struct apple_jpeg_job {
 	u32 restart_interval;
 };
 
+/*
+ * Raw input: one buffer, the luma rows, then the interleaved CbCr rows at
+ * the same stride (V4L2 NV12/NV16). The engine prefetches its input up to
+ * AJ_INPUT_END, so both planes must sit in one buffer that ends there: with
+ * separate plane buffers it read past the end of whichever plane lies lower
+ * and faulted. It also fetches whole MCU rows (16 for 4:2:0, 8 for 4:2:2);
+ * the luma overrun lands in the chroma rows, and the buffer carries the
+ * chroma rows up to the MCU boundary after the visible ones.
+ */
+struct apple_jpeg_layout {
+	u32 bytesperline;
+	u32 chroma_offset;
+	u32 sizeimage;
+};
+
+static inline void apple_jpeg_raw_layout(u32 width, u32 height, bool is422,
+					 struct apple_jpeg_layout *l)
+{
+	u32 rows = ALIGN(height, is422 ? 8 : 16);
+
+	l->bytesperline = ALIGN(width, 16);
+	l->chroma_offset = l->bytesperline * height;
+	l->sizeimage = l->chroma_offset + l->bytesperline * (is422 ? rows : rows / 2);
+}
+
+/* A kept CAPTURE size above the worst case is honoured up to this. */
+#define APPLE_JPEG_CODED_LIMIT		SZ_64M
+
+/*
+ * JPEG buffer size: the worst case at quality 100 plus headers, or @keep, a
+ * size already agreed with the client, when that is larger (bounded).
+ */
+static inline u32 apple_jpeg_coded_size(u32 width, u32 height, u32 keep)
+{
+	u64 need = PAGE_ALIGN((u64)width * height * 3 + SZ_16K);
+	u64 limit = max_t(u64, need, APPLE_JPEG_CODED_LIMIT);
+
+	if (keep > need)
+		need = min_t(u64, PAGE_ALIGN((u64)keep), limit);
+	return need;
+}
+
 /* Enough for the default image, the job and both quantisation tables. */
 #define APPLE_JPEG_MAX_WRITES		256
 
diff --git a/drivers/media/platform/apple/jpeg/apple-jpeg-test.c b/drivers/media/platform/apple/jpeg/apple-jpeg-test.c
index 8f8d49ade8..c5fc7c865d 100644
--- a/drivers/media/platform/apple/jpeg/apple-jpeg-test.c
+++ b/drivers/media/platform/apple/jpeg/apple-jpeg-test.c
@@ -150,12 +150,65 @@ static void apple_jpeg_job_reject_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, apple_jpeg_build_job(&job, w, 10), -ENOSPC);
 }
 
+/*
+ * One buffer: chroma straight after the visible luma rows, then chroma up to
+ * the MCU boundary. 1080p NV12: chroma at 1080 rows, 544 chroma rows.
+ */
+static void apple_jpeg_raw_layout_test(struct kunit *test)
+{
+	static const struct {
+		u32 w, h;
+		bool is422;
+		u32 bpl, chroma, size;
+	} cases[] = {
+		{ 1920, 1080, false, 1920, 1920 * 1080, 1920 * (1080 + 544) },
+		{ 1280, 720, false, 1280, 1280 * 720, 1280 * (720 + 360) },
+		{ 640, 480, false, 640, 640 * 480, 640 * (480 + 240) },
+		{ 3840, 2160, false, 3840, 3840 * 2160, 3840 * (2160 + 1080) },
+		/* Odd height and a width that pads the stride to 16. */
+		{ 642, 481, false, 656, 656 * 481, 656 * (481 + 248) },
+		/* 4:2:2 MCUs are 8 rows high and chroma has every row. */
+		{ 1920, 1084, true, 1920, 1920 * 1084, 1920 * (1084 + 1088) },
+	};
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(cases); i++) {
+		struct apple_jpeg_layout l;
+
+		apple_jpeg_raw_layout(cases[i].w, cases[i].h, cases[i].is422, &l);
+		KUNIT_EXPECT_EQ(test, l.bytesperline, cases[i].bpl);
+		KUNIT_EXPECT_EQ(test, l.chroma_offset, cases[i].chroma);
+		KUNIT_EXPECT_EQ(test, l.sizeimage, cases[i].size);
+		/* The 4-byte start alignment of luma carries to chroma. */
+		KUNIT_EXPECT_EQ(test, l.chroma_offset & 3, 0U);
+	}
+}
+
+/* A kept CAPTURE size survives OUTPUT changes, within the limit. */
+static void apple_jpeg_coded_size_test(struct kunit *test)
+{
+	u32 need720 = PAGE_ALIGN(1280 * 720 * 3 + SZ_16K);
+	u32 need1080 = PAGE_ALIGN(1920 * 1080 * 3 + SZ_16K);
+
+	KUNIT_EXPECT_EQ(test, apple_jpeg_coded_size(1280, 720, 0), need720);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_coded_size(1280, 720, 4096), need720);
+	/* CAPTURE was sized at the 1080p default before OUTPUT moved to 720p. */
+	KUNIT_EXPECT_EQ(test, apple_jpeg_coded_size(1280, 720, need1080), need1080);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_coded_size(1280, 720, need1080 - 1), need1080);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_coded_size(1280, 720, U32_MAX),
+			(u32)APPLE_JPEG_CODED_LIMIT);
+	/* The worst case at the largest size is above the limit and wins. */
+	KUNIT_EXPECT_EQ(test, apple_jpeg_coded_size(16384, 16384, U32_MAX),
+			(u32)PAGE_ALIGN(16384ULL * 16384 * 3 + SZ_16K));
+}
+
 static struct kunit_case apple_jpeg_cases[] = {
 	KUNIT_CASE(apple_jpeg_hwrev_test),
 	KUNIT_CASE(apple_jpeg_quant_test),
 	KUNIT_CASE(apple_jpeg_job_420_test),
 	KUNIT_CASE(apple_jpeg_job_422_test),
 	KUNIT_CASE(apple_jpeg_job_reject_test),
+	KUNIT_CASE(apple_jpeg_raw_layout_test),
+	KUNIT_CASE(apple_jpeg_coded_size_test),
 	{ }
 };
 
