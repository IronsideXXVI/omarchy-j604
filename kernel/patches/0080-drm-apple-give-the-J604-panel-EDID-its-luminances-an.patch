From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 15:56:36 +0000
Subject: [PATCH] drm/apple: give the J604 panel EDID its luminances
 and input depth

The panel EDID left the DisplayID display parameters' luminances at 0
(edid-decode shows 0.000031 cd/m2) and gave no colour depth, although
both are known for the MacBook Pro (14-inch, M4) panel:

- The ADT /backlight node: LmaxProduct 1600 nits (16.16), the peak over
  part of the screen, and aurora-maximum-nits 1000.0 (binary32), the SDR
  ceiling for bright surroundings that the whole screen holds; Apple's
  specifications give 1600 nits peak and 1000 nits sustained full-screen.
- macOS 27.2 on the J604: the panel's IOMobileFramebuffer colour element
  is RGB, SDR, Depth 8. The DCP takes deeper frames and dithers them to
  the panel's input; the input itself is 8 bits a component.

dcp_panel_id gains peak_nits, full_nits and bpc. The DisplayID 2.0
display parameters carry them as binary16 luminances (maximum over the
full screen and over 10 %; the minimum stays not given) and as the native
colour depth; the EDID 1.4 base block's digital input gets the same bit
depth; an HDR panel's CTA-861.3 metadata takes the full-screen maximum as
its maximum frame-average luminance instead of the peak. Unknown values
(0) leave every byte as before. The J604 profile gets panel_bpc 8; the
driver fills the luminances from the ADT it already reads.

Nothing in this driver reads display_info.bpc: the plane formats,
including 10-bit, are unchanged.

KUnit apple-dcp-panel-edid: the binary16 values (1, 600, 1000, 1600,
2047, 4095 rounding up to 4096, 65504, 0), the depth fields for 8, 10 and
an unknown depth, both checksums, and the connector reading back bpc 8,
max_cll 160 (1600 nits) and max_fall 138 (1000 nits).

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/dcp-m4-profile.h      | 11 +++
 drivers/gpu/drm/apple/dcp-panel-edid-test.c | 89 +++++++++++++++++++++
 drivers/gpu/drm/apple/dcp-panel-edid.c      | 66 +++++++++++++--
 drivers/gpu/drm/apple/dcp-panel-edid.h      |  8 ++
 drivers/gpu/drm/apple/iomfb_m4.c            |  8 ++
 5 files changed, 174 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-m4-profile.h b/drivers/gpu/drm/apple/dcp-m4-profile.h
index 29eca0da53..15f90b31cc 100644
--- a/drivers/gpu/drm/apple/dcp-m4-profile.h
+++ b/drivers/gpu/drm/apple/dcp-m4-profile.h
@@ -35,6 +35,11 @@ struct dcp_m4_profile {
 	 * 0 for none (appledrm.panel_vrr_min_hz given at boot overrides it).
 	 */
 	u16 vrr_min_hz;
+	/*
+	 * Bits a component of the panel's input, for the panel EDID; 0 if not
+	 * known. macOS reads it from the panel's colour element (Depth).
+	 */
+	u8 panel_bpc;
 	/*
 	 * HDR offered on the panel by default, shown as EDR up to the ADT peak
 	 * (appledrm.panel_edr given at boot overrides it).
@@ -136,6 +141,12 @@ static const struct dcp_m4_profile dcp_m4_profile_j604 = {
 	 * technical specifications). J713 and J715 keep VRR off.
 	 */
 	.vrr_min_hz = 48,
+	/*
+	 * The panel's input is 8 bits a component: macOS's IOMobileFramebuffer
+	 * ColorElements for it say Depth 8, RGB, SDR (the J604 under macOS 27.2).
+	 * The DCP dithers deeper frames down to it.
+	 */
+	.panel_bpc = 8,
 	/* Liquid Retina XDR: 1600 nits peak (ADT LmaxProduct), SDR 600. */
 	.edr = true,
 	/*
diff --git a/drivers/gpu/drm/apple/dcp-panel-edid-test.c b/drivers/gpu/drm/apple/dcp-panel-edid-test.c
index 96b0d281e1..afe1a28ed1 100644
--- a/drivers/gpu/drm/apple/dcp-panel-edid-test.c
+++ b/drivers/gpu/drm/apple/dcp-panel-edid-test.c
@@ -9,6 +9,7 @@
  */
 
 #include <kunit/test.h>
+#include <linux/unaligned.h>
 #include <linux/errno.h>
 #include <linux/hdmi.h>
 #include <linux/string.h>
@@ -407,6 +408,92 @@ static void panel_edid_update_publishes_vrr_range(struct kunit *test)
 	KUNIT_EXPECT_TRUE(test, list_empty(&connector->probed_modes));
 }
 
+/* The DisplayID display parameters: binary16 luminances and the native depth. */
+static void panel_edid_luminance_and_depth(struct kunit *test)
+{
+	static const struct { u16 nits; u16 half; } t[] = {
+		{ 1, 0x3c00 }, { 600, 0x60b0 }, { 1000, 0x63d0 }, { 1600, 0x6640 },
+		{ 2047, 0x67ff }, { 4095, 0x6c00 }, { 65504, 0x7bff }, { 0, 0 },
+	};
+	u8 *e = kunit_kzalloc(test, DCP_PANEL_EDID_HDR_BLOCKS * EDID_LENGTH, GFP_KERNEL);
+	const struct edid *base = (const struct edid *)e;
+	/* Extension tag, section header (4), block header (3): parameters at 136. */
+	const u8 *p = e + EDID_LENGTH + 8;
+	struct dcp_panel_id id;
+
+	KUNIT_ASSERT_NOT_NULL(test, e);
+	panel_id_j516(test, &id);
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	/* Nothing known: as before. */
+	KUNIT_EXPECT_EQ(test, base->input, DRM_EDID_INPUT_DIGITAL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(p + 21) | get_unaligned_le16(p + 23), 0);
+	KUNIT_EXPECT_EQ(test, p[27], 0x10);
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(t); i++) {
+		id.full_nits = t[i].nits;
+		id.peak_nits = t[i].nits;
+		KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+		KUNIT_EXPECT_EQ(test, get_unaligned_le16(p + 21), t[i].half);
+		KUNIT_EXPECT_EQ(test, get_unaligned_le16(p + 23), t[i].half);
+	}
+	/* The J604: 1000 over the full screen, 1600 over 10 %, input 8 bits. */
+	id.full_nits = 1000;
+	id.peak_nits = 1600;
+	id.bpc = 8;
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(p + 21), 0x63d0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(p + 23), 0x6640);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(p + 25), 0);
+	KUNIT_EXPECT_EQ(test, p[27], 0x10 | 2);
+	KUNIT_EXPECT_EQ(test, base->input, DRM_EDID_INPUT_DIGITAL | DRM_EDID_DIGITAL_DEPTH_8);
+	KUNIT_EXPECT_EQ(test, sum(e, EDID_LENGTH), 0);
+	KUNIT_EXPECT_EQ(test, sum(e + EDID_LENGTH, EDID_LENGTH), 0);
+	id.bpc = 10;
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	KUNIT_EXPECT_EQ(test, p[27], 0x10 | 3);
+	KUNIT_EXPECT_EQ(test, base->input, DRM_EDID_INPUT_DIGITAL | DRM_EDID_DIGITAL_DEPTH_10);
+	/* An unknown depth is not given. */
+	id.bpc = 7;
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	KUNIT_EXPECT_EQ(test, p[27], 0x10);
+	KUNIT_EXPECT_EQ(test, base->input, DRM_EDID_INPUT_DIGITAL);
+}
+
+/* The connector reads back the depth and the HDR maximum and frame average. */
+static void panel_edid_update_publishes_luminances(struct kunit *test)
+{
+	struct panel_edid_test *t;
+	struct drm_connector *connector;
+	struct dcp_panel_id id;
+	struct device *dev;
+	int ret;
+
+	dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	t = drm_kunit_helper_alloc_drm_device(test, dev, struct panel_edid_test, drm,
+					      DRIVER_MODESET);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, t);
+	connector = &t->connector;
+	ret = drmm_connector_init(&t->drm, connector, &panel_edid_connector_funcs,
+				  DRM_MODE_CONNECTOR_eDP, NULL);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	panel_id_j516(test, &id);
+	id.hdr_max_nits = 1600;
+	id.peak_nits = 1600;
+	id.full_nits = 1000;
+	id.bpc = 8;
+	mutex_lock(&t->drm.mode_config.mutex);
+	ret = dcp_panel_edid_update(connector, &id, J516_W_MM, J516_H_MM);
+	mutex_unlock(&t->drm.mode_config.mutex);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, connector->display_info.bpc, 8);
+	/* CTA-861.3 codes: 50 x 2^(cv / 32) <= nits: 1600 -> 160, 1000 -> 138. */
+	KUNIT_EXPECT_EQ(test, connector->display_info.hdr_sink_metadata.hdmi_type1.max_cll, 160);
+	KUNIT_EXPECT_EQ(test, connector->display_info.hdr_sink_metadata.hdmi_type1.max_fall, 138);
+	KUNIT_EXPECT_TRUE(test, list_empty(&connector->probed_modes));
+}
+
 static struct kunit_case panel_edid_cases[] = {
 	KUNIT_CASE(panel_id_from_compatible),
 	KUNIT_CASE(panel_id_needs_a_model_and_a_known_vendor),
@@ -418,6 +505,8 @@ static struct kunit_case panel_edid_cases[] = {
 	KUNIT_CASE(panel_edid_update_publishes_hdr),
 	KUNIT_CASE(panel_edid_vrr_range),
 	KUNIT_CASE(panel_edid_update_publishes_vrr_range),
+	KUNIT_CASE(panel_edid_luminance_and_depth),
+	KUNIT_CASE(panel_edid_update_publishes_luminances),
 	{}
 };
 
diff --git a/drivers/gpu/drm/apple/dcp-panel-edid.c b/drivers/gpu/drm/apple/dcp-panel-edid.c
index 2c97185806..79a89b2de2 100644
--- a/drivers/gpu/drm/apple/dcp-panel-edid.c
+++ b/drivers/gpu/drm/apple/dcp-panel-edid.c
@@ -86,6 +86,52 @@ static const u16 dcp_panel_p3[8] = { 6800, 3200, 2650, 6900, 1500, 600, 3127, 32
 #define DISPLAYID_NO_SPEAKERS	0x80	/* features: audio not integrated */
 #define DISPLAYID_TECH_LCD	0x10	/* device technology: active-matrix LCD */
 
+/*
+ * DisplayID 2.0 luminance: an IEEE 754 binary16 value in cd/m2, here from
+ * whole nits (1 to 65504), rounded to nearest; 0 stays 0 (not given).
+ */
+static u16 displayid_luminance(u32 nits)
+{
+	u32 e, m;
+
+	if (!nits)
+		return 0;
+	nits = min(nits, 65504U);
+	e = fls(nits) - 1;
+	m = DIV_ROUND_CLOSEST(nits << 10, 1U << e);
+	if (m == 2048) {
+		m = 1024;
+		e++;
+	}
+	return (e + 15) << 10 | (m - 1024);
+}
+
+/* DisplayID 2.0 native colour depth (bits 2:0 of the depth/technology byte). */
+static u8 displayid_depth(u8 bpc)
+{
+	switch (bpc) {
+	case 6: return 1;
+	case 8: return 2;
+	case 10: return 3;
+	case 12: return 4;
+	case 16: return 5;
+	default: return 0;
+	}
+}
+
+/* EDID 1.4 digital input: the colour bit depth field. */
+static u8 base_depth(u8 bpc)
+{
+	switch (bpc) {
+	case 6: return DRM_EDID_DIGITAL_DEPTH_6;
+	case 8: return DRM_EDID_DIGITAL_DEPTH_8;
+	case 10: return DRM_EDID_DIGITAL_DEPTH_10;
+	case 12: return DRM_EDID_DIGITAL_DEPTH_12;
+	case 16: return DRM_EDID_DIGITAL_DEPTH_16;
+	default: return DRM_EDID_DIGITAL_DEPTH_UNDEF;
+	}
+}
+
 int dcp_panel_id_from_compatible(struct dcp_panel_id *id, const char *compatible)
 {
 	const char *comma = strchr(compatible, ','), *model;
@@ -264,7 +310,7 @@ static int base_block(const struct dcp_panel_id *id, int width_mm, int height_mm
 	block->mfg_year = id->model_year - 1990;
 	block->version = 1;
 	block->revision = 4;
-	block->input = DRM_EDID_INPUT_DIGITAL;
+	block->input = DRM_EDID_INPUT_DIGITAL | base_depth(id->bpc);
 	block->width_cm = DIV_ROUND_CLOSEST(width_mm, 10);
 	block->height_cm = DIV_ROUND_CLOSEST(height_mm, 10);
 	block->gamma = DCP_PANEL_EDID_GAMMA;
@@ -329,8 +375,10 @@ static void displayid_block(const struct dcp_panel_id *id, int width_mm, int hei
 	p[8] = DISPLAYID_NO_SPEAKERS;
 	for (i = 0; i < 4; i++)
 		displayid_xy(p + 9 + 3 * i, dcp_panel_p3[2 * i], dcp_panel_p3[2 * i + 1]);
-	/* Bytes 21-26, the luminances, are not known: left 0. Colour depth not given. */
-	p[27] = DISPLAYID_TECH_LCD;
+	/* Bytes 21-26: maximum over the full screen and over 10 %, minimum (not given). */
+	put_le16(p + 21, displayid_luminance(id->full_nits));
+	put_le16(p + 23, displayid_luminance(id->peak_nits));
+	p[27] = DISPLAYID_TECH_LCD | displayid_depth(id->bpc);
 	p[28] = DCP_PANEL_EDID_GAMMA;
 
 	b = p + DISPLAYID_PARAMS_LEN;
@@ -404,12 +452,14 @@ static u8 cta_luminance(u32 nits)
 /*
  * The CTA-861 extension of an HDR panel: a Colorimetry block with BT.2020
  * RGB and an HDR Static Metadata block with the SDR and SMPTE ST 2084
- * transfer functions, metadata type 1, the peak as maximum and maximum
- * frame-average luminance, and no minimum (as Aurora's desktop 26.x panels).
+ * transfer functions, metadata type 1, the peak as maximum luminance, the
+ * full-screen maximum (else the peak) as maximum frame-average luminance,
+ * and no minimum (as Aurora's desktop 26.x panels).
  */
-static void cta_hdr_block(u16 max_nits, u8 *ext)
+static void cta_hdr_block(u16 max_nits, u16 avg_nits, u8 *ext)
 {
 	u8 *d = ext + 4, cv = cta_luminance(max_nits);
+	u8 avg = avg_nits && avg_nits < max_nits ? cta_luminance(avg_nits) : cv;
 
 	memset(ext, 0, EDID_LENGTH);
 	ext[0] = CEA_EXT;
@@ -426,7 +476,7 @@ static void cta_hdr_block(u16 max_nits, u8 *ext)
 	d[2] = BIT(0) | BIT(2);	/* traditional gamma SDR, SMPTE ST 2084 */
 	d[3] = BIT(0);		/* static metadata type 1 */
 	d[4] = cv;
-	d[5] = cv;
+	d[5] = avg;
 	d[6] = 0;
 	d += 7;
 	/* No detailed timings: they would start where the data blocks end. */
@@ -446,7 +496,7 @@ int dcp_panel_edid_build_hdr(const struct dcp_panel_id *id, int width_mm, int he
 		return ret;
 	((struct edid *)edid)->extensions = DCP_PANEL_EDID_HDR_BLOCKS - 1;
 	checksum(edid, EDID_LENGTH);
-	cta_hdr_block(id->hdr_max_nits, edid + 2 * EDID_LENGTH);
+	cta_hdr_block(id->hdr_max_nits, id->full_nits, edid + 2 * EDID_LENGTH);
 	return 0;
 }
 
diff --git a/drivers/gpu/drm/apple/dcp-panel-edid.h b/drivers/gpu/drm/apple/dcp-panel-edid.h
index 0e77def9f2..bb89eb1dbd 100644
--- a/drivers/gpu/drm/apple/dcp-panel-edid.h
+++ b/drivers/gpu/drm/apple/dcp-panel-edid.h
@@ -25,6 +25,14 @@ struct dcp_panel_id {
 	u16 model_year;				/* the model's year, 0 if unknown */
 	struct dcp_panel_timing timing;		/* zero if unknown */
 	u16 hdr_max_nits;			/* HDR peak for a CTA-861 block, 0: SDR */
+	/*
+	 * Luminances for the DisplayID display parameters, 0 if not known: the
+	 * peak over a tenth of the screen and the maximum over all of it.
+	 * With hdr_max_nits, full_nits is also the CTA maximum frame average.
+	 */
+	u16 peak_nits, full_nits;
+	/* Bits a component of the panel's own input, 0 if not known (6-16). */
+	u8 bpc;
 	/*
 	 * A variable refresh range, minimum and maximum in Hz (both 0: fixed);
 	 * the base block then carries a Display Range Limits descriptor.
diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index fcf45c2c98..9a255294d9 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -3267,6 +3267,14 @@ int iomfb_m4_panel_edid(struct apple_dcp *owner, struct drm_connector *connector
 	strscpy(id.name, dcp_m4_pf->name, sizeof(id.name));
 	id.model_year = dcp_m4_pf->model_year;
 	id.hdr_max_nits = dcp->edr_capable ? dcp->panel_peak : 0;
+	/*
+	 * From the ADT: LmaxProduct is the peak over a tenth of the screen, the
+	 * bright-surroundings SDR ceiling (aurora-maximum-nits) what the whole
+	 * screen holds (1600 and 1000 nits on the J604).
+	 */
+	id.peak_nits = min_t(u32, dcp->panel_peak, U16_MAX);
+	id.full_nits = min_t(u32, dcp->boost_max, U16_MAX);
+	id.bpc = dcp_m4_pf->panel_bpc;
 	id.timing = (struct dcp_panel_timing) {
 		.clock_khz = mode.clock,
 		.hdisplay = mode.hdisplay, .hsync_start = mode.hsync_start,
