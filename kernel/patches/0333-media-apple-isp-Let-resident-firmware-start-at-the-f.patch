From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 28 Oct 2026 09:44:07 -0400
Subject: [PATCH] media: apple: isp: Let resident firmware start at the first
 stream

Resident firmware is started at probe and runs while the driver is
bound, so the ISP stays powered from boot even when the camera is never
used. On the J713 (T8132) that costs about 100 mW, at idle and in
suspend-to-idle.

The video device can be registered without the firmware: its formats
come from the device tree presets. Let a SoC defer the firmware start
and the camera detection to the first stream start; from then on the
firmware stays resident as before. Opening the device or listing its
formats does not start it, as desktop services open every video node at
login. On the J713 the deferred start, from power-up to a detected
camera, adds about 0.2 s to the first VIDIOC_STREAMON.

Deferring moves what detection checks to that first stream: an
unsupported sensor, unexpected metadata sizes or a missing channel now
fail it instead of probe, and leave the camera unusable until the next
boot, like any failed resident start. Presets the firmware lacks can no
longer be dropped from the formats userspace has already seen, so a
stream on one is refused with -EINVAL instead. For the same reason a
deferred start keeps the device tree presets: the IMX958 configuration
discovery and P010 preview, which add formats at detection, stay with
starts at probe.

A KUnit case checks that only resident firmware defers its start.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 6d95eef30f957d73e06f12b9bee6f9b21cf5c630)
---
 drivers/media/platform/apple/isp/isp-cam.c    | 33 ++++++++++++++++++-
 .../media/platform/apple/isp/isp-drv-test.c   | 31 +++++++++++++++--
 drivers/media/platform/apple/isp/isp-drv.c    | 14 ++++----
 drivers/media/platform/apple/isp/isp-drv.h    | 18 ++++++++--
 drivers/media/platform/apple/isp/isp-fw.c     |  5 +--
 5 files changed, 87 insertions(+), 14 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 004a7fa13d..9b6d7a0f06 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -209,6 +209,23 @@ static int isp_check_presets(struct apple_isp *isp, u32 num_fw_presets)
 	if (!num_fw_presets)
 		return 0;
 
+	/*
+	 * A deferred start detects the camera after the presets were
+	 * advertised: keep them, and refuse a stream on one the firmware
+	 * lacks instead.
+	 */
+	if (isp->hw->resident_fw_deferred) {
+		isp->num_fw_presets = num_fw_presets;
+		for (int i = 0; i < isp->num_presets; i++)
+			if (isp->presets[i].index >= num_fw_presets)
+				dev_warn(isp->dev,
+					 "%ux%u preset: config %u, firmware has %u\n",
+					 isp->presets[i].output_dim.x,
+					 isp->presets[i].output_dim.y,
+					 isp->presets[i].index, num_fw_presets);
+		return 0;
+	}
+
 	for (int i = 0; i < isp->num_presets; i++) {
 		struct isp_preset *preset = &isp->presets[i];
 
@@ -568,6 +585,8 @@ int apple_isp_detect_camera(struct apple_isp *isp)
 	if (isp->hw->resident_fw) {
 		if (err)
 			apple_isp_firmware_halt(isp);
+		else
+			isp->camera_detected = true;
 		return err;
 	}
 
@@ -955,14 +974,26 @@ static int isp_configure_capture(struct apple_isp *isp)
 
 int apple_isp_start_camera(struct apple_isp *isp)
 {
+	struct isp_format *fmt = isp_get_current_format(isp);
 	int err;
 
-	err = apple_isp_firmware_boot(isp);
+	/* A deferred start boots the firmware and detects the camera now. */
+	if (isp->hw->resident_fw_deferred && !isp->camera_detected)
+		err = apple_isp_detect_camera(isp);
+	else
+		err = apple_isp_firmware_boot(isp);
 	if (err < 0) {
 		dev_err(isp->dev, "failed to boot firmware: %d\n", err);
 		return err;
 	}
 
+	if (isp->num_fw_presets && fmt->preset->index >= isp->num_fw_presets) {
+		dev_err(isp->dev, "preset config %u: firmware has %u\n",
+			fmt->preset->index, isp->num_fw_presets);
+		apple_isp_firmware_shutdown(isp);
+		return -EINVAL;
+	}
+
 	err = isp_configure_capture(isp);
 	if (err) {
 		dev_err(isp->dev, "failed to configure capture: %d\n", err);
diff --git a/drivers/media/platform/apple/isp/isp-drv-test.c b/drivers/media/platform/apple/isp/isp-drv-test.c
index a31cf2bfa8..ca86f58968 100644
--- a/drivers/media/platform/apple/isp/isp-drv-test.c
+++ b/drivers/media/platform/apple/isp/isp-drv-test.c
@@ -1,7 +1,8 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * KUnit tests for the DART address filter windows of the Apple ISP driver,
- * built into isp-drv.c. They need no hardware.
+ * KUnit tests for the per-SoC data of the Apple ISP driver, built into
+ * isp-drv.c: the DART address filter windows and the firmware start. They
+ * need no hardware.
  */
 
 #include <kunit/device.h>
@@ -97,3 +98,29 @@ static struct kunit_suite isp_dapf_test_suite = {
 };
 
 kunit_test_suite(isp_dapf_test_suite);
+
+/* Only resident firmware may defer its start: it is detected once. */
+static void isp_test_deferred_is_resident(struct kunit *test)
+{
+	const struct of_device_id *match;
+
+	for (match = apple_isp_of_match; match->compatible[0]; match++) {
+		const struct apple_isp_hw *hw = match->data;
+
+		if (hw->resident_fw_deferred)
+			KUNIT_EXPECT_TRUE_MSG(test, hw->resident_fw, "%s",
+					      match->compatible);
+	}
+}
+
+static struct kunit_case isp_hw_test_cases[] = {
+	KUNIT_CASE(isp_test_deferred_is_resident),
+	{}
+};
+
+static struct kunit_suite isp_hw_test_suite = {
+	.name = "apple-isp-hw",
+	.test_cases = isp_hw_test_cases,
+};
+
+kunit_test_suite(isp_hw_test_suite);
diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index 5e816ed8d5..fa96e83219 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -650,10 +650,12 @@ static int apple_isp_probe(struct platform_device *pdev)
 
 	pm_runtime_enable(dev);
 
-	err = apple_isp_detect_camera(isp);
-	if (err) {
-		dev_err(dev, "failed to detect camera: %d\n", err);
-		goto free_surface;
+	if (!isp->hw->resident_fw_deferred) {
+		err = apple_isp_detect_camera(isp);
+		if (err) {
+			dev_err(dev, "failed to detect camera: %d\n", err);
+			goto free_surface;
+		}
 	}
 
 	err = apple_isp_setup_video(isp);
@@ -1029,8 +1031,8 @@ static __maybe_unused int apple_isp_freeze(struct device *dev)
 	/*
 	 * Hibernation hands the system from one kernel to another, and
 	 * firmware left running would go on using the memory of the kernel
-	 * that started it. Stop it cleanly instead; the camera is then
-	 * unavailable until the next system boot.
+	 * that started it. Stop it cleanly instead; if it ran, the camera is
+	 * then unavailable until the next system boot.
 	 */
 	if (isp->hw->resident_fw) {
 		mutex_lock(&isp->video_lock);
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 70c647fcea..1e938dcd55 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -222,10 +222,17 @@ struct apple_isp_hw {
 	bool meta_exposure;
 
 	/*
-	 * The firmware can be started only once per system boot, so it is
-	 * started at probe and kept running while the driver is bound.
+	 * The firmware can be started only once per system boot, so once
+	 * started it is kept running while the driver is bound. It starts at
+	 * probe, or at the first stream with resident_fw_deferred.
 	 */
 	bool resident_fw;
+
+	/*
+	 * With resident_fw: start the firmware, and detect the camera, at the
+	 * first stream instead of at probe, so the ISP stays off until then.
+	 */
+	bool resident_fw_deferred;
 };
 
 enum isp_sensor_id {
@@ -365,6 +372,10 @@ struct apple_isp {
 	} fw;
 	/* changes under video_lock once the video device is registered */
 	enum isp_fw_state fw_state;
+	/* the camera was detected; until then a deferred start is pending */
+	bool camera_detected;
+	/* configurations the firmware has, once a deferred start detected them */
+	u32 num_fw_presets;
 
 	struct isp_surf *ipc_surf;
 	struct isp_surf *extra_surf;
@@ -463,7 +474,8 @@ int apple_isp_program_dapf(struct apple_isp *isp);
 
 static inline bool isp_supports_p010(struct apple_isp *isp)
 {
-	return isp->hw->gen == ISP_GEN_T6040 &&
+	/* Its config discovery would change formats already advertised. */
+	return isp->hw->gen == ISP_GEN_T6040 && !isp->hw->resident_fw_deferred &&
 	       isp_get_current_format(isp)->version == 0x958;
 }
 
diff --git a/drivers/media/platform/apple/isp/isp-fw.c b/drivers/media/platform/apple/isp/isp-fw.c
index d892841470..45ce027b58 100644
--- a/drivers/media/platform/apple/isp/isp-fw.c
+++ b/drivers/media/platform/apple/isp/isp-fw.c
@@ -1045,7 +1045,8 @@ static void isp_firmware_shutdown(struct apple_isp *isp)
  * Resident firmware (hw->resident_fw) is loaded by the bootloader and
  * does not start again once it has been stopped: after CISP_CMD_SUSPEND,
  * a coprocessor reset and a power cycle of its domains it never completes
- * the first handshake. It is booted once, at probe, and runs until the
+ * the first handshake. It is booted once, at probe or with
+ * resident_fw_deferred at the first stream, and runs until the
  * driver is unbound, probe fails or the system hibernates, also across
  * suspend; after it has stopped the device stays unusable until the next
  * system boot.
@@ -1091,7 +1092,7 @@ int apple_isp_firmware_boot(struct apple_isp *isp)
 	return 0;
 }
 
-/* The end of a stream or of the camera detection at probe */
+/* The end of a stream or of the camera detection */
 void apple_isp_firmware_shutdown(struct apple_isp *isp)
 {
 	if (!isp->hw->resident_fw) {
