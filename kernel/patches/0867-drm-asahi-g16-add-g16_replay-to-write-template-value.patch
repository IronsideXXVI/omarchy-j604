         firmware.engine.shared = Some(self.clone());
@@ -1801,6 +1811,7 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
             params::rekick_us(),
             self.session.shared.irq_bells.load(Ordering::Relaxed)
         )?;
