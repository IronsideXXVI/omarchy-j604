diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 35bbaa6f93..3f5008df8f 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2287,6 +2287,24 @@ pub(crate) fn resident_lazy_async() -> bool {
     "G16: a VM's first render builds only its two full render units; the others are built when it queues deeper: 1 in SUBMIT, 2 by a worker (default 0: all at the first render; read when a VM builds units)"
 );
 
+/// Storage of `g16_replay` (runtime 0644, default 0).
+static REPLAY: AtomicU32 = AtomicU32::new(0);
+
+/// The pieces of the `aurora-g16/replay` template applied to each compute command: bit k
+/// applies the template entries of piece k (0: none, the default).
+pub(crate) fn replay() -> u32 {
+    REPLAY.load(Ordering::Relaxed)
+}
+
+live_u32_param!(
+    REPLAY_PARAM,
+    REPLAY_PARMTYPE,
+    REPLAY_PARM,
+    REPLAY,
+    "g16_replay",
+    "G16: mask of template pieces (aurora-g16/replay) written into each compute command's sequence record over this driver's values; addresses are never replaced (default 0: none; runtime 0644)"
+);
+
 /// Storage of `g16_resident_units` (0644, default 0; read once, at the latch).
 static RESIDENT_UNITS: AtomicU32 = AtomicU32::new(0);
 
