From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 08:06:47 +0000
Subject: [PATCH] phy: apple: atc: add a bring-up switch for a test mem
 sleep that is not firmware-driven

On T8132 an active PHY with a host on it may only take suspend-to-idle.
Add phy_apple_atc.debug_allow_mem, default off: a suspend-to-RAM that is
not declared firmware-driven (apple_s2r.debug_begin_as_idle, pm_test
only) passes that check as suspend-to-idle does. A firmware-driven sleep
is not affected.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/phy/apple/atc.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/drivers/phy/apple/atc.c b/drivers/phy/apple/atc.c
index e8dfef11eb..5528ed5163 100644
--- a/drivers/phy/apple/atc.c
+++ b/drivers/phy/apple/atc.c
@@ -7276,6 +7276,15 @@ static void atcphy_sleep_lost_cio(struct apple_atcphy *atcphy)
 		atcphy->mode);
 }
 
+/*
+ * Bring-up: a test suspend-to-RAM that is not declared firmware-driven
+ * (apple_s2r.debug_begin_as_idle, pm_test only) is taken as suspend-to-idle
+ * by the T8132 sleep check below. Default off.
+ */
+static bool debug_allow_mem;
+module_param(debug_allow_mem, bool, 0644);
+MODULE_PARM_DESC(debug_allow_mem, "Bring-up: let a suspend-to-RAM that is not firmware-driven (apple_s2r.debug_begin_as_idle) pass as for suspend-to-idle (default: off)");
+
 static int atcphy_suspend(struct device *dev)
 {
 	struct apple_atcphy *atcphy = dev_get_drvdata(dev);
@@ -7299,7 +7308,9 @@ static int atcphy_suspend(struct device *dev)
 	 * domain was off, see atcphy_restore_after_pd_off().
 	 */
 	if (atcphy->t8132_common_owned && !atcphy->dp_only &&
-	    (!atcphy->host_active || pm_suspend_target_state != PM_SUSPEND_TO_IDLE) &&
+	    (!atcphy->host_active ||
+	     (pm_suspend_target_state != PM_SUSPEND_TO_IDLE &&
+	      !(READ_ONCE(debug_allow_mem) && !pm_suspend_via_firmware()))) &&
 	    !(atcphy->sleep_lose && atcphy->host_active) && !atcphy_cio_may_lose(atcphy))
 		return -EBUSY;
 	/* Do not admit a new epoch after this check and before resume. */
