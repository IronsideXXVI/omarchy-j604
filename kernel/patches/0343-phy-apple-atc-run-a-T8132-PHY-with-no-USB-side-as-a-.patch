From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 05:11:54 +0000
Subject: [PATCH] phy: apple: atc: run a T8132 PHY with no USB side as
 a four-lane DP PHY

The J604 (MacBook Pro 14-inch, M4) has its HDMI port on ATC2, an ATC
PHY with no USB controller: the ADT names it atc2-dpphy, a fixed,
untunnelled DisplayPort PHY feeding an on-board DP-to-HDMI converter,
as ATC3 on the M3 Pro MacBook Pros. The T8132 path only ran DisplayPort
inside USB4 tunnels so far.

Treat a T8132 PHY that is described with its banks but without the
USB2 PHY and PIPE windows as DisplayPort-only, like a T8122 one, and
give it APPLE_ATCPHY_MODE_DP:

 - probe maps only the banks, loads the bank calibration and the AUX
   calibration (apple,tunable-usb3-dp), no lane or CIO tunables, and
   creates only the DP PHY; a common-power epoch left by the boot chain
   is stopped, since nothing else runs on this PHY;
 - the Type-C mux keeps DP for it instead of falling back to USB2, and
   refuses every other mode;
 - DP is the USB3 power-up from cold without the USB2 PHY: the bank
   calibration, the AUX calibration, both lanes on DP and the DP
   crossbar (from the mode table, see atcphy_t8132_lane_mode() and
   atcphy_t8132_crossbar()), the eFuse calibration, the PHY reset, the
   common block start, then the T8122 AUX block;
 - the link rate and drive levels then go through the T8122 DP code
   (phy_configure), DPTX Activate/Deactivate are no-ops as on T8122;
 - leaving DP stops the link and AUX, then the common block as after
   CIO (no PIPE BIST step);
 - system sleep is not refused for it: DP is set up again after its
   domain was off.

The USB3 path is unchanged; KUnit checks that the table-derived words
match its hard-coded ones.

[j604: no upstream commit exists for T8132 native DP (searched the
 AsahiLinux and Aurora trees). The four-lane DP words 0x492/0x22014
 are derived from the T8122 mode table with the T8132 field layout that
 reproduces the USB3 words (INFERENCE); the power-up order and the reuse
 of the T8122 AUX/AUSPLL sequences on T8132 are INFERENCE. TO-VERIFY:
 static check against macOS AppleT8132TypeCPhy, then the desk batch
 (HDMI check).]

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/phy/apple/atc-test.c | 137 +++++++++++++++++++++++++++++++
 drivers/phy/apple/atc.c      | 153 ++++++++++++++++++++++++++++-------
 2 files changed, 259 insertions(+), 31 deletions(-)

diff --git a/drivers/phy/apple/atc-test.c b/drivers/phy/apple/atc-test.c
index 09eec7f9d6..9224eb4ae3 100644
--- a/drivers/phy/apple/atc-test.c
+++ b/drivers/phy/apple/atc-test.c
@@ -1450,3 +1450,140 @@ static struct kunit_suite atcphy_t8132_pm_test_suite = {
 };
 
 kunit_test_suite(atcphy_t8132_pm_test_suite);
+
+/*
+ * A T8132 DisplayPort-only PHY (ATC2 behind the J604 HDMI port). The checks
+ * here stop before any register access: the power handshake needs hardware.
+ */
+static struct apple_atcphy *atcphy_test_alloc_t8132_dp(struct kunit *test, bool tunables)
+{
+	struct apple_atcphy *atcphy = atcphy_test_alloc_powered_off(test);
+
+	atcphy->hw = &atcphy_hw_t8132;
+	atcphy->t8132_ss = true;
+	atcphy->dp_only = true;
+	atcphy->dp_tunables = tunables;
+	atcphy->typec_mode = APPLE_ATCPHY_MODE_OFF;
+
+	return atcphy;
+}
+
+/* The words derived from the mode table are those the USB3 path writes. */
+static void atcphy_test_t8132_lane_words(struct kunit *test)
+{
+	const struct atcphy_mode_configuration *usb3 =
+		&atcphy_modes[APPLE_ATCPHY_MODE_USB3_DP].normal;
+	const struct atcphy_mode_configuration *usb3_swapped =
+		&atcphy_modes[APPLE_ATCPHY_MODE_USB3_DP].swapped;
+	const struct atcphy_mode_configuration *dp = &atcphy_modes[APPLE_ATCPHY_MODE_DP].normal;
+	const struct atcphy_mode_configuration *dp_swapped =
+		&atcphy_modes[APPLE_ATCPHY_MODE_DP].swapped;
+
+	KUNIT_EXPECT_EQ(test, atcphy_t8132_lane_mode(usb3), 0x489U);
+	KUNIT_EXPECT_EQ(test, atcphy_t8132_crossbar(usb3), 0x110U);
+	KUNIT_EXPECT_EQ(test, atcphy_t8132_lane_mode(usb3_swapped), 0x252U);
+	KUNIT_EXPECT_EQ(test, atcphy_t8132_crossbar(usb3_swapped), 0x111U);
+	KUNIT_EXPECT_TRUE(test, usb3_swapped->set_swap);
+
+	/* Four DP lanes: DP in every lane field, DP protocol on both PMAs. */
+	KUNIT_EXPECT_EQ(test, atcphy_t8132_lane_mode(dp), 0x492U);
+	KUNIT_EXPECT_EQ(test, atcphy_t8132_crossbar(dp), 0x22014U);
+	KUNIT_EXPECT_FALSE(test, dp->set_swap);
+	KUNIT_EXPECT_EQ(test, atcphy_t8132_lane_mode(dp_swapped), 0x492U);
+	KUNIT_EXPECT_EQ(test, atcphy_t8132_crossbar(dp_swapped), 0x114U);
+}
+
+/* The fixed output's DP request keeps DP instead of falling back to USB2. */
+static void atcphy_test_t8132_dp_target_mode(struct kunit *test)
+{
+	struct typec_altmode alt = { .svid = USB_TYPEC_DP_SID };
+	struct typec_mux_state state = { .alt = &alt, .mode = TYPEC_DP_STATE_C };
+	struct apple_atcphy *atcphy = atcphy_test_alloc_t8132_dp(test, true);
+
+	KUNIT_EXPECT_EQ(test, atcphy_typec_target_mode(atcphy, &state), APPLE_ATCPHY_MODE_DP);
+	state.mode = TYPEC_DP_STATE_E;
+	KUNIT_EXPECT_EQ(test, atcphy_typec_target_mode(atcphy, &state), APPLE_ATCPHY_MODE_DP);
+	state.alt = NULL;
+	state.mode = TYPEC_STATE_SAFE;
+	KUNIT_EXPECT_EQ(test, atcphy_typec_target_mode(atcphy, &state), APPLE_ATCPHY_MODE_OFF);
+
+	/* A Type-C port's T8132 PHY still serves the USB2 beside DP lanes. */
+	atcphy->dp_only = false;
+	state.alt = &alt;
+	state.mode = TYPEC_DP_STATE_C;
+	KUNIT_EXPECT_EQ(test, atcphy_typec_target_mode(atcphy, &state), APPLE_ATCPHY_MODE_USB2);
+}
+
+static void atcphy_test_t8132_dp_mux_check(struct kunit *test)
+{
+	struct apple_atcphy *atcphy = atcphy_test_alloc_t8132_dp(test, true);
+
+	KUNIT_EXPECT_EQ(test, atcphy_mux_check(atcphy, APPLE_ATCPHY_MODE_DP), 0);
+	KUNIT_EXPECT_EQ(test, atcphy_mux_check(atcphy, APPLE_ATCPHY_MODE_OFF), 0);
+	KUNIT_EXPECT_EQ(test, atcphy_mux_check(atcphy, APPLE_ATCPHY_MODE_USB3), -EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, atcphy_mux_check(atcphy, APPLE_ATCPHY_MODE_USB2), -EOPNOTSUPP);
+
+	/* Without the AUX calibration there is no DisplayPort. */
+	atcphy->dp_tunables = false;
+	KUNIT_EXPECT_EQ(test, atcphy_mux_check(atcphy, APPLE_ATCPHY_MODE_DP), -EOPNOTSUPP);
+
+	/* Nor on a Type-C port's T8132 PHY. */
+	atcphy->dp_only = false;
+	atcphy->dp_tunables = true;
+	KUNIT_EXPECT_EQ(test, atcphy_mux_check(atcphy, APPLE_ATCPHY_MODE_DP), -ENODEV);
+}
+
+/* Refusals return before the first register access. */
+static void atcphy_test_t8132_dp_configure_refused(struct kunit *test)
+{
+	struct apple_atcphy *atcphy = atcphy_test_alloc_t8132_dp(test, false);
+
+	scoped_guard(mutex, &atcphy->lock) {
+		KUNIT_EXPECT_EQ(test, atcphy_configure_t8132(atcphy, APPLE_ATCPHY_MODE_DP),
+				-EOPNOTSUPP);
+		atcphy->dp_tunables = true;
+		KUNIT_EXPECT_EQ(test, atcphy_configure_t8132(atcphy, APPLE_ATCPHY_MODE_USB3),
+				-EOPNOTSUPP);
+		KUNIT_EXPECT_EQ(test, atcphy_configure_t8132(atcphy, APPLE_ATCPHY_MODE_USB2),
+				-EOPNOTSUPP);
+		atcphy->t8132_suspended = true;
+		KUNIT_EXPECT_EQ(test, atcphy_configure_t8132(atcphy, APPLE_ATCPHY_MODE_DP),
+				-EBUSY);
+		atcphy->t8132_suspended = false;
+		atcphy->dp_only = false;
+		KUNIT_EXPECT_EQ(test, atcphy_configure_t8132(atcphy, APPLE_ATCPHY_MODE_DP),
+				-EOPNOTSUPP);
+	}
+	KUNIT_EXPECT_EQ(test, atcphy->mode, APPLE_ATCPHY_MODE_OFF);
+	KUNIT_EXPECT_FALSE(test, atcphy->t8132_common_owned);
+}
+
+/* DPTX Activate and Deactivate on the fixed output. */
+static void atcphy_test_t8132_dp_set_mode(struct kunit *test)
+{
+	struct apple_atcphy *atcphy = atcphy_test_alloc_t8132_dp(test, true);
+
+	KUNIT_EXPECT_EQ(test, atcphy_dpphy_set_mode_t8132(atcphy, PHY_MODE_DP), 0);
+	KUNIT_EXPECT_EQ(test, atcphy_dpphy_set_mode_t8132(atcphy, PHY_MODE_INVALID), 0);
+	KUNIT_EXPECT_EQ(test, atcphy_dpphy_set_mode_t8132(atcphy, PHY_MODE_USB_HOST),
+			-EOPNOTSUPP);
+	/* A Type-C port's T8132 PHY outside a tunnel refuses DP. */
+	atcphy->dp_only = false;
+	KUNIT_EXPECT_EQ(test, atcphy_dpphy_set_mode_t8132(atcphy, PHY_MODE_DP), -EOPNOTSUPP);
+}
+
+static struct kunit_case atcphy_t8132_dp_test_cases[] = {
+	KUNIT_CASE(atcphy_test_t8132_lane_words),
+	KUNIT_CASE(atcphy_test_t8132_dp_target_mode),
+	KUNIT_CASE(atcphy_test_t8132_dp_mux_check),
+	KUNIT_CASE(atcphy_test_t8132_dp_configure_refused),
+	KUNIT_CASE(atcphy_test_t8132_dp_set_mode),
+	{}
+};
+
+static struct kunit_suite atcphy_t8132_dp_test_suite = {
+	.name = "phy-apple-atc-t8132-dp",
+	.test_cases = atcphy_t8132_dp_test_cases,
+};
+
+kunit_test_suite(atcphy_t8132_dp_test_suite);
diff --git a/drivers/phy/apple/atc.c b/drivers/phy/apple/atc.c
index c92f3ae567..960c04f7f9 100644
--- a/drivers/phy/apple/atc.c
+++ b/drivers/phy/apple/atc.c
@@ -1256,6 +1256,28 @@ static const struct atcphy_mode_configuration *atcphy_get_mode_config(struct app
 		return &atcphy_modes[mode].normal;
 }
 
+/*
+ * The T8132 lane mode and crossbar words for @cfg, in the T8122 layout that
+ * atcphy_configure_lanes() writes field by field. From the mode table they
+ * give the USB3 words atcphy_configure_t8132() writes (0x489 and 0x110, with
+ * the plug flipped 0x252 and 0x111), and 0x492 and 0x22014 for DisplayPort
+ * on all four lanes.
+ */
+static u32 atcphy_t8132_lane_mode(const struct atcphy_mode_configuration *cfg)
+{
+	return FIELD_PREP(ACIOPHY_LANE_MODE_RX0, cfg->lane_mode[0]) |
+	       FIELD_PREP(ACIOPHY_LANE_MODE_TX0, cfg->lane_mode[0]) |
+	       FIELD_PREP(ACIOPHY_LANE_MODE_RX1, cfg->lane_mode[1]) |
+	       FIELD_PREP(ACIOPHY_LANE_MODE_TX1, cfg->lane_mode[1]);
+}
+
+static u32 atcphy_t8132_crossbar(const struct atcphy_mode_configuration *cfg)
+{
+	return FIELD_PREP(ACIOPHY_CROSSBAR_PROTOCOL, cfg->crossbar) |
+	       FIELD_PREP(ACIOPHY_CROSSBAR_DP_SINGLE_PMA, cfg->crossbar_dp_single_pma) |
+	       (cfg->crossbar_dp_both_pma ? ACIOPHY_CROSSBAR_DP_BOTH_PMA : 0);
+}
+
 /* Readback only; callers hold the PHY mutex and keep the fixed host live. */
 static inline u32 core_read32(struct apple_atcphy *atcphy, u32 reg)
 {
@@ -3953,11 +3975,17 @@ static void atcphy_t8132_cio_start(struct apple_atcphy *atcphy)
 static int atcphy_configure_t8132(struct apple_atcphy *atcphy, enum atcphy_mode mode)
 {
 	bool cio = atcphy_mode_is_cio(mode);
+	bool dp = mode == APPLE_ATCPHY_MODE_DP;
 	u32 reg;
 	int ret;
 
+	/* A DisplayPort-only PHY runs its four lanes, or nothing. */
+	if (atcphy->dp_only && mode != APPLE_ATCPHY_MODE_OFF && !dp)
+		return -EOPNOTSUPP;
+	if (dp && (!atcphy->dp_only || !atcphy->dp_tunables))
+		return -EOPNOTSUPP;
 	if (mode != APPLE_ATCPHY_MODE_OFF && mode != APPLE_ATCPHY_MODE_USB2 &&
-	    mode != APPLE_ATCPHY_MODE_USB3 && mode != APPLE_ATCPHY_MODE_USB3_DP && !cio)
+	    mode != APPLE_ATCPHY_MODE_USB3 && mode != APPLE_ATCPHY_MODE_USB3_DP && !cio && !dp)
 		return -EOPNOTSUPP;
 	if (cio && !atcphy->cio_tunables)
 		return -EOPNOTSUPP;
@@ -3968,7 +3996,7 @@ static int atcphy_configure_t8132(struct apple_atcphy *atcphy, enum atcphy_mode
 		return -ENODEV;
 	if (atcphy->t8132_failed)
 		return -EIO;
-	if ((mode == APPLE_ATCPHY_MODE_USB3 || mode == APPLE_ATCPHY_MODE_USB3_DP || cio) &&
+	if ((mode == APPLE_ATCPHY_MODE_USB3 || mode == APPLE_ATCPHY_MODE_USB3_DP || cio || dp) &&
 	    atcphy->t8132_suspended)
 		return -EBUSY;
 	if (atcphy->pipe_pending || atcphy->pipe_state != ATCPHY_PIPEHANDLER_STATE_DUMMY)
@@ -3982,7 +4010,11 @@ static int atcphy_configure_t8132(struct apple_atcphy *atcphy, enum atcphy_mode
 		return ret;
 	atcphy->mode_dirty = true;
 	if (atcphy->t8132_common_owned) {
-		if (atcphy->mode == APPLE_ATCPHY_MODE_USB3_DP)
+		/* DisplayPort ran no USB PIPE: no BIST step, as after CIO. */
+		if (atcphy->mode == APPLE_ATCPHY_MODE_DP) {
+			atcphy_dp_stop_t8122(atcphy);
+			ret = atcphy_t8132_phy_stop(atcphy);
+		} else if (atcphy->mode == APPLE_ATCPHY_MODE_USB3_DP)
 			ret = atcphy_t8132_full_stop(atcphy);
 		else if (atcphy_mode_is_cio(atcphy->mode))
 			ret = atcphy_t8132_phy_stop(atcphy);
@@ -3997,7 +4029,9 @@ static int atcphy_configure_t8132(struct apple_atcphy *atcphy, enum atcphy_mode
 		atcphy->t8132_common_owned = false;
 	}
 	if (mode == APPLE_ATCPHY_MODE_OFF) {
-		atcphy_usb2_power_off(atcphy);
+		/* A DisplayPort-only PHY has no USB2 PHY window. */
+		if (!atcphy->dp_only)
+			atcphy_usb2_power_off(atcphy);
 		goto done;
 	}
 	if (mode == APPLE_ATCPHY_MODE_USB2) {
@@ -4020,8 +4054,10 @@ static int atcphy_configure_t8132(struct apple_atcphy *atcphy, enum atcphy_mode
 			core_read32(atcphy, ATCPHY_MISC));
 		return -EBUSY;
 	}
-	atcphy_usb2_power_on(atcphy);
-	ndelay(500);
+	if (!atcphy->dp_only) {
+		atcphy_usb2_power_on(atcphy);
+		ndelay(500);
+	}
 	/* A touched failure retains this epoch without guessing a rollback. */
 	atcphy->t8132_common_owned = true;
 	core_set32(atcphy, ATCPHY_MISC, ATCPHY_MISC_RESET_N);
@@ -4055,22 +4091,40 @@ static int atcphy_configure_t8132(struct apple_atcphy *atcphy, enum atcphy_mode
 	for (unsigned int i = T8132_AXI2AF; i <= T8132_COMMON; i++)
 		apple_tunable_apply(atcphy->t8132_banks[i].regs,
 				    atcphy->t8132_banks[i].tunable);
-	apple_tunable_apply(atcphy->regs.core,
-			    atcphy->tunables.lane_usb3[atcphy->swap_lanes ? 1 : 0]);
-	if (mode == APPLE_ATCPHY_MODE_USB3_DP)
+	if (dp) {
+		const struct atcphy_mode_configuration *cfg =
+			atcphy_get_mode_config(atcphy, mode);
+
+		/*
+		 * The DP lanes are programmed and started by the link rate
+		 * sequence, see atcphy_dp_set_rate_t8122(); here only the AUX
+		 * calibration, both lanes on DP and the DP crossbar.
+		 */
 		apple_tunable_apply(atcphy->regs.core, atcphy->tunables.usb3_dp);
-	core_mask32(atcphy, ACIOPHY_LANE_MODE_T8122, GENMASK(11, 0),
-		    atcphy->swap_lanes ? 0x252 : 0x489);
-	core_mask32(atcphy, ACIOPHY_CROSSBAR_T8122, GENMASK(16, 0),
-		    atcphy->swap_lanes ? 0x111 : 0x110);
-	core_mask32(atcphy, ATCPHY_MISC, ATCPHY_MISC_LANE_SWAP,
-		    atcphy->swap_lanes ? ATCPHY_MISC_LANE_SWAP : 0);
+		core_mask32(atcphy, ACIOPHY_LANE_MODE_T8122, GENMASK(11, 0),
+			    atcphy_t8132_lane_mode(cfg));
+		core_mask32(atcphy, ACIOPHY_CROSSBAR_T8122, GENMASK(17, 0),
+			    atcphy_t8132_crossbar(cfg));
+		core_mask32(atcphy, ATCPHY_MISC, ATCPHY_MISC_LANE_SWAP,
+			    cfg->set_swap ? ATCPHY_MISC_LANE_SWAP : 0);
+	} else {
+		apple_tunable_apply(atcphy->regs.core,
+				    atcphy->tunables.lane_usb3[atcphy->swap_lanes ? 1 : 0]);
+		if (mode == APPLE_ATCPHY_MODE_USB3_DP)
+			apple_tunable_apply(atcphy->regs.core, atcphy->tunables.usb3_dp);
+		core_mask32(atcphy, ACIOPHY_LANE_MODE_T8122, GENMASK(11, 0),
+			    atcphy->swap_lanes ? 0x252 : 0x489);
+		core_mask32(atcphy, ACIOPHY_CROSSBAR_T8122, GENMASK(16, 0),
+			    atcphy->swap_lanes ? 0x111 : 0x110);
+		core_mask32(atcphy, ATCPHY_MISC, ATCPHY_MISC_LANE_SWAP,
+			    atcphy->swap_lanes ? ATCPHY_MISC_LANE_SWAP : 0);
+	}
 	udelay(1);
 	apple_tunable_apply(atcphy->regs.core, atcphy->t8132_banks[T8132_EFUSE].tunable);
 	udelay(10);
 	core_set32(atcphy, ATCPHY_POWER_CTRL, ATCPHY_POWER_PHY_RESET_N);
 	udelay(100);
-	if (mode == APPLE_ATCPHY_MODE_USB3_DP) {
+	if (mode == APPLE_ATCPHY_MODE_USB3_DP || dp) {
 		ret = atcphy_t8132_common_start(atcphy);
 		if (ret)
 			goto failed;
@@ -4079,6 +4133,9 @@ static int atcphy_configure_t8132(struct apple_atcphy *atcphy, enum atcphy_mode
 done:
 	atcphy->mode = mode;
 	atcphy->mode_dirty = false;
+	/* The AUX block needs the PHY out of reset and calibrated, as on T8122. */
+	if (dp)
+		atcphy_dp_aux_on_t8122(atcphy);
 	return 0;
 
 failed:
@@ -4734,6 +4791,12 @@ static const struct phy_ops apple_atc_usb3_phy_ops = {
 static int atcphy_dpphy_set_mode_t8132(struct apple_atcphy *atcphy, enum phy_mode mode)
 {
 	guard(mutex)(&atcphy->lock);
+	/*
+	 * A DisplayPort-only PHY has its lanes set up by the mux, as on T8122;
+	 * DPTX Activate and Deactivate have nothing left to do.
+	 */
+	if (atcphy->dp_only)
+		return mode == PHY_MODE_DP || mode == PHY_MODE_INVALID ? 0 : -EOPNOTSUPP;
 	if ((mode == PHY_MODE_DP || mode == PHY_MODE_INVALID) &&
 	    (atcphy->mode == APPLE_ATCPHY_MODE_USB4 || atcphy->mode == APPLE_ATCPHY_MODE_TBT))
 		return 0;
@@ -4803,9 +4866,12 @@ static int atcphy_dpphy_configure(struct phy *phy, union phy_configure_opts *opt
 	struct apple_atcphy *atcphy = phy_get_drvdata(phy);
 	enum atcphy_dp_link_rate link_rate;
 
-	/* No DP alternate mode: a tunnel sets its rate through its own call. */
+	/*
+	 * No DP alternate mode: a tunnel sets its rate through its own call. A
+	 * DisplayPort-only PHY runs its link as on T8122.
+	 */
 	if (atcphy->hw->gen == ATCPHY_GENERATION_T8132)
-		return -EOPNOTSUPP;
+		return atcphy->dp_only ? atcphy_dpphy_configure_t8122(atcphy, opts) : -EOPNOTSUPP;
 	if (atcphy->hw->has_t8140_dp)
 		return j700_dp_configure(atcphy, opts);
 
@@ -5623,8 +5689,8 @@ static enum atcphy_mode atcphy_typec_target_mode(struct apple_atcphy *atcphy,
 		target_mode = APPLE_ATCPHY_MODE_USB2;
 
 	/*
-	 * T8132 runs no DisplayPort-only lanes, and DisplayPort beside USB3
-	 * only with its calibration. A partner that enters DP Alt Mode keeps
+	 * A T8132 Type-C port runs no DisplayPort-only lanes, and DisplayPort
+	 * beside USB3 only with its calibration. A partner in DP Alt Mode keeps
 	 * its USB on the other wires: USB2 next to four DP lanes (pin
 	 * assignments C and E), USB3 next to two (D). Serve that USB rather
 	 * than refuse the mode, which would leave the port without USB at all.
@@ -5632,7 +5698,7 @@ static enum atcphy_mode atcphy_typec_target_mode(struct apple_atcphy *atcphy,
 	if (atcphy->hw->gen == ATCPHY_GENERATION_T8132) {
 		enum atcphy_mode usb_mode = target_mode;
 
-		if (target_mode == APPLE_ATCPHY_MODE_DP)
+		if (target_mode == APPLE_ATCPHY_MODE_DP && !atcphy->dp_only)
 			usb_mode = APPLE_ATCPHY_MODE_USB2;
 		else if (target_mode == APPLE_ATCPHY_MODE_USB3_DP && !atcphy->tunables.usb3_dp)
 			usb_mode = APPLE_ATCPHY_MODE_USB3;
@@ -5686,6 +5752,11 @@ static int atcphy_mux_check(const struct apple_atcphy *atcphy, enum atcphy_mode
 	    atcphy->cio_tunables)
 		return 0;
 
+	/* T8132 four-lane DP needs its banks and its AUX calibration. */
+	if (atcphy->hw->gen == ATCPHY_GENERATION_T8132 && atcphy->dp_only &&
+	    mode == APPLE_ATCPHY_MODE_DP)
+		return atcphy->dp_tunables ? 0 : -EOPNOTSUPP;
