From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Tue, 20 Oct 2026 11:42:19 +1100
Subject: [PATCH] soc: apple: pmp: use lossless command and bootargs
 conversions

Use From for the u8/u16/u32 values widened to u64 in power command packing
and bootargs updates. Keep all bit positions, correlation state transitions
and serialized bytes unchanged.

The production-source host tests pass identically before and after:
power correlation 3/3 and bootargs 9/9.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/soc/apple/pmp.rs          | 6 +++---
 drivers/soc/apple/pmp_bootargs.rs | 2 +-
 drivers/soc/apple/pmp_power.rs    | 2 +-
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/drivers/soc/apple/pmp.rs b/drivers/soc/apple/pmp.rs
index d33f55c259..044f340351 100644
--- a/drivers/soc/apple/pmp.rs
+++ b/drivers/soc/apple/pmp.rs
@@ -515,9 +515,9 @@ pub unsafe extern "C" fn apple_pmp_send_power_command(
     // SAFETY: The C bridge serializes calls against unregister in Drop.
     let data = unsafe { &*data.cast::<PmpData>() };
     let message = PM_COMMAND_MARKER
-        | ((command as u64) << PM_COMMAND_SHIFT)
-        | ((device_id as u64) << 40)
-        | ((enabled as u64) << 32);
+        | (u64::from(command) << PM_COMMAND_SHIFT)
+        | (u64::from(device_id) << 40)
+        | (u64::from(enabled) << 32);
     {
         let mut state = data.power_command.lock();
         if !state.begin(command) {
diff --git a/drivers/soc/apple/pmp_bootargs.rs b/drivers/soc/apple/pmp_bootargs.rs
index ec1a92746c..c085a323fe 100644
--- a/drivers/soc/apple/pmp_bootargs.rs
+++ b/drivers/soc/apple/pmp_bootargs.rs
@@ -37,7 +37,7 @@ pub(super) fn patch(bytes: &mut [u8], patches: &[(u32, u32)]) -> bool {
         let (key, size) = header(remaining).unwrap();
         let (body, rest) = remaining[8..].split_at_mut(size);
         if let Some((_, value)) = patches.iter().find(|(k, _)| *k == key) {
-            body.copy_from_slice(&(*value as u64).to_le_bytes()[..size]);
+            body.copy_from_slice(&u64::from(*value).to_le_bytes()[..size]);
         }
         remaining = rest;
     }
diff --git a/drivers/soc/apple/pmp_power.rs b/drivers/soc/apple/pmp_power.rs
index 0c5171f42c..f06a41d831 100644
--- a/drivers/soc/apple/pmp_power.rs
+++ b/drivers/soc/apple/pmp_power.rs
@@ -18,7 +18,7 @@ impl Command {
         if *self != Self::Idle || !matches!(command, 0x0e | 0x0f) {
             return false;
         }
-        *self = Self::Pending(MARKER | ((command as u64 + 1) << SHIFT));
+        *self = Self::Pending(MARKER | ((u64::from(command) + 1) << SHIFT));
         true
     }
 
