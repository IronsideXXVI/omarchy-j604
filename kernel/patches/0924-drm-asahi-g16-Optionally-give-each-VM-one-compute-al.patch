+/// `g16_compute_shared_pool` = 2: the VM's one allocator descriptor and its submitted
+/// counter. The host writes the descriptor once, before the VM's first compute command is
+/// counted; afterwards only the firmware writes it. Both live as long as the arena, which a
+/// retained (aborted) job keeps forever.
+pub(crate) struct ComputeStream {
+    pub(crate) desc: Arc<super::object::FwObject>,
+    pub(crate) counter: Arc<super::object::FwObject>,
+    poisoned: AtomicBool,
+}
+
+impl ComputeStream {
+    /// A counted command of this VM was aborted: its descriptor may stay bound and unsaved
+    /// on UMA index 1, so its saved ring cursors are no longer the ring's.
+    pub(crate) fn poison(&self) {
+        self.poisoned.store(true, Ordering::Release);
+    }
+    pub(crate) fn poisoned(&self) -> bool {
+        self.poisoned.load(Ordering::Acquire)
+    }
+}
+
 pub(crate) struct ComputeInner {
     pub(crate) compute: KVec<ComputeSlot>,
+    /// `g16_compute_shared_pool` = 2 only.
+    pub(crate) stream: Option<ComputeStream>,
     /// Pages of this arena's private objects at construction, in bytes (stats only).
     pub(crate) bytes: u64,
     _objects: Objects,
@@ -125,11 +148,22 @@ fn new(
             let unit = ComputeSlot::new(&mut objects, k, compute.first(), pack.as_ref())?;
             compute.push(unit, GFP_KERNEL)?;
         }
+        let stream = if super::params::compute_one_descriptor() {
+            let sh = super::object::Class::Shared;
+            Some(ComputeStream {
+                desc: super::graph::alloc(&mut objects, 0x100, sh, None, 0, false)?,
+                counter: super::graph::alloc(&mut objects, 0x80, sh, None, 0, false)?,
+                poisoned: AtomicBool::new(false),
+            })
+        } else {
+            None
+        };
         objects.finish_private()?;
         let bytes = objects.pages() as u64 * super::hw::PAGE;
         let arena = Arc::new(
             Self(crate::cleanup::Deferred::new(ComputeInner {
                 compute,
+                stream,
                 bytes,
                 _objects: objects,
                 _bind: bind.clone(),
