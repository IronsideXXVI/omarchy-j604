-            let submitted = unit.counter.r64(0)?;
+            // `g16_compute_shared_pool` = 2: the VM's one descriptor counts its commands in
+            // ring order, so this flight is done once COMPLETED reaches the count written at
+            // its publication; the descriptor must still name the VM's counter.
+            let (counted, completed, linked) = match f.job.resources.compute()?.stream.as_ref() {
+                Some(st) => (
