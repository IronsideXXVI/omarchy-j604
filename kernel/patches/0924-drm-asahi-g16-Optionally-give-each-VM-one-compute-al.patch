     put64(w, 0x844, ts_va[0]);
     put64(w, 0x84c, ts_va[1]);
-    put64(w, 0x86a, r.tail + compute::DESCRIPTOR as u64);
+    put64(w, 0x86a, descriptor(r));
     put8(w, 0x872, 1);
     put64(w, 0x873, 0x1588000);
     put64(w, 0x87b, 0xef8000);
@@ -353,7 +366,7 @@ pub(crate) fn encode_compute(
         put16(q, off + 0xe, 1);
     }
     put32(q, 0x158, att.len() as u32);
-    put64(q, 0x160, r.tail + compute::DESCRIPTOR as u64);
+    put64(q, 0x160, descriptor(r));
     put64(q, 0x178, r.auxiliary_gva);
     put64(q, 0x188, r.context_store_gva);
     put64(q, 0x190, r.context_store_gva + 0xf400);
diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index e01733f99c..5681bd81c5 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
