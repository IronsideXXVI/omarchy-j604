@@ -1192,6 +1192,15 @@ fn other_vm_running(&self, job: &Job) -> bool {
         on && self.engine.flights.iter().any(|f| f.job.vm.id != job.vm.id)
     }
 
+    /// `g16_compute_shared_pool` = 2: every VM's compute commands bind firmware UMA index 1
+    /// with that VM's one descriptor, and the binder reprograms the row from a different
+    /// descriptor without saving the previous one. So a compute command goes behind running
+    /// flights only when all of them are of its VM; another VM binds only after the pipe
+    /// drained, when the firmware's retire has saved the row into the previous descriptor.
+    fn one_descriptor_ok(&self, job: &Job) -> bool {
+        !params::compute_one_descriptor()
+            || self.engine.flights.iter().all(|f| f.job.vm.id == job.vm.id)
+    }
     /// Whether the VM holding the engine may still publish while another VM waits: its
     /// batch since its turn began is below `g16_vm_batch` commands and `g16_vm_batch_us`.
     fn batch_open(&self) -> bool {
@@ -1232,7 +1241,8 @@ fn ahead_ok(&self, job: &Job) -> bool {
                 && !self.engine.frozen
                 && self.engine.flights.iter().all(|f| {
                     f.renders == 0 && f.computes != 0 && !f.doomed && !f.recovery_suspect
-                });
+                })
+                && self.one_descriptor_ok(job);
         }
         // g16_resident: up to the resident depth, one render unit each; otherwise
         // g16_flights / g16_depth (at most two).
@@ -1857,9 +1867,11 @@ fn publish_prefix_into(
                 self.graph.render.threshold.w32(8, prefix.draw as u32)?;
             } else {
                 let k = f.claims.slot[0] as usize;
-                job.resources.compute()?.compute[k]
-                    .counter
-                    .w64(0, f.uma_submitted)?;
+                let arena = job.resources.compute()?;
+                match arena.stream.as_ref() {
+                    Some(st) => st.counter.w64(0, f.uma_submitted)?,
+                    None => arena.compute[k].counter.w64(0, f.uma_submitted)?,
+                }
                 self.graph.compute.threshold.w32(0, prefix.n as u32)?;
             }
             wmb();
@@ -2012,6 +2024,13 @@ fn prefix_compute(
     ) -> Result {
         let n = super::recovery::logic::next_ordinal(pf.n).ok_or(EOVERFLOW)?;
         let target = encode::stamp(n);
+        // `g16_compute_shared_pool` = 2: the VM's one descriptor and counter, on UMA index 1.
+        // After an aborted counted command the descriptor no longer holds its ring's cursors;
+        // never bind it again.
+        let stream = job.resources.compute()?.stream.as_ref();
+        if stream.is_some_and(|st| st.poisoned()) {
+            return Err(EIO);
+        }
         let index = self
             .slots
             .claim_compute(job.resources.compute()?, &mut f.claims, 0)?
@@ -2026,7 +2045,11 @@ fn prefix_compute(
             s
         };
         let g = &self.graph.compute;
-        let before = s.counter.r64(0)?;
+        let counter = match stream {
+            Some(st) => &st.counter,
+            None => &s.counter,
+        };
+        let before = counter.r64(0)?;
         let submitted = before.checked_add(1).ok_or(EOVERFLOW)?;
         let refs = ComputeRefs {
             notifier: g.notifier.va + notifier_page::COMPUTE_RECORD as u64,
@@ -2044,13 +2067,18 @@ fn prefix_compute(
             auxiliary_fw: s.aux.va,
             auxiliary_gva: s.aux.gva.ok_or(EINVAL)?,
             context_store_gva: s.context_store.gva.ok_or(EINVAL)?,
-            counter_fw: s.counter.va,
+            counter_fw: counter.va,
+            desc: stream.map_or(0, |st| st.desc.va),
             pool_state_gva: pool.pool_state.gva.ok_or(EINVAL)?,
             page_list_gva: pool.page_list.gva.ok_or(EINVAL)?,
             usc_base: job.queue.usc_base,
             record_fw: g.notifier.va + notifier_page::COMPUTE_RECORD as u64,
             binding_generation: generation,
-            uma_slot: super::pools::lifetime::uma_slot(super::hw::engine::COMPUTE_UMA_SLOT, index),
+            uma_slot: if stream.is_some() {
+                super::hw::engine::COMPUTE_UMA_SLOT
+            } else {
+                super::pools::lifetime::uma_slot(super::hw::engine::COMPUTE_UMA_SLOT, index)
+            },
             // Preserve the already qualified packet bytes while expressing the native
             // fields separately. This compatibility identifier is not proof of native
             // global command-ID allocation or uniqueness after compute-index wrap.
@@ -2079,7 +2107,8 @@ fn prefix_compute(
         super::host_records::capture_submit(
             "compute-encoded-prefix", s.work.va, g.qinfo.va, n, &w[..0x1000], job.host_identity,
         );
-        if before != 0 {
+        // Mode 2 has no per-unit descriptor to restore: the work names the VM's descriptor.
+        if before != 0 && stream.is_none() {
             // Slots::claim_compute proved a different fully retired unit displaced this
             // descriptor in the same hardware slot. Keep every firmware-mutated byte.
             let mut descriptor = [0u8; work::compute::DESCRIPTOR_SIZE];
@@ -2102,6 +2131,15 @@ fn prefix_compute(
             &s.block_va().to_le_bytes(),
             job.host_identity,
         );
+        if let Some(st) = stream {
+            // Written once, while no command of this VM has been counted on it (its counter
+            // is still 0), so the firmware has never bound it; afterwards only the firmware
+            // writes it (bind programs the row from it, the retire at drain saves the row).
+            if before == 0 {
+                let d = &w[work::compute::DESCRIPTOR..][..work::compute::DESCRIPTOR_SIZE];
+                st.desc.write(0, d)?;
+            }
+        }
         s.write_work(w)?;
         f.uma_submitted = submitted;
         wmb();
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index e584786c5c..aa4d9f80a0 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -856,29 +856,43 @@ pub(crate) fn compute_units() -> usize {
 
 /// Storage of `g16_compute_shared_pool` (0644, default 0; latched at its first read).
 static COMPUTE_SHARED_POOL: AtomicU32 = AtomicU32::new(0);
-/// 0 until latched, then 1 (off) or 2 (on).
+/// 0 until latched, then 1 (mode 0), 2 (mode 1) or 3 (mode 2).
 static COMPUTE_SHARED_POOL_LATCH: AtomicU32 = AtomicU32::new(0);
 
-/// Every compute unit of a VM allocates from unit 0's UMA freelist and pool table instead of
-/// its own. Each command keeps its own work, allocator descriptor, UMA slot, completion
-/// counter and context store. The firmware runs the one compute ring in order, so only one
-/// command at a time allocates from the shared pool. Read once, at the first compute command,
-/// so every descriptor of a run names the same pool.
-pub(crate) fn compute_shared_pool() -> bool {
+/// The latched `g16_compute_shared_pool` mode plus one. Any value other than 0 and 2 keeps
+/// the meaning every non-zero value had before mode 2 existed (mode 1). Read once, at the
+/// engine start, so every descriptor of a run names the same pool.
+fn compute_pool_latch() -> u32 {
     let l = COMPUTE_SHARED_POOL_LATCH.load(Ordering::Acquire);
     if l != 0 {
-        return l == 2;
+        return l;
     }
-    let v = if COMPUTE_SHARED_POOL.load(Ordering::Relaxed) != 0 {
-        2
-    } else {
-        1
+    let v = match COMPUTE_SHARED_POOL.load(Ordering::Relaxed) {
+        0 => 1,
+        2 => 3,
+        _ => 2,
     };
     let _ = COMPUTE_SHARED_POOL_LATCH.compare_exchange(0, v, Ordering::AcqRel, Ordering::Acquire);
-    COMPUTE_SHARED_POOL_LATCH.load(Ordering::Acquire) == 2
+    COMPUTE_SHARED_POOL_LATCH.load(Ordering::Acquire)
 }
 
-/// The latch as the statistics print it: 0 not yet read, 1 off, 2 on (reading it latches nothing).
+/// Modes 1 and 2: every compute unit of a VM allocates from unit 0's UMA freelist and pool
+/// table instead of its own.
+pub(crate) fn compute_shared_pool() -> bool {
+    compute_pool_latch() >= 2
+}
+
+/// Mode 2: the VM's one pool also has ONE allocator descriptor, one submitted counter and
+/// one firmware UMA index (1), shared by all its compute units, as macOS gives one
+/// descriptor to all compute commands of a context. Mode 1 gives each unit its own
+/// descriptor and index over the one pool, so up to 16 saved copies of the pool's ring
+/// cursors disagree.
+pub(crate) fn compute_one_descriptor() -> bool {
+    compute_pool_latch() == 3
+}
+
+/// The latch as the statistics print it: 0 not yet read, 1 mode 0, 2 mode 1, 3 mode 2
+/// (reading it latches nothing).
 pub(crate) fn compute_shared_pool_state() -> u32 {
     COMPUTE_SHARED_POOL_LATCH.load(Ordering::Relaxed)
 }
@@ -889,7 +903,7 @@ pub(crate) fn compute_shared_pool_state() -> u32 {
     COMPUTE_SHARED_POOL_PARM,
     COMPUTE_SHARED_POOL,
     "g16_compute_shared_pool",
-    "G16: 1 = all compute units of a VM allocate from unit 0's UMA pool, each command keeping its own descriptor, UMA slot and context store; 0 (default) = one 32 MiB pool per unit; latched at the first compute command, set it as a module option"
+    "G16: 0 (default) = one 32 MiB UMA pool per compute unit; 1 = all compute units of a VM allocate from unit 0's pool, each keeping its own allocator descriptor and UMA index; 2 = one pool AND one allocator descriptor, counter and UMA index per VM, shared by all its compute units, as macOS has; latched at the engine start, set it as a module option"
 );
 
 live_u32_param!(
