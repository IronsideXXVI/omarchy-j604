index c464e7914c..bdadff4a57 100644
--- a/drivers/gpu/drm/asahi/g16/encode/compute.rs
+++ b/drivers/gpu/drm/asahi/g16/encode/compute.rs
@@ -38,6 +38,9 @@ pub(crate) struct ComputeRefs {
     pub(crate) auxiliary_gva: u64,
     pub(crate) context_store_gva: u64,
     pub(crate) counter_fw: u64,
+    /// Firmware VA of the VM's one allocator descriptor (`g16_compute_shared_pool` = 2);
+    /// zero names the unit's own at tail + DESCRIPTOR.
+    pub(crate) desc: u64,
     pub(crate) pool_state_gva: u64,
     pub(crate) page_list_gva: u64,
     pub(crate) usc_base: u64,
@@ -107,6 +110,15 @@ pub(crate) fn init_compute_pool(
 /// Numeric checks here do not establish that ownership proof. The old descriptor's completion
 /// counter must equal A's cumulative submission count. Pool/list/counter backing stays pinned;
 /// only the work pointer and destination slot are rewritten. Returns the next private counter.
+/// The allocator descriptor the command names (launch W+0x86a and StartCompute +0x160).
+fn descriptor(r: &ComputeRefs) -> u64 {
+    if r.desc != 0 {
+        r.desc
+    } else {
+        r.tail + compute::DESCRIPTOR as u64
+    }
+}
+
 pub(crate) fn preserve_compute_descriptor(
     r: &ComputeRefs,
     old: &[u8; compute::DESCRIPTOR_SIZE],
@@ -183,6 +195,7 @@ pub(crate) fn encode_compute(
         || !fw(r.stats_fw, 0xe10)
         || !fw(r.auxiliary_fw, compute::AUX_SIZE as u64)
         || !fw(r.counter_fw, 8)
+        || (r.desc != 0 && !fw(r.desc, compute::DESCRIPTOR_SIZE as u64))
         || !fw(r.notifier, 0x118)
