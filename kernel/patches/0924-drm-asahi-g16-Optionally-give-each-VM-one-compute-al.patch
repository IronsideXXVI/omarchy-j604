+                None => {
+                    let submitted = unit.counter.r64(0)?;
+                    (
+                        submitted != 0,
+                        unit.work.r64(compute::DESCRIPTOR_COMPLETED)? == submitted,
+                        unit.work.r64(compute::DESCRIPTOR_COUNTER)? == unit.counter.va,
+                    )
+                }
+            };
             let start = unit.its.r64(0)?;
             let end = unit.its.r64(8)?;
             let note = g.notifier.r32(notifier_page::COMPUTE_STAMP)?;
@@ -1229,9 +1246,9 @@ fn retired_snapshot(&mut self) -> Result<Retirement> {
                     && g.notifier.r32(notifier_page::COMPUTE_CONTEXT)? == f.job.vm.slot
             };
             full &= noted
-                && submitted != 0
-                && unit.work.r64(compute::DESCRIPTOR_COMPLETED)? == submitted
-                && unit.work.r64(compute::DESCRIPTOR_COUNTER)? == unit.counter.va
+                && counted
+                && completed
+                && linked
                 && start != 0
                 && end > start;
         }
@@ -1436,6 +1453,15 @@ pub(crate) fn retire_oldest(
             self.slots.quarantine(&mut f.claims);
             self.retain(&f.job);
             f.job.mark_aborted();
+            // `g16_compute_shared_pool` = 2: an aborted counted command may leave the VM's
+            // descriptor bound and unsaved on UMA index 1. Its later compute commands fail;
+            // the retained job keeps the descriptor mapped.
+            if f.computes != 0 && f.uma_submitted != 0 {
+                let arena = f.job.resources.compute().ok();
+                if let Some(st) = arena.and_then(|a| a.stream.as_ref()) {
+                    st.poison();
+                }
+            }
             self.recovery.aborted_receipts = self.recovery.aborted_receipts.saturating_add(1);
         }
         if self.slots.compute_exhausted() {
diff --git a/drivers/gpu/drm/asahi/g16/resources.rs b/drivers/gpu/drm/asahi/g16/resources.rs
index 699c8943c9..fc9feb7f9c 100644
--- a/drivers/gpu/drm/asahi/g16/resources.rs
+++ b/drivers/gpu/drm/asahi/g16/resources.rs
@@ -81,8 +81,31 @@ fn deref(&self) -> &Self::Target {
