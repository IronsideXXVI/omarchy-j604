From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 02:22:44 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j604: Enable USB-C ports 1 and 2
 (USB2)

Enable the ATC0 and ATC1 USB-C ports of the MacBook Pro (14-inch, M4) in
USB2 host mode, with their SN201202X port controllers on SPMI A0, wired
the same way as the J713 ports on integration/aurora (hpm0 and hpm1 in
t8132-j713.dts).

From the J604 Apple device tree (26B123 and 25G83 templates):
- nub-spmi-a0/hpm0 (port 1, USID 0xc, interrupts 11 17 19) and hpm1
  (port 2, USID 0xa, interrupts 37 43 45) are "usbc,sn201202x,spmi";
- atc-phy0/usb-drd0 are port 1 and atc-phy1/usb-drd1 port 2, so hpm0
  pairs with ATC0 and hpm1 with ATC1;
- hpm5 on the same bus (USID 8, hpm-class-type 0xb, port-type 0x11) is
  not a USB-C port (likely MagSafe); it is not described.

The connector labels use the device-tree port numbers, as the template
carries no location. The USB2-only T8132 PHY path does not read tunables,
so the loader's ATC calibration import does not matter for these ports.

The third port (ATC3, on SPMI A1) is left for a separate change.

Testing: dtc and dtbs_check only.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 165 +++++++++++++++++++++++
 1 file changed, 165 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index c5092b7a77..2d3092911d 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -22,6 +22,8 @@
 	model = "Apple MacBook Pro (14-inch, M4, 2024)";
 
 	aliases {
+		atcphy0 = &atcphy0;
+		atcphy1 = &atcphy1;
 		bluetooth0 = &bluetooth0;
 		keyboard = &keyboard;
 		wifi0 = &wifi0;
@@ -212,3 +214,166 @@
 	stm {
 	};
 };
+
+/*
+ * USB-C ports 1 and 2 (ATC0 and ATC1; port numbers as in the Apple device
+ * tree), USB2 only. Their SN201202X port controllers sit on SPMI A0; the
+ * third controller on that bus (hpm5, USID 8) is the MagSafe port and is
+ * not described.
+ */
+
+&nub_spmi_a0 {
+	status = "okay"; /* DTV-SPMIA0-1, DTV-SPMIA0-2 */
+
+	hpm1: usb-pd@a {
+		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
+		reg = <0xa SPMI_USID>; /* DTV-HPM-1a */
+		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
+			     <43 IRQ_TYPE_EDGE_RISING>,
+			     <45 IRQ_TYPE_EDGE_RISING>; /* DTV-HPM-1b */
+		interrupt-names = "irq", "sleep", "wake";
+
+		typec1: connector {
+			compatible = "usb-c-connector";
+			label = "USB-C port 2";
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					typec1_connector_hs: endpoint {
+						remote-endpoint = <&dwc3_1_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					typec1_connector_ss: endpoint {
+						remote-endpoint = <&atcphy1_typec_lanes>;
+					};
+				};
+			};
+		};
+	};
+
+	hpm0: usb-pd@c {
+		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
+		reg = <0xc SPMI_USID>; /* DTV-HPM-0a */
+		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
+			     <17 IRQ_TYPE_EDGE_RISING>,
+			     <19 IRQ_TYPE_EDGE_RISING>; /* DTV-HPM-0b */
+		interrupt-names = "irq", "sleep", "wake";
+
+		typec0: connector {
+			compatible = "usb-c-connector";
+			label = "USB-C port 1";
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					typec0_connector_hs: endpoint {
+						remote-endpoint = <&dwc3_0_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					typec0_connector_ss: endpoint {
+						remote-endpoint = <&atcphy0_typec_lanes>;
+					};
+				};
+			};
+		};
+	};
+};
+
+&atcphy0 {
+	status = "okay"; /* DTV-USB-0a */
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			atcphy0_typec_lanes: endpoint {
+				remote-endpoint = <&typec0_connector_ss>;
+			};
+		};
+	};
+};
+
+&dwc3_0_dart_0 {
+	status = "okay"; /* DTV-USB-0c */
+};
+
+&dwc3_0_dart_1 {
+	status = "okay"; /* DTV-USB-0c */
+};
+
+&dwc3_0 {
+	dr_mode = "host";
+	status = "okay"; /* DTV-USB-0b */
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			dwc3_0_hs: endpoint {
+				remote-endpoint = <&typec0_connector_hs>;
+			};
+		};
+	};
+};
+
+&atcphy1 {
+	status = "okay"; /* DTV-USB-1a */
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			atcphy1_typec_lanes: endpoint {
+				remote-endpoint = <&typec1_connector_ss>;
+			};
+		};
+	};
+};
+
+&dwc3_1_dart_0 {
+	status = "okay"; /* DTV-USB-1c */
+};
+
+&dwc3_1_dart_1 {
+	status = "okay"; /* DTV-USB-1c */
+};
+
+&dwc3_1 {
+	dr_mode = "host";
+	status = "okay"; /* DTV-USB-1b */
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			dwc3_1_hs: endpoint {
+				remote-endpoint = <&typec1_connector_hs>;
+			};
+		};
+	};
+};
