From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 23:18:34 +0000
Subject: [PATCH] drm/asahi: g16: Add a switch for the firmware's GPU
 power-off delay word

When the 25G83 GPU firmware powers the GPU up it arms a power-off delay
timer whose period is the Main hwdata word at +0xed0 divided by 24, in
microseconds. We write 24000 there, a 1 ms delay, as Gravity does. The
GPU starts work about 100 us after a doorbell that finds the firmware
idle, on macOS as on ours, and whether a GPU power cycle is part of that
can be measured by moving this word.

Add g16_gpu_off_delay, read once when the initdata is built. The default
0 writes 24000 as before; any other value is written as given, in 24 MHz
ticks: 240000 for 10 ms, 2400 for 0.1 ms.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/fw/initdata.rs |  2 +-
 drivers/gpu/drm/asahi/g16/params.rs      | 22 ++++++++++++++++++++++
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/asahi/g16/fw/initdata.rs b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
index f6e9fbfd30..254e84f5d7 100644
--- a/drivers/gpu/drm/asahi/g16/fw/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
@@ -666,7 +666,7 @@ pub(crate) fn encode(
         (0xea0, 1),
         (0xee0, 1),
         (0xeb8, 1),
-        (0xed0, 24000),
+        (0xed0, super::super::params::gpu_off_delay()),
         (0xed4, 1),
         (0xed8, 8),
         (0xfc0, input.performance.count as u32),
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 2f9864a8f9..9347986929 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -1012,6 +1012,28 @@ pub(crate) fn rekick_us() -> u32 {
     "G16: while commands are in flight, re-poll at least every this many us and ring their pipes again on each such pass (default 0: off; 10..1000; runtime 0644)"
 );
 
+/// Storage of `g16_gpu_off_delay` (0644, default 0; read once, when the initdata is built).
+static GPU_OFF_DELAY: AtomicU32 = AtomicU32::new(0);
+
+/// The Main hwdata word at +0xed0, in 24 MHz ticks: the firmware arms its power-off delay
+/// timer with it divided by 24 (us) when it powers the GPU up. 0 (default) writes 24000
+/// (1 ms), as Gravity does; any other value is written as given.
+pub(crate) fn gpu_off_delay() -> u32 {
+    match GPU_OFF_DELAY.load(Ordering::Relaxed) {
+        0 => 24000,
+        v => v,
+    }
+}
+
+live_u32_param!(
+    GPU_OFF_DELAY_PARAM,
+    GPU_OFF_DELAY_PARMTYPE,
+    GPU_OFF_DELAY_PARM,
+    GPU_OFF_DELAY,
+    "g16_gpu_off_delay",
+    "G16: the firmware's GPU power-off delay word (Main hwdata +0xed0, 24 MHz ticks; default 0: 24000 = 1 ms; set before the GPU starts)"
+);
+
 /// Storage of `g16_render_quiet` (runtime 0644, default 0).
 static RENDER_QUIET: AtomicU32 = AtomicU32::new(0);
 
-- 
2.43.0

