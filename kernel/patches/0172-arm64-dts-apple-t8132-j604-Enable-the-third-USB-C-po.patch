From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 21:31:36 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j604: Enable the third USB-C port

The right-hand USB-C port of the MacBook Pro (14-inch, M4) is ATC3. Its
SN201202X port controller is hpm3 on SPMI A1, USID 0xc, with the same
three interrupts as hpm0 on SPMI A0 (11, 17 and 19 in the bus's own
interrupt space). The J604 Apple device tree numbers this port 4
(usb-drd3 and atc-phy3 port-number 4, /port-usb-c-4, hpm3 port-location
"right"); number 3 belongs to the DisplayPort PHY of ATC2.

Describe the controller and its connector, enable the ATC3 PHY, DARTs and
DWC3, and wire them up exactly like ports 1 and 2: host mode, USB2 only,
with the connector's HS endpoint on the DWC3 and its SS endpoint on the
PHY's Type-C lanes. Add the atcphy3 alias so that the loader handles this
PHY as it does atcphy0 and atcphy1 (m1n1 kboot_setup_atc() walks
/arm-io/atc-phyN by alias atcphyN and only adds calibration properties).

No driver change is needed: sn201202x, phy-apple-atc and dwc3-apple key
their T8132 behaviour on the compatibles, not on the instance.

TO-VERIFY: a J604 boot with this device tree; a USB device and a power
source on the right-hand port.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 91 ++++++++++++++++++++++--
 1 file changed, 87 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 83843651a3..b3274b1276 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -25,6 +25,7 @@
 	aliases {
 		atcphy0 = &atcphy0;
 		atcphy1 = &atcphy1;
+		atcphy3 = &atcphy3;
 		bluetooth0 = &bluetooth0;
 		keyboard = &keyboard;
 		pmp = &pmp;
@@ -275,10 +276,12 @@
 };
 
 /*
- * USB-C ports 1 and 2 (ATC0 and ATC1; port numbers as in the Apple device
- * tree), USB2 only. Their SN201202X port controllers sit on SPMI A0; the
- * third controller on that bus (hpm5, USID 8) is the MagSafe port and is
- * not described.
+ * USB-C ports 1, 2 and 4 (ATC0, ATC1 and ATC3), USB2 only. The port numbers
+ * are the Apple device tree's, which gives number 3 to the DisplayPort PHY
+ * of ATC2, not a USB-C port. The SN201202X port controllers of ports 1 and 2
+ * sit on SPMI A0; the third controller on that bus (hpm5, USID 8) is the
+ * MagSafe port and is not described. The controller of port 4, on the
+ * right, sits on SPMI A1.
  */
 
 &nub_spmi_a0 {
@@ -355,6 +358,45 @@
 	};
 };
 
+&nub_spmi_a1 {
+	status = "okay";
+
+	hpm3: usb-pd@c {
+		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
+		reg = <0xc SPMI_USID>;
+		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
+			     <17 IRQ_TYPE_EDGE_RISING>,
+			     <19 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "irq", "sleep", "wake";
+
+		typec3: connector {
+			compatible = "usb-c-connector";
+			label = "USB-C port 4";
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					typec3_connector_hs: endpoint {
+						remote-endpoint = <&dwc3_3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					typec3_connector_ss: endpoint {
+						remote-endpoint = <&atcphy3_typec_lanes>;
+					};
+				};
+			};
+		};
+	};
+};
+
 &atcphy0 {
 	status = "okay"; /* DTV-USB-0a */
 
@@ -437,6 +479,47 @@
 	};
 };
 
+&atcphy3 {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			atcphy3_typec_lanes: endpoint {
+				remote-endpoint = <&typec3_connector_ss>;
+			};
+		};
+	};
+};
+
+&dwc3_3_dart_0 {
+	status = "okay";
+};
+
+&dwc3_3_dart_1 {
+	status = "okay";
+};
+
+&dwc3_3 {
+	dr_mode = "host";
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			dwc3_3_hs: endpoint {
+				remote-endpoint = <&typec3_connector_hs>;
+			};
+		};
+	};
+};
+
 /*
  * CPU DVFS. Without a board thermal owner the T8132 cpufreq driver keeps both
  * clusters at or below P-state 4 (E 1860 MHz, P 1800 MHz).
