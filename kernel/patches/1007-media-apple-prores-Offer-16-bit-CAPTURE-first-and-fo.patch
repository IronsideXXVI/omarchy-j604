From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 24 Nov 2026 05:57:58 +0000
Subject: [PATCH] media: apple: prores: Offer 16-bit CAPTURE first and follow
 header changes

Two problems a stateful decoder client meets on the decoder node:

The CAPTURE formats were listed in table order, NV16 or NV24 first. A
client that takes the first format it can map, as FFmpeg's v4l2_m2m
wrapper does, decoded 10 and 12 bit ProRes into 8-bit planes. List the
16-bit layouts (P216, P416) first, then the 8-bit ones, still filtered by
the chroma format once a header is known.

A header with a new size or chroma format that arrived while CAPTURE
held buffers raised SOURCE_CHANGE but left the CAPTURE format on the old
layout, so G_FMT after the event returned the old layout and the next job
never became ready. Set the CAPTURE format from the new header at once.
If the existing CAPTURE buffers have another layout, hold jobs until the
client sets the CAPTURE queue up again from empty.

Both choices are pure helpers with a KUnit case each.
---
 .../platform/apple/prores/apple-prores-desc.c | 32 +++++++++++++++
 .../platform/apple/prores/apple-prores-drv.c  | 40 +++++++++++++------
 .../platform/apple/prores/apple-prores-test.c | 36 +++++++++++++++++
 .../platform/apple/prores/apple-prores.h      |  3 ++
 4 files changed, 99 insertions(+), 12 deletions(-)

diff --git a/drivers/media/platform/apple/prores/apple-prores-desc.c b/drivers/media/platform/apple/prores/apple-prores-desc.c
index 9ac831a4212..a2425ab291a 100644
--- a/drivers/media/platform/apple/prores/apple-prores-desc.c
+++ b/drivers/media/platform/apple/prores/apple-prores-desc.c
@@ -614,6 +614,38 @@ int apr_dec_layout(const struct apr_frame_info *fi, enum apr_input out,
 }
 EXPORT_SYMBOL_IF_KUNIT(apr_dec_layout);
 
+/*
+ * CAPTURE layouts the decoder offers, deepest first: 16-bit planes keep all
+ * 10 or 12 bits of a ProRes frame, so a client that takes the first format
+ * it knows gets full depth. Once a header is known, only its chroma format.
+ * Returns the layout at @index, or -EINVAL past the end.
+ */
+int apr_dec_cap_order(bool have_info, bool is444, unsigned int index)
+{
+	static const enum apr_input order[] = {
+		APR_INPUT_422_16, APR_INPUT_444_16, APR_INPUT_422_8, APR_INPUT_444_8,
+	};
+	unsigned int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(order); i++) {
+		if (have_info && apr_input_is_444(order[i]) != is444)
+			continue;
+		if (n++ == index)
+			return order[i];
+	}
+	return -EINVAL;
+}
+EXPORT_SYMBOL_IF_KUNIT(apr_dec_cap_order);
+
+/* A header with a new size or chroma format needs new CAPTURE buffers. */
+bool apr_dec_needs_realloc(const struct apr_frame_info *cur,
+			   const struct apr_frame_info *fi)
+{
+	return cur->width != fi->width || cur->height != fi->height ||
+	       cur->is444 != fi->is444;
+}
+EXPORT_SYMBOL_IF_KUNIT(apr_dec_needs_realloc);
+
 /*
  * A finished frame starts with its big-endian length, which counts the whole
  * frame, followed by the 'icpf' frame identifier.
diff --git a/drivers/media/platform/apple/prores/apple-prores-drv.c b/drivers/media/platform/apple/prores/apple-prores-drv.c
index e2561dc5f7a..e3230b9e28e 100644
--- a/drivers/media/platform/apple/prores/apple-prores-drv.c
+++ b/drivers/media/platform/apple/prores/apple-prores-drv.c
@@ -635,6 +635,7 @@ struct apr_ctx {
 	bool dec;			/* opened through the decoder node */
 	struct apr_frame_info info;	/* stream header CAPTURE follows */
 	bool have_info;			/* a header has been announced */
+	bool cap_stale;			/* CAPTURE buffers predate dst_fmt */
 };
 
 /* A decoder buffer and, on OUTPUT, the frame header parsed at prepare. */
@@ -1111,6 +1112,8 @@ static int apr_job_ready(void *priv)
 
 	if (!ctx->dec)
 		return 1;
+	if (ctx->cap_stale)
+		return 0;
 	src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
 	if (!src)
 		return 0;
@@ -1387,6 +1390,7 @@ static void apr_dec_fill_coded(struct v4l2_pix_format_mplane *pix)
 static void apr_dec_reset_fmts(struct apr_ctx *ctx)
 {
 	ctx->have_info = false;
+	ctx->cap_stale = false;
 	ctx->info = (struct apr_frame_info){ .width = 1920, .height = 1080 };
 	ctx->raw = &apr_raw_fmts[1];
 	memset(&ctx->src_fmt, 0, sizeof(ctx->src_fmt));
@@ -1397,8 +1401,10 @@ static void apr_dec_reset_fmts(struct apr_ctx *ctx)
 }
 
 /*
- * A header with a new size or chroma format resizes an idle CAPTURE queue
+ * A header with a new size or chroma format sets the CAPTURE format at once
  * and raises SOURCE_CHANGE (stateful decoder interface); so does the first.
+ * G_FMT after the event returns the new layout. If CAPTURE already holds
+ * buffers of another layout, jobs wait until the client sets it up anew.
  */
 static void apr_dec_announce(struct apr_ctx *ctx, const struct apr_frame_info *fi)
 {
@@ -1407,15 +1413,21 @@ static void apr_dec_announce(struct apr_ctx *ctx, const struct apr_frame_info *f
 		.u.src_change.changes = V4L2_EVENT_SRC_CH_RESOLUTION,
 	};
 
-	if (ctx->have_info && ctx->info.width == fi->width &&
-	    ctx->info.height == fi->height && ctx->info.is444 == fi->is444)
+	struct v4l2_pix_format_mplane pix;
+
+	if (ctx->have_info && !apr_dec_needs_realloc(&ctx->info, fi))
 		return;
 	ctx->info = *fi;
 	ctx->have_info = true;
-	if (!vb2_is_busy(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx))) {
-		ctx->raw = apr_dec_pick_raw(ctx, ctx->raw->fourcc);
-		apr_dec_fill_raw(ctx, &ctx->dst_fmt, ctx->raw);
-	}
+	ctx->raw = apr_dec_pick_raw(ctx, ctx->raw->fourcc);
+	apr_dec_fill_raw(ctx, &pix, ctx->raw);
+	if (vb2_is_busy(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)) &&
+	    (pix.pixelformat != ctx->dst_fmt.pixelformat ||
+	     pix.width != ctx->dst_fmt.width ||
+	     pix.height != ctx->dst_fmt.height ||
+	     pix.plane_fmt[0].sizeimage != ctx->dst_fmt.plane_fmt[0].sizeimage))
+		ctx->cap_stale = true;
+	ctx->dst_fmt = pix;
 	v4l2_event_queue_fh(&ctx->fh, &ev);
 }
 
@@ -1435,16 +1447,17 @@ static int apr_dec_enum_fmt_out(struct file *file, void *priv, struct v4l2_fmtde
 	return 0;
 }
 
-/* Once a header is known, only layouts with its chroma format. */
+/* 16-bit layouts first; once a header is known, only its chroma format. */
 static int apr_dec_enum_fmt_cap(struct file *file, void *priv, struct v4l2_fmtdesc *f)
 {
 	struct apr_ctx *ctx = apr_file_to_ctx(file);
-	unsigned int i, n = 0;
+	int input = apr_dec_cap_order(ctx->have_info, ctx->info.is444, f->index);
+	unsigned int i;
 
+	if (input < 0)
+		return input;
 	for (i = 0; i < ARRAY_SIZE(apr_raw_fmts); i++) {
-		if (ctx->have_info && apr_raw_fmts[i].is444 != ctx->info.is444)
-			continue;
-		if (n++ == f->index) {
+		if (apr_raw_fmts[i].input == input) {
 			f->pixelformat = apr_raw_fmts[i].fourcc;
 			return 0;
 		}
@@ -1576,6 +1589,9 @@ static int apr_queue_setup(struct vb2_queue *q, unsigned int *nbufs,
 	struct apr_ctx *ctx = vb2_get_drv_priv(q);
 	u32 size = apr_q_fmt(ctx, q->type)->plane_fmt[0].sizeimage;
 
+	/* A CAPTURE queue set up from empty holds the announced layout. */
+	if (ctx->dec && !V4L2_TYPE_IS_OUTPUT(q->type) && !vb2_get_num_buffers(q))
+		ctx->cap_stale = false;
 	if (*nplanes)
 		return *nplanes == 1 && sizes[0] >= size ? 0 : -EINVAL;
 	*nplanes = 1;
diff --git a/drivers/media/platform/apple/prores/apple-prores-test.c b/drivers/media/platform/apple/prores/apple-prores-test.c
index 188a078db94..43b8ae67da2 100644
--- a/drivers/media/platform/apple/prores/apple-prores-test.c
+++ b/drivers/media/platform/apple/prores/apple-prores-test.c
@@ -890,9 +890,45 @@ static void apr_test_dec_layout(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, apr_dec_layout(&fi, APR_INPUT_422_8, &l), -EINVAL);
 }
 
+/* CAPTURE formats are offered 16-bit first, filtered by the header chroma. */
+static void apr_test_dec_cap_order(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, apr_dec_cap_order(false, false, 0), APR_INPUT_422_16);
+	KUNIT_EXPECT_EQ(test, apr_dec_cap_order(false, false, 1), APR_INPUT_444_16);
+	KUNIT_EXPECT_EQ(test, apr_dec_cap_order(false, false, 2), APR_INPUT_422_8);
+	KUNIT_EXPECT_EQ(test, apr_dec_cap_order(false, false, 3), APR_INPUT_444_8);
+	KUNIT_EXPECT_EQ(test, apr_dec_cap_order(false, false, 4), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apr_dec_cap_order(true, false, 0), APR_INPUT_422_16);
+	KUNIT_EXPECT_EQ(test, apr_dec_cap_order(true, false, 1), APR_INPUT_422_8);
+	KUNIT_EXPECT_EQ(test, apr_dec_cap_order(true, false, 2), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apr_dec_cap_order(true, true, 0), APR_INPUT_444_16);
+	KUNIT_EXPECT_EQ(test, apr_dec_cap_order(true, true, 1), APR_INPUT_444_8);
+	KUNIT_EXPECT_EQ(test, apr_dec_cap_order(true, true, 2), -EINVAL);
+}
+
+/* Only a new size or chroma format asks for new CAPTURE buffers. */
+static void apr_test_dec_needs_realloc(struct kunit *test)
+{
+	const struct apr_frame_info cur = { .width = 1920, .height = 1080 };
+	struct apr_frame_info fi = cur;
+
+	fi.frame_bytes = 12345;
+	KUNIT_EXPECT_FALSE(test, apr_dec_needs_realloc(&cur, &fi));
+	fi.height = 2160;
+	KUNIT_EXPECT_TRUE(test, apr_dec_needs_realloc(&cur, &fi));
+	fi = cur;
+	fi.width = 3840;
+	KUNIT_EXPECT_TRUE(test, apr_dec_needs_realloc(&cur, &fi));
+	fi = cur;
+	fi.is444 = true;
+	KUNIT_EXPECT_TRUE(test, apr_dec_needs_realloc(&cur, &fi));
+}
+
 static struct kunit_case apr_test_cases[] = {
 	KUNIT_CASE(apr_test_frame_header_ks),
 	KUNIT_CASE(apr_test_dec_layout),
+	KUNIT_CASE(apr_test_dec_cap_order),
+	KUNIT_CASE(apr_test_dec_needs_realloc),
 	KUNIT_CASE(apr_test_qmat_regs),
 	KUNIT_CASE(apr_test_dc_scale),
 	KUNIT_CASE(apr_test_profiles),
diff --git a/drivers/media/platform/apple/prores/apple-prores.h b/drivers/media/platform/apple/prores/apple-prores.h
index 7dcc6859061..b25a8757d56 100644
--- a/drivers/media/platform/apple/prores/apple-prores.h
+++ b/drivers/media/platform/apple/prores/apple-prores.h
@@ -209,6 +209,9 @@ int apr_build_decode_desc(const struct apr_dec_frame *f, u8 *desc);
 int apr_parse_frame_header(const u8 *buf, size_t len, struct apr_frame_info *info);
 int apr_dec_layout(const struct apr_frame_info *fi, enum apr_input out,
 		   struct apr_dec_layout *l);
+int apr_dec_cap_order(bool have_info, bool is444, unsigned int index);
+bool apr_dec_needs_realloc(const struct apr_frame_info *cur,
+			   const struct apr_frame_info *fi);
 int apr_check_output(const u8 *out, size_t capacity, u32 *frame_bytes);
 u32 apr_ring_advance(u32 head, u32 size, u32 ring_bytes, bool *restart);
 extern const struct apri_layout apri_t6041;
-- 
