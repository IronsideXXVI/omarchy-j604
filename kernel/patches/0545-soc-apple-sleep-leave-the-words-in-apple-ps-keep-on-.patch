From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 12:59:13 +0000
Subject: [PATCH] soc: apple: sleep: leave the words in
 apple,ps-keep-on alone

The SoC's macOS-on list comes from one machine's macOS. On the T8132
it is the J713's: eight words that macOS has at f at the commit. The
J604's macOS writes none of them before its commit, and seven of them
belong to no domain the J604 has.

Read apple,ps-keep-on at probe and skip those words both where the
match raises the list for the commit and where it puts the list back
after the wake. Without the property nothing changes.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/sleep.c | 37 +++++++++++++++++++++++++++++++++++++
 1 file changed, 37 insertions(+)

diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index 202c07c098..c6a1d24fc8 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -568,6 +568,7 @@ struct apple_sleep {
 	void __iomem *cluster_dcs;
 	/* As the match found them: one for each word of the SoC's lists */
 	u32 *ps_on_saved;
+	unsigned long ps_on_keep;	/* ps_macos_on bits to leave alone */
 	u32 *ps_off_saved;
 	u32 *ps_aon_saved;
 	u32 *ps_aon_on_saved;
@@ -2653,6 +2654,37 @@ static bool apple_sleep_ps_unlatch(struct apple_sleep *s)
 	return stuck;
 }
 
+/* A word of the SoC's macOS-on list that this machine's macOS leaves as it is. */
+static bool sleep_ps_keep(struct apple_sleep *s, int i)
+{
+	return i < BITS_PER_LONG && test_bit(i, &s->ps_on_keep);
+}
+
+/*
+ * apple,ps-keep-on: words of the SoC's macOS-on list that this machine's macOS
+ * neither raises nor touches before the commit. They are not raised for a
+ * sleep, and not put back after it.
+ */
+static void apple_sleep_read_ps_keep(struct apple_sleep *s,
+				     const struct apple_sleep_soc *soc)
+{
+	struct device_node *np = s->dev->of_node;
+	int i, j, n;
+	u32 off;
+
+	n = of_property_count_u32_elems(np, "apple,ps-keep-on");
+	for (i = 0; i < n; i++) {
+		if (of_property_read_u32_index(np, "apple,ps-keep-on", i, &off))
+			continue;
+		for (j = 0; j < soc->ps_macos_on.count && j < BITS_PER_LONG; j++)
+			if (soc->ps_macos_on.offset[j] == off)
+				__set_bit(j, &s->ps_on_keep);
+	}
+	if (s->ps_on_keep)
+		dev_info(s->dev, "%lu PS words kept as they are across a sleep\n",
+			 hweight_long(s->ps_on_keep));
+}
+
 static void apple_sleep_match(struct apple_sleep *s)
 {
 	const struct apple_sleep_soc *soc = s->soc;
@@ -2671,6 +2703,8 @@ static void apple_sleep_match(struct apple_sleep *s)
 		u32 offset = soc->ps_macos_on.offset[i];
 
 		s->ps_on_saved[i] = readl(s->ps + offset);
+		if (sleep_ps_keep(s, i))
+			continue;
 		/* State 4 reads as on, and macOS has these at f. */
 		if (FIELD_GET(PS_ACTUAL, s->ps_on_saved[i]) == 0xf)
 			continue;
@@ -2763,6 +2797,8 @@ static void apple_sleep_match_undo(struct apple_sleep *s)
 	for (i = soc->ps_macos_on.count - 1; i >= 0; i--) {
 		u32 val = s->ps_on_saved[i];
 
+		if (sleep_ps_keep(s, i))
+			continue;
 		if (!FIELD_GET(PS_ACTUAL, val))
 			sleep_ps_lower(s, soc->ps_macos_on.offset[i]);
 		else if (FIELD_GET(PS_ACTUAL, val) != 0xf)
@@ -4064,6 +4100,7 @@ static int apple_sleep_alloc_books(struct apple_sleep *s)
 		return dev_err_probe(dev, -EINVAL, "the SoC's lists are too long\n");
 
 	s->ps_on_saved = devm_kcalloc(dev, soc->ps_macos_on.count, sizeof(u32), GFP_KERNEL);
+	apple_sleep_read_ps_keep(s, soc);
 	s->ps_off_saved = devm_kcalloc(dev, soc->ps_macos_off.count, sizeof(u32), GFP_KERNEL);
 	s->ps_aon_on_saved = devm_kcalloc(dev, soc->ps_aon_macos_on.count, sizeof(u32), GFP_KERNEL);
 	s->ps_aon_saved = devm_kcalloc(dev, soc->ps_aon_macos_off.count, sizeof(u32),
-- 
2.43.0

