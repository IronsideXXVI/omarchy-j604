From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 01:39:49 +0000
Subject: [PATCH] soc: apple: cluster-pwrgate: apply_disabled on the
 command line at the initcall

apply_disabled sets the enables of a cluster power gate node that a
board still leaves disabled. Given on the command line, its handler runs
from parse_args(), before mm_core_init(): of_iomap() would then allocate
before the slab and vmalloc allocators exist.

On the command line, only record the request. The early initcall then
sets the enables right after it reports the words, which is the point
where an enabled node gets them: before the secondary CPUs and the PMP
start, as an enabled node would have them at boot. A write at runtime
still applies them at once.

The node stays disabled, and the parameter is not set by default, so a
boot without it behaves as before.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/apple-cluster-pwrgate.c | 45 ++++++++++++++++-------
 1 file changed, 31 insertions(+), 14 deletions(-)

diff --git a/drivers/soc/apple/apple-cluster-pwrgate.c b/drivers/soc/apple/apple-cluster-pwrgate.c
index 8f2b805fc1..a2bb87aab9 100644
--- a/drivers/soc/apple/apple-cluster-pwrgate.c
+++ b/drivers/soc/apple/apple-cluster-pwrgate.c
@@ -105,6 +105,25 @@ static const struct kernel_param_ops apple_cluster_pwrgate_dump_ops = {
 module_param_cb(dump_sleep_words, &apple_cluster_pwrgate_dump_ops, NULL, 0600);
 MODULE_PARM_DESC(dump_sleep_words, "Bring-up: log the T8132 CPU cluster, power gate and DVFM words a suspend-to-RAM uses, read only; at boot, or now when 1 is written (default: off)");
 
+/* Set by apply_disabled on the command line, applied by the initcall below. */
+static bool apply_disabled_req;
+
+/* Set the enables of a node left disabled, as an enabled node has them. */
+static void apple_cluster_pwrgate_apply(struct device_node *np)
+{
+	void __iomem *gate;
+	int i;
+
+	for (i = 0; (gate = of_iomap(np, i)); i++) {
+		u32 was = readl(gate);
+
+		writel(was | CLUSTER_PWRGATE_EN, gate);
+		pr_info("%pOF: cluster %d power gate %#x, now %#x (apply_disabled)\n",
+			np, i, was, readl(gate));
+		iounmap(gate);
+	}
+}
+
 /* Before the secondaries start. A core picks the word up at its next WFI. */
 static int __init apple_cluster_pwrgate_init(void)
 {
@@ -127,6 +146,8 @@ static int __init apple_cluster_pwrgate_init(void)
 					np, i, readl(gate));
 				iounmap(gate);
 			}
+			if (apply_disabled_req)
+				apple_cluster_pwrgate_apply(np);
 			continue;
 		}
 
@@ -149,6 +170,9 @@ early_initcall(apple_cluster_pwrgate_init);
  * For bring-up on a board whose node is still disabled: writing 1 sets the
  * enables of that node's words now, as an enabled node would have at boot.
  * Only once the read-only report above shows words of the expected layout.
+ * On the command line this is parsed before the allocator and ioremap work,
+ * so it only records the request and the initcall applies it, at the point
+ * an enabled node is set (before the secondaries and the PMP start).
  */
 static int apple_cluster_pwrgate_apply_set(const char *val, const struct kernel_param *kp)
 {
@@ -160,21 +184,14 @@ static int apple_cluster_pwrgate_apply_set(const char *val, const struct kernel_
 	if (ret || !apply)
 		return ret;
 
-	for_each_matching_node(np, apple_cluster_pwrgate_of_match) {
-		void __iomem *gate;
-		int i;
-
-		if (of_device_is_available(np))
-			continue;
-		for (i = 0; (gate = of_iomap(np, i)); i++) {
-			u32 was = readl(gate);
-
-			writel(was | CLUSTER_PWRGATE_EN, gate);
-			pr_info("%pOF: cluster %d power gate %#x, now %#x (apply_disabled)\n",
-				np, i, was, readl(gate));
-			iounmap(gate);
-		}
+	if (system_state != SYSTEM_RUNNING) {
+		apply_disabled_req = true;
+		return 0;
 	}
+
+	for_each_matching_node(np, apple_cluster_pwrgate_of_match)
+		if (!of_device_is_available(np))
+			apple_cluster_pwrgate_apply(np);
 	return 0;
 }
 
