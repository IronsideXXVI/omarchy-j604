From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 07:43:52 +0000
Subject: [PATCH] drm/asahi: g16: Size the parameter buffer from the
 blocks in use

Every fresh PB manager is seeded with its unit's whole heap today: 2048
blocks (256 MiB) on the full units, 128 on the compact ones. The host
never looks at how much of it a render takes.

macOS sizes the parameter buffer from what the GPU side reports in use:
three times the blocks used, rounded up to a granule, grown before the
submit and shrunk when idle. Under a 1080p fill benchmark it holds
8.25 MiB idle and 19 to 24 MiB under load.

Add g16_pb_size (runtime, default 0, read per render command). While a
render is in flight the poll pass reads the distance between the two
free-block ring words of its manager, capped at the seeded blocks, as
the high water of that PB slot. A fresh manager is then seeded with
three times that high water, rounded up to 16 blocks (2 MiB), within
the unit's heap, and InitBM is given the same count. A leased manager
that holds fewer blocks than that, or was seeded for another size, is
not reused, so the slot grows before the next submit.

1 never goes below 128 blocks (the compact units' 16 MiB) and never
shrinks a slot. 3 also shrinks it, at the slot's next fresh manager,
to the need of the window since it was last sized, down to 64 blocks.
A new stats line pb_size reports samples, grows, shrinks, refused
reuses, the widest distance and each slot's size. With 0 nothing
changes.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/engine.rs |   6 +-
 drivers/gpu/drm/asahi/g16/params.rs |  21 +++++
 drivers/gpu/drm/asahi/g16/poll.rs   |   8 ++
 drivers/gpu/drm/asahi/g16/pools.rs  | 121 ++++++++++++++++++++++++++++
 4 files changed, 155 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 78e38032e8..0a1d0a430d 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -1604,7 +1604,8 @@ fn render_refs(
             }
             None => {
                 let epoch = job.resources.pb(job.progress.sent() as usize)?;
-                let blocks = arena.heap_blocks(slot)?;
+                // g16_pb_size: the slot's size from the blocks its renders were seen holding.
+                let blocks = super::pools::sized_blocks(slot, arena.heap_blocks(slot)?);
                 epoch.prepare(slot, arena.heap_gva(slot)?, blocks)?;
                 epoch.clone()
             }
@@ -1614,6 +1615,9 @@ fn render_refs(
             a.parameter_id = slot as u32;
             a.init_blocks = arena.heap_blocks(slot)?;
         }
+        if params::pb_size() != 0 {
+            a.init_blocks = epoch.seeded_blocks();
+        }
         a.mgr_misc = epoch.misc.va;
         *pb_used = Some(epoch);
         let r = &self.graph.render;
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 3d66e00539..3d6ab32aac 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2615,6 +2615,27 @@ pub(crate) fn pb_probe() -> bool {
     "G16: read the PB manager and counter words at each render retirement and the free-block ring words while renders run, into the stats file; reads only (default 0; runtime 0644)"
 );
 
+/// Storage of `g16_pb_size` (runtime 0644, default 0).
+static PB_SIZE: AtomicU32 = AtomicU32::new(0);
+
+/// Parameter-buffer sizing from the blocks the firmware is seen holding, as macOS sizes its
+/// parameter buffer (three times the blocks in use, rounded to a granule, grown before the
+/// submit): bit 0 seeds each fresh PB manager with that many blocks, at least 128 and never
+/// fewer than the slot's last manager; bit 1 also lets it shrink to the last window's need.
+/// 0 seeds every manager with the whole heap, as before. Read per render command.
+pub(crate) fn pb_size() -> u32 {
+    PB_SIZE.load(Ordering::Relaxed) & 3
+}
+
+live_u32_param!(
+    PB_SIZE_PARAM,
+    PB_SIZE_PARMTYPE,
+    PB_SIZE_PARM,
+    PB_SIZE,
+    "g16_pb_size",
+    "G16: size each fresh PB manager at three times the blocks its slot's renders were seen holding, as macOS does (default 0: the whole heap; 1: grow only, from 128 blocks; 3: also shrink; runtime 0644)"
+);
+
 /// Storage of `g16_pb_shared` (0644, default 0; latched at its first read).
 static PB_SHARED: AtomicU32 = AtomicU32::new(0);
 /// 0 until latched, then 1 (off) or 2 (on).
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 58a943c4c5..007429d3ef 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -745,6 +745,13 @@ pub(crate) fn poll(&mut self, evented: bool, done: &mut Completions) -> Result<b
                 }
             }
         }
+        if params::pb_size() != 0 {
+            for f in self.engine.flights.iter().filter(|f| f.renders != 0) {
+                if let Some(epoch) = f.pb_used.as_ref() {
+                    let _ = epoch.size_sample();
+                }
+            }
+        }
         let mut lap = Lap::start();
         let start = lap.on().then(now_ns);
         self.retire(evented, done)?;
@@ -1849,6 +1856,7 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
             write!(f, " {:x}", w.load(Ordering::Relaxed))?;
         }
         writeln!(f)?;
+        super::pools::write_size_stats(f)?;
         let forms = &super::engine::FS_FORMS;
         writeln!(
             f,
diff --git a/drivers/gpu/drm/asahi/g16/pools.rs b/drivers/gpu/drm/asahi/g16/pools.rs
index 52d88cd040..25ae3c62d4 100644
--- a/drivers/gpu/drm/asahi/g16/pools.rs
+++ b/drivers/gpu/drm/asahi/g16/pools.rs
@@ -97,6 +97,96 @@ pub(crate) struct PoolSet {
 /// The counter words of the last probed retirement.
 pub(crate) static PROBE_CTR: [AtomicU32; CTR_WORDS] = [const { AtomicU32::new(0) }; CTR_WORDS];
 
+/// `g16_pb_size`: the start and floor of a sized manager (the compact units' 16 MiB), and the
+/// granule its size is rounded up to (16 blocks, 2 MiB).
+const SIZE_START: u32 = 128;
+const SIZE_GRANULE: u32 = 16;
+/// `g16_pb_size`: per PB slot, the widest free-block ring distance seen in flight since the
+/// slot was last sized.
+static SIZE_HW: [AtomicU32; super::hw::sizes::RENDER_UNITS] =
+    [const { AtomicU32::new(0) }; super::hw::sizes::RENDER_UNITS];
+/// `g16_pb_size`: per PB slot, the block count its last fresh manager was seeded with.
+static SIZE_NOW: [AtomicU32; super::hw::sizes::RENDER_UNITS] =
+    [const { AtomicU32::new(0) }; super::hw::sizes::RENDER_UNITS];
+/// `g16_pb_size`: [0] in-flight samples, [1] managers sized larger than the slot's last one,
+/// [2] sized smaller, [3] reuses refused because the leased manager is too small, [4] the
+/// widest ring distance seen.
+pub(crate) static SIZE: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+
+/// The block count `used` blocks in use ask for: three times that, rounded up to the granule
+/// (macOS sizes its parameter buffer at three times the blocks in use).
+fn size_want(used: u32) -> u32 {
+    used.saturating_mul(3).div_ceil(SIZE_GRANULE) * SIZE_GRANULE
+}
+
+/// `g16_pb_size`: the block count a fresh manager on PB slot `slot` is seeded with, out of the
+/// `unit` blocks its heap holds. Off, the whole heap. Bit 0: three times the widest ring
+/// distance seen on the slot, at least [`SIZE_START`], never smaller than the slot's last
+/// size. Bit 1: the widest distance of the window since the slot was last sized, down to
+/// buffer::MIN_BLOCKS; a window without samples keeps the last size.
+pub(crate) fn sized_blocks(slot: usize, unit: u32) -> u32 {
+    let mode = super::params::pb_size();
+    let (Some(hw), Some(now)) = (SIZE_HW.get(slot), SIZE_NOW.get(slot)) else {
+        return unit;
+    };
+    if mode == 0 {
+        return unit;
+    }
+    let last = now.load(Ordering::Relaxed);
+    let want = if mode & 2 != 0 {
+        match hw.swap(0, Ordering::Relaxed) {
+            0 if last != 0 => last,
+            0 => SIZE_START,
+            seen => size_want(seen).max(buffer::MIN_BLOCKS),
+        }
+    } else {
+        size_want(hw.load(Ordering::Relaxed))
+            .max(SIZE_START)
+            .max(last)
+    };
+    let blocks = want.clamp(buffer::MIN_BLOCKS, unit);
+    if last != 0 && blocks > last {
+        SIZE[1].fetch_add(1, Ordering::Relaxed);
+    } else if last != 0 && blocks < last {
+        SIZE[2].fetch_add(1, Ordering::Relaxed);
+    }
+    now.store(blocks, Ordering::Relaxed);
+    blocks
+}
+
+/// `g16_pb_size`: whether a leased manager seeded with `seeded` blocks may be reused on slot
+/// `slot`: it has the slot's current size (a manager seeded before the slot was sized, or for
+/// another size, is replaced) and still holds three times the widest ring distance seen there
+/// (grow before submit).
+fn size_holds(slot: usize, seeded: u32) -> bool {
+    if super::params::pb_size() == 0 {
+        return true;
+    }
+    let (Some(hw), Some(now)) = (SIZE_HW.get(slot), SIZE_NOW.get(slot)) else {
+        return true;
+    };
+    seeded == now.load(Ordering::Relaxed) && size_want(hw.load(Ordering::Relaxed)) <= seeded
+}
+
+/// `g16_pb_size` stats line: samples, grows, shrinks, reuses refused, the widest ring distance
+/// and each slot's current size.
+pub(crate) fn write_size_stats(f: &mut impl fmt::Write) -> fmt::Result {
+    write!(
+        f,
+        "pb_size: on {} samples {} grows {} shrinks {} reuse_refused {} ring_max {} now",
+        super::params::pb_size(),
+        SIZE[0].load(Ordering::Relaxed),
+        SIZE[1].load(Ordering::Relaxed),
+        SIZE[2].load(Ordering::Relaxed),
+        SIZE[3].load(Ordering::Relaxed),
+        SIZE[4].load(Ordering::Relaxed)
+    )?;
+    for now in &SIZE_NOW {
+        write!(f, " {}", now.load(Ordering::Relaxed))?;
+    }
+    writeln!(f)
+}
+
 fn alloc(
     o: &mut Objects,
     size: usize,
@@ -384,6 +474,11 @@ pub(crate) fn shared(
             self.stats.ring_busy += 1;
             return None;
         }
+        if !size_holds(0, epoch.seeded_blocks()) {
+            SIZE[3].fetch_add(1, Ordering::Relaxed);
+            self.stats.fresh += 1;
+            return None;
+        }
         self.stats.reused += 1;
         Some(epoch.clone())
     }
@@ -421,6 +516,11 @@ pub(crate) fn reusable(
             self.stats.ring_busy += 1;
             return None;
         }
+        if !size_holds(k, epoch.seeded_blocks()) {
+            SIZE[3].fetch_add(1, Ordering::Relaxed);
+            self.stats.fresh += 1;
+            return None;
+        }
         self.stats.reused += 1;
         Some(epoch.clone())
     }
@@ -434,6 +534,7 @@ pub(crate) fn would_reuse(&self, k: usize, vm: &Arc<super::vm::VmState>) -> bool
             && epoch.check_assignment(k).is_ok()
             && epoch.is_exposed()
             && epoch.ring_words().is_ok_and(|w| w[0] == w[1])
+            && size_holds(k, epoch.seeded_blocks())
     }
     pub(crate) fn retire_binding(&mut self, k: usize, epoch: &Arc<PbEpoch>) -> Result {
         *self.owners.get_mut(k).ok_or(EINVAL)? = Some(epoch.clone());
@@ -474,6 +575,8 @@ pub(crate) struct PbEpochInner {
     pub(crate) misc: Arc<FwObject>,
     pub(crate) initbm: Arc<FwObject>,
     assigned: AtomicU32,
+    /// The block count [`PbEpoch::prepare`] seeded the manager with.
+    seeded: AtomicU32,
     exposed: AtomicBool,
     /// The manager image as seeded (`g16_pb_probe` compares against it).
     seed: [AtomicU32; MGR_WORDS],
@@ -500,6 +603,7 @@ pub(crate) fn new(
             misc: FwObject::view(&records, 0x300, 0x40)?,
             initbm: FwObject::view(&records, 0x400, 0x20)?,
             assigned: AtomicU32::new(u32::MAX),
+            seeded: AtomicU32::new(0),
             exposed: AtomicBool::new(false),
             seed: [const { AtomicU32::new(0) }; MGR_WORDS],
             _objects: o,
@@ -551,9 +655,14 @@ pub(crate) fn prepare(&self, k: usize, heap: u64, blocks: u32) -> Result {
                 Ordering::Relaxed,
             );
         }
+        self.seeded.store(blocks, Ordering::Relaxed);
         self.assigned.store(k as u32, Ordering::Release);
         Ok(())
     }
+    /// The block count the manager was seeded with (0 before [`Self::prepare`]).
+    pub(crate) fn seeded_blocks(&self) -> u32 {
+        self.seeded.load(Ordering::Relaxed)
+    }
     pub(crate) fn check_assignment(&self, k: usize) -> Result {
         if self.assigned.load(Ordering::Acquire) != k as u32 {
             return Err(EINVAL);
@@ -610,6 +719,18 @@ pub(crate) fn probe_flight(&self) -> Result {
         }
         Ok(())
     }
+    /// `g16_pb_size` while a render binding this manager is in flight: the free-block ring
+    /// distance, at most the seeded blocks, as the high water of the manager's PB slot.
+    pub(crate) fn size_sample(&self) -> Result {
+        let [a, b] = self.ring_words()?;
+        let used = a.abs_diff(b).min(self.seeded_blocks());
+        SIZE[0].fetch_add(1, Ordering::Relaxed);
+        SIZE[4].fetch_max(u64::from(used), Ordering::Relaxed);
+        if let Some(hw) = SIZE_HW.get(self.assigned.load(Ordering::Acquire) as usize) {
+            hw.fetch_max(used, Ordering::Relaxed);
+        }
+        Ok(())
+    }
 }
 
 impl Firmware {
