From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 18:03:24 +0000
Subject: [PATCH] phy: apple: atc: say whether a port can run
 SuperSpeed

On the Type-C ports the dwc3 glue starts the controller, and with it
both xHCI root hubs, only once a cable is attached, so an idle port has
no root hub of any kind. Nothing then tells whether the port would run
SuperSpeed: the PHY warns when its calibration is incomplete and is
silent when it is complete, and the only trace of the USB3 route is a
debug line that reads PIPE handler registers.

Say it once at probe ("SuperSpeed: ready" or the reason it is not:
no SuperSpeed banks in the device tree, calibration incomplete, a
DisplayPort-only PHY), and add a debugfs file atcphy-<device>/state
with the PHY's own view of the port: SuperSpeed and CIO availability,
the current and the requested mode, the PIPE backend, the host role,
the T8132 common-block ownership, failure and suspend flags, and the
USB3 refusals. Every line comes from driver fields; reading the file
never touches the hardware, so it is safe in any power state.

KUnit: the state string for each probe outcome and the mode names.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 930f1380abacefa97e24618a0d5694d1350539b3)
(cherry picked from commit fd45c1294fa05e53ff1c63ccd343ecfd42d18278)
---
 drivers/phy/apple/atc-test.c | 30 ++++++++++++++++++++++++++++++
 drivers/phy/apple/atc.c      |  1 +
 2 files changed, 31 insertions(+)

diff --git a/drivers/phy/apple/atc-test.c b/drivers/phy/apple/atc-test.c
index e3c1454691..03d375b023 100644
--- a/drivers/phy/apple/atc-test.c
+++ b/drivers/phy/apple/atc-test.c
@@ -1444,6 +1444,35 @@ static void atcphy_test_t8132_usb3_cold(struct kunit *test)
 	KUNIT_EXPECT_NE(test, atcphy->mode, APPLE_ATCPHY_MODE_USB2);
 }
 
+/* The state the debugfs file and the probe line give for each probe outcome. */
+static void atcphy_test_ss_state(struct kunit *test)
+{
+	struct apple_atcphy *atcphy = atcphy_test_alloc_powered_off(test);
+
+	atcphy->hw = &atcphy_hw_t8132;
+	KUNIT_EXPECT_STREQ(test, atcphy_ss_state(atcphy),
+			   "usb2-only (no SuperSpeed banks in the device tree)");
+	atcphy->t8132_ss = true;
+	KUNIT_EXPECT_STREQ(test, atcphy_ss_state(atcphy), "usb2-only (calibration incomplete)");
+	atcphy->ss_tunables = true;
+	KUNIT_EXPECT_STREQ(test, atcphy_ss_state(atcphy), "ready");
+	atcphy->t8132_failed = true;
+	KUNIT_EXPECT_STREQ(test, atcphy_ss_state(atcphy),
+			   "failed (a PHY transition failed, no retry until reset)");
+	atcphy->dp_only = true;
+	KUNIT_EXPECT_STREQ(test, atcphy_ss_state(atcphy), "none (DisplayPort-only PHY)");
+
+	/* Other generations have no banks to describe. */
+	atcphy->hw = &atcphy_hw_t8103;
+	atcphy->dp_only = false;
+	atcphy->t8132_ss = false;
+	KUNIT_EXPECT_STREQ(test, atcphy_ss_state(atcphy), "ready");
+
+	KUNIT_EXPECT_STREQ(test, atcphy_mode_name(APPLE_ATCPHY_MODE_USB3_DP), "usb3-dp");
+	KUNIT_EXPECT_STREQ(test, atcphy_mode_name(APPLE_ATCPHY_MODE_DP), "dp");
+	KUNIT_EXPECT_STREQ(test, atcphy_mode_name((enum atcphy_mode)42), "?");
+}
+
 static void atcphy_test_t8103_usb3_machine_scope(struct kunit *test)
 {
 	static const struct {
@@ -1535,6 +1564,7 @@ static struct kunit_case atcphy_t8132_pm_test_cases[] = {
 	KUNIT_CASE(atcphy_test_t8132_usb3_dp_not_cold),
 	KUNIT_CASE(atcphy_test_t8132_cio_not_cold),
 	KUNIT_CASE(atcphy_test_t8132_usb3_cold),
+	KUNIT_CASE(atcphy_test_ss_state),
 #ifdef CONFIG_SUSPEND
 	KUNIT_CASE(atcphy_test_t8132_system_suspend),
 #endif
diff --git a/drivers/phy/apple/atc.c b/drivers/phy/apple/atc.c
index 308da1d1d6..3170607dbd 100644
--- a/drivers/phy/apple/atc.c
+++ b/drivers/phy/apple/atc.c
@@ -21,6 +21,7 @@
 #include <kunit/static_stub.h>
 #include <linux/bitfield.h>
 #include <linux/cleanup.h>
+#include <linux/debugfs.h>
 #include <linux/delay.h>
 #include <linux/devm-helpers.h>
 #include <linux/iopoll.h>
