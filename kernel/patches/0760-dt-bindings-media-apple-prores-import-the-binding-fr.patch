From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 22:30:38 +0000
Subject: [PATCH] dt-bindings: media: apple,prores: import the binding
 from aurora

Import the Apple ProRes encoder (APR) binding from aurora-silicon/linux
integration/aurora 2362d9a55b as it is there, with the MAINTAINERS
section aurora has for the binding and the driver. The binding already
describes the T8132 engine: "apple,t8132-prores", "apple,prores" with
three register windows, two interrupts, one power domain and one IOMMU,
as the T8132 ADT lists them.

Upstream history of the file (all by Ryan Murray): a66ebc3af0 first, then
the shared resource variants up to f67926c275.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
(cherry picked from commit c290a0a2e4052879381645018bc28cdeba3b4f6b)
---
 .../bindings/media/apple,prores.yaml          | 284 ++++++++++++++++++
 MAINTAINERS                                   |   8 +
 2 files changed, 292 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/apple,prores.yaml

diff --git a/Documentation/devicetree/bindings/media/apple,prores.yaml b/Documentation/devicetree/bindings/media/apple,prores.yaml
new file mode 100644
index 0000000000..78514091b7
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/apple,prores.yaml
@@ -0,0 +1,284 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/apple,prores.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple Silicon ProRes codec (APR)
+
+maintainers:
+  - Ryan Murray <ryan@aurorasilicon.org>
+
+description: |
+  The APR is a directly programmed ProRes engine with its own DART. Jobs are
+  descriptors in a DMA ring; the engine signals completion with an
+  interrupt. It has no firmware. Its power domain also resets it.
+
+select:
+  properties:
+    compatible:
+      contains:
+        enum:
+          - apple,t6000-prores
+          - apple,t6020-prores
+          - apple,t6021-prores
+          - apple,t6022-prores
+          - apple,t6030-prores
+          - apple,t6031-prores
+          - apple,t6032-prores
+          - apple,t6041-prores
+          - apple,t8112-prores
+          - apple,t8122-prores
+          - apple,t8132-prores
+          - apple,t6050-prores
+          - apple,t8140-prores
+  required:
+    - compatible
+
+properties:
+  compatible: true
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8132-prores
+    then:
+      properties:
+        reg:
+          minItems: 3
+          maxItems: 3
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - apple,t8132-prores
+              - apple,t6050-prores
+      required:
+        - compatible
+    then:
+      properties:
+        compatible:
+          items:
+            - enum:
+                - apple,t8132-prores
+                - apple,t6050-prores
+            - const: apple,prores
+
+        reg:
+          minItems: 2
+          maxItems: 5
+          description:
+            Three windows on T8132. On T6050 the ADT lists two for the first
+            ProRes instance and five for the second.
+
+        interrupts:
+          minItems: 2
+          maxItems: 2
+
+        power-domains:
+          maxItems: 1
+
+        iommus:
+          maxItems: 1
+
+      required:
+        - compatible
+        - reg
+        - interrupts
+        - power-domains
+        - iommus
+    else:
+      allOf:
+        - if:
+            properties:
+              compatible:
+                contains:
+                  enum:
+                    - apple,t6032-prores
+            required:
+              - compatible
+          then:
+            properties:
+              compatible:
+                items:
+                  - const: apple,t6032-prores
+                  - const: apple,prores
+
+              reg:
+                minItems: 2
+                maxItems: 3
+
+              interrupts:
+                maxItems: 1
+
+              power-domains:
+                maxItems: 1
+
+              iommus:
+                minItems: 1
+                maxItems: 2
+
+            required:
+              - compatible
+              - reg
+              - interrupts
+              - power-domains
+              - iommus
+          else:
+            properties:
+              compatible:
+                oneOf:
+                  - const: apple,t8140-prores
+                  - items:
+                      - enum:
+                          - apple,t6000-prores
+                          - apple,t6020-prores
+                          - apple,t6021-prores
+                          - apple,t6022-prores
+                          - apple,t6030-prores
+                          - apple,t6031-prores
+                          - apple,t6041-prores
+                          - apple,t8112-prores
+                          - apple,t8122-prores
+                      - const: apple,prores
+
+              reg:
+                minItems: 2
+                maxItems: 3
+                description: Engine, wrapper and generation-specific auxiliary register windows.
+
+              reg-names:
+                minItems: 2
+                items:
+                  - const: core
+                  - const: wrapper
+                  - const: aux
+
+              interrupts:
+                minItems: 1
+                maxItems: 2
+
+              iommus:
+                minItems: 1
+                maxItems: 2
+
+              power-domains:
+                minItems: 1
+                items:
+                  - description: The engine's power domain
+                  - description: Performance request held while the engine works
+
+              power-domain-names:
+                minItems: 1
+                items:
+                  - const: core
+                  - const: perf
+
+              resets:
+                maxItems: 1
+
+            required:
+              - compatible
+              - reg
+              - interrupts
+              - iommus
+              - power-domains
+
+            allOf:
+              - if:
+                  properties:
+                    compatible:
+                      contains:
+                        enum:
+                          - apple,t6030-prores
+                          - apple,t6031-prores
+                          - apple,t8122-prores
+                then:
+                  properties:
+                    reg:
+                      minItems: 2
+                      maxItems: 3
+                    power-domains:
+                      maxItems: 1
+              - if:
+                  properties:
+                    compatible:
+                      contains:
+                        enum:
+                          - apple,t6020-prores
+                          - apple,t6021-prores
+                          - apple,t6022-prores
+                          - apple,t8112-prores
+                then:
+                  properties:
+                    reg:
+                      maxItems: 2
+                    reg-names:
+                      maxItems: 2
+              - if:
+                  properties:
+                    compatible:
+                      contains:
+                        enum:
+                          - apple,t6041-prores
+                then:
+                  properties:
+                    reg:
+                      minItems: 3
+                      maxItems: 3
+                    reg-names:
+                      minItems: 3
+                      maxItems: 3
+                    interrupts:
+                      maxItems: 1
+                    iommus:
+                      maxItems: 1
+                  required:
+                    - resets
+                    - reg-names
+              - if:
+                  properties:
+                    compatible:
+                      contains:
+                        enum:
+                          - apple,t8140-prores
+                then:
+                  properties:
+                    reg:
+                      maxItems: 2
+                    reg-names:
+                      maxItems: 2
+                    iommus:
+                      maxItems: 1
+                  required:
+                    - reg-names
+
+            additionalProperties: false
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/apple-aic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        video-codec@295000000 {
+            compatible = "apple,t8140-prores";
+            reg = <0x2 0x95000000 0x0 0x4000>,
+                  <0x2 0x94000000 0x0 0x8000>;
+            reg-names = "core", "wrapper";
+            interrupt-parent = <&aic>;
+            interrupts = <AIC_IRQ 1260 IRQ_TYPE_LEVEL_HIGH>,
+                         <AIC_IRQ 1259 IRQ_TYPE_LEVEL_HIGH>;
+            iommus = <&apr_dart 0>;
+            power-domains = <&ps_prores>;
+            resets = <&ps_prores>;
+        };
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index 37c9d5db72..5bc14929ad 100644
