From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 22:24:09 +0000
Subject: [PATCH] drm/asahi: g16: Add a runtime ceiling on the governed
 GPU state

The host governor's user ceiling is fixed at the table's top, so no
run-time setting can hold the GPU at a lower state. Measuring what
clock each state delivers needs exactly that: the same ALU-bound load
at each state in turn.

Add g16_max_pstate (runtime 0644, default 0). 0 keeps the table's top;
1 to the top caps the published state there, under the cooling
ceiling, and the next power pass publishes it. Nothing changes at 0.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 21 +++++++++++++++++++++
 drivers/gpu/drm/asahi/g16/power.rs  |  2 +-
 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 8365ddb13a..b2fb266414 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -499,6 +499,27 @@ pub(crate) fn onebell() -> u32 {
     "G16: runtime completion repoll interval, us (default 0 = g16_resnap_us; 10..1000; runtime 0644)"
 );
 
+/// Storage of `g16_max_pstate` (runtime 0644, default 0 = no user ceiling).
+static MAX_PSTATE: AtomicU32 = AtomicU32::new(0);
+
+/// The user ceiling on the governed state: `g16_max_pstate` (1 to the table's top), or the
+/// table's top when 0. The cooling ceiling still applies below it.
+pub(crate) fn max_pstate() -> u32 {
+    match MAX_PSTATE.load(Ordering::Relaxed) {
+        0 => pstate_max(),
+        state => state.clamp(1, pstate_max()),
+    }
+}
+
+live_u32_param!(
+    MAX_PSTATE_PARAM,
+    MAX_PSTATE_PARMTYPE,
+    MAX_PSTATE_PARM,
+    MAX_PSTATE,
+    "g16_max_pstate",
+    "G16: highest governed performance state (default 0: the table's top; 1..top; runtime 0644)"
+);
+
 /// Storage of `g16_irq_only` (runtime 0644, default 0).
 static IRQ_ONLY: AtomicU32 = AtomicU32::new(0);
 
diff --git a/drivers/gpu/drm/asahi/g16/power.rs b/drivers/gpu/drm/asahi/g16/power.rs
index ec8d710ade..bb3acb37da 100644
--- a/drivers/gpu/drm/asahi/g16/power.rs
+++ b/drivers/gpu/drm/asahi/g16/power.rs
@@ -258,7 +258,7 @@ fn ceiling(&mut self, now: u64, idle: bool) -> (u32, bool) {
         // The full cooling level still reaches S1 with an eleven-row table.
         let top = policy::pstate_max();
         let ceiling = if level >= COOLING_MAX { 1 } else { top - level };
-        let limit = policy::limit(self.configured, ceiling, self.user);
+        let limit = policy::limit(self.configured, ceiling, self.user.min(params::max_pstate()));
         let decision = (
             limit,
             self.governor,
