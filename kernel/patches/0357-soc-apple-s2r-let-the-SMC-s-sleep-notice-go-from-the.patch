From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 08:11:50 +0000
Subject: [PATCH 357/358] soc: apple: s2r: let the SMC's sleep notice go from
 the T8132 finisher

On macOS (J604, 26B123) the SMC stamps each sleep it registers within
1 ms of the last AP step. Ours tells the SMC at its noirq suspend, before
all of ->enter. To test whether that order matters, let the SMC driver
hand its notice to the T8132 finisher, which sends it right before the
commit: after both watchdogs are armed and before the smc-stamp counter,
the last cache cleans and the commit.

Past the coprocessor stops a refusal can't be undone, so a notice the
SMC does not take resets through apple_s2r_t8132_fatal() with its own
stage, 0x51, as every other refusal from that point; the next boot
reads it as the stage byte. What the notice dirtied is cleaned to the
PoC with the rest. Only the T8132 sequence takes the registration.

Assisted-by: LLM
---
 drivers/soc/apple/apple-s2r.c   | 42 +++++++++++++++++++++++++++++++++
 include/linux/soc/apple/sleep.h |  6 +++++
 2 files changed, 48 insertions(+)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index f0f104086d..8c7714100b 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -1121,6 +1121,31 @@ void apple_sleep_enclave_unregister(struct device *dev)
 }
 EXPORT_SYMBOL_GPL(apple_sleep_enclave_unregister);
 
+/* smc-notice-late: macsmc's sleep notice, for the finisher to send right before the commit */
+static struct {
+	int (*notice)(void *data);
+	void *data;
+	size_t size;
+} apple_s2r_late;
+
+int apple_sleep_smc_late_register(int (*notice)(void *data), void *data, size_t size)
+{
+	if (!apple_s2r || !t8132_sequence)
+		return -EOPNOTSUPP;
+	apple_s2r_late.data = data;
+	apple_s2r_late.size = size;
+	WRITE_ONCE(apple_s2r_late.notice, notice);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_sleep_smc_late_register);
+
+void apple_sleep_smc_late_unregister(void *data)
+{
+	if (apple_s2r_late.data == data)
+		WRITE_ONCE(apple_s2r_late.notice, NULL);
+}
+EXPORT_SYMBOL_GPL(apple_sleep_smc_late_unregister);
+
 void apple_sleep_coproc_set_ready(struct device *dev, bool ready)
 {
 	struct apple_s2r_coproc *c;
@@ -1562,6 +1587,8 @@ enum apple_s2r_crumb {
 	S2R_CRUMB_T8132_RAISE_APCIE,	/* 0x4e split step: ANS's APCIe block back */
 	S2R_CRUMB_T8132_RAISE_DONE,	/* 0x4f split step: returning -ECANCELED */
 	/* T8132 sequence, the return through cpu_resume */
+	/* smc-notice-late: the SMC did not take the late notice, reset (stage, not a step) */
+	S2R_CRUMB_T8132_NOTICE = 0x51,
 	S2R_CRUMB_T8132_BACK = 0x61,	/* first C line after the wake */
 	S2R_CRUMB_T8132_BACK_CLUSTERS,	/* 0x62 CPU clusters on */
 	S2R_CRUMB_T8132_BACK_PS,	/* 0x63 power words and ATC0 written back */
@@ -3363,6 +3390,21 @@ static int apple_s2r_t8132_finish(unsigned long arg)
 	if (s2r->wdt_armed)
 		apple_s2r_wdt_arm_secs(s2r, min_t(u32, wdt_timeout, T8132_WD1_COMMIT_SECS));
 
+	/*
+	 * smc-notice-late: the SMC's notice here instead of at its noirq. Past the
+	 * coprocessor stops a refusal can't be undone, so one not answered resets
+	 * with its own stage, as every other refusal from here.
+	 */
+	if (READ_ONCE(apple_s2r_late.notice)) {
+		ret = apple_s2r_late.notice(apple_s2r_late.data);
+		if (ret) {
+			pr_emerg("apple-s2r: T8132: late SMC sleep notice not taken: %d\n", ret);
+			apple_s2r_t8132_fatal(s2r, S2R_CRUMB_T8132_NOTICE);
+		}
+		dcache_clean_poc((unsigned long)apple_s2r_late.data,
+				 (unsigned long)apple_s2r_late.data + apple_s2r_late.size);
+	}
+
 	/* smc-stamp: the commit's time on the AP counter, cleaned with the rest */
 	t->commit_cycles = get_cycles();
 	t->commit_cycles_read = true;
diff --git a/include/linux/soc/apple/sleep.h b/include/linux/soc/apple/sleep.h
index ca1c9a8371..ffbde89cf3 100644
--- a/include/linux/soc/apple/sleep.h
+++ b/include/linux/soc/apple/sleep.h
@@ -117,6 +117,9 @@ int apple_sleep_apcie_port_down(unsigned int port);
 bool apple_sleep_apcie_hold(struct device_node *np);
 /* The SMC's clock (CLKU, us) at its sleep notice, read between two get_cycles(). */
 void apple_sleep_smc_clock_mark(u64 smc_us, u64 cycles_before, u64 cycles_after);
+/* smc-notice-late: the SMC's sleep notice, sent by the T8132 finisher right before the commit. */
+int apple_sleep_smc_late_register(int (*notice)(void *data), void *data, size_t size);
+void apple_sleep_smc_late_unregister(void *data);
 #else
 static inline int apple_sleep_coproc_register(struct device *dev, void __iomem *asc,
 					      bool pcie_ans, int (*last_stop)(void *data),
@@ -142,6 +145,9 @@ static inline int apple_sleep_apcie_port_down(unsigned int port) { return 0; }
 static inline bool apple_sleep_apcie_hold(struct device_node *np) { return false; }
 static inline void apple_sleep_smc_clock_mark(u64 smc_us, u64 cycles_before,
 					      u64 cycles_after) { }
+static inline int apple_sleep_smc_late_register(int (*notice)(void *data), void *data,
+						size_t size) { return -EOPNOTSUPP; }
+static inline void apple_sleep_smc_late_unregister(void *data) { }
 #endif
 
