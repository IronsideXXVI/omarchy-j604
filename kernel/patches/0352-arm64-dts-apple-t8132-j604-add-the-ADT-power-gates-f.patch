@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Check apple-s2r's apple,pwrgate-regs (the J604 ADT's pmgr pwrgate-regs).
+
+The J604 device tree must carry the four records of the J604 ADT's
+/arm-io/pmgr pwrgate-regs (26B123) as they are, and its "pmgr0" / "pmgr1"
+windows must be pmgr reg[0] and reg[1] and hold every record's word. The
+driver must read the words at probe and at the commit without writing them,
+write them only behind t8132_pwrgate_adt (default off) as m1n1's
+tunables_apply_global() does (mask cleared, value set), refuse a record
+outside its window or with mask and value sharing a bit, and put a written
+word back after an abort in reverse order.
+"""
+import argparse
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[2]
+DT = 'arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi'
+S2R = 'drivers/soc/apple/apple-s2r.c'
+# The J604 ADT (macOS 26B123), /arm-io/pmgr pwrgate-regs: {reg index, offset, mask, value}
+ADT = [(0, 0x2504c, 0x402001, 0x80000000), (0, 0x2604c, 0, 0x80000000),
+       (0, 0x2704c, 0, 0x80000000), (1, 0x1c01c, 0, 0x80000000)]
+# ... and its pmgr reg[0] / reg[1] bases, through arm-io ranges (child 0 -> 0x200000000)
+ADT_REG = {0: 0x380700000, 1: 0x388280000}
+MUTATIONS = {
+    'param-on': ('static bool t8132_pwrgate_adt;', 'static bool t8132_pwrgate_adt = true;'),
+    'always-write': ('\t\tif (!write)\n\t\t\tcontinue;\n', ''),
+    'wrong-apply': ('val = (t->pga_saved[i] & ~t->pga[i].mask) | t->pga[i].value;',
+                    'val = t->pga_saved[i] | t->pga[i].value;'),
+    'no-bounds': ('p->offset > t->pmgr_reg_size[p->reg] - 4 ||', ''),
+    'no-overlap-check': ('\t\t    (p->mask & p->value))', '\t\t    0)'),
+    'no-undo': ('\tapple_s2r_t8132_pga_undo(s2r);\n\tif (!t->pg_changed)', '\tif (!t->pg_changed)'),
+    'undo-forward': ('\tfor (i = t->npga - 1; i >= 0; i--)\n\t\tif (t->pga_changed & BIT(i))',
+                     '\tfor (i = 0; i < t->npga; i++)\n\t\tif (t->pga_changed & BIT(i))'),
+    'dt-record': ('<0 0x2704c 0x0 0x80000000>', '<0 0x2704c 0x0 0x40000000>'),
+    'dt-window': ('<0x3 0x88280000 0x0 0x1d000>', '<0x3 0x88280000 0x0 0x10000>'),
+    'no-commit-read': ('\t\tt->pga_commit[i] = readl(apple_s2r_t8132_pga_addr(t, i));\n\tt->quiesce_still_on = 0;',
+                       '\tt->quiesce_still_on = 0;'),
+}
+
+
+def fn_body(src, head):
+    at = src.index(head)
+    return src[at:src.index('\n}\n', at)]
+
+
+def node(dt):
+    at = dt.index('compatible = "apple,t8132-pmgr-s2r";')
+    return dt[at:dt.index('\n\t};', at)]
+
+
+def check(s2r, dt):
+    n = node(dt)
+    cells = re.search(r'apple,pwrgate-regs = (.*?);', n, re.S)
+    assert cells, 'Assertion failed: no apple,pwrgate-regs in the J604 DT'
+    recs = [tuple(int(x, 0) for x in g.split()) for g in re.findall(r'<([^>]*)>', cells.group(1))]
+    assert recs == ADT, f'Assertion failed: DT records {recs} are not the ADT\'s {ADT}'
+    regs = [tuple(int(x, 0) for x in g.split()) for g in re.findall(r'<([^>]*)>', re.search(r'\breg = (.*?);', n, re.S).group(1))]
+    names = re.findall(r'"([^"]+)"', re.search(r'reg-names = (.*?);', n, re.S).group(1))
+    assert len(regs) == len(names), 'Assertion failed: reg / reg-names count'
+    win = {}
+    for i, nm in enumerate(('pmgr0', 'pmgr1')):
+        assert nm in names, f'Assertion failed: no {nm} window'
+        hi, lo, _, size = regs[names.index(nm)]
+        win[i] = ((hi << 32) | lo, size)
+        assert win[i][0] == ADT_REG[i], f'Assertion failed: {nm} is {win[i][0]:#x}, not pmgr reg[{i}]'
+    for r, off, mask, val in recs:
+        assert off % 4 == 0 and off + 4 <= win[r][1], f'Assertion failed: record {off:#x} outside window {r}'
+        assert not (mask & val), 'Assertion failed: a record\'s mask and value share a bit'
+
+    assert 'static bool t8132_pwrgate_adt;' in s2r, 'Assertion failed: t8132_pwrgate_adt must default to off'
+    assert 'module_param(t8132_pwrgate_adt, bool, 0644);' in s2r
+    mp = fn_body(s2r, 'static int apple_s2r_t8132_map_pga(')
+    assert 'writel' not in mp, 'Assertion failed: probe must only read the words'
+    for need in ('p->reg >= T8132_PGA_REGS', 'p->offset % 4', 'p->offset > t->pmgr_reg_size[p->reg] - 4', '(p->mask & p->value)'):
+        assert need in mp, f'Assertion failed: probe lacks the check {need}'
+    en = fn_body(s2r, 'static void apple_s2r_t8132_pga_enter(struct apple_s2r *s2r, bool write)')
+    assert 0 <= en.find('t->pga_saved[i] = readl(reg);') < en.find('\t\tif (!write)\n\t\t\tcontinue;') < en.find('writel(val, reg);'), \
+        'Assertion failed: the words must be read always and written only when asked'
+    assert 'val = (t->pga_saved[i] & ~t->pga[i].mask) | t->pga[i].value;' in en, \
+        "Assertion failed: the write must be m1n1's mask32(addr, mask, value)"
+    pg = fn_body(s2r, 'static void apple_s2r_t8132_pg_enable(struct apple_s2r *s2r)')
+    assert 'apple_s2r_t8132_pga_enter(s2r, READ_ONCE(t8132_pwrgate_adt));' in pg, \
+        'Assertion failed: the write must be gated by t8132_pwrgate_adt'
+    un = fn_body(s2r, 'static void apple_s2r_t8132_pga_undo(struct apple_s2r *s2r)')
+    assert 'for (i = t->npga - 1; i >= 0; i--)' in un and 'writel(t->pga_saved[i]' in un, \
+        'Assertion failed: the undo must put the words back in reverse order'
+    pu = fn_body(s2r, 'static void apple_s2r_t8132_pg_undo(struct apple_s2r *s2r)')
+    assert 0 <= pu.find('apple_s2r_t8132_pga_undo(s2r);') < pu.find('if (!t->pg_changed)'), \
+        'Assertion failed: an abort must put the words back'
+    fin = fn_body(s2r, 'static int apple_s2r_t8132_finish(unsigned long arg)')
+    assert fin.find('t->pga_commit[i] = readl(apple_s2r_t8132_pga_addr(t, i));') >= 0 and \
+        fin.find('t->pga_commit[i] = readl(') < fin.find('writel(S2R_TIMER_START, t->commit);'), \
+        'Assertion failed: the words must be read before the commit'
+    return recs
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path)
+    parser.add_argument('--mutation', choices=MUTATIONS)
+    args = parser.parse_args()
+    s2r = (ROOT / S2R).read_text()
+    dt = (ROOT / DT).read_text()
+    if args.mutation:
+        old, new = MUTATIONS[args.mutation]
+        if old in s2r:
+            s2r = s2r.replace(old, new, 1)
+        else:
+            assert old in dt, f'missing mutation site: {old}'
+            dt = dt.replace(old, new, 1)
+    try:
+        recs = check(s2r, dt)
+    except (AssertionError, ValueError, AttributeError) as e:
+        print(e if str(e).startswith('Assertion') else f'Assertion failed: {e}')
+        raise SystemExit(1)
+    line = 't8132 pwrgate-regs: %d records as the ADT has them, in their windows; read at probe and at the commit, written only with t8132_pwrgate_adt' % len(recs)
+    if args.out:
+        args.out.write_text(line + '\n')
+    print(line)
+
+
+if __name__ == '__main__':
+    main()
-- 
