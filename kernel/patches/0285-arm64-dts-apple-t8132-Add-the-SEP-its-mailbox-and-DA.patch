From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Sun, 25 Oct 2026 19:58:58 -0400
Subject: [PATCH] arm64: dts: apple: t8132: Add the SEP, its mailbox and DART,
 and SPI2

The Secure Enclave and its DART, as the ADT describes them: SEP at
0x3aa600000 with its ASC mailbox at +0x8000 (AIC 389-392), DART at
0x3a8c80000 (AIC 399) with the BIT(40) input alias the DART translates.
The DART's register window is 0x20000: its stale-exception drain reads
per-stream registers past 0x4000.

SPI2 at 0x3ad108000 (AIC 1056) carries the Mesa fingerprint sensor. As on
T8140 it runs from the 24 MHz reference clock; with a 200 MHz rate the
divider for the sensor's 8 MHz gave about 1 MHz and frame reads timed out.
The sensor node takes SPI mode 2, as the 0x3356 sensor does on J700.

All disabled. The SEP driver enables the SEP and its DART itself; a
board with a qualified sensor enables the mailbox and SPI2.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 0fe3023281dffbdef258a62f68e28bc93f236afa)
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 58 ++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index c054528614..226d40b727 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -683,6 +683,44 @@
 			};
 		};
 
+		/*
+		 * The SEP DART's input aperture is the BIT(40) alias the DART
+		 * translates (ADT vm-base-0 0x10000004000).
+		 */
+		sep_dart: iommu@3a8c80000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x3 0xa8c80000 0x0 0x20000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 399 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			apple,dma-range = /bits/ 64 <0x10000004000 0xffff0000>;
+			apple,dma-offset = /bits/ 64 <0x0>;
+			status = "disabled";
+		};
+
+		sep: sep@3aa600000 {
+			compatible = "apple,sep";
+			reg = <0x3 0xaa600000 0x0 0x88000>;
+			mboxes = <&sep_mbox>;
+			mbox-names = "mbox";
+			iommus = <&sep_dart 0>;
+			status = "disabled";
+		};
+
+		sep_mbox: mbox@3aa608000 {
+			compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x3 0xaa608000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 389 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 390 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 391 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 392 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+				"recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			status = "disabled";
+		};
+
 		i2c0: i2c@3ad010000 {
 			compatible = "apple,t8132-i2c", "apple,t8103-i2c";
 			reg = <0x3 0xad010000 0x0 0x4000>;
@@ -773,6 +811,26 @@
 			status = "disabled";
 		};
 
+		spi2: spi@3ad108000 {
+			compatible = "apple,t8132-spi", "apple,t8103-spi";
+			reg = <0x3 0xad108000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1056 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clkref>;
+			power-domains = <&ps_spi2>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+
+			mesa: fingerprint@0 {
+				compatible = "apple,mesa-fingerprint";
+				reg = <0>;
+				spi-max-frequency = <8000000>;
+				spi-cpol;
+				status = "disabled";
+			};
+		};
+
 		serial0: serial@3ad200000 {
 			compatible = "apple,s5l-uart";
 			reg = <0x3 0xad200000 0x0 0x1000>;
