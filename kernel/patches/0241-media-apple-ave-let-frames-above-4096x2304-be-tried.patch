From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 02:50:30 +0000
Subject: [PATCH] media: apple: ave: let frames above 4096x2304 be
 tried

The encoder offers frames from 320x240 to 4096x2304, the range it was
seen working at plus some room. Whether it encodes larger frames, and
with which buffer sizes, has never been measured.

Add the module parameters max_width and max_height (default 4096 and
2304, at most 8192 and 4352) to offer a larger bound. They are writable
at run time and apply to files opened afterwards, so the encoder can be
tried at larger sizes without reloading the driver. With a larger bound
only:

- the H.264 and HEVC level controls and the level choice reach level
  6.2 (H.264 Table A-1, HEVC Table A-8 Main tier), so a picture above
  level 5.2 is given a level that allows it;
- the HEVC picture area is capped at the level 6.2 limit instead of the
  5.2 one.

The coded buffer may now exceed 32 MiB when the frame needs it, and the
raw stride limit follows the width bound. With the default parameters
the bound, the levels and every buffer size stay as they are.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/ave/ave-sess.c | 18 ++++++-
 drivers/media/platform/apple/ave/ave-v4l2.c | 58 +++++++++++++++++----
 2 files changed, 63 insertions(+), 13 deletions(-)

diff --git a/drivers/media/platform/apple/ave/ave-sess.c b/drivers/media/platform/apple/ave/ave-sess.c
index b0edfff468..02f8265648 100644
--- a/drivers/media/platform/apple/ave/ave-sess.c
+++ b/drivers/media/platform/apple/ave/ave-sess.c
@@ -54,7 +54,7 @@ struct ave_level {
 	u32 max_kbps;
 };
 
-/* H.264 Table A-1, in V4L2 menu order (1, 1b, 1.1 ... 5.2); macroblocks. */
+/* H.264 Table A-1, in V4L2 menu order (1, 1b, 1.1 ... 5.2, 6 ... 6.2); macroblocks. */
 static const struct ave_level ave_h264_levels[] = {
 	{ 99, 1485, 64 },	    { 99, 1485, 128 },
 	{ 396, 3000, 192 },	    { 396, 6000, 384 },
@@ -65,17 +65,27 @@ static const struct ave_level ave_h264_levels[] = {
 	{ 8192, 245760, 50000 },    { 8704, 522240, 50000 },
 	{ 22080, 589824, 135000 },  { 36864, 983040, 240000 },
 	{ 36864, 2073600, 240000 },
+	/* Levels 6 to 6.2: only with the larger frame bound (ave_large_frames()). */
+	{ 139264, 4177920, 240000 }, { 139264, 8355840, 480000 },
+	{ 139264, 16711680, 800000 },
 };
 
-/* HEVC Table A-8 (Main tier), in V4L2 menu order (1, 2, 2.1 ... 5.1); samples. */
+#define AVE_H264_DEFAULT_LEVELS 17
+
+/* HEVC Table A-8 (Main tier), in V4L2 menu order (1, 2, 2.1 ... 5.1, 5.2 ... 6.2); samples. */
 static const struct ave_level ave_hevc_levels[] = {
 	{ 36864, 552960, 128 },	       { 122880, 3686400, 1500 },
 	{ 245760, 7372800, 3000 },     { 552960, 16588800, 6000 },
 	{ 983040, 33177600, 10000 },   { 2228224, 66846720, 12000 },
 	{ 2228224, 133693440, 20000 }, { 8912896, 267386880, 25000 },
 	{ 8912896, 534773760, 40000 },
+	/* Levels 5.2 to 6.2: only with the larger frame bound (ave_large_frames()). */
+	{ 8912896, 1069547520, 60000 },   { 35651584, 1069547520, 60000 },
+	{ 35651584, 2139095040, 120000 }, { 35651584, 4278190080ULL, 240000 },
 };
 
+#define AVE_HEVC_DEFAULT_LEVELS 9
+
 /*
  * The lowest level that fits the picture, rate and bit rate, or the
  * requested one if that is higher. Returned as the firmware's 1-based enum.
@@ -90,6 +100,10 @@ static int ave_pick_level(const struct ave_params *p, u32 requested)
 	u64 rate = DIV_ROUND_UP_ULL(size * p->fps_num, p->fps_den);
 	u32 kbps = DIV_ROUND_UP(p->bitrate, 1000);
 
+	/* Without the larger frame bound, the levels stay the tested ones. */
+	if (!ave_large_frames())
+		n = hevc ? AVE_HEVC_DEFAULT_LEVELS : AVE_H264_DEFAULT_LEVELS;
+
 	for (unsigned int i = 0; i < n; i++) {
 		u32 max_kbps = t[i].max_kbps;
 
diff --git a/drivers/media/platform/apple/ave/ave-v4l2.c b/drivers/media/platform/apple/ave/ave-v4l2.c
index 60a64367e4..39b3c32163 100644
--- a/drivers/media/platform/apple/ave/ave-v4l2.c
+++ b/drivers/media/platform/apple/ave/ave-v4l2.c
@@ -9,6 +9,7 @@
  */
 #include <linux/delay.h>
 #include <linux/log2.h>
+#include <linux/moduleparam.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 #include <linux/slab.h>
@@ -27,12 +28,17 @@
 /*
  * Frame size limits and input stride alignment: the range the encoder was
  * seen working at (320x240 up to the 2408x1506 panel), with a little room.
- * Larger sizes need buffer sizes nobody has checked yet.
+ * Larger sizes need buffer sizes nobody has checked yet; max_width and
+ * max_height let them be tried, up to level 6.2 (8192x4352). They are read
+ * when a file is opened and when a format or session is set up, so a change
+ * applies to files opened afterwards.
  */
 #define AVE_MIN_W		320
 #define AVE_MIN_H		240
 #define AVE_MAX_W		4096
 #define AVE_MAX_H		2304
+#define AVE_TRY_MAX_W		8192
+#define AVE_TRY_MAX_H		4352
 #define AVE_STEP		16
 #define AVE_STRIDE_ALIGN	64
 #define AVE_DEFAULT_W		1920
@@ -63,6 +69,30 @@ static const struct v4l2_event ave_eos_event = {
 	.type = V4L2_EVENT_EOS,
 };
 
+static unsigned int max_width = AVE_MAX_W;
+module_param(max_width, uint, 0644);
+MODULE_PARM_DESC(max_width, "Largest frame width offered to files opened from now on (default 4096, at most 8192)");
+
+static unsigned int max_height = AVE_MAX_H;
+module_param(max_height, uint, 0644);
+MODULE_PARM_DESC(max_height, "Largest frame height offered to files opened from now on (default 2304, at most 4352)");
+
+static u32 ave_max_w(void)
+{
+	return clamp_t(u32, ALIGN(max_width, 2), AVE_MIN_W, AVE_TRY_MAX_W);
+}
+
+static u32 ave_max_h(void)
+{
+	return clamp_t(u32, ALIGN(max_height, 2), AVE_MIN_H, AVE_TRY_MAX_H);
+}
+
+/* Frames beyond the default bound were asked for: levels above 5.2 apply. */
+bool ave_large_frames(void)
+{
+	return ave_max_w() > AVE_MAX_W || ave_max_h() > AVE_MAX_H;
+}
+
 enum ave_codec ave_ctx_codec(struct ave_ctx *ctx)
 {
 	return ctx->dst_fmt.pixelformat == V4L2_PIX_FMT_HEVC ? AVE_CODEC_HEVC :
@@ -77,16 +107,19 @@ static bool ave_fmt_listed(const u32 *list, unsigned int n, u32 fourcc)
 	return false;
 }
 
-/* HEVC Main tier levels 5 to 5.2 allow at most this many luma samples. */
+/* HEVC Main tier levels 5 to 5.2, and 6 to 6.2, allow at most this many luma samples. */
 #define AVE_HEVC_MAX_SAMPLES	8912896
+#define AVE_HEVC_L6_MAX_SAMPLES	35651584
 
 /* @coded is the coded format the size is for: HEVC caps the picture area. */
 static void ave_clamp_size(u32 coded, u32 *w, u32 *h)
 {
-	*w = clamp_t(u32, ALIGN(*w, 2), AVE_MIN_W, AVE_MAX_W);
-	*h = clamp_t(u32, ALIGN(*h, 2), AVE_MIN_H, AVE_MAX_H);
-	if (coded == V4L2_PIX_FMT_HEVC && *w * *h > AVE_HEVC_MAX_SAMPLES)
-		*h = rounddown(AVE_HEVC_MAX_SAMPLES / *w, 2);
+	u32 samples = ave_large_frames() ? AVE_HEVC_L6_MAX_SAMPLES : AVE_HEVC_MAX_SAMPLES;
+
+	*w = clamp_t(u32, ALIGN(*w, 2), AVE_MIN_W, ave_max_w());
+	*h = clamp_t(u32, ALIGN(*h, 2), AVE_MIN_H, ave_max_h());
+	if (coded == V4L2_PIX_FMT_HEVC && *w * *h > samples)
+		*h = rounddown(samples / *w, 2);
 }
 
 /*
@@ -107,7 +140,7 @@ static void ave_fill_raw(struct v4l2_pix_format_mplane *f, u32 coded)
 	ave_clamp_size(coded, &f->width, &f->height);
 	/* Keep a client's stride, within reason, rounded to 64 bytes. */
 	stride = ALIGN(clamp_t(u32, f->plane_fmt[0].bytesperline, f->width * bytes,
-			       2 * AVE_MAX_W * bytes),
+			       2 * ave_max_w() * bytes),
 		       AVE_STRIDE_ALIGN);
 	height = ALIGN(f->height, AVE_STEP);
 	f->num_planes = 1;
@@ -129,7 +162,8 @@ static void ave_fill_coded(struct v4l2_pix_format_mplane *f)
 	min = ALIGN(3 * ALIGN(f->width, 32) * ALIGN(f->height, 16) / 2, SZ_16K) + SZ_64K;
 	f->num_planes = 1;
 	f->plane_fmt[0].bytesperline = 0;
-	f->plane_fmt[0].sizeimage = clamp_t(u32, f->plane_fmt[0].sizeimage, min, SZ_32M);
+	f->plane_fmt[0].sizeimage = clamp_t(u32, f->plane_fmt[0].sizeimage, min,
+					    max_t(u32, min, SZ_32M));
 	f->field = V4L2_FIELD_NONE;
 	memset(f->plane_fmt[0].reserved, 0, sizeof(f->plane_fmt[0].reserved));
 	memset(f->reserved, 0, sizeof(f->reserved));
@@ -195,7 +229,7 @@ static int ave_enum_framesizes(struct file *file, void *priv, struct v4l2_frmsiz
 		return -EINVAL;
 	fs->type = V4L2_FRMSIZE_TYPE_STEPWISE;
 	fs->stepwise = (struct v4l2_frmsize_stepwise){
-		AVE_MIN_W, AVE_MAX_W, 2, AVE_MIN_H, AVE_MAX_H, 2,
+		AVE_MIN_W, ave_max_w(), 2, AVE_MIN_H, ave_max_h(), 2,
 	};
 	return 0;
 }
@@ -570,7 +604,8 @@ static int ave_init_ctrls(struct ave_ctx *ctx)
 			       V4L2_MPEG_VIDEO_H264_PROFILE_MAIN);
 	/* A minimum: the driver raises it to what size, rate and bit rate need. */
 	v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_MPEG_VIDEO_H264_LEVEL,
-			       V4L2_MPEG_VIDEO_H264_LEVEL_5_2, 0,
+			       ave_large_frames() ? V4L2_MPEG_VIDEO_H264_LEVEL_6_2 :
+						    V4L2_MPEG_VIDEO_H264_LEVEL_5_2, 0,
 			       V4L2_MPEG_VIDEO_H264_LEVEL_1_0);
 	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_H264_MIN_QP, 0, 51, 1, 0);
 	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_H264_MAX_QP, 0, 51, 1, 51);
@@ -582,7 +617,8 @@ static int ave_init_ctrls(struct ave_ctx *ctx)
 				 BIT(V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_10)),
 			       V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN);
 	v4l2_ctrl_new_std_menu(hdl, ops, V4L2_CID_MPEG_VIDEO_HEVC_LEVEL,
-			       V4L2_MPEG_VIDEO_HEVC_LEVEL_5_1, 0,
+			       ave_large_frames() ? V4L2_MPEG_VIDEO_HEVC_LEVEL_6_2 :
+						    V4L2_MPEG_VIDEO_HEVC_LEVEL_5_1, 0,
 			       V4L2_MPEG_VIDEO_HEVC_LEVEL_1);
 	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_HEVC_MIN_QP, 0, 51, 1, 0);
 	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_MPEG_VIDEO_HEVC_MAX_QP, 0, 51, 1, 51);
-- 
2.43.0

