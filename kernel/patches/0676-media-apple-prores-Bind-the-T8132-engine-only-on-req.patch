From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 08:12:05 +0000
Subject: [PATCH] media: apple: prores: Bind the T8132 engine only on
 request

The T8132 engine has not run on a machine yet. Give it a platform
driver of its own, registered only with apple_prores.t8132=1 on the
kernel command line or at module load. With the parameter off, which is
the default, nothing binds the J604's ProRes node: its power domain is
not attached and its windows are not mapped. The other engines keep
their driver as before.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../platform/apple/prores/apple-prores-drv.c  | 50 ++++++++++++++++++-
 1 file changed, 48 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/apple/prores/apple-prores-drv.c b/drivers/media/platform/apple/prores/apple-prores-drv.c
index 2fb78e1cb5..5b15bdf361 100644
--- a/drivers/media/platform/apple/prores/apple-prores-drv.c
+++ b/drivers/media/platform/apple/prores/apple-prores-drv.c
@@ -1418,7 +1418,6 @@ static const struct of_device_id apr_of_match[] = {
 	{ .compatible = "apple,t6000-prores", .data = &apr_t6000 },
 	{ .compatible = "apple,t6041-prores", .data = &apr_t6041 },
 	{ .compatible = "apple,t6050-prores", .data = &apr_t6050 },
-	{ .compatible = "apple,t8132-prores", .data = &apr_t8132 },
 	{ .compatible = "apple,t8140-prores", .data = &apr_t8140 },
 	{ }
 };
@@ -1433,7 +1432,54 @@ static struct platform_driver apr_driver = {
 		.pm = pm_ptr(&apr_pm_ops),
 	},
 };
-module_platform_driver(apr_driver);
+/*
+ * The T8132 (M4) engine binds only on request: apple_prores.t8132=1 on the
+ * kernel command line (or at module load). Off by default, so nothing binds
+ * its node, and neither its power domain nor its windows are touched, until
+ * the engine has run on the machine. A driver of its own keeps the other
+ * engines as they are.
+ */
+static bool t8132;
+module_param(t8132, bool, 0444);
+MODULE_PARM_DESC(t8132, "Bind the T8132 (M4) ProRes engine (default: off)");
+
+static const struct of_device_id apr_t8132_of_match[] = {
+	{ .compatible = "apple,t8132-prores", .data = &apr_t8132 },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, apr_t8132_of_match);
+
+static struct platform_driver apr_t8132_driver = {
+	.probe = apr_probe,
+	.remove = apr_remove,
+	.driver = {
+		.name = APR_NAME "-t8132",
+		.of_match_table = apr_t8132_of_match,
+		.pm = pm_ptr(&apr_pm_ops),
+	},
+};
+
+static int __init apr_init(void)
+{
+	int ret;
+
+	ret = platform_driver_register(&apr_driver);
+	if (ret || !t8132)
+		return ret;
+	ret = platform_driver_register(&apr_t8132_driver);
+	if (ret)
+		platform_driver_unregister(&apr_driver);
+	return ret;
+}
+module_init(apr_init);
+
+static void __exit apr_exit(void)
+{
+	if (t8132)
+		platform_driver_unregister(&apr_t8132_driver);
+	platform_driver_unregister(&apr_driver);
+}
+module_exit(apr_exit);
 
 MODULE_DESCRIPTION("Apple ProRes encoder");
 MODULE_LICENSE("GPL");
-- 
2.43.0

