From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 18 Nov 2026 14:24:40 +0000
Subject: [PATCH] drm/asahi: g16: Optionally keep render microsequences
 in session slots

g16_render_seq_pool=1 (load time, default 0) allocates at boot two
session objects, one uncached and one ASC-cached, each with one TA and
one FS microsequence slot per render unit. A render then writes its live
TA and FS microsequences into its unit's slot instead of the unit's
per-VM sequence objects, and the work records and the finalize back
references name that slot.

Render units are claimed device-wide, so no two VMs use a slot at once.
The session objects are never dropped, so a cached class never reaches a
per-VM mapping that is dropped at client exit.

g16_render_seq_cached (runtime 0644, default 0) picks the copy for the
renders published from then on: 0 the uncached one, 1 the ASC-cached
one, the attribute index macOS uses for these objects. The firmware
cleans and invalidates each stage's sequence at its prepare and at its
post. The stats file gains a render_seq line with the publication count
per copy.

Values 0 of both parameters behave as before.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/asahi_core.rs |  4 ++++
 drivers/gpu/drm/asahi/g16/engine.rs | 25 +++++++++++++++++---
 drivers/gpu/drm/asahi/g16/graph.rs  | 36 +++++++++++++++++++++++++++++
 drivers/gpu/drm/asahi/g16/params.rs | 30 ++++++++++++++++++++++++
 drivers/gpu/drm/asahi/g16/poll.rs   | 12 ++++++++++
 5 files changed, 104 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_core.rs b/drivers/gpu/drm/asahi/asahi_core.rs
index 8057d6fb00..54a7442859 100644
--- a/drivers/gpu/drm/asahi/asahi_core.rs
+++ b/drivers/gpu/drm/asahi/asahi_core.rs
@@ -291,6 +291,10 @@ fn init(module: &'static kernel::ThisModule) -> impl PinInit<Self, Error> {
             default: 1,
             description: "G16: 1 queue 2 compute 4 TA 8 FS 16 ring; 32/64/128 work/seq/barrier",
         },
+        g16_render_seq_pool: u32 {
+            default: 0,
+            description: "G16: 1 = render microsequences in session slots per unit, uncached and ASC-cached copies",
+        },
         g16_host_records: u32 {
             default: 0,
             description: "G16: bounded host record bytes before publication (default off)",
diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 0bf5af4593..4208da8d57 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -2232,7 +2232,15 @@ fn prefix_render(
         self.slots.hold_vm(&f.claims, &job.vm, job.resources.compute_arc())?;
         let (refs, init_buffer) = self.render_refs(k, job, draw, &mut f.pb_used)?;
         let p = job.resources.render()?.pass(k).ok_or(EINVAL)?;
-        let pass = p.refs();
+        let mut pass = p.refs();
+        // g16_render_seq_pool: the live microsequences go to unit k's session slot; every
+        // reference the encoders derive from them (work +0x770 / +0x14, the finalize back
+        // references) then names that slot.
+        let seq_slot = self.graph.render_seq_slot(k);
+        if let Some((obj, ta_at, fs_at, _)) = &seq_slot {
+            pass.ta_seq = obj.va + *ta_at as u64;
+            pass.fs_seq = obj.va + *fs_at as u64;
+        }
         let geometry = Geometry::new(&cmd.cmd, pass.heap_gva);
         super::poll::note_fs_words([
             u64::from(geometry.tilebuffer_control),
@@ -2349,8 +2357,19 @@ fn prefix_render(
             &mut scratch.scene[..],
         );
         p.write_work(&scratch.ta[..], &scratch.fs[..])?;
-        p.ta_seq.write(0, &scratch.tas[..])?;
-        p.fs_seq.write(0, &scratch.fss[..])?;
+        match &seq_slot {
+            Some((obj, ta_at, fs_at, copy)) => {
+                obj.write(*ta_at, &scratch.tas[..])?;
+                obj.write(*fs_at, &scratch.fss[..])?;
+                if let Some(c) = super::poll::RENDER_SEQ.get(*copy) {
+                    c.fetch_add(1, core::sync::atomic::Ordering::Relaxed);
+                }
+            }
+            None => {
+                p.ta_seq.write(0, &scratch.tas[..])?;
+                p.fs_seq.write(0, &scratch.fss[..])?;
+            }
+        }
         p.scene.write(0, &scratch.scene[..])?;
         // One retained descriptor is shared by TA and FS; its private submitted counter
         // advances by two. Reused descriptors and their pool/list bytes remain intact.
diff --git a/drivers/gpu/drm/asahi/g16/graph.rs b/drivers/gpu/drm/asahi/g16/graph.rs
index 739613f506..4cf3a8fb44 100644
--- a/drivers/gpu/drm/asahi/g16/graph.rs
+++ b/drivers/gpu/drm/asahi/g16/graph.rs
@@ -291,7 +291,15 @@ pub(crate) struct Graphs {
     pub(crate) render: RenderGraph,
     /// `g16_render_queues` 2: a second render queue set under its own scheduling context.
     pub(crate) render2: Option<RenderGraph>,
+    /// `g16_render_seq_pool`: one TA and one FS microsequence slot per render unit, in an
+    /// uncached [0] and an ASC-cached [1] session object, never dropped while the session lives.
+    pub(crate) render_seq: Option<[Arc<FwObject>; 2]>,
 }
+
+/// Bytes per render unit in each `g16_render_seq_pool` object: the TA slot, then the FS slot,
+/// each as large as a unit's own sequence object and page aligned.
+pub(crate) const RENDER_SEQ_STRIDE: usize =
+    super::fw::work::ta::SEQ_OBJECT + super::fw::work::fs::SEQ_OBJECT;
 impl Graphs {
     pub(crate) fn new(dev: &AsahiDrmDevice, o: &mut Objects) -> Result<Self> {
         let compute = ComputeGraph::new(o)?;
@@ -309,13 +317,41 @@ pub(crate) fn new(dev: &AsahiDrmDevice, o: &mut Objects) -> Result<Self> {
         } else {
             None
         };
+        let render_seq = if super::params::render_seq_pool() {
+            let size = sizes::RENDER_UNITS * RENDER_SEQ_STRIDE;
+            Some([
+                alloc(o, size, Class::Fw, None, 0, false)?,
+                alloc(o, size, Class::FwCached, None, 0, false)?,
+            ])
+        } else {
+            None
+        };
         Ok(Self {
             dev: dev.as_ref().as_ref().into(),
             compute,
             render,
             render2,
+            render_seq,
         })
     }
+
+    /// Unit `k`'s `g16_render_seq_pool` slot: the object, the TA and FS offsets in it, and the
+    /// copy (0 uncached, 1 ASC-cached, as `g16_render_seq_cached` reads now). None without the
+    /// pool, so the unit's own sequence objects are used.
+    pub(crate) fn render_seq_slot(&self, k: usize) -> Option<(Arc<FwObject>, usize, usize, usize)> {
+        let pool = self.render_seq.as_ref()?;
+        if k >= sizes::RENDER_UNITS {
+            return None;
+        }
+        let copy = usize::from(super::params::render_seq_cached());
+        let at = k * RENDER_SEQ_STRIDE;
+        Some((
+            pool[copy].clone(),
+            at,
+            at + super::fw::work::ta::SEQ_OBJECT,
+            copy,
+        ))
+    }
 }
 impl Firmware {
     /// `g16_render_queues` 2: initialises the second render queue set and registers it.
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 635fca6e5d..986ea76f53 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -709,6 +709,36 @@ pub(crate) fn fw_cached_mask() -> u32 {
     module_parameters::g16_fw_cached.value()
 }
 
+/// `g16_render_seq_pool` (load time, default 0). 1: at boot two session objects, one uncached
+/// and one ASC-cached, each hold one TA and one FS microsequence slot per render unit, and every
+/// render writes its live microsequences into its unit's slot instead of the unit's per-VM
+/// sequence objects. Render units are claimed device-wide, so no two VMs use a slot at once, and
+/// the session objects are never dropped, so a cached class never reaches a per-VM mapping that
+/// is dropped at client exit.
+pub(crate) fn render_seq_pool() -> bool {
+    module_parameters::g16_render_seq_pool.value() == 1
+}
+
+/// Storage of `g16_render_seq_cached` (runtime 0644, default 0).
+static RENDER_SEQ_CACHED: AtomicU32 = AtomicU32::new(0);
+
+/// With `g16_render_seq_pool`, whether renders published from now on name the ASC-cached copy of
+/// their unit's microsequence slot (attribute index 0, the class macOS gives these objects)
+/// instead of the uncached one. The firmware cleans and invalidates each stage's sequence when
+/// it prepares the stage and again at its post.
+pub(crate) fn render_seq_cached() -> bool {
+    RENDER_SEQ_CACHED.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    RENDER_SEQ_CACHED_PARAM,
+    RENDER_SEQ_CACHED_PARMTYPE,
+    RENDER_SEQ_CACHED_PARM,
+    RENDER_SEQ_CACHED,
+    "g16_render_seq_cached",
+    "G16: with g16_render_seq_pool=1, publish renders with the ASC-cached copy of their unit's microsequence slot (default 0: the uncached copy; runtime 0644)"
+);
+
 /// `g16_ktrace_mask` (load time): the word written to CONTROL+0 at init. 25G83 copies it into
 /// its trace gate (0x192db4) from fn 0x3350, which INIT points at CONTROL through init-block
 /// +0xa8. Bit 0 enables the event-handler trace points, bit 1 the scheduler ones, bit 2 the power
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 2228a0867d..80fe5b8dad 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -162,6 +162,10 @@ fn wbig_stats(f: &mut fmt::Formatter<'_>) -> fmt::Result {
 /// previous FS (`g16_render_chain`).
 pub(crate) static RENDER_CHAINED: core::sync::atomic::AtomicU64 =
     core::sync::atomic::AtomicU64::new(0);
+/// Renders whose microsequences went to a `g16_render_seq_pool` slot: [0] the uncached copy,
+/// [1] the ASC-cached copy.
+pub(crate) static RENDER_SEQ: [core::sync::atomic::AtomicU64; 2] =
+    [const { core::sync::atomic::AtomicU64::new(0) }; 2];
 /// Render commands queued behind work whose start came 100 us or more after the previous command's
 /// end: bins 0-15 = 10 us steps from the host's event read that preceded the previous retirement to
 /// this start, 16 = started before that read, 17 = no read recorded.
@@ -2022,6 +2026,14 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
             RENDER_CHAINED.load(Ordering::Relaxed),
             RENDER_NOWAIT.load(Ordering::Relaxed)
         )?;
+        writeln!(
+            f,
+            "render_seq: pool {} uncached {} cached {} select {}",
+            u32::from(super::params::render_seq_pool()),
+            RENDER_SEQ[0].load(Ordering::Relaxed),
+            RENDER_SEQ[1].load(Ordering::Relaxed),
+            u32::from(super::params::render_seq_cached())
+        )?;
         writeln!(
             f,
             "rekick: pass {} timer_render {} timer_compute {} rekick {} rekick_us {} irq {}",
