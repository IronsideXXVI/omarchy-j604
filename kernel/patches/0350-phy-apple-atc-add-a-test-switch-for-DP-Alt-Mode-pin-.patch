From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 22:20:41 +0000
Subject: [PATCH] phy: apple: atc: add a test switch for DP Alt Mode
 pin assignment D on T8132

USB-C monitors and docks with a USB hub usually take pin assignment D:
two DP lanes beside USB3. On T8132 the PHY already runs that mode. For
USB3 it sets up the lane mode and crossbar words of the mode table,
with the DP pair, applies the AUX calibration and starts the common
block. But the DP PHY refuses DCP's activate and link rate calls in
that mode, and the display fabric does not route the display, so such
a monitor gets USB and no picture.

Add t8132_dp_alt_d, off by default. When it is set, the DP PHY takes
activate and deactivate in USB3+DP mode as it does in DP mode. It sets
the link rate and drive levels through the T8122 sequence, which
already works per lane pair from the mode table. It reports that it
runs two lanes beside USB3 (apple_atc_dp_alt_lanes() returns 2), and
the fabric then routes pin assignment D. The switch is read when the
display side asks, so a test can set it and replug. With it off,
nothing changes.

This is the PHY half. The display fabric part (dcp-fabric) goes with
the T8132 DP Alt Mode route in the display series.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/phy/apple/atc.c | 32 ++++++++++++++++++++++++++++++--
 1 file changed, 30 insertions(+), 2 deletions(-)

diff --git a/drivers/phy/apple/atc.c b/drivers/phy/apple/atc.c
index 7c5cdf2e18..ee1ebfab38 100644
--- a/drivers/phy/apple/atc.c
+++ b/drivers/phy/apple/atc.c
@@ -1500,6 +1500,26 @@ module_param(t8132_usb4_pipe, bool, 0644);
 MODULE_PARM_DESC(t8132_usb4_pipe,
 		 "T8132: route the PIPE to the USB4 side in CIO mode for tunnelled USB3 (default: N; experimental)");
 
+/*
+ * Test switch for DP Alt Mode pin assignment D on T8132: two DP lanes beside
+ * USB3. The PHY already runs that mode for USB3 with the DP pair and AUX set
+ * up (atcphy_configure_t8132()); the switch lets the DP PHY carry the link on
+ * that pair, through the T8122 rate and drive sequence that works per lane
+ * pair. Read when the display side asks, so it applies from the next
+ * connection. Off by default.
+ */
+static bool t8132_dp_alt_d;
+module_param(t8132_dp_alt_d, bool, 0644);
+MODULE_PARM_DESC(t8132_dp_alt_d,
+		 "T8132: run DP Alt Mode pin assignment D (two DP lanes beside USB3) (default: N; experimental)");
+
+/* Does this T8132 Type-C PHY take pin assignment D, by the test switch? */
+static bool atcphy_t8132_dp_alt_d(const struct apple_atcphy *atcphy)
+{
+	return READ_ONCE(t8132_dp_alt_d) && !atcphy->dp_only &&
+	       atcphy->hw->gen == ATCPHY_GENERATION_T8132;
+}
+
 /*
  * The PIPE backend a mode needs. T8132 carries no USB3 over USB4 yet, so its
  * PIPE stays on the dummy backend in CIO, as in a mode without USB3. Routed to
@@ -4853,6 +4873,10 @@ static int atcphy_dpphy_set_mode_t8132(struct apple_atcphy *atcphy, enum phy_mod
 	    (atcphy->mode == APPLE_ATCPHY_MODE_USB4 || atcphy->mode == APPLE_ATCPHY_MODE_TBT ||
 	     atcphy->mode == APPLE_ATCPHY_MODE_DP))
 		return 0;
+	/* Pin assignment D: the DP pair was set up with USB3 by the mux. */
+	if ((mode == PHY_MODE_DP || mode == PHY_MODE_INVALID) &&
+	    atcphy->mode == APPLE_ATCPHY_MODE_USB3_DP && atcphy_t8132_dp_alt_d(atcphy))
+		return 0;
 	return -EOPNOTSUPP;
 }
 
@@ -4903,7 +4927,8 @@ static int atcphy_dpphy_configure_t8122(struct apple_atcphy *atcphy,
 
 	/* A T8132 Type-C port in a tunnel sets its rate through its own call. */
 	if (atcphy->hw->gen == ATCPHY_GENERATION_T8132 && !atcphy->dp_only &&
-	    atcphy->mode != APPLE_ATCPHY_MODE_DP)
+	    atcphy->mode != APPLE_ATCPHY_MODE_DP &&
+	    !(atcphy->mode == APPLE_ATCPHY_MODE_USB3_DP && atcphy_t8132_dp_alt_d(atcphy)))
 		return -EOPNOTSUPP;
 	if (opts->set_lanes)
 		return -EINVAL;
@@ -5179,7 +5204,10 @@ int apple_atc_dp_alt_lanes(struct phy *phy)
 	atcphy = phy_get_drvdata(phy);
 	if (atcphy->hw->gen != ATCPHY_GENERATION_T8132)
 		return 1;
-	return atcphy_t8132_dp_lanes(atcphy);
+	if (!atcphy_t8132_dp_lanes(atcphy))
+		return 0;
+	/* 2: two lanes beside USB3 as well (pin assignment D), by the test switch */
+	return atcphy_t8132_dp_alt_d(atcphy) ? 2 : 1;
 }
 EXPORT_SYMBOL_GPL(apple_atc_dp_alt_lanes);
 
-- 
