From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 20:20:38 +0000
Subject: [PATCH] media: apple: ave: encode frames up to 8192x4352 by
 default

The encoder offered 4096x2304 unless max_width and max_height were
raised. On the M4 (T8132) macOS encodes HEVC at 8K on this hardware
(7680x4320 at 15 fps, the pixel rate its encoder reports), and a 8K
request here was refused: the bound clamped the format to 4096x2304
and no level up to 5.1 allowed the bit rate it asked for.

Make 8192x4352, level 6.2, the default bound. The levels above 5.2 and
the level 6.2 picture area now apply by default, since they depend on
the bound reaching beyond 4096x2304. One 8K session maps under 1 GiB of
working buffers in the 4 GiB DART window.

H.264 stays within 4096x4096, the AVC limit macOS reports for this
encoder: the coded format is clamped to it and a larger H.264 session
is refused before any buffer is mapped. The raw side keeps the full
bound, as clients set it before the coded format.

Also correct the window size in a comment: the working buffers are
mapped in the DART window, not a 256 MiB one.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/media/platform/apple/ave/ave-sess.c |  6 +++-
 drivers/media/platform/apple/ave/ave-v4l2.c | 31 +++++++++++++--------
 drivers/media/platform/apple/ave/ave.h      |  2 ++
 3 files changed, 26 insertions(+), 13 deletions(-)

diff --git a/drivers/media/platform/apple/ave/ave-sess.c b/drivers/media/platform/apple/ave/ave-sess.c
index 02f8265648..cbe8341d21 100644
--- a/drivers/media/platform/apple/ave/ave-sess.c
+++ b/drivers/media/platform/apple/ave/ave-sess.c
@@ -156,6 +156,10 @@ static int ave_sess_params(struct ave_ctx *ctx, struct ave_params *p)
 	p->fps_den = ctx->timeperframe.numerator;
 	p->fps_int = max(DIV_ROUND_CLOSEST(p->fps_num, p->fps_den), 1U);
 
+	if (p->codec == AVE_CODEC_H264 &&
+	    (p->width > AVE_H264_MAX_DIM || p->height > AVE_H264_MAX_DIM))
+		return -EINVAL;
+
 	if (p->codec == AVE_CODEC_H264) {
 		switch (ctx->h264_profile) {
 		case V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE:
@@ -327,7 +331,7 @@ static void ave_req(struct ave_buf_req *r, unsigned int *n, struct ave_buf *b, s
 
 /*
  * Working buffer sizes, all from the requested picture size. The DMA layer
- * aligns each mapping to a power of two in the encoder's 256 MiB window, so
+ * aligns each mapping to a power of two in the encoder's DART window, so
  * the buffers are mapped largest first: the smaller ones then fill the
  * alignment gaps the large ones leave.
  */
diff --git a/drivers/media/platform/apple/ave/ave-v4l2.c b/drivers/media/platform/apple/ave/ave-v4l2.c
index 39b3c32163..05aac53870 100644
--- a/drivers/media/platform/apple/ave/ave-v4l2.c
+++ b/drivers/media/platform/apple/ave/ave-v4l2.c
@@ -26,19 +26,22 @@
 #define AVE_NAME		"apple-ave"
 
 /*
- * Frame size limits and input stride alignment: the range the encoder was
- * seen working at (320x240 up to the 2408x1506 panel), with a little room.
- * Larger sizes need buffer sizes nobody has checked yet; max_width and
- * max_height let them be tried, up to level 6.2 (8192x4352). They are read
- * when a file is opened and when a format or session is set up, so a change
- * applies to files opened afterwards.
+ * Frame size limits and input stride alignment. The encoder takes frames up
+ * to level 6.2 (8192x4352): on the M4 (T8132) macOS encodes HEVC at 8K on
+ * this hardware. H.264 stays within 4096x4096, the AVC limit macOS reports
+ * for the same encoder. max_width and max_height can lower the bound; they
+ * are read when a file is opened and when a format or session is set up, so
+ * a change applies to files opened afterwards.
  */
 #define AVE_MIN_W		320
 #define AVE_MIN_H		240
-#define AVE_MAX_W		4096
-#define AVE_MAX_H		2304
+#define AVE_MAX_W		8192
+#define AVE_MAX_H		4352
 #define AVE_TRY_MAX_W		8192
 #define AVE_TRY_MAX_H		4352
+/* Above this bound the levels above 5.2 apply. */
+#define AVE_BASE_W		4096
+#define AVE_BASE_H		2304
 #define AVE_STEP		16
 #define AVE_STRIDE_ALIGN	64
 #define AVE_DEFAULT_W		1920
@@ -71,11 +74,11 @@ static const struct v4l2_event ave_eos_event = {
 
 static unsigned int max_width = AVE_MAX_W;
 module_param(max_width, uint, 0644);
-MODULE_PARM_DESC(max_width, "Largest frame width offered to files opened from now on (default 4096, at most 8192)");
+MODULE_PARM_DESC(max_width, "Largest frame width offered to files opened from now on (default and at most 8192)");
 
 static unsigned int max_height = AVE_MAX_H;
 module_param(max_height, uint, 0644);
-MODULE_PARM_DESC(max_height, "Largest frame height offered to files opened from now on (default 2304, at most 4352)");
+MODULE_PARM_DESC(max_height, "Largest frame height offered to files opened from now on (default and at most 4352)");
 
 static u32 ave_max_w(void)
 {
@@ -87,10 +90,10 @@ static u32 ave_max_h(void)
 	return clamp_t(u32, ALIGN(max_height, 2), AVE_MIN_H, AVE_TRY_MAX_H);
 }
 
-/* Frames beyond the default bound were asked for: levels above 5.2 apply. */
+/* The bound reaches beyond 4096x2304: levels above 5.2 apply. */
 bool ave_large_frames(void)
 {
-	return ave_max_w() > AVE_MAX_W || ave_max_h() > AVE_MAX_H;
+	return ave_max_w() > AVE_BASE_W || ave_max_h() > AVE_BASE_H;
 }
 
 enum ave_codec ave_ctx_codec(struct ave_ctx *ctx)
@@ -158,6 +161,10 @@ static void ave_fill_coded(struct v4l2_pix_format_mplane *f)
 	if (!ave_fmt_listed(ave_coded_fmts, ARRAY_SIZE(ave_coded_fmts), f->pixelformat))
 		f->pixelformat = ave_coded_fmts[0];
 	ave_clamp_size(f->pixelformat, &f->width, &f->height);
+	if (f->pixelformat == V4L2_PIX_FMT_H264) {
+		f->width = min_t(u32, f->width, AVE_H264_MAX_DIM);
+		f->height = min_t(u32, f->height, AVE_H264_MAX_DIM);
+	}
 	/* The firmware's coded-data capacity plus parameter sets and headers. */
 	min = ALIGN(3 * ALIGN(f->width, 32) * ALIGN(f->height, 16) / 2, SZ_16K) + SZ_64K;
 	f->num_planes = 1;
diff --git a/drivers/media/platform/apple/ave/ave.h b/drivers/media/platform/apple/ave/ave.h
index cc67d60f8b..35e3f77b06 100644
--- a/drivers/media/platform/apple/ave/ave.h
+++ b/drivers/media/platform/apple/ave/ave.h
@@ -416,6 +416,8 @@ struct ave_frame_result {
 };
 
 #define AVE_MAX_REFS 5
+/* H.264 frames are at most this wide and tall (the AVC limit of the encoder). */
+#define AVE_H264_MAX_DIM 4096
 #define AVE_TILE_BUFS 8
 #define AVE_ENTROPY_SETS 4
 #define AVE_NEIGHBOUR_SETS 4
-- 
2.43.0

