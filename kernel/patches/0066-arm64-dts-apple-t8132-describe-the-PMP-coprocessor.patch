From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eryk Wieliczko <eryk@wieliczko.ninja>
Date: Wed, 4 Nov 2026 04:57:21 -0600
Subject: [PATCH] arm64: dts: apple: t8132: describe the PMP coprocessor

Describe the M4 power-management processor (PMP ASC, its mailbox and
DART) and the PMP report SRAM window. All nodes stay disabled; m1n1
supplies board/DRAM parameters and tunables before a board enables them.

Source-commit: 050f1a0059233cf33918f9844a98ed273feb8bad
Source-snapshot: 6090f9eb8237c86526508d76a4539852089942d5
Assisted-by: LLM
(cherry picked from commit c6b301adfd4fe1b8ff0805852fb72b22548a9f5c,
 subset: the pmp_dart, pmp_report, pmp and pmp_mbox nodes of
 t8132.dtsi, byte-identical to the source apart from one more tab of
 indentation: the source adds them in a trailing &soc block, here they
 sit inside soc after pmgr, as omacom does for nub_spmi_a0; the other
 platform controllers of that commit are covered by omacom #332, by the
 MTP port or not needed for the GPU path)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 45 ++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 8d33fba5f4..676ce98f6f 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -210,6 +210,51 @@
 			/* child nodes are added in t8132-pmgr.dtsi */
 		};
 
+		pmp_dart: iommu@380300000 {
+			status = "disabled";
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x3 0x80300000 0x0 0xc000>;
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 881 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_pmp>;
+		};
+
+		pmp_report: pmp-report@3803c0000 {
+			status = "disabled";
+			compatible = "apple,t8132-pmp-v2-report";
+			reg = <0x3 0x803c0000 0x0 0x20000>;
+			power-domains = <&ps_pms_sram>;
+		};
+
+		pmp: pmp@380500000 {
+			compatible = "apple,t8132-pmp-v2", "apple,t6000-pmp-v2";
+			reg = <0x3 0x80500000 0x0 0x80000>,
+			      <0x3 0x80e00000 0x0 0x4000>;
+			reg-names = "pmp", "asc";
+			mboxes = <&pmp_mbox>;
+			mbox-names = "mbox";
+			iommus = <&pmp_dart 0>;
+			power-domains = <&ps_pmp>;
+			/* m1n1 supplies board/DRAM parameters and tunables before enabling. */
+			status = "disabled";
+		};
+
+		pmp_mbox: mailbox@380e08000 {
+			status = "disabled";
+			compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
+			reg = <0x3 0x80e08000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 877 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 878 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 879 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 880 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "send-not-empty",
+					  "recv-empty", "recv-not-empty";
+			#mbox-cells = <0>;
+			power-domains = <&ps_pmp>, <&ps_pms_sram>;
+		};
+
 		aic: interrupt-controller@381000000 {
 			compatible = "apple,t8132-aic3", "apple,t8122-aic3";
 			#interrupt-cells = <3>;
