From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 22:21:52 +0000
Subject: [PATCH] drm/apple: power a T8132 external DCP down with
 nothing attached

With nothing attached, dispext0_cpu and dispext1_cpu stay on and the
dcpext firmware DARTs stay active for as long as the machine runs:
nothing ever powers an idle dcpext down.

Power it down once nothing has been attached for dcpext_idle_ms
(appledrm.dcpext_idle_ms, 5 s; 0 turns it off). The decision
(dcp-m4-ext-idle.h) runs under hpd_mutex with the driver's inputs:
DPTX ports, the Type-C route, the HDMI hot-plug level, the HDMI
start, a queued Type-C reconnect and unanswered teardown calls; the
session adds its own. It is looked at again whenever what is attached
changes (a display released, a route ended, an HDMI hot-plug edge, a
sink gone) and, while something only passes, after the delay.

Hot-plug keeps working: a display only appears through the AP, and
every way it does asks the firmware to connect first. A DPTX connect,
and any AFK command, powers the DCP up before it talks to it
(dcp_t8132_idle_wake()); a message that would still reach it
stopped is not sent and is logged. System sleep, remove and shutdown
stop the policy first; shutdown powers the DCP up for its unbind.
Resume powers it up as before, and the policy takes it down again.

The host selftests that build afk.c, dcp.c or dcp-fabric.c functions
stub the two hooks, as they stub the other T8132 ones.

(cherry picked from commit 99e7cbf5ef8e2fbc49f7cc5ee87e1a33502f14bb)

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/afk.c                   |   4 +
 drivers/gpu/drm/apple/dcp-fabric.c            |   6 +-
 drivers/gpu/drm/apple/dcp.c                   | 125 ++++++++++++++++--
 .../drivers/gpu/apple-dcp/lifecycle.py        |   3 +
 .../drivers/gpu/apple-dcp/transaction.py      |   3 +
 5 files changed, 128 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/apple/afk.c b/drivers/gpu/drm/apple/afk.c
index 0296cb9b41..4133b2bcee 100644
--- a/drivers/gpu/drm/apple/afk.c
+++ b/drivers/gpu/drm/apple/afk.c
@@ -2933,6 +2933,10 @@ static int afk_send_command_common(struct apple_epic_service *service, u8 type,
 	if (!service)
 		return -ENODEV;
 	ep = service->ep;
+	/* A T8132 dcpext powered down with nothing attached: up first. */
+	ret = dcp_t8132_idle_wake(ep->dcp);
+	if (ret)
+		goto err_put_service;
 	if (READ_ONCE(ep->compact)) {
 		u32 request_status = afk_compact_next_status(service);
 		size_t copied = 0;
diff --git a/drivers/gpu/drm/apple/dcp-fabric.c b/drivers/gpu/drm/apple/dcp-fabric.c
index 96191bc942..7a2ab3869e 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.c
+++ b/drivers/gpu/drm/apple/dcp-fabric.c
@@ -764,8 +764,10 @@ static int dcp_typec_route_deactivate(struct apple_dcp_typec_route *route)
 		dpavservep_detach(dcp);
 	route->selected = false;
 	ended_attachment = dcp_modes_end_typec(dcp, route);
-	if (dcp->active_typec_route == route)
+	if (dcp->active_typec_route == route) {
 		dcp->active_typec_route = NULL;
+		dcp_t8132_idle_kick(dcp);
+	}
 
 	if (connector && connector->dcp == to_platform_device(dcp->dev)) {
 		/*
@@ -5222,6 +5224,8 @@ void dcp_fabric_hdmi_sample(struct apple_dcp *dcp)
 {
 	guard(mutex)(&dcp_typec_fabric_lock);
 	dcp_hdmi_update_locked(dcp);
+	/* Attached or not may have changed. */
+	dcp_t8132_idle_kick(dcp);
 	/* The GPIO edge detector is off throughout an oneshot handler. */
 	if (dcp_hdmi_settle_enabled(dcp))
 		mod_delayed_work(system_freezable_wq, &dcp->hdmi_recheck_wq, 0);
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index d74990a7dc..54aa0ad2a4 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -339,6 +339,11 @@ bool dcp_h17p_external_ready(struct device_node *np)
 }
 
 static bool show_notch;
+static unsigned int dcpext_idle_ms = DCP_M4_EXT_IDLE_MS_DEFAULT;
+module_param(dcpext_idle_ms, uint, 0644);
+MODULE_PARM_DESC(dcpext_idle_ms,
+		 "T8132: power an external display processor down after this many ms with nothing attached (0: never; 1000-600000; read at the next attach or detach)");
+
 module_param(show_notch, bool, 0644);
 MODULE_PARM_DESC(show_notch, "Use the full display height and show the notch (also when /chosen/asahi,show-notch is \"1\")");
 
@@ -1775,6 +1780,12 @@ void dcp_send_message(struct apple_dcp *dcp, u8 endpoint, u64 message)
 
 	if (READ_ONCE(dcp->quiescing))
 		return;
+	/* Every request powers an idle T8132 dcpext up first: this is a bug. */
+	if (unlikely(iomfb_m4_ext_idle_down(dcp))) {
+		dev_warn_ratelimited(dcp->dev, "idle: message to ep %02x while powered down, not sent\n",
+				     endpoint);
+		return;
+	}
 	trace_dcp_send_msg(dcp, endpoint, message);
 	/*
 	 * The adopted T6030 14.7 session shares this mailbox with the panel
@@ -2081,6 +2092,12 @@ static int dcp_dptx_connect_raw(struct apple_dcp *dcp, u32 port, bool *retryable
 		dcp->connector_type, dcp->dptxport[port].connected);
 
 	mutex_lock(&dcp->hpd_mutex);
+	/* A T8132 dcpext down with nothing attached: up for the connection. */
+	if (t8132) {
+		ret = dcp_t8132_idle_wake(dcp);
+		if (ret)
+			goto out_unlock;
+	}
 	compact = dptx_service_available(&dcp->dptxport[port]) &&
 		  READ_ONCE(dcp->dptxport[port].service->ep->compact);
 	if (!dcp_connect_session_valid_locked(dcp, session, cable, recovery)) {
@@ -3471,6 +3488,7 @@ static int dcp_dptx_release_locked(struct apple_dcp *dcp, u32 port)
 		if (ret)
 			return ret;
 		dcp->dptxport[port].connected = false;
+		dcp_t8132_idle_kick(dcp);
 	}
 	/*
 	 * T6030: the firmware takes a direct crossbar output down when it
@@ -3739,15 +3757,6 @@ bool dcp_fw_compat_is_desktop(struct platform_device *pdev)
 }
 
 /* Firmware whose panel shows PQ content as EDR (dcp_panel_edr_supported()). */
-/*
- * The internal panel path (iomfb_m4.c) kicks a T8132 dcpext's idle release
- * after its own work. This driver does not power an idle dcpext down yet, so
- * the kick has nothing to wake.
- */
-void dcp_t8132_idle_kick(struct apple_dcp *dcp)
-{
-}
-
 bool dcp_fw_compat_panel_edr(struct platform_device *pdev)
 {
 	struct apple_dcp *dcp = platform_get_drvdata(pdev);
@@ -6599,6 +6608,86 @@ static void dcp_t8132_hdmi_stop(struct apple_dcp *dcp)
 	dcp_hdmi_disable(dcp);
 }
 
+/*
+ * A T8132 dcpext with nothing attached (dcp-m4-ext-idle.h) is powered down
+ * after dcpext_idle_ms. The decision runs under hpd_mutex, so no connection
+ * starts while it goes down; a connection, and any other request to its
+ * firmware, powers it up first (dcp_t8132_idle_wake(), afk.c, iomfb_m4.c).
+ * What is attached is looked at again on each of its changes
+ * (dcp_t8132_idle_kick()): a display released, a Type-C route ended, an
+ * HDMI hot-plug edge, a sink gone; what only passes, after the delay.
+ */
+static void dcp_t8132_idle_work(struct work_struct *work)
+{
+	struct apple_dcp *dcp = container_of(to_delayed_work(work), struct apple_dcp,
+					     t8132_idle_wq);
+	unsigned int ms = dcp_m4_ext_idle_delay_ms(READ_ONCE(dcpext_idle_ms));
+	struct dcp_m4_ext_idle_in in = { .enabled = ms != 0 };
+	enum dcp_m4_ext_idle_verdict verdict;
+
+	mutex_lock(&dcp->hpd_mutex);
+	in.stopping = !READ_ONCE(dcp->t8132_idle) || READ_ONCE(dcp->quiescing);
+	in.services = dptx_service_available(&dcp->dptxport[0]);
+	for (unsigned int i = 0; i < ARRAY_SIZE(dcp->dptxport); i++)
+		in.connected |= dcp->dptxport[i].connected;
+	in.route = !!READ_ONCE(dcp->active_typec_route);
+	in.hpd = dcp->hdmi_hpd && gpiod_get_value_cansleep(dcp->hdmi_hpd) > 0;
+	in.hdmi_starting = READ_ONCE(dcp->t8132_hdmi) && !dcp->t8132_hdmi_irq_on;
+	in.reconnect = delayed_work_pending(&dcp->typec_reconnect_wq);
+	in.orphans = READ_ONCE(dcp->t8132_release_late) ||
+		     (dcp->dptxep && afk_compact_orphans_pending(dcp->dptxep));
+	verdict = iomfb_m4_ext_idle_gate(dcp, &in);
+	mutex_unlock(&dcp->hpd_mutex);
+	if (verdict == DCP_M4_EXT_IDLE_RECHECK && ms)
+		mod_delayed_work(system_freezable_wq, &dcp->t8132_idle_wq,
+				 msecs_to_jiffies(ms));
+}
+
+/* What is attached changed: look again once it has stayed so for the delay. */
+void dcp_t8132_idle_kick(struct apple_dcp *dcp)
+{
+	unsigned int ms = dcp_m4_ext_idle_delay_ms(READ_ONCE(dcpext_idle_ms));
+
+	if (!dcp || !READ_ONCE(dcp->t8132_idle) || !ms)
+		return;
+	mod_delayed_work(system_freezable_wq, &dcp->t8132_idle_wq, msecs_to_jiffies(ms));
+}
+
+/*
+ * Before a request to a T8132 dcpext's firmware: up again if it was powered
+ * down with nothing attached, and down again later if nothing comes of it.
+ * May sleep; not under the DCP session's own lock.
+ */
+int dcp_t8132_idle_wake(struct apple_dcp *dcp)
+{
+	int ret;
+
+	if (!dcp || !dcp->v26_6 || !iomfb_m4_ext_idle_down(dcp))
+		return 0;
+	ret = iomfb_m4_ext_idle_wake(dcp);
+	dcp_t8132_idle_kick(dcp);
+	return ret;
+}
+
+/* With the HDMI output (probe, resume); dcp_t8132_idle_stop() undoes it. */
+static void dcp_t8132_idle_start(struct apple_dcp *dcp)
+{
+	if (!dcp_is_t8132_ext(dcp))
+		return;
+	enable_delayed_work(&dcp->t8132_idle_wq);
+	WRITE_ONCE(dcp->t8132_idle, true);
+	dcp_t8132_idle_kick(dcp);
+}
+
+/* For system sleep, remove and shutdown: no power-down starts after this. */
+static void dcp_t8132_idle_stop(struct apple_dcp *dcp)
+{
+	if (!READ_ONCE(dcp->t8132_idle))
+		return;
+	WRITE_ONCE(dcp->t8132_idle, false);
+	disable_delayed_work_sync(&dcp->t8132_idle_wq);
+}
+
 static void dcp_t8132_ext_routes(struct apple_dcp *dcp)
 {
 	struct device_node *routes __free(device_node) =
@@ -6805,6 +6894,9 @@ static int dcp_platform_probe_pipe(struct platform_device *pdev)
 	/* Enabled by dcp_t8132_hdmi_start(). */
 	INIT_DELAYED_WORK(&dcp->t8132_hdmi_wq, dcp_t8132_hdmi_work);
 	disable_delayed_work(&dcp->t8132_hdmi_wq);
+	/* Enabled by dcp_t8132_idle_start(). */
+	INIT_DELAYED_WORK(&dcp->t8132_idle_wq, dcp_t8132_idle_work);
+	disable_delayed_work(&dcp->t8132_idle_wq);
 	/* System sleep and shutdown cancel these even if no bind succeeded. */
 	INIT_WORK(&dcp->vblank_wq, dcp_delayed_vblank);
 	INIT_DELAYED_WORK(&dcp->swap_watchdog_wq, dcp_swap_watchdog);
@@ -6856,6 +6948,7 @@ static int dcp_platform_probe_pipe(struct platform_device *pdev)
 				dcp_t8132_hdmi_setup(dcp);
 				dcp_t8132_ext_routes(dcp);
 				dcp_t8132_hdmi_start(dcp);
+				dcp_t8132_idle_start(dcp);
 			}
 			return ret;
 		}
@@ -7343,6 +7436,7 @@ static void dcp_platform_remove(struct platform_device *pdev)
 	if (of_device_is_compatible(pdev->dev.of_node, "apple,t8132-dcpext")) {
 		/* Enabled with its Type-C routes, see dcp_t8132_ext_routes(). */
 		if (dcp) {
+			dcp_t8132_idle_stop(dcp);
 			dcp_t8132_hdmi_stop(dcp);
 			disable_delayed_work_sync(&dcp->typec_reconnect_wq);
 		}
@@ -7378,6 +7472,8 @@ VISIBLE_IF_KUNIT void dcp_platform_shutdown(struct platform_device *pdev)
 		return;
 
 	if (dcp && iomfb_is_m4(dcp)) {
+		dcp_t8132_idle_stop(dcp);
+		dcp_t8132_idle_wake(dcp);
 		dcp_comp_unbind(&pdev->dev, NULL, NULL);
 		return;
 	}
@@ -8900,12 +8996,15 @@ static int dcp_platform_suspend(struct device *dev)
 		int ret;
 
 		/* HDMI edges wait for resume, which acts on the level. */
+		dcp_t8132_idle_stop(dcp);
 		dcp_t8132_hdmi_stop(dcp);
 		ret = iomfb_m4_suspend(dcp);
-		if (!ret)
+		if (!ret) {
 			device_set_wakeup_path(dev);
-		else
+		} else {
 			dcp_t8132_hdmi_start(dcp);
+			dcp_t8132_idle_start(dcp);
+		}
 		return ret;
 	}
 	if (READ_ONCE(dcp->ext_dead))
@@ -9002,8 +9101,10 @@ static int dcp_platform_resume(struct device *dev)
 	if (iomfb_is_m4(dcp)) {
 		int ret = iomfb_m4_resume(dcp);
 
-		if (!ret && dcp_is_t8132_ext(dcp))
+		if (!ret && dcp_is_t8132_ext(dcp)) {
 			dcp_t8132_hdmi_start(dcp);
+			dcp_t8132_idle_start(dcp);
+		}
 		return ret;
 	}
 	if (READ_ONCE(dcp->ext_dead))
diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/lifecycle.py b/tools/testing/selftests/drivers/gpu/apple-dcp/lifecycle.py
index 86a95e0f41..1aec623d2d 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/lifecycle.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/lifecycle.py
@@ -178,6 +178,9 @@ static int dptxport_release_display(void *p)
 { (void)p; releases++; return release_error; }
 static void av_service_disconnect(struct apple_dcp *d) { (void)d; }
 static void dpavservep_detach(struct apple_dcp *d) { (void)d; detaches++; }
+/* The idle T8132 dcpext hooks (dcp.c): never down in these scenarios. */
+#define dcp_t8132_idle_kick(d) ((void)(d))
+#define dcp_t8132_idle_wake(d) ((void)(d), 0)
 static void dcp_firmware_metadata_hotplug(struct apple_dcp *d, bool c) { (void)d; (void)c; }
 static void dcp_firmware_metadata_connection(struct apple_dcp *d, u64 g, bool c)
 { (void)d; (void)g; (void)c; }
diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/transaction.py b/tools/testing/selftests/drivers/gpu/apple-dcp/transaction.py
index f70e13245e..ffd0ab0fc9 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/transaction.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/transaction.py
@@ -88,6 +88,9 @@ def controls(ROOT):
 static int mux_control_deselect(struct mux_control *m) { (void)m;event('C');xbar_calls++;return xbar_error; }
     static int mux_control_select(struct mux_control *m,unsigned n) { (void)m;(void)n;return 0; }
     static void dpavservep_detach(struct apple_dcp *d) { (void)d; }
+    /* The idle T8132 dcpext hooks (dcp.c): never down in these scenarios. */
+    #define dcp_t8132_idle_kick(d) ((void)(d))
+    #define dcp_t8132_idle_wake(d) ((void)(d), 0)
     /* Desktop 26.6 dual-pipe peers: no scenario here is on that firmware. */
     static void __attribute__((unused)) dcp_peer_release_26_6(struct apple_dcp *d) { (void)d;assert(!"desktop 26.6 peer release"); }
     /* failed takes of the hybrid, reset when a Type-C display leaves DP */
