From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 14:35:38 +0000
Subject: [PATCH] media: apple: isp: add a test floor on the auto
 exposure gain

The low-light colour cast of this camera grows as the scene gets darker,
which makes it hard to check a fix without a dark room. The firmware has
a floor for the auto exposure gain, AE_GAIN_CAP_MIN_SET (0x022e, next to
GAIN_CAP_SET in its command table); with a floor set, a lit scene is
taken at a dark room's sensor gain and the exposure is shortened to keep
the picture as bright.

Add ae_gain_min, in the 1/256 steps of GAIN_CAP_SET, sent at every
stream start when it is not 0. It is a test knob; the default of 0 sends
nothing.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit ab70da580b10fd9169944a46f3df02b023158761)
---
 drivers/media/platform/apple/isp/isp-cam.c | 26 ++++++++++++++++++++++
 drivers/media/platform/apple/isp/isp-cmd.h |  2 ++
 2 files changed, 28 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 55b4a9ad34..7615f845fb 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -1250,6 +1250,31 @@ module_param(macos_face_detect, bool, 0644);
 MODULE_PARM_DESC(macos_face_detect,
 		 "Turn on face and body detection as macOS does on this camera (default: off)");
 
+/*
+ * A floor on the auto exposure gain (1/256 steps, as AE_GAIN_CAP_SET), for
+ * tests: with it a lit scene is taken at the sensor gain of a dark room,
+ * and auto exposure shortens the exposure to keep the brightness. 0 (the
+ * default) sends nothing.
+ */
+static unsigned int ae_gain_min;
+module_param(ae_gain_min, uint, 0644);
+MODULE_PARM_DESC(ae_gain_min,
+		 "Lowest auto exposure gain in 1/256 steps, for tests (default: 0, firmware's own)");
+
+static void isp_ch_ae_gain_min(struct apple_isp *isp, u32 ch)
+{
+	unsigned int min = READ_ONCE(ae_gain_min);
+	int err;
+
+	if (!min)
+		return;
+	err = isp_cmd_ch_u32_set(isp, CISP_CMD_CH_AE_GAIN_CAP_MIN_SET, ch, min);
+	if (err)
+		dev_warn_once(isp->dev, "AE gain floor refused: %d\n", err);
+	else
+		dev_info_once(isp->dev, "AE gain floor %u/256 (test)\n", min);
+}
+
 static void isp_ch_macos_face_detect(struct apple_isp *isp, u32 ch)
 {
 	int err;
@@ -1738,6 +1763,7 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	}
 
 	isp_ch_macos_face_detect(isp, ch);
+	isp_ch_ae_gain_min(isp, ch);
 
 	if (READ_ONCE(macos_be_la) && isp->hw->macos_session_settings) {
 		err = isp_cmd_ch_be_lasetting_set(isp, ch, isp_macos_be_la);
diff --git a/drivers/media/platform/apple/isp/isp-cmd.h b/drivers/media/platform/apple/isp/isp-cmd.h
index 5752489bb0..4c4ebbd33a 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.h
+++ b/drivers/media/platform/apple/isp/isp-cmd.h
@@ -58,6 +58,8 @@
 #define CISP_CMD_CH_AE_GAIN_CAP_SET			     0x020c
 #define CISP_CMD_CH_AE_STABILITY_SET			     0x021a
 #define CISP_CMD_CH_AE_STABILITY_TO_STABLE_SET		     0x0229
+#define CISP_CMD_CH_AE_GAIN_CAP_MIN_GET			     0x022d
+#define CISP_CMD_CH_AE_GAIN_CAP_MIN_SET			     0x022e
 #define CISP_CMD_CH_AE_INTEGRATION_TABLE_SET		     0x0240
 #define CISP_CMD_CH_BE_LASETTING_SET			     0x0a15
 #define CISP_CMD_CH_AE_2WAYSPEED_SET			     0x0243
-- 
2.43.0

