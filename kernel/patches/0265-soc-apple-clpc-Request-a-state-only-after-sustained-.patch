From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jonathan Goyvaerts <jonathan.goyvaerts@gmail.com>
Date: Sat, 17 Oct 2026 22:09:50 -0300
Subject: [PATCH] soc: apple: clpc: Request a state only after sustained load

The driver samples each cluster every 4 ms and requests a state as soon
as one sample is busy. On the T6040 any CPU half busy for one sample
raises the floor for 36 ms, and short bursts of background work do that
often: the floor sat above its lowest state 56-69 % of the time on an
idle desktop, which cost about 0.75 W against the driver not loaded.

Add a per-SoC count of consecutive busy samples a cluster needs before
it requests a state. With three (12 ms) on the T6040 the idle floor time
falls to 10-13 % and idle power matches the driver not loaded. Letting
only the full-capacity clusters vote, as macOS does, brought the idle
floor time down only to 45 %, and added nothing on top of three samples.

A SoC that sets no count, like the T8140, keeps the previous behaviour.

Signed-off-by: Jonathan Goyvaerts <jonathan.goyvaerts@gmail.com>
Assisted-by: LLM
(cherry picked from commit f236c33daca696a326bd652799bd189ac2b6421f)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/clpc.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/apple/clpc.c b/drivers/soc/apple/clpc.c
index ac38b3980b..007b8a3301 100644
--- a/drivers/soc/apple/clpc.c
+++ b/drivers/soc/apple/clpc.c
@@ -54,6 +54,8 @@ enum apple_clpc_rail {
 /**
  * struct apple_clpc_hw - per-SoC CLPC parameters
  * @rail: PMC rail of the DCS and of the fabric
+ * @sustain: consecutive busy samples before a cluster requests a state;
+ *	0 or 1 for the first
  * @map: state of each rail for a busy cluster below 25, 50, 75 and 100
  *	percent of its maximum frequency
  * @gpu_demand: streaming GPU work requests @gpu
@@ -65,6 +67,7 @@ enum apple_clpc_rail {
  */
 struct apple_clpc_hw {
 	unsigned int rail[APPLE_CLPC_RAILS];
+	unsigned int sustain;
 	u8 map[APPLE_CLPC_RAILS][APPLE_CLPC_LEVELS];
 	bool gpu_demand;
 	u8 gpu[APPLE_CLPC_RAILS];
@@ -77,6 +80,7 @@ struct apple_clpc_cluster {
 	unsigned int policy_cpu;
 	cpumask_var_t cpus;
 	unsigned int busy;
+	unsigned int streak;
 	unsigned int level;
 	unsigned int request[APPLE_CLPC_RAILS];
 };
@@ -199,8 +203,13 @@ static void apple_clpc_sample_cluster(struct apple_clpc *clpc,
 
 	q = min_t(unsigned int, cl->level / (100 / APPLE_CLPC_LEVELS),
 		  APPLE_CLPC_LEVELS - 1);
+	if (busy < APPLE_CLPC_BUSY_PCT)
+		cl->streak = 0;
+	else if (cl->streak < clpc->hw->sustain)
+		cl->streak++;
 	for (rail = 0; rail < APPLE_CLPC_RAILS; rail++)
-		cl->request[rail] = busy >= APPLE_CLPC_BUSY_PCT ?
+		cl->request[rail] = busy >= APPLE_CLPC_BUSY_PCT &&
+				    cl->streak >= clpc->hw->sustain ?
 				   clpc->hw->map[rail][q] : 0;
 }
 
@@ -617,6 +626,10 @@ static const struct apple_clpc_hw apple_clpc_hw_t8140 = {
  * and fabric 2 the CPUs read 237-242 GB/s at 135 ns DRAM latency, against
  * 41 GB/s and 314 ns at 0 and 0. The second column is provisional until the
  * power of each DCS state is measured.
+ *
+ * A cluster requests only after three busy samples in a row (12 ms). At idle
+ * a single busy sample raised the floor about 60 % of the time, from short
+ * bursts of background work; three in a row bring that to about 11 %.
  */
 static const struct apple_clpc_hw apple_clpc_hw_t6040 = {
 	.rail = { [APPLE_CLPC_DCS] = 0, [APPLE_CLPC_SOC] = 1 },
@@ -624,6 +637,7 @@ static const struct apple_clpc_hw apple_clpc_hw_t6040 = {
 		[APPLE_CLPC_DCS] = { 1, 2, 5, 5 },
 		[APPLE_CLPC_SOC] = { 0, 1, 2, 2 },
 	},
+	.sustain = 3,
 };
 
 static const struct of_device_id apple_clpc_of_match[] = {
