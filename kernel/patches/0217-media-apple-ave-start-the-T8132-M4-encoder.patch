From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 04:14:50 +0000
Subject: [PATCH] media: apple: ave: start the T8132 (M4) encoder

The T8132 variant was probe only. On a J604 (MacBook Pro 14", M4) the
values it lacked are now measured:

  - the loader leaves the coprocessor code base at the T6041 (v40)
    offset: VCBAR reads the TEXT address 0x10000000000 with the valid
    bit, CTRL is 0 and the mailbox is clear, the reset state the v40
    start expects;
  - with device number 26, type 24 and the 9003.78.0 command layout the
    H16G firmware (TEXT CRC 9308d2ab) answers its hello, takes Config
    and encodes: ffmpeg h264_v4l2m2m and hevc_v4l2m2m turned 300 frames
    of 1080p30 into Main-profile streams at 9.6 and 8.0 Mb/s that decode
    back at 46.8 and 45.9 dB PSNR, and a second session after a runtime
    suspend (cold restart, DATA restored) gave 46.4 dB.

Give the variant those values, key the 9003.78.0 layout to the H16G
TEXT CRC as well, and list it among the known builds.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/ave/ave-drv.c    | 19 +++++++++++++------
 drivers/media/platform/apple/ave/ave-fw.c     |  1 +
 drivers/media/platform/apple/ave/ave-layout.c |  7 ++++---
 3 files changed, 18 insertions(+), 9 deletions(-)

diff --git a/drivers/media/platform/apple/ave/ave-drv.c b/drivers/media/platform/apple/ave/ave-drv.c
index 2e458ccbd8..d4f51c4189 100644
--- a/drivers/media/platform/apple/ave/ave-drv.c
+++ b/drivers/media/platform/apple/ave/ave-drv.c
@@ -105,17 +105,24 @@ static const struct ave_variant ave_t6041 = {
 /*
  * The M4 (T8132, J604 MacBook Pro) runs AppleAVE2FW_H16G 9003.78.0 from the
  * 25G83 boot stub: __TEXT 0x148000 and __DATA 0x12c000 bytes, as the J604 ADT
- * segment-ranges and the IPSW firmware image both give. Its boot device ID,
- * device type and coprocessor registers are not known, so the variant is
- * probe only: ave_fw_probe() records the CRCs of the preloaded segments and
- * ave_fw_check_boot() refuses to start the coprocessor (no regs, not
- * qualified). Nothing here touches the coprocessor.
+ * segment-ranges and the IPSW firmware image both give. On the J604 the
+ * loader leaves the code base at the T6041 (v40) offset, and the firmware
+ * starts and encodes with device number 26, type 24 and the T6041 command
+ * layout: H.264 and HEVC clips decode back at 46-49 dB PSNR, also after a
+ * cold restart.
  */
 static const struct ave_variant ave_t8132 = {
+	.regs = &ave_coproc_v40,
 	.fw_text_size = 0x148000,
 	.fw_data_size = 0x12c000,
+	.boot_device_id = 26,
+	.boot_arg_value = AVE_COPROC_BOOT_ARG_VALUE,
+	.timebase_multiplier = 1,
+	.vcbar_mask = U64_MAX,
+	.vcbar_flags = AVE_COPROC_VCBAR_VALID,
+	.device_type = 24,
 	.lfs_ref_scale = 2,
-	.boot_qualified = false,
+	.boot_qualified = true,
 };
 
 static const struct ave_variant ave_t8140 = {
diff --git a/drivers/media/platform/apple/ave/ave-fw.c b/drivers/media/platform/apple/ave/ave-fw.c
index 28c06d2870..05541bff7a 100644
--- a/drivers/media/platform/apple/ave/ave-fw.c
+++ b/drivers/media/platform/apple/ave/ave-fw.c
@@ -37,6 +37,7 @@ static const u32 ave_known_text_crc[] = {
 	0x2ce7359e, /* AppleAVE2FW 9003.78.0 */
 	0x69c54454, /* AppleAVE2FW 9003.78.0 (macOS 26.0.x) */
 	AVE_FW_TEXT_CRC_T6040_25G83, /* AppleAVE2FW 9003.78.0 / T6040 */
+	AVE_FW_TEXT_CRC_T8132_25G83, /* AppleAVE2FW 9003.78.0 / T8132 */
 	0x460c7a7c, /* AppleAVE2FW 6070.11.1 / T6000 */
 	0x25bfd039, /* AppleAVE2FW 6070.11.1 / T8112 */
 };
diff --git a/drivers/media/platform/apple/ave/ave-layout.c b/drivers/media/platform/apple/ave/ave-layout.c
index 30d4d07d3a..23f9dc71c2 100644
--- a/drivers/media/platform/apple/ave/ave-layout.c
+++ b/drivers/media/platform/apple/ave/ave-layout.c
@@ -530,10 +530,11 @@ const struct ave_fw_layout ave_layout_6070_11_1 = {
 const struct ave_fw_layout *ave_layout_for_crc(u32 crc)
 {
 	/*
-	 * The M4 Pro gets the same 25G83 firmware build as the A18 Pro, built
-	 * for its own chip, and speaks the same command layout.
+	 * The M4 Pro and the M4 get the same 25G83 firmware build as the A18
+	 * Pro, built for their own chips, and speak the same command layout.
 	 */
-	if (crc == AVE_FW_TEXT_CRC_9003_78_0 || crc == AVE_FW_TEXT_CRC_T6040_25G83)
+	if (crc == AVE_FW_TEXT_CRC_9003_78_0 || crc == AVE_FW_TEXT_CRC_T6040_25G83 ||
+	    crc == AVE_FW_TEXT_CRC_T8132_25G83)
 		return &ave_layout_9003_78_0;
 	if (crc == 0x460c7a7c || crc == 0x25bfd039)
 		return &ave_layout_6070_11_1;
