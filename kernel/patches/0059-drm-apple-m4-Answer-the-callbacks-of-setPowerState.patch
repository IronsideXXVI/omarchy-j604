From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Sun, 25 Oct 2026 20:20:13 -0400
Subject: [PATCH] drm/apple: m4: Answer the callbacks of setPowerState

Powering the J713 display down and up with setPowerState (A473), the
26.6.2 firmware calls back into the AP: acknowledgeSetPowerState
(D106), will_power_off_signal (D002), get_calendar_time_ms (D209),
powerUpDART (D572), swap_complete_intent (D592), set_kernel_power_assert
(D700), aot_supported_peek (D203), set_power_trace_enable (D008),
set_idle_caching_state_ap (D117) and enable_backlight_message_ap_gated
(D594). The exact-shape table refused them, which quarantines the
session.

Add their shapes and answer them for this machine: the notifications
and setters with an ACK, the status-returning calls with success, AOT
support with false, and the calendar time in milliseconds. The DART
and the power assertion are the AP's to hold: the J713 keeps the
display domains on across suspend-to-idle.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit c1967d32dc57c93cb99fc0dc7ce9de7ccac4bcbe)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/dcp-m4-callback.h | 27 ++++++++++++++++++++-----
 1 file changed, 22 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-m4-callback.h b/drivers/gpu/drm/apple/dcp-m4-callback.h
index 08249a9f25..738f803835 100644
--- a/drivers/gpu/drm/apple/dcp-m4-callback.h
+++ b/drivers/gpu/drm/apple/dcp-m4-callback.h
@@ -5,6 +5,7 @@
 #include <linux/errno.h>
 #include <linux/kernel.h>
 #include <linux/string.h>
+#include <linux/timekeeping.h>
 #include <linux/types.h>
 #include <linux/unaligned.h>
 #include "dcp-m4-profile.h"
@@ -33,16 +34,17 @@ static inline int dcp_m4_callback_result(int ret)
 
 /* Exact qualified J713 shapes. An absent behavior hook is failure, never an ACK. */
 static const struct dcp_m4_callback_shape dcp_m4_callbacks[] = {
-	{0, 0, 4}, {1, 0, 4}, {3, 4, 60}, {6, 84, 80},
-	{100, 0, 0}, {101, 0, 4}, {102, 68, 0}, {104, 68, 0}, {107, 64, 0},
+	{0, 0, 4}, {1, 0, 4}, {2, 0, 0}, {3, 4, 60}, {6, 84, 80}, {8, 4, 0},
+	{100, 0, 0}, {101, 0, 4}, {102, 68, 0}, {104, 68, 0}, {106, 0, 4}, {107, 64, 0},
 	{108, 0, 4}, {109, 0, 4}, {110, 0, 4}, {111, 0, 4}, {112, 0, 4}, {113, 0, 4},
-	{114, 4164, 4100}, {121, 0, 4}, {122, 0, 4}, {123, 0, 4},
+	{114, 4164, 4100}, {117, 12, 0}, {121, 0, 4}, {122, 0, 4}, {123, 0, 4},
 	{125, 100, 36}, {127, 4, 4}, {128, 4104, 4}, {129, 64, 4},
-	{201, 12, 16}, {206, 0, 4}, {207, 0, 4}, {300, 16, 0},
+	{201, 12, 16}, {203, 0, 4}, {206, 0, 4}, {207, 0, 4}, {209, 0, 8}, {300, 16, 0},
 	{400, 76, 3076}, {401, 80, 12}, {406, 72, 0}, {408, 8, 8},
 	{413, 4168, 4}, {414, 80, 4}, {415, 76, 4}, {451, 20, 28}, {454, 4, 4},
 	{552, 4164, 4}, {561, 4164, 4}, {563, 76, 4}, {565, 72, 4}, {567, 128, 4},
-	{575, 88, 76}, {576, 4, 0}, {582, 8, 4}, {588, 0, 0}, {590, 1840, 0}, {599, 0, 0},
+	{572, 4, 4}, {575, 88, 76}, {576, 4, 0}, {582, 8, 4}, {588, 0, 0}, {590, 1840, 0},
+	{592, 20, 0}, {594, 4, 0}, {599, 0, 0}, {700, 4, 4},
 };
 
 static inline int dcp_m4_callback_method(u32 tag)
@@ -136,6 +138,21 @@ static inline int dcp_m4_callback_dispatch(const struct dcp_m4_callback_ops *ops
 		return 0;
 	case 300: case 406: case 576: case 588:
 		return 0;
+	/*
+	 * will_power_off_signal, set_power_trace_enable, set_idle_caching_state_ap,
+	 * swap_complete_intent, enable_backlight_message_ap_gated: notifications.
+	 */
+	case 2: case 8: case 117: case 592: case 594:
+		return 0;
+	/*
+	 * acknowledgeSetPowerState, powerUpDART, set_kernel_power_assert: success;
+	 * aot_supported_peek: false.
+	 */
+	case 106: case 572: case 700: case 203:
+		return 0;
+	case 209: /* get_calendar_time_ms */
+		put_unaligned_le64(ktime_get_real_ns() / NSEC_PER_MSEC, out);
+		return 0;
 	case 122: case 123: case 582:
 		return 0; /* False, not an unimplemented service returning success. */
 	case 101:
