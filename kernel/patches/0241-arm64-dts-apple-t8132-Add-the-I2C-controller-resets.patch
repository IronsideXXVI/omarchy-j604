From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Sun, 1 Nov 2026 20:06:06 -0500
Subject: [PATCH] arm64: dts: apple: t8132: Add the I2C controller resets

Each I2C controller is reset through its own PMGR power state. The
driver resets a controller that stays stuck in a transaction.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit c5e08978be50620fbb025680ffced4ecfc6feb82)
Assisted-by: Claude:claude-opus-5.5
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 3f447dee6a..c054528614 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -694,6 +694,7 @@
 			#address-cells = <0x1>;
 			#size-cells = <0x0>;
 			power-domains = <&ps_i2c0>;
+			resets = <&ps_i2c0>;
 
 			status = "disabled";
 		};
@@ -709,6 +710,7 @@
 			#address-cells = <0x1>;
 			#size-cells = <0x0>;
 			power-domains = <&ps_i2c1>;
+			resets = <&ps_i2c1>;
 
 			status = "disabled";
 		};
@@ -724,6 +726,7 @@
 			#address-cells = <0x1>;
 			#size-cells = <0x0>;
 			power-domains = <&ps_i2c2>;
+			resets = <&ps_i2c2>;
 
 			status = "disabled";
 		};
@@ -739,6 +742,7 @@
 			#address-cells = <0x1>;
 			#size-cells = <0x0>;
 			power-domains = <&ps_i2c3>;
+			resets = <&ps_i2c3>;
 
 			status = "disabled";
 		};
@@ -754,6 +758,7 @@
 			#address-cells = <0x1>;
 			#size-cells = <0x0>;
 			power-domains = <&ps_i2c4>;
+			resets = <&ps_i2c4>;
 
 			status = "disabled";
 		};
