From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 04:56:59 +0000
Subject: [PATCH] drm/asahi: G16: lower the Globals max power to
 macOS's post-INIT value after READY

macOS 26B123 has 36294 in the G17 region C max_power_mw word at INIT, which the initdata now
writes, and 26250 in every later Globals snapshot (video, idle, bench start). Write 26250 at
our +0x84 once the firmware is READY, before the boot re-import, behind g16_power_late
(default 1, read at boot); 0 leaves the INIT value.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/boot.rs        | 13 +++++++++++++
 drivers/gpu/drm/asahi/g16/fw/initdata.rs |  5 +++++
 drivers/gpu/drm/asahi/g16/params.rs      | 18 ++++++++++++++++++
 3 files changed, 36 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16/boot.rs b/drivers/gpu/drm/asahi/g16/boot.rs
index 81302597d5..01e5cf4aa2 100644
--- a/drivers/gpu/drm/asahi/g16/boot.rs
+++ b/drivers/gpu/drm/asahi/g16/boot.rs
@@ -776,6 +776,19 @@ fn run(
                 dev_info!(dev, "M4 power: Globals runtime words written as macOS\n");
             }
         }
+        // macOS lowers max_power_mw from its INIT value after INIT and leaves it (list 14).
+        if super::params::power_late() {
+            if let Some(g) = init.globals.as_ref() {
+                let (at, value) = super::fw::initdata::globals::POWER_LATE;
+                g.w32(at, value)?;
+                regs::wmb();
+                dev_info!(
+                    dev,
+                    "M4 power: Globals max power {} mW after INIT, as macOS\n",
+                    value
+                );
+            }
+        }
         // The boot import ran before START and the policy record; import once more so a
         // firmware copy of Globals carries the tally that matches every record it drained.
         if super::params::reimport() {
diff --git a/drivers/gpu/drm/asahi/g16/fw/initdata.rs b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
index 8a00b56ad4..17290b76b8 100644
--- a/drivers/gpu/drm/asahi/g16/fw/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
@@ -90,6 +90,11 @@ pub(crate) mod globals {
     /// 200000; MEASURED list 13: 0 at INIT, these values in every later snapshot), our
     /// +0x98c/+0x990 with its 4-byte shift; the qualified image leaves both zero.
     pub(crate) const RUNTIME_WORDS: [(usize, u32); 2] = [(0x98c, 2), (0x990, 200000)];
+    /// G17 region C max_power_mw after INIT: macOS 26B123 has 36294 there at INIT (written by
+    /// [`REQUIRED`]) and 26250 in every later snapshot (MEASURED, list 14: video, idle, bench
+    /// start), at its +0x88 = our +0x84.
+    pub(crate) const POWER_LATE: (usize, u32) = (0x84, 26250);
+    const _: () = assert!(POWER_LATE.0 == REQUIRED[8].0);
     const _: () =
         assert!(RUNTIME_WORDS[0].0 > PSTATE_SELECTORS[2] && RUNTIME_WORDS[1].0 + 4 <= 0x998);
     /// The word the G17 backend documents as region C `idle_power_off` ("non-zero lets the
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 6349f11c1a..bc2896672f 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -1057,6 +1057,24 @@ pub(crate) fn selectors_macos() -> bool {
     "G16: performance selectors (default 0: the host utilization governor's state x 100; 1: 1000 as macOS whenever the cooling ceiling allows the top state, else that ceiling; runtime 0644)"
 );
 
+/// Storage of `g16_power_late` (0644, default 1; read at boot after READY).
+static POWER_LATE: AtomicU32 = AtomicU32::new(1);
+
+/// Whether the boot writes macOS's post-INIT max_power_mw (26250 at Globals +0x84) once the
+/// firmware is READY, before the boot re-import.
+pub(crate) fn power_late() -> bool {
+    POWER_LATE.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    POWER_LATE_PARAM,
+    POWER_LATE_PARMTYPE,
+    POWER_LATE_PARM,
+    POWER_LATE,
+    "g16_power_late",
+    "G16: after READY, write Globals +0x84 (max_power_mw) = 26250 as macOS has it after INIT (default 1; 0: the INIT value stays; read at boot)"
+);
+
 /// Storage of `g16_render_row0` (0644, default 1; read when the queue graphs are built).
 static RENDER_ROW0: AtomicU32 = AtomicU32::new(1);
 
-- 
2.43.0

