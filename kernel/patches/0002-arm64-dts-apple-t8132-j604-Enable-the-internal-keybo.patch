From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 3 Nov 2026 23:39:56 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j604: Enable the internal
 keyboard and trackpad

Enable the MTP helper, its mailbox and DART, and the DockChannel HID
transport of the MacBook Pro (14-inch, M4, 2024), so Linux can adopt the
input session the loader keeps running ("mtp-live-v1").

The nodes and addresses are those of the J713 (t8132.dtsi); the J604
template device tree (25G83 and 26B123 DeviceTree.j604ap) has the same
ASC, DART and DockChannel registers and interrupts (DTV-MTP-3..9). The
trackpad AFE and STM resets are SMC gP1c/gP1d (DTV-MTP-1/2). The J604
trackpad personality differs from the J713 (C1FD0,5 vs C1FD1,3,
DTV-MTP-10), so it loads its own multi-touch firmware.

As on the J713, the nodes are enabled here and the loader either adds
the live handoff to &mtp or disables it. A loader that does neither
leaves the helper to cold-start the coprocessor.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 42 ++++++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 9d01836e85..56f29632bb 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -366,3 +366,45 @@
 &ps_atc3_usb {
 	status = "okay";
 };
+
+/*
+ * Internal keyboard and trackpad (MTP over DockChannel). Linux adopts the
+ * session the loader keeps running: the loader adds apple,rtkit-handoff =
+ * "mtp-live-v1" and apple,rtkit-buffers to &mtp, or disables &mtp when it
+ * cannot keep the session, as for the J713.
+ */
+
+&mtp {
+	status = "okay"; /* DTV-MTP-3..5 */
+};
+
+&mtp_mbox {
+	status = "okay"; /* DTV-MTP-5 */
+};
+
+&mtp_dart {
+	status = "okay"; /* DTV-MTP-6, DTV-MTP-7 */
+};
+
+&mtp_dockchannel {
+	status = "okay"; /* DTV-MTP-8, DTV-MTP-9 */
+};
+
+&mtp_hid {
+	apple,afe-reset-gpios = <&smc_gpio 28 GPIO_ACTIVE_LOW>; /* DTV-MTP-1 */
+	apple,stm-reset-gpios = <&smc_gpio 29 GPIO_ACTIVE_LOW>; /* DTV-MTP-2 */
+
+	multi-touch {
+		/* J604 personality C1FD0,5 (DTV-MTP-10), not the J713 firmware */
+		firmware-name = "apple/tpmtfw-j604.bin";
+		apple,power-method = <2>;
+	};
+
+	keyboard: keyboard {
+		hid-country-code = <0>;
+		apple,keyboard-layout-id = <0>;
+	};
+
+	stm {
+	};
+};
