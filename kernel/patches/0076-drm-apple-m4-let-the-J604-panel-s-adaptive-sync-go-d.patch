From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 15:57:35 +0000
Subject: [PATCH] drm/apple: m4: let the J604 panel's adaptive sync go
 down to 24 Hz

The J604 profile offered adaptive sync from 48 Hz, the lowest fixed rate
in Apple's specifications for the MacBook Pro (14-inch, M4). macOS runs
the panel lower: on the J604 under macOS 27.2, the panel's
IOMobileFramebuffer reports IOMFBDisplayRefresh with a maximum refresh
interval of 1000000 and a minimum of 200000 ticks of the 24 MHz timebase
(41.67 and 8.33 ms, so 24 to 120 Hz), in 100000-tick (4.17 ms) steps;
the same intervals in 2^-32 s units (178928337 and 35785667) agree.

Offer 24 Hz: the EDID range and the default panel_vrr_min_hz become
24-120, so a 24 fps fullscreen video can run at its own rate instead of
48 Hz with each frame shown twice. appledrm.panel_vrr_min_hz=48 at boot
keeps the old range.

Whether firmware 26.6.2 (the Linux stub) takes a 24 Hz minimum through
A442 IOMFBParameter 14 the way macOS's firmware runs it is checked in the
1.613 dev-loop window first: the parameter is writable at run time, and
the kit writes 24 before this default is integrated.

KUnit: apple-dcp-m4-frame checks the J604 profile (24 Hz, J713/J715 off);
apple-dcp-panel-edid reads a 24-120 Hz range back from the connector.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
(cherry picked from commit 6fed9a84fb811075f9bd81dfdfa08afe673f99e4)
---
 drivers/gpu/drm/apple/dcp-m4-frame-test.c   | 16 ++++++++++++++++
 drivers/gpu/drm/apple/dcp-m4-profile.h      | 10 ++++++----
 drivers/gpu/drm/apple/dcp-panel-edid-test.c |  9 +++++++++
 drivers/gpu/drm/apple/iomfb_m4.c            |  2 +-
 4 files changed, 32 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-m4-frame-test.c b/drivers/gpu/drm/apple/dcp-m4-frame-test.c
index 1c05c742d9..728cc4c792 100644
--- a/drivers/gpu/drm/apple/dcp-m4-frame-test.c
+++ b/drivers/gpu/drm/apple/dcp-m4-frame-test.c
@@ -125,10 +125,26 @@ static void frame_surface_encoding(struct kunit *test)
 	}
 }
 
+/* The J604 panel's display defaults, each from the J604 itself (see the profile). */
+static void frame_j604_profile(struct kunit *test)
+{
+	const struct dcp_m4_profile *pf = &dcp_m4_profile_j604;
+
+	/* macOS: 24-120 Hz refresh intervals. */
+	KUNIT_EXPECT_EQ(test, pf->vrr_min_hz, 24);
+	/* macOS: colour element Depth 8. */
+	KUNIT_EXPECT_EQ(test, pf->panel_bpc, 8);
+	KUNIT_EXPECT_TRUE(test, pf->edr);
+	/* Fixed-rate panels on the same backend keep VRR off. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_profile_j713.vrr_min_hz, 0);
+	KUNIT_EXPECT_EQ(test, dcp_m4_profile_j715.vrr_min_hz, 0);
+}
+
 static struct kunit_case m4_frame_cases[] = {
 	KUNIT_CASE(frame_drm_formats),
 	KUNIT_CASE(frame_format_helpers),
 	KUNIT_CASE(frame_surface_encoding),
+	KUNIT_CASE(frame_j604_profile),
 	{}
 };
 
diff --git a/drivers/gpu/drm/apple/dcp-m4-profile.h b/drivers/gpu/drm/apple/dcp-m4-profile.h
index 15f90b31cc..94818bc0f2 100644
--- a/drivers/gpu/drm/apple/dcp-m4-profile.h
+++ b/drivers/gpu/drm/apple/dcp-m4-profile.h
@@ -136,11 +136,13 @@ static const struct dcp_m4_profile dcp_m4_profile_j604 = {
 	/* MacBook Pro (14-inch, M4, 2024): the panel EDID's model year. */
 	.model_year = 2024,
 	/*
-	 * ProMotion "adaptive refresh rates up to 120Hz"; 48 Hz is the lowest
-	 * fixed rate Apple lists for this panel (47.95 and 48 Hz, MacBook Pro
-	 * technical specifications). J713 and J715 keep VRR off.
+	 * ProMotion "adaptive refresh rates up to 120Hz". macOS 27.2 drives this
+	 * panel between 24 and 120 Hz: its IOMobileFramebuffer IOMFBDisplayRefresh
+	 * gives a 1000000-tick (41.67 ms) maximum and a 200000-tick (8.33 ms)
+	 * minimum refresh interval at 24 MHz, in 4.17 ms steps. J713 and J715
+	 * keep VRR off.
 	 */
-	.vrr_min_hz = 48,
+	.vrr_min_hz = 24,
 	/*
 	 * The panel's input is 8 bits a component: macOS's IOMobileFramebuffer
 	 * ColorElements for it say Depth 8, RGB, SDR (the J604 under macOS 27.2).
diff --git a/drivers/gpu/drm/apple/dcp-panel-edid-test.c b/drivers/gpu/drm/apple/dcp-panel-edid-test.c
index afe1a28ed1..598ee4d244 100644
--- a/drivers/gpu/drm/apple/dcp-panel-edid-test.c
+++ b/drivers/gpu/drm/apple/dcp-panel-edid-test.c
@@ -406,6 +406,15 @@ static void panel_edid_update_publishes_vrr_range(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, connector->display_info.monitor_range.min_vfreq, 48);
 	KUNIT_EXPECT_EQ(test, connector->display_info.monitor_range.max_vfreq, 120);
 	KUNIT_EXPECT_TRUE(test, list_empty(&connector->probed_modes));
+
+	/* The J604's 24-120 Hz. */
+	id.vrr_min_hz = 24;
+	mutex_lock(&t->drm.mode_config.mutex);
+	ret = dcp_panel_edid_update(connector, &id, J516_W_MM, J516_H_MM);
+	mutex_unlock(&t->drm.mode_config.mutex);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, connector->display_info.monitor_range.min_vfreq, 24);
+	KUNIT_EXPECT_EQ(test, connector->display_info.monitor_range.max_vfreq, 120);
 }
 
 /* The DisplayID display parameters: binary16 luminances and the native depth. */
diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index 369211541b..fa6e42964c 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -211,7 +211,7 @@ static const struct kernel_param_ops panel_vrr_min_hz_ops = {
 
 module_param_cb(panel_vrr_min_hz, &panel_vrr_min_hz_ops, &panel_vrr_min_hz, 0644);
 MODULE_PARM_DESC(panel_vrr_min_hz,
-		 "J604: adaptive sync on the internal panel; VRR_ENABLED sets the DCP adaptive-sync minimum to this rate (A442 IOMFBParameter 14, as desktop 26.6 ProMotion panels; default: the machine's, J604 48, J713/J715 0 = off; at most 119). Set at boot it offers VRR (vrr_capable, the EDID range); a later write moves the minimum from the next commit, and 0 holds the panel at 120 Hz");
+		 "J604: adaptive sync on the internal panel; VRR_ENABLED sets the DCP adaptive-sync minimum to this rate (A442 IOMFBParameter 14, as desktop 26.6 ProMotion panels; default: the machine's, J604 24, J713/J715 0 = off; at most 119). Set at boot it offers VRR (vrr_capable, the EDID range); a later write moves the minimum from the next commit, and 0 holds the panel at 120 Hz");
 
 static unsigned int panel_boost_nits;
 
-- 
2.43.0

