From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 18 Nov 2026 21:24:11 +0000
Subject: [PATCH] drm/asahi: g16: Keep compute sequences in ASC-cached
 slots by default

Each compute command's microsequence is written at its publication and
read by the firmware's interpreter when the command starts and when it
posts. Embedded in the unit's per-VM work page it is mapped uncached,
while macOS maps it ASC-cached.

Make g16_compute_seq_pool default to 1 and g16_compute_seq_cached
default to 1. Every compute command then writes its microsequence into
slot (compute ordinal mod 64) of the ASC-cached session object, two
objects of 64 slots of 768 bytes for the whole device. At most 32
compute commands are in flight and they retire in order, so a slot is
rewritten only after its command retired, and the firmware cleans and
invalidates the sequence before it reads it and again at its post.

On the J604 the cached copy took compute.light at depth 64 from 30.3 us
to 27.4 to 27.6 us, with depth 8 within 2 %, compute.heavy unchanged at
555 to 557 us and both stress tests passing.

g16_compute_seq_cached=0 at run time returns to the uncached copy, and
aurora.g16_compute_seq_pool=0 on the command line to the sequence in
each unit's work page.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/asahi_core.rs | 4 ++--
 drivers/gpu/drm/asahi/g16/params.rs | 8 ++++----
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_core.rs b/drivers/gpu/drm/asahi/asahi_core.rs
index 562e2af23b..d305ca8a1a 100644
--- a/drivers/gpu/drm/asahi/asahi_core.rs
+++ b/drivers/gpu/drm/asahi/asahi_core.rs
@@ -300,8 +300,8 @@ fn init(module: &'static kernel::ThisModule) -> impl PinInit<Self, Error> {
             description: "G16: 1 (default) = render TA and FS work records in session slots per unit, uncached and ASC-cached copies; 0 = each unit's own work objects",
         },
         g16_compute_seq_pool: u32 {
-            default: 0,
-            description: "G16: 1 = compute microsequences in device-wide session slots, uncached and ASC-cached copies",
+            default: 1,
+            description: "G16: 1 (default) = compute sequences in session slots; 0 = work pages",
         },
         g16_host_records: u32 {
             default: 0,
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 32553b3e10..bee101687b 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -761,7 +761,7 @@ pub(crate) fn render_seq_cached() -> bool {
     "G16: with g16_render_seq_pool=1, publish renders with the ASC-cached copy of their unit's microsequence slot (default 1; 0: the uncached copy; runtime 0644)"
 );
 
-/// `g16_compute_seq_pool` (load time, default 0). 1: at boot two session objects, one uncached
+/// `g16_compute_seq_pool` (load time, default 1). 1: at boot two session objects, one uncached
 /// and one ASC-cached, each hold `graph::COMPUTE_SEQ_SLOTS` compute microsequence slots, and
 /// every compute command writes its live microsequence into slot (compute ordinal mod
 /// COMPUTE_SEQ_SLOTS) instead of its unit's per-VM work page. Compute units are per VM, so the
@@ -772,8 +772,8 @@ pub(crate) fn compute_seq_pool() -> bool {
     module_parameters::g16_compute_seq_pool.value() == 1
 }
 
-/// Storage of `g16_compute_seq_cached` (runtime 0644, default 0).
-static COMPUTE_SEQ_CACHED: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_compute_seq_cached` (runtime 0644, default 1).
+static COMPUTE_SEQ_CACHED: AtomicU32 = AtomicU32::new(1);
 
 /// With `g16_compute_seq_pool`, whether compute commands published from now on name the
 /// ASC-cached copy of their slot (attribute index 0, the class macOS gives the compute
@@ -790,7 +790,7 @@ pub(crate) fn compute_seq_cached() -> bool {
     COMPUTE_SEQ_CACHED_PARM,
     COMPUTE_SEQ_CACHED,
     "g16_compute_seq_cached",
-    "G16: with g16_compute_seq_pool=1, publish compute commands with the ASC-cached copy of their microsequence slot (default 0: the uncached copy; runtime 0644)"
+    "G16: with g16_compute_seq_pool=1, publish compute commands with the ASC-cached copy of their microsequence slot (default 1; 0: the uncached copy; runtime 0644)"
 );
 
 /// `g16_ktrace_mask` (load time): the word written to CONTROL+0 at init. 25G83 copies it into
-- 
2.43.0

