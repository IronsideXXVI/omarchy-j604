From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 11:18:13 +0000
Subject: [PATCH] drm/asahi: default to the 25G83 relative-power table
 encoding

Enable only init_macos bit 0x200000 after the isolated k1014 experiment passed the full same-session suite, REPRO, zero-fault and return checks. Controller and AON bits remain off; init_macos=0 restores the previous encoding.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/asahi_core.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_core.rs b/drivers/gpu/drm/asahi/asahi_core.rs
index 9e0abf6c98..8057d6fb00 100644
--- a/drivers/gpu/drm/asahi/asahi_core.rs
+++ b/drivers/gpu/drm/asahi/asahi_core.rs
@@ -312,8 +312,8 @@ fn init(module: &'static kernel::ThisModule) -> impl PinInit<Self, Error> {
             description: "G16: firmware power controllers (default 0; 1: with thermal, 2: without)",
         },
         g16_init_macos: u32 {
-            default: 0,
-            description: "G16: macOS INIT words beyond the Main table, bit mask (default 0: none)",
+            default: 0x200000,
+            description: "G16: INIT mask (default 0x200000: integer relative-power tables)",
         },
         g16_init_cached: u32 {
             default: 7,
-- 
2.43.0

