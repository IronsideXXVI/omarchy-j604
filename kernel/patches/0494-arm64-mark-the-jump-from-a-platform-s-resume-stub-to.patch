From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 12:33:44 +0000
Subject: [PATCH] arm64: mark the jump from a platform's resume stub to
 init_el2

Four T8132 deep sleeps stopped at the stub's 60 s window; on 1.882,
with init_el2's first mark (39 s) in place, a stop at 60 means that
mark never ran. Between them sit the stub's checks, its jump, and the
first instructions of cpu_resume and init_kernel_el.

Restart the platform's resume watchdog for 105 s in the stub once its
checks pass, right before the jump, and for 125 s at cpu_resume's
first instruction, so a stop reads as stub (60), jump (105) or
cpu_resume to init_el2 (125).

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/kernel/sleep.S |  1 +
 drivers/soc/apple/sleep.c | 10 +++++++++-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/kernel/sleep.S b/arch/arm64/kernel/sleep.S
index 45cc011fc9..832835ec3b 100644
--- a/arch/arm64/kernel/sleep.S
+++ b/arch/arm64/kernel/sleep.S
@@ -124,6 +124,7 @@ SYM_FUNC_END(__cpu_suspend_enter)
 
 	.pushsection ".idmap.text", "a"
 SYM_CODE_START(cpu_resume)
+	resume_mark 125, 0		// first instruction after the platform's jump
 	mov	x0, xzr
 #ifdef CONFIG_ARM64_CTXR_EXECMEM
 	mov	x22, #1				// a resuming CPU may be confined
diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index 1e1d1aabf0..5825ddaa94 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -3298,6 +3298,14 @@ asm(
 "	bl	t8132_elchk_region\n"
 "	tbz	w17, #31, 28f\n"
 "29:	bl	t8132_elchk2_run\n"
+/* Both checks passed or none armed: WD2 for 105 s (0x96342600 ticks), then the jump. */
+"	str	wzr, [x9, #0x2c]\n"
+"	str	wzr, [x9, #0x20]\n"
+"	movz	w10, #0x2600\n"
+"	movk	w10, #0x9634, lsl #16\n"
+"	str	w10, [x9, #0x28]\n"
+"	mov	w10, #1\n"
+"	str	w10, [x9, #0x2c]\n"
 "	b	cpu_resume\n"
 /* A mismatch: WD2 for 46 s (0x41cdb400 ticks), the record, then stay. */
 "28:	str	wzr, [x9, #0x2c]\n"
@@ -5088,7 +5096,7 @@ static void t8132_catch_init(struct platform_device *pdev, struct apple_sleep *s
 			 (unsigned long)t8132_catch_io + sizeof(t8132_catch_io));
 	arm64_resume_vbar = __pa_symbol(t8132_resume_vectors);
 	arm64_resume_vbar_va = (unsigned long)t8132_resume_vectors;
-	/* Marks inside the resume assembly: 57 54 65 48 85 95 45 42 s, see WDT_SUSPEND_SECS. */
+	/* Marks inside the resume assembly: 125 57 54 65 48 85 95 45 42 s, see WDT_SUSPEND_SECS. */
 	arm64_resume_wdt[0] = wdt->start;
 	arm64_resume_wdt[1] = (unsigned long)s->wdt;
 	arm64_resume_wdt[2] = WDT_TICKS_PER_S;
-- 
