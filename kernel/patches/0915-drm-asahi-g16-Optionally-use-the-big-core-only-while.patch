From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 22:03:23 +0000
Subject: [PATCH] drm/asahi: g16: Optionally use the big core only
 while GPU work is out

g16_worker_big=2 moved compute.light at depth 64 from 50.8-57.2 to
39.3 us per submit, but at an idle desktop it also moved the passes
that firmware ring-service messages and the power decay window queue
(about 3.5 per second) onto a performance core: +46 mW system.

Add g16_worker_big=3: as 2 while flights or pending work exist, as
publish() last saw them under the device lock, and as 0 otherwise, so
an idle pass stays on the CPU that queued it. The wbig: line counts
the queueings that took the default path (idle_default).

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/engine.rs |  2 ++
 drivers/gpu/drm/asahi/g16/params.rs |  8 +++++---
 drivers/gpu/drm/asahi/g16/poll.rs   | 25 ++++++++++++++++++++++---
 3 files changed, 29 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index cfbe7a80d1..31bf6bf14e 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -1562,6 +1562,8 @@ pub(crate) fn publish(&mut self, done: &mut Completions) -> Result {
         // Polling retires before it publishes, so this sees work start and
         // drain; a fail-stop reports from fail_flights().
         self.power.report_work(!self.engine.flights.is_empty());
+        // g16_worker_big 3: big-CPU passes only while work is outstanding.
+        super::poll::wbig_busy(!self.engine.flights.is_empty() || !self.engine.pending.is_empty());
         result
     }
 
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index d0e6ae4c1c..922741ea98 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -946,12 +946,14 @@ pub(crate) fn rt_poll() -> bool {
 /// Where the poll/completion work runs: 0 (default) `system_highpri_wq` on the CPU that
 /// queued it (the mailbox interrupt's or the hrtimer's CPU, often an efficiency core); 1 the
 /// unbound high-priority `aurora_g16_big` queue limited to the CPUs of maximum capacity;
-/// 2 `system_highpri_wq` on one such CPU chosen at probe (no migration between passes).
+/// 2 `system_highpri_wq` on one such CPU chosen at probe (no migration between passes);
+/// 3 as 2 while GPU work is outstanding (flights or pending, as publish() last saw them),
+/// else as 0, so the idle firmware messages keep their pass on the CPU that took them.
 /// With 1 or 2, scheduler submit queues (`aurora_g16_hi`) created afterwards are limited to
 /// the same CPUs. Read per queueing.
 pub(crate) fn worker_big() -> u32 {
     match WORKER_BIG.load(Ordering::Relaxed) {
-        v @ 1..=2 => v,
+        v @ 1..=3 => v,
         _ => 0,
     }
 }
@@ -962,7 +964,7 @@ pub(crate) fn worker_big() -> u32 {
     WORKER_BIG_PARM,
     WORKER_BIG,
     "g16_worker_big",
-    "G16: run the completion/poll work on the max-capacity CPUs (default 0: where queued; 1: unbound high-priority queue on those CPUs; 2: one such CPU chosen at probe; runtime 0644)"
+    "G16: run the completion/poll work on the max-capacity CPUs (default 0: where queued; 1: unbound high-priority queue on those CPUs; 2: one such CPU chosen at probe; 3: as 2 only while GPU work is outstanding; runtime 0644)"
 );
 
 /// Storage of `g16_pmp_agx` (runtime 0644, default 1).
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 0070dc8c0a..31536a1471 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -73,13 +73,22 @@ fn tailcut_stats(f: &mut fmt::Formatter<'_>) -> fmt::Result {
     [const { core::sync::atomic::AtomicU64::new(0) }; 16];
 /// Time of the oldest immediate queueing not yet run (0: none).
 static WBIG_QUEUED_NS: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+/// `g16_worker_big` 3: GPU work outstanding as publish() last saw it (written under the
+/// device lock, read at any queueing), and queueings that took the default path for it.
+static WBIG_BUSY: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+static WBIG_IDLE: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+
+/// `g16_worker_big` 3: records whether flights or pending work exist after a publication.
+pub(crate) fn wbig_busy(busy: bool) {
+    WBIG_BUSY.store(busy, Ordering::Relaxed);
+}
 
 /// The `wbig:` line of the stats file.
 fn wbig_stats(f: &mut fmt::Formatter<'_>) -> fmt::Result {
     let v = |i: usize| WBIG_N[i].load(Ordering::Relaxed);
     write!(
         f,
-        "wbig: on {} big_cpu {} rechosen {} passes_big {} passes_little {} lat_us {} lat_max_us {} queued {} fallback {} cpu",
+        "wbig: on {} big_cpu {} rechosen {} passes_big {} passes_little {} lat_us {} lat_max_us {} queued {} fallback {} idle_default {} cpu",
         params::worker_big(),
         super::boot::glue::big_cpu(),
         super::boot::glue::big_rechosen(),
@@ -88,7 +97,8 @@ fn wbig_stats(f: &mut fmt::Formatter<'_>) -> fmt::Result {
         v(2) / 1000,
         v(3) / 1000,
         v(4),
-        v(5)
+        v(5),
+        WBIG_IDLE.load(Ordering::Relaxed)
     )?;
     for c in &WBIG_CPU {
         write!(f, " {}", c.load(Ordering::Relaxed))?;
@@ -610,7 +620,16 @@ fn mod_poll(self: &Arc<Self>, delay: Jiffies) {
         // g16_worker_big: 1 the unbound big-CPU queue, 2 one big CPU on system_highpri_wq,
         // else (or without them) the queueing CPU's system_highpri_wq worker, as before.
         let unbound = bindings::wq_misc_consts_WORK_CPU_UNBOUND as kernel::ffi::c_int;
-        let mode = params::worker_big();
+        // 3: the big CPU (as 2) only while GPU work is outstanding; an idle pass (a firmware
+        // ring-service message, the power window, sleep) stays where it was queued (as 0).
+        let mode = match params::worker_big() {
+            3 if WBIG_BUSY.load(Ordering::Relaxed) => 2,
+            3 => {
+                WBIG_IDLE.fetch_add(1, Ordering::Relaxed);
+                0
+            }
+            m => m,
+        };
         let big_wq = super::boot::glue::big_wq();
         // 2 pins only an IMMEDIATE queueing, to an online big CPU (glue.c re-chooses one if
         // the chosen CPU is offline, -1 if none is). A delayed queueing (the re-poll backup)
-- 
2.43.0

