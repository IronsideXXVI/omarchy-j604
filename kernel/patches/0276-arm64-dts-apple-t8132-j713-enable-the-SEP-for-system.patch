From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bartosz Nitka <niteria@gmail.com>
Date: Sun, 8 Nov 2026 15:48:11 +0100
Subject: [PATCH] arm64: dts: apple: t8132-j713: enable the SEP for
 system sleep

Assisted-by: LLM
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 9e95d60b404f0f5a91b2383ee854deec202aee86)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi b/arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi
index e852488477..adf78e23ba 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi
@@ -137,6 +137,15 @@ &dcp {
 	apple,panel-height-mm = <188>;
 };
 
+/* The enclave must take the sleep request, so its driver has to bind. */
+&sep_dart {
+	status = "okay";
+};
+
+&sep {
+	status = "okay";
+};
+
 /* External displays: both pipes, routed to either USB-C port. */
 &dcpext0_mbox {
 	status = "okay";
-- 
2.43.0

