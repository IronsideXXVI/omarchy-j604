From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Mon, 26 Oct 2026 14:59:51 +1100
Subject: [PATCH] media: apple: isp: copy complete IPC messages with FORTIFY
 enabled

Acquire the validity word, copy the complete message object after the DMA read barrier and restore that captured word. Copying seven payload words through the arg1 field violates FORTIFY field bounds. Cover all eight copied words and keep the ownership ordering unchanged.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
---
 drivers/media/platform/apple/isp/isp-ipc-test.c | 16 ++++++++++++++++
 drivers/media/platform/apple/isp/isp-ipc.c      |  5 +++--
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-ipc-test.c b/drivers/media/platform/apple/isp/isp-ipc-test.c
index 8b6decd63f..caa9e92f73 100644
--- a/drivers/media/platform/apple/isp/isp-ipc-test.c
+++ b/drivers/media/platform/apple/isp/isp-ipc-test.c
@@ -188,7 +188,23 @@ static void isp_test_late_ack_keeps_cursor(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, t->chan->cursor, 1);
 }
 
+static void isp_test_message_payload_copy(struct kunit *test)
+{
+	struct isp_sm_test *t = isp_sm_test_alloc(test);
+	struct isp_message response = {
+		.arg0 = 0x5000001, .arg1 = 1, .arg2 = 2, .arg3 = 3,
+		.arg4 = 4, .arg5 = 5, .arg6 = 6, .arg7 = 7,
+	};
+	struct isp_message copied = {};
+
+	isp_get_current_format(t->isp)->pixelformat = V4L2_PIX_FMT_P010;
+	t->chan->virt = &response;
+	chan_read_msg_index(t->isp, t->chan, &copied, 0);
+	KUNIT_EXPECT_MEMEQ(test, &copied, &response, sizeof(response));
+}
+
 static struct kunit_case isp_ipc_test_cases[] = {
+	KUNIT_CASE(isp_test_message_payload_copy),
 	KUNIT_CASE(isp_test_late_ack_keeps_cursor),
 	KUNIT_CASE(isp_test_command_ring_wrap),
 	KUNIT_CASE(isp_test_sm_free_releases),
diff --git a/drivers/media/platform/apple/isp/isp-ipc.c b/drivers/media/platform/apple/isp/isp-ipc.c
index 92cfc6ab35..74cc717ead 100644
--- a/drivers/media/platform/apple/isp/isp-ipc.c
+++ b/drivers/media/platform/apple/isp/isp-ipc.c
@@ -72,11 +72,12 @@ static inline void chan_read_msg_index(struct apple_isp *isp,
 {
 	if (isp_is_p010(isp)) {
 		u64 *slot = chan_msg_virt(chan, index);
+		u64 arg0 = READ_ONCE(*slot);
 
 		/* Acquire validity before consuming the firmware-owned payload. */
-		msg->arg0 = READ_ONCE(*slot);
 		dma_rmb();
-		memcpy(&msg->arg1, slot + 1, sizeof(*msg) - sizeof(msg->arg0));
+		memcpy(msg, slot, sizeof(*msg));
+		msg->arg0 = arg0;
 	} else {
 		memcpy(msg, chan_msg_virt(chan, index), sizeof(*msg));
 	}
