From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 18 Nov 2026 01:15:44 +0000
Subject: [PATCH] drm/asahi: g16: Publish fewer renders ahead for large
 targets by default

Make g16_large_window default 4: a render whose target has at least
g16_large_px (3500000) pixels is published with at most four renders
ahead of it. On 1.1032 a depth-64 client's 2560x1440 geometry went from
275.7 to 261.4 us per submit and its 3840x2160 geometry from 470.5 to
452.0 with a window of 4. Targets below the threshold, 1920x1080 among
them, keep the whole resident depth. g16_large_window=0 restores the
previous behaviour at runtime.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index e0f0b53e8b..6580b7aaf8 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2560,8 +2560,8 @@ fn resident_latch() -> u32 {
     RESIDENT_LATCH.load(Ordering::Acquire)
 }
 
-/// Storage of `g16_large_window` (0644, default 0 = off; read at every publication).
-static LARGE_WINDOW: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_large_window` (0644, default 4; read at every publication).
+static LARGE_WINDOW: AtomicU32 = AtomicU32::new(4);
 
 /// `g16_large_window`: the most renders in firmware when the next render's target is at least
 /// `g16_large_px` pixels (0: off, the resident depth applies to every render).
@@ -2575,7 +2575,7 @@ pub(crate) fn large_window() -> u32 {
     LARGE_WINDOW_PARM,
     LARGE_WINDOW,
     "g16_large_window",
-    "G16: publish at most this many renders ahead when the next render's target has at least g16_large_px pixels (default 0: off; runtime 0644)"
+    "G16: publish at most this many renders ahead when the next render's target has at least g16_large_px pixels (default 4; 0: off; runtime 0644)"
 );
 
 /// Storage of `g16_large_px` (0644, default 3500000; read at every publication).
-- 
2.43.0

