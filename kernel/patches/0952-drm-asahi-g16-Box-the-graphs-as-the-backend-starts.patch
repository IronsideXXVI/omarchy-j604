From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 19 Nov 2026 08:17:18 +0000
Subject: [PATCH] drm/asahi: g16: Box the graphs as the backend starts

start_backend made the graphs by value inside its closure's result,
destructured that result and moved them into the boxed Firmware, so
every byte of Graphs sat in that frame two to three times. With the
compute queue commits the frame grew by 160 bytes, past the boot stack
budget.

Box the graphs as they are made and keep the box in Firmware. Field
access is unchanged. start_backend's frame goes from 5,040 to 3,952
bytes and the boot chain from 18,480 to 17,936.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/mod.rs | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/mod.rs b/drivers/gpu/drm/asahi/g16/mod.rs
index b718190ce8..007ba243bb 100644
--- a/drivers/gpu/drm/asahi/g16/mod.rs
+++ b/drivers/gpu/drm/asahi/g16/mod.rs
@@ -441,7 +441,7 @@ pub(crate) struct Firmware {
     /// Decoded firmware events (stage counters, last error, growth requests).
     pub(crate) events: event::Events,
     /// The compute and render graphs.
-    pub(crate) graph: graph::Graphs,
+    pub(crate) graph: KBox<graph::Graphs>,
     /// Compute slots, pass slots and clustering buffers.
     pub(crate) slots: KBox<slots::Slots>,
     /// Pending jobs, prefixes, horizons and flights.
@@ -585,7 +585,9 @@ fn start_backend(
             "G16: firmware at READY, starting the backend\n"
         );
         let backend = (|| -> Result<_> {
-            let graph = graph::Graphs::new(dev, &mut booted.objects)?;
+            // Boxed as it is made: the graphs are not copied through this closure's result and
+            // into the firmware box on the boot stack.
+            let graph = KBox::new(graph::Graphs::new(dev, &mut booted.objects)?, GFP_KERNEL)?;
             let slots = slots::Slots::new_boxed()?;
             let pools = pools::Pools::new(dev);
             let vms = vm::Registry::new()?;
