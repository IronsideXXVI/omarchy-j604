From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 17:39:56 +0000
Subject: [PATCH] tools/asahi: rtkit-oslog-tests: follow CoreAnalytics and the
 oslog echo

The RTKit OSLog host test no longer built. The J604 series'
apple_rtkit_reinit() also frees and reinitialises the CoreAnalytics
buffer and completion, and 167ddf5b79 makes apple_rtkit_oslog_rx() echo
an owed counter through cmpxchg() on oslog_owed. The model had none of
these (MEASURED: 2 compile errors on the linux-aurora 1.612 series, 4 on
later J604 integration branches and on this branch).

Give the model the CoreAnalytics buffer and completion, oslog_owed and a
host cmpxchg(). Reinit now frees seven buffers, so the reset check
expects seven and names them.

Result (MEASURED): 859 OSLog counter/channel/session controls pass. The
four mutations (admission, channel, counter, reset) each still build
and each fails an assertion.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 tools/asahi/rtkit-oslog-tests.py | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/tools/asahi/rtkit-oslog-tests.py b/tools/asahi/rtkit-oslog-tests.py
index d09307d8a7..24474a5386 100644
--- a/tools/asahi/rtkit-oslog-tests.py
+++ b/tools/asahi/rtkit-oslog-tests.py
@@ -37,6 +37,7 @@ typedef uint8_t u8; typedef uint64_t u64; typedef uint32_t u32;
 #define ARRAY_SIZE(x) (sizeof(x)/sizeof((x)[0]))
 #define APPLE_RTKIT_MAX_ENDPOINTS 256
 #define WRITE_ONCE(x,v) ((x)=(v))
+#define cmpxchg(p,o,n) __sync_val_compare_and_swap((p),(o),(n))
 #define spin_lock_irqsave(l,f) ((void)(l), (f)=0)
 #define spin_unlock_irqrestore(l,f) ((void)(l), (void)(f))
 struct apple_rtkit_shmem { size_t size; };
@@ -45,16 +46,17 @@ struct apple_rtkit {
  void *dev, *wq;
  struct mailbox *mbox;
  struct apple_rtkit_shmem oslog_buffer, syslog_buffer, ioreport_buffer, crashlog_buffer;
- struct apple_rtkit_shmem kdebug_buffer0, kdebug_buffer1;
+ struct apple_rtkit_shmem kdebug_buffer0, kdebug_buffer1, coreanalytics_buffer;
  int sync_ack_fifo;
  bool sync_syslog_ack, oslog_inherited, syslog_inherited, crashlog_inherited, crashed, shutting_down;
  bool oslog_echo;
+ u64 oslog_owed;
  int boot_result;
  unsigned iop_power_state, ap_power_state;
  unsigned long endpoints[4], started[4];
  char *syslog_msg_buffer;
  size_t syslog_n_entries, syslog_msg_size;
- int epmap_completion, iop_pwr_ack_completion, ap_pwr_ack_completion;
+ int epmap_completion, iop_pwr_ack_completion, ap_pwr_ack_completion, coreanalytics_completion;
 };
 static unsigned sent, warnings, errors, requests, detachments, flushes, freed, checks;
 static int send_error, setup_error, start_error;
@@ -128,7 +130,8 @@ int main(void)
   detachments=flushes=freed=0;start_error=fail?-5:0;
   assert(apple_rtkit_reinit(&r)==start_error);
   assert(!r.oslog_inherited && !r.syslog_inherited && !r.crashlog_inherited);
-  assert(!r.oslog_buffer.size && !r.crashed && !r.syslog_msg_size && freed==6);
+  /* coreanalytics, ioreport, crashlog, oslog, syslog, kdebug0, kdebug1 */
+  assert(!r.oslog_buffer.size && !r.crashed && !r.syslog_msg_size && freed==7);
   assert(r.endpoints[0]==(1UL<<APPLE_RTKIT_EP_MGMT));
   assert(detachments==(fail?2U:1U) && flushes==(fail?2U:1U));
   event(&r,type|1,false);++checks;
