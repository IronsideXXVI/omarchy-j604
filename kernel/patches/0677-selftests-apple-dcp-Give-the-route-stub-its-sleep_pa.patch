From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 14:18:00 +0000
Subject: [PATCH] selftests: apple-dcp: Give the route stub its sleep_parked
 flag

dcp_typec_route_deactivate() now reads route->sleep_parked ("park a
Type-C display route's crossbar for a deep sleep"). The host tests that
extract it compile it against the stub route in quiesce.py, which lacked
the member, so they gained a compile error. Add it after the fields
transaction.py rewrites, so its replacement still matches.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 tools/testing/selftests/drivers/gpu/apple-dcp/quiesce.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/quiesce.py b/tools/testing/selftests/drivers/gpu/apple-dcp/quiesce.py
index cc279a2f29..c522b6944d 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/quiesce.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/quiesce.py
@@ -59,7 +59,7 @@ struct connector { bool connected; };
 struct apple_dcp { int external_lock,external_error; bool external_cable,external_stopped; struct { bool connected; } dptxport[1]; void *hdmi_hpd; bool active; bool external,typec_cable_connected; void *dev; struct connector *typec_connector; bool ext_backlight; };
 struct apple_dcp_typec_route;
 struct apple_dcp_typec_port { int link; void *connector_np; struct apple_dcp_typec_route *owner,*target,*secondary_target,*preferred_route; void *applied_alt; unsigned long applied_mode; unsigned applied_status,applied_conf; bool applied_valid,safe_pending,safe_finish_ready,dp_wanted,dp_hpd,hpd,busy_noted; };
-struct apple_dcp_typec_route { struct apple_dcp_typec_port *port; struct apple_dcp *dcp; void *xbar; bool deactivate_xbar_done; int deactivate_error; bool selected,tunnel; };
+struct apple_dcp_typec_route { struct apple_dcp_typec_port *port; struct apple_dcp *dcp; void *xbar; bool deactivate_xbar_done; int deactivate_error; bool selected,tunnel; bool sleep_parked; };
 static int dcp_typec_fabric_lock,dcp_typec_ports,deactivate_calls;
 struct drm_device { int unused; };
 static struct apple_dcp display;
