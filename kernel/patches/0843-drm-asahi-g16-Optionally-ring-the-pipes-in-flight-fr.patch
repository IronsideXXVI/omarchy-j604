From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 23:18:16 +0000
Subject: [PATCH] drm/asahi: g16: Optionally ring the pipes in flight
 from the mailbox callback

At render.light depth 64 the firmware runs a group of renders, sends its
end-of-work message and idles, although renders published meanwhile wait
with their doorbells already rung. g16_rekick 1 rings them again, but
only once the poll pass runs: about 100 us after the message, behind the
host wake and the start of the pass.

Add value 3 to g16_rekick. The mailbox receive callback then rings the
render pipes if renders are in flight, and the compute pipe if compute
commands are, when the firmware's end-of-work message arrives, before
the pass is woken; no poll pass rings. The callback runs under the
mailbox receive lock with interrupts off, so the doorbell is sent
atomically, as RTKit's own sends from that callback are. Which pipes
have flights is recorded after each pass and submission. The Globals
doorbell tally, which needs the state lock, takes these doorbells at the
next doorbell sent under the lock. The stats file counts them.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/boot.rs   |  7 +++-
 drivers/gpu/drm/asahi/g16/mod.rs    | 62 +++++++++++++++++++++++++++++
 drivers/gpu/drm/asahi/g16/params.rs |  8 ++--
 drivers/gpu/drm/asahi/g16/poll.rs   |  7 +++-
 4 files changed, 78 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/boot.rs b/drivers/gpu/drm/asahi/g16/boot.rs
index 63ac9c5f74..87edc3cc30 100644
--- a/drivers/gpu/drm/asahi/g16/boot.rs
+++ b/drivers/gpu/drm/asahi/g16/boot.rs
@@ -259,6 +259,7 @@ unsafe fn shared<'a>(cookie: *mut c_void) -> ArcBorrow<'a, Shared> {
     // EP 0x20 0x0042... asks for receive-ring draining; nothing else expected.
     if endpoint == hw::ep::FIRMWARE && message == hw::ep::RING_SERVICE {
         if shared.started.load(Ordering::Acquire) {
+            shared.irq_rekick();
             Arc::<Shared>::from(shared).kick();
         }
         return;
@@ -307,6 +308,7 @@ unsafe fn shared<'a>(cookie: *mut c_void) -> ArcBorrow<'a, Shared> {
     {
         return false;
     }
+    shared.irq_rekick();
     Arc::<Shared>::from(shared).kick();
     true
 }
@@ -424,6 +426,7 @@ fn new(dev: &device::Device, shared: &Arc<Shared>) -> Result<Self> {
                         e
                     );
                 }
+                shared.rtk.store(rtk, Ordering::Release);
                 Ok(Self { rtk })
             }
             Err(e) => {
@@ -533,7 +536,9 @@ pub(crate) fn send(&mut self, endpoint: u8, message: u64) -> Result {
         if endpoint == hw::ep::DOORBELL && super::params::doorbell_tally() {
             if let Some(g) = self.globals.as_ref() {
                 let at = super::fw::initdata::globals::DOORBELL_TALLY;
-                g.w32(at, g.r32(at)?.wrapping_add(1))?;
+                // With the doorbells `g16_rekick` 3 rang from the receive callback.
+                let owed = self.shared.irq_tally.swap(0, Ordering::Relaxed);
+                g.w32(at, g.r32(at)?.wrapping_add(1).wrapping_add(owed))?;
                 regs::wmb();
             }
         }
diff --git a/drivers/gpu/drm/asahi/g16/mod.rs b/drivers/gpu/drm/asahi/g16/mod.rs
index 22d538e88c..f6c04ae1eb 100644
--- a/drivers/gpu/drm/asahi/g16/mod.rs
+++ b/drivers/gpu/drm/asahi/g16/mod.rs
@@ -90,6 +90,7 @@
 
 use crate::driver::{AsahiDrmDevice, AsahiPlatformDriver};
 use crate::{alloc, gem, gpu, mmu, regs as shared_regs};
+use channel::Channel;
 
 /// Name of the G16 platform driver.
 pub(crate) const DRIVER_NAME: &CStr = c_str!("aurora-g16");
@@ -225,6 +226,14 @@ pub(crate) struct Shared {
     pub(crate) error: AtomicI32,
     /// The RTKit receive callbacks may queue the poll work.
     pub(crate) started: AtomicBool,
+    /// The RTKit handle once initialized (retained until reboot), for `g16_rekick` 3.
+    pub(crate) rtk: AtomicPtr<kernel::bindings::apple_rtkit>,
+    /// `g16_rekick` 3: the pipes with published flights outstanding after the last pass or
+    /// submission (bit 0 render, bit 1 compute), the doorbells rung from the receive callback,
+    /// and those owed to the Globals doorbell tally (added by the next send under the lock).
+    pub(crate) bells_out: AtomicU32,
+    pub(crate) irq_bells: AtomicU64,
+    pub(crate) irq_tally: AtomicU32,
     /// Firmware DATA, where the only RTKit buffer accepted lies.
     pub(crate) data: Range<u64>,
     /// Physical address of the accepted RTKit buffer, 0 before.
@@ -285,6 +294,55 @@ pub(crate) fn kick(self: &Arc<Self>) {
         self.poll_now();
     }
 
+    /// `g16_rekick` 3: rings the pipes with published flights outstanding from the mailbox
+    /// receive callback, at the firmware's end-of-work message. The callback runs under the
+    /// mailbox receive lock with interrupts off: the send is atomic (it never sleeps, as
+    /// RTKit's own sends from that callback), and the Globals tally is added under the lock.
+    pub(crate) fn irq_rekick(&self) {
+        let rtk = self.rtk.load(Ordering::Acquire);
+        let bells = self.bells_out.load(Ordering::Acquire);
+        if params::rekick() != 3
+            || rtk.is_null()
+            || bells == 0
+            || self.sleeping.load(Ordering::Acquire)
+            || self.crashed.load(Ordering::Acquire)
+        {
+            return;
+        }
+        for (bit, channel) in [(1, Channel::Ta), (1, Channel::Fs), (2, Channel::Compute)] {
+            if bells & bit == 0 {
+                continue;
+            }
+            let message = hw::engine::DOORBELL | channel as u64;
+            // SAFETY: `rtk` is the live RTKit handle, retained until reboot; an atomic send
+            // does not sleep.
+            let ret = unsafe {
+                kernel::bindings::apple_rtkit_send_message(
+                    rtk,
+                    hw::ep::DOORBELL,
+                    message,
+                    core::ptr::null_mut(),
+                    true,
+                )
+            };
+            if ret != 0 {
+                return;
+            }
+            self.irq_bells.fetch_add(1, Ordering::Relaxed);
+            if params::doorbell_tally() {
+                self.irq_tally.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+    }
+
+    /// `g16_rekick` 3: records which pipes have published flights outstanding.
+    pub(crate) fn note_bells(&self, flights: &[engine::Flight]) {
+        let render = flights.iter().any(|f| f.renders != 0) as u32;
+        let compute = flights.iter().any(|f| f.computes != 0) as u32;
+        self.bells_out
+            .store(render | compute << 1, Ordering::Release);
+    }
+
     /// Latches the fail-stop state.
     pub(crate) fn fail_stop(&self, error: Error) {
         let _ =
@@ -434,6 +492,10 @@ pub(crate) fn new(
                 clpc_busy_ns: AtomicU64::new(0),
                 error: AtomicI32::new(0),
                 started: AtomicBool::new(false),
+                rtk: AtomicPtr::new(core::ptr::null_mut()),
+                bells_out: AtomicU32::new(0),
+                irq_bells: AtomicU64::new(0),
+                irq_tally: AtomicU32::new(0),
                 data,
                 rtkit_buffer: AtomicU64::new(0),
                 orphaned: AtomicBool::new(false),
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 613c829384..2f9864a8f9 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -973,9 +973,11 @@ pub(crate) fn fs_sample_size() -> bool {
 
 /// When a poll pass rings the TA and FS doorbells again while renders are in flight, with no
 /// new record: 0 never; 1 at a pass that follows a firmware event; 2 at every pass. A render
-/// published while the firmware runs older ones then gets a doorbell after they end.
+/// published while the firmware runs older ones then gets a doorbell after they end. 3: no
+/// pass rings; the mailbox receive callback rings the pipes with published flights outstanding
+/// when the firmware's end-of-work message arrives, before the pass is woken.
 pub(crate) fn rekick() -> u32 {
-    REKICK.load(Ordering::Relaxed).min(2)
+    REKICK.load(Ordering::Relaxed).min(3)
 }
 
 live_u32_param!(
@@ -984,7 +986,7 @@ pub(crate) fn rekick() -> u32 {
     REKICK_PARM,
     REKICK,
     "g16_rekick",
-    "G16: ring the render doorbells again at a poll pass while renders are in flight (default 0: never; 1: after a firmware event; 2: every pass; runtime 0644)"
+    "G16: ring the render doorbells again at a poll pass while renders are in flight (default 0: never; 1: after a firmware event; 2: every pass; 3: from the mailbox callback at the firmware's event, for the pipes with flights; runtime 0644)"
 );
 
 /// Storage of `g16_rekick_us` (runtime 0644, default 0).
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 9b2d82cbba..d79f5d5c06 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -361,6 +361,7 @@ pub(crate) fn run_poll(self: Arc<Self>) {
                 }
                 let evented = self.evented.swap(false, Ordering::AcqRel);
                 let result = firmware.poll(evented, &mut done);
+                self.note_bells(&firmware.engine.flights);
                 let busy = !firmware.engine.flights.is_empty();
                 match result {
                     Ok(true) => {
@@ -429,6 +430,7 @@ pub(crate) fn submit(self: &Arc<Self>, job: Arc<Job>) -> Result {
                     firmware.fail_stop(error, &mut done);
                     self.fail_stop(error);
                 }
+                self.note_bells(&firmware.engine.flights);
                 if !firmware.engine.flights.is_empty() || firmware.engine.chan_wait {
                     self.lat_qos(!firmware.engine.flights.is_empty(), false);
                     self.rearm(firmware.engine.chan_wait, firmware.engine.window_wait);
@@ -1761,12 +1763,13 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
         )?;
         writeln!(
             f,
-            "rekick: pass {} timer_render {} timer_compute {} rekick {} rekick_us {}",
+            "rekick: pass {} timer_render {} timer_compute {} rekick {} rekick_us {} irq {}",
             s.rekick[0],
             s.rekick[1],
             s.rekick[2],
             params::rekick(),
-            params::rekick_us()
+            params::rekick_us(),
+            self.session.shared.irq_bells.load(Ordering::Relaxed)
         )?;
         let w: [u64; 8] = core::array::from_fn(|i| FS_WORDS[i].load(Ordering::Relaxed));
         writeln!(
