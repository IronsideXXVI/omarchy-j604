From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sat, 7 Nov 2026 01:13:08 +1100
Subject: [PATCH] iio: aop_motion: give each sensor its own trigger

iio-sensor-proxy finds a buffered sensor through its trigger: it looks
for "<name>-dev<id>" or "<name>-trigger", and without one it logs
"Could not find trigger name associated with ..." and does not offer the
sensor at all. The AOP accelerometer and gyroscope fill their buffers as
the AOP reports, with no trigger, so on the J616s the accelerometer was
missing from iio-sensor-proxy (HasAccelerometer false) and every boot
logged that warning.

Register a "<name>-dev<id>" trigger per device and make it the default,
the way the HID sensor hub drivers do: the buffer is a triggered buffer
whose poll function only stamps the time, and the report listener keeps
pushing the scans. The trigger never fires. Only the device's own
trigger is accepted.

Add the IIO trigger headers to the Rust bindings and a helper for the
inline iio_trigger_get().

Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Assisted-by: LLM
(backported from commit bac6f373c5c9c1417a7ca2c80d3eaf232a4d8718)
[j604: the trigger is allocated with the crate's THIS_MODULE (this tree has no
 kernel::module::this_module()); rust/helpers/helpers.c lists its includes in
 another order in this tree, so only the iio.c include is added; and the
 iio_trigger_get() helper is built only with CONFIG_IIO_TRIGGER, the only
 configuration that declares the inline (as rust/helpers/cpufreq.c does for
 CONFIG_CPU_FREQ): the official recipe config without the motion driver has
 no IIO_TRIGGER and failed to build vmlinux at "call to undeclared function
 'iio_trigger_get'". Otherwise unchanged.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/iio/common/aop_sensors/Kconfig       |  2 +-
 drivers/iio/common/aop_sensors/aop_motion.rs | 40 +++++++++++++++++++-
 rust/bindings/bindings_helper.h              |  3 ++
 rust/helpers/helpers.c                       |  1 +
 rust/helpers/iio.c                           | 10 +++++
 5 files changed, 53 insertions(+), 3 deletions(-)
 create mode 100644 rust/helpers/iio.c

diff --git a/drivers/iio/common/aop_sensors/Kconfig b/drivers/iio/common/aop_sensors/Kconfig
index df1277d408..1a8e25f66a 100644
--- a/drivers/iio/common/aop_sensors/Kconfig
+++ b/drivers/iio/common/aop_sensors/Kconfig
@@ -28,7 +28,7 @@ config IIO_AOP_SENSOR_MOTION
 	depends on SYSFS
 	select APPLE_AOP
 	select IIO_BUFFER
-	select IIO_KFIFO_BUF
+	select IIO_TRIGGERED_BUFFER
 	help
 	  Module to handle the accelerometer and gyroscope that the AOP
 	  coprocessor of Apple laptops reads. Each sensor is an IIO device
diff --git a/drivers/iio/common/aop_sensors/aop_motion.rs b/drivers/iio/common/aop_sensors/aop_motion.rs
index ec369b4777..efa75aa5c0 100644
--- a/drivers/iio/common/aop_sensors/aop_motion.rs
+++ b/drivers/iio/common/aop_sensors/aop_motion.rs
@@ -390,6 +390,9 @@ impl MotionIio {
                 ],
                 info: bindings::iio_info {
                     read_raw: Some(motion_read_raw),
+                    // The buffer fills from the AOP's reports, not from a
+                    // trigger, so only the device's own trigger fits it.
+                    validate_trigger: Some(bindings::iio_validate_own_trigger),
                     ..Default::default()
                 },
                 _p: PhantomPinned,
@@ -432,13 +435,46 @@ impl MotionIio {
             _spec: spec,
             registered: false,
         };
+        // The buffer fills as the AOP reports, so the trigger never fires.
+        // It exists because userspace finds a buffered sensor through its
+        // trigger: iio-sensor-proxy looks for "<name>-dev<id>" and does not
+        // use a buffer without one.
+        // SAFETY: `dev` is valid and `indio_dev` is allocated; the format
+        // takes the device name and its id, both valid here.
+        let module = &THIS_MODULE;
+        let trig = unsafe {
+            bindings::__devm_iio_trigger_alloc(
+                dev.as_raw(),
+                module.as_ptr(),
+                c"%s-dev%d".as_char_ptr(),
+                kind.name.as_char_ptr(),
+                bindings::iio_device_id(indio_dev),
+            )
+        };
+        if trig.is_null() {
+            return Err(ENOMEM);
+        }
+        // SAFETY: `trig` was allocated above; it is unregistered and freed
+        // with the platform device's resources, after the IIO device that
+        // holds a reference to it.
+        let ret = unsafe { bindings::devm_iio_trigger_register(dev.as_raw(), trig) };
+        if ret < 0 {
+            return Err(Error::from_errno(ret));
+        }
+        // SAFETY: `indio_dev` is not registered yet; the reference taken
+        // here is dropped when the IIO device is released.
+        unsafe { (*indio_dev).trig = bindings::iio_trigger_get(trig) };
         // SAFETY: Both devices are valid. The buffer is released with the
         // platform device's resources; the IIO device holds its own
-        // reference to it until it is freed.
+        // reference to it until it is freed. The poll function only stamps
+        // the time; the report listener pushes the scans.
         let ret = unsafe {
-            bindings::devm_iio_kfifo_buffer_setup_ext(
+            bindings::devm_iio_triggered_buffer_setup_ext(
                 dev.as_raw(),
                 indio_dev,
+                Some(bindings::iio_pollfunc_store_time),
+                None,
+                bindings::iio_buffer_direction_IIO_BUFFER_DIRECTION_IN,
                 ptr::null(),
                 ptr::null_mut(),
             )
diff --git a/rust/bindings/bindings_helper.h b/rust/bindings/bindings_helper.h
index e9af270acd..acc2d82a10 100644
--- a/rust/bindings/bindings_helper.h
+++ b/rust/bindings/bindings_helper.h
@@ -71,6 +71,9 @@
 #include <linux/iio/buffer.h>
 #include <linux/iio/iio.h>
 #include <linux/iio/kfifo_buf.h>
+#include <linux/iio/trigger.h>
+#include <linux/iio/trigger_consumer.h>
+#include <linux/iio/triggered_buffer.h>
 #include <linux/iio/types.h>
 #include <linux/input.h>
 #include <linux/interrupt.h>
diff --git a/rust/helpers/helpers.c b/rust/helpers/helpers.c
index f5aec52017..c90393ecac 100644
--- a/rust/helpers/helpers.c
+++ b/rust/helpers/helpers.c
@@ -68,6 +68,7 @@
 #include "drm_gpuvm.c"
 #include "drm_syncobj.c"
 #include "err.c"
+#include "iio.c"
 #include "irq.c"
 #include "fs.c"
 #include "gpu.c"
diff --git a/rust/helpers/iio.c b/rust/helpers/iio.c
new file mode 100644
index 0000000000..28ed1bb4e6
--- /dev/null
+++ b/rust/helpers/iio.c
@@ -0,0 +1,10 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/iio/trigger.h>
+
+#ifdef CONFIG_IIO_TRIGGER
+__rust_helper struct iio_trigger *rust_helper_iio_trigger_get(struct iio_trigger *trig)
+{
+	return iio_trigger_get(trig);
+}
+#endif
