From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 09:02:55 +0000
Subject: [PATCH] drm/apple: m4: adaptive sync on the J604 panel, as an
 experiment

The J604 panel is a 120 Hz ProMotion panel, like the desktop 26.6 panels of
the M4 Pro and Max MacBook Pros that Aurora drives with VRR: the swaps
carry the same constant timing words this backend already sends
(dcp_desktop_present_deadline(): 120), and VRR_ENABLED moves the
adaptive-sync minimum of the live mode with IOMFBParameter 14 (minRR in
16.16 Hz, mediaTargetRate, fractional rate; count 3) through
set_parameter_dcp, A442 on the desktop 26.6 firmware (dcp_vrr_update(),
dcp_peer_adaptive_sync(): 0x28 bytes in, a u32 status out).

That method number is not observed on 26.6.2. Four methods this backend
uses carry the desktop 26.6 numbers (A406 swap_start, A407 swap_submit,
A457 first_client_open, A473 setPowerState), so A442 is taken to be
set_parameter_dcp; a wrong method fails the session.

Add appledrm.panel_vrr_min_hz (default 0: off) for a test window. With a
rate, the panel connector reports vrr_capable, the atomic check takes
VRR_ENABLED, and a commit that changes VRR_ENABLED sends the minimum: the
rate with VRR on, 120 Hz with it off. Nothing is sent before a commit
first asks for VRR, and every call and its status word is logged and
shown in debugfs iomfb_m4. Without the parameter nothing changes: the
connector stays not VRR-capable and VRR_ENABLED is refused, as before.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
(cherry picked from commit 64e1f848148744c29e6b583e8acc8f7f7d856ee7)
[j604: k610 drm sync: iomfb_m4.h conflict next to iomfb_m4_panel_edr_capable()
 (both kept). The 50d5865ea6 backend also drives the external T8132 DCP, so
 the VRR experiment is limited to the internal panel: no vrr_capable on an
 external connector from iomfb_m4_panel_edid(), iomfb_m4_panel_vrr_requested()
 is false for an external DCP (dcp_crtc_atomic_check() keeps refusing
 VRR_ENABLED there, as upstream does), and iomfb_m4_atomic_vrr() returns
 for it. Default unchanged: panel_vrr_min_hz=0 (0444).]
(cherry picked from commit 767f179714a344c6937ce5cb96ea567fb861b636)
(cherry picked from commit 5e1f0136a9703233fcaa40037824c5904df3ed5d)
---
 drivers/gpu/drm/apple/dcp.c      |   4 +-
 drivers/gpu/drm/apple/iomfb.c    |   4 +-
 drivers/gpu/drm/apple/iomfb_m4.c | 109 ++++++++++++++++++++++++++++++-
 drivers/gpu/drm/apple/iomfb_m4.h |   5 ++
 4 files changed, 118 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index b61bc986d3..d603459360 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -1508,8 +1508,8 @@ int dcp_crtc_atomic_check(struct drm_crtc *crtc, struct drm_atomic_commit *commi
 		crtc_state = drm_atomic_get_new_crtc_state(commit, crtc);
 		if (!crtc_state)
 			return 0;
-		if (crtc_state->vrr_enabled || crtc_state->ctm ||
-		    crtc_state->degamma_lut || crtc_state->gamma_lut)
+		if ((crtc_state->vrr_enabled && !iomfb_m4_panel_vrr_requested(dcp)) ||
+		    crtc_state->ctm || crtc_state->degamma_lut || crtc_state->gamma_lut)
 			return -EINVAL;
 		if (!crtc_state->enable)
 			return 0;
diff --git a/drivers/gpu/drm/apple/iomfb.c b/drivers/gpu/drm/apple/iomfb.c
index b629af76d0..4e2a43e730 100644
--- a/drivers/gpu/drm/apple/iomfb.c
+++ b/drivers/gpu/drm/apple/iomfb.c
@@ -3321,8 +3321,10 @@ void dcp_flush(struct drm_crtc *crtc, struct drm_atomic_commit *commit)
 		if (!new || !new->active)
 			return;
 		ret = iomfb_m4_error(dcp);
-		if (!ret)
+		if (!ret) {
 			iomfb_m4_atomic_hdr(dcp, crtc, commit);
+			iomfb_m4_atomic_vrr(dcp, new->vrr_enabled);
+		}
 		/* A CRTC-only commit publishes no new framebuffer. */
 		if (!ret && plane) {
 			obj = plane->fb ? drm_fb_dma_get_gem_obj(plane->fb, 0) : NULL;
diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index f225b7d55c..cdfa5d71bc 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -136,6 +136,22 @@ module_param(panel_edr, bool, 0444);
 MODULE_PARM_DESC(panel_edr,
 		 "J604: offer HDR to the compositor and show BT.2020 PQ content as EDR on the internal panel, up to its ADT peak (testing; default: off; boot time)");
 
+static unsigned int panel_vrr_min_hz;
+
+static int panel_vrr_min_hz_set(const char *val, const struct kernel_param *kp)
+{
+	return param_set_uint_minmax(val, kp, 0, 119);
+}
+
+static const struct kernel_param_ops panel_vrr_min_hz_ops = {
+	.set = panel_vrr_min_hz_set,
+	.get = param_get_uint,
+};
+
+module_param_cb(panel_vrr_min_hz, &panel_vrr_min_hz_ops, &panel_vrr_min_hz, 0444);
+MODULE_PARM_DESC(panel_vrr_min_hz,
+		 "J604 experiment: offer VRR on the internal panel; VRR_ENABLED sets the DCP adaptive-sync minimum to this rate (A442 IOMFBParameter 14, as desktop 26.6 ProMotion panels; 0: off, default; at most 119; boot time)");
+
 struct iomfb_m4 {
 	struct apple_dcp *owner;
 	struct device *dev;
@@ -185,6 +201,13 @@ struct iomfb_m4 {
 	bool edr_capable, output_edr;
 	struct dcp_m4_edr_state edr;
 	u64 edr_swaps;
+	/*
+	 * VRR (panel_vrr_min_hz): the adaptive-sync minimum last accepted
+	 * (16.16 Hz, 0: never sent) and the A442 status words seen.
+	 */
+	u32 vrr_min_sent;
+	u32 vrr_status;
+	u64 vrr_calls;
 	struct delayed_work idle_cache;
 	/*
 	 * Framebuffer references a window let go of, put
@@ -3033,7 +3056,12 @@ int iomfb_m4_panel_edid(struct apple_dcp *owner, struct drm_connector *connector
 	struct drm_display_mode mode;
 	int ret;
 
-	if (!dcp || !dcp_m4_pf->model_year)
+	if (!dcp)
+		return 0;
+	/* panel_vrr_min_hz: the compositor may ask for VRR (testing). */
+	if (!dcp->external && READ_ONCE(panel_vrr_min_hz))
+		drm_connector_set_vrr_capable_property(connector, true);
+	if (!dcp_m4_pf->model_year)
 		return 0;
 	if (!dcp->panel_adt_read) {
 		struct dcp_panel_adt adt = {};
@@ -3089,6 +3117,81 @@ int iomfb_m4_panel_edid(struct apple_dcp *owner, struct drm_connector *connector
 	return ret;
 }
 
+/*
+ * IOMFBParameter 14, adaptive sync: minRR (16.16 Hz), mediaTargetRate and the
+ * fractional rate, 0 = off. The desktop 26.6 firmware takes it as A442
+ * set_parameter_dcp (0x28 bytes in, a u32 status out; Aurora's
+ * dcp_vrr_update() and dcp_peer_adaptive_sync()); its A406, A407, A457 and
+ * A473 are this backend's swap_start, swap_submit, first_client_open and
+ * setPowerState, so A442 is taken to be set_parameter_dcp here too
+ * (INFERENCE: not observed on 26.6.2).
+ */
+struct dcp_m4_set_parameter {
+	__le32 param;
+	__le32 value[8];
+	__le32 count;
+} __packed;
+static_assert(sizeof(struct dcp_m4_set_parameter) == 0x28);
+
+#define DCP_M4_SET_PARAMETER_METHOD	442
+#define DCP_M4_PARAM_ADAPTIVE_SYNC	14
+#define DCP_M4_VRR_FIXED_HZ		120
+
+static int dcp_m4_set_adaptive_sync(struct iomfb_m4 *dcp, u32 min_rr)
+{
+	const struct dcp_m4_set_parameter param = {
+		.param = cpu_to_le32(DCP_M4_PARAM_ADAPTIVE_SYNC),
+		.value = { cpu_to_le32(min_rr) },
+		.count = cpu_to_le32(3),
+	};
+	__le32 status = 0;
+	int ret;
+
+	lockdep_assert_held(&dcp->lock);
+	ret = dcp_m4_runtime_live(dcp->runtime);
+	if (ret)
+		return ret;
+	ret = dcp_m4_runtime_call(dcp->runtime, DCP_M4_SET_PARAMETER_METHOD, false,
+				  &param, sizeof(param), &status, sizeof(status));
+	dcp->vrr_calls++;
+	dcp->vrr_status = le32_to_cpu(status);
+	dev_info(dcp->dev, "adaptive sync minimum %u.%03u Hz: ret %d status %#x (panel_vrr_min_hz, testing)\n",
+		 min_rr >> 16, (u32)(((u64)(min_rr & 0xffff) * 1000) >> 16), ret,
+		 dcp->vrr_status);
+	return ret;
+}
+
+bool iomfb_m4_panel_vrr_requested(struct apple_dcp *owner)
+{
+	struct iomfb_m4 *dcp = iomfb_is_m4(owner) ? owner->v26_6 : NULL;
+
+	/* The internal panel only: an external T8132 output takes no VRR here. */
+	return dcp && !dcp->external && READ_ONCE(panel_vrr_min_hz);
+}
+
+/*
+ * Before a commit's present: VRR_ENABLED moves the adaptive-sync minimum of
+ * the live mode between panel_vrr_min_hz and the fixed 120 Hz, as the
+ * desktop 26.6 driver moves a ProMotion panel's (dcp_vrr_update()). Nothing
+ * is sent until a commit first asks for VRR. Swaps keep their timing words.
+ */
+void iomfb_m4_atomic_vrr(struct apple_dcp *owner, bool vrr_enabled)
+{
+	struct iomfb_m4 *dcp = owner->v26_6;
+	unsigned int hz = READ_ONCE(panel_vrr_min_hz);
+	u32 min;
+
+	if (!dcp || dcp->external || !hz)
+		return;
+	mutex_lock(&dcp->lock);
+	min = (vrr_enabled ? hz : DCP_M4_VRR_FIXED_HZ) << 16;
+	if ((dcp->vrr_min_sent || vrr_enabled) && min != dcp->vrr_min_sent &&
+	    dcp->runtime && !dcp->powered_off &&
+	    !dcp_m4_set_adaptive_sync(dcp, min))
+		dcp->vrr_min_sent = min;
+	mutex_unlock(&dcp->lock);
+}
+
 bool iomfb_m4_panel_edr_requested(struct apple_dcp *owner)
 {
 	return iomfb_is_m4(owner) && READ_ONCE(panel_edr);
@@ -5476,6 +5579,10 @@ static int iomfb_m4_status_show(struct seq_file *s, void *unused)
 			   r->health_top[2].index, DCP_M4_US(r->health_top[2].ns),
 			   r->health_hist[0], r->health_hist[1], r->health_hist[2],
 			   r->health_hist[3], r->health_hist[4]);
+	if (READ_ONCE(panel_vrr_min_hz))
+		seq_printf(s, "vrr min_hz=%u min_sent=%#x calls=%llu status=%#x\n",
+			   READ_ONCE(panel_vrr_min_hz), dcp->vrr_min_sent, dcp->vrr_calls,
+			   dcp->vrr_status);
 	if (READ_ONCE(panel_edr))
 		seq_printf(s, "edr capable=%u output=%u peak=%u ceiling=%u hm=%u sdr=%u sent=%u swaps=%llu\n",
 			   dcp->edr_capable, dcp->output_edr, dcp->panel_peak, dcp->edr_ceiling,
diff --git a/drivers/gpu/drm/apple/iomfb_m4.h b/drivers/gpu/drm/apple/iomfb_m4.h
index 058dc8887d..10401abe4c 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.h
+++ b/drivers/gpu/drm/apple/iomfb_m4.h
@@ -50,6 +50,9 @@ int iomfb_m4_panel_edid(struct apple_dcp *dcp, struct drm_connector *connector);
 /* EDR on the internal panel: opt-in (appledrm.panel_edr), see iomfb_m4.c. */
 bool iomfb_m4_panel_edr_requested(struct apple_dcp *dcp);
 bool iomfb_m4_panel_edr_capable(struct apple_dcp *dcp);
+/* VRR on the internal panel: experiment (appledrm.panel_vrr_min_hz). */
+bool iomfb_m4_panel_vrr_requested(struct apple_dcp *dcp);
+void iomfb_m4_atomic_vrr(struct apple_dcp *dcp, bool vrr_enabled);
 int iomfb_m4_atomic_check_hdr(struct apple_dcp *dcp, struct drm_crtc *crtc,
 			      struct drm_atomic_commit *commit);
 void iomfb_m4_atomic_hdr(struct apple_dcp *dcp, struct drm_crtc *crtc,
@@ -109,6 +112,8 @@ static inline int iomfb_m4_panel_edid(struct apple_dcp *dcp, struct drm_connecto
 }
 static inline bool iomfb_m4_panel_edr_requested(struct apple_dcp *dcp) { return false; }
 static inline bool iomfb_m4_panel_edr_capable(struct apple_dcp *dcp) { return false; }
+static inline bool iomfb_m4_panel_vrr_requested(struct apple_dcp *dcp) { return false; }
+static inline void iomfb_m4_atomic_vrr(struct apple_dcp *dcp, bool vrr_enabled) { }
 static inline int iomfb_m4_atomic_check_hdr(struct apple_dcp *dcp, struct drm_crtc *crtc,
 					    struct drm_atomic_commit *commit)
 {
