From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Mon, 2 Nov 2026 21:50:33 +1100
Subject: [PATCH] wifi: brcmfmac: preserve nonfatal regulatory error handling
 on resume

Keep failed country updates pending with their existing firmware
diagnostics, without returning the regulatory error from the wiphy
PM callback. A country not present in the firmware mapping must not
cause cfg80211 to shut down all interfaces on wake.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit cf86175fc9fad7d4186ee4ebcdc10487ea13a19c)
---
 drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c | 3 ++-
 tools/asahi/brcmf-suspend-tests.py                          | 4 +++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
index 2fe8111b1e..aa00d42248 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -4401,7 +4401,8 @@ static s32 brcmf_cfg80211_resume(struct wiphy *wiphy)
 		}
 	}
 	cfg->suspended = false;
-	return brcmf_cfg80211_update_country(cfg);
+	brcmf_cfg80211_update_country(cfg);
+	return 0;
 }
 
 static void brcmf_configure_wowl(struct brcmf_cfg80211_info *cfg,
diff --git a/tools/asahi/brcmf-suspend-tests.py b/tools/asahi/brcmf-suspend-tests.py
index c6a8489c03..dd0c2f7f77 100644
--- a/tools/asahi/brcmf-suspend-tests.py
+++ b/tools/asahi/brcmf-suspend-tests.py
@@ -218,7 +218,9 @@ for(int up=0;up<2;up++)for(int fail=0;fail<2;fail++) {
  assert(!brcmf_pcie_pm_enter_D3(&device));hint("AU");hint("GB");
  assert(!country_gets && cfg.country_pending);
  assert(!brcmf_pcie_pm_leave_D3(&device));failure=fail;
- assert(brcmf_cfg80211_resume(&wiphy)==(fail?-EIO:0));
+  /* A regulatory error keeps its retry and existing diagnostics; it must
+   * not make cfg80211 shut down every interface from the PM callback. */
+  assert(!brcmf_cfg80211_resume(&wiphy));
  assert(!cfg.suspended && cfg.country_pending==!!fail && country_gets==1);
  if(!fail)assert(!memcmp(applied,"GB",2));cases++;
 }
