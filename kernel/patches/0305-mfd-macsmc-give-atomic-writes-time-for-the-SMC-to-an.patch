From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sean Dolbec <sdolbec1@gmail.com>
Date: Sat, 7 Nov 2026 07:13:42 +0000
Subject: [PATCH] mfd: macsmc: give atomic writes time for the SMC to answer

Restart and power-off are issued as atomic SMC writes (MBSE = 'phra' /
'offw'). Since c243a5f85a ("mfd: macsmc: bound the atomic write poll"),
apple_smc_write_atomic() waits SMC_TIMEOUT_MS (500 ms) for the reply and,
with a command still pending, polls RTKit once and returns -EBUSY.

On the M4 Mac mini (J773g, T8132) that is sometimes too short for the
SMC: macsmc_restart() logs "Failed to issue MBSE = phra", the restart
chain falls through to apple_wdt_restart(), and iBoot takes the watchdog
reset as a crash (panicmedic-telemetry is set) and boots macOS instead of
the configured Linux startup volume.

Keep the bound that c243a5f85a introduced, but make it 5 s in the atomic
paths: wait that long for a pending earlier command before refusing, and
that long for the reply. Log replies slower than 100 ms, and failures,
so slow SMCs show up in the log.

Observed on the J773g: with the 500 ms bound a reboot from a test
initramfs landed in macOS (2026-11-02 23:12); with this change the same
path returned to Linux through the SMC (2026-11-03 10:59).

Fixes: c243a5f85a ("mfd: macsmc: bound the atomic write poll")
Signed-off-by: Sean Dolbec <sdolbec1@gmail.com>
(backported from commit 67c3100c82)
[j604: the 1.607 base has neither c243a5f85a nor the pending-command
 ownership that 67c3100c82 builds on: apple_smc_write_atomic() polled
 without any bound, with IRQs off. This brings drivers/mfd/macsmc.c to
 the file of 67c3100c82 (git show 67c3100c82:drivers/mfd/macsmc.c):
 the 5 s bound with the slow-reply log, an earlier pending command is
 waited for, a send failure releases the buffer, a mismatched reply
 keeps it owned, and probe initialises smc->lock (spin_lock_init, which
 the base lacked). No other file changes.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/mfd/macsmc.c | 53 +++++++++++++++++++++++++++++++++++++-------
 1 file changed, 45 insertions(+), 8 deletions(-)

diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
index fb9e1d7fa0..e88af94489 100644
--- a/drivers/mfd/macsmc.c
+++ b/drivers/mfd/macsmc.c
@@ -12,6 +12,8 @@
 #include <linux/device.h>
 #include <linux/io.h>
 #include <linux/ioport.h>
+#include <linux/iopoll.h>
+#include <linux/ktime.h>
 #include <linux/math.h>
 #include <linux/mfd/core.h>
 #include <linux/mfd/macsmc.h>
@@ -45,6 +47,8 @@
 #define SMC_RESULT			SMC_MSG
 
 #define SMC_TIMEOUT_MS		500
+/* Restart and power-off go through atomic writes; give the SMC time. */
+#define SMC_ATOMIC_TIMEOUT_MS	5000
 
 static const struct mfd_cell apple_smc_devs[] = {
 	MFD_CELL_NAME("macsmc-input"),
@@ -280,8 +284,10 @@ int apple_smc_write_atomic(struct apple_smc *smc, smc_key key, const void *buf,
 {
 	guard(spinlock_irqsave)(&smc->lock);
 	u8 result;
-	int ret;
+	int ret, poll_ret;
 	u64 msg;
+	ktime_t t0;
+	s64 us;
 
 	if (size > SMC_MAX_SIZE || size == 0)
 		return -EINVAL;
@@ -290,6 +296,23 @@ int apple_smc_write_atomic(struct apple_smc *smc, smc_key key, const void *buf,
 		return -EIO;
 	if (!smc->atomic_mode)
 		return -EIO;
+	/*
+	 * A poll timeout or a mismatched reply does not cancel the command or
+	 * release its SRAM. Its late reply does: take it if it has arrived.
+	 */
+	if (smc->atomic_pending) {
+		/* Wait for the earlier command's late reply instead of giving up. */
+		ret = read_poll_timeout_atomic(apple_rtkit_poll, poll_ret,
+					       poll_ret < 0 || !smc->atomic_pending,
+					       100, SMC_ATOMIC_TIMEOUT_MS * USEC_PER_MSEC,
+					       false, smc->rtk);
+		if (poll_ret < 0 || smc->atomic_pending) {
+			dev_err(smc->dev, "atomic: earlier command still pending (%d/%d)\n",
+				ret, poll_ret);
+			return -EBUSY;
+		}
+		dev_warn(smc->dev, "atomic: earlier command's reply arrived late\n");
+	}
 
 	memcpy_toio(smc->shmem.iomem, buf, size);
 	smc->msg_id = (smc->msg_id + 1) & 0xf;
@@ -301,20 +324,33 @@ int apple_smc_write_atomic(struct apple_smc *smc, smc_key key, const void *buf,
 
 	ret = apple_rtkit_send_message(smc->rtk, SMC_ENDPOINT, msg, NULL, true);
 	if (ret < 0) {
+		/* Never sent, so no reply will release the buffer. */
+		smc->atomic_pending = false;
 		dev_err(smc->dev, "Failed to send command (%d)\n", ret);
 		return ret;
 	}
 
-	while (smc->atomic_pending) {
-		ret = apple_rtkit_poll(smc->rtk);
-		if (ret < 0) {
-			dev_err(smc->dev, "RTKit poll failed (%llx)", msg);
-			return ret;
-		}
-		udelay(100);
+	t0 = ktime_get();
+	ret = read_poll_timeout_atomic(apple_rtkit_poll, poll_ret,
+				       poll_ret < 0 || !smc->atomic_pending,
+				       100, SMC_ATOMIC_TIMEOUT_MS * USEC_PER_MSEC,
+				       false, smc->rtk);
+	us = ktime_us_delta(ktime_get(), t0);
+	if (us > 100 * USEC_PER_MSEC || ret < 0 || smc->atomic_pending)
+		dev_warn(smc->dev, "atomic: key %p4ch reply after %lld us (ret %d)\n",
+			 &key, us, ret);
+	if (poll_ret < 0) {
+		dev_err(smc->dev, "RTKit poll failed (%llx)", msg);
+		return poll_ret;
+	}
+	if (ret < 0 || smc->atomic_pending) {
+		dev_err(smc->dev, "Atomic SMC command timed out (%llx)\n", msg);
+		return -ETIMEDOUT;
 	}
 
 	if (FIELD_GET(SMC_ID, smc->cmd_ret) != smc->msg_id) {
+		/* This response cannot resolve ownership of the published command. */
+		smc->atomic_pending = true;
 		dev_err(smc->dev, "Command sequence mismatch (expected %d, got %d)\n",
 			smc->msg_id, (unsigned int)FIELD_GET(SMC_ID, smc->cmd_ret));
 		return -EIO;
@@ -452,6 +488,7 @@ static int apple_smc_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	mutex_init(&smc->mutex);
+	spin_lock_init(&smc->lock);
 	smc->dev = &pdev->dev;
 	smc->sram_base = devm_platform_get_and_ioremap_resource(pdev, 1, &smc->sram);
 	if (IS_ERR(smc->sram_base))
