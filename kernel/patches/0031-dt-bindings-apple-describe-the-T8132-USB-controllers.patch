From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eryk Wieliczko <eryk@wieliczko.ninja>
Date: Sun, 18 Oct 2026 11:17:48 +0200
Subject: [PATCH] dt-bindings: apple: describe the T8132 USB controllers

Describe the M4 controller variants, board power ownership and retained input
handoff through the existing subsystem bindings.

Source-commit: 9251bffee1094e1c36b9f084546b828a7d2c768e
Source-snapshot: 9ffa1fbed1e052d9706ad3e13c8663bc8ffe3d8d
Assisted-by: LLM

[dylan: USB part only: apple,atcphy, apple,dwc3 and apple,sn201202x. The
 other 15 files of the commit conflict on this base and are not needed
 for the J604 USB nodes.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../devicetree/bindings/phy/apple,atcphy.yaml | 62 ++++++++++++++-----
 .../devicetree/bindings/usb/apple,dwc3.yaml   | 11 +++-
 .../bindings/usb/apple,sn201202x.yaml         | 57 +++++++++++++----
 3 files changed, 100 insertions(+), 30 deletions(-)

diff --git a/Documentation/devicetree/bindings/phy/apple,atcphy.yaml b/Documentation/devicetree/bindings/phy/apple,atcphy.yaml
index 3e36244ef4..dba9944f34 100644
--- a/Documentation/devicetree/bindings/phy/apple,atcphy.yaml
+++ b/Documentation/devicetree/bindings/phy/apple,atcphy.yaml
@@ -30,8 +30,48 @@ description: >
   second eUSB2 PHY register bank whose per-device defaults are also provided by
   the bootloader.
 
+  The T8132 variant provides only USB2 and its pipehandler, without the
+  SuperSpeed core or its associated register banks and tunables.
+
 allOf:
   - $ref: /schemas/usb/usb-switch.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8132-atcphy
+    then:
+      properties:
+        reg:
+          items:
+            - description: USB2 PHY specific controls
+            - description: USB3 PIPE interface controls
+        reg-names:
+          items:
+            - const: usb2phy
+            - const: pipehandler
+    else:
+      properties:
+        reg:
+          minItems: 5
+          items:
+            - description: Common controls for all PHYs (USB2/3/4, DisplayPort, TBT)
+            - description: DisplayPort Alternate Mode PHY specific controls
+            - description: Type-C PHY AXI to Apple Fabric interconnect controls
+            - description: USB2 PHY specific controls
+            - description: USB3 PIPE interface controls
+            - description: Secondary eUSB2 PHY register bank (T8140)
+        reg-names:
+          minItems: 5
+          items:
+            - const: core
+            - const: lpdptx
+            - const: axi2af
+            - const: usb2phy
+            - const: pipehandler
+            - const: usb2phy-reg
+      required:
+        - power-domains
   - if:
       properties:
         compatible:
@@ -82,28 +122,17 @@ properties:
               - apple,t8112-atcphy
           - const: apple,t8103-atcphy
       - const: apple,t8103-atcphy
+      - const: apple,t8132-atcphy
       - const: apple,t8140-atcphy
       - const: apple,t8142-atcphy
 
   reg:
-    minItems: 5
-    items:
-      - description: Common controls for all PHYs (USB2/3/4, DisplayPort, TBT)
-      - description: DisplayPort Alternate Mode PHY specific controls
-      - description: Type-C PHY AXI to Apple Fabric interconnect controls
-      - description: USB2 PHY specific controls
-      - description: USB3 PIPE interface controls
-      - description: Secondary eUSB2 PHY register bank (T8140)
+    minItems: 2
+    maxItems: 6
 
   reg-names:
-    minItems: 5
-    items:
-      - const: core
-      - const: lpdptx
-      - const: axi2af
-      - const: usb2phy
-      - const: pipehandler
-      - const: usb2phy-reg
+    minItems: 2
+    maxItems: 6
 
   "#phy-cells":
     const: 1
@@ -230,7 +259,6 @@ required:
   - "#reset-cells"
   - orientation-switch
   - mode-switch
-  - power-domains
   - ports
 
 additionalProperties: false
diff --git a/Documentation/devicetree/bindings/usb/apple,dwc3.yaml b/Documentation/devicetree/bindings/usb/apple,dwc3.yaml
index 9dc0adc535..7071ddbd1a 100644
--- a/Documentation/devicetree/bindings/usb/apple,dwc3.yaml
+++ b/Documentation/devicetree/bindings/usb/apple,dwc3.yaml
@@ -15,6 +15,15 @@ description:
 
 allOf:
   - $ref: snps,dwc3-common.yaml#
+  - if:
+      properties:
+        compatible:
+          not:
+            contains:
+              const: apple,t8132-dwc3
+    then:
+      required:
+        - power-domains
 
 properties:
   compatible:
@@ -28,6 +37,7 @@ properties:
               - apple,t8142-dwc3
           - const: apple,t8103-dwc3
       - const: apple,t8103-dwc3
+      - const: apple,t8132-dwc3
 
   reg:
     items:
@@ -58,7 +68,6 @@ required:
   - interrupts
   - iommus
   - resets
-  - power-domains
   - usb-role-switch
 
 unevaluatedProperties: false
diff --git a/Documentation/devicetree/bindings/usb/apple,sn201202x.yaml b/Documentation/devicetree/bindings/usb/apple,sn201202x.yaml
index 9b1a566fd1..88ee208e10 100644
--- a/Documentation/devicetree/bindings/usb/apple,sn201202x.yaml
+++ b/Documentation/devicetree/bindings/usb/apple,sn201202x.yaml
@@ -17,27 +17,27 @@ description: |
 
   The controller can be polled when interrupt resources are not supplied.
 
+  T8132 omits the register-selection interrupt, so selection is polled while
+  event, standby and wakeup notifications use interrupts.
+
 properties:
   compatible:
-    enum:
-      - apple,sn201202x
+    oneOf:
+      - const: apple,sn201202x
+      - items:
+          - const: apple,t8132-sn201202x
+          - const: apple,sn201202x
 
   reg:
     maxItems: 1
 
   interrupts:
-    items:
-      - description: Primary irq used for tps6598x events
-      - description: Logical register selection completed
-      - description: Standby command completed
-      - description: Wakeup command completed
+    minItems: 3
+    maxItems: 4
 
   interrupt-names:
-    items:
-      - const: irq
-      - const: select
-      - const: sleep
-      - const: wake
+    minItems: 3
+    maxItems: 4
 
   connector:
     $ref: /schemas/connector/usb-connector.yaml#
@@ -46,6 +46,39 @@ required:
   - compatible
   - reg
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8132-sn201202x
+    then:
+      properties:
+        interrupts:
+          items:
+            - description: Primary irq used for tps6598x events
+            - description: Standby command completed
+            - description: Wakeup command completed
+        interrupt-names:
+          items:
+            - const: irq
+            - const: sleep
+            - const: wake
+    else:
+      properties:
+        interrupts:
+          items:
+            - description: Primary irq used for tps6598x events
+            - description: Logical register selection completed
+            - description: Standby command completed
+            - description: Wakeup command completed
+        interrupt-names:
+          items:
+            - const: irq
+            - const: select
+            - const: sleep
+            - const: wake
+
 dependentRequired:
   interrupts: [interrupt-names]
   interrupt-names: [interrupts]
