From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Sun, 25 Oct 2026 20:20:13 -0400
Subject: [PATCH] drm/apple: m4: Carry out-of-band calls on stream 1

IOMFB 26.x takes setPowerState (A473) on the out-of-band channel, the
older contexts' +4, which the T8132 words carry as stream 1 (bit 10): the
AP packet goes at shared-memory offset 0x8000, the firmware answers on
the same stream, and the callbacks it makes meanwhile arrive at 0x68000
with bit 10 set. The J713 backend so far admitted stream 0 only.

Let a top-level AP call name stream 1, and while it is outstanding,
decode incoming words with bit 10 as stream-1 packets. Calls nested in
one of its callbacks stay on stream 1, at the next aligned offset after
the outstanding packet, as on stream 0. Stream-0 traffic is unchanged.
The first user is system sleep.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit d57301072438b66baa8a64a32f5af3d4f1623e1a)
[dylan: the tools/testing/selftests/drivers/gpu/apple-dcp/m4.py hunk is
 dropped: omacom does not carry that file, which aurora 4c254113bf
 ("selftests: apple: cover M4 graphics ownership and failure paths")
 adds.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/dcp-m4-protocol.h    | 26 +++++++++--
 drivers/gpu/drm/apple/dcp-m4-transaction.h | 50 +++++++++++++++++-----
 drivers/gpu/drm/apple/iomfb_m4.c           | 20 ++++++---
 3 files changed, 76 insertions(+), 20 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-m4-protocol.h b/drivers/gpu/drm/apple/dcp-m4-protocol.h
index 6fccff5625..3b5c8c2946 100644
--- a/drivers/gpu/drm/apple/dcp-m4-protocol.h
+++ b/drivers/gpu/drm/apple/dcp-m4-protocol.h
@@ -119,16 +119,36 @@ static inline int dcp_m4_decode_word_ext(u64 word, struct dcp_m4_packet *packet)
 	return 0;
 }
 
+/*
+ * While an AP call is outstanding on stream 1 (bit 10, the older contexts'
+ * out-of-band +4), its reply and callbacks come on stream 1 as well, besides
+ * any stream-0 traffic.
+ */
+static inline int dcp_m4_decode_word_oob(u64 word, struct dcp_m4_packet *packet)
+{
+	u8 stream = (word >> 10) & 3;
+	int ret;
+
+	if (!stream)
+		return dcp_m4_decode_word(word, packet);
+	if (stream != 1)
+		return -EPROTO;
+	ret = dcp_m4_decode_word(word & ~0x400ULL, packet);
+	if (!ret)
+		packet->stream = 1;
+	return ret;
+}
+
 /*
  * Replies require their pending request record, not a new packet location.
- * Only callbacks may name a nonzero stream (external profile); the internal
- * decoder never produces one.
+ * Callbacks may name a nonzero stream (external profile, or stream 1 during
+ * an out-of-band call); AP calls use stream 0, or stream 1 out of band.
  */
 static inline int dcp_m4_packet_offset(const struct dcp_m4_packet *packet, bool callback)
 {
 	unsigned int base;
 
-	if (packet->reply || (callback ? packet->stream >= 4 : packet->stream) ||
+	if (packet->reply || (callback ? packet->stream >= 4 : packet->stream > 1) ||
 	    (packet->callback_flag && (!callback || !packet->remote)) ||
 	    packet->offset % DCP_M4_ALIGNMENT ||
 	    packet->offset >= DCP_M4_STREAM_SIZE || packet->length < DCP_M4_PACKET_HEADER ||
diff --git a/drivers/gpu/drm/apple/dcp-m4-transaction.h b/drivers/gpu/drm/apple/dcp-m4-transaction.h
index 7736a7a50d..b9d4c25cdd 100644
--- a/drivers/gpu/drm/apple/dcp-m4-transaction.h
+++ b/drivers/gpu/drm/apple/dcp-m4-transaction.h
@@ -32,13 +32,16 @@ struct dcp_m4_transaction {
 	unsigned int callbacks;
 	int error;
 	bool external;	/* DCPEXT profile: streams 0..3 and any flagged callback route */
+	bool oob;	/* an AP call is outstanding on stream 1 */
 };
 
 static inline int dcp_m4_transaction_decode(const struct dcp_m4_transaction *state, u64 word,
 					    struct dcp_m4_packet *packet)
 {
-	return state->external ? dcp_m4_decode_word_ext(word, packet) :
-				 dcp_m4_decode_word(word, packet);
+	if (state->external)
+		return dcp_m4_decode_word_ext(word, packet);
+	return state->oob ? dcp_m4_decode_word_oob(word, packet) :
+			    dcp_m4_decode_word(word, packet);
 }
 
 static inline int dcp_m4_transaction_fail(struct dcp_m4_transaction *state, int error)
@@ -59,14 +62,15 @@ static inline bool dcp_m4_tag(u32 tag, u8 direction)
 }
 
 /* Prepare only; the caller publishes with its DMA barrier and mailbox send. */
-static inline int dcp_m4_call_begin(struct dcp_m4_transaction *state, void *rpc,
-				  size_t rpc_size, u32 tag, bool remote,
-				  const void *input, u32 input_size, u32 output_size,
-				  u64 *word)
+/* Stream 1 is out of band: top-level calls only, such as setPowerState. */
+static inline int dcp_m4_call_begin_stream(struct dcp_m4_transaction *state, void *rpc,
+					   size_t rpc_size, u32 tag, u8 stream, bool remote,
+					   const void *input, u32 input_size, u32 output_size,
+					   u64 *word)
 {
 	struct dcp_m4_packet packet = {
 		.tag = tag, .input_size = input_size, .output_size = output_size,
-		.remote = remote,
+		.remote = remote, .stream = stream,
 	};
 	const struct dcp_m4_packet *outer = NULL;
 	u8 *data;
@@ -77,6 +81,8 @@ static inline int dcp_m4_call_begin(struct dcp_m4_transaction *state, void *rpc,
 	if (!rpc || rpc_size != DCP_M4_RPC_SIZE || !word || (input_size && !input) ||
 	    !dcp_m4_tag(tag, 'A') || state->calls >= DCP_M4_CALL_DEPTH)
 		return dcp_m4_transaction_fail(state, -EINVAL);
+	if (stream > 1 || (stream && (state->calls || state->callbacks || state->external)))
+		return dcp_m4_transaction_fail(state, -EINVAL);
 	if (state->calls) {
 		struct dcp_m4_call *pending = &state->call[state->calls - 1];
 
@@ -88,9 +94,16 @@ static inline int dcp_m4_call_begin(struct dcp_m4_transaction *state, void *rpc,
 	if (state->callbacks &&
 	    remote != state->callback[state->callbacks - 1].packet.remote)
 		return dcp_m4_transaction_fail(state, -EPROTO);
-	/* AP calls use stream 0; a callback on another stream cannot recurse. */
-	if (state->callbacks && state->callback[state->callbacks - 1].packet.stream)
-		return dcp_m4_transaction_fail(state, -EOPNOTSUPP);
+	/*
+	 * AP calls use stream 0; a callback on another stream cannot recurse,
+	 * except that calls nested in an out-of-band callback stay out of band.
+	 */
+	if (state->callbacks && state->callback[state->callbacks - 1].packet.stream) {
+		if (!state->oob || state->callback[state->callbacks - 1].packet.stream != 1)
+			return dcp_m4_transaction_fail(state, -EOPNOTSUPP);
+		stream = 1;
+		packet.stream = stream;
+	}
 	ret = dcp_m4_packet_size(input_size, output_size, &packet.length);
 	if (ret)
 		return dcp_m4_transaction_fail(state, ret);
@@ -119,11 +132,22 @@ static inline int dcp_m4_call_begin(struct dcp_m4_transaction *state, void *rpc,
 	state->call[state->calls++] = (struct dcp_m4_call) {
 		.packet = packet, .callbacks = state->callbacks,
 	};
-	*word = 2 | (remote ? 0x100 : 0) | ((u64)packet.offset << 16) |
+	*word = 2 | (remote ? 0x100 : 0) | ((u64)stream << 10) | ((u64)packet.offset << 16) |
 		((u64)packet.length << 32);
+	if (stream)
+		state->oob = true;
 	return 0;
 }
 
+static inline int dcp_m4_call_begin(struct dcp_m4_transaction *state, void *rpc,
+				    size_t rpc_size, u32 tag, bool remote,
+				    const void *input, u32 input_size, u32 output_size,
+				    u64 *word)
+{
+	return dcp_m4_call_begin_stream(state, rpc, rpc_size, tag, 0, remote, input,
+					input_size, output_size, word);
+}
+
 /* Firmware may write output, but must not change the owned packet header. */
 static inline int dcp_m4_owned_packet(const void *rpc, const struct dcp_m4_packet *owned,
 				    bool callback)
@@ -160,6 +184,7 @@ static inline int dcp_m4_call_reply(struct dcp_m4_transaction *state, const void
 		return dcp_m4_transaction_fail(state, ret);
 	call = &state->call[state->calls - 1];
 	if (!reply.reply || reply.remote != call->packet.remote ||
+	    reply.stream != call->packet.stream ||
 	    state->callbacks != call->callbacks || output_size != call->packet.output_size ||
 	    (output_size && !output))
 		return dcp_m4_transaction_fail(state, -EPROTO);
@@ -169,6 +194,9 @@ static inline int dcp_m4_call_reply(struct dcp_m4_transaction *state, const void
 	if (output_size)
 		memcpy(output, (const u8 *)rpc + offset + DCP_M4_PACKET_HEADER +
 		       call->packet.input_size, output_size);
+	/* The out-of-band call itself, not a call nested in its callbacks. */
+	if (call->packet.stream && state->calls == 1)
+		state->oob = false;
 	state->calls--;
 	return 0;
 }
diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index ac68f00162..0940bb01a8 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -650,10 +650,10 @@ failed:
 	return ret;
 }
 
-static int dcp_m4_runtime_call(void *cookie, unsigned int method, bool remote,
-				const void *input, u32 input_size, void *output, u32 output_size)
+static int dcp_m4_runtime_call_stream(struct dcp_m4_runtime *r, unsigned int method,
+				      u8 stream, bool remote, const void *input,
+				      u32 input_size, void *output, u32 output_size)
 {
-	struct dcp_m4_runtime *r = cookie;
 	struct iomfb_m4 *dcp = r->dcp;
 	unsigned long previous = r->deadline;
 	struct dcp_m4_packet message;
@@ -671,8 +671,9 @@ static int dcp_m4_runtime_call(void *cookie, unsigned int method, bool remote,
 	}
 	tag = 'A' | (('0' + method / 100) << 8) |
 		(('0' + method / 10 % 10) << 16) | (('0' + method % 10) << 24);
-	ret = dcp_m4_call_begin(&dcp->transaction, dcp->rpc, DCP_M4_RPC_SIZE,
-			      tag, remote, input, input_size, output_size, &word);
+	ret = dcp_m4_call_begin_stream(&dcp->transaction, dcp->rpc, DCP_M4_RPC_SIZE,
+				       tag, stream, remote, input, input_size, output_size,
+				       &word);
 	if (!ret)
 		ret = dcp_m4_runtime_send(r, word);
 	while (!ret) {
@@ -680,7 +681,7 @@ static int dcp_m4_runtime_call(void *cookie, unsigned int method, bool remote,
 		if (ret)
 			break;
 		dma_rmb();
-		ret = dcp_m4_decode_word(word, &message);
+		ret = dcp_m4_transaction_decode(&dcp->transaction, word, &message);
 		if (ret) {
 			dcp_m4_runtime_bad_word(r, word, ret);
 			break;
@@ -702,6 +703,13 @@ finished:
 	return ret;
 }
 
+static int dcp_m4_runtime_call(void *cookie, unsigned int method, bool remote,
+			       const void *input, u32 input_size, void *output, u32 output_size)
+{
+	return dcp_m4_runtime_call_stream(cookie, method, 0, remote, input, input_size,
+					  output, output_size);
+}
+
 /* One bounded drain; a positive return asks the idle worker to reschedule. */
 static int dcp_m4_runtime_drain(struct dcp_m4_runtime *r, unsigned int budget)
 {
