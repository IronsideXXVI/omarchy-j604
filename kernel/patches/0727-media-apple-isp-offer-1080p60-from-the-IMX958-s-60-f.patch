From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 16:02:24 +0000
Subject: [PATCH] media: apple: isp: offer 1080p60 from the IMX958's 60
 fps mode on T8132

Of the 13 sensor configs the J604's IMX958 reports, 0, 7 and 12 are
single-exposure modes timed for 60 frames per second (line length times
frame length at the 1.02 GHz sensor clock), and the config table carries
each config's own rate limit in 8.8: 0x3c08 for config 7, 0x1e01 for
config 6. Config 7 reads the same 3040x2880 window as config 6, once
instead of twice. macOS streams this camera from config 6 only, at 30 at
most, and sends config 6's limit as MAX_FRAME_RATE_ALLOW (0x0167).

Add fps60, off by default. With it, the sizes of up to 1920x1080 that the
wide view's window serves (1920x1080, 1280x720, 640x480) also list 60
frames per second. Selecting it streams from config 7 with the same
window, and the stream sends config 7's limit as the channel's highest
allowed rate before the auto exposure limits; macos_stream_config sends
the selected config's limit instead of config 6's. A format without a 60
fps cut goes back to 30, as does a stream started at a size that has none.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 .../media/platform/apple/isp/isp-cam-test.c   | 118 ++++++++++++++++++
 drivers/media/platform/apple/isp/isp-cam.c    |  77 +++++++++++-
 drivers/media/platform/apple/isp/isp-cam.h    |   2 +
 drivers/media/platform/apple/isp/isp-drv.h    |   2 +
 drivers/media/platform/apple/isp/isp-v4l2.c   |  24 +++-
 5 files changed, 217 insertions(+), 6 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam-test.c b/drivers/media/platform/apple/isp/isp-cam-test.c
index 90dda2190b..7ece939f90 100644
--- a/drivers/media/platform/apple/isp/isp-cam-test.c
+++ b/drivers/media/platform/apple/isp/isp-cam-test.c
@@ -926,6 +926,121 @@ static void isp_test_macos_candidates_on(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, trace->word[i][1], 0);
 }
 
+static void isp_test_fps60_reset(void *unused)
+{
+	fps60 = false;
+}
+
+/* An IMX958 NV12 setup on hardware with config 6's wide view */
+static struct apple_isp *isp_test_fast_alloc(struct kunit *test, bool on)
+{
+	struct apple_isp *isp = isp_test_nv12_alloc(test, ISP_IMX958_2224_01);
+	struct apple_isp_hw *hw = kunit_kzalloc(test, sizeof(*hw), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, hw);
+	*hw = *isp->hw;
+	hw->imx958_wide_cfg6 = true;
+	isp->hw = hw;
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, isp_test_fps60_reset,
+							NULL), 0);
+	fps60 = on;
+	return isp;
+}
+
+/* Which sizes fps60 offers at 60, and none without it */
+static void isp_test_fast_sizes(struct kunit *test)
+{
+	static const struct {
+		struct coord dim;
+		unsigned int rate;
+	} sizes[] = {
+		{ { 1920, 1080 }, 60 }, { { 1280, 720 }, 60 }, { { 640, 480 }, 60 },
+		{ { 2560, 1440 }, 0 }, { { 1760, 1328 }, 0 }, { { 1552, 1552 }, 0 },
+		{ { 1328, 1760 }, 0 }, { { 1080, 1920 }, 0 },
+	};
+	struct apple_isp *isp = isp_test_fast_alloc(test, false);
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(sizes); i++)
+		KUNIT_EXPECT_EQ(test, apple_isp_fast_rate(isp, sizes[i].dim), 0);
+	fps60 = true;
+	for (unsigned int i = 0; i < ARRAY_SIZE(sizes); i++)
+		KUNIT_EXPECT_EQ_MSG(test, apple_isp_fast_rate(isp, sizes[i].dim),
+				    sizes[i].rate, "%ux%u", sizes[i].dim.x,
+				    sizes[i].dim.y);
+}
+
+/* 1080p60 streams from config 7 with the lens window's 16:9 crop */
+static void isp_test_fast_preset(struct kunit *test)
+{
+	static struct isp_preset p1080 = {
+		.index = 5, .input_dim = { 1920, 2160 },
+		.output_dim = { 1920, 1080 }, .crop_size = { 1920, 1080 },
+	};
+	static struct isp_preset p1440 = {
+		.index = 6, .input_dim = { 3040, 5760 },
+		.output_dim = { 2560, 1440 }, .crop_size = { 2560, 1440 },
+		.wide_only = true,
+	};
+	struct apple_isp *isp = isp_test_fast_alloc(test, true);
+
+	isp->frame_rate = 60;
+	isp_resolve_stream_preset(isp, &p1080);
+	KUNIT_EXPECT_EQ(test, isp->frame_rate, 60);
+	KUNIT_EXPECT_EQ(test, isp->stream_preset.index, 7);
+	KUNIT_EXPECT_EQ(test, isp->stream_preset.input_dim.x, 3040);
+	KUNIT_EXPECT_EQ(test, isp->stream_preset.input_dim.y, 2880);
+	KUNIT_EXPECT_EQ(test, isp->stream_preset.crop_offset.x, 176);
+	KUNIT_EXPECT_EQ(test, isp->stream_preset.crop_offset.y, 606);
+	KUNIT_EXPECT_EQ(test, isp->stream_preset.crop_size.x, 2688);
+	KUNIT_EXPECT_EQ(test, isp->stream_preset.crop_size.y, 1512);
+	KUNIT_EXPECT_EQ(test, isp->stream_preset.output_dim.x, 1920);
+	KUNIT_EXPECT_EQ(test, isp->stream_preset.max_rate, 0x3c08);
+
+	/* At 30 nothing changes: config 6, no rate limit sent */
+	isp->frame_rate = 30;
+	isp_resolve_stream_preset(isp, &p1080);
+	KUNIT_EXPECT_EQ(test, isp->stream_preset.index, 6);
+	KUNIT_EXPECT_EQ(test, isp->stream_preset.max_rate, 0);
+
+	/* A size without a 60 fps cut falls back to 30 */
+	isp->frame_rate = 60;
+	isp_resolve_stream_preset(isp, &p1440);
+	KUNIT_EXPECT_EQ(test, isp->frame_rate, 30);
+	KUNIT_EXPECT_EQ(test, isp->stream_preset.index, 6);
+}
+
+/* The 60 fps stream sends config 7's limit, then the AE rates */
+static void isp_test_fast_commands(struct kunit *test)
+{
+	struct apple_isp *isp = isp_test_fast_alloc(test, true);
+	struct isp_test_nv12_trace *trace;
+	int i;
+
+	trace = kunit_kzalloc(test, sizeof(*trace), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, trace);
+	test->priv = trace;
+	isp->frame_rate = 60;
+	KUNIT_ASSERT_TRUE(test, isp_cut_fast(isp, (struct coord){ 1920, 1080 },
+					     &isp->stream_preset));
+	KUNIT_EXPECT_EQ(test, isp_ch_configure_capture(isp, 0), 0);
+	i = isp_test_find(trace, 0x0167);
+	KUNIT_ASSERT_GE(test, i, 0);
+	KUNIT_EXPECT_EQ(test, trace->word[i][0], 0x3c08);
+	KUNIT_EXPECT_EQ(test, trace->opcode[i + 1], 0x0208);
+	KUNIT_EXPECT_EQ(test, trace->word[i + 1][0], 60 * 256);
+	KUNIT_EXPECT_LT(test, i, isp_test_find(trace, 0x0b0d));
+	i = isp_test_find(trace, 0x0107);
+	KUNIT_ASSERT_GE(test, i, 0);
+	KUNIT_EXPECT_EQ(test, trace->word[i][0], 7);
+
+	/* At 30 the limit is not sent */
+	memset(trace, 0, sizeof(*trace));
+	isp->frame_rate = 30;
+	isp->stream_preset.max_rate = 0;
+	KUNIT_EXPECT_EQ(test, isp_ch_configure_capture(isp, 0), 0);
+	KUNIT_EXPECT_LT(test, isp_test_find(trace, 0x0167), 0);
+}
+
 static struct kunit_case isp_cam_test_cases[] = {
 	KUNIT_CASE(isp_test_call_crop),
 	KUNIT_CASE(isp_test_call_crop_bounds),
@@ -948,6 +1063,9 @@ static struct kunit_case isp_cam_test_cases[] = {
 	KUNIT_CASE(isp_test_setfile_path),
 	KUNIT_CASE(isp_test_macos_candidates_off),
 	KUNIT_CASE(isp_test_macos_candidates_on),
+	KUNIT_CASE(isp_test_fast_sizes),
+	KUNIT_CASE(isp_test_fast_preset),
+	KUNIT_CASE(isp_test_fast_commands),
 	{}
 };
 
diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 563b53cba2..673f8dad07 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -918,6 +918,64 @@ static bool isp_cut_wide(const struct isp_preset *preset,
 	return isp_size_from_crop(isp_wide_window(), preset->output_dim, wide);
 }
 
+/*
+ * Of the IMX958's 13 sensor configs, 0, 7 and 12 are single-exposure modes
+ * timed for 60 frames per second: their line length times frame length at
+ * the 1.02 GHz sensor clock, and their own rate limit in the config table
+ * (0x3c08 for config 7, 60.03 in 8.8; 0x1e01 for config 6). Config 7 reads
+ * the same 3040x2880 window as config 6, once instead of twice. macOS
+ * streams this camera from config 6 only, at 30 at most, and sends config
+ * 6's limit as the channel's highest allowed rate.
+ *
+ * With fps60, the sizes of up to 1920x1080 that the wide view's window can
+ * serve are also offered at 60 frames per second, cut from config 7 with
+ * the same window, and the stream sends config 7's limit instead. Off by
+ * default: no other system streams this mode yet.
+ */
+static bool fps60;
+module_param(fps60, bool, 0644);
+MODULE_PARM_DESC(fps60,
+		 "T8132: offer 1920x1080, 1280x720 and 640x480 at 60 fps, from the sensor's 60 fps mode (default: off)");
+
+#define ISP_FRAME_RATE_FAST 60
+
+static const struct isp_preset isp_wide_fast_source = {
+	.index = 7,
+	.input_dim = { 3040, 2880 },
+	.crop_offset = { 0, 584 },
+	.crop_size = { 3040, 1710 },
+	.output_dim = { 1920, 1080 },
+	.max_rate = 0x3c08,
+};
+
+static const struct isp_preset isp_lens_fast_source = {
+	.index = 7,
+	.input_dim = { 3040, 2880 },
+	.crop_offset = { 176, 494 },
+	.crop_size = { 2688, 1738 },
+	.output_dim = { 1920, 1080 },
+	.max_rate = 0x3c08,
+};
+
+static bool isp_cut_fast(struct apple_isp *isp, struct coord dim,
+			 struct isp_preset *fast)
+{
+	const struct isp_preset *source = READ_ONCE(wide_window) == 1 ?
+		&isp_lens_fast_source : &isp_wide_fast_source;
+
+	if (!READ_ONCE(fps60) || !isp->hw->imx958_wide_cfg6 ||
+	    dim.x * dim.y > 1920 * 1080 || isp_desk_size(dim))
+		return false;
+	return isp_size_from_crop(source, dim, fast);
+}
+
+unsigned int apple_isp_fast_rate(struct apple_isp *isp, struct coord dim)
+{
+	struct isp_preset fast;
+
+	return isp_cut_fast(isp, dim, &fast) ? ISP_FRAME_RATE_FAST : 0;
+}
+
 /* The preset a stream starts with; with the wide view, from config 6. */
 static void isp_resolve_stream_preset(struct apple_isp *isp,
 				      const struct isp_preset *preset)
@@ -950,6 +1008,16 @@ static void isp_resolve_stream_preset(struct apple_isp *isp,
 		use_wide = true;
 	}
 
+	/* Above 30, a size that config 7 serves streams from it. */
+	if (isp->frame_rate > ISP_FRAME_RATE_DEFAULT) {
+		if (isp_cut_fast(isp, preset->output_dim, &wide)) {
+			isp->stream_preset = wide;
+			use_wide = true;
+		} else if (!READ_ONCE(isp->extra_frame_rate)) {
+			isp->frame_rate = ISP_FRAME_RATE_DEFAULT;
+		}
+	}
+
 	if (use_wide != isp->streamed_wide ||
 	    (use_wide && isp->stream_preset.crop_offset.x != isp->streamed_crop_x))
 		dev_info(isp->dev,
@@ -1450,7 +1518,7 @@ static void isp_ch_macos_stream_config(struct apple_isp *isp, u32 ch)
 				 ch, 1);
 	if (!err)
 		err = isp_cmd_ch_u32_set(isp, CISP_CMD_CH_MAX_FRAME_RATE_ALLOW,
-					 ch, 0x1e01);
+					 ch, isp->stream_preset.max_rate ?: 0x1e01);
 	if (!err)
 		err = isp_ch_u32x2_set(isp,
 				       CISP_CMD_APPLE_CH_CONTEXTSWITCH_ENABLE,
@@ -1795,6 +1863,13 @@ static int isp_ch_configure_frame_rate(struct apple_isp *isp, u32 ch)
 	if (v4l2_ctrl_g_ctrl(isp->exposure_priority))
 		min_rate = ISP_FRAME_RATE_MIN * ISP_FRAME_RATE_SCALE;
 
+	if (isp->stream_preset.max_rate) {
+		err = isp_cmd_ch_u32_set(isp, CISP_CMD_CH_MAX_FRAME_RATE_ALLOW,
+					 ch, isp->stream_preset.max_rate);
+		if (err)
+			return err;
+	}
+
 	err = isp_cmd_ch_ae_frame_rate_max_set(isp, ch, rate);
 	if (err)
 		return err;
diff --git a/drivers/media/platform/apple/isp/isp-cam.h b/drivers/media/platform/apple/isp/isp-cam.h
index abc8a702e8..a84d0fd73b 100644
--- a/drivers/media/platform/apple/isp/isp-cam.h
+++ b/drivers/media/platform/apple/isp/isp-cam.h
@@ -17,6 +17,8 @@ int apple_isp_detect_camera(struct apple_isp *isp);
 int apple_isp_add_early_call_sizes(struct apple_isp *isp);
 
 bool apple_isp_wide_view(struct apple_isp *isp);
+/* The faster rate a size may stream at, frames per second; 0: none */
+unsigned int apple_isp_fast_rate(struct apple_isp *isp, struct coord dim);
 bool apple_isp_preset_offered(struct apple_isp *isp,
 			      const struct isp_preset *preset);
 int apple_isp_add_wide_presets(struct apple_isp *isp);
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 33a87f0e7d..1899e2a842 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -165,6 +165,8 @@ struct isp_preset {
 	bool wide_only;
 	/* Cut from the tall portrait window (offered with the wide view). */
 	bool tall;
+	/* The sensor config's own rate limit, fps in 8.8; 0: not sent */
+	u16 max_rate;
 };
 
 struct ane_isp_link;
diff --git a/drivers/media/platform/apple/isp/isp-v4l2.c b/drivers/media/platform/apple/isp/isp-v4l2.c
index 1e7dfe5abe..6715d45387 100644
--- a/drivers/media/platform/apple/isp/isp-v4l2.c
+++ b/drivers/media/platform/apple/isp/isp-v4l2.c
@@ -44,6 +44,12 @@ static unsigned int isp_extra_rate(struct apple_isp *isp)
 	return rate > ISP_FRAME_RATE_DEFAULT && rate <= 120 ? rate : 0;
 }
 
+/* The rate offered above the standard list for a size: the lab's, else 60. */
+static unsigned int isp_size_extra_rate(struct apple_isp *isp, struct coord dim)
+{
+	return isp_extra_rate(isp) ?: apple_isp_fast_rate(isp, dim);
+}
+
 static unsigned int isp_num_rates(unsigned int extra)
 {
 	return ARRAY_SIZE(isp_frame_rates) + !!extra;
@@ -907,12 +913,9 @@ static int isp_vidioc_enum_frameintervals(struct file *file, void *fh,
 					  struct v4l2_frmivalenum *interval)
 {
 	struct apple_isp *isp = video_drvdata(file);
-	unsigned int extra = isp_extra_rate(isp);
+	unsigned int extra;
 	int i;
 
-	if (interval->index >= isp_num_rates(extra))
-		return -EINVAL;
-
 	if (interval->pixel_format != V4L2_PIX_FMT_NV12 &&
 	    !(interval->pixel_format == V4L2_PIX_FMT_P010 && isp_has_p010(isp)))
 		return -EINVAL;
@@ -929,6 +932,10 @@ static int isp_vidioc_enum_frameintervals(struct file *file, void *fh,
 	if (i == isp->num_presets)
 		return -EINVAL;
 
+	extra = isp_size_extra_rate(isp, isp->presets[i].output_dim);
+	if (interval->index >= isp_num_rates(extra))
+		return -EINVAL;
+
 	interval->type = V4L2_FRMIVAL_TYPE_DISCRETE;
 	interval->discrete.numerator = 1;
 	interval->discrete.denominator = isp_rate(extra, interval->index);
@@ -1008,6 +1015,11 @@ static int isp_vidioc_set_format(struct file *file, void *fh,
 
 	isp_get_sp_pix_format(isp, f, fmt);
 
+	/* A rate above 30 holds only for the sizes that offer it. */
+	if (isp->frame_rate > ISP_FRAME_RATE_DEFAULT &&
+	    isp->frame_rate != isp_size_extra_rate(isp, preset->output_dim))
+		isp->frame_rate = ISP_FRAME_RATE_DEFAULT;
+
 	isp->vbq.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
 	isp_vb2_set_min_buffers(isp);
 
@@ -1080,6 +1092,8 @@ static int isp_vidioc_set_param(struct file *file, void *fh,
 {
 	struct apple_isp *isp = video_drvdata(file);
 	struct v4l2_fract *tpf = &a->parm.capture.timeperframe;
+	struct coord dim = isp_get_current_format(isp)->preset->output_dim;
+	unsigned int extra = isp_size_extra_rate(isp, dim);
 
 	if (a->type != V4L2_BUF_TYPE_VIDEO_CAPTURE)
 		return -EINVAL;
@@ -1092,7 +1106,7 @@ static int isp_vidioc_set_param(struct file *file, void *fh,
 	if (!tpf->numerator || !tpf->denominator)
 		isp->frame_rate = ISP_FRAME_RATE_DEFAULT;
 	else
-		isp->frame_rate = isp_closest_frame_rate(tpf, isp_extra_rate(isp));
+		isp->frame_rate = isp_closest_frame_rate(tpf, extra);
 
 	a->parm.capture.capability = V4L2_CAP_TIMEPERFRAME;
 	a->parm.capture.readbuffers = 0;
-- 
