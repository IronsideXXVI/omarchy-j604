From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 08:11:02 -0500
Subject: [PATCH] drm/apple: park a Type-C display route's crossbar for a deep
 sleep

On T8140 the display crossbar sits in the ATC block that the sleep's
commit powers off. The mux core still holds the route's selection after
the wake and skips selecting it again, so a display kept attached would
come back on a crossbar with its reset values.

Add dcp_typec_route_park() and dcp_typec_route_unpark(). Parking takes a
direct route's output down while it still has power, as releasing a
display does, and unparking selects it again after the wake: the same
teardown and setup an unplug before a sleep and a plug after it go
through. The route, its owner and the connector stay as they are. A route
released while parked has nothing held to give back, and one that could
not be selected again is marked so.

A crashed DCPEXT, which goes into the sleep without its A500, has its
route parked the same way.

Signed-off-by: Diljit Singh <hey@djdev.me>

Assisted-by: Claude:claude-opus-5.5

---
 drivers/gpu/drm/apple/dcp-fabric.c | 54 +++++++++++++++++++++++++++++-
 drivers/gpu/drm/apple/dcp-fabric.h |  4 +++
 drivers/gpu/drm/apple/dcp.c        |  3 +-
 3 files changed, 59 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-fabric.c b/drivers/gpu/drm/apple/dcp-fabric.c
index 4168ce54f1..7e2c5a0d7f 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.c
+++ b/drivers/gpu/drm/apple/dcp-fabric.c
@@ -592,6 +592,7 @@ static int dcp_typec_route_activate(struct apple_dcp_typec_route *route,
 	scoped_guard(mutex, &dcp->tb_lock) {
 		route->deactivate_xbar_done = false;
 		route->deactivate_error = 0;
+		route->sleep_parked = false;
 		route->active_xbar = xbar;
 		route->tunnel = xbar != route->xbar;
 		route->xbar_up = !route->tunnel;
@@ -639,7 +640,10 @@ static int dcp_typec_route_deactivate(struct apple_dcp_typec_route *route)
 			return route->deactivate_error;
 		if (!route->deactivate_xbar_done) {
 			dcp_typec_route_phy_off(route);
-			if (!route->tunnel || route->xbar_up)
+			/* Parked for a sleep, its output is already down and not held. */
+			if (route->sleep_parked)
+				ret = 0;
+			else if (!route->tunnel || route->xbar_up)
 				ret = mux_control_deselect(route->active_xbar ?: route->xbar);
 			else
 				ret = dcp_dpxbar_preselect(route->active_xbar, MUX_IDLE_DISCONNECT);
@@ -653,6 +657,7 @@ static int dcp_typec_route_deactivate(struct apple_dcp_typec_route *route)
 				ret = 0;
 			/* Deselect always unlocks: never consume that selection twice. */
 			route->deactivate_xbar_done = true;
+			route->sleep_parked = false;
 			route->xbar_up = false;
 			if (ret) {
 				/* Idle is unproven; retain the owner and the real error. */
@@ -4289,6 +4294,53 @@ int dcp_register_typec_routes(struct apple_dcp *dcp)
 	return dcp_fabric_run_probe(!!routes, dcp_register_typec_routes_present, &ctx);
 }
 
+/*
+ * A sleep that reaches its commit powers the crossbar off. Take the output of a direct
+ * route down while it still has power, as a released display's is, and select it again
+ * after the wake. The route stays, and with it the display on the port.
+ */
+void dcp_typec_route_park(struct apple_dcp *dcp)
+{
+	struct apple_dcp_typec_route *route;
+	int ret;
+
+	guard(mutex)(&dcp_typec_fabric_lock);
+	route = dcp->active_typec_route;
+	if (!route || route->tunnel || !route->selected)
+		return;
+	guard(mutex)(&dcp->tb_lock);
+	if (route->deactivate_xbar_done || route->sleep_parked)
+		return;
+	/* Deselect always unlocks. */
+	ret = mux_control_deselect(route->active_xbar ?: route->xbar);
+	route->sleep_parked = true;
+	dev_dbg(dcp->dev, "display route parked for the sleep: crossbar output down: %d\n", ret);
+}
+
+void dcp_typec_route_unpark(struct apple_dcp *dcp)
+{
+	struct apple_dcp_typec_route *route;
+	int ret;
+
+	guard(mutex)(&dcp_typec_fabric_lock);
+	route = dcp->active_typec_route;
+	if (!route)
+		return;
+	guard(mutex)(&dcp->tb_lock);
+	if (!route->sleep_parked)
+		return;
+	route->sleep_parked = false;
+	ret = mux_control_try_select(route->active_xbar ?: route->xbar, route->mux_index);
+	if (ret) {
+		/* Nothing is held, so the route's release has nothing to give back. */
+		route->deactivate_xbar_done = true;
+		dev_err(dcp->dev, "display route not back after the sleep: crossbar output: %d\n",
+			ret);
+		return;
+	}
+	dev_dbg(dcp->dev, "display route back after the sleep: crossbar output up\n");
+}
+
 /*
  * A hybrid let go while its HDMI port was empty was parked on a Type-C PHY
  * (see dcp_typec_route_deactivate()).  Point it at the HDMI output again
diff --git a/drivers/gpu/drm/apple/dcp-fabric.h b/drivers/gpu/drm/apple/dcp-fabric.h
index 808d3aee25..86726b095f 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.h
+++ b/drivers/gpu/drm/apple/dcp-fabric.h
@@ -51,6 +51,8 @@ struct apple_dcp_typec_route {
 	/* Lower mux release is consumed even when idle programming fails. */
 	bool deactivate_xbar_done;
 	int deactivate_error;
+	/* Its crossbar output is down for a sleep, and not held. */
+	bool sleep_parked;
 };
 
 int dcp_typec_phy_on(struct apple_dcp *dcp);
@@ -111,6 +113,8 @@ bool dcp_is_t8132_ext(const struct apple_dcp *dcp);
 
 /* DCP probe, resume and endpoint teardown hooks. */
 int dcp_register_typec_routes(struct apple_dcp *dcp);
+void dcp_typec_route_park(struct apple_dcp *dcp);
+void dcp_typec_route_unpark(struct apple_dcp *dcp);
 void dcp_typec_routes_disable(struct apple_dcp *dcp);
 void dcp_typec_routes_disable_dev(struct device *dev);
 void dcp_typec_retrain_work(struct work_struct *work);
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index e558d3aed3..667ece8c2e 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -7541,9 +7541,10 @@ static int dcp_s2r_ext_suspend(struct apple_dcp *dcp)
 		return 0;
 	}
 
-	/* No A500 and no disconnect: the link just goes down. */
+	/* No A500 and no disconnect: the link and its crossbar output just go down. */
 	if (dcp_s2r_stops_crashed(dcp)) {
 		dcp_disable_typec_work(dcp, false);
+		dcp_typec_route_park(dcp);
 		return dcp_s2r_stop_crashed(dcp);
 	}
 	if (READ_ONCE(dcp->crashed) || IS_ERR_OR_NULL(dcp->rtk))
