 		 2 * mcc->nr_planes * (unsigned int)ARRAY_SIZE(apple_mcc_t8132_ctrr));
 }
 
+#include "mcc-t8132-entry.h"
+
+/*
+ * Test switch: before allocation is enabled, write the AMCC plane-enable and stage words
+ * macOS's kernel writes right after it starts (mcc-t8132-entry.h), in its order, through
+ * the apertures probe has mapped. Nothing outside them is mapped, read or written.
+ * Default N: nothing is written.
+ */
+static bool t8132_entry_replay;
+module_param(t8132_entry_replay, bool, 0444);
+MODULE_PARM_DESC(t8132_entry_replay,
+		 "T8132: replay macOS's AMCC plane-enable and stage words at probe (default: N)");
+
+static void apple_mcc_replay_t8132(struct platform_device *pdev, struct apple_mcc *mcc)
+{
+	unsigned int i, done = 0, skipped = 0;
+	struct resource *res[2];
+
+	for (i = 0; i < 2; i++) {
+		res[i] = platform_get_resource(pdev, IORESOURCE_MEM, i);
+		if (!res[i])
+			return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(mcc_t8132_entry_seq); i++) {
+		const struct mcc_t8132_entry_write *w = &mcc_t8132_entry_seq[i];
+		unsigned int p = w->pa >= res[1]->start;
+		u64 off = w->pa - res[p]->start;
+
+		if (w->pa < res[p]->start || off + w->width > resource_size(res[p])) {
+			skipped++;
+			continue;
+		}
+		if (w->width == 8)
+			writeq(w->value, mcc->planes[p] + off);
+		else
+			writel(w->value, mcc->planes[p] + off);
+		udelay(1);
+		done++;
+	}
+	dev_info(mcc->dev, "t8132: replayed %u of macOS's entry words, %u skipped\n",
+		 done, skipped);
+}
+
 static int apple_mcc_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -283,6 +328,8 @@ static int apple_mcc_probe(struct platform_device *pdev)
 		return ret;
 	if (mcc->retained && mcc->nr_planes == 2)
 		apple_mcc_log_locks_t8132(mcc);
+	if (mcc->retained && mcc->nr_planes == 2 && t8132_entry_replay)
+		apple_mcc_replay_t8132(pdev, mcc);
 
 	platform_set_drvdata(pdev, mcc);
 
