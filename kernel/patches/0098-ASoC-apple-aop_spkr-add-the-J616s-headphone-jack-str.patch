+            capture: stream(c_str!("JACK RX"), PLAYBACK_FORMATS, HEADSET_CHANNELS),
+            ..Default::default()
+        },
+    ];
+    // Both directions share the serializer's frame.
+    dais[2].set_symmetric_rate(1);
