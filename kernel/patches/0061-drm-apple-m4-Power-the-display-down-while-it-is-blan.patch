From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Mon, 26 Oct 2026 17:20:53 -0400
Subject: [PATCH] drm/apple: m4: Power the display down while it is blanked

With DPMS off, the J713 display was only blanked: the swap to no
surface stops presenting, but the display pipeline stays powered. A
blanked panel is the state in which system sleep powers the display
down with setPowerState(0), and the same works here.

After a successful blank, power the display down, and power it back up
with setPowerState(1) before the next present, so the first frame after
DPMS on brings the panel back. System sleep with the display already
down leaves it down and skips its own setPowerState(0); after resume the
next present powers it up. A refused transition fails the session, as
in system sleep. debugfs reports whether the display is down, how often
it went down, and how long the last and longest power-down and power-up
took.

On the J713, idle on battery with the backlight off, DPMS off saved
346 mW before this change (3.04 -> 2.69 W) and saves 1.20 W with it
(2.93 -> 1.73 W), each measured within one run. Over 200 blank/wake
cycles, power-down took 128-132 ms and power-up 55-56 ms.

Signed-off-by: Erik Bourget <erik@ebourget.net>
[eryk: a blank that finds the display already blanked and powered down
 returns without a swap, which would otherwise reach the powered-down
 pipeline when a CRTC-only commit turned the CRTC on and off again]
Signed-off-by: Eryk Wieliczko <eryk@wieliczko.ninja>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit aec96e5158bcf357944ede683500ef837bd4c643)
[dylan: the tools/testing/selftests/drivers/gpu/apple-dcp/m4.py hunk is
 dropped: omacom does not carry that file, which aurora 4c254113bf
 ("selftests: apple: cover M4 graphics ownership and failure paths")
 adds.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/iomfb_m4.c | 49 ++++++++++++++++++++++++++++++--
 1 file changed, 47 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index f30610ee88..e10424923c 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -20,6 +20,8 @@
 #include <linux/seq_file.h>
 #include <linux/crc32.h>
 #include <linux/jiffies.h>
+#include <linux/ktime.h>
+#include <linux/minmax.h>
 #include <linux/workqueue.h>
 #include <drm/drm_framebuffer.h>
 #include <drm/drm_modes.h>
@@ -70,6 +72,9 @@ struct iomfb_m4 {
 	int error;
 	bool started, init_sent, ready, startup_started;
 	bool powered_off; /* setPowerState(0) for system sleep */
+	bool display_off; /* setPowerState(0) while blanked, until the next frame */
+	u64 display_off_cycles;
+	s64 display_off_us, display_off_us_max, display_on_us, display_on_us_max;
 	/* Exact completed successor or blank is the only framebuffer retirement. */
 	struct drm_framebuffer *active_fb;
 	struct drm_framebuffer *uncertain_fb;
@@ -78,6 +83,7 @@ struct iomfb_m4 {
 };
 
 static void dcp_m4_runtime_wake(struct iomfb_m4 *dcp);
+static int dcp_m4_set_power_state(struct iomfb_m4 *dcp, bool on);
 static void dcp_m4_runtime_receive(struct iomfb_m4 *dcp, u64 word);
 
 static int dcp_m4_dart_check(struct device *dev)
@@ -1298,6 +1304,18 @@ int iomfb_m4_present(struct apple_dcp *owner, struct drm_framebuffer *fb,
 		ret = -EAGAIN;
 	if (!ret)
 		ret = iomfb_m4_check_frame(&frame);
+	/* The first frame after a blank powers the display back up. */
+	if (!ret && dcp->display_off) {
+		ktime_t start = ktime_get();
+
+		ret = dcp_m4_set_power_state(dcp, true);
+		if (!ret) {
+			dcp->display_off = false;
+			dcp->display_on_us = ktime_us_delta(ktime_get(), start);
+			dcp->display_on_us_max = max(dcp->display_on_us,
+						     dcp->display_on_us_max);
+		}
+	}
 	if (ret)
 		goto out;
 	/* Keep the source before the first work descriptor can become visible. */
@@ -1330,6 +1348,11 @@ int iomfb_m4_blank(struct apple_dcp *owner)
 		return -ENODEV;
 	mutex_lock(&dcp->lock);
 	ret = dcp_m4_runtime_live(dcp->runtime);
+	/* Already blanked and powered down: nothing to swap or power down */
+	if (!ret && dcp->display_off && !dcp->active_frame.dva) {
+		mutex_unlock(&dcp->lock);
+		return 0;
+	}
 	if (!ret)
 		ret = iomfb_m4_swap(dcp, NULL);
 	if (ret) {
@@ -1339,6 +1362,21 @@ int iomfb_m4_blank(struct apple_dcp *owner)
 		dcp->active_fb = NULL;
 		memset(&dcp->active_frame, 0, sizeof(dcp->active_frame));
 		dcp->blanks++;
+		/*
+		 * Nothing is scanned out until the next frame: power the display
+		 * down as system sleep does. A refusal fails the session, as there.
+		 */
+		if (!dcp->display_off) {
+			ktime_t start = ktime_get();
+
+			if (!dcp_m4_set_power_state(dcp, false)) {
+				dcp->display_off = true;
+				dcp->display_off_cycles++;
+				dcp->display_off_us = ktime_us_delta(ktime_get(), start);
+				dcp->display_off_us_max = max(dcp->display_off_us,
+							      dcp->display_off_us_max);
+			}
+		}
 	}
 	mutex_unlock(&dcp->lock);
 	if (retire)
@@ -1394,11 +1432,14 @@ int iomfb_m4_suspend(struct apple_dcp *owner)
 	if (dcp->active_fb || dcp->active_frame.dva) {
 		dev_warn(dcp->dev, "panel still scanning out: refusing system sleep\n");
 		ret = -EBUSY;
+	} else if (dcp->display_off) {
+		/* Already powered down by the blank; the next frame powers it up. */
+		ret = 0;
 	} else {
 		ret = dcp_m4_set_power_state(dcp, false);
+		if (!ret)
+			dcp->powered_off = true;
 	}
-	if (!ret)
-		dcp->powered_off = true;
 	mutex_unlock(&dcp->lock);
 	return ret;
 }
@@ -1500,6 +1541,10 @@ static int iomfb_m4_status_show(struct seq_file *s, void *unused)
 	seq_printf(s, "flips=%llu blanks=%llu backlight_swaps=%llu active=%u uncertain=%u\n",
 		   dcp->flips, dcp->blanks, dcp->brightness_swaps,
 		   !!dcp->active_fb, !!dcp->uncertain_fb);
+	seq_printf(s, "display_off=%u off_cycles=%llu off_us=%lld/%lld on_us=%lld/%lld\n",
+		   dcp->display_off, dcp->display_off_cycles,
+		   dcp->display_off_us, dcp->display_off_us_max,
+		   dcp->display_on_us, dcp->display_on_us_max);
 	mutex_unlock(&dcp->lock);
 	return 0;
 }
