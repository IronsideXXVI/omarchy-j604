From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Mon, 9 Nov 2026 14:45:02 -0500
Subject: [PATCH] soc: apple: resolve radio PERST through the sleep
 controller's PCIe host

Use the apple,apcie phandle instead of searching for a T8140-compatible
controller. This allows the shared sleep path to assert J713 radio PERST
before removing the native PCIe clocks.

Signed-off-by: Erik Bourget <erik@ebourget.net>
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 67e2371a3683616885fdbc45216c9eef56054c4d)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/sleep.c | 7 +------
 1 file changed, 1 insertion(+), 6 deletions(-)

diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index 21d69b5697..f1b337431e 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -487,8 +487,6 @@ struct apple_sleep_soc {
 	unsigned int nwake_names;
 	/* The sources in the wake block's last word */
 	u32 wake_last_word;
-	/* The PCIe host whose port the radio is on, for its PERST#, or NULL */
-	const char *radio_pcie;
 	/* The encoders' system power words: their domains need the AVE complex up */
 	const u32 *ave_domains;
 	unsigned int nave_domains;
@@ -3930,9 +3928,7 @@ static void apple_sleep_find_radio_perst(struct apple_sleep *s, struct device_no
 	struct device_node *host, *port;
 	struct of_phandle_args args;
 
-	if (!s->soc->radio_pcie)
-		return;
-	host = of_find_compatible_node(NULL, NULL, s->soc->radio_pcie);
+	host = of_parse_phandle(s->dev->of_node, "apple,apcie", 0);
 	if (!host)
 		return;
 	if (of_device_is_available(host)) {
@@ -4307,7 +4303,6 @@ static const struct apple_sleep_soc t8140_sleep_soc = {
 	.nwake_names = ARRAY_SIZE(t8140_wake_names),
 	/* 21 sources. Measured: macOS reads 0x001fef77 there. */
 	.wake_last_word = GENMASK(20, 0),
-	.radio_pcie = "apple,t8140-pcie",
 	.ave_domains = t8140_ave_domains,
 	.nave_domains = ARRAY_SIZE(t8140_ave_domains),
 	.ave_pmc = "apple,t8140-pmc",
-- 
