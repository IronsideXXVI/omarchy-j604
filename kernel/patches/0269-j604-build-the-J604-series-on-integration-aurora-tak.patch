-// SPDX-License-Identifier: GPL-2.0-only
-/*
- * Apple lossless compressed 8-bit 4:2:0 surfaces (see ave-cmp420.h).
- *
- * A surface is four regions: Y bodies, Y metadata, CbCr bodies, CbCr
- * metadata. Bodies are row-major storage tiles: 32x32 luma samples in 1024
- * bytes with 32 metadata bytes, 16x16 CbCr pairs in 512 bytes with 8
- * metadata bytes. The metadata of tile (tx, ty) sits at a Morton slot of a
- * square grid of at least 64x64 slots. A tile is a raster of 8x4-sample
- * blocks (CbCr: pairs), one metadata byte each; inside a block the samples
- * interleave x0 y0 x1 y1 x2. A block's payload starts where the previous
- * one of the tile ends. Raw blocks (Y 0x1f, CbCr 0x3f) carry the samples
- * as they are, solid blocks (Y 0x60, CbCr 0x01) one sample (pair) for all
- * 32.
- *
- * The writer marks every block raw, so its output is a lossless surface
- * with no compression. The reader decodes raw and solid blocks and the
- * coded forms the MCTF writes: luma modes 0, 1, 4 and 5 and CbCr blocks
- * with direct, neighbour or constant prediction per component. Any other
- * block is counted and filled with a marker. Luma blocks other than mode 7
- * and every CbCr block carry their size in the metadata byte, so the reader
- * keeps its place after an unknown block of those kinds.
- *
- * Copyright The Aurora Silicon Contributors
- */
-#include <linux/bitfield.h>
-#include <linux/errno.h>
-#include <linux/kernel.h>
-#include <linux/minmax.h>
-#include <linux/string.h>
-#include <linux/unaligned.h>
-
-#include "ave-cmp420.h"
-
-#define AVE_CMP420_CTILE	16	/* compression tile, samples */
-#define AVE_CMP420_BLOCK	32	/* samples per metadata byte */
-
-#define SEEN_RAW	BIT(0)
-#define SEEN_SOLID	BIT(1)
-#define SEEN_OTHER	BIT(2)
-
-/* Spread the low 8 bits of @v to the even bits */
-static inline u32 ave_cmp420_spread(u32 v)
-{
-	v &= 0xff;
-	v = (v | (v << 4)) & 0x0f0f;
-	v = (v | (v << 2)) & 0x3333;
-	v = (v | (v << 1)) & 0x5555;
-	return v;
-}
-
-/*
- * Metadata is not row-major: the metadata of storage tile (tx, ty) sits at
- * slot M(tx, ty) of a square, power-of-two grid, with the tx bits on the
- * even bit positions and the ty bits on the odd ones.
- */
-static inline u32 ave_cmp420_meta_slot(u32 tx, u32 ty)
-{
-	return ave_cmp420_spread(tx) | ave_cmp420_spread(ty) << 1;
-}
-
-/*
- * Sample index inside a storage tile, split into its x and y parts. A tile
- * is a raster of 8x4 blocks (four across in luma, two in CbCr); inside a
- * block, the index bits are x0 y0 x1 y1 x2. Luma index bits: x0 y0 x1 y1
- * x2 x3 x4 y2 y3 y4; CbCr: x0 y0 x1 y1 x2 x3 y2 y3.
- */
-static inline u32 ave_cmp420_xbits(u32 x)
-{
-	return (x & 1) | (x & 2) << 1 | (x & ~3u) << 2;
-}
-
-static inline u32 ave_cmp420_y_ybits(u32 y)
-{
-	return (y & 1) << 1 | (y & 2) << 2 | (y & ~3u) << 5;
-}
-
-static inline u32 ave_cmp420_c_ybits(u32 y)
-{
-	return (y & 1) << 1 | (y & 2) << 2 | (y & ~3u) << 4;
-}
-
-int ave_cmp420_geom(struct ave_cmp420_geom *g, u32 width, u32 height)
-{
-	u32 cols, rows;
-
-	if (!width || !height || width % 2 || height % 2 ||
-	    width > 8192 || height > 8192)
-		return -EINVAL;
-	g->width = width;
-	g->height = height;
-	g->tiles_x = DIV_ROUND_UP(width, AVE_CMP420_Y_TILE);
-	g->tiles_y = DIV_ROUND_UP(height, AVE_CMP420_Y_TILE);
-	/* Morton slots of 8 bits per axis at most (ave_cmp420_spread()) */
-	if (g->tiles_x > 256 || g->tiles_y > 256)
-		return -EINVAL;
-	cols = roundup_pow_of_two(max3(g->tiles_x, g->tiles_y,
-				       (u32)AVE_CMP420_META_ALIGN));
-	rows = cols;
-	g->y_pitch = g->tiles_x * AVE_CMP420_Y_BODY;
-	g->y_meta = g->tiles_y * g->y_pitch;
-	g->y_meta_pitch = cols * AVE_CMP420_Y_META;
-	g->c = g->y_meta + rows * g->y_meta_pitch;
-	g->c_pitch = g->tiles_x * AVE_CMP420_C_BODY;
-	g->c_meta = g->c + g->tiles_y * g->c_pitch;
-	g->c_meta_pitch = cols * AVE_CMP420_C_META;
-	g->bytes = g->c_meta + rows * g->c_meta_pitch;
-	return 0;
-}
