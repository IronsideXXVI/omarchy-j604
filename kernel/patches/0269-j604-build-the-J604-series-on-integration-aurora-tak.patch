-	pl = &ave->layout->process[AVE_CODEC_H264 - 1];
-	recon = ave_6070_avc_recon_layout(1920, 1080);
-
-	for (u32 frame = 0; frame < 5; frame++) {
-		memset(cmd, 0, 0x1940);
