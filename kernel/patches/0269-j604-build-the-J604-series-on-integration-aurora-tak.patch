-static void *t_alloc(struct kunit *test, size_t n)
-{
-	void *p = kvzalloc(n, GFP_KERNEL);
-
-	KUNIT_ASSERT_NOT_NULL(test, p);
-	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, t_free, p), 0);
-	return p;
-}
