-/**
- * apple_cpu_deep_sleep() - power down the calling core
- * @flags: APPLE_CPU_SLEEP_* flags
- *
- * Cleans the L1 data cache and powers the core down at WFI without state
- * retention. The core next runs from its RVBAR. Must be called with
- * interrupts masked.
- */
-void __noreturn apple_cpu_deep_sleep(unsigned int flags)
-{
-	apple_cpu_power_down(NULL, 0, flags);
-}
-EXPORT_SYMBOL_GPL(apple_cpu_deep_sleep);
-
-/*
- * T8132 suspend-to-RAM, in the order macOS uses on that SoC. SOURCE: Aurora's
- * drivers/soc/apple/sleep.c (sleep_cpu_stop(), sleep_deep_wfi_arm(),
- * sleep_boot_wfi()) and arch/arm64/kernel/smp_spin_table.c
- * (smp_rvbar_spin_table_hold()) in aurora-silicon/linux#1314, by Bartosz
- * Nitka and Diljit Singh, from the aura#109 trace of a macOS sleep on a
- * J713: each secondary writes its own PMGR stop bit at the start of the
- * commit and stays awake; only after the commit does every core take its
- * last WFI, with bits 0 and 63 of S3_5_C15_C6_2 set. That register is
- * neither CYC_OVRD nor ACC_OVRD, which this path does not write.
- */
-#define SYS_APL_T8132_DEEP_SLEEP	sys_reg(3, 5, 15, 6, 2)
-#define T8132_DEEP_SLEEP_ENABLE		(BIT_ULL(0) | BIT_ULL(63))
-
-/* Set by the boot CPU once the commit is written, or the sleep abandoned */
-static bool apple_cpu_t8132_released;
-/* With the release: whether the commit was written, and deep sleep allowed */
-static bool apple_cpu_t8132_deep;
-
-/* Clean and invalidate the L1 data cache by set/way */
-static void apple_l1_clean_sw(const struct apple_l1_sw *sw)
-{
-	u64 way = sw->ways;
-
-	asm volatile(
-	"	sub	%[way], %[way], #1\n"
-	"1:	sub	x10, %[sets], #1\n"
-	"2:	lslv	x11, %[way], %[way_shift]\n"
-	"	lslv	x12, x10, %[line_shift]\n"
-	"	orr	x11, x11, x12\n"
-	"	dc	cisw, x11\n"
-	"	subs	x10, x10, #1\n"
-	"	b.ge	2b\n"
-	"	subs	%[way], %[way], #1\n"
-	"	b.ge	1b\n"
-	"	dsb	sy\n"
-	: [way] "+r" (way)
-	: [sets] "r" (sw->sets), [way_shift] "r" (sw->way_shift),
-	  [line_shift] "r" (sw->line_shift)
-	: "x10", "x11", "x12", "cc", "memory");
-}
-
-/*
- * A core's last instructions for a T8132 sleep: the timers can't end the WFI,
- * and every wake-up acknowledges a fast IPI before the next WFI. Nothing
- * brings the core back but a reset. Deep sleep only once the commit is
- * written: a sleep abandoned after the stop takes the core down as the PMGR
- * stop alone does (apple_cpu_park_power_down()), its cluster left powered.
- */
-/* Events read off the AIC per wake of a last WFI, at most */
-#define T8132_AIC_ACK_MAX	256
-
-static bool t8132_aic_ack;
-module_param(t8132_aic_ack, bool, 0644);
-MODULE_PARM_DESC(t8132_aic_ack,
-		 "For bring-up: in the last WFI after a T8132 sleep commit, read the AIC's event register until it is empty after each wake of the WFI, as macOS does, so that an event latched before the lines were masked cannot keep the core out of its deep WFI (default: off)");
-
-/*
- * The AIC's event register for the last WFI, read before the commit: from the
- * commit on, a core touches no memory it has not already got in its caches.
- */
-static void __iomem *apple_cpu_t8132_aic_event;
-
-static void __noreturn apple_cpu_t8132_last_wfi(bool deep_sleep)
-{
-	void __iomem *ev = READ_ONCE(apple_cpu_t8132_aic_event);
-	u64 deep;
-
-	write_sysreg(0, cntv_ctl_el0);
-	write_sysreg(0, cntp_ctl_el0);
-	if (is_kernel_in_hyp_mode())
-		sysreg_clear_set_s(SYS_APL_ACNTHV_CTL_EL2, BIT(0), 0);
-	isb();
-
-	if (deep_sleep) {
-		deep = read_sysreg_s(SYS_APL_T8132_DEEP_SLEEP) | T8132_DEEP_SLEEP_ENABLE;
-		write_sysreg_s(deep, SYS_APL_T8132_DEEP_SLEEP);
-		isb();
-	}
-
-	/*
-	 * What ends a WFI here with every line masked: an event the AIC latched
-	 * before the mask, or an IPI. Ack both and wait again (Aurora's
-	 * sleep_boot_wfi(), from macOS's trace), so the engine gets the deep WFI.
-	 */
-	asm volatile(
-	"1:	dsb	sy\n"
-	"	isb\n"
-	"	wfi\n"
-	"	cbz	%0, 3f\n"
-	"	mov	x11, #%1\n"
-	"2:	ldr	w10, [%0]\n"
-	"	cbz	w10, 3f\n"
-	"	subs	x11, x11, #1\n"
-	"	b.ne	2b\n"
-	"3:	mov	x10, #1\n"
-	"	msr	s3_5_c15_c1_1, x10\n"
-	"	b	1b\n"
-	: : "r" (ev), "i" (T8132_AIC_ACK_MAX) : "x10", "x11", "memory");
-
-	unreachable();
-}
-
-/**
- * apple_cpu_t8132_deep_sleep() - the boot CPU's last WFI after a T8132 commit
- *
- * Cleans the L1 data cache by set/way, then powers the core down at WFI with
- * deep sleep allowed. The core next runs from its RVBAR. Must be called with
- * interrupts masked.
- */
-void __noreturn apple_cpu_t8132_deep_sleep(void)
-{
-	struct apple_l1_sw sw;
-
-	apple_l1_sw(&sw);
-	apple_l1_clean_sw(&sw);
-	apple_cpu_t8132_last_wfi(true);
-}
-EXPORT_SYMBOL_GPL(apple_cpu_t8132_deep_sleep);
-
-static u32 apple_cpu_start_bit(const struct apple_cluster *cl,
-			       unsigned int core);
-
-/*
- * On the parked core, for a T8132 commit: its own stop bit first, then held
- * awake, coherent and only reading memory, until the boot CPU has written the
- * commit, then the last WFI.
- */
-static void __noreturn apple_cpu_t8132_stop_hold(struct apple_cpu *ac)
-{
-	struct apple_cluster *cl = ac->cluster;
-	struct apple_l1_sw sw;
-
-	writel(apple_cpu_start_bit(cl, ac->core), cl->ctrl->start + CPU_START_STOP);
-	dsb(sy);
-	/* Pairs with the acquire in apple_cpu_t8132_stop_parked(). */
-	smp_store_release(&ac->t8132_stopped, true);
-
-	apple_l1_sw(&sw);
-	apple_l1_clean_sw(&sw);
-	/* Pairs with the release in apple_cpu_t8132_release_stopped(). */
-	while (!smp_load_acquire(&apple_cpu_t8132_released))
-		wfe();
-
-	apple_cpu_t8132_last_wfi(READ_ONCE(apple_cpu_t8132_deep));
-}
-
-static u32 apple_cpu_start_bit(const struct apple_cluster *cl,
-			       unsigned int core)
-{
-	const struct apple_cpu_ctrl_data *data = cl->ctrl->data;
-
-	if (data->start_bank)
-		return BIT(data->start_bank[cl->idx] + core);
-
-	return BIT(CPU_START_BANK_CORES * cl->idx + core);
-}
-
-/*
- * Runs on the dying CPU, with every exception masked. The core parks at a
- * WFI that powers it down with state retention: WFI_MODE(3) without
- * DISABLE_WFI_RET, the state the cpuidle "CPU PD" state uses. Its interrupt
- * modes are left alone so that a fast IPI (a FIQ) wakes it; device
- * interrupts were moved to other CPUs. The PMGR is not involved.
- *
- * The L1 stays powered and coherent in this state, as for an idle CPU, and
- * is cleaned anyway. The park loop only reads memory, so the core holds no
- * dirty line, whatever happens to its power later. Every command but
- * PARK_CMD_RESUME takes it down for good.
- */
-static void __noreturn apple_cpu_park(struct apple_cpu *ac)
-{
-	struct apple_cluster *cl = ac->cluster;
-	typeof(cpu_soft_restart) *restart;
-	struct apple_l1_sw sw;
-	u64 cyc, park, cmd;
-
-	/* Without CYC_OVRD, plain WFI already power gates with retention */
-	if (READ_ONCE(apple_cpu_no_cyc_ovrd)) {
-		cyc = 0;
-		park = 0;
-	} else {
-		cyc = read_sysreg_s(SYS_IMP_APL_CYC_OVRD);
-		park = (cyc & ~(CYC_OVRD_WFI_MODE | CYC_OVRD_DISABLE_WFI_RET)) |
-		       FIELD_PREP(CYC_OVRD_WFI_MODE, CYC_OVRD_WFI_MODE_POWER_DOWN);
-	}
-	apple_l1_sw(&sw);
-
-	/* Pairs with the acquire in cpu_kill: everything above is done. */
-	smp_store_release(&ac->parked, true);
-
-	do {
-		cmd = apple_cpu_park_wfi(&ac->park_cmd, park, sw.ways, sw.sets,
-					 sw.way_shift, sw.line_shift);
-		/* The controlling CPU may have withdrawn it in the meantime. */
-	} while (cmpxchg(&ac->park_cmd, cmd, PARK_CMD_TAKEN) != cmd);
-
-	if (cmd == PARK_CMD_RESUME) {
-		if (park) {
-			write_sysreg_s(cyc, SYS_IMP_APL_CYC_OVRD);
-			isb();
-		}
-
-		/* Into the holding pen with the MMU off, as on first boot */
-		cpu_install_idmap();
-		restart = (void *)__pa_symbol(cpu_soft_restart);
-		restart(is_hyp_nvhe(), __pa_symbol(secondary_holding_pen),
-			0, 0, 0);
-		unreachable();
-	}
-
-	if (cmd == PARK_CMD_T8132_STOP)
-		apple_cpu_t8132_stop_hold(ac);
-
-	apple_cpu_power_down(cl->ctrl->start + CPU_START_STOP,
-			     apple_cpu_start_bit(cl, ac->core),
-			     APPLE_CPU_SLEEP_MASK_IRQ);
-}
-
-static void apple_cpu_send_ipi(unsigned int cpu)
-{
-	u64 mpidr = cpu_logical_map(cpu);
-	u64 val = FIELD_PREP(IPI_RR_CPU, MPIDR_AFFINITY_LEVEL(mpidr, 0));
-
-	preempt_disable();
-	if (MPIDR_AFFINITY_LEVEL(read_cpuid_mpidr(), 1) ==
-	    MPIDR_AFFINITY_LEVEL(mpidr, 1))
-		write_sysreg_s(val, SYS_IMP_APL_IPI_RR_LOCAL_EL1);
-	else
-		write_sysreg_s(val | FIELD_PREP(IPI_RR_CLUSTER,
-						MPIDR_AFFINITY_LEVEL(mpidr, 1)),
-			       SYS_IMP_APL_IPI_RR_GLOBAL_EL1);
-	isb();
-	preempt_enable();
-}
-
-/*
- * Give a parked core a command and wait until it took it. If it does not
- * within PARK_TIMEOUT_US the command is withdrawn and the core stays
- * parked. Does not sleep.
- */
-static int apple_cpu_park_command(unsigned int cpu, struct apple_cpu *ac,
-				  u64 cmd)
-{
-	u64 val;
-	int ret;
-
-	/*
-	 * The pen release written before is visible before the command, and
-	 * the command before the IPI arrives.
-	 */
-	smp_store_release(&ac->park_cmd, cmd);
-	dsb(sy);
-	apple_cpu_send_ipi(cpu);
-
-	ret = read_poll_timeout_atomic(READ_ONCE, val, val == PARK_CMD_TAKEN,
-				       1, PARK_TIMEOUT_US, false, ac->park_cmd);
-	if (ret && cmpxchg(&ac->park_cmd, cmd, PARK_CMD_NONE) != cmd)
-		ret = 0;
-	if (ret)
-		pr_err("CPU%u: parked core did not respond\n", cpu);
-
-	return ret;
-}
-
-/*
- * Power a parked core down without state retention, through the PMGR stop
- * control, so that its cluster can be gated. Does not sleep.
- *
- * A parked core already reads run state 0, so that alone does not show it
- * went down. The core sets its stop bit after cleaning its L1 and right
- * before its final WFI; the stop control reads back the stopped cores.
- */
-static int apple_cpu_park_power_down(unsigned int cpu, struct apple_cpu *ac)
-{
-	struct apple_cluster *cl = ac->cluster;
-	void __iomem *stop = cl->ctrl->start + CPU_START_STOP;
-	u32 bit = apple_cpu_start_bit(cl, ac->core);
-	u32 stopped;
-	u64 val;
-	int ret;
-
-	ret = apple_cpu_park_command(cpu, ac, PARK_CMD_POWER_DOWN);
-	if (ret)
-		return ret;
-
-	ret = readl_poll_timeout_atomic(stop, stopped, stopped & bit, 10,
-					IMPL_STOP_TIMEOUT_US);
-	if (!ret)
-		ret = readq_poll_timeout_atomic(ac->impl + IMPL_CORE_STATUS, val,
-						!(val & IMPL_CORE_STATUS_RUNNING),
-						10, IMPL_STOP_TIMEOUT_US);
-	if (ret) {
-		pr_err("CPU%u: core did not power down: stop %#x, status %#llx\n",
-		       cpu, readl(stop), readq(ac->impl + IMPL_CORE_STATUS));
-		ac->state = APPLE_CPU_STUCK;
-		return ret;
-	}
-
-	ac->state = APPLE_CPU_STOPPED;
-	return 0;
-}
-
-/**
- * apple_cpu_acc_save() - prepare the CPU complexes for losing power
- *
- * Captures the CPU complex configuration of every powered cluster that can
- * be re-initialised, for apple_cpu_acc_restore(). Parked CPUs must already
- * be powered down: see apple_cpu_park_power_down_all(). Must be called
- * with interrupts masked, with every secondary CPU offline.
- *
- * Return: 0, or -ENODEV if no cluster supports it.
- */
-int apple_cpu_acc_save(void)
-{
-	bool found = false;
-	unsigned int i;
-
-	for (i = 0; i < apple_nr_clusters; i++) {
-		struct apple_cluster *cl = &apple_clusters[i];
-
-		/* A cluster awaiting re-init still holds its capture. */
-		if (!apple_cluster_acc(cl) || cl->gated || cl->reinit)
-			continue;
-		apple_acc_save(cl);
-		found = true;
-	}
-
-	return found ? 0 : -ENODEV;
-}
-EXPORT_SYMBOL_GPL(apple_cpu_acc_save);
-
-/**
- * apple_cpu_park_power_down_all() - power down every parked CPU
- *
- * A parked core would not survive its cluster losing power. Once powered
- * down, it can only be started again after its cluster was power cycled:
- * if suspend to RAM is aborted afterwards, the CPUs of the boot CPU's
- * cluster stay offline until reboot. Call it before any other SoC power is
- * taken down, as a parked core must not be woken after that. Must be
- * called with interrupts masked.
- *
- * Return: 0, or an error if a parked CPU did not power down.
- */
-int apple_cpu_park_power_down_all(void)
-{
-	unsigned int cpu;
-	int ret;
-
-	for_each_possible_cpu(cpu) {
-		struct apple_cpu *ac = apple_cpus[cpu];
-
-		if (!ac || ac->state != APPLE_CPU_PARKED)
-			continue;
-		ret = apple_cpu_park_power_down(cpu, ac);
-		if (ret)
-			return ret;
-	}
-
-	return 0;
-}
-EXPORT_SYMBOL_GPL(apple_cpu_park_power_down_all);
-
-/**
- * apple_cpu_t8132_stop_parked() - stop the parked CPUs for a T8132 commit
- *
- * Each parked secondary writes its own PMGR stop bit and is held awake until
- * apple_cpu_t8132_release_stopped(). Must be called with interrupts masked,
- * with every secondary CPU offline. A core that took the stop can only be
- * started again after the SoC was power cycled, also if the sleep is then
- * abandoned: apple_cpu_t8132_release_stopped() must follow in every case.
- *
- * Return: 0, or an error if a parked CPU did not take the stop.
- */
-int apple_cpu_t8132_stop_parked(void)
-{
-	unsigned int cpu;
-	bool stopped;
-	int ret;
-
-	WRITE_ONCE(apple_cpu_t8132_released, false);
-	WRITE_ONCE(apple_cpu_t8132_deep, false);
-	WRITE_ONCE(apple_cpu_t8132_aic_event,
-		   READ_ONCE(t8132_aic_ack) ? aic_sleep_event_reg() : NULL);
-	/* Before any parked core reads it in apple_cpu_t8132_stop_hold() */
-	dcache_clean_poc((unsigned long)&apple_cpu_t8132_aic_event,
-			 (unsigned long)(&apple_cpu_t8132_aic_event + 1));
-	for_each_possible_cpu(cpu) {
-		struct apple_cpu *ac = apple_cpus[cpu];
-
-		if (!ac || ac->state != APPLE_CPU_PARKED)
-			continue;
-		ac->t8132_stopped = false;
-		ret = apple_cpu_park_command(cpu, ac, PARK_CMD_T8132_STOP);
-		if (!ret)
-			ret = read_poll_timeout_atomic(smp_load_acquire, stopped, stopped,
-						       1, PARK_TIMEOUT_US, false,
-						       &ac->t8132_stopped);
-		if (ret) {
-			ac->state = APPLE_CPU_STUCK;
-			return ret;
-		}
-		ac->state = APPLE_CPU_STOPPED;
-	}
-
-	return 0;
-}
-EXPORT_SYMBOL_GPL(apple_cpu_t8132_stop_parked);
-
-/**
- * apple_cpu_t8132_release_stopped() - let the stopped CPUs take their last WFI
- * @committed: the T8132 commit is written, deep sleep is allowed
- *
- * After the T8132 commit, or to give up a sleep after
- * apple_cpu_t8132_stop_parked(): the stopped cores power down.
- */
-void apple_cpu_t8132_release_stopped(bool committed)
-{
-	WRITE_ONCE(apple_cpu_t8132_deep, committed);
-	/* Pairs with the acquire in apple_cpu_t8132_stop_hold(): @committed first. */
-	smp_store_release(&apple_cpu_t8132_released, true);
-	dsb(sy);
-	sev();
-}
-EXPORT_SYMBOL_GPL(apple_cpu_t8132_release_stopped);
-
-/**
- * apple_cpu_power_cycled() - every CPU complex lost power
- *
- * Called on resume from suspend to RAM: each powered-down CPU can now be
- * started once.
- */
-void apple_cpu_power_cycled(void)
-{
-	unsigned int cpu;
-
-	for_each_possible_cpu(cpu) {
-		struct apple_cpu *ac = apple_cpus[cpu];
-
-		if (ac && ac->state == APPLE_CPU_STOPPED)
-			ac->state = APPLE_CPU_OFF;
-	}
-}
-EXPORT_SYMBOL_GPL(apple_cpu_power_cycled);
-
-/**
- * apple_cpu_acc_restore() - re-apply the CPU complex configuration
- *
- * Re-initialises every powered cluster from its last apple_cpu_acc_save()
- * capture, after the CPU complexes lost their state. Clusters that are
- * power gated are re-initialised when their first CPU is started.
- *
- * Return: 0, the first error, or -ENODEV if no cluster supports it.
- */
-int apple_cpu_acc_restore(void)
-{
-	bool found = false;
-	unsigned int i;
-	int ret = 0;
-
-	for (i = 0; i < apple_nr_clusters; i++) {
-		struct apple_cluster *cl = &apple_clusters[i];
-		int err;
-
-		if (!apple_cluster_acc(cl) || cl->gated || !cl->saved)
-			continue;
-		found = true;
-		err = apple_acc_reinit(cl);
-		if (err) {
-			pr_err("cluster %u: CPU complex re-init failed: %d\n",
-			       cl->idx, err);
-			if (!ret)
-				ret = err;
-		} else {
-			cl->reinit = false;
-		}
-	}
-
-	return found ? ret : -ENODEV;
-}
-EXPORT_SYMBOL_GPL(apple_cpu_acc_restore);
-
-/*
- * Can @cpu, the last online CPU of its cluster, take the cluster down with
- * it? Every other core of the cluster must be parked or powered down, and a
- * core started later must find a quiet boot loader.
- */
-static bool apple_cluster_can_gate(unsigned int cpu, struct apple_cluster *cl)
-{
-	unsigned int other;
-
-	if (!READ_ONCE(cluster_gating) || !apple_cluster_acc(cl) ||
-	    !cl->ctrl->data->cluster_ps || !cl->min_pstate ||
-	    apple_reentry.mode == APPLE_REENTRY_UNKNOWN)
-		return false;
-
-	/* Neither online nor powered down: never booted, or in an unknown state */
-	for_each_possible_cpu(other) {
-		struct apple_cpu *ac = apple_cpus[other];
-
-		if (other == cpu || !apple_cpu_same_cluster(cpu, other))
-			continue;
-		if (!ac || ac->cluster != cl)
-			return false;
-		if (ac->state != APPLE_CPU_PARKED &&
-		    ac->state != APPLE_CPU_STOPPED &&
-		    ac->state != APPLE_CPU_OFF)
-			return false;
-	}
-
-	return true;
-}
