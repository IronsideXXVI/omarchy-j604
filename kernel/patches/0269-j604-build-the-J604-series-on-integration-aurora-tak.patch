-/*
- * Sleep handshake: after the children have suspended, write WKTP = 2 and
- * announce sleep with MBSE = 'slpa'. The SMC acknowledges it by setting bit 16
- * of the status word read back from MBSE. On resume, read the MBSW wake-reason
- * bitmap and announce the wake with MBSE = 'waka', which clears that bit.
- *
- * The announcement only tells the SMC that the system is asleep; it does not
- * by itself power anything down under s2idle. Under s2idle it is only made
- * with the sleep_handshake module parameter (default off, so suspend-to-idle
- * behaves as before); suspend-to-RAM, which needs it, always makes it. MBSW
- * is read-only and always logged.
- *
- * Suspend-to-RAM uses the firmware-driven sequence further down instead
- * (.prepare and the noirq phases), which blocks key commands between the AP
- * power notices.
- */
-static bool sleep_handshake;
-module_param(sleep_handshake, bool, 0644);
-MODULE_PARM_DESC(sleep_handshake, "Also announce suspend-to-idle and its wake to the SMC; suspend-to-RAM always does (default: off)");
-
-static int apple_smc_announce_sleep(struct device *dev)
-{
-	struct apple_smc *smc = dev_get_drvdata(dev);
-	int ret;
-
-	smc->sleep_announced = false;
-	if (!sleep_handshake && pm_suspend_target_state != PM_SUSPEND_MEM)
-		return 0;
-
-	if (apple_smc_key_exists(smc, SMC_KEY(WKTP))) {
-		ret = apple_smc_write_u8(smc, SMC_KEY(WKTP), 2);
-		if (ret < 0)
-			dev_warn(dev, "Failed to write WKTP (%d)\n", ret);
-	}
-
-	/*
-	 * Serialize the last key command with background power/thermal work.
-	 * Do not hold the mutex while waiting for an RTKit management reply:
-	 * queued notifications on that worker may themselves try to read keys.
-	 */
-	scoped_guard(mutex, &smc->mutex) {
-		u32 command = SMC_KEY(slpa);
-
-		ret = apple_smc_rw_locked(smc, SMC_KEY(MBSE), &command,
-					  sizeof(command), NULL, 0);
-		if (ret >= 0)
-			smc->sleep_announced = true;
-	}
-	if (ret < 0) {
-		dev_warn(dev, "Failed to announce sleep (MBSE = slpa): %d\n", ret);
-		return pm_suspend_target_state == PM_SUSPEND_MEM ? ret : 0;
-	}
-
-	return 0;
-}
