-	APPLE_CPU_STOPPED,
-	/*
-	 * Powered down, and its cluster power cycled since: the core can be
-	 * started through the PMGR.
-	 */
-	APPLE_CPU_OFF,
-	/* Released from the park or started, not online yet */
-	APPLE_CPU_STARTING,
-	/* Did not go down or did not come back as expected; left alone */
-	APPLE_CPU_STUCK,
-};
