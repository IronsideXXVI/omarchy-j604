-}
-
-/* Runs on the CPU that just came up. */
-static void apple_spin_table_cpu_postboot(void)
-{
-	struct apple_cpu *ac = apple_cpus[smp_processor_id()];
-	struct apple_cluster *cl;
-
-	if (!ac)
-		return;
-
-	ac->state = APPLE_CPU_RUNNING;
-	if (ac->lone) {
-		ac->lone = false;
-		pr_info("CPU%u: online again after a power-down alone (debug_lone_core)\n",
-			smp_processor_id());
-	}
-
-	cl = ac->cluster;
-	if (cl->acc_ovrd_dirty) {
-		write_sysreg_s(cl->acc_ovrd, SYS_IMP_APL_ACC_OVRD);
-		isb();
-		cl->acc_ovrd_dirty = false;
-	}
-}
-
-/* debug_power_down=<cpu>: power one parked secondary down alone */
-static int apple_cpu_debug_power_down_set(const char *val,
-					  const struct kernel_param *kp)
-{
-	struct apple_cpu *ac;
-	unsigned int cpu;
-	int ret;
-
-	if (!READ_ONCE(debug_lone_core))
