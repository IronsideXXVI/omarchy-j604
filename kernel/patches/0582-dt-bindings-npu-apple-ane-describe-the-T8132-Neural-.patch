From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 03:28:34 +0000
Subject: [PATCH] dt-bindings: npu: apple,ane: describe the T8132 Neural Engine

The T8132 (M4) Neural Engine is an H16 engine like the T6041's, and the
J604 runtime ADT describes it with:

  /arm-io/ane       compatible "ane,t8020", ane-type 0x100, pre-loaded
                    __TEXT 0xc0000 / __DATA 0x2ac000 at device addresses
                    0x10000000000 / 0x100000c0000, two interrupts (629,
                    642), six reg windows:
                      0x500000000 +0x2000000   engine
                      0x380700000 +0x18000     PMGR
                      0x380724000 +0x4000
                      0x3803c0000 +0x30000
                      0x211000000 +0xff4000
                      0x3882c8000 +0x4000
  /arm-io/dart-ane  three DART instances, one interrupt (630), a DAPF bank
                    at DART0 + 0x10000 and five dapf-instance-0 records

That is the T6041's window list without its second 32 MiB engine window
(aux-3), so the T8132 names its windows engine, pmgr, aux-0, aux-1, aux-2
and aux-4, and it has five DAPF ranges where the T6041 has four.

Add apple,t8132-ane wherever the binding lists the firmware-managed H16/H17
engines, a T8132 branch with its six windows, one interrupt, the five
power domains and ane-type 0x100, allow ane-type 0x100, and let
apple,dapf-ranges carry five ranges (still exactly four on the T6041).

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 .../devicetree/bindings/npu/apple,ane.yaml    | 56 +++++++++++++++++--
 1 file changed, 51 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/npu/apple,ane.yaml b/Documentation/devicetree/bindings/npu/apple,ane.yaml
index 6e50f9f11b..11dd95f7d2 100644
--- a/Documentation/devicetree/bindings/npu/apple,ane.yaml
+++ b/Documentation/devicetree/bindings/npu/apple,ane.yaml
@@ -32,6 +32,7 @@ properties:
           - apple,t6022-ane
           - apple,t6041-ane
           - apple,t8112-ane
+          - apple,t8132-ane
           - apple,t8140-ane
       - items:
           - const: apple,t6001-ane
@@ -141,15 +142,16 @@ properties:
   apple,dapf-ranges:
     $ref: /schemas/types.yaml#/definitions/uint64-matrix
     minItems: 4
-    maxItems: 4
+    maxItems: 5
     items:
       items:
         - description: Physical start address, inclusive
         - description: Physical end address, inclusive
     description:
-      Four DART address protection filter (DAPF) ranges, in hardware record
-      order. Each pair contains inclusive 64-bit physical bounds, not a
-      base and length. The same records apply to all three ANE DARTs.
+      The DART address protection filter (DAPF) ranges in hardware record
+      order, four on T6041 and T8140 and five on T8132. Each pair contains
+      inclusive 64-bit physical bounds, not a base and length. The same
+      records apply to all three ANE DARTs.
       Firmware accesses these registers through identity mappings of the
       containing 16 KiB pages in its private domain. These are MMIO ranges,
       not allocatable DMA memory or additional preload segments.
@@ -167,7 +169,7 @@ properties:
 
   apple,ane-type:
     $ref: /schemas/types.yaml#/definitions/uint32
-    enum: [0x110, 0x200]
+    enum: [0x100, 0x110, 0x200]
     description: Firmware generation identifier supplied by the bootloader
 
   apple,firmware-preloaded:
@@ -254,6 +256,7 @@ allOf:
         compatible:
           enum:
             - apple,t6041-ane
+            - apple,t8132-ane
             - apple,t8140-ane
       required:
         - memory-region
@@ -300,6 +303,47 @@ allOf:
             - const: perf
         apple,ane-type:
           const: 0x110
+        apple,dapf-ranges:
+          maxItems: 4
+      required:
+        - apple,ane-type
+        - apple,firmware-preloaded
+        - apple,dapf-ranges
+  - if:
+      properties:
+        compatible:
+          const: apple,t8132-ane
+    then:
+      properties:
+        interrupts:
+          maxItems: 1
+        reg:
+          minItems: 6
+          maxItems: 6
+        reg-names:
+          items:
+            - const: engine
+            - const: pmgr
+            - const: aux-0
+            - const: aux-1
+            - const: aux-2
+            - const: aux-4
+        power-domains:
+          minItems: 5
+          maxItems: 6
+        power-domain-names:
+          minItems: 5
+          items:
+            - const: sys
+            - const: cpu
+            - const: mpm
+            - const: td
+            - const: base
+            - const: perf
+        apple,ane-type:
+          const: 0x100
+        apple,dapf-ranges:
+          minItems: 5
       required:
         - apple,ane-type
         - apple,firmware-preloaded
@@ -311,6 +355,7 @@ allOf:
             enum:
               - apple,t8140-ane
               - apple,t6041-ane
+              - apple,t8132-ane
     then:
       properties:
         interrupt-names: false
@@ -410,6 +455,7 @@ allOf:
             enum:
               - apple,t8140-ane
               - apple,t6041-ane
+              - apple,t8132-ane
               - apple,t6001-ane
     else:
       properties:
