diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 39237a5546..480963d1f4 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -8,6 +8,9 @@
 //! and successful command receipt frontiers. No independent hardware queue reservation,
 //! fragment barriers or ray queries are advertised.
 
+use core::ffi::{c_char, c_int};
+use core::sync::atomic::{AtomicU32, Ordering};
+
 use kernel::{prelude::*, uapi};
 
 use super::{hw, Gpu, GPU_GENERATION};
@@ -53,18 +56,141 @@ pub(crate) fn sampler_heap() -> bool {
     *module_parameters::g16_sampler_heap.value() != 0
 }
 
-/// Idle core power-off level (testing; read once at probe).
+/// Default of `asahi.g16_idle_power_off`.
+pub(crate) const IDLE_POWER_OFF_DEFAULT: u32 = 0;
+
+/// Storage of `asahi.g16_idle_power_off`, always in 0..=2.
+static IDLE_POWER_OFF: AtomicU32 = AtomicU32::new(IDLE_POWER_OFF_DEFAULT);
+
+/// Idle core power-off level.
 ///
 /// 0 keeps the qualified 25G83 initdata, under which the firmware keeps the GPU cores powered
 /// while idle. 1 sets the Globals word that the G17 backend documents as region C
 /// `idle_power_off` (same offset, +0x30; the qualified G16 Globals already carries the G17
 /// region C values around it, including the power-off delay at +0x9bc). 2 also clears the
-/// G17 gating-disable bits in SGX +0xd06030 before the firmware is initialized. Values above 2
-/// are treated as 2.
+/// G17 gating-disable bits in SGX +0xd06030 before the firmware is initialized.
+///
+/// The `module!` parameters are boot-only and have no sysfs node (`perm: 0` in
+/// rust/macros/module.rs), so this one is declared with its own `kernel_param` entry: it is
+/// readable in /sys/module/asahi/parameters, and writable there by root. The level at probe
+/// selects the initdata (and, for 2, the SGX gating bits); later writes change only whether
+/// Globals +0x30 is 0 or 1, published with the next power service (before the next
+/// publication), as the host already publishes the performance selectors in the same Globals.
 pub(crate) fn idle_power_off() -> u32 {
-    (*module_parameters::g16_idle_power_off.value()).min(2)
+    IDLE_POWER_OFF.load(Ordering::Relaxed)
 }
 
+/// `set` of `asahi.g16_idle_power_off`: a decimal level; values above 2 are stored as 2.
+///
+/// # Safety
+///
+/// Called by the module-parameter core with `val` NULL or a NUL-terminated string.
+unsafe extern "C" fn idle_power_off_set(
+    val: *const c_char,
+    _kp: *const kernel::bindings::kernel_param,
+) -> c_int {
+    if val.is_null() {
+        return EINVAL.to_errno();
+    }
+    // SAFETY: `val` is a NUL-terminated string per the function contract.
+    let Ok(text) = unsafe { core::ffi::CStr::from_ptr(val) }.to_str() else {
+        return EINVAL.to_errno();
+    };
+    let Ok(level) = text.trim().parse::<u32>() else {
+        return EINVAL.to_errno();
+    };
+    IDLE_POWER_OFF.store(level.min(2), Ordering::Relaxed);
+    0
+}
+
+/// `get` of `asahi.g16_idle_power_off`.
+///
+/// # Safety
+///
+/// `buffer` is the module-parameter core's PAGE_SIZE output buffer.
+unsafe extern "C" fn idle_power_off_get(
+    buffer: *mut c_char,
+    _kp: *const kernel::bindings::kernel_param,
+) -> c_int {
+    let level = IDLE_POWER_OFF.load(Ordering::Relaxed).min(2) as u8;
+    // SAFETY: the buffer holds PAGE_SIZE bytes; two are written. The core appends the newline.
+    unsafe {
+        *buffer.cast::<u8>() = b'0' + level;
+        *buffer.cast::<u8>().add(1) = 0;
+    }
+    1
+}
+
+static IDLE_POWER_OFF_OPS: kernel::bindings::kernel_param_ops = kernel::bindings::kernel_param_ops {
+    flags: 0,
+    set: Some(idle_power_off_set),
+    get: Some(idle_power_off_get),
+    free: None,
+};
+
+#[link_section = "__param"]
+#[used(compiler)]
+static IDLE_POWER_OFF_PARAM: kernel::module_param::KernelParam =
+    kernel::module_param::KernelParam::new(kernel::bindings::kernel_param {
+        name: kernel::str::as_char_ptr_in_const_context(if cfg!(MODULE) {
+            kernel::c_str!("g16_idle_power_off")
+        } else {
+            kernel::c_str!("asahi.g16_idle_power_off")
+        }),
+        // `__this_module` is constructed by the kernel at load time and is not freed until the
+        // module is unloaded. Take its address without a reference to the mutable static.
+        #[cfg(MODULE)]
+        mod_: (&raw const kernel::bindings::__this_module).cast_mut(),
+        #[cfg(not(MODULE))]
+        mod_: core::ptr::null_mut(),
+        ops: core::ptr::from_ref(&IDLE_POWER_OFF_OPS),
+        perm: 0o644,
+        level: -1,
+        flags: 0,
+        __bindgen_anon_1: kernel::bindings::kernel_param__bindgen_ty_1 {
+            arg: core::ptr::from_ref(&IDLE_POWER_OFF).cast_mut().cast(),
+        },
+    });
+
+/// Copies a modinfo string into the array a `.modinfo` entry needs.
+const fn modinfo<const N: usize>(text: &[u8]) -> [u8; N] {
+    let mut out = [0u8; N];
+    let mut i = 0;
+    while i < N {
+        out[i] = text[i];
+        i += 1;
+    }
+    out
+}
+
+// modinfo strings in the `module!` spelling (`parm`, `parmtype`), so `modinfo asahi` lists the
+// parameter as before; built-in modules prefix them with `asahi.`.
+#[cfg(MODULE)]
+const PARMTYPE: &[u8] = b"parmtype=g16_idle_power_off:u32\0";
+#[cfg(MODULE)]
+const PARM: &[u8] = b"parm=g16_idle_power_off:G16: idle core power-off (default 0; runtime 0644). 0: qualified 25G83 initdata (cores stay powered); 1: Globals +0x30 = 1 (G17 region C idle_power_off), also switchable at runtime; 2: 1 and clear the SGX +0xd06030 gating-disable bits before init (G17 pattern; boot only)\0";
+#[cfg(not(MODULE))]
+const BUILTIN_PARMTYPE: &[u8] = b"asahi.parmtype=g16_idle_power_off:u32\0";
+#[cfg(not(MODULE))]
+const BUILTIN_PARM: &[u8] = b"asahi.parm=g16_idle_power_off:G16: idle core power-off (default 0; runtime 0644)\0";
+
+#[cfg(MODULE)]
+#[link_section = ".modinfo"]
+#[used(compiler)]
+static IDLE_POWER_OFF_PARMTYPE: [u8; PARMTYPE.len()] = modinfo(PARMTYPE);
+#[cfg(MODULE)]
+#[link_section = ".modinfo"]
+#[used(compiler)]
+static IDLE_POWER_OFF_PARM: [u8; PARM.len()] = modinfo(PARM);
+#[cfg(not(MODULE))]
+#[link_section = ".modinfo"]
+#[used(compiler)]
+static IDLE_POWER_OFF_PARMTYPE: [u8; BUILTIN_PARMTYPE.len()] = modinfo(BUILTIN_PARMTYPE);
+#[cfg(not(MODULE))]
+#[link_section = ".modinfo"]
+#[used(compiler)]
+static IDLE_POWER_OFF_PARM: [u8; BUILTIN_PARM.len()] = modinfo(BUILTIN_PARM);
+
 /// Fragment-only dependency publication has not been qualified on this backend.
 pub(crate) fn early_tiling() -> bool {
     false
