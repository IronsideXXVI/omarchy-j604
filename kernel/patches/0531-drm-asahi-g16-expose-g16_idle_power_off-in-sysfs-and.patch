     let mut input = wire::Input {
         performance,
         va: [0; wire::OBJECT_COUNT],
@@ -147,13 +154,13 @@ pub(crate) fn build(
         lower_parameter: wire::BOOTSTRAP_START + 0x8000,
         ktrace_mask: 0,
         progress_recovery: 1,
-        idle_power_off: super::params::idle_power_off() != 0,
