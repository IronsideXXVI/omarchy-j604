index 8c4cf148b6..d80c03185f 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -859,6 +859,14 @@ impl Firmware {
             self.power.effective, self.power.temperature_mc, self.power.updates,
             self.power.sensor_errors
         )?;
+        writeln!(
+            f,
+            "idle_power_off: published {} requested {} boot_level {} changes {}",
+            self.init.idle_power_off,
+            params::idle_power_off(),
+            self.init.idle_power_off_level,
+            self.init.idle_power_off_changes
+        )?;
         writeln!(
             f,
             "publications: compute {} render {}",
diff --git a/drivers/gpu/drm/asahi/g16/power.rs b/drivers/gpu/drm/asahi/g16/power.rs
index bd8ec48310..cef36a0a8b 100644
--- a/drivers/gpu/drm/asahi/g16/power.rs
+++ b/drivers/gpu/drm/asahi/g16/power.rs
@@ -14,7 +14,9 @@
 //! Under the qualified initdata (`g16_idle_power_off=0`, see `params::idle_power_off`)
 //! the firmware keeps GFX powered while the GPU idles, so the host reports
 //! when it has work in flight to the DT-selected CLPC, which holds the memory
-//! and fabric floor for that work.
+//! and fabric floor for that work. A runtime change of `g16_idle_power_off`
+//! between 0 and non-zero is published here as Globals +0x30, like the
+//! selectors: written and ordered before the next queue or doorbell publication.
 
 pub(crate) mod policy;
 
@@ -24,7 +26,7 @@ use kernel::{bindings, device, prelude::*, sync::aref::ARef};
 use super::fw::initdata::globals;
 use super::recovery::now_ns;
 use super::regs::wmb;
-use super::Firmware;
+use super::{params, Firmware};
 use policy::{COOLING_MAX, PSTATE_MAX};
 
 static_assert!(globals::PSTATE_SELECTORS[0] == 0x88);
@@ -269,6 +271,7 @@ impl Firmware {
         if let Some(error) = self.recovery.failed() {
             return Err(error);
         }
+        self.service_idle_power_off()?;
         let now = now_ns();
         let (limit, decision) = self.power.ceiling(now);
         let target = self
@@ -300,4 +303,29 @@ impl Firmware {
         self.power.updates += 1;
         Ok(())
     }
+
+    /// Publishes Globals +0x30 when `asahi.g16_idle_power_off` changed between zero and
+    /// non-zero since the last publication. The firmware reads it from the same shared
+    /// Globals object as the performance selectors.
+    fn service_idle_power_off(&mut self) -> Result {
+        let want = u32::from(params::idle_power_off() != 0);
+        if want == self.init.idle_power_off {
+            return Ok(());
+        }
+        let globals = self.init.globals.as_ref().ok_or(ENODEV)?;
+        globals.w32(globals::IDLE_POWER_OFF, want)?;
+        wmb();
+        dev_info!(
+            self.dev(),
+            "M4 power: idle core power-off {} -> {} (Globals +{:#x}, g16_idle_power_off={}, boot level {})\n",
+            self.init.idle_power_off,
+            want,
+            globals::IDLE_POWER_OFF,
+            params::idle_power_off(),
+            self.init.idle_power_off_level
+        );
+        self.init.idle_power_off = want;
+        self.init.idle_power_off_changes += 1;
+        Ok(())
+    }
 }
