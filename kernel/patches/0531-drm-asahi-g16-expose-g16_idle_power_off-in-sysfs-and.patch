     }
@@ -223,6 +230,9 @@ pub(crate) fn build(
             uma: graph[id::UMA].clone(),
             parameter: graph[id::PARAMETER].clone(),
             root: graph[id::ROOT].clone(),
+            idle_power_off_level,
