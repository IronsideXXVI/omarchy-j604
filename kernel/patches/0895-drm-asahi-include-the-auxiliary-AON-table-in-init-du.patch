From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 08:11:26 +0000
Subject: [PATCH] drm/asahi: include the auxiliary AON table in init
 dumps

Retain the actual pre-start table bytes when g16_init_dump is enabled and expose the live allocation as object 31. Keep existing inventory IDs stable. Mark unreadable and size-limited data explicitly instead of implying zeros.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/initdata.rs | 22 +++++++++++++++++++---
 1 file changed, 19 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/initdata.rs b/drivers/gpu/drm/asahi/g16/initdata.rs
index 68dfacd57e..67a5c04072 100644
--- a/drivers/gpu/drm/asahi/g16/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/initdata.rs
@@ -100,6 +100,9 @@ pub(crate) fn take_dump(&mut self) -> Result<Option<InitDump>> {
         for object in self._graph.iter() {
             objects.push(object.clone(), GFP_KERNEL)?;
         }
+        if let Some(aon) = self._aon_ptd.as_ref() {
+            objects.push(aon.clone(), GFP_KERNEL)?;
+        }
         Ok(Some(InitDump { objects, encoded }))
     }
 
@@ -166,13 +169,18 @@ pub(crate) fn dump_show(v: &InitDump, f: &mut fmt::Formatter<'_>) -> fmt::Result
         v.objects.len()
     )?;
     for (i, object) in v.objects.iter().enumerate() {
-        let size = wire::OBJECT_SIZE[i];
+        let (name, size) = if i == wire::OBJECT_COUNT {
+            ("aon_ptd", wire::init_macos::AON_PTD_SIZE)
+        } else {
+            (NAMES[i], wire::OBJECT_SIZE[i])
+        };
         writeln!(
             f,
             "obj {} {} va {:#x} size {:#x}",
-            i, NAMES[i], object.va, size
+            i, name, object.va, size
         )?;
         if size > DUMP_MAX {
+            writeln!(f, "unavailable {} all size-limit", i)?;
             continue;
         }
         let encoded = v.encoded.get(i);
@@ -181,7 +189,10 @@ pub(crate) fn dump_show(v: &InitDump, f: &mut fmt::Formatter<'_>) -> fmt::Result
             let mut live = [0u8; 32];
             let live = match object.read(at, &mut live[..n]) {
                 Ok(()) => Some(&live[..n]),
-                Err(_) => None,
+                Err(_) => {
+                    writeln!(f, "unavailable {} l {:#x} {:#x} read-error", i, at, n)?;
+                    None
+                }
             };
             let image = encoded.and_then(|e| e.get(at..at + n));
             for (tag, row) in [("e", image), ("l", live)] {
@@ -575,6 +586,11 @@ pub(crate) fn build(
             dev,
             "M4 initdata: g16_init_dump=1: images kept for aurora-g16/initdata\n"
         );
+        if let Some(aon) = aon_ptd.as_ref() {
+            let mut image = KVVec::from_elem(0u8, wire::init_macos::AON_PTD_SIZE, GFP_KERNEL)?;
+            aon.read(0, &mut image)?;
+            images.push(image, GFP_KERNEL)?;
+        }
         Some(images)
     } else {
         None
-- 
