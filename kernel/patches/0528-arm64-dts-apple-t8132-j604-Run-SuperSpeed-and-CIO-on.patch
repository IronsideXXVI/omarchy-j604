From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 02:41:44 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: Run SuperSpeed and CIO on
 USB-C ports 1 and 4

Ports 1 (left front, ATC0) and 4 (right, ATC3) were left USB2-only: their
PHYs had only the usb2phy and pipehandler windows, so the T8132 PHY driver
takes them as USB2-only (t8132_ss false) and refuses USB3 and CIO.

Map the five T8132 banks (core, axi2af, lioa, fabric, common-config) on
both, as port 2 (ATC1) already has them, and give dwc3_0 and dwc3_3 their
SuperSpeed PHY. Upstream did the same for the J713 front port (ATC0) in
38dcae1e0d ("arm64: dts: apple: t8132-j713: enable SuperSpeed and CIO on
the front port PHY"); its J713 board half does not apply to this tree.

The windows are ATC1's at each ATC's own base. In the J604 ADT the three
USB ATCs have the same layout apart from the base (atc-phyN reg
0x4N2a90000/0x4000, 0x4N2800000/0x4000, 0x4N3000000/0x58000,
0x4N0000000/0x1000000 and usb-drdN pipehandler 0x4N2a84000, with N = 0, 0x08,
0x18 for ATC0, ATC1, ATC3), and the ATC0 values equal the J713 ATC0 ones.
The crossbar windows at core + 0x4c000 stay with their own driver.

The calibration comes from the boot loader: m1n1 copies the ATC tunables
for every atcphyN alias, independent of the reg windows, and this board
already has the atcphy0, atcphy1 and atcphy3 aliases.

The driver starts a SuperSpeed or CIO epoch only on a cold common block
(atcphy_t8132_cold()) and refuses it otherwise; it never resets a live
epoch to make one cold.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 43 ++++++++++++++++++++++--
 1 file changed, 40 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index b93dc7449f..992d6b1457 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -536,6 +536,22 @@
 
 &atcphy0 {
 	status = "okay"; /* DTV-USB-0a */
+	/*
+	 * SuperSpeed and CIO on USB-C port 1 (left front). The windows are
+	 * ATC1's at this ATC's base: J604 ADT atc-phy0 0x403000000/0x58000 and
+	 * 0x400000000/0x1000000, usb-drd0 0x402a84000 (the same values as the
+	 * J713 ATC0). The display crossbar at core + 0x4c000 (atc0-dpxbar) is
+	 * left to its own driver. Calibration comes from the boot loader.
+	 */
+	reg = <0x4 0x02a90000 0x0 0x4000>,
+	      <0x4 0x02a84000 0x0 0x4000>,
+	      <0x4 0x03000000 0x0 0x24000>,
+	      <0x4 0x00000000 0x0 0x8000>,
+	      <0x4 0x00020000 0x0 0x4000>,
+	      <0x4 0x03044000 0x0 0x4000>,
+	      <0x4 0x03050000 0x0 0x4000>;
+	reg-names = "usb2phy", "pipehandler", "core", "axi2af", "lioa",
+		    "fabric", "common-config";
 
 	ports {
 		#address-cells = <1>;
@@ -560,6 +576,9 @@
 
 &dwc3_0 {
 	dr_mode = "host";
+	maximum-speed = "super-speed";
+	phys = <&atcphy0 PHY_TYPE_USB2>, <&atcphy0 PHY_TYPE_USB3>;
+	phy-names = "usb2-phy", "usb3-phy";
 	status = "okay"; /* DTV-USB-0b */
 
 	ports {
@@ -578,9 +597,9 @@
 &atcphy1 {
 	status = "okay"; /* DTV-USB-1a */
 	/*
-	 * SuperSpeed on USB-C port 2 (left rear) only: the ATC block the J713
-	 * qualified. All seven windows lie inside this J604's own ADT atc-phy1
-	 * and usb-drd1 ranges; the display crossbar at core + 0x4c000
+	 * SuperSpeed on USB-C port 2 (left rear), the ATC block the J713
+	 * qualified first. All seven windows lie inside this J604's own ADT
+	 * atc-phy1 and usb-drd1 ranges; the display crossbar at core + 0x4c000
 	 * (atc1-dpxbar) is left to its own driver. The calibration comes from
 	 * the boot loader (apple,tunable-usb3-*, lane0/1-usb).
 	 */
@@ -637,6 +656,21 @@
 
 &atcphy3 {
 	status = "okay";
+	/*
+	 * SuperSpeed and CIO on USB-C port 4 (right). The windows are ATC1's
+	 * at this ATC's base: J604 ADT atc-phy3 0x41b000000/0x58000 and
+	 * 0x418000000/0x1000000, usb-drd3 0x41aa84000. The display crossbar at
+	 * core + 0x4c000 (atc3-dpxbar) is left to its own driver.
+	 */
+	reg = <0x4 0x1aa90000 0x0 0x4000>,
+	      <0x4 0x1aa84000 0x0 0x4000>,
+	      <0x4 0x1b000000 0x0 0x24000>,
+	      <0x4 0x18000000 0x0 0x8000>,
+	      <0x4 0x18020000 0x0 0x4000>,
+	      <0x4 0x1b044000 0x0 0x4000>,
+	      <0x4 0x1b050000 0x0 0x4000>;
+	reg-names = "usb2phy", "pipehandler", "core", "axi2af", "lioa",
+		    "fabric", "common-config";
 
 	ports {
 		#address-cells = <1>;
@@ -661,6 +695,9 @@
 
 &dwc3_3 {
 	dr_mode = "host";
+	maximum-speed = "super-speed";
+	phys = <&atcphy3 PHY_TYPE_USB2>, <&atcphy3 PHY_TYPE_USB3>;
+	phy-names = "usb2-phy", "usb3-phy";
 	status = "okay";
 
 	ports {
