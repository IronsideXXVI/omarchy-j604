From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Thu, 5 Nov 2026 12:07:51 -0500
Subject: [PATCH] dt-bindings: power: apple,pmc: Add display pipe interface
 enables

On T8132 a display pipe votes for memory bandwidth and for a faster
display clock through two PMC interfaces: bandwidth request (BWR) and
boost. Each interface has an enable word with one bit per agent, and the
PMC ignores the votes of a pipe whose bits are clear. macOS sets a pipe's
two bits when the pipe's SYS power state powers on, and clears them
before it powers off.

Describe such a pair of bits as an interface-* child node of the PMC,
provided as a power domain whose parent is the power state the enables
need. The bits are set after the parent powers on and cleared before it
powers off. Only the T8132 PMC has these words, so other PMCs may not
have interface nodes.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 22344bc0a7e473670463e6ccf27c0e74affd36d4)
[j604: binding reg description conflict resolved by hand into the a15y items form (T8132 BWR/boost words sentence kept)]
---
 .../devicetree/bindings/power/apple,pmc.yaml  | 75 ++++++++++++++++++-
 1 file changed, 74 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/power/apple,pmc.yaml b/Documentation/devicetree/bindings/power/apple,pmc.yaml
index 6cad221048..50e4ccc091 100644
--- a/Documentation/devicetree/bindings/power/apple,pmc.yaml
+++ b/Documentation/devicetree/bindings/power/apple,pmc.yaml
@@ -34,7 +34,8 @@ properties:
       - description: Perf-state floor words of the voter agents
       - description: |
           Per-agent words holding the floor the PMC honours for each agent,
-          and per-rail interface enable words
+          and per-rail interface enable words; on T8132 the rails block also
+          holds the bandwidth request and boost interface enable words
       - description: The cluster enable control word followed by its status word
 
   reg-names:
@@ -164,6 +165,43 @@ patternProperties:
       - '#power-domain-cells'
       - apple,cluster-bit
 
+  '^interface-[a-z0-9-]+$':
+    type: object
+    description: |
+      A display pipe's interface enables, provided as a power domain. The
+      bandwidth request (BWR) and boost interfaces each have an enable word
+      with one bit per agent, and the PMC ignores the pipe's bandwidth and
+      boost votes while its bits are clear. Both bits are set after the
+      parent domain powers on, and cleared before it powers off.
+    additionalProperties: false
+
+    properties:
+      label:
+        description: Name of the power domain.
+
+      '#power-domain-cells':
+        const: 0
+
+      power-domains:
+        maxItems: 1
+        description: Domain that must be powered while the enables are set.
+
+      apple,bwr-bit:
+        $ref: /schemas/types.yaml#/definitions/uint32
+        maximum: 31
+        description: Bit of the pipe in the BWR interface enable word.
+
+      apple,boost-bit:
+        $ref: /schemas/types.yaml#/definitions/uint32
+        maximum: 31
+        description: Bit of the pipe in the boost interface enable word.
+
+    required:
+      - '#power-domain-cells'
+      - power-domains
+      - apple,bwr-bit
+      - apple,boost-bit
+
   '^performance-controller@[0-9a-f]+$':
     type: object
     description: The host performance controller's voter agent.
@@ -192,6 +230,17 @@ required:
   - reg
   - reg-names
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          not:
+            contains:
+              const: apple,t8132-pmc
+    then:
+      patternProperties:
+        '^interface-[a-z0-9-]+$': false
+
 additionalProperties: false
 
 examples:
@@ -230,3 +279,27 @@ examples:
             };
         };
     };
+
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        power-management@382800000 {
+            compatible = "apple,t8132-pmc";
+            reg = <0x3 0x82800000 0x0 0x10000>,
+                  <0x3 0x828aa000 0x0 0x3000>;
+            reg-names = "voters", "rails";
+            #address-cells = <1>;
+            #size-cells = <0>;
+            apple,static-voters = <3>;
+
+            interface-dispext0 {
+                label = "dispext0-interface";
+                #power-domain-cells = <0>;
+                power-domains = <&ps_dispext0_sys>;
+                apple,bwr-bit = <3>;
+                apple,boost-bit = <1>;
+            };
+        };
+    };
