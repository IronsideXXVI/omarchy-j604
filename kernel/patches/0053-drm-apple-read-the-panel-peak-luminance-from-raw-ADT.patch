From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 08:52:57 +0000
Subject: [PATCH] drm/apple: read the panel peak luminance from raw ADT

The /backlight node of the Apple device tree also carries LmaxProduct,
the peak luminance of the panel in 16.16 nits. On the desktop 26.x
firmware the driver asks the DCP for the same peak (A128); the T8132
backend has no such query yet, so read it from the ADT with the EDR
headroom.

J604 runtime ADT (2026-11-05): LmaxProduct 1600 nits next to
EDRPotentialHeadroom 16.0 (and LmidProduct 140, user-accessible maximum
600 nits). A KUnit case covers the property and its absence.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
[j604: k610 drm sync: conflicts with Aurora dcp-panel-adt.{c,h} (identity, dimensions, found); the a15y header comment is not carried, and the EDRPotentialHeadroom branch gets braces for the new LmaxProduct branch.]
---
 drivers/gpu/drm/apple/dcp-panel-adt-test.c | 21 ++++++++++++++++++++-
 drivers/gpu/drm/apple/dcp-panel-adt.c      |  5 ++++-
 drivers/gpu/drm/apple/dcp-panel-adt.h      |  2 ++
 3 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-panel-adt-test.c b/drivers/gpu/drm/apple/dcp-panel-adt-test.c
index 76d46f4c23..076e310a5c 100644
--- a/drivers/gpu/drm/apple/dcp-panel-adt-test.c
+++ b/drivers/gpu/drm/apple/dcp-panel-adt-test.c
@@ -66,6 +66,7 @@ struct adt_spec {
 	int matrix;		/* 0: none, else the matrix version */
 	bool singular;
 	u32 headroom;		/* 0: no EDRPotentialHeadroom */
+	u32 lmax;		/* 0: no LmaxProduct */
 	bool gamut_in_child;	/* the target one level too deep */
 };
 
@@ -92,10 +93,12 @@ static size_t adt_build(struct adt_buf *b, const struct adt_spec *s)
 	if (s->matrix)
 		adt_matrix(b, s->matrix, s->singular);
 
-	adt_node(b, 1 + !!s->headroom, 0);
+	adt_node(b, 1 + !!s->headroom + !!s->lmax, 0);
 	adt_name(b, "backlight");
 	if (s->headroom)
 		adt_u32(b, "EDRPotentialHeadroom", s->headroom);
+	if (s->lmax)
+		adt_u32(b, "LmaxProduct", s->lmax);
 	return b->len;
 }
 
@@ -119,6 +122,21 @@ static void panel_adt_p3_and_headroom(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, panel.edr_potential_headroom, 16U << 16);
 }
 
+/* The J604 /backlight values: a 1600 nit peak at a potential headroom of 16. */
+static void panel_adt_peak(struct kunit *test)
+{
+	const struct adt_spec s = { .gamut = "P3", .matrix = 1, .headroom = 16 << 16,
+				    .lmax = 1600 << 16 };
+	const struct adt_spec none = { .gamut = "P3", .matrix = 1 };
+	struct dcp_panel_adt panel;
+
+	adt_parse(test, &s, &panel);
+	KUNIT_EXPECT_EQ(test, panel.lmax_product, 1600U << 16);
+	KUNIT_EXPECT_EQ(test, panel.edr_potential_headroom, 16U << 16);
+	adt_parse(test, &none, &panel);
+	KUNIT_EXPECT_EQ(test, panel.lmax_product, 0U);
+}
+
 static void panel_adt_srgb(struct kunit *test)
 {
 	const struct adt_spec s = { .gamut = "sRGB", .matrix = 1 };
@@ -181,6 +199,7 @@ static void panel_adt_malformed_tree(struct kunit *test)
 
 static struct kunit_case panel_adt_cases[] = {
 	KUNIT_CASE(panel_adt_p3_and_headroom),
+	KUNIT_CASE(panel_adt_peak),
 	KUNIT_CASE(panel_adt_srgb),
 	KUNIT_CASE(panel_adt_target_needs_a_valid_v1_matrix),
 	KUNIT_CASE(panel_adt_unknown_or_misplaced_target),
diff --git a/drivers/gpu/drm/apple/dcp-panel-adt.c b/drivers/gpu/drm/apple/dcp-panel-adt.c
index e3d360a536..22bdb8fcc1 100644
--- a/drivers/gpu/drm/apple/dcp-panel-adt.c
+++ b/drivers/gpu/drm/apple/dcp-panel-adt.c
@@ -176,8 +176,11 @@ static int dcp_adt_node(struct dcp_adt_cursor *c, struct dcp_panel_adt *panel,
 			matrix_valid = !matrix_seen &&
 				dcp_adt_calibration_matrix(prop + 36, size);
 			matrix_seen = true;
-		} else if (backlight && !strcmp(name, "EDRPotentialHeadroom") && size == 4)
+		} else if (backlight && !strcmp(name, "EDRPotentialHeadroom") && size == 4) {
 			panel->edr_potential_headroom = get_unaligned_le32(prop + 36);
+		} else if (backlight && !strcmp(name, "LmaxProduct") && size == 4) {
+			panel->lmax_product = get_unaligned_le32(prop + 36);
+		}
 		c->pos += 36 + ALIGN((size_t)size, 4);
 	}
 	if (product)
diff --git a/drivers/gpu/drm/apple/dcp-panel-adt.h b/drivers/gpu/drm/apple/dcp-panel-adt.h
index 855adaf507..c15d119f7d 100644
--- a/drivers/gpu/drm/apple/dcp-panel-adt.h
+++ b/drivers/gpu/drm/apple/dcp-panel-adt.h
@@ -10,6 +10,8 @@ struct dcp_panel_adt {
 	u32 width_mm, height_mm;
 	/* /backlight EDRPotentialHeadroom, 16.16; 0 if absent */
 	u32 edr_potential_headroom;
+	/* /backlight LmaxProduct, the panel peak in 16.16 nits; 0 if absent */
+	u32 lmax_product;
 	/* /product target, only when its calibration matrix is also valid */
 	enum dcp_panel_gamut gamut;
 	bool found;
