From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 06:05:49 +0000
Subject: [PATCH] media: apple: isp: offer the T8132 camera's
 lens-centred wide window

macOS reads its video on the J604 from a 2688x1738 window of the IMX958's
config 6, at (176, 494): every frame it delivers reports that readout.
The window is centred horizontally on config 6's window and vertically
on the lens's optical centre, and shows 1.4 times config 5's field. The
wide view so far uses the full-width 3040x1710 crop, centred on the
window instead.

Make the wide view's window selectable with the new apple_isp.wide_window
parameter (writable at runtime, read at stream start): 0, the default,
keeps the 3040x1710 crop; 1 takes the lens-centred window. Every stream's
crop is cut from the selected window with the call-size rule, never
enlarging.

With the wide view, also list 1760x1328 and 1552x1552, the 4:3 and square
sizes macOS offers for this camera: both need more than config 5's 1080
rows and fit either window. The portrait 1328x1760 and 1080x1920 would
need enlarging from a 1738-row window and are not offered.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/media/platform/apple/isp/isp-cam.c | 82 +++++++++++++++++-----
 drivers/media/platform/apple/isp/isp-drv.h |  2 +
 2 files changed, 65 insertions(+), 19 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index ae72531e32..06145210e6 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -560,10 +560,35 @@ static const struct isp_preset isp_wide_source = {
 	.output_dim = { 1920, 1080 },
 };
 
+/*
+ * The window macOS reads from config 6 for its video on the J604: each of
+ * its frames reports a 2688x1738 sensor readout at (176, 494). That is
+ * centred horizontally on config 6's window and vertically on the lens's
+ * optical centre (1526.6, 1360.2), not on the window's centre: 1.4 times
+ * config 5's field. Selected with wide_window=1.
+ */
+static const struct isp_preset isp_lens_source = {
+	.index = 6,
+	.input_dim = { 3040, 5760 },
+	.crop_offset = { 176, 494 },
+	.crop_size = { 2688, 1738 },
+	.output_dim = { 1920, 1080 },
+};
+
 static bool wide_view;
 module_param(wide_view, bool, 0644);
 MODULE_PARM_DESC(wide_view,
-		 "T8132: start the next streams from the wider sensor config and offer 2560x1440 (default: off)");
+		 "T8132: start the next streams from the wider sensor config and offer 2560x1440, 1760x1328 and 1552x1552 (default: off)");
+
+static unsigned int wide_window;
+module_param(wide_window, uint, 0644);
+MODULE_PARM_DESC(wide_window,
+		 "T8132 wide view window: 0 = the full-width 3040x1710 crop, 1 = the 2688x1738 window centred on the lens (default: 0)");
+
+static const struct isp_preset *isp_wide_window(void)
+{
+	return READ_ONCE(wide_window) == 1 ? &isp_lens_source : &isp_wide_source;
+}
 
 bool apple_isp_wide_view(struct apple_isp *isp)
 {
@@ -588,36 +613,50 @@ static bool isp_preset_narrow(const struct isp_preset *preset)
 }
 
 /*
- * Add 2560x1440 from config 6, offered only with the wide view, after the
- * device tree presets so that the default format does not change.
+ * The sizes only config 6 can serve without enlarging: 2560x1440, and the
+ * 4:3 and square sizes macOS lists for this camera, which need more than
+ * config 5's 1080 rows. Offered only with the wide view, after the device
+ * tree presets so that the default format does not change; the crop is cut
+ * from the selected window at stream start.
  */
+static const struct coord isp_wide_sizes[] = {
+	{ 2560, 1440 }, { 1760, 1328 }, { 1552, 1552 },
+};
+
 int apple_isp_add_wide_presets(struct apple_isp *isp)
 {
-	struct isp_preset *presets;
-	unsigned int num = isp->num_presets;
+	struct isp_preset *presets, cut;
+	unsigned int num = isp->num_presets, n = num;
 	bool narrow = false;
 
 	if (!isp->hw->imx958_wide_cfg6)
 		return 0;
 
-	for (unsigned int i = 0; i < num; i++) {
-		if (isp->presets[i].output_dim.x == 2560 &&
-		    isp->presets[i].output_dim.y == 1440)
-			return 0;
+	for (unsigned int i = 0; i < num; i++)
 		narrow |= isp_preset_narrow(&isp->presets[i]);
-	}
 	if (!narrow)
 		return 0;
 
-	presets = devm_kcalloc(isp->dev, num + 1, sizeof(*presets), GFP_KERNEL);
+	presets = devm_kcalloc(isp->dev, num + ARRAY_SIZE(isp_wide_sizes),
+			       sizeof(*presets), GFP_KERNEL);
 	if (!presets)
 		return -ENOMEM;
 	memcpy(presets, isp->presets, num * sizeof(*presets));
-	presets[num] = isp_wide_source;
-	presets[num].output_dim = (struct coord){ 2560, 1440 };
-	presets[num].wide_only = true;
+	for (unsigned int k = 0; k < ARRAY_SIZE(isp_wide_sizes); k++) {
+		bool have = false;
+
+		for (unsigned int i = 0; i < n; i++)
+			have |= presets[i].output_dim.x == isp_wide_sizes[k].x &&
+				presets[i].output_dim.y == isp_wide_sizes[k].y;
+		if (have || !isp_size_from_crop(&isp_wide_source,
+						isp_wide_sizes[k], &cut))
+			continue;
+		presets[n] = cut;
+		presets[n].wide_only = true;
+		n++;
+	}
 	isp->presets = presets;
-	isp->num_presets = num + 1;
+	isp->num_presets = n;
 	return 0;
 }
 
@@ -646,22 +685,27 @@ static void isp_resolve_stream_preset(struct apple_isp *isp,
 	}
 
 	isp->stream_preset = *preset;
-	if (apple_isp_wide_view(isp) && isp_preset_narrow(preset) &&
-	    isp_size_from_crop(&isp_wide_source, preset->output_dim, &wide)) {
+	if (((apple_isp_wide_view(isp) && isp_preset_narrow(preset)) ||
+	     preset->wide_only) &&
+	    isp_size_from_crop(isp_wide_window(), preset->output_dim, &wide)) {
 		isp->stream_preset = wide;
 		use_wide = true;
 	}
 
-	if (use_wide != isp->streamed_wide)
+	if (use_wide != isp->streamed_wide ||
+	    (use_wide && isp->stream_preset.crop_offset.x != isp->streamed_crop_x))
 		dev_info(isp->dev,
-			 "wide view %s: %ux%u from sensor config %u, crop %ux%u\n",
+			 "wide view %s: %ux%u from sensor config %u, crop %u,%u %ux%u\n",
 			 use_wide ? "on" : "off",
 			 isp->stream_preset.output_dim.x,
 			 isp->stream_preset.output_dim.y,
 			 isp->stream_preset.index,
+			 isp->stream_preset.crop_offset.x,
+			 isp->stream_preset.crop_offset.y,
 			 isp->stream_preset.crop_size.x,
 			 isp->stream_preset.crop_size.y);
 	isp->streamed_wide = use_wide;
+	isp->streamed_crop_x = use_wide ? isp->stream_preset.crop_offset.x : 0;
 }
 
 static int isp_ch_cache_sensor_info(struct apple_isp *isp, u32 ch)
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 22c2633bd7..0985d6e8f6 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -458,6 +458,8 @@ struct apple_isp {
 	struct isp_preset stream_preset;
 	/* the previous stream ran from the wide sensor config */
 	bool streamed_wide;
+	/* and the horizontal offset of its crop (which wide window) */
+	u32 streamed_crop_x;
 	/* measurement overrides set in debugfs, read at stream start */
 	struct isp_preset stream_config;
 	bool stream_config_set;
-- 
2.43.0

