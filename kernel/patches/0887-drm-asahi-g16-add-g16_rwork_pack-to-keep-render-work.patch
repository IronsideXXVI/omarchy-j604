@@ -7,7 +7,7 @@
 
 use super::{
     command::Command,
-    object::{Factory, Objects},
+    object::{Factory, FwObject, Objects},
     pools::{Allocator, AllocatorRefs, PbEpoch, PoolSet},
     slots::{ComputeSlot, PassSlot},
     vm::VmState,
@@ -109,6 +109,8 @@ fn deref(&self) -> &Self::Target {
 pub(crate) struct RenderInner {
     pub(crate) passes: KVec<PassSlot>,
     pub(crate) pools: PoolSet,
+    /// `g16_rwork_pack`: the units' TA and FS work blocks, later units' included.
+    work_pack: Option<Arc<FwObject>>,
     /// Units built later (`g16_resident_lazy`), at their unit index; dropped before the bind.
     ext: [SetOnce<KBox<ExtUnit>>; super::hw::sizes::RENDER_UNITS],
     /// A worker is building the next unit (`g16_resident_lazy` 2).
@@ -135,9 +137,23 @@ fn new(
             super::params::resident_units()
         };
         let compact = super::params::resident_compact();
+        let work_pack = if super::params::rwork_pack() {
+            Some(super::graph::alloc_work(
+                &mut objects,
+                super::hw::client::RWORK_PACK_SIZE as usize,
+                super::hw::client::RWORK_PACK,
+                0,
+                super::hw::tuning::FWC_TA | super::hw::tuning::FWC_FS,
+            )?)
+        } else {
+            None
+        };
         let mut passes = KVec::with_capacity(units, GFP_KERNEL)?;
         for k in 0..units {
-            passes.push(PassSlot::new(&mut objects, k as u64, 1, compact)?, GFP_KERNEL)?;
+            passes.push(
+                PassSlot::new(&mut objects, k as u64, 1, compact, work_pack.as_ref())?,
+                GFP_KERNEL,
+            )?;
         }
         let pools = PoolSet::new(&mut objects, units, compact)?;
         objects.finish_private()?;
@@ -145,6 +161,7 @@ fn new(
             Self(crate::cleanup::Deferred::new(RenderInner {
                 passes,
                 pools,
+                work_pack,
                 ext: [const { SetOnce::new() }; super::hw::sizes::RENDER_UNITS],
                 building: AtomicBool::new(false),
                 tpc_dirty: [const { AtomicU64::new(0) }; super::hw::sizes::RENDER_UNITS],
@@ -166,7 +183,7 @@ fn extend(&self, factory: &Factory, vm: &mmu::Vm, k: usize) -> Result {
         let start = super::engine::now_ns();
         let compact = super::params::resident_compact();
         let mut objects = factory.objects(vm);
-        let pass = PassSlot::new(&mut objects, k as u64, 1, compact)?;
+        let pass = PassSlot::new(&mut objects, k as u64, 1, compact, self.work_pack.as_ref())?;
         let alloc = PoolSet::build_unit(&mut objects, k, compact)?;
         objects.finish_private()?;
         let unit = KBox::new(
diff --git a/drivers/gpu/drm/asahi/g16/slots.rs b/drivers/gpu/drm/asahi/g16/slots.rs
index a77ac76afd..eee7129e69 100644
--- a/drivers/gpu/drm/asahi/g16/slots.rs
+++ b/drivers/gpu/drm/asahi/g16/slots.rs
@@ -186,6 +186,9 @@ fn scrub(&self) -> Result {
 
 /// One render pass slot.
 pub(crate) struct PassSlot {
+    /// `g16_rwork_pack`: the shared buffer and the offsets of this slot's TA and FS work
+    /// blocks; `ta_work` / `fs_work` are then unused.
+    pub(crate) work_pack: Option<(Arc<FwObject>, usize, usize)>,
     pub(crate) aux: Arc<FwObject>,
     pub(crate) pre: KVec<Arc<FwObject>>,
     pub(crate) tpc: Arc<FwObject>,
@@ -211,7 +214,13 @@ pub(crate) struct PassSlot {
 
 impl PassSlot {
     /// Allocates pass slot `i`'s objects, with their client leaf classes.
-    pub(crate) fn new(o: &mut Objects, i: u64, pre_records: u32, compact: bool) -> Result<Self> {
+    pub(crate) fn new(
+        o: &mut Objects,
+        i: u64,
+        pre_records: u32,
+        compact: bool,
+        pack: Option<&Arc<FwObject>>,
+    ) -> Result<Self> {
         let sh = Class::Shared;
         // Qualified slots 0/1 at i strides; resident slots (i >= 2) in their own window, a
         // compact one (g16_resident_compact) with a 1 MiB TPC and a 1 MiB tilemap.
@@ -319,7 +328,15 @@ pub(crate) fn new(o: &mut Objects, i: u64, pre_records: u32, compact: bool) -> R
             client::TA_WORK_OFF as usize,
             tuning::FWC_TA,
         )?;
+        let at = i as usize;
         Ok(Self {
+            work_pack: pack.map(|p| {
+                (
+                    p.clone(),
+                    at * client::RWORK_TA_STRIDE,
+                    client::RWORK_FS_OFF + at * client::RWORK_FS_STRIDE,
+                )
+            }),
             aux,
             pre,
             tpc,
@@ -355,8 +372,16 @@ fn scrub(
     ) -> Result {
         let _ = pre_records;
 
-        self.ta_work.fill(0, 0, ta::WORK_SIZE)?;
-        self.fs_work.fill(0, 0, fs::WORK_SIZE)?;
+        match &self.work_pack {
+            Some((pack, ta_at, fs_at)) => {
+                pack.fill(*ta_at, 0, ta::WORK_SIZE)?;
+                pack.fill(*fs_at, 0, fs::WORK_SIZE)?;
+            }
+            None => {
+                self.ta_work.fill(0, 0, ta::WORK_SIZE)?;
+                self.fs_work.fill(0, 0, fs::WORK_SIZE)?;
+            }
+        }
         self.ta_seq.fill(0, 0, ta::SEQ_OBJECT)?;
         self.fs_seq.fill(0, 0, fs::SEQ_OBJECT)?;
         self.ta_scratch.fill(0, 0, 0x10000)?;
@@ -377,13 +402,59 @@ fn scrub(
         Ok(())
     }
 
+    /// Firmware VA of the TA work block.
+    pub(crate) fn ta_va(&self) -> u64 {
+        match &self.work_pack {
+            Some((pack, ta_at, _)) => pack.va + *ta_at as u64,
+            None => self.ta_work.va,
+        }
+    }
+    /// Firmware VA of the FS work block.
+    pub(crate) fn fs_va(&self) -> u64 {
+        match &self.work_pack {
+            Some((pack, _, fs_at)) => pack.va + *fs_at as u64,
+            None => self.fs_work.va,
+        }
+    }
+    fn ta_gva(&self) -> u64 {
+        match &self.work_pack {
+            Some((pack, ta_at, _)) => pack.lower_gva.map_or(0, |g| g + *ta_at as u64),
+            None => self.ta_work.lower_gva.unwrap_or(0),
+        }
+    }
+    fn fs_gva(&self) -> u64 {
+        match &self.work_pack {
+            Some((pack, _, fs_at)) => pack.lower_gva.map_or(0, |g| g + *fs_at as u64),
+            None => self.fs_work.lower_gva.unwrap_or(0),
+        }
+    }
+    /// Writes the TA and FS work images where the slot's records find them.
+    pub(crate) fn write_work(&self, ta_image: &[u8], fs_image: &[u8]) -> Result {
+        match &self.work_pack {
+            Some((pack, ta_at, fs_at)) => {
+                pack.write(*ta_at, ta_image)?;
+                pack.write(*fs_at, fs_image)
+            }
+            None => {
+                self.ta_work.write(0, ta_image)?;
+                self.fs_work.write(0, fs_image)
+            }
+        }
+    }
+    /// A u64 of the TA work block.
+    pub(crate) fn ta_r64(&self, offset: usize) -> Result<u64> {
+        match &self.work_pack {
+            Some((pack, ta_at, _)) => pack.r64(*ta_at + offset),
+            None => self.ta_work.r64(offset),
+        }
+    }
     /// The addresses the render encoders name.
     pub(crate) fn refs(&self) -> PassRefs {
         PassRefs {
-            ta_work: self.ta_work.va,
-            ta_work_gva: self.ta_work.lower_gva.unwrap_or(0),
-            fs_work: self.fs_work.va,
-            fs_work_gva: self.fs_work.lower_gva.unwrap_or(0),
+            ta_work: self.ta_va(),
+            ta_work_gva: self.ta_gva(),
+            fs_work: self.fs_va(),
+            fs_work_gva: self.fs_gva(),
             ta_seq: self.ta_seq.va,
             fs_seq: self.fs_seq.va,
             scene: self.scene.va,
