@@ -2203,8 +2203,7 @@ fn prefix_render(
             init_buffer,
             &mut scratch.scene[..],
         );
-        p.ta_work.write(0, &scratch.ta[..])?;
-        p.fs_work.write(0, &scratch.fs[..])?;
+        p.write_work(&scratch.ta[..], &scratch.fs[..])?;
         p.ta_seq.write(0, &scratch.tas[..])?;
         p.fs_seq.write(0, &scratch.fss[..])?;
         p.scene.write(0, &scratch.scene[..])?;
@@ -2259,7 +2258,7 @@ fn prefix_render(
             pf.ta_head = (pf.ta_head + 1) % cap;
             super::poll::RENDER_CHAINED.fetch_add(1, core::sync::atomic::Ordering::Relaxed);
         }
-        r.ring[0].w64(8 * pf.ta_head as usize, p.ta_work.va)?;
+        r.ring[0].w64(8 * pf.ta_head as usize, p.ta_va())?;
         pf.ta_head = (pf.ta_head + 1) % cap;
         // g16_render_quiet 2: no FS-ring barrier record; the FS follows its TA by the
         // firmware's own pairing, as macOS's records have no such record.
@@ -2267,7 +2266,7 @@ fn prefix_render(
             r.ring[1].w64(8 * pf.fs_head as usize, p.own_barrier.va)?;
             pf.fs_head = (pf.fs_head + 1) % cap;
         }
-        r.ring[1].w64(8 * pf.fs_head as usize, p.fs_work.va)?;
+        r.ring[1].w64(8 * pf.fs_head as usize, p.fs_va())?;
         pf.fs_head = (pf.fs_head + 1) % cap;
         pf.renders = 1;
         pf.draw = draw;
diff --git a/drivers/gpu/drm/asahi/g16/hw.rs b/drivers/gpu/drm/asahi/g16/hw.rs
index 8aa796c629..27290e5572 100644
--- a/drivers/gpu/drm/asahi/g16/hw.rs
+++ b/drivers/gpu/drm/asahi/g16/hw.rs
@@ -274,6 +274,13 @@ pub(crate) const fn compute_small(k: u64) -> u64 {
     /// per-unit work pages of all 32 units.
     pub(crate) const CWORK_PACK: u64 = WORK_PAGE + 32 * CWORK_STRIDE;
     pub(crate) const CWORK_PACK_SIZE: u64 = 0x14000;
+    /// `g16_rwork_pack`: every render unit's TA work block (`RWORK_TA_STRIDE` apart) and FS work
+    /// block (`RWORK_FS_STRIDE` apart, from `RWORK_FS_OFF`), after the compute pack.
+    pub(crate) const RWORK_PACK: u64 = CWORK_PACK + CWORK_PACK_SIZE;
+    pub(crate) const RWORK_PACK_SIZE: u64 = 0x1c000;
+    pub(crate) const RWORK_TA_STRIDE: usize = 0x940;
+    pub(crate) const RWORK_FS_OFF: usize = 0xa700;
+    pub(crate) const RWORK_FS_STRIDE: usize = 0xcc0;
 
     // Render allocator units contain one 32 MiB UMA pool and its persistent lists. Units
     // 0 and 1 keep the qualified placement; resident units (k >= 2, `g16_resident`) place
@@ -429,8 +436,13 @@ pub(crate) mod sizes {
                 <= super::client::CWORK_PACK
             && COMPUTE_UNITS_MAX as u64 * super::super::fw::work::compute::BLOCK as u64
                 <= super::client::CWORK_PACK_SIZE
-            && super::client::CWORK_PACK + super::client::CWORK_PACK_SIZE
+            && super::client::RWORK_PACK + super::client::RWORK_PACK_SIZE
                 <= super::client::COMPUTE_SMALL_BASE
+            && RENDER_UNITS * super::client::RWORK_TA_STRIDE <= super::client::RWORK_FS_OFF
+            && super::client::RWORK_FS_OFF + RENDER_UNITS * super::client::RWORK_FS_STRIDE
+                <= super::client::RWORK_PACK_SIZE as usize
+            && super::super::fw::work::ta::WORK_SIZE <= super::client::RWORK_TA_STRIDE
+            && super::super::fw::work::fs::WORK_SIZE <= super::client::RWORK_FS_STRIDE
             && super::client::compute_small(COMPUTE_UNITS_MAX as u64 - 1)
                 + super::client::COMPUTE_SMALL_STRIDE
                 <= super::client::compute_base(0)
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 98cbfd304c..aa8e3b418a 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -1373,6 +1373,38 @@ pub(crate) fn cwork_pack() -> bool {
     "G16: keep the compute units' work blocks 0x900 apart in one buffer, as macOS lays out its compute commands (default 0; latched at the first compute units built, set it as a module option)"
 );
 
+/// Storage of `g16_rwork_pack` (0644, default 0; latched at its first read).
+static RWORK_PACK: AtomicU32 = AtomicU32::new(0);
+/// 0 until latched, then 1 (off) or 2 (on).
+static RWORK_PACK_LATCH: AtomicU32 = AtomicU32::new(0);
+
+/// Whether a VM's render units keep their TA work blocks 0x940 apart and their FS work blocks
+/// 0xcc0 apart in one buffer, as the macOS driver lays out its render commands, instead of a
+/// page per pass slot. Read once, at the first render units a VM builds, so every VM of the
+/// boot is built the same way.
+pub(crate) fn rwork_pack() -> bool {
+    let l = RWORK_PACK_LATCH.load(Ordering::Acquire);
+    if l != 0 {
+        return l == 2;
+    }
+    let v = if RWORK_PACK.load(Ordering::Relaxed) != 0 {
+        2
+    } else {
+        1
+    };
+    let _ = RWORK_PACK_LATCH.compare_exchange(0, v, Ordering::AcqRel, Ordering::Acquire);
+    RWORK_PACK_LATCH.load(Ordering::Acquire) == 2
+}
+
+live_u32_param!(
+    RWORK_PACK_PARAM,
+    RWORK_PACK_PARMTYPE,
+    RWORK_PACK_PARM,
+    RWORK_PACK,
+    "g16_rwork_pack",
+    "G16: keep the render units' TA and FS work blocks back to back in one buffer, as macOS lays out its render commands (default 0; latched at the first render units built, set it as a module option)"
+);
+
 /// Storage of `g16_ktrace_keep` (runtime 0644, default 0).
 static KTRACE_KEEP: AtomicU32 = AtomicU32::new(0);
 
diff --git a/drivers/gpu/drm/asahi/g16/resources.rs b/drivers/gpu/drm/asahi/g16/resources.rs
index 8e908a4b06..5efcabca87 100644
--- a/drivers/gpu/drm/asahi/g16/resources.rs
