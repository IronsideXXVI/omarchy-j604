 drivers/gpu/drm/asahi/g16/engine.rs    |  9 ++-
 drivers/gpu/drm/asahi/g16/hw.rs        | 14 ++++-
 drivers/gpu/drm/asahi/g16/params.rs    | 32 ++++++++++
 drivers/gpu/drm/asahi/g16/resources.rs | 23 ++++++-
 drivers/gpu/drm/asahi/g16/slots.rs     | 85 +++++++++++++++++++++++---
 5 files changed, 147 insertions(+), 16 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
