From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 05:23:02 +0000
Subject: [PATCH] media: apple: isp: use macOS's T8132 auto exposure
 stability thresholds

macOS sets the auto exposure stability threshold to 16 and the
threshold to return to stable to 8 for every camera session on the
J604 (M4 MacBook Pro 14", T8132), where the driver sends 32 and 20 on
every SoC. Read from the ISP firmware's own command log while macOS
streamed the camera unlocked in Photo Booth.

Give the per-SoC data the two thresholds, set them for T8132 and send
them by default. macos_ae_stability=N gives back 32 and 20; other SoCs
keep 32 and 20.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/media/platform/apple/isp/isp-cam.c | 21 +++++++++++++++++++--
 drivers/media/platform/apple/isp/isp-drv.c |  3 +++
 drivers/media/platform/apple/isp/isp-drv.h |  3 +++
 3 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 87dceb6115..ef00126ce3 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -589,6 +589,15 @@ static const struct isp_preset isp_lens_source = {
 	.output_dim = { 1920, 1080 },
 };
 
+/*
+ * macOS sets this Mac's auto exposure stability thresholds to 16 and 8 for
+ * every camera session; macos_ae_stability=N gives back 32 and 20.
+ */
+static bool macos_ae_stability = true;
+module_param(macos_ae_stability, bool, 0644);
+MODULE_PARM_DESC(macos_ae_stability,
+		 "Use the auto exposure stability thresholds macOS sets on this camera, where known (default: on)");
+
 /*
  * macOS streams every size of this camera from config 6, through the lens
  * window, so that is the default view; wide_view=N gives back config 5's
@@ -1256,6 +1265,7 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 {
 	struct isp_format *fmt = isp_get_format(isp, ch);
 	bool h17 = isp->hw->fw_abi == ISP_FW_ABI_H17;
+	u32 ae_stability, ae_to_stable;
 	int err;
 
 	err = isp_cmd_flicker_sensor_set(isp, 0);
@@ -1366,11 +1376,18 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	if (err)
 		return err;
 
-	err = isp_cmd_ch_ae_stability_set(isp, ch, 32);
+	ae_stability = 32;
+	ae_to_stable = 20;
+	if (READ_ONCE(macos_ae_stability) && isp->hw->ae_stability) {
+		ae_stability = isp->hw->ae_stability;
+		ae_to_stable = isp->hw->ae_stability_to_stable;
+	}
+
+	err = isp_cmd_ch_ae_stability_set(isp, ch, ae_stability);
 	if (err)
 		return err;
 
-	err = isp_cmd_ch_ae_stability_to_stable_set(isp, ch, 20);
+	err = isp_cmd_ch_ae_stability_to_stable_set(isp, ch, ae_to_stable);
 	if (err)
 		return err;
 
diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index 8ca5e6c05a..55a6b0b11e 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -1326,6 +1326,9 @@ static const struct apple_isp_hw apple_isp_hw_t8132 = {
 	.lsc_ideal_percent = 84,
 	/* The ADT's camera node declares auto-low-light-video, as macOS runs it */
 	.auto_low_light = true,
+	/* As macOS sets up each camera session on this Mac */
+	.ae_stability = 16,
+	.ae_stability_to_stable = 8,
 };
 
 /*
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 1acd319d32..34f2971d43 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -311,6 +311,9 @@ struct apple_isp_hw {
 	u16 lsc_ideal_percent;
 	/* H17 firmware that takes the face-detection scene metering setup */
 	bool ae_fd_scene_metering;
+	/* Auto exposure stability thresholds as macOS sets them (0: driver default) */
+	u32 ae_stability;
+	u32 ae_stability_to_stable;
 };
 
 enum isp_sensor_id {
-- 
2.43.0

