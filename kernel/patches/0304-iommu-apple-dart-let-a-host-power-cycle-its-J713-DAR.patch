diff --git a/tools/asahi/dart-cio-owner-tests.c b/tools/asahi/dart-cio-owner-tests.c
new file mode 100644
index 0000000000..5f68b65576
--- /dev/null
+++ b/tools/asahi/dart-cio-owner-tests.c
@@ -0,0 +1,339 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Included after the MMIO fixture and before the actual ownership methods. */
+#include <limits.h>
+#define READ_ONCE(x) (x)
+#define WRITE_ONCE(x, v) ((x) = (v))
+/* Single-threaded fixture: model publication without CPU barriers. */
+#define smp_store_release(p, v) (*(p) = (v))
+#define dma_wmb() \
+	do {      \
+	} while (0)
+#define spin_lock_irqsave(lock, flags) \
+	do {                           \
+		(void)(lock);          \
+		(flags) = 0;           \
+	} while (0)
+#define spin_unlock_irqrestore(lock, flags) \
+	do {                                \
+		(void)(lock);               \
+		(void)(flags);              \
+	} while (0)
+#define APPLE_PS_PROT_SLICE(n) (0x100 + 0x40 * (n))
+#define APPLE_PS_PROT_SLICE_ON BIT(4)
+#define APPLE_DART_WRITER_COUNTED 1
+#define APPLE_DART_WRITER_CLOSED 2
+#define scoped_guard(type, lock) for (int _g = ((void)(lock), 1); _g; _g = 0)
+#define bitmap_fill(map, n) ((void)sizeof(n), memset((map), 0xff, sizeof(map)))
+#define PM_SUSPEND_MEM 3
+static int pm_suspend_target_state = PM_SUSPEND_MEM;
+struct device {
+	int refs;
+};
+struct device_link {};
+struct regmap {
+	u32 value;
+	int fail, fail_read;
+	unsigned int offset;
+};
+struct apple_dart_sleep {
+	int result;
+};
+struct apple_dart_cio;
+struct apple_dart_stream_map;
+struct apple_dart_hw {
+	int (*invalidate_tlb)(struct apple_dart_stream_map *map);
+};
+struct apple_dart {
+	struct device *dev;
+	void *regs;
+	unsigned int num_streams, sleep_writers;
+	bool managed_sids, sleep_closed, commands_gated, cio_active;
+	int managed_lock, lock;
+	const struct apple_dart_hw *hw;
+	struct apple_dart_cio *cio;
+	struct apple_dart_sleep *sleep_record;
+};
+struct apple_dart_stream_map {
+	struct apple_dart *dart;
+	unsigned long sidmap[4];
+};
+static unsigned int invalidations, sleeps;
+static bool fail_flush;
+/* A flush issues commands, so it needs them reopened; it may precede the opening. */
+static int model_invalidate(struct apple_dart_stream_map *map)
+{
+	assert(!map->dart->commands_gated);
+	if (fail_flush)
+		return -ETIMEDOUT;
+	invalidations++;
+	return 0;
+}
+/* The drain of memory-only writers: a hook lets one finish meanwhile. */
+static void (*on_sleep)(void);
+static void usleep_range(unsigned long min, unsigned long max)
+{
+	(void)min;
+	(void)max;
+	sleeps++;
+	if (on_sleep)
+		on_sleep();
+}
+static void (*on_read)(void);
+static const struct apple_dart_hw model_hw = { .invalidate_tlb = model_invalidate };
+static int pm_runtime_resume_and_get(struct device *dev)
+{
+	dev->refs++;
+	return 0;
+}
+static void pm_runtime_put(struct device *dev)
+{
+	assert(dev->refs > 0);
+	dev->refs--;
+}
+static int regmap_read(struct regmap *map, unsigned int off, u32 *value)
+{
+	assert(off == map->offset);
+	if (on_read)
+		on_read();
+	if (map->fail_read)
+		return -EIO;
+	*value = map->value;
+	return 0;
+}
+static int regmap_write(struct regmap *map, unsigned int off, u32 value)
+{
+	assert(off == map->offset);
+	if (map->fail)
+		return -EIO;
+	map->value = value;
+	return 0;
+}
+static int regmap_update_bits(struct regmap *map, unsigned int off, u32 mask,
+			      u32 value)
+{
+	assert(off == map->offset && mask == BIT(4));
+	if (map->fail)
+		return -EIO;
+	map->value = (map->value & ~mask) | value;
+	return 0;
+}
+static struct apple_dart dart;
+static struct device provider, owner;
+static struct regmap gapf;
+static int apple_dart_quiesce_commands(struct device *dev)
+{
+	assert(dev == &provider && dart.sleep_closed && !dart.sleep_writers);
+	dart.commands_gated = true;
+	return 0;
+}
+
+/* Arguments are evaluated: a diagnostic's register reads still happen. */
+static inline void dev_log(void *dev, const char *fmt, ...)
+{
+	(void)dev;
+	(void)fmt;
+}
+#define dev_err(dev, ...) dev_log(dev, __VA_ARGS__)
+#define dev_info(dev, ...) dev_log(dev, __VA_ARGS__)
+/* ACTUAL_OWNER */
+
+static struct apple_dart_cio state;
+static void reset_owner(unsigned int slice, bool partitions)
+{
+	reset(partitions ? 28 : 256, partitions);
+	provider.refs = owner.refs = 0;
+	/* A live DART: its slice enabled, protection on. */
+	gapf = (struct regmap){ .offset = APPLE_PS_PROT_SLICE(slice),
+				.value = BIT(1) | BIT(4) | BIT(7) };
+	/* PCIe-C's software allocator covers 64 of the 256 hardware SIDs. */
+	dart = (struct apple_dart){ .regs = regs,
+				    .num_streams = partitions ? 28 : 64,
+				    .dev = &provider,
+				    .hw = &model_hw,
+				    .cio = &state };
+	state = (struct apple_dart_cio){ .dart = &dart,
+					 .owner = &owner,
+					 .gapf = &gapf,
+					 .slice = slice };
+	invalidations = sleeps = 0;
+	fail_flush = false;
+	on_sleep = on_read = NULL;
+}
+static struct apple_dart dart;
+/* A writer that updates page tables in memory while the DART is closed. */
+static void closed_writer(void)
+{
+	int gate = apple_dart_sleep_writer_get(&dart);
+
+	assert(gate == APPLE_DART_WRITER_CLOSED);
+	apple_dart_sleep_writer_put(&dart, gate);
+}
+static void finish_writer(void)
+{
+	apple_dart_sleep_writer_put(&dart, APPLE_DART_WRITER_CLOSED);
+	on_sleep = NULL;
+}
+int main(void)
+{
+	unsigned int cases = 0;
+	const unsigned int slices[] = { 14, 15, 18, 19 };
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(slices); i++) {
+		reset_owner(slices[i], i % 2);
+		for (unsigned int cycle = 0; cycle < 3; cycle++) {
+			assert(!apple_dart_cio_prepare(&state) &&
+			       provider.refs == 1 && dart.cio_active);
+			assert(apple_dart_cio_prepare(&state) == -EBUSY &&
+			       provider.refs == 1);
+			assert(!apple_dart_cio_off(&state) && state.changed &&
+			       !state.restored);
+			assert(state.saved.streams == (i % 2 ? 28 : 256));
+			assert(dart.commands_gated && dart.sleep_closed &&
+			       gapf.value == (BIT(1) | BIT(7)));
+			lose_power();
+			assert(!apple_dart_cio_on(&state) && state.restored);
+			assert(!dart.commands_gated && !dart.sleep_closed);
+			assert(gapf.value == (BIT(1) | BIT(4) | BIT(7)));
+			check_restored(&state.saved);
+			unsigned int before = writes;
+
+			assert(!apple_dart_cio_on(&state) && writes == before);
+			assert(apple_dart_cio_off(&state) == -EINVAL);
+			assert(!apple_dart_cio_finish(&state) &&
+			       !dart.cio_active && !provider.refs);
+			assert(apple_dart_cio_on(&state) == -EINVAL);
+			assert(apple_dart_cio_finish(&state) == -EINVAL);
+			cases++;
+		}
+	}
+	reset_owner(15, true);
+	assert(!apple_dart_cio_prepare(&state));
+	assert(!apple_dart_cio_on(&state));
+	assert(!apple_dart_cio_finish(&state) && !reads && !writes);
+	cases++;
+	assert(!apple_dart_cio_prepare(&state));
+	assert(apple_dart_sleep_writer_get(&dart) == APPLE_DART_WRITER_COUNTED);
+	assert(apple_dart_cio_off(&state) == -EBUSY && !reads && !writes);
+	apple_dart_sleep_writer_put(&dart, APPLE_DART_WRITER_COUNTED);
+	assert(!apple_dart_cio_finish(&state));
+	cases++;
+	for (unsigned int fault = 0; fault < 4; fault++) {
+		reset_owner(14, false);
+		assert(!apple_dart_cio_prepare(&state));
+		if (fault == 0)
+			gapf.fail_read = 1;
+		if (fault == 1)
+			gapf.value &= ~BIT(1);
+		if (fault == 2)
+			busy = 1;
+		if (fault == 3)
+			regs[2] = 0x204;
+		assert(apple_dart_cio_off(&state) < 0);
+		assert(!writes && !dart.commands_gated && !dart.sleep_closed &&
+		       !state.changed);
+		assert(!apple_dart_cio_finish(&state) && !provider.refs);
+		cases++;
+	}
+	reset_owner(19, true);
+	assert(!apple_dart_cio_prepare(&state));
+	gapf.fail = 1;
+	assert(apple_dart_cio_off(&state) == -EIO);
+	assert(state.changed && dart.sleep_closed && dart.commands_gated);
+	assert(apple_dart_cio_on(&state) == -EIO && !state.restored);
+	gapf.fail = 0;
+	ntrace = 0;
+	assert(!apple_dart_cio_on(&state));
+	check_restored(&state.saved);
+	assert(!apple_dart_cio_finish(&state) && !provider.refs);
+	cases++;
+	reset_owner(18, false);
+	assert(!apple_dart_cio_prepare(&state));
+	assert(!apple_dart_cio_off(&state));
+	lose_power();
+	drop = 0x1400;
+	assert(apple_dart_cio_on(&state) == -EIO && !state.restored);
+	assert(dart.sleep_closed && dart.commands_gated && provider.refs == 1);
+	drop = ~0U;
+	assert(!apple_dart_cio_on(&state) && !apple_dart_cio_finish(&state));
+	cases++;
+	reset_owner(15, true);
+	assert(!apple_dart_cio_prepare(&state));
+	assert(!apple_dart_cio_off(&state));
+	/* A map while closed goes to memory and is flushed once it reopens. */
+	assert(apple_dart_sleep_writer_get(&dart) == APPLE_DART_WRITER_CLOSED &&
+	       state.tlb_stale && !dart.sleep_writers && state.closed_writers == 1);
+	apple_dart_sleep_writer_put(&dart, APPLE_DART_WRITER_CLOSED);
+	lose_power();
+	assert(!invalidations && !apple_dart_cio_on(&state) && invalidations == 1);
+	assert(!state.tlb_stale && !apple_dart_cio_finish(&state));
+	cases++;
+	/* Without such a map, reopening issues no extra flush. */
+	reset_owner(18, false);
+	assert(!apple_dart_cio_prepare(&state) && !apple_dart_cio_off(&state));
+	lose_power();
+	assert(!apple_dart_cio_on(&state) && !invalidations);
+	assert(!apple_dart_cio_finish(&state));
+	cases++;
+	/* Not restored: the transaction ends, the DART stays closed, sleeps are refused. */
+	reset_owner(14, false);
+	assert(!apple_dart_cio_prepare(&state) && !apple_dart_cio_off(&state));
+	assert(apple_dart_cio_finish(&state) == -EIO && state.dead);
+	assert(!dart.cio_active && !provider.refs);
+	assert(dart.sleep_closed && dart.commands_gated);
+	closed_writer();
+	assert(apple_dart_cio_prepare(&state) == -EIO && !provider.refs);
+	/* Still closed once its owner is gone. */
+	state.owner = NULL;
+	closed_writer();
+	cases++;
+	/* A memory-only writer still running at reopening is waited for, then flushed. */
+	reset_owner(19, true);
+	assert(!apple_dart_cio_prepare(&state) && !apple_dart_cio_off(&state));
+	assert(apple_dart_sleep_writer_get(&dart) == APPLE_DART_WRITER_CLOSED);
+	lose_power();
+	on_sleep = finish_writer;
+	assert(!apple_dart_cio_on(&state) && sleeps == 1 && invalidations == 1);
+	assert(!dart.sleep_closed && !state.closed_writers && !state.tlb_stale);
+	assert(!apple_dart_cio_finish(&state));
+	cases++;
+	/* One that never finishes keeps it closed; the transaction then ends dead. */
+	reset_owner(15, true);
+	assert(!apple_dart_cio_prepare(&state) && !apple_dart_cio_off(&state));
+	assert(apple_dart_sleep_writer_get(&dart) == APPLE_DART_WRITER_CLOSED);
+	lose_power();
+	assert(apple_dart_cio_on(&state) == -EBUSY && !state.restored && dart.sleep_closed);
+	assert(apple_dart_cio_finish(&state) == -EIO && state.dead);
+	apple_dart_sleep_writer_put(&dart, APPLE_DART_WRITER_CLOSED);
+	cases++;
+	/* A flush that fails keeps it closed too. */
+	reset_owner(14, false);
+	assert(!apple_dart_cio_prepare(&state) && !apple_dart_cio_off(&state));
+	closed_writer();
+	lose_power();
+	fail_flush = true;
+	assert(apple_dart_cio_on(&state) == -ETIMEDOUT && dart.sleep_closed);
+	assert(apple_dart_cio_finish(&state) == -EIO && state.dead);
+	cases++;
+	/* A snapshot that fails after a memory-only update reopens with a flush. */
+	reset_owner(18, false);
+	assert(!apple_dart_cio_prepare(&state));
+	regs[2] = 0x204;
+	on_read = closed_writer;
+	assert(apple_dart_cio_off(&state) < 0 && !state.changed);
+	assert(!dart.sleep_closed && invalidations == 1 && !state.dead);
+	on_read = NULL;
+	assert(!apple_dart_cio_finish(&state));
+	cases++;
+	/* A display firmware left protection off: it is turned on before the snapshot. */
+	reset_owner(5, false);
+	gapf.value = BIT(1) | BIT(7);
+	assert(!apple_dart_cio_prepare(&state) && !apple_dart_cio_off(&state));
+	assert(gapf.value == (BIT(1) | BIT(7)));
+	lose_power();
+	/* After the sleep the slice word reads zero: it is written back. */
+	gapf.value = 0;
+	assert(!apple_dart_cio_on(&state) && gapf.value == (BIT(1) | BIT(4) | BIT(7)));
+	assert(!apple_dart_cio_finish(&state));
+	cases++;
+	printf("PASS %u CIO DART ownership cases\n", cases);
+}
diff --git a/tools/asahi/dart-cio-owner-tests.py b/tools/asahi/dart-cio-owner-tests.py
new file mode 100644
index 0000000000..f9e717f607
--- /dev/null
+++ b/tools/asahi/dart-cio-owner-tests.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise the actual owner transaction, writer gate and register helpers together."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def function(source, name):
+    found = re.search(r'^(?:static )?(?:int|void|bool) ' + name + r'\([^;]+?\{.*?\n\}',
+                      source, re.M | re.S)
+    assert found, name
+    return found.group()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path)
+    args = parser.parse_args()
+    paths = ['drivers/iommu/apple-dart-power.h', 'drivers/iommu/apple-dart-cio-power.h',
+             'drivers/iommu/apple-dart-cio.c', 'drivers/iommu/apple-dart-sleep.c',
+             'drivers/iommu/apple-dart-cio-owner.h']
+    sources = {p: (ROOT / p).read_text() for p in paths}
+    hw = '\n'.join(sources[p] for p in paths[:2])
+    owner = sources[paths[2]]
+    struct = re.search(r'^struct apple_dart_cio \{.*?\n\};', sources[paths[4]],
+                       re.M | re.S).group()
+    names = ['apple_dart_cio_prepare', 'apple_dart_cio_gapf', 'apple_dart_cio_reopen',
+             'apple_dart_cio_off', 'apple_dart_cio_on', 'apple_dart_cio_finish']
+    methods = '\n'.join(function(owner, n) for n in names)
+    gate = '\n'.join(function(sources[paths[3]], n) for n in [
+        'apple_dart_sleep_writer_get', 'apple_dart_sleep_writer_put', 'apple_dart_sleep_close'])
+    fixture = Path(__file__).with_name('dart-cio-power-tests.c').read_text().split('int main(void)')[0]
+    fixture = fixture.replace('/* ACTUAL_HEADERS */', hw)
+    fixture += Path(__file__).with_suffix('.c').read_text().replace('/* ACTUAL_OWNER */', struct + '\n' + gate + methods)
+    mutations = {
+        'allocator-is-not-hardware-size': (
+            'streams = FIELD_GET(GENMASK(8, 0), params3);', 'streams = dart->num_streams;'),
+        'skip-writer-close': ('ret = apple_dart_sleep_close(dart);', 'ret = 0;'),
+        'ignore-gapf-policy': ('if (!ret && !(value & BIT(1)))', 'if (false)'),
+        'forget-partial-off': ('s->changed = true;', 's->changed = false;'),
+        'open-on-failure': ('\t\treturn ret;\n\t}\n\tdma_wmb();',
+                            '\t\tapple_dart_cio_reopen(s);\n\t\treturn ret;\n\t}\n\tdma_wmb();'),
+        'forget-stale-flush': ('if (stale) {', 'if (false) {'),
+        'open-with-writers': ('if (!s->closed_writers) {', 'if (true) {'),
+        'owner-only-gate': ('(READ_ONCE(cio->owner) || READ_ONCE(dart->sleep_closed))',
+                            'READ_ONCE(cio->owner)'),
+        'open-after-failed-flush': ('if (ret)\n\t\t\t\treturn ret;\n\t\t\tcontinue;',
+                                    '(void)ret;\n\t\t\tcontinue;'),
+        'forget-dead': ('\t\ts->dead = true;\n', ''),
+        'reopen-unrestored': ('\tif (s->changed && !s->restored) {', '\tif (false) {'),
+        'overwrite-gapf-neighbors': ('APPLE_PS_PROT_SLICE(s->slice), BIT(4),',
+                                    'APPLE_PS_PROT_SLICE(s->slice), ~0U,'),
+    }
+    variants = {'real': fixture}
+    for name, (old, new) in mutations.items():
+        assert old in fixture, name
+        variants[name] = fixture.replace(old, new)
+    with tempfile.TemporaryDirectory(prefix='dart-cio-owner-') as tmp:
+        out = args.output or Path(tmp)
+        out.mkdir(parents=True, exist_ok=True)
+        results = {}
+        for name, text in variants.items():
+            unit, binary = out / (name + '.c'), out / name
+            unit.write_text(text)
+            subprocess.run(['cc', '-std=gnu11', '-Wall', '-Wextra', '-Werror',
+                            '-Wno-unused-function', '-Wno-unused-parameter', '-g',
+                            '-fsanitize=address,undefined', str(unit), '-o', str(binary)], check=True)
+            run = subprocess.run([str(binary)], capture_output=True, text=True, timeout=10)
+            results[name] = {'exit': run.returncode, 'stdout': run.stdout, 'stderr': run.stderr}
+            assert (run.returncode == 0) == (name == 'real'), (name, results[name])
+            if name == 'real': print(run.stdout, end='')
+        (out / 'receipt.json').write_text(json.dumps({
+            'sha256': {p: hashlib.sha256(s.encode()).hexdigest() for p, s in sources.items()},
+            'results': results}, indent=2) + '\n')
+        print(f'PASS {len(mutations)} negative controls')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/asahi/dart-cio-power-tests.c b/tools/asahi/dart-cio-power-tests.c
new file mode 100644
index 0000000000..df853b59ca
--- /dev/null
+++ b/tools/asahi/dart-cio-power-tests.c
@@ -0,0 +1,333 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Fault-injected register model; no hardware accesses. */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+typedef uint32_t u32;
+#define __iomem
+#define BIT(n) (1U << (n))
+#define GENMASK(h, l) ((~0U << (l)) & (~0U >> (31 - (h))))
+#define FIELD_GET(mask, val) (((val) & (mask)) >> __builtin_ctz(mask))
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define DIV_ROUND_UP(n, d) (((n) + (d) - 1) / (d))
+#define max(a, b) ((a) > (b) ? (a) : (b))
+/* The MMIO mock records write order synchronously. */
+#define mb() \
+	do { \
+	} while (0)
+static u32 regs[0x9000 / 4];
+static unsigned int reads, writes, drop, busy, flushes, enables,
+	partition_reads;
+static unsigned int trace[4096], ntrace;
+static unsigned int offset(const void *p)
+{
+	uintptr_t off = (uintptr_t)p - (uintptr_t)regs;
+
+	assert(off < sizeof(regs) && !(off & 3));
+	return off;
+}
+static u32 readl(const void *p)
+{
+	unsigned int off = offset(p);
+
+	reads++;
+	assert(off != 0x100 && off != 0x104 && off < 0x6000);
+	if (off >= 0x800 && off < 0x840)
+		partition_reads++;
+	if (off == 0x80 && busy == 1)
+		return BIT(31);
+	if (off == 0x604 && busy == 2)
+		return 1;
+	if (off == 0x230 && busy == 3)
+		return 1;
+	return regs[off / 4];
+}
+static void writel(u32 value, void *p)
+{
+	unsigned int off = offset(p);
+
+	writes++;
+	assert(ntrace < ARRAY_SIZE(trace));
+	trace[ntrace++] = off;
+	assert(off != 0x100 && off != 0x104 && off != 0x200 && off != 0x208);
+	assert(off != 0x700 && off != 0x704 && off != 0x720);
+	assert(!(off >= 0x500 && off <= 0x548));
+	if (off == drop)
+		return;
+	if (off == 0x4060) {
+		/* Only implemented mask bits retain the write. */
+		regs[off / 4] = value & 0xff;
+	} else if (off >= 0xc20 && off < 0xc40) {
+		assert(value && !(value & (value - 1)));
+		regs[(off - 0x20) / 4] &= ~value;
+	} else if (off == 0x80) {
+		assert(value == 0xa000 || value == 0x8000);
+		assert(!regs[0xc00 / 4] && !regs[0xc1c / 4]);
+		flushes++;
+	} else {
+		if (off >= 0xc00 && off < 0xc20) {
+			assert(flushes && !regs[0x4060 / 4]);
+			enables++;
+		}
+		regs[off / 4] = value;
+	}
+}
+#define readl_poll_timeout_atomic(addr, value, condition, delay, timeout) \
+	({                                                                \
+		(void)(delay);                                            \
+		(void)(timeout);                                          \
+		int result = -ETIMEDOUT;                                  \
+		for (unsigned int tries = 0; tries < 4; tries++) {        \
+			value = readl(addr);                              \
+			if (condition) {                                  \
+				result = 0;                               \
+				break;                                    \
+			}                                                 \
+		}                                                         \
+		result;                                                   \
+	})
+
+/* ACTUAL_HEADERS */
+
+static void reset(unsigned int streams, bool partitions)
+{
+	memset(regs, 0, sizeof(regs));
+	reads = writes = busy = flushes = enables = partition_reads = ntrace =
+		0;
+	drop = ~0U;
+	regs[0] = partitions ? BIT(29) : 0;
+	regs[1] = BIT(16) | BIT(20) | BIT(2);
+	regs[2] = 0x203;
+	regs[3] = streams | (16 << 16);
+	regs[0x208 / 4] = BIT(3) | BIT(4);
+	regs[0x210 / 4] = 1;
+	regs[0x228 / 4] = 0x1122;
+	regs[0x22c / 4] = 0x3344;
+	for (unsigned int i = 0; i < DART_POWER_TUNABLES; i++)
+		regs[dart_power_tunables[i].offset / 4] =
+			dart_power_tunables[i].mask;
+	for (unsigned int i = 0; i < DART_POWER_TZ_WORDS; i++)
+		regs[dart_power_tz[i].offset / 4] = dart_power_tz[i].mask;
+	for (unsigned int i = 0; i < 16; i++)
+		regs[(0x800 + 4 * i) / 4] = 0xa0000000 | 0x20000 | (2 * i);
+	for (unsigned int sid = 0; sid < streams; sid++) {
+		regs[(0x1000 + 4 * sid) / 4] =
+			(sid == 253 || sid == 255) ? BIT(8) : BIT(0);
+		regs[(0x1400 + 4 * sid) / 4] =
+			(sid == 253 || sid == 255) ? 0 : BIT(31) | sid;
+		regs[(0xc00 + 4 * (sid / 32)) / 4] |= BIT(sid % 32);
+	}
+}
+static void lose_power(void)
+{
+	u32 params[4], tz[DART_POWER_TZ_WORDS], lock = regs[0x208 / 4];
+
+	memcpy(params, regs, sizeof(params));
+	for (unsigned int i = 0; i < DART_POWER_TZ_WORDS; i++)
+		tz[i] = regs[dart_power_tz[i].offset / 4];
+	memset(regs, 0, sizeof(regs));
+	memcpy(regs, params, sizeof(params));
+	for (unsigned int i = 0; i < DART_POWER_TZ_WORDS; i++)
+		regs[dart_power_tz[i].offset / 4] = tz[i];
+	regs[0x208 / 4] = lock;
+	flushes = enables = ntrace = 0;
+}
+static void check_restored(const struct dart_cio_power *s)
+{
+	for (unsigned int sid = 0; sid < s->streams; sid++) {
+		assert(regs[(0x1000 + 4 * sid) / 4] == s->tcr[sid]);
+		assert(regs[(0x1400 + 4 * sid) / 4] == s->ttbr[sid]);
+	}
+	for (unsigned int i = 0; i < DIV_ROUND_UP(s->streams, 32); i++)
+		assert(regs[(0xc00 + 4 * i) / 4] == s->enabled[i]);
+	for (unsigned int i = 0; i < s->partitions; i++)
+		assert((regs[(0x800 + 4 * i) / 4] & DART_CIO_PARTITION_MASK) ==
+		       (s->partition[i] & DART_CIO_PARTITION_MASK));
+	unsigned int flush = 0, pair = 0, enable = 0;
+
+	for (unsigned int i = 0; i < ntrace; i++) {
+		if (trace[i] == 0x80)
+			flush = i;
+		if (trace[i] == 0x228)
+			pair = i;
+		if (trace[i] == 0xc00)
+			enable = i;
+	}
+	assert(flush < enable && (!pair || (flush < pair && pair < enable)));
+}
+static int restore(struct dart_cio_power *s)
+{
+	ntrace = flushes = enables = 0;
+	return dart_cio_restore(regs, s);
+}
+int main(void)
+{
+	struct dart_cio_power s = {};
+	unsigned int cases = 0;
+	/* The live T8132 PCIe-C bank reports 256 SIDs, not the allocator's 64. */
+	reset(256, false);
+	regs[0] = 0xae313020;
+	regs[1] = 0x34110083;
+	regs[2] = 0x2a2a0202;
+	regs[3] = 0x00100100;
+	regs[0x208 / 4] = 0;
+	assert(dart_cio_capture(regs, &s, 64, false) == -EOPNOTSUPP && !writes);
+	assert(!dart_cio_capture(regs, &s, 256, false) && !s.common.has_tz);
+	assert(!dart_cio_disable(regs, &s));
+	lose_power();
+	assert(!restore(&s));
+	check_restored(&s);
+	cases++;
+	for (unsigned int streams = 28; streams <= 256; streams += 228) {
+		bool parts = streams == 28;
+
+		for (unsigned int version = 0x202; version <= 0x203;
+		     version++) {
+			reset(streams, parts);
+			regs[2] = version;
+			assert(!dart_cio_capture(regs, &s, streams, parts) &&
+			       s.valid && !writes);
+			assert(partition_reads == (parts ? 16 : 0));
+			assert(!dart_cio_disable(regs, &s));
+			for (unsigned int i = 0; i < DIV_ROUND_UP(streams, 32);
+			     i++)
+				assert(!regs[(0xc00 + 4 * i) / 4]);
+			lose_power();
+			assert(!restore(&s));
+			check_restored(&s);
+			cases++;
+			assert(!dart_cio_capture(regs, &s, streams, parts));
+			assert(!dart_cio_disable(regs, &s));
+			/* Abort without losing power also restores the saved context. */
+			assert(!restore(&s));
+			check_restored(&s);
+			cases++;
+		}
+	}
+	for (unsigned int i = 0; i < 8; i++) {
+		reset(256, false);
+		regs[(0x4000 + 4 * i) / 4] = BIT(i);
+		assert(dart_cio_capture(regs, &s, 256, false) == -EIO &&
+		       !writes && !s.valid);
+		cases++;
+	}
+	for (unsigned int kind = 0; kind < 9; kind++) {
+		reset(28, true);
+		switch (kind) {
+		case 0:
+			regs[2] = 0x201;
+			break;
+		case 1:
+			regs[2] = 0x204;
+			break;
+		case 2:
+			regs[0] = 0;
+			break;
+		case 3:
+			regs[3] = 28 | (15 << 16);
+			break;
+		case 4:
+			regs[3] = 27 | (16 << 16);
+			break;
+		case 5:
+			regs[0x704 / 4] = 0x100;
+			break;
+		case 6:
+			regs[0x4060 / 4] = 1;
+			break;
+		case 7:
+			regs[0x208 / 4] = 0;
+			break;
+		case 8:
+			regs[0xc00 / 4] |= BIT(31);
+			break;
+		}
+		assert(dart_cio_capture(regs, &s, 28, true) < 0 && !writes &&
+		       !s.valid);
+		cases++;
+	}
+	for (unsigned int kind = 1; kind <= 3; kind++) {
+		reset(28, true);
+		busy = kind;
+		assert(dart_cio_capture(regs, &s, 28, true) == -ETIMEDOUT &&
+		       !writes);
+		cases++;
+	}
+	const unsigned int badwrites[] = { 0x210,
+					   0x20c,
+					   0x220,
+					   0x224,
+					   0x300,
+					   0x308,
+					   0x310,
+					   0x800,
+					   0x83c,
+					   0x1000,
+					   0x1000 + 4 * 255,
+					   0x1400,
+					   0x228,
+					   0x22c,
+					   0xc00,
+					   0xc1c };
+	for (unsigned int i = 0; i < ARRAY_SIZE(badwrites); i++) {
+		reset(256, true);
+		assert(!dart_cio_capture(regs, &s, 256, true));
+		assert(!dart_cio_disable(regs, &s));
+		lose_power();
+		drop = badwrites[i];
+		assert(restore(&s) == -EIO);
+		assert(!regs[0xc00 / 4] && !regs[0xc1c / 4]);
+		drop = ~0U;
+		assert(!restore(&s));
+		check_restored(&s);
+		cases++;
+	}
+	for (unsigned int kind = 0; kind < 5; kind++) {
+		reset(256, true);
+		assert(!dart_cio_capture(regs, &s, 256, true));
+		assert(!dart_cio_disable(regs, &s));
+		lose_power();
+		if (kind == 0)
+			regs[0x208 / 4] ^= BIT(3);
+		if (kind == 1)
+			regs[0x500 / 4] ^= 1;
+		if (kind == 2)
+			regs[3] ^= 1;
+		if (kind == 3)
+			regs[0x4000 / 4] = 1;
+		if (kind == 4) {
+			regs[0x200 / 4] = 1;
+			regs[0x208 / 4] |= 1;
+		}
+		assert(restore(&s) == -EUCLEAN && !enables);
+		cases++;
+	}
+	reset(28, true);
+	assert(!dart_cio_capture(regs, &s, 28, true));
+	busy = 1;
+	assert(dart_cio_disable(regs, &s) == -ETIMEDOUT);
+	busy = 0;
+	assert(!restore(&s));
+	check_restored(&s);
+	cases++;
+	reset(28, true);
+	regs[0xc00 / 4] &= ~BIT(3);
+	assert(!dart_cio_capture(regs, &s, 28, true));
+	regs[0xc00 / 4] |= BIT(3);
+	unsigned int oldwrites = writes;
+
+	assert(restore(&s) == -EUCLEAN && writes == oldwrites);
+	cases++;
+	s.valid = false;
+	unsigned int before = reads + writes;
+
+	assert(dart_cio_disable(regs, &s) == -ENODATA);
+	assert(dart_cio_restore(regs, &s) == -ENODATA &&
+	       reads + writes == before);
+	cases++;
+	printf("PASS %u CIO DART power cases\n", cases);
+}
diff --git a/tools/asahi/dart-cio-power-tests.py b/tools/asahi/dart-cio-power-tests.py
new file mode 100644
index 0000000000..82cf479315
--- /dev/null
+++ b/tools/asahi/dart-cio-power-tests.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Compile the actual CIO register helpers against a fault-injected MMIO model."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+MUTATIONS = {
+    'skip-partitions': ('i < s->partitions; i++', 'i < 0; i++'),
+    'truncate-streams': ('sid < s->streams; sid++', 'sid < 28; sid++'),
+    'wrong-error-mask': ('#define DART_POWER_ERROR_MASK 0x4060', '#define DART_POWER_ERROR_MASK 0x104'),
+    'truncate-faults': ('i < DIV_ROUND_UP(s->streams, 32); i++', 'i < 1; i++'),
+    'skip-restore-flush': ('ret = dart_power_flush(regs, false) ?:', 'ret = 0 ?:'),
+    'ignore-lock': ('if (locked)\n\t\treturn -EUCLEAN;', 'if (false)\n\t\treturn -EUCLEAN;'),
+    'wrong-outstanding': ('regs + 0x230 + 4 * i', 'regs + 0x6000 + 4 * i'),
+    'skip-params': ('if (readl(regs + 4 * i) != s->params[i])', 'if (false)'),
+}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path)
+    args = parser.parse_args()
+    paths = ['drivers/iommu/apple-dart-power.h', 'drivers/iommu/apple-dart-cio-power.h']
+    sources = {p: (ROOT / p).read_text() for p in paths}
+    source = '\n'.join(sources.values())
+    fixture = Path(__file__).with_suffix('.c').read_text()
+    variants = {'real': source}
+    for name, (old, new) in MUTATIONS.items():
+        assert old in source, name
+        variants[name] = source.replace(old, new)
+    with tempfile.TemporaryDirectory(prefix='dart-cio-power-') as tmp:
+        out = args.output or Path(tmp)
+        out.mkdir(parents=True, exist_ok=True)
+        results = {}
+        for name, prod in variants.items():
+            unit, binary = out / (name + '.c'), out / name
+            unit.write_text(fixture.replace('/* ACTUAL_HEADERS */', prod))
+            subprocess.run(['cc', '-std=gnu11', '-Wall', '-Wextra', '-Werror',
+                            '-Wno-unused-function', '-Wno-unused-parameter', '-Wno-type-limits', '-g',
+                            '-fsanitize=address,undefined', str(unit), '-o', str(binary)], check=True)
+            run = subprocess.run([str(binary)], capture_output=True, text=True, timeout=10)
+            results[name] = {'exit': run.returncode, 'stdout': run.stdout, 'stderr': run.stderr}
+            assert (run.returncode == 0) == (name == 'real'), (name, results[name])
+            if name == 'real':
+                print(run.stdout, end='')
+        (out / 'receipt.json').write_text(json.dumps({
+            'sha256': {p: hashlib.sha256(s.encode()).hexdigest() for p, s in sources.items()},
+            'results': results}, indent=2) + '\n')
+        print(f'PASS {len(MUTATIONS)} negative controls')
+
+
+if __name__ == '__main__':
+    main()
