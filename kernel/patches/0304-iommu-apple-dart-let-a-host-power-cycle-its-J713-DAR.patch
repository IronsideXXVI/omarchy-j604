+	assert(!gate);
+	apple_dart_sleep_writer_put(&d, gate);
+	assert(!d.sleep_writers);
+	/* A host-owned DART with no owner bound yet is not gated either. */
+	d = (struct apple_dart){ .cio = &cio };
