diff --git a/drivers/iommu/apple-dart-cio-owner.h b/drivers/iommu/apple-dart-cio-owner.h
new file mode 100644
index 0000000000..c3b04e59f0
--- /dev/null
+++ b/drivers/iommu/apple-dart-cio-owner.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by apple-dart.c before its writer gate, which reads this state. */
+#ifndef __APPLE_DART_CIO_OWNER_H
+#define __APPLE_DART_CIO_OWNER_H
+
+#include "apple-dart-power.h"
+#include "apple-dart-cio-power.h"
+
+struct apple_dart_cio {
+	struct apple_dart *dart;
+	struct device *owner;
+	struct device_link *link;
+	struct regmap *gapf;
+	struct dart_cio_power saved;
+	unsigned int slice;
+	u32 gapf_saved;
+	/*
+	 * Under managed_lock: writers updating page tables in memory only while
+	 * the DART is closed, and whether any did.
+	 */
+	unsigned int closed_writers;
+	bool tlb_stale;
+	bool changed, restored, dead;
+};
+
+#endif
diff --git a/drivers/iommu/apple-dart-cio-power.h b/drivers/iommu/apple-dart-cio-power.h
new file mode 100644
index 0000000000..c6005c1408
--- /dev/null
+++ b/drivers/iommu/apple-dart-cio-power.h
@@ -0,0 +1,216 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Register state for a T8132 CIO DART. Its host must exclude every requester. */
+#ifndef __APPLE_DART_CIO_POWER_H
+#define __APPLE_DART_CIO_POWER_H
+
+#define DART_CIO_STREAMS 256
+#define DART_CIO_PARTITIONS 16
+#define DART_CIO_PARTITION_MASK 0x000f003f
+
+struct dart_cio_power {
+	struct dart_power_state common;
+	u32 tcr[DART_CIO_STREAMS], ttbr[DART_CIO_STREAMS];
+	u32 enabled[DART_CIO_STREAMS / 32];
+	u32 partition[DART_CIO_PARTITIONS];
+	u32 params[4];
+	unsigned int streams, partitions;
+	bool valid;
+};
+
+static bool dart_cio_fault(void __iomem *regs, const struct dart_cio_power *s)
+{
+	for (unsigned int i = 0; i < DIV_ROUND_UP(s->streams, 32); i++)
+		if (readl(regs + 0x4000 + 4 * i))
+			return true;
+	return readl(regs + 0x704) & 0x777;
+}
+
+static int dart_cio_idle(void __iomem *regs, const struct dart_cio_power *s)
+{
+	unsigned int ports = max(FIELD_GET(GENMASK(18, 16), s->params[1]),
+				 FIELD_GET(GENMASK(22, 20), s->params[1]));
+	u32 value;
+	int ret;
+
+	if (!ports || ports > 4 || dart_cio_fault(regs, s))
+		return -EIO;
+	ret = dart_power_tlb_idle(regs);
+	if (ret)
+		return ret;
+	for (unsigned int i = 0; i < ports; i++) {
+		ret = readl_poll_timeout_atomic(regs + 0x230 + 4 * i, value, !value,
+						1, 10000);
+		if (ret)
+			return ret;
+	}
+	return dart_cio_fault(regs, s) ? -EIO : 0;
+}
+
+/* Only the v2.2/v2.3 layout is admitted; do not guess at a newer revision. */
+static int dart_cio_capture(void __iomem *regs, struct dart_cio_power *s,
+			    unsigned int streams, bool partitions)
+{
+	struct dart_power_state *p = &s->common;
+	u32 version;
+	int ret;
+
+	s->valid = false;
+	if (!streams || streams > DART_CIO_STREAMS)
+		return -EINVAL;
+	for (unsigned int i = 0; i < ARRAY_SIZE(s->params); i++)
+		s->params[i] = readl(regs + 4 * i);
+	version = s->params[2] & 0xffff;
+	if (version < 0x202 || version > 0x203 ||
+	    FIELD_GET(GENMASK(8, 0), s->params[3]) != streams)
+		return -EOPNOTSUPP;
+	if (partitions && (!(s->params[0] & BIT(29)) ||
+			   FIELD_GET(GENMASK(24, 16), s->params[3]) < DART_CIO_PARTITIONS))
+		return -EOPNOTSUPP;
+	s->streams = streams;
+	s->partitions = partitions ? DART_CIO_PARTITIONS : 0;
+	ret = dart_cio_idle(regs, s);
+	if (ret)
+		return ret;
+	/* This owner restores the normal unmasked error policy on wake. */
+	if (readl(regs + DART_POWER_ERROR_MASK))
+		return -EBUSY;
+	p->version = version;
+	p->lock = readl(regs + 0x208);
+	p->diag = readl(regs + 0x210);
+	p->pair[0] = readl(regs + 0x228);
+	p->pair[1] = readl(regs + 0x22c);
+	p->has_tz = s->params[1] & BIT(2);
+	if (p->has_tz) {
+		if ((p->lock & GENMASK(4, 3)) != GENMASK(4, 3))
+			return -EPERM;
+		for (unsigned int i = 0; i < DART_POWER_TZ_WORDS; i++)
+			p->tz[i] = readl(regs + dart_power_tz[i].offset) &
+				   dart_power_tz[i].mask;
+	}
+	for (unsigned int i = 0; i < DART_POWER_TUNABLES; i++)
+		p->tunable[i] = readl(regs + dart_power_tunables[i].offset);
+	for (unsigned int i = 0; i < s->partitions; i++)
+		s->partition[i] = readl(regs + 0x800 + 4 * i);
+	for (unsigned int sid = 0; sid < streams; sid++) {
+		s->tcr[sid] = readl(regs + 0x1000 + 4 * sid);
+		s->ttbr[sid] = readl(regs + 0x1400 + 4 * sid);
+	}
+	for (unsigned int i = 0; i < DIV_ROUND_UP(streams, 32); i++)
+		s->enabled[i] = readl(regs + 0xc00 + 4 * i);
+	if (streams % 32 && (s->enabled[streams / 32] & ~GENMASK(streams % 32 - 1, 0)))
+		return -EUCLEAN;
+	s->valid = true;
+	return 0;
+}
+
+/* One command per SID; DISABLE_STREAMS has no readback equality contract. */
+static void dart_cio_disable_streams(void __iomem *regs, const struct dart_cio_power *s)
+{
+	for (unsigned int sid = 0; sid < s->streams; sid++)
+		if (s->enabled[sid / 32] & BIT(sid % 32))
+			writel(BIT(sid % 32), regs + 0xc20 + 4 * (sid / 32));
+	/* Complete the stream commands before flushing or releasing GAPF. */
+	mb();
+}
+
+static int dart_cio_disable(void __iomem *regs, const struct dart_cio_power *s)
+{
+	int ret;
+
+	if (!s->valid)
+		return -ENODATA;
+	ret = dart_cio_idle(regs, s);
+	if (ret)
+		return ret;
+	dart_power_mask_errors(regs, true);
+	dart_cio_disable_streams(regs, s);
+	ret = dart_power_flush(regs, true);
+	return ret ?: (dart_cio_fault(regs, s) ? -EIO : 0);
+}
+
+/* GAPF is already on; all requesters remain stopped until this returns zero. */
+static int dart_cio_restore(void __iomem *regs, const struct dart_cio_power *s)
+{
+	const struct dart_power_state *p = &s->common;
+	u32 protect, lock;
+	bool locked;
+	int ret;
+
+	if (!s->valid)
+		return -ENODATA;
+	for (unsigned int i = 0; i < ARRAY_SIZE(s->params); i++)
+		if (readl(regs + 4 * i) != s->params[i])
+			return -EUCLEAN;
+	protect = readl(regs + 0x200);
+	lock = readl(regs + 0x208);
+	locked = protect & lock & BIT(0);
+	if ((lock & GENMASK(4, 3)) != (p->lock & GENMASK(4, 3)) || dart_cio_fault(regs, s))
+		return -EUCLEAN;
+	/* A requester outside the saved set means ownership was lost. */
+	for (unsigned int i = 0; i < DIV_ROUND_UP(s->streams, 32); i++)
+		if (readl(regs + 0xc00 + 4 * i) & ~s->enabled[i])
+			return -EUCLEAN;
+	dart_power_mask_errors(regs, true);
+	/* Also handles an aborted shutdown with some streams still enabled. */
+	dart_cio_disable_streams(regs, s);
+	ret = dart_power_write(regs, 0x210, p->diag);
+	if (ret)
+		return ret;
+	if (p->has_tz)
+		for (unsigned int i = 0; i < DART_POWER_TZ_WORDS; i++)
+			if ((readl(regs + dart_power_tz[i].offset) & dart_power_tz[i].mask) !=
+			    p->tz[i])
+				return -EUCLEAN;
+	for (unsigned int i = 0; i < DART_POWER_TUNABLES; i++) {
+		bool apf_locked = dart_power_tunables[i].offset >= 0x300 &&
+				  (protect & lock & BIT(2));
+
+		ret = dart_power_config(regs, dart_power_tunables[i].offset,
+					dart_power_tunables[i].mask, p->tunable[i],
+					locked || apf_locked);
+		if (ret)
+			return ret;
+	}
+	for (unsigned int i = 0; i < s->partitions; i++) {
+		ret = dart_power_config(regs, 0x800 + 4 * i, DART_CIO_PARTITION_MASK,
+					s->partition[i], locked);
+		if (ret)
+			return ret;
+	}
+	/* Include reserved bypass SIDs: they are part of the port's DMA context. */
+	for (unsigned int sid = 0; sid < s->streams; sid++) {
+		ret = dart_power_config(regs, 0x1000 + 4 * sid, ~0U, s->tcr[sid], locked);
+		if (ret)
+			return ret;
+		/*
+		 * A locked DART can come back from a sleep with other bits in the
+		 * root of a stream that is not enabled, a root that was and still
+		 * is invalid: no translation either way.
+		 */
+		if (locked && !(s->enabled[sid / 32] & BIT(sid % 32)) &&
+		    !((s->ttbr[sid] | readl(regs + 0x1400 + 4 * sid)) & BIT(0)))
+			continue;
+		ret = dart_power_config(regs, 0x1400 + 4 * sid, ~0U, s->ttbr[sid], locked);
+		if (ret)
+			return ret;
+	}
+	ret = dart_power_flush(regs, false) ?:
+	      dart_power_config(regs, 0x228, ~0U, p->pair[0], locked) ?:
+	      dart_power_config(regs, 0x22c, ~0U, p->pair[1], locked);
+	if (ret)
+		return ret;
+	dart_power_mask_errors(regs, false);
+	for (unsigned int i = 0; i < DIV_ROUND_UP(s->streams, 32); i++) {
+		ret = dart_power_write(regs, 0xc00 + 4 * i, s->enabled[i]);
+		if (ret) {
+			dart_power_mask_errors(regs, true);
+			dart_cio_disable_streams(regs, s);
+			/* The caller keeps requesters stopped even if cleanup fails. */
+			dart_power_flush(regs, true);
+			return ret;
+		}
+	}
+	return 0;
+}
+
+#endif
diff --git a/drivers/iommu/apple-dart-cio.c b/drivers/iommu/apple-dart-cio.c
new file mode 100644
index 0000000000..e88fedbacf
--- /dev/null
+++ b/drivers/iommu/apple-dart-cio.c
@@ -0,0 +1,324 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Included by apple-dart.c: owner-driven ACIO, PCIe-C and external display DART power cycles. */
+/*
+ * Called before publishing the IOMMU: writer accounting cannot start mid-map.
+ * A DART whose host can power-cycle it names its clock protection slice in the
+ * device tree. The internal display DARTs (@skip) name theirs for their DCP's
+ * own power-down instead.
+ */
+static int apple_dart_cio_init(struct apple_dart *dart, resource_size_t size, bool skip)
+{
+	struct device_node *np = dart->dev->of_node;
+	struct apple_dart_cio *s;
+	struct regmap *gapf;
+	unsigned int slice;
+
+	if (skip || dart->hw->type != DART_T8110 ||
+	    !of_property_present(np, "apple,clock-protection"))
+		return 0;
+	if (size < 0x4064)
+		return -EINVAL;
+	gapf = syscon_regmap_lookup_by_phandle_args(np, "apple,clock-protection", 1, &slice);
+	if (IS_ERR(gapf))
+		return dev_err_probe(dart->dev, PTR_ERR(gapf), "clock-protection bank\n");
+	if (slice >= APPLE_PS_PROT_SLICES)
+		return -EINVAL;
+	s = devm_kzalloc(dart->dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+	s->dart = dart;
+	s->gapf = gapf;
+	s->slice = slice;
+	dart->cio = s;
+	return 0;
+}
+
+static void apple_dart_cio_unbind(void *data)
+{
+	struct apple_dart_cio *s = data;
+
+	if (READ_ONCE(s->dart->cio_active))
+		panic("Apple CIO: removing owner with unresolved DMA state");
+	s->owner = NULL;
+	module_put(THIS_MODULE);
+}
+
+int apple_dart_cio_bind(struct device *owner, struct device *provider,
+			struct apple_dart_cio **state)
+{
+	struct apple_dart *dart;
+	struct apple_dart_cio *s;
+	int ret;
+
+	if (!provider || provider->driver != &apple_dart_driver.driver)
+		return -EPROBE_DEFER;
+	dart = dev_get_drvdata(provider);
+	if (!dart || !READ_ONCE(dart->iommu.ready))
+		return -EPROBE_DEFER;
+	s = dart->cio;
+	if (!s || dart->managed_sids || dart->hw->ttbr_count != 1)
+		return -EOPNOTSUPP;
+	if (s->owner)
+		return -EBUSY;
+	if (!try_module_get(THIS_MODULE))
+		return -ENODEV;
+	s->link = device_link_add(owner, provider, DL_FLAG_AUTOREMOVE_CONSUMER);
+	if (!s->link) {
+		module_put(THIS_MODULE);
+		return -EINVAL;
+	}
+	s->owner = owner;
+	ret = devm_add_action_or_reset(owner, apple_dart_cio_unbind, s);
+	if (!ret)
+		*state = s;
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_dart_cio_bind);
+
+int apple_dart_cio_prepare(struct apple_dart_cio *s)
+{
+	struct apple_dart *dart;
+	unsigned long flags;
+	int ret;
+
+	if (!s || !s->owner || pm_suspend_target_state != PM_SUSPEND_MEM)
+		return -EINVAL;
+	dart = s->dart;
+	ret = pm_runtime_resume_and_get(dart->dev);
+	if (ret < 0)
+		return ret;
+	spin_lock_irqsave(&dart->managed_lock, flags);
+	if (s->dead) {
+		ret = -EIO;
+	} else if (dart->cio_active || dart->sleep_closed || dart->commands_gated) {
+		ret = -EBUSY;
+	} else {
+		s->saved.valid = false;
+		s->changed = false;
+		s->restored = false;
+		s->tlb_stale = false;
+		dart->cio_active = true;
+		ret = 0;
+	}
+	spin_unlock_irqrestore(&dart->managed_lock, flags);
+	if (ret)
+		pm_runtime_put(dart->dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_dart_cio_prepare);
+
+static int apple_dart_cio_gapf(struct apple_dart_cio *s, bool on)
+{
+	u32 value;
+	int ret;
+
+	ret = regmap_read(s->gapf, APPLE_PS_PROT_SLICE(s->slice), &value);
+	/*
+	 * An external display DART's slice word does not survive the sleep: give
+	 * it the value it had at power-down back, before its protection goes on.
+	 */
+	if (!ret && on && !(value & BIT(1)) && (s->gapf_saved & BIT(1))) {
+		u32 restore = s->gapf_saved | BIT(4);
+
+		dev_info(s->dart->dev, "CIO DART slice %u lost (%#x): restoring %#x\n",
+			 s->slice, value, restore);
+		ret = regmap_write(s->gapf, APPLE_PS_PROT_SLICE(s->slice), restore);
+		if (!ret)
+			ret = regmap_read(s->gapf, APPLE_PS_PROT_SLICE(s->slice), &value);
+	}
+	if (ret || !(value & BIT(1)))
+		return ret ?: -EPERM;
+	ret = regmap_update_bits(s->gapf, APPLE_PS_PROT_SLICE(s->slice), BIT(4),
+				 on ? BIT(4) : 0);
+	if (!ret)
+		ret = regmap_read(s->gapf, APPLE_PS_PROT_SLICE(s->slice), &value);
+	return ret ?: (!!(value & BIT(4)) == on ? 0 : -EIO);
+}
+
+/* Returns whether a page table changed while it was closed. */
+/*
+ * Reopen a DART whose registers hold its state. Writers that updated page
+ * tables in memory only finish first, and if there were any the whole TLB is
+ * flushed before the DART opens, so no stale translation outlives the
+ * closure. On failure it stays closed.
+ */
+static int apple_dart_cio_reopen(struct apple_dart_cio *s)
+{
+	struct apple_dart_stream_map all = { .dart = s->dart };
+	struct apple_dart *dart = s->dart;
+	unsigned long flags;
+	unsigned int tries;
+	bool stale;
+	int ret;
+
+	/* Under the lock its other writers hold; the restore was ordered by dma_wmb(). */
+	scoped_guard(spinlock_irqsave, &dart->lock)
+		WRITE_ONCE(dart->commands_gated, false);
+	bitmap_fill(all.sidmap, dart->num_streams);
+	for (tries = 0; tries < 10000; tries++) {
+		stale = false;
+		spin_lock_irqsave(&dart->managed_lock, flags);
+		if (!s->closed_writers) {
+			stale = s->tlb_stale;
+			s->tlb_stale = false;
+			if (!stale) {
+				WRITE_ONCE(dart->sleep_closed, false);
+				spin_unlock_irqrestore(&dart->managed_lock, flags);
+				return 0;
+			}
+		}
+		spin_unlock_irqrestore(&dart->managed_lock, flags);
+		if (stale) {
+			ret = dart->hw->invalidate_tlb(&all);
+			if (ret)
+				return ret;
+			continue;
+		}
+		usleep_range(10, 20);
+	}
+	return -EBUSY;
+}
+
+int apple_dart_cio_off(struct apple_dart_cio *s)
+{
+	u32 value, params0, params3;
+	struct apple_dart *dart;
+	unsigned int streams;
+	bool partitions;
+	int ret;
+
+	if (!s || !READ_ONCE(s->dart->cio_active) || s->changed || s->restored)
+		return -EINVAL;
+	dart = s->dart;
+	ret = apple_dart_sleep_close(dart);
+	if (ret)
+		return ret;
+	/* The bank size comes from the hardware, not from the stream allocator. */
+	params0 = readl(dart->regs);
+	params3 = readl(dart->regs + 12);
+	streams = FIELD_GET(GENMASK(8, 0), params3);
+	partitions = (params0 & BIT(29)) &&
+		     FIELD_GET(GENMASK(24, 16), params3) >= DART_CIO_PARTITIONS;
+	/* Drains the fault IRQ and any hardware command admitted before closure. */
