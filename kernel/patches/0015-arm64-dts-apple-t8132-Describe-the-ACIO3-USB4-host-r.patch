From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 08:07:38 +0000
Subject: [PATCH] arm64: dts: apple: t8132: Describe the ACIO3 USB4
 host router

The T8132 has a third USB-C ATC, ATC3, with its own USB4 host router
(ACIO3), PCIe-C tunnel port (APCIEC3) and DARTs; the MacBook Pro J604
uses it for its right-hand port. t8132-usb4.dtsi describes ACIO0 and
ACIO1 only, as the J713 has two ports.

Add ACIO3 in the same form, disabled: the MxWrap CPU mailbox, the
router with its DART and NHI, the PCIe-C root port with its DART, the
LSTX pin, and the ATC3 power domains. Every address, interrupt, the
LSTX pin, the MSI slice and the PCI windows were checked against the
J604 runtime ADT (acio3, acio-cpu3 and its nub's segment ranges,
dart-acio3, apciec3, apciec3-piodma, dart-apciec3, pcic3-bridge):

- mailbox 0x419108000, IRQs 1502-1505; cpu 0x419100000; rc 0x419ac0000
  (three 0x4000 windows); sram 0x419080000; PCIe adapter 0x419e44000;
  DART 0x419a80000, IRQ 1500; NHI 0x419f00000 and PDF 0x419db0000,
  ring IRQs 1473-1484 (tx) and 1485-1496 (rx): ACIO1 + 0x10000000 and
  + 124, as ACIO1 is ACIO0 + 0x8000000 and + 62.
- LSTX: AOP GPIO 23 (ADT gpio-lstx; ACIO0 17, ACIO1 19).
- APCIEC3: config 0x1c80000000, the port windows at 0x41c0xxxxx, ioa
  0x418020000, oe-fabric 0x41c03c000 (piodma), IRQ 1453; DART
  0x41c000000, IRQ 1454; MSI slice 1506 + 0xc0 (pcic3-bridge
  msi-vector-base) = 1698; PCI windows 0x1400000000 and 0x16xxxxxxxx.
- The PCIe-C DART and oe-fabric tunables are the ADT's, identical for
  APCIEC0, 1 and 3 on the J604.

The CIO reset index 3 follows the slot numbering of ACIO0/ACIO1 (0, 1);
the T8132 CIO reset layout is not decoded yet (reset-apple-cio.c), so
this index is an inference until a router comes up on ATC3.

The boot loader fills the router, PCIe adapter, NHI and PCIe-C
calibration and the router DROM through the board's usb4-3-* aliases,
as for ACIO0/ACIO1.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 02849f178799ef4450fbf4564d1a85e50325298b)
(cherry picked from commit 745e325e7a652b1ed4972173ba21e154e6d92c38)
---
 arch/arm64/boot/dts/apple/t8132-usb4.dtsi | 221 +++++++++++++++++++++-
 1 file changed, 219 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-usb4.dtsi b/arch/arm64/boot/dts/apple/t8132-usb4.dtsi
index f137650f91..6ea659c42f 100644
--- a/arch/arm64/boot/dts/apple/t8132-usb4.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-usb4.dtsi
@@ -1,10 +1,11 @@
 // SPDX-License-Identifier: GPL-2.0+ OR MIT
 /*
- * Apple T8132 (M4) USB4/Thunderbolt host routers: ACIO0 behind ATC0, ACIO1 behind ATC1.
+ * Apple T8132 (M4) USB4/Thunderbolt host routers: ACIO0 behind ATC0, ACIO1 behind ATC1,
+ * ACIO3 behind ATC3 (ATC2 is the DisplayPort-only PHY and has no router).
  *
  * The layout follows T6030: the same offsets from the ACIO base for the rc, sram,
  * PCIe adapter, MxWrap CPU, mailbox, DART and NHI blocks. ACIO1 sits 0x8000000 above
- * ACIO0 and its interrupts 62 above. The NHI ring interrupts are listed tx first
+ * ACIO0 and its interrupts 62 above; ACIO3 sits 0x18000000 and 186 above ACIO0. The NHI ring interrupts are listed tx first
  * (the lower block), then rx.
  *
  * The boot loader fills apple,tunable-rc, -pcie-adapter, -nhi and
@@ -20,6 +21,10 @@
 	usb4_1_lstx_pins: usb4-1-lstx-pins {
 		pinmux = <APPLE_PINMUX(19, 1)>;
 	};
+
+	usb4_3_lstx_pins: usb4-3-lstx-pins {
+		pinmux = <APPLE_PINMUX(23, 1)>;
+	};
 };
 
 &soc {
@@ -268,6 +273,122 @@
 			apple,thunderbolt-drom = [00];
 		};
 	};
+
+	usb4_3_mbox: mailbox@419108000 {
+		compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x4 0x19108000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1502 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 1503 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 1504 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 1505 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+		status = "disabled";
+	};
+
+	usb4_3_acio: cio@419ac0000 {
+		compatible = "apple,t8132-usb4-acio", "apple,t8103-usb4-acio";
+		reg = <0x4 0x19ac0000 0x0 0xc000>,
+		      <0x4 0x19080000 0x0 0x20000>,
+		      <0x4 0x19e44000 0x0 0x4000>,
+		      <0x4 0x19100000 0x0 0x4000>;
+		reg-names = "rc", "sram", "pcie-adapter", "cpu";
+
+		mboxes = <&usb4_3_mbox>;
+		resets = <&cio_reset 3>;
+		pinctrl-names = "lstx";
+		pinctrl-0 = <&usb4_3_lstx_pins>;
+		lstx-gpios = <&pinctrl_aop 23 GPIO_ACTIVE_HIGH>;
+
+		power-domains = <&ps_atc3_cio>,
+				<&ps_atc3_cio_pcie>,
+				<&ps_atc3_cio_usb>;
+
+		thunderbolt-switch;
+
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x4 0x19000000 0x1000000>;
+		nonposted-mmio;
+		status = "disabled";
+
+		usb4_3_dart: iommu@a80000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0xa80000 0x20000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1500 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <5>;
+		};
+
+		usb4_3_nhi: nhi@f00000 {
+			compatible = "apple,t8132-usb4-nhi", "apple,t8103-usb4-nhi";
+			reg = <0xf00000 0x100000>,
+			      <0xdb0000 0x30004>;
+			reg-names = "nhi", "pdf";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1473 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1474 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1475 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1476 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1477 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1478 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1479 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1480 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1481 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1482 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1483 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1484 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1485 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1486 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1487 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1488 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1489 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1490 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1491 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1492 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1493 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1494 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1495 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 1496 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names =
+				"txring0", "txring1", "txring2",
+				"txring3", "txring4", "txring5",
+				"txring6", "txring7", "txring8",
+				"txring9", "txring10", "txring11",
+				"rxring0", "rxring1", "rxring2",
+				"rxring3", "rxring4", "rxring5",
+				"rxring6", "rxring7", "rxring8",
+				"rxring9", "rxring10", "rxring11";
+			iommus = <&usb4_3_dart 0 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 1 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 2 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 3 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 4 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 5 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 6 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 7 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 8 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 9 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 10 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 11 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 16 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 17 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 18 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 19 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 20 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 21 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 22 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 23 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 24 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 25 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 26 0x100 0x0 0x10 0x0>,
+				 <&usb4_3_dart 27 0x100 0x0 0x10 0x0>;
+			/* To be filled by the loader */
+			apple,thunderbolt-drom = [00];
+		};
+	};
 };
 
 /*
@@ -459,6 +580,96 @@
 			};
 		};
 	};
+
+	usb4_3_pcie_tunnel: usb4-pcie-tunnel-3 {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		nonposted-mmio;
+		/* Preserve the SoC DMA window after moving the virtual container. */
+		dma-ranges = <0 0 0 0 0xffffffff 0xffffc000>;
+
+		usb4_3_pcie_dart: iommu@41c000000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x1c000000 0x0 0x20000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1454 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			/* The port's own writes, MSIs included, use these streams. */
+			apple,bypass-sids = <253 255>;
+			/* No bootloader fills this one; the tunnel's cold init needs it. */
+			apple,tunable =
+				<0x20c 0x80000121 0x80000121>,
+				<0x220 0xf0f0f 0xf0f0f>,
+				<0x224 0xffffff 0x80808>,
+				<0x300 0x1f31 0x1>,
+				<0x308 0x3ffffffc 0x10000000>,
+				<0x310 0x3ffffffc 0x3ffffffc>;
+		};
+
+		usb4_3_pcie: pcie@1c80000000 {
+			compatible = "apple,t8132-pciec", "apple,t8122-pciec",
+				     "apple,t8103-pciec";
+			device_type = "pci";
+			reg = <0x1c 0x80000000 0x0 0x10000000>,
+			      <0x4 0x1c034000 0x0 0x4000>,
+			      <0x4 0x1c020000 0x0 0x8000>,
+			      <0x4 0x1c038000 0x0 0x4000>,
+			      <0x4 0x1c060000 0x0 0x4000>,
+			      <0x4 0x18020000 0x0 0x4000>,
+			      <0x4 0x1c02c000 0x0 0x4000>,
+			      <0x4 0x1c028000 0x0 0x4000>,
+			      <0x4 0x1c03c000 0x0 0x4000>;
+			reg-names = "config", "rc", "port0", "fabric",
+				    "debug", "ioa", "ltssm", "intr2axi",
+				    "oe-fabric";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1453 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_atc3_cio_pcie>;
+			resets = <&ps_atc3_pcie>;
+			apple,pciec-kernel-init;
+			apple,tunable-oe-fabric =
+				<0x4 0x70007 0x40004>,
+				<0xc 0x1 0x1>,
+				<0x10 0x1 0x1>,
+				<0x14 0x801f 0x4>,
+				<0x1c 0x801f 0x4>,
+				<0x24 0x801f 0x4>;
+			msi-controller;
+			msi-parent = <&usb4_3_pcie>;
+			/* The ADT bridge's 32-vector slice of the window shared with apcie. */
+			msi-ranges = <&aic AIC_IRQ 1698 IRQ_TYPE_EDGE_RISING 32>;
+			apple,msi-vector-base = <0xc0>;
+			iommu-map = <0x0 &usb4_3_pcie_dart 0x0 0x40>;
+			iommu-map-mask = <0x3f>;
+			bus-range = <0x0 0x7f>;
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges = <0x43000000 0x14 0x0
+				  0x14 0x0 0x2 0x0>,
+				 <0x02000000 0x0 0x100000
+				  0x16 0x100000 0x0 0x3ff00000>,
+				 <0x42000000 0x0 0x40000000
+				  0x16 0x40000000 0x0 0x40000000>;
+
+			usb4_3_pcie_port: pci@0,0 {
+				device_type = "pci";
+				reg = <0x0 0x0 0x0 0x0 0x0>;
+				external-facing;
+				/* apple,tunable is filled by the bootloader */
+				#address-cells = <3>;
+				#size-cells = <2>;
+				ranges;
+				interrupt-controller;
+				#interrupt-cells = <1>;
+				interrupt-map-mask = <0 0 0 7>;
+				interrupt-map = <0 0 0 1 &usb4_3_pcie_port 0 0 0 0>,
+						<0 0 0 2 &usb4_3_pcie_port 0 0 0 1>,
+						<0 0 0 3 &usb4_3_pcie_port 0 0 0 2>,
+						<0 0 0 4 &usb4_3_pcie_port 0 0 0 3>;
+			};
+		};
+	};
 };
 
 &usb4_0_acio {
@@ -472,3 +683,9 @@
 			<&ps_atc1_cio_usb>, <&ps_atc1_pcie>;
 	apple,pcie-tunnel = <&usb4_1_pcie_tunnel>;
 };
+
+&usb4_3_acio {
+	power-domains = <&ps_atc3_cio>, <&ps_atc3_cio_pcie>,
+			<&ps_atc3_cio_usb>, <&ps_atc3_pcie>;
+	apple,pcie-tunnel = <&usb4_3_pcie_tunnel>;
+};
-- 
