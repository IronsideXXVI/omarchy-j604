From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 20 Nov 2026 21:48:22 +0000
Subject: [PATCH] media: apple: avd: Name the Daisy entries that do not
 read back

With axi_daisy=3 the T8132 bridge reports "32 of 47 read back": all
32 AXI2AF entries match and the 15 upstream and downstream flow-control
entries do not. The count alone cannot tell a register that ignores the
write from one that carries status or self-clearing bits.

In mode 3, read the flow-control registers before writing them and, on
the first two power-ups that miss, log each entry that differs with its
mask, the value written, the value read and the value it held before.
Modes 0, 1 and 2 are unchanged and the default stays 0.

Assisted-by: LLM
---
 drivers/media/platform/apple/avd/avd-pm.c | 51 +++++++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/drivers/media/platform/apple/avd/avd-pm.c b/drivers/media/platform/apple/avd/avd-pm.c
index 4ece3194daf..5e147254801 100644
--- a/drivers/media/platform/apple/avd/avd-pm.c
+++ b/drivers/media/platform/apple/avd/avd-pm.c
@@ -468,8 +468,44 @@ unsigned int avd_pm_write_daisy_tunables(void __iomem *base)
 	return ok;
 }
 
+/*
+ * Mode 3 only: name each entry whose read-back differs, with the value it
+ * held before the write, so a register that ignores the write can be told
+ * from one with status or self-clearing bits. Logged on the first two
+ * power-ups that miss, then quiet.
+ */
+static unsigned int daisy_reports;
+
+static void avd_pm_daisy_snap(void __iomem *base, const struct avd_tunable *t,
+			      unsigned int n, u32 *before)
+{
+	for (unsigned int i = 0; i < n; i++)
+		before[i] = readl(base + t[i].off);
+}
+
+static void avd_pm_daisy_report(struct avd_dev *avd, const char *what,
+				const struct avd_tunable *t, unsigned int n,
+				const u32 *before)
+{
+	void __iomem *base = avd->pm.axi2af;
+
+	for (unsigned int i = 0; i < n; i++) {
+		u32 v = readl(base + t[i].off);
+
+		if ((v & t[i].mask) == (t[i].val & t[i].mask))
+			continue;
+		if (before)
+			dev_info(avd->dev, "AXI daisy %s +0x%04x mask 0x%08x wrote 0x%08x reads 0x%08x was 0x%08x\n",
+				 what, t[i].off, t[i].mask, t[i].val, v, before[i]);
+		else
+			dev_info(avd->dev, "AXI daisy %s +0x%04x mask 0x%08x wrote 0x%08x reads 0x%08x\n",
+				 what, t[i].off, t[i].mask, t[i].val, v);
+	}
+}
+
 void avd_pm_apply_axi_daisy(struct avd_dev *avd)
 {
+	u32 before[ARRAY_SIZE(avd_daisy_flow_up) + ARRAY_SIZE(avd_daisy_flow_dn)];
 	unsigned int ok;
 
 	if (!axi_daisy || axi_daisy > 3 || !avd->pm.axi2af)
@@ -489,9 +525,24 @@ void avd_pm_apply_axi_daisy(struct avd_dev *avd)
 				 ARRAY_SIZE(avd_daisy_axi2af), base);
 		return;
 	}
+	avd_pm_daisy_snap(avd->pm.axi2af, avd_daisy_flow_up,
+			  ARRAY_SIZE(avd_daisy_flow_up), before);
+	avd_pm_daisy_snap(avd->pm.axi2af, avd_daisy_flow_dn,
+			  ARRAY_SIZE(avd_daisy_flow_dn),
+			  before + ARRAY_SIZE(avd_daisy_flow_up));
 	ok = avd_pm_write_daisy_tunables(avd->pm.axi2af);
 	dev_info_ratelimited(avd->dev, "AXI daisy tables applied: %u of %u read back\n",
 			     ok, AVD_DAISY_TUNABLES);
+	if (ok == AVD_DAISY_TUNABLES || daisy_reports >= 2)
+		return;
+	daisy_reports++;
+	avd_pm_daisy_report(avd, "up", avd_daisy_flow_up,
+			    ARRAY_SIZE(avd_daisy_flow_up), before);
+	avd_pm_daisy_report(avd, "dn", avd_daisy_flow_dn,
+			    ARRAY_SIZE(avd_daisy_flow_dn),
+			    before + ARRAY_SIZE(avd_daisy_flow_up));
+	avd_pm_daisy_report(avd, "axi2af", avd_daisy_axi2af,
+			    ARRAY_SIZE(avd_daisy_axi2af), NULL);
 }
 
