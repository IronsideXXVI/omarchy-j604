From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 08:53:00 +0000
Subject: [PATCH] drm/asahi: gate integer relative-power tables for the
 25G83 ABI

Add default-off init_macos bit 0x200000 for the two sixteen-word Main relative-power arrays. 25G83 interpolates integer percentages; 26B123 captures contain float percentages. Truncate finite values without kernel FPU use, reject invalid or above-100 values, and retain firmware state floor/ceiling clamping. Tests cover both arrays, disabled byte identity, boundaries and cap replay.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/fw/initdata.rs | 95 +++++++++++++++++++++++-
 1 file changed, 92 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/fw/initdata.rs b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
index 5a1b537cc9..6be9f40c17 100644
--- a/drivers/gpu/drm/asahi/g16/fw/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
@@ -412,7 +412,10 @@ pub(crate) mod init_macos {
     pub(crate) const AON_PTD_ENABLE_WORDS: u32 = 1 << 19;
     /// [`AON_PTD_SENSORS`]: four more sensor keys and their mask (25G83 0x27638).
     pub(crate) const AON_PTD_SENSOR_WORDS: u32 = 1 << 20;
-    pub(crate) const ALL: u32 = 0x1fffff;
+    /// 25G83 consumes both relative-power tables as integer percentages, unlike 26B123.
+    /// Default off; only the two 16-word Main arrays are converted.
+    pub(crate) const RELATIVE_PERCENT_25: u32 = 1 << 21;
+    pub(crate) const ALL: u32 = 0x3fffff;
 
     pub(crate) const RUNTIME_LOG: usize = 0x250;
     pub(crate) const RUNTIME_TIMER_COPY: usize = 0x8;
@@ -1235,7 +1238,39 @@ pub(crate) fn encode(
             input.fw_thermal,
         )?;
     }
-    encode_init_macos(objects, input)
+    encode_init_macos(objects, input)?;
+    encode_relative_percent25(objects[id::MAIN], input.init_macos)
+}
+
+/// Encode non-negative finite f32 percent bits as truncated integer percent without FPU.
+/// Reject out-of-domain inputs rather than silently accepting NaNs or unrelated words.
+/// The 25G83 controller itself clamps interpolated state*100 to its floor and ceiling.
+fn percent25(bits: u32) -> Result<u32, ()> {
+    if bits > 0x42c8_0000 {
+        return Err(());
+    }
+    let exponent = (bits >> 23) & 0xff;
+    if exponent < 127 {
+        return Ok(0);
+    }
+    Ok(((bits & 0x7f_ffff) | 0x80_0000) >> (150 - exponent))
+}
+
+fn encode_relative_percent25(main: &mut [u8], bits: u32) -> Result<(), ()> {
+    if bits & init_macos::RELATIVE_PERCENT_25 == 0 {
+        return Ok(());
+    }
+    // INIT 0x319b4..0x31a44 copies 16 rows from each table. Keep the five unused rows zero.
+    // 25G83 readers 0x25e98 and 0x11e88 use integer interpolation; 26B123 uses floats.
+    for base in [hwdata::j604::RELATIVE_A, hwdata::j604::RELATIVE_B] {
+        for i in 0..16 {
+            let at = base + 4 * i;
+            let bytes = main.get(at..at + 4).ok_or(())?;
+            let value = u32::from_le_bytes(bytes.try_into().map_err(|_| ())?);
+            put32(main, at, percent25(value)?)?;
+        }
+    }
+    Ok(())
 }
 
 /// Writes the [`init_macos`] words `input.init_macos` selects; nothing when it is 0.
@@ -1409,6 +1444,60 @@ fn the_word_matches_g17_region_c_and_misses_the_policy_words() {
         assert!(globals::POLICY.contains(&(0x9cc, 50)));
     }
 
+    #[test]
+    fn relative_percent25_conversion_and_scope() {
+        assert_eq!(percent25(0), Ok(0));
+        assert_eq!(percent25(0x3f7f_ffff), Ok(0)); // just below one
+        assert_eq!(percent25(0x3f80_0000), Ok(1));
+        assert_eq!(percent25(0x410a_8eae), Ok(8)); // truncate, not round to nearest
+        assert_eq!(percent25(0x42c8_0000), Ok(100));
+        assert!(percent25(0x42c8_0001).is_err()); // no out-of-range saturation
+        assert!(percent25(0xbf80_0000).is_err());
+        assert!(percent25(0x7f80_0000).is_err());
+        assert!(percent25(0x7fc0_0000).is_err());
+        let mut main = [0xa5; 0x2658];
+        let untouched = main;
+        encode_relative_percent25(&mut main, 0).unwrap();
+        assert_eq!(main, untouched);
+        for (base, rows) in [
+            (hwdata::j604::RELATIVE_A, hwdata::j604::RELATIVE_A_ROWS),
+            (hwdata::j604::RELATIVE_B, hwdata::j604::RELATIVE_B_ROWS),
+        ] {
+            for i in 0..16 {
+                put32(&mut main, base + 4 * i, rows.get(i).copied().unwrap_or(0)).unwrap();
+            }
+        }
+        let before = main;
+        encode_relative_percent25(&mut main, init_macos::RELATIVE_PERCENT_25).unwrap();
+        let expected = [
+            [0, 8, 14, 20, 27, 36, 44, 53, 60, 79, 100, 0, 0, 0, 0, 0],
+            [0, 0, 22, 36, 47, 57, 67, 75, 80, 91, 100, 0, 0, 0, 0, 0],
+        ];
+        for (j, base) in [0x18c8, 0x1908].into_iter().enumerate() {
+            for i in 0..16 {
+                let bytes = &main[base + 4 * i..base + 4 * i + 4];
+                let v = u32::from_le_bytes(bytes.try_into().unwrap());
+                assert_eq!(v, expected[j][i]);
+            }
+        }
+        for i in 0..main.len() {
+            if !(0x18c8..0x1948).contains(&i) {
+                assert_eq!(main[i], before[i]);
+            }
+        }
+        // The integer consumer clamps the request to state*100 floor/top.
+        let cap = |request: u32, rows: &[u32]| {
+            let lower = (0..10).rev().find(|&i| request >= rows[i]).unwrap();
+            let span = rows[lower + 1] - rows[lower];
+            let fraction = if span == 0 { 0 } else { (request - rows[lower]) * 100 / span };
+            (lower as u32 * 100 + fraction).clamp(40, 1000)
+        };
+        assert_eq!(cap(100, &hwdata::j604::RELATIVE_A_ROWS), 40);
+        assert_eq!(cap(100, &expected[0]), 1000);
+        assert_eq!(cap(100, &expected[1]), 1000);
+        assert_eq!(cap(0, &expected[0]), 40);
+    }
+
     #[test]
     fn the_init_macos_words_miss_the_controller_words() {
         for (at, _) in init_macos::PP.iter().chain(init_macos::PP_TAIL.iter()) {
@@ -1416,7 +1505,7 @@ fn the_init_macos_words_miss_the_controller_words() {
                 .iter()
                 .any(|(c, _)| c == at));
         }
-        assert_eq!(init_macos::ALL, (init_macos::AON_PTD_SENSOR_WORDS << 1) - 1);
+        assert_eq!(init_macos::ALL, (init_macos::RELATIVE_PERCENT_25 << 1) - 1);
         // The sensor keys the controller words also write agree, and they are the table's.
         for (at, value) in init_macos::AON_PTD_ENABLE
             .iter()
