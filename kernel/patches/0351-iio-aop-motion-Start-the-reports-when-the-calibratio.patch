From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sun, 1 Nov 2026 10:26:47 +1100
Subject: [PATCH] iio: aop: motion: Start the reports when the calibration is
 already held

The T6040 firmware takes a service's calibration once per AOP boot.
When it is sent again, after a rebind or on resume, the firmware
answers the range-intrinsic and nominal-extrinsic writes with
kIOReturnUnsupported (0xe00002c7), accepts the range-extrinsic one and
keeps the calibration it holds. The driver treated that status as a
failure. A rebind then failed with EIO, and after resume the reports
were not restarted.

Treat that status on a calibration write as "already held", log how
many packets were kept, and go on to the report interval. Any other
non-zero status still stops the start. Cover the status decision in
the host selftest. This has been measured on the T6040 only.

On J616s, rebinding the stock driver fails with "property 75 refused:
status 0xe00002c7" on both devices. With this change both devices bind
again and report fresh samples.

Fixes: d2da58eb27a7 ("iio: aop: Add the accelerometer and gyroscope driver")
Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit 5a56a3e574c9262b59e57cd5cf05592ee5e07beb)
---
 drivers/iio/common/aop_sensors/aop_motion.rs  | 73 +++++++++++++++----
 .../selftests/drivers/apple/aop-motion.py     | 13 +++-
 2 files changed, 71 insertions(+), 15 deletions(-)

diff --git a/drivers/iio/common/aop_sensors/aop_motion.rs b/drivers/iio/common/aop_sensors/aop_motion.rs
index abeb11d5ec..ec369b4777 100644
--- a/drivers/iio/common/aop_sensors/aop_motion.rs
+++ b/drivers/iio/common/aop_sensors/aop_motion.rs
@@ -46,6 +46,30 @@ const CALIBRATION: [(u32, &CStr); 3] = [
 /// at byte 6. The other bytes carry no sample.
 const REPORT_LEN: usize = 22;
 const XYZ_OFFSET: usize = 6;
+/// The status a calibration write is answered with when the service already
+/// holds a calibration from an earlier start in the same AOP boot, as after a
+/// rebind or a resume. The firmware keeps that calibration, so the reports can
+/// be started without it.
+const STATUS_UNSUPPORTED: u32 = 0xe000_02c7;
+
+/// What the status of a calibration write means for the start of the reports.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum CalStatus {
+    /// The firmware took the packet.
+    Taken,
+    /// The firmware holds a calibration from an earlier start.
+    Held,
+    /// Anything else: the reports are not started.
+    Refused,
+}
+
+fn cal_status(status: u32) -> CalStatus {
+    match status {
+        0 => CalStatus::Taken,
+        STATUS_UNSUPPORTED => CalStatus::Held,
+        _ => CalStatus::Refused,
+    }
+}
 
 /// What one of the two services measures.
 struct Kind {
@@ -146,30 +170,51 @@ impl Control {
         )?)
     }
 
-    fn set(&self, prop: u32, value: &[u8]) -> Result {
+    /// Writes a property and returns the firmware's status.
+    fn write(&self, prop: u32, value: &[u8]) -> Result<u32> {
         let mut msg = KVec::with_capacity(8 + value.len(), GFP_KERNEL)?;
         msg.extend_from_slice(&0u32.to_le_bytes(), GFP_KERNEL)?;
         msg.extend_from_slice(&prop.to_le_bytes(), GFP_KERNEL)?;
         msg.extend_from_slice(value, GFP_KERNEL)?;
-        let status = self
-            .aop
-            .epic_call(&self.service, SUBTYPE_SET_PROPERTY, &msg)?;
-        if status != 0 {
-            dev_err!(
-                self.dev,
-                "property {} refused: status {:#x}\n",
-                prop,
-                status
-            );
-            return Err(EIO);
+        self.aop
+            .epic_call(&self.service, SUBTYPE_SET_PROPERTY, &msg)
+    }
+
+    fn refused(&self, prop: u32, status: u32) -> Error {
+        dev_err!(
+            self.dev,
+            "property {} refused: status {:#x}\n",
+            prop,
+            status
+        );
+        EIO
+    }
+
+    fn set(&self, prop: u32, value: &[u8]) -> Result {
+        match self.write(prop, value)? {
+            0 => Ok(()),
+            status => Err(self.refused(prop, status)),
         }
-        Ok(())
     }
 
     /// Sends the calibration, then the interval that starts the reports.
     fn start(&self) -> Result {
+        let mut held = 0;
         for ((prop, _), packet) in CALIBRATION.iter().zip(self.packets.iter()) {
-            self.set(*prop, packet)?;
+            let status = self.write(*prop, packet)?;
+            match cal_status(status) {
+                CalStatus::Taken => {}
+                CalStatus::Held => held += 1,
+                CalStatus::Refused => return Err(self.refused(*prop, status)),
+            }
+        }
+        if held > 0 {
+            dev_info!(
+                self.dev,
+                "{} of {} calibration packets kept from an earlier start\n",
+                held,
+                CALIBRATION.len()
+            );
         }
         self.set(PROP_INTERVAL, &INTERVAL_US.to_le_bytes())
     }
diff --git a/tools/testing/selftests/drivers/apple/aop-motion.py b/tools/testing/selftests/drivers/apple/aop-motion.py
index 592474bf70..a66d26b778 100755
--- a/tools/testing/selftests/drivers/apple/aop-motion.py
+++ b/tools/testing/selftests/drivers/apple/aop-motion.py
@@ -29,7 +29,9 @@ def main():
     motion = (root / "drivers/iio/common/aop_sensors/aop_motion.rs").read_text()
     parts = [const(motion, "REPORT_LEN"), const(motion, "XYZ_OFFSET"),
              block(motion, "fn decode("), block(motion, "fn le_u32("),
-             block(motion, "fn location0_packet("), r'''
+             block(motion, "fn location0_packet("),
+             const(motion, "STATUS_UNSUPPORTED"),
+             block(motion, "#[derive(Clone, Copy, Debug, PartialEq, Eq)]\nenum CalStatus"), block(motion, "fn cal_status("), r'''
 fn report(prefix: u8, xyz: [i32; 3], suffix: u8) -> Vec<u8> {
     let mut r = vec![prefix; 6];
     for v in xyz {
@@ -69,6 +71,15 @@ fn container(entries: &[(u32, &[u8])]) -> Vec<u8> {
     c
 }
 #[test]
+fn calibration_status() {
+    assert_eq!(cal_status(0), CalStatus::Taken);
+    // Answered once the service holds a calibration from an earlier start.
+    assert_eq!(cal_status(0xe000_02c7), CalStatus::Held);
+    for status in [1, 0xe000_02bc, 0xe000_02c2, 0xe000_02e2, 0xe000_02c6, u32::MAX] {
+        assert_eq!(cal_status(status), CalStatus::Refused, "{status:#x}");
+    }
+}
+#[test]
 fn selects_location_zero() {
     let a = [1u8; 44];
     let b = [2u8; 40];
