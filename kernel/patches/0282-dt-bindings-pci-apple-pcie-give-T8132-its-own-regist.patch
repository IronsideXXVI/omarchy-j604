From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bartosz Nitka <niteria@gmail.com>
Date: Tue, 10 Nov 2026 11:37:12 +0100
Subject: [PATCH] dt-bindings: pci: apple,pcie: give T8132 its own
 register list

T8132's ANS host has one port and one PHY, so the generic list, which
has four ports before the PHYs, never matched it. Its deep sleep also
needs the five windows T8140's does to bring the APCIe block back:
axi2af, cio3pll, clkgen, phy-block and phy-ip. List them after the four
the host always has.

Assisted-by: LLM
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 08666006342a1280580353e736d4f97b0b11913e)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../devicetree/bindings/pci/apple,pcie.yaml   | 57 +++++++++++++------
 1 file changed, 41 insertions(+), 16 deletions(-)

diff --git a/Documentation/devicetree/bindings/pci/apple,pcie.yaml b/Documentation/devicetree/bindings/pci/apple,pcie.yaml
index 3d1ae40305..f9098d6e0a 100644
--- a/Documentation/devicetree/bindings/pci/apple,pcie.yaml
+++ b/Documentation/devicetree/bindings/pci/apple,pcie.yaml
@@ -573,22 +573,47 @@ allOf:
                   interrupts:
                     maxItems: 3
               else:
-                properties:
-                  reg:
-                    maxItems: 10
-                  reg-names:
-                    minItems: 3
-                    items:
-                      - const: config
-                      - const: rc
-                      - const: port0
-                      - const: port1
-                      - const: port2
-                      - const: port3
-                      - const: phy0
-                      - const: phy1
-                      - const: phy2
-                      - const: phy3
+                if:
+                  properties:
+                    compatible:
+                      contains:
+                        const: apple,t8132-pcie
+                then:
+                  properties:
+                    reg:
+                      minItems: 4
+                      maxItems: 9
+                    reg-names:
+                      minItems: 4
+                      items:
+                        - const: config
+                        - const: rc
+                        - const: port0
+                        - const: phy0
+                        - const: axi2af
+                        - const: cio3pll
+                        - const: clkgen
+                        - const: phy-block
+                        - const: phy-ip
+                    interrupts:
+                      maxItems: 1
+                else:
+                  properties:
+                    reg:
+                      maxItems: 10
+                    reg-names:
+                      minItems: 3
+                      items:
+                        - const: config
+                        - const: rc
+                        - const: port0
+                        - const: port1
+                        - const: port2
+                        - const: port3
+                        - const: phy0
+                        - const: phy1
+                        - const: phy2
+                        - const: phy3
       patternProperties:
         "^pci@":
           properties:
-- 
