From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 06:39:21 +0000
Subject: [PATCH] drm/asahi: g16: Add the remaining macOS INIT words to
 g16_init_macos

Four init words macOS 26B123 writes on the J604 are not covered by any
switch yet. This firmware does not write them itself. Add one bit for
each group, all default off:

  0x100  Main +0x4..+0x5ec, 33 words below the loader table, at the
         same offsets in both builds
  0x200  FirmwareData +0x4 = 1
  0x400  Runtime +0x8 = the Timer's VA, as Runtime +0x10
  0x800  Main +0xe88 = 0: no retention pointer at INIT

With these bits clear the encoded objects are unchanged.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/asahi_core.rs      |  2 +-
 drivers/gpu/drm/asahi/g16/fw/initdata.rs | 77 +++++++++++++++++++++++-
 drivers/gpu/drm/asahi/g16/initdata.rs    | 10 +++
 3 files changed, 86 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_core.rs b/drivers/gpu/drm/asahi/asahi_core.rs
index 119e42a89c..c098783af0 100644
--- a/drivers/gpu/drm/asahi/asahi_core.rs
+++ b/drivers/gpu/drm/asahi/asahi_core.rs
@@ -305,7 +305,7 @@ fn init(module: &'static kernel::ThisModule) -> impl PinInit<Self, Error> {
         },
         g16_init_macos: u32 {
             default: 0,
-            description: "G16: macOS INIT words outside Main, bit mask (default 0: none)",
+            description: "G16: macOS INIT words beyond the Main table, bit mask (default 0: none)",
         },
         g16_init_cached: u32 {
             default: 0,
diff --git a/drivers/gpu/drm/asahi/g16/fw/initdata.rs b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
index 22fd65ac77..558d020fa3 100644
--- a/drivers/gpu/drm/asahi/g16/fw/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
@@ -382,9 +382,20 @@ pub(crate) mod init_macos {
     /// The Globals P-state selectors at the top row at INIT (macOS: 1000 with eleven rows)
     /// instead of the S1 startup value; written by the owner after [`super::encode`].
     pub(crate) const SELECTORS: u32 = 1 << 7;
-    pub(crate) const ALL: u32 = 0xff;
+    /// [`MAIN_LOW`]: Main words below the loader table, at the same offsets in both builds.
+    pub(crate) const MAIN_LOW_WORDS: u32 = 1 << 8;
+    /// FirmwareData +0x4 = 1.
+    pub(crate) const FIRMWARE_DATA_4: u32 = 1 << 9;
+    /// Runtime +0x8 = the Timer's VA, as Runtime +0x10.
+    pub(crate) const RUNTIME_TIMER_8: u32 = 1 << 10;
+    /// Main +0xe88 = 0: no retention pointer at INIT, as macOS (26B123 +0xfa0).
+    pub(crate) const NO_RETENTION: u32 = 1 << 11;
+    pub(crate) const ALL: u32 = 0xfff;
 
     pub(crate) const RUNTIME_LOG: usize = 0x250;
+    pub(crate) const RUNTIME_TIMER_COPY: usize = 0x8;
+    pub(crate) const FIRMWARE_DATA_WORD: usize = 0x4;
+    pub(crate) const MAIN_RETENTION: usize = 0xe88;
     pub(crate) const RUNTIME_STATS_MASK: usize = 0x3d8;
     pub(crate) const RUNTIME_COUNT_TABLE: usize = 0x2c8;
     pub(crate) const COUNT_TABLE_SIZE: usize = 0x800;
@@ -435,6 +446,45 @@ pub(crate) mod init_macos {
     /// 0xf is left out: it masks a table of AON-PTD source codes this switch does not write.
     pub(crate) const PP_TAIL: [(usize, u32); 1] = [(0x2eec, 0x42c80000)];
 
+    /// Main below +0x640 as macOS 26B123 writes it at INIT on the J604 (two boots, equal).
+    /// This firmware does not write these words itself. The offsets assume no change
+    /// below the loader table, where the one traced reader (+0x28) and the table agree.
+    pub(crate) const MAIN_LOW: [(usize, u32); 33] = [
+        (0x4, 0x6f),
+        (0x8, 0xffc00000),
+        (0x14, 0x10),
+        (0x1c, 0x10),
+        (0x20, 0xffff8000),
+        (0x24, 0x2ff),
+        (0xe0, 0x2008),
+        (0xe8, 0x20080000),
+        (0xf4, 0x2008),
+        (0xf8, 0x24cb),
+        (0xfc, 0xc98a2cfa),
+        (0x100, 0xf4f624cb),
+        (0x104, 0x1877e917),
+        (0x108, 0x38d924cb),
+        (0x10c, 0xbdab0000),
+        (0x2d8, 0xfff82000),
+        (0x2dc, 0xd32d2cdb),
+        (0x2e0, 0xf5002000),
+        (0x2e4, 0x21dae926),
+        (0x2e8, 0x38b62000),
+        (0x2ec, 0xc7420008),
+        (0x3e0, 0x7fe0),
+        (0x3e8, 0x7fe00000),
+        (0x3f4, 0x7fe0),
+        (0x3f8, 0x8000),
+        (0x400, 0x80000000),
+        (0x40c, 0x8000),
+        (0x5d8, 0x4b232645),
+        (0x5dc, 0xe98),
+        (0x5e0, 0xd5a2ea5f),
+        (0x5e4, 0x40003fff),
+        (0x5e8, 0xca5e4000),
+        (0x5ec, 0x4000f5a2),
+    ];
+
     const fn within(words: &[(usize, u32)], size: usize) -> bool {
         let mut i = 0;
         while i < words.len() {
@@ -450,6 +500,8 @@ const fn within(words: &[(usize, u32)], size: usize) -> bool {
     const _: () = assert!(within(&PP, OBJECT_SIZE[id::POWER_PERFORMANCE]));
     const _: () = assert!(within(&PP_TAIL, OBJECT_SIZE[id::POWER_PERFORMANCE]));
     const _: () = assert!(RUNTIME_COUNT_TABLE + 8 <= OBJECT_SIZE[id::RUNTIME]);
+    const _: () = assert!(within(&MAIN_LOW, 0x640));
+    const _: () = assert!(MAIN_RETENTION + 8 <= OBJECT_SIZE[id::MAIN]);
     const _: () = assert!(RUNTIME_STATS_MASK + 4 <= OBJECT_SIZE[id::RUNTIME]);
 }
 
@@ -1109,6 +1161,24 @@ pub(crate) fn encode(
     if bits & init_macos::COUNT_TABLE != 0 {
         put64(runtime, init_macos::RUNTIME_COUNT_TABLE, input.count_table)?;
     }
+    if bits & init_macos::RUNTIME_TIMER_8 != 0 {
+        put64(runtime, init_macos::RUNTIME_TIMER_COPY, input.va[id::TIMER])?;
+    }
+    if bits & init_macos::FIRMWARE_DATA_4 != 0 {
+        put32(
+            objects[id::FIRMWARE_DATA],
+            init_macos::FIRMWARE_DATA_WORD,
+            1,
+        )?;
+    }
+    if bits & init_macos::MAIN_LOW_WORDS != 0 {
+        for &(at, value) in &init_macos::MAIN_LOW {
+            put32(objects[id::MAIN], at, value)?;
+        }
+    }
+    if bits & init_macos::NO_RETENTION != 0 {
+        put64(objects[id::MAIN], init_macos::MAIN_RETENTION, 0)?;
+    }
     let mut groups = [
         (init_macos::POWER_WORDS, id::POWER, &init_macos::POWER[..]),
         (
@@ -1201,7 +1271,10 @@ fn the_init_macos_words_miss_the_controller_words() {
                 .iter()
                 .any(|(c, _)| c == at));
         }
-        assert_eq!(init_macos::ALL, (init_macos::SELECTORS << 1) - 1);
+        assert_eq!(init_macos::ALL, (init_macos::NO_RETENTION << 1) - 1);
+        for (at, _) in init_macos::MAIN_LOW {
+            assert!(at != 0x28 && at + 4 <= 0x640);
+        }
     }
 
     #[test]
diff --git a/drivers/gpu/drm/asahi/g16/initdata.rs b/drivers/gpu/drm/asahi/g16/initdata.rs
index f8d34214ff..1482e57489 100644
--- a/drivers/gpu/drm/asahi/g16/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/initdata.rs
@@ -319,6 +319,16 @@ pub(crate) fn build(
             (m >> 6) & 1,
             (m >> 7) & 1
         );
+        if m >> 8 != 0 {
+            dev_info!(
+                dev,
+                "M4 initdata: g16_init_macos: main-low {} fwdata-4 {} runtime-8 {} no-retention {}\n",
+                (m >> 8) & 1,
+                (m >> 9) & 1,
+                (m >> 10) & 1,
+                (m >> 11) & 1
+            );
+        }
         if m & (wire::init_macos::PP_WORDS | wire::init_macos::PP_TAIL_WORDS) != 0
             && !input.fw_controllers
         {
