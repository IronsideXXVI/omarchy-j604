From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 14:14:36 -0600
Subject: [PATCH] Revert "arm64: dts: apple: t8132-j604: Disable the USB-C
 ports for now"

This reverts commit 206db5893f.

The USB-C ports were disabled together with PCIe port 0 and the AOP
audio group because a device tree enabling all three hung the 14-inch
MacBook Pro (M4, 2024) early in boot. A device tree that keeps the
USB-C ports and the AOP group enabled and disables only PCIe port 0
boots to the desktop with this kernel (MEASURED 2026-11-04), so the
USB-C ports are not needed to avoid the hang. Enable them again.

PCIe port 0 stays disabled.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 23 +++++++++--------------
 1 file changed, 9 insertions(+), 14 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 9b27f48a60..ccb3210c3b 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -280,15 +280,10 @@
  * tree), USB2 only. Their SN201202X port controllers sit on SPMI A0; the
  * third controller on that bus (hpm5, USID 8) is the MagSafe port and is
  * not described.
- *
- * Disabled for now, with the SPMI bus of the port controllers: a J604 device
- * tree that enables these ports together with PCIe and the AOP hangs early
- * boot, before the console. Enable them again once a J604 boot with them
- * enabled has been shown to work.
  */
 
 &nub_spmi_a0 {
-	status = "disabled"; /* DTV-SPMIA0-1, DTV-SPMIA0-2 */
+	status = "okay"; /* DTV-SPMIA0-1, DTV-SPMIA0-2 */
 
 	hpm1: usb-pd@a {
 		compatible = "apple,t8132-sn201202x", "apple,sn201202x";
@@ -362,7 +357,7 @@
 };
 
 &atcphy0 {
-	status = "disabled"; /* DTV-USB-0a */
+	status = "okay"; /* DTV-USB-0a */
 
 	ports {
 		#address-cells = <1>;
@@ -378,16 +373,16 @@
 };
 
 &dwc3_0_dart_0 {
-	status = "disabled"; /* DTV-USB-0c */
+	status = "okay"; /* DTV-USB-0c */
 };
 
 &dwc3_0_dart_1 {
-	status = "disabled"; /* DTV-USB-0c */
+	status = "okay"; /* DTV-USB-0c */
 };
 
 &dwc3_0 {
 	dr_mode = "host";
-	status = "disabled"; /* DTV-USB-0b */
+	status = "okay"; /* DTV-USB-0b */
 
 	ports {
 		#address-cells = <1>;
@@ -403,7 +398,7 @@
 };
 
 &atcphy1 {
-	status = "disabled"; /* DTV-USB-1a */
+	status = "okay"; /* DTV-USB-1a */
 
 	ports {
 		#address-cells = <1>;
@@ -419,16 +414,16 @@
 };
 
 &dwc3_1_dart_0 {
-	status = "disabled"; /* DTV-USB-1c */
+	status = "okay"; /* DTV-USB-1c */
 };
 
 &dwc3_1_dart_1 {
-	status = "disabled"; /* DTV-USB-1c */
+	status = "okay"; /* DTV-USB-1c */
 };
 
 &dwc3_1 {
 	dr_mode = "host";
-	status = "disabled"; /* DTV-USB-1b */
+	status = "okay"; /* DTV-USB-1b */
 
 	ports {
 		#address-cells = <1>;
