From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 10:19:51 +0000
Subject: [PATCH] arm64: dts: apple: t8132: describe the JPEG engines

Add the two T8132 JPEG engines and their DARTs from the J604 runtime
ADT (/arm-io/jpeg0, jpeg1, dart-jpeg0, dart-jpeg1):

  jpeg0       0x3a5000000 +0x4000  irq 1019  dart-jpeg0 sid 0
  dart-jpeg0  0x3a5020000 +0xc000  irq 1020
  jpeg1       0x3a5060000 +0x4000  irq 1022  dart-jpeg1 sid 0
  dart-jpeg1  0x3a5080000 +0xc000  irq 1023

The ADT power gates of both engines (JPG0-V, JPG1-V) are virtual
children of the JPG power state at PMGR +0x578 (ps_jpg); the
JPG-SOC-VMAX/VNOM entries are performance votes, not power states,
and are not described (as on T6041). The DART window is the ADT
vm-base/vm-size (0x10000000000 + 0x30000000000), and each engine
takes the T6041 4 GiB DMA window.

Every node is "disabled" here and no board enables it, so nothing
probes and no power state changes until a board opts in.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
(cherry picked from commit 68e97f835a7ec86db029242d508e7ddd10bab6be)
(cherry picked from commit 444ea401d03e8a74c843f5d71574b59dde47de27)
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 49 ++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index fb3e06e633..d8614aff47 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -722,6 +722,55 @@
 			};
 		};
 
+		/*
+		 * JPEG engines: J604 runtime ADT jpeg0/jpeg1 (hw-type 100008, the
+		 * T6041 revision) and dart-jpeg0/1 (sid 0, vm-base 0x10000000000,
+		 * vm-size 0x30000000000), all under the JPG power state.
+		 */
+		jpeg0: jpeg@3a5000000 {
+			compatible = "apple,t8132-jpeg", "apple,t6041-jpeg";
+			reg = <0x3 0xa5000000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1019 IRQ_TYPE_LEVEL_HIGH>;
+			iommus = <&jpeg0_dart 0>;
+			power-domains = <&ps_jpg>;
+			apple,dma-range = /bits/ 64 <0x10000000000 0x100000000>;
+			status = "disabled";
+		};
+
+		jpeg0_dart: iommu@3a5020000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x3 0xa5020000 0x0 0xc000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1020 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			apple,dma-range = <0x100 0x0 0x300 0x0>;
+			power-domains = <&ps_jpg>;
+			status = "disabled";
+		};
+
+		jpeg1: jpeg@3a5060000 {
+			compatible = "apple,t8132-jpeg", "apple,t6041-jpeg";
+			reg = <0x3 0xa5060000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1022 IRQ_TYPE_LEVEL_HIGH>;
+			iommus = <&jpeg1_dart 0>;
+			power-domains = <&ps_jpg>;
+			apple,dma-range = /bits/ 64 <0x10000000000 0x100000000>;
+			status = "disabled";
+		};
+
+		jpeg1_dart: iommu@3a5080000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x3 0xa5080000 0x0 0xc000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1023 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			apple,dma-range = <0x100 0x0 0x300 0x0>;
+			power-domains = <&ps_jpg>;
+			status = "disabled";
+		};
+
 		/*
 		 * The SEP DART's input aperture is the BIT(40) alias the DART
 		 * translates (ADT vm-base-0 0x10000004000).
