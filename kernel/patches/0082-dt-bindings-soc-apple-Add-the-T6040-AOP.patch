+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/apple/apple,t6041-aop.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple T604x Always-On Processor
+
+maintainers:
+  - Jonathan Goyvaerts <jonathan.goyvaerts@gmail.com>
+
+description:
+  The Always-On Processor provides audio and sensor services through firmware
+  loaded by the bootloader. The application processor patches the firmware's
+  boot arguments in the AOP SRAM, starts it through RTKit over one mailbox and
+  reaches its services through the RTKit endpoints. The bootloader reserves
+  the firmware's external code and log segments as /reserved-memory nodes
+  named aop-etext and aop-oslog; no mapping of them survives the reset of the
+  AOP's DART, so the operating system maps them again before the start.
+
+properties:
+  compatible:
+    const: apple,t6041-aop
+
+  reg:
+    minItems: 2
+    items:
+      - description: AOP SRAM, holding the boot-argument table
+      - description: ASC wrapper and processor control registers
+      - description: Second ASC register window
+      - description: AOP configuration registers
+
+  reg-names:
+    minItems: 2
+    items:
+      - const: firmware
+      - const: asc
+      - const: asc-aux
+      - const: config
+
+  mboxes:
+    maxItems: 1
+
+  mbox-names:
+    const: mbox
+
+  iommus:
+    maxItems: 1
+
+  audio:
+    type: object
+    description: The audio service.
+
+  als:
+    type: object
+    description: The ambient light sensor service.
+    additionalProperties: false
+
+    properties:
+      compatible:
+        items:
+          - const: apple,t6041-aop-als
+          - const: apple,aop-als
+
+    required:
+      - compatible
+
+  las:
+    type: object
+    description: The lid angle sensor service.
+    additionalProperties: false
+
+    properties:
+      compatible:
+        items:
+          - const: apple,t6041-aop-las
+          - const: apple,aop-las
+
+    required:
+      - compatible
+
+required:
+  - compatible
+  - reg
+  - mboxes
+  - mbox-names
+  - iommus
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        aop@510c10000 {
+            compatible = "apple,t6041-aop";
+            reg = <0x5 0x10c10000 0x0 0x2e0000>,
+                  <0x5 0x10600000 0x0 0x88000>,
+                  <0x5 0x10050000 0x0 0x4000>,
+                  <0x5 0x08328000 0x0 0x24>;
+            reg-names = "firmware", "asc", "asc-aux", "config";
+            mboxes = <&aop_mbox>;
+            mbox-names = "mbox";
+            iommus = <&aop_dart 0>;
+
+            als {
+                compatible = "apple,t6041-aop-als", "apple,aop-als";
+            };
+
+            las {
+                compatible = "apple,t6041-aop-las", "apple,aop-las";
+            };
+        };
+    };
