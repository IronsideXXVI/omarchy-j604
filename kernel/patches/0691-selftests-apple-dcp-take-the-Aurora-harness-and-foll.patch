+                   if line.startswith('#define IOMFB_GAMMA_ENTRIES')) + '\n'
+    for name in ('req', 'resp'):
+        prefix += block(header, 'struct iomfb_gamma_table_' + name + ' {') + ';\n'
+    prefix += r'''
