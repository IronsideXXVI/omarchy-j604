+    dart = (root / 'drivers/iommu/apple-dart.c').read_text()
+    dcp = (root / 'drivers/gpu/drm/apple/dcp.c').read_text()
+    dart_dcp = root / 'drivers/iommu/apple-dart-dcp.h'
+    borrowed = borrowed_fail(dart_dcp.read_text() if dart_dcp.exists() else '')
+    common = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <errno.h>
+#include <string.h>
