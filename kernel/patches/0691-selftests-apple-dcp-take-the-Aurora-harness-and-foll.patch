+    """The real apple_dart_fail_borrowed() and a leaf apple_dart_dcp_fail(), if the tree has the macro."""
+    marker = '#define apple_dart_fail_borrowed('
+    if marker not in header:
+        return ''
+    lines = header[header.index(marker):].splitlines()
+    macro = [lines[0]]
+    while macro[-1].endswith('\\'):
+        macro.append(lines[len(macro)])
+    return ('#ifndef ARRAY_SIZE\n#define ARRAY_SIZE(a) (sizeof(a)/sizeof((a)[0]))\n#endif\n'
+            'static void apple_dart_dcp_fail(struct apple_dart_dcp *s, const char *fmt, ...)\n'
+            '{ (void)fmt; s->failed = true; }\n' + '\n'.join(macro) + '\n')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
