+TIMING_MAIN = r'''
+struct timing_case {
+    const char *name;
+    const struct dcp_m4_profile *profile;
+    const u8 *data;
+    size_t size;
+    int expect;
+    u32 mode[10];
+};
+static const struct timing_case cases[] = {
+%s
+};
+int main(void)
+{
+    for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+        const struct timing_case *c = &cases[i];
+        struct dcp_m4_timing t;
+        int ret;
+        memset(&t, 0xa5, sizeof(t));
+        dcp_m4_pf = c->profile;
