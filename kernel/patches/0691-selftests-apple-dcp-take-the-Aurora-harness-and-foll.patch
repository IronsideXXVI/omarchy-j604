+    assert((s64)fw[1] == -(s64)(1LL << 32));  /* -1.0 */
+    assert(fw[2] == 0);                       /* negative zero */
+    assert((s64)fw[3] == -1);                 /* smallest step */
+    assert((s64)fw[4] == -0x7fffffffffffffffLL);
