From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 28 Oct 2026 09:44:06 -0400
Subject: [PATCH] dt-bindings: iommu: apple,dart: Add the address filter
 registers

Apple DARTs have address filter (DAPF) registers next to their
translation registers. They restrict the physical addresses the DART
lets its masters reach, and lose their contents whenever the DART's
power domain is off.

Allow them as an optional second register range named "dapf", so that a
device whose coprocessor reaches fixed MMIO windows through the DART can
program them after every power-up, finding them on the DART it already
references.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 6602a37f73c66ad60b81d0117a40bdd0419ce08e)
---
 .../devicetree/bindings/iommu/apple,dart.yaml | 33 ++++++++++++++++++-
 1 file changed, 32 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/iommu/apple,dart.yaml b/Documentation/devicetree/bindings/iommu/apple,dart.yaml
index 8e164bb698..865cd9584b 100644
--- a/Documentation/devicetree/bindings/iommu/apple,dart.yaml
+++ b/Documentation/devicetree/bindings/iommu/apple,dart.yaml
@@ -60,7 +60,18 @@ properties:
       error-mask policy rather than changing it for these streams.
 
   reg:
-    maxItems: 1
+    minItems: 1
+    items:
+      - description: DART registers
+      - description:
+          Address filter (DAPF) registers, which restrict the physical
+          addresses the DART lets its masters reach
+
+  reg-names:
+    minItems: 1
+    items:
+      - const: dart
+      - const: dapf
 
   interrupts:
     maxItems: 1
@@ -139,6 +150,17 @@ required:
   - '#iommu-cells'
   - interrupts
 
+allOf:
+  - if:
+      properties:
+        reg:
+          minItems: 2
+      required:
+        - reg
+    then:
+      required:
+        - reg-names
+
 additionalProperties: false
 
 examples:
@@ -171,3 +193,12 @@ examples:
     master2 {
       iommus = <&dart2a 0>, <&dart2b 1>;
     };
+
+  - |+
+    dart3: iommu@8e8c0000 {
+      compatible = "apple,t8132-dart", "apple,t8110-dart";
+      reg = <0x8e8c0000 0xc000>, <0x8e8d0000 0x4000>;
+      reg-names = "dart", "dapf";
+      interrupts = <1 387 4>;
+      #iommu-cells = <1>;
+    };
