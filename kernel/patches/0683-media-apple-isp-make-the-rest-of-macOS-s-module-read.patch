From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 10:25:43 +0000
Subject: [PATCH] media: apple: isp: make the rest of macOS's module
 reads at open

With macos_cal_reads set, the driver reads the module calibration that
macOS reads around the setfile load, but not all of it. macOS also reads
the focus limits before the load, and the dual-camera switchover zoom
(twice), the extrinsics (three times, for all channels), the lens
distortion and the image rotation correction after it.

Make those reads too, with macOS's request lengths, so that the switch
covers every module read macOS makes when the camera opens, except the
per-module luma shading read, whose request carries a buffer address and
whose size is not known yet. Replies are logged on the first stream as
before: small ones in full, the distortion and extrinsics as a hash.
Still off by default.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit ed721de73a45f55d75b8ec3f9a828372afd03627)
---
 drivers/media/platform/apple/isp/isp-cam.c | 19 ++++++++++++++++---
 drivers/media/platform/apple/isp/isp-cmd.h |  4 ++++
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 51391b5244..765b929e8e 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -1225,7 +1225,8 @@ static void isp_setfile_radial_gain(u8 *data, size_t len)
  * calibration: the lens shading polynomials of every sensor config, the
  * sensor NVM and the per-module lens shading before the load; the AWB
  * calibration matrix, the AWB gains ahead of the CCM and the colour
- * calibration after it. The driver reads none of it. If the firmware
+ * calibration after it, and the lens limits, distortion, extrinsics and
+ * rotation correction. The driver reads none of it. If the firmware
  * applies the module calibration only once it has been read, these reads
  * alone change the picture; in any case the first stream logs what they
  * return (NVM and grids only as a hash: the NVM also holds the module
@@ -1279,6 +1280,7 @@ static void isp_ch_macos_cal_reads(struct apple_isp *isp, u32 ch, bool loaded)
 		bool after_load;
 		bool show;
 		const char *name;
+		bool all_channels;
 	} reads[] = {
 		{ CISP_CMD_CH_LSC_POLYNOMIAL_COEFF_GET,
 		  0x48, 0xc, 13, 0, false, false, "LSC polynomial" },
@@ -1288,12 +1290,22 @@ static void isp_ch_macos_cal_reads(struct apple_isp *isp, u32 ch, bool loaded)
 		  0x14, 0, 1, 0, false, true, "module LSC info" },
 		{ CISP_CMD_CH_SENSOR_PERMODULE_LSC_GRID_GET,
 		  0x400, 0, 1, 0, false, false, "module LSC grid" },
+		{ CISP_CMD_CH_FOCUS_LIMITS_GET,
+		  0x10, 0, 1, 0, false, true, "focus limits" },
+		{ CISP_CMD_CH_MS_SWITCHOVER_ZOOM_FACTOR_GET,
+		  0x10, 0, 2, 0, true, true, "switchover zoom" },
+		{ CISP_CMD_EXTRINSIC_DATA_GET,
+		  0x70, 0, 3, 0, true, false, "extrinsics", true },
 		{ CISP_CMD_APPLE_CH_AWB_CALIBRATION_MATRIX_GET,
 		  0x5c, 0, 1, 0, true, true, "AWB calibration matrix" },
 		{ CISP_CMD_APPLE_CH_AWB_PRE_CCM_GAIN_GET,
 		  0x18, 0, 1, 0, true, true, "AWB pre-CCM gains" },
+		{ CISP_CMD_CH_DISTORTION_DATA_GET,
+		  0x400, 0, 1, 0, true, false, "distortion" },
 		{ CISP_CMD_CH_COLOR_CAL_ABS_GET,
 		  0x18, 0, 1, 0, true, true, "colour calibration" },
+		{ CISP_CMD_CH_IMAGE_ROTATION_CORRECTION_GET,
+		  0x24, 0, 1, 0, true, true, "rotation correction" },
 	};
 	static bool logged;
 	size_t area = ISP_CMD_AREA_SIZE(isp_num_capmeta(isp));
@@ -1315,8 +1327,9 @@ static void isp_ch_macos_cal_reads(struct apple_isp *isp, u32 ch, bool loaded)
 			memset(buf, 0, reads[i].len);
 			if (reads[i].word_off)
 				memcpy(buf + reads[i].word_off, &word, sizeof(word));
-			err = isp_cmd_ch_raw_get(isp, reads[i].opcode, ch, buf,
-						 reads[i].len);
+			err = isp_cmd_ch_raw_get(isp, reads[i].opcode,
+						 reads[i].all_channels ? U32_MAX : ch,
+						 buf, reads[i].len);
 			if (logged)
 				continue;
 			if (err)
diff --git a/drivers/media/platform/apple/isp/isp-cmd.h b/drivers/media/platform/apple/isp/isp-cmd.h
index 889e7657da..5752489bb0 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.h
+++ b/drivers/media/platform/apple/isp/isp-cmd.h
@@ -67,6 +67,10 @@
 #define CISP_CMD_CH_COLOR_CAL_ABS_GET			     0x0808
 #define CISP_CMD_CH_LPDP_HS_RECEIVER_TUNING_SET		     0x051b
 #define CISP_CMD_CH_FOCUS_LIMITS_GET			     0x0701
+#define CISP_CMD_CH_IMAGE_ROTATION_CORRECTION_GET	     0x016a
+#define CISP_CMD_CH_MS_SWITCHOVER_ZOOM_FACTOR_GET	     0x0814
+#define CISP_CMD_CH_DISTORTION_DATA_GET			     0x7002
+#define CISP_CMD_EXTRINSIC_DATA_GET			     0x7005
 #define CISP_CMD_CH_CROP_GET				     0x0800
 #define CISP_CMD_CH_CROP_SET				     0x0801
 #define CISP_CMD_CH_SCALER_CROP_SET			     0x080a
-- 
2.43.0

