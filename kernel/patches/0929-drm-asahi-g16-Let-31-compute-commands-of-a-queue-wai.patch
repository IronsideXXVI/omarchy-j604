From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 18 Nov 2026 16:17:21 +0000
Subject: [PATCH] drm/asahi: g16: Let 31 compute commands of a queue
 wait behind a running one by default

Set g16_horizon to 31 by default. With 32 compute units, up to 31
compute commands of one queue may now be published behind its running
compute command, each on its own unit, as up to 15 could on 16 units.
The depth is still clamped to the latched units minus one, so with
g16_compute_units 16, or with g16_compute_shared_pool 0, it stays 15.
With one allocator descriptor per VM every command published behind a
running compute flight belongs to the same VM, as before.

Revert with g16_horizon=15 (runtime).

RESULT: to be filled by the release owner

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index ffb6b85af9..635fca6e5d 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -816,8 +816,8 @@ pub(crate) fn submit_ts() -> u32 {
     "G16: clock of the submit record time word (default 0: architectural counter; 1: firmware stage clock, 24 MHz; runtime 0644)"
 );
 
-/// Storage of `g16_horizon` (runtime 0644, default 15).
-static HORIZON: AtomicU32 = AtomicU32::new(15);
+/// Storage of `g16_horizon` (runtime 0644, default 31).
+static HORIZON: AtomicU32 = AtomicU32::new(31);
 
 /// Compute horizon, format A (per-command ahead posting): with `g16_horizon` = 1, a queue's
 /// next compute command may be published behind its running compute predecessor, into the
@@ -831,8 +831,9 @@ pub(crate) fn submit_ts() -> u32 {
 /// `COMPUTE_SLOTS - 1`): with one behind, every second command still waited for the host to
 /// notice a retirement (J604 k884: 30318 ahead at a 32 us gap, 74866 serial at ~200 us). With
 /// three behind (1.908) 80 % still ran serial: a command's round trip (doorbell to start ~95 us,
-/// completion to host ~108 us) outlasts four tiny commands. Default 15, on 16
-/// `g16_compute_units`: with 8 in flight the queue drained every ~7.7 commands.
+/// completion to host ~108 us) outlasts four tiny commands. Default 31, on 32
+/// `g16_compute_units` (15 on 16 up to 1.1056; clamped to the units - 1):
+/// with 8 in flight the queue drained every ~7.7 commands.
 pub(crate) fn horizon() -> bool {
     HORIZON.load(Ordering::Relaxed) != 0 && super::pools::lifetime::overlap_active()
 }
@@ -939,7 +940,7 @@ pub(crate) fn compute_shared_pool_state() -> u32 {
     HORIZON_PARM,
     HORIZON,
     "g16_horizon",
-    "G16: compute commands of one queue that may go behind its running compute predecessor (default 15; 1 up to g16_compute_units - 1, each on its own compute unit; needs g16_overlap=1 and g16_uma_split=1; 0: none; runtime 0644)"
+    "G16: compute commands of one queue that may go behind its running compute predecessor (default 31; 1 up to g16_compute_units - 1, each on its own compute unit; needs g16_overlap=1 and g16_uma_split=1; 0: none; runtime 0644)"
 );
 
 /// Storage of `g16_depth` (runtime 0644, default 0).
