From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 12:14:27 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: name the power words
 the J604 lacks

The J604's ADT has no power state at 32 main and 34 always-on PMGR
offsets that the T8132 sleep lists carry from the J713's ADT. List them
so that the sleep leaves them alone, as the J604's macOS does.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 54bc5da4ee..5eab4b7bfb 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -472,6 +472,20 @@ &sleep {
 	 * AUTO_ENABLE, and the other seven are in no J604 node.
 	 */
 	apple,ps-keep-on = <0x118 0x2f8 0x310 0x318 0x320 0x348 0x358 0x368>;
+	/*
+	 * Power words of the T8132 lists (taken from the J713's ADT) that the
+	 * J604's ADT has no device for: not touched around a sleep. The J604
+	 * macOS S2R record touches none of them either.
+	 */
+	apple,ps-absent = <0x100 0x128 0x130 0x198 0x1a0 0x1a8 0x1b0 0x1c0
+			   0x1c8 0x1d0 0x238 0x258 0x260 0x2f8 0x310 0x318
+			   0x320 0x328 0x330 0x338 0x340 0x348 0x350 0x358
+			   0x360 0x368 0x4c8 0x558 0x4000 0x4008 0x4010 0x4018>;
+	apple,ps-aon-absent = <0x78 0x98 0x4020 0x4090 0x40b8 0x40c0 0x40c8
+			       0x40d0 0x40d8 0x40e0 0x40e8 0x40f0 0x40f8 0x4100
+			       0x4108 0x4110 0x4118 0x4120 0x4128 0x4130 0x4138
+			       0x4140 0x4148 0x4150 0x4158 0x4160 0x4168 0x8028
+			       0x8030 0x8038 0x8040 0x8048 0x8080 0x8088>;
 	status = "okay";
 };
 
