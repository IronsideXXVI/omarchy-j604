From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 04:19:57 +0000
Subject: [PATCH] tools/asahi: pmgr-bus-tests: cover the T8132 PMGR banks

The T8132 banks carry "apple,t8132-pmgr", "apple,t8103-pmgr", "syscon",
"simple-mfd" on the J604 and the J713. Check that the production probe
binds such a bank as a transparent bus without side effects, and add a
negative control: with the T8132 entry removed from the match table the
binding assertion must fail, as it does for T6041.

Without that binding the mini PMGR bank stays a SYNC_STATE_ONLY consumer
of the main bank's ATC common domains, so they never reach sync_state()
and stay on with idle USB-C ports.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 tools/asahi/pmgr-bus-tests.py | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/tools/asahi/pmgr-bus-tests.py b/tools/asahi/pmgr-bus-tests.py
index 0d1d6de394..1a48237bcd 100644
--- a/tools/asahi/pmgr-bus-tests.py
+++ b/tools/asahi/pmgr-bus-tests.py
@@ -85,6 +85,10 @@ int main(void)
     struct device_node t6041 = {
         { "apple,t6041-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd" }
     };
+    /* Both T8132 banks (pmgr, pmgr_mini) carry this list, as on the J604 and J713. */
+    struct device_node t8132 = {
+        { "apple,t8132-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd" }
+    };
     struct device_node t8103 = {
         { "apple,t8103-pmgr", "apple,pmgr", "syscon", "simple-mfd" }
     };
@@ -94,6 +98,7 @@ int main(void)
         { "apple,future-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd" }
     };
     check(&t6041, 0, false);
+    check(&t8132, 0, false);
     check(&t8103, 0, false);
     check(&bus, 0, false);
     check(&dedicated, -ENODEV, false);
@@ -115,11 +120,11 @@ def main():
                    source.index('MODULE_DEVICE_TABLE(of, simple_pm_bus_of_match)')]
     with tempfile.TemporaryDirectory(prefix='pmgr-bus-') as tmp:
         tmp = Path(tmp)
-        for negative in (False, True):
+        for negative in (None, 't6041', 't8132'):
             selected = table
             if negative:
-                selected = re.sub(r'^.*"apple,t6041-pmgr".*\n', '', table, flags=re.M)
-                assert selected != table, 'T6041 transparent match missing'
+                selected = re.sub(r'^.*"apple,%s-pmgr".*\n' % negative, '', table, flags=re.M)
+                assert selected != table, '%s transparent match missing' % negative.upper()
             cfile, exe = tmp / 'test.c', tmp / 'test'
             cfile.write_text(PREAMBLE + bus + '\n' + probe + selected + MAIN)
             subprocess.run(shlex.split(os.environ.get('CC', 'cc')) +
@@ -128,7 +133,7 @@ def main():
             result = subprocess.run([str(exe)], capture_output=True, text=True)
             if negative:
                 assert result.returncode < 0 and 'Assertion' in result.stderr, result
-                print('PASS: removing the T6041 match fails the binding assertion')
+                print('PASS: removing the %s match fails the binding assertion' % negative.upper())
             else:
                 assert result.returncode == 0, result.stderr
                 print(result.stdout, end='')
