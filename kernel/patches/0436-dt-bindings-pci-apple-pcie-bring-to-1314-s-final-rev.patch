From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 05:17:01 +0000
Subject: [PATCH] dt-bindings: pci: apple,pcie: bring to #1314's final
 revision

Bring to its revision in aurora-silicon/linux#1314:
commit 1177aeee1cba ("dt-bindings: pci: apple,pcie: give T8132 its own
register list").
This tree carried an earlier revision:
commit 277f377ad161 ("dt-bindings: pci: apple,pcie: give T8132 its own
register list").
Only the difference between the two.

Based on 1177aeee1cba from aurora-silicon/linux#1314
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../devicetree/bindings/pci/apple,pcie.yaml   | 33 ++++++++++++-------
 1 file changed, 21 insertions(+), 12 deletions(-)

diff --git a/Documentation/devicetree/bindings/pci/apple,pcie.yaml b/Documentation/devicetree/bindings/pci/apple,pcie.yaml
index d3fb3fde4f..afe6d593c0 100644
--- a/Documentation/devicetree/bindings/pci/apple,pcie.yaml
+++ b/Documentation/devicetree/bindings/pci/apple,pcie.yaml
@@ -596,19 +596,28 @@ allOf:
                       minItems: 4
                       maxItems: 9
                     reg-names:
-                      minItems: 4
-                      items:
-                        - const: config
-                        - const: rc
-                        - const: port0
-                        - const: phy0
-                        - const: axi2af
-                        - const: cio3pll
-                        - const: clkgen
-                        - const: phy-block
-                        - const: phy-ip
+                      oneOf:
+                        - minItems: 4
+                          items:
+                            - const: config
+                            - const: rc
+                            - const: port0
+                            - const: phy0
+                            - const: axi2af
+                            - const: cio3pll
+                            - const: clkgen
+                            - const: phy-block
+                            - const: phy-ip
+                        # A board that uses the third port lists it instead.
+                        - items:
+                            - const: config
+                            - const: rc
+                            - const: port0
+                            - const: phy0
+                            - const: port2
+                            - const: phy2
                     interrupts:
-                      maxItems: 1
+                      maxItems: 3
                 else:
                   properties:
                     reg:
-- 
