From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 05:21:35 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j604: Enable the AOP, the
 microphones and the jack

Enable the AOP, its DART and mailbox, and both audio ADMACs on the
MacBook Pro 14" M4, with the AOP audio service for the three
microphones and the headphone jack as a card of its own: the CS42L84 at
0x4b on i2c1, reset on nub GPIO 17, interrupt on AP GPIO 98.

The J604 ADT matches the J713 one for every value used here: the AOP,
DART, mailbox and ADMAC addresses and interrupts, the DART streams (AOP
0, admac-base-ns 8, admac-leap-ns 10), the microphones' LEAP channel 1,
the jack's base-ns channels 4 and 5, and the codec's bus, address,
reset and interrupt. DTV-AUD-* tags name rows of DT-VERIFY-audio.tsv.

The AOP needs the loader's handoff (the DAPF and the firmware
memory-region). Until m1n1 provides it for the J604, the AOP driver
fails its probe before touching the AOP and neither card binds.

The six speaker amps (SN012776 on i2c3) stay undescribed until they get
a bring-up of their own.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
[dylan: tier c already ends the file with the t8132-j604-gpu.dtsi and
 t8132-j604-display.dtsi includes; the AOP, ADMAC and codec blocks follow
 them unchanged.]
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 78 ++++++++++++++++++++++++
 1 file changed, 78 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 0f80e2f7c0..3cf8202f47 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -40,6 +40,30 @@
 			default-state = "keep";
 		};
 	};
+
+	/*
+	 * The headphone jack: the AOP audio component's jack back-end (DAI 4)
+	 * to the CS42L84, as a card of its own.
+	 */
+	sound_jack: sound-jack {
+		compatible = "apple,j604-macaudio-jack", "apple,macaudio";
+		model = "MacBook Pro J604 Jack";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		dai-link@0 {
+			reg = <0>;
+			link-name = "Headphone Jack";
+
+			cpu {
+				sound-dai = <&aop_audio 4>;
+			};
+
+			codec {
+				sound-dai = <&jack_codec>;
+			};
+		};
+	};
 };
 
 &fpwm1 {
@@ -384,3 +408,57 @@
  * t8132-jxxx.dtsi keeps the panel (see t8132-j604-display.dtsi).
  */
 #include "t8132-j604-display.dtsi"
+
+/*
+ * AOP (always-on processor) audio: the three microphones and the headphone
+ * jack. The AOP needs the loader's handoff: m1n1 programs the AOP DART's
+ * DAPF and adds the firmware segments and the DAPF windows to the AOP's
+ * memory-region when /chosen asks for the AOP's handoff. Until m1n1 does so
+ * for the J604, the AOP driver finds no memory-region and fails its probe
+ * before touching the AOP, and the cards below never bind.
+ */
+&aop {
+	status = "okay"; /* DTV-AUD-1, DTV-AUD-2, DTV-AUD-13 */
+};
+
+&aop_audio {
+	/* The microphones on LEAP, the jack on base-ns TX2 and RX2. */
+	dmas = <&admac0 1>, <&admac1 4>, <&admac1 5>; /* DTV-AUD-7..9 */
+	dma-names = "dma", "cout", "cin";
+	apple,chassis-name = "J604";
+	apple,machine-kind = "MacBook Pro";
+};
+
+&aop_dart {
+	status = "okay"; /* DTV-AUD-4 */
+};
+
+&aop_mbox {
+	status = "okay"; /* DTV-AUD-3 */
+};
+
+&admac0 {
+	status = "okay"; /* DTV-AUD-5 */
+};
+
+&admac1 {
+	status = "okay"; /* DTV-AUD-6 */
+};
+
+/*
+ * The CS42L84 headphone codec (ADT /arm-io/i2c1/audio-codec-output at 0x4b).
+ * Its reset line is nub GPIO 17, driven high to run the codec; its interrupt
+ * is AP GPIO 98, level low. The AOP firmware runs the jack's stream.
+ */
+&i2c1 {
+	status = "okay";
+
+	jack_codec: codec@4b {
+		compatible = "cirrus,cs42l84";
+		reg = <0x4b>; /* DTV-AUD-10 */
+		reset-gpios = <&pinctrl_nub 17 GPIO_ACTIVE_HIGH>; /* DTV-AUD-11 */
+		#sound-dai-cells = <0>;
+		interrupts-extended = <&pinctrl_ap 98 IRQ_TYPE_LEVEL_LOW>; /* DTV-AUD-12 */
+		sound-name-prefix = "Jack";
+	};
+};
