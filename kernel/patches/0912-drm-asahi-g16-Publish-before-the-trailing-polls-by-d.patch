From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 21:36:23 +0000
Subject: [PATCH] drm/asahi: g16: Publish before the trailing polls by
 default

Turn g16_tail_cut on: a pass woken by a firmware event that has retired
a flight publishes into the freed unit at once instead of after its
four trailing 5 us busy polls. Writing 0 restores the polls.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 81bb069645..eeaf836b92 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2012,12 +2012,12 @@ fn render_patch_parse_u32(text: &str) -> Option<u32> {
         },
     });
 
-/// Storage of `g16_tail_cut` (runtime 0644, default 0).
-static TAIL_CUT: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_tail_cut` (runtime 0644, default 1).
+static TAIL_CUT: AtomicU32 = AtomicU32::new(1);
 
 /// Whether a pass woken by a firmware event ends its four trailing 5 us busy polls as soon as
 /// it has retired a flight, so that the same pass publishes into the freed unit at once. The
-/// next event or the completion re-poll catches later receipts. 0: the polls as before.
+/// next event or the completion re-poll catches later receipts. Default on; 0: the polls as before.
 pub(crate) fn tail_cut() -> bool {
     TAIL_CUT.load(Ordering::Relaxed) != 0
 }
@@ -2028,7 +2028,7 @@ pub(crate) fn tail_cut() -> bool {
     TAIL_CUT_PARM,
     TAIL_CUT,
     "g16_tail_cut",
-    "G16: 1: an evented pass that retired a flight skips its remaining trailing 5 us polls and publishes at once (default 0: as before; runtime 0644)"
+    "G16: 1: an evented pass that retired a flight skips its remaining trailing 5 us polls and publishes at once (default 1; 0: as before; runtime 0644)"
 );
 
 /// Storage of `g16_tail_us` (runtime 0644, default 0).
-- 
2.43.0

