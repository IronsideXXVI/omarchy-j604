From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:13 -0500
Subject: [PATCH] soc: apple: sart: restore entries after a firmware-driven
 suspend

The SART sits in its coprocessor's power domain, which a firmware-driven
suspend powers off, and the driver has no sleep code. A coprocessor that
restarts with an empty SART can't reach its firmware's buffers.

Save the entries in suspend_late, after the consumers have gone quiet,
and write back every one that was in use in resume_noirq, the same or
not, as macOS rewrites entries 0 to 7 at every wake. This includes the
bootloader's protected entries: Linux doesn't change those, it only puts
back what power loss took. macOS leaves unused entries at their power-on
flags, and so does this.

macOS writes the entries back once more right before ANS's run bit,
config first, then address, then size. apple_sart_replay() does that on
SARTv3, for the coprocessor's driver to call there, and warns about an
entry that doesn't read back.

Only a firmware-driven resume restores anything, so suspend-to-idle and
every SoC that doesn't advertise deep sleep are unchanged. The SART also
has throttle registers, which this doesn't touch since nothing in Linux
knows their layout.

Signed-off-by: Diljit Singh <hey@djdev.me>

[j604 backport: resolved: this tree's SART has no backend layer (sart-backend.h); the saved-entry fields are added without the backend fields, and apple_sart_replay() no longer tests sart->backend]
Assisted-by: Claude:claude-opus-5.5

---
 drivers/soc/apple/sart.c       | 104 +++++++++++++++++++++++++++++++++
 include/linux/soc/apple/sart.h |   6 ++
 2 files changed, 110 insertions(+)

diff --git a/drivers/soc/apple/sart.c b/drivers/soc/apple/sart.c
index b0b208c927..e99c693f1b 100644
--- a/drivers/soc/apple/sart.c
+++ b/drivers/soc/apple/sart.c
@@ -22,6 +22,7 @@
 #include <linux/of.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
+#include <linux/suspend.h>
 #include <linux/types.h>
 
 #define APPLE_SART_MAX_ENTRIES 16
@@ -82,6 +83,16 @@ struct apple_sart {
 
 	unsigned long protected_entries;
 	unsigned long used_entries;
+
+	/* The registers as they stood before a firmware-driven suspend */
+	struct {
+		u8 flags;
+		phys_addr_t paddr;
+		size_t size;
+	} saved[APPLE_SART_MAX_ENTRIES];
+	bool saved_valid;
+	/* saved[] still holds the last sleep's entries, for apple_sart_replay() */
+	bool replay_valid;
 };
 
 static void sart0_get_entry(struct apple_sart *sart, int index, u8 *flags,
@@ -371,6 +382,98 @@ static void apple_sart_shutdown(struct platform_device *pdev)
 	}
 }
 
+/*
+ * A SART in a domain that a firmware-driven suspend powers off comes back empty,
+ * and its coprocessor can't reach its firmware or buffers until the entries are
+ * back. This includes the bootloader's, which Linux otherwise never writes.
+ */
+static int apple_sart_suspend_late(struct device *dev)
+{
+	struct apple_sart *sart = dev_get_drvdata(dev);
+	int i;
+
+	sart->saved_valid = false;
+	sart->replay_valid = false;
+	if (pm_suspend_target_state != PM_SUSPEND_MEM || !pm_suspend_via_firmware())
+		return 0;
+
+	for (i = 0; i < APPLE_SART_MAX_ENTRIES; i++)
+		sart->ops->get_entry(sart, i, &sart->saved[i].flags,
+				     &sart->saved[i].paddr, &sart->saved[i].size);
+	sart->saved_valid = true;
+
+	return 0;
+}
+
+static int apple_sart_resume_noirq(struct device *dev)
+{
+	struct apple_sart *sart = dev_get_drvdata(dev);
+	unsigned int restored = 0;
+	int i;
+
+	if (!sart->saved_valid || !pm_resume_via_firmware())
+		return 0;
+	sart->saved_valid = false;
+
+	for (i = 0; i < APPLE_SART_MAX_ENTRIES; i++) {
+		/* An unused entry stays as the power left it, whatever that reads. */
+		if (!sart->saved[i].size && !sart->saved[i].flags)
+			continue;
+		/* Every one in use, the same or not: macOS rewrites 0 to 7 at every wake. */
+		sart->ops->set_entry(sart, i, sart->saved[i].flags,
+				     sart->saved[i].paddr >> sart->ops->paddr_shift,
+				     sart->saved[i].size >> sart->ops->size_shift);
+		restored++;
+	}
+	dev_dbg(dev, "%u entries restored after sleep\n", restored);
+	sart->replay_valid = true;
+
+	return 0;
+}
+
+/*
+ * A coprocessor's driver calls this right before its run bit. macOS writes the entries back
+ * there, config first, then address, then size, so this does the same on SARTv3. Unused
+ * entries stay as they read.
+ */
+int apple_sart_replay(struct apple_sart *sart)
+{
+	int i, bad = 0;
+
+	if (sart->ops != &sart_ops_v3 || !sart->replay_valid)
+		return -EOPNOTSUPP;
+
+	for (i = 0; i < APPLE_SART_MAX_ENTRIES; i++) {
+		phys_addr_t paddr;
+		size_t size;
+		u8 flags;
+
+		if (!sart->saved[i].size && !sart->saved[i].flags)
+			continue;
+		writel(sart->saved[i].flags, sart->regs + APPLE_SART3_CONFIG(i));
+		writel(sart->saved[i].paddr >> APPLE_SART3_PADDR_SHIFT,
+		       sart->regs + APPLE_SART3_PADDR(i));
+		writel(sart->saved[i].size >> APPLE_SART3_SIZE_SHIFT,
+		       sart->regs + APPLE_SART3_SIZE(i));
+		sart->ops->get_entry(sart, i, &flags, &paddr, &size);
+		if (flags == sart->saved[i].flags && paddr == sart->saved[i].paddr &&
+		    size == sart->saved[i].size)
+			continue;
+		bad++;
+		dev_warn(sart->dev, "entry %d reads %#x %pa+%#zx, wrote %#x %pa+%#zx\n",
+			 i, flags, &paddr, size, sart->saved[i].flags, &sart->saved[i].paddr,
+			 sart->saved[i].size);
+	}
+
+	return bad;
+}
+EXPORT_SYMBOL_GPL(apple_sart_replay);
+
+static const struct dev_pm_ops apple_sart_pm_ops = {
+	LATE_SYSTEM_SLEEP_PM_OPS(apple_sart_suspend_late, NULL)
+	NOIRQ_SYSTEM_SLEEP_PM_OPS(NULL, apple_sart_resume_noirq)
+};
+
 static const struct of_device_id apple_sart_of_match[] = {
 	{
 		.compatible = "apple,t6000-sart",
@@ -392,6 +495,7 @@ static struct platform_driver apple_sart_driver = {
 	.driver = {
 		.name = "apple-sart",
 		.of_match_table = apple_sart_of_match,
+		.pm = pm_sleep_ptr(&apple_sart_pm_ops),
 	},
 	.probe = apple_sart_probe,
 	.shutdown = apple_sart_shutdown,
diff --git a/include/linux/soc/apple/sart.h b/include/linux/soc/apple/sart.h
index f5d0db5022..53186e759e 100644
--- a/include/linux/soc/apple/sart.h
+++ b/include/linux/soc/apple/sart.h
@@ -64,4 +64,10 @@ int apple_sart_remove_allowed_region(struct apple_sart *sart, phys_addr_t paddr,
 bool apple_sart_is_inherited_region(struct apple_sart *sart, phys_addr_t paddr,
 				    size_t size);
 
+/*
+ * After a firmware-driven sleep, writes the entries in use before it back again and reads
+ * each back. Returns how many didn't hold, or -EOPNOTSUPP.
+ */
+int apple_sart_replay(struct apple_sart *sart);
+
 #endif /* _LINUX_SOC_APPLE_SART_H_ */
