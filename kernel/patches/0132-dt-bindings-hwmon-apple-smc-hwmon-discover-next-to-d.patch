From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 19:03:28 +0000
Subject: [PATCH] dt-bindings: hwmon: apple,smc-hwmon: discover next to
 described temperatures

apple,discover-temperatures excluded temperature-* nodes, so a machine
could describe a few labelled temperatures or show the SMC's full list,
not both. Allow both: the described channels come first and keep their
indices, which #thermal-sensor-cells refers to, and the discovered keys
follow them without the described ones.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
(cherry picked from commit 7c48537cf26f14599d90598a3c67ff3b8f66bac6)
(cherry picked from commit 2143d2898785968c8bac239c1e792f2d02850fa0)
---
 .../bindings/hwmon/apple,smc-hwmon.yaml       | 21 +++++++------------
 1 file changed, 7 insertions(+), 14 deletions(-)

diff --git a/Documentation/devicetree/bindings/hwmon/apple,smc-hwmon.yaml b/Documentation/devicetree/bindings/hwmon/apple,smc-hwmon.yaml
index fcfe475d4d..800ec8af3a 100644
--- a/Documentation/devicetree/bindings/hwmon/apple,smc-hwmon.yaml
+++ b/Documentation/devicetree/bindings/hwmon/apple,smc-hwmon.yaml
@@ -65,12 +65,13 @@ properties:
   apple,discover-temperatures:
     type: boolean
     description:
-      Enumerate readable, non-function temperature keys from the running SMC
-      instead of providing a board-specific temperature table. Only keys
-      beginning with T and reporting a four-byte floating-point value are
-      exposed. Labels are the key identifiers, without inferred locations.
-      Channels are reporting-only; their indices depend on the firmware and
-      must not be used by a static thermal policy.
+      Enumerate readable, non-function temperature keys from the running SMC.
+      Only keys beginning with T and reporting a four-byte floating-point value
+      are exposed, after the channels of the temperature-* nodes and without
+      the keys those describe. Labels are the key identifiers, without
+      inferred locations. The discovered channels are reporting-only; their
+      indices depend on the firmware and must not be used by a static thermal
+      policy.
 
   "#thermal-sensor-cells":
     const: 1
@@ -137,12 +138,4 @@ patternProperties:
     $ref: "#/$defs/sensor"
     unevaluatedProperties: false
 
-allOf:
-  - if:
-      required:
-        - apple,discover-temperatures
-    then:
-      patternProperties:
-        "^temperature-": false
-
 additionalProperties: false
