From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 14:46:23 +0000
Subject: [PATCH] drm/asahi: g16: Optionally write the tile-buffer
 sample size in the FS record

The G15 backend writes the render's tile-buffer sample size (bytes per
sample, sample_size_B) into the fragment record's parameter block. The
G16 record has the same block at +0x790, and every neighbouring word
(ZLS control, tile-buffer control, ISP control, tile mode, background
object values, ZLS pixels) sits at the same place in both; G16 leaves
the sample-size word, +0xa30, at zero.

Add g16_fs_sample_size (runtime, default 0). With 1, the FS record
carries sample_size_B at +0xa30 as the G15 backend writes it. With 0
the record is unchanged.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/engine.rs |  9 +++++++++
 drivers/gpu/drm/asahi/g16/params.rs | 18 ++++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index b36cccae6e..e71cd4ad30 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -1794,6 +1794,15 @@ fn prefix_render(
                 v.get_mut(at..at + 4).ok_or(EINVAL)?.fill(0);
             }
         }
+        // g16_fs_sample_size: the tile-buffer bytes per sample at FS +0xa30, where the G15
+        // backend writes them in the same parameter block (its +0x790 + 0x2a0).
+        if params::fs_sample_size() {
+            scratch
+                .fs
+                .get_mut(0xa30..0xa34)
+                .ok_or(EINVAL)?
+                .copy_from_slice(&u32::from(cmd.cmd.sample_size_B).to_le_bytes());
+        }
         encode::render_attachments(&mut scratch.tas[..], 0, &cmd.vertex_attachments);
         encode::render_attachments(&mut scratch.fss[..], 1, &cmd.fragment_attachments);
         params::render_patch_apply(&mut scratch.tas[..], &mut scratch.fss[..]);
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 8119163b39..7727be66ad 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -923,6 +923,24 @@ pub(crate) fn render_chain() -> bool {
     "G16: publish a render whose wait is on renders already published ahead of it, behind them, with a firmware wait for the previous FS (default 0: the host waits for their retirement; 1: firmware wait; runtime 0644)"
 );
 
+/// Storage of `g16_fs_sample_size` (runtime 0644, default 0).
+static FS_SAMPLE_SIZE: AtomicU32 = AtomicU32::new(0);
+
+/// Whether the FS record carries the tile-buffer sample size (bytes per sample) at +0xa30, the
+/// word the G15 backend writes at the same place of the same parameter block; G16 leaves it 0.
+pub(crate) fn fs_sample_size() -> bool {
+    FS_SAMPLE_SIZE.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    FS_SAMPLE_SIZE_PARAM,
+    FS_SAMPLE_SIZE_PARMTYPE,
+    FS_SAMPLE_SIZE_PARM,
+    FS_SAMPLE_SIZE,
+    "g16_fs_sample_size",
+    "G16: write the tile-buffer sample size into the FS record (+0xa30) as the G15 backend does (default 0: left 0; 1: written; runtime 0644)"
+);
+
 /// Storage of `g16_job_ahead` (runtime 0644, default 0).
 static JOB_AHEAD: AtomicU32 = AtomicU32::new(0);
 
-- 
