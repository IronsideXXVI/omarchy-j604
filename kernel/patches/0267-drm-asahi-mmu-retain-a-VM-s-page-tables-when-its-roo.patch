diff --git a/drivers/gpu/drm/asahi/mmu/release.rs b/drivers/gpu/drm/asahi/mmu/release.rs
new file mode 100644
index 0000000000..4421e1196d
--- /dev/null
+++ b/drivers/gpu/drm/asahi/mmu/release.rs
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! What returning an application context's root lease may do. Core-only, so the host tests
+//! build it with `rustc --test`.
+//!
+//! The ADT asks the GPU MMU for a TLB invalidation before a page that held translations is
+//! reused (`issue-gmmu-tlbis-at-retype`). Page tables are freed only when a whole tree drops,
+//! and the root lease is returned before its VM: the return invalidates the context's ASID, so
+//! the tree's walks are gone before its pages are. That holds when the lease still owns its
+//! TTBAT slot, or the slot is already empty. If another root sits in the slot, the lease must
+//! not clear it or invalidate on that owner's behalf, and nothing then guarantees that this
+//! tree's walks are gone: the tree is retained (leaked) instead of freed.
+
+/// The TTBAT slot as the lease finds it when it is returned.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum RootRelease {
+    /// The slot holds this lease's root: clear it, then invalidate the ASID.
+    Owned,
+    /// The slot is already empty: invalidate the ASID.
+    Cleared,
+    /// Another root holds the slot: no invalidation, and the tree must never be freed.
+    Violation,
+}
+
+impl RootRelease {
+    /// Classifies the slot's `(ttb0, ttb1)` against the lease's own pair.
+    pub(crate) fn classify(slot: (u64, u64), lease: (u64, u64)) -> Self {
+        if slot == lease {
+            Self::Owned
+        } else if slot == (0, 0) {
+            Self::Cleared
+        } else {
+            Self::Violation
+        }
+    }
+
+    /// Whether the return clears the slot.
+    pub(crate) fn clears_slot(self) -> bool {
+        self == Self::Owned
+    }
+
+    /// Whether the return invalidates the ASID and returns the identity.
+    pub(crate) fn invalidates(self) -> bool {
+        self != Self::Violation
+    }
+
+    /// Whether the VM's page tables must be retained instead of freed.
+    pub(crate) fn retains_tables(self) -> bool {
+        self == Self::Violation
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::RootRelease;
+
+    /// A page-table tree as `UatPageTable` treats it: `drop` frees every table unless retained.
+    struct Tree {
+        tables: u32,
+        retained: bool,
+        freed: u32,
+    }
+
+    impl Tree {
+        fn new(tables: u32) -> Self {
+            Self { tables, retained: false, freed: 0 }
+        }
+        fn drop_tree(&mut self) {
+            if !self.retained {
+                self.freed += self.tables; // one free_table call per table
+            }
+        }
+    }
+
+    /// The ExecutionContext sequence: return the lease, retain on a violation, then the VM drops.
+    fn release_then_drop(slot: (u64, u64), lease: (u64, u64), tree: &mut Tree) -> (bool, bool) {
+        let outcome = RootRelease::classify(slot, lease);
+        if outcome.retains_tables() {
+            tree.retained = true;
+        }
+        tree.drop_tree();
+        (outcome.clears_slot(), outcome.invalidates())
+    }
+
+    #[test]
+    fn owned_slot_is_cleared_invalidated_and_freed() {
+        let mut t = Tree::new(5);
+        assert_eq!(release_then_drop((0x1000, 0x2000), (0x1000, 0x2000), &mut t), (true, true));
+        assert_eq!(t.freed, 5);
+    }
+
+    #[test]
+    fn empty_slot_is_invalidated_and_freed() {
+        let mut t = Tree::new(3);
+        assert_eq!(release_then_drop((0, 0), (0x1000, 0x2000), &mut t), (false, true));
+        assert_eq!(t.freed, 3);
+    }
+
+    #[test]
+    fn foreign_root_retains_the_tree_no_free_table_call() {
+        for slot in [(0x9000, 0x2000), (0x1000, 0x9000), (0x9000, 0), (0, 0x9000)] {
+            let mut t = Tree::new(4);
+            assert_eq!(release_then_drop(slot, (0x1000, 0x2000), &mut t), (false, false));
+            assert_eq!(t.freed, 0, "free_table called after a foreign root in {slot:x?}");
+            assert!(t.retained);
+        }
+    }
+
+    #[test]
+    fn a_zero_lease_on_a_zero_slot_counts_as_owned() {
+        // The pre-fix rule (`owned || slot empty`) invalidated here; the classification must agree.
+        assert_eq!(RootRelease::classify((0, 0), (0, 0)), RootRelease::Owned);
+        assert!(RootRelease::classify((0, 0), (0, 0)).invalidates());
+    }
+
+    #[test]
+    fn invalidation_matches_the_previous_rule_everywhere() {
+        let vals = [0u64, 0x1000, 0x2000, 0x9000];
+        for &a in &vals {
+            for &b in &vals {
+                for &c in &vals {
+                    for &d in &vals {
+                        let old = (a, b) == (c, d) || (a == 0 && b == 0);
+                        let new = RootRelease::classify((a, b), (c, d));
+                        assert_eq!(new.invalidates(), old);
+                        assert_eq!(new.retains_tables(), !old);
+                    }
+                }
+            }
+        }
+    }
+}
