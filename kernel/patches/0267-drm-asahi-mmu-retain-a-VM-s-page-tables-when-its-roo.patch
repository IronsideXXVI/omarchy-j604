             inner.context_returns[id] = inner.context_clock;
             inner.execution_contexts &= !(1u64 << id);
         } else {
+            self.violated.store(true, Ordering::Release);
             pr_err!(
-                "MMU: application context {} changed owners while leased\n",
+                "MMU: application context {} changed owners while leased; retaining its page tables\n",
                 id
             );
         }
     }
 }
 
+impl Drop for ExecutionContext {
+    fn drop(&mut self) {
+        // The root is returned before the `vm` field drops (and with it, possibly, the tables).
+        self.root.release();
+        self.retain_on_violation();
+    }
+}
