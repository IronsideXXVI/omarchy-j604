From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eryk Wieliczko <eryk@wieliczko.ninja>
Date: Sun, 18 Oct 2026 11:17:50 +0200
Subject: [PATCH] usb: typec: tipd: handle the T8132 SPMI controller

Apply the qualified SPMI transport behavior to the T8132 Type-C controller.

Source-commit: 51fa2aacdf22726b8200906811de85ea1ed34ddc
Source-snapshot: 9ffa1fbed1e052d9706ad3e13c8663bc8ffe3d8d
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/usb/typec/tipd/spmi.c     | 21 +++++++++++++++------
 drivers/usb/typec/tipd/tps6598x.h |  1 +
 2 files changed, 16 insertions(+), 6 deletions(-)

diff --git a/drivers/usb/typec/tipd/spmi.c b/drivers/usb/typec/tipd/spmi.c
index d70a617d40..e24ada69cf 100644
--- a/drivers/usb/typec/tipd/spmi.c
+++ b/drivers/usb/typec/tipd/spmi.c
@@ -30,7 +30,7 @@ static int regmap_sn201202x_select_reg(struct spmi_device *sdev, u8 reg)
 	if (err)
 		return err;
 
-	if (sn->polled) {
+	if (sn->polled || sn->select_polled) {
 		int poll_err;
 
 		poll_err = read_poll_timeout(spmi_register_read, err,
@@ -240,8 +240,15 @@ static int sn201202x_probe(struct spmi_device *device)
 		if (tps->irq < 0)
 			return tps->irq;
 		irq_select = of_irq_get_byname(device->dev.of_node, "select");
-		if (irq_select < 0)
+		/* T8132 has no select notification, but retains event/sleep/wake IRQs. */
+		if (irq_select == -EINVAL || irq_select == -ENODATA) {
+			if (!of_device_is_compatible(device->dev.of_node,
+						     "apple,t8132-sn201202x"))
+				return irq_select;
+			sn->select_polled = true;
+		} else if (irq_select < 0) {
 			return irq_select;
+		}
 		irq_sleep = of_irq_get_byname(device->dev.of_node, "sleep");
 		if (irq_sleep < 0)
 			return irq_sleep;
@@ -249,10 +256,12 @@ static int sn201202x_probe(struct spmi_device *device)
 		if (irq_wake < 0)
 			return irq_wake;
 
-		ret = devm_request_irq(&device->dev, irq_select, sn201202x_irq,
-				       0, NULL, &sn->select_completion);
-		if (ret)
-			return ret;
+		if (!sn->select_polled) {
+			ret = devm_request_irq(&device->dev, irq_select, sn201202x_irq,
+					       0, NULL, &sn->select_completion);
+			if (ret)
+				return ret;
+		}
 		ret = devm_request_irq(&device->dev, irq_sleep, sn201202x_irq,
 				       0, NULL, &sn->sleep_completion);
 		if (ret)
diff --git a/drivers/usb/typec/tipd/tps6598x.h b/drivers/usb/typec/tipd/tps6598x.h
index 33e6f213dd..bffa3531ee 100644
--- a/drivers/usb/typec/tipd/tps6598x.h
+++ b/drivers/usb/typec/tipd/tps6598x.h
@@ -447,6 +447,7 @@ struct cd321x {
 struct sn201202x {
 	struct cd321x cd;
 	bool polled;
+	bool select_polled;
 	struct completion select_completion;
 	struct completion sleep_completion;
 	struct completion wake_completion;
