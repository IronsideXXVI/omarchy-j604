From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 02:48:05 +0000
Subject: [PATCH] drm/apple: m4: give the internal T8132 panel a colour
 matrix

The T8132 CRTC has no CTM property, and an atomic check refuses one, so
a night light (hyprsunset through Hyprland's CTM protocol) or a white
point adaptation has nothing to act on: aquamarine only submits a CTM
when the CRTC offers one, and Hyprland has no shader fallback for it.

The 25G83 DCP firmware still dispatches set_matrix (A423). Offer the CTM
on the internal panel (apple,t8132-dcp; never on the dcpext processors),
convert it to the firmware's Q32.32 as the other backends do, and send
it after the swap at location 9, the location those backends use for
the CTM; the factory calibration keeps location 8. A matrix is sent
again after the DCP comes back from a power gate or a power-off. The
identity is only sent to clear an earlier matrix, so a boot that never
sets one makes no new call. appledrm.panel_ctm=0 leaves the CRTC as it
was.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/apple_drv.c |  4 +-
 drivers/gpu/drm/apple/dcp.c       |  3 +-
 drivers/gpu/drm/apple/iomfb.c     |  1 +
 drivers/gpu/drm/apple/iomfb_m4.c  | 89 +++++++++++++++++++++++++++++++
 drivers/gpu/drm/apple/iomfb_m4.h  |  5 ++
 5 files changed, 100 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/apple/apple_drv.c b/drivers/gpu/drm/apple/apple_drv.c
index f702a8372b..378d63fb32 100644
--- a/drivers/gpu/drm/apple/apple_drv.c
+++ b/drivers/gpu/drm/apple/apple_drv.c
@@ -1194,13 +1194,15 @@ static int apple_probe_per_dcp(struct device *dev,
 		return ret;
 
 	drm_crtc_helper_add(&crtc->base, &apple_crtc_helper_funcs);
-	/* T8132 has no qualified CTM transaction. */
+	/* T8132: the CTM on the internal panel only (set_matrix, iomfb_m4.c). */
 	if (!iomfb_is_m4(dcp_data)) {
 		unsigned int gamma_size = dcp_gamma_lut_size(dcp);
 
 		drm_crtc_enable_color_mgmt(&crtc->base, 0, true, gamma_size);
 		if (gamma_size)
 			drm_mode_crtc_set_gamma_size(&crtc->base, gamma_size);
+	} else if (iomfb_m4_ctm_supported(&dcp->dev)) {
+		drm_crtc_enable_color_mgmt(&crtc->base, 0, true, 0);
 	}
 
 	crtc->dcp = dcp;
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index b5949f6e14..6ac7736227 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -1880,7 +1880,8 @@ int dcp_crtc_atomic_check(struct drm_crtc *crtc, struct drm_atomic_commit *commi
 		if (!crtc_state)
 			return 0;
 		if ((crtc_state->vrr_enabled && !iomfb_m4_panel_vrr_requested(dcp)) ||
-		    crtc_state->ctm || crtc_state->degamma_lut || crtc_state->gamma_lut)
+		    (crtc_state->ctm && !iomfb_m4_ctm_supported(dcp->dev)) ||
+		    crtc_state->degamma_lut || crtc_state->gamma_lut)
 			return -EINVAL;
 		if (!crtc_state->enable)
 			return 0;
diff --git a/drivers/gpu/drm/apple/iomfb.c b/drivers/gpu/drm/apple/iomfb.c
index 47f81b5d84..23a26d399f 100644
--- a/drivers/gpu/drm/apple/iomfb.c
+++ b/drivers/gpu/drm/apple/iomfb.c
@@ -3687,6 +3687,7 @@ void dcp_flush(struct drm_crtc *crtc, struct drm_atomic_commit *commit)
 			ret = iomfb_m4_atomic_mode(dcp, &new->mode);
 		if (!ret) {
 			iomfb_m4_atomic_hdr(dcp, crtc, commit);
+			iomfb_m4_atomic_ctm(dcp, new);
 			iomfb_m4_atomic_vrr(dcp, new->vrr_enabled);
 		}
 		/* A CRTC-only commit publishes no new framebuffer. */
diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index b1162310c3..ddcc46bae6 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -48,6 +48,7 @@
 #include <linux/spinlock.h>
 #include <linux/suspend.h>
 #include <linux/soc/apple/dart.h>
+#include <drm/drm_color_mgmt.h>
 #include <linux/soc/apple/dart-cio.h>
 #include <linux/soc/apple/rtkit.h>
 #include <linux/soc/apple/pmp-display.h>
@@ -139,6 +140,25 @@ static const struct kernel_param_ops blm_ah_mode_ops = {
 
 module_param_cb(blm_ah_mode, &blm_ah_mode_ops, &blm_ah_mode, 0644);
 static void iomfb_m4_blm_work(struct work_struct *work);
+static void iomfb_m4_ctm_work(struct work_struct *work);
+
+/*
+ * The internal panel's colour matrix (KMS CTM): sent to the DCP as macOS's
+ * colour path does, set_matrix (A423) at location 9, the location the other
+ * Apple DCP backends use for the CTM; the factory calibration stays at 8.
+ * It is what a night light (hyprsunset) and the white-point adaptation use.
+ * N leaves the CRTC without a CTM property, as before.
+ */
+static bool panel_ctm = true;
+module_param(panel_ctm, bool, 0444);
+MODULE_PARM_DESC(panel_ctm,
+		 "Internal panel: offer the KMS CTM and send it to the DCP (set_matrix, location 9) (default: Y)");
+
+bool iomfb_m4_ctm_supported(const struct device *dev)
+{
+	return READ_ONCE(panel_ctm) && dev->of_node &&
+	       of_device_is_compatible(dev->of_node, "apple,t8132-dcp");
+}
 
 MODULE_PARM_DESC(blm_ah_mode,
 		 "Internal mini-LED panel: BLM Adaptive Headroom mode sent to the DCP (RuntimeProperty 171; macOS on the J604: 2, the default; -1: send nothing; applies after the next swap)");
@@ -690,6 +710,10 @@ struct iomfb_m4 {
 	/* Sends blm_ah_mode; blm_gen is the blm_ah_gen it last handled. */
 	struct delayed_work blm_work;
 	int blm_gen;
+	/* The CTM for the next A423 (Q32.32), whether one is due, whether it is not identity */
+	struct delayed_work ctm_work;
+	u64 ctm_fw[9];
+	bool ctm_pending, ctm_active;
 	/*
 	 * Framebuffer references a window let go of, put
 	 * by ext_put_work outside the session lock
@@ -4099,6 +4123,7 @@ int iomfb_m4_init(struct apple_dcp *owner)
 	init_waitqueue_head(&dcp->ext_settle_wq);
 	INIT_DELAYED_WORK(&dcp->idle_cache, iomfb_m4_idle_cache_work);
 	INIT_DELAYED_WORK(&dcp->blm_work, iomfb_m4_blm_work);
+	INIT_DELAYED_WORK(&dcp->ctm_work, iomfb_m4_ctm_work);
 	INIT_DELAYED_WORK(&dcp->gate_work, iomfb_m4_gate_work);
 	spin_lock_init(&dcp->retire_lock);
 	INIT_WORK(&dcp->retire_work, iomfb_m4_retire_work);
@@ -5483,6 +5508,8 @@ static void iomfb_m4_idle_cache_kick(struct iomfb_m4 *dcp)
 
 	if (ms && !READ_ONCE(dcp->owner->quiescing))
 		mod_delayed_work(dcp->runtime->wq, &dcp->idle_cache, msecs_to_jiffies(ms));
+	if (dcp->ctm_pending && !dcp->external && !READ_ONCE(dcp->owner->quiescing))
+		mod_delayed_work(dcp->runtime->wq, &dcp->ctm_work, 0);
 	/* A new blm_ah_mode goes out from the work, outside the swap. */
 	if (!dcp->external && atomic_read(&blm_ah_gen) != dcp->blm_gen &&
 	    !READ_ONCE(dcp->owner->quiescing))
@@ -5508,6 +5535,58 @@ static void iomfb_m4_blm_send(struct iomfb_m4 *dcp, u32 id, u32 value)
 			 id, value, ret, le32_to_cpu(out));
 }
 
+static void iomfb_m4_ctm_work(struct work_struct *work)
+{
+	struct iomfb_m4 *dcp = container_of(to_delayed_work(work), struct iomfb_m4, ctm_work);
+	struct iomfb_set_matrix_req req = { .location = 9 };
+	__le32 out = 0;
+	int ret;
+
+	mutex_lock(&dcp->lock);
+	/* An RPC failure has already failed the session. */
+	if (READ_ONCE(dcp->owner->quiescing) || !dcp->runtime || dcp->external ||
+	    dcp->powered_off || !dcp->ctm_pending)
+		goto out;
+	dcp->ctm_pending = false;
+	memcpy(req.matrix, dcp->ctm_fw, sizeof(req.matrix));
+	ret = dcp_m4_runtime_live(dcp->runtime);
+	if (!ret)
+		ret = dcp_m4_runtime_call_stream(dcp->runtime, 423, 0, false, &req,
+						 sizeof(req), &out, sizeof(out));
+	if (ret || le32_to_cpu(out))
+		dev_warn_ratelimited(dcp->dev, "CTM set_matrix: rpc %d, status %#x\n",
+				     ret, le32_to_cpu(out));
+	else
+		dev_dbg(dcp->dev, "CTM set_matrix sent (%s)\n",
+			dcp->ctm_active ? "matrix" : "identity");
+out:
+	mutex_unlock(&dcp->lock);
+}
+
+void iomfb_m4_atomic_ctm(struct apple_dcp *owner, const struct drm_crtc_state *st)
+{
+	struct iomfb_m4 *dcp = owner->v26_6;
+	const struct drm_color_ctm *ctm = st->ctm ? st->ctm->data : NULL;
+	u64 fw[9];
+	unsigned int i;
+	bool active = false;
+
+	if (!dcp || dcp->external || !st->color_mgmt_changed ||
+	    !iomfb_m4_ctm_supported(owner->dev))
+		return;
+	dcp_ctm_to_fw(fw, ctm);
+	for (i = 0; i < 9; i++)
+		active |= fw[i] != ((i % 4 == 0) ? 1ULL << 32 : 0);
+	mutex_lock(&dcp->lock);
+	/* The identity is sent once to clear a matrix, never at boot. */
+	if (active || dcp->ctm_active) {
+		memcpy(dcp->ctm_fw, fw, sizeof(fw));
+		dcp->ctm_pending = true;
+	}
+	dcp->ctm_active = active;
+	mutex_unlock(&dcp->lock);
+}
+
 static void iomfb_m4_blm_work(struct work_struct *work)
 {
 	struct iomfb_m4 *dcp = container_of(to_delayed_work(work), struct iomfb_m4, blm_work);
@@ -6097,6 +6176,8 @@ static int iomfb_m4_power_ungate(struct iomfb_m4 *dcp)
 	if (ret)
 		goto fail;
 	WRITE_ONCE(dcp->gated, false);
+	/* The matrix went with the DCP's power: send it again. */
+	dcp->ctm_pending |= dcp->ctm_active;
 	/* The BLM properties went with the DCP's power: send them again. */
 	dcp->blm_gen = -1;
 
@@ -6248,6 +6329,8 @@ static int iomfb_m4_ext_power_ungate(struct iomfb_m4 *dcp, const char *why)
 	if (ret)
 		goto fail;
 	WRITE_ONCE(dcp->gated, false);
+	/* The matrix went with the DCP's power: send it again. */
+	dcp->ctm_pending |= dcp->ctm_active;
 	/* The BLM properties went with the DCP's power: send them again. */
 	dcp->blm_gen = -1;
 	WRITE_ONCE(dcp->ext_idle_gated, false);
@@ -8309,6 +8392,8 @@ static int iomfb_m4_ext_stop(struct iomfb_m4 *dcp)
 		return ret;
 	}
 	WRITE_ONCE(dcp->gated, false);
+	/* The matrix went with the DCP's power: send it again. */
+	dcp->ctm_pending |= dcp->ctm_active;
 	/* The BLM properties went with the DCP's power: send them again. */
 	dcp->blm_gen = -1;
 	return ret;
@@ -8379,6 +8464,8 @@ static int iomfb_m4_ext_start(struct iomfb_m4 *dcp)
 		return 0;
 	}
 	WRITE_ONCE(dcp->gated, false);
+	/* The matrix went with the DCP's power: send it again. */
+	dcp->ctm_pending |= dcp->ctm_active;
 	/* The BLM properties went with the DCP's power: send them again. */
 	dcp->blm_gen = -1;
 	dev_info(dcp->dev, "external DCP restarted after sleep\n");
@@ -8646,6 +8733,7 @@ int iomfb_m4_resume(struct apple_dcp *owner)
 		if (!ret) {
 			dcp->powered_off = false;
 			dcp->blm_gen = -1;
+			dcp->ctm_pending |= dcp->ctm_active;
 		}
 	} else {
 		ret = dcp_m4_runtime_health(dcp->runtime);
@@ -8751,6 +8839,7 @@ void iomfb_m4_quiesce(struct apple_dcp *owner)
 	/* After the flush, as drained callbacks can queue it. */
 	cancel_delayed_work_sync(&dcp->idle_cache);
 	cancel_delayed_work_sync(&dcp->blm_work);
+	cancel_delayed_work_sync(&dcp->ctm_work);
 	cancel_delayed_work_sync(&dcp->gate_work);
 }
 
diff --git a/drivers/gpu/drm/apple/iomfb_m4.h b/drivers/gpu/drm/apple/iomfb_m4.h
index 2e1c3ffcab..871375350b 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.h
+++ b/drivers/gpu/drm/apple/iomfb_m4.h
@@ -80,6 +80,8 @@ int iomfb_m4_atomic_check_hdr(struct apple_dcp *dcp, struct drm_crtc *crtc,
 			      struct drm_atomic_commit *commit);
 void iomfb_m4_atomic_hdr(struct apple_dcp *dcp, struct drm_crtc *crtc,
 			 struct drm_atomic_commit *commit);
+void iomfb_m4_atomic_ctm(struct apple_dcp *dcp, const struct drm_crtc_state *st);
+bool iomfb_m4_ctm_supported(const struct device *dev);
 int iomfb_m4_health(struct apple_dcp *dcp);
 int iomfb_m4_error(struct apple_dcp *dcp);
 bool iomfb_m4_external_ready(struct apple_dcp *dcp);
@@ -171,6 +173,9 @@ static inline int iomfb_m4_atomic_check_hdr(struct apple_dcp *dcp, struct drm_cr
 }
 static inline void iomfb_m4_atomic_hdr(struct apple_dcp *dcp, struct drm_crtc *crtc,
 				       struct drm_atomic_commit *commit) { }
+static inline void iomfb_m4_atomic_ctm(struct apple_dcp *dcp,
+				       const struct drm_crtc_state *st) { }
+static inline bool iomfb_m4_ctm_supported(const struct device *dev) { return false; }
 static inline int iomfb_m4_health(struct apple_dcp *dcp) { return -ENODEV; }
 static inline int iomfb_m4_error(struct apple_dcp *dcp) { return -ENODEV; }
 static inline bool iomfb_m4_external_ready(struct apple_dcp *dcp) { return false; }
-- 
2.43.0

