From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 02:10:48 +0000
Subject: [PATCH] PCI: apple: keep an off card reader's root port out
 of runtime PM

With its slot empty the J604's SD reader is powered down and the root
port's config space reads all ones, as macOS also reads it. The port is
then childless, so the PCI core runtime-suspends it, and each D-state
change finds no PMCSR to write:

  pcieport 0000:00:02.0: Unable to change power state from D0 to D3hot, device inaccessible
  pcieport 0000:00:02.0: Unable to change power state from D3cold to D0, device inaccessible

(the second when a config read, lspci here, resumed it).

Take a runtime PM reference on the root port before the reader goes
down, while the port still answers, and drop it once the reader is back
and rescanned, or when the port goes away. The port then stays as probe
left it while the reader is off, and no D-state change is attempted on
a port that cannot take one.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/pci/controller/pcie-apple.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/drivers/pci/controller/pcie-apple.c b/drivers/pci/controller/pcie-apple.c
index 8124b01760..70b59ab876 100644
--- a/drivers/pci/controller/pcie-apple.c
+++ b/drivers/pci/controller/pcie-apple.c
@@ -619,6 +619,7 @@ struct apple_pcie_port {
 	struct delayed_work	sd_work;
 	struct list_head	sd_entry;
 	bool			sd_off;		/* powered down for an empty slot */
+	struct pci_dev		*sd_rp_held;	/* its root port, kept active while it is down */
 };
 
 static bool apple_radio_writer_closed(struct apple_pcie *pcie);
@@ -2961,6 +2962,14 @@ static void apple_pcie_sd_power_down(struct apple_pcie *pcie, struct apple_pcie_
 
 	pci_lock_rescan_remove();
 	rp = bridge->bus ? pci_get_slot(bridge->bus, PCI_DEVFN(port->idx, 0)) : NULL;
+	/*
+	 * With the endpoint off the root port's config space reads all ones, as on macOS, so the
+	 * PCI core must not move it between D-states until the reader is back: a childless port
+	 * runtime-suspends, and its D0 -> D3hot (and a config read's D3cold -> D0) then fail as
+	 * "device inaccessible". Keep it active, from while it still answers.
+	 */
+	if (rp && !port->sd_rp_held && pm_runtime_resume_and_get(&rp->dev) >= 0)
+		port->sd_rp_held = pci_dev_get(rp);
 	if (rp && rp->subordinate)
 		list_for_each_entry_safe_reverse(dev, tmp, &rp->subordinate->devices, bus_list)
 			pci_stop_and_remove_bus_device(dev);
@@ -2980,6 +2989,18 @@ static void apple_pcie_sd_power_down(struct apple_pcie *pcie, struct apple_pcie_
 	dev_info(pcie->dev, "port %pOF: slot empty, reader powered down\n", port->np);
 }
 
+/* The reader is back (or the port goes away): its root port's runtime PM is the core's again. */
+static void apple_pcie_sd_release_rp(struct apple_pcie_port *port)
+{
+	struct pci_dev *rp = port->sd_rp_held;
+
+	if (!rp)
+		return;
+	port->sd_rp_held = NULL;
+	pm_runtime_put(&rp->dev);
+	pci_dev_put(rp);
+}
+
 static int apple_pcie_sd_power_up(struct apple_pcie *pcie, struct apple_pcie_port *port)
 {
 	struct pci_host_bridge *bridge = pci_host_bridge_from_priv(pcie);
@@ -3028,6 +3049,7 @@ static int apple_pcie_sd_power_up(struct apple_pcie *pcie, struct apple_pcie_por
 	if (bridge->bus)
 		pci_rescan_bus(bridge->bus);
 	pci_unlock_rescan_remove();
+	apple_pcie_sd_release_rp(port);
 	return 0;
 }
 
@@ -3115,6 +3137,7 @@ static void apple_pcie_sd_remove(void *data)
 		unregister_pm_notifier(&apple_pcie_sd_pm_nb);
 	mutex_unlock(&apple_pcie_sd_lock);
 	cancel_delayed_work_sync(&port->sd_work);
+	apple_pcie_sd_release_rp(port);
 }
 
