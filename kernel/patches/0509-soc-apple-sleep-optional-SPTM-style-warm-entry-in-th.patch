From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 20:27:33 +0000
Subject: [PATCH] soc: apple: sleep: optional SPTM-style warm entry in
 the T8132 stub

macOS's SPTM, on a J604 wake, masks all exceptions as its second
instruction, clears the VM timer FIQ enable (s3_5_c15_c1_3) and runs a
TLB invalidate and ic iallu before its MMU comes on. Our resume stub
does none of that. aura already masks DAIF before it jumps to the
stub, so the rest is what is new here.

t8132_stub_harden (stub bit 8, off by default) does the same right
after the stub reads its flags, before the catch vectors go in: DAIF
masked, the VM timer FIQ off, tlbi alle2, ic iallu, dsb sy, isb.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/sleep.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index bae07019be..7443777eb3 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -3328,6 +3328,9 @@ MODULE_PARM_DESC(t8132_elchk2, "T8132 deep sleep: the resume stub also checks th
  *       a byte of a page outside the image (allocated at probe, PA logged), 97.5 s; then
  *       elchk as before (75 s once it passed). The first window that never comes names
  *       the first read that did not return.
+ * bit 8 t8132_stub_harden: first, before the vectors go in: DAIF all masked again, the VM
+ *       timer FIQ enable (s3_5_c15_c1_3) cleared, tlbi alle2, ic iallu, dsb sy, isb: what
+ *       SPTM's warm entry does before its MMU-on on the J604 (macOS 26B123, TB).
  * bit 7 t8132_stub_regs: right after the ladder, the woken core's own CTRR_D (CTL
  *       s3_0_c11_c1_5, bounds s3_0_c11_c1_2/3) and CTXR_D (CTL s3_0_c11_c5_5, bounds
  *       s3_0_c11_c3_0/1) against the PA of .idmap.text, as WD2 = 20 + 15 * code s, then
@@ -3364,6 +3367,9 @@ static bool t8132_stub_sctlr;
 module_param(t8132_stub_sctlr, bool, 0644);
 static bool t8132_stub_early_wake;
 module_param(t8132_stub_early_wake, bool, 0644);
+static bool t8132_stub_harden;
+module_param(t8132_stub_harden, bool, 0644);
+MODULE_PARM_DESC(t8132_stub_harden, "T8132 deep sleep: the resume stub first masks DAIF, clears the VM timer FIQ enable and invalidates the TLB and I-cache (default off)");
 static bool t8132_go_hib;
 module_param(t8132_go_hib, bool, 0644);
 MODULE_PARM_DESC(t8132_go_hib, "T8132 deep sleep: after the commit, send the PMU macOS's go-hib writes (0x200e <- 0, 0x2000 <- 0x41) (default off)");
@@ -3400,6 +3406,15 @@ asm(
 "61:\ttbz\tw22, #0, 62f\n"
 "\tmsr\tdaifset, #0xf\n"
 "62:\n"
+/* Bit 8: as SPTM's warm entry, all masked, the VM timer FIQ off, TLB and I-cache clean. */
+"\ttbz\tw22, #8, 72f\n"
+"\tmsr\tdaifset, #0xf\n"
+"\tmsr\ts3_5_c15_c1_3, xzr\n"
+"\ttlbi\talle2\n"
+"\tic\tiallu\n"
+"\tdsb\tsy\n"
+"\tisb\n"
+"72:\n"
 "\tadrp\tx9, t8132_resume_vectors\n"
 "\tadd\tx9, x9, :lo12:t8132_resume_vectors\n"
 "\tmsr\tvbar_el2, x9\n"
@@ -4567,6 +4582,8 @@ static void t8132_arm_stubcfg(void)
 	c->ladder_pa = t8132_ladder_page ? page_to_phys(t8132_ladder_page) : 0;
 	if (READ_ONCE(t8132_stub_regs))
 		f |= BIT(7);
+	if (READ_ONCE(t8132_stub_harden))
+		f |= BIT(8);
 	if (READ_ONCE(t8132_stub_ladder))
 		f |= BIT(6);
 	c->flags = f;
-- 
2.43.0

