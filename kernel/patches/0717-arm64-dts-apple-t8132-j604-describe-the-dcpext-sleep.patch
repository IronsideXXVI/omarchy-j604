From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 18:43:04 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: describe the dcpext sleep
 providers

Give each J604 external DCP what it powers down for a sleep that
powers the SoC down, from the J604 runtime ADT (macOS 27.2, 26B123):

- its firmware DART's clock-protection slice: dart-dcpext0
  clock-protection-slice-index 5, dart-dcpext1 0x1e (the internal
  dart-dcp has 0x2a, dart-disp0 8, already used);
- its pipe's PMC interface enables: pmgr bwr-agent DISP_EXT0 index 3,
  DISP_EXT1 index 4; boost-agent DISP_EXT0 index 1, DISP_EXT1 index 2,
  read as bits as for DISP_INT (index 0 in both, pmc_disp0); power
  states 0x28 and 0x89;
- its power domains (dispext0/1 sys, fe, cpu), firmware-owned, now
  also consumer-switched: the dcpext powers them off and on itself.

Nothing changes until a dcpext uses them: the DART power-down,
consumer-switched states and interfaces act only when their consumer
calls them, and the interface nodes write nothing at probe.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../boot/dts/apple/t8132-j604-dcpext.dtsi     | 41 +++++++++++++++++++
 .../arm64/boot/dts/apple/t8132-j604-pmgr.dtsi | 12 ++++++
 2 files changed, 53 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-dcpext.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-dcpext.dtsi
index b2d0364d00..a20e980a09 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-dcpext.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-dcpext.dtsi
@@ -63,6 +63,12 @@
 		#iommu-cells = <1>;
 		apple,dma-range = <0x100 0x0 0x10 0x0>;
 		power-domains = <&ps_dispext0_cpu>;
+		/*
+		 * J604 ADT dart-dcpext0 clock-protection-slice-index 0x5
+		 * (macOS 27.2 runtime): its DCP powers it down for a sleep
+		 * that powers the SoC down.
+		 */
+		apple,clock-protection = <&ps_prot 5>;
 		status = "disabled"; /* Enabled by the loader. */
 	};
 
@@ -95,6 +101,8 @@
 		dma-noncoherent;
 		apple,dcp-index = <1>;
 		apple,bw-scratch = <&pmgr_dcpext 0 4 0>;
+		/* Its pipe's BWR and boost enables, cleared for a SoC power-down sleep. */
+		apple,pmc-interface = <&pmc_dispext0>;
 		#address-cells = <2>;
 		#size-cells = <2>;
 		status = "disabled"; /* Enabled by the loader. */
@@ -140,6 +148,12 @@
 		#iommu-cells = <1>;
 		apple,dma-range = <0x100 0x0 0x10 0x0>;
 		power-domains = <&ps_dispext1_cpu>;
+		/*
+		 * J604 ADT dart-dcpext1 clock-protection-slice-index 0x1e
+		 * (macOS 27.2 runtime): its DCP powers it down for a sleep
+		 * that powers the SoC down.
+		 */
+		apple,clock-protection = <&ps_prot 30>;
 		status = "disabled"; /* Enabled by the loader. */
 	};
 
@@ -172,6 +186,8 @@
 		dma-noncoherent;
 		apple,dcp-index = <2>;
 		apple,bw-scratch = <&pmgr_dcpext 1 4 0>;
+		/* Its pipe's BWR and boost enables, cleared for a SoC power-down sleep. */
+		apple,pmc-interface = <&pmc_dispext1>;
 		#address-cells = <2>;
 		#size-cells = <2>;
 		status = "disabled"; /* Enabled by the loader. */
@@ -381,3 +397,28 @@
 &atc3_dpxbar {
 	status = "okay";
 };
+
+/*
+ * The external pipes' PMC interface enables. J604 ADT pmgr (macOS 27.2
+ * runtime) bwr-agent records DISP_EXT0 index 3 and DISP_EXT1 index 4,
+ * boost-agent DISP_EXT0 index 1 and DISP_EXT1 index 2, the bit of each in
+ * its enable word as for DISP_INT (t8132-memory.dtsi); power states 0x28
+ * and 0x89 (DISPEXT0_SYS, DISPEXT1_SYS). Each dcpext clears them before it
+ * powers its domains down for a sleep that powers the SoC down, and
+ * restores them after.
+ */
+&pmc {
+	pmc_dispext0: interface-dispext0 {
+		label = "dispext0-interface";
+		apple,consumer-switched;
+		apple,bwr-bit = <3>;
+		apple,boost-bit = <1>;
+	};
+
+	pmc_dispext1: interface-dispext1 {
+		label = "dispext1-interface";
+		apple,consumer-switched;
+		apple,bwr-bit = <4>;
+		apple,boost-bit = <2>;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
index bc83eeb670..4b28b3f283 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
@@ -109,16 +109,22 @@
 &ps_dispext0_sys {
 	status = "okay";
 	apple,firmware-owned;
+	/* Its dcpext powers it off and on for a SoC power-down sleep. */
+	apple,consumer-switched;
 };
 
 &ps_dispext0_fe {
 	status = "okay";
 	apple,firmware-owned;
+	/* Its dcpext powers it off and on for a SoC power-down sleep. */
+	apple,consumer-switched;
 };
 
 &ps_dispext0_cpu {
 	status = "okay";
 	apple,firmware-owned;
+	/* Its dcpext powers it off and on for a SoC power-down sleep. */
+	apple,consumer-switched;
 };
 
 &ps_scodec {
@@ -407,16 +413,22 @@
 &ps_dispext1_sys {
 	status = "okay";
 	apple,firmware-owned;
+	/* Its dcpext powers it off and on for a SoC power-down sleep. */
+	apple,consumer-switched;
 };
 
 &ps_dispext1_fe {
 	status = "okay";
 	apple,firmware-owned;
+	/* Its dcpext powers it off and on for a SoC power-down sleep. */
+	apple,consumer-switched;
 };
 
 &ps_dispext1_cpu {
 	status = "okay";
 	apple,firmware-owned;
+	/* Its dcpext powers it off and on for a SoC power-down sleep. */
+	apple,consumer-switched;
 };
 
 /* The camera powers the ISP from its first stream until it is unbound. */
