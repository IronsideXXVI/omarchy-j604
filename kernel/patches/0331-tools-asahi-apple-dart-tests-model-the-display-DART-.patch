From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 21:20:40 +0000
Subject: [PATCH] tools/asahi: apple-dart tests: model the display DART
 fields

The DART map and range paths now read display_dark, display_tcr_four and
display_tlb_stale, which came in with the 7.3 integration of the J604
series (6c29d67f46), and neither fixture's struct apple_dart has them,
so apple-dart-fw-tests and apple-dart-range-tests no longer build. Add
the three fields to both fixtures, left clear as on a lit display.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 tools/asahi/apple-dart-fw/fixture.c   | 17 ++++++++++++++++-
 tools/asahi/apple-dart-range-tests.py |  3 ++-
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/tools/asahi/apple-dart-fw/fixture.c b/tools/asahi/apple-dart-fw/fixture.c
index 13e39fed94..39050c5a9b 100644
--- a/tools/asahi/apple-dart-fw/fixture.c
+++ b/tools/asahi/apple-dart-fw/fixture.c
@@ -50,7 +50,22 @@ static unsigned lock_depth;
 static size_t find_next_bit(unsigned long*p,size_t n,size_t a){for(;a<n;a++)if(test_bit(a,p))break;return a;}
 static size_t find_next_zero_bit(unsigned long*p,size_t n,size_t a){for(;a<n;a++)if(!test_bit(a,p))break;return a;}
 struct apple_dart_hw;struct device;
-struct apple_dart {struct device*dev;unsigned pgsize,oas,fw_mirror,tcr,fw_handoff,ias,locked,num_streams,version,managed_sids;struct {int ready;} iommu;struct apple_dart_hw*hw;u64 dma_offset,locked_window[2];u64 *locked_ttbr[2][4],*locked_owned[2][4];struct apple_dart_fw_root*locked_fw[2][4];int lock,locked_retire_err[2];};
+struct apple_dart {
+	struct device *dev;
+	unsigned int pgsize, oas, fw_mirror, tcr, fw_handoff, ias, locked, num_streams, version;
+	unsigned int managed_sids;
+	struct {
+		int ready;
+	} iommu;
+	struct apple_dart_hw *hw;
+	u64 dma_offset, locked_window[2];
+	u64 *locked_ttbr[2][4], *locked_owned[2][4];
+	struct apple_dart_fw_root *locked_fw[2][4];
+	int lock, locked_retire_err[2];
+	/* The display DART's dark state: clear, as on a lit display */
+	bool display_dark, display_tlb_stale;
+	unsigned long display_tcr_four[4];
+};
 struct apple_dart_stream_map {struct apple_dart*dart;unsigned long sidmap[1];};
 struct apple_dart_atomic_stream_map {struct apple_dart*dart;unsigned long sidmap[1];};
 struct apple_dart_dcp;struct apple_dart_domain {struct apple_dart_atomic_stream_map stream_maps[2];unsigned long fw_sidmap[2][1];void*pgtbl_ops;struct apple_dart_dcp*dcp;};
diff --git a/tools/asahi/apple-dart-range-tests.py b/tools/asahi/apple-dart-range-tests.py
index 53699cd2ac..ff4186ecd8 100644
--- a/tools/asahi/apple-dart-range-tests.py
+++ b/tools/asahi/apple-dart-range-tests.py
@@ -45,7 +45,8 @@ struct io_pgtable { struct io_pgtable_cfg cfg; };
 struct apple_dart;
 struct apple_dart_stream_map { struct apple_dart *dart; unsigned long sidmap[1]; };
 struct apple_dart_hw { int (*invalidate_tlb)(struct apple_dart_stream_map *); };
-struct apple_dart { int num_streams, locked, version; bool fw_mirror, fw_handoff, managed_sids; void *dev; struct apple_dart_hw *hw; };
+struct apple_dart { int num_streams, locked, version; bool fw_mirror, fw_handoff, managed_sids; void *dev; struct apple_dart_hw *hw;
+                    bool display_dark, display_tlb_stale; unsigned long display_tcr_four[4]; };
 struct apple_dart_atomic_stream_map { struct apple_dart *dart; unsigned long sidmap[1]; };
 struct apple_dart_domain {
  void *pgtbl_ops; bool dcp; struct apple_dart_atomic_stream_map streams[2]; int count;
