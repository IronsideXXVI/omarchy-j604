From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 23:24:11 +0000
Subject: [PATCH] arm64: apple: stop parked cores for a T8132 sleep
 commit, as macOS does

On T8132 (M4), macOS stops the secondary cores at the start of its
suspend-to-RAM commit and lets them take their last WFI only after the
commit is written, with bits 0 and 63 of S3_5_C15_C6_2 set on every core.
That register is neither CYC_OVRD, which T8132 lacks, nor ACC_OVRD.

Add that to the parked-core protocol, for apple-s2r's T8132 sequence:

 - apple_cpu_t8132_stop_parked(): each parked core is sent a new park
   command, writes its own PMGR stop bit, cleans its L1 and is held awake
   until the release.
 - apple_cpu_t8132_release_stopped(): the held cores take their last WFI,
   with deep sleep allowed only if the commit was written. A sleep given up
   after the stop takes them down as the PMGR stop alone does today, with
   their cluster left powered.
 - apple_cpu_t8132_deep_sleep(): the boot CPU's last WFI after the commit.

Nothing calls these unless apple-s2r runs its T8132 sequence, which is off
by default. The other paths are unchanged.

The order, the stop-bit layout (E cores first, P cores from bit 6) and the
deep sleep bits follow Aurora's sleep_cpu_stop(), sleep_deep_wfi_arm(),
sleep_boot_wfi() and smp_rvbar_spin_table_hold() in
aurora-silicon/linux#1314 (drivers/soc/apple/sleep.c and
arch/arm64/kernel/smp_spin_table.c), by Bartosz Nitka and Diljit Singh,
measured from macOS's sleep on a J713 (aura#109). Our start-bit layout
already matches it (t8132_start_bank = { 0, 6 }).

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/include/asm/apple_cpu.h |  12 ++
 arch/arm64/kernel/apple_cpu.c      | 185 +++++++++++++++++++++++++++++
 2 files changed, 197 insertions(+)

diff --git a/arch/arm64/include/asm/apple_cpu.h b/arch/arm64/include/asm/apple_cpu.h
index 0f272966f4..05936d7db4 100644
--- a/arch/arm64/include/asm/apple_cpu.h
+++ b/arch/arm64/include/asm/apple_cpu.h
@@ -22,6 +22,9 @@ int apple_cpu_acc_restore(void);
 bool apple_cpu_acc_available(void);
 int apple_cpu_park_power_down_all(void);
 void apple_cpu_power_cycled(void);
+int apple_cpu_t8132_stop_parked(void);
+void apple_cpu_t8132_release_stopped(bool committed);
+void __noreturn apple_cpu_t8132_deep_sleep(void);
 
 /* The park loop of an offline CPU, internal to the CPU hotplug code */
 u64 apple_cpu_park_wfi(u64 *cmd, u64 cyc, u64 ways, u64 sets, u64 way_shift,
@@ -50,6 +53,15 @@ static inline int apple_cpu_park_power_down_all(void)
 static inline void apple_cpu_power_cycled(void)
 {
 }
+
+static inline int apple_cpu_t8132_stop_parked(void)
+{
+	return -ENODEV;
+}
+
+static inline void apple_cpu_t8132_release_stopped(bool committed)
+{
+}
 #endif
 
 #endif /* __ASM_APPLE_CPU_H */
diff --git a/arch/arm64/kernel/apple_cpu.c b/arch/arm64/kernel/apple_cpu.c
index e255b3dbd0..3c4da0e33b 100644
--- a/arch/arm64/kernel/apple_cpu.c
+++ b/arch/arm64/kernel/apple_cpu.c
@@ -367,6 +367,8 @@ enum apple_cpu_die {
 #define PARK_CMD_POWER_DOWN		2
 /* The core took the command */
 #define PARK_CMD_TAKEN			3
+/* T8132 suspend-to-RAM: stop through the PMGR, then hold until the commit */
+#define PARK_CMD_T8132_STOP		4
 
 struct apple_cpu {
 	struct apple_cluster *cluster;
@@ -381,6 +383,8 @@ struct apple_cpu {
 	bool parked;
 	/* Powered down alone through debug_power_down, not started since */
 	bool lone;
+	/* Set by the core once it wrote its stop bit for a T8132 commit */
+	bool t8132_stopped;
 };
 
 #define APPLE_MAX_CPU_CTRLS		4
@@ -1202,6 +1206,126 @@ void __noreturn apple_cpu_deep_sleep(unsigned int flags)
 }
 EXPORT_SYMBOL_GPL(apple_cpu_deep_sleep);
 
+/*
+ * T8132 suspend-to-RAM, in the order macOS uses on that SoC. SOURCE: Aurora's
+ * drivers/soc/apple/sleep.c (sleep_cpu_stop(), sleep_deep_wfi_arm(),
+ * sleep_boot_wfi()) and arch/arm64/kernel/smp_spin_table.c
+ * (smp_rvbar_spin_table_hold()) in aurora-silicon/linux#1314, by Bartosz
+ * Nitka and Diljit Singh, from the aura#109 trace of a macOS sleep on a
+ * J713: each secondary writes its own PMGR stop bit at the start of the
+ * commit and stays awake; only after the commit does every core take its
+ * last WFI, with bits 0 and 63 of S3_5_C15_C6_2 set. That register is
+ * neither CYC_OVRD nor ACC_OVRD, which this path does not write.
+ */
+#define SYS_APL_T8132_DEEP_SLEEP	sys_reg(3, 5, 15, 6, 2)
+#define T8132_DEEP_SLEEP_ENABLE		(BIT_ULL(0) | BIT_ULL(63))
+
+/* Set by the boot CPU once the commit is written, or the sleep abandoned */
+static bool apple_cpu_t8132_released;
+/* With the release: whether the commit was written, and deep sleep allowed */
+static bool apple_cpu_t8132_deep;
+
+/* Clean and invalidate the L1 data cache by set/way */
+static void apple_l1_clean_sw(const struct apple_l1_sw *sw)
+{
+	u64 way = sw->ways;
+
+	asm volatile(
+	"	sub	%[way], %[way], #1\n"
+	"1:	sub	x10, %[sets], #1\n"
+	"2:	lslv	x11, %[way], %[way_shift]\n"
+	"	lslv	x12, x10, %[line_shift]\n"
+	"	orr	x11, x11, x12\n"
+	"	dc	cisw, x11\n"
+	"	subs	x10, x10, #1\n"
+	"	b.ge	2b\n"
+	"	subs	%[way], %[way], #1\n"
+	"	b.ge	1b\n"
+	"	dsb	sy\n"
+	: [way] "+r" (way)
+	: [sets] "r" (sw->sets), [way_shift] "r" (sw->way_shift),
+	  [line_shift] "r" (sw->line_shift)
+	: "x10", "x11", "x12", "cc", "memory");
+}
+
+/*
+ * A core's last instructions for a T8132 sleep: the timers can't end the WFI,
+ * and every wake-up acknowledges a fast IPI before the next WFI. Nothing
+ * brings the core back but a reset. Deep sleep only once the commit is
+ * written: a sleep abandoned after the stop takes the core down as the PMGR
+ * stop alone does (apple_cpu_park_power_down()), its cluster left powered.
+ */
+static void __noreturn apple_cpu_t8132_last_wfi(bool deep_sleep)
+{
+	u64 deep;
+
+	write_sysreg(0, cntv_ctl_el0);
+	write_sysreg(0, cntp_ctl_el0);
+	if (is_kernel_in_hyp_mode())
+		sysreg_clear_set_s(SYS_APL_ACNTHV_CTL_EL2, BIT(0), 0);
+	isb();
+
+	if (deep_sleep) {
+		deep = read_sysreg_s(SYS_APL_T8132_DEEP_SLEEP) | T8132_DEEP_SLEEP_ENABLE;
+		write_sysreg_s(deep, SYS_APL_T8132_DEEP_SLEEP);
+		isb();
+	}
+
+	asm volatile(
+	"1:	dsb	sy\n"
+	"	isb\n"
+	"	wfi\n"
+	"	mov	x10, #1\n"
+	"	msr	s3_5_c15_c1_1, x10\n"
+	"	b	1b\n"
+	: : : "x10", "memory");
+
+	unreachable();
+}
+
+/**
+ * apple_cpu_t8132_deep_sleep() - the boot CPU's last WFI after a T8132 commit
+ *
+ * Cleans the L1 data cache by set/way, then powers the core down at WFI with
+ * deep sleep allowed. The core next runs from its RVBAR. Must be called with
+ * interrupts masked.
+ */
+void __noreturn apple_cpu_t8132_deep_sleep(void)
+{
+	struct apple_l1_sw sw;
+
+	apple_l1_sw(&sw);
+	apple_l1_clean_sw(&sw);
+	apple_cpu_t8132_last_wfi(true);
+}
+EXPORT_SYMBOL_GPL(apple_cpu_t8132_deep_sleep);
+
+static u32 apple_cpu_start_bit(const struct apple_cluster *cl,
+			       unsigned int core);
+
+/*
+ * On the parked core, for a T8132 commit: its own stop bit first, then held
+ * awake, coherent and only reading memory, until the boot CPU has written the
+ * commit, then the last WFI.
+ */
+static void __noreturn apple_cpu_t8132_stop_hold(struct apple_cpu *ac)
+{
+	struct apple_cluster *cl = ac->cluster;
+	struct apple_l1_sw sw;
+
+	writel(apple_cpu_start_bit(cl, ac->core), cl->ctrl->start + CPU_START_STOP);
+	dsb(sy);
+	/* Pairs with the acquire in apple_cpu_t8132_stop_parked(). */
+	smp_store_release(&ac->t8132_stopped, true);
+
+	apple_l1_sw(&sw);
+	apple_l1_clean_sw(&sw);
+	/* Pairs with the release in apple_cpu_t8132_release_stopped(). */
+	while (!smp_load_acquire(&apple_cpu_t8132_released))
+		wfe();
+
+	apple_cpu_t8132_last_wfi(READ_ONCE(apple_cpu_t8132_deep));
+}
 
 static u32 apple_cpu_start_bit(const struct apple_cluster *cl,
 			       unsigned int core)
@@ -1267,6 +1391,9 @@ static void __noreturn apple_cpu_park(struct apple_cpu *ac)
 		unreachable();
 	}
 
+	if (cmd == PARK_CMD_T8132_STOP)
+		apple_cpu_t8132_stop_hold(ac);
+
 	apple_cpu_power_down(cl->ctrl->start + CPU_START_STOP,
 			     apple_cpu_start_bit(cl, ac->core),
 			     APPLE_CPU_SLEEP_MASK_IRQ);
@@ -1436,6 +1563,64 @@ int apple_cpu_park_power_down_all(void)
 }
 EXPORT_SYMBOL_GPL(apple_cpu_park_power_down_all);
 
+/**
+ * apple_cpu_t8132_stop_parked() - stop the parked CPUs for a T8132 commit
+ *
+ * Each parked secondary writes its own PMGR stop bit and is held awake until
+ * apple_cpu_t8132_release_stopped(). Must be called with interrupts masked,
+ * with every secondary CPU offline. A core that took the stop can only be
+ * started again after the SoC was power cycled, also if the sleep is then
+ * abandoned: apple_cpu_t8132_release_stopped() must follow in every case.
+ *
+ * Return: 0, or an error if a parked CPU did not take the stop.
+ */
+int apple_cpu_t8132_stop_parked(void)
+{
+	unsigned int cpu;
+	bool stopped;
+	int ret;
+
+	WRITE_ONCE(apple_cpu_t8132_released, false);
+	WRITE_ONCE(apple_cpu_t8132_deep, false);
+	for_each_possible_cpu(cpu) {
+		struct apple_cpu *ac = apple_cpus[cpu];
+
+		if (!ac || ac->state != APPLE_CPU_PARKED)
+			continue;
+		ac->t8132_stopped = false;
+		ret = apple_cpu_park_command(cpu, ac, PARK_CMD_T8132_STOP);
+		if (!ret)
+			ret = read_poll_timeout_atomic(smp_load_acquire, stopped, stopped,
+						       1, PARK_TIMEOUT_US, false,
+						       &ac->t8132_stopped);
+		if (ret) {
+			ac->state = APPLE_CPU_STUCK;
+			return ret;
+		}
+		ac->state = APPLE_CPU_STOPPED;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_cpu_t8132_stop_parked);
+
+/**
+ * apple_cpu_t8132_release_stopped() - let the stopped CPUs take their last WFI
+ * @committed: the T8132 commit is written, deep sleep is allowed
+ *
+ * After the T8132 commit, or to give up a sleep after
+ * apple_cpu_t8132_stop_parked(): the stopped cores power down.
+ */
+void apple_cpu_t8132_release_stopped(bool committed)
+{
+	WRITE_ONCE(apple_cpu_t8132_deep, committed);
+	/* Pairs with the acquire in apple_cpu_t8132_stop_hold(): @committed first. */
+	smp_store_release(&apple_cpu_t8132_released, true);
+	dsb(sy);
+	sev();
+}
+EXPORT_SYMBOL_GPL(apple_cpu_t8132_release_stopped);
+
 /**
  * apple_cpu_power_cycled() - every CPU complex lost power
  *
