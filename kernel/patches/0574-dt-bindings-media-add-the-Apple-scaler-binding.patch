From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 03:13:57 +0000
Subject: [PATCH] dt-bindings: media: add the Apple scaler binding

Backport of Documentation/devicetree/bindings/media/apple,scaler.yaml as
aurora-silicon/linux integration/aurora has it at 50d5865ea6 (introduced
by 5e92a16b6b "dt-bindings: apple: describe unqualified T6041 and T8140
hardware resources" and 20366a7088 "arm64: dts: apple: describe
disabled T8132 resources and codecs", then reshaped by later
resource-contract commits). The file is taken whole and unchanged: it
already describes apple,t8132-scaler (4 reg, 2 interrupts, 1-2 power
domains, 1-2 IOMMU streams, optional clock) with apple,scaler as the
fallback, which is what the J604 runtime ADT /arm-io/scaler0 has.

The driver (drivers/media/platform/apple/scaler, picked from
aurora-silicon/linux msr/scaler 44d118cbac) and this binding live on
separate Aurora branches; this base carries neither, so the binding comes
in as one file.

[j604: whole-file backport from integration/aurora 50d5865ea6; no edits]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 .../bindings/media/apple,scaler.yaml          | 268 ++++++++++++++++++
 1 file changed, 268 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/apple,scaler.yaml

diff --git a/Documentation/devicetree/bindings/media/apple,scaler.yaml b/Documentation/devicetree/bindings/media/apple,scaler.yaml
new file mode 100644
index 0000000000..e7e0413371
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/apple,scaler.yaml
@@ -0,0 +1,268 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/apple,scaler.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple image scaler
+
+maintainers:
+  - Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
+
+description: |
+  The image scaler and its companion DMA registers. The two DART streams
+  carry image data and PIODMA transfers. Firmware performance votes are
+  not fixed clock rates and are not encoded as clock-frequency values.
+
+select:
+  properties:
+    compatible:
+      contains:
+        enum:
+          - apple,t6000-scaler
+          - apple,t6020-scaler
+          - apple,t6021-scaler
+          - apple,t6022-scaler
+          - apple,t6030-scaler
+          - apple,t6031-scaler
+          - apple,t6032-scaler
+          - apple,t6041-scaler
+          - apple,t8103-scaler
+          - apple,t8112-scaler
+          - apple,t8122-scaler
+          - apple,t8132-scaler
+          - apple,t8140-scaler
+  required:
+    - compatible
+
+properties:
+  compatible: true
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - apple,t8132-scaler
+      required:
+        - compatible
+    then:
+      properties:
+        compatible:
+          items:
+            - enum:
+                - apple,t8132-scaler
+            - const: apple,scaler
+
+        reg:
+          minItems: 4
+          maxItems: 4
+
+        interrupts:
+          minItems: 2
+          maxItems: 2
+
+        power-domains:
+          minItems: 1
+          maxItems: 2
+
+        iommus:
+          minItems: 1
+          maxItems: 2
+
+        clocks:
+          maxItems: 1
+
+      required:
+        - compatible
+        - reg
+        - interrupts
+        - power-domains
+        - iommus
+    else:
+      allOf:
+        - if:
+            properties:
+              compatible:
+                contains:
+                  enum:
+                    - apple,t6032-scaler
+            required:
+              - compatible
+          then:
+            properties:
+              compatible:
+                items:
+                  - const: apple,t6032-scaler
+                  - const: apple,scaler
+
+              reg:
+                minItems: 4
+                maxItems: 4
+
+              interrupts:
+                minItems: 2
+                maxItems: 2
+
+              power-domains:
+                minItems: 2
+                maxItems: 2
+
+              iommus:
+                minItems: 2
+                maxItems: 2
+
+              clocks:
+                maxItems: 1
+
+            required:
+              - compatible
+              - reg
+              - interrupts
+              - power-domains
+              - iommus
+              - clocks
+          else:
+            properties:
+              compatible:
+                items:
+                  - enum:
+                      - apple,t6000-scaler
+                      - apple,t6020-scaler
+                      - apple,t6021-scaler
+                      - apple,t6022-scaler
+                      - apple,t6030-scaler
+                      - apple,t6031-scaler
+                      - apple,t6041-scaler
+                      - apple,t8103-scaler
+                      - apple,t8112-scaler
+                      - apple,t8122-scaler
+                      - apple,t8140-scaler
+                  - const: apple,scaler
+
+              reg:
+                minItems: 2
+                maxItems: 4
+
+              interrupts:
+                minItems: 2
+                maxItems: 2
+
+              power-domains:
+                minItems: 1
+                maxItems: 3
+
+              iommus:
+                minItems: 1
+                maxItems: 2
+
+              clocks:
+                maxItems: 1
+
+              resets:
+                maxItems: 1
+
+            required:
+              - compatible
+              - reg
+              - interrupts
+              - power-domains
+              - iommus
+
+            allOf:
+              - if:
+                  properties:
+                    compatible:
+                      contains:
+                        enum:
+                          - apple,t6041-scaler
+                          - apple,t8140-scaler
+                then:
+                  properties:
+                    reg:
+                      minItems: 4
+                      maxItems: 4
+                    power-domains:
+                      minItems: 2
+                      maxItems: 2
+                    iommus:
+                      minItems: 2
+                      maxItems: 2
+                  required:
+                    - resets
+                    - clocks
+              - if:
+                  properties:
+                    compatible:
+                      contains:
+                        enum:
+                          - apple,t6020-scaler
+                          - apple,t6021-scaler
+                          - apple,t6022-scaler
+                          - apple,t8112-scaler
+                then:
+                  properties:
+                    power-domains:
+                      minItems: 2
+                      maxItems: 3
+                    iommus:
+                      minItems: 2
+                      maxItems: 2
+              - if:
+                  properties:
+                    compatible:
+                      contains:
+                        enum:
+                          - apple,t6030-scaler
+                          - apple,t6031-scaler
+                          - apple,t8122-scaler
+                then:
+                  properties:
+                    power-domains:
+                      minItems: 1
+                      maxItems: 2
+              - if:
+                  properties:
+                    compatible:
+                      contains:
+                        const: apple,t8103-scaler
+                then:
+                  properties:
+                    reg:
+                      maxItems: 2
+                else:
+                  properties:
+                    reg:
+                      minItems: 3
+              - if:
+                  properties:
+                    compatible:
+                      contains:
+                        const: apple,t6000-scaler
+                then:
+                  properties:
+                    reg:
+                      minItems: 3
+                      maxItems: 3
+              - if:
+                  properties:
+                    compatible:
+                      contains:
+                        enum:
+                          - apple,t6000-scaler
+                          - apple,t8103-scaler
+                then:
+                  properties:
+                    power-domains:
+                      minItems: 2
+                      maxItems: 2
+                    iommus:
+                      minItems: 2
+                  required:
+                    - resets
+                    - clocks
+
+            additionalProperties: false
+
+unevaluatedProperties: false
