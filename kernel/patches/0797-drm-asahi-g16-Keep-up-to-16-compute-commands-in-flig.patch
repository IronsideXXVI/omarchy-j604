From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 11:47:29 +0000
Subject: [PATCH] drm/asahi: g16: Keep up to 16 compute commands in
 flight by default

A queue of small compute commands drains every few commands. Each
command in flight holds its own compute unit until the host retires
it, and with 12 units and a horizon of 7 at most 8 commands can be in
the firmware at once. The host's completion path (firmware event,
wake-up and retirement) takes longer than 8 small commands take to
run, so the queue empties and the next command waits for the host.

Raise the default to all 16 compute units the 25G83 layout provides
(COMPUTE_SLOTS) and the default horizon to 15, so up to 16 commands
can be queued behind each other. Each extra unit costs about 33 MiB,
allocated only for a VM that runs compute, at its first compute
command. Both stay module parameters; g16_compute_units=12 and
g16_horizon=7 give the previous behaviour.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/hw.rs     |  2 +-
 drivers/gpu/drm/asahi/g16/params.rs | 15 ++++++++-------
 2 files changed, 9 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/hw.rs b/drivers/gpu/drm/asahi/g16/hw.rs
index 0aa494d17d..bb63a8b1c6 100644
--- a/drivers/gpu/drm/asahi/g16/hw.rs
+++ b/drivers/gpu/drm/asahi/g16/hw.rs
@@ -374,7 +374,7 @@ pub(crate) mod sizes {
     /// Units 0 and 1 are the qualified ones; 2 and 3 take the next 64 MiB intervals below the
     /// render units; 4..7 the free interval below render pass slot 1; 8..11 the free interval
     /// above pass slot 1's tilemap; 12..15 the free tails of render units 0 and 1. How many a
-    /// VM allocates is `g16_compute_units` (latched, default 12).
+    /// VM allocates is `g16_compute_units` (latched, default 16).
     pub(crate) const COMPUTE_SLOTS: usize = 16;
     const _: () = assert!(
         super::client::compute_context(3) + 0x40000 <= super::client::render_base(0)
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 3a63ad7cbd..f20f2f4ea3 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -575,8 +575,8 @@ pub(crate) fn submit_ts() -> u32 {
     "G16: clock of the submit record time word (default 0: architectural counter; 1: firmware stage clock, 24 MHz; runtime 0644)"
 );
 
-/// Storage of `g16_horizon` (runtime 0644, default 7).
-static HORIZON: AtomicU32 = AtomicU32::new(7);
+/// Storage of `g16_horizon` (runtime 0644, default 15).
+static HORIZON: AtomicU32 = AtomicU32::new(15);
 
 /// Compute horizon, format A (per-command ahead posting): with `g16_horizon` = 1, a queue's
 /// next compute command may be published behind its running compute predecessor, into the
@@ -590,7 +590,8 @@ pub(crate) fn submit_ts() -> u32 {
 /// `COMPUTE_SLOTS - 1`): with one behind, every second command still waited for the host to
 /// notice a retirement (J604 k884: 30318 ahead at a 32 us gap, 74866 serial at ~200 us). With
 /// three behind (1.908) 80 % still ran serial: a command's round trip (doorbell to start ~95 us,
-/// completion to host ~108 us) outlasts four tiny commands. Default 7, on `g16_compute_units`.
+/// completion to host ~108 us) outlasts four tiny commands. Default 15, on 16
+/// `g16_compute_units`: with 8 in flight the queue drained every ~7.7 commands.
 pub(crate) fn horizon() -> bool {
     HORIZON.load(Ordering::Relaxed) != 0 && super::pools::lifetime::overlap_active()
 }
@@ -601,8 +602,8 @@ pub(crate) fn horizon_depth() -> u64 {
     (HORIZON.load(Ordering::Relaxed) as u64).clamp(1, compute_units() as u64 - 1)
 }
 
-/// Storage of `g16_compute_units` (0644, default 12; latched at the engine start).
-static COMPUTE_UNITS: AtomicU32 = AtomicU32::new(12);
+/// Storage of `g16_compute_units` (0644, default 16; latched at the engine start).
+static COMPUTE_UNITS: AtomicU32 = AtomicU32::new(16);
 /// The latched compute units, 0 until latched.
 static COMPUTE_UNITS_LATCH: AtomicU32 = AtomicU32::new(0);
 
@@ -626,7 +627,7 @@ pub(crate) fn compute_units() -> usize {
     COMPUTE_UNITS_PARM,
     COMPUTE_UNITS,
     "g16_compute_units",
-    "G16: compute units per VM, one compute command in flight each (default 12; 2..16; 8 = before; 4 = k908; 9..16 = deeper compute queue, ~33 MiB per unit, 13..16 for g16_horizon up to 15; latched at the engine start, set it as a module option)"
+    "G16: compute units per VM, one compute command in flight each (default 16; 2..16; 12 = k948; 8 = before; 4 = k908; 9..16 = deeper compute queue, ~33 MiB per unit, 13..16 for g16_horizon up to 15; latched at the engine start, set it as a module option)"
 );
 
 /// Storage of `g16_compute_shared_pool` (0644, default 0; latched at its first read).
@@ -673,7 +674,7 @@ pub(crate) fn compute_shared_pool_state() -> u32 {
     HORIZON_PARM,
     HORIZON,
     "g16_horizon",
-    "G16: compute commands of one queue that may go behind its running compute predecessor (default 7; 1 up to g16_compute_units - 1, each on its own compute unit; needs g16_overlap=1 and g16_uma_split=1; 0: none; runtime 0644)"
+    "G16: compute commands of one queue that may go behind its running compute predecessor (default 15; 1 up to g16_compute_units - 1, each on its own compute unit; needs g16_overlap=1 and g16_uma_split=1; 0: none; runtime 0644)"
 );
 
 /// Storage of `g16_depth` (runtime 0644, default 0).
