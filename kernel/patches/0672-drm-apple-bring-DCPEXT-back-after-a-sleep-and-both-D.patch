From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:26 -0500
Subject: [PATCH] drm/apple: bring DCPEXT back after a sleep, and both DCPs
 after a refusal

After a deep sleep DCPEXT's resume found nothing to do, so the external
display processor stayed down until a reboot, with no firmware running.
macOS brings it back the same way in every wake measured: DISPEXT0's SYS
and FE on, then its CPU with PS_MIN 4 first, since the wake reset it,
then on, pmc-dcp up, its DART's streams on again, and a warm restart,
with no secure port and no display-on call. Do that from the resume
after a real sleep, releasing the DART's GAPF slice first if the wake
left it protected. Type-C work, stopped for the sleep, starts again once
the firmware is back. A DCPEXT that a failed start left running is
stopped before the next sleep, as the internal DCP is.

pmc-dcp holds the number of powered DCPs on macOS: 0, 1, 2, 1, 0 across
a wake. The driver wrote an absolute 1 or 0 for the internal DCP, which
is right only while DCPEXT never powers up. Keep one count for both: a
DCP counts from when this driver powers its domains up until it powers
them off, or a sleep stops it, since the sleep controller lowers the
domains itself.

A firmware that has idled for a sleep doesn't come back with its power
kept: after a refused sleep the DCPs woke on the first message and never
read their inbox, and the display stayed dark until the next real sleep.
The internal DCP now comes back as DPMS on brings it, from a power
cycle: its domains off in macOS's order, then the warm restart and
display on, measured 11 of 11. DCPEXT goes through DISPEXT0's own
power-off, CPU first, which really gates its CPU, holds it off for a
second, then starts as after a real sleep, through
apple_rtkit_power_cycled_return(). Its display DART goes dark before the
domains drop and is lit again once they're back, as the compositor can
still map framebuffers into it. The sleep controller lowers DISPEXT0
before refusals of its own, and with it off the CPU and the display DART
don't answer, so a cycle that finds DISPEXT0 off raises it first.

A stop that fails once the CPU has stopped, at the DART's stream stop,
fails the suspend, and the PM core doesn't call .resume for it: the
firmware is started again there, as for a refused sleep, before the
error goes back. On the internal DCP the refused path releases the GAPF
slice first, as a failed flush leaves it protecting the CPU's power
word, which faults when written.

A crashed DCP no longer keeps the machine out of every deep sleep until
reboot. As macOS recovers one, its CPU is stopped cold, its mailbox
turned off and its DART's streams stopped, so the sleep controller can
lower its domain, and the wake's power cycle starts it again; a good
start clears the crash. DCPEXT skips its A500 and the display
disconnect, and its Type-C work goes off. DPMS off, which has no power
cycle behind it, still refuses a crashed DCP.

An idle the internal DCP refused with the display already off is taken
back: AP on to its main mailbox, as the GPU and the AOP send it after a
refused idle, and its secure port's AP side brought back and polled
again. The next sleep doesn't send set_power_state(0) a second time,
whose D572 may never come, and goes straight to A500 and the idle; if
that stops the firmware, the display stays dark after the wake, as after
DPMS off, until DPMS on starts it, and if that sleep is refused its
domains are lowered first, as DPMS off does.

Signed-off-by: Diljit Singh <hey@djdev.me>

[j604 backport: applied clean. New paths are gated on dcp_s2r_capable/_ext_capable (H17P + apple,t8140-dcp/dcpext) or on s2r_stopped/s2r_fw_down, which only those paths set: inert on T8132. The wake sequence and pmc-dcp counts are Aurora's T8140 measurements; none were traced here]
Assisted-by: Claude:claude-opus-5.5

---
 drivers/gpu/drm/apple/dcp-internal.h |   2 +
 drivers/gpu/drm/apple/dcp.c          | 417 +++++++++++++++++++++++++--
 2 files changed, 387 insertions(+), 32 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-internal.h b/drivers/gpu/drm/apple/dcp-internal.h
index 611e2103bb..c94e42a723 100644
--- a/drivers/gpu/drm/apple/dcp-internal.h
+++ b/drivers/gpu/drm/apple/dcp-internal.h
@@ -647,6 +647,8 @@ struct apple_dcp {
 	bool s2r_fw_down;
 	/* This driver raised the display domains, and nothing has lowered them since. */
 	bool s2r_domains_up;
+	/* Counted in pmc-dcp, the number of powered DCPs */
+	bool pmc_up;
 	bool s2r_power_on;
 	bool s2r_power_oob;
 	u8 s2r_step;
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 5862ffc0d5..e558d3aed3 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -7202,6 +7202,7 @@ static void dcp_platform_complete(struct device *dev)
 #define DCP_S2R_DISP_STREAMS	(BIT(0) | BIT(3) | BIT(4) | BIT(16))
 #define DCP_S2R_DCP_STREAMS	(BIT(23) | BIT(24))
 #define DCP_S2R_D572_TIMEOUT_MS	1000	/* macOS: about 170 ms after A473(0) */
+#define DCP_PS_MIN		GENMASK(19, 16)
 
 static struct device *dcp_s2r_find_dart(struct device_node *np)
 {
@@ -7271,6 +7272,22 @@ static void dcp_s2r_answer_secure_port(struct apple_dcp *dcp)
 		dcp_secure_port_start(dcp);
 }
 
+/* After a refused idle: AP on to both mailboxes, as the GPU and the AOP send it. */
+static void dcp_s2r_idle_undo(struct apple_dcp *dcp)
+{
+	int ret;
+
+	ret = apple_rtkit_ap_power(dcp->rtk, true);
+	if (ret)
+		dev_warn(dcp->dev, "AP on after the refused idle: %d\n", ret);
+	if (!dcp->secure_rtk || !dcp->secure_answered || READ_ONCE(dcp->secure_polling))
+		return;
+	ret = apple_rtkit_port_on(dcp->secure_rtk, DCP_SECURE_TIMEOUT_MS);
+	if (ret)
+		dev_warn(dcp->dev, "secure port AP on after the refused idle: %d\n", ret);
+	dcp_secure_poll_start(dcp);
+}
+
 /*
  * macOS's order up to RTKit idle. On success the firmware is idle and its run bit
  * is still set.
@@ -7278,7 +7295,9 @@ static void dcp_s2r_answer_secure_port(struct apple_dcp *dcp)
 static int dcp_s2r_quiesce(struct apple_dcp *dcp, u32 *status)
 {
 	ktime_t start = ktime_get();
-	bool display_off = false;
+	/* Off since a refused idle: no second set_power_state(0), whose D572 may never come. */
+	bool display_off = dcp->s2r_refused_off;
+	bool idle_sent = false;
 	s64 power_ms;
 	bool idle;
 	int ret;
@@ -7287,6 +7306,11 @@ static int dcp_s2r_quiesce(struct apple_dcp *dcp, u32 *status)
 	dcp_s2r_find_darts(dcp);
 	WRITE_ONCE(dcp->s2r_active, true);
 
+	if (display_off) {
+		dev_info(dcp->dev, "display still off from a refused idle\n");
+		goto display_is_off;
+	}
+
 	/* In band, 3 of 3 on macOS. */
 	ret = iomfb_s2r_power_h17p(dcp, false, true, false);
 	if (ret) {
@@ -7307,6 +7331,7 @@ static int dcp_s2r_quiesce(struct apple_dcp *dcp, u32 *status)
 		ktime_ms_delta(ktime_get(), start));
 	display_off = true;
 
+display_is_off:
 	/* D572 itself is still being answered, and a busy channel can't be sent on. */
 	usleep_range(5000, 6000);
 	if (read_poll_timeout(iomfb_channels_idle, idle, idle, 1000, 100000, false, dcp))
@@ -7324,6 +7349,7 @@ static int dcp_s2r_quiesce(struct apple_dcp *dcp, u32 *status)
 	if (read_poll_timeout(iomfb_channels_idle, idle, idle, 1000, 100000, false, dcp))
 		dev_warn(dcp->dev, "firmware calls still in flight before idle\n");
 
+	idle_sent = true;
 	ret = apple_rtkit_idle_with(dcp->rtk, dcp_secure_port_idle, dcp);
 	if (ret) {
 		/* Answer what it still has queued, its log counters among them, and ask again. */
@@ -7354,6 +7380,7 @@ static int dcp_s2r_quiesce(struct apple_dcp *dcp, u32 *status)
 		ktime_ms_delta(ktime_get(), start), *status);
 
 	WRITE_ONCE(dcp->s2r_active, false);
+	dcp->s2r_refused_off = false;
 
 	return 0;
 
@@ -7365,6 +7392,8 @@ err:
 	 * own feet. DPMS on lights the display again on the running firmware.
 	 */
 	if (display_off) {
+		if (idle_sent)
+			dcp_s2r_idle_undo(dcp);
 		dcp->s2r_refused_off = true;
 		dev_warn(dcp->dev, "display left off with the firmware running\n");
 		return ret;
@@ -7416,20 +7445,107 @@ static bool dcp_s2r_ext_capable(struct apple_dcp *dcp)
 	       of_device_is_compatible(dcp->dev->of_node, "apple,t8140-dcpext");
 }
 
+/*
+ * Taken as stopped, but a start since raised its domains and failed after the run bit,
+ * as one a signal ended. Left running, it refuses every sleep; stopped, it comes back
+ * from the sleep's power cycle like any other.
+ */
+static void dcp_s2r_stop_failed_start(struct apple_dcp *dcp)
+{
+	if (!dcp->s2r_domains_up ||
+	    !(readl(dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL) &
+	      APPLE_DCP_COPROC_CPU_CONTROL_RUN))
+		return;
+	dev_warn(dcp->dev, "a failed start left the firmware running: stopping it for the sleep\n");
+	dcp_s2r_cpu_stop(dcp);
+}
+
+/*
+ * pmc-dcp counts the powered DCPs, as macOS keeps it: 0, 1, 2, 1, 0 across a wake. A DCP
+ * counts from when this driver powers it up until it powers it off or a sleep stops it.
+ */
+static DEFINE_MUTEX(dcp_pmc_lock);
+static unsigned int dcp_pmc_count;
+
+static void dcp_pmc_set(struct apple_dcp *dcp, void __iomem *pmc, bool up)
+{
+	guard(mutex)(&dcp_pmc_lock);
+	if (up != dcp->pmc_up) {
+		dcp->pmc_up = up;
+		if (up)
+			dcp_pmc_count++;
+		else if (dcp_pmc_count)
+			dcp_pmc_count--;
+	}
+	writel(dcp_pmc_count, pmc);
+}
+
+/* The sleep controller lowers the domains and pmc-dcp itself. */
+static void dcp_pmc_forget(struct apple_dcp *dcp)
+{
+	guard(mutex)(&dcp_pmc_lock);
+	if (dcp->pmc_up && dcp_pmc_count)
+		dcp_pmc_count--;
+	dcp->pmc_up = false;
+}
+
+static void dcp_s2r_restart_failed_stop(struct apple_dcp *dcp);
+
+/*
+ * Crashed firmware takes no stop sequence, and refusing would hold every later sleep off until
+ * reboot. Its CPU stops cold, as for a failed start, and the wake starts it again, as macOS
+ * recovers a crashed DCP. A system sleep only: DPMS off still refuses it.
+ */
+static bool dcp_s2r_stops_crashed(struct apple_dcp *dcp)
+{
+	return READ_ONCE(dcp->crashed) && !IS_ERR_OR_NULL(dcp->rtk) &&
+	       pm_suspend_target_state != PM_SUSPEND_ON;
+}
+
+static int dcp_s2r_stop_crashed(struct apple_dcp *dcp)
+{
+	void __iomem *control = dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL;
+	int ret;
+
+	dev_warn(dcp->dev, "firmware crashed: stopped cold for the sleep, started again after it\n");
+	apple_rtkit_mailbox_off(dcp->rtk);
+	writel(readl(control) & ~APPLE_DCP_COPROC_CPU_CONTROL_RUN, control);
+	writel(readl(control) & ~APPLE_DCP_COPROC_CPU_CONTROL_RUN, control);
+	dcp_s2r_find_darts(dcp);
+	dcp->s2r_stopped = true;
+	WRITE_ONCE(dcp->s2r_fw_down, true);
+	ret = dcp_s2r_stop_streams(dcp);
+	if (ret) {
+		dcp_s2r_restart_failed_stop(dcp);
+		return ret == -ETIMEDOUT ? -EBUSY : ret;
+	}
+	dcp_pmc_forget(dcp);
+	device_set_wakeup_path(dcp->dev);
+
+	return 0;
+}
+
 static int dcp_s2r_ext_suspend(struct apple_dcp *dcp)
 {
 	int ret;
 
 	if (READ_ONCE(dcp->s2r_fw_down)) {
+		dcp_s2r_stop_failed_start(dcp);
 		dcp_s2r_find_darts(dcp);
 		dcp->s2r_stopped = true;
 		ret = dcp_s2r_stop_streams(dcp);
 		if (ret)
 			return ret == -ETIMEDOUT ? -EBUSY : ret;
+		dcp_pmc_forget(dcp);
 		device_set_wakeup_path(dcp->dev);
 		return 0;
 	}
 
+	/* No A500 and no disconnect: the link just goes down. */
+	if (dcp_s2r_stops_crashed(dcp)) {
+		dcp_disable_typec_work(dcp, false);
+		return dcp_s2r_stop_crashed(dcp);
+	}
 	if (READ_ONCE(dcp->crashed) || IS_ERR_OR_NULL(dcp->rtk))
 		return -EBUSY;
 
@@ -7480,32 +7596,21 @@ static int dcp_s2r_ext_suspend(struct apple_dcp *dcp)
 		readl(dcp->coproc_reg + APPLE_DCP_COPROC_CPU_STATUS));
 
 	ret = dcp_s2r_stop_streams(dcp);
-	if (ret)
+	if (ret) {
+		dcp_s2r_restart_failed_stop(dcp);
 		return ret == -ETIMEDOUT ? -EBUSY : ret;
+	}
 
+	dcp_pmc_forget(dcp);
 	device_set_wakeup_path(dcp->dev);
 
 	return 0;
 }
 
