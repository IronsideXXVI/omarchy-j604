From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 23:48:20 +0000
Subject: [PATCH] thermal: apple: pmp: Pin the raw poll to one CPU on a tick
 boundary

The 5 ms raw poll hrtimer is armed HRTIMER_MODE_REL at the end of the
deferred setup work. It re-arms itself with hrtimer_forward_now(), so it
stays on whichever CPU ran that work and keeps the phase against the
scheduler tick that it started with. Its work item runs on the same CPU
(system_highpri_wq).

At HZ=1000 the period is exactly five ticks, and tick boundaries are
multiples of TICK_NSEC, so that phase is fixed for the whole boot. Idle
exit restarts a stopped tick at the next tick boundary. If the poll's
work is still running then, sched_tick() sees a busy CPU, and
nohz_balancer_kick() takes the CPU out of nohz.idle_cpus_mask. Because
nohz.needs_update is set, it sends a NOHZ_NEXT_KICK to the first idle
CPU (cpu0, a P core). When the CPU idles again, nohz_balance_enter_idle()
sets needs_update again, so the next poll kicks again. The tick on that
CPU also runs its deferrable timers each period.

On the J604 this happened on one boot and not on another, with identical
code in every involved file (MEASURED, 60 s ftrace at idle, same
userspace wakeup profile):
  boot A: poll on cpu6 (E core). cpu6 tick 219/s, nohz_csd_func 197/s
    sent from kworker/6:0H, cpu0 idle entries 280/s, SCHED softirq
    459/s, apple_clpc_idle_work 81.5/s. P-CPU rail 0.096 W, system
    7.43 W (600 s).
  boot B: poll on cpu8 (P core). cpu8 tick 16/s, nohz_csd_func 2.1/s,
    cpu0 idle entries 87/s, SCHED softirq 96/s, apple_clpc_idle_work
    12.4/s. P-CPU rail 0.054 W, system 7.31 W.
  Both: apple_pmp_poll_timer and apple_pmp_poll_work 200.1/s, E-CPU
    rail 0.009 W.
The poll CPU differs, but the kick path above does not depend on the
CPU. It depends on whether the work outlasts the time left to the next
tick boundary (INFERENCE from the code above; TO-VERIFY from the
recorded hrtimer expiry times).

Arm the poll from the chosen CPU (smp_call_function_single()) as an
absolute pinned hrtimer whose first expiry is the first tick boundary at
least one period away. The work then starts just after a tick boundary
and has most of a tick to finish before a restarted tick can fire. The
period, the 100 ms governor, the trips and the three >= 120 C samples at
least 5 ms apart are unchanged.

The CPU is a module parameter, poll_cpu, which defaults to 6, an E core.
On boot A, an extra ~208 E-core wakeups/s did not move the E-CPU rail
(MEASURED, 0.009 W on both boots), while the P-CPU rail rose with the
kicks to cpu0. If the CPU is not online, the poll runs on the calling
CPU instead and a warning is printed. T8132 CPUs cannot go offline
(spin-table), and a pinned hrtimer moves with hrtimers_cpu_dying()
anyway.

The official Aurora tree (integration/aurora 50d5865ea6) arms the same
poll HRTIMER_MODE_REL, and no rework of it exists there.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/thermal/apple-pmp-thermal.c | 53 +++++++++++++++++++++++++++--
 1 file changed, 50 insertions(+), 3 deletions(-)

diff --git a/drivers/thermal/apple-pmp-thermal.c b/drivers/thermal/apple-pmp-thermal.c
index 46dc59af88..836b8f1291 100644
--- a/drivers/thermal/apple-pmp-thermal.c
+++ b/drivers/thermal/apple-pmp-thermal.c
@@ -23,6 +23,7 @@
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/pm_qos.h>
+#include <linux/smp.h>
 #include <linux/soc/apple/cpufreq-thermal.h>
 #include <linux/soc/apple/pmp-temps.h>
 #include <linux/soc/apple/pmp-telemetry.h>
@@ -41,6 +42,20 @@
 #define APPLE_PMP_POLL_MS		5
 #define APPLE_PMP_GOVERNOR_NS	100000000ULL
 
+/*
+ * The raw poll runs on one fixed CPU, and its period starts on a scheduler
+ * tick boundary. When TICK_NSEC divides the period (HZ 1000, 500, 200 or
+ * 100) the poll keeps that phase against the tick for good. Idle exit
+ * restarts a stopped tick at the next tick boundary. If the poll's work is
+ * still running then, every period becomes a busy tick: it takes the CPU out
+ * of the nohz idle set and kicks the idle load balancer (an IPI to the first
+ * idle CPU), and the CPU joins the set again when it next idles. Starting on
+ * a boundary gives the work most of a tick to finish first. Without a fixed
+ * CPU and phase, both depend on when the deferred setup happened to run.
+ * CPU 6 is an E core (cluster 1 below).
+ */
+#define APPLE_PMP_POLL_CPU		6
+
 /*
  * Boards whose sensor topology and operating policy are qualified: the PMP
  * die records, P cores 0 and 7-9, E cores 1-6. The measured-rail budget is
@@ -104,6 +119,10 @@ module_param_named(sample_count, pmp_thermal.sample_count, ullong, 0444);
 module_param_named(governor_count, pmp_thermal.governor_count, ullong, 0444);
 module_param_named(ready, pmp_thermal.ready, bool, 0444);
 
+static int poll_cpu = APPLE_PMP_POLL_CPU;
+module_param(poll_cpu, int, 0444);
+MODULE_PARM_DESC(poll_cpu, "CPU that runs the 5 ms raw poll (default 6, an E core)");
+
 static int apple_pmp_power_status(char *buffer, const struct kernel_param *kp)
 {
 	struct apple_pmp_power_policy *p = &pmp_thermal.power;
@@ -517,6 +536,35 @@ static enum hrtimer_restart apple_pmp_poll_timer(struct hrtimer *timer)
 	return HRTIMER_RESTART;
 }
 
+/* Arm the poll on this CPU, first expiring on a tick boundary. */
+static void apple_pmp_poll_start(void *unused)
+{
+	u64 expires = ktime_get_ns() + APPLE_PMP_POLL_MS * NSEC_PER_MSEC;
+	u32 rem;
+
+	/* Tick boundaries are multiples of TICK_NSEC (tick_init_jiffy_update()). */
+	div_u64_rem(expires, TICK_NSEC, &rem);
+	if (rem)
+		expires += TICK_NSEC - rem;
+	hrtimer_start(&pmp_thermal.poll_timer, ns_to_ktime(expires),
+		      HRTIMER_MODE_ABS_PINNED);
+}
+
+static void apple_pmp_poll_arm(void)
+{
+	int cpu = READ_ONCE(poll_cpu);
+
+	if (cpu >= 0 && cpu < nr_cpu_ids &&
+	    !smp_call_function_single(cpu, apple_pmp_poll_start, NULL, true)) {
+		pr_info("apple-pmp-thermal: raw poll on CPU %d, tick-aligned\n", cpu);
+		return;
+	}
+	/* Polling anywhere beats not polling. */
+	pr_warn("apple-pmp-thermal: poll CPU %d is not online; raw poll on CPU %d\n",
+		cpu, raw_smp_processor_id());
+	apple_pmp_poll_start(NULL);
+}
+
 static int apple_pmp_change_mode(struct thermal_zone_device *zone,
 				 enum thermal_device_mode mode)
 {
@@ -727,8 +775,7 @@ static int apple_pmp_thermal_setup(void)
 	pmp_thermal.power_polling = true;
 	schedule_delayed_work(&pmp_thermal.power_work, msecs_to_jiffies(500));
 	pmp_thermal.polling = true;
-	hrtimer_start(&pmp_thermal.poll_timer, ms_to_ktime(APPLE_PMP_POLL_MS),
-		      HRTIMER_MODE_REL);
+	apple_pmp_poll_arm();
 	/* Both guards start at the minimum frequency: hand over the cpufreq cap. */
 	pmp_thermal.owner = true;
 	for (i = 0; i < ARRAY_SIZE(pmp_thermal.clusters); i++) {
@@ -789,7 +836,7 @@ static int apple_pmp_thermal_probe(struct platform_device *pdev)
 	INIT_DELAYED_WORK(&pmp_thermal.power_work, apple_pmp_power_work);
 	INIT_WORK(&pmp_thermal.poll_work, apple_pmp_poll_work);
 	hrtimer_setup(&pmp_thermal.poll_timer, apple_pmp_poll_timer,
-		      CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+		      CLOCK_MONOTONIC, HRTIMER_MODE_ABS_PINNED);
 	schedule_delayed_work(&pmp_thermal.setup_work, 0);
 	return 0;
 }
