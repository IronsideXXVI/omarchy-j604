+/* A DART with a two-entry filter in a bank of three, every byte of the bank 0xa5. */
+static struct apple_dart *apple_dart_test_dapf(struct kunit *test, u8 **bank)
+{
+	static const u64 ranges[] = { 0x380704000, 0x380704063, 0x382824000, 0x382824004 };
+	struct apple_dart *dart;
