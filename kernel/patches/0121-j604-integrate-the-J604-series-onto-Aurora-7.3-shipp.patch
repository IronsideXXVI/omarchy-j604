+/* Coprocessor ASC: CPU control (run bit) and status, as nvme-apple's ANS */
+#define ASC_CPU_CONTROL		0x44
+#define ASC_CPU_CONTROL_RUN	BIT(4)
+#define ASC_CPU_STATUS		0x48
+
+/* ANS, DCP, DCPEXT, SIO, PMP, GPU, ISP, AOP */
+#define S2R_COPROCS		8
+
+static struct apple_s2r_coproc {
+	struct device *dev;
+	void __iomem *asc;
+	int (*last_check)(void *data);
+	int (*last_stop)(void *data);
+	void *data;
+	bool ready;
+	bool stopped;
+	/* Stopped before the others; its last stop clears its own run bits */
+	bool first;
+	u32 status;
+} apple_s2r_coprocs[S2R_COPROCS];
+static DEFINE_MUTEX(apple_s2r_coprocs_lock);
+
+/* The enclave's sleep request, the very last refusal */
+static struct {
+	struct device *dev;
+	int (*tell)(void *data);
+	void *data;
+} apple_s2r_enclave;
+
+static struct apple_s2r_coproc *apple_s2r_coproc_find(struct device *dev)
+{
+	int i;
+
+	for (i = 0; i < S2R_COPROCS; i++)
+		if (apple_s2r_coprocs[i].dev == dev)
+			return &apple_s2r_coprocs[i];
+	return NULL;
+}
+
+int apple_sleep_coproc_register(struct device *dev, void __iomem *asc, bool pcie_ans,
+				int (*last_stop)(void *data), void *data)
+{
+	struct apple_s2r_coproc *c;
+
+	/* The warm boot path comes back at EL2 only (probe) */
+	if (!is_kernel_in_hyp_mode())
+		return -ENODEV;
+	if (pcie_ans)
+		return -EOPNOTSUPP;
+
+	guard(mutex)(&apple_s2r_coprocs_lock);
+	if (apple_s2r_coproc_find(dev))
+		return -EEXIST;
+	c = apple_s2r_coproc_find(NULL);
+	if (!c)
+		return -ENOSPC;
+	*c = (struct apple_s2r_coproc) {
+		.asc = asc,
+		.last_stop = last_stop,
+		.data = data,
+		.dev = dev,
+	};
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_sleep_coproc_register);
+
+int apple_sleep_coproc_register_first(struct device *dev, int (*last_stop)(void *data),
+				      void *data)
+{
+	struct apple_s2r_coproc *c;
+	int ret;
+
+	if (!last_stop)
+		return -EINVAL;
+	ret = apple_sleep_coproc_register(dev, NULL, false, last_stop, data);
+	if (ret)
+		return ret;
+
+	guard(mutex)(&apple_s2r_coprocs_lock);
+	c = apple_s2r_coproc_find(dev);
+	if (c)
+		c->first = true;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_sleep_coproc_register_first);
