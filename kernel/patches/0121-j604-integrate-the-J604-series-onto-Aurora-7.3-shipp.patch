+EXPORT_SYMBOL_GPL(apple_pmp_j713_display_sleep_disable);
+
+/*
+ * From the PMP's suspend_late, before it stops. 0: no vote is held or in
+ * flight, and none is taken until apple_pmp_display_wake(). Otherwise
+ * nothing changed and the sleep is refused: -EBUSY, or the error of a
+ * failed vote stream.
+ */
+int apple_pmp_display_sleep(void)
+{
+	/* Pairs with the release in apple_pmp_display_register(). */
+	struct apple_pmp_display *p = smp_load_acquire(&pmp_display);
+	enum pmp_display_sleep_verdict verdict;
+	struct pmp_display_sleep_votes v;
+	unsigned long flags;
+	int ret;
+
+	if (!p) {
+		pr_err("pmp-display: no vote bridge, retained power votes have no teardown: refusing the sleep\n");
+		return -EBUSY;
+	}
+	/* Every get and put sends under the request lock: nothing is in flight while it is held. */
+	mutex_lock(&p->request);
+	spin_lock_irqsave(&p->lock, flags);
+	v = (struct pmp_display_sleep_votes) {
+		.provider_error = p->vote.provider_error,
+		.error = p->vote.error,
+		.pending = p->vote.pending != PMP_POWER_NONE,
+		.disp_held = p->vote.held[PMP_POWER_DISP],
+		.agx_held = p->vote.held[PMP_POWER_AGX],
+	};
+	verdict = pmp_display_sleep_enter(&p->sleep, &v);
+	spin_unlock_irqrestore(&p->lock, flags);
+	mutex_unlock(&p->request);
+
+	if (verdict == PMP_DISPLAY_SLEEP_OK) {
+		dev_dbg(p->dev, "retained votes released: none taken until wake\n");
+		return 0;
+	}
+	ret = verdict == PMP_DISPLAY_SLEEP_FAILED ? (v.provider_error ?: v.error ?: -EIO) : -EBUSY;
+	dev_err(p->dev, "%s: refusing the sleep\n", pmp_display_sleep_reason(verdict));
+	return ret;
+}
+
+/* From the PMP's resume_early, or when its sleep did not happen: votes may be taken again. */
+void apple_pmp_display_wake(void)
+{
+	/* Pairs with the release in apple_pmp_display_register(). */
+	struct apple_pmp_display *p = smp_load_acquire(&pmp_display);
+	unsigned long flags;
+
+	if (!p)
+		return;
+	spin_lock_irqsave(&p->lock, flags);
+	pmp_display_sleep_leave(&p->sleep);
+	spin_unlock_irqrestore(&p->lock, flags);
+}
