index 0000000000..fbd1d248e1
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -0,0 +1,1310 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * MacBook Pro (14-inch, M4, 2024): the J604 delta on top of Aurora's
+ * t8132-j604.dts (DjDeveloperr's ADT-derived board file and the shared T8132
+ * files). Everything below is what the 1.617 J604 series described
+ * for this machine and Aurora 7.3 does not; the original commits and authors
+ * are those of the 1.617 series.
+ *
+ * Storage, the nub SPMI bus and its PMU stay as 1.617 described them (proven
+ * with m1n1 1.608): Aurora's boot-loader-filled placeholders and the aliases
+ * that ask the boot loader to fill them are removed for this board.
+ */
+
+/ {
+	aliases {
+		/delete-property/ ans;
+		/delete-property/ ans-mbox;
+		/delete-property/ sart-ans;
+		/delete-property/ spmi-primary;
+		/delete-property/ pmu-primary;
+		/delete-property/ nvram;
+	};
+};
+
+/delete-node/ &{/soc/nvme@40000};
