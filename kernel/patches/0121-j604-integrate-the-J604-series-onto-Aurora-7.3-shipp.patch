+        drop(store);
+        // The next boot finds the old record alone, and arms again.
+        let mut store = open(&bytes, &faults, &writes, true)?;
+        let (_, records, _, malformed, duplicates, _, writable) = store.summary();
+        assert_eq!((records, malformed, duplicates, writable), (4, 0, 0, true));
+        assert_eq!(value_of(&mut store, &ROOT1)?.as_deref(), Some(&b"root one"[..]));
+        Ok(())
+    }
+
+    static SAVED: Atomic<u32> = Atomic::new(0);
+
+    fn save_ok(_key: &Key, _value: &[u8]) -> Result<()> {
+        SAVED.fetch_add(1, Relaxed);
+        Ok(())
+    }
+
+    fn existing(store: &TestStore<'_>) -> Result<KVec<Key>> {
+        store.live_keys()
+    }
+
+    #[test]
+    fn strict_never_changes_another_os_record() -> Result<()> {
+        let bytes = RefCell::new(image()?);
+        let list = RefCell::new(KVec::new());
+        let (faults, writes) = (Faults::default(), RefCell::new(KVec::new()));
+        let mut store = open(&bytes, &faults, &writes, true)?;
+        let keys = existing(&store)?;
+        store.set_guard_with(Guard::strict_with_file(1, keys, Ok(MemList(&list))));
+        store.save_prev = save_ok;
+        let saved = SAVED.load(Relaxed);
+        let locker_slot = copy(&bytes)?;
+        assert_eq!(store.write(&MACOS_LOCKER, b"rewritten"), Err(EPERM));
+        assert_eq!(store.write(&MACOS_USER, b"rewritten"), Err(EPERM));
+        assert_eq!(store.delete(&MACOS_LOCKER), Err(EPERM));
+        assert_eq!(store.delete(&MACOS_USER), Err(EPERM));
+        assert!(writes.borrow().is_empty());
+        assert!(locker_slot[..] == bytes.borrow()[..]);
+        assert_eq!(SAVED.load(Relaxed), saved);
+        // A refusal does not disarm: Linux's own records and the roots
+        // stay writable.
+        assert!(store.writes_enabled());
+        let new = Key::new(4, [9; 16]);
+        store.write(&new, b"linux record")?;
+        store.write(&ROOT2, b"root two, next")?;
+        assert_eq!(value_of(&mut store, &MACOS_LOCKER)?.as_deref(), Some(&b"macOS locker"[..]));
+        assert_eq!(value_of(&mut store, &MACOS_USER)?.as_deref(), Some(&b"macOS user record"[..]));
+        assert!(all_inside(&writes));
+        Ok(())
+    }
+
+}
