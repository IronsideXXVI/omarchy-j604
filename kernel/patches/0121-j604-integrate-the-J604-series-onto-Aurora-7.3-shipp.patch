+/*
+ * The last refusals: interrupts are off and no other CPU is up, so the
+ * registry is read without its lock, which no one can hold now.
+ */
+static int apple_s2r_coprocs_check(struct apple_s2r *s2r)
+{
+	int i, ret;
+
+	for (i = 0; i < S2R_COPROCS; i++) {
+		struct apple_s2r_coproc *c = &apple_s2r_coprocs[i];
+
+		if (!c->dev || !c->ready || c->stopped || !c->last_check)
+			continue;
+		ret = c->last_check(c->data);
+		if (ret) {
+			dev_err(s2r->dev, "refused: %s: %d\n", dev_name(c->dev), ret);
+			return ret;
+		}
+	}
+	if (apple_s2r_enclave.tell) {
+		ret = apple_s2r_enclave.tell(apple_s2r_enclave.data);
+		if (ret) {
+			dev_err(s2r->dev, "refused: the enclave didn't take the sleep request: %d\n",
+				ret);
+			return ret;
+		}
+	}
+	return 0;
+}
+
+/*
+ * Past every refusal: a coprocessor stopped here comes back only through a
+ * real sleep. Those registered first go before the others; then each run bit
+ * is cleared from what it reads back, twice, as on Aurora's ANS stop.
+ */
+static void apple_s2r_coprocs_stop(bool first)
+{
+	int i;
+
+	for (i = 0; i < S2R_COPROCS; i++) {
+		struct apple_s2r_coproc *c = &apple_s2r_coprocs[i];
+
+		if (!c->dev || !c->ready || c->stopped || c->first != first)
+			continue;
+		if (c->last_stop)
+			c->last_stop(c->data);
+		if (c->asc) {
+			c->status = readl(c->asc + ASC_CPU_STATUS);
+			writel(readl(c->asc + ASC_CPU_CONTROL) & ~ASC_CPU_CONTROL_RUN,
+			       c->asc + ASC_CPU_CONTROL);
+			writel(readl(c->asc + ASC_CPU_CONTROL) & ~ASC_CPU_CONTROL_RUN,
+			       c->asc + ASC_CPU_CONTROL);
+		}
+		c->stopped = true;
+	}
+	dsb(sy);
+}
