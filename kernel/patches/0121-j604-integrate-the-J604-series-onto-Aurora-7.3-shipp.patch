diff --git a/drivers/soc/apple/pmp-display-sleep-test.c b/drivers/soc/apple/pmp-display-sleep-test.c
new file mode 100644
index 0000000000..81f34c7ff3
--- /dev/null
+++ b/drivers/soc/apple/pmp-display-sleep-test.c
@@ -0,0 +1,263 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * KUnit tests for the retained PMP votes through a system sleep that stops
+ * the PMP (pmp-display-sleep.h). No hardware: a model of the bridge's vote
+ * state, driven in the order the PM core and the DCP drive the real one.
+ */
+#include <kunit/test.h>
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include "pmp-display-sleep.h"
+
+/* The bridge's vote state as the model drives it: get/put as the consumer calls them. */
+struct model {
+	struct pmp_display_sleep s;
+	struct pmp_display_sleep_votes v;
+	unsigned int sends;
+};
+
+/* apple_pmp_j713_display_get(): sends only when admitted and not yet held. */
+static int model_get_disp(struct model *m)
+{
+	if (!pmp_display_sleep_admits(&m->s))
+		return -EBUSY;
+	if (!m->v.disp_held) {
+		m->sends++;
+		m->v.disp_held = true;
+	}
+	return 0;
+}
+
+/* apple_pmp_j713_display_put(): a vote not held needs nothing sent. */
+static int model_put_disp(struct model *m)
+{
+	if (m->v.disp_held) {
+		m->sends++;
+		m->v.disp_held = false;
+	}
+	return 0;
+}
+
+static void model_boot(struct model *m)
+{
+	*m = (struct model) {};
+	/* Probe: the DCP takes DISP at bring-up. */
+	model_get_disp(m);
+}
+
+/* No consumer: refused, as before the check, whatever the votes are; nothing changes. */
+static void pmp_sleep_refused_without_consumer(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+	/* Even with every vote released, the refusal stays until a consumer opts in. */
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+	KUNIT_EXPECT_TRUE(test, pmp_display_sleep_admits(&m.s));
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+}
+
+/* The consumer's suspend runs first and releases DISP; the PMP stops; resume reverses it. */
+static void pmp_sleep_teardown_restore_order(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	/* DCP .suspend: power gate (put), then arm this sleep (display_sleep_enable). */
+	KUNIT_EXPECT_EQ(test, model_put_disp(&m), 0);
+	KUNIT_EXPECT_EQ(test, m.sends, 2U);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	/* PMP suspend_late. */
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_TRUE(test, m.s.asleep);
+	/* Nothing reaches the stopped PMP. */
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), -EBUSY);
+	KUNIT_EXPECT_FALSE(test, m.v.disp_held);
+	KUNIT_EXPECT_EQ(test, m.sends, 2U);
+	/* PMP resume_early, then DCP .resume: ungate, get. */
+	pmp_display_sleep_leave(&m.s);
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+	KUNIT_EXPECT_TRUE(test, m.v.disp_held);
+	KUNIT_EXPECT_EQ(test, m.sends, 3U);
+	/* The wake ended the arming: a second sleep arms again, the same way. */
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	pmp_display_sleep_leave(&m.s);
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+}
+
+/* Wrong order: the PMP asked before its consumer released DISP. Refused; nothing changes. */
+static void pmp_sleep_refused_disp_held(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	m.s.consumer = true;
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_DISP_HELD);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+	KUNIT_EXPECT_TRUE(test, m.v.disp_held);
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+	KUNIT_EXPECT_EQ(test, m.sends, 1U);
+}
+
+/* AGX has no release: once the GPU took it, every such sleep is refused. */
+static void pmp_sleep_refused_agx_held(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	m.s.consumer = true;
+	model_put_disp(&m);
+	m.v.agx_held = true;
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_AGX_HELD);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+}
+
+static void pmp_sleep_refused_pending_or_failed(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	m.s.consumer = true;
+	model_put_disp(&m);
+	m.v.pending = true;
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_PENDING);
+	m.v.pending = false;
+	m.v.error = -EPROTO;		/* closed stream: DISP could not be taken again */
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_FAILED);
+	m.v.error = 0;
+	m.v.provider_error = -EIO;	/* failed owner: before any other reason */
+	m.v.pending = true;
+	m.v.agx_held = true;
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_FAILED);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+}
+
+/* suspend_late for a PMP still stopped from a refused sleep; wake twice. */
+static void pmp_sleep_enter_leave_idempotent(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	m.s.consumer = true;
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_TRUE(test, m.s.asleep);
+	pmp_display_sleep_leave(&m.s);
+	pmp_display_sleep_leave(&m.s);
+	KUNIT_EXPECT_TRUE(test, pmp_display_sleep_admits(&m.s));
+	/* Leave without enter (resume after a refused suspend_late) changes nothing. */
+	pmp_display_sleep_leave(&m.s);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+}
+
+/* Arming while DISP is still held (the consumer did not power down) is refused. */
+static void pmp_sleep_arm_refused_disp_held(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_DISP_HELD);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	/* A failed owner refuses before anything else. */
+	model_put_disp(&m);
+	m.v.provider_error = -EIO;
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_FAILED);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+}
+
+/* One arming, one sleep: after wake an unarmed sleep is refused again. */
+static void pmp_sleep_arm_one_sleep(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	pmp_display_sleep_leave(&m.s);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+	/* Display used, blanked and powered down again, but not armed: refused. */
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+}
+
+/* A sleep aborted after the consumer armed it, before the PMP stopped: its resume disarms. */
+static void pmp_sleep_disarm_on_resume(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	pmp_display_sleep_disarm(&m.s);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	KUNIT_EXPECT_TRUE(test, pmp_display_sleep_admits(&m.s));
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	/* Disarm with nothing armed changes nothing. */
+	pmp_display_sleep_disarm(&m.s);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+}
+
+/* Armed by the display, but the GPU holds AGX: still refused; the display's resume disarms. */
+static void pmp_sleep_armed_agx_still_refused(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	m.v.agx_held = true;
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_AGX_HELD);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+	pmp_display_sleep_disarm(&m.s);
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+}
+
+static void pmp_sleep_reasons(struct kunit *test)
+{
+	enum pmp_display_sleep_verdict v;
+
+	for (v = PMP_DISPLAY_SLEEP_OK; v <= PMP_DISPLAY_SLEEP_DISP_HELD; v++)
+		KUNIT_EXPECT_STRNEQ(test, pmp_display_sleep_reason(v), "unknown");
+	KUNIT_EXPECT_NOT_NULL(test, strstr(pmp_display_sleep_reason(PMP_DISPLAY_SLEEP_NO_CONSUMER),
+					   "retained power votes have no teardown"));
+}
+
+static struct kunit_case pmp_display_sleep_cases[] = {
+	KUNIT_CASE(pmp_sleep_refused_without_consumer),
+	KUNIT_CASE(pmp_sleep_teardown_restore_order),
+	KUNIT_CASE(pmp_sleep_refused_disp_held),
+	KUNIT_CASE(pmp_sleep_refused_agx_held),
+	KUNIT_CASE(pmp_sleep_refused_pending_or_failed),
+	KUNIT_CASE(pmp_sleep_enter_leave_idempotent),
+	KUNIT_CASE(pmp_sleep_arm_refused_disp_held),
+	KUNIT_CASE(pmp_sleep_arm_one_sleep),
+	KUNIT_CASE(pmp_sleep_disarm_on_resume),
+	KUNIT_CASE(pmp_sleep_armed_agx_still_refused),
+	KUNIT_CASE(pmp_sleep_reasons),
+	{}
+};
+
+static struct kunit_suite pmp_display_sleep_suite = {
+	.name = "apple-pmp-display-sleep",
+	.test_cases = pmp_display_sleep_cases,
+};
+
+kunit_test_suite(pmp_display_sleep_suite);
+
+MODULE_DESCRIPTION("Apple PMP retained vote system sleep tests");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/soc/apple/pmp-display-sleep.h b/drivers/soc/apple/pmp-display-sleep.h
new file mode 100644
index 0000000000..a59ae97a5e
--- /dev/null
+++ b/drivers/soc/apple/pmp-display-sleep.h
@@ -0,0 +1,141 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The retained DISP/AGX votes through a system sleep that stops the PMP
+ * (pmp-display.c, pmp-export.c). Decisions only, no hardware: unit tested
+ * by pmp-display-sleep-test.c.
+ *
+ * The bridge cannot release a vote on its own. DISP is released by its
+ * consumer, the DCP, which powers the display domains down first and calls
+ * apple_pmp_j713_display_put() (iomfb_m4_power_gate()); it takes the vote
+ * again with apple_pmp_j713_display_get() after power-up. AGX has no release
+ * at all. So a sleep that stops the PMP may only go ahead when the consumer
+ * has released DISP for this sleep and armed it (pmp_display_sleep_arm()),
+ * AGX is not held, nothing is in flight and the request stream works; from
+ * then until wake no vote may be taken, since a stopped PMP cannot accept
+ * one. The arming lasts one sleep: wake clears it, and so does the
+ * consumer's resume (pmp_display_sleep_disarm()).
+ */
+#ifndef _APPLE_PMP_DISPLAY_SLEEP_H
+#define _APPLE_PMP_DISPLAY_SLEEP_H
+
+#include <linux/types.h>
+
+enum pmp_display_sleep_verdict {
+	PMP_DISPLAY_SLEEP_OK,
+	/* DISP not released and this sleep not armed (apple_pmp_j713_display_sleep_enable()). */
+	PMP_DISPLAY_SLEEP_NO_CONSUMER,
+	/* The PMP owner failed, or an ambiguous reply closed the request stream. */
+	PMP_DISPLAY_SLEEP_FAILED,
+	/* A vote request is in flight. */
+	PMP_DISPLAY_SLEEP_PENDING,
+	/* The AGX vote is held: it has no release. */
+	PMP_DISPLAY_SLEEP_AGX_HELD,
+	/* The DISP vote is held: its consumer has not powered the display down. */
+	PMP_DISPLAY_SLEEP_DISP_HELD,
+};
+
+struct pmp_display_sleep {
+	/* Armed for this sleep: the consumer released DISP. Cleared at wake. */
+	bool consumer;
+	/* Between apple_pmp_display_sleep() and apple_pmp_display_wake(). */
+	bool asleep;
+};
+
+/* The vote state the decision reads, as pmp-display.c keeps it. */
+struct pmp_display_sleep_votes {
+	int provider_error;
+	int error;
+	bool pending;
+	bool disp_held;
+	bool agx_held;
+};
+
+static inline enum pmp_display_sleep_verdict
+pmp_display_sleep_check(const struct pmp_display_sleep *s, const struct pmp_display_sleep_votes *v)
+{
+	/* First: without a consumer nothing else is asked, as before this check existed. */
+	if (!s->consumer)
+		return PMP_DISPLAY_SLEEP_NO_CONSUMER;
+	if (v->provider_error)
+		return PMP_DISPLAY_SLEEP_FAILED;
+	if (v->pending)
+		return PMP_DISPLAY_SLEEP_PENDING;
+	if (v->agx_held)
+		return PMP_DISPLAY_SLEEP_AGX_HELD;
+	if (v->disp_held)
+		return PMP_DISPLAY_SLEEP_DISP_HELD;
+	/* Released, but the consumer could not take DISP again after wake. */
+	if (v->error)
+		return PMP_DISPLAY_SLEEP_FAILED;
+	return PMP_DISPLAY_SLEEP_OK;
+}
+
+/* Enter the sleep if allowed. Already asleep: nothing could have changed, OK. */
+static inline enum pmp_display_sleep_verdict
+pmp_display_sleep_enter(struct pmp_display_sleep *s, const struct pmp_display_sleep_votes *v)
+{
+	enum pmp_display_sleep_verdict verdict;
+
+	if (s->asleep)
+		return PMP_DISPLAY_SLEEP_OK;
+	verdict = pmp_display_sleep_check(s, v);
+	if (verdict == PMP_DISPLAY_SLEEP_OK)
+		s->asleep = true;
+	return verdict;
+}
+
+/* Wake: votes may be taken again, and the next sleep needs a new arming. */
+static inline void pmp_display_sleep_leave(struct pmp_display_sleep *s)
+{
+	s->asleep = false;
+	s->consumer = false;
+}
+
+/*
+ * The consumer, in its suspend, once it has powered the display down and put
+ * DISP: arm this sleep. Refused while DISP is still held or the owner failed;
+ * nothing changes then.
+ */
+static inline enum pmp_display_sleep_verdict
+pmp_display_sleep_arm(struct pmp_display_sleep *s, const struct pmp_display_sleep_votes *v)
+{
+	if (v->provider_error)
+		return PMP_DISPLAY_SLEEP_FAILED;
+	if (v->disp_held)
+		return PMP_DISPLAY_SLEEP_DISP_HELD;
+	s->consumer = true;
+	return PMP_DISPLAY_SLEEP_OK;
