+	dart = apple_dart_test_dapf(test, &bank);
+	KUNIT_EXPECT_FALSE(test, apple_dart_dapf_matches(dart));
+	apple_dart_dapf_write(dart);
+	KUNIT_EXPECT_TRUE(test, apple_dart_dapf_matches(dart));
+
+	writeq(0x380704063 | 3, dart->dapf + 0x10);
+	writel(0xff00 | 0x31, dart->dapf + 0x00);
+	KUNIT_EXPECT_TRUE(test, apple_dart_dapf_matches(dart));
