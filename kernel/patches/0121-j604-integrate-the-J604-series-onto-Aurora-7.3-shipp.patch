+					       &rtk->iop_power_state, us);
+	if (!ret)
+		ret = readl_poll_timeout_atomic(cpu_control + APPLE_ASC_CPU_STATUS, status,
+						(status & APPLE_ASC_CPU_STATUS_DOWN) ==
+						APPLE_ASC_CPU_STATUS_DOWN,
+						APPLE_RTKIT_POLLED_STEP_US, 5000);
