+	/* Every entry counts, not only the first. */
+	writeq(0x382828000, dart->dapf + DART_DAPF_STRIDE + 0x08);
+	KUNIT_EXPECT_FALSE(test, apple_dart_dapf_matches(dart));
+	apple_dart_dapf_write(dart);
+	writel(1, dart->dapf + DART_DAPF_STRIDE + 0x04);
+	KUNIT_EXPECT_FALSE(test, apple_dart_dapf_matches(dart));
+	apple_dart_dapf_write(dart);
+	writel(0, dart->dapf + DART_DAPF_STRIDE + 0x20);
+	KUNIT_EXPECT_FALSE(test, apple_dart_dapf_matches(dart));
