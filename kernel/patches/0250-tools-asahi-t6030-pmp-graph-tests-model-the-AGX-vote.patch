From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 21:42:40 +0000
Subject: [PATCH] tools/asahi: t6030-pmp-graph-tests: model the AGX
 vote and drop a dead stub

The PMP report's probe now sets rep->agx_id from
apple_pmp_report_agx_id(), which came with 895c1acc38 ("soc: apple: vote
GPU activity to the PMP so memory leaves idle DVFS on t600x") and is
carried since the 7.3 integration snapshot 6c29d67f46. The fixture's
struct apple_pmp_report has no agx_id and the helper is not extracted,
so the harness no longer builds. With that fixed, its devm_kcalloc()
stub, which the extracted code stopped calling in the same snapshot,
fails -Wunused-function.

Extract the helper with the probe (it returns -1 for a T6030 report),
give the fixture the field, the T8132 offsets it compares against and
APPLE_PMP_T6001_AGX_ID, and turn the old stub into a macro.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 tools/asahi/t6030-pmp-graph-tests.c  | 10 ++++++----
 tools/asahi/t6030-pmp-graph-tests.py |  2 +-
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/tools/asahi/t6030-pmp-graph-tests.c b/tools/asahi/t6030-pmp-graph-tests.c
index e89d982d2d..2e4362cc9c 100644
--- a/tools/asahi/t6030-pmp-graph-tests.c
+++ b/tools/asahi/t6030-pmp-graph-tests.c
@@ -156,6 +156,8 @@ struct apple_pmp_report {
 	struct list_head list;
 	void *debugfs;
 	struct apple_pmp_start *start;
+	/* The AGX request this report votes: none on T6030, which reads -1 */
+	int agx_id;
 	/* Requests held until the PMP runs; T6030 does not defer them. */
 	u64 shadow, known;
 	bool defer;
@@ -632,10 +634,8 @@ static void *devm_kzalloc(struct device *d, size_t n, int g)
 	return v;
 }
 
-static void *devm_kcalloc(struct device *d, size_t n, size_t size, int g)
-{
-	return devm_kzalloc(d, n * size, g);
-}
+/* A macro: the production code stopped calling it, older refs (--ref) still do. */
+#define devm_kcalloc(d, n, size, g) devm_kzalloc(d, (n) * (size), g)
 #define kzalloc_obj(v) calloc(1, sizeof(v))
 #define kfree free
 static char *kstrdup(const char *s, int g)
@@ -751,6 +751,8 @@ static const struct apple_pmp_start_timing apple_pmp_start_timing = { 2, 0, 2,
 /* The extracted probe compares rep->offsets with the T6001 table and tells the AGX vote that a report came back. This harness has neither: the table is empty and
  * never matches, and the call does nothing. */
 static const struct apple_pmp_report_offsets apple_pmp_offsets_t600x;
+static const struct apple_pmp_report_offsets apple_pmp_offsets_t8132;
+#define APPLE_PMP_T6001_AGX_ID 9
 static void apple_pmp_agx_activity_resume(void) {}
 /* Floor admission is covered independently by the J613 fixture. */
 static int j613_floor_probe(struct apple_pmp_report *rep)
diff --git a/tools/asahi/t6030-pmp-graph-tests.py b/tools/asahi/t6030-pmp-graph-tests.py
index 4c85001acf..3b67bb63fb 100644
--- a/tools/asahi/t6030-pmp-graph-tests.py
+++ b/tools/asahi/t6030-pmp-graph-tests.py
@@ -45,7 +45,7 @@ def main():
              'static int apple_pmp_report_entry_set_state(',
              'static int apple_pmp_report_entry_power_on(', 'static int apple_pmp_report_entry_power_off(',
              'static void apple_pmp_report_entry_free(', 'static int apple_pmp_report_entry_probe(',
-             'static int apple_pmp_report_probe(', 'static struct device_node *apple_pmp_report_t6030_entry(',
+             'static int apple_pmp_report_agx_id(', 'static int apple_pmp_report_probe(', 'static struct device_node *apple_pmp_report_t6030_entry(',
              'static int apple_pmp_report_wait_t6030_14(', 'int apple_pmp_report_wait_supplier_ready(']
     if 'static bool apple_pmp_report_running(' in source:
         names.insert(0, 'static bool apple_pmp_report_running(')
-- 
2.43.0

