From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 05:17:01 +0000
Subject: [PATCH] iommu: apple-dart: bring to #1314's final revision

Bring to its revision in aurora-silicon/linux#1314:
commit 322e1035c6db ("iommu: apple-dart: preserve native radio
translations across system sleep").
This tree carried an earlier revision:
commit 5166c2c786c1 ("iommu: apple-dart: preserve native radio
translations across system sleep").
Only the difference between the two.

Based on 322e1035c6db from aurora-silicon/linux#1314
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 include/linux/soc/apple/sleep-spin.h | 6 ++++--
 tools/asahi/dart-sleep-power-tests.c | 2 +-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/include/linux/soc/apple/sleep-spin.h b/include/linux/soc/apple/sleep-spin.h
index 056a975d64..6748b2d536 100644
--- a/include/linux/soc/apple/sleep-spin.h
+++ b/include/linux/soc/apple/sleep-spin.h
@@ -15,7 +15,8 @@ static inline int apple_sleep_spin(void __iomem *reg, u32 mask, u32 expected, un
 {
 #ifdef CONFIG_ARM64
 	u64 start = arch_timer_read_counter();
-	u64 ticks = ((u64)arch_timer_get_rate() * usec + USEC_PER_SEC - 1) / USEC_PER_SEC;
+	/* CNTFRQ_EL0, the arch timer's rate: arch_timer_get_rate() isn't exported to modules. */
+	u64 ticks = ((u64)arch_timer_get_cntfrq() * usec + USEC_PER_SEC - 1) / USEC_PER_SEC;
 
 	if (!ticks)
 		return -EINVAL;
@@ -28,8 +29,9 @@ static inline int apple_sleep_spin(void __iomem *reg, u32 mask, u32 expected, un
 		now = arch_timer_read_counter();
 		if (now < start)
 			return -EIO;
+		/* One more look: a stall after the read mustn't make a done wait time out. */
 		if (now - start >= ticks)
-			return reg ? -ETIMEDOUT : 0;
+			return reg && (readl(reg) & mask) != expected ? -ETIMEDOUT : 0;
 		cpu_relax();
 	}
 	return -ETIMEDOUT;
diff --git a/tools/asahi/dart-sleep-power-tests.c b/tools/asahi/dart-sleep-power-tests.c
index 92882677ad..cde438032c 100644
--- a/tools/asahi/dart-sleep-power-tests.c
+++ b/tools/asahi/dart-sleep-power-tests.c
@@ -184,7 +184,7 @@ static u64 arch_timer_read_counter(void)
 		return tick--;
 	return stopped_counter ? tick : (tick += 1000);
 }
-static u32 arch_timer_get_rate(void)
+static u32 arch_timer_get_cntfrq(void)
 {
 	return 1000000;
 }
-- 
2.43.0

