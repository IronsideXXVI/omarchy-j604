From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 08:06:46 +0000
Subject: [PATCH] PCI: apple: add a bring-up switch for a test mem
 sleep that is not firmware-driven

The managed radio port refuses any sleep but suspend-to-idle in its noirq
suspend. Add pcie_apple.debug_allow_mem, default off: a suspend-to-RAM
that is not declared firmware-driven (apple_s2r.debug_begin_as_idle,
pm_test only) keeps the port in place as for suspend-to-idle. A
firmware-driven sleep is not affected.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/pci/controller/pcie-apple.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/drivers/pci/controller/pcie-apple.c b/drivers/pci/controller/pcie-apple.c
index 6ad3376dcf..fce3c64d3e 100644
--- a/drivers/pci/controller/pcie-apple.c
+++ b/drivers/pci/controller/pcie-apple.c
@@ -3942,6 +3942,15 @@ static void apple_pcie_stop_for_sleep(struct device *dev)
 		apple_pcie_tunnel_hierarchy_lost(dev);
 }
 
+/*
+ * Bring-up: a test suspend-to-RAM that is not declared firmware-driven
+ * (apple_s2r.debug_begin_as_idle, pm_test only) keeps the managed radio in
+ * place as for suspend-to-idle instead of refusing it. Default off.
+ */
+static bool debug_allow_mem;
+module_param(debug_allow_mem, bool, 0644);
+MODULE_PARM_DESC(debug_allow_mem, "Bring-up: let a suspend-to-RAM that is not firmware-driven (apple_s2r.debug_begin_as_idle) pass as for suspend-to-idle (default: off)");
+
 static int apple_pcie_suspend_noirq(struct device *dev)
 {
 	struct apple_pcie *pcie = apple_pcie_lookup(dev);
@@ -3951,7 +3960,9 @@ static int apple_pcie_suspend_noirq(struct device *dev)
 	 * leaves it in place like any other internal port (no power domain).
 	 */
 	if (pcie->managed_sids)
-		return pm_suspend_target_state == PM_SUSPEND_TO_IDLE ? 0 : -EBUSY;
+		return pm_suspend_target_state == PM_SUSPEND_TO_IDLE ||
+		       (READ_ONCE(debug_allow_mem) && !pm_suspend_via_firmware()) ?
+		       0 : -EBUSY;
 	if (!pcie->hw->tunneled)
 		return 0;
 	pcie->reset_on_resume = false;
