From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 01:46:45 +0000
Subject: [PATCH] drm/asahi: g16: optionally reuse a leased PB manager
 of the same VM

Every G16 render command gets a fresh parameter-buffer manager: the host
seeds its page and block lists, and the TA ring starts with an InitBM
before the TA work. On the J604 a render command waits about 0.7 ms
from publication to its first firmware event, while a compute command,
which has no InitBM, waits about 0.17 ms and the TA stage itself takes
about 11 us.

Add g16_pb_reuse (runtime 0644, default 0 = unchanged). At 1 a render
command reuses the manager its pass slot still leases from a fully
retired command of the same VM, and skips the InitBM entry, when that
manager was exposed on the same slot and the two words of its free-block
ring agree. The flight records which manager it used, and that one is
checked, exposed and leased as before. The debugfs pb line counts
reuses, fresh managers and refused reuses.

This is a measurement knob: whether the firmware keeps a consistent
buffer manager across commands without InitBM has to be shown on the
machine before anything changes by default.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 0082350c34f39f8398bce572cd20af56253d4102)
---
 drivers/gpu/drm/asahi/g16/engine.rs | 41 ++++++++++++++++++----
 drivers/gpu/drm/asahi/g16/params.rs | 18 ++++++++++
 drivers/gpu/drm/asahi/g16/poll.rs   |  2 +-
 drivers/gpu/drm/asahi/g16/pools.rs  | 53 +++++++++++++++++++++++++++--
 4 files changed, 104 insertions(+), 10 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 020379265b..b42196eecd 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -182,6 +182,8 @@ pub(crate) struct Flight {
     pub(crate) published_ns: u64,
     /// Publication time in architectural counter ticks (24 MHz), for the latency statistics.
     pub(crate) published_ticks: u64,
+    /// The PB manager this render prefix uses: its own, or the leased one it reused.
+    pub(crate) pb_used: Option<Arc<super::pools::PbEpoch>>,
 }
 
 impl Flight {
@@ -212,6 +214,7 @@ fn new(job: Arc<Job>) -> Self {
             recovery_started_ns: 0,
             published_ns: 0,
             published_ticks: 0,
+            pb_used: None,
         }
     }
 }
@@ -918,14 +921,37 @@ pub(crate) fn job_partly_published(&self, job: &Job) -> bool {
     }
 
     /// Addresses and cumulative allocator state of the selected retained render unit.
-    fn render_refs(&mut self, k: usize, job: &Job, draw: u64) -> Result<(RenderRefs, bool)> {
+    fn render_refs(
+        &mut self,
+        k: usize,
+        job: &Job,
+        draw: u64,
+        pb_used: &mut Option<Arc<super::pools::PbEpoch>>,
+    ) -> Result<(RenderRefs, bool)> {
         let generation = job.vm.generation;
         let arena = job.resources.render()?;
         let mut a = arena.pools.prepare(k, draw)?;
-        let epoch = job.resources.pb(job.progress.sent() as usize)?;
-        epoch.prepare(k, arena.pools.heap_gva(k)?)?;
+        // g16_pb_reuse: the manager slot k still leases from a fully retired command of
+        // this VM, without a new InitBM; otherwise the command's own fresh manager.
+        let reused = if params::pb_reuse() {
+            self.pools.reusable(k, &job.vm)
+        } else {
+            None
+        };
+        let epoch = match reused {
+            Some(epoch) => {
+                a.init_buffer = false;
+                epoch
+            }
+            None => {
+                let epoch = job.resources.pb(job.progress.sent() as usize)?;
+                epoch.prepare(k, arena.pools.heap_gva(k)?)?;
+                epoch.clone()
+            }
+        };
         a.pb_mgr = epoch.manager.va;
         a.mgr_misc = epoch.misc.va;
+        *pb_used = Some(epoch);
         let r = &self.graph.render;
         let stage = draw.checked_mul(2).ok_or(EOVERFLOW)?;
         Ok((
@@ -1096,8 +1122,9 @@ fn publish_prefix_into(
             return Err(EAGAIN);
         }
         if render {
-            job.resources
-                .pb(index as usize)?
+            f.pb_used
+                .as_ref()
+                .ok_or(EINVAL)?
                 .check_assignment(f.claims.pass[0] as usize)?;
         }
         // Reserve lifetime ownership before any counter or producer becomes reachable.
@@ -1110,7 +1137,7 @@ fn publish_prefix_into(
         let publication = (|| -> Result {
             if render {
                 let k = f.claims.pass[0] as usize;
-                job.resources.pb(index as usize)?.expose();
+                f.pb_used.as_ref().ok_or(EINVAL)?.expose();
                 job.resources.render()?.pools.publish(k, f.uma_submitted)?;
                 // Notifier service dereferences u32 counters; the host ordering ledger
                 // remains u64. Eight-byte spacing is retained allocation padding.
@@ -1333,7 +1360,7 @@ fn prefix_render(
         // Claim performs only a qualified per-use scrub, never allocator/list reset.
         self.slots.claim_pass(job.resources.render()?, k)?;
         self.slots.hold_vm(&f.claims, &job.vm)?;
-        let (refs, init_buffer) = self.render_refs(k, job, draw)?;
+        let (refs, init_buffer) = self.render_refs(k, job, draw, &mut f.pb_used)?;
         let p = &job.resources.render()?.passes[k];
         let pass = p.refs();
         let geometry = Geometry::new(&cmd.cmd, pass.heap_gva);
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index c65a4d1b96..97369ac3ba 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -503,6 +503,24 @@ pub(crate) fn flights() -> usize {
     "G16: render commands in flight at once, 1 (default, the qualified one-at-a-time protocol) or 2 (one render published behind a running render; experimental; runtime 0644)"
 );
 
+/// Storage of `g16_pb_reuse` (runtime 0644, default 0).
+static PB_REUSE: AtomicU32 = AtomicU32::new(0);
+
+/// Whether a render command may reuse its pass slot's leased PB manager of the same VM
+/// without a new InitBM (experimental).
+pub(crate) fn pb_reuse() -> bool {
+    PB_REUSE.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    PB_REUSE_PARAM,
+    PB_REUSE_PARMTYPE,
+    PB_REUSE_PARM,
+    PB_REUSE,
+    "g16_pb_reuse",
+    "G16: let a render command reuse the PB manager its pass slot still leases from a fully retired command of the same VM, without a new InitBM (default 0 = a fresh manager and InitBM for every command; experimental; runtime 0644)"
+);
+
 /// Fragment-only dependency publication has not been qualified on this backend.
 pub(crate) fn early_tiling() -> bool {
     false
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 145f3511b0..7f503e8086 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -576,7 +576,7 @@ pub(crate) fn retire_oldest(
             if f.renders != 0 {
                 self.recovery.last_retired[1] = Some(f.ta_target);
                 self.recovery.last_retired[2] = Some(f.fs_target);
-                let committed = f.job.resources.pb(f.first).and_then(|epoch| {
+                let committed = f.pb_used.as_ref().ok_or(EINVAL).and_then(|epoch| {
                     self.pools
                         .retire_binding(timestamp_claims.pass[0] as usize, epoch)
                 });
diff --git a/drivers/gpu/drm/asahi/g16/pools.rs b/drivers/gpu/drm/asahi/g16/pools.rs
index d4a85cc6f3..dd845ac0d0 100644
--- a/drivers/gpu/drm/asahi/g16/pools.rs
+++ b/drivers/gpu/drm/asahi/g16/pools.rs
@@ -67,6 +67,12 @@ pub(crate) struct PbStats {
     #[allow(dead_code)]
     pub(crate) refused: u64,
     pub(crate) bad: u64,
+    /// g16_pb_reuse: commands that reused a leased manager, that found none to reuse, and
+    /// that found one whose free-block ring words differed (not reused); last ring words.
+    pub(crate) reused: u64,
+    pub(crate) fresh: u64,
+    pub(crate) ring_busy: u64,
+    pub(crate) ring_last: [u32; 2],
 }
 
 pub(crate) struct PoolSet {
@@ -268,6 +274,33 @@ pub(crate) fn new(dev: &AsahiDrmDevice) -> Self {
             owners: [None, None],
         }
     }
+    /// The PB manager slot `k` still leases, if it belongs to `vm`, has been exposed on
+    /// slot `k` and its free-block ring words agree (g16_pb_reuse).
+    pub(crate) fn reusable(
+        &mut self,
+        k: usize,
+        vm: &Arc<super::vm::VmState>,
+    ) -> Option<Arc<PbEpoch>> {
+        let Some(epoch) = self.owners.get(k).and_then(Option::as_ref) else {
+            self.stats.fresh += 1;
+            return None;
+        };
+        if !epoch.same_vm(vm) || epoch.check_assignment(k).is_err() || !epoch.is_exposed() {
+            self.stats.fresh += 1;
+            return None;
+        }
+        let Ok(words) = epoch.ring_words() else {
+            self.stats.fresh += 1;
+            return None;
+        };
+        self.stats.ring_last = words;
+        if words[0] != words[1] {
+            self.stats.ring_busy += 1;
+            return None;
+        }
+        self.stats.reused += 1;
+        Some(epoch.clone())
+    }
     pub(crate) fn retire_binding(&mut self, k: usize, epoch: &Arc<PbEpoch>) -> Result {
         *self.owners.get_mut(k).ok_or(EINVAL)? = Some(epoch.clone());
         Ok(())
@@ -275,10 +308,15 @@ pub(crate) fn retire_binding(&mut self, k: usize, epoch: &Arc<PbEpoch>) -> Resul
     pub(crate) fn write_stats(&self, f: &mut impl fmt::Write) -> fmt::Result {
         writeln!(
             f,
-            "pb: M4 private allocators blocks {} requests {} bad {}",
+            "pb: M4 private allocators blocks {} requests {} bad {} reuse {} fresh {} ring_busy {} ring {} {}",
             buffer::MAX_BLOCKS,
             self.stats.requests,
-            self.stats.bad
+            self.stats.bad,
+            self.stats.reused,
+            self.stats.fresh,
+            self.stats.ring_busy,
+            self.stats.ring_last[0],
+            self.stats.ring_last[1]
         )
     }
 }
@@ -375,6 +413,17 @@ pub(crate) fn check_assignment(&self, k: usize) -> Result {
     pub(crate) fn expose(&self) {
         self.exposed.store(true, Ordering::Release);
     }
+    pub(crate) fn is_exposed(&self) -> bool {
+        self.exposed.load(Ordering::Acquire)
+    }
+    pub(crate) fn same_vm(&self, vm: &Arc<super::vm::VmState>) -> bool {
+        Arc::ptr_eq(&self._vm, vm)
+    }
+    /// The two words of the free-block ring, as seeded (both MAX_BLOCKS) or as the firmware
+    /// left them.
+    pub(crate) fn ring_words(&self) -> Result<[u32; 2]> {
+        Ok([self.ring.r32(0)?, self.ring.r32(4)?])
+    }
 }
 
 impl Firmware {
