@@ -2203,6 +2203,8 @@ static int dcp_m4_external_callback(struct dcp_m4_runtime *r, u32 tag, bool remo
 			WRITE_ONCE(r->dcp->ext_sink, !!connected);
 			t8132_ext_drm_hotplug(r->dcp->dev);
 		}
+		if (!connected)
+			dcp_t8132_idle_kick(r->dcp->owner);
 		return 0;
 	}
 
@@ -3826,6 +3828,8 @@ void iomfb_m4_external_link_gone(struct apple_dcp *owner)
 		WRITE_ONCE(dcp->ext_sink, false);
 		t8132_ext_drm_hotplug(dcp->dev);
 	}
+	if (dcp && dcp->external)
+		dcp_t8132_idle_kick(owner);
 }
 
 /*
@@ -4952,6 +4956,7 @@ static int dcp_m4_ext_up(struct iomfb_m4 *dcp)
 		dcp->ext_idle_wakes++;
 		dcp->ext_idle_on_us = ktime_us_delta(ktime_get(), start);
 		dcp->ext_idle_why = "up for a request";
+		dcp_t8132_idle_kick(dcp->owner);
 	}
 	return ret;
 }
