From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 07:38:59 +0000
Subject: [PATCH] drm/asahi: g16: let per-VM objects use the ASC-cached
 classes

Objects a VM's queues and slots own come from its private allocator,
which refuses every class but Fw and Shared. With g16_fw_cached=1 the
command objects ask for FwCached and SharedCached, so every render and
compute submission failed with EINVAL before anything was mapped.

The private path already maps the firmware side with the class's own
leaf, as the global path does, and keeps the client and lower aliases
non-cacheable. Accept the two cached classes there.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/object.rs | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/asahi/g16/object.rs b/drivers/gpu/drm/asahi/g16/object.rs
index b934ee75b4..6afbb1ef0d 100644
--- a/drivers/gpu/drm/asahi/g16/object.rs
+++ b/drivers/gpu/drm/asahi/g16/object.rs
@@ -401,8 +401,13 @@ fn alloc_private_in(
         req: Request,
         client_range: Option<core::ops::Range<u64>>,
     ) -> Result<Arc<FwObject>> {
+        // The firmware mapping below takes the class's own leaf, so the ASC-cached classes
+        // map exactly as on the global path; client and lower aliases keep their NC leaves.
         if !matches!(req.placement, Placement::Anywhere)
-            || !matches!(req.class, Class::Fw | Class::Shared)
+            || !matches!(
+                req.class,
+                Class::Fw | Class::FwCached | Class::Shared | Class::SharedCached
+            )
             || req.size == 0
             || req.offset >= hw::PAGE as usize
         {
