From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 10:21:01 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: enable the JPEG engines (test)

TEST-ONLY opt-in for one test boot; not for the default
kernel. Enable the JPG power state, both JPEG engines and their
DARTs on the J604.

With this commit, at boot: genpd registers ps_jpg (PMGR +0x578); the
two DARTs probe and power the JPG state on while they configure; the
apple-jpeg module autoloads from the "apple,t6041-jpeg" modalias,
powers the engine, writes MODE 0x147 and reads HWREV once per engine.
If HWREV is not 0x100008 under the mask the probe stops with
"unsupported HWREV" and no video device appears. Otherwise two
/dev/video* M2M encoders appear ("apple-jpeg"), and runtime PM gates
the JPG state again 100 ms after the last job.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi |  3 ++-
 arch/arm64/boot/dts/apple/t8132-j604.dts       | 17 +++++++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
index 7f321973da..bc83eeb670 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
@@ -452,8 +452,9 @@
 	status = "disabled";
 };
 
+/* The JPEG engines and their DARTs (ADT /arm-io/jpeg0/1, dart-jpeg0/1). */
 &ps_jpg {
-	status = "disabled";
+	status = "okay";
 };
 
 /* The video decoder and its DART (ADT /arm-io/avd, dart-avd). */
diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 638a4f5e2e..814ce9a8a8 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -731,6 +731,23 @@
 	/delete-property/ power-domains;
 };
 
+/* ADT /arm-io/jpeg0, jpeg1 and /arm-io/dart-jpeg0, dart-jpeg1 (test opt-in) */
+&jpeg0_dart {
+	status = "okay";
+};
+
+&jpeg0 {
+	status = "okay";
+};
+
+&jpeg1_dart {
+	status = "okay";
+};
+
+&jpeg1 {
+	status = "okay";
+};
+
 #include "t8132-j604-gpu.dtsi"
 
 /*
