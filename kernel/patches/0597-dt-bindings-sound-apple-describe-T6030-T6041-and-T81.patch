From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 06:12:51 +0000
Subject: [PATCH] dt-bindings: sound: apple: describe T6030, T6041 and T8132
 DisplayPort audio

The DisplayPort audio interface of an external display processor has no
application-processor registers: samples arrive through SIO, and the graph
connects it to port 0 of the display processor that owns the audio service.
Describe it for the T6030 and T6041, as upstream does, and for the T8132,
whose interfaces stay disabled with its SIO until the SIO's firmware tables
have loader support.

(backported from commit 2cb8fd897879814d97d634eeaa1f2b8ec255c25b)
[j604: the file as on aurora integration-aurora (this tree has no earlier
 version of it), plus apple,t8132-dpaudio for the J604 HDMI port's DPA1.
 H3-D4 of ports-3 round 2.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 .../bindings/sound/apple,t6030-dpaudio.yaml   | 68 +++++++++++++++++++
 1 file changed, 68 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/apple,t6030-dpaudio.yaml

diff --git a/Documentation/devicetree/bindings/sound/apple,t6030-dpaudio.yaml b/Documentation/devicetree/bindings/sound/apple,t6030-dpaudio.yaml
new file mode 100644
index 0000000000..cb47867220
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/apple,t6030-dpaudio.yaml
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/apple,t6030-dpaudio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple T6030, T6041 and T8132 DisplayPort audio
+
+maintainers:
+  - Ryan Murray <ryan@aurorasilicon.org>
+
+description: |
+  The external display processor provides a DisplayPort/HDMI audio service.
+  Its DisplayPort audio interface has no application-processor registers.
+  Samples arrive through SIO, and the graph connects this interface to
+  port 0 of the display processor that owns the audio service.
+
+  T6041 interfaces remain disabled until a generation-specific SIO firmware
+  backend and loader handoff are available and display audio is qualified.
+  T8132 interfaces remain disabled with the T8132 SIO, until its firmware
+  tables have loader support.
+
+select:
+  properties:
+    compatible:
+      contains:
+        enum:
+          - apple,t6030-dpaudio
+          - apple,t6041-dpaudio
+          - apple,t8132-dpaudio
+  required:
+    - compatible
+
+properties:
+  compatible:
+    items:
+      - enum:
+          - apple,t6030-dpaudio
+          - apple,t6041-dpaudio
+          - apple,t8132-dpaudio
+      - const: apple,dpaudio
+
+  dmas:
+    maxItems: 1
+
+  dma-names:
+    const: tx
+
+  power-domains:
+    maxItems: 1
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Connection to the display processor's audio service.
+    required:
+      - port@0
+
+required:
+  - compatible
+  - dmas
+  - dma-names
+  - power-domains
+  - ports
+
+additionalProperties: false
