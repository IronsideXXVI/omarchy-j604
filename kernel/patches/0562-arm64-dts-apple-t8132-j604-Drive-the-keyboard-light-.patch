From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 09:11:59 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: Drive the keyboard
 light on macOS's scale

macOS drives this keyboard backlight at 25 kHz with its levels
0.0625 / 0.25 / 0.5 / 0.75 / 1.0 at 69 / 123 / 194 / 265 / 336 of 960
cycles: on = 52 + 284 * level. Its top level is 35 % duty. Linux drove
max-brightness at 100 %, about 2.9 times macOS's top, and the bottom
fifth of its scale under the duty cycle where macOS's line starts.

Label the keyboard LED in t8132-laptop.dtsi and give the J604 the
duty cycle range 542..3500 basis points, so brightness 0..255 follows
macOS's line and 255 is macOS's top level.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
(cherry picked from commit d15652b2237e8eb37f6f192d1b13dbef864dfc6a)
---
 arch/arm64/boot/dts/apple/t8132-j604.dts    | 10 ++++++++++
 arch/arm64/boot/dts/apple/t8132-laptop.dtsi |  2 +-
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 7095c2c765..7f006cd97e 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -450,3 +450,13 @@ &sleep {
 	apple,ps-keep-on = <0x118 0x2f8 0x310 0x318 0x320 0x348 0x358 0x368>;
 	status = "okay";
 };
+
+/*
+ * Keyboard backlight on macOS's scale: its levels 0.0625..1.0 drive
+ * 69..336 of 960 PWM cycles, on = 52 + 284 * level, so the top level is
+ * 35 % duty and the line starts at 5.42 %.
+ */
+&kbd_led {
+	min-duty-cycle-bp = <542>;
+	max-duty-cycle-bp = <3500>;
+};
diff --git a/arch/arm64/boot/dts/apple/t8132-laptop.dtsi b/arch/arm64/boot/dts/apple/t8132-laptop.dtsi
index c6a1a5ee78..0e33ff67f6 100644
--- a/arch/arm64/boot/dts/apple/t8132-laptop.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-laptop.dtsi
@@ -60,7 +60,7 @@ codec {
 	led-controller {
 		compatible = "pwm-leds";
 
-		led-0 {
+		kbd_led: led-0 {
 			pwms = <&fpwm1 0 40000>;
 			label = "kbd_backlight";
 			function = LED_FUNCTION_KBD_BACKLIGHT;
-- 
2.43.0

