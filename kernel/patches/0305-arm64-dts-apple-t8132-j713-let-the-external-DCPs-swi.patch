From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Tue, 10 Nov 2026 00:00:20 -0500
Subject: [PATCH] arm64: dts: apple: t8132-j713: let the external DCPs
 switch their domains

A deep sleep powers the external display coprocessors off, and they
have to be stopped first and started again afterwards. Mark the CPU,
front-end and system domains of both as consumer-switched, with the
CPU domains' power-gate retention words and the system domains' bridge
links, so the coprocessor's driver can power the chain off after it has
stopped the firmware and on again before it restarts it.

The bridge links name the external DCP whose block they are in, so they
live in the board file; the PMGR file is also built into the platform
data, which has no DCP nodes.

The domains stay firmware-owned otherwise: nothing changes at runtime.

This builds on work by Bartosz Nitka.

Signed-off-by: Erik Bourget <erik@ebourget.net>
[niteria: credit moved from Based-on-work-by into the text]
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 3ba2ee373f3af9166166aedf06688659bbb6d532)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j713-pmgr.dtsi | 12 ++++++++++++
 arch/arm64/boot/dts/apple/t8132-j713.dts       | 13 +++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713-pmgr.dtsi b/arch/arm64/boot/dts/apple/t8132-j713-pmgr.dtsi
index 75a9273e6e..c8657d83a0 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j713-pmgr.dtsi
@@ -84,16 +84,22 @@
 
 &ps_dispext0_sys {
 	apple,firmware-owned;
+	/* Its coprocessor powers these three off around a deep sleep (bridge link: board DT). */
+	apple,consumer-switched;
 	status = "okay";
 };
 
 &ps_dispext0_fe {
 	apple,firmware-owned;
+	apple,consumer-switched;
 	status = "okay";
 };
 
 &ps_dispext0_cpu {
 	apple,firmware-owned;
+	apple,consumer-switched;
+	/* Power-gate retention workaround, as macOS sets it while off. */
+	apple,retention-workaround = <0x256cc 0x3 0x3>, <0x256f0 0x3 0x0>;
 	status = "okay";
 };
 
@@ -386,16 +392,22 @@
 
 &ps_dispext1_sys {
 	apple,firmware-owned;
+	/* Its coprocessor powers these three off around a deep sleep (bridge link: board DT). */
+	apple,consumer-switched;
 	status = "okay";
 };
 
 &ps_dispext1_fe {
 	apple,firmware-owned;
+	apple,consumer-switched;
 	status = "okay";
 };
 
 &ps_dispext1_cpu {
 	apple,firmware-owned;
+	apple,consumer-switched;
+	/* Power-gate retention workaround, as macOS sets it while off. */
+	apple,retention-workaround = <0x25b4c 0x3 0x3>, <0x25b70 0x3 0x0>;
 	status = "okay";
 };
 
diff --git a/arch/arm64/boot/dts/apple/t8132-j713.dts b/arch/arm64/boot/dts/apple/t8132-j713.dts
index 3758e4a442..3c217debd1 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j713.dts
@@ -167,6 +167,19 @@
 	apple,pmc-interface = <&pmc_disp0>;
 };
 
+/*
+ * The external display system domains have a bus bridge in front of their
+ * block: its link words are 0x800104 past the start of the block's disp-3
+ * registers (reg 4 of the external DCP).
+ */
+&ps_dispext0_sys {
+	apple,bridge-link = <&dcpext0 4 0x800104>;
+};
+
+&ps_dispext1_sys {
+	apple,bridge-link = <&dcpext1 4 0x800104>;
+};
+
 /* Native radio recovery is required before admitting system sleep. */
 &pcie0 {
 	status = "okay";
-- 
2.43.0

