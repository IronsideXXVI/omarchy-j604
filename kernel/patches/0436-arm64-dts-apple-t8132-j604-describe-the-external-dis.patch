From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 09:42:29 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: describe the external display
 coprocessors

Describe the J604's two external display coprocessors, dcpext0 and
dcpext1, with their mailboxes, firmware DARTs, display DARTs and the PMC
bandwidth slots, in the form of t8132-j713-dcpext.dtsi. They are the same
T8132 blocks: every address, interrupt and segment name was checked
against the J604 Apple device tree (25G83 runtime tree, 32 of 32 values
equal to the J713's).

Each dcpext gets a disabled DisplayPort tunnel route to each of the three
USB-C ports (ATC0, ATC1 and ATC3; the J604 device tree gives ATC3 the
crossbar endpoint 3 and the same DP PHY / DP IN0 / DP IN1 cells), and the
three Type-C connectors get the matching port@3 endpoints.

The J604 boots with a single device tree that the boot loader completes,
as for its internal display (t8132-j604-display.dtsi), so every node here
is disabled ("enabled by the loader"), and the ATC display crossbars stay
disabled. Without a boot loader handoff nothing new probes: the routes'
remote endpoints are unavailable to the Type-C mux lookup, and the
external display DARTs are adopted only for a dcpext marked
apple,t8132-dcpext-firmware-ready.

The HDMI port (ATC2's DisplayPort-only PHY behind an on-board
DP-to-HDMI converter) is not described: the T8132 external display path
drives DisplayPort tunnels only.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 .../boot/dts/apple/t8132-j604-dcpext.dtsi     | 369 ++++++++++++++++++
 arch/arm64/boot/dts/apple/t8132-j604.dts      |   7 +
 2 files changed, 376 insertions(+)
 create mode 100644 arch/arm64/boot/dts/apple/t8132-j604-dcpext.dtsi

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-dcpext.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-dcpext.dtsi
new file mode 100644
index 0000000000..d4d14b4e1d
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8132-j604-dcpext.dtsi
@@ -0,0 +1,369 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Apple MacBook Pro (14-inch, M4) external display coprocessors (DCP-ext).
+ *
+ * Same SoC blocks as t8132-j713-dcpext.dtsi: T8132 has two external display
+ * pipes, dispext0 and dispext1, each with its own DCP, mailbox, DCP DART and
+ * display DART. Every address, interrupt and segment name below was checked
+ * against the J604 Apple device tree (25G83 runtime tree: dcpext0/1,
+ * dart-dcpext0/1, dart-dispext0/1, dispext0/1, atc0..3-dpxbar; 32 of 32
+ * values equal); they are the J713's.
+ *
+ * The J604 boots with one device tree: the boot loader completes this one,
+ * as it does the internal display (t8132-j604-display.dtsi). Every node here
+ * is therefore disabled. When the boot loader hands an external DCP over
+ * (opt-in, and only after the internal display was handed over), it
+ * reserves the firmware memory, publishes the firmware identity, marks the
+ * dcpext apple,t8132-dcpext-firmware-ready and enables the dcpext with its
+ * mailbox and DARTs. Without that handoff nothing here probes.
+ *
+ * Streams: SID23 for the firmware, SID0 scanout and SID16 PIODMA, as on
+ * the internal display.
+ *
+ * The ATC display crossbars these routes select (atc0/1/3_dpxbar) stay
+ * disabled too until the external display driver is enabled with them.
+ *
+ * The J604's HDMI port (port-hdmi-1: ATC2's DisplayPort-only PHY, its
+ * display crossbar and an on-board DP-to-HDMI converter) is not described
+ * here: the T8132 external display path drives DisplayPort tunnels only.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+/ {
+	aliases {
+		dcpext0 = &dcpext0;
+		dcpext1 = &dcpext1;
+	};
+};
+
+&soc {
+	dcpext0_mbox: mailbox@286e08000 {
+		compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x2 0x86e08000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 731 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 732 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 733 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 734 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		power-domains = <&ps_dispext0_cpu>;
+		#mbox-cells = <0>;
+		status = "disabled"; /* Enabled by the loader. */
+	};
+
+	dcpext0_dart: iommu@286340000 {
+		compatible = "apple,t8132-dart", "apple,t8110-dart";
+		reg = <0x2 0x86340000 0x0 0x20000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 750 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		apple,dma-range = <0x100 0x0 0x10 0x0>;
+		power-domains = <&ps_dispext0_cpu>;
+		status = "disabled"; /* Enabled by the loader. */
+	};
+
+	dispext0_dart: iommu@286300000 {
+		compatible = "apple,t8132-dart", "apple,t8110-dart";
+		reg = <0x2 0x86300000 0x0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 750 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		apple,dma-range = <0x100 0x0 0x10 0x0>;
+		power-domains = <&ps_dispext0_cpu>;
+		status = "disabled"; /* Enabled by the loader. */
+	};
+
+	dcpext0: dcp@286e00000 {
+		compatible = "apple,t8132-dcpext";
+		reg = <0x2 0x86e00000 0x0 0x4000>,
+		      <0x2 0x84000000 0x0 0xc20000>,
+		      <0x2 0x86240000 0x0 0x10000>,
+		      <0x2 0x863a8000 0x0 0x4000>,
+		      <0x2 0x86800000 0x0 0x800000>,
+		      <0x3 0x82800000 0x0 0xbc000>,
+		      <0x2 0x86850000 0x0 0x4000>;
+		reg-names = "coproc", "disp-0", "disp-1", "disp-2", "disp-3",
+			    "disp-4", "iop-vbar";
+		mboxes = <&dcpext0_mbox>;
+		mbox-names = "mbox";
+		iommus = <&dcpext0_dart 23>;
+		power-domains = <&ps_dispext0_cpu>;
+		dma-noncoherent;
+		apple,dcp-index = <1>;
+		apple,bw-scratch = <&pmgr_dcpext 0 4 0>;
+		#address-cells = <2>;
+		#size-cells = <2>;
+		status = "disabled"; /* Enabled by the loader. */
+
+		dcpext0_piodma: piodma {
+			iommus = <&dispext0_dart 16>;
+			dma-noncoherent;
+			status = "disabled";
+		};
+	};
+
+	/*
+	 * The external pipes' realtime bandwidth request slots in the PMC,
+	 * 0x2c000 and 0x30000 into the window the dcpexts have as disp-4.
+	 */
+	pmgr_dcpext: power-management@38282c000 {
+		reg = <0x3 0x8282c000 0x0 0x8>,
+		      <0x3 0x82830000 0x0 0x8>;
+		reg-names = "dcpext0-bw-scratch", "dcpext1-bw-scratch";
+		#apple,bw-scratch-cells = <3>;
+	};
+
+	dcpext1_mbox: mailbox@48ae08000 {
+		compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x4 0x8ae08000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 803 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 804 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 805 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 806 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		power-domains = <&ps_dispext1_cpu>;
+		#mbox-cells = <0>;
+		status = "disabled"; /* Enabled by the loader. */
+	};
+
+	dcpext1_dart: iommu@48a340000 {
+		compatible = "apple,t8132-dart", "apple,t8110-dart";
+		reg = <0x4 0x8a340000 0x0 0x20000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 824 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		apple,dma-range = <0x100 0x0 0x10 0x0>;
+		power-domains = <&ps_dispext1_cpu>;
+		status = "disabled"; /* Enabled by the loader. */
+	};
+
+	dispext1_dart: iommu@48a300000 {
+		compatible = "apple,t8132-dart", "apple,t8110-dart";
+		reg = <0x4 0x8a300000 0x0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 824 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		apple,dma-range = <0x100 0x0 0x10 0x0>;
+		power-domains = <&ps_dispext1_cpu>;
+		status = "disabled"; /* Enabled by the loader. */
+	};
+
+	dcpext1: dcp@48ae00000 {
+		compatible = "apple,t8132-dcpext";
+		reg = <0x4 0x8ae00000 0x0 0x4000>,
+		      <0x4 0x88000000 0x0 0xc20000>,
+		      <0x4 0x8a240000 0x0 0x10000>,
+		      <0x4 0x8a3a8000 0x0 0x4000>,
+		      <0x4 0x8a800000 0x0 0x800000>,
+		      <0x3 0x82800000 0x0 0xbc000>,
+		      <0x4 0x8a850000 0x0 0x4000>;
+		reg-names = "coproc", "disp-0", "disp-1", "disp-2", "disp-3",
+			    "disp-4", "iop-vbar";
+		mboxes = <&dcpext1_mbox>;
+		mbox-names = "mbox";
+		iommus = <&dcpext1_dart 23>;
+		power-domains = <&ps_dispext1_cpu>;
+		dma-noncoherent;
+		apple,dcp-index = <2>;
+		apple,bw-scratch = <&pmgr_dcpext 1 4 0>;
+		#address-cells = <2>;
+		#size-cells = <2>;
+		status = "disabled"; /* Enabled by the loader. */
+
+		dcpext1_piodma: piodma {
+			iommus = <&dispext1_dart 16>;
+			dma-noncoherent;
+			status = "disabled";
+		};
+	};
+};
+
+/*
+ * dcpext0's Type-C routes: the three USB-C ports (ATC0, ATC1, ATC3), UFP
+ * mux selector 2 on each ATC crossbar (cells 0/1/2: DP PHY, DP IN0, DP IN1;
+ * the J604 device tree names the same cells as dp-switch-dfp-port 0/1/2 and
+ * the ATC as dp-switch-dfp-endpoint 0/1/3). As on the J713 the routes are
+ * for DisplayPort tunnels and stay disabled; they are enabled only for a
+ * dcpext the boot loader handed over, since a USB-C port controller waits
+ * for every available route. Route N uses the names typecN.
+ */
+&dcpext0 {
+	apple,connector-type = "USB-C";
+	phys = <&atcphy0 PHY_TYPE_DP>, <&atcphy1 PHY_TYPE_DP>,
+	       <&atcphy3 PHY_TYPE_DP>;
+	phy-names = "typec0", "typec1", "typec2";
+	mux-controls = <&atc0_dpxbar 0>, <&atc1_dpxbar 0>, <&atc3_dpxbar 0>,
+		       <&atc0_dpxbar 1>, <&atc0_dpxbar 2>,
+		       <&atc1_dpxbar 1>, <&atc1_dpxbar 2>,
+		       <&atc3_dpxbar 1>, <&atc3_dpxbar 2>;
+	mux-control-names = "typec0", "typec1", "typec2",
+			    "typec0-dpin0", "typec0-dpin1",
+			    "typec1-dpin0", "typec1-dpin1",
+			    "typec2-dpin0", "typec2-dpin1";
+	apple,typec-mux-indices = <2 2 2>;
+	apple,typec-dptx-phys = <0 1 3>;
+
+	typec-routes {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		route@0 {
+			reg = <0>;
+			mode-switch;
+			status = "disabled";
+
+			port {
+				dcpext0_typec0: endpoint {
+					remote-endpoint = <&typec0_dcpext0>;
+				};
+			};
+		};
+
+		route@1 {
+			reg = <1>;
+			mode-switch;
+			status = "disabled";
+
+			port {
+				dcpext0_typec1: endpoint {
+					remote-endpoint = <&typec1_dcpext0>;
+				};
+			};
+		};
+
+		route@2 {
+			reg = <2>;
+			mode-switch;
+			status = "disabled";
+
+			port {
+				dcpext0_typec3: endpoint {
+					remote-endpoint = <&typec3_dcpext0>;
+				};
+			};
+		};
+	};
+};
+
+/* dcpext1's Type-C routes, UFP mux selector 4, as for dcpext0. */
+&dcpext1 {
+	apple,connector-type = "USB-C";
+	phys = <&atcphy0 PHY_TYPE_DP>, <&atcphy1 PHY_TYPE_DP>,
+	       <&atcphy3 PHY_TYPE_DP>;
+	phy-names = "typec0", "typec1", "typec2";
+	mux-controls = <&atc0_dpxbar 0>, <&atc1_dpxbar 0>, <&atc3_dpxbar 0>,
+		       <&atc0_dpxbar 1>, <&atc0_dpxbar 2>,
+		       <&atc1_dpxbar 1>, <&atc1_dpxbar 2>,
+		       <&atc3_dpxbar 1>, <&atc3_dpxbar 2>;
+	mux-control-names = "typec0", "typec1", "typec2",
+			    "typec0-dpin0", "typec0-dpin1",
+			    "typec1-dpin0", "typec1-dpin1",
+			    "typec2-dpin0", "typec2-dpin1";
+	apple,typec-mux-indices = <4 4 4>;
+	apple,typec-dptx-phys = <0 1 3>;
+
+	typec-routes {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		route@0 {
+			reg = <0>;
+			mode-switch;
+			status = "disabled";
+
+			port {
+				dcpext1_typec0: endpoint {
+					remote-endpoint = <&typec0_dcpext1>;
+				};
+			};
+		};
+
+		route@1 {
+			reg = <1>;
+			mode-switch;
+			status = "disabled";
+
+			port {
+				dcpext1_typec1: endpoint {
+					remote-endpoint = <&typec1_dcpext1>;
+				};
+			};
+		};
+
+		route@2 {
+			reg = <2>;
+			mode-switch;
+			status = "disabled";
+
+			port {
+				dcpext1_typec3: endpoint {
+					remote-endpoint = <&typec3_dcpext1>;
+				};
+			};
+		};
+	};
+};
+
+&typec0 {
+	ports {
+		port@3 {
+			reg = <3>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			typec0_dcpext0: endpoint@0 {
+				reg = <0>;
+				remote-endpoint = <&dcpext0_typec0>;
+			};
+
+			typec0_dcpext1: endpoint@1 {
+				reg = <1>;
+				remote-endpoint = <&dcpext1_typec0>;
+			};
+		};
+	};
+};
+
+&typec1 {
+	ports {
+		port@3 {
+			reg = <3>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			typec1_dcpext0: endpoint@0 {
+				reg = <0>;
+				remote-endpoint = <&dcpext0_typec1>;
+			};
+
+			typec1_dcpext1: endpoint@1 {
+				reg = <1>;
+				remote-endpoint = <&dcpext1_typec1>;
+			};
+		};
+	};
+};
+
+&typec3 {
+	ports {
+		port@3 {
+			reg = <3>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			typec3_dcpext0: endpoint@0 {
+				reg = <0>;
+				remote-endpoint = <&dcpext0_typec3>;
+			};
+
+			typec3_dcpext1: endpoint@1 {
+				reg = <1>;
+				remote-endpoint = <&dcpext1_typec3>;
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 4e5a14ea9a..6d6a90c1ba 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -984,3 +984,10 @@
  * their calibration from this Mac's ADT (see t8132-j604-usb4.dtsi).
  */
 #include "t8132-j604-usb4.dtsi"
+
+/*
+ * External display coprocessors and their USB-C DisplayPort tunnel routes,
+ * all disabled until the boot loader hands a dcpext over (see
+ * t8132-j604-dcpext.dtsi).
+ */
+#include "t8132-j604-dcpext.dtsi"
