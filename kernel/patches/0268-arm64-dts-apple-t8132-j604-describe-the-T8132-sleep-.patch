From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 23:24:12 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: describe the T8132
 sleep sequence's windows

Give the J604's suspend-to-RAM node the register windows of the T8132
sequence and the six AP wake sources macOS enables. They are used only with
apple_s2r.t8132_sequence, which is off by default.

Each window lies inside the J604 ADT entry named next to it; the 26B123 and
25G83 ADTs agree:
 - commit, pmgr reg[40]
 - ps, pmgr reg[32]
 - ps-aon, pmgr reg[1]
 - pwrgate, reg[34]
 - cluster, reg[36]
 - aon-misc, reg[38]
 - wake, reg[4]
 - spmi, nub-spmi0 reg[0]
 - spmi-a0, nub-spmi-a0 reg[0]
 - pmc-voters, pmgr reg[48]
 - dcs, clk-mux and clk-perf, pmgr reg[2]
 - amcc0/1 and mcc0/1, mcc reg[7]

The windows themselves are those of Aurora's J713 t8132.dtsi
(aurora-silicon/linux#1314).

The wake source ids are the J604 ADT's numbers for NUB.SPMI0.SW3,
ATC0.USBWakeup, SMC.CPUWakeupAP, SMC.OutboxNotEmpty,
MTP.DOCK.CHANNELS.AP0.IRQ and MTP.OutboxNotEmpty. They are matched by name
and are the same as the J713's.

The node now has a unit address, from its first window.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 35 ++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index d75d1b9a9e..f9e3396078 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -54,12 +54,45 @@
 /* ---- generated delta (1.617 J604 DT vs Aurora 7.3 + the lines above) ---- */
 
 / {
-	pmgr_s2r: power-management-s2r {
+	/*
+	 * The T8132 sleep sequence's windows (Aurora's t8132.dtsi in
+	 * aurora-silicon/linux#1314), used only with apple_s2r.t8132_sequence.
+	 * Each lies inside the J604 ADT entry named; 26B123 and 25G83 agree.
+	 */
+	pmgr_s2r: power-management@3882d4000 {
 		compatible = "apple,t8132-pmgr-s2r";
+		reg = <0x3 0x882d4000 0x0 0x4>,		/* pmgr reg[40] */
+		      <0x3 0x80700000 0x0 0x18000>,	/* pmgr reg[32] */
+		      <0x3 0x88280000 0x0 0x10000>,	/* pmgr reg[1] */
+		      <0x3 0x80724000 0x0 0x2000>,	/* pmgr reg[34] */
+		      <0x3 0x80780000 0x0 0x8>,		/* pmgr reg[36] */
+		      <0x3 0x882b8000 0x0 0x44>,	/* pmgr reg[38] */
+		      <0x3 0x88004000 0x0 0x48>,	/* pmgr reg[4] */
+		      <0x3 0x88714000 0x0 0x84>,	/* nub-spmi0 reg[0] */
+		      <0x3 0x88908040 0x0 0x4>,		/* nub-spmi-a0 reg[0] */
+		      <0x3 0x82800000 0x0 0x10000>,	/* pmgr reg[48] */
+		      <0x3 0x8005c000 0x0 0x4>,		/* pmgr reg[2] */
+		      <0x3 0x80040040 0x0 0x18>,	/* pmgr reg[2] */
+		      <0x3 0x80058000 0x0 0x10004>,	/* pmgr reg[2] */
+		      <0x2 0x20024000 0x0 0x1000>,	/* mcc reg[7] */
+		      <0x2 0x20064000 0x0 0x1000>,	/* mcc reg[7] */
+		      <0x2 0x20400580 0x0 0x10>,	/* mcc reg[7] */
+		      <0x2 0x20800580 0x0 0x10>;	/* mcc reg[7] */
+		reg-names = "commit", "ps", "ps-aon", "pwrgate", "cluster",
+			    "aon-misc", "wake", "spmi", "spmi-a0", "pmc-voters",
+			    "dcs", "clk-mux", "clk-perf", "amcc0", "amcc1",
+			    "mcc0", "mcc1";
 		apple,pmgr = <&pmgr>;
 		apple,cpu-clusters = <0x00 0x01>;
 		apple,sep-domain = <&ps_sep>;
 		apple,watchdog = <&wdt>;
+		/*
+		 * From the J604 ADT's /arm-io/pmgr ap-wake-sources (25G83 and
+		 * 26B123 agree): NUB.SPMI0.SW3, ATC0.USBWakeup, SMC.CPUWakeupAP,
+		 * SMC.OutboxNotEmpty, MTP.DOCK.CHANNELS.AP0.IRQ and
+		 * MTP.OutboxNotEmpty, the ones macOS enables.
+		 */
+		apple,wake-enable = <145 69 161 183 85 104>;
 		status = "okay";
 	};
 	dpaudio1: audio-controller-1 {
