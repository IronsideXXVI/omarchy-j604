From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 04:03:50 +0000
Subject: [PATCH] cpufreq: apple-soc: show the cluster's DVFS command
 and status words

On T8132 the reported frequency is the requested P-state: the status
word's current-state field is not established for this SoC. A single
busy thread on a J604 P core runs at 3.93-3.99 GHz by its cycle counter
while scaling_cur_freq reports the requested 4.464 GHz, so what the
cluster delivers is not visible anywhere.

Add a read-only per-policy dvfs_registers attribute with the command
word, the P-state it requests and the raw status word. That lets the
status layout be established on the machine against known requests
before any field of it is used for the reported frequency.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/cpufreq/apple-soc-cpufreq.c | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/drivers/cpufreq/apple-soc-cpufreq.c b/drivers/cpufreq/apple-soc-cpufreq.c
index 0603a40d86..83f8b8233a 100644
--- a/drivers/cpufreq/apple-soc-cpufreq.c
+++ b/drivers/cpufreq/apple-soc-cpufreq.c
@@ -1590,6 +1590,34 @@ static int apple_soc_cpufreq_offline(struct cpufreq_policy *policy)
 	return 0;
 }
 
+/*
+ * The cluster's DVFS command and status words as read now, for SoCs whose
+ * status layout is not established (cur_pstate_mask unset): what the cluster
+ * runs at can then be compared with what was requested, without a guess
+ * about the layout reaching the reported frequency.
+ */
+static ssize_t show_dvfs_registers(struct cpufreq_policy *policy, char *buf)
+{
+	struct apple_cpu_priv *priv = policy->driver_data;
+	u64 cmd;
+	u32 status;
+
+	if (!priv)
+		return -ENODEV;
+	cmd = readq_relaxed(priv->reg_base + APPLE_DVFS_CMD);
+	status = readl_relaxed(priv->reg_base + APPLE_DVFS_STATUS);
+	return sysfs_emit(buf, "cmd %#018llx requested %llu status %#010x\n",
+			  cmd, (cmd & priv->info->ps1_mask) >> priv->info->ps1_shift,
+			  status);
+}
+
+cpufreq_freq_attr_ro(dvfs_registers);
+
+static struct freq_attr *apple_soc_cpufreq_attr[] = {
+	&dvfs_registers,
+	NULL,
+};
+
 static struct cpufreq_driver apple_soc_cpufreq_driver = {
 	.name		= "apple-cpufreq",
 	.flags		= CPUFREQ_HAVE_GOVERNOR_PER_POLICY |
@@ -1602,6 +1630,7 @@ static struct cpufreq_driver apple_soc_cpufreq_driver = {
 	.fast_switch	= apple_soc_cpufreq_fast_switch,
 	.register_em	= cpufreq_register_em_with_opp,
 	.set_boost	= cpufreq_boost_set_sw,
+	.attr		= apple_soc_cpufreq_attr,
 	.suspend	= apple_soc_cpufreq_suspend,
 	.resume		= apple_soc_cpufreq_resume,
 };
