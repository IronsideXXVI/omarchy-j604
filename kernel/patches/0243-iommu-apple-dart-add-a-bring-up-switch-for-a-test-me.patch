From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 08:06:46 +0000
Subject: [PATCH] iommu/apple-dart: add a bring-up switch for a test
 mem sleep that is not firmware-driven

A DART that keeps display, radio or borrowed DMA running in place refuses
any sleep but suspend-to-idle. With apple_s2r.debug_begin_as_idle a
pm_test suspend-to-RAM is not declared firmware-driven, and the display
DART then refuses it before the devices stage completes (-EBUSY from
48a300000 on the J604), so that run cannot locate the reset that follows
a suspend-to-RAM.

Add apple_dart.debug_allow_mem, default off: such a sleep, and only one
that is not firmware-driven, keeps these DARTs in place as for
suspend-to-idle. A firmware-driven sleep is not affected, and its ->enter
refuses the test sleep anyway.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/iommu/apple-dart.c | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 607d01acc8..a10955ed50 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -5623,6 +5623,22 @@ void apple_dart_sleep_restore(struct device *dev)
 }
 EXPORT_SYMBOL_GPL(apple_dart_sleep_restore);
 
+/*
+ * Bring-up: a test suspend-to-RAM that is not declared firmware-driven
+ * (apple_s2r.debug_begin_as_idle, pm_test only; its ->enter refuses) keeps
+ * the DMA of these DARTs in place as for suspend-to-idle instead of refusing
+ * it. A firmware-driven sleep is not affected. Default off: nothing changes.
+ */
+static bool debug_allow_mem;
+module_param(debug_allow_mem, bool, 0644);
+MODULE_PARM_DESC(debug_allow_mem, "Bring-up: let a suspend-to-RAM that is not firmware-driven (apple_s2r.debug_begin_as_idle) pass as for suspend-to-idle (default: off)");
+
+static bool apple_dart_sleep_as_idle(void)
+{
+	return pm_suspend_target_state == PM_SUSPEND_TO_IDLE ||
+	       (READ_ONCE(debug_allow_mem) && !pm_suspend_via_firmware());
+}
+
 static __maybe_unused int apple_dart_suspend(struct device *dev)
 {
 	struct apple_dart *dart = dev_get_drvdata(dev);
@@ -5646,7 +5662,7 @@ static __maybe_unused int apple_dart_suspend(struct device *dev)
 	 * again.
 	 */
 	if (dart->dispext) {
-		if (pm_suspend_target_state != PM_SUSPEND_TO_IDLE &&
+		if (!apple_dart_sleep_as_idle() &&
 		    !apple_dart_dispext_dcp_down(dart))
 			return -EBUSY;
 		if (apple_dart_has_borrowed(dart))
@@ -5660,7 +5676,7 @@ static __maybe_unused int apple_dart_suspend(struct device *dev)
 	 * registers are saved only for resume to check.
 	 */
 	if (dart->managed_sids || dart->preserve_display || apple_dart_has_borrowed(dart)) {
-		if (pm_suspend_target_state != PM_SUSPEND_TO_IDLE)
+		if (!apple_dart_sleep_as_idle())
 			return -EBUSY;
 		apple_dart_save_state(dart);
 		dart->s2idle_kept = true;
