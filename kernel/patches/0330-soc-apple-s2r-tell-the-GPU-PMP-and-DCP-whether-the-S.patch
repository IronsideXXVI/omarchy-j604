From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 20:59:35 +0000
Subject: [PATCH] soc: apple: s2r: tell the GPU, PMP and DCP whether
 the SoC really slept

A T8132 split step from depth 2 declares the resume firmware-driven,
because ATC0 and, at depth 7, ANS do lose power there. The GPU, the PMP
and DCP read that flag as "my power was cut" and restart firmware that
never stopped: an RTKit warm restart that waits for a HELLO a running
firmware never sends, in the PM complete phase.

Add apple_sleep_powered_down(): true only once a T8132 wake has come
back through the resume stub, and the firmware-driven resume flag
without the T8132 sequence, as before. The GPU's sleep completion (G16
and G17), the PMP's resume and DCP's resume use it instead. ATC0's
drivers, the DARTs and pmgr keep the flag, which is true for ATC0.

Their line for a sleep aborted before the commit said "sleep refused
... firmware never stopped", which reads as a fault on the designed
path. It now reads "sleep aborted before the commit: ... firmware kept
running", at info level as before.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/dcp.c        |  4 +++-
 drivers/gpu/drm/asahi/g16/sleep.rs |  8 +++++---
 drivers/gpu/drm/asahi/g17/sleep.c  |  6 ++++++
 drivers/gpu/drm/asahi/g17/sleep.h  |  1 +
 drivers/gpu/drm/asahi/g17/sleep.rs |  8 +++++---
 drivers/soc/apple/apple-s2r.c      | 13 +++++++++++++
 drivers/soc/apple/pmp-export.c     |  7 ++++---
 include/linux/soc/apple/sleep.h    |  6 ++++++
 tools/asahi/display26-tests.py     |  3 ++-
 9 files changed, 45 insertions(+), 11 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 34a2f084f6..5e3d077741 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -32,6 +32,7 @@
 #include <linux/random.h>
 #include <linux/slab.h>
 #include <linux/soc/apple/rtkit.h>
+#include <linux/soc/apple/sleep.h>
 #include <linux/soc/apple/pmp-report.h>
 #include <linux/string.h>
 #include <linux/usb/typec_altmode.h>
@@ -8307,7 +8308,8 @@ static int dcp_s2r_restart(struct apple_dcp *dcp, bool real)
 
 static int dcp_s2r_resume(struct apple_dcp *dcp)
 {
-	bool real = pm_resume_via_firmware();
+	/* A T8132 split step or a refusal never takes the display's domains down. */
+	bool real = apple_sleep_powered_down();
 
 	dcp->s2r_stopped = false;
 	/* A real sleep took the domains' power. */
diff --git a/drivers/gpu/drm/asahi/g16/sleep.rs b/drivers/gpu/drm/asahi/g16/sleep.rs
index 94c65491df..9dcf8afc97 100644
--- a/drivers/gpu/drm/asahi/g16/sleep.rs
+++ b/drivers/gpu/drm/asahi/g16/sleep.rs
@@ -41,6 +41,7 @@ extern "C" {
         rtk: *mut bindings::apple_rtkit,
     ) -> *mut core::ffi::c_void;
     fn asahi_g17_commit_finish(commit: *mut core::ffi::c_void, saved: *mut u32) -> bool;
+    fn asahi_g17_powered_down() -> bool;
     fn asahi_g17_power_auto_off(dev: *mut core::ffi::c_void, saved: *mut u32) -> core::ffi::c_int;
     fn asahi_g17_power_lower(dev: *mut core::ffi::c_void) -> core::ffi::c_int;
     fn asahi_g17_power_raise(dev: *mut core::ffi::c_void, saved: u32) -> core::ffi::c_int;
@@ -297,12 +298,13 @@ impl Gpu {
         if !self.shared.sleeping.load(Ordering::Acquire) {
             return;
         }
-        // SAFETY: Reads a global flag word.
-        let real = unsafe { bindings::pm_resume_via_firmware() };
+        // A split step or a refusal powers some blocks down, never this one: only a real
+        // sleep takes the GPU's power. SAFETY: Reads the sleep driver's flag.
+        let real = unsafe { asahi_g17_powered_down() };
         if self.shared.sleep_commit_finish() == Some(false) && !real {
             dev_info!(
                 self.shared.dev.as_ref(),
-                "sleep refused before the commit: GPU firmware never stopped\n"
+                "sleep aborted before the commit: GPU firmware kept running\n"
             );
             self.shared.sleeping.store(false, Ordering::Release);
             self.shared.poll_now();
diff --git a/drivers/gpu/drm/asahi/g17/sleep.c b/drivers/gpu/drm/asahi/g17/sleep.c
index 85dfae403d..733efaf587 100644
--- a/drivers/gpu/drm/asahi/g17/sleep.c
+++ b/drivers/gpu/drm/asahi/g17/sleep.c
@@ -379,6 +379,12 @@ err:
  * After the sleep, refused or not: whether the commit stopped the GPU, and in @saved the
  * domain's word from before, if it did. Frees @c.
  */
+/* For the Rust sleep code: whether the SoC really lost power, not only some blocks. */
+bool asahi_g17_powered_down(void)
+{
+	return apple_sleep_powered_down();
+}
+
 bool asahi_g17_commit_finish(struct asahi_g17_commit *c, u32 *saved)
 {
 	bool stopped = apple_sleep_coproc_stopped(c->dev) || c->ran;
diff --git a/drivers/gpu/drm/asahi/g17/sleep.h b/drivers/gpu/drm/asahi/g17/sleep.h
index c9d35415fb..26f1c8d973 100644
--- a/drivers/gpu/drm/asahi/g17/sleep.h
+++ b/drivers/gpu/drm/asahi/g17/sleep.h
@@ -16,6 +16,7 @@ struct asahi_g17_commit *asahi_g17_commit_prepare(struct device *dev,
 						  struct apple_mbox *secondary_mbox, bool bridge);
 struct asahi_g17_commit *asahi_g16_commit_prepare(struct device *dev, struct apple_rtkit *rtk);
 bool asahi_g17_commit_finish(struct asahi_g17_commit *c, u32 *saved);
+bool asahi_g17_powered_down(void);
 int asahi_g17_power_auto_off(struct device *dev, u32 *saved);
 int asahi_g17_power_lower(struct device *dev);
 int asahi_g17_power_raise(struct device *dev, u32 saved);
diff --git a/drivers/gpu/drm/asahi/g17/sleep.rs b/drivers/gpu/drm/asahi/g17/sleep.rs
index 0db5f0a9a3..4a234073c1 100644
--- a/drivers/gpu/drm/asahi/g17/sleep.rs
+++ b/drivers/gpu/drm/asahi/g17/sleep.rs
@@ -47,6 +47,7 @@ unsafe extern "C" {
         bridge: bool,
     ) -> *mut core::ffi::c_void;
     fn asahi_g17_commit_finish(commit: *mut core::ffi::c_void, saved: *mut u32) -> bool;
+    fn asahi_g17_powered_down() -> bool;
 }
 
 /// What `.complete` does after a sleep whose stop was left to the commit.
@@ -586,13 +587,14 @@ impl super::Gpu {
         if !self.shared.sleeping() {
             return;
         }
-        // SAFETY: Reads a global flag word.
-        let real = unsafe { bindings::pm_resume_via_firmware() };
+        // Only a real sleep takes the GPU's power, not a split step or a refusal.
+        // SAFETY: Reads the sleep driver's flag.
+        let real = unsafe { asahi_g17_powered_down() };
         if let Some(stopped) = self.shared.sleep_commit_finish() {
             if after_commit(stopped, real) == AfterCommit::Running {
                 dev_info!(
                     self.shared.dev.as_ref(),
-                    "sleep refused before the commit: GPU firmware never stopped\n"
+                    "sleep aborted before the commit: GPU firmware kept running\n"
                 );
                 self.shared.sleep_cancel();
                 return;
diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index df47a0e3c3..0b30df66b7 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -988,6 +988,17 @@ bool apple_sleep_coproc_power_cycled(struct device *dev)
 }
 EXPORT_SYMBOL_GPL(apple_sleep_coproc_power_cycled);
 
+/* A T8132 wake came back through the resume stub: the SoC really powered down. */
+static bool apple_s2r_powered_down;
+
+bool apple_sleep_powered_down(void)
+{
+	if (!READ_ONCE(t8132_sequence))
+		return pm_resume_via_firmware();
+	return READ_ONCE(apple_s2r_powered_down);
+}
+EXPORT_SYMBOL_GPL(apple_sleep_powered_down);
+
 /*
  * The last refusals: interrupts are off and no other CPU is up, so the
  * registry is read without its lock, which no one can hold now.
@@ -2916,6 +2927,7 @@ static void apple_s2r_t8132_return(struct apple_s2r *s2r)
 
 	apple_cpu_power_cycled();
 	apple_s2r_coprocs_mark_cycled(false);
+	WRITE_ONCE(apple_s2r_powered_down, true);
 	s2r->pins_lost = s2r->pins_saved_valid;
 
 	for (i = 0; i < T8132_WAKE_WORDS; i++)
@@ -3643,6 +3655,7 @@ static int apple_s2r_begin(suspend_state_t state)
 		return 0;
 	if (READ_ONCE(debug_begin_as_idle))
 		return 0;
+	WRITE_ONCE(apple_s2r_powered_down, false);
 	if (apple_s2r) {
 		if (apple_s2r->wdt) {
 			apple_s2r->wdt_begin_ctl = readl_relaxed(apple_s2r->wdt + WDT_CTL);
diff --git a/drivers/soc/apple/pmp-export.c b/drivers/soc/apple/pmp-export.c
index 577aace748..92f52cc2cb 100644
--- a/drivers/soc/apple/pmp-export.c
+++ b/drivers/soc/apple/pmp-export.c
@@ -246,16 +246,17 @@ static int apple_pmp_resume_early(struct device *dev)
 
 		pmp_commit_used = false;
 		apple_sleep_coproc_set_ready(dev, false);
-		if (!pm_resume_via_firmware() && !stopped) {
+		/* A split step or a refusal never takes the PMP's power: only a real sleep does. */
+		if (!apple_sleep_powered_down() && !stopped) {
 			pmp_asleep = false;
 			apple_pmp_report_wake(dev, true);
 			apple_pmp_display_wake();
-			dev_info(dev, "sleep refused before the commit: firmware never stopped\n");
+			dev_info(dev, "sleep aborted before the commit: firmware kept running\n");
 			return 0;
 		}
 	}
 	/* A stopped firmware doesn't restart with its power kept: the next real sleep does. */
-	if (!pm_resume_via_firmware()) {
+	if (!apple_sleep_powered_down()) {
 		dev_warn(dev, "sleep refused: firmware stays stopped until a real sleep\n");
 		return 0;
 	}
diff --git a/include/linux/soc/apple/sleep.h b/include/linux/soc/apple/sleep.h
index 0409dd9916..4eeb4dc790 100644
--- a/include/linux/soc/apple/sleep.h
+++ b/include/linux/soc/apple/sleep.h
@@ -26,6 +26,7 @@
 
 #include <linux/errno.h>
 #include <linux/kconfig.h>
+#include <linux/suspend.h>
 #include <linux/types.h>
 
 struct device;
@@ -84,6 +85,9 @@ static inline void apple_sleep_lid_closed_wake(void) { }
  * apple_sleep_coproc_power_cycled() tells it whether the stopped coprocessor's
  * power was cut and restored since (a real sleep, or a T8132 split step that
  * took its domain down): one idled with its power kept does not come back.
+ * apple_sleep_powered_down() tells any resume path whether the whole SoC lost
+ * power: a T8132 split step or a refusal powers only some blocks down, and
+ * pm_resume_via_firmware() is set for those as well.
  * T8132 has no PCIe ANS block: @pcie_ans must be false.
  */
 #if IS_ENABLED(CONFIG_APPLE_S2R)
@@ -98,6 +102,7 @@ void apple_sleep_enclave_unregister(struct device *dev);
 void apple_sleep_coproc_set_ready(struct device *dev, bool ready);
 bool apple_sleep_coproc_stopped(struct device *dev);
 bool apple_sleep_coproc_power_cycled(struct device *dev);
+bool apple_sleep_powered_down(void);
 /* After a deep sleep, put back the pins it reset. ANS's driver calls it before the run bit. */
 void apple_sleep_restore_pins(void);
 /* The PCIe host retrained a root port (or the radio's, port 0) after a T8132 sleep. */
@@ -123,6 +128,7 @@ static inline void apple_sleep_enclave_unregister(struct device *dev) { }
 static inline void apple_sleep_coproc_set_ready(struct device *dev, bool ready) { }
 static inline bool apple_sleep_coproc_stopped(struct device *dev) { return false; }
 static inline bool apple_sleep_coproc_power_cycled(struct device *dev) { return false; }
+static inline bool apple_sleep_powered_down(void) { return pm_resume_via_firmware(); }
 static inline void apple_sleep_restore_pins(void) { }
 static inline void apple_sleep_apcie_port_up(unsigned int port) { }
 static inline void apple_sleep_radio_port_up(void) { }
diff --git a/tools/asahi/display26-tests.py b/tools/asahi/display26-tests.py
index 3fa48f871d..bd2337b576 100644
--- a/tools/asahi/display26-tests.py
+++ b/tools/asahi/display26-tests.py
@@ -113,7 +113,8 @@ int main(void) {
               'static inline int apple_sleep_coproc_register(struct device *d, void __iomem *a, bool p,\n'
               '\t\t\t\t\t      int (*f)(void *), void *x) { assert(!"no system sleep here"); return -EIO; }\n'
               'static inline void apple_sleep_coproc_set_ready(struct device *d, bool r) { assert(!"no system sleep here"); }\n'
-              'static inline bool apple_sleep_coproc_stopped(struct device *d) { assert(!"no system sleep here"); return false; }\n')
+              'static inline bool apple_sleep_coproc_stopped(struct device *d) { assert(!"no system sleep here"); return false; }\n'
+              'static inline bool apple_sleep_powered_down(void) { assert(!"no system sleep here"); return false; }\n')
         write(tmp, 'linux/soc/apple/pmp-display.h', '#include <stdbool.h>\nbool apple_pmp_display_retained_board(void);\n'
               'int apple_pmp_display_sleep(void);\nvoid apple_pmp_display_wake(void);\n')
         write(tmp, 'mock.h', '''#pragma once
