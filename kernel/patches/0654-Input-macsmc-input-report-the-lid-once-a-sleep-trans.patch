From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:09:37 -0500
Subject: [PATCH] Input: macsmc-input: report the lid once a sleep transition
 ends

Lid events that arrive during a sleep transition went to the input core
at once. A lid that closes during a sleep and opens again before user
space runs then shows up as a closed-then-open pair, which logind or a
desktop may act on.

From PM_SUSPEND_PREPARE on, raise the wakeup event as before, so the lid
opening still ends a suspend, but hold the report back. ->complete() now
reads MSLD after every sleep, s2idle included, and reports where the lid
ended up, and the PM notifier reports it again at PM_POST_SUSPEND, for a
suspend that ended before ->prepare() and so never ran ->complete().

In a dark wake ->complete() reports nothing and leaves the lid and the
button armed: the system sleeps again, and a lid opened or a button
pressed before the next ->prepare() is a hard wakeup that aborts it, not
a KEY_POWER for user space. That ->prepare() reads MSLD once and refuses
with -EBUSY if the lid is open, in case its event came and went.
PM_POST_SUSPEND clears that state, so a later suspend never inherits it.
User space sees the lid as it is when it next runs.

A wake that stays awake gives user space the same lid state as before.

Signed-off-by: Diljit Singh <hey@djdev.me>
---
 drivers/input/misc/macsmc-input.c | 39 +++++++++++++++++++++++++++----
 1 file changed, 35 insertions(+), 4 deletions(-)

diff --git a/drivers/input/misc/macsmc-input.c b/drivers/input/misc/macsmc-input.c
index 19ea8f552c..fb3fe3fdb6 100644
--- a/drivers/input/misc/macsmc-input.c
+++ b/drivers/input/misc/macsmc-input.c
@@ -23,6 +23,7 @@
  * @nb: Notifier block used for incoming events from SMC (e.g. button pressed down)
  * @pm_nb: Notifier block for the start and end of a system suspend
  * @wakeup_mode: Set to true when system is suspended and power button events should wake it
+ * @dark: Going back to sleep from a dark wake: the lid is read again before it
  */
 struct macsmc_input {
 	struct device *dev;
@@ -31,6 +32,7 @@ struct macsmc_input {
 	struct notifier_block nb;
 	struct notifier_block pm_nb;
 	bool wakeup_mode;
+	bool dark;
 };
 
 #define SMC_EV_BTN 0x7201
@@ -87,6 +89,10 @@ static void macsmc_input_event_lid(struct macsmc_input *smcin, unsigned long eve
 	u8 lid_state = !!((event >> 8) & 0xff);
 
 	pm_wakeup_dev_event(smcin->dev, 0, (smcin->wakeup_mode && !lid_state));
+	/* Through a sleep, .complete reports where the lid ended up. */
+	if (smcin->wakeup_mode)
+		return;
+
 	input_report_switch(smcin->input, SW_LID, lid_state);
 	input_sync(smcin->input);
 }
@@ -118,10 +124,20 @@ static int macsmc_input_pm_notify(struct notifier_block *nb, unsigned long actio
 {
 	struct macsmc_input *smcin = container_of(nb, struct macsmc_input, pm_nb);
 
-	if (action == PM_SUSPEND_PREPARE)
+	if (action == PM_SUSPEND_PREPARE) {
 		WRITE_ONCE(smcin->wakeup_mode, true);
-	else if (action == PM_POST_SUSPEND)
+	} else if (action == PM_POST_SUSPEND) {
+		u8 val;
+
 		WRITE_ONCE(smcin->wakeup_mode, false);
+		smcin->dark = false;
+		/* A suspend that ended before .prepare held its lid events back too. */
+		if (apple_smc_key_exists(smcin->smc, SMC_KEY(MSLD)) &&
+		    apple_smc_read_u8(smcin->smc, SMC_KEY(MSLD), &val) >= 0) {
+			input_report_switch(smcin->input, SW_LID, val);
+			input_sync(smcin->input);
+		}
+	}
 
 	return NOTIFY_DONE;
 }
@@ -236,8 +252,18 @@ static int macsmc_input_probe(struct platform_device *pdev)
 static int macsmc_input_pm_prepare(struct device *dev)
 {
 	struct macsmc_input *smcin = dev_get_drvdata(dev);
+	u8 val;
 
 	smcin->wakeup_mode = true;
+	/* A lid opened as the dark wake ended may have sent its event already. */
+	if (smcin->dark) {
+		smcin->dark = false;
+		if (apple_smc_key_exists(smcin->smc, SMC_KEY(MSLD)) &&
+		    apple_smc_read_u8(smcin->smc, SMC_KEY(MSLD), &val) >= 0 && !val) {
+			dev_info(dev, "the lid opened during a dark wake: not sleeping again\n");
+			return -EBUSY;
+		}
+	}
 	return 0;
 }
 
@@ -245,10 +271,15 @@ static void macsmc_input_pm_complete(struct device *dev)
 {
 	struct macsmc_input *smcin = dev_get_drvdata(dev);
 
+	/* Still armed: a lid opened or a button pressed before the next .prepare wakes. */
+	if (pm_dark_wake()) {
+		smcin->dark = true;
+		return;
+	}
 	smcin->wakeup_mode = false;
 
-	/* The lid may have moved while the AP was off and no event could arrive. */
-	if (pm_resume_via_firmware() && apple_smc_key_exists(smcin->smc, SMC_KEY(MSLD))) {
+	/* The lid may have moved while the AP was off, or its events were held back. */
+	if (apple_smc_key_exists(smcin->smc, SMC_KEY(MSLD))) {
 		u8 val;
 
 		if (apple_smc_read_u8(smcin->smc, SMC_KEY(MSLD), &val) >= 0) {
