From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 07:20:21 +0000
Subject: [PATCH] drm/asahi: g16: Split g16_init_macos's Power words
 for bisecting

With g16_fw_controllers=1 and the Power words of g16_init_macos bit
0x08, the firmware caps its own performance. To find the word that
starts it without another kernel, add default-off bits that write
parts of that set alone:

  0x2000   Power +0x1c, the floor
  0x4000   Power +0x10, +0x14, +0x18, +0x20, the filter windows and
           gains
  0x8000   the other 13 Power words, the clamps among them
  0x10000  POWER_PERFORMANCE +0x5b64 / +0x5b68, the thermal-limit
           pair, alone (only with g16_fw_controllers)

Bit 0x08 still writes all 18 Power words.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/fw/initdata.rs | 79 ++++++++++++++++++++++--
 drivers/gpu/drm/asahi/g16/initdata.rs    | 15 ++++-
 2 files changed, 89 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/fw/initdata.rs b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
index 6cd5bdce08..11068642cc 100644
--- a/drivers/gpu/drm/asahi/g16/fw/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
@@ -392,7 +392,16 @@ pub(crate) mod init_macos {
     pub(crate) const NO_RETENTION: u32 = 1 << 11;
     /// [`MAIN_INIT_COPY`]: three Main words the firmware's init copies into its own state.
     pub(crate) const MAIN_INIT_COPY_WORDS: u32 = 1 << 12;
-    pub(crate) const ALL: u32 = 0x1fff;
+    /// [`POWER_FLOOR`]: Power +0x1c alone (part of [`POWER_WORDS`]).
+    pub(crate) const POWER_FLOOR_WORD: u32 = 1 << 13;
+    /// [`POWER_FILTER`]: the filter windows and gains (part of [`POWER_WORDS`]).
+    pub(crate) const POWER_FILTER_WORDS: u32 = 1 << 14;
+    /// [`POWER_LIMITS`]: the clamps and the other Power words (part of [`POWER_WORDS`]).
+    pub(crate) const POWER_LIMITS_WORDS: u32 = 1 << 15;
+    /// [`PP_THERMAL`]: the two thermal-limit words of [`PP`] alone; only with
+    /// `g16_fw_controllers`.
+    pub(crate) const PP_THERMAL_WORDS: u32 = 1 << 16;
+    pub(crate) const ALL: u32 = 0x1ffff;
 
     pub(crate) const RUNTIME_LOG: usize = 0x250;
     pub(crate) const RUNTIME_TIMER_COPY: usize = 0x8;
@@ -425,6 +434,31 @@ pub(crate) mod init_macos {
         (0x130, 0x3e800000),
         (0x134, 0x3f99999a),
     ];
+    /// [`POWER`] split for bisecting: +0x1c alone, the four words 0x26008 reads, the rest.
+    pub(crate) const POWER_FLOOR: [(usize, u32); 1] = [(0x1c, 40)];
+    pub(crate) const POWER_FILTER: [(usize, u32); 4] = [
+        (0x10, 31),
+        (0x14, 0x3e0a3d71),
+        (0x18, 0x401ae148),
+        (0x20, 1),
+    ];
+    pub(crate) const POWER_LIMITS: [(usize, u32); 13] = [
+        (0xc8, 11000),
+        (0xcc, 8000),
+        (0xd8, 0x42f00000),
+        (0xdc, 0x3fd55554),
+        (0xf0, 9600),
+        (0xf4, 200),
+        (0x108, 0x43960000),
+        (0x10c, 0x3fa66666),
+        (0x110, 625),
+        (0x124, 300),
+        (0x12c, 0x8dc6),
+        (0x130, 0x3e800000),
+        (0x134, 0x3f99999a),
+    ];
+    /// 26B123 POWER_PERFORMANCE +0x5bac / +0x5bb0, the thermal-limit pair of [`PP`].
+    pub(crate) const PP_THERMAL: [(usize, u32); 2] = [(0x5b64, 0x4159999a), (0x5b68, 0x41000000)];
     /// 26B123 Power +0x624..+0x640 at 25G83 -0x20 (between reader pairs that both move
     /// by 0x20).
     pub(crate) const POWER_TAIL: [(usize, u32); 5] = [
@@ -1193,6 +1227,26 @@ pub(crate) fn encode(
     }
     let mut groups = [
         (init_macos::POWER_WORDS, id::POWER, &init_macos::POWER[..]),
+        (
+            init_macos::POWER_FLOOR_WORD,
+            id::POWER,
+            &init_macos::POWER_FLOOR[..],
+        ),
+        (
+            init_macos::POWER_FILTER_WORDS,
+            id::POWER,
+            &init_macos::POWER_FILTER[..],
+        ),
+        (
+            init_macos::POWER_LIMITS_WORDS,
+            id::POWER,
+            &init_macos::POWER_LIMITS[..],
+        ),
+        (
+            init_macos::PP_THERMAL_WORDS,
+            id::POWER_PERFORMANCE,
+            &init_macos::PP_THERMAL[..],
+        ),
         (
             init_macos::POWER_TAIL_WORDS,
             id::POWER,
@@ -1210,8 +1264,10 @@ pub(crate) fn encode(
         ),
     ];
     if !input.fw_controllers {
-        groups[2].0 = 0;
-        groups[3].0 = 0;
+        // The POWER_PERFORMANCE groups: the thermal pair, PP and the PP tail.
+        groups[4].0 = 0;
+        groups[6].0 = 0;
+        groups[7].0 = 0;
     }
     for (bit, object, words) in groups {
         if bits & bit == 0 {
@@ -1283,7 +1339,22 @@ fn the_init_macos_words_miss_the_controller_words() {
                 .iter()
                 .any(|(c, _)| c == at));
         }
-        assert_eq!(init_macos::ALL, (init_macos::MAIN_INIT_COPY_WORDS << 1) - 1);
+        assert_eq!(init_macos::ALL, (init_macos::PP_THERMAL_WORDS << 1) - 1);
+        // The three Power sub-bits together are exactly POWER_WORDS's words.
+        let parts = init_macos::POWER_FLOOR.len()
+            + init_macos::POWER_FILTER.len()
+            + init_macos::POWER_LIMITS.len();
+        assert_eq!(parts, init_macos::POWER.len());
+        for w in init_macos::POWER_FLOOR
+            .iter()
+            .chain(init_macos::POWER_FILTER.iter())
+            .chain(init_macos::POWER_LIMITS.iter())
+        {
+            assert!(init_macos::POWER.contains(w));
+        }
+        for w in init_macos::PP_THERMAL.iter() {
+            assert!(init_macos::PP.contains(w));
+        }
         for (at, _) in init_macos::MAIN_INIT_COPY {
             assert!(!main_macos::WORDS.iter().any(|(m, _)| usize::from(*m) == at));
         }
diff --git a/drivers/gpu/drm/asahi/g16/initdata.rs b/drivers/gpu/drm/asahi/g16/initdata.rs
index c4117bc9a7..6438b17ae4 100644
--- a/drivers/gpu/drm/asahi/g16/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/initdata.rs
@@ -330,7 +330,20 @@ pub(crate) fn build(
                 (m >> 12) & 1
             );
         }
-        if m & (wire::init_macos::PP_WORDS | wire::init_macos::PP_TAIL_WORDS) != 0
+        if m >> 13 != 0 {
+            dev_info!(
+                dev,
+                "M4 initdata: g16_init_macos: power-floor {} power-filter {} power-limits {} pp-thermal {}\n",
+                (m >> 13) & 1,
+                (m >> 14) & 1,
+                (m >> 15) & 1,
+                (m >> 16) & 1
+            );
+        }
+        if m & (wire::init_macos::PP_WORDS
+            | wire::init_macos::PP_TAIL_WORDS
+            | wire::init_macos::PP_THERMAL_WORDS)
+            != 0
             && !input.fw_controllers
         {
             dev_info!(
-- 
