From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 00:22:14 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: drop the second video
 decoder node

The J604 lab include still adds the decoder node it carried before the
Aurora base described the block, avd@3a1080000. Aurora's
video-decoder@3a1080000 (t8132-avd.dtsi), which t8132-j604.dts enables,
covers the same windows, interrupts, DART and power domain. Both bind
apple_avd: the first owns the hardware, the second fails its probe with
-EBUSY and a warning on every boot, and its failed binding keeps the
pmgr power controller's sync_state pending.

Drop the lab node and the comment that says Aurora's node stays
disabled.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 17 -----------------
 1 file changed, 17 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index 497d1a4232..76e0f6d5c3 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -55,12 +55,6 @@ aliases {
 /* The boot framebuffer keeps no power domains (1.617: drop them, the DCP owns the display). */
 &{/chosen/framebuffer@0} { /delete-property/ power-domains; };
 
-/*
- * The video decoder keeps 1.617's node (avd@3a1080000, the four named windows
- * the AVD driver maps); Aurora's video-decoder@3a0000000 is a disabled
- * placeholder ("the driver register layout is not selected here") and stays so.
- */
-
 /* ---- generated delta (1.617 J604 DT vs Aurora 7.3 + the lines above) ---- */
 
 / {
@@ -255,17 +249,6 @@ nvme: nvme@4c5cc0000 {
 		apple,sart = <&sart>;
 		status = "okay";
 	};
-	avd@3a1080000 {
-		compatible = "apple,t8132-avd";
-		reg = <0x03 0xa1080000 0x00 0x14000>, <0x03 0xa1094000 0x00 0x14000>, <0x03 0xa10a8000 0x00 0x4000>, <0x03 0xa1100000 0x00 0x10000>;
-		reg-names = "code", "sram", "mbox", "ctrl";
-		interrupt-parent = <&aic>;
-		interrupts = <0x00 0x3b4 0x04>, <0x00 0x3b5 0x04>;
-		power-domains = <&ps_avd_sys>;
-		resets = <&ps_avd_sys>;
-		iommus = <&avd_dart 0x00>;
-		status = "okay";
-	};
 	cpu_ctrl: cpu-ctrl@380734000 {
 		compatible = "apple,t8132-cpu-ctrl";
 		/*
-- 
2.43.0

