From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sun, 1 Nov 2026 19:38:03 +1100
Subject: [PATCH] wifi: brcmfmac: distinguish firmware busy when starting escan

FWIL maps all firmware errors to -EBADE, so brcmf_run_escan cannot
recognize BCME_BUSY and takes the error-level path instead. The scan
callback then logs the same rejection a second time. This can happen
when the firmware cannot accept an escan around initial association.

Add an iovar setter that reports the command's firmware status alongside
the existing host error, under the protocol lock. Keep existing FWIL
callers and the feature-probing firmware-error mode unchanged. Leave
the status zero on transport or local setup failures.

Translate only an explicit BCME_BUSY escan reply to -EBUSY. Report it
once at debug level and use the existing scan cleanup without arming
the timeout, so userspace can retry. Treat the existing connecting
check as busy as well. Keep other errors at error level and include
the raw firmware status to distinguish non-busy scan rejections.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit ae64cd3620f5f953facd602dd0797af1898c2d29)
---
 .../broadcom/brcm80211/brcmfmac/cfg80211.c    | 18 ++++++---
 .../broadcom/brcm80211/brcmfmac/fwil.c        | 39 +++++++++++++------
 .../broadcom/brcm80211/brcmfmac/fwil.h        |  8 ++++
 3 files changed, 49 insertions(+), 16 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
index f5cd39ea63..d285183869 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -1365,7 +1365,7 @@ brcmf_run_escan(struct brcmf_cfg80211_info *cfg, struct brcmf_if *ifp,
 	void *prepped_params = NULL;
 	u32 params_size = 0;
 	struct brcmf_escan_params_le *params;
-	s32 err = 0;
+	s32 err = 0, fwerr;
 
 	brcmf_dbg(SCAN, "E-SCAN START\n");
 
@@ -1397,12 +1397,17 @@ brcmf_run_escan(struct brcmf_cfg80211_info *cfg, struct brcmf_if *ifp,
 	params->action = cpu_to_le16(WL_ESCAN_ACTION_START);
 	params->sync_id = cpu_to_le16(0x1234);
 
-	err = brcmf_fil_iovar_data_set(ifp, "escan", params, params_size);
+	err = brcmf_fil_iovar_data_set_fwerr(ifp, "escan", params,
+					     params_size, &fwerr);
+	/* Association or another firmware scan can temporarily own the radio. */
+	if (err == -EBADE && fwerr == -BRCMF_FW_BUSY)
+		err = -EBUSY;
 	if (err) {
 		if (err == -EBUSY)
 			brcmf_dbg(INFO, "system busy : escan canceled\n");
 		else
-			bphy_err(drvr, "error (%d)\n", err);
+			bphy_err(drvr, "error (%d), firmware status (%d)\n",
+				 err, fwerr);
 	}
 
 	kfree(params);
@@ -1465,8 +1470,8 @@ brcmf_cfg80211_scan(struct wiphy *wiphy, struct cfg80211_scan_request *request)
 		return -EAGAIN;
 	}
 	if (test_bit(BRCMF_VIF_STATUS_CONNECTING, &vif->sme_state)) {
-		bphy_err(drvr, "Connecting: status (%lu)\n", vif->sme_state);
-		return -EAGAIN;
+		brcmf_dbg(SCAN, "Connecting: status (%lu)\n", vif->sme_state);
+		return -EBUSY;
 	}
 
 	brcmf_dbg(SCAN, "START ESCAN\n");
@@ -1495,6 +1500,8 @@ brcmf_cfg80211_scan(struct wiphy *wiphy, struct cfg80211_scan_request *request)
 		  timeout, request->n_channels);
 
 	err = brcmf_do_escan(vif->ifp, request);
+	if (err == -EBUSY)
+		goto scan_cleanup;
 	if (err)
 		goto scan_out;
 
@@ -1506,6 +1513,7 @@ brcmf_cfg80211_scan(struct wiphy *wiphy, struct cfg80211_scan_request *request)
 
 scan_out:
 	bphy_err(drvr, "scan error (%d)\n", err);
+scan_cleanup:
 	clear_bit(BRCMF_SCAN_STATUS_BUSY, &cfg->scan_status);
 	cfg->scan_request = NULL;
 	return err;
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.c
index 6f2bac1c86..9ed2e25141 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.c
@@ -94,11 +94,15 @@ static const char *brcmf_fil_get_errstr(u32 err)
 #endif /* DEBUG */
 
 static s32
-brcmf_fil_cmd_data(struct brcmf_if *ifp, u32 cmd, void *data, u32 len, bool set)
+brcmf_fil_cmd_data(struct brcmf_if *ifp, u32 cmd, void *data, u32 len, bool set,
+		   s32 *fwerr_out)
 {
 	struct brcmf_pub *drvr = ifp->drvr;
 	s32 err, fwerr;
 
+	if (fwerr_out)
+		*fwerr_out = 0;
+
 	if (drvr->bus_if->state != BRCMF_BUS_UP) {
 		bphy_err(drvr, "bus is down. we have nothing to do.\n");
 		return -EIO;
@@ -113,6 +117,9 @@ brcmf_fil_cmd_data(struct brcmf_if *ifp, u32 cmd, void *data, u32 len, bool set)
 		err = brcmf_proto_query_dcmd(drvr, ifp->ifidx, cmd,
 					     data, len, &fwerr);
 
+	if (fwerr_out && !err)
+		*fwerr_out = fwerr;
+
 	if (err) {
 		brcmf_dbg(FIL, "Failed: error=%d\n", err);
 	} else if (fwerr < 0) {
@@ -137,7 +144,7 @@ brcmf_fil_cmd_data_set(struct brcmf_if *ifp, u32 cmd, void *data, u32 len)
 	brcmf_dbg_hex_dump(BRCMF_FIL_ON(), data,
 			   min_t(uint, len, MAX_HEX_DUMP_LEN), "data\n");
 
-	err = brcmf_fil_cmd_data(ifp, cmd, data, len, true);
+	err = brcmf_fil_cmd_data(ifp, cmd, data, len, true, NULL);
 	mutex_unlock(&ifp->drvr->proto_block);
 
 	return err;
@@ -150,7 +157,7 @@ brcmf_fil_cmd_data_get(struct brcmf_if *ifp, u32 cmd, void *data, u32 len)
 	s32 err;
 
 	mutex_lock(&ifp->drvr->proto_block);
-	err = brcmf_fil_cmd_data(ifp, cmd, data, len, false);
+	err = brcmf_fil_cmd_data(ifp, cmd, data, len, false, NULL);
 
 	brcmf_dbg(FIL, "ifidx=%d, cmd=%d, len=%d, err=%d\n", ifp->ifidx, cmd,
 		  len, err);
@@ -185,13 +192,16 @@ brcmf_create_iovar(const char *name, const char *data, u32 datalen,
 
 
 s32
-brcmf_fil_iovar_data_set(struct brcmf_if *ifp, const char *name, const void *data,
-			 u32 len)
+brcmf_fil_iovar_data_set_fwerr(struct brcmf_if *ifp, const char *name,
+			       const void *data, u32 len, s32 *fwerr)
 {
 	struct brcmf_pub *drvr = ifp->drvr;
 	s32 err;
 	u32 buflen;
 
+	if (fwerr)
+		*fwerr = 0;
+
 	mutex_lock(&drvr->proto_block);
 
 	brcmf_dbg(FIL, "ifidx=%d, name=%s, len=%d\n", ifp->ifidx, name, len);
@@ -202,7 +212,7 @@ brcmf_fil_iovar_data_set(struct brcmf_if *ifp, const char *name, const void *dat
 				    sizeof(drvr->proto_buf));
 	if (buflen) {
 		err = brcmf_fil_cmd_data(ifp, BRCMF_C_SET_VAR, drvr->proto_buf,
-					 buflen, true);
+					 buflen, true, fwerr);
 	} else {
 		err = -EPERM;
 		bphy_err(drvr, "Creating iovar failed\n");
@@ -211,6 +221,13 @@ brcmf_fil_iovar_data_set(struct brcmf_if *ifp, const char *name, const void *dat
 	mutex_unlock(&drvr->proto_block);
 	return err;
 }
+
+s32
+brcmf_fil_iovar_data_set(struct brcmf_if *ifp, const char *name, const void *data,
+			 u32 len)
+{
+	return brcmf_fil_iovar_data_set_fwerr(ifp, name, data, len, NULL);
+}
 BRCMF_EXPORT_SYMBOL_GPL(brcmf_fil_iovar_data_set);
 
 s32
@@ -227,7 +244,7 @@ brcmf_fil_iovar_data_get(struct brcmf_if *ifp, const char *name, void *data,
 				    sizeof(drvr->proto_buf));
 	if (buflen) {
 		err = brcmf_fil_cmd_data(ifp, BRCMF_C_GET_VAR, drvr->proto_buf,
-					 buflen, false);
+					 buflen, false, NULL);
 		if (err == 0)
 			memcpy(data, drvr->proto_buf, len);
 	} else {
@@ -347,7 +364,7 @@ brcmf_fil_bsscfg_data_set(struct brcmf_if *ifp, const char *name,
 				     drvr->proto_buf, sizeof(drvr->proto_buf));
 	if (buflen) {
 		err = brcmf_fil_cmd_data(ifp, BRCMF_C_SET_VAR, drvr->proto_buf,
-					 buflen, true);
+					 buflen, true, NULL);
 	} else {
 		err = -EPERM;
 		bphy_err(drvr, "Creating bsscfg failed\n");
@@ -372,7 +389,7 @@ brcmf_fil_bsscfg_data_get(struct brcmf_if *ifp, const char *name,
 				     drvr->proto_buf, sizeof(drvr->proto_buf));
 	if (buflen) {
 		err = brcmf_fil_cmd_data(ifp, BRCMF_C_GET_VAR, drvr->proto_buf,
-					 buflen, false);
+					 buflen, false, NULL);
 		if (err == 0)
 			memcpy(data, drvr->proto_buf, len);
 	} else {
@@ -428,7 +445,7 @@ s32 brcmf_fil_xtlv_data_set(struct brcmf_if *ifp, const char *name, u16 id,
 				   drvr->proto_buf, sizeof(drvr->proto_buf));
 	if (buflen) {
 		err = brcmf_fil_cmd_data(ifp, BRCMF_C_SET_VAR, drvr->proto_buf,
-					 buflen, true);
+					 buflen, true, NULL);
 	} else {
 		err = -EPERM;
 		bphy_err(drvr, "Creating xtlv failed\n");
@@ -452,7 +469,7 @@ s32 brcmf_fil_xtlv_data_get(struct brcmf_if *ifp, const char *name, u16 id,
 				   drvr->proto_buf, sizeof(drvr->proto_buf));
 	if (buflen) {
 		err = brcmf_fil_cmd_data(ifp, BRCMF_C_GET_VAR, drvr->proto_buf,
-					 buflen, false);
+					 buflen, false, NULL);
 		if (err == 0)
 			memcpy(data, drvr->proto_buf, len);
 	} else {
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.h b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.h
index 92c9fbba52..fbc78763bc 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.h
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil.h
@@ -8,6 +8,9 @@
 
 #include "debug.h"
 
+/* Firmware error codes (positive values; firmware returns their negatives). */
+#define BRCMF_FW_BUSY				16
+
 /*******************************************************************************
  * Dongle command codes that are interpreted by firmware
  ******************************************************************************/
@@ -115,6 +118,11 @@ s32 brcmf_fil_cmd_int_query(struct brcmf_if *ifp, u32 cmd, u32 *data)
 	return brcmf_fil_cmd_int_get(ifp, cmd, data);
 }
 
+/* Like brcmf_fil_iovar_data_set(), also returning the firmware status.
+ * The status is zero when the command could not be sent or transport failed.
+ */
+s32 brcmf_fil_iovar_data_set_fwerr(struct brcmf_if *ifp, const char *name,
+				   const void *data, u32 len, s32 *fwerr);
 s32 brcmf_fil_iovar_data_set(struct brcmf_if *ifp, const char *name,
 			     const void *data, u32 len);
 s32 brcmf_fil_iovar_data_get(struct brcmf_if *ifp, const char *name, void *data,
