From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 04:58:15 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j604: describe the G16 GPU resources

Add the J604 GPU (gfx-asc ASCWrap and sgx block), its mailbox, the GFX
TVM gate and the six firmware-inherited reserved-memory ranges, in the
layout of the J713 description, with values from the J604 ADT (25G83
j604ap template). Add the "gpu" alias that m1n1 uses to find the node.

Everything stays disabled. m1n1 fills the reserved ranges and the
firmware segment layout only for an admitted board and never enables
the GPU; the G16 backend is qualified on J713 only, and the J604 perf
state selection and loaded firmware image are not measured yet. ps_gfx
keeps its current parent.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604-gpu.dtsi | 102 ++++++++++++++++++
 arch/arm64/boot/dts/apple/t8132-j604.dts      |   1 +
 2 files changed, 103 insertions(+)
 create mode 100644 arch/arm64/boot/dts/apple/t8132-j604-gpu.dtsi

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-gpu.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-gpu.dtsi
new file mode 100644
index 0000000000..397a275882
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8132-j604-gpu.dtsi
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Apple MacBook Pro (14-inch, M4, 2024) G16 GPU resources.
+ *
+ * Node structure follows the J604 ADT (25G83 j604ap template): the gfx-asc
+ * ASCWrap at 0x302600000, the sgx block at 0x300000000 and the gfx-asc
+ * mailbox interrupts 993-996. m1n1 finds the GPU through the "gpu" alias,
+ * fills the inherited UAT and firmware ranges below, sets them okay and
+ * publishes the firmware segment layout on the gpu node; it never enables
+ * the gpu node itself.
+ *
+ * The GPU, its mailbox and the GFX TVM gate stay disabled: the G16 backend
+ * is qualified on J713 only, and the J604 perf-state selection and loaded
+ * firmware image are not measured yet. ps_gfx keeps its current parent.
+ *
+ * DTV-<id> tags name rows of DT-VERIFY-gpu.tsv.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+/ {
+	aliases {
+		gpu = &gpu;
+	};
+
+	reserved-memory {
+		gpu_ttbs: uat-ttbs {
+			reg = <0 0 0 0>; /* DTV-GPU-14 */
+			no-map;
+			status = "disabled";
+		};
+
+		gpu_pagetables: uat-pagetables {
+			reg = <0 0 0 0>; /* DTV-GPU-15 */
+			no-map;
+			status = "disabled";
+		};
+
+		gpu_handoff: uat-handoff {
+			reg = <0 0 0 0>; /* DTV-GPU-16 */
+			no-map;
+			status = "disabled";
+		};
+
+		gpu_shared_l2: uat-shared-l2 {
+			reg = <0 0 0 0>; /* DTV-GPU-17 */
+			no-map;
+			status = "disabled";
+		};
+
+		gpu_fw_text: gpu-fw-text {
+			reg = <0 0 0 0>; /* DTV-GPU-18 */
+			no-map;
+			status = "disabled";
+		};
+
+		gpu_fw_data: gpu-fw-data {
+			reg = <0 0 0 0>; /* DTV-GPU-19 */
+			no-map;
+			status = "disabled";
+		};
+	};
+};
+
+&soc {
+	gfx_tvm: power-controller@380760800 {
+		compatible = "apple,t8132-gfx-tvm";
+		reg = <0x3 0x80760800 0x0 0x4>; /* DTV-GPU-11 */
+		#power-domain-cells = <0>;
+		status = "disabled"; /* DTV-GPU-13 */
+	};
+
+	gpu: gpu@302600000 {
+		compatible = "apple,agx-t8132";
+		reg = <0x3 0x02600000 0x0 0x4000>, /* DTV-GPU-1, DTV-GPU-2 */
+		      <0x3 0x00000000 0x0 0x4000000>; /* DTV-GPU-3 */
+		reg-names = "asc", "sgx";
+		mboxes = <&agx_mbox>;
+		power-domains = <&ps_gfx>; /* DTV-GPU-6 */
+		apple,pmp = <&pmp>;
+		memory-region = <&gpu_ttbs>, <&gpu_pagetables>, <&gpu_handoff>,
+				<&gpu_shared_l2>, <&gpu_fw_text>, <&gpu_fw_data>;
+		memory-region-names = "ttbs", "pagetables", "handoff",
+				      "shared-l2", "fw-text", "fw-data";
+		status = "disabled"; /* DTV-GPU-7 */
+	};
+
+	agx_mbox: mailbox@302608000 {
+		/* ASCWrap v6 contains the same mailbox aperture used by ASC v4. */
+		compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x3 0x02608000 0x0 0x4000>; /* DTV-GPU-8 */
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 993 IRQ_TYPE_LEVEL_HIGH>, /* DTV-GPU-9 */
+			     <AIC_IRQ 994 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 995 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 996 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+		status = "disabled"; /* DTV-GPU-10 */
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 2d3092911d..1b1e360613 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -377,3 +377,4 @@
 		};
 	};
 };
+#include "t8132-j604-gpu.dtsi"
