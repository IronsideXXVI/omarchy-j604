From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 13:20:46 +0000
Subject: [PATCH] soc: apple: sep: Take the PM callbacks by address

The SEP driver declares its C dev_pm_ops as an extern static in Rust.
Without CONFIG_LOCKDEP, dev_pm_ops carries an empty lockdep_map, and
rustc warns that the static's type is not FFI-safe. Rust only ever
takes its address, so get that from C instead, through a function
returning a pointer.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/soc/apple/pm.rs     | 2 +-
 drivers/soc/apple/pm_shim.c | 6 ++++++
 drivers/soc/apple/sep.rs    | 4 ++--
 drivers/soc/apple/shim.h    | 1 +
 4 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/drivers/soc/apple/pm.rs b/drivers/soc/apple/pm.rs
index a65e592010..3c7eef1b8d 100644
--- a/drivers/soc/apple/pm.rs
+++ b/drivers/soc/apple/pm.rs
@@ -49,7 +49,7 @@ extern "C" {
         mask: u64,
     ) -> c_int;
     fn sep_pm_commit_finish(dev: *mut c_void) -> c_int;
-    pub(crate) static sep_pm_ops: kernel::bindings::dev_pm_ops;
+    pub(crate) fn sep_pm_ops_get() -> *const c_void;
 }
 
 /// How long the enclave gets to gate its domain once it has answered.
diff --git a/drivers/soc/apple/pm_shim.c b/drivers/soc/apple/pm_shim.c
index f7ca2e711e..4d7f52aeaa 100644
--- a/drivers/soc/apple/pm_shim.c
+++ b/drivers/soc/apple/pm_shim.c
@@ -419,6 +419,12 @@ const struct dev_pm_ops sep_pm_ops = {
 	.suspend_noirq = pm_sleep_ptr(sep_pm_suspend_noirq),
 };
 
+/* For Rust, which only needs the address. */
+const void *sep_pm_ops_get(void)
+{
+	return &sep_pm_ops;
+}
+
 int sep_pm_register(void *ptr, void (*event)(bool entering), int (*sleep)(void),
 		    void (*wake)(void), bool (*told)(void))
 {
diff --git a/drivers/soc/apple/sep.rs b/drivers/soc/apple/sep.rs
index 9ee09f4153..ea4aba106a 100644
--- a/drivers/soc/apple/sep.rs
+++ b/drivers/soc/apple/sep.rs
@@ -3291,8 +3291,8 @@ impl platform::Driver for SepDriver {
     const OF_ID_TABLE: Option<of::IdTable<()>> = Some(&OF_TABLE);
 
     fn pm_ops() -> Option<&'static bindings::dev_pm_ops> {
-        // SAFETY: a static in `pm_shim.c`, never written.
-        Some(unsafe { &*core::ptr::addr_of!(pm::sep_pm_ops) })
+        // SAFETY: the address of a static in `pm_shim.c`, never written.
+        Some(unsafe { &*pm::sep_pm_ops_get().cast::<kernel::bindings::dev_pm_ops>() })
     }
 
     fn probe<'bound>(
diff --git a/drivers/soc/apple/shim.h b/drivers/soc/apple/shim.h
index 26827c6f42..ec86e8f310 100644
--- a/drivers/soc/apple/shim.h
+++ b/drivers/soc/apple/shim.h
@@ -37,6 +37,7 @@ void sep_pm_dart_restore(void *dev);
 int sep_pm_commit_prepare(void *dev, void *mbox, u64 msg0, u32 msg1, u64 reply, u64 mask);
 int sep_pm_commit_finish(void *dev);
 extern const struct dev_pm_ops sep_pm_ops;
+const void *sep_pm_ops_get(void);
 
 /* -- hwrng_shim.c ------------------------------------------------------- */
 
