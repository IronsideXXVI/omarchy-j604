From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 15:38:22 +0000
Subject: [PATCH] media: apple: isp: reserve a control base and
 document the controls

The auto framing control took a number from the user class without a
reservation, defined in the driver. Reserve 16 controls for the driver
at V4L2_CID_USER_BASE + 0x1240, the next free base after Mali-C55, move
V4L2_CID_APPLE_ISP_AUTO_FRAMING to a uapi header with its kernel-doc,
and describe the driver's controls, standard and driver-specific, in
the userspace API documentation. The control keeps its number.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 .../userspace-api/media/drivers/apple-isp.rst | 38 +++++++++++++++++++
 .../userspace-api/media/drivers/index.rst     |  1 +
 drivers/media/platform/apple/isp/isp-drv.h    |  4 +-
 include/uapi/linux/apple-isp.h                | 21 ++++++++++
 include/uapi/linux/v4l2-controls.h            |  6 +++
 5 files changed, 67 insertions(+), 3 deletions(-)
 create mode 100644 Documentation/userspace-api/media/drivers/apple-isp.rst
 create mode 100644 include/uapi/linux/apple-isp.h

diff --git a/Documentation/userspace-api/media/drivers/apple-isp.rst b/Documentation/userspace-api/media/drivers/apple-isp.rst
new file mode 100644
index 0000000000..6c92b427a0
--- /dev/null
+++ b/Documentation/userspace-api/media/drivers/apple-isp.rst
@@ -0,0 +1,38 @@
+.. SPDX-License-Identifier: GPL-2.0-only
+
+Apple silicon ISP camera driver
+===============================
+
+The apple-isp driver runs the built-in camera of Apple silicon Macs through
+the image signal processor's firmware. It offers one video capture node.
+
+Standard controls
+-----------------
+
+``V4L2_CID_EXPOSURE_AUTO_PRIORITY``
+    Auto exposure is always on. When set, it may lengthen the frame time in
+    low light, down to 15 frames per second; when clear it holds the frame
+    rate and raises the gain. Where macOS runs the camera with auto low-light
+    video, it is set by default.
+
+``V4L2_CID_GAIN``, ``V4L2_CID_EXPOSURE_ABSOLUTE``
+    Read-only, where the firmware reports them: the gain (in 1/256 steps)
+    and the exposure (in 100 µs units) of the last frame auto exposure took.
+
+``V4L2_CID_POWER_LINE_FREQUENCY``
+    The mains frequency auto exposure avoids beating with, 50 Hz by default.
+
+``V4L2_CID_ZOOM_ABSOLUTE``
+    The digital zoom done by the firmware, 100 to 400 (1x to 4x), where the
+    driver offers it.
+
+Driver-specific controls
+------------------------
+
+The controls are defined in ``include/uapi/linux/apple-isp.h``.
+
+``V4L2_CID_APPLE_ISP_AUTO_FRAMING``
+    Boolean. When set, the digital zoom follows the faces the firmware
+    detects and keeps them framed, as Center Stage does on macOS;
+    ``V4L2_CID_ZOOM_ABSOLUTE`` no longer sets the zoom while it is set. Off by
+    default. Offered with the digital zoom only.
diff --git a/Documentation/userspace-api/media/drivers/index.rst b/Documentation/userspace-api/media/drivers/index.rst
index 02967c9b18..671e5d46f5 100644
--- a/Documentation/userspace-api/media/drivers/index.rst
+++ b/Documentation/userspace-api/media/drivers/index.rst
@@ -26,6 +26,7 @@ For more details see the file COPYING in the source distribution of Linux.
 	:maxdepth: 5
 	:numbered:
 
+	apple-isp
 	aspeed-video
 	camera-sensor
 	ccs
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 2aabbcfc22..33a87f0e7d 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -12,6 +12,7 @@
 #include <linux/types.h>
 #include <linux/spinlock.h>
 #include <linux/workqueue.h>
+#include <linux/apple-isp.h>
 
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
@@ -412,9 +413,6 @@ struct isp_format {
 	size_t total_size;
 };
 
-/* Driver-private until a control base is reserved for this driver. */
-#define V4L2_CID_APPLE_ISP_AUTO_FRAMING (V4L2_CID_USER_BASE + 0x1240)
-
 struct apple_isp {
 	struct device *dev;
 	const struct apple_isp_hw *hw;
diff --git a/include/uapi/linux/apple-isp.h b/include/uapi/linux/apple-isp.h
new file mode 100644
index 0000000000..285d208fba
--- /dev/null
+++ b/include/uapi/linux/apple-isp.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH Linux-syscall-note */
+/*
+ * Apple silicon ISP camera driver: driver-specific controls.
+ */
+
+#ifndef __UAPI_APPLE_ISP_H_
+#define __UAPI_APPLE_ISP_H_
+
+#include <linux/v4l2-controls.h>
+
+/**
+ * define V4L2_CID_APPLE_ISP_AUTO_FRAMING - keep the people in view
+ *
+ * Boolean. When set, the digital zoom follows the faces the camera firmware
+ * detects, framing them as Center Stage does on macOS, and
+ * %V4L2_CID_ZOOM_ABSOLUTE no longer sets the zoom. Off by default. Offered
+ * only where the driver offers the digital zoom.
+ */
+#define V4L2_CID_APPLE_ISP_AUTO_FRAMING	(V4L2_CID_USER_APPLE_ISP_BASE + 0x00)
+
+#endif /* __UAPI_APPLE_ISP_H_ */
diff --git a/include/uapi/linux/v4l2-controls.h b/include/uapi/linux/v4l2-controls.h
index 25a6116195..ef66112026 100644
--- a/include/uapi/linux/v4l2-controls.h
+++ b/include/uapi/linux/v4l2-controls.h
@@ -234,6 +234,12 @@ enum v4l2_colorfx {
  */
 #define V4L2_CID_USER_MALI_C55_BASE		(V4L2_CID_USER_BASE + 0x1230)
 
+/*
+ * The base for the Apple ISP driver controls.
+ * We reserve 16 controls for this driver.
+ */
+#define V4L2_CID_USER_APPLE_ISP_BASE		(V4L2_CID_USER_BASE + 0x1240)
+
 /* MPEG-class control IDs */
 /* The MPEG controls are applicable to all codec controls
  * and the 'MPEG' part of the define is historical */
