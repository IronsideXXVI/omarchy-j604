From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 13:34:26 +0000
Subject: [PATCH] soc: apple: clpc: observe the GFX power state where it does
 not drive demand

On T8132 the GFX power state does not set the GPU floor (hw->gpu_demand is
false; the GPU driver reports its work instead), so the CLPC never reads it
and nothing shows whether graphics ever powers off at idle. The J604 power
work needs exactly that: the GPU rail stays at 0.1-0.2 W at idle where macOS
reads 0 mW.

Where gpu_demand is false and the node has apple,gpu-power-state, read that
word for observation only: at every sample the CLPC takes anyway (no sample
of its own, no floor, no change to the sampling cadence), count samples that
find graphics powered (ACTUAL 0xf) or not and the changes between them, and
print the live word with its fields in debugfs status:

  gfx pstate (observed, no floor): now 0x1f0023ff err 0 actual 0xf target 0xf
  auto 1 ps_auto 0xf | samples on N off N changes N errors N

The word is the one the GPU driver itself reads at probe (G16 boot.rs,
power_domain_state(), PMGR offset 0x250) and the one the CLPC reads on
SoCs where it drives demand. A node the CLPC cannot use only goes
unobserved; probe does not fail. SoCs with gpu_demand are unchanged.

[j604: observability for linux-aurora 1.612. The GPU rail-floor question
is read from this line, with no raw register access.]

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/soc/apple/clpc.c | 72 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 72 insertions(+)

diff --git a/drivers/soc/apple/clpc.c b/drivers/soc/apple/clpc.c
index 349aa26865..c4fe777b1b 100644
--- a/drivers/soc/apple/clpc.c
+++ b/drivers/soc/apple/clpc.c
@@ -181,6 +181,18 @@ struct apple_clpc {
 	/* Samples that applied the GPU floor for streaming or dense work. */
 	unsigned long gpu_streaming_samples;
 	unsigned long gpu_dense_samples;
+	/*
+	 * The GFX power state where it does not drive demand (!hw->gpu_demand):
+	 * observed for debugfs only, at samples taken anyway and at each read.
+	 * Counts of samples that found graphics powered or not, and of changes.
+	 */
+	struct regmap *gfx_obs;
+	u32 gfx_obs_offset;
+	u32 gfx_obs_last;
+	unsigned long gfx_obs_on;
+	unsigned long gfx_obs_off;
+	unsigned long gfx_obs_changes;
+	unsigned long gfx_obs_errors;
 };
 
 /* Protect publication/removal of provider drvdata, never a submission path. */
@@ -665,6 +677,51 @@ static bool apple_clpc_gpu_input_demand(const struct apple_clpc_hw *hw,
 	return true;
 }
 
+/*
+ * Observation only: no floor follows it and it takes no sample of its own.
+ * Reads the same GFX power-state word the GPU driver checks at probe.
+ */
+static void apple_clpc_gfx_obs_init(struct device *dev, struct apple_clpc *clpc)
+{
+	struct device_node *np = of_parse_phandle(dev->of_node, "apple,gpu-power-state", 0);
+	struct regmap *map;
+	u32 offset;
+	int ret;
+
+	if (!np)
+		return;
+	ret = of_property_read_u32(np, "reg", &offset);
+	map = syscon_node_to_regmap(np->parent);
+	of_node_put(np);
+	/* Observation is optional: a node it cannot use only goes unobserved. */
+	if (ret || IS_ERR(map)) {
+		dev_warn(dev, "GFX power state not observed (%d)\n", ret ?: (int)PTR_ERR(map));
+		return;
+	}
+	clpc->gfx_obs = map;
+	clpc->gfx_obs_offset = offset;
+}
+
+static void apple_clpc_gfx_observe(struct apple_clpc *clpc)
+{
+	u32 status;
+	bool on;
+
+	if (regmap_read(clpc->gfx_obs, clpc->gfx_obs_offset, &status)) {
+		clpc->gfx_obs_errors++;
+		return;
+	}
+	on = (status & GENMASK(7, 4)) == GENMASK(7, 4);
+	if ((clpc->gfx_obs_on || clpc->gfx_obs_off) &&
+	    on != ((clpc->gfx_obs_last & GENMASK(7, 4)) == GENMASK(7, 4)))
+		clpc->gfx_obs_changes++;
+	if (on)
+		clpc->gfx_obs_on++;
+	else
+		clpc->gfx_obs_off++;
+	clpc->gfx_obs_last = status;
+}
+
 static void apple_clpc_sample(struct apple_clpc *clpc)
 {
 	unsigned int demand[APPLE_CLPC_RAILS] = {};
@@ -718,6 +775,9 @@ static void apple_clpc_sample(struct apple_clpc *clpc)
 		}
 	}
 
+	if (clpc->gfx_obs)
+		apple_clpc_gfx_observe(clpc);
+
 	for (rail = 0; rail < APPLE_CLPC_RAILS; rail++)
 		state[rail] = apple_clpc_vote(&clpc->vote[rail], demand[rail],
 					      now);
@@ -798,6 +858,16 @@ static int apple_clpc_status_show(struct seq_file *s, void *unused)
 	}
 	seq_printf(s, "samples: %lu update errors: %lu gpu read errors: %lu\n",
 		   clpc->samples, clpc->update_errors, clpc->gpu_read_errors);
+	if (clpc->gfx_obs) {
+		u32 word = 0;
+		int err = regmap_read(clpc->gfx_obs, clpc->gfx_obs_offset, &word);
+
+		seq_printf(s, "gfx pstate (observed, no floor): now %#010x err %d actual %#x target %#x auto %u ps_auto %#x | samples on %lu off %lu changes %lu errors %lu\n",
+			   word, err, (word >> 4) & 0xf, word & 0xf, (word >> 28) & 1,
+			   (word >> 24) & 0xf, READ_ONCE(clpc->gfx_obs_on),
+			   READ_ONCE(clpc->gfx_obs_off), READ_ONCE(clpc->gfx_obs_changes),
+			   READ_ONCE(clpc->gfx_obs_errors));
+	}
 	if (clpc->gpu_pmgr) {
 		seq_printf(s, "gpu: powered %u for %u ms, pmp limited ", clpc->gpu_on,
 			   clpc->gpu_on ? jiffies_to_msecs(jiffies - clpc->gpu_on_since) : 0);
@@ -976,6 +1046,8 @@ static int apple_clpc_probe(struct platform_device *pdev)
 	/* The property is optional: without it, CPU demand alone sets the floors. */
 	if (clpc->hw->gpu_demand)
 		gpu = of_parse_phandle(dev->of_node, "apple,gpu-power-state", 0);
+	else
+		apple_clpc_gfx_obs_init(dev, clpc);
 	if (gpu) {
 		ret = of_property_read_u32(gpu, "reg", &clpc->gpu_offset);
 		clpc->gpu_pmgr = syscon_node_to_regmap(gpu->parent);
