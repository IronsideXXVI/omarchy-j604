From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 05:37:10 +0000
Subject: [PATCH] media: apple: scaler: scale to another size

The scaler's mem2mem device only converted at 1:1. The engine also
resamples, with a 9-tap vertical and a 15-tap horizontal polyphase
filter of 32 phases each in Q4.12, and a Q22 source-to-destination ratio
per direction; the register layout, the phase convention (phase p
samples at p/32 for p < 16 and (p - 32)/32 otherwise, around the middle
tap) and the coefficient packing are as m1n1's scaler experiment
records them, and the 1:1 setup this driver already writes uses the same
ratio words with a unit value.

Let the CAPTURE size differ from the OUTPUT size, from a quarter to
eight times in each direction, and program the scaler for such jobs:
enable each direction whose size changes, put its ratio in every ratio
word, start at phase zero, and load Catmull-Rom filters computed for
the ratio (widened by the reduction when scaling down, so they also
filter), normalised to 1.0 per phase. Same-size jobs are unchanged.

apple_scaler.scaling=0 restores the 1:1-only behaviour.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 61897f78e9074b047dd0bbb9c54a70b8711717e7)
---
 .../platform/apple/scaler/apple-scaler-drv.c  |  33 ++++--
 .../platform/apple/scaler/apple-scaler-hw.c   | 103 +++++++++++++++++-
 .../platform/apple/scaler/apple-scaler-hw.h   |   5 +-
 3 files changed, 129 insertions(+), 12 deletions(-)

diff --git a/drivers/media/platform/apple/scaler/apple-scaler-drv.c b/drivers/media/platform/apple/scaler/apple-scaler-drv.c
index d9707d2aec..f9f784612a 100644
--- a/drivers/media/platform/apple/scaler/apple-scaler-drv.c
+++ b/drivers/media/platform/apple/scaler/apple-scaler-drv.c
@@ -108,6 +108,10 @@ static void asc_write(struct apple_scaler *asc, u32 reg, u32 val)
 	writel_relaxed(val, asc->regs + reg);
 }
 
+static bool scaling = true;
+module_param(scaling, bool, 0644);
+MODULE_PARM_DESC(scaling, "Allow a destination size other than the source size (default: yes)");
+
 /* ---- hardware --------------------------------------------------------- */
 
 
@@ -312,6 +316,7 @@ static void asc_device_run(void *priv)
 	/* Job tags as the engine is driven on macOS: a counter above bit 3, bit 2 set. */
 	job.transform_id = (++asc->transform_id << 3) | BIT(2);
 	job.msr20 = asc->variant->msr20;
+	job.scale = READ_ONCE(scaling);
 	n = asc_job_build(&job, asc->writes, ARRAY_SIZE(asc->writes));
 	if (n < 0) {
 		spin_unlock_irqrestore(&asc->hw_lock, flags);
@@ -350,10 +355,22 @@ static const struct v4l2_m2m_ops asc_m2m_ops = {
  * transfer function, since the engine converts only the encoding.
  */
 static void asc_fill(struct v4l2_pix_format_mplane *pix, const struct v4l2_pix_format_mplane *ref,
-		     u32 default_fourcc)
+		     u32 default_fourcc, bool resize)
 {
 	const struct asc_format *f = asc_find_format(pix->pixelformat);
 	u32 w = ref ? ref->width : pix->width, h = ref ? ref->height : pix->height;
+
+	/*
+	 * A destination may be scaled: down to a quarter (the filters keep
+	 * every source line up to a halving vertically and to 3.5x
+	 * horizontally, and still average beyond) or up to eight times.
+	 */
+	if (ref && resize && READ_ONCE(scaling) && pix->width && pix->height) {
+		w = clamp_t(u32, pix->width, max_t(u32, ref->width / 4, ASC_MIN_SIZE),
+			    min_t(u32, ref->width * 8, ASC_MAX_SIZE));
+		h = clamp_t(u32, pix->height, max_t(u32, ref->height / 4, ASC_MIN_SIZE),
+			    min_t(u32, ref->height * 8, ASC_MAX_SIZE));
+	}
 	struct v4l2_pix_format_mplane in = *pix;
 
 	if (!f)
@@ -451,13 +468,13 @@ static int asc_g_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
 
 static int asc_try_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
 {
-	asc_fill(&f->fmt.pix_mp, NULL, V4L2_PIX_FMT_NV12M);
+	asc_fill(&f->fmt.pix_mp, NULL, V4L2_PIX_FMT_NV12M, false);
 	return 0;
 }
 
 static int asc_try_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
 {
-	asc_fill(&f->fmt.pix_mp, &asc_file_to_ctx(file)->src, V4L2_PIX_FMT_ARGB32);
+	asc_fill(&f->fmt.pix_mp, &asc_file_to_ctx(file)->src, V4L2_PIX_FMT_ARGB32, true);
 	return 0;
 }
 
@@ -468,9 +485,9 @@ static int asc_s_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
 	if (vb2_is_busy(v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx)) ||
 	    vb2_is_busy(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
 		return -EBUSY;
-	asc_fill(&f->fmt.pix_mp, NULL, V4L2_PIX_FMT_NV12M);
+	asc_fill(&f->fmt.pix_mp, NULL, V4L2_PIX_FMT_NV12M, false);
 	ctx->src = f->fmt.pix_mp;
-	asc_fill(&ctx->dst, &ctx->src, V4L2_PIX_FMT_ARGB32);
+	asc_fill(&ctx->dst, &ctx->src, V4L2_PIX_FMT_ARGB32, false);
 	return 0;
 }
 
@@ -480,7 +497,7 @@ static int asc_s_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
 
 	if (vb2_is_busy(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
 		return -EBUSY;
-	asc_fill(&f->fmt.pix_mp, &ctx->src, V4L2_PIX_FMT_ARGB32);
+	asc_fill(&f->fmt.pix_mp, &ctx->src, V4L2_PIX_FMT_ARGB32, true);
 	ctx->dst = f->fmt.pix_mp;
 	return 0;
 }
@@ -630,9 +647,9 @@ static int asc_open(struct file *file)
 	ctx->src.width = 1920;
 	ctx->src.height = 1080;
 	ctx->src.pixelformat = V4L2_PIX_FMT_NV12M;
-	asc_fill(&ctx->src, NULL, V4L2_PIX_FMT_NV12M);
+	asc_fill(&ctx->src, NULL, V4L2_PIX_FMT_NV12M, false);
 	ctx->dst.pixelformat = V4L2_PIX_FMT_ARGB32;
-	asc_fill(&ctx->dst, &ctx->src, V4L2_PIX_FMT_ARGB32);
+	asc_fill(&ctx->dst, &ctx->src, V4L2_PIX_FMT_ARGB32, false);
 	v4l2_fh_init(&ctx->fh, video_devdata(file));
 
 	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(asc->m2m_dev, ctx, asc_queue_init);
diff --git a/drivers/media/platform/apple/scaler/apple-scaler-hw.c b/drivers/media/platform/apple/scaler/apple-scaler-hw.c
index 6b8333720c..a41a908577 100644
--- a/drivers/media/platform/apple/scaler/apple-scaler-hw.c
+++ b/drivers/media/platform/apple/scaler/apple-scaler-hw.c
@@ -15,6 +15,7 @@
 #include <linux/math.h>
 #include <linux/minmax.h>
 #include <linux/export.h>
+#include <linux/math.h>
 #include <linux/math64.h>
 #include <linux/module.h>
 #include <linux/string.h>
@@ -358,6 +359,92 @@ static void asc_emit_chroma(struct asc_emit *e, const struct asc_job *job)
 	}
 }
 
+/* Catmull-Rom cubic at x (Q16, x >= 0), in Q16. */
+static s64 asc_cubic(s64 x)
+{
+	s64 x2 = (x * x) >> 16, x3 = (x2 * x) >> 16;
+
+	if (x < 65536)
+		return (3 * x3) / 2 - (5 * x2) / 2 + 65536;
+	if (x < 2 * 65536)
+		return -x3 / 2 + (5 * x2) / 2 - 4 * x + 2 * 65536;
+	return 0;
+}
+
+/**
+ * asc_filter_compute - polyphase filter for one direction
+ * @in: source extent
+ * @out: destination extent
+ * @taps: filter taps (9 vertical, 15 horizontal)
+ * @coef: @taps x 32 coefficients, tap-major, in Q4.12
+ *
+ * The engine's filters have 32 phases: phase p samples at offset p/32 of
+ * a source pixel for p < 16 and (p - 32)/32 for the others, centred on the
+ * middle tap, and every phase sums to 1.0 (layout as m1n1's scaler
+ * experiment records it). The kernel is Catmull-Rom, widened by the
+ * reduction factor when scaling down so that it also filters.
+ */
+void asc_filter_compute(u32 in, u32 out, unsigned int taps, s16 *coef)
+{
+	int c = (taps - 1) / 2;
+
+	for (int p = 0; p < 32; p++) {
+		int off = p < 16 ? p : p - 32;
+		s64 w[15], sum = 0;
+		int big = c, total = 0;
+
+		for (int t = 0; t < (int)taps; t++) {
+			s64 d = abs((t - c) * 32 - off);	/* 1/32 pixel */
+			s64 x = d * 2048;			/* Q16 */
+
+			if (in > out)
+				x = div_u64(x * out, in);
+			w[t] = asc_cubic(x);
+			sum += w[t];
+		}
+		for (int t = 0; t < (int)taps; t++) {
+			coef[t * 32 + p] = sum ? (s16)div64_s64(w[t] * 4096 + sum / 2, sum) : 0;
+			total += coef[t * 32 + p];
+			if (coef[t * 32 + p] > coef[big * 32 + p])
+				big = t;
+		}
+		/* Rounding: every phase must sum to exactly 1.0. */
+		coef[big * 32 + p] += 4096 - total;
+	}
+}
+EXPORT_SYMBOL_IF_KUNIT(asc_filter_compute);
+
+/*
+ * One direction of the scaler with its filter: enable, the ratio in every
+ * ratio word (the 1:1 setup writes one in each), zero initial phase, then
+ * the coefficients, each once per 16-bit half of the first block and two
+ * phases per word in the second.
+ */
+static void asc_emit_scale_dir(struct asc_emit *e, u32 base, u32 flags, u32 in, u32 out,
+			       unsigned int taps)
+{
+	u32 ratio = asc_scale_ratio(in, out);
+	s16 coef[15 * 32];
+	unsigned int i;
+
+	asc_filter_compute(in, out, taps, coef);
+	asc_emit(e, base, flags | BIT(0));
+	asc_emit(e, base + 0x04, 0);
+	asc_emit(e, base + 0x08, 0);
+	asc_emit(e, base + 0x0c, ratio);
+	asc_emit(e, base + 0x10, ratio);
+	asc_emit(e, base + 0x14, ratio);
+	asc_emit(e, base + 0x18, ratio);
+	asc_emit(e, base + 0x1c, 0);
+	asc_emit(e, base + 0x20, ratio);
+	asc_emit(e, base + 0x24, ratio);
+	for (i = 0; i < taps * 32; i++)
+		asc_emit(e, base + 0x400 + 4 * i, ((u32)(u16)coef[i] << 16) | (u16)coef[i]);
+	for (i = 0; i < taps * 16; i++)
+		asc_emit(e, base + 0xc00 + 4 * i,
+			 ((u32)(u16)coef[2 * i + 1] << 16) | (u16)coef[2 * i]);
+}
+
 /* Scaler at 1:1: polyphase filters off, unit ratios, zero initial phase. */
 static void asc_emit_unscaled(struct asc_emit *e, const struct asc_job *job)
 {
@@ -440,8 +527,9 @@ int asc_job_build(const struct asc_job *job, struct asc_reg *w, unsigned int max
 	struct asc_emit e = { .w = w, .max = max };
 	unsigned int i;
 
-	if (!s || !d || job->src.width != job->dst.width ||
-	    job->src.height != job->dst.height)
+	bool scaled = job->src.width != job->dst.width || job->src.height != job->dst.height;
+
+	if (!s || !d || (scaled && !job->scale))
 		return -EINVAL;
 	/* Y'CbCr <-> R'G'B' needs a matrix; same-family jobs must not have one. */
 	if ((s->yuv != d->yuv) != !!job->csc)
@@ -459,7 +547,16 @@ int asc_job_build(const struct asc_job *job, struct asc_reg *w, unsigned int max
 	 */
 	asc_emit(&e, 0x8c, (!d->yuv && !s->alpha ? BIT(31) : 0) | 0xffff);
 	asc_emit_chroma(&e, job);
-	asc_emit_unscaled(&e, job);
+	if (scaled) {
+		u32 flags = job->src.fmt->yuv && job->src.fmt->hsub > 1 ? BIT(1) : 0;
+
+		/* Vertical (0x1000, 9 taps) then horizontal (0x2000, 15 taps). */
+		asc_emit_scale_dir(&e, 0x1000, flags, job->src.height, job->dst.height, 9);
+		asc_emit_scale_dir(&e, 0x2000, flags, job->src.width, job->dst.width, 15);
+		asc_emit(&e, 0x480, 0);
+	} else {
+		asc_emit_unscaled(&e, job);
+	}
 	if (job->csc)
 		asc_emit_csc(&e, job->csc);
 	for (i = 0; i < ARRAY_SIZE(asc_job_fixed); i++)
diff --git a/drivers/media/platform/apple/scaler/apple-scaler-hw.h b/drivers/media/platform/apple/scaler/apple-scaler-hw.h
index 46410b78ea..51ce4a2acc 100644
--- a/drivers/media/platform/apple/scaler/apple-scaler-hw.h
+++ b/drivers/media/platform/apple/scaler/apple-scaler-hw.h
@@ -101,7 +101,8 @@ struct asc_reg {
 };
 
 #define ASC_MAX_PLANES		2
-#define ASC_JOB_MAX_WRITES	224
+/* Same-size jobs need 224 writes; scaling adds the polyphase filters. */
+#define ASC_JOB_MAX_WRITES	(224 + (9 + 15) * 48)
 
 /**
  * struct asc_image - one side of a job
@@ -134,6 +135,7 @@ struct asc_job {
 	const struct asc_csc *csc;
 	u32 transform_id;
 	bool msr20;	/* engine has the MSR20-generation control block */
+	bool scale;	/* source and destination sizes may differ */
 };
 
 int asc_job_build(const struct asc_job *job, struct asc_reg *w, unsigned int max);
@@ -147,5 +149,6 @@ int asc_csc_compute(enum v4l2_ycbcr_encoding enc,
 u32 asc_csc_offset_reg(s32 offset);
 
 u32 asc_scale_ratio(u32 in, u32 out);
+void asc_filter_compute(u32 in, u32 out, unsigned int taps, s16 *coef);
 
 #endif /* APPLE_SCALER_HW_H */
-- 
