From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 9 Nov 2026 23:33:04 +0000
Subject: [PATCH] soc: apple: s2r: keep suspend-to-idle the default mem
 sleep

The M4 GPU driver refuses a sleep that powers the SoC down once its
firmware has run (G16 has no firmware stop and warm restart yet), so
with "deep" as the default every lid close or systemctl suspend on a
J604 with a running desktop fails with -EBUSY instead of sleeping.

Register with suspend_set_ops_keep_s2idle(): "deep" is offered in
/sys/power/mem_sleep for bring-up and suspend-to-idle stays the
default. apple_s2r.default_deep=1 (or mem_sleep_default=deep) makes
"deep" the default once every device can take it.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/soc/apple/Kconfig     |  4 ++++
 drivers/soc/apple/apple-s2r.c | 14 +++++++++++++-
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/apple/Kconfig b/drivers/soc/apple/Kconfig
index 68ee0107e3..2f7e3b6d05 100644
--- a/drivers/soc/apple/Kconfig
+++ b/drivers/soc/apple/Kconfig
@@ -99,6 +99,10 @@ config APPLE_S2R
 	  older firmware the system keeps suspend-to-idle. apple_s2r.enable=0
 	  on the kernel command line keeps suspend-to-idle as well.
 
+	  Suspend-to-idle stays the default mem sleep and "deep" is offered
+	  in /sys/power/mem_sleep; apple_s2r.default_deep=1 or
+	  mem_sleep_default=deep makes "deep" the default.
+
 config APPLE_CLUSTER_PWRGATE
 	bool "Apple SoC CPU cluster power gates"
 	depends on OF
diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 3be5f5aebb..3e7d0363fb 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -549,6 +549,10 @@ static bool bringup_no_fw;
 module_param(bringup_no_fw, bool, 0444);
 MODULE_PARM_DESC(bringup_no_fw, "For bring-up without firmware warm boot support: register anyway, but only run suspend-to-RAM with abort_before set to a step before the clock generators (1-8), so the SoC never goes to sleep (default: off)");
 
+static bool default_deep;
+module_param(default_deep, bool, 0444);
+MODULE_PARM_DESC(default_deep, "Make \"deep\" the default mem sleep; off, suspend-to-idle stays the default and \"deep\" is only offered, as long as a device (the M4 GPU) refuses it once running (default: off)");
+
 static bool spin_instead_of_sleep;
 module_param(spin_instead_of_sleep, bool, 0644);
 MODULE_PARM_DESC(spin_instead_of_sleep, "For bring-up: run every step, arm the watchdog, then spin with interrupts off instead of the final power-down, so only the watchdog can end it; needs wdt_timeout (default: off)");
@@ -1236,7 +1240,15 @@ static int apple_s2r_probe(struct platform_device *pdev)
 	s2r->syscore.data = s2r;
 	register_syscore(&s2r->syscore);
 
-	suspend_set_ops(&apple_s2r_ops);
+	/*
+	 * The M4 GPU firmware has no stop and warm restart yet, so its driver
+	 * refuses a sleep that powers the SoC down once the firmware ran: with
+	 * "deep" as the default every suspend would fail. Offer it only.
+	 */
+	if (default_deep)
+		suspend_set_ops(&apple_s2r_ops);
+	else
+		suspend_set_ops_keep_s2idle(&apple_s2r_ops);
 
 	if (s2r->rvbar_last)
 		apple_s2r_debugfs_init(dev);
