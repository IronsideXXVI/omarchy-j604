 drivers/gpu/drm/asahi/g16/glue.c    | 25 ++++++++++++
 drivers/gpu/drm/asahi/g16/mod.rs    |  1 +
 drivers/gpu/drm/asahi/g16/params.rs | 17 ++++++++
 drivers/gpu/drm/asahi/g16/sleep.rs  | 54 +++++++++++++++++++++++++
 drivers/gpu/drm/asahi/g17/sleep.c   | 61 ++++++++++++++++++++++-------
 drivers/gpu/drm/asahi/g17/sleep.h   |  1 +
 7 files changed, 145 insertions(+), 15 deletions(-)

