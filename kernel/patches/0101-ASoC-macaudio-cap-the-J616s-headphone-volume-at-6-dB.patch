From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jonathan Goyvaerts <jonathan.goyvaerts@gmail.com>
Date: Thu, 22 Oct 2026 19:19:40 -0300
Subject: [PATCH] ASoC: macaudio: cap the J616s headphone volume at -6 dB

The CS42L84 DAC volume goes up to +12 dB, and nothing limits it on the
jack card. Add an optional headphone volume ceiling to the machine
configuration, set through snd_soc_limit_volume() on "Jack DAC Playback
Volume" before the card registers, so userspace sees the capped range
from the start, and the codec refuses writes above it since
commit eaefdaa73035 ("ASoC: cs42l84: honour the platform volume limit").
The card fails to bind if the limit does not apply, as with the speaker
limits.

Cap the J616s jack at -6 dB. Above 0 dB the DAC adds only digital gain,
which clips a full-scale signal. The 6 dB below that are margin: the
analog full scale of this board's headphone output has not been
measured, and macOS adapts it to the headphone impedance it detects,
which this driver does not do.

Signed-off-by: Jonathan Goyvaerts <jonathan.goyvaerts@gmail.com>
Assisted-by: LLM
(cherry picked from commit b7ab2c5c2076b466cc9b6ce7749300ab2fc5dc1c)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 sound/soc/apple/macaudio.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/sound/soc/apple/macaudio.c b/sound/soc/apple/macaudio.c
index 32561ba627..99b79bf733 100644
--- a/sound/soc/apple/macaudio.c
+++ b/sound/soc/apple/macaudio.c
@@ -118,6 +118,11 @@ struct macaudio_platform_cfg {
 	 * for its own card).
 	 */
 	bool fe_cpu_is_platform;
+	/*
+	 * The highest headphone volume, a "Jack DAC Playback Volume" value
+	 * (CS42L84_DAC_DB()), 0 for the codec's own maximum.
+	 */
+	int jack_max_vol;
 };
 
 static const char *volume_control_names[] = {
@@ -140,6 +145,10 @@ static const char *volume_control_names[] = {
 #define MAX98360A_0DB 127
 #define MAX98360A_DB(x) (MAX98360A_0DB + 2 * (x))
 
+/* CS42L84 DAC: 0.5 dB steps from -128 dB, 256 = 0 dB, up to +12 dB */
+#define CS42L84_DAC_0DB 256
+#define CS42L84_DAC_DB(x) (CS42L84_DAC_0DB + 2 * (x))
+
 struct ma_codec_idle {
 	int idle_mode;
 	u32 idle_mask;
@@ -1655,6 +1664,11 @@ static int macaudio_fixup_controls(struct snd_soc_card *card)
 			 "Apple%s", p + 1);
 	}
 
+	/* Before the card registers: userspace never sees the codec's full range */
+	if (ma->cfg->jack_max_vol)
+		CHECK(snd_soc_limit_volume, "Jack DAC Playback Volume",
+		      ma->cfg->jack_max_vol, 1);
+
 	if (!ma->has_speakers)
 		return 0;
 
@@ -2024,6 +2038,13 @@ struct macaudio_platform_cfg macaudio_j616_jack_cfg = {
 	.fe_dai_names = { "j616-jack-pcm-0", "j616-jack-pcm-1" },
 	.dai_fmt = SND_SOC_DAIFMT_DSP_A | SND_SOC_DAIFMT_CBC_CFC | SND_SOC_DAIFMT_IB_NF,
 	.fe_cpu_is_platform = true,
+	/*
+	 * Above 0 dB the DAC only adds digital gain, which clips a full-scale
+	 * signal. The 6 dB below that are margin: the analog full scale of
+	 * this board's headphone output is unmeasured, and macOS adapts it to
+	 * the impedance it detects, which this driver does not.
+	 */
+	.jack_max_vol = CS42L84_DAC_DB(-6),
 };
 
 struct macaudio_platform_cfg macaudio_fallback_cfg = {
