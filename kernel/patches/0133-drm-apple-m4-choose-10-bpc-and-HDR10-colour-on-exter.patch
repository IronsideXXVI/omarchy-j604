From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 20:36:40 +0000
Subject: [PATCH] drm/apple: m4: choose 10 bpc and HDR10 colour on
 external links

A T8132 external output always runs the 8 bpc RGB SDR colour element
of its timing, never deep colour and never PQ, even where the sink's
EDID lets the firmware list them.

Add the pure part of choosing better, for the KUnit suite: the 10 bpc
RGB SDR element and the 10 bpc RGB ST 2084 element in BT.2020 RGB
colorimetry (HDR10) of a timing, without DSC, ranked full range
first; and the choice for a commit: PQ where it asks for PQ in
BT.2020 RGB (refused where the timing has no HDR10 element that fits
the link), else the deepest SDR element up to its max bpc that fits
at 30 bits per pixel, else the 8 bpc element as today. 12 bpc is not
offered. Six new KUnit cases.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/gpu/drm/apple/Makefile                |   1 +
 .../gpu/drm/apple/dcp-m4-ext-colour-test.c    | 193 ++++++++++++++++++
 drivers/gpu/drm/apple/dcp-m4-ext-colour.h     | 142 +++++++++++++
 3 files changed, 336 insertions(+)
 create mode 100644 drivers/gpu/drm/apple/dcp-m4-ext-colour-test.c
 create mode 100644 drivers/gpu/drm/apple/dcp-m4-ext-colour.h

diff --git a/drivers/gpu/drm/apple/Makefile b/drivers/gpu/drm/apple/Makefile
index e13932edbc..31051479c7 100644
--- a/drivers/gpu/drm/apple/Makefile
+++ b/drivers/gpu/drm/apple/Makefile
@@ -34,6 +34,7 @@ appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += dcp-panel-adt-test.o
 appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += dcp-m4-edr-test.o
 appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += dcp-m4-frame-test.o
 appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += dcp-m4-xdr-test.o
+appledrm-$(CONFIG_DRM_APPLE_KUNIT_TEST) += dcp-m4-ext-colour-test.o
 appledrm-y += iomfb_v26_6.o iomfb_v26_6_link.o j613_dcp_activate.o
 appledrm-y += epic/dpavservep.o
 appledrm-y += plane.o
diff --git a/drivers/gpu/drm/apple/dcp-m4-ext-colour-test.c b/drivers/gpu/drm/apple/dcp-m4-ext-colour-test.c
new file mode 100644
index 0000000000..398ff9a11b
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-ext-colour-test.c
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/*
+ * The colour of a T8132 external link (dcp-m4-ext-colour.h): which elements
+ * count as deep SDR or HDR10, and which one a commit runs for its HDR state,
+ * max bpc and the link's capacity.
+ */
+
+#include <kunit/test.h>
+
+#include "dcp-m4-ext-colour.h"
+
+/* A 4K60 timing (594 MHz) on a link of 24 Gbit/s (in kHz x bits). */
+#define CLOCK	594000U
+#define ROOM	(594000ULL * 30)
+#define TIGHT	(594000ULL * 24)
+
+static struct dcp_color_element el(s64 id, s64 depth, s64 eotf, s64 colorimetry)
+{
+	return (struct dcp_color_element){ .id = id, .depth = depth, .eotf = eotf,
+					   .colorimetry = colorimetry, .score = 1,
+					   .encoding = DCP_COLOR_FORMAT_RGB,
+					   .range = DCP_COLOR_YCBCR_RANGE_FULL };
+}
+
+/* A sink with HDR10: an 8 bpc SDR (id 1), 10 bpc SDR (2) and 10 bpc PQ BT.2020 (3) element. */
+static void hdr_sink(struct dcp_m4_ext_colours *c)
+{
+	struct dcp_color_element sdr10 = el(2, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	struct dcp_color_element pq = el(3, 10, DCP_EOTF_ST_2084, DCP_COLORIMETRY_BT2020_RGB);
+
+	*c = (struct dcp_m4_ext_colours){};
+	dcp_m4_ext_colour_take(c, &sdr10);
+	dcp_m4_ext_colour_take(c, &pq);
+}
+
+static void ext_colour_classes(struct kunit *test)
+{
+	struct dcp_color_element e = el(5, 10, DCP_EOTF_ST_2084, DCP_COLORIMETRY_BT2020_RGB);
+
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_colour_pq(&e));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	/* HLG, or PQ in another colorimetry, or at 12 bpc: not HDR10 here. */
+	e.eotf = DCP_EOTF_BT_2100;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_pq(&e));
+	e = el(5, 10, DCP_EOTF_ST_2084, DCP_COLORIMETRY_BT2020_YCC);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_pq(&e));
+	e = el(5, 12, DCP_EOTF_ST_2084, DCP_COLORIMETRY_BT2020_RGB);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_pq(&e));
+	/* DSC, YCbCr, virtual, unsafe, no ID or a negative score: never. */
+	e = el(6, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_colour_sdr10(&e));
+	e.dsc_required = true;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	e = el(6, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	e.encoding = DCP_COLOR_FORMAT_YCBCR444;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	e = el(6, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	e.is_virtual = true;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	e = el(6, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	e.unsafe = true;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	e = el(-1, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	e = el(6, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	e.score = -1;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+	/* 8 bpc is the existing element's, not a deep one. */
+	e = el(6, 8, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_sdr10(&e));
+}
+
+static void ext_colour_takes_the_best(struct kunit *test)
+{
+	struct dcp_m4_ext_colours c = {};
+	struct dcp_color_element a = el(7, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_BT601);
+	struct dcp_color_element b = el(8, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	struct dcp_color_element lim = el(9, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+
+	dcp_m4_ext_colour_take(&c, &a);
+	KUNIT_EXPECT_TRUE(test, c.has_sdr10);
+	KUNIT_EXPECT_EQ(test, c.sdr10.id, 7);
+	/* sRGB over BT.601 at one range. */
+	dcp_m4_ext_colour_take(&c, &b);
+	KUNIT_EXPECT_EQ(test, c.sdr10.id, 8);
+	/* Limited range never over full range. */
+	lim.range = DCP_COLOR_YCBCR_RANGE_LIMITED;
+	lim.score = 100;
+	dcp_m4_ext_colour_take(&c, &lim);
+	KUNIT_EXPECT_EQ(test, c.sdr10.id, 8);
+	/* The same rank: the higher score. */
+	lim = el(10, 10, DCP_EOTF_SDR_GAMMA, DCP_COLORIMETRY_SRGB);
+	lim.score = 5;
+	dcp_m4_ext_colour_take(&c, &lim);
+	KUNIT_EXPECT_EQ(test, c.sdr10.id, 10);
+	KUNIT_EXPECT_FALSE(test, c.has_pq);
+}
+
+static void ext_colour_sdr_is_deep_by_default(struct kunit *test)
+{
+	struct dcp_m4_ext_colours c;
+	struct dcp_m4_ext_want w = { .max_bpc = 10 };
+	struct dcp_m4_ext_choice ch;
+
+	hdr_sink(&c);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, ROOM, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.color, 2U);
+	KUNIT_EXPECT_EQ(test, ch.depth, 10U);
+	KUNIT_EXPECT_FALSE(test, ch.pq);
+	/* max bpc 8 (or unset): the 8 bpc element. */
+	w.max_bpc = 8;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, ROOM, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.color, 1U);
+	KUNIT_EXPECT_EQ(test, ch.depth, 8U);
+	w.max_bpc = 0;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, ROOM, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.depth, 8U);
+}
+
+static void ext_colour_link_bounds_depth(struct kunit *test)
+{
+	struct dcp_m4_ext_colours c;
+	struct dcp_m4_ext_want w = { .max_bpc = 10 };
+	struct dcp_m4_ext_choice ch;
+
+	hdr_sink(&c);
+	/* 24 bits per pixel fit, 30 do not: 8 bpc. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, TIGHT, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.depth, 8U);
+	KUNIT_EXPECT_EQ(test, ch.color, 1U);
+	/* The 8 bpc element needs DSC: no deep element over it. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, true, &c, CLOCK, ROOM, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.depth, 8U);
+	/* Capacity unknown (0): the deep element. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, 0, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.depth, 10U);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_fits_bpp(CLOCK, 30, ROOM));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_fits_bpp(CLOCK, 30, ROOM - 1));
+}
+
+static void ext_colour_pq(struct kunit *test)
+{
+	struct dcp_m4_ext_colours c;
+	struct dcp_m4_ext_want w = { .pq = true, .max_bpc = 10 };
+	struct dcp_m4_ext_choice ch = {};
+
+	hdr_sink(&c);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, ROOM, &ch), 0);
+	KUNIT_EXPECT_EQ(test, ch.color, 3U);
+	KUNIT_EXPECT_EQ(test, ch.depth, 10U);
+	KUNIT_EXPECT_TRUE(test, ch.pq);
+	/* Refused, never SDR in its place: no PQ element, no room, max bpc 8. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, TIGHT, &ch),
+			-EINVAL);
+	w.max_bpc = 8;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, ROOM, &ch),
+			-EINVAL);
+	w.max_bpc = 10;
+	c.has_pq = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_colour_choose(&w, 1, false, &c, CLOCK, ROOM, &ch),
+			-EINVAL);
+}
+
+static void ext_colour_known(struct kunit *test)
+{
+	struct dcp_m4_ext_colours c;
+
+	hdr_sink(&c);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_colour_known(1, 1, &c));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_colour_known(2, 1, &c));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_colour_known(3, 1, &c));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_known(4, 1, &c));
+	c.has_pq = false;
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_colour_known(3, 1, &c));
+}
+
+static struct kunit_case m4_ext_colour_cases[] = {
+	KUNIT_CASE(ext_colour_classes),
+	KUNIT_CASE(ext_colour_takes_the_best),
+	KUNIT_CASE(ext_colour_sdr_is_deep_by_default),
+	KUNIT_CASE(ext_colour_link_bounds_depth),
+	KUNIT_CASE(ext_colour_pq),
+	KUNIT_CASE(ext_colour_known),
+	{}
+};
+
+static struct kunit_suite m4_ext_colour_suite = {
+	.name = "apple-dcp-m4-ext-colour",
+	.test_cases = m4_ext_colour_cases,
+};
+
+kunit_test_suite(m4_ext_colour_suite);
diff --git a/drivers/gpu/drm/apple/dcp-m4-ext-colour.h b/drivers/gpu/drm/apple/dcp-m4-ext-colour.h
new file mode 100644
index 0000000000..a2b4df047f
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-ext-colour.h
@@ -0,0 +1,142 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The colour of a T8132 external output's link (firmware 26.6.2): which of
+ * the colour elements the firmware lists for a timing (from the sink's EDID)
+ * a commit runs, and which bits per pixel that takes on the link.
+ *
+ * Besides the 8 bpc RGB SDR element every offered timing has, a timing may
+ * list a 10 bpc RGB SDR one (deep colour) and, for a sink with HDR, a 10 bpc
+ * RGB ST 2084 (PQ) one in BT.2020 colorimetry (HDR10).  A commit asking for
+ * PQ in BT.2020 RGB (HDR_OUTPUT_METADATA EOTF ST 2084 and Colorspace
+ * BT2020_RGB, as the internal panel takes them) runs the PQ element, and
+ * fails its check where the timing has none; any other commit runs the
+ * deepest SDR element up to its max bpc that fits the link.  Elements that
+ * need DSC are not taken above 8 bpc; 12 bpc is not offered.
+ *
+ * Pure functions, for the KUnit suite.
+ */
+#ifndef APPLE_DCP_M4_EXT_COLOUR_H
+#define APPLE_DCP_M4_EXT_COLOUR_H
+
+#include <linux/errno.h>
+#include <linux/limits.h>
+#include <linux/types.h>
+
+#include "parser.h"
+
+#define DCP_M4_EXT_DEEP_BPC	10U	/* the deepest link depth taken */
+
+/* The deep and the HDR element of one timing, as the firmware lists them. */
+struct dcp_m4_ext_colours {
+	struct dcp_color_element sdr10, pq;
+	bool has_sdr10, has_pq;
+};
+
+/* What a commit asks of the link. */
+struct dcp_m4_ext_want {
+	bool pq;	/* ST 2084 in BT.2020 RGB */
+	u32 max_bpc;	/* the connector's max bpc (0: 8) */
+};
+
+/* The element chosen: its ID, depth and whether it is the PQ one. */
+struct dcp_m4_ext_choice {
+	u32 color, depth;
+	bool pq;
+};
+
+/* An element any choice may take: RGB, real, safe, with an ID and a score. */
+static inline bool dcp_m4_ext_colour_usable(const struct dcp_color_element *e)
+{
+	return !e->is_virtual && !e->unsafe && e->id >= 0 && e->id <= U32_MAX &&
+	       e->score >= 0 && e->encoding == DCP_COLOR_FORMAT_RGB;
+}
+
+/* A 10 bpc SDR element without DSC. */
+static inline bool dcp_m4_ext_colour_sdr10(const struct dcp_color_element *e)
+{
+	return dcp_m4_ext_colour_usable(e) && e->eotf == DCP_EOTF_SDR_GAMMA &&
+	       e->depth == DCP_M4_EXT_DEEP_BPC && !e->dsc_required;
+}
+
+/* A 10 bpc ST 2084 element in BT.2020 RGB colorimetry without DSC. */
+static inline bool dcp_m4_ext_colour_pq(const struct dcp_color_element *e)
+{
+	return dcp_m4_ext_colour_usable(e) && e->eotf == DCP_EOTF_ST_2084 &&
+	       e->colorimetry == DCP_COLORIMETRY_BT2020_RGB &&
+	       e->depth == DCP_M4_EXT_DEEP_BPC && !e->dsc_required;
+}
+
+/* At one depth: full range first, then sRGB/BT.709 colorimetry (SDR), then the score. */
+static inline unsigned int dcp_m4_ext_colour_rank(const struct dcp_color_element *e)
+{
+	return (e->range == DCP_COLOR_YCBCR_RANGE_FULL ? 2 : 0) +
+	       (e->colorimetry == DCP_COLORIMETRY_SRGB ||
+		e->colorimetry == DCP_COLORIMETRY_BT709 ? 1 : 0);
+}
+
+static inline bool dcp_m4_ext_colour_better(const struct dcp_color_element *e,
+					    const struct dcp_color_element *best)
+{
+	unsigned int a = dcp_m4_ext_colour_rank(e), b = dcp_m4_ext_colour_rank(best);
+
+	return a > b || (a == b && e->score > best->score);
+}
+
+/* Take @e into @c where it is a better deep or HDR element. */
+static inline void dcp_m4_ext_colour_take(struct dcp_m4_ext_colours *c,
+					  const struct dcp_color_element *e)
+{
+	if (dcp_m4_ext_colour_sdr10(e) &&
+	    (!c->has_sdr10 || dcp_m4_ext_colour_better(e, &c->sdr10))) {
+		c->sdr10 = *e;
+		c->has_sdr10 = true;
+	}
+	if (dcp_m4_ext_colour_pq(e) && (!c->has_pq || dcp_m4_ext_colour_better(e, &c->pq))) {
+		c->pq = *e;
+		c->has_pq = true;
+	}
+}
+
+/* Whether a timing of @clock kHz fits a link of @capacity (0: unknown) at @bpp. */
+static inline bool dcp_m4_ext_fits_bpp(u32 clock, u32 bpp, u64 capacity)
+{
+	return !capacity || (u64)clock * bpp <= capacity;
+}
+
+/*
+ * The element a commit asking @w runs on a timing of @clock kHz whose 8 bpc
+ * element is @color8 (@dsc: it needs DSC) with the deep and HDR ones of @c,
+ * on a link of @capacity.  -EINVAL: PQ asked, and the timing has no PQ element
+ * that fits.
+ */
+static inline int dcp_m4_ext_colour_choose(const struct dcp_m4_ext_want *w, u32 color8, bool dsc,
+					   const struct dcp_m4_ext_colours *c, u32 clock,
+					   u64 capacity, struct dcp_m4_ext_choice *out)
+{
+	bool fits10 = dcp_m4_ext_fits_bpp(clock, 3 * DCP_M4_EXT_DEEP_BPC, capacity);
+
+	if (w->pq) {
+		if (!c->has_pq || !fits10 || w->max_bpc < DCP_M4_EXT_DEEP_BPC)
+			return -EINVAL;
+		*out = (struct dcp_m4_ext_choice){ .color = (u32)c->pq.id,
+						   .depth = DCP_M4_EXT_DEEP_BPC, .pq = true };
+		return 0;
+	}
+	if (c->has_sdr10 && fits10 && !dsc && w->max_bpc >= DCP_M4_EXT_DEEP_BPC) {
+		*out = (struct dcp_m4_ext_choice){ .color = (u32)c->sdr10.id,
+						   .depth = DCP_M4_EXT_DEEP_BPC };
+		return 0;
+	}
+	*out = (struct dcp_m4_ext_choice){ .color = color8, .depth = 8 };
+	return 0;
+}
+
+/* Whether @color is one of the elements this timing's choices may run. */
+static inline bool dcp_m4_ext_colour_known(u32 color, u32 color8,
+					   const struct dcp_m4_ext_colours *c)
+{
+	return color == color8 || (c->has_sdr10 && color == (u32)c->sdr10.id) ||
+	       (c->has_pq && color == (u32)c->pq.id);
+}
+
+#endif
