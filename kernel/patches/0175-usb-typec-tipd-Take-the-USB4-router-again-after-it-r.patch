From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Tue, 10 Nov 2026 01:13:52 +1100
Subject: [PATCH] usb: typec: tipd: Take the USB4 router again after it
 rebinds

CD321x looks up the USB4/Thunderbolt switch of its router once, at probe
(or when the router binds late). When the router driver unbinds and
binds again, for example "echo 381ac0000.cio > .../unbind" and "bind"
for the Apple ACIO, the old switch is unregistered and the router
registers a new one. CD321x keeps the old handle, every cable update
then fails with -ENODEV, it ends with "cable revalidation failed", and
the port never comes back: the ACIO is not started again, there is no
NHI and no link until a reboot.

Add typec_thunderbolt_switch_is_live() so that a consumer can tell that
the provider of its handle went away. Watch for switch registration on
every port with a router, not only on a port that probed without it.
When the router registers a switch while the one in use is gone, move
the notifier to the new switch, drop the old handle and reapply the
cable state as for a router that binds late.

Assisted-by: LLM
Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
(cherry picked from commit 6c8b0f71ed35db01b335b82d3e31c76d3b9a44e2)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/usb/typec/mux.c                  | 20 ++++++++++++
 drivers/usb/typec/tipd/cd321x-tbt-test.c | 40 ++++++++++++++++++++++++
 drivers/usb/typec/tipd/core.c            | 33 ++++++++++++++-----
 include/linux/usb/typec_mux.h            |  7 +++++
 4 files changed, 93 insertions(+), 7 deletions(-)

diff --git a/drivers/usb/typec/mux.c b/drivers/usb/typec/mux.c
index db28d50cf6..71293c645c 100644
--- a/drivers/usb/typec/mux.c
+++ b/drivers/usb/typec/mux.c
@@ -866,6 +866,26 @@ void typec_thunderbolt_switch_put(struct typec_thunderbolt_switch *sw)
 }
 EXPORT_SYMBOL_GPL(typec_thunderbolt_switch_put);
 
+/**
+ * typec_thunderbolt_switch_is_live - Whether the switch provider is still bound
+ * @sw: USB4/Thunderbolt switch
+ *
+ * A handle outlives the provider: once the provider unregisters its switch,
+ * typec_thunderbolt_switch_set() fails with -ENODEV. A provider that binds
+ * again registers a new switch, which must be looked up again.
+ *
+ * Return: %true if @sw is valid and its provider is still registered.
+ */
+bool typec_thunderbolt_switch_is_live(struct typec_thunderbolt_switch *sw)
+{
+	if (IS_ERR_OR_NULL(sw))
+		return false;
+
+	guard(rwsem_read)(&sw->sw_dev->set_lock);
+	return sw->sw_dev->set;
+}
+EXPORT_SYMBOL_GPL(typec_thunderbolt_switch_is_live);
+
 /**
  * typec_thunderbolt_switch_set - Forward cable details to USB4/Thunderbolt switch
  * @sw: USB4/Thunderbolt switch
diff --git a/drivers/usb/typec/tipd/cd321x-tbt-test.c b/drivers/usb/typec/tipd/cd321x-tbt-test.c
index ee46db0734..5ed8a2ab13 100644
--- a/drivers/usb/typec/tipd/cd321x-tbt-test.c
+++ b/drivers/usb/typec/tipd/cd321x-tbt-test.c
@@ -367,6 +367,45 @@ static void cd321x_tbt_router_binds_after_removal_test(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, cd->tbt_notifier_registered);
 }
 
+/* A router that unbinds and binds again is taken again; the cable is reread. */
+static void cd321x_tbt_router_rebinds_test(struct kunit *test)
+{
+	struct cd321x *cd = cd321x_tbt_test_late_port(test);
+	struct typec_thunderbolt_switch_desc desc = {
+		.fwnode = software_node_fwnode(&cd321x_test_router),
+		.set = cd321x_tbt_test_set,
+		.name = "router-first",
+	};
+	struct typec_thunderbolt_switch_dev *sw_dev;
+	struct device *router;
+	int ret;
+
+	router = kunit_device_register(test, "router-first");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, router);
+	sw_dev = typec_thunderbolt_switch_register(router, &desc);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, sw_dev);
+
+	ret = cd321x_tbt_watch_late(cd, software_node_fwnode(&cd321x_test_connector));
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	flush_work(&cd->tbt_attach_work);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, cd->tbt_switch);
+	KUNIT_EXPECT_TRUE(test, typec_thunderbolt_switch_is_live(cd->tbt_switch));
+	KUNIT_EXPECT_EQ(test, atomic_read(&cd->restore_event), 1);
+	atomic_set(&cd->restore_event, 0);
+
+	typec_thunderbolt_switch_unregister(sw_dev);
+	KUNIT_EXPECT_FALSE(test, typec_thunderbolt_switch_is_live(cd->tbt_switch));
+
+	cd321x_tbt_test_add_router(test, &cd321x_test_router);
+	flush_work(&cd->tbt_attach_work);
+	KUNIT_EXPECT_TRUE(test, typec_thunderbolt_switch_is_live(cd->tbt_switch));
+	KUNIT_EXPECT_TRUE(test, cd->tbt_notifier_registered);
+	KUNIT_EXPECT_EQ(test, atomic_read(&cd->restore_event), 1);
+
+	cd321x_tbt_test_release_port(cd);
+	KUNIT_EXPECT_FALSE(test, cd->tbt_notifier_registered);
+}
+
 static struct kunit_case cd321x_tbt_cases[] = {
 	KUNIT_CASE(cd321x_tbt_no_router_test),
 	KUNIT_CASE(cd321x_tbt_router_bound_test),
@@ -376,6 +415,7 @@ static struct kunit_case cd321x_tbt_cases[] = {
 	KUNIT_CASE(cd321x_tbt_router_bound_before_watch_test),
 	KUNIT_CASE(cd321x_tbt_other_router_binds_test),
 	KUNIT_CASE(cd321x_tbt_router_binds_after_removal_test),
+	KUNIT_CASE(cd321x_tbt_router_rebinds_test),
 	{}
 };
 
diff --git a/drivers/usb/typec/tipd/core.c b/drivers/usb/typec/tipd/core.c
index a6582cf365..1a134c16dd 100644
--- a/drivers/usb/typec/tipd/core.c
+++ b/drivers/usb/typec/tipd/core.c
@@ -2304,20 +2304,25 @@ cd321x_tbt_switch_get(struct device *dev, struct fwnode_handle *fwnode,
 EXPORT_SYMBOL_IF_KUNIT(cd321x_tbt_switch_get);
 
 /*
- * Take a router that bound after the port gave up on it. An attached cable
- * raises no new event, so reapply it through the router as after system sleep.
+ * Take a router that bound after the port gave up on it, or that unbound and
+ * bound again. An attached cable raises no new event, so reapply it through
+ * the router as after system sleep.
  */
 static void cd321x_tbt_attach_work(struct work_struct *work)
 {
 	struct cd321x *cd321x = container_of(work, struct cd321x,
 					    tbt_attach_work);
 	struct tps6598x *tps = &cd321x->tps;
-	struct typec_thunderbolt_switch *sw;
+	struct typec_thunderbolt_switch *sw, *old;
 	int ret;
 
 	scoped_guard(mutex, &tps->lock) {
-		if (cd321x->tbt_switch || cd321x->pm.phase == CD321X_PM_REMOVED)
+		if (cd321x->pm.phase == CD321X_PM_REMOVED)
+			return;
+		/* The router this port uses is still bound. */
+		if (typec_thunderbolt_switch_is_live(cd321x->tbt_switch))
 			return;
+		old = cd321x->tbt_switch;
 	}
 
 	/* Another port's router, or this one is not usable yet: keep watching. */
@@ -2325,6 +2330,13 @@ static void cd321x_tbt_attach_work(struct work_struct *work)
 	if (IS_ERR_OR_NULL(sw))
 		return;
 
+	/* The router went away: its switch sends nothing more, stop listening. */
+	if (old && cd321x->tbt_notifier_registered) {
+		typec_thunderbolt_switch_unregister_notifier(old,
+							     &cd321x->tbt_notifier);
+		cd321x->tbt_notifier_registered = false;
+	}
+
 	ret = typec_thunderbolt_switch_register_notifier(sw,
 							 &cd321x->tbt_notifier);
 	if (ret) {
@@ -2338,7 +2350,9 @@ static void cd321x_tbt_attach_work(struct work_struct *work)
 		cd321x->tbt_switch = sw;
 		cd321x->tbt_notifier_registered = true;
 	}
-	dev_info(tps->dev, "USB4/Thunderbolt router bound, reapplying the cable state\n");
+	typec_thunderbolt_switch_put(old);
+	dev_info(tps->dev, "USB4/Thunderbolt router bound%s, reapplying the cable state\n",
+		 old ? " again" : "");
 	atomic_set(&cd321x->restore_event, 1);
 	mod_delayed_work(system_freezable_wq, &cd321x->resume_work, 0);
 }
@@ -2465,8 +2479,13 @@ cd321x_register_port(struct tps6598x *tps, struct fwnode_handle *fwnode)
 		goto err_put_switch;
 	cd321x->tbt_notifier_registered = true;
 
-	/* Keep the port without the router rather than fail it: see above. */
-	if (tbt_late && cd321x_tbt_watch_late(cd321x, fwnode))
+	/*
+	 * Keep the port without the router rather than fail it: see above. A
+	 * router that is there can also unbind and bind again, which gives it
+	 * a new switch: watch for that as well.
+	 */
+	if ((tbt_late || cd321x->tbt_switch) &&
+	    cd321x_tbt_watch_late(cd321x, fwnode))
 		dev_warn(tps->dev, "cannot watch for the USB4/Thunderbolt router\n");
 
 	return 0;
diff --git a/include/linux/usb/typec_mux.h b/include/linux/usb/typec_mux.h
index ea0d697629..9d1df67201 100644
--- a/include/linux/usb/typec_mux.h
+++ b/include/linux/usb/typec_mux.h
@@ -253,6 +253,7 @@ struct typec_thunderbolt_switch_desc {
 struct typec_thunderbolt_switch *
 fwnode_typec_thunderbolt_switch_get(struct fwnode_handle *fwnode);
 void typec_thunderbolt_switch_put(struct typec_thunderbolt_switch *sw);
+bool typec_thunderbolt_switch_is_live(struct typec_thunderbolt_switch *sw);
 int typec_thunderbolt_switch_set(struct typec_thunderbolt_switch *sw,
 				 const struct typec_thunderbolt_switch_data *data);
 int typec_thunderbolt_switch_register_notifier(struct typec_thunderbolt_switch *sw,
@@ -302,6 +303,12 @@ typec_thunderbolt_switch_register(struct device *parent,
 	return ERR_PTR(-EOPNOTSUPP);
 }
 
+static inline bool
+typec_thunderbolt_switch_is_live(struct typec_thunderbolt_switch *sw)
+{
+	return false;
+}
+
 static inline int
 typec_thunderbolt_switch_register_notifier(struct typec_thunderbolt_switch *sw,
 					   struct notifier_block *nb)
