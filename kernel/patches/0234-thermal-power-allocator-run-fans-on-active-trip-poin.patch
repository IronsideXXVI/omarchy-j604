From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Thu, 29 Oct 2026 09:33:19 +1100
Subject: [PATCH] thermal: power allocator: run fans on active trip points

The power allocator only budgets power actors on its passive trips. A
cooling device without power callbacks, such as a fan, mapped to an
active trip of a zone the power allocator governs was never set, so a
device tree fan curve did nothing on kernels that make it the default
governor.

Run those cooling devices the way the bang-bang governor does: when the
zone reaches an active trip, each such instance asks for its upper
state, and when the zone falls below the trip minus its hysteresis it
asks for nothing. A cooling device mapped to several trips takes the
deepest state asked for, so a ladder of active trips gives a stepped
fan curve. Instances that have no target yet (a cooling device bound
after the zone passed the trip, or after resume) are set from the zone
temperature on the next update. Power actors are left to the power
allocator as before, and zones without active trips are unchanged.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit 55c73c2c1fcf59b3c0895d683a641c1e6b8a6cd0)
Assisted-by: Claude:claude-opus-5.5
---
 drivers/thermal/gov_power_allocator.c | 57 +++++++++++++++++++++++++++
 1 file changed, 57 insertions(+)

diff --git a/drivers/thermal/gov_power_allocator.c b/drivers/thermal/gov_power_allocator.c
index aaa2192dd5..ce9cd7f229 100644
--- a/drivers/thermal/gov_power_allocator.c
+++ b/drivers/thermal/gov_power_allocator.c
@@ -793,6 +793,60 @@ static void power_allocator_unbind(struct thermal_zone_device *tz)
 	tz->governor_data = NULL;
 }
 
+/*
+ * Cooling devices that are not power actors, such as fans, have no power to
+ * allocate, so the governor runs those on active trip points the way the
+ * bang-bang governor does: an instance asks for its upper state once the zone
+ * reaches the trip and for nothing once it drops below the trip's hysteresis.
+ * A cooling device bound to several trips takes the deepest state asked for,
+ * so a ladder of active trips gives a stepped fan curve.
+ */
+static void power_allocator_set_active(struct thermal_instance *instance,
+				       bool on)
+{
+	instance->target = on ? instance->upper : THERMAL_NO_TARGET;
+	instance->initialized = true;
+	thermal_cdev_update_nocheck(instance->cdev);
+}
+
+static void power_allocator_trip_crossed(struct thermal_zone_device *tz,
+					 const struct thermal_trip *trip,
+					 bool upward)
+{
+	const struct thermal_trip_desc *td = trip_to_trip_desc(trip);
+	struct thermal_instance *instance;
+
+	lockdep_assert_held(&tz->lock);
+
+	if (trip->type != THERMAL_TRIP_ACTIVE)
+		return;
+
+	list_for_each_entry(instance, &td->thermal_instances, trip_node)
+		if (!power_actor_is_valid(instance))
+			power_allocator_set_active(instance, upward);
+}
+
+/*
+ * Set up the active trip instances that have no target yet: after a cooling
+ * device binds to a trip the zone already sits above, and after resume.
+ */
+static void power_allocator_init_active(struct thermal_zone_device *tz)
+{
+	const struct thermal_trip_desc *td;
+	struct thermal_instance *instance;
+
+	for_each_trip_desc(tz, td) {
+		if (td->trip.type != THERMAL_TRIP_ACTIVE ||
+		    td->trip.temperature == THERMAL_TEMP_INVALID)
+			continue;
+
+		list_for_each_entry(instance, &td->thermal_instances, trip_node)
+			if (!instance->initialized && !power_actor_is_valid(instance))
+				power_allocator_set_active(instance,
+							   tz->temperature >= td->threshold);
+	}
+}
+
 static void power_allocator_manage(struct thermal_zone_device *tz)
 {
 	struct power_allocator_params *params = tz->governor_data;
@@ -800,6 +854,8 @@ static void power_allocator_manage(struct thermal_zone_device *tz)
 
 	lockdep_assert_held(&tz->lock);
 
+	power_allocator_init_active(tz);
+
 	if (trip && tz->temperature < trip->temperature) {
 		reset_pid_controller(params);
 		allow_maximum_power(tz);
@@ -818,6 +874,7 @@ static struct thermal_governor thermal_gov_power_allocator = {
 	.name		= "power_allocator",
 	.bind_to_tz	= power_allocator_bind,
 	.unbind_from_tz	= power_allocator_unbind,
+	.trip_crossed	= power_allocator_trip_crossed,
 	.manage		= power_allocator_manage,
 	.update_tz	= power_allocator_update_tz,
 };
