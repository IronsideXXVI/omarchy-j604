 .../boot/dts/apple/t6040-gpu-thermal.dtsi      |  7 +++++++
 arch/arm64/boot/dts/apple/t604x-j614-j616.dtsi | 15 +++++++++++++++
 drivers/hwmon/hwmon.c                          |  9 +++++++++
 drivers/hwmon/macsmc-hwmon.c                   | 18 +++++++++++++++---
 5 files changed, 55 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/hwmon/apple,smc-hwmon.yaml b/Documentation/devicetree/bindings/hwmon/apple,smc-hwmon.yaml
index 800ec8af3a..a2a4d3f001 100644
--- a/Documentation/devicetree/bindings/hwmon/apple,smc-hwmon.yaml
+++ b/Documentation/devicetree/bindings/hwmon/apple,smc-hwmon.yaml
@@ -33,6 +33,15 @@ $defs:
       label:
         description: Human-readable name for the sensor
 
+      apple,no-data-below-millicelsius:
+        $ref: /schemas/types.yaml#/definitions/int32
+        description:
+          The SMC publishes a placeholder below this temperature, in
+          millidegrees Celsius, while the sensor is powered down (the GPU
+          temperature sensors of the M4 Pro read -4 to 4 C while the GPU is
+          off). Such readings are reported as no data instead of as a
+          temperature, and a thermal zone on the sensor skips them.
+
     required:
       - apple,key-id
 
diff --git a/arch/arm64/boot/dts/apple/t6040-gpu-thermal.dtsi b/arch/arm64/boot/dts/apple/t6040-gpu-thermal.dtsi
index 74af4a032b..18654e21f3 100644
--- a/arch/arm64/boot/dts/apple/t6040-gpu-thermal.dtsi
+++ b/arch/arm64/boot/dts/apple/t6040-gpu-thermal.dtsi
@@ -1499,35 +1499,42 @@
 	temperature-Tg05 {
 		apple,key-id = "Tg05";
 		label = "GPU Tg05";
+		apple,no-data-below-millicelsius = <10000>;
 	};
 
 	temperature-Tg0S {
 		apple,key-id = "Tg0S";
 		label = "GPU Tg0S";
+		apple,no-data-below-millicelsius = <10000>;
 	};
 
 	temperature-Tg0Y {
 		apple,key-id = "Tg0Y";
 		label = "GPU Tg0Y";
+		apple,no-data-below-millicelsius = <10000>;
 	};
 
 	temperature-Tg0k {
 		apple,key-id = "Tg0k";
 		label = "GPU Tg0k";
+		apple,no-data-below-millicelsius = <10000>;
 	};
 
 	temperature-Tg0z {
 		apple,key-id = "Tg0z";
 		label = "GPU Tg0z";
+		apple,no-data-below-millicelsius = <10000>;
 	};
 
 	temperature-Tg1V {
 		apple,key-id = "Tg1V";
 		label = "GPU Tg1V";
+		apple,no-data-below-millicelsius = <10000>;
 	};
 
 	temperature-Tg1l {
 		apple,key-id = "Tg1l";
 		label = "GPU Tg1l";
+		apple,no-data-below-millicelsius = <10000>;
 	};
 };
