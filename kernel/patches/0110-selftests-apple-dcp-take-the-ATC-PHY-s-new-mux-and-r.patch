From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 16:04:28 +0000
Subject: [PATCH] selftests: apple-dcp: take the ATC PHY's new mux and
 restore helpers

"phy: apple: atc: take the USB controller through hibernation for a
sleep" split atcphy_mux_update() into atcphy_mux_update_to(), with
atcphy_mux_done(), and made atcphy_restore_after_pd_off() call the new
atcphy_forget_common_state(). The host extractors kept taking only the
old functions, so the lifecycle unit probe-mux-pm-dispatch stopped
compiling:

  host.c: call to undeclared function 'atcphy_forget_common_state'
  host.c: call to undeclared function 'atcphy_mux_update_to'

Take the new helpers from the source where it has them: pm.py before
atcphy_mux_update(), phy.py and lifecycle.py before
atcphy_restore_after_pd_off(). No driver change. Sources without the
helpers build as before.

With this the lifecycle group gives the same 33 result lines as before
the ATC sleep series (10 ok, 23 not ok, the 23 failing there already);
quiesce and boot are unchanged.

[j604: the failure is on the ATC PHY branch head 775a031009 too, so it
is not caused by the integration.]

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 tools/testing/selftests/drivers/gpu/apple-dcp/lifecycle.py | 2 +-
 tools/testing/selftests/drivers/gpu/apple-dcp/phy.py       | 3 +++
 tools/testing/selftests/drivers/gpu/apple-dcp/pm.py        | 5 +++++
 3 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/lifecycle.py b/tools/testing/selftests/drivers/gpu/apple-dcp/lifecycle.py
index 5e12168e97..203114198f 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/lifecycle.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/lifecycle.py
@@ -1087,7 +1087,7 @@ def teardown(root):
                 'atcphy_park_pipehandler',
                 'atcphy_get_mode_config', 'atcphy_dp_configure',
                 'j700_field_update', 'j700_aux_disable', 'atcphy_disable_dp_aux',
-                'atcphy_power_off', 'atcphy_power_on', *ATC_POST_TUNABLE, 'atcphy_configure', 'atcphy_restore_after_pd_off',
+                'atcphy_power_off', 'atcphy_power_on', *ATC_POST_TUNABLE, 'atcphy_configure', 'atcphy_forget_common_state', 'atcphy_restore_after_pd_off',
                 'atcphy_usb2_init', 'atcphy_usb3_power_off',
                 'atcphy_usb3_route', 'atcphy_usb3_set_mode', 'atcphy_usb2_power_off',
                 '_atcphy_dwc3_reset_assert', 'atcphy_dwc3_reset_assert', 'atcphy_mux_set'),
diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/phy.py b/tools/testing/selftests/drivers/gpu/apple-dcp/phy.py
index a56a3a3ccf..b882af14b6 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/phy.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/phy.py
@@ -181,6 +181,9 @@ static int __attribute__((unused)) atcphy_configure_pipehandler_usb3_host_t8132(
         parts.append(function(atc, name))
     parts.append(dp)
     parts.append(atc_restore_helpers(atc))
+    # atcphy_restore_after_pd_off() forgets the common block's state through it, where it exists.
+    if 'static void atcphy_forget_common_state(' in atc:
+        parts.append(function(atc, 'atcphy_forget_common_state'))
     for name in ('atcphy_configure_lanes', 'j700_aux_enable', 'j700_aux_disable',
                  'atcphy_enable_dp_aux', 'atcphy_disable_dp_aux', 'atcphy_power_off',
                  'atcphy_power_on', *ATC_POST_TUNABLE, 'atcphy_configure', 'atcphy_set_orientation',
diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/pm.py b/tools/testing/selftests/drivers/gpu/apple-dcp/pm.py
index 92ccae9ed0..545e0e471a 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/pm.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/pm.py
@@ -428,6 +428,11 @@ int main(void)
      helpers+=ns['function'](s,'atcphy_mux_is_noop')+'\n'
      helpers+=''.join(atc_function(s,name) for name in
        ('atcphy_park_retry_delay','atcphy_park_retry','atcphy_park_due','atcphy_mux_change'))
+     # The update body takes a target mode, and an update another one finished is not
+     # repeated (atcphy_mux_update_to(), atcphy_mux_done()), where the source has them.
+     for name in ('atcphy_mux_done','atcphy_mux_update_to'):
+      if re.search(r'^static [^\n]*\b'+name+r'\(',s,re.M):
+       helpers+=ns['function'](s,name)+'\n'
      helpers+=ns['function'](s,'atcphy_mux_update')+'\n'
      # Lane fixtures provide the target mapping and locked body; use the real callback here.
      # The mux callback powers an idle-power-off PHY first; this PHY is not one.
