From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sean Dolbec <sdolbec1@gmail.com>
Date: Wed, 4 Nov 2026 14:50:53 -0500
Subject: [PATCH] soc: apple: pmp: Name the retained T8132 firmware
 predicate

The existing telemetry predicate already selects firmware-qualified T8132,
including J773g, for endpoint 7. Name that condition for reuse by the
PMP and GPU paths; this is a refactoring, not a change in admission.
The misleading J713-only comments are corrected.

A prior J773g bring-up stack required endpoint 7 to complete PMP probe;
the current base already enables it on qualified T8132 machines.

Signed-off-by: Sean Dolbec <sdolbec1@gmail.com>
[dylan: one tool trailer of the original message is not reproduced here]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/pmp-telemetry.c     | 3 ++-
 drivers/soc/apple/pmp.rs              | 4 ++--
 include/linux/soc/apple/pmp-display.h | 7 +++++++
 3 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/drivers/soc/apple/pmp-telemetry.c b/drivers/soc/apple/pmp-telemetry.c
index 7378e3eb8c..4c33f0c472 100644
--- a/drivers/soc/apple/pmp-telemetry.c
+++ b/drivers/soc/apple/pmp-telemetry.c
@@ -12,6 +12,7 @@
 #include <linux/rculist.h>
 #include <linux/platform_device.h>
 #include <linux/slab.h>
+#include <linux/soc/apple/pmp-display.h>
 #include <linux/soc/apple/pmp-telemetry.h>
 #include <linux/soc/apple/pmp-temps.h>
 #include <linux/soc/apple/pmp-power-policy.h>
@@ -24,7 +25,7 @@
  */
 bool apple_pmp_telemetry_retained_board(void)
 {
-	return apple_t8132_firmware_path() && of_machine_is_compatible("apple,t8132");
+	return apple_pmp_t8132_retained_board();
 }
 
 static LIST_HEAD(apple_pmp_telemetry_list);
diff --git a/drivers/soc/apple/pmp.rs b/drivers/soc/apple/pmp.rs
index 337be41924..ee263c9250 100644
--- a/drivers/soc/apple/pmp.rs
+++ b/drivers/soc/apple/pmp.rs
@@ -840,7 +840,7 @@ struct PmpHwConfig {
 enum Ep7 {
     /// Never started.
     No,
-    /// Only on the retained J713 board.
+    /// Only on T8132 boards with a retained, qualified PMP session.
     RetainedBoard,
     /// On every board with this SoC.
     Always,
@@ -970,7 +970,7 @@ fn probe<'bound>(
         }
         data.patch_bootargs(&pmp_mmio, &patches, cfg.check_bootargs_uuid)?;
         // EP7 is a startup dependency on every T6041 PMP, and on the
-        // retained J713 PMP among the T8132 boards.
+        // retained, qualified PMP session among the T8132 boards.
         let needs_coreanalytics = match cfg.coreanalytics {
             Ep7::No => false,
             Ep7::Always => true,
diff --git a/include/linux/soc/apple/pmp-display.h b/include/linux/soc/apple/pmp-display.h
index 56bafd62af..22a2a6e1a8 100644
--- a/include/linux/soc/apple/pmp-display.h
+++ b/include/linux/soc/apple/pmp-display.h
@@ -24,6 +24,13 @@ static inline bool apple_pmp_display_board(void)
 		of_machine_is_compatible("apple,t8132"));
 }
 
+/* T8132 boards on which Linux retains the qualified PMP firmware session. */
+static inline bool apple_pmp_t8132_retained_board(void)
+{
+	return apple_t8132_firmware_path() &&
+	       of_machine_is_compatible("apple,t8132");
+}
+
 struct device;
 struct apple_pmp_display;
 
-- 
2.43.0

