From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 15:03:38 +0000
Subject: [PATCH] media: apple: isp: make macOS's module reads in its
 per-session order

A capture of macOS opening this camera shows two kinds of session. The
first sets the camera up without a stream: it reads the lens shading
polynomials, selects every sensor config, reads the lens limits, the
sensor NVM and the per-module lens shading, loads the setfile, then
reads the zoom, extrinsics, AWB calibration and lens distortion. Every
stream session after it reads none of the NVM or lens shading again:
only the zoom, extrinsics and distortion after the setfile load, and
the distortion, absolute colour calibration, AWB calibration and
rotation correction after selecting its sensor config.

With macos_cal_reads set, the driver read the whole set in every stream
and in an order macOS never uses; on T8132 a read in it timed out and
the stream did not start. Make the first stream after the driver loads
read as macOS's set-up session does, sensor config sweep included, and
every later stream read as macOS's stream sessions do. Still off by
default.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit dc1608996c0224a82e62dc301a83df91a9a0796c)
---
 drivers/media/platform/apple/isp/isp-cam.c | 162 +++++++++++++--------
 drivers/media/platform/apple/isp/isp-drv.h |   2 +
 2 files changed, 102 insertions(+), 62 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index ffbd7115be..bbd2853ab6 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -1257,8 +1257,8 @@ static void isp_setfile_radial_gain(u8 *data, size_t len)
 /*
  * Around loading the setfile macOS reads this camera module's own
  * calibration: the lens shading polynomials of every sensor config, the
- * sensor NVM and the per-module lens shading around it, once a sensor
- * config is selected (the NVM read hangs the firmware before); the AWB
+ * sensor NVM and the per-module lens shading after selecting every sensor
+ * config (the NVM read hangs the firmware before); the AWB
  * calibration matrix, the AWB gains ahead of the CCM and the colour
  * calibration after it, and the lens limits, distortion, extrinsics and
  * rotation correction. The driver reads none of it. If the firmware
@@ -1365,47 +1365,79 @@ enum isp_cal_phase {
 	ISP_CAL_AFTER_SELECT,
 };
 
+#define ISP_CAL_FIRST	BIT(0)	/* the first stream since the driver loaded */
+#define ISP_CAL_LATER	BIT(1)	/* every stream after it */
+#define ISP_CAL_SWEEP	0	/* not a read: select every sensor config */
+
+/*
+ * macOS's module reads, in its order (q9-cam-cmd-3): its first session sets
+ * the camera up without a stream, reading the lens shading polynomials,
+ * selecting every sensor config, then reading the lens limits, the NVM and
+ * the per-module lens shading before the setfile load and the zoom, the
+ * extrinsics, the AWB calibration and the distortion after it. Every
+ * stream session reads only the zoom, extrinsics and distortion after the
+ * load, and the distortion, colour calibration, AWB calibration and
+ * rotation correction after its config select.
+ */
+static const struct isp_cal_read {
+	u16 opcode;
+	u16 len;
+	u16 word_off;
+	u16 count;
+	u32 word;
+	u8 phase;
+	u8 when;
+	bool show;
+	bool all_channels;
+	const char *name;
+} isp_cal_reads[] = {
+	{ CISP_CMD_CH_LSC_POLYNOMIAL_COEFF_GET, 0x48, 0xc, 13, 0,
+	  ISP_CAL_BEFORE_LOAD, ISP_CAL_FIRST, false, false, "LSC polynomial" },
+	{ ISP_CAL_SWEEP, 0, 0, 1, 0,
+	  ISP_CAL_BEFORE_LOAD, ISP_CAL_FIRST, false, false, "config sweep" },
+	{ CISP_CMD_CH_FOCUS_LIMITS_GET, 0x10, 0, 1, 0,
+	  ISP_CAL_BEFORE_LOAD, ISP_CAL_FIRST, true, false, "focus limits" },
+	{ CISP_CMD_CH_SENSOR_NVM_GET, 0x400, 0x10, 1, 0x1c11,
+	  ISP_CAL_BEFORE_LOAD, ISP_CAL_FIRST, false, false, "sensor NVM" },
+	{ CISP_CMD_CH_SENSOR_PERMODULE_LSC_INFO_GET, 0x14, 0, 1, 0,
+	  ISP_CAL_BEFORE_LOAD, ISP_CAL_FIRST, true, false, "module LSC info" },
+	{ CISP_CMD_CH_SENSOR_PERMODULE_LSC_GRID_GET, 0x400, 0, 1, 0,
+	  ISP_CAL_BEFORE_LOAD, ISP_CAL_FIRST, false, false, "module LSC grid" },
+	{ CISP_CMD_CH_MS_SWITCHOVER_ZOOM_FACTOR_GET, 0x10, 0, 1, 0,
+	  ISP_CAL_AFTER_LOAD, ISP_CAL_FIRST | ISP_CAL_LATER, true, false,
+	  "switchover zoom" },
+	{ CISP_CMD_EXTRINSIC_DATA_GET, 0x70, 0, 1, 0,
+	  ISP_CAL_AFTER_LOAD, ISP_CAL_FIRST | ISP_CAL_LATER, false, true,
+	  "extrinsics" },
+	{ CISP_CMD_APPLE_CH_AWB_CALIBRATION_MATRIX_GET, 0x5c, 0, 1, 0,
+	  ISP_CAL_AFTER_LOAD, ISP_CAL_FIRST, true, false, "AWB calibration matrix" },
+	{ CISP_CMD_APPLE_CH_AWB_PRE_CCM_GAIN_GET, 0x18, 0, 1, 0,
+	  ISP_CAL_AFTER_LOAD, ISP_CAL_FIRST, true, false, "AWB pre-CCM gains" },
+	{ CISP_CMD_CH_DISTORTION_DATA_GET, 0x400, 0, 1, 0,
+	  ISP_CAL_AFTER_LOAD, ISP_CAL_FIRST | ISP_CAL_LATER, false, false,
+	  "distortion" },
+	{ CISP_CMD_EXTRINSIC_DATA_GET, 0x70, 0, 1, 0,
+	  ISP_CAL_AFTER_LOAD, ISP_CAL_LATER, false, true, "extrinsics" },
+	{ CISP_CMD_CH_DISTORTION_DATA_GET, 0x400, 0, 1, 0,
+	  ISP_CAL_AFTER_SELECT, ISP_CAL_FIRST | ISP_CAL_LATER, false, false,
+	  "distortion" },
+	{ CISP_CMD_CH_COLOR_CAL_ABS_GET, 0x18, 0, 1, 0,
+	  ISP_CAL_AFTER_SELECT, ISP_CAL_FIRST | ISP_CAL_LATER, true, false,
+	  "colour calibration" },
+	{ CISP_CMD_APPLE_CH_AWB_CALIBRATION_MATRIX_GET, 0x5c, 0, 1, 0,
+	  ISP_CAL_AFTER_SELECT, ISP_CAL_FIRST | ISP_CAL_LATER, true, false,
+	  "AWB calibration matrix" },
+	{ CISP_CMD_CH_IMAGE_ROTATION_CORRECTION_GET, 0x24, 0, 1, 0,
+	  ISP_CAL_AFTER_SELECT, ISP_CAL_FIRST | ISP_CAL_LATER, true, false,
+	  "rotation correction" },
+};
+
 static void isp_ch_macos_cal_reads(struct apple_isp *isp, u32 ch,
 				   enum isp_cal_phase phase)
 {
-	static const struct {
-		u16 opcode;
-		u16 len;
-		u16 word_off;
-		u16 count;
-		u32 word;
-		u8 phase;
-		bool show;
-		const char *name;
-		bool all_channels;
-	} reads[] = {
-		{ CISP_CMD_CH_LSC_POLYNOMIAL_COEFF_GET,
-		  0x48, 0xc, 13, 0, ISP_CAL_BEFORE_LOAD, false, "LSC polynomial" },
-		{ CISP_CMD_CH_SENSOR_NVM_GET,
-		  0x400, 0x10, 1, 0x1c11, ISP_CAL_AFTER_SELECT, false, "sensor NVM" },
-		{ CISP_CMD_CH_SENSOR_PERMODULE_LSC_INFO_GET,
-		  0x14, 0, 1, 0, ISP_CAL_AFTER_SELECT, true, "module LSC info" },
-		{ CISP_CMD_CH_SENSOR_PERMODULE_LSC_GRID_GET,
-		  0x400, 0, 1, 0, ISP_CAL_AFTER_SELECT, false, "module LSC grid" },
-		{ CISP_CMD_CH_FOCUS_LIMITS_GET,
-		  0x10, 0, 1, 0, ISP_CAL_AFTER_SELECT, true, "focus limits" },
-		{ CISP_CMD_CH_MS_SWITCHOVER_ZOOM_FACTOR_GET,
-		  0x10, 0, 2, 0, ISP_CAL_AFTER_LOAD, true, "switchover zoom" },
-		{ CISP_CMD_EXTRINSIC_DATA_GET,
-		  0x70, 0, 3, 0, ISP_CAL_AFTER_LOAD, false, "extrinsics", true },
-		{ CISP_CMD_APPLE_CH_AWB_CALIBRATION_MATRIX_GET,
-		  0x5c, 0, 1, 0, ISP_CAL_AFTER_LOAD, true, "AWB calibration matrix" },
-		{ CISP_CMD_APPLE_CH_AWB_PRE_CCM_GAIN_GET,
-		  0x18, 0, 1, 0, ISP_CAL_AFTER_LOAD, true, "AWB pre-CCM gains" },
-		{ CISP_CMD_CH_DISTORTION_DATA_GET,
-		  0x400, 0, 1, 0, ISP_CAL_AFTER_SELECT, false, "distortion" },
-		{ CISP_CMD_CH_COLOR_CAL_ABS_GET,
-		  0x18, 0, 1, 0, ISP_CAL_AFTER_SELECT, true, "colour calibration" },
-		{ CISP_CMD_CH_IMAGE_ROTATION_CORRECTION_GET,
-		  0x24, 0, 1, 0, ISP_CAL_AFTER_SELECT, true, "rotation correction" },
-	};
-	static bool logged;
+	u8 when = isp->cal_setup_done ? ISP_CAL_LATER : ISP_CAL_FIRST;
 	size_t area = ISP_CMD_AREA_SIZE(isp_num_capmeta(isp));
+	static bool logged;
 	unsigned int i, n;
 	u8 *buf;
 	int err;
@@ -1415,34 +1447,43 @@ static void isp_ch_macos_cal_reads(struct apple_isp *isp, u32 ch,
 	buf = kzalloc(0x400, GFP_KERNEL);
 	if (!buf)
 		return;
-	for (i = 0; i < ARRAY_SIZE(reads); i++) {
-		if (reads[i].phase != phase || reads[i].len > area)
+	for (i = 0; i < ARRAY_SIZE(isp_cal_reads); i++) {
+		const struct isp_cal_read *r = &isp_cal_reads[i];
+
+		if (r->phase != phase || !(r->when & when) || r->len > area)
 			continue;
-		for (n = 0; n < reads[i].count; n++) {
-			u32 word = reads[i].count > 1 ? n : reads[i].word;
-
-			memset(buf, 0, reads[i].len);
-			if (reads[i].word_off)
-				memcpy(buf + reads[i].word_off, &word, sizeof(word));
-			err = isp_cmd_ch_raw_get(isp, reads[i].opcode,
-						 reads[i].all_channels ? U32_MAX : ch,
-						 buf, reads[i].len);
+		if (r->opcode == ISP_CAL_SWEEP) {
+			for (n = 0; n < isp->num_fw_presets; n++)
+				isp_cmd_ch_camera_config_select(isp, ch, n);
+			continue;
+		}
+		for (n = 0; n < r->count; n++) {
+			u32 word = r->count > 1 ? n : r->word;
+
+			memset(buf, 0, r->len);
+			if (r->word_off)
+				memcpy(buf + r->word_off, &word, sizeof(word));
+			err = isp_cmd_ch_raw_get(isp, r->opcode,
+						 r->all_channels ? U32_MAX : ch,
+						 buf, r->len);
 			if (logged)
 				continue;
 			if (err)
 				dev_info(isp->dev, "%s %u: read failed: %d\n",
-					 reads[i].name, n, err);
-			else if (reads[i].show)
-				dev_info(isp->dev, "%s: %*ph\n", reads[i].name,
-					 min(reads[i].len - 8, 64), buf + 8);
+					 r->name, n, err);
+			else if (r->show)
+				dev_info(isp->dev, "%s: %*ph\n", r->name,
+					 min(r->len - 8, 64), buf + 8);
 			else
 				dev_info(isp->dev, "%s %u: %u bytes, hash %08x\n",
-					 reads[i].name, n, reads[i].len - 8,
-					 jhash(buf + 8, reads[i].len - 8, 0));
+					 r->name, n, r->len - 8,
+					 jhash(buf + 8, r->len - 8, 0));
 		}
 	}
-	if (phase == ISP_CAL_AFTER_SELECT)
-		logged = true;
+	if (phase == ISP_CAL_AFTER_SELECT) {
+		logged = isp->cal_setup_done;
+		isp->cal_setup_done = true;
+	}
 	kfree(buf);
 }
 
@@ -1712,10 +1753,7 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	err = isp_cmd_ch_camera_config_select(isp, ch, isp->stream_preset.index);
 	if (err)
 		return err;
-	/*
-	 * The sensor NVM, the module's lens data and its colour calibration can
-	 * be read only once a sensor config is selected.
-	 */
+	/* macOS reads the module's lens and colour data again after this select. */
 	isp_ch_macos_cal_reads(isp, ch, ISP_CAL_AFTER_SELECT);
 
 	err = isp_cmd_ch_buffer_recycle_mode_set(
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 8396c409ba..2aabbcfc22 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -516,6 +516,8 @@ struct apple_isp {
 	struct debugfs_blob_wrapper meta_snap;
 	/* configurations the firmware has, once a deferred start detected them */
 	u32 num_fw_presets;
+	/* macos_cal_reads: the first stream's set-up reads are done */
+	bool cal_setup_done;
 
 	/* stopped for system sleep, to start again on resume */
 	bool fw_sleep_stopped;
-- 
2.43.0

