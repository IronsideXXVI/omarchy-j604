From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 22:21:52 +0000
Subject: [PATCH] drm/apple: m4: power an idle external DCP down and up
 on request

An external DCP's power-down for a sleep that powers the SoC down
(iomfb_m4_ext_power_gate()) brings it to a state it can be woken from
(iomfb_m4_ext_power_ungate()): CPU stopped, firmware DART, PMC
interface enables and dispext domains off, firmware, endpoints and
shared buffers in DRAM. With no display attached it can take that
state while the system runs too.

Add, for the DCP driver:
- iomfb_m4_ext_idle_gate(): completes the driver's inputs with the
  session's (dcp-m4-ext-idle.h) and, if nothing is attached, powers
  the DCP down. A power-down refused before anything changed leaves
  it as it was; one that fails after that fails the session, as for
  a sleep.
- iomfb_m4_ext_idle_wake(): powers it up again, for a request to its
  firmware. Every call of the session to its firmware does the same
  first, so a modeset or a frame never reaches a stopped CPU; a
  message that would anyway is refused with a warning.
- iomfb_m4_ext_idle_down(), for the driver's own sends.
Any power-up, also the one after a sleep, ends the idle power-down.
The sleep and idle paths log which one powered the DCP down or up.
debugfs iomfb_m4 shows the count, the last durations and the reason
on an "ext_idle" line.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
(cherry picked from commit 28c409c8922d1d7706daca7047047d20b775f53b)
---
 drivers/gpu/drm/apple/iomfb_m4.c | 145 +++++++++++++++++++++++++++++--
 drivers/gpu/drm/apple/iomfb_m4.h |  15 ++++
 2 files changed, 152 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index b802628c23..9692e7765b 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -69,6 +69,7 @@
 #include "dcp-m4-xdr.h"
 #include "dcp-m4-ext-colour.h"
 #include "dcp-m4-ext-sink.h"
+#include "dcp-m4-ext-idle.h"
 #include "dcp-hdr-metadata.h"
 #include "parser.h"
 #include "t8132_ext_drm.h"
@@ -306,6 +307,15 @@ struct iomfb_m4 {
 	 * gated says it is down.
 	 */
 	bool ext_gate_capable;
+	/*
+	 * An external DCP powered down with nothing attached
+	 * (iomfb_m4_ext_idle_gate()): written under the lock, read without it
+	 * by the fast path of iomfb_m4_ext_idle_wake(). Any power-up clears it.
+	 */
+	bool ext_idle_gated;
+	u64 ext_idle_cycles, ext_idle_wakes;
+	s64 ext_idle_off_us, ext_idle_on_us;
+	const char *ext_idle_why;
 	struct delayed_work gate_work;
 	u64 gate_cycles;
 	s64 gate_off_us, gate_on_us;
@@ -1416,12 +1426,16 @@ static int dcp_m4_runtime_send(struct dcp_m4_runtime *r, u64 word)
 
 	if (ret)
 		return ret;
+	/* Never to a stopped CPU: every call powers it up first (above). */
+	if (WARN_ON_ONCE(READ_ONCE(dcp->ext_idle_gated)))
+		return -EAGAIN;
 	dma_wmb();
 	return apple_rtkit_send_message(dcp->rtkit, DCP_M4_ENDPOINT, word, NULL, false);
 }
 
 static int dcp_m4_runtime_call(void *cookie, unsigned int method, bool remote,
 				const void *input, u32 input_size, void *output, u32 output_size);
+static int dcp_m4_ext_up(struct iomfb_m4 *dcp);
 
 /*
  * An external DCP's sink description arrives as properties: chunked ones
@@ -2320,6 +2334,12 @@ static int dcp_m4_runtime_call_stream(struct dcp_m4_runtime *r, unsigned int met
 
 	if (method > 999)
 		return -EINVAL;
+	/* An external DCP down with nothing attached: up first. */
+	if (unlikely(READ_ONCE(dcp->ext_idle_gated))) {
+		ret = dcp_m4_ext_up(dcp);
+		if (ret)
+			return ret;
+	}
 	/* The epoch our own call goes out in, for its nested callbacks. */
 	if (!remote) {
 		r->ext_local_calls++;
@@ -4796,7 +4816,7 @@ fail:
  * provider cannot take part nothing changes; a failure after that fails
  * the session.
  */
-static int iomfb_m4_ext_power_gate(struct iomfb_m4 *dcp)
+static int iomfb_m4_ext_power_gate(struct iomfb_m4 *dcp, const char *why)
 {
 	struct dcp_m4_runtime *r = dcp->runtime;
 	unsigned long flags;
@@ -4815,7 +4835,7 @@ static int iomfb_m4_ext_power_gate(struct iomfb_m4 *dcp)
 	      apple_pmc_interface_consumer_check(dcp->dev) ?:
 	      apple_pmgr_ps_consumer_check(dcp->dev);
 	if (ret) {
-		dev_warn(dcp->dev, "sleep: power-down not possible now (%d)\n", ret);
+		dev_warn(dcp->dev, "%s: power-down not possible now (%d)\n", why, ret);
 		return ret;
 	}
 
@@ -4866,7 +4886,7 @@ static int iomfb_m4_ext_power_gate(struct iomfb_m4 *dcp)
 		goto fail;
 	return 0;
 fail:
-	dev_err(dcp->dev, "sleep: power-down failed at %s: %d\n", step, ret);
+	dev_err(dcp->dev, "%s: power-down failed at %s: %d\n", why, step, ret);
 	dcp_m4_failed(dcp, ret);
 	return ret;
 }
@@ -4878,7 +4898,7 @@ fail:
  * its mode from scratch (t8132_ext_sleep_restore()). A failure fails the
  * session: the replay then marks the link BAD.
  */
-static int iomfb_m4_ext_power_ungate(struct iomfb_m4 *dcp)
+static int iomfb_m4_ext_power_ungate(struct iomfb_m4 *dcp, const char *why)
 {
 	const char *step;
 	int ret;
@@ -4903,14 +4923,118 @@ static int iomfb_m4_ext_power_ungate(struct iomfb_m4 *dcp)
 	if (ret)
 		goto fail;
 	WRITE_ONCE(dcp->gated, false);
-	dev_info(dcp->dev, "resume: external display coprocessor up\n");
+	WRITE_ONCE(dcp->ext_idle_gated, false);
+	dev_info(dcp->dev, "%s: external display coprocessor up\n", why);
 	return 0;
 fail:
-	dev_err(dcp->dev, "resume: power-up failed at %s: %d\n", step, ret);
+	dev_err(dcp->dev, "%s: power-up failed at %s: %d\n", why, step, ret);
+	/* Failed for good: no further power-up is tried for it. */
+	WRITE_ONCE(dcp->ext_idle_gated, false);
 	dcp_m4_failed(dcp, ret);
 	return ret;
 }
 
+/*
+ * Up again from an idle power-down, for a request to the firmware: the
+ * caller holds the lock and goes on with its request once this returns 0.
+ */
+static int dcp_m4_ext_up(struct iomfb_m4 *dcp)
+{
+	ktime_t start;
+	int ret;
+
+	lockdep_assert_held(&dcp->lock);
+	if (!dcp->ext_idle_gated)
+		return 0;
+	start = ktime_get();
+	ret = iomfb_m4_ext_power_ungate(dcp, "idle");
+	if (!ret) {
+		dcp->ext_idle_wakes++;
+		dcp->ext_idle_on_us = ktime_us_delta(ktime_get(), start);
+		dcp->ext_idle_why = "up for a request";
+	}
+	return ret;
+}
+
+/*
+ * Nothing attached (dcp-m4-ext-idle.h): @in, the DCP driver's inputs, is
+ * completed with the session's, and if it may the DCP takes its sleep
+ * power-down now. The caller holds the DCP driver's hpd_mutex, so no
+ * connection starts meanwhile; every later request to the firmware powers
+ * it up first (iomfb_m4_ext_idle_wake(), dcp_m4_ext_up()). A power-down
+ * refused before anything changed leaves the DCP as it was; one that
+ * failed after that has failed the session, as for a sleep.
+ */
+enum dcp_m4_ext_idle_verdict
+iomfb_m4_ext_idle_gate(struct apple_dcp *owner, struct dcp_m4_ext_idle_in *in)
+{
+	struct iomfb_m4 *dcp = owner->v26_6;
+	enum dcp_m4_ext_idle_verdict verdict;
+	struct dcp_m4_runtime *r;
+	ktime_t start;
+
+	if (!dcp || !dcp->external)
+		return DCP_M4_EXT_IDLE_NEVER;
+	mutex_lock(&dcp->lock);
+	r = dcp->runtime;
+	in->capable = dcp->ext_gate_capable;
+	/* Pairs with the release store of r->done in startup. */
+	in->session = r && smp_load_acquire(&r->done);
+	in->failed = READ_ONCE(dcp->error) != 0;
+	in->gated = dcp->gated;
+	in->sink = READ_ONCE(dcp->ext_sink) || (r && r->ext_connected);
+	in->powered = r && READ_ONCE(r->ext_powered);
+	in->dart_on = !READ_ONCE(dcp->ext_dart_down);
+	in->busy = (r && r->ext_qn) || dcp->transaction.calls;
+	in->stopping |= READ_ONCE(owner->quiescing);
+	verdict = dcp_m4_ext_idle_check(in);
+	dcp->ext_idle_why = dcp_m4_ext_idle_reason(in);
+	if (verdict != DCP_M4_EXT_IDLE_GATE)
+		goto out;
+	start = ktime_get();
+	if (iomfb_m4_ext_power_gate(dcp, "idle")) {
+		/* Refused: the next event looks again. Failed: never again. */
+		verdict = READ_ONCE(dcp->error) ? DCP_M4_EXT_IDLE_NEVER :
+						   DCP_M4_EXT_IDLE_ATTACHED;
+		dcp->ext_idle_why = READ_ONCE(dcp->error) ? "power-down failed" :
+							    "power-down refused";
+		goto out;
+	}
+	WRITE_ONCE(dcp->ext_idle_gated, true);
+	dcp->ext_idle_cycles++;
+	dcp->ext_idle_off_us = ktime_us_delta(ktime_get(), start);
+	dcp->ext_idle_why = "down";
+	dev_info(dcp->dev,
+		 "idle: nothing attached: external display coprocessor and domains down (%lld us)\n",
+		 dcp->ext_idle_off_us);
+	verdict = DCP_M4_EXT_IDLE_DOWN;
+out:
+	mutex_unlock(&dcp->lock);
+	return verdict;
+}
+
+/* Up again from an idle power-down before a request to its firmware. */
+int iomfb_m4_ext_idle_wake(struct apple_dcp *owner)
+{
+	struct iomfb_m4 *dcp = owner->v26_6;
+	int ret;
+
+	if (!dcp || !dcp->external || !READ_ONCE(dcp->ext_idle_gated))
+		return 0;
+	mutex_lock(&dcp->lock);
+	ret = dcp_m4_ext_up(dcp);
+	mutex_unlock(&dcp->lock);
+	return ret;
+}
+
+/* Down with nothing attached: nothing may reach its firmware now. */
+bool iomfb_m4_ext_idle_down(struct apple_dcp *owner)
+{
+	struct iomfb_m4 *dcp = owner->v26_6;
+
+	return dcp && READ_ONCE(dcp->ext_idle_gated);
+}
+
 static void iomfb_m4_gate_work(struct work_struct *work)
 {
 	struct iomfb_m4 *dcp = container_of(to_delayed_work(work), struct iomfb_m4, gate_work);
@@ -6790,7 +6914,7 @@ static int iomfb_m4_ext_suspend_firmware(struct iomfb_m4 *dcp)
 	if (dcp->rtkit)
 		apple_rtkit_flush_rx(dcp->rtkit);
 	mutex_lock(&dcp->lock);
-	if (!dcp->gated && iomfb_m4_ext_power_gate(dcp))
+	if (!dcp->gated && iomfb_m4_ext_power_gate(dcp, "sleep"))
 		verdict = DCP_M4_FW_SLEEP_GATE_FAILED;
 	if (verdict == DCP_M4_FW_SLEEP_OK) {
 		atomic_inc(&dcp->ext_pm_epoch);
@@ -6881,7 +7005,7 @@ int iomfb_m4_resume(struct apple_dcp *owner)
 		atomic_inc(&dcp->ext_pm_epoch);
 		/* Down for a SoC power-down sleep: up again, in the new epoch. */
 		mutex_lock(&dcp->lock);
-		ret = dcp->gated ? iomfb_m4_ext_power_ungate(dcp) : 0;
+		ret = dcp->gated ? iomfb_m4_ext_power_ungate(dcp, "resume") : 0;
 		mutex_unlock(&dcp->lock);
 		return ret;
 	}
@@ -7016,6 +7140,11 @@ static int iomfb_m4_status_show(struct seq_file *s, void *unused)
 	seq_printf(s, "gate_capable=%u gated=%u gate_cycles=%llu gate_off_us=%lld gate_on_us=%lld\n",
 		   dcp->gate_capable, dcp->gated, dcp->gate_cycles, dcp->gate_off_us,
 		   dcp->gate_on_us);
+	if (dcp->external)
+		seq_printf(s, "ext_idle gate_capable=%u down=%u cycles=%llu wakes=%llu off_us=%lld on_us=%lld why=%s\n",
+			   dcp->ext_gate_capable, dcp->ext_idle_gated, dcp->ext_idle_cycles,
+			   dcp->ext_idle_wakes, dcp->ext_idle_off_us, dcp->ext_idle_on_us,
+			   dcp->ext_idle_why ?: "-");
 	seq_printf(s, "startup=%u background=%u power=%u scanout=%u callbacks=%u\n",
 		   r && r->done, r && r->background_done, r && r->power_done,
 		   r && r->scanout_done, r ? r->callbacks : 0);
diff --git a/drivers/gpu/drm/apple/iomfb_m4.h b/drivers/gpu/drm/apple/iomfb_m4.h
index 8e445a49fb..635362a475 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.h
+++ b/drivers/gpu/drm/apple/iomfb_m4.h
@@ -6,6 +6,8 @@
 #include <linux/errno.h>
 #include <linux/kconfig.h>
 
+#include "dcp-m4-ext-idle.h"
+
 struct apple_dcp;
 struct device;
 struct dentry;
@@ -78,6 +80,11 @@ int iomfb_m4_health(struct apple_dcp *dcp);
 int iomfb_m4_error(struct apple_dcp *dcp);
 bool iomfb_m4_external_ready(struct apple_dcp *dcp);
 void iomfb_m4_external_link_gone(struct apple_dcp *dcp);
+/* An adopted external DCP with nothing attached (dcp-m4-ext-idle.h). */
+enum dcp_m4_ext_idle_verdict
+iomfb_m4_ext_idle_gate(struct apple_dcp *dcp, struct dcp_m4_ext_idle_in *in);
+int iomfb_m4_ext_idle_wake(struct apple_dcp *dcp);
+bool iomfb_m4_ext_idle_down(struct apple_dcp *dcp);
 /* An adopted external DCP's sink, for its DRM connector (t8132_ext_drm.c). */
 int iomfb_m4_ext_detect(struct apple_dcp *dcp);
 int iomfb_m4_ext_get_modes(struct apple_dcp *dcp, struct drm_connector *connector);
@@ -147,6 +154,14 @@ static inline int iomfb_m4_health(struct apple_dcp *dcp) { return -ENODEV; }
 static inline int iomfb_m4_error(struct apple_dcp *dcp) { return -ENODEV; }
 static inline bool iomfb_m4_external_ready(struct apple_dcp *dcp) { return false; }
 static inline void iomfb_m4_external_link_gone(struct apple_dcp *dcp) { }
+static inline enum dcp_m4_ext_idle_verdict
+iomfb_m4_ext_idle_gate(struct apple_dcp *dcp, struct dcp_m4_ext_idle_in *in)
+{
+	return DCP_M4_EXT_IDLE_NEVER;
+}
+
+static inline int iomfb_m4_ext_idle_wake(struct apple_dcp *dcp) { return 0; }
+static inline bool iomfb_m4_ext_idle_down(struct apple_dcp *dcp) { return false; }
 static inline int iomfb_m4_ext_detect(struct apple_dcp *dcp) { return -ENODEV; }
 static inline int iomfb_m4_ext_get_modes(struct apple_dcp *dcp, struct drm_connector *connector)
 {
