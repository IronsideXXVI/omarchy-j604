diff --git a/drivers/gpu/drm/asahi/g17/power.rs b/drivers/gpu/drm/asahi/g17/power.rs
index b0e21e70bb..c0ec972bf6 100644
--- a/drivers/gpu/drm/asahi/g17/power.rs
+++ b/drivers/gpu/drm/asahi/g17/power.rs
@@ -260,3 +260,43 @@ mod tests {
         assert_eq!(hold.step(1, false, 2, FIRMWARE_IDLE_OFF_MS), HoldAction::Release);
     }
 }
+
+unsafe extern "C" {
+    fn asahi_clpc_gpu_get(dev: *mut kernel::bindings::device, out: *mut *mut core::ffi::c_void) -> core::ffi::c_int;
+    fn asahi_clpc_gpu_set_active(gpu: *mut core::ffi::c_void, active: bool);
+    fn asahi_clpc_gpu_put(gpu: *mut core::ffi::c_void);
+}
+
+/// DT-selected memory-demand provider. Its independent allocation outlives a
+/// detached provider; a device link orders supplier removal and suspend.
+pub(super) struct Demand(*mut core::ffi::c_void);
+
+// SAFETY: the provider's leaf spinlock serializes all access; no GPU callback.
+unsafe impl Send for Demand {}
+// SAFETY: shared access only changes that locked request, never its lifetime.
+unsafe impl Sync for Demand {}
+
+impl Demand {
+    pub(super) fn new(dev: *mut kernel::bindings::device) -> kernel::error::Result<Self> {
+        let mut out = core::ptr::null_mut();
+        // SAFETY: live platform device and writable result; C returns an owned reference.
+        let ret = unsafe { asahi_clpc_gpu_get(dev, &mut out) };
+        if ret < 0 {
+            Err(kernel::error::Error::from_errno(ret))
+        } else {
+            Ok(Self(out))
+        }
+    }
+
+    pub(super) fn set_active(&self, active: bool) {
+        // SAFETY: the retained reference is live; NULL denotes no DT provider.
+        unsafe { asahi_clpc_gpu_set_active(self.0, active) };
+    }
+}
+
+impl Drop for Demand {
+    fn drop(&mut self) {
+        // SAFETY: releases exactly the reference returned by get, clearing demand first.
+        unsafe { asahi_clpc_gpu_put(self.0) };
+    }
+}
diff --git a/drivers/soc/apple/clpc.c b/drivers/soc/apple/clpc.c
index 50b4eed1bd..1e7dab92d8 100644
--- a/drivers/soc/apple/clpc.c
+++ b/drivers/soc/apple/clpc.c
@@ -21,6 +21,12 @@
  */
 
 #include <linux/cpufreq.h>
+#include <linux/kref.h>
+#include <linux/ktime.h>
+#include <linux/of_platform.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/soc/apple/clpc.h>
 #include <linux/debugfs.h>
 #include <linux/jiffies.h>
 #include <linux/kernel.h>
@@ -90,6 +96,15 @@ struct apple_clpc_vote {
 	unsigned long last_demand;
 };
 
+/* Independent lifetime: a late consumer put never dereferences a removed provider. */
+struct apple_clpc_gpu {
+	struct kref ref;
+	spinlock_t lock;
+	bool active;
+	u64 updated_ns;
+	u64 sequence;
+};
+
 struct apple_clpc {
 	struct device *dev;
 	struct device *pmc;
@@ -113,6 +128,10 @@ struct apple_clpc {
 	unsigned long gpu_read_errors;
 	struct dentry *debugfs;
 	struct regmap *gpu_pmgr;
+	struct apple_clpc_gpu *gpu;
+	u32 last_floor;
+	u32 last_reason;
+	u64 last_vote_ns;
 	u32 gpu_offset;
 	/* Graphics powered at the last sample, since when, and that sample's time */
 	bool gpu_on;
@@ -130,6 +149,92 @@ struct apple_clpc {
 	unsigned long gpu_floor_returns;
 };
 
+static void apple_clpc_gpu_free(struct kref *ref)
+{
+	kfree(container_of(ref, struct apple_clpc_gpu, ref));
+}
+
+void apple_clpc_gpu_set_active(struct apple_clpc_gpu *gpu, bool active)
+{
+	unsigned long flags;
+
+	if (!gpu)
+		return;
+	spin_lock_irqsave(&gpu->lock, flags);
+	gpu->active = active;
+	gpu->updated_ns = ktime_get_mono_fast_ns();
+	gpu->sequence++;
+	spin_unlock_irqrestore(&gpu->lock, flags);
+}
+EXPORT_SYMBOL_GPL(apple_clpc_gpu_set_active);
+
+void apple_clpc_gpu_put(struct apple_clpc_gpu *gpu)
+{
+	if (gpu) {
+		apple_clpc_gpu_set_active(gpu, false);
+		kref_put(&gpu->ref, apple_clpc_gpu_free);
+	}
+}
+EXPORT_SYMBOL_GPL(apple_clpc_gpu_put);
+
+int apple_clpc_gpu_get(struct device *dev, struct apple_clpc_gpu **out)
+{
+	struct device_node *np;
+	struct platform_device *provider;
+	struct apple_clpc *clpc;
+	struct device_link *link;
+	int ret = -EPROBE_DEFER;
+
+	*out = NULL;
+	np = of_parse_phandle(dev->of_node, "apple,clpc", 0);
+	if (!np)
+		return of_find_property(dev->of_node, "apple,clpc", NULL) ? -EINVAL : 0;
+	if (!of_device_is_compatible(np, "apple,t6040-clpc")) {
+		of_node_put(np);
+		return -EINVAL;
+	}
+	provider = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!provider)
+		return ret;
+	link = device_link_add(dev, &provider->dev, DL_FLAG_AUTOREMOVE_CONSUMER);
+	if (!link) {
+		put_device(&provider->dev);
+		return -ENOMEM;
+	}
+	device_lock(&provider->dev);
+	clpc = device_is_bound(&provider->dev) ? dev_get_drvdata(&provider->dev) : NULL;
+	if (clpc && clpc->gpu && refcount_read(&clpc->gpu->ref.refcount) == 1) {
+		kref_get(&clpc->gpu->ref);
+		*out = clpc->gpu;
+		ret = 0;
+	}
+	device_unlock(&provider->dev);
+	put_device(&provider->dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_clpc_gpu_get);
+
+static bool apple_clpc_gpu_active(struct apple_clpc_gpu *gpu, u64 *updated, u64 *sequence)
+{
+	unsigned long flags;
+	bool active;
+
+	spin_lock_irqsave(&gpu->lock, flags);
+	active = gpu->active;
+	*updated = gpu->updated_ns;
+	*sequence = gpu->sequence;
+	spin_unlock_irqrestore(&gpu->lock, flags);
+	return active;
+}
+
+static void apple_clpc_gpu_owner_put(void *data)
+{
+	struct apple_clpc_gpu *gpu = data;
+
+	kref_put(&gpu->ref, apple_clpc_gpu_free);
+}
+
 /* cpufreq policies can appear after probe; pick up new ones as they do. */
 static void apple_clpc_find_clusters(struct apple_clpc *clpc)
 {
@@ -333,6 +438,7 @@ static void apple_clpc_sample(struct apple_clpc *clpc)
 	unsigned int state[APPLE_CLPC_RAILS];
 	unsigned long now = jiffies;
 	unsigned int i, rail;
+	u32 reason = 0, floor;
 
 	clpc->samples++;
 	if (!cpumask_equal(clpc->covered, cpu_possible_mask) &&
@@ -348,22 +454,42 @@ static void apple_clpc_sample(struct apple_clpc *clpc)
 		for (rail = 0; rail < APPLE_CLPC_RAILS; rail++)
 			demand[rail] = max(demand[rail], cl->request[rail]);
 	}
+	for (rail = 0; rail < APPLE_CLPC_RAILS; rail++)
+		if (demand[rail])
+			reason |= 1;
+	if (clpc->gpu && !clpc->hw->gpu_demand) {
+		u64 updated, sequence;
+
+		if (apple_clpc_gpu_active(clpc->gpu, &updated, &sequence)) {
+			reason |= 2;
+			for (rail = 0; rail < APPLE_CLPC_RAILS; rail++)
+				demand[rail] = max(demand[rail],
+						clpc->hw->map[rail][APPLE_CLPC_LEVELS - 1]);
+		}
+	}
 	if (clpc->gpu_pmgr && apple_clpc_gpu_streaming(clpc, now)) {
 		bool released = apple_clpc_gpu_limited(clpc, now);
 
 		apple_clpc_gpu_floor_count(clpc, released);
-		if (!released)
+		if (!released) {
+			reason |= 4;
 			for (rail = 0; rail < APPLE_CLPC_RAILS; rail++)
 				demand[rail] = max(demand[rail],
 						   clpc->hw->gpu[rail]);
+		}
 	}
 
 	for (rail = 0; rail < APPLE_CLPC_RAILS; rail++)
 		state[rail] = apple_clpc_vote(&clpc->vote[rail], demand[rail],
 					      now);
 
-	if (apple_pmc_floor_update(clpc->pmc, clpc->agent, clpc->mask,
-				   apple_clpc_floor(clpc, state)))
+	floor = apple_clpc_floor(clpc, state);
+	if (!reason && floor)
+		reason = 16;
+	clpc->last_floor = floor;
+	clpc->last_reason = reason;
+	clpc->last_vote_ns = ktime_get_mono_fast_ns();
+	if (apple_pmc_floor_update(clpc->pmc, clpc->agent, clpc->mask, floor))
 		clpc->update_errors++;
 
 	/* Sample on time while graphics is powered, to see it power off. */
@@ -398,6 +524,16 @@ static int apple_clpc_status_show(struct seq_file *s, void *unused)
 						   clpc->hw->rail[rail]),
 			   clpc->hw->map[rail][0], clpc->hw->map[rail][1],
 			   clpc->hw->map[rail][2], clpc->hw->map[rail][3]);
+	seq_printf(s, "last_vote: %#x reason_bits %#x sampled_ns %llu (cpu=1 host_gpu=2 streaming_gpu=4 hold=16)\n",
+		   READ_ONCE(clpc->last_floor), READ_ONCE(clpc->last_reason),
+		   READ_ONCE(clpc->last_vote_ns));
+	if (clpc->gpu) {
+		u64 updated, sequence;
+		bool active = apple_clpc_gpu_active(clpc->gpu, &updated, &sequence);
+
+		seq_printf(s, "host_gpu: active %u request_ns %llu sequence %llu\n",
+			   active, updated, sequence);
+	}
 	seq_printf(s, "samples: %lu update errors: %lu gpu read errors: %lu\n",
 		   clpc->samples, clpc->update_errors, clpc->gpu_read_errors);
 	if (clpc->gpu_pmgr) {
@@ -476,6 +612,19 @@ static int apple_clpc_probe(struct platform_device *pdev)
 	clpc->dev = dev;
 	clpc->pmc = dev->parent;
 	clpc->hw = of_device_get_match_data(dev);
+	/* T6040 firmware keeps GFX powered for its whole lifetime. A separate
+	 * host publication/idle input, not that supplier state, drives demand.
+	 */
+	if (of_device_is_compatible(dev->of_node, "apple,t6040-clpc")) {
+		clpc->gpu = kzalloc_obj(*clpc->gpu);
+		if (!clpc->gpu)
+			return -ENOMEM;
+		kref_init(&clpc->gpu->ref);
+		spin_lock_init(&clpc->gpu->lock);
+		ret = devm_add_action_or_reset(dev, apple_clpc_gpu_owner_put, clpc->gpu);
+		if (ret)
+			return ret;
+	}
 	/* The property is optional: without it, CPU demand alone sets the floors. */
 	if (clpc->hw->gpu_demand)
 		gpu = of_parse_phandle(dev->of_node, "apple,gpu-power-state", 0);
@@ -631,7 +780,8 @@ static const struct apple_clpc_hw apple_clpc_hw_t8140 = {
  * a single busy sample raised the floor about 60 % of the time, from short
  * bursts of background work; three in a row bring that to about 11 %.
  * GPU demand bypasses the CPU streak and uses the same qualified DCS 5 /
- * fabric 2 states until the graphics state powers off and HOLD_MS expires.
+ * fabric 2 states until publication/in-flight demand ends and HOLD_MS expires.
+ * GFX supplier power cannot drive this input: firmware keeps it always on.
  */
 static const struct apple_clpc_hw apple_clpc_hw_t6040 = {
 	.rail = { [APPLE_CLPC_DCS] = 0, [APPLE_CLPC_SOC] = 1 },
@@ -640,7 +790,7 @@ static const struct apple_clpc_hw apple_clpc_hw_t6040 = {
 		[APPLE_CLPC_SOC] = { 0, 1, 2, 2 },
 	},
 	.sustain = 3,
-	.gpu_demand = true,
+	.gpu_demand = false,
 };
 
 static const struct of_device_id apple_clpc_of_match[] = {
diff --git a/include/linux/soc/apple/clpc.h b/include/linux/soc/apple/clpc.h
new file mode 100644
index 0000000000..37b2cfce55
--- /dev/null
+++ b/include/linux/soc/apple/clpc.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef _LINUX_SOC_APPLE_CLPC_H
+#define _LINUX_SOC_APPLE_CLPC_H
+
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/property.h>
+
+struct apple_clpc_gpu;
+
+#if IS_REACHABLE(CONFIG_APPLE_CLPC)
+int apple_clpc_gpu_get(struct device *dev, struct apple_clpc_gpu **out);
+void apple_clpc_gpu_set_active(struct apple_clpc_gpu *gpu, bool active);
+void apple_clpc_gpu_put(struct apple_clpc_gpu *gpu);
+#else
+static inline int apple_clpc_gpu_get(struct device *dev, struct apple_clpc_gpu **out)
+{
+	*out = NULL;
+	return device_property_present(dev, "apple,clpc") ? -ENODEV : 0;
+}
+static inline void apple_clpc_gpu_set_active(struct apple_clpc_gpu *gpu, bool active) {}
+static inline void apple_clpc_gpu_put(struct apple_clpc_gpu *gpu) {}
+#endif
+#endif
