+static int dcp_m4_runtime_callback(struct dcp_m4_runtime *r, u64 word);
+static int dcp_m4_runtime_drain(struct dcp_m4_runtime *r, unsigned int budget);
+static u32 dcp_m4_live_rate(struct dcp_m4_runtime *r);
+
+/*
+ * int_async_flip. The internal panel's present returns once the firmware has
+ * accepted its swap (A407); the swap waits in r->int_fl, at most one, until
+ * its D590, which puts its frame on screen and sends the flip event. The
+ * previous frame stays dcp->active_fb, referenced, until then: it is scanned
+ * out until the D590, and DRM hands it back to the compositor with the flip
+ * event, so it is handed back only once off screen. Every other host call
+ * first waits for that D590 (dcp_m4_int_settle()), so the firmware never has
+ * two internal swaps open, as with the synchronous path.
+ */
+
+/* Framebuffers retired by a D590, put outside dcp->lock. */
+static void iomfb_m4_retire_work(struct work_struct *work)
+{
+	struct iomfb_m4 *dcp = container_of(work, struct iomfb_m4, retire_work);
+	struct drm_framebuffer *q[ARRAY_SIZE(dcp->retire_q)];
+	unsigned int n, i;
+
+	spin_lock_irq(&dcp->retire_lock);
+	n = dcp->retire_n;
+	memcpy(q, dcp->retire_q, n * sizeof(*q));
+	dcp->retire_n = 0;
+	spin_unlock_irq(&dcp->retire_lock);
+	for (i = 0; i < n; i++)
+		drm_framebuffer_put(q[i]);
+}
+
+/* False when the queue is full: the caller keeps the reference. */
+static bool iomfb_m4_retire(struct iomfb_m4 *dcp, struct drm_framebuffer *fb)
+{
+	bool queued = true;
+
+	if (!fb)
+		return true;
+	spin_lock_irq(&dcp->retire_lock);
+	if (dcp->retire_n < ARRAY_SIZE(dcp->retire_q))
+		dcp->retire_q[dcp->retire_n++] = fb;
+	else
+		queued = false;
+	spin_unlock_irq(&dcp->retire_lock);
+	if (queued)
+		schedule_work(&dcp->retire_work);
+	else
+		dev_warn_ratelimited(dcp->dev, "retire queue full: a framebuffer kept until teardown\n");
+	return queued;
+}
+
+/*
+ * The panel's refresh count at @t: the last one plus the refreshes since the
+ * last flip at the running rate, at least one more. Counted from flip to
+ * flip, so that rounding never accumulates.
+ */
+static u64 dcp_m4_int_seq(struct dcp_m4_runtime *r, ktime_t t)
+{
+	u32 rate = dcp_m4_live_rate(r);
+	u64 period = rate ? div_u64((u64)NSEC_PER_SEC << 16, rate) : 0;
+	u64 n = 1;
+
+	if (period && r->seq_last_kt && ktime_after(t, r->seq_last_kt))
+		n = max_t(u64, 1, div64_u64(ktime_to_ns(ktime_sub(t, r->seq_last_kt)) +
+					      period / 2, period));
+	r->seq_last += n;
+	r->seq_last_kt = t;
+	return r->seq_last;
+}
+
+/*
+ * The open swap's D590 is in (dcp->lock held): its frame is on screen, or the
+ * firmware kept the one before (D590 +0x4 = 0). Promote it, keep every frame
+ * that may still be on screen, retire the rest, and send the flip event.
+ */
+static void dcp_m4_int_flight_finish(struct dcp_m4_runtime *r)
+{
+	struct iomfb_m4 *dcp = r->dcp;
+	struct apple_crtc *crtc = READ_ONCE(dcp->owner->crtc);
+	bool shown = !r->int_shown_valid || r->int_shown;
+	struct drm_framebuffer *old = dcp->active_fb;
+	ktime_t t = r->int_done_kt ?: ktime_get();
+
+	r->int_fl.open = false;
+	cancel_delayed_work(&r->int_fl_work);
+	if (shown) {
+		if (!iomfb_m4_retire(dcp, old))
+			old = NULL;
+		if (iomfb_m4_retire(dcp, dcp->lost_fb))
+			dcp->lost_fb = NULL;
+		if (iomfb_m4_retire(dcp, dcp->extra_fb))
+			dcp->extra_fb = NULL;
+		dcp->active_unshown = false;
+	} else {
+		/* What is on screen: the last displayed frame, kept. */
+		r->int_async_unshown++;
+		dev_info_ratelimited(dcp->dev, "swap %u: its D590 says not displayed: the frame on screen stays\n",
+				     r->int_fl.swap.id);
+		if (dcp->active_unshown)
+			iomfb_m4_retire(dcp, old);
+		else if (!dcp->lost_fb)
+			dcp->lost_fb = old;
+		else if (!dcp->extra_fb)
+			dcp->extra_fb = old;
+		else
+			dcp->uncertain_fb = old;
+		dcp->active_unshown = true;
+	}
+	dcp->active_fb = r->int_fl.fb;
+	dcp->active_frame = r->int_fl.frame;
+	r->int_fl.fb = NULL;
+	dcp->flips++;
+	r->int_async_flips++;
+	if (r->prec_cur.reply_cnt && r->prec_cur.id == r->int_fl.swap.id) {
+		r->prec_cur.done_cnt = READ_ONCE(r->int_done_cnt);
+		r->prec_cur.flip_cnt = __arch_counter_get_cntpct();
+		r->prec_cur.flip_ns = ktime_get_ns();
+		r->prec[r->prec_count++ % DCP_M4_PREC_N] = r->prec_cur;
+		r->prec_cur.start_cnt = 0;
+		r->prec_cur.reply_cnt = 0;
+	}
+	if (crtc)
+		dcp_drm_crtc_vblank_at(crtc, dcp_m4_int_seq(r, t), t);
+}
+
+static int dcp_m4_int_flight_done(struct dcp_m4_runtime *r)
+{
+	int ret = dcp_m4_swap_record_done(&r->int_fl.swap, r->int_fl.swap.id);
+
+	if (!ret && dcp_m4_swap_take_completion(&r->int_fl.swap) != 1)
+		ret = -EPROTO;
+	if (ret)
+		return ret;
+	dcp_m4_int_flight_finish(r);
+	return 0;
+}
+
+/*
+ * The open swap's D590 never came (its deadline), or the session failed: as
+ * the synchronous path would, the session fails; both frames are kept (no
+ * release receipt for either), and the flip is sent as lost.
+ */
+static void dcp_m4_int_flight_lost(struct dcp_m4_runtime *r, int error)
+{
+	struct iomfb_m4 *dcp = r->dcp;
+	struct apple_crtc *crtc = READ_ONCE(dcp->owner->crtc);
+
+	if (!r->int_fl.open)
+		return;
+	r->int_fl.open = false;
+	r->int_async_lost++;
+	cancel_delayed_work(&r->int_fl_work);
+	if (!dcp->uncertain_fb)
+		dcp->uncertain_fb = r->int_fl.fb;
+	else if (!dcp->extra_fb)
+		dcp->extra_fb = r->int_fl.fb;
+	r->int_fl.fb = NULL;
+	dev_err(dcp->dev, "swap %u: no D590 after its A407: %d\n", r->int_fl.swap.id, error);
+	if (crtc)
+		dcp_drm_crtc_error(crtc, NULL, error);
+	dcp_m4_swap_fail(&r->int_fl.swap, error);
+	dcp_m4_transaction_fail(&dcp->transaction, error);
+	dcp_m4_failed(dcp, error);
+}
+
+/* Before any other host call: the open swap's D590, or its deadline. */
+static int dcp_m4_int_settle(struct dcp_m4_runtime *r)
+{
+	unsigned long deadline = r->deadline, limit = r->limit;
+	u64 word;
+	int ret = 0;
+
+	r->int_async_settled++;
+	r->deadline = r->int_fl.deadline;
+	r->limit = 0;
+	while (!ret && r->int_fl.open) {
+		ret = dcp_m4_runtime_next(r, &word, true);
+		if (!ret)
+			ret = dcp_m4_runtime_callback(r, word);
+	}
+	r->deadline = deadline;
+	r->limit = limit;
+	if (ret)
+		dcp_m4_int_flight_lost(r, ret);
+	return ret;
+}
+
+/* The open swap at its deadline: words already in first, then given up. */
+static void dcp_m4_int_fl_work(struct work_struct *work)
+{
+	struct dcp_m4_runtime *r = container_of(to_delayed_work(work), struct dcp_m4_runtime,
+						int_fl_work);
+	struct iomfb_m4 *dcp = r->dcp;
+	int ret;
+
+	mutex_lock(&dcp->lock);
+	if (r->int_fl.open) {
+		ret = READ_ONCE(dcp->error) ?: dcp_m4_runtime_drain(r, 32);
+		if (r->int_fl.open && (ret < 0 || time_after_eq(jiffies, r->int_fl.deadline)))
+			dcp_m4_int_flight_lost(r, ret < 0 ? ret : -ETIMEDOUT);
+		else if (r->int_fl.open)
+			queue_delayed_work(r->wq, &r->int_fl_work,
+					   max_t(long, (long)(r->int_fl.deadline - jiffies), 1));
+	}
+	mutex_unlock(&dcp->lock);
+}
+
 static int dcp_m4_runtime_swap_done(void *cookie, u32 id)
 {
 	struct dcp_m4_runtime *r = cookie;
@@ -1941,8 +2200,12 @@ static int dcp_m4_runtime_swap_done(void *cookie, u32 id)
 		/* The late D590 of a probe given up is not this swap's. */
 		if (dcp_m4_int_late_d590(r, id))
