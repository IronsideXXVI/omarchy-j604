 	return dcp_m4_runtime_call_stream(cookie, method, 0, remote, input, input_size,
 					  output, output_size);
 }
@@ -3068,6 +3340,31 @@ static int dcp_m4_runtime_swap_full(struct dcp_m4_runtime *r, bool primary,
 		r->prec_cur.reply_cnt = __arch_counter_get_cntpct();
