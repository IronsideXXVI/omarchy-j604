+/*
+ * The pending flip event of @crtc, with the refresh count @seq and the time
+ * @when its frame went on screen (CLOCK_MONOTONIC), for a driver without
+ * drm_vblank_init(), whose events would say 0 and the time of sending.
+ */
+void dcp_drm_crtc_vblank_at(struct apple_crtc *crtc, u64 seq, ktime_t when)
+{
+	struct drm_device *dev = crtc->base.dev;
+	struct drm_pending_vblank_event *e;
+	unsigned long flags;
+
+	spin_lock_irqsave(&dev->event_lock, flags);
+	e = crtc->event;
+	crtc->event = NULL;
+	if (e) {
+		e->pipe = drm_crtc_index(&crtc->base);
+		if (e->event.base.type == DRM_EVENT_FLIP_COMPLETE ||
+		    e->event.base.type == DRM_EVENT_VBLANK) {
+			struct timespec64 tv = ktime_to_timespec64(when);
+
+			e->event.vbl.sequence = seq;
+			e->event.vbl.tv_sec = tv.tv_sec;
+			e->event.vbl.tv_usec = tv.tv_nsec / 1000;
+		}
+		drm_send_event_timestamp_locked(dev, &e->base, when);
+	}
+	spin_unlock_irqrestore(&dev->event_lock, flags);
+}
