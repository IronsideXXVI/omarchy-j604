From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bartosz Nitka <niteria@gmail.com>
Date: Sun, 8 Nov 2026 15:22:43 +0100
Subject: [PATCH] irqchip/apple-aic: save T8132 state across a firmware
 suspend

Assisted-by: LLM
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 63b80e2a51fb7c500e79f1722bebf823f27b1ea7)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/irqchip/irq-apple-aic.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/drivers/irqchip/irq-apple-aic.c b/drivers/irqchip/irq-apple-aic.c
index 21a43bd773..57a5f868a3 100644
--- a/drivers/irqchip/irq-apple-aic.c
+++ b/drivers/irqchip/irq-apple-aic.c
@@ -341,6 +341,14 @@ static const struct aic_info aic3_t8140_info __initconst = {
 	.fw_suspend = true,
 };
 
+static const struct aic_info aic3_t8132_info __initconst = {
+	.version = 3,
+	.irq_cfg = AIC3_IRQ_CFG,
+	.fast_ipi = true,
+	.local_fast_ipi = true,
+	.fw_suspend = true,
+};
+
 static const struct aic_info aic3_t8142_info __initconst = {
 	.version = 3,
 	.irq_cfg = AIC3_IRQ_CFG,
@@ -350,6 +358,10 @@ static const struct aic_info aic3_t8142_info __initconst = {
 };
 
 static const struct of_device_id aic_info_match[] = {
+	{
+		.compatible = "apple,t8132-aic3",
+		.data = &aic3_t8132_info,
+	},
 	{
 		.compatible = "apple,t8140-aic3",
 		.data = &aic3_t8140_info,
-- 
2.43.0

