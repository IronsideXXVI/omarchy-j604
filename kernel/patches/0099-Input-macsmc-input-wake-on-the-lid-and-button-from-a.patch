From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:17 -0500
Subject: [PATCH] Input: macsmc-input: wake on the lid and button from
 a suspend's start

A suspend's first steps, the PM notifiers and the freezer, run before
.prepare, and until the SMC's AP idle notice the lid and the power
button arrive as plain events. A lid opened or the button pressed in
that window didn't count as a wake, and the machine went to sleep
anyway: on a J700, closing and opening the lid back to back left it
asleep.

Count them as wakes from PM_SUSPEND_PREPARE to PM_POST_SUSPEND, so they
end the suspend, as on macOS.

Signed-off-by: Diljit Singh <hey@djdev.me>
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/input/misc/macsmc-input.c | 33 ++++++++++++++++++++++++++++++-
 1 file changed, 32 insertions(+), 1 deletion(-)

diff --git a/drivers/input/misc/macsmc-input.c b/drivers/input/misc/macsmc-input.c
index 853dfa73b7..243a0c9823 100644
--- a/drivers/input/misc/macsmc-input.c
+++ b/drivers/input/misc/macsmc-input.c
@@ -20,6 +20,7 @@
  * @smc: Pointer to apple_smc struct of the mfd parent
  * @input: Allocated input_dev; devres managed
  * @nb: Notifier block used for incoming events from SMC (e.g. button pressed down)
+ * @pm_nb: Notifier block for the start and end of a system suspend
  * @wakeup_mode: Set to true when system is suspended and power button events should wake it
  */
 struct macsmc_input {
@@ -27,6 +28,7 @@ struct macsmc_input {
 	struct apple_smc *smc;
 	struct input_dev *input;
 	struct notifier_block nb;
+	struct notifier_block pm_nb;
 	bool wakeup_mode;
 };
 
@@ -106,6 +108,30 @@ static int macsmc_input_event(struct notifier_block *nb, unsigned long event, vo
 	}
 }
 
+/*
+ * A suspend's first steps run before .prepare, and the SMC reports the lid and the button as
+ * plain events until its AP idle notice. Treat them as wakes from the suspend's start, so a lid
+ * opened or a button pressed while the machine goes down ends the suspend, as on macOS.
+ */
+static int macsmc_input_pm_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+	struct macsmc_input *smcin = container_of(nb, struct macsmc_input, pm_nb);
+
+	if (action == PM_SUSPEND_PREPARE)
+		WRITE_ONCE(smcin->wakeup_mode, true);
+	else if (action == PM_POST_SUSPEND)
+		WRITE_ONCE(smcin->wakeup_mode, false);
+
+	return NOTIFY_DONE;
+}
+
+static void macsmc_input_unregister_pm_notifier(void *data)
+{
+	struct macsmc_input *smcin = data;
+
+	unregister_pm_notifier(&smcin->pm_nb);
+}
+
 static void macsmc_input_unregister_notifier(void *data)
 {
 	struct macsmc_input *smcin = data;
@@ -198,7 +224,12 @@ static int macsmc_input_probe(struct platform_device *pdev)
 	if (error)
 		return error;
 
-	return 0;
+	smcin->pm_nb.notifier_call = macsmc_input_pm_notify;
+	error = register_pm_notifier(&smcin->pm_nb);
+	if (error)
+		return error;
+
+	return devm_add_action_or_reset(&pdev->dev, macsmc_input_unregister_pm_notifier, smcin);
 }
 
 static int macsmc_input_pm_prepare(struct device *dev)
