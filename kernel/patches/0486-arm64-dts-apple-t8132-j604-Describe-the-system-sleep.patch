+++ b/Documentation/devicetree/bindings/arm/apple/apple,cpu-ctrl.yaml
@@ -30,7 +30,9 @@ properties:
     pattern: "^cpu-ctrl@[0-9a-f]+$"
 
   compatible:
-    const: apple,t6020-cpu-ctrl
+    enum:
+      - apple,t6020-cpu-ctrl
+      - apple,t8132-cpu-ctrl
 
   reg:
     minItems: 1
