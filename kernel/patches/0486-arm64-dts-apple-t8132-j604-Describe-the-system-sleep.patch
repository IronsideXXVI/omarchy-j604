index 0959d3c7b7..16b9697c45 100644
--- a/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml
+++ b/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml
@@ -34,7 +34,7 @@ description: |
 
 properties:
   $nodename:
-    pattern: "^power-management@[0-9a-f]+$"
+    pattern: "^power-management(@[0-9a-f]+|-s2r)$"
 
   compatible:
     enum:
diff --git a/arch/arm64/boot/dts/apple/t8132-j604-sleep.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-sleep.dtsi
new file mode 100644
index 0000000000..1c315a4afb
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8132-j604-sleep.dtsi
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Apple MacBook Pro (14-inch, M4, 2024) (J604): system sleep controls for
+ * suspend-to-RAM ("deep" mem sleep).
+ *
+ * Every value comes from the J604: its ADT (macOS 27.2 runtime capture,
+ * /arm-io/pmgr "reg", "events", "ap-wake-sources", /cpus "reg", the
+ * per-core implementation register ranges) or the boot loader that runs on
+ * it (m1n1 starts the J604's CPUs through PMGR + 0x34000). Values marked
+ * TO-VERIFY are inferred from the T6020/T6021 layout and are checked by the
+ * J604 bring-up kit before suspend-to-RAM is used.
+ *
+ * Nothing here changes a default boot: apple-sleep only counts sleep states
+ * (its s2idle stages stay off), CPUs only go offline when asked to, and
+ * apple-s2r registers only with apple_s2r.enable=1 and a boot loader that
+ * publishes the warm boot mailbox (or apple_s2r.bringup_no_fw=1 for runs
+ * that stop before the SoC sleeps).
+ */
+
+&{/soc} {
+	/*
+	 * PMGR CPU start/stop block: PMGR + 0x34000 (m1n1 smp.c, T8132 uses the
+	 * T8112 offset; inside the ADT PMGR range 0x380730000 + 0x14000). No
+	 * ACC ranges: the T8132 CPU complex feature bits are not known, so
+	 * clusters are not gated when their CPUs go offline.
+	 */
+	cpu_ctrl: cpu-ctrl@380734000 {
+		compatible = "apple,t8132-cpu-ctrl";
+		reg = <0x3 0x80734000 0x0 0x40>;
+		reg-names = "cpu-start";
+		apple,pmgr = <&pmgr>;
+	};
+
+	/*
+	 * PMGR sleep-state counters, AP wake sources and sleep exit times. ADT
+	 * PMGR ranges: event counters 0x3882c8000 (PMGR_AON + 0x48000), wake
+	 * 0x388004000, wake-time 0x380760000 (PMGR + 0x60000). Offsets inside
+	 * each block are the T6020 ones: TO-VERIFY (bring-up kit reads
+	 * /sys/kernel/debug/apple-sleep/regs first). No CPM range: the T6020
+	 * CPM gating words (PMGR + 0xc030..) are not known on T8132, and a
+	 * guessed PMGR word is never written.
+	 */
+	pmgr_sleep: power-management@3882c8000 {
+		compatible = "apple,t8132-pmgr-sleep";
+		reg = <0x3 0x882c8000 0x0 0x1000>,
+		      <0x3 0x88004000 0x0 0x60>,
+		      <0x3 0x80760000 0x0 0x1000>;
+		reg-names = "events", "wake", "wake-time";
+		/*
+		 * The J604 ADT "ap-wake-sources" list, unchanged: AOP CPU wakeup,
+		 * AOP GPIO IRQ4/6, AOP outbox, AOP/NUB SPMI0/1 SW3, ATC0-3 CIO and
+		 * USB wakeup, MTP dockchannel AP0 and outbox, NUB wakeup time, PMGR
+		 * AON AP watchdog, NUB GPIO IRQ6, NUB wakeup, SMC CPU wakeup and
+		 * outbox, AOP trusted outbox.
+		 */
+		apple,ap-wake-sources = <5 12 14 42 60 64 68 69 70 71 72 73 74 75
+					 85 104 122 123 138 145 150 156 161 183
+					 229>;
+		status = "disabled";
+	};
+};
+
+/ {
+	/*
+	 * Final suspend-to-RAM sequence. No reg: the T8132 clock generator,
+	 * PLL off-mode and suspend-to-RAM timer registers are not in any J604
+	 * ADT PMGR range at the T6021 offsets, so those steps are left out
+	 * until they are found. CPU cluster IDs 0 (ECPU) and 1 (PCPU) follow
+	 * the ADT "soc-clusters" order (EACC, PACC0): TO-VERIFY against the
+	 * PMGR cluster power state words at PMGR + 0x8000.
+	 */
+	pmgr_s2r: power-management-s2r {
+		compatible = "apple,t8132-pmgr-s2r";
+		apple,pmgr = <&pmgr>;
+		apple,cpu-clusters = <0 1>;
+		apple,sep-domain = <&ps_sep>;
+		apple,watchdog = <&wdt>;
+		status = "disabled";
+	};
+};
+
+/*
+ * Per-core implementation registers (RVBAR, core status): the J604 ADT
+ * PMGR ranges 0x210050000..0x210550000 (E cores) and 0x211050000..
+ * 0x211350000 (P cores), one per core.
+ */
+&cpu_e0 { apple,cpu-ctrl = <&cpu_ctrl 0 0>; apple,cpu-impl-reg = /bits/ 64 <0x210050000>; };
+&cpu_e1 { apple,cpu-ctrl = <&cpu_ctrl 0 1>; apple,cpu-impl-reg = /bits/ 64 <0x210150000>; };
+&cpu_e2 { apple,cpu-ctrl = <&cpu_ctrl 0 2>; apple,cpu-impl-reg = /bits/ 64 <0x210250000>; };
+&cpu_e3 { apple,cpu-ctrl = <&cpu_ctrl 0 3>; apple,cpu-impl-reg = /bits/ 64 <0x210350000>; };
+&cpu_e4 { apple,cpu-ctrl = <&cpu_ctrl 0 4>; apple,cpu-impl-reg = /bits/ 64 <0x210450000>; };
+&cpu_e5 { apple,cpu-ctrl = <&cpu_ctrl 0 5>; apple,cpu-impl-reg = /bits/ 64 <0x210550000>; };
+&cpu_p0 { apple,cpu-ctrl = <&cpu_ctrl 1 0>; apple,cpu-impl-reg = /bits/ 64 <0x211050000>; };
+&cpu_p1 { apple,cpu-ctrl = <&cpu_ctrl 1 1>; apple,cpu-impl-reg = /bits/ 64 <0x211150000>; };
+&cpu_p2 { apple,cpu-ctrl = <&cpu_ctrl 1 2>; apple,cpu-impl-reg = /bits/ 64 <0x211250000>; };
+&cpu_p3 { apple,cpu-ctrl = <&cpu_ctrl 1 3>; apple,cpu-impl-reg = /bits/ 64 <0x211350000>; };
+
+&pmgr_sleep {
+	status = "okay";
+};
+
+&pmgr_s2r {
+	status = "okay";
+};
