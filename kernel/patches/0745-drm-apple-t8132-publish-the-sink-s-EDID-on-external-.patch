From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 21:11:58 +0000
Subject: [PATCH] drm/apple: t8132: publish the sink's EDID on external
 outputs

The HDMI and DP connectors of a T8132 dcpext have no EDID property.
Stock compositors read a sink's HDR capability from it (Hyprland
through libdisplay-info), so they treat every external sink as SDR
without a manual monitor rule.

The dcpext, like the desktop 26.x external processors, does not hand
the sink's EDID out through its DCPAV service; it sends the sink's
DisplayAttributes as a property, as it sends TimingElements. Cache
them for the current sink (D129, or a D552/D561 dictionary), dropped
when the sink goes. At get_modes, publish the sink's own EDID where
they carry one (EDID, IODisplayEDID), else one built from their
identity and colour with the preferred mode, as the desktop path does
(dcp_metadata_edid(): with PQ, a CTA-861 extension with the
colorimetry and HDR static metadata data blocks), else none. The mode
list stays the firmware's TimingElements catalogue.

Logged once per sink: what DisplayAttributes gave, and which EDID the
connector publishes.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
(cherry picked from commit 4832b602d59b3fdfdad0247997c0abea7fe48421)
---
 drivers/gpu/drm/apple/iomfb_m4.c | 159 ++++++++++++++++++++++++++++++-
 1 file changed, 157 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index 854eed604a..830d87eebf 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -30,6 +30,7 @@
 #include <linux/thermal.h>
 #include <drm/drm_atomic.h>
 #include <drm/drm_connector.h>
+#include <drm/drm_edid.h>
 #include <drm/drm_framebuffer.h>
 #include <drm/drm_modes.h>
 #include <drm/drm_fourcc.h>
@@ -67,6 +68,7 @@
 #include "dcp-m4-frame.h"
 #include "dcp-m4-xdr.h"
 #include "dcp-m4-ext-colour.h"
+#include "dcp-m4-ext-sink.h"
 #include "dcp-hdr-metadata.h"
 #include "parser.h"
 #include "t8132_ext_drm.h"
@@ -429,6 +431,20 @@ struct iomfb_m4 {
 	/* what iomfb_m4_ext_get_modes() last logged */
 	unsigned int ext_logged_modes, ext_logged_link;
 	int ext_logged_pick;
+	/*
+	 * The sink's DisplayAttributes, received in sink generation
+	 * ext_attr_gen: the identity and colour an EDID is built from
+	 * (ext_meta, while ext_meta_ok) and the sink's own EDID where they
+	 * carry one (ext_edid, ext_edid_size), under ext_modes_lock; and
+	 * the EDID iomfb_m4_ext_get_modes() last published for this sink
+	 * (enum dcp_m4_ext_edid + 1, 0 before), for its log.
+	 */
+	struct dcp_display_metadata ext_meta;
+	bool ext_meta_ok;
+	u8 *ext_edid;
+	size_t ext_edid_size;
+	int ext_attr_gen;
+	int ext_logged_edid;
 };
 
 static void dcp_m4_runtime_wake(struct iomfb_m4 *dcp);
@@ -1414,6 +1430,8 @@ static bool dcp_m4_ext_cache_modes(struct iomfb_m4 *dcp, const void *blob, u32 s
 static bool dcp_m4_ext_cache_preferred(struct iomfb_m4 *dcp, const void *blob, u32 size,
 				       int gen);
 static void dcp_m4_ext_sink_gone(struct iomfb_m4 *dcp, bool route);
+static bool dcp_m4_ext_cache_attributes(struct iomfb_m4 *dcp, const void *blob, u32 size,
+					int gen);
 
 static void dcp_m4_ext_property(struct dcp_m4_runtime *r, unsigned int method,
 				const u8 *in)
@@ -1456,6 +1474,22 @@ static void dcp_m4_ext_property(struct dcp_m4_runtime *r, unsigned int method,
 		    dcp_m4_ext_cache_preferred(dcp, props->raw[slot].data, props->raw[slot].size,
 					       gen))
 			t8132_ext_drm_hotplug(dcp->dev);
+		/* The sink's identity and colour, for the connector's EDID. */
+		if (slot >= 0 && !strcmp(props->raw[slot].name, "DisplayAttributes") &&
+		    props->raw[slot].data &&
+		    dcp_m4_ext_cache_attributes(dcp, props->raw[slot].data, props->raw[slot].size,
+						gen))
+			t8132_ext_drm_hotplug(dcp->dev);
+		break;
+	case 552:
+	case 561:
+		/* The same, set as one dictionary in the callback's sink generation. */
+		slot = dcp_m4_raw_slot(props, 0, (const char *)in, false);
+		if (slot >= 0 && !strcmp(props->raw[slot].name, "DisplayAttributes") &&
+		    props->raw[slot].data &&
+		    dcp_m4_ext_cache_attributes(dcp, props->raw[slot].data, props->raw[slot].size,
+						r->cb_gen))
+			t8132_ext_drm_hotplug(dcp->dev);
 		break;
 	}
 }
@@ -3964,6 +3998,57 @@ static int dcp_m4_ext_pick_preferred(struct iomfb_m4 *dcp, u64 capacity, const c
 	return best;
 }
 
+/*
+ * The connector's EDID (dcp-m4-ext-sink.h): the sink's own (@src SINK,
+ * @raw), else one built from its DisplayAttributes @meta and the
+ * preferred mode @mode, else none; logged once per sink and change.
+ */
+static void dcp_m4_ext_publish_edid(struct iomfb_m4 *dcp, struct drm_connector *connector,
+				    enum dcp_m4_ext_edid src, const u8 *raw, size_t size,
+				    const struct dcp_display_metadata *meta,
+				    const struct drm_display_mode *mode)
+{
+	const struct drm_edid *edid = NULL;
+	int ret = 0;
+
+	if (src == DCP_M4_EXT_EDID_SINK && raw) {
+		edid = drm_edid_alloc(raw, size);
+		if (edid && !drm_edid_valid(edid)) {
+			drm_edid_free(edid);
+			edid = NULL;
+			ret = -EPROTO;
+		}
+		if (!edid)
+			src = meta ? DCP_M4_EXT_EDID_BUILT : DCP_M4_EXT_EDID_NONE;
+	}
+	if (!edid && src == DCP_M4_EXT_EDID_BUILT && meta && mode) {
+		edid = dcp_metadata_edid(meta, mode);
+		if (IS_ERR(edid)) {
+			ret = PTR_ERR(edid);
+			edid = NULL;
+		}
+	}
+	if (!edid)
+		src = DCP_M4_EXT_EDID_NONE;
+	drm_edid_connector_update(connector, edid);
+	if (READ_ONCE(dcp->ext_logged_edid) != src + 1) {
+		WRITE_ONCE(dcp->ext_logged_edid, src + 1);
+		if (src == DCP_M4_EXT_EDID_SINK)
+			dev_info(dcp->dev, "sink EDID: the sink's own, %zu bytes\n", size);
+		else if (src == DCP_M4_EXT_EDID_BUILT)
+			dev_info(dcp->dev, "sink EDID: from DisplayAttributes: %s \"%s\", %s%s, max %u cd/m2\n",
+				 meta->manufacturer, meta->name,
+				 meta->pq ? "HDR10 (ST 2084)" : "SDR",
+				 meta->bt2020_rgb ? ", BT.2020 RGB" : "",
+				 meta->max_luminance >> 16);
+		else
+			dev_info(dcp->dev, "sink EDID: none (%s): %d\n",
+				 meta ? "DisplayAttributes not usable" :
+				 "no usable DisplayAttributes from the dcpext", ret);
+	}
+	drm_edid_free(edid);
+}
+
 int iomfb_m4_ext_get_modes(struct apple_dcp *owner, struct drm_connector *connector)
 {
 	struct iomfb_m4 *dcp = owner->v26_6;
@@ -3973,6 +4058,11 @@ int iomfb_m4_ext_get_modes(struct apple_dcp *owner, struct drm_connector *connec
 	struct drm_display_mode *preferred = NULL, *fallback = NULL;
 	unsigned int added = 0, skipped = 0, total;
 	const char *why = "1920x1080 at 60 Hz, else the first";
+	struct dcp_display_metadata meta;
+	enum dcp_m4_ext_edid src;
+	size_t raw_size = 0;
+	u8 *raw = NULL;
+	bool meta_ok;
 	int pick;
 
 	if (!dcp || !dcp->external)
@@ -4019,7 +4109,20 @@ int iomfb_m4_ext_get_modes(struct apple_dcp *owner, struct drm_connector *connec
 			p ? p->hdisplay : 0, p ? p->vdisplay : 0, p ? drm_mode_vrefresh(p) : 0,
 			p ? p->clock : 0, preferred ? why : "1920x1080 at 60 Hz, else the first");
 	}
+	/* The sink's EDID, as its DisplayAttributes give it, published unlocked. */
+	src = dcp_m4_ext_edid_pick(dcp->ext_edid, dcp->ext_meta_ok, dcp->ext_attr_gen,
+				   atomic_read(&dcp->ext_sink_gen));
+	if (src == DCP_M4_EXT_EDID_SINK) {
+		raw = kmemdup(dcp->ext_edid, dcp->ext_edid_size, GFP_KERNEL);
+		raw_size = raw ? dcp->ext_edid_size : 0;
+	}
+	meta_ok = src != DCP_M4_EXT_EDID_NONE && dcp->ext_meta_ok;
+	if (meta_ok)
+		meta = dcp->ext_meta;
 	mutex_unlock(&dcp->ext_modes_lock);
+	dcp_m4_ext_publish_edid(dcp, connector, src, raw, raw_size, meta_ok ? &meta : NULL,
+				preferred ?: fallback);
+	kfree(raw);
 	return added;
 }
 
@@ -4996,21 +5099,73 @@ static bool dcp_m4_ext_cache_preferred(struct iomfb_m4 *dcp, const void *blob, u
 	return changed;
 }
 
+/*
+ * The sink's DisplayAttributes @blob: its own EDID where they carry one
+ * (EDID, IODisplayEDID) and the identity and colour an EDID is built from
+ * (parse_display_metadata()); not if received in sink generation @gen,
+ * before a released route (stale). True if cached.
+ */
+static bool dcp_m4_ext_cache_attributes(struct iomfb_m4 *dcp, const void *blob, u32 size,
+					int gen)
+{
+	struct dcp_display_metadata meta;
+	struct dcp_parse_ctx ctx;
+	const u8 *raw = NULL;
+	size_t raw_size = 0;
+	u8 *edid = NULL, *old;
+	bool meta_ok;
+
+	if (!parse_panel_edid_data(blob, size, &raw, &raw_size))
+		edid = kmemdup(raw, raw_size, GFP_KERNEL);
+	meta_ok = !parse(blob, size, &ctx) && !parse_display_metadata(&ctx, &meta);
+	mutex_lock(&dcp->ext_modes_lock);
+	if (gen != atomic_read(&dcp->ext_sink_gen)) {
+		mutex_unlock(&dcp->ext_modes_lock);
+		kfree(edid);
+		dev_dbg(dcp->dev, "DisplayAttributes %s: not cached\n",
+			gen == INT_MIN ? "not all in one sink generation" :
+			"from before a released route");
+		return false;
+	}
+	old = dcp->ext_edid;
+	dcp->ext_edid = edid;
+	dcp->ext_edid_size = edid ? raw_size : 0;
+	dcp->ext_meta_ok = meta_ok;
+	if (meta_ok)
+		dcp->ext_meta = meta;
+	dcp->ext_attr_gen = gen;
+	mutex_unlock(&dcp->ext_modes_lock);
+	kfree(old);
+	dev_info(dcp->dev, "sink DisplayAttributes: %s EDID, %s\n",
+		 edid ? "the sink's own" : "no",
+		 meta_ok ? "identity and colour read" : "no usable identity and colour");
+	return true;
+}
+
 /*
  * The sink went: in the firmware's own order (D575(0)), or with its
  * route (@route), which runs beside the firmware's messages: then words
  * already received publish nothing more (a new sink generation). Its
- * PreferredTimingElements go, and none are taken until its next
- * TimingElements. The mode list stays until then.
+ * PreferredTimingElements and DisplayAttributes go, and none are taken
+ * until its next TimingElements. The mode list stays until then.
  */
 static void dcp_m4_ext_sink_gone(struct iomfb_m4 *dcp, bool route)
 {
+	u8 *old;
+
 	mutex_lock(&dcp->ext_modes_lock);
 	if (route)
 		atomic_inc(&dcp->ext_sink_gen);
 	dcp->ext_catalog_open = false;
 	dcp->ext_pref_count = 0;
+	/* Its DisplayAttributes and EDID describe nothing any more. */
+	old = dcp->ext_edid;
+	dcp->ext_edid = NULL;
+	dcp->ext_edid_size = 0;
+	dcp->ext_meta_ok = false;
+	WRITE_ONCE(dcp->ext_logged_edid, 0);
 	mutex_unlock(&dcp->ext_modes_lock);
+	kfree(old);
 }
 
 /* One top-level call of an external output's work, with a deadline of its own. */
