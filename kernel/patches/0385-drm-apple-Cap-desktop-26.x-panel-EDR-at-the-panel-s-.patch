From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Sat, 7 Nov 2026 08:51:31 +0000
Subject: [PATCH] drm/apple: Cap desktop 26.x panel EDR at the panel's
 potential headroom

On the J616s in GNOME's BT.2100 mode, stepping the brightness down
through the low end made the panel dip darker and then come back
brighter on every key press, and kept flickering for seconds after the
last one.

dcp_edr_prepare() gave the panel headroom peak / SDR white with no
limit. At the lowest GNOME level (6 nits) that is a headroom of 266:
every swap asked for the panel peak and scaled the picture by 1/266.
Reaching it took about 120 one-step swaps, and a still desktop sends
about one swap a second, so the ramp crawled on for seconds and each OSD
redraw of a later key press ran another stretch of it. Meanwhile the
backlight fade lowers SDR white faster than one step a swap raises the
headroom, so the requested panel level went down and up again within
one key press: traced on the J616s for one 35 to 6 nit step, it went
1599, 1527, 1495, 1566, 1599, 1559, ... 891, and back up to 1599 over
the next 4.5 s. The firmware eases the panel level over several frames
but applies the EDR scale at once, so each reversal shows as a dip and
a recovery.

macOS limits the headroom to the panel's potential headroom, which the
ADT carries as EDRPotentialHeadroom in the /backlight node. Read it with
the panel's other ADT properties and cap the headroom there. Below the
SDR white at which the peak needs more than that, the headroom stays at
the cap, and a brightness change moves only the panel level.

Above it, a swap that lowers SDR white while the headroom is still
below its target now raises the headroom just enough to hold the panel
level, so the requested level never moves against a fade. The macOS
ramp for EDR content starting, one step per swap, is unchanged and
continues once SDR white settles. Without the ADT property, the
headroom is not capped, as before.

The KUnit cases model the swaps of a backlight fade and check that the
panel level never moves against it, with and without a cap, that swaps
at a steady level change nothing, and the start ramp. The host
selftest's ADT fixture gains a /backlight node.

Assisted-by: LLM
Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
(backported from commit 43f112d09ac0f20c0b19bd189297d3d5cad16bd3)
[j604: only the new dcp-edr.h (the headroom ceiling, target and per-swap
 step helpers) and its KUnit cases in dcp_backlight_test.c; the case list
 also keeps 1.607's backlight_m4_unlock_fade_test. The desktop 26.x
 consumer in iomfb_template.c, dcp.c and dcp-internal.h, the ADT read in
 dcp-panel-adt.c (already in the parser backport) and the selftest are not
 taken: 1.607 has no desktop EDR. The iomfb_m4 consumer follows.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/gpu/drm/apple/dcp-edr.h            |  66 +++++++++++
 drivers/gpu/drm/apple/dcp_backlight_test.c | 132 +++++++++++++++++++++
 2 files changed, 198 insertions(+)
 create mode 100644 drivers/gpu/drm/apple/dcp-edr.h

diff --git a/drivers/gpu/drm/apple/dcp-edr.h b/drivers/gpu/drm/apple/dcp-edr.h
new file mode 100644
index 0000000000..462f3076be
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-edr.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Copyright 2026 Ryan Murray */
+
+#ifndef __APPLE_DCP_EDR_H__
+#define __APPLE_DCP_EDR_H__
+
+#include <linux/limits.h>
+#include <linux/math64.h>
+#include <linux/minmax.h>
+#include <linux/types.h>
+
+/*
+ * EDR headroom on a desktop 26.x panel, x1000: 1000 is SDR white at the
+ * panel level.  A swap asks for brightness SDR white x H and scales the
+ * picture by 1 / H (see dcp_edr_prepare()).
+ */
+#define DCP_EDR_UNITY		1000U
+#define DCP_EDR_STEP_UP		1047U	/* x1000 per swap */
+
+/*
+ * The panel's potential headroom, the ADT backlight node's
+ * EDRPotentialHeadroom (16.16), as a ceiling x1000.  macOS never gives the
+ * panel more.  0: no ceiling, for a value that is missing or not above 1.0.
+ */
+static inline u32 dcp_edr_ceiling(u32 fixed)
+{
+	u64 hm = ((u64)fixed * DCP_EDR_UNITY) >> 16;
+
+	return hm > DCP_EDR_UNITY && hm <= U32_MAX ? hm : 0;
+}
+
+/* The headroom the panel has above @sdr nits: peak / sdr, up to @ceiling. */
+static inline u32 dcp_edr_target(u32 peak, u32 sdr, u32 ceiling)
+{
+	u32 target = DCP_EDR_UNITY;
+
+	if (sdr && peak > sdr)
+		target = div_u64((u64)peak * DCP_EDR_UNITY, sdr);
+	if (ceiling)
+		target = clamp(target, DCP_EDR_UNITY, ceiling);
+	return target;
+}
+
+/*
+ * The headroom for the next swap: up one step per swap, down at once.  A
+ * swap that lowers SDR white from @prev_sdr to @sdr while the headroom is
+ * below its target raises the headroom just enough to hold the panel level,
+ * as far as the target allows, and no further: the firmware eases the panel
+ * level over several frames but applies the scale at once, so a level that
+ * moved against the fade would show as a dip and a recovery.  Held, only the
+ * scale moves and SDR content dims in the frame that asks for it.  A ramp
+ * cut short continues once SDR white settles.
+ */
+static inline u32 dcp_edr_next(u32 cur, u32 target, u32 prev_sdr, u32 sdr)
+{
+	if (target < cur)
+		return target;
+	if (target == cur)
+		return cur;
+	if (sdr && prev_sdr > sdr)
+		return min_t(u64, div_u64((u64)cur * prev_sdr + sdr / 2, sdr), target);
+	return min_t(u64, div_u64((u64)cur * DCP_EDR_STEP_UP, DCP_EDR_UNITY) + 1,
+		     target);
+}
+
+#endif /* __APPLE_DCP_EDR_H__ */
diff --git a/drivers/gpu/drm/apple/dcp_backlight_test.c b/drivers/gpu/drm/apple/dcp_backlight_test.c
index a8f37a029f..e1f0df0432 100644
--- a/drivers/gpu/drm/apple/dcp_backlight_test.c
+++ b/drivers/gpu/drm/apple/dcp_backlight_test.c
@@ -5,6 +5,7 @@
 #include <linux/module.h>
 
 #include "dcp_backlight.h"
+#include "dcp-edr.h"
 
 static void backlight_millinits_takeover_test(struct kunit *test)
 {
@@ -568,6 +569,132 @@ static void backlight_m4_unlock_fade_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, present.nits, 48U);
 }
 
+
+/* Synthetic panel: a 1200 nit peak and a potential headroom of 8.0. */
+#define EDR_TEST_PEAK		1200U
+#define EDR_TEST_CEILING	0x80000U
+
+static void edr_ceiling_test(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, dcp_edr_ceiling(0), 0U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_ceiling(0x8000), 0U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_ceiling(0x10000), 0U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_ceiling(0x18000), 1500U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_ceiling(EDR_TEST_CEILING), 8000U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_ceiling(U32_MAX), 65535999U);
+}
+
+static void edr_target_test(struct kunit *test)
+{
+	u32 ceiling = dcp_edr_ceiling(EDR_TEST_CEILING);
+
+	/* Bright SDR white: the peak sets the headroom. */
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(EDR_TEST_PEAK, 400, ceiling), 3000U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(EDR_TEST_PEAK, 150, ceiling), 8000U);
+	/* Dim SDR white: the ceiling does, never peak / sdr. */
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(EDR_TEST_PEAK, 6, ceiling), 8000U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(EDR_TEST_PEAK, 1, ceiling), 8000U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(EDR_TEST_PEAK, 6, 0), 200000U);
+	/* No headroom above the peak, and none to give with no SDR white. */
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(EDR_TEST_PEAK, 1200, ceiling), 1000U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(EDR_TEST_PEAK, 1500, ceiling), 1000U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(EDR_TEST_PEAK, 0, ceiling), 1000U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(10000, 1, 0), 10000000U);
+}
+
+/*
+ * Present a fade of SDR white from @from to @to in @steps swaps, as the
+ * backlight fade does, then @extra swaps at the new level, and return the
+ * number of swaps whose panel level moved against the fade.
+ */
+static unsigned int edr_fade(struct kunit *test, u32 *hm, u32 ceiling,
+			     u32 from, u32 to, unsigned int steps,
+			     unsigned int extra, u32 *last_bri)
+{
+	u32 prev = from, bri = (u64)from * *hm / DCP_EDR_UNITY;
+	unsigned int reversals = 0;
+
+	for (unsigned int i = 1; i <= steps + extra; i++) {
+		u32 sdr = i >= steps ? to :
+			(from > to ? from - (from - to) * i / steps :
+				     from + (to - from) * i / steps);
+		u32 target = dcp_edr_target(EDR_TEST_PEAK, sdr, ceiling);
+		u32 next = dcp_edr_next(*hm, target, prev, sdr);
+		u32 level = (u64)sdr * next / DCP_EDR_UNITY;
+
+		KUNIT_EXPECT_LE(test, next, max(target, *hm));
+		/* Allow the rounding of the headroom and of the level. */
+		u32 slack = max(1U, bri / 200);
+
+		if ((from > to && level > bri + slack) ||
+		    (from < to && level + slack < bri))
+			reversals++;
+		*hm = next;
+		prev = sdr;
+		bri = level;
+	}
+	*last_bri = bri;
+	return reversals;
+}
+
+static void edr_low_end_steady_test(struct kunit *test)
+{
+	u32 ceiling = dcp_edr_ceiling(EDR_TEST_CEILING);
+	u32 hm = dcp_edr_target(EDR_TEST_PEAK, 35, ceiling), bri;
+
+	/* At the ceiling below 150 nits: a fade only moves the panel level. */
+	KUNIT_EXPECT_EQ(test, edr_fade(test, &hm, ceiling, 35, 6, 15, 0, &bri), 0U);
+	KUNIT_EXPECT_EQ(test, hm, 8000U);
+	KUNIT_EXPECT_EQ(test, bri, 48U);
+	/* Swaps at the floor, e.g. for an OSD, change nothing. */
+	for (unsigned int i = 0; i < 200; i++)
+		KUNIT_EXPECT_EQ(test, dcp_edr_next(hm, dcp_edr_target(EDR_TEST_PEAK, 6, ceiling),
+						   6, 6), hm);
+}
+
+static void edr_fade_monotonic_test(struct kunit *test)
+{
+	u32 ceilings[] = { dcp_edr_ceiling(EDR_TEST_CEILING), 0 };
+
+	for (unsigned int c = 0; c < ARRAY_SIZE(ceilings); c++) {
+		u32 ceiling = ceilings[c];
+		u32 hm = dcp_edr_target(EDR_TEST_PEAK, 400, ceiling), bri;
+
+		/* Down: the panel level holds, then follows SDR white down. */
+		KUNIT_EXPECT_EQ(test, edr_fade(test, &hm, ceiling, 400, 6, 15, 300, &bri), 0U);
+		KUNIT_EXPECT_EQ(test, hm, dcp_edr_target(EDR_TEST_PEAK, 6, ceiling));
+		KUNIT_EXPECT_EQ(test, bri, (u32)((u64)6 * hm / DCP_EDR_UNITY));
+		/* Up: the headroom drops at once and the level only rises. */
+		KUNIT_EXPECT_EQ(test, edr_fade(test, &hm, ceiling, 6, 400, 15, 10, &bri), 0U);
+		KUNIT_EXPECT_EQ(test, hm, 3000U);
+		KUNIT_EXPECT_EQ(test, bri, EDR_TEST_PEAK);
+		/* One step at a time between near levels. */
+		KUNIT_EXPECT_EQ(test, edr_fade(test, &hm, ceiling, 400, 300, 15, 50, &bri), 0U);
+		KUNIT_EXPECT_EQ(test, hm, 4000U);
+	}
+}
+
+static void edr_start_ramp_test(struct kunit *test)
+{
+	u32 ceiling = dcp_edr_ceiling(EDR_TEST_CEILING);
+	u32 target = dcp_edr_target(EDR_TEST_PEAK, 6, ceiling);
+	u32 hm = DCP_EDR_UNITY;
+	unsigned int swaps = 0;
+
+	/* EDR starting at a steady level rises one step per swap. */
+	while (hm < target) {
+		u32 next = dcp_edr_next(hm, target, 6, 6);
+
+		KUNIT_ASSERT_GT(test, next, hm);
+		KUNIT_EXPECT_LE(test, next, hm * DCP_EDR_STEP_UP / DCP_EDR_UNITY + 1);
+		hm = next;
+		KUNIT_ASSERT_LT(test, ++swaps, 100U);
+	}
+	KUNIT_EXPECT_EQ(test, hm, target);
+	/* Ending EDR returns to 1.0 in one swap. */
+	KUNIT_EXPECT_EQ(test, dcp_edr_next(hm, DCP_EDR_UNITY, 6, 6), DCP_EDR_UNITY);
+}
+
 static struct kunit_case backlight_cases[] = {
 	KUNIT_CASE(backlight_millinits_takeover_test),
 	KUNIT_CASE(backlight_takeover_test),
@@ -586,6 +713,11 @@ static struct kunit_case backlight_cases[] = {
 	KUNIT_CASE(backlight_fade_restart_test),
 	KUNIT_CASE(backlight_fade_blank_test),
 	KUNIT_CASE(backlight_m4_unlock_fade_test),
+	KUNIT_CASE(edr_ceiling_test),
+	KUNIT_CASE(edr_target_test),
+	KUNIT_CASE(edr_low_end_steady_test),
+	KUNIT_CASE(edr_fade_monotonic_test),
+	KUNIT_CASE(edr_start_ramp_test),
 	{}
 };
 
