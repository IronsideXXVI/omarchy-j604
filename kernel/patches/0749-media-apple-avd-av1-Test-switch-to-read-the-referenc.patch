+ avd_av1_stop(&ctx);
+ queue.vp_pool[3]=BIT(9)|BIT(10)|BIT(11);queue.next_vp[3]=0;
+ puts("PASS: av1_cdf_chain: one-engine latch, no VP-callback wait, PP waits kept, CDF input in place, held producer, tail ABI, error release");
  /* Fail allocation in every bank, including after earlier banks succeeded. */
  for(int n=1;n<=16;n++){
   fail_alloc_after=n;allocating_ctx=&ctx;assert(avd_av1_start(&ctx)==-ENOMEM);allocating_ctx=NULL;
