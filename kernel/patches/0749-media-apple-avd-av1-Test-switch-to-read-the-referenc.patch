From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 21:36:59 +0000
Subject: [PATCH] media: apple: avd: av1: Test switch to read the
 reference's CDFs in place

An AV1 picture's CDF input is a CPU copy of its primary reference's VP
output, made while the picture is prepared. So the next picture is not
built until the previous picture's VP callback has run, and with one AV1
VP engine that engine waits for the callback and the next picture's
whole preparation on every picture. The queue keeps about 1.33 AV1
pictures in flight, where macOS keeps 2.19 on the same silicon, and AV1
8-bit decodes at 88 % of macOS (598 vs 683 fps at 4K).

Add av1_cdf_chain, off by default and latched when a stream starts. It
applies only when the queue firmware lists exactly one AV1 VP engine
(new avd_qfw_vp_engines()). A picture whose CDFs come from a reference
still in a bank then names that bank's CDF output as its CDF input,
and does not wait for a named reference's VP callback: one engine runs
VP in submit order. The motion-field and segmentation-map waits on the
whole reference picture stay, as do pictures with frame-end update off
(their output must start as their input) and pictures on default CDFs.
A bank that is read this way stays reserved until the reader's VP
callback or its retirement, and the reader's CAPTURE tail gets the CDFs
it read at its VP callback, as before.

With the switch off nothing changes. Whether one engine keeps VP in
submit order across queue slots is what the switch tests: a bit-exact
decode against software decides it.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/media/platform/apple/avd/avd-av1.c    | 82 +++++++++++++++++--
 .../platform/apple/avd/avd-backend-queue.c    | 13 +++
 drivers/media/platform/apple/avd/avd.h        |  1 +
 .../platform/apple/avd/tests/av1-test.py      | 61 +++++++++++++-
 4 files changed, 150 insertions(+), 7 deletions(-)

diff --git a/drivers/media/platform/apple/avd/avd-av1.c b/drivers/media/platform/apple/avd/avd-av1.c
index 99a4b9e7da..7697dd23d6 100644
--- a/drivers/media/platform/apple/avd/avd-av1.c
+++ b/drivers/media/platform/apple/avd/avd-av1.c
@@ -47,6 +47,11 @@ module_param(av1_out_hdr58, uint, 0644);
 MODULE_PARM_DESC(av1_out_hdr58,
 		 "Test only: 10-bit AV1 picture header word at HEVC's hdr_58 place (default 0)");
 
+static bool av1_cdf_chain;
+module_param(av1_cdf_chain, bool, 0644);
+MODULE_PARM_DESC(av1_cdf_chain,
+		 "Test only: one AV1 VP engine reads its reference's CDFs in place (at stream start); default off");
+
 static bool av1_mvs_after_vp;
 module_param(av1_mvs_after_vp, bool, 0644);
 MODULE_PARM_DESC(av1_mvs_after_vp,
@@ -242,6 +247,7 @@ struct avd_av1_run {
 	struct avd_run base;
 
 	struct {
+		dma_addr_t probs;	/* 0: this bank's own CDF input */
 		dma_addr_t probs_out;
 		dma_addr_t color;
 		dma_addr_t seg;
@@ -291,10 +297,15 @@ struct avd_av1_bank {
 	u64 timestamp;
 	u32 flags;
 	u8 seg_flags;
+	/* av1_cdf_chain: the bank whose probs_out this picture's VP reads, and readers of ours */
+	struct avd_av1_bank *cdf_src;
+	unsigned int cdf_users;
+	bool retired;	/* PP done, still held for a reader's VP */
 };
 
 struct avd_av1_stream {
 	unsigned int nbanks;
+	bool cdf_chain;
 	struct avd_av1_bank bank[AVD_AV1_BANKS];
 	struct avd_av1_bank *b;
 };
@@ -326,6 +337,19 @@ static bool avd_av1_writes_seg(u8 flags)
 	       (flags & V4L2_AV1_SEGMENTATION_FLAG_UPDATE_MAP);
 }
 
+/*
+ * av1_cdf_chain: with one AV1 VP engine, VP runs in submit order, so a picture can
+ * read the CDFs its primary reference's VP writes in place, without waiting for
+ * that VP's callback to copy them. Not when frame-end update is off: that picture's
+ * output must start as its input, which is copied while it is prepared.
+ */
+static bool avd_av1_cdf_chain(const struct avd_av1_stream *stream,
+			      const struct v4l2_ctrl_av1_frame *frame)
+{
+	return stream && stream->cdf_chain && !avd_av1_default_cdf(frame) &&
+	       !(frame->flags & V4L2_AV1_FRAME_FLAG_DISABLE_FRAME_END_UPDATE_CDF);
+}
+
 /*
  * Queued CDF output is private coherent VP storage, published by the tagged
  * VP callback after the queue's dma_rmb(). CAPTURE maps and motion fields
@@ -334,10 +358,14 @@ static bool avd_av1_writes_seg(u8 flags)
 static bool avd_av1_depends(const struct v4l2_ctrl_av1_frame *frame,
 			   const struct avd_av1_bank *bank)
 {
+	bool chain = avd_av1_cdf_chain(bank->codec.stream, frame);
+	/* Pairs with the release in avd_av1_vp_done(). */
+	bool vp_done = smp_load_acquire(&bank->vp_done);
+
 	/* Preserve same-VP ordering for named references when engines differ. */
 	for (unsigned int i = 0; i < V4L2_AV1_REFS_PER_FRAME; i++)
 		if (avd_av1_ref_ts(frame, frame->ref_frame_idx[i]) == bank->timestamp &&
-		    (!smp_load_acquire(&bank->vp_done) ||
+		    ((!chain && !vp_done) ||
 		     ((frame->flags & V4L2_AV1_FRAME_FLAG_USE_REF_FRAME_MVS) &&
 		      !READ_ONCE(av1_mvs_after_vp))))
 			return true;
@@ -397,6 +425,7 @@ static bool avd_av1_ready(struct avd_ctx *ctx)
 		ready = true;
 		for (unsigned int i = 0; i < av1_ctx->nbanks; i++)
 			if (READ_ONCE(av1_ctx->bank[i].busy) &&
+			    !READ_ONCE(av1_ctx->bank[i].retired) &&
 			    avd_av1_depends(frame, &av1_ctx->bank[i]))
 				ready = false;
 	}
@@ -987,7 +1016,7 @@ static void set_header(struct avd_ctx *ctx, struct avd_av1_run *run)
 	push(0, "");
 
 	pusha(run->addresses.probs_out, "probs_out", 0);
-	pusha(av1_ctx->bufs.probs.addr, "probs", 1);
+	pusha(run->addresses.probs ?: av1_ctx->bufs.probs.addr, "probs", 1);
 	pusha(av1_ctx->bufs.above_info.addr, "col", 0);
 	pusha(run->addresses.seg, "seg", 0);
 	pusha(run->addresses.prev_seg, "prev_seg", 1);
@@ -1327,6 +1356,7 @@ static void avd_av1_prepare_prob(struct avd_ctx *ctx, struct avd_av1_run *run)
 	struct avd_decoded_buffer *dst, *ref;
 	struct avd_av1_bank *bank = NULL;
 
+	run->addresses.probs = 0;
 	dst = vb2_to_avd_decoded_buf(&run->base.bufs.dst->vb2_buf);
 	if (stream->nbanks > 1 && !avd_av1_default_cdf(run->frame)) {
 		ref = avd_get_ref_buf(ctx, &dst->base.vb,
@@ -1336,6 +1366,11 @@ static void avd_av1_prepare_prob(struct avd_ctx *ctx, struct avd_av1_run *run)
 	}
 	if (!bank) {
 		avd_av1_set_prob(ctx, run);
+	} else if (avd_av1_cdf_chain(stream, run->frame)) {
+		/* Read in VP order; the CAPTURE-tail copy waits for our VP callback. */
+		run->addresses.probs = bank->codec.bufs.probs_out.addr;
+		bank->cdf_users++;
+		stream->b->cdf_src = bank;	/* avd_av1_run() made b this picture's bank */
 	} else {
 		memcpy(codec->bufs.probs.cpu, bank->codec.bufs.probs_out.cpu,
 		       AVD_CDFS_SIZE);
@@ -1346,7 +1381,8 @@ static void avd_av1_prepare_prob(struct avd_ctx *ctx, struct avd_av1_run *run)
 	}
 	if (stream->nbanks > 1) {
 		/* No VP write when frame-end update is disabled: preserve its input. */
-		memcpy(codec->bufs.probs_out.cpu, codec->bufs.probs.cpu, AVD_CDFS_SIZE);
+		if (!run->addresses.probs)
+			memcpy(codec->bufs.probs_out.cpu, codec->bufs.probs.cpu, AVD_CDFS_SIZE);
 		run->addresses.probs_out = codec->bufs.probs_out.addr;
 	}
 }
@@ -1738,6 +1774,9 @@ static int avd_av1_run(struct avd_ctx *ctx)
 		smp_store_release(&ctx->priv, &bank->codec);
 		WRITE_ONCE(bank->prepared, false);
 		WRITE_ONCE(bank->vp_done, false);
+		bank->cdf_src = NULL;
+		bank->cdf_users = 0;
+		WRITE_ONCE(bank->retired, false);
 		WRITE_ONCE(bank->busy, true);
 		bank->dst = dst;
 		bank->timestamp = run.base.bufs.src->vb2_buf.timestamp;
@@ -1779,6 +1818,30 @@ static int avd_av1_run(struct avd_ctx *ctx)
 }
 
 
+/*
+ * av1_cdf_chain: the picture in @bank has read (or will never read) the CDFs its
+ * source bank's VP wrote. Keep the CAPTURE-tail ABI with the CDFs it read, then let
+ * a source whose PP already retired go.
+ */
+static void avd_av1_cdf_release(struct avd_av1_bank *bank,
+				struct avd_decoded_buffer *buf, bool copy)
+{
+	struct avd_av1_bank *src = bank->cdf_src;
+
+	if (!src)
+		return;
+	bank->cdf_src = NULL;
+	if (copy)
+		memcpy(vb2_plane_vaddr(&buf->base.vb.vb2_buf, 0) +
+			AVD_AV1_CDFS_OFFSET(buf->base.vb.vb2_buf.planes[0].length,
+					    buf->av1.color_size),
+		       src->codec.bufs.probs_out.cpu, AVD_CDFS_SIZE);
+	if (!--src->cdf_users && READ_ONCE(src->retired)) {
+		WRITE_ONCE(src->retired, false);
+		WRITE_ONCE(src->busy, false);
+	}
+}
+
 /*
  * VP writes probs_out, independently of PP reconstruction. The queue executes
  * dma_rmb() before this callback. Publish coherent output, never read a live
@@ -1790,8 +1853,10 @@ static void avd_av1_vp_done(struct avd_ctx *ctx, struct vb2_v4l2_buffer *dst)
 	struct avd_decoded_buffer *buf = vb2_to_avd_decoded_buf(&dst->vb2_buf);
 	struct avd_av1_bank *bank = avd_av1_ref_bank(stream, buf);
 
-	if (bank)
+	if (bank) {
 		smp_store_release(&bank->vp_done, true);
+		avd_av1_cdf_release(bank, buf, true);
+	}
 }
 
 static void avd_av1_done(struct avd_ctx *ctx, struct vb2_v4l2_buffer *src,
@@ -1811,7 +1876,12 @@ static void avd_av1_done(struct avd_ctx *ctx, struct vb2_v4l2_buffer *src,
 							    buf->av1.color_size),
 					bank->codec.bufs.probs_out.cpu, AVD_CDFS_SIZE);
 			}
-			WRITE_ONCE(bank->busy, false);
+			/* A picture that never reached its VP callback still holds its source. */
+			avd_av1_cdf_release(bank, buf, false);
+			if (bank->cdf_users)
+				WRITE_ONCE(bank->retired, true);
+			else
+				WRITE_ONCE(bank->busy, false);
 		}
 		buf->bank = 0;
 	}
@@ -1894,6 +1964,8 @@ static int avd_av1_start(struct avd_ctx *ctx)
 
 	av1_ctx->nbanks = avd_qfw_has_vp_done(ctx->dev) ?
 		avd_qfw_picture_banks(ctx->dev, AVD_CODEC_AV1) : 1;
+	av1_ctx->cdf_chain = READ_ONCE(av1_cdf_chain) && av1_ctx->nbanks > 1 &&
+			     avd_qfw_vp_engines(ctx->dev, AVD_CODEC_AV1) == 1;
 	av1_ctx->b = &av1_ctx->bank[0];
 	for (unsigned int i = 0; i < av1_ctx->nbanks; i++) {
 		av1_ctx->bank[i].codec.stream = av1_ctx;
diff --git a/drivers/media/platform/apple/avd/avd-backend-queue.c b/drivers/media/platform/apple/avd/avd-backend-queue.c
index bec03920c2..a5e4db7e76 100644
--- a/drivers/media/platform/apple/avd/avd-backend-queue.c
+++ b/drivers/media/platform/apple/avd/avd-backend-queue.c
@@ -487,6 +487,19 @@ unsigned int avd_qfw_picture_banks(const struct avd_dev *avd, unsigned int codec
 	return avd_backend_is_qfw(avd) ? avd_qfw_bank_limit(avd->qfw, codec) : 1;
 }
 
+/* Hardware VP engines the queue firmware lists for a codec; 0 when it lists none. */
+unsigned int avd_qfw_vp_engines(const struct avd_dev *avd, unsigned int codec)
+{
+	unsigned int n = 0;
+	u32 pool;
+
+	if (!avd_backend_is_qfw(avd) || !avd->qfw->multi_vp || codec > AVD_CODEC_AV1)
+		return 0;
+	for (pool = avd->qfw->vp_pool[codec]; pool; pool &= pool - 1)
+		n++;
+	return n;
+}
+
 /*
  * SRAM survives a CM3 reload, so a stale info block from an earlier ABI 2
  * image could make a legacy image look queue capable. Clear the magic before
diff --git a/drivers/media/platform/apple/avd/avd.h b/drivers/media/platform/apple/avd/avd.h
index 6686301a56..a9e62fdf51 100644
--- a/drivers/media/platform/apple/avd/avd.h
+++ b/drivers/media/platform/apple/avd/avd.h
@@ -436,6 +436,7 @@ void avd_qfw_debug(struct avd_dev *avd, struct avd_frame *f, const char *where);
 bool avd_backend_is_qfw(const struct avd_dev *avd);
 bool avd_qfw_has_vp_done(const struct avd_dev *avd);
 unsigned int avd_qfw_picture_banks(const struct avd_dev *avd, unsigned int codec);
