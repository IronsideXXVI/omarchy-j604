 static void *vb2_plane_vaddr(struct vb2_buffer *b,int p){(void)p;return b->cpu;}
@@ -129,7 +130,7 @@ post += qfw[qfw.index('#define AVDQ_MAGIC'):qfw.index('/* Arguments of dev_dbg()
 post += hw[hw.index('#define AVD_V3_'):hw.index('int avd_boot(')]
 post += '#define w32(r,v) writel((v),avd->ctrl+(r))\n#define m32(r,v) w32(r,(v)|readl(avd->ctrl+(r)))\n'
 post += function(hw, 't8112_configure_stream') + function(hw, 't8122_configure_stream')
-post += function(qfw, 'avd_qfw_picture_banks')
+post += function(qfw, 'avd_qfw_picture_banks') + function(qfw, 'avd_qfw_vp_engines')
 post += function(qfw, 'avd_qfw_stream') + function(qfw, 'avd_qfw_submit')
 post += '\nstatic int avd_submit_job(struct avd_ctx *ctx){return avd_open_build_program(ctx);}\n'
 
@@ -347,6 +348,62 @@ int main(int argc,char **argv){
  current_dst=&dst[0].base.vb;frame.idx=0;assert(!avd_av1_run(&ctx));
  assert(dst[0].bank==1&&p->bank[0].busy);
  avd_av1_done(&ctx,&src,&dst[0].base.vb,VB2_BUF_STATE_DONE);avd_av1_stop(&ctx);
+ /* av1_cdf_chain (default off): ONE AV1 VP engine, so a picture reads its primary reference's VP CDFs in place. */
+ av1_cdf_chain=true;queue.vp_pool[3]=BIT(9)|BIT(10);queue.next_vp[3]=0;
+ assert(!avd_av1_start(&ctx));p=((struct avd_av1_ctx *)ctx.priv)->stream;assert(p->nbanks==3&&!p->cdf_chain);avd_av1_stop(&ctx);
+ av1_cdf_chain=false;queue.vp_pool[3]=BIT(9);queue.next_vp[3]=0;
+ assert(!avd_av1_start(&ctx));p=((struct avd_av1_ctx *)ctx.priv)->stream;assert(p->nbanks==2&&!p->cdf_chain);avd_av1_stop(&ctx);
+ av1_cdf_chain=true;
+ assert(!avd_av1_start(&ctx));p=((struct avd_av1_ctx *)ctx.priv)->stream;assert(p->nbanks==2&&p->cdf_chain);
+ av1_cdf_chain=false; /* latched at start: a later write does not change this stream */
