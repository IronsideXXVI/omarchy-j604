 #define READ_ONCE(x) (x)
-static bool av1_mvs_after_vp, av1_out_packed;
+static bool av1_mvs_after_vp, av1_out_packed, av1_cdf_chain;
 static unsigned int av1_out_hdr58;
 #define WRITE_ONCE(x,v) ((x)=(v))
 #define static_assert _Static_assert
@@ -72,6 +72,7 @@ enum vb2_buffer_state { STATE_DUMMY };
