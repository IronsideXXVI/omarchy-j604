+ for(unsigned int i=0;i<7;i++)params.ref_frame_idx[i]=-1;
+ src.vb2_buf.timestamp=1000;current_dst=&dst[0].base.vb;frame.idx=0;
+ queue_request(&src);assert(avd_av1_ready(&ctx));assert(!avd_av1_run(&ctx));
+ assert(dst[0].bank==1&&p->bank[0].busy&&p->bank[0].prepared&&!p->bank[0].vp_done&&!p->bank[0].cdf_src);
+ params.frame_type=V4L2_AV1_INTER_FRAME;params.primary_ref_frame=0;params.ref_frame_idx[0]=0;params.reference_frame_ts[0]=1000;
+ src.vb2_buf.timestamp=1001;queue_request(&src);
+ assert(avd_av1_ready(&ctx)); /* no wait for picture 0's VP callback */
+ request_params.flags=V4L2_AV1_FRAME_FLAG_DISABLE_FRAME_END_UPDATE_CDF;assert(!avd_av1_ready(&ctx));
+ request_params.flags=V4L2_AV1_FRAME_FLAG_USE_REF_FRAME_MVS;assert(!avd_av1_ready(&ctx)); /* motion fields keep the PP wait */
+ request_params.flags=V4L2_AV1_FRAME_FLAG_ERROR_RESILIENT_MODE;assert(!avd_av1_ready(&ctx)); /* not chained: the old wait */
+ avd_av1_vp_done(&ctx,&dst[0].base.vb);assert(avd_av1_ready(&ctx));p->bank[0].vp_done=false;
+ request_params.flags=0;params=request_params;
+ memset(p->bank[0].codec.bufs.probs_out.cpu,0x6c,AVD_CDFS_SIZE);
+ memset(p->bank[1].codec.bufs.probs_out.cpu,0x11,AVD_CDFS_SIZE);
+ memset(p->bank[1].codec.bufs.probs.cpu,0x22,AVD_CDFS_SIZE);
+ current_dst=&dst[1].base.vb;frame.idx=1;assert(!avd_av1_run(&ctx));
+ assert(dst[1].bank==2&&p->bank[1].cdf_src==&p->bank[0]&&p->bank[0].cdf_users==1);
