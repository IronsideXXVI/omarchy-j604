From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 11:11:00 +0000
Subject: [PATCH] accel/ane: map the H16 XL window only on SoCs that
 have one

The H16 backend maps reg "aux-3", the second 32 MiB engine window, as
its XL window and applies a tunable group to it. The T8132 has no such
window: its ADT /arm-io/ane has six reg entries, the T6041 list without
aux-3 (J604 runtime ADT, MEASURED), and its DT node names none.

Add a platform flag for it. With no_xl set, acquire does not look the
window up and tunable groups that name the XL window are skipped and
logged. The T8132 platform sets it. Nothing changes for the T6041.

KUnit: a no-XL platform runs the boot to startup, never accesses the
XL window and applies every other tunable write. The simulator takes
the expected tunable write count per case instead of a constant.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
(cherry picked from commit fafd10d18bdeaa69a8d688ec90ccbd67eff09dc2)
(cherry picked from commit 9465a275bb6955e2531462cd1287238c0937e6e9)
---
 drivers/accel/ane/ane_fw_platform.c   |  1 +
 drivers/accel/ane/ane_fw_platform.h   |  5 +++++
 drivers/accel/ane/ane_h16_backend.c   |  6 +++++-
 drivers/accel/ane/ane_h16_boot.h      |  5 +++++
 drivers/accel/ane/ane_h16_boot_test.c | 20 ++++++++++++++++++--
 5 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/drivers/accel/ane/ane_fw_platform.c b/drivers/accel/ane/ane_fw_platform.c
index caf7d3eb22..3b4bbfd7be 100644
--- a/drivers/accel/ane/ane_fw_platform.c
+++ b/drivers/accel/ane/ane_fw_platform.c
@@ -131,6 +131,7 @@ const struct ane_fw_platform ane_h16_t8132_platform = {
 	.firmware_preloaded = true,
 	.safe_reset = false,
 	.dapf_range_count = 5,
+	.no_xl = true,
 	.identify_only = true,
 };
 
diff --git a/drivers/accel/ane/ane_fw_platform.h b/drivers/accel/ane/ane_fw_platform.h
index 0bd1747571..402d17378c 100644
--- a/drivers/accel/ane/ane_fw_platform.h
+++ b/drivers/accel/ane/ane_fw_platform.h
@@ -79,6 +79,11 @@ struct ane_fw_platform {
 	bool sleep_cold;
 	/* Number of apple,dapf-ranges pairs; 0 means four. */
 	u8 dapf_range_count;
+	/*
+	 * No second 32 MiB engine window (aux-3, the H16 XL window): nothing
+	 * maps it and tunable groups that name it are skipped.
+	 */
+	bool no_xl;
 	/*
 	 * Stop after the preload identity: preflight, resource geometry and the
 	 * firmware digest only, no power, DART or engine access.
diff --git a/drivers/accel/ane/ane_h16_backend.c b/drivers/accel/ane/ane_h16_backend.c
index 58175ebfc6..e27410eb6c 100644
--- a/drivers/accel/ane/ane_h16_backend.c
+++ b/drivers/accel/ane/ane_h16_backend.c
@@ -1408,8 +1408,12 @@ static int ane_h16_acquire(struct platform_device *pdev, struct ane_h16_device *
 	if (ret)
 		return ret;
 	for (i = 0; i < ARRAY_SIZE(names); i++) {
-		struct resource *r = platform_get_resource_byname(pdev, IORESOURCE_MEM, names[i]);
+		struct resource *r;
 
+		/* aux-3 is the XL window; the T8132 has none. */
+		if (i == ANE_H16_XL && h->boot.soc->no_xl)
+			continue;
+		r = platform_get_resource_byname(pdev, IORESOURCE_MEM, names[i]);
 		if (!r)
 			return -ENODEV;
 		h->window[i] = ioremap_np(r->start, resource_size(r));
diff --git a/drivers/accel/ane/ane_h16_boot.h b/drivers/accel/ane/ane_h16_boot.h
index 76314b1057..a259d3854a 100644
--- a/drivers/accel/ane/ane_h16_boot.h
+++ b/drivers/accel/ane/ane_h16_boot.h
@@ -422,6 +422,11 @@ static inline int ane_h16_prepare(struct ane_h16_boot *b)
 
 		if (group->c1ppt && !f->c1ppt)
 			continue;
+		if (group->window == ANE_H16_XL && b->soc->no_xl) {
+			b->ops->log(b->ctx, "tunables skipped, no XL window", group->window,
+				    group->count);
+			continue;
+		}
 		if (group->lock_mask &&
 		    (b->ops->read32(b->ctx, group->window, group->base +
 				    group->lock_offset) & group->lock_mask)) {
diff --git a/drivers/accel/ane/ane_h16_boot_test.c b/drivers/accel/ane/ane_h16_boot_test.c
index 7c3a33f250..d91f999a61 100644
--- a/drivers/accel/ane/ane_h16_boot_test.c
+++ b/drivers/accel/ane/ane_h16_boot_test.c
@@ -23,6 +23,7 @@ struct ane_h16_sim {
 	u32 command_count;
 	u32 scratch_writes;
 	u32 tuning_writes;
+	u32 expect_tuning;
 	u32 dapf_writes;
 	u32 mailbox_polls;
 	u32 maps;
@@ -204,7 +205,7 @@ static void sim_write32(void *ctx, enum ane_h16_window w, u32 off, u32 value)
 		s->dapf[off / 4] = value;
 		return;
 	}
-	KUNIT_EXPECT_TRUE(s->test, w == ANE_H16_ENGINE || w == ANE_H16_XL);
+	KUNIT_EXPECT_TRUE(s->test, w == ANE_H16_ENGINE || (w == ANE_H16_XL && !s->soc.no_xl));
 	if (w == ANE_H16_ENGINE && off == s->soc.irq_ack) {
 		s->irq &= ~value;
 		return;
@@ -230,7 +231,7 @@ static void sim_write32(void *ctx, enum ane_h16_window w, u32 off, u32 value)
 		if (s->scratch_writes < 8) {
 			KUNIT_EXPECT_EQ(s->test, cell, s->scratch_writes);
 			KUNIT_EXPECT_EQ(s->test, value, 0U);
-			KUNIT_EXPECT_EQ(s->test, s->tuning_writes, 103U);
+			KUNIT_EXPECT_EQ(s->test, s->tuning_writes, s->expect_tuning);
 		}
 		s->scratch_writes++;
 		s->scratch[cell] = value;
@@ -572,6 +573,8 @@ static int sim_init(struct kunit *test)
 	for (i = 0; i < ARRAY_SIZE(s->dapf); i++)
 		s->dapf[i] = i % 16 ? 0x5a5a0000 | i : 0;
 	s->dapf_stuck = -1;
+	/* Every T6041 26A428 AXI, XL and C1PPT write. */
+	s->expect_tuning = 103;
 	s->channel_request = 8;
 	s->ipc_request = 0xc440;
 	s->heap_request = 0xf00000;
@@ -608,6 +611,18 @@ static void ane_h16_dapf_five_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, ane_h16_dapf(&s->boot, true), -EINVAL);
 }
 
+/* No XL window (T8132): the XL group is skipped, the rest is applied. */
+static void ane_h16_no_xl_test(struct kunit *test)
+{
+	struct ane_h16_sim *s = test->priv;
+
+	s->soc.no_xl = true;
+	s->expect_tuning = 103 - ARRAY_SIZE(ane_h16_xl);
+	KUNIT_ASSERT_EQ(test, ane_h16_run(&s->boot, ANE_H16_STARTUP), 0);
+	KUNIT_EXPECT_TRUE(test, s->boot.ran);
+	KUNIT_EXPECT_EQ(test, s->tuning_writes, s->expect_tuning);
+}
+
 static void ane_h16_happy_test(struct kunit *test)
 {
 	struct ane_h16_sim *s = test->priv;
@@ -1187,6 +1202,7 @@ static void ane_h16_foreign_free_test(struct kunit *test)
 static struct kunit_case ane_h16_boot_cases[] = {
 	KUNIT_CASE(ane_h16_alloc_reuse_test),
 	KUNIT_CASE(ane_h16_happy_test),
+	KUNIT_CASE(ane_h16_no_xl_test),
 	KUNIT_CASE(ane_h16_locked_matching_test),
 	KUNIT_CASE(ane_h16_dapf_program_test),
 	KUNIT_CASE(ane_h16_dapf_five_test),
