From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 22:32:38 +0000
Subject: [PATCH] media: apple: prores: probe only on the T8132

The T8132 (M4) has a ProRes engine (ADT /arm-io/apr, three register
windows, two interrupts) and the binding describes it, but neither the
roles of its windows nor its engine and wrapper settings are known, and
the T8140 tables cannot be assumed to fit: its windows differ in number
and size.

Match "apple,t8132-prores" with a variant that is probe only: probe logs
why it stops and returns -ENODEV before it maps, requests or reads
anything, so the engine is never touched until its set-up is qualified.
The check is apr_admit(), shared by probe and KUnit.

KUnit (apple-prores): the T8132 is matched but not admitted (-ENODEV);
T8140 and T6000 are admitted; an engine without match data is not
matched at all (-ENOENT), so the T8132 entry cannot silently go missing.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 .../platform/apple/prores/apple-prores-drv.c  | 45 ++++++++++++++++++-
 .../platform/apple/prores/apple-prores-test.c | 11 +++++
 .../platform/apple/prores/apple-prores.h      |  4 ++
 3 files changed, 58 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/apple/prores/apple-prores-drv.c b/drivers/media/platform/apple/prores/apple-prores-drv.c
index e74a3ae099..f041a14036 100644
--- a/drivers/media/platform/apple/prores/apple-prores-drv.c
+++ b/drivers/media/platform/apple/prores/apple-prores-drv.c
@@ -28,6 +28,7 @@
 #include <linux/slab.h>
 #include <linux/spinlock.h>
 #include <linux/workqueue.h>
+#include <kunit/visibility.h>
 
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
@@ -266,6 +267,8 @@ struct apr_variant {
 	unsigned int num_irqs;
 	u32 ring_bytes;
 	u32 desc_bytes;
+	/* Matched, but its engine set-up is not known: never touched. */
+	bool probe_only;
 };
 
 static const struct apr_variant apr_t8140 = {
@@ -285,6 +288,15 @@ static const struct apr_variant apr_t8140 = {
 	.desc_bytes = APR_DESC_BYTES,
 };
 
+/*
+ * The T8132 engine: three register windows whose roles, and the engine and
+ * wrapper settings, are not known yet. It is matched so that its probe says
+ * why it stops, before anything is mapped or read.
+ */
+static const struct apr_variant apr_t8132 = {
+	.probe_only = true,
+};
+
 static const struct apr_variant apr_t6000 = {
 	.build_desc = apr_build_desc_v0,
 	.stats = { { 0x278, 0x27c, 0x280 }, { 0x358, 0x35c, 0x360 } },
@@ -1158,6 +1170,19 @@ static void apr_cleanup(void *data)
 	v4l2_device_unregister(&apr->v4l2_dev);
 }
 
+/* Whether probe may set up the engine of @v; @dev, if given, is told why not. */
+static int apr_admit(struct device *dev, const struct apr_variant *v)
+{
+	if (!v)
+		return -ENODEV;
+	if (v->probe_only) {
+		if (dev)
+			dev_info(dev, "probe only: ProRes engine not qualified on this SoC\n");
+		return -ENODEV;
+	}
+	return 0;
+}
+
 static int apr_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -1172,8 +1197,9 @@ static int apr_probe(struct platform_device *pdev)
 		return -ENOMEM;
 	apr->dev = dev;
 	apr->variant = of_device_get_match_data(dev);
-	if (!apr->variant)
-		return -ENODEV;
+	ret = apr_admit(dev, apr->variant);
+	if (ret)
+		return ret;
 	mutex_init(&apr->vdev_lock);
 	spin_lock_init(&apr->hw_lock);
 	INIT_DELAYED_WORK(&apr->watchdog, apr_watchdog);
@@ -1289,11 +1315,26 @@ static void apr_remove(struct platform_device *pdev)
 
 static const struct of_device_id apr_of_match[] = {
 	{ .compatible = "apple,t6000-prores", .data = &apr_t6000 },
+	{ .compatible = "apple,t8132-prores", .data = &apr_t8132 },
 	{ .compatible = "apple,t8140-prores", .data = &apr_t8140 },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, apr_of_match);
 
+#if IS_ENABLED(CONFIG_KUNIT)
+/* apr_admit() for the engine matched by @compatible; -ENOENT if none is. */
+VISIBLE_IF_KUNIT int apr_admit_compatible(const char *compatible)
+{
+	const struct of_device_id *id;
+
+	for (id = apr_of_match; id->compatible[0]; id++)
+		if (!strcmp(id->compatible, compatible))
+			return apr_admit(NULL, id->data);
+	return -ENOENT;
+}
+EXPORT_SYMBOL_IF_KUNIT(apr_admit_compatible);
+#endif
+
 static struct platform_driver apr_driver = {
 	.probe = apr_probe,
 	.remove = apr_remove,
diff --git a/drivers/media/platform/apple/prores/apple-prores-test.c b/drivers/media/platform/apple/prores/apple-prores-test.c
index 9ac7080e07..f2ced3cafe 100644
--- a/drivers/media/platform/apple/prores/apple-prores-test.c
+++ b/drivers/media/platform/apple/prores/apple-prores-test.c
@@ -336,6 +336,16 @@ static void apr_test_output(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, apr_check_output(out, SZ_4K, &bytes), -EIO);
 }
 
+/* The T8132 engine is matched but never set up; the known engines are set up. */
+static void apr_test_t8132_probe_only(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, apr_admit_compatible("apple,t8132-prores"), -ENODEV);
+	KUNIT_EXPECT_EQ(test, apr_admit_compatible("apple,t8140-prores"), 0);
+	KUNIT_EXPECT_EQ(test, apr_admit_compatible("apple,t6000-prores"), 0);
+	/* Not matched at all: no ProRes driver data for it */
+	KUNIT_EXPECT_EQ(test, apr_admit_compatible("apple,t6041-prores"), -ENOENT);
+}
+
 static struct kunit_case apr_test_cases[] = {
 	KUNIT_CASE(apr_test_qmat_regs),
 	KUNIT_CASE(apr_test_dc_scale),
@@ -348,6 +358,7 @@ static struct kunit_case apr_test_cases[] = {
 	KUNIT_CASE(apr_test_budgets),
 	KUNIT_CASE(apr_test_slices),
 	KUNIT_CASE(apr_test_output),
+	KUNIT_CASE(apr_test_t8132_probe_only),
 	{}
 };
 
diff --git a/drivers/media/platform/apple/prores/apple-prores.h b/drivers/media/platform/apple/prores/apple-prores.h
index d41fbdeff9..19796ad705 100644
--- a/drivers/media/platform/apple/prores/apple-prores.h
+++ b/drivers/media/platform/apple/prores/apple-prores.h
@@ -120,4 +120,8 @@ int apr_build_desc(const struct apr_frame *f, u8 *desc);
 int apr_build_desc_v0(const struct apr_frame *f, u8 *desc);
 int apr_check_output(const u8 *out, size_t capacity, u32 *frame_bytes);
 
+#if IS_ENABLED(CONFIG_KUNIT)
+int apr_admit_compatible(const char *compatible);
+#endif
+
 #endif
