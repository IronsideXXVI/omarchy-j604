From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
Date: Tue, 3 Nov 2026 09:04:51 -0600
Subject: [PATCH] tools: asahi: vote suite cases for the end-during-SET race,
 the backoff kick storm and the revived retry

Three cases for chriskearney's findings on #334, written first and red at
this commit:

- Case 20: an end lands between decide (SET) and applied. The end sees
  voted false, arms nothing, and applied then sets the vote with no user and
  an already-reached idle deadline. next() must return 1 there, not 0: 0 is
  the suite's "nothing pending", so the caller would never run the reconcile
  that clears the vote.
- Case 21: an idle gap beyond half the 32-bit millisecond range makes the
  wrapped arithmetic read an expired retry deadline as future, which would
  keep the vote off for days. A retry deadline more than one backoff window
  in the future cannot be real and counts as reached.
- Case 22: during backoff, begin must not ask for a reconciliation decide
  would refuse; the retry timer already drives the set.

Three mutants pin them (set-write-ends, retry-revival, begin-backoff-kick),
and stopped-in-begin now matches the begin line the fix will produce. Red
here: case 20 fails at `agx_vote_next(&v, 5001) == 1`.

Signed-off-by: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
(cherry picked from commit 825e9aca448e7e18386dafb6bea7ba4fa265b4c4)
---
 tools/asahi/pmp-agx-vote-tests.c  | 55 ++++++++++++++++++++++++++++++-
 tools/asahi/pmp-agx-vote-tests.py |  5 ++-
 tools/aurora-ci/host-tests.json   | 42 +++++++++++++++++++++++
 3 files changed, 100 insertions(+), 2 deletions(-)

diff --git a/tools/asahi/pmp-agx-vote-tests.c b/tools/asahi/pmp-agx-vote-tests.c
index 9ffb3541d6..f58c592b9a 100644
--- a/tools/asahi/pmp-agx-vote-tests.c
+++ b/tools/asahi/pmp-agx-vote-tests.c
@@ -16,6 +16,7 @@ struct sim {
 	bool armed;
 	uint32_t timer_at;
 	int begin_in_write;  // begin this many operations while the register write of the next reconcile is in progress
+	int kicks;           // reconciliations the operations asked for
 };
 
 static void arm(struct sim *s, uint32_t delay_ms)
@@ -62,8 +63,10 @@ static void reconcile(struct sim *s)
 
 static void begin(struct sim *s)
 {
-	if (agx_vote_begin(&s->v))
+	if (agx_vote_begin(&s->v)) {
+		s->kicks++;
 		arm(s, 0);
+	}
 }
 
 static void end(struct sim *s)
@@ -308,6 +311,56 @@ int main(void)
 		struct agx_vote w = {.enabled = true, .idle_ms = 100, .users = 1, .failures = 1, .retry_at = 0x54u};
 		CHECK(agx_vote_decide(&w, 0xFFFFFFF8u) == AGX_VOTE_NONE);
 	}
+	// 20. chriskearney's race: the last end lands between decide (SET) and applied. end saw voted false and
+	// armed nothing; applied then sets the vote with no user and an already-reached idle deadline. The
+	// caller must still be told to run the reconcile that clears it.
+	{
+		// exactly the reviewer's interleaving, on the header alone: decide, then end, then the write lands
+		struct agx_vote v = {.enabled = true, .idle_ms = 0};
+		CHECK(agx_vote_begin(&v) && v.users == 1);
+		CHECK(agx_vote_decide(&v, 5000) == AGX_VOTE_SET);
+		CHECK(agx_vote_end(&v, 5001) == 0);                   // the end during the write sees voted false: no timer
+		CHECK(v.users == 0);
+		agx_vote_applied(&v, AGX_VOTE_SET, 0, 5000);
+		CHECK(v.voted && v.users == 0);
+		CHECK(agx_vote_next(&v, 5001) == 1);                  // an already-reached deadline is due now, not "nothing"
+		CHECK(agx_vote_decide(&v, 5001) == AGX_VOTE_CLEAR);
+		agx_vote_applied(&v, AGX_VOTE_CLEAR, 0, 5001);
+		CHECK(!v.voted && agx_vote_next(&v, 5001) == 0);      // and it settles
+	}
+	// 21. chriskearney's bound: an idle gap beyond half the 32-bit millisecond range makes the wrapped
+	// arithmetic read an expired retry deadline as future, which would keep the vote off for days. A retry
+	// deadline more than one backoff window in the future cannot be real, so it counts as reached.
+	{
+		struct sim s = fresh(true, 100, 0);
+		s.fail_sets = 1;
+		begin(&s); advance_to(&s, 0);
+		CHECK(s.v.failures == 1);
+		s.v.retry_at = 0x54u;
+		advance_to(&s, 0x54u + 0x80000005u);                  // the timer fires absurdly late
+		CHECK(s.bit && s.sets == 2 && s.v.failures == 0);     // the vote is set again at once
+		// the header alone
+		struct agx_vote w = {.enabled = true, .users = 1, .failures = 1, .retry_at = 0x54u};
+		CHECK(agx_vote_decide(&w, 0x54u + 0x80000005u) == AGX_VOTE_SET);
+		CHECK(agx_vote_next(&w, 0x54u + 0x80000005u) == 1);
+	}
+	// 22. the same review: during backoff begin must not ask for a reconciliation decide would refuse
+	// (every begin during the window kicked a NONE reconcile and the retry timer did the work anyway)
+	{
+		struct sim s = fresh(true, 100, 0);
+		s.fail_sets = 1;
+		begin(&s); advance_to(&s, 0);
+		CHECK(s.v.failures == 1 && s.armed);
+		int kicks = s.kicks;
+		for (int i = 0; i < 5; i++)
+			begin(&s);
+		CHECK(s.kicks == kicks && s.sets == 1);               // no kicks, no sets: the timer drives it
+		advance_to(&s, AGX_VOTE_RETRY_MS);
+		CHECK(s.sets == 2 && s.bit && s.v.failures == 0);
+		// the header alone
+		struct agx_vote v = {.enabled = true, .failures = 1};
+		CHECK(!agx_vote_begin(&v));
+	}
 	printf("AGX-VOTE-SELFCHECK-OK\n");
 	return 0;
 }
diff --git a/tools/asahi/pmp-agx-vote-tests.py b/tools/asahi/pmp-agx-vote-tests.py
index 7377d14a07..881a2e85d6 100755
--- a/tools/asahi/pmp-agx-vote-tests.py
+++ b/tools/asahi/pmp-agx-vote-tests.py
@@ -30,10 +30,13 @@ HEADER = 'drivers/pmdomain/apple/pmp-agx-vote.h'
 CONTROLS = [
     ('owed-set-branch', '\tif (v->users && !v->voted && !v->failures)\n\t\treturn 1;\n', ''),
     ('owed-failures', 'if (v->users && !v->voted && !v->failures)\n\t\treturn 1;', 'if (v->users && !v->voted)\n\t\treturn 1;'),
-    ('stopped-in-begin', 'return v->enabled && !v->voted && !v->stopped;', 'return v->enabled && !v->voted;'),
+    ('stopped-in-begin', 'return v->enabled && !v->voted && !v->stopped && !v->failures;', 'return v->enabled && !v->voted && !v->failures;'),
     ('stopped-in-decide', 'if (!v->enabled || v->stopped)\n\t\treturn v->voted ? AGX_VOTE_CLEAR : AGX_VOTE_NONE;',
      'if (!v->enabled)\n\t\treturn v->voted ? AGX_VOTE_CLEAR : AGX_VOTE_NONE;'),
     ('wrap-reached', 'return (agx_sms_t)(now - t) >= 0;', 'return now >= t;'),
+    ('set-write-ends', 'return agx_vote_reached(now, at) ? 1 : at - now;', 'return agx_vote_reached(now, at) ? 0 : at - now;'),
+    ('begin-backoff-kick', 'return v->enabled && !v->voted && !v->stopped && !v->failures;', 'return v->enabled && !v->voted && !v->stopped;'),
+    ('retry-revival', '|| (agx_sms_t)(v->retry_at - now) > (agx_sms_t)AGX_VOTE_RETRY_MS', ''),
 ]
 
 
