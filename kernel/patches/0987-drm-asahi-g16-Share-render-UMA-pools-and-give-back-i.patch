From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 21 Nov 2026 17:23:49 +0000
Subject: [PATCH] drm/asahi: g16: Share render UMA pools and give back
 idle units by default

A VM's render units each built a 32 MiB render UMA pool and units 0/1
a full TPC and tilemap, held until the VM closes, so every GPU client
paid for its busiest moment for the rest of its life. Turn on the four
words that undo that: later units and unit 1 build on unit 0's pool,
units 0/1 start with a small TPC and tilemap and grow on demand, and a
VM idle for 5 s gives back the later units it built.

Each word stays runtime 0644, and writing 0 brings back the old behaviour.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 24 ++++++++++++------------
 1 file changed, 12 insertions(+), 12 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 610352786f7..8f37a48fcc7 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2941,8 +2941,8 @@ pub(crate) fn pb_pool() -> u32 {
     "G16: PB managers a VM keeps for reuse instead of building one per render command in SUBMIT (default 8; 0: one per command, as before; max 16; runtime 0644)"
 );
 
-/// Storage of `g16_unit_one_pool` (runtime 0644, default 0; read when a unit is built).
-static UNIT_ONE_POOL: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_unit_one_pool` (runtime 0644, default 1; read when a unit is built).
+static UNIT_ONE_POOL: AtomicU32 = AtomicU32::new(1);
 
 /// Whether a render unit a VM builds after its first render (`g16_resident_lazy`, unit 2 on)
 /// binds unit 0's render UMA descriptor, pool and submitted counter instead of building its
@@ -2958,12 +2958,12 @@ pub(crate) fn unit_one_pool() -> bool {
     UNIT_ONE_POOL_PARM,
     UNIT_ONE_POOL,
     "g16_unit_one_pool",
-    "G16: render units a VM builds after its first render share unit 0's render UMA pool instead of a 32 MiB pool each (default 0; read when a unit is built; runtime 0644)"
+    "G16: render units a VM builds after its first render share unit 0's render UMA pool instead of a 32 MiB pool each (default 1; read when a unit is built; runtime 0644)"
 );
 
-/// Storage of `g16_unit1_one_pool` (runtime 0644, default 0; read when a VM builds its first
+/// Storage of `g16_unit1_one_pool` (runtime 0644, default 1; read when a VM builds its first
 /// render units).
-static UNIT1_ONE_POOL: AtomicU32 = AtomicU32::new(0);
+static UNIT1_ONE_POOL: AtomicU32 = AtomicU32::new(1);
 
 /// Whether render unit 1, which a VM builds with unit 0 at its first render, binds unit 0's
 /// render UMA descriptor, pool and submitted counter (as `g16_unit_one_pool` does for the
@@ -2979,7 +2979,7 @@ pub(crate) fn unit1_one_pool() -> bool {
     UNIT1_ONE_POOL_PARM,
     UNIT1_ONE_POOL,
     "g16_unit1_one_pool",
-    "G16: render unit 1 shares unit 0's render UMA pool instead of a 32 MiB pool of its own (default 0; read when a VM builds its first render units; runtime 0644)"
+    "G16: render unit 1 shares unit 0's render UMA pool instead of a 32 MiB pool of its own (default 1; read when a VM builds its first render units; runtime 0644)"
 );
 
 /// Storage of `g16_resident` (runtime 0644, default 8).
@@ -3001,9 +3001,9 @@ pub(crate) fn resident_compact() -> bool {
     resident_latch() & 0x100 != 0
 }
 
-/// Storage of `g16_unit_large_lazy` (runtime 0644, default 0; read when a VM builds its first
+/// Storage of `g16_unit_large_lazy` (runtime 0644, default 1; read when a VM builds its first
 /// render units).
-static UNIT_LARGE_LAZY: AtomicU32 = AtomicU32::new(0);
+static UNIT_LARGE_LAZY: AtomicU32 = AtomicU32::new(1);
 
 /// `g16_unit_large_lazy` 1: render units 0 and 1 get a 1 MiB TPC and a 1 MiB tilemap at their
 /// usual addresses instead of 16 / 8 MiB; the first render no unit's own set fits builds a
@@ -3020,7 +3020,7 @@ pub(crate) fn unit_large_lazy() -> bool {
     UNIT_LARGE_LAZY_PARM,
     UNIT_LARGE_LAZY,
     "g16_unit_large_lazy",
-    "G16: 1 = render units 0/1 start with a 1 MiB TPC and tilemap; unit 0 builds the full set on demand (default 0; read when a VM builds its first render units; runtime 0644)"
+    "G16: 1 = render units 0/1 start with a 1 MiB TPC and tilemap; unit 0 builds the full set on demand (default 1; read when a VM builds its first render units; runtime 0644)"
 );
 
 /// The latch word: units | compact << 8, set once from `g16_resident` and
@@ -3123,8 +3123,8 @@ pub(crate) fn resident_lazy_async() -> bool {
     "G16: a VM's first render builds only its two full render units; the others are built when it queues deeper: 1 in SUBMIT, 2 by a worker (default 2; 0: all at the first render; read when a VM builds units)"
 );
 
-/// Storage of `g16_unit_trim` (runtime 0644, default 0).
-static UNIT_TRIM: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_unit_trim` (runtime 0644, default 5000).
+static UNIT_TRIM: AtomicU32 = AtomicU32::new(5000);
 
 /// `g16_unit_trim` N: the next submission of a VM that has had no render command outstanding
 /// for N ms first gives back the render units it built after its first render, from the
@@ -3141,7 +3141,7 @@ pub(crate) fn unit_trim_ms() -> u32 {
     UNIT_TRIM_PARM,
     UNIT_TRIM,
     "g16_unit_trim",
-    "G16: N ms = a VM idle that long gives back the render units it built later at its next submission (default 0: kept until it closes)"
+    "G16: N ms = a VM idle that long gives back the render units it built later at its next submission (default 5000; 0: kept until it closes)"
 );
 
 /// Storage of `g16_loader_macos` (0644, default 7; read once, when initdata is built).
-- 
