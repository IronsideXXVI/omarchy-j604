diff --git a/drivers/gpu/drm/asahi/g16/hw.rs b/drivers/gpu/drm/asahi/g16/hw.rs
index 4ff61352ce..e9d3ecb178 100644
--- a/drivers/gpu/drm/asahi/g16/hw.rs
+++ b/drivers/gpu/drm/asahi/g16/hw.rs
@@ -246,6 +246,34 @@ pub(crate) const fn render_base(k: u64) -> u64 {
     pub(crate) const fn resident_window(k: u64) -> u64 {
         RESIDENT_BASE + (k - 2) * RESIDENT_WINDOW
     }
+    /// Compact resident units (k >= 2, `g16_resident_compact`): one 64 MiB window each in the
+    /// same interval. Pass objects at the qualified offsets from the base (they end at
+    /// +1.5 MiB), a 1 MiB TPC at +2 MiB, a 1 MiB tilemap at +4 MiB (a single-layer
+    /// 3024x1964 render needs 48 KiB / 32 KiB with 32-pixel utiles, 192 KiB / 120 KiB with
+    /// 16), the allocator (the qualified 32 MiB pool and its lists) at +8 MiB, a 16 MiB PB
+    /// heap (128 blocks) at +44 MiB.
+    pub(crate) const COMPACT_UNIT_WINDOW: u64 = 0x4000000;
+    pub(crate) const COMPACT_TPC_OFF: u64 = 0x200000;
+    pub(crate) const COMPACT_TPC_SIZE: u64 = 0x100000;
+    pub(crate) const COMPACT_TILEMAP_OFF: u64 = 0x400000;
+    pub(crate) const COMPACT_TILEMAP_SIZE: u64 = 0x100000;
+    pub(crate) const COMPACT_ALLOC_OFF: u64 = 0x800000;
+    pub(crate) const COMPACT_PB_HEAP_OFF: u64 = 0x2c00000;
+    pub(crate) const COMPACT_PB_HEAP_SIZE: u64 = 0x1000000;
+    pub(crate) const fn compact_window(k: u64) -> u64 {
+        RESIDENT_BASE + (k - 2) * COMPACT_UNIT_WINDOW
+    }
+    // Both resident layouts end below the qualified PB heaps; compact parts do not overlap
+    // (the allocator spans 0x2074000: pool, state, list, descriptor, PB pages, scene list).
+    const _: () = assert!(
+        resident_window(super::sizes::FULL_RESIDENT_UNITS as u64 - 1) + RESIDENT_WINDOW <= PB_HEAP
+            && compact_window(super::sizes::RENDER_UNITS as u64 - 1) + COMPACT_UNIT_WINDOW <= PB_HEAP
+            && AUX + 0x20000 - FS_WORK_PAGE <= COMPACT_TPC_OFF
+            && COMPACT_TPC_OFF + COMPACT_TPC_SIZE <= COMPACT_TILEMAP_OFF
+            && COMPACT_TILEMAP_OFF + COMPACT_TILEMAP_SIZE <= COMPACT_ALLOC_OFF
+            && COMPACT_ALLOC_OFF + 0x2074000 <= COMPACT_PB_HEAP_OFF
+            && COMPACT_PB_HEAP_OFF + COMPACT_PB_HEAP_SIZE <= COMPACT_UNIT_WINDOW
+    );
     /// The shift of pass slot `k`'s objects from slot 0's: `k` 256 MiB strides for the two
     /// qualified slots, the unit's resident window for k >= 2.
     // pass_shift() moves every pass object by one shift: the qualified strides agree.
@@ -336,12 +364,16 @@ pub(crate) mod sizes {
     /// (see `Firmware::ahead_ok()`). Compute stays bounded by [`COMPUTE_SLOTS`].
     pub(crate) const FLIGHTS: usize = RENDER_UNITS;
     /// Render pass units (pass slot, UMA/heap allocator, PB slot) a VM may hold: the two
-    /// qualified units, plus two resident units allocated only when `g16_resident` >= 3 is
+    /// qualified units, plus resident units allocated only when `g16_resident` >= 3 is
     /// latched (one render command in flight per unit; each binds its own split UMA slot,
     /// render 33 + k of the 32 per class of the 25G83 layout). Bounded by the free client
-    /// aperture: an extra unit takes a 512 MiB window (its 256 MiB PB heap and 32 MiB pool
-    /// are backed in full) and only [`client::RESIDENT_BASE`].. 0x70c0000000 is free.
-    pub(crate) const RENDER_UNITS: usize = 4;
+    /// aperture, [`client::RESIDENT_BASE`]..0x70c0000000 (1 GiB): a full-size resident unit
+    /// takes a 512 MiB window (its 256 MiB PB heap and 32 MiB pool are backed in full), so
+    /// [`FULL_RESIDENT_UNITS`] in all; a compact one (`g16_resident_compact`) takes 64 MiB
+    /// (1 MiB TPC, 1 MiB tilemap, the same 32 MiB pool, a 16 MiB PB heap), so 2 + 16.
+    pub(crate) const RENDER_UNITS: usize = 18;
+    /// Units with full-size resident units only (`g16_resident_compact` = 0).
+    pub(crate) const FULL_RESIDENT_UNITS: usize = 4;
     /// Inherited diagnostic histogram width; M4 does not fold jobs into a compute horizon.
     pub(crate) const HORIZON_JOBS: u32 = 1;
     /// Two jobs may be admitted per logical queue so exact prior-command dependencies can
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index d64c45412d..63339f9b80 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -931,20 +931,47 @@ pub(crate) fn flights() -> usize {
 /// (module option in the initramfs). Latched once; later changes of `g16_resident` only
 /// lower the depth ([`resident`]).
 pub(crate) fn resident_units() -> usize {
+    (resident_latch() & 0xff) as usize
+}
+
+/// Whether the latched resident units (k >= 2) are compact ones (`g16_resident_compact`).
+pub(crate) fn resident_compact() -> bool {
+    resident_latch() & 0x100 != 0
+}
+
+/// The latch word: units | compact << 8, set once from `g16_resident` and
+/// `g16_resident_compact` (full-size units: at most [`hw::sizes::FULL_RESIDENT_UNITS`];
+/// compact: at most [`hw::sizes::RENDER_UNITS`]).
+fn resident_latch() -> u32 {
     let l = RESIDENT_LATCH.load(Ordering::Acquire);
     if l != 0 {
-        return l as usize;
+        return l;
     }
     let v = RESIDENT.load(Ordering::Relaxed);
-    let units = if v >= 3 {
-        v.min(hw::sizes::RENDER_UNITS as u32)
+    let compact = RESIDENT_COMPACT.load(Ordering::Relaxed) != 0;
+    let max = if compact {
+        hw::sizes::RENDER_UNITS
     } else {
-        2
+        hw::sizes::FULL_RESIDENT_UNITS
     };
-    let _ = RESIDENT_LATCH.compare_exchange(0, units, Ordering::AcqRel, Ordering::Acquire);
-    RESIDENT_LATCH.load(Ordering::Acquire) as usize
+    let units = if v >= 3 { v.min(max as u32) } else { 2 };
+    let word = units | u32::from(compact && units > 2) << 8;
+    let _ = RESIDENT_LATCH.compare_exchange(0, word, Ordering::AcqRel, Ordering::Acquire);
+    RESIDENT_LATCH.load(Ordering::Acquire)
 }
 
+/// Storage of `g16_resident_compact` (0644, default 0; read with `g16_resident` at the latch).
+static RESIDENT_COMPACT: AtomicU32 = AtomicU32::new(0);
+
+live_u32_param!(
+    RESIDENT_COMPACT_PARAM,
+    RESIDENT_COMPACT_PARMTYPE,
+    RESIDENT_COMPACT_PARM,
+    RESIDENT_COMPACT,
+    "g16_resident_compact",
+    "G16: resident render units 2.. are compact (1 MiB TPC/tilemap, 16 MiB PB heap of 128 blocks; about 51 MiB each) so g16_resident may reach 18; set at module load with g16_resident (default 0: full-size units, at most 4; latched)"
+);
+
 /// Resident render depth: how many render commands may sit in the firmware's TA/FS rings at
 /// once, each in its own render pass unit, retired in order as their receipts complete (one
 /// ring-service event may retire several). 0 (`g16_resident` < 2, or `g16_overlap` /
@@ -973,7 +1000,7 @@ pub(crate) fn resident_credits() -> u32 {
     RESIDENT_PARM,
     RESIDENT,
     "g16_resident",
-    "G16: render commands that may be resident in the firmware rings at once, each in its own render unit (default 0: off; 2..4; >= 3 must be set at module load to allocate the extra units; needs g16_overlap=1 and g16_uma_split=1; runtime 0644)"
+    "G16: render commands that may be resident in the firmware rings at once, each in its own render unit (default 0: off; 2..4, 2..18 with g16_resident_compact=1; >= 3 must be set at module load to allocate the extra units; needs g16_overlap=1 and g16_uma_split=1; runtime 0644)"
 );
 
 /// Storage of `g16_submit_ahead` (runtime 0644, default 0).
