         let scene_list = alloc(
             o,
             buffer::SCENE_LIST_SIZE,
@@ -192,6 +216,7 @@ fn new(o: &mut Objects, k: u64) -> Result<Self> {
             published: AtomicBool::new(false),
             id: k as u32,
