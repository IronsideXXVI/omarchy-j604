From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 08:03:02 +0000
Subject: [PATCH] cpuidle: apple: let the cluster driver slow an
 all-idle cluster (M4)

From M4 on both idle states are WFI, since CYC_OVRD is locked, and a
core waiting in WFI stays at its cluster's P-state. A cluster whose
cores are all idle therefore keeps the state the governor last chose:
with the performance governor, the top one.

Give the second state its own entry point, which calls optional
enter/exit hooks around the WFI with RCU watching, and a target
residency of 1 ms, so the governor only picks it for a long idle. The
cluster performance-state driver registers the hooks once at boot.
Suspend-to-idle keeps a plain WFI: the cpufreq core already holds the
clusters at their suspend frequency then.

The exit latency is 75 us: on T8132 the woken CPU runs at once while
its cluster ramps, and with a busy core the cluster is at 2868 MHz or
more within 75 us of the request (20 of 20 trials, mean 59 us).

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit d78ad8c2c4f4c82f41d4d53f5911a606212f63fb)
---
 drivers/cpuidle/cpuidle-apple.c        | 72 ++++++++++++++++++++++++--
 include/linux/soc/apple/cluster-idle.h | 27 ++++++++++
 2 files changed, 94 insertions(+), 5 deletions(-)
 create mode 100644 include/linux/soc/apple/cluster-idle.h

diff --git a/drivers/cpuidle/cpuidle-apple.c b/drivers/cpuidle/cpuidle-apple.c
index 09554f74cb..d8f941e04b 100644
--- a/drivers/cpuidle/cpuidle-apple.c
+++ b/drivers/cpuidle/cpuidle-apple.c
@@ -10,6 +10,7 @@
 #include <linux/cpu_pm.h>
 #include <linux/platform_device.h>
 #include <linux/of.h>
+#include <linux/soc/apple/cluster-idle.h>
 #include <asm/cpuidle.h>
 
 enum idle_state {
@@ -93,6 +94,66 @@ static __cpuidle int apple_enter_idle(struct cpuidle_device *dev, struct cpuidle
 	return index;
 }
 
+/*
+ * Cluster idle hooks, M4 and later
+ *
+ * An idle core waits in WFI at its cluster's P-state, so a cluster whose
+ * cores are all idle keeps running at whatever state the governor last
+ * chose: with the performance governor, the top one. The cluster driver can
+ * drop such a cluster to its slowest state and restore it on the first wake.
+ * The hooks run only from the second state, which the governor picks for a
+ * predicted idle of at least its target residency, never in suspend-to-idle
+ * (the cpufreq core already takes the clusters to their suspend frequency).
+ * The cluster driver registers them once at boot and never removes them.
+ */
+static const struct apple_cluster_idle_ops *apple_cluster_ops;
+
+void apple_cpuidle_set_cluster_ops(const struct apple_cluster_idle_ops *ops)
+{
+	WRITE_ONCE(apple_cluster_ops, ops);
+}
+EXPORT_SYMBOL_GPL(apple_cpuidle_set_cluster_ops);
+
+static __cpuidle int apple_enter_cluster_wfi(struct cpuidle_device *dev,
+					     struct cpuidle_driver *drv, int index)
+{
+	const struct apple_cluster_idle_ops *ops = READ_ONCE(apple_cluster_ops);
+
+	if (ops)
+		ops->enter(dev->cpu);
+	ct_cpuidle_enter();
+	cpu_do_idle();
+	ct_cpuidle_exit();
+	if (ops)
+		ops->exit(dev->cpu);
+	return index;
+}
+
+static __cpuidle int apple_enter_s2idle_wfi(struct cpuidle_device *dev,
+					    struct cpuidle_driver *drv, int index)
+{
+	ct_cpuidle_enter();
+	cpu_do_idle();
+	ct_cpuidle_exit();
+	return index;
+}
+
+/* The second state from M4 on: WFI, letting an all-idle cluster slow down. */
+static const struct cpuidle_state apple_cluster_wfi_state = {
+	.enter			= apple_enter_cluster_wfi,
+	.enter_s2idle		= apple_enter_s2idle_wfi,
+	/*
+	 * The woken CPU runs at once while the cluster ramps: on T8132 with a
+	 * busy core it is at 2868 MHz or more within 75 us of the request.
+	 */
+	.exit_latency		= 75,
+	.target_residency	= 1000,
+	.power_usage		= 0,
+	.name			= "WFI-CL",
+	.desc			= "WFI, idle cluster slowed",
+	.flags			= CPUIDLE_FLAG_RCU_IDLE,
+};
+
 static struct cpuidle_driver apple_idle_driver = {
 	.name = "apple_idle",
 	.owner = THIS_MODULE,
@@ -135,13 +196,14 @@ static int apple_cpuidle_probe(struct platform_device *pdev)
 {
 	/*
 	 * CPU PD writes CYC_OVRD, which only M1 to M3 let the OS write. From
-	 * M4 on it is locked and the write is undefined, and WFI already
-	 * power-gates an idle core, so both entries use WFI. Keep index 1:
-	 * the generic s2idle selector skips fallback index 0, otherwise
-	 * tick_freeze() and timekeeping suspension are never reached.
+	 * M4 on it is locked and the write is undefined, so both entries use
+	 * WFI; the second one also runs the cluster idle hooks, see
+	 * apple_cpuidle_set_cluster_ops(). Keep index 1: the generic s2idle
+	 * selector skips fallback index 0, otherwise tick_freeze() and
+	 * timekeeping suspension are never reached.
 	 */
 	if (!of_machine_compatible_match(apple_cyc_ovrd_machines))
-		apple_idle_driver.states[STATE_PWRDOWN] = apple_idle_driver.states[STATE_WFI];
+		apple_idle_driver.states[STATE_PWRDOWN] = apple_cluster_wfi_state;
 
 	return cpuidle_register(&apple_idle_driver, NULL);
 }
diff --git a/include/linux/soc/apple/cluster-idle.h b/include/linux/soc/apple/cluster-idle.h
new file mode 100644
index 0000000000..c40deb9442
--- /dev/null
+++ b/include/linux/soc/apple/cluster-idle.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Apple SoC cluster idle hooks, between cpuidle-apple and the cluster
+ * performance-state driver.
+ */
+#ifndef _LINUX_SOC_APPLE_CLUSTER_IDLE_H_
+#define _LINUX_SOC_APPLE_CLUSTER_IDLE_H_
+
+/**
+ * struct apple_cluster_idle_ops - called by a CPU around a long WFI
+ * @enter: @cpu is about to wait, interrupts disabled
+ * @exit: @cpu has woken, interrupts still disabled
+ *
+ * Both run in the idle path with RCU watching and must not sleep.
+ */
+struct apple_cluster_idle_ops {
+	void (*enter)(unsigned int cpu);
+	void (*exit)(unsigned int cpu);
+};
+
+#if IS_REACHABLE(CONFIG_ARM_APPLE_CPUIDLE)
+void apple_cpuidle_set_cluster_ops(const struct apple_cluster_idle_ops *ops);
+#else
+static inline void apple_cpuidle_set_cluster_ops(const struct apple_cluster_idle_ops *ops) { }
+#endif
+
+#endif /* _LINUX_SOC_APPLE_CLUSTER_IDLE_H_ */
-- 
2.43.0

