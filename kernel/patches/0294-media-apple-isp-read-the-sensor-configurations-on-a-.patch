From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 02:23:14 +0000
Subject: [PATCH] media: apple: isp: read the sensor configurations on
 a deferred start

The firmware reports a list of sensor configurations: the readout
windows and output sizes it can run. The driver reads it with
CH_CAMERA_CONFIG_GET only for the T6040 IMX958, where the list also
qualifies the P010 presets, and prints it with VIDIOC_LOG_STATUS.

A deferred start (T8132) detects the camera only at the first stream,
after the device tree presets were advertised, so the list is never
read there and the modes of such a board cannot be established from
what its firmware says.

Behind the new apple_isp.discover_configs parameter, off by default,
read the list at that detection as well, for VIDIOC_LOG_STATUS only.
It is the same read-only command with the same reply size the T6040
path sends. No format changes, and a failed read is reported and
leaves the camera as it was.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-cam.c | 65 ++++++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index d136ece49d..5fd74e7e7d 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -2,6 +2,7 @@
 /* Copyright 2023 Eileen Yoon <eyn@gmx.com> */
 
 #include <linux/firmware.h>
+#include <linux/moduleparam.h>
 #include <linux/gcd.h>
 #include <linux/unaligned.h>
 #include <kunit/static_stub.h>
@@ -346,6 +347,68 @@ free_configs:
 	return err;
 }
 
+/*
+ * A deferred start detects the camera after its formats were advertised, so
+ * the configuration discovery above does not run there. On request, read the
+ * firmware's configuration list anyway, only for VIDIOC_LOG_STATUS: it is
+ * how the sensor modes and readout windows of such a board are established.
+ * It changes no format, and a failed read leaves the camera as it was.
+ */
+static bool discover_configs;
+module_param(discover_configs, bool, 0644);
+MODULE_PARM_DESC(discover_configs,
+		 "Deferred-start SoCs: read the sensor configurations at the first stream, for VIDIOC_LOG_STATUS (default: off)");
+
+static void isp_ch_read_sensor_configs(struct apple_isp *isp, u32 ch, u32 count)
+{
+	struct cmd_ch_camera_config_h17 args;
+	struct isp_sensor_config *configs;
+	int err = 0;
+
+	if (!discover_configs || !isp->hw->deferred_start ||
+	    isp->hw->fw_abi != ISP_FW_ABI_H17 || isp->sensor_configs)
+		return;
+	if (!count || count > ISP_MAX_SENSOR_CONFIGS) {
+		dev_warn(isp->dev, "sensor configs: firmware reports %u\n", count);
+		return;
+	}
+
+	configs = kcalloc(count, sizeof(*configs), GFP_KERNEL);
+	if (!configs)
+		return;
+
+	for (u32 i = 0; i < count; i++) {
+		struct cmd_ch_camera_config *config = &args.config;
+		struct isp_sensor_config *cached = &configs[i];
+
+		err = isp_cmd_ch_camera_config_get(isp, ch, i, &args);
+		if (err)
+			break;
+		if (config->opcode != (u64)CISP_CMD_CH_CAMERA_CONFIG_GET << 32 ||
+		    config->chan != ch || config->preset != i) {
+			err = -EIO;
+			break;
+		}
+
+		memcpy(cached->reply, &args, sizeof(args));
+		cached->input_dim = (struct coord){config->in_width, config->in_height};
+		cached->output_dim = (struct coord){config->out_width, config->out_height};
+		cached->sensor_clk = config->sensor_clk;
+		cached->usable = isp_sensor_config_usable(config);
+	}
+
+	if (err) {
+		dev_warn(isp->dev, "sensor configs not read: %d\n", err);
+		kfree(configs);
+		return;
+	}
+
+	isp->sensor_configs = configs;
+	isp->num_sensor_configs = count;
+	dev_info(isp->dev, "read %u sensor configs, listed by VIDIOC_LOG_STATUS\n",
+		 count);
+}
+
 /* Common call sizes, offered only when a known processed crop contains them. */
 static const struct coord isp_call_sizes[] = {
 	{ 640, 480 }, { 1280, 720 }, { 1920, 1080 }, { 1080, 1920 },
@@ -496,6 +559,8 @@ static int isp_ch_cache_sensor_info(struct apple_isp *isp, u32 ch)
 	err = isp_check_presets(isp, args->num_presets);
 	if (!err)
 		err = isp_ch_cache_sensor_configs(isp, ch, args->num_presets);
+	if (!err)
+		isp_ch_read_sensor_configs(isp, ch, args->num_presets);
 	if (!err)
 		err = isp_add_call_sizes(isp);
 
