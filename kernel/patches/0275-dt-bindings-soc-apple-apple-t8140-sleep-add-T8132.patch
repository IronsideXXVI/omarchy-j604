From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bartosz Nitka <niteria@gmail.com>
Date: Sun, 8 Nov 2026 15:12:39 +0100
Subject: [PATCH] dt-bindings: soc: apple: apple,t8140-sleep: add T8132

The M4's (T8132) sleep controller is driven like T8140's, from fewer
register blocks: two AMCC planes and two memory channels instead of four
and three. It also has the PMGR's clock-protection slices ("ps-prot"),
which guard the external display domains' CPU words.

Add the compatible with its register list, and keep T8140's list for
T8140. apple,wake-enable stays required on T8140 only: without it a
T8132 still probes, and refuses every sleep.

Assisted-by: LLM
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 2b5bba9c7396c7609678f0160c4ac12e6dc9cadc)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../bindings/soc/apple/apple,t8140-sleep.yaml | 119 +++++++++++++-----
 1 file changed, 88 insertions(+), 31 deletions(-)

diff --git a/Documentation/devicetree/bindings/soc/apple/apple,t8140-sleep.yaml b/Documentation/devicetree/bindings/soc/apple/apple,t8140-sleep.yaml
index 3498a9e913..bdbe2a5cca 100644
--- a/Documentation/devicetree/bindings/soc/apple/apple,t8140-sleep.yaml
+++ b/Documentation/devicetree/bindings/soc/apple/apple,t8140-sleep.yaml
@@ -19,41 +19,16 @@ description: |
 properties:
   compatible:
     enum:
+      - apple,t8132-sleep
       - apple,t8140-sleep
 
   reg:
+    minItems: 25
     maxItems: 28
 
   reg-names:
-    items:
-      - const: ps
-      - const: pwrgate
-      - const: cpu-start
-      - const: cllt
-      - const: cluster
-      - const: commit
-      - const: wdt
-      - const: aon-misc
-      - const: wake
-      - const: amcc0
-      - const: amcc1
-      - const: amcc2
-      - const: amcc3
-      - const: pmc-dcp
-      - const: dvfm-e
-      - const: dvfm-p
-      - const: spmi
-      - const: pmc-voters
-      - const: dcs
-      - const: ps-aon
-      - const: spmi-a0
-      - const: clk-mux
-      - const: mcc0
-      - const: mcc1
-      - const: mcc2
-      - const: ptd
-      - const: clk-perf
-      - const: cluster-dcs
+    minItems: 25
+    maxItems: 28
 
   apple,wake-enable:
     $ref: /schemas/types.yaml#/definitions/uint32-array
@@ -88,14 +63,96 @@ properties:
   apple,display-coprocessors:
     $ref: /schemas/types.yaml#/definitions/phandle-array
     description:
-      The DCP and the external DCP, which must be off before a commit, in that
+      The DCP and the external DCPs, which must be off before a commit, in that
       order.
 
 required:
   - compatible
   - reg
   - reg-names
-  - apple,wake-enable
   - apple,display-coprocessors
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8140-sleep
+    then:
+      required:
+        - apple,wake-enable
+      properties:
+        reg:
+          minItems: 28
+          maxItems: 28
+        reg-names:
+          items:
+            - const: ps
+            - const: pwrgate
+            - const: cpu-start
+            - const: cllt
+            - const: cluster
+            - const: commit
+            - const: wdt
+            - const: aon-misc
+            - const: wake
+            - const: amcc0
+            - const: amcc1
+            - const: amcc2
+            - const: amcc3
+            - const: pmc-dcp
+            - const: dvfm-e
+            - const: dvfm-p
+            - const: spmi
+            - const: pmc-voters
+            - const: dcs
+            - const: ps-aon
+            - const: spmi-a0
+            - const: clk-mux
+            - const: mcc0
+            - const: mcc1
+            - const: mcc2
+            - const: ptd
+            - const: clk-perf
+            - const: cluster-dcs
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8132-sleep
+    then:
+      properties:
+        reg:
+          minItems: 25
+          maxItems: 26
+        reg-names:
+          minItems: 25
+          items:
+            - const: ps
+            - const: pwrgate
+            - const: cpu-start
+            - const: cllt
+            - const: cluster
+            - const: commit
+            - const: wdt
+            - const: aon-misc
+            - const: wake
+            - const: amcc0
+            - const: amcc1
+            - const: pmc-dcp
+            - const: dvfm-e
+            - const: dvfm-p
+            - const: spmi
+            - const: pmc-voters
+            - const: dcs
+            - const: ps-aon
+            - const: spmi-a0
+            - const: clk-mux
+            - const: mcc0
+            - const: mcc1
+            - const: ptd
+            - const: clk-perf
+            - const: cluster-dcs
+            - const: ps-prot
+
 additionalProperties: false
