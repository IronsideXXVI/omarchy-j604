 	t->stop_word[0] = apple_cpu_stop_word();
@@ -3656,12 +3666,73 @@ static int apple_s2r_t8132_enter(struct apple_s2r *s2r)
 	return ret;
 }
 
+/*
+ * smc-stamp: the SMC's clock (CLKU) at its sleep notice, and the AP counter
+ * around that read (macsmc, noirq). It and the counter at the commit place
+ * our sleep on the clock the SMC stamps its sleeps (CLSP) on.
+ */
+static struct {
+	u64 smc_us;
+	u64 before;
+	u64 after;
+	bool valid;
+} apple_s2r_smc_mark;
+
+void apple_sleep_smc_clock_mark(u64 smc_us, u64 cycles_before, u64 cycles_after)
+{
+	apple_s2r_smc_mark.smc_us = smc_us;
+	apple_s2r_smc_mark.before = cycles_before;
+	apple_s2r_smc_mark.after = cycles_after;
+	apple_s2r_smc_mark.valid = true;
+}
+EXPORT_SYMBOL_GPL(apple_sleep_smc_clock_mark);
+
+/*
+ * The SMC's clock @cycles AP counter ticks: counted from the middle of the
+ * mark's read, rounded down. 0 when it can't be placed.
+ */
+static u64 apple_s2r_smc_us_at(u64 smc_us, u64 before, u64 after, u64 cycles, u32 freq)
+{
+	u64 mid = before + (after - before) / 2;
+
+	if (!freq || after < before || cycles < mid)
+		return 0;
+	return smc_us + mul_u64_u32_div(cycles - mid, USEC_PER_SEC, freq);
+}
+
+static void apple_s2r_smc_stamp_report(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	u64 smc_us = apple_s2r_smc_mark.smc_us;
+	u64 ticks = apple_s2r_smc_mark.after - apple_s2r_smc_mark.before;
+	u32 freq = arch_timer_get_cntfrq();
+	u64 at;
+
+	if (!apple_s2r_smc_mark.valid) {
+		dev_info(s2r->dev, "smc-stamp: no SMC clock read at the notice\n");
+	} else if (!t->commit_cycles_read) {
+		dev_info(s2r->dev,
+			 "smc-stamp: CLKU at the notice %llu us (read in %llu ticks), commit not reached\n",
+			 smc_us, ticks);
+	} else {
+		at = apple_s2r_smc_us_at(smc_us, apple_s2r_smc_mark.before,
+					 apple_s2r_smc_mark.after, t->commit_cycles, freq);
+		dev_info(s2r->dev,
+			 "smc-stamp: CLKU at the notice %llu us (read in %llu ticks), at the commit %llu us (+%llu us, AP counter at %u Hz)\n",
+			 smc_us, ticks, at, at ? at - smc_us : 0, freq);
+	}
+	apple_s2r_smc_mark.valid = false;
+	t->commit_cycles_read = false;
+}
+
 /* After ->enter: what the wake found, and what didn't go as macOS has it. */
 static void apple_s2r_t8132_report(struct apple_s2r *s2r)
 {
 	struct apple_s2r_t8132 *t = &s2r->t8132;
 	unsigned int i, id;
 
+	apple_s2r_smc_stamp_report(s2r);
+
 	if (t->pmu_err)
 		dev_warn(s2r->dev, "T8132: PMU boot stage write failed %u time(s)\n", t->pmu_err);
 	t->pmu_err = 0;
@@ -4319,6 +4390,7 @@ static int apple_s2r_begin(suspend_state_t state)
 		return 0;
 	WRITE_ONCE(apple_s2r_powered_down, false);
 	WRITE_ONCE(apple_s2r_lost_n, 0);
+	apple_s2r_smc_mark.valid = false;
 	if (apple_s2r) {
 		if (apple_s2r->wdt) {
 			apple_s2r->wdt_begin_ctl = readl_relaxed(apple_s2r->wdt + WDT_CTL);
