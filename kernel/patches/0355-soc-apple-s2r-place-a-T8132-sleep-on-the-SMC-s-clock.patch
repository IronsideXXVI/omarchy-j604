diff --git a/tools/asahi/smc-stamp-tests.py b/tools/asahi/smc-stamp-tests.py
new file mode 100755
index 0000000000..292f95a999
--- /dev/null
+++ b/tools/asahi/smc-stamp-tests.py
@@ -0,0 +1,181 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Check smc-stamp: the SMC's sleep keys read only, and our sleep on the SMC's clock.
+
+On macOS (J604, 26B123) the SMC stamps each sleep it registers in CLSP within
+1 ms of the last AP step and counts it in MPPR. This checks, from the sources,
+that macsmc's debugfs file reads exactly the keys CLSP, CLWK, CLKU, CLBT,
+MPPR, MBSE and MBSW, root-only and read-only, with no SMC write or command in
+its path; that the SMC's clock CLKU is read, between two AP counter reads,
+before the sleep notice and after the debug link's settle; that apple-s2r
+takes the AP counter right before the commit, before the last cache clean,
+and forgets an older notice at ->begin. It then builds apple-s2r's conversion
+from the AP counter to the SMC's clock and checks it on fixed values,
+including a 30-day span that overflows a plain 64-bit product.
+"""
+import argparse
+import os
+import re
+import subprocess
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+KEYS = ['CLSP', 'CLWK', 'CLKU', 'CLBT', 'MPPR', 'MBSE', 'MBSW']
+MUTATIONS = {
+    'mid-after': ('\tu64 mid = before + (after - before) / 2;\n', '\tu64 mid = after;\n'),
+    'naive-mul': ('return smc_us + mul_u64_u32_div(cycles - mid, USEC_PER_SEC, freq);',
+                  'return smc_us + (cycles - mid) * USEC_PER_SEC / freq;'),
+    'early-ok': ('\tif (!freq || after < before || cycles < mid)\n', '\tif (!freq || after < before)\n'),
+    'reader-writable': ('debugfs_create_file("sleep-keys", 0400,', 'debugfs_create_file("sleep-keys", 0600,'),
+    'reader-writes': ('\t\t\tret = apple_smc_read(smc, key, buf, info.size);\n',
+                      '\t\t\tret = apple_smc_write(smc, key, buf, info.size);\n'),
+    'key-dropped': ('\tSMC_KEY(MPPR), SMC_KEY(MBSE), SMC_KEY(MBSW),\n', '\tSMC_KEY(MBSE), SMC_KEY(MBSW),\n'),
+    'mark-after-notice': ('\tapple_smc_clock_mark(smc);\n\tret = apple_smc_sleep_commit(smc);\n',
+                          '\tret = apple_smc_sleep_commit(smc);\n\tapple_smc_clock_mark(smc);\n'),
+    'no-mark': ('\tapple_smc_clock_mark(smc);\n\tret = apple_smc_sleep_commit(smc);\n',
+                '\tret = apple_smc_sleep_commit(smc);\n'),
+    'mark-unbracketed': ('\tbefore = get_cycles();\n\tret = apple_smc_read_u64(smc, SMC_KEY(CLKU), &smc_us);\n',
+                         '\tret = apple_smc_read_u64(smc, SMC_KEY(CLKU), &smc_us);\n\tbefore = get_cycles();\n'),
+    'commit-cycles-late': ('\t/* smc-stamp: the commit\'s time on the AP counter, cleaned with the rest */\n'
+                           '\tt->commit_cycles = get_cycles();\n\tt->commit_cycles_read = true;\n\n', ''),
+    'mark-not-cleared': ('\tWRITE_ONCE(apple_s2r_lost_n, 0);\n\tapple_s2r_smc_mark.valid = false;\n',
+                         '\tWRITE_ONCE(apple_s2r_lost_n, 0);\n'),
+}
+
+FIXTURE = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+typedef uint64_t u64;
+typedef uint32_t u32;
+#define USEC_PER_SEC 1000000UL
+static __attribute__((unused)) u64 mul_u64_u32_div(u64 a, u32 mul, u32 divisor)
+{
+	return (u64)(((unsigned __int128)a * mul) / divisor);
+}
+%s
+}
+int main(void)
+{
+	const u32 f = 24000000;
+	const u64 base = 1566400294738ULL;
+	/* a 100 us read: from its middle, 2200 */
+	assert(apple_s2r_smc_us_at(base, 1000, 3400, 2200 + 5ULL * f, f) == base + 5000000);
+	assert(apple_s2r_smc_us_at(base, 1000, 3400, 2200 + 23, f) == base);
+	assert(apple_s2r_smc_us_at(base, 1000, 3400, 2200 + 24, f) == base + 1);
+	assert(apple_s2r_smc_us_at(base, 1000, 3400, 2200, f) == base);
+	/* before the mark, a reversed read, no frequency: unknown */
+	assert(apple_s2r_smc_us_at(base, 1000, 3400, 2199, f) == 0);
+	assert(apple_s2r_smc_us_at(base, 3400, 1000, 9000, f) == 0);
+	assert(apple_s2r_smc_us_at(base, 1000, 3400, 9000, 0) == 0);
+	/* 30 days: (cycles - mid) * 10^6 needs more than 64 bits */
+	assert(apple_s2r_smc_us_at(base, 1000, 1000, 1000 + 30ULL * 86400 * f, f) == base + 30ULL * 86400 * 1000000);
+	puts("conversion ok");
+	return 0;
+}
+'''
+
+
+def fn_body(src, head):
+    at = src.index(head)
+    return src[at:src.index('\n}\n', at)]
+
+
+def check_sources(smc, s2r, sleep_h):
+    m = re.search(r'static const smc_key apple_smc_sleep_keys\[\] = \{(.*?)\};', smc, re.S)
+    assert m, 'Assertion failed: no apple_smc_sleep_keys'
+    keys = re.findall(r'SMC_KEY\((\w+)\)', m.group(1))
+    assert keys == KEYS, f'Assertion failed: sleep keys {keys}, want {KEYS}'
+    init = fn_body(smc, 'static void apple_smc_debugfs_init(struct apple_smc *smc)')
+    assert 'debugfs_create_file("sleep-keys", 0400, dir, smc, &apple_smc_sleep_keys_fops);' in init, \
+        'Assertion failed: sleep-keys must be a root-only read-only file'
+    assert 'DEFINE_SHOW_ATTRIBUTE(apple_smc_sleep_keys);' in smc, \
+        'Assertion failed: sleep-keys must be a show attribute (no write op)'
+    show = fn_body(smc, 'static int apple_smc_sleep_keys_show(struct seq_file *m, void *unused)')
+    for bad in ('apple_smc_write', 'apple_smc_rw', '_atomic(', 'apple_smc_ap_power', 'MBSE)'):
+        assert bad not in show, f'Assertion failed: the reader must not use {bad}'
+    for need in ('apple_smc_get_key_info(smc, key, &info)', 'info.size > sizeof(buf)',
+                 'apple_smc_read(smc, key, buf, info.size)'):
+        assert need in show, f'Assertion failed: the reader lacks {need}'
+    probe = fn_body(smc, 'static int apple_smc_probe(struct platform_device *pdev)')
+    assert probe.find('smc->key_count = be32_to_cpu(count);') < probe.find('apple_smc_debugfs_init(smc);'), \
+        'Assertion failed: the reader is created once the SMC answers'
+
+    mark = fn_body(smc, 'static void apple_smc_clock_mark(struct apple_smc *smc)')
+    i_b = mark.find('before = get_cycles();')
+    i_r = mark.find('apple_smc_read_u64(smc, SMC_KEY(CLKU), &smc_us)')
+    i_a = mark.find('after = get_cycles();')
+    assert 0 <= i_b < i_r < i_a, 'Assertion failed: CLKU must be read between two AP counter reads'
+    assert 'apple_sleep_smc_clock_mark(smc_us, before, after);' in mark
+    noirq = fn_body(smc, 'static int apple_smc_suspend_noirq(struct device *dev)')
+    i_p = noirq.find('apple_smc_set_polled(smc, true);')
+    i_s = noirq.find('apple_smc_outbox_settle(smc);')
+    i_m = noirq.find('apple_smc_clock_mark(smc);')
+    i_c = noirq.find('apple_smc_sleep_commit(smc);')
+    assert 0 <= i_p < i_s < i_m < i_c, \
+        'Assertion failed: the mark goes after the settle and before the notice (commands fail after it)'
+    assert 'void apple_sleep_smc_clock_mark(u64 smc_us, u64 cycles_before, u64 cycles_after);' in sleep_h
+    assert 'static inline void apple_sleep_smc_clock_mark(' in sleep_h, 'Assertion failed: no stub without APPLE_S2R'
+
+    fin = fn_body(s2r, 'static int apple_s2r_t8132_finish(unsigned long arg)')
+    i_cc = fin.find('t->commit_cycles = get_cycles();')
+    i_cl = fin.find('dcache_clean_poc((unsigned long)task_stack_page(current),')
+    i_cm = fin.find('writel(S2R_TIMER_START, t->commit);')
+    assert 0 <= i_cc < i_cl < i_cm, \
+        'Assertion failed: the commit counter is read before the last clean and the commit'
+    assert 't->commit_cycles_read = true;' in fin[i_cc:i_cl]
+    begin = fn_body(s2r, 'static int apple_s2r_begin(suspend_state_t state)')
+    assert 'apple_s2r_smc_mark.valid = false;' in begin, 'Assertion failed: ->begin must forget an older mark'
+    enter = fn_body(s2r, 'static int apple_s2r_t8132_enter(struct apple_s2r *s2r)')
+    assert 't->commit_cycles_read = false;' in enter, 'Assertion failed: ->enter must forget an older commit'
+    rep = fn_body(s2r, 'static void apple_s2r_t8132_report(struct apple_s2r *s2r)')
+    assert 'apple_s2r_smc_stamp_report(s2r);' in rep, 'Assertion failed: the report must print the marks'
+    return fn_body(s2r, 'static u64 apple_s2r_smc_us_at(u64 smc_us, u64 before, u64 after, u64 cycles, u32 freq)')
+
+
+def check_conversion(fn):
+    with tempfile.TemporaryDirectory() as d:
+        c = Path(d) / 'smc-stamp.c'
+        c.write_text(FIXTURE % fn)
+        exe = Path(d) / 'smc-stamp'
+        subprocess.run(['gcc', '-std=gnu11', '-O1', '-Wall', '-Werror', '-o', str(exe), str(c)], check=True)
+        p = subprocess.run([str(exe)], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+        print(p.stdout, end='')
+        if p.returncode:
+            print(f'"exit": {p.returncode}' + (' Assertion failed (C)' if 'Assertion' in p.stdout else ''))
+            raise SystemExit(1)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path)
+    parser.add_argument('--mutation', choices=MUTATIONS)
+    args = parser.parse_args()
+    files = {
+        'smc': ROOT / 'drivers/mfd/macsmc.c',
+        's2r': ROOT / 'drivers/soc/apple/apple-s2r.c',
+        'sleep_h': ROOT / 'include/linux/soc/apple/sleep.h',
+    }
+    text = {k: v.read_text() for k, v in files.items()}
+    if args.mutation:
+        old, new = MUTATIONS[args.mutation]
+        hit = [k for k in text if old in text[k]]
+        assert hit, f'missing mutation site: {old}'
+        text[hit[0]] = text[hit[0]].replace(old, new, 1)
+    try:
+        fn = check_sources(**text)
+    except (AssertionError, ValueError, AttributeError) as e:
+        print(e if str(e).startswith('Assertion') else f'Assertion failed: {e}')
+        raise SystemExit(1)
+    check_conversion(fn)
