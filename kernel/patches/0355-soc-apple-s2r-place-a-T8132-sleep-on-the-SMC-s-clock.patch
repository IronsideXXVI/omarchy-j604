diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
index 4d49a44a4a..d876028773 100644
--- a/drivers/mfd/macsmc.c
+++ b/drivers/mfd/macsmc.c
@@ -29,6 +29,7 @@
 #include <linux/soc/apple/rtkit.h>
 #include <linux/soc/apple/sleep.h>
 #include <linux/suspend.h>
+#include <linux/timex.h>
 #include <linux/unaligned.h>
 #include <linux/suspend.h>
 
@@ -1096,6 +1097,26 @@ static void apple_smc_outbox_settle(struct apple_smc *smc)
 		count, last, quiet >= SMC_OUTBOX_QUIET_MS ? "quiet" : "still busy", ms);
 }
 
+/*
+ * The SMC's clock at the sleep notice, for the sleep driver to place the
+ * commit on it: after the notice the SMC answers no key read, so the commit's
+ * time is derived from the AP counter read around this one.
+ */
+static void apple_smc_clock_mark(struct apple_smc *smc)
+{
+	u64 smc_us, before, after;
+	int ret;
+
+	before = get_cycles();
+	ret = apple_smc_read_u64(smc, SMC_KEY(CLKU), &smc_us);
+	after = get_cycles();
+	if (ret) {
+		dev_warn(smc->dev, "SMC clock not read before the sleep notice: %d\n", ret);
+		return;
+	}
+	apple_sleep_smc_clock_mark(smc_us, before, after);
+}
+
 static int apple_smc_suspend_noirq(struct device *dev)
 {
 	struct apple_smc *smc = dev_get_drvdata(dev);
@@ -1107,6 +1128,7 @@ static int apple_smc_suspend_noirq(struct device *dev)
 	apple_smc_set_polled(smc, true);
 	if (apple_sleep_debug_link_cut())
 		apple_smc_outbox_settle(smc);
+	apple_smc_clock_mark(smc);
 	ret = apple_smc_sleep_commit(smc);
 	apple_smc_set_polled(smc, false);
 
