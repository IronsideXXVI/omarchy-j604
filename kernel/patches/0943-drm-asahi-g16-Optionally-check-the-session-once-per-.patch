+    /// The same at the head of check_hangs: with `g16_check_once` it reuses the session check
+    /// its own pass already ran and passed, and reads only the latched failure.
+    pub(crate) fn transport_error_once(&self) -> Option<Error> {
+        use super::check_once as co;
+        if co::reuse(super::params::check_once(), co::verified()) {
+            co::count(1);
+            return self.session.shared.check().err();
+        }
+        co::count(0);
+        self.session.check().err()
+    }
