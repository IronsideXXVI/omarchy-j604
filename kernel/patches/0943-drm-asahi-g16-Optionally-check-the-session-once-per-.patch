diff --git a/drivers/gpu/drm/asahi/g16/check_once.rs b/drivers/gpu/drm/asahi/g16/check_once.rs
new file mode 100644
index 0000000000..623ab559d7
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16/check_once.rs
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! `g16_check_once`: within one pass under the device lock, the transport check at the head of
+//! `check_hangs` may reuse the session check the same pass already ran and passed, instead of
+//! running it again. Core only, so the rules run as host tests.
+//!
+//! A pass opens a [`Pass`] scope; the scope starts unverified, the pass marks it verified after
+//! its own session check passes, and dropping the scope restores what was there before (a
+//! nested scope cannot leak a verdict outward). Without an open, verified scope every transport
+//! check runs in full, so a path that opens no scope behaves as before.
+
+use core::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+/// The verdict of the innermost open scope. Written only under the device lock.
+static VERIFIED: AtomicBool = AtomicBool::new(false);
+
+/// Counters: 0 transport checks run in full at the head of `check_hangs`, 1 reused.
+pub(crate) static N: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+
+/// Whether a transport check may reuse the scope's verdict: the word is on and the scope is
+/// verified.
+pub(crate) fn reuse(word: u32, verified: bool) -> bool {
+    word != 0 && verified
+}
+
+/// One pass's scope for its session verdict.
+pub(crate) struct Pass {
+    prev: bool,
+}
+
+impl Pass {
+    /// Opens an unverified scope.
+    pub(crate) fn begin() -> Self {
+        Self {
+            prev: VERIFIED.swap(false, Ordering::Relaxed),
+        }
+    }
+}
+
+impl Drop for Pass {
+    fn drop(&mut self) {
+        VERIFIED.store(self.prev, Ordering::Relaxed);
+    }
+}
+
+/// Marks the open scope verified (its own session check has just passed).
+pub(crate) fn note_verified() {
+    VERIFIED.store(true, Ordering::Relaxed);
+}
+
+/// Whether the open scope is verified.
+pub(crate) fn verified() -> bool {
+    VERIFIED.load(Ordering::Relaxed)
+}
+
+/// Adds one to counter `i`.
+pub(crate) fn count(i: usize) {
+    if let Some(c) = N.get(i) {
+        c.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Reads counter `i`.
+pub(crate) fn get(i: usize) -> u64 {
+    N.get(i).map_or(0, |c| c.load(Ordering::Relaxed))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reuse_needs_word_and_verdict() {
+        assert!(!reuse(0, true));
+        assert!(!reuse(1, false));
+        assert!(reuse(1, true));
+    }
+
+    /// The event pass, the submit pass, a nested own check and paths outside any scope.
+    #[test]
+    fn scopes_never_leak_a_verdict() {
+        assert!(!verified());
+        {
+            // Event pass: opens, checks, marks; every check_hangs inside may reuse.
+            let _pass = Pass::begin();
+            assert!(!verified());
+            note_verified();
+            assert!(verified());
+            {
+                // publish() with its own check (pass_check_once 0) nests a scope.
+                let _own = Pass::begin();
+                assert!(!verified());
+                note_verified();
+                assert!(verified());
+            }
+            // The outer verdict is back after the nested scope.
+            assert!(verified());
+        }
+        // Outside any scope (sleep, resume, submit_retire, recovery): full checks.
+        assert!(!verified());
+        {
+            // Submit pass: publish() opens its own scope; a failed check never marks it.
+            let _own = Pass::begin();
+            assert!(!verified());
+        }
+        assert!(!verified());
+    }
+
+    #[test]
+    fn counters_count() {
+        let before = get(1);
+        count(1);
+        assert_eq!(get(1), before + 1);
+        count(7);
+        assert_eq!(get(7), 0);
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index bd45ae716c..1616bdc107 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -1390,8 +1390,12 @@ pub(crate) fn publish(&mut self, done: &mut Completions) -> Result {
         if self.session.shared.sleeping.load(core::sync::atomic::Ordering::Acquire) {
             return Ok(());
         }
-        if !core::mem::take(&mut self.engine.pass_checked) {
+        // `g16_check_once`: a pass that runs its own session check holds its verdict here.
+        let own_check =
+            (!core::mem::take(&mut self.engine.pass_checked)).then(super::check_once::Pass::begin);
+        if own_check.is_some() {
             self.session.check()?;
+            super::check_once::note_verified();
             self.objects.health()?;
         }
         self.service_power()?;
