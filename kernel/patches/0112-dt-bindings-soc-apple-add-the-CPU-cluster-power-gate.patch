From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:05 -0500
Subject: [PATCH] dt-bindings: soc: apple: add the CPU cluster power
 gates

Each CPU cluster has a PMGR word whose top bit lets its cores power down
in WFI. A core that PMGR powers on comes up allowed to, but the boot CPU
only follows the word, and iBoot leaves it clear for T8140's P cluster.
Describe the words, so that a driver can set the bit before the
secondaries start.

Signed-off-by: Diljit Singh <hey@djdev.me>
(cherry picked from commit ad3e82488a093e3e60a208db2377ec3812c17af6)
(cherry picked from commit 3896bc07179025d6d99c8457399252181c6b2532)
(cherry picked from commit 5e738f3a33171136952bbc8085597e20ef06e095)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../soc/apple/apple,cluster-pwrgate.yaml      | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/apple/apple,cluster-pwrgate.yaml

diff --git a/Documentation/devicetree/bindings/soc/apple/apple,cluster-pwrgate.yaml b/Documentation/devicetree/bindings/soc/apple/apple,cluster-pwrgate.yaml
new file mode 100644
index 0000000000..8d4e6ab002
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/apple/apple,cluster-pwrgate.yaml
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/apple/apple,cluster-pwrgate.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple SoC CPU cluster power-gate enables
+
+maintainers:
+  - Diljit Singh <hey@djdev.me>
+
+description: |
+  One PMGR word per CPU cluster, whose top bit lets the cluster's cores power
+  down in WFI. A core that PMGR powers on comes up allowed to, but the boot CPU
+  was started by the boot ROM and only follows the word, which the boot loader
+  may leave clear. The words are set early in boot, in the order listed.
+
+properties:
+  compatible:
+    items:
+      - enum:
+          - apple,t8140-cluster-pwrgate
+      - const: apple,cluster-pwrgate
+
+  reg:
+    minItems: 1
+    maxItems: 8
+    description: One word per cluster.
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        power-gate@300724000 {
+            compatible = "apple,t8140-cluster-pwrgate", "apple,cluster-pwrgate";
+            reg = <0x3 0x00724000 0x0 0x4>,
+                  <0x3 0x00724040 0x0 0x4>;
+        };
+    };
