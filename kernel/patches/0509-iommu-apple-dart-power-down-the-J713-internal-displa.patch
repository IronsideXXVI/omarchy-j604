From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bartosz Nitka <niteria@gmail.com>
Date: Fri, 6 Nov 2026 17:41:57 +0100
Subject: [PATCH] iommu: apple-dart: power down the J713 internal display DARTs

The J713 internal display DARTs are borrowed from the running DCP and
stay powered: the DCP keeps the display domains on. To let the DCP power
the domains down while the display is off, add apple_dart_dcp_power_off()
and apple_dart_dcp_power_on() for a DART that has a clock protection
slice (apple,clock-protection).

Power-down, with the DCP CPU stopped and the DART's masters idle, marks
the DART's power unconfirmed (apple_dart_pm_get() refuses from then on and
the uses in flight are waited for) and gates its commands. Then, as the
native DART power-down does, it requires no fault, waits up to 1 ms for
the TLB command and outstanding transactions to drain, disables the
enabled streams, flushes with the power-down TLB command (V2 | STT) and
clears the clock protection slice. It saves the translations, their lock
and the stream enables first. apple_dart_dcp_power_check() says, changing
nothing, whether a power-down can run, so that the DCP can ask before it
starts.

Power-up restores the slice, requires the streams still disabled and the
translations and their lock as saved (a DART that lost them is not
rebuilt), flushes, enables the saved streams and confirms the power. A
failure in either direction retires the DART's borrowed streams, as other
display DART failures do; nothing is retried.

While the DART is down its generic DMA streams, the display's SID0 and
the DCP's SID23, keep working on their page tables: unmap, the flush
after a map and translation use the tables in memory and no register,
and the power-up flushes before it enables the streams. The DART's
powered-down state changes only with the locks of all its borrowed
streams held, so the power-up's flush and its confirmed power are one
step for those updates.

System resume leaves a powered-down DART alone; its gated commands
already keep suspend and the fault handler off its registers.

KUnit: a full cycle against RAM registers and a RAM-backed PS_PROT bank,
a DART that comes back without its translations, refusals for a locked
bank, a stream that stays enabled, a transaction that does not drain and
a pending fault, and a SID0 stream whose unmap, flush and translation use
only its page tables while the DART is down.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 139b9d77dab0d3a450996604ebeff8d5ab283633)

[j604: conflict resolved on a15y 0f06dbf809: the apple_dart_resume() context check of
 dart->cold_ane and the apple_dart_test_strict_engines() test belong to other Aurora changes
 not in a15y; only this commit's host_off early return and its J713 host-power tests kept]

---
 drivers/iommu/Kconfig           |   1 +
 drivers/iommu/apple-dart-dcp.h  |  59 +++++-
 drivers/iommu/apple-dart-test.c | 194 ++++++++++++++++++++
 drivers/iommu/apple-dart.c      | 316 +++++++++++++++++++++++++++++++-
 include/linux/soc/apple/dart.h  |  12 ++
 5 files changed, 577 insertions(+), 5 deletions(-)

diff --git a/drivers/iommu/Kconfig b/drivers/iommu/Kconfig
index 78d6cbb543..4233b253b0 100644
--- a/drivers/iommu/Kconfig
+++ b/drivers/iommu/Kconfig
@@ -319,6 +319,7 @@ config APPLE_DART
 config APPLE_DART_J713_DCP
 	bool "Retained J713 display DART support"
 	depends on APPLE_DART=y && ARM64_16K_PAGES
+	select MFD_SYSCON
 	help
 	  Adopt the qualified running J713 internal display DARTs. Their
 	  firmware-visible allocations, page tables and noncoherent CPU
diff --git a/drivers/iommu/apple-dart-dcp.h b/drivers/iommu/apple-dart-dcp.h
index 21a0ef567f..2ce7070deb 100644
--- a/drivers/iommu/apple-dart-dcp.h
+++ b/drivers/iommu/apple-dart-dcp.h
@@ -144,6 +144,36 @@ static inline void apple_dart_pm_invalidate(struct apple_dart *dart, bool suspen
 	wait_event(dart->pm_wq, !READ_ONCE(dart->pm_users));
 }
 
+/*
+ * The locks of every borrowed stream of @dart, in a fixed order (SID23, then
+ * SID0, then SID16). An internal display DART's host_off changes only with
+ * all of them held, so under any one of them it is stable: while it is set,
+ * the DART's DCP has it powered down (or powering down), and its generic DMA
+ * streams (SID0, SID23) update their page tables in memory only, with no
+ * register used; its power-up flushes every translation, with these locks
+ * held, before it enables the streams again.
+ */
+static void apple_dart_host_lock(struct apple_dart *dart, unsigned long *flags)
+{
+	struct apple_dart_dcp *streams[] = { dart->dcp, dart->frontend[0], dart->frontend[1] };
+	unsigned int held = 0;
+
+	local_irq_save(*flags);
+	for (unsigned int i = 0; i < ARRAY_SIZE(streams); i++)
+		if (streams[i])
+			spin_lock_nested(&streams[i]->lock, held++);
+}
+
+static void apple_dart_host_unlock(struct apple_dart *dart, unsigned long flags)
+{
+	struct apple_dart_dcp *streams[] = { dart->frontend[1], dart->frontend[0], dart->dcp };
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(streams); i++)
+		if (streams[i])
+			spin_unlock(&streams[i]->lock);
+	local_irq_restore(flags);
+}
+
 /* Every borrowed stream of @dart, for one reason. */
 #define apple_dart_fail_borrowed(dart, fmt, ...)				\
 	do {									\
@@ -663,6 +693,18 @@ static phys_addr_t __apple_dart_dcp_translate(struct apple_dart_dcp *dcp, u64 io
 			phys = dcp_dart_pte_phys(pte) | (iova & (DCP_DART_PAGE - 1));
 		goto out;
 	}
+	/*
+	 * Powered down by its DCP (stable under this lock): no register, so
+	 * only the host-owned leaves, which expected[] mirrors.
+	 */
+	if (READ_ONCE(dcp->dart->host_off)) {
+		if (!test_bit(root, dcp->foreign) && dcp->expected[root]) {
+			pte = dcp->expected[root][leaf];
+			if (pte)
+				phys = dcp_dart_pte_phys(pte) | (iova & (DCP_DART_PAGE - 1));
+		}
+		goto out;
+	}
 	/*
 	 * An external display DART's registers only inside a use of them (its
 	 * power confirmed, a sleep waits for it): none, no lookup.
@@ -1432,6 +1474,14 @@ static size_t apple_dart_dcp_unmap(struct apple_dart_dcp *dcp, u64 iova,
 {
 	size_t unmapped;
 
+	/*
+	 * An internal display DART that its DCP powers down: no use of its
+	 * registers is needed. Under the stream's lock __apple_dart_dcp_unmap()
+	 * sees whether the DART is powered (apple_dart_host_lock()), and while it
+	 * is not, only updates the page tables.
+	 */
+	if (dcp->dart->ps_prot)
+		return __apple_dart_dcp_unmap(dcp, iova, size, count, gather);
 	/*
 	 * On an external display DART, only inside a use of its registers.
 	 * Returning 0 (nothing unmapped) is not safe for general DMA teardown:
@@ -1485,8 +1535,13 @@ static size_t __apple_dart_dcp_unmap(struct apple_dart_dcp *dcp, u64 iova,
 	while (cleared < count && dcp->table[root][leaf + cleared])
 		WRITE_ONCE(dcp->table[root][leaf + cleared++], 0);
 	dma_wmb();
-	/* Strict SID0: invalidate before the IOVA or its pages can be reused. */
-	if (cleared && dcp->sid == 0 && apple_dart_dcp_flush(dcp)) {
+	/*
+	 * Strict SID0: invalidate before the IOVA or its pages can be reused.
+	 * Not while its DCP has the DART powered down: nothing is cached then,
+	 * and the power-up flushes before it enables the streams.
+	 */
+	if (cleared && dcp->sid == 0 && !READ_ONCE(dcp->dart->host_off) &&
+	    apple_dart_dcp_flush(dcp)) {
 		/* A stale translation may survive: republish the leaves and keep the pages. */
 		for (size_t i = 0; i < cleared; i++)
 			WRITE_ONCE(dcp->table[root][leaf + i], dcp->expected[root][leaf + i]);
diff --git a/drivers/iommu/apple-dart-test.c b/drivers/iommu/apple-dart-test.c
index bd3dd7ae7b..c63cb0067c 100644
--- a/drivers/iommu/apple-dart-test.c
+++ b/drivers/iommu/apple-dart-test.c
@@ -1042,6 +1042,194 @@ static void apple_dart_test_resume_reset_retry(struct kunit *test)
 			dart->hw->ttbr_valid | 0x1000);
 }
 
+#if IS_ENABLED(CONFIG_APPLE_DART_J713_DCP)
+#define APPLE_DART_TEST_PS_SLICE 42
+
+static void apple_dart_test_regmap_exit(void *map)
+{
+	regmap_exit(map);
+}
+
+/* An internal display DART with one live stream and a PS_PROT bank in RAM. */
+static struct apple_dart *apple_dart_test_host_dart(struct kunit *test)
+{
+	static const struct regmap_config cfg = {
+		.reg_bits = 32, .val_bits = 32, .reg_stride = 4,
+		.max_register = APPLE_PS_PROT_SLICE(APPLE_PS_PROT_SLICES - 1),
+	};
+	static atomic_t instance = ATOMIC_INIT(0);
+	struct apple_dart *dart;
+	char name[40];
+	void *bank;
+
+	dart = kunit_kzalloc(test, sizeof(*dart), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dart);
+	/* Device names must be unique: a test may set up several. */
+	snprintf(name, sizeof(name), "apple-dart-host-power-%d", atomic_inc_return(&instance));
+	dart->dev = kunit_device_register(test, name);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dart->dev);
+	dev_set_drvdata(dart->dev, dart);
+	/* Up to the exception registers at 0x4000, which a 0x0203 DART reads. */
+	dart->regs = (__force void __iomem *)kunit_kzalloc(test, APPLE_DART_TEST_REGS_SIZE,
+							   GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dart->regs);
+	dart->hw = &apple_dart_hw_t8110;
+	dart->num_streams = 2;
+	dart->pgsize = SZ_16K;
+	dart->version = 0x0203;
+	dart->power_gated = true;
+	spin_lock_init(&dart->lock);
+	spin_lock_init(&dart->pm_gate_lock);
+	init_waitqueue_head(&dart->pm_wq);
+	pm_runtime_set_active(dart->dev);
+	pm_runtime_enable(dart->dev);
+
+	bank = kunit_kzalloc(test, APPLE_PS_PROT_SLICE(APPLE_PS_PROT_SLICES), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, bank);
+	dart->ps_prot = regmap_init_mmio(NULL, (__force void __iomem *)bank, &cfg);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dart->ps_prot);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, apple_dart_test_regmap_exit,
+							dart->ps_prot), 0);
+	dart->ps_prot_slice = APPLE_DART_TEST_PS_SLICE;
+	regmap_write(dart->ps_prot, APPLE_PS_PROT_ENABLE, 1);
+	regmap_write(dart->ps_prot, APPLE_PS_PROT_SLICE(APPLE_DART_TEST_PS_SLICE), 0x12);
+
+	writel(1 << 16, dart->regs + DART_PARAMS2);	/* one port */
+	writel(DART_T8110_TCR_TRANSLATE_ENABLE, dart->regs + DART_TCR(dart, 1));
+	writel(dart->hw->ttbr_valid | 0x1234, dart->regs + DART_TTBR(dart, 1, 0));
+	writel(DART_T8110_PROTECT_TTBR_TCR, dart->regs + DART_T8110_PROTECT);
+	writel(DART_T8110_PROTECT_TTBR_TCR, dart->regs + DART_T8110_PROTECT_LOCK);
+	return dart;
+}
+
+static u32 apple_dart_test_slice(struct apple_dart *dart)
+{
+	u32 value = 0;
+
+	regmap_read(dart->ps_prot, APPLE_PS_PROT_SLICE(dart->ps_prot_slice), &value);
+	return value;
+}
+
+static void apple_dart_test_host_power_cycle(struct kunit *test)
+{
+	struct apple_dart *dart = apple_dart_test_host_dart(test);
+
+	KUNIT_ASSERT_EQ(test, apple_dart_host_power_off(dart), 0);
+	KUNIT_EXPECT_TRUE(test, READ_ONCE(dart->host_off));
+	KUNIT_EXPECT_TRUE(test, READ_ONCE(dart->commands_gated));
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_T8110_TLB_CMD), DART_T8110_TLB_CMD_POWERDOWN);
+	KUNIT_EXPECT_EQ(test, apple_dart_test_slice(dart), 0x2U);
+	/* Its registers are not used until power-up. */
+	KUNIT_EXPECT_FALSE(test, apple_dart_pm_get(dart));
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_off(dart), -EALREADY);
+
+	KUNIT_ASSERT_EQ(test, apple_dart_host_power_on(dart), 0);
+	KUNIT_EXPECT_FALSE(test, READ_ONCE(dart->host_off));
+	KUNIT_EXPECT_FALSE(test, READ_ONCE(dart->commands_gated));
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_T8110_TLB_CMD), DART_T8110_TLB_CMD_V2);
+	KUNIT_EXPECT_EQ(test, apple_dart_test_slice(dart), 0x12U);
+	KUNIT_EXPECT_TRUE(test, apple_dart_pm_get(dart));
+	apple_dart_pm_put(dart);
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_on(dart), -EALREADY);
+}
+
+static void apple_dart_test_host_power_lost(struct kunit *test)
+{
+	struct apple_dart *dart = apple_dart_test_host_dart(test);
+
+	KUNIT_ASSERT_EQ(test, apple_dart_host_power_off(dart), 0);
+	/* Power came back with a reset DART: not rebuilt, not used. */
+	writel(0, dart->regs + DART_TTBR(dart, 1, 0));
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_on(dart), -EIO);
+	KUNIT_EXPECT_TRUE(test, READ_ONCE(dart->host_off));
+	KUNIT_EXPECT_FALSE(test, apple_dart_pm_get(dart));
+}
+
+static void apple_dart_test_host_power_refused(struct kunit *test)
+{
+	struct apple_dart *dart = apple_dart_test_host_dart(test);
+
+	regmap_write(dart->ps_prot, APPLE_PS_PROT_LOCK, 1);
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_off(dart), -EPERM);
+	KUNIT_EXPECT_EQ(test, apple_dart_test_slice(dart), 0x12U);
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_T8110_TLB_CMD), 0U);
+
+	dart = apple_dart_test_host_dart(test);
+	/* A stream that stays enabled: the flush and the slice are left alone. */
+	writel(BIT(1), dart->regs + DART_T8110_ENABLE_STREAMS);
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_off(dart), -EIO);
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_T8110_DISABLE_STREAMS), BIT(1));
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_T8110_TLB_CMD), 0U);
+	KUNIT_EXPECT_EQ(test, apple_dart_test_slice(dart), 0x12U);
+
+	/* An outstanding transaction that does not drain in time. */
+	dart = apple_dart_test_host_dart(test);
+	writel(1, dart->regs + DART_T8110_OUTSTANDING(0));
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_off(dart), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, apple_dart_test_slice(dart), 0x12U);
+
+	/* A pending fault is not waited for. */
+	dart = apple_dart_test_host_dart(test);
+	writel(1, dart->regs + DART_T8110_EXCEPTION(0));
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_off(dart), -EIO);
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_T8110_TLB_CMD), 0U);
+	KUNIT_EXPECT_EQ(test, apple_dart_test_slice(dart), 0x12U);
+}
+
+/*
+ * Generic SID0 DMA while the DCP has the DART powered down: translations,
+ * flushes and unmaps use the page tables only, and the power-up flushes.
+ */
+static void apple_dart_test_host_power_tables(struct kunit *test)
+{
+	const u64 iova = DCP_DART_ALIAS + 3 * DCP_DART_SLICE + 5 * DCP_DART_PAGE;
+	const unsigned int root = (iova >> 25) & 2047, leaf = (iova >> 14) & 2047;
+	const u64 pte = (0x12340000ULL >> 4) | 1 | (0xfffULL << 40);
+	struct apple_dart *dart = apple_dart_test_host_dart(test);
+	struct iommu_iotlb_gather gather;
+	struct apple_dart_domain *domain;
+	struct apple_dart_dcp *dcp;
+
+	dcp = kunit_kzalloc(test, sizeof(*dcp), GFP_KERNEL);
+	domain = kunit_kzalloc(test, sizeof(*domain), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dcp);
+	KUNIT_ASSERT_NOT_NULL(test, domain);
+	dcp->dart = dart;
+	spin_lock_init(&dcp->lock);
+	dcp->root = kunit_kzalloc(test, DCP_DART_ENTRIES * sizeof(u64), GFP_KERNEL);
+	dcp->table[root] = kunit_kzalloc(test, DCP_DART_ENTRIES * sizeof(u64), GFP_KERNEL);
+	dcp->expected[root] = kunit_kzalloc(test, DCP_DART_ENTRIES * sizeof(u64), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dcp->root);
+	KUNIT_ASSERT_NOT_NULL(test, dcp->table[root]);
+	KUNIT_ASSERT_NOT_NULL(test, dcp->expected[root]);
+	dcp->root[root] = 0x5670001;
+	dcp->entry[root] = dcp->root[root];
+	dcp->table[root][leaf] = pte;
+	dcp->expected[root][leaf] = pte;
+	dart->frontend[0] = dcp;
+	domain->dcp = dcp;
+
+	KUNIT_ASSERT_EQ(test, apple_dart_host_power_off(dart), 0);
+	writel(0, dart->regs + DART_T8110_TLB_CMD);	/* Any later command shows here. */
+
+	KUNIT_EXPECT_EQ(test, apple_dart_dcp_translate(dcp, iova + 0x123),
+			dcp_dart_pte_phys(pte) | 0x123);
+	KUNIT_EXPECT_EQ(test, apple_dart_dcp_domain_flush(domain), 0);
+	iommu_iotlb_gather_init(&gather);
+	KUNIT_EXPECT_EQ(test, apple_dart_dcp_unmap(dcp, iova, DCP_DART_PAGE, 1, &gather),
+			(size_t)DCP_DART_PAGE);
+	KUNIT_EXPECT_EQ(test, dcp->table[root][leaf], 0ULL);
+	KUNIT_EXPECT_EQ(test, dcp->expected[root][leaf], 0ULL);
+	KUNIT_EXPECT_EQ(test, apple_dart_dcp_translate(dcp, iova), (phys_addr_t)0);
+	KUNIT_EXPECT_FALSE(test, READ_ONCE(dcp->failed));
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_T8110_TLB_CMD), 0U);
+
+	KUNIT_ASSERT_EQ(test, apple_dart_host_power_on(dart), 0);
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_T8110_TLB_CMD), DART_T8110_TLB_CMD_V2);
+	KUNIT_EXPECT_FALSE(test, READ_ONCE(dart->host_off));
+}
+#endif
+
 static struct kunit_case apple_dart_test_cases[] = {
 	KUNIT_CASE(apple_dart_test_iommu_specifiers),
 	KUNIT_CASE(apple_dart_test_consumer_window),
@@ -1069,6 +1257,12 @@ static struct kunit_case apple_dart_test_cases[] = {
 	KUNIT_CASE(apple_dart_test_resume_reset_retry),
 	KUNIT_CASE(apple_dart_test_resume_retained_bypass_t8103),
 	KUNIT_CASE(apple_dart_test_resume_retained_bypass_t8110),
+#if IS_ENABLED(CONFIG_APPLE_DART_J713_DCP)
+	KUNIT_CASE(apple_dart_test_host_power_cycle),
+	KUNIT_CASE(apple_dart_test_host_power_lost),
+	KUNIT_CASE(apple_dart_test_host_power_refused),
+	KUNIT_CASE(apple_dart_test_host_power_tables),
+#endif
 	{}
 };
 
diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 90d7fee60d..1d4d88758f 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -25,6 +25,8 @@
 #include <linux/io-pgtable.h>
 #include <linux/iommu.h>
 #include <linux/iopoll.h>
+#include <linux/mfd/syscon.h>
+#include <linux/regmap.h>
 #include <linux/kexec.h>
 #include <linux/minmax.h>
 #include <linux/mm.h>
@@ -188,6 +190,27 @@
 #define DART_T8110_ENABLE_STREAMS  0xc00
 #define DART_T8110_DISABLE_STREAMS 0xc20
 
+/* Per-port outstanding transactions; the port counts are in PARAMS2. */
+#define DART_T8110_OUTSTANDING(port) (0x230 + 4 * (port))
+#define DART_T8110_PARAMS2_READ_PORTS  GENMASK(18, 16)
+#define DART_T8110_PARAMS2_WRITE_PORTS GENMASK(22, 20)
+/* How long the power-down and power-up wait for transactions to drain. */
+#define DART_T8110_IDLE_TIMEOUT_US 1000
+/* TLB command of the power-down path: flush everything, also stream table state. */
+#define DART_T8110_TLB_CMD_POWERDOWN (DART_T8110_TLB_CMD_V2 | DART_T8110_TLB_CMD_STT)
+
+/*
+ * PS_PROT ("clock protection") bank: one slice per protected DART. An
+ * enabled slice (bit 4) guards a power-state register of the DART's power
+ * domain; the native DART power-down clears bit 4 after its streams are
+ * disabled and flushed, and power-up sets it again.
+ */
+#define APPLE_PS_PROT_ENABLE		0x20
+#define APPLE_PS_PROT_LOCK		0x24
+#define APPLE_PS_PROT_SLICE(n)		(0x100 + 0x40 * (n))
+#define APPLE_PS_PROT_SLICES		64
+#define APPLE_PS_PROT_SLICE_ON		BIT(4)
+
 #define DART_T8110_TCR                  0x1000
 #define DART_T8110_TCR_REMAP            GENMASK(11, 8)
 #define DART_T8110_TCR_REMAP_ENABLE     BIT(7)
@@ -324,6 +347,17 @@ struct apple_dart {
 	 * with its power confirmed (apple_dart_pm_get()).
 	 */
 	bool power_gated;
+	/*
+	 * Internal display DART: powered down by its DCP (from
+	 * apple_dart_dcp_power_off() until apple_dart_dcp_power_on(); changed
+	 * only under apple_dart_host_lock()), with what the power-up checks
+	 * and restores.
+	 */
+	bool host_off;
+	u32 off_streams, off_protect, off_lock;
+	/* Its clock-protection slice in the PS_PROT bank, if it has one. */
+	struct regmap *ps_prot;
+	u32 ps_prot_slice, ps_prot_saved;
 	/*
 	 * Power-gated display DART: its power confirmation across
 	 * sleep, under pm_gate_lock (a spinlock: only these fields, never
@@ -2032,15 +2066,23 @@ static int __apple_dart_dcp_domain_flush(struct apple_dart_domain *domain);
 /*
  * Borrowed DCP domains have no io-pgtable; their flush ignores the range.
  * On an external display DART only with its power confirmed: -EAGAIN
