From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 06:38:20 +0000
Subject: [PATCH] drm/asahi: g16: Build the firmware loader map as
 macOS does by default

g16_loader_macos (default 0 until now) makes the loader map equal to
macOS 26B123's in the three ways the firmware's own slot table allows:
mode 2 in the empty slots macOS marks so (bit 0), macOS's VA packing,
each window on a 0x8000 boundary after its guard page (bit 1), and the
PowerTrans window left unmapped at init as macOS leaves it (bit 2). All
19 filled windows and their PA, length, tag and mode were already equal.
With all three bits the map is macOS's slot for slot; the 25G83
firmware boots without a host PowerTrans mapping at init. Make 7 the
default.

Revert: aurora.g16_loader_macos=0

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 6c540c9581..163cca9294 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2365,8 +2365,8 @@ pub(crate) fn resident_lazy_async() -> bool {
     "G16: a VM's first render builds only its two full render units; the others are built when it queues deeper: 1 in SUBMIT, 2 by a worker (default 0: all at the first render; read when a VM builds units)"
 );
 
-/// Storage of `g16_loader_macos` (0644, default 0; read once, when initdata is built).
-static LOADER_MACOS: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_loader_macos` (0644, default 7; read once, when initdata is built).
+static LOADER_MACOS: AtomicU32 = AtomicU32::new(7);
 
 /// `g16_loader_macos`: build the loader map as macOS 26B123 does (bit 0 empty-slot mode 2, bit 1
 /// VA packing on 0x8000, bit 2 PowerTrans unmapped at init).
@@ -2380,7 +2380,7 @@ pub(crate) fn loader_macos() -> u32 {
     LOADER_MACOS_PARM,
     LOADER_MACOS,
     "g16_loader_macos",
-    "G16: build the firmware loader map as macOS 26B123 does: bit 0 mode 2 in its empty slots, bit 1 its VA packing, bit 2 PowerTrans left unmapped at init (default 0; read once, at initdata build)"
+    "G16: build the firmware loader map as macOS 26B123 does: bit 0 mode 2 in its empty slots, bit 1 its VA packing, bit 2 PowerTrans left unmapped at init (default 7, as macOS; 0 = our own map; read once, at initdata build)"
 );
 
 /// Storage of `g16_replay` (runtime 0644, default 0).
