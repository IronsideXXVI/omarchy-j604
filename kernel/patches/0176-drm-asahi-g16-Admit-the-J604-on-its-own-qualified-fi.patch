From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 20:32:39 -0600
Subject: [PATCH] drm/asahi: g16: Admit the J604 on its own qualified firmware
 build

The J604 is matched against its own table of loaded firmware builds,
J604_FIRMWARE, and is refused even on a match. Its remaining J604-only
pieces are now in place: the performance selection and the PMP GPU
vote. The handoff layout comes from m1n1, which checks it against the
J604 ADT and publishes it on that machine, and the hardware identity is
still checked against the qualified values after the power vote.

Admit the J604 when its loaded build is in J604_FIRMWARE: the board
gate returns success after the identity report, and admit() checks the
loaded TEXT against J604_FIRMWARE instead of the J713 builds. A board
whose build is not listed is still refused with the identity report,
before the PMP lease, any power-domain hold or any firmware-visible
write.

J604_FIRMWARE is still empty, so this changes nothing on a running
J604 until a build measured on one is added.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/gpu/drm/asahi/g16/boot.rs | 25 ++++++++++++++-----------
 drivers/gpu/drm/asahi/g16/hw.rs   |  5 +++--
 2 files changed, 17 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/boot.rs b/drivers/gpu/drm/asahi/g16/boot.rs
index 12ec3103a5..bf1019f183 100644
--- a/drivers/gpu/drm/asahi/g16/boot.rs
+++ b/drivers/gpu/drm/asahi/g16/boot.rs
@@ -441,9 +441,8 @@ impl Orphan {
 /// An unqualified T8132 board first reports the firmware its boot loader left in place, which
 /// is what qualifying it needs, and is then refused the same way.
 ///
-/// The J604 is matched against its own qualified builds, never the J713's. It stays refused
-/// even on a match until its PMP AGX vote, performance selection, hardware identity and
-/// boot-loader handoff layout are qualified on J604 data as well.
+/// The J604 is matched against its own qualified builds, never the J713's, and is admitted
+/// only on a match; [`admit`] then checks the same build again before any vote.
 pub(crate) fn qualified_board(dev: &device::Device) -> Result {
     if glue::board() {
         return Ok(());
@@ -454,11 +453,10 @@ pub(crate) fn qualified_board(dev: &device::Device) -> Result {
             .as_ref()
             .and_then(|loaded| identity::qualified(loaded, hw::t8132::J604_FIRMWARE))
         {
-            Some(build) => dev_info!(
-                dev,
-                "G16: J604 firmware build: {}; PMP AGX vote, performance selection, hardware identity and handoff layout not qualified, not probing\n",
-                build.name
-            ),
+            Some(build) => {
+                dev_info!(dev, "G16: J604 firmware build: {}\n", build.name);
+                return Ok(());
+            }
             None => dev_info!(
                 dev,
                 "G16: J604 firmware build not qualified, not probing\n"
@@ -481,9 +479,14 @@ pub(crate) fn admit(
     res: shared_regs::G16Resources,
 ) -> Result<Admitted> {
     let dev = pdev.as_ref();
-    if !glue::board() {
+    // The J604 has its own qualified builds; it never matches the J713's.
+    let builds = if glue::board() {
+        cfg.firmware
+    } else if glue::j604_board() {
+        hw::t8132::J604_FIRMWARE
+    } else {
         return Err(ENODEV);
-    }
+    };
     // Retain the PMP supplier (and its AGX bridge) before any vote.
     // SAFETY: `dev` is the bound GPU device.
     let ret = unsafe { bindings::apple_pmp_j713_gpu_prepare(dev.as_raw()) };
@@ -496,7 +499,7 @@ pub(crate) fn admit(
     }
     let adt =
         adt::read(dev).inspect_err(|e| dev_err!(dev, "ADT GPU regions not admitted: {:?}\n", e))?;
-    identity::firmware(dev, &adt, cfg.firmware)
+    identity::firmware(dev, &adt, builds)
         .inspect_err(|e| dev_err!(dev, "loaded GFX TEXT identity mismatch: {:?}\n", e))?;
     dev_info!(dev, "M4: firmware identity accepted\n");
     // Firmware objects are cleaned to the point of coherency by their DMA mapping: that needs
diff --git a/drivers/gpu/drm/asahi/g16/hw.rs b/drivers/gpu/drm/asahi/g16/hw.rs
index dc54f98569..e7d6a7f07a 100644
--- a/drivers/gpu/drm/asahi/g16/hw.rs
+++ b/drivers/gpu/drm/asahi/g16/hw.rs
@@ -74,8 +74,9 @@ pub(crate) mod t8132 {
     };
 
     /// Loaded builds qualified on the J604 (MacBook Pro 14-inch, M4), matched on the J604's
-    /// own measured identity ([`crate::g16::identity::report_unqualified`]). None is qualified
-    /// yet, and no J713 entry stands in for one: TEXT differs per board after iBoot fills it.
+    /// own measured identity ([`crate::g16::identity::report_unqualified`]). They select the
+    /// same 25G83 graph as [`CONFIG`]; no J713 entry stands in for one, because TEXT differs
+    /// per board after iBoot fills it. Until one is listed the J604 is refused at the board gate.
     pub(crate) const J604_FIRMWARE: &[FirmwareBuild] = &[];
 }
 
