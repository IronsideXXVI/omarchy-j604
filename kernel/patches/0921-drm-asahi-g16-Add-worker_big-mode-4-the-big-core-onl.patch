From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 18 Nov 2026 01:24:41 +0000
Subject: [PATCH] drm/asahi: g16: Add worker_big mode 4, the big core
 only for compute

g16_worker_big 3 runs the completion pass on a performance core while
any GPU work is outstanding. On an idle desktop the compositor's own
frames count as outstanding work, so about 90 % of the idle desktop's
passes run on the performance core, measured at about +10 mW of system
power against mode 0. The gain of the mode is in the compute rows only;
the render rows did not move.

Mode 4 takes the performance core only while compute work is
outstanding: a published flight with compute members, or a pending job
with an unsent compute command, as publish() last saw them. While only
render work is outstanding the pass stays on the CPU that queued it, as
in mode 0. A pass queued while compute work is outstanding still runs on
the performance core when it also retires render work. The decision is
still read per queueing; publish() runs after every retirement, so the
flag drops with the last compute flight.

The wbig: stats line gains ronly_big and ronly_little (passes run while
only render work was outstanding, on and off the performance cores, in
any mode) and ronly_default (queueings mode 4 left where they were
queued for that reason).

The default stays 3.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/engine.rs | 16 +++++++++++++--
 drivers/gpu/drm/asahi/g16/params.rs | 12 ++++++-----
 drivers/gpu/drm/asahi/g16/poll.rs   | 31 ++++++++++++++++++++++++-----
 3 files changed, 47 insertions(+), 12 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index f296f9d223..e01733f99c 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -1574,8 +1574,20 @@ pub(crate) fn publish(&mut self, done: &mut Completions) -> Result {
         // Polling retires before it publishes, so this sees work start and
         // drain; a fail-stop reports from fail_flights().
         self.power.report_work(!self.engine.flights.is_empty());
-        // g16_worker_big 3: big-CPU passes only while work is outstanding.
-        super::poll::wbig_busy(!self.engine.flights.is_empty() || !self.engine.pending.is_empty());
+        // g16_worker_big 3: big-CPU passes only while work is outstanding; 4: only while
+        // compute work is (a flight with compute members, or a pending job with an unsent
+        // compute command), so a render-only stream (the compositor) keeps mode 0's CPUs.
+        let compute = self.engine.flights.iter().any(|f| f.computes != 0)
+            || self.engine.pending.iter().any(|j| {
+                j.commands
+                    .iter()
+                    .skip(j.progress.sent() as usize)
+                    .any(|c| matches!(c, Command::Compute(_)))
+            });
+        super::poll::wbig_busy(
+            !self.engine.flights.is_empty() || !self.engine.pending.is_empty(),
+            compute,
+        );
         result
     }
 
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 1d2a6915ed..e0f0b53e8b 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -948,12 +948,14 @@ pub(crate) fn rt_poll() -> bool {
 /// unbound high-priority `aurora_g16_big` queue limited to the CPUs of maximum capacity;
 /// 2 `system_highpri_wq` on one such CPU chosen at probe (no migration between passes);
 /// 3 (default) as 2 while GPU work is outstanding (flights or pending, as publish() last saw
-/// them), else as 0, so the idle firmware messages keep their pass on the CPU that took them.
-/// With 1, 2 or 3, scheduler submit queues (`aurora_g16_hi`) created afterwards are limited to
-/// the same CPUs. Read per queueing.
+/// them), else as 0, so the idle firmware messages keep their pass on the CPU that took them;
+/// 4 as 2 only while COMPUTE work is outstanding (a flight with compute members or a pending
+/// job with an unsent compute command), else as 0, so render-only work (the compositor's
+/// frames) keeps its passes where 0 runs them. With 1 to 4, scheduler submit queues
+/// (`aurora_g16_hi`) created afterwards are limited to the same CPUs. Read per queueing.
 pub(crate) fn worker_big() -> u32 {
     match WORKER_BIG.load(Ordering::Relaxed) {
-        v @ 1..=3 => v,
+        v @ 1..=4 => v,
         _ => 0,
     }
 }
@@ -964,7 +966,7 @@ pub(crate) fn worker_big() -> u32 {
     WORKER_BIG_PARM,
     WORKER_BIG,
     "g16_worker_big",
-    "G16: run the completion/poll work on the max-capacity CPUs (0: where queued; 1: unbound high-priority queue on those CPUs; 2: one such CPU chosen at probe; 3, the default: as 2 only while GPU work is outstanding; runtime 0644)"
+    "G16: run the completion/poll work on the max-capacity CPUs (0: where queued; 1: unbound high-priority queue on those CPUs; 2: one such CPU chosen at probe; 3, the default: as 2 only while GPU work is outstanding; 4: as 2 only while compute work is outstanding; runtime 0644)"
 );
 
 /// Storage of `g16_pmp_agx` (runtime 0644, default 1).
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 90e3fc275b..f647417d50 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -85,10 +85,18 @@ fn tailcut_stats(f: &mut fmt::Formatter<'_>) -> fmt::Result {
 /// device lock, read at any queueing), and queueings that took the default path for it.
 static WBIG_BUSY: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
 static WBIG_IDLE: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+/// `g16_worker_big` 4: compute work outstanding as publish() last saw it.
+static WBIG_CBUSY: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+/// Passes run while only render work was outstanding: [0] on a max-capacity CPU, [1] on
+/// another (any mode); [2] queueings that mode 4 left where they were queued for that reason.
+static WBIG_RONLY: [core::sync::atomic::AtomicU64; 3] =
+    [const { core::sync::atomic::AtomicU64::new(0) }; 3];
 
-/// `g16_worker_big` 3: records whether flights or pending work exist after a publication.
-pub(crate) fn wbig_busy(busy: bool) {
+/// `g16_worker_big` 3 and 4: records whether flights or pending work exist after a
+/// publication, and whether any of it is compute.
+pub(crate) fn wbig_busy(busy: bool, compute: bool) {
     WBIG_BUSY.store(busy, Ordering::Relaxed);
+    WBIG_CBUSY.store(compute, Ordering::Relaxed);
 }
 
 /// The `wbig:` line of the stats file.
@@ -96,7 +104,7 @@ fn wbig_stats(f: &mut fmt::Formatter<'_>) -> fmt::Result {
     let v = |i: usize| WBIG_N[i].load(Ordering::Relaxed);
     write!(
         f,
-        "wbig: on {} big_cpu {} rechosen {} passes_big {} passes_little {} lat_us {} lat_max_us {} queued {} fallback {} idle_default {} cpu",
+        "wbig: on {} big_cpu {} rechosen {} passes_big {} passes_little {} lat_us {} lat_max_us {} queued {} fallback {} idle_default {} ronly_big {} ronly_little {} ronly_default {} cpu",
         params::worker_big(),
         super::boot::glue::big_cpu(),
         super::boot::glue::big_rechosen(),
@@ -106,7 +114,10 @@ fn wbig_stats(f: &mut fmt::Formatter<'_>) -> fmt::Result {
         v(3) / 1000,
         v(4),
         v(5),
-        WBIG_IDLE.load(Ordering::Relaxed)
+        WBIG_IDLE.load(Ordering::Relaxed),
+        WBIG_RONLY[0].load(Ordering::Relaxed),
+        WBIG_RONLY[1].load(Ordering::Relaxed),
+        WBIG_RONLY[2].load(Ordering::Relaxed)
     )?;
     for c in &WBIG_CPU {
         write!(f, " {}", c.load(Ordering::Relaxed))?;
@@ -425,6 +436,9 @@ pub(crate) fn run_poll(self: Arc<Self>) {
             let cpu = super::boot::glue::this_cpu();
             let big = super::boot::glue::cpu_is_big(cpu);
             WBIG_N[if big { 0 } else { 1 }].fetch_add(1, Ordering::Relaxed);
+            if WBIG_BUSY.load(Ordering::Relaxed) && !WBIG_CBUSY.load(Ordering::Relaxed) {
+                WBIG_RONLY[if big { 0 } else { 1 }].fetch_add(1, Ordering::Relaxed);
+            }
             WBIG_CPU[(cpu.max(0) as usize).min(15)].fetch_add(1, Ordering::Relaxed);
             let queued = WBIG_QUEUED_NS.swap(0, Ordering::Relaxed);
             if queued != 0 {
@@ -649,9 +663,16 @@ fn mod_poll(self: &Arc<Self>, delay: Jiffies) {
         let unbound = bindings::wq_misc_consts_WORK_CPU_UNBOUND as kernel::ffi::c_int;
         // 3: the big CPU (as 2) only while GPU work is outstanding; an idle pass (a firmware
         // ring-service message, the power window, sleep) stays where it was queued (as 0).
+        // 4: as 3, but only while COMPUTE work is outstanding; while only render work is (the
+        // compositor's frames) the pass stays where it was queued, as 0 has it.
         let mode = match params::worker_big() {
             3 if WBIG_BUSY.load(Ordering::Relaxed) => 2,
-            3 => {
+            4 if WBIG_CBUSY.load(Ordering::Relaxed) => 2,
+            4 if WBIG_BUSY.load(Ordering::Relaxed) => {
+                WBIG_RONLY[2].fetch_add(1, Ordering::Relaxed);
+                0
+            }
+            3 | 4 => {
                 WBIG_IDLE.fetch_add(1, Ordering::Relaxed);
                 0
             }
-- 
2.43.0

