From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 08:11:56 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: Enable the three USB4 host
 routers

Enable ACIO0, ACIO1 and ACIO3 with their CIO/PCIe power domains,
mailboxes and the CIO PMGR, and connect each router to its USB-C
connector (typec0/1/3, port@2), in the form of t8132-j713-usb4.dtsi.

No calibration is described: m1n1 copies the router, PCIe adapter and
NHI tunables and the DROM from /arm-io/acioN through the usb4-N-*
aliases, and the PCIe-C tunables from /arm-io/apciecN through the
usb4_N_pcie aliases (dt_set_acio_tunables/dt_set_pcie_tunables). The
J713 values are not used.

The atcrt0/1/3 retimers on i2c2 have no driver and stay as the boot
loader hands them over.

[j604: ACIO3 router index and cio reset 3 are INFERENCE from the ADT;
 the router/tunnel bring-up is TO-VERIFY on hardware]

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 .../arm64/boot/dts/apple/t8132-j604-usb4.dtsi | 184 ++++++++++++++++++
 arch/arm64/boot/dts/apple/t8132-j604.dts      |   6 +
 2 files changed, 190 insertions(+)
 create mode 100644 arch/arm64/boot/dts/apple/t8132-j604-usb4.dtsi

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-usb4.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-usb4.dtsi
new file mode 100644
index 0000000000..3ee311ffe4
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8132-j604-usb4.dtsi
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * J604 USB4/Thunderbolt, in the form of t8132-j713-usb4.dtsi. The J604 has
+ * three host routers, one behind each USB-C port:
+ *   ACIO0 - hpm0, typec0, ATC0 ("USB-C port 1")
+ *   ACIO1 - hpm1, typec1, ATC1 ("USB-C port 2")
+ *   ACIO3 - hpm3, typec3, ATC3 ("USB-C port 4")
+ * ACIO powers its domains only once the port controller reports a USB4 or
+ * Thunderbolt connection.
+ *
+ * Unlike the J713, no calibration is described here: m1n1 copies the router,
+ * PCIe adapter and NHI tunables and the DROM from this machine's ADT
+ * (/arm-io/acioN) through the usb4-N-* aliases, and the PCIe-C tunables
+ * (/arm-io/apciecN) through the usb4_N_pcie aliases.
+ *
+ * The port retimers (atcrt0/1/3 on i2c2) have no driver and are left as the
+ * boot loader hands them over.
+ */
+
+/ {
+	aliases {
+		usb4-0-acio = &usb4_0_acio;
+		usb4-0-nhi = &usb4_0_nhi;
+		usb4-0-pcie-adapter = &usb4_0_acio;
+		usb4_0_pcie = &usb4_0_pcie;
+		usb4-1-acio = &usb4_1_acio;
+		usb4-1-nhi = &usb4_1_nhi;
+		usb4-1-pcie-adapter = &usb4_1_acio;
+		usb4_1_pcie = &usb4_1_pcie;
+		usb4-3-acio = &usb4_3_acio;
+		usb4-3-nhi = &usb4_3_nhi;
+		usb4-3-pcie-adapter = &usb4_3_acio;
+		usb4_3_pcie = &usb4_3_pcie;
+	};
+};
+
+/* ACIO is the consumer that owns these domains while a cable is up. */
+&ps_atc0_pcie {
+	status = "okay";
+};
+
+&ps_atc1_pcie {
+	status = "okay";
+};
+
+&ps_atc3_pcie {
+	status = "okay";
+};
+
+&ps_atc0_cio {
+	status = "okay";
+};
+
+&ps_atc0_cio_pcie {
+	status = "okay";
+};
+
+&ps_atc0_cio_usb {
+	status = "okay";
+};
+
+&ps_atc1_cio {
+	status = "okay";
+};
+
+&ps_atc1_cio_pcie {
+	status = "okay";
+};
+
+&ps_atc1_cio_usb {
+	status = "okay";
+};
+
+&ps_atc3_cio {
+	status = "okay";
+};
+
+&ps_atc3_cio_pcie {
+	status = "okay";
+};
+
+&ps_atc3_cio_usb {
+	status = "okay";
+};
+
+&pmgr_cio {
+	status = "okay";
+};
+
+&usb4_0_mbox {
+	status = "okay";
+};
+
+&usb4_1_mbox {
+	status = "okay";
+};
+
+&usb4_3_mbox {
+	status = "okay";
+};
+
+&usb4_0_acio {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* 1: USB4 port */
+		port@1 {
+			reg = <1>;
+			usb4_0_acio_tbt: endpoint {
+				remote-endpoint = <&typec0_con_tbt>;
+			};
+		};
+	};
+};
+
+&usb4_1_acio {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* 1: USB4 port */
+		port@1 {
+			reg = <1>;
+			usb4_1_acio_tbt: endpoint {
+				remote-endpoint = <&typec1_con_tbt>;
+			};
+		};
+	};
+};
+
+&usb4_3_acio {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* 1: USB4 port */
+		port@1 {
+			reg = <1>;
+			usb4_3_acio_tbt: endpoint {
+				remote-endpoint = <&typec3_con_tbt>;
+			};
+		};
+	};
+};
+
+&typec0 {
+	ports {
+		port@2 {
+			reg = <2>;
+			typec0_con_tbt: endpoint {
+				remote-endpoint = <&usb4_0_acio_tbt>;
+			};
+		};
+	};
+};
+
+&typec1 {
+	ports {
+		port@2 {
+			reg = <2>;
+			typec1_con_tbt: endpoint {
+				remote-endpoint = <&usb4_1_acio_tbt>;
+			};
+		};
+	};
+};
+
+&typec3 {
+	ports {
+		port@2 {
+			reg = <2>;
+			typec3_con_tbt: endpoint {
+				remote-endpoint = <&usb4_3_acio_tbt>;
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index d2fee3667d..4e5a14ea9a 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -978,3 +978,9 @@
 	/* Per-device factory data from this Mac's own iBoot system container. */
 	firmware-name = "apple/mesacal-j604.bin";
 };
+
+/*
+ * USB4/Thunderbolt host routers behind all three USB-C ports; m1n1 fills in
+ * their calibration from this Mac's ADT (see t8132-j604-usb4.dtsi).
+ */
+#include "t8132-j604-usb4.dtsi"
