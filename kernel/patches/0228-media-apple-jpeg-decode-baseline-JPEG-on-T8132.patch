 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Apple Silicon JPEG encoder, V4L2 memory-to-memory.
+ * Apple Silicon JPEG encoder and decoder, V4L2 memory-to-memory.
  *
- * Takes full-range YUV in one buffer (NV12 for 4:2:0, NV16 for 4:2:2) and
- * produces baseline JPEG with the standard Huffman tables. One job runs at
- * a time; the engine is reset before each job and the completion interrupt
- * ends it. Register layout: see apple-jpeg-hw.h.
+ * The encoder takes full-range YUV in one buffer (NV12 for 4:2:0, NV16 for
+ * 4:2:2) and produces baseline JPEG with the standard Huffman tables. The
+ * decoder takes baseline JPEG (4:4:4, 4:2:2 or 4:2:0) and produces NV12 or
+ * NV16 covering whole MCU rows, the visible picture as the compose rectangle.
+ * Both nodes share one job queue: one job runs at a time, the engine is
+ * reset before each job and the completion interrupt ends it. Register
+ * layout: see apple-jpeg-hw.h.
  */
 #include <linux/dma-mapping.h>
 #include <linux/interrupt.h>
@@ -37,6 +40,10 @@
 #define AJ_MAX_SIZE		16384
 #define AJ_JOB_TIMEOUT_MS	2000
 
+static bool decode = true;
+module_param(decode, bool, 0444);
+MODULE_PARM_DESC(decode, "Expose the JPEG decoder node where decode is qualified (default: on)");
+
 struct apple_jpeg {
 	struct device *dev;
 	void __iomem *regs;
@@ -45,7 +52,8 @@ struct apple_jpeg {
 	struct mutex lock;	/* serialises ioctls and queue state */
 	struct v4l2_device v4l2_dev;
 	struct video_device vdev;
-	struct v4l2_m2m_dev *m2m_dev;
+	struct video_device vdec;
+	struct v4l2_m2m_dev *m2m_dev;	/* one job queue for both nodes */
 	int irq;
 
 	spinlock_t hw_lock;	/* protects the fields below */
@@ -59,12 +67,14 @@ struct apple_jpeg {
 struct apple_jpeg_ctx {
 	struct v4l2_fh fh;
 	struct apple_jpeg *jpeg;
+	bool dec;
 	struct v4l2_ctrl_handler hdl;
 	struct v4l2_ctrl *quality;
 	struct v4l2_ctrl *restart;
-	struct v4l2_pix_format_mplane src;	/* raw, OUTPUT queue */
-	struct v4l2_pix_format_mplane dst;	/* JPEG, CAPTURE queue */
+	struct v4l2_pix_format_mplane src;	/* OUTPUT queue: raw (encoder), JPEG (decoder) */
+	struct v4l2_pix_format_mplane dst;	/* CAPTURE queue: JPEG (encoder), raw (decoder) */
 	u32 dst_keep;		/* JPEG buffer size S_FMT(CAPTURE) returned */
+	u32 vis_w, vis_h;	/* decoder: visible picture inside dst */
 	u32 sequence;
 	/*
 	 * Serialises the drain state (last source buffer, stopped) between job
@@ -74,6 +84,18 @@ struct apple_jpeg_ctx {
 	spinlock_t drain_lock;
 };
 
+/* Decoder OUTPUT buffers carry the header parsed when they were prepared. */
+struct aj_buf {
+	struct v4l2_m2m_buffer m2m;
+	struct apple_jpeg_header hdr;
+	int hdr_err;
+};
+
+static struct aj_buf *aj_to_buf(struct vb2_v4l2_buffer *vbuf)
+{
+	return container_of(vbuf, struct aj_buf, m2m.vb);
+}
+
 static struct apple_jpeg_ctx *aj_file_to_ctx(struct file *file)
 {
 	return container_of(file_to_v4l2_fh(file), struct apple_jpeg_ctx, fh);
@@ -135,9 +157,11 @@ static void aj_finish(struct apple_jpeg *jpeg, struct apple_jpeg_ctx *ctx, int e
 	src = v4l2_m2m_src_buf_remove(m2m);
 	dst = v4l2_m2m_dst_buf_remove(m2m);
 	if (src && dst) {
-		if (!err && (jpeg->bytes < 4 || jpeg->bytes > vb2_plane_size(&dst->vb2_buf, 0)))
+		u32 bytes = ctx->dec ? ctx->dst.plane_fmt[0].sizeimage : jpeg->bytes;
+
+		if (!err && (bytes < 4 || bytes > vb2_plane_size(&dst->vb2_buf, 0)))
 			err = -EIO;
-		vb2_set_plane_payload(&dst->vb2_buf, 0, err ? 0 : jpeg->bytes);
+		vb2_set_plane_payload(&dst->vb2_buf, 0, err ? 0 : bytes);
 		v4l2_m2m_buf_copy_metadata(src, dst);
 		dst->sequence = ctx->sequence++;
 		dst->flags |= V4L2_BUF_FLAG_KEYFRAME;
@@ -219,12 +243,41 @@ static void aj_watchdog(struct work_struct *work)
 	}
 }
 
+/* The decode of one OUTPUT buffer into the CAPTURE buffer's whole size. */
+static int aj_dec_job(struct apple_jpeg_ctx *ctx, struct vb2_v4l2_buffer *src,
+		      struct vb2_v4l2_buffer *dst, struct apple_jpeg_dec_job *job)
+{
+	struct aj_buf *b = aj_to_buf(src);
+	dma_addr_t in = vb2_dma_contig_plane_dma_addr(&src->vb2_buf, 0);
+	dma_addr_t y = vb2_dma_contig_plane_dma_addr(&dst->vb2_buf, 0);
+	u32 stride = ctx->dst.plane_fmt[0].bytesperline;
+
+	if (b->hdr_err)
+		return b->hdr_err;
+	/* A larger picture than the CAPTURE buffers: source change was sent. */
+	if (b->hdr.width > ctx->dst.width || b->hdr.height > ctx->dst.height)
+		return -ENOSPC;
+	*job = (struct apple_jpeg_dec_job){
+		.hdr = b->hdr,
+		.out422 = ctx->dst.pixelformat == V4L2_PIX_FMT_NV16,
+		.stride = stride,
+		.input = in,
+		.input_end = in + vb2_plane_size(&src->vb2_buf, 0) - 1,
+		.luma = y,
+		.chroma = y + (u64)stride * ctx->dst.height,
+		.output_end = y + vb2_plane_size(&dst->vb2_buf, 0) - 1,
+		.mode = ctx->jpeg->variant->dec_mode,
+	};
+	return 0;
+}
+
 static void aj_device_run(void *priv)
 {
 	struct apple_jpeg_ctx *ctx = priv;
 	struct apple_jpeg *jpeg = ctx->jpeg;
 	struct vb2_v4l2_buffer *src, *dst;
 	struct apple_jpeg_layout layout;
+	struct apple_jpeg_dec_job djob;
 	struct apple_jpeg_job job;
 	unsigned long flags;
 	dma_addr_t y;
@@ -240,6 +293,14 @@ static void aj_device_run(void *priv)
 		return;
 	}
 
+	if (ctx->dec) {
+		ret = aj_dec_job(ctx, src, dst, &djob);
+		if (ret) {
+			aj_finish(jpeg, ctx, ret);
+			return;
+		}
+		goto run;
+	}
 	y = vb2_dma_contig_plane_dma_addr(&src->vb2_buf, 0);
 	is422 = ctx->src.pixelformat == V4L2_PIX_FMT_NV16;
 	apple_jpeg_raw_layout(ctx->src.width, ctx->src.height, is422, &layout);
@@ -259,6 +320,7 @@ static void aj_device_run(void *priv)
 		.restart_interval = v4l2_ctrl_g_ctrl(ctx->restart),
 	};
 
+run:
 	spin_lock_irqsave(&jpeg->hw_lock, flags);
 	ret = jpeg->broken ? -EIO : aj_reset(jpeg);
 	if (ret) {
@@ -268,8 +330,12 @@ static void aj_device_run(void *priv)
 		aj_finish(jpeg, ctx, -EIO);
 		return;
 	}
-	n = apple_jpeg_build_job(jpeg->variant->layout, &job, jpeg->writes,
-				 ARRAY_SIZE(jpeg->writes));
+	if (ctx->dec)
+		n = apple_jpeg_build_decode(jpeg->variant->layout, &djob, jpeg->writes,
+					    ARRAY_SIZE(jpeg->writes));
+	else
+		n = apple_jpeg_build_job(jpeg->variant->layout, &job, jpeg->writes,
+					 ARRAY_SIZE(jpeg->writes));
 	if (n < 0) {
 		spin_unlock_irqrestore(&jpeg->hw_lock, flags);
 		aj_finish(jpeg, ctx, n);
@@ -332,10 +398,68 @@ static void aj_fill_coded(struct v4l2_pix_format_mplane *dst,
 	dst->plane_fmt[0].sizeimage = apple_jpeg_coded_size(src->width, src->height, keep);
 }
 
+/*
+ * Decoded picture: whole MCU rows (16 pixels at most each way), Y rows then
+ * interleaved CbCr rows in one buffer. The format is the MCU-aligned size;
+ * the visible picture is the compose rectangle.
+ */
+static void aj_fill_dec_raw(struct v4l2_pix_format_mplane *pix)
+{
+	bool is422 = pix->pixelformat == V4L2_PIX_FMT_NV16;
+	u32 w = ALIGN(clamp_t(u32, pix->width, AJ_MIN_SIZE, AJ_MAX_SIZE), 16);
+	u32 h = ALIGN(clamp_t(u32, pix->height, AJ_MIN_SIZE, AJ_MAX_SIZE), 16);
+
+	pix->pixelformat = is422 ? V4L2_PIX_FMT_NV16 : V4L2_PIX_FMT_NV12;
+	pix->width = w;
+	pix->height = h;
+	pix->field = V4L2_FIELD_NONE;
+	pix->num_planes = 1;
+	pix->flags = 0;
+	memset(pix->plane_fmt, 0, sizeof(pix->plane_fmt));
+	memset(pix->reserved, 0, sizeof(pix->reserved));
+	pix->plane_fmt[0].bytesperline = w;
+	pix->plane_fmt[0].sizeimage = w * h + w * (is422 ? h : h / 2);
+	pix->colorspace = V4L2_COLORSPACE_SRGB;
+	pix->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	pix->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	pix->xfer_func = V4L2_XFER_FUNC_SRGB;
+}
+
+/* Decoder input: the size is a hint until a header is parsed. */
+static void aj_fill_dec_coded(struct v4l2_pix_format_mplane *pix)
+{
+	u32 keep = pix->plane_fmt[0].sizeimage;
+
+	pix->width = clamp_t(u32, pix->width, AJ_MIN_SIZE, AJ_MAX_SIZE);
+	pix->height = clamp_t(u32, pix->height, AJ_MIN_SIZE, AJ_MAX_SIZE);
+	pix->pixelformat = V4L2_PIX_FMT_JPEG;
+	pix->field = V4L2_FIELD_NONE;
+	pix->num_planes = 1;
+	pix->flags = 0;
+	memset(pix->plane_fmt, 0, sizeof(pix->plane_fmt));
+	memset(pix->reserved, 0, sizeof(pix->reserved));
+	pix->plane_fmt[0].sizeimage = apple_jpeg_coded_size(pix->width, pix->height, keep);
+	pix->colorspace = V4L2_COLORSPACE_SRGB;
+	pix->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	pix->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	pix->xfer_func = V4L2_XFER_FUNC_SRGB;
+}
+
+/* The CAPTURE size follows the stream; the client picks NV12 or NV16. */
+static void aj_dec_set_size(struct apple_jpeg_ctx *ctx, u32 w, u32 h)
+{
+	ctx->vis_w = w;
+	ctx->vis_h = h;
+	ctx->dst.width = w;
+	ctx->dst.height = h;
+	aj_fill_dec_raw(&ctx->dst);
+}
+
 static int aj_querycap(struct file *file, void *priv, struct v4l2_capability *cap)
 {
 	strscpy(cap->driver, AJ_NAME, sizeof(cap->driver));
-	strscpy(cap->card, "Apple JPEG encoder", sizeof(cap->card));
+	strscpy(cap->card, aj_file_to_ctx(file)->dec ? "Apple JPEG decoder" : "Apple JPEG encoder",
+		sizeof(cap->card));
 	return 0;
 }
 
@@ -489,6 +613,150 @@ static const struct v4l2_ioctl_ops aj_ioctl_ops = {
 	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
 };
 
+/* ---- decoder ioctls ---------------------------------------------------- */
+
+static int aj_dec_enum_fmt_out(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+	f->pixelformat = V4L2_PIX_FMT_JPEG;
+	f->flags = V4L2_FMT_FLAG_COMPRESSED;
+	return 0;
+}
+
+static int aj_dec_enum_fmt_cap(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	static const u32 fmts[] = { V4L2_PIX_FMT_NV12, V4L2_PIX_FMT_NV16 };
+
+	if (f->index >= ARRAY_SIZE(fmts))
+		return -EINVAL;
+	f->pixelformat = fmts[f->index];
+	return 0;
+}
+
+static int aj_dec_try_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	aj_fill_dec_coded(&f->fmt.pix_mp);
+	return 0;
+}
+
+static int aj_dec_try_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct apple_jpeg_ctx *ctx = aj_file_to_ctx(file);
+
+	f->fmt.pix_mp.width = ctx->vis_w;
+	f->fmt.pix_mp.height = ctx->vis_h;
+	aj_fill_dec_raw(&f->fmt.pix_mp);
+	return 0;
+}
+
+static int aj_dec_s_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct apple_jpeg_ctx *ctx = aj_file_to_ctx(file);
+
+	if (vb2_is_busy(v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx)))
+		return -EBUSY;
+	aj_fill_dec_coded(&f->fmt.pix_mp);
+	ctx->src = f->fmt.pix_mp;
+	if (!vb2_is_busy(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
+		aj_dec_set_size(ctx, ctx->src.width, ctx->src.height);
+	return 0;
+}
+
+static int aj_dec_s_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct apple_jpeg_ctx *ctx = aj_file_to_ctx(file);
+
+	if (vb2_is_busy(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
+		return -EBUSY;
+	aj_dec_try_fmt_cap(file, priv, f);
+	ctx->dst = f->fmt.pix_mp;
+	return 0;
+}
+
+static int aj_dec_g_selection(struct file *file, void *priv, struct v4l2_selection *s)
+{
+	struct apple_jpeg_ctx *ctx = aj_file_to_ctx(file);
+
+	if (s->type != V4L2_BUF_TYPE_VIDEO_CAPTURE)
+		return -EINVAL;
+	switch (s->target) {
+	case V4L2_SEL_TGT_COMPOSE:
+	case V4L2_SEL_TGT_COMPOSE_DEFAULT:
+	case V4L2_SEL_TGT_COMPOSE_BOUNDS:
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		s->r = (struct v4l2_rect){ 0, 0, ctx->vis_w, ctx->vis_h };
+		return 0;
+	case V4L2_SEL_TGT_COMPOSE_PADDED:
+		s->r = (struct v4l2_rect){ 0, 0, ctx->dst.width, ctx->dst.height };
+		return 0;
+	}
+	return -EINVAL;
+}
+
+/* As aj_encoder_cmd, for the decoder's drain. */
+static int aj_decoder_cmd(struct file *file, void *priv, struct v4l2_decoder_cmd *dc)
+{
+	struct apple_jpeg_ctx *ctx = aj_file_to_ctx(file);
+	unsigned long flags;
+	int ret;
+
+	ret = v4l2_m2m_ioctl_try_decoder_cmd(file, priv, dc);
+	if (ret)
+		return ret;
+	if (dc->cmd != V4L2_DEC_CMD_STOP) {
+		ret = v4l2_m2m_ioctl_decoder_cmd(file, priv, dc);
+		if (!ret)
+			vb2_clear_last_buffer_dequeued(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx));
+		return ret;
+	}
+	spin_lock_irqsave(&ctx->drain_lock, flags);
+	ret = v4l2_m2m_decoder_cmd(file, ctx->fh.m2m_ctx, dc);
+	if (!ret && v4l2_m2m_has_stopped(ctx->fh.m2m_ctx))
+		v4l2_event_queue_fh(&ctx->fh, &aj_eos);
+	spin_unlock_irqrestore(&ctx->drain_lock, flags);
+	return ret;
+}
+
+static int aj_dec_subscribe_event(struct v4l2_fh *fh, const struct v4l2_event_subscription *sub)
+{
+	if (sub->type == V4L2_EVENT_SOURCE_CHANGE)
+		return v4l2_src_change_event_subscribe(fh, sub);
+	return aj_subscribe_event(fh, sub);
+}
+
+static const struct v4l2_ioctl_ops aj_dec_ioctl_ops = {
+	.vidioc_querycap = aj_querycap,
+	.vidioc_enum_fmt_vid_out = aj_dec_enum_fmt_out,
+	.vidioc_enum_fmt_vid_cap = aj_dec_enum_fmt_cap,
+	.vidioc_enum_framesizes = aj_enum_framesizes,
+	.vidioc_g_fmt_vid_out_mplane = aj_g_fmt_out,
+	.vidioc_g_fmt_vid_cap_mplane = aj_g_fmt_cap,
+	.vidioc_try_fmt_vid_out_mplane = aj_dec_try_fmt_out,
+	.vidioc_try_fmt_vid_cap_mplane = aj_dec_try_fmt_cap,
+	.vidioc_s_fmt_vid_out_mplane = aj_dec_s_fmt_out,
+	.vidioc_s_fmt_vid_cap_mplane = aj_dec_s_fmt_cap,
+	.vidioc_g_selection = aj_dec_g_selection,
+
+	.vidioc_reqbufs = v4l2_m2m_ioctl_reqbufs,
+	.vidioc_querybuf = v4l2_m2m_ioctl_querybuf,
+	.vidioc_qbuf = v4l2_m2m_ioctl_qbuf,
+	.vidioc_dqbuf = v4l2_m2m_ioctl_dqbuf,
+	.vidioc_prepare_buf = v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_create_bufs = v4l2_m2m_ioctl_create_bufs,
