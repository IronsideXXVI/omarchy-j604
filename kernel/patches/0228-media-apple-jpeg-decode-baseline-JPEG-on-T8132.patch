+		if (marker == 0xff) {
+			pos++;		/* fill byte */
+			continue;
+		}
+		if (marker == 0x01 || (marker >= 0xd0 && marker <= 0xd8)) {
+			pos += 2;	/* markers without a length */
+			continue;
