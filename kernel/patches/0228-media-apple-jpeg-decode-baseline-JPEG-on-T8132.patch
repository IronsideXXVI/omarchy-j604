+/* SOI, an APP0 to skip, then SOF0 for 1921x1081 with the given Y sampling. */
+static void apple_jpeg_test_header(u8 *b, u8 sof, u8 y_sampling, u8 ncomp)
+{
+	static const u8 head[] = { 0xff, 0xd8, 0xff, 0xe0, 0x00, 0x04, 0x00, 0x00, 0xff, 0xff };
+	u8 sofbody[] = { 0xff, 0x00, 0x00, 0x11, 0x08, 0x04, 0x39, 0x07, 0x81, 0x03,
+			 0x01, 0x22, 0x00, 0x02, 0x11, 0x01, 0x03, 0x11, 0x01 };
+
+	memcpy(b, head, sizeof(head));
+	sofbody[1] = sof;
+	sofbody[11] = y_sampling;
+	sofbody[9] = ncomp;
+	memcpy(b + sizeof(head), sofbody, sizeof(sofbody));
+}
+
+static void apple_jpeg_parse_test(struct kunit *test)
+{
+	struct apple_jpeg_header hdr = {};
+	u8 b[32];
+
+	apple_jpeg_test_header(b, 0xc0, 0x22, 3);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_parse_header(b, sizeof(b), &hdr), 0);
+	KUNIT_EXPECT_EQ(test, hdr.width, 1921);
+	KUNIT_EXPECT_EQ(test, hdr.height, 1081);
+	KUNIT_EXPECT_EQ(test, hdr.codec, AJ_CODEC_420);
+	apple_jpeg_test_header(b, 0xc1, 0x21, 3);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_parse_header(b, sizeof(b), &hdr), 0);
+	KUNIT_EXPECT_EQ(test, hdr.codec, AJ_CODEC_422);
+	apple_jpeg_test_header(b, 0xc0, 0x11, 3);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_parse_header(b, sizeof(b), &hdr), 0);
+	KUNIT_EXPECT_EQ(test, hdr.codec, AJ_CODEC_444);
+
+	/* Progressive, 4:1:1, greyscale: not for the engine. */
+	apple_jpeg_test_header(b, 0xc2, 0x22, 3);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_parse_header(b, sizeof(b), &hdr), -EOPNOTSUPP);
+	apple_jpeg_test_header(b, 0xc0, 0x41, 3);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_parse_header(b, sizeof(b), &hdr), -EOPNOTSUPP);
+	apple_jpeg_test_header(b, 0xc0, 0x22, 1);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_parse_header(b, sizeof(b), &hdr), -EOPNOTSUPP);
+	/* Truncated frame header, no SOI, scan before the frame header. */
+	apple_jpeg_test_header(b, 0xc0, 0x22, 3);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_parse_header(b, 20, &hdr), -EINVAL);
+	b[0] = 0;
+	KUNIT_EXPECT_EQ(test, apple_jpeg_parse_header(b, sizeof(b), &hdr), -EINVAL);
+	apple_jpeg_test_header(b, 0xda, 0x22, 3);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_parse_header(b, sizeof(b), &hdr), -EINVAL);
+}
+
+static struct apple_jpeg_dec_job apple_jpeg_test_dec_job(void)
+{
+	return (struct apple_jpeg_dec_job){
+		.hdr = { .width = 1920, .height = 1080, .codec = AJ_CODEC_420 },
+		.stride = 1920,
+		.input = 0x10000100000ULL, .input_end = 0x100001fffffULL,
+		.luma = 0x10001000000ULL, .chroma = 0x100011fe000ULL,
+		.output_end = 0x100012fcfffULL,
+		.mode = AJ_MODE_DECODE_T8132,
+	};
+}
+
+static void apple_jpeg_decode_test(struct kunit *test)
+{
+	struct apple_jpeg_write *w = kunit_kcalloc(test, APPLE_JPEG_MAX_WRITES, sizeof(*w),
+						   GFP_KERNEL);
+	const struct apple_jpeg_reg_layout *wide = apple_jpeg_t8132.layout;
+	struct apple_jpeg_dec_job job = apple_jpeg_test_dec_job();
+	int n;
+
+	KUNIT_ASSERT_NOT_NULL(test, w);
+	n = apple_jpeg_build_decode(wide, &job, w, APPLE_JPEG_MAX_WRITES);
+	KUNIT_ASSERT_GT(test, n, 0);
+	KUNIT_EXPECT_EQ(test, w[0].value, AJ_MODE_SETUP);
+	KUNIT_EXPECT_EQ(test, w[n - 1].offset, AJ_COMMAND);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, AJ_DECODE_ENABLE), 1);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, AJ_ENCODE_ENABLE), 0);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, AJ_CODEC), AJ_CODEC_420);
+	/* The m1n1 decode block, 0x3c up on the wide layout. */
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x16c), 120);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x170), 68);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x178), 8);	/* 1080 - 1088 + 16 */
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x180), 4);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x188), AJ_DEC_FMT_YUV420_PLANES);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, AJ_PX_PLANE1_HEIGHT_M1), 539);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, AJ_PX_PLANE1_TILE_V), 8);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, AJ_CHROMA_HALVE_V_TYPE1), 0);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x0c0), 0x01000000);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x0d0), 0x011fe000);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x0d4), 0x100);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x0b8), 0x1f);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x154), 0);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x158), 1);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x19c), 0);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, AJ_JPEG_IO_FLAGS), AJ_DEC_IO_FLAGS);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, AJ_MODE), AJ_MODE_DECODE_T8132);
+
+	/* 4:2:2 into NV12 halves the chroma vertically. */
+	job.hdr.codec = AJ_CODEC_422;
+	n = apple_jpeg_build_decode(wide, &job, w, APPLE_JPEG_MAX_WRITES);
+	KUNIT_ASSERT_GT(test, n, 0);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, AJ_CHROMA_HALVE_V_TYPE1), 1);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, AJ_PX_PLANE1_TILE_V), 4);
+	KUNIT_EXPECT_EQ(test, apple_jpeg_last(w, n, 0x170), 135);
+
+	/* Chroma inside the luma's MCU rows, or a short output, is refused. */
+	job = apple_jpeg_test_dec_job();
+	job.chroma = job.luma + 1920 * 1080;
+	KUNIT_EXPECT_EQ(test, apple_jpeg_build_decode(wide, &job, w, APPLE_JPEG_MAX_WRITES),
+			-EINVAL);
+	job = apple_jpeg_test_dec_job();
+	job.output_end -= 1920;
+	KUNIT_EXPECT_EQ(test, apple_jpeg_build_decode(wide, &job, w, APPLE_JPEG_MAX_WRITES),
+			-EINVAL);
+	job = apple_jpeg_test_dec_job();
+	KUNIT_EXPECT_EQ(test, apple_jpeg_build_decode(apple_jpeg_t6000.layout, &job, w,
+						      APPLE_JPEG_MAX_WRITES), -ERANGE);
+}
