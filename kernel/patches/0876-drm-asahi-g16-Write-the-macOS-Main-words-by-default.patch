From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 05:52:49 +0000
Subject: [PATCH] drm/asahi: g16: Write the macOS Main words by default

g16_main_macos writes the Main words macOS 26B123 has at INIT on the
J604, placed at this firmware's offsets through the field map of the
two builds. Turn it on by default; it still needs the eleven-row
table and leaves +0xea0 out as before.

g16_main_macos=0 restores the previous encoding.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/asahi_core.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_core.rs b/drivers/gpu/drm/asahi/asahi_core.rs
index 11cc0dcf58..7bf24faa31 100644
--- a/drivers/gpu/drm/asahi/asahi_core.rs
+++ b/drivers/gpu/drm/asahi/asahi_core.rs
@@ -268,8 +268,8 @@ fn init(module: &'static kernel::ThisModule) -> impl PinInit<Self, Error> {
             description: "G16: J604 eleven DVFS rows, ADT state 4 kept (default 1; 0: ten rows)",
         },
         g16_main_macos: u32 {
-            default: 0,
-            description: "G16: J604 Main words as macOS 26B123 has them (default 0; 1: the table)",
+            default: 1,
+            description: "G16: J604 Main words as macOS 26B123 has them (default 1; 0: off)",
         },
         g16_main_macos_from: u32 {
             default: 0,
-- 
2.43.0

