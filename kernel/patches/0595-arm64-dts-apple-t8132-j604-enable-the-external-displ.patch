From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 06:00:02 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: enable the external display
 chain

Enable what the external display coprocessors use, so that HDMI and USB-C
displays work once the boot loader hands a dcpext over:

- the DisplayPort-out domains (dispext0/1 sys, fe, cpu), firmware-owned as
  on the J713: the boot loader hands the coprocessors over running and only
  does so when they are;
- the ATC0/1/3 display crossbars that the dcpexts' Type-C routes select.
  Their driver touches no register at probe and holds the ATC USB domain
  only while an output is selected, so idle USB-C ports still power down;
- the HDMI port's ATC2 DisplayPort PHY and display crossbar, with ATC2's
  domains: ATC2_USB under runtime PM and ATC2_USB_AON always on, as for the
  USB-C ports, and ATC2_COMMON always on, as ATC3_COMMON for the M3 Pro HDMI
  port: no USB consumer holds it, and across system sleep it would power
  down and lose the HDMI PHY state.

The dcpexts themselves, their mailboxes, DARTs and Type-C routes stay
disabled here; the boot loader enables them.

[j604: H3-D3 of ports-3 round 2. Whether the loader leaves ATC2_USB_AON on
 and ATC2_COMMON on
 is not measured; always-on turns them on if not (pmgr-pwrstate.c). Desk check:
 HDMI check at the desk.]

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 .../boot/dts/apple/t8132-j604-dcpext.dtsi     | 18 ++++++++-
 .../arm64/boot/dts/apple/t8132-j604-hdmi.dtsi | 12 ++++--
 .../arm64/boot/dts/apple/t8132-j604-pmgr.dtsi | 40 +++++++++++++------
 arch/arm64/boot/dts/apple/t8132-j604.dts      |  5 ++-
 4 files changed, 55 insertions(+), 20 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-dcpext.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-dcpext.dtsi
index 7a71cd7bf4..b2d0364d00 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-dcpext.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-dcpext.dtsi
@@ -20,8 +20,10 @@
  * Streams: SID23 for the firmware, SID0 scanout and SID16 PIODMA, as on
  * the internal display.
  *
- * The ATC display crossbars these routes select (atc0/1/3_dpxbar) stay
- * disabled too until the external display driver is enabled with them.
+ * The ATC display crossbars these routes select (atc0/1/3_dpxbar) are
+ * enabled: their driver touches no register at probe and holds the ATC USB
+ * domain only while an output is selected, so idle USB-C ports still power
+ * down.
  *
  * The J604's HDMI port (port-hdmi-1: ATC2's DisplayPort-only PHY, its
  * display crossbar and an on-board DP-to-HDMI converter) is added to dcpext0
@@ -367,3 +369,15 @@
 		};
 	};
 };
+
+&atc0_dpxbar {
+	status = "okay";
+};
+
+&atc1_dpxbar {
+	status = "okay";
+};
+
+&atc3_dpxbar {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t8132-j604-hdmi.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-hdmi.dtsi
index 6efa5c176f..29770e0b44 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-hdmi.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-hdmi.dtsi
@@ -28,9 +28,10 @@
  * through the atcphy2 alias like that of the USB-C ports' PHYs; the PHY uses
  * the bank and AUX lists of it.
  *
- * Everything here stays disabled with dcpext0 (t8132-j604-dcpext.dtsi) until
- * the external coprocessor driver path is enabled for the J604. ATC2's power
- * domains (t8132-j604-pmgr.dtsi) stay disabled as well.
+ * The PHY and the crossbar are enabled, with ATC2's power domains
+ * (t8132-j604-pmgr.dtsi); dcpext0 is enabled by the boot loader when it hands
+ * the coprocessor over (t8132-j604-dcpext.dtsi). Until then the PHY stays
+ * powered down.
  *
  * The port's audio is DPA1 (ADT dp-audio1, SIO channel 0x66, the dp-audio
  * node dcpext0 names), as on the M3 Pro HDMI port. It is not described: this
@@ -67,7 +68,6 @@
 		orientation-switch;
 		mode-switch;
 		power-domains = <&ps_atc2_usb>;
-		status = "disabled";
 
 		ports {
 			#address-cells = <1>;
@@ -118,3 +118,7 @@
 		};
 	};
 };
+
+&atc2_dpxbar {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
index d35bfdbc1b..7f321973da 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
@@ -11,9 +11,17 @@
  * - A domain that an enabled J604 node consumes, directly or as the parent
  *   of a consumed domain, stays enabled. This covers ATC3 USB, the
  *   general-purpose PCIe and the NUB SPMI buses.
- * - The DisplayPort-out domains (dispext0/1 sys, fe, cpu), which the J713
- *   keeps firmware-owned, are disabled here. They are off when the J604
- *   boots and no J604 node consumes them.
+ * - ATC2, which runs the HDMI port's DisplayPort PHY and display crossbar
+ *   (t8132-j604-hdmi.dtsi) and has no USB controller on this board: its
+ *   ATC2_USB domain is left to runtime PM like those of the USB-C ports, and
+ *   its ATC2_USB_AON parent stays on like theirs. ATC2_COMMON stays on as
+ *   well: no USB consumer holds it, and across system sleep it would power
+ *   down and lose the HDMI PHY state (as ATC3_COMMON on the M3 Pro, see
+ *   t603x-j514s-j516s-hdmi.dtsi).
+ *
+ * The DisplayPort-out domains (dispext0/1 sys, fe, cpu) are firmware-owned,
+ * as on the J713: the boot loader hands the external display coprocessors
+ * over running (t8132-j604-dcpext.dtsi) and refuses to unless they are.
  *
  * The USB-C ports' ATCn_USB and ATCn_COMMON domains are left to runtime PM,
  * so an idle port switches both off, as on the J713. Their ATCn_USB_AON
@@ -99,15 +107,18 @@
 };
 
 &ps_dispext0_sys {
-	status = "disabled";
+	status = "okay";
+	apple,firmware-owned;
 };
 
 &ps_dispext0_fe {
-	status = "disabled";
+	status = "okay";
+	apple,firmware-owned;
 };
 
 &ps_dispext0_cpu {
-	status = "disabled";
+	status = "okay";
+	apple,firmware-owned;
 };
 
 &ps_scodec {
@@ -325,7 +336,8 @@
 };
 
 &ps_atc2_common {
-	status = "disabled";
+	status = "okay";
+	apple,always-on;
 };
 
 &ps_atc2_pcie {
@@ -393,15 +405,18 @@
 };
 
 &ps_dispext1_sys {
-	status = "disabled";
+	status = "okay";
+	apple,firmware-owned;
 };
 
 &ps_dispext1_fe {
-	status = "disabled";
+	status = "okay";
+	apple,firmware-owned;
 };
 
 &ps_dispext1_cpu {
-	status = "disabled";
+	status = "okay";
+	apple,firmware-owned;
 };
 
 /* The camera powers the ISP from its first stream until it is unbound. */
@@ -603,7 +618,8 @@
 };
 
 &ps_atc2_usb_aon {
-	status = "disabled";
+	status = "okay";
+	apple,always-on;
 };
 
 &ps_atc3_usb_aon {
@@ -612,7 +628,7 @@
 };
 
 &ps_atc2_usb {
-	status = "disabled";
+	status = "okay";
 };
 
 &ps_atc3_usb {
diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 0a6435dc28..bee83f0b2a 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -1018,11 +1018,12 @@
 
 /*
  * External display coprocessors and their USB-C DisplayPort tunnel routes,
- * all disabled until the boot loader hands a dcpext over (see
+ * enabled by the boot loader when it hands a dcpext over (see
  * t8132-j604-dcpext.dtsi).
  */
 #include "t8132-j604-dcpext.dtsi"
 
 #include "t8132-j604-sleep.dtsi"
-/* The HDMI port, on dcpext0 (disabled with it). */
