From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 05:12:40 +0000
Subject: [PATCH] soc: apple: s2r: check the APCIe block's own fabric
 before touching it

On a J604, genpd gated the APCIe block's PHY_SW, SYS_GP and GP domains
at noirq while its system domain stayed on, and the T8132 lowering then
stopped the clock generator because only that system domain was
checked. With the block's way into the fabric gated, such an access
never completes.

Check the block's fabric (GP and SYS_GP, and PHY_SW until the lowering
lowers it) before each of its windows is touched: a block found with
its system domain on and its fabric dark is refused at the first step,
named, with nothing touched; the clock generator and the PHY are
stopped only with the fabric on; the AXI enables are cleared only with
GP on. The sleep then refuses with the step named instead of hanging,
whatever holds the domains elsewhere.

Only the T8132 sequence's lowering is affected; it is off by default.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/apple-s2r.c | 42 +++++++++++++++++++++++++++++------
 1 file changed, 35 insertions(+), 7 deletions(-)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index c672e08582..6b835965dc 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -2069,21 +2069,40 @@ static int apple_s2r_t8132_apcie_clk_off(struct apple_s2r_t8132 *t)
  * ANS's own link runs on this block, and macOS takes it down with the domains,
  * in this order. A block's registers fault with its domain off.
  */
+/* The APCIe block's fabric: GP and SYS_GP, and PHY_SW while it has not been lowered yet */
+static bool apple_s2r_t8132_apcie_fabric_on(struct apple_s2r *s2r, bool phy_sw)
+{
+	return apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_GP) &&
+	       apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_SYS_GP) &&
+	       (!phy_sw || apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_PHY_SW));
+}
+
 static void apple_s2r_t8132_lower_apcie(struct apple_s2r *s2r, unsigned int depth)
 {
 	struct apple_s2r_t8132 *t = &s2r->t8132;
 	void __iomem *gp = t->ps + T8132_PS_APCIE_SYS_GP;
 	u32 val;
 
+	/*
+	 * The block's own fabric first, whatever holds it elsewhere: with its
+	 * system domain on and PHY_SW, SYS_GP or GP gated (genpd at noirq), every
+	 * window of it hangs the bus. Refused, named, and nothing touched.
+	 */
+	if (apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_SYS_ST) &&
+	    !apple_s2r_t8132_apcie_fabric_on(s2r, true)) {
+		apple_s2r_t8132_lower_fail(t, S2R_CRUMB_T8132_PORTS, -ENODEV);
+		return;
+	}
+
 	t->apcie_lowered = true;
 	apple_s2r_t8132_ports_stop(s2r);
 	apple_s2r_t8132_step(s2r, S2R_CRUMB_T8132_PORTS, T8132_TT_PORTS);
 	if (depth < 4)
 		return;
 	t->apcie_domains_lowered = true;
-	/* The PHY's registers need both domains on. */
-	if (apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_PHY_SW) &&
-	    apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_SYS_ST))
+	/* The PHY's registers need both domains on, and the fabric. */
+	if (apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_SYS_ST) &&
+	    apple_s2r_t8132_apcie_fabric_on(s2r, true))
 		apple_s2r_t8132_lower_fail(t, S2R_CRUMB_T8132_PHY,
 					   apple_s2r_t8132_apcie_phy_off(t));
 	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_APCIE_PHY_SW);
@@ -2091,9 +2110,14 @@ static void apple_s2r_t8132_lower_apcie(struct apple_s2r *s2r, unsigned int dept
 	if (depth < 5)
 		return;
 
-	if (apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_SYS_ST))
-		apple_s2r_t8132_lower_fail(t, S2R_CRUMB_T8132_SYS,
-					   apple_s2r_t8132_apcie_clk_off(t));
+	/* PHY_SW is down by now, as macOS has it; SYS_GP and GP are the path in. */
+	if (apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_SYS_ST)) {
+		if (apple_s2r_t8132_apcie_fabric_on(s2r, false))
+			apple_s2r_t8132_lower_fail(t, S2R_CRUMB_T8132_SYS,
+						   apple_s2r_t8132_apcie_clk_off(t));
+		else
+			apple_s2r_t8132_lower_fail(t, S2R_CRUMB_T8132_SYS, -ENODEV);
+	}
 	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_APCIE_SYS_ST);
 	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_APCIE_ST);
 	apple_s2r_t8132_step(s2r, S2R_CRUMB_T8132_SYS, T8132_TT_DOMAINS);
@@ -2106,7 +2130,11 @@ static void apple_s2r_t8132_lower_apcie(struct apple_s2r *s2r, unsigned int dept
 	 * latches a PCIe receive link error once the block's last domain goes off.
 	 */
 	val = apple_s2r_t8132_ps_lower_start(gp);
-	if (apple_s2r_t8132_ps_wait_on(gp, val)) {
+	if (!apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_GP)) {
+		/* SYS_GP's parent dark: the AXI window has no way in. */
+		if (FIELD_GET(T8132_PS_TARGET, val))
+			apple_s2r_t8132_lower_fail(t, S2R_CRUMB_T8132_GP, -ENODEV);
+	} else if (apple_s2r_t8132_ps_wait_on(gp, val)) {
 		writel(readl(t->apcie_axi + APCIE_AXI_EN0) & ~BIT(0), t->apcie_axi + APCIE_AXI_EN0);
 		writel(readl(t->apcie_axi + APCIE_AXI_EN1) & ~BIT(0), t->apcie_axi + APCIE_AXI_EN1);
 	} else if (FIELD_GET(T8132_PS_TARGET, val)) {
