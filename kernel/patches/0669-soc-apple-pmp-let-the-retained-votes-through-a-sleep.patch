From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 14:53:59 +0000
Subject: [PATCH] soc: apple: pmp: let the retained votes through a sleep that
 stops the PMP

On the J713 and J604 the PMP bridge carries the retained DISP and AGX
votes, and the PMP refused every sleep that stops it: "retained power
votes have no teardown". A vote held while the PMP stops is lost with
its firmware state, and taking one while it is stopped cannot work.

The bridge cannot release a vote by itself: DISP may only go once its
consumer has powered the display domains down. The DCP already does
that for display sleep: iomfb_m4_power_gate() stops its CPU, powers its
DARTs down and then puts the DISP vote, and iomfb_m4_power_ungate()
gets it again first. AGX has no release.

So let a consumer say, once after prepare, that it puts its DISP vote
in its suspend and gets it again in its resume
(apple_pmp_j713_display_sleep_enable()). The device link from prepare
already orders that suspend before the PMP's suspend_late and that
resume after its resume_early. In suspend_late the PMP then asks the
bridge (apple_pmp_display_sleep()): only with such a consumer, no
request in flight, a working request stream, and neither DISP nor AGX
held does it stop; from then on the bridge takes no vote until
apple_pmp_display_wake(), from resume_early or when the sleep did not
happen. A PMP left stopped by a sleep refused after its commit stays
closed until the next real sleep restarts it.

No consumer opts in yet, so every such sleep is still refused with
-EBUSY, now with the reason logged. The decisions are in
pmp-display-sleep.h, for unit tests.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>

---
 drivers/soc/apple/pmp-display-sleep.h | 115 ++++++++++++++++++++++++++
 drivers/soc/apple/pmp-display.c       | 102 ++++++++++++++++++++++-
 drivers/soc/apple/pmp-export.c        |  26 ++++--
 include/linux/soc/apple/pmp-display.h |  12 +++
 tools/asahi/display26-tests.py        |   5 +-
 5 files changed, 253 insertions(+), 7 deletions(-)
 create mode 100644 drivers/soc/apple/pmp-display-sleep.h

diff --git a/drivers/soc/apple/pmp-display-sleep.h b/drivers/soc/apple/pmp-display-sleep.h
new file mode 100644
index 0000000000..c69103b05b
--- /dev/null
+++ b/drivers/soc/apple/pmp-display-sleep.h
@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The retained DISP/AGX votes through a system sleep that stops the PMP
+ * (pmp-display.c, pmp-export.c). Decisions only, no hardware: unit tested
+ * by pmp-display-sleep-test.c.
+ *
+ * The bridge cannot release a vote on its own. DISP is released by its
+ * consumer, the DCP, which powers the display domains down first and calls
+ * apple_pmp_j713_display_put() (iomfb_m4_power_gate()); it takes the vote
+ * again with apple_pmp_j713_display_get() after power-up. AGX has no release
+ * at all. So a sleep that stops the PMP may only go ahead when a consumer has
+ * said it releases DISP for such a sleep, DISP and AGX are not held, nothing
+ * is in flight and the request stream works; from then until wake no vote
+ * may be taken, since a stopped PMP cannot accept one.
+ */
+#ifndef _APPLE_PMP_DISPLAY_SLEEP_H
+#define _APPLE_PMP_DISPLAY_SLEEP_H
+
+#include <linux/types.h>
+
+enum pmp_display_sleep_verdict {
+	PMP_DISPLAY_SLEEP_OK,
+	/* No consumer releases DISP for such a sleep (apple_pmp_j713_display_sleep_enable()). */
+	PMP_DISPLAY_SLEEP_NO_CONSUMER,
+	/* The PMP owner failed, or an ambiguous reply closed the request stream. */
+	PMP_DISPLAY_SLEEP_FAILED,
+	/* A vote request is in flight. */
+	PMP_DISPLAY_SLEEP_PENDING,
+	/* The AGX vote is held: it has no release. */
+	PMP_DISPLAY_SLEEP_AGX_HELD,
+	/* The DISP vote is held: its consumer has not powered the display down. */
+	PMP_DISPLAY_SLEEP_DISP_HELD,
+};
+
+struct pmp_display_sleep {
+	/* A consumer releases DISP before such a sleep and takes it again after. */
+	bool consumer;
+	/* Between apple_pmp_display_sleep() and apple_pmp_display_wake(). */
+	bool asleep;
+};
+
+/* The vote state the decision reads, as pmp-display.c keeps it. */
+struct pmp_display_sleep_votes {
+	int provider_error;
+	int error;
+	bool pending;
+	bool disp_held;
+	bool agx_held;
+};
+
+static inline enum pmp_display_sleep_verdict
+pmp_display_sleep_check(const struct pmp_display_sleep *s, const struct pmp_display_sleep_votes *v)
+{
+	/* First: without a consumer nothing else is asked, as before this check existed. */
+	if (!s->consumer)
+		return PMP_DISPLAY_SLEEP_NO_CONSUMER;
+	if (v->provider_error)
+		return PMP_DISPLAY_SLEEP_FAILED;
+	if (v->pending)
+		return PMP_DISPLAY_SLEEP_PENDING;
+	if (v->agx_held)
+		return PMP_DISPLAY_SLEEP_AGX_HELD;
+	if (v->disp_held)
+		return PMP_DISPLAY_SLEEP_DISP_HELD;
+	/* Released, but the consumer could not take DISP again after wake. */
+	if (v->error)
+		return PMP_DISPLAY_SLEEP_FAILED;
+	return PMP_DISPLAY_SLEEP_OK;
+}
+
+/* Enter the sleep if allowed. Already asleep: nothing could have changed, OK. */
+static inline enum pmp_display_sleep_verdict
+pmp_display_sleep_enter(struct pmp_display_sleep *s, const struct pmp_display_sleep_votes *v)
+{
+	enum pmp_display_sleep_verdict verdict;
+
+	if (s->asleep)
+		return PMP_DISPLAY_SLEEP_OK;
+	verdict = pmp_display_sleep_check(s, v);
+	if (verdict == PMP_DISPLAY_SLEEP_OK)
+		s->asleep = true;
+	return verdict;
+}
+
+static inline void pmp_display_sleep_leave(struct pmp_display_sleep *s)
+{
+	s->asleep = false;
+}
+
+/* Whether a vote may be taken now: not while the PMP is stopped for a sleep. */
+static inline bool pmp_display_sleep_admits(const struct pmp_display_sleep *s)
+{
+	return !s->asleep;
+}
+
+static inline const char *pmp_display_sleep_reason(enum pmp_display_sleep_verdict verdict)
+{
+	switch (verdict) {
+	case PMP_DISPLAY_SLEEP_OK:
+		return "votes released";
+	case PMP_DISPLAY_SLEEP_NO_CONSUMER:
+		return "retained power votes have no teardown (no consumer releases DISP)";
+	case PMP_DISPLAY_SLEEP_FAILED:
+		return "the vote stream failed";
+	case PMP_DISPLAY_SLEEP_PENDING:
+		return "a vote request is in flight";
+	case PMP_DISPLAY_SLEEP_AGX_HELD:
+		return "the AGX vote is held and has no release";
+	case PMP_DISPLAY_SLEEP_DISP_HELD:
+		return "the DISP vote is still held (display not powered down)";
+	}
+	return "unknown";
+}
+
+#endif
diff --git a/drivers/soc/apple/pmp-display.c b/drivers/soc/apple/pmp-display.c
index 6496faef3f..29db2d27a8 100644
--- a/drivers/soc/apple/pmp-display.c
+++ b/drivers/soc/apple/pmp-display.c
@@ -21,6 +21,8 @@
 #include <linux/unaligned.h>
 #include <linux/soc/apple/pmp-display.h>
 
+#include "pmp-display-sleep.h"
+
 /* AGX: command 0x0f, logical device 5, state 1. The reply carries no tag. */
 #define PMP_AGX_REQUEST		0x0020f50100000000ULL
 #define PMP_DISP_REQUEST	0x0020f80100000000ULL
@@ -221,6 +223,8 @@ struct apple_pmp_display {
 	struct pmp_power_vote vote;
 	struct device_link *link[PMP_POWER_COUNT];
 	bool agx_table_valid;
+	/* System sleep that stops the PMP (pmp-display-sleep.h); under @lock. */
+	struct pmp_display_sleep sleep;
 };
 
 /* One qualified supplier; published once, never freed during its epoch. */
@@ -439,7 +443,8 @@ static int pmp_power_get(struct device *consumer, enum pmp_power_kind kind)
 	spin_lock_irqsave(&p->lock, flags);
 	/* Reset before publishing pending: an immediate reply must not be lost. */
 	reinit_completion(&p->reply);
-	ret = pmp_vote_begin(&p->vote, kind);
+	/* A PMP stopped for a system sleep takes no vote until apple_pmp_display_wake(). */
+	ret = pmp_display_sleep_admits(&p->sleep) ? pmp_vote_begin(&p->vote, kind) : -EBUSY;
 	spin_unlock_irqrestore(&p->lock, flags);
 	if (ret <= 0)
 		goto out;
@@ -566,3 +571,98 @@ int apple_pmp_j713_gpu_get(struct device *consumer)
 	return apple_pmp_display_board() ? pmp_power_get(consumer, PMP_POWER_AGX) : -ENODEV;
 }
 EXPORT_SYMBOL_GPL(apple_pmp_j713_gpu_get);
+
+/*
+ * System sleep that stops the PMP (pmp-export.c). The bridge releases no
+ * vote itself: DISP is released by its consumer, which powers the display
+ * domains down and calls apple_pmp_j713_display_put() in its suspend, and
+ * takes it again with apple_pmp_j713_display_get() in its resume, once the
+ * PMP is back. The device link apple_pmp_j713_display_prepare() made orders
+ * that suspend before the PMP's and that resume after it. AGX has no
+ * release: a held AGX vote keeps refusing such a sleep.
+ *
+ * The consumer says it does so with apple_pmp_j713_display_sleep_enable(),
+ * after prepare; it holds until reboot, as the links do. Without it,
+ * apple_pmp_display_sleep() refuses, as the PMP did before.
+ */
+int apple_pmp_j713_display_sleep_enable(struct device *consumer)
+{
+	struct apple_pmp_display *p;
+	unsigned long flags;
+	int ret;
+
+	if (!apple_pmp_display_board())
+		return -ENODEV;
+	p = pmp_power_consumer(consumer, PMP_POWER_DISP);
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+	mutex_lock(&p->request);
+	ret = p->link[PMP_POWER_DISP] ? 0 : -ENODEV;
+	if (!ret) {
+		spin_lock_irqsave(&p->lock, flags);
+		p->sleep.consumer = true;
+		spin_unlock_irqrestore(&p->lock, flags);
+	}
+	mutex_unlock(&p->request);
+	if (!ret)
+		dev_info(p->dev, "%s releases the retained DISP vote for a system sleep\n",
+			 dev_name(consumer));
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_pmp_j713_display_sleep_enable);
+
+/*
+ * From the PMP's suspend_late, before it stops. 0: no vote is held or in
+ * flight, and none is taken until apple_pmp_display_wake(). Otherwise
+ * nothing changed and the sleep is refused: -EBUSY, or the error of a
+ * failed vote stream.
+ */
+int apple_pmp_display_sleep(void)
+{
+	/* Pairs with the release in apple_pmp_display_register(). */
+	struct apple_pmp_display *p = smp_load_acquire(&pmp_display);
+	enum pmp_display_sleep_verdict verdict;
+	struct pmp_display_sleep_votes v;
+	unsigned long flags;
+	int ret;
+
+	if (!p) {
+		pr_err("pmp-display: no vote bridge, retained power votes have no teardown: refusing the sleep\n");
+		return -EBUSY;
+	}
+	/* Every get and put sends under the request lock: nothing is in flight while it is held. */
+	mutex_lock(&p->request);
+	spin_lock_irqsave(&p->lock, flags);
+	v = (struct pmp_display_sleep_votes) {
+		.provider_error = p->vote.provider_error,
+		.error = p->vote.error,
+		.pending = p->vote.pending != PMP_POWER_NONE,
+		.disp_held = p->vote.held[PMP_POWER_DISP],
+		.agx_held = p->vote.held[PMP_POWER_AGX],
+	};
+	verdict = pmp_display_sleep_enter(&p->sleep, &v);
+	spin_unlock_irqrestore(&p->lock, flags);
+	mutex_unlock(&p->request);
+
+	if (verdict == PMP_DISPLAY_SLEEP_OK) {
+		dev_dbg(p->dev, "retained votes released: none taken until wake\n");
+		return 0;
+	}
+	ret = verdict == PMP_DISPLAY_SLEEP_FAILED ? (v.provider_error ?: v.error ?: -EIO) : -EBUSY;
+	dev_err(p->dev, "%s: refusing the sleep\n", pmp_display_sleep_reason(verdict));
+	return ret;
+}
+
+/* From the PMP's resume_early, or when its sleep did not happen: votes may be taken again. */
+void apple_pmp_display_wake(void)
+{
+	/* Pairs with the release in apple_pmp_display_register(). */
+	struct apple_pmp_display *p = smp_load_acquire(&pmp_display);
+	unsigned long flags;
+
+	if (!p)
+		return;
+	spin_lock_irqsave(&p->lock, flags);
+	pmp_display_sleep_leave(&p->sleep);
+	spin_unlock_irqrestore(&p->lock, flags);
+}
diff --git a/drivers/soc/apple/pmp-export.c b/drivers/soc/apple/pmp-export.c
index 93a8aa9123..577aace748 100644
--- a/drivers/soc/apple/pmp-export.c
+++ b/drivers/soc/apple/pmp-export.c
@@ -196,23 +196,36 @@ static int apple_pmp_commit_prepare(struct device *dev)
 
 static int apple_pmp_suspend_late(struct device *dev)
 {
-	bool at_commit;
+	bool at_commit, retained;
 	int ret;
 
 	if (!pm_suspend_via_firmware())
 		return 0;
-	/* Retained power votes have no teardown. */
-	if (apple_pmp_display_retained_board())
-		return -EBUSY;
+	/*
+	 * Retained power votes have no teardown of their own: only a consumer
+	 * that released its vote lets the PMP stop, and no vote is taken until
+	 * resume. Without such a consumer this refuses (-EBUSY), as before.
+	 */
+	retained = apple_pmp_display_retained_board();
+	if (retained) {
+		ret = apple_pmp_display_sleep();
+		if (ret)
+			return ret;
+	}
 
 	guard(mutex)(&pmp_lock);
-	if (pmp_device != dev || pmp_asleep)
+	if (pmp_device != dev || pmp_asleep) {
+		/* Not stopped here; one still stopped from a refused sleep stays closed. */
+		if (retained && !pmp_asleep)
+			apple_pmp_display_wake();
 		return 0;
+	}
 	at_commit = apple_pmp_commit_available(dev);
 	apple_pmp_report_sleep(dev, at_commit);
 	ret = at_commit ? apple_pmp_commit_prepare(dev) : apple_pmp_sleep(pmp_data);
 	if (ret) {
 		apple_pmp_report_wake(dev, false);
+		apple_pmp_display_wake();
 		return dev_err_probe(dev, ret, "firmware did not go idle for sleep\n");
 	}
 	pmp_asleep = true;
@@ -236,6 +249,7 @@ static int apple_pmp_resume_early(struct device *dev)
 		if (!pm_resume_via_firmware() && !stopped) {
 			pmp_asleep = false;
 			apple_pmp_report_wake(dev, true);
+			apple_pmp_display_wake();
 			dev_info(dev, "sleep refused before the commit: firmware never stopped\n");
 			return 0;
 		}
@@ -253,6 +267,8 @@ static int apple_pmp_resume_early(struct device *dev)
 		dev_dbg(dev, "firmware back from sleep\n");
 	/* Requests go back either way: consumers read them from the report too. */
 	apple_pmp_report_wake(dev, true);
+	/* Votes too: a get that fails since the firmware is gone fails the consumer. */
+	apple_pmp_display_wake();
 
 	return 0;
 }
diff --git a/include/linux/soc/apple/pmp-display.h b/include/linux/soc/apple/pmp-display.h
index 663e7118d7..888fe75a6d 100644
--- a/include/linux/soc/apple/pmp-display.h
+++ b/include/linux/soc/apple/pmp-display.h
@@ -59,4 +59,16 @@ int apple_pmp_j713_gpu_prepare(struct device *consumer);
 int apple_pmp_j713_gpu_get(struct device *consumer);
 int apple_pmp_j713_gpu_check(struct device *consumer);
 
+/*
+ * A system sleep that stops the PMP (pmp-export.c) needs every retained vote
+ * released first. The DISP consumer says, once after prepare, that it powers
+ * the display down and puts its vote in its suspend, and gets it again in its
+ * resume (display_sleep_enable); without that, such a sleep is refused.
+ * The AGX vote has no release, so a held AGX vote refuses it too.
+ */
+int apple_pmp_j713_display_sleep_enable(struct device *consumer);
+/* Internal: the PMP owner, around its own stop and restart. */
+int apple_pmp_display_sleep(void);
+void apple_pmp_display_wake(void);
+
 #endif
diff --git a/tools/asahi/display26-tests.py b/tools/asahi/display26-tests.py
index c43323f0d8..3fa48f871d 100644
--- a/tools/asahi/display26-tests.py
+++ b/tools/asahi/display26-tests.py
@@ -114,7 +114,8 @@ int main(void) {
               '\t\t\t\t\t      int (*f)(void *), void *x) { assert(!"no system sleep here"); return -EIO; }\n'
               'static inline void apple_sleep_coproc_set_ready(struct device *d, bool r) { assert(!"no system sleep here"); }\n'
               'static inline bool apple_sleep_coproc_stopped(struct device *d) { assert(!"no system sleep here"); return false; }\n')
-        write(tmp, 'linux/soc/apple/pmp-display.h', '#include <stdbool.h>\nbool apple_pmp_display_retained_board(void);\n')
+        write(tmp, 'linux/soc/apple/pmp-display.h', '#include <stdbool.h>\nbool apple_pmp_display_retained_board(void);\n'
+              'int apple_pmp_display_sleep(void);\nvoid apple_pmp_display_wake(void);\n')
         write(tmp, 'mock.h', '''#pragma once
 #include <assert.h>
 #include <stdbool.h>
@@ -162,6 +163,8 @@ int apple_pmp_send_power_command(const void*data,u8 command,u16 id,u32 enabled){
 int apple_pmp_report_check_t6030_gfx(struct device*d){assert(!"unexpected T6030 report on J613");return -EIO;}
 int apple_pmp_report_set_t6030_gfx(struct device*d,bool enabled){assert(!"unexpected T6030 report on J613");return -EIO;}
 bool apple_pmp_display_retained_board(void){return false;}
+int apple_pmp_display_sleep(void){assert(!"no system sleep here");return -EIO;}
+void apple_pmp_display_wake(void){assert(!"no system sleep here");}
 void apple_pmp_report_sleep(struct device*d,bool at_commit){assert(!"no system sleep here");}
 void apple_pmp_report_wake(struct device*d,bool real){assert(!"no system sleep here");}
 int apple_pmp_sleep(const void*data){assert(!"no system sleep here");return -EIO;}
