From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 12:27:30 +0000
Subject: [PATCH] drm/apple: av: give the KUnit lifetime endpoints an
 orphan wait queue

afk_cancel_commands() now ends in wake_up_all(&ep->compact_orphan_wq),
which afk_init() initializes for every real endpoint. The
apple-av-audio-lifetime fixtures build their endpoint with kzalloc and
were taught compact_cmds but not compact_orphan_wq, so the first case
whose cleanup quiesces the endpoint (av_lifetime_devres_order) walks a
zeroed list head in __wake_up() and oopses at 0xfffffffffffffff8. The
oops ends the KUnit run: no later suite runs.

Initialize the fake endpoint in one helper, the way afk_init() does,
and add a case: releasing the audio service wakes a waiter on the
endpoint's orphan queue.

The driver itself is unaffected: every endpoint it quiesces comes from
afk_init() (an ERR_PTR one is skipped by afk_quiesce()).

Fixes: d6d84d5ad56d ("drm/apple: route DisplayPort tunnels through the J713 external DCPs")
Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/av-lifetime-test.c | 53 ++++++++++++++++++++++--
 1 file changed, 49 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/apple/av-lifetime-test.c b/drivers/gpu/drm/apple/av-lifetime-test.c
index f75be1a5bb..86c802c765 100644
--- a/drivers/gpu/drm/apple/av-lifetime-test.c
+++ b/drivers/gpu/drm/apple/av-lifetime-test.c
@@ -46,6 +46,18 @@ struct av_life_test {
 static struct av_life_test *av_life_current;
 static void av_life_release_group(struct av_life_test *t);
 
+/*
+ * A fake endpoint gets what afk_init() gives a real one before anything can
+ * quiesce it: afk_quiesce() -> afk_cancel_commands() walks compact_cmds and
+ * wakes compact_orphan_wq.
+ */
+static void av_life_init_ep(struct apple_dcp_afkep *ep)
+{
+	spin_lock_init(&ep->lock);
+	INIT_LIST_HEAD(&ep->compact_cmds);
+	init_waitqueue_head(&ep->compact_orphan_wq);
+}
+
 static void av_life_owner_fn(struct work_struct *work)
 {
 	struct av_life_test *t = av_life_current;
@@ -154,8 +166,7 @@ static struct av_life_test *av_life_setup(struct kunit *test, work_func_t owner_
 	KUNIT_ASSERT_NOT_NULL(test, t->ep);
 	t->dcp->dev = t->dev;
 	dev_set_drvdata(t->dev, t->dcp);
-	spin_lock_init(&t->ep->lock);
-	INIT_LIST_HEAD(&t->ep->compact_cmds);
+	av_life_init_ep(t->ep);
 	init_rwsem(&t->asrv->srv_rwsem);
 #if IS_ENABLED(CONFIG_DRM_APPLE_DCP_T6030_AUDIO)
 	init_waitqueue_head(&t->asrv->gen_wq);
@@ -487,8 +498,7 @@ static struct av_life_test *av_life_group_setup(struct kunit *test,
 	if (endpoint > 0) {
 		t->ep = devm_kzalloc(t->dev, sizeof(*t->ep), GFP_KERNEL);
 		KUNIT_ASSERT_NOT_NULL(test, t->ep);
-		spin_lock_init(&t->ep->lock);
-		INIT_LIST_HEAD(&t->ep->compact_cmds);
+		av_life_init_ep(t->ep);
 		t->ep->dcp = t->dcp;
 		t->wq = alloc_ordered_workqueue("av-lifetime-devres", 0);
 		KUNIT_ASSERT_NOT_ERR_OR_NULL(test, t->wq);
@@ -525,6 +535,40 @@ static void av_lifetime_devres_order(struct kunit *test)
 		av_audiosrv_quiesce(t->dcp);
 }
 
+struct av_life_orphan_waiter {
+	struct wait_queue_entry wq;
+	bool woken;
+};
+
+static int av_life_orphan_wake(struct wait_queue_entry *wq, unsigned int mode,
+			       int sync, void *key)
+{
+	struct av_life_orphan_waiter *w =
+		container_of(wq, struct av_life_orphan_waiter, wq);
+
+	w->woken = true;
+	/* Off the endpoint's queue before the group frees the endpoint. */
+	list_del_init(&wq->entry);
+	return 1;
+}
+
+/* Releasing the audio service wakes whoever waits for late compact replies. */
+static void av_lifetime_quiesce_wakes_orphan_waiters(struct kunit *test)
+{
+	struct av_life_test *t = av_life_group_setup(test, av_life_owner_fn, 1);
+	struct av_life_orphan_waiter w = { };
+
+	init_waitqueue_func_entry(&w.wq, av_life_orphan_wake);
+	add_wait_queue(&t->ep->compact_orphan_wq, &w.wq);
+	KUNIT_ASSERT_EQ(test, av_audiosrv_register_cleanup(t->dcp, t->asrv, t->ep), 0);
+	devres_close_group(t->dev, t->group);
+	av_life_release_group(t);
+	KUNIT_EXPECT_TRUE(test, t->endpoint_released);
+	KUNIT_EXPECT_TRUE(test, t->release_saw_quiesced);
+	KUNIT_EXPECT_TRUE(test, w.woken);
+	KUNIT_EXPECT_TRUE(test, list_empty(&w.wq.entry));
+}
+
 static void av_lifetime_devres_null_endpoint(struct kunit *test)
 {
 	struct av_life_test *t = av_life_group_setup(test, av_life_owner_fn, 0);
@@ -670,6 +714,7 @@ static struct kunit_case av_lifetime_cases[] = {
 	KUNIT_CASE(av_lifetime_devres_fresh_rebind),
 	KUNIT_CASE(av_lifetime_producer_rebind_balance),
 	KUNIT_CASE(av_lifetime_devres_order),
+	KUNIT_CASE(av_lifetime_quiesce_wakes_orphan_waiters),
 	KUNIT_CASE(av_lifetime_devres_null_endpoint),
 	KUNIT_CASE(av_lifetime_devres_error_endpoint),
 	KUNIT_CASE(av_lifetime_add_action_reset),
