From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Sat, 7 Nov 2026 15:45:40 +1100
Subject: [PATCH] ASoC: tas2764: Write back only the registers the driver
 writes

A regmap debugfs dump of a TAS2764/SN012776 ("registers") reads every
register of every page and leaves all of them in the cache. The next
system sleep marks the cache dirty, and the resume's regcache_sync()
then writes back everything cached as raw blocks of contiguous
registers: from the page 1 quirk register at 0xb3 through the page 6
quirk registers at 0x313, across pages the amp reserves. The amp never
completes that transfer, the I2C controller stays in its transaction
(SMSTA 0x10850140) and every amp on the bus is gone until the next
boot:

  i2c-apple 23501c000.i2c: Timeout, status 0x10850140
  tas2764 3-003c: Unable to sync registers 0xb3-0x313. -62
  i2c-apple 23501c000.i2c: Bus is still stuck (status 0x10850140 ...)

A speaker wiring self-check that reads the amps' registers through
debugfs does exactly that dump, so the first sleep after such a check
broke the speakers on the J413 (M2), J316 (M1 Pro) and J616s alike.
The controller reset of commit 1dcabeda5f43 ("i2c: pasemi: Reset a
controller that stays stuck in a transaction") recovers the bus, but
the write that stuck it is the bug.

Give the regmap a writeable_reg: page 0, the page 1 and page 6
registers of the quirk sequences and the SDOUT high-impedance masks,
and TI's quirk pages. regcache_sync() skips registers that are not
writeable, so a cache sync writes back only what the driver wrote.
Every register the driver and its quirk sequences write stays
writeable, which KUnit checks.

Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Assisted-by: LLM
(cherry picked from commit c879124a7c847230518c0e8e3a71d38b27c7e38d)
---
 sound/soc/codecs/tas2764-bop-test.h | 48 +++++++++++++++++++++++++++++
 sound/soc/codecs/tas2764.c          | 27 ++++++++++++++++
 2 files changed, 75 insertions(+)

diff --git a/sound/soc/codecs/tas2764-bop-test.h b/sound/soc/codecs/tas2764-bop-test.h
index 4c114601b3..1ccd60c104 100644
--- a/sound/soc/codecs/tas2764-bop-test.h
+++ b/sound/soc/codecs/tas2764-bop-test.h
@@ -199,6 +199,52 @@ static void tas2764_tx_zd(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, tas2764->have_tx_zd);
 }
 
+/* Every register the driver or its quirk sequences write is writeable */
+static void tas2764_writeable_covers_every_write(struct kunit *test)
+{
+	unsigned int i, j, reg;
+
+	for (i = 0; i < ARRAY_SIZE(tas2764_quirk_init_sequences); i++) {
+		const struct tas2764_quirk_init_sequence *q = &tas2764_quirk_init_sequences[i];
+
+		for (j = 0; q->seq && j < q->len; j++) {
+			reg = q->seq[j].reg;
+			KUNIT_EXPECT_TRUE_MSG(test, tas2764_writeable_register(NULL, reg),
+					      "quirk %u reg 0x%x", i, reg);
+		}
+	}
+	for (i = 0; i < ARRAY_SIZE(tas2764_pre_shutdown_seq); i++) {
+		reg = tas2764_pre_shutdown_seq[i].reg;
+		KUNIT_EXPECT_TRUE(test, tas2764_writeable_register(NULL, reg));
+	}
+	for (i = 0; i < ARRAY_SIZE(tas2764_post_shutdown_seq); i++) {
+		reg = tas2764_post_shutdown_seq[i].reg;
+		KUNIT_EXPECT_TRUE(test, tas2764_writeable_register(NULL, reg));
+	}
+	for (i = 0; i < TAS2764_BOP_CFG_LEN; i++)
+		KUNIT_EXPECT_TRUE(test, tas2764_writeable_register(NULL, TAS2764_BOP_CFG0 + i));
+	KUNIT_EXPECT_TRUE(test, tas2764_writeable_register(NULL, TAS2764_PAGE));
+	KUNIT_EXPECT_TRUE(test, tas2764_writeable_register(NULL, TAS2764_PWR_CTRL));
+	KUNIT_EXPECT_TRUE(test, tas2764_writeable_register(NULL, TAS2764_DVC));
+	KUNIT_EXPECT_TRUE(test, tas2764_writeable_register(NULL, TAS2764_SDOUT_HIZ_9));
+}
+
+/*
+ * What only a debugfs dump caches is never written back: the reserved pages
+ * between the page-1 quirk registers and the page-6 ones (the 0xb3..0x313 raw
+ * block that stuck the speaker buses at resume), and the rest of pages 1 and 6.
+ */
+static void tas2764_sync_skips_read_only_cache(struct kunit *test)
+{
+	KUNIT_EXPECT_FALSE(test, tas2764_writeable_register(NULL, TAS2764_REG(0x1, 0x34)));
+	KUNIT_EXPECT_FALSE(test, tas2764_writeable_register(NULL, TAS2764_REG(0x1, 0x7f)));
+	KUNIT_EXPECT_FALSE(test, tas2764_writeable_register(NULL, TAS2764_REG(0x2, 0x00)));
+	KUNIT_EXPECT_FALSE(test, tas2764_writeable_register(NULL, TAS2764_REG(0x4, 0x40)));
+	KUNIT_EXPECT_FALSE(test, tas2764_writeable_register(NULL, TAS2764_REG(0x6, 0x13)));
+	KUNIT_EXPECT_FALSE(test, tas2764_writeable_register(NULL, TAS2764_REG(0x6, 0x20)));
+	KUNIT_EXPECT_FALSE(test, tas2764_writeable_register(NULL, TAS2764_REG(0x10, 0x00)));
+}
+
 static struct kunit_case tas2764_bop_test_cases[] = {
 	KUNIT_CASE(tas2764_bop_from_dt),
 	KUNIT_CASE(tas2764_bop_absent),
@@ -209,6 +255,8 @@ static struct kunit_case tas2764_bop_test_cases[] = {
 	KUNIT_CASE(tas2764_dcb_short),
 	KUNIT_CASE(tas2764_dcb_not_sn012776),
 	KUNIT_CASE(tas2764_tx_zd),
+	KUNIT_CASE(tas2764_writeable_covers_every_write),
+	KUNIT_CASE(tas2764_sync_skips_read_only_cache),
 	{}
 };
 
diff --git a/sound/soc/codecs/tas2764.c b/sound/soc/codecs/tas2764.c
index e8e2efc4e3..2bb4641979 100644
--- a/sound/soc/codecs/tas2764.c
+++ b/sound/soc/codecs/tas2764.c
@@ -1291,9 +1291,36 @@ static bool tas2764_volatile_register(struct device *dev, unsigned int reg)
 	}
 }
 
+/*
+ * The registers the driver writes: page 0, the page 1 and page 6 registers of
+ * the quirk sequences and the SDOUT high-impedance masks, and TI's quirk pages
+ * (volatile). A cache sync after a resume writes back only these. Anything
+ * else in the cache got there through a read alone, such as a regmap debugfs
+ * dump of every page, and some of those registers are reserved: a raw block
+ * written over them at resume is never completed by the amp and leaves the
+ * I2C controller stuck in its transaction, taking every amp on the bus with
+ * it.
+ */
+static bool tas2764_writeable_register(struct device *dev, unsigned int reg)
+{
+	switch (reg) {
+	case TAS2764_REG(0x0, 0x00) ... TAS2764_REG(0x0, 0x7f):
+	case TAS2764_REG(0x1, 0x33):
+	case TAS2764_REG(0x1, 0x37):
+	case TAS2764_SDOUT_HIZ_1 ... TAS2764_SDOUT_HIZ_9:
+	case TAS2764_REG(0x1, 0x47):
+	case TAS2764_REG(0x6, 0x14) ... TAS2764_REG(0x6, 0x1f):
+	case TAS2764_REG(0xf0, 0x0) ... TAS2764_REG(0xff, 0x7f):
+		return true;
+	default:
+		return false;
+	}
+}
+
 static const struct regmap_config tas2764_i2c_regmap = {
 	.reg_bits = 8,
 	.val_bits = 8,
+	.writeable_reg = tas2764_writeable_register,
 	.volatile_reg = tas2764_volatile_register,
 	.reg_defaults = tas2764_reg_defaults,
 	.num_reg_defaults = ARRAY_SIZE(tas2764_reg_defaults),
