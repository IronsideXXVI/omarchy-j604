From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 10:17:43 +0000
Subject: [PATCH] cpufreq: apple-soc: Optionally set schedutil's
 starting values

On the M4 MacBook Pro the kernel work that feeds the GPU wakes about
every 70 us for a few us at a time. schedutil sees almost no demand
from it, so the cluster it lands on stays at its slowest clock.

Add sugov_rate_limit_us and sugov_down_hold_us. They set the policy's
transition delay and down hold that schedutil starts each cluster
with. Both default to -1, which keeps the kernel's own values.

Assisted-by: LLM
---
 drivers/cpufreq/apple-soc-cpufreq.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/cpufreq/apple-soc-cpufreq.c b/drivers/cpufreq/apple-soc-cpufreq.c
index 36e6d50df6..5c945af754 100644
--- a/drivers/cpufreq/apple-soc-cpufreq.c
+++ b/drivers/cpufreq/apple-soc-cpufreq.c
@@ -572,6 +572,20 @@ static bool idle_drop_wait = true;
 module_param(idle_drop_wait, bool, 0644);
 MODULE_PARM_DESC(idle_drop_wait, "T8132: when the cluster is still changing state as its last CPU goes idle, wait for the transition (at most 100 us) and drop the cluster, instead of leaving it at its state for that idle (default: on)");
 
+/*
+ * Starting values for schedutil on every cluster, read when a policy is
+ * created (boot, or the driver's probe). They only change where schedutil
+ * starts; its sysfs tunables still work. -1, the default, keeps the
+ * kernel's own values (rate limit from the transition latency, no hold).
+ */
+static int sugov_rate_limit_us = -1;
+module_param(sugov_rate_limit_us, int, 0444);
+MODULE_PARM_DESC(sugov_rate_limit_us, "schedutil rate_limit_us to start every cluster with (-1 = the kernel's, default)");
+
+static int sugov_down_hold_us = -1;
+module_param(sugov_down_hold_us, int, 0444);
+MODULE_PARM_DESC(sugov_down_hold_us, "schedutil down_hold_us to start every cluster with (-1 = none, default)");
+
 static DEFINE_PER_CPU(struct apple_cpu_priv *, apple_idle_priv);
 
 /* The policy of @cpu if its cluster takes part in the idle drop, or NULL. */
@@ -1722,6 +1736,10 @@ static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
 	policy->dvfs_possible_from_any_cpu = true;
 	policy->fast_switch_possible = !info->verify_transition || info->lazy_verify;
 	policy->suspend_freq = freq_table[0].frequency;
+	if (sugov_rate_limit_us >= 0)
+		policy->transition_delay_us = max(sugov_rate_limit_us, 1);
+	if (sugov_down_hold_us >= 0)
+		policy->down_hold_us = sugov_down_hold_us;
 
 	return 0;
 
