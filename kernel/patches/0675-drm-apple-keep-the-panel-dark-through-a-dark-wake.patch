From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:09:38 -0500
Subject: [PATCH] drm/apple: keep the panel dark through a dark wake

macOS keeps the display off in a dark wake. In the 25G83 kernel, read
statically, the DCP family reads the root domain's AppleClamshellState
and sends it to the DCP as A476 (set_dcp_clamshell_state), and the
DisplayPort family has its own dark wake state. The panel is powered,
as far as the code shows, only when WindowServer asks for it, in a full
wake.

In a dark wake the internal T8140 DCP now resumes as after DPMS off
before the sleep: its firmware stays stopped, and the next CRTC enable
brings it and the panel back through dcp_dpms_power_on(). The suspend
that follows takes the firmware-down path that already exists.

DCPEXT stays down the same way, its crossbar output parked and its
Type-C work off, so a monitor on the USB-C port isn't driven up for a
moment at every dark wake. The next resume that isn't dark restarts it
as after any real sleep. If the next suspend fails before suspending it,
->complete() starts it, or a PM notifier does when the failure came
before ->prepare(); the real sleep reset its CPU, so it starts as after
a power cycle.

apple-drm keeps its saved state and commits nothing, since user space
stays frozen. Its next suspend leaves that state alone, so the real wake
restores what was there before the first sleep. If that suspend fails,
->complete() restores the outputs, or a PM notifier does when the
failure came before ->prepare() reached this device.

Signed-off-by: Diljit Singh <hey@djdev.me>

[j604 backport: resolved against Aurora code this branch does not carry (T6041 takeover abort, t8132_ext_drm_fini, dcp_desktop_probe_routes/dcp_t8132_ext_routes): only this commit's own lines kept. pm_dark_wake() is set only by apple_sleep_lid_closed_wake() after an apple-s2r sleep (apple-sleep.c l.694-702, armed only from apple-s2r ->enter) and cleared per suspend (kernel/power/suspend.c l.611): under s2idle the resume reduces to the old body. Aurora's message cites a static read of a macOS kernel; no Apple code was read for this port]
Assisted-by: Claude:claude-opus-5.5

---
 drivers/gpu/drm/apple/apple_drv.c    |  77 ++++++++++++++++---
 drivers/gpu/drm/apple/dcp-internal.h |   4 +
 drivers/gpu/drm/apple/dcp.c          | 107 +++++++++++++++++++++++----
 3 files changed, 163 insertions(+), 25 deletions(-)

diff --git a/drivers/gpu/drm/apple/apple_drv.c b/drivers/gpu/drm/apple/apple_drv.c
index fb19eed21b..be4caf445e 100644
--- a/drivers/gpu/drm/apple/apple_drv.c
+++ b/drivers/gpu/drm/apple/apple_drv.c
@@ -44,6 +44,7 @@
 #include <drm/drm_vblank.h>
 #include <drm/drm_fixed.h>
 #include <linux/pm.h>
+#include <linux/suspend.h>
 
 #include "apple_boot_display.h"
 #include "apple_resume.h"
@@ -66,8 +67,13 @@ struct apple_drm_private {
 	bool aborted;
 	/* This suspend found every firmware already stopped. */
 	bool s2r_skipped;
+	/* A dark wake left the outputs as the suspend did, for the next resume. */
+	bool dark_held;
+	struct notifier_block pm_nb;
 };
 
+static int apple_drm_pm_notify(struct notifier_block *nb, unsigned long action, void *data);
+
 /* Component readiness is later than platform probe/bind. */
 static DEFINE_MUTEX(apple_g15_display_lock);
 static struct device *apple_t6030_display;
@@ -1558,6 +1564,9 @@ static int apple_drm_init(struct device *dev)
 		goto err_unbind;
 	}
 
+	apple->pm_nb.notifier_call = apple_drm_pm_notify;
+	register_pm_notifier(&apple->pm_nb);
+
 	return 0;
 
 err_unlock:
@@ -1581,6 +1590,8 @@ static void apple_drm_uninit(struct device *dev)
 	if (apple->aborted)
 		return;
 
+	unregister_pm_notifier(&apple->pm_nb);
+
 	/* Before anything of the DRM device is torn down. */
 	t8132_ext_drm_fini(&apple->drm);
 	apple_drm_quiesce_connectors(&apple->drm);
@@ -1721,6 +1732,10 @@ static int apple_platform_suspend(struct device *dev)
 {
 	struct apple_drm_private *apple = dev_get_drvdata(dev);
 
+	/* Still suspended from before a dark wake. */
+	if (apple && apple->dark_held)
+		return 0;
+
 	if (apple && !apple->aborted) {
 		apple->s2r_skipped = apple_drm_firmware_stopped(apple);
 		if (!apple->s2r_skipped)
@@ -1747,29 +1762,71 @@ static bool apple_drm_hold_resume_events(struct apple_drm_private *apple, u32 cr
 	return held;
 }
 
+static void apple_drm_resume_outputs(struct apple_drm_private *apple)
+{
+	u32 dropped = 0;
+
+	apple->dark_held = false;
+	if (apple->drm.mode_config.suspend_state)
+		dropped = apple_drm_drop_stale_crtcs(apple->drm.mode_config.suspend_state);
+	/* Have userspace set the mode of a CRTC resumed disabled again. */
+	if (dropped && apple_drm_hold_resume_events(apple, dropped))
+		dropped = 0;
+	drm_mode_config_helper_resume(&apple->drm);
+	if (dropped)
+		drm_kms_helper_hotplug_event(&apple->drm);
+}
+
 static int apple_platform_resume(struct device *dev)
 {
 	struct apple_drm_private *apple = dev_get_drvdata(dev);
-	u32 dropped = 0;
 
-	if (apple && !apple->aborted && !apple->s2r_skipped) {
-		if (apple->drm.mode_config.suspend_state)
-			dropped = apple_drm_drop_stale_crtcs(apple->drm.mode_config.suspend_state);
-		/* Have userspace set the mode of a CRTC resumed disabled again. */
-		if (dropped && apple_drm_hold_resume_events(apple, dropped))
-			dropped = 0;
-		drm_mode_config_helper_resume(&apple->drm);
-		if (dropped)
-			drm_kms_helper_hotplug_event(&apple->drm);
+	if (!apple || apple->aborted || apple->s2r_skipped)
+		return 0;
+
+	/* A dark wake goes back to sleep with user space frozen: nothing is lit for it. */
+	if (pm_dark_wake()) {
+		apple->dark_held = true;
+		dev_info(dev, "dark wake: outputs stay off\n");
+		return 0;
 	}
 
+	apple_drm_resume_outputs(apple);
 	return 0;
 }
 
+/* The suspend after a dark wake failed before it suspended this device. */
+static void apple_platform_complete(struct device *dev)
+{
+	struct apple_drm_private *apple = dev_get_drvdata(dev);
+
+	if (apple && apple->dark_held && !pm_dark_wake())
+		apple_drm_resume_outputs(apple);
+}
+
+/* It failed before ->prepare() reached this device, so ->complete() didn't run either. */
+static int apple_drm_pm_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+	struct apple_drm_private *apple = container_of(nb, struct apple_drm_private, pm_nb);
+
+	if (action == PM_POST_SUSPEND && apple->dark_held) {
+		dev_warn(apple->drm.dev, "dark wake over without a resume: outputs back now\n");
+		apple_drm_resume_outputs(apple);
+	}
+
+	return NOTIFY_DONE;
+}
+
 static const struct dev_pm_ops apple_platform_pm_ops = {
 	.suspend	= apple_platform_suspend,
 	.resume		= apple_platform_resume,
+	.complete	= apple_platform_complete,
 };
+#else
+static int apple_drm_pm_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+	return NOTIFY_DONE;
+}
 #endif
 
 static struct platform_driver apple_platform_driver = {
diff --git a/drivers/gpu/drm/apple/dcp-internal.h b/drivers/gpu/drm/apple/dcp-internal.h
index c94e42a723..3ef45cc669 100644
--- a/drivers/gpu/drm/apple/dcp-internal.h
+++ b/drivers/gpu/drm/apple/dcp-internal.h
@@ -11,6 +11,7 @@
 #include <linux/ioport.h>
 #include <linux/list.h>
 #include <linux/mutex.h>
+#include <linux/notifier.h>
 #include <linux/spinlock.h>
 #include <linux/mux/consumer.h>
 #include <linux/phy/phy.h>
@@ -645,6 +646,9 @@ struct apple_dcp {
 	struct delayed_work secure_poll_wq;
 	/* Stopped and not restarted, which outlives a suspend that gets refused. */
 	bool s2r_fw_down;
+	/* DCPEXT kept down through a dark wake, see dcp_s2r_dark_finish(). */
+	bool s2r_dark_held;
+	struct notifier_block s2r_pm_nb;
 	/* This driver raised the display domains, and nothing has lowered them since. */
 	bool s2r_domains_up;
 	/* Counted in pmc-dcp, the number of powered DCPs */
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 466eb4011d..459c6d6e91 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -6304,6 +6304,8 @@ static void dcp_t8132_ext_routes(struct apple_dcp *dcp)
 		 dcp->nr_typec_routes);
 }
 
+static int dcp_s2r_pm_register(struct apple_dcp *dcp);
+
 static int dcp_platform_probe_pipe(struct platform_device *pdev)
 {
 	const struct apple_dcp_hw_data *hw = of_device_get_match_data(&pdev->dev);
@@ -6483,6 +6485,9 @@ static int dcp_platform_probe_pipe(struct platform_device *pdev)
 	}
 
 	platform_set_drvdata(pdev, dcp);
+	ret = dcp_s2r_pm_register(dcp);
+	if (ret)
+		return ret;
 
 	if (iomfb_is_m4(dcp)) {
 		dcp->fixed_connector_type = DRM_MODE_CONNECTOR_eDP;
@@ -7171,10 +7176,13 @@ static int dcp_platform_prepare(struct device *dev)
 	return 0;
 }
 
+static void dcp_s2r_dark_finish(struct apple_dcp *dcp);
+
 static void dcp_platform_complete(struct device *dev)
 {
 	struct apple_dcp *dcp = dev_get_drvdata(dev);
 
+	dcp_s2r_dark_finish(dcp);
 	if (!dcp->external)
 		return;
 	mutex_lock(&dcp->hpd_mutex);
@@ -8062,6 +8070,27 @@ static int dcp_s2r_refused_domains_off(struct apple_dcp *dcp)
 	return ret ?: dcp_s2r_domains_off(dcp);
 }
 
+static void dcp_s2r_restart_done(struct apple_dcp *dcp, int ret)
+{
+	bool ext = dcp_s2r_ext_capable(dcp);
+
+	dcp_s2r_put_darts(dcp);
+	/* An attached display's crossbar output; its link reconnects from the Type-C work. */
+	if (ext)
+		dcp_typec_route_unpark(dcp);
+	if (ret) {
+		WRITE_ONCE(dcp->crashed, true);
+		dev_warn(dcp->dev, "firmware stopped for sleep, display stays off until reboot\n");
+		return;
+	}
+	/* Back from a full restart, even after a failed start had marked it crashed. */
+	WRITE_ONCE(dcp->crashed, false);
+	WRITE_ONCE(dcp->s2r_fw_down, false);
+	iomfb_pause_presentation(dcp, false);
+	if (ext && !READ_ONCE(dcp->typec_work_enabled))
+		dcp_enable_typec_work(dcp);
+}
+
 /*
  * If the display doesn't come back, the panel stays dark until reboot, and the driver
  * must not talk to the stopped firmware, so treat it as a crashed DCP. Nothing else in
@@ -8091,21 +8120,7 @@ static int dcp_s2r_restart(struct apple_dcp *dcp, bool real)
 		else if (ret)
 			dev_err(dcp->dev, "warm restart failed: %d\n", ret);
 	}
-	dcp_s2r_put_darts(dcp);
-	/* An attached display's crossbar output; its link reconnects from the Type-C work. */
-	if (dcp_s2r_ext_capable(dcp))
-		dcp_typec_route_unpark(dcp);
-	if (ret) {
-		WRITE_ONCE(dcp->crashed, true);
-		dev_warn(dcp->dev, "firmware stopped for sleep, display stays off until reboot\n");
-	} else {
-		/* Back from a full restart, even after a failed start had marked it crashed. */
-		WRITE_ONCE(dcp->crashed, false);
-		WRITE_ONCE(dcp->s2r_fw_down, false);
-		iomfb_pause_presentation(dcp, false);
-		if (dcp_s2r_ext_capable(dcp) && !READ_ONCE(dcp->typec_work_enabled))
-			dcp_enable_typec_work(dcp);
-	}
+	dcp_s2r_restart_done(dcp, ret);
 
 	return ret;
 }
@@ -8118,6 +8133,18 @@ static int dcp_s2r_resume(struct apple_dcp *dcp)
 	/* A real sleep took the domains' power. */
 	if (real)
 		dcp->s2r_domains_up = false;
+	/* A dark wake sleeps again with the panel never lit, as if DPMS had turned it off. */
+	if (pm_dark_wake() && dcp_s2r_capable(dcp) && !dcp->dpms_powered_off) {
+		dcp->dpms_powered_off = true;
+		dev_info(dcp->dev, "dark wake: firmware and panel stay off\n");
+	}
+	/* DCPEXT too, its crossbar output parked: dcp_s2r_dark_finish() if no resume follows. */
+	if (pm_dark_wake() && dcp_s2r_ext_capable(dcp)) {
+		dcp->s2r_dark_held = true;
+		dev_info(dcp->dev, "dark wake: firmware and output stay off\n");
+		return 0;
+	}
+	dcp->s2r_dark_held = false;
 	/* Off by DPMS before the sleep: it stays off until DPMS on brings it back. */
 	if (dcp->dpms_powered_off) {
 		/* Off after a refused idle, its power may be on: DPMS on needs it lowered. */
@@ -8131,6 +8158,56 @@ static int dcp_s2r_resume(struct apple_dcp *dcp)
 	return 0;
 }
 
+/*
+ * The suspend after a dark wake failed before suspending DCPEXT, or before preparing it. It's
+ * still down from the real sleep, whose wake reset its CPU: start it as after one.
+ */
+static void dcp_s2r_dark_finish(struct apple_dcp *dcp)
+{
+	int ret;
+
+	if (!dcp->s2r_dark_held || pm_dark_wake() || IS_ERR_OR_NULL(dcp->rtk))
+		return;
+	dcp->s2r_dark_held = false;
+	dcp->s2r_stopped = false;
+	dcp_s2r_find_darts(dcp);
+	ret = dcp_s2r_ext_start(dcp, true);
+	dev_info(dcp->dev, "dark wake over without a resume: firmware %s: %d\n",
+		 ret ? "not back" : "back", ret);
+	dcp_s2r_restart_done(dcp, ret);
+}
+
+static int dcp_s2r_pm_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+	struct apple_dcp *dcp = container_of(nb, struct apple_dcp, s2r_pm_nb);
+
+	if (action == PM_POST_SUSPEND)
+		dcp_s2r_dark_finish(dcp);
+
+	return NOTIFY_DONE;
+}
+
+static void dcp_s2r_pm_unregister(void *data)
+{
+	struct apple_dcp *dcp = data;
+
+	unregister_pm_notifier(&dcp->s2r_pm_nb);
+}
+
+static int dcp_s2r_pm_register(struct apple_dcp *dcp)
+{
+	int ret;
+
+	if (!dcp_s2r_ext_capable(dcp))
+		return 0;
+	dcp->s2r_pm_nb.notifier_call = dcp_s2r_pm_notify;
+	ret = register_pm_notifier(&dcp->s2r_pm_nb);
+	if (ret)
+		return ret;
+
+	return devm_add_action_or_reset(dcp->dev, dcp_s2r_pm_unregister, dcp);
+}
+
 /*
  * Its own suspend failed with the CPU stopped, and the PM core won't call .resume: start it
  * again as a refused sleep does, or the display stays dark until a later sleep gets through.
