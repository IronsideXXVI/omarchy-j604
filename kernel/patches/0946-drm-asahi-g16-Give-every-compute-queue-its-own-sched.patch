+/// One object of a firmware compute queue, in the order [`queue_set`] allocates them (the
+/// first compute queue's order, so one queue keeps its layout).
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Obj {
+    /// Queue info. The queue image names its own +0xb0 as the scratch at +0x18 (macOS 26B123
+    /// names its own +0x80) and keeps the ring cursors at +0x20, +0x24 and +0x28.
+    QInfo,
+    /// Queue state block, queue image +0x00.
+    QState,
+    /// Work ring, queue image +0x08.
+    Ring,
+    /// Engine-stage stamp cell written by the host.
+    UserStamp,
+    /// Engine-stage stamp cell written by the firmware.
+    FwStamp,
+    /// Scheduling context, queue image +0xa4 (macOS 26B123 +0xa8).
+    SchedCtx,
+    /// Notifier page.
+    Notifier,
+    /// Notifier threshold cell.
+    Threshold,
+    /// Job list, queue image +0x10.
+    JobList,
+}
+
+/// The objects of one firmware compute queue, as handles of any allocator.
+pub(crate) struct QueueSet<T> {
+    pub(crate) qinfo: T,
+    pub(crate) qstate: T,
+    pub(crate) ring: T,
+    pub(crate) user_stamp: T,
+    pub(crate) fw_stamp: T,
+    pub(crate) sched_ctx: T,
+    pub(crate) notifier: T,
+    pub(crate) threshold: T,
+    pub(crate) job_list: T,
+}
+
+/// Allocates one firmware compute queue's objects in [`Obj`] order. Every compute queue is
+/// made by this, each object its own: macOS gives each compute queue its own queue info, state
+/// block, ring, scratch, cursors and scheduling context, and its compute queues share only the
+/// compute channel.
+pub(crate) fn queue_set<T, E>(
+    mut alloc: impl FnMut(Obj) -> Result<T, E>,
+) -> Result<QueueSet<T>, E> {
+    let qinfo = alloc(Obj::QInfo)?;
+    let qstate = alloc(Obj::QState)?;
+    let ring = alloc(Obj::Ring)?;
+    let user_stamp = alloc(Obj::UserStamp)?;
+    let fw_stamp = alloc(Obj::FwStamp)?;
+    let sched_ctx = alloc(Obj::SchedCtx)?;
+    let notifier = alloc(Obj::Notifier)?;
+    let threshold = alloc(Obj::Threshold)?;
+    let job_list = alloc(Obj::JobList)?;
+    Ok(QueueSet {
+        qinfo,
+        qstate,
+        ring,
+        user_stamp,
+        fw_stamp,
+        sched_ctx,
+        notifier,
+        threshold,
+        job_list,
+    })
+}
