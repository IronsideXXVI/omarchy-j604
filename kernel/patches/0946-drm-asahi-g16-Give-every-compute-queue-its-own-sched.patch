+
+/// The per-queue table of LIGHT88-CQ2-SETUP.md (macOS against ours), checked on the objects
+/// [`queue_set`] makes and on the queue image `fw/graph.rs` writes from them, as
+/// `ComputeGraph::init` writes it.
+#[cfg(test)]
+mod table {
+    use super::fwg::{job_list, qinfo, qstate, queue_image, sched_ctx};
+    use super::*;
+
+    /// Render queue ids: TA 0x70, FS 0x71 and `g16_render_qids` 0x13 and 0x14.
+    const RENDER_IDS: [u8; 4] = [0x70, 0x71, 0x13, 0x14];
+
+    fn handles(s: &QueueSet<u64>) -> [(Obj, u64); 9] {
+        [
+            (Obj::QInfo, s.qinfo),
+            (Obj::QState, s.qstate),
+            (Obj::Ring, s.ring),
+            (Obj::UserStamp, s.user_stamp),
+            (Obj::FwStamp, s.fw_stamp),
+            (Obj::SchedCtx, s.sched_ctx),
+            (Obj::Notifier, s.notifier),
+            (Obj::Threshold, s.threshold),
+            (Obj::JobList, s.job_list),
+        ]
+    }
+
+    /// `n` compute queues from a bump allocator (each object page-aligned at its own VA), and
+    /// the order in which their objects were asked for.
+    fn build(n: usize) -> (Vec<QueueSet<u64>>, Vec<Obj>) {
+        let (mut va, mut order, mut sets) = (0xffff_fc20_c000_0000u64, Vec::new(), Vec::new());
+        for _ in 0..n {
+            let set = queue_set(|obj| -> Result<u64, ()> {
+                let size = match obj {
+                    Obj::QInfo => qinfo::SIZE,
+                    Obj::QState => qstate::SIZE,
+                    Obj::SchedCtx => sched_ctx::SIZE,
+                    Obj::JobList => job_list::SIZE,
+                    Obj::Ring | Obj::Notifier => 0x1000,
+                    Obj::Threshold => 24,
+                    Obj::UserStamp | Obj::FwStamp => 8,
+                };
+                order.push(obj);
+                let at = va;
+                va += (size as u64).div_ceil(0x4000) * 0x4000;
+                Ok(at)
+            });
+            sets.push(set.unwrap());
+        }
+        (sets, order)
+    }
+
+    /// Queue image of `s` from the objects `ComputeGraph::init` hands to `init_queue`.
+    fn image(s: &QueueSet<u64>) -> [u8; 0xb4] {
+        queue_image(s.qstate, s.ring, s.job_list, s.qinfo, s.sched_ctx, false)
+    }
+
+    fn r64(q: &[u8], at: usize) -> u64 {
+        u64::from_le_bytes(q[at..at + 8].try_into().unwrap())
+    }
+
+    /// The table row by row; `Err` names the first row a queue set breaks.
+    fn check(sets: &[QueueSet<u64>], ids: &[u8]) -> Result<(), String> {
+        // Channel: shared by design (one compute channel), so it is no queue object. Every
+        // object below is the queue's own, as macOS has it.
+        let all: Vec<(Obj, u64)> = sets.iter().flat_map(handles).collect();
+        for (i, (obj, va)) in all.iter().enumerate() {
+            if all[..i].iter().any(|(_, v)| v == va) {
+                return Err(format!("{obj:?} shared between queues"));
+            }
+        }
+        let images: Vec<[u8; 0xb4]> = sets.iter().map(image).collect();
+        for (s, q) in sets.iter().zip(&images) {
+            for (at, own, row) in [
+                (0x00, s.qstate, "state block +0x00"),
+                (0x08, s.ring, "work ring +0x08"),
+                (0x10, s.job_list, "job list +0x10"),
+                (0x18, s.qinfo + 0xb0, "scratch +0x18"),
+                (0xa4, s.sched_ctx, "scheduling context +0xa4"),
+            ] {
+                if r64(q, at) != own {
+                    return Err(format!("{row} is not the queue's own"));
+                }
+            }
+            if !(s.qinfo..s.qinfo + qinfo::SIZE as u64).contains(&r64(q, 0x18)) {
+                return Err("scratch +0x18 outside the queue's own qinfo".into());
+            }
+            if q[0x20..0x2c] != [0u8; 12] {
+                return Err("ring cursors +0x20..+0x2c do not start at zero".into());
+            }
+        }
+        // Shared values: every byte of the image that names no object is the same in every
+        // queue (macOS: +0x2c, the mask, the class words and the rest are equal per queue).
+        let values = |q: &[u8; 0xb4]| {
+            let mut v = *q;
+            for at in [0x00, 0x08, 0x10, 0x18, 0xa4] {
+                v[at..at + 8].fill(0);
+            }
+            v
+        };
+        if images.iter().any(|q| values(q) != values(&images[0])) {
+            return Err("shared values differ between queues".into());
+        }
+        // Queue ids: one per queue, consecutive, inside the 7-bit row field, and no busy bit
+        // (id mod 64) shared with another compute queue or a render queue.
+        if ids.len() != sets.len() {
+            return Err("one queue id per queue".into());
+        }
+        for (i, &id) in ids.iter().enumerate() {
+            if usize::from(id) != usize::from(ids[0]) + i {
+                return Err(format!("queue id {id} not consecutive"));
+            }
+            if id >= 0x80 {
+                return Err(format!("queue id {id} outside the queue table"));
+            }
+            let bit = id % 64;
+            if ids[..i].iter().chain(&RENDER_IDS).any(|&o| o % 64 == bit) {
+                return Err(format!("queue id {id} shares busy bit {bit}"));
+            }
+        }
+        Ok(())
+    }
+
+    const ORDER: [Obj; 9] = [
+        Obj::QInfo,
+        Obj::QState,
+        Obj::Ring,
+        Obj::UserStamp,
+        Obj::FwStamp,
+        Obj::SchedCtx,
+        Obj::Notifier,
+        Obj::Threshold,
+        Obj::JobList,
+    ];
+
+    #[test]
+    fn one_queue_keeps_its_objects_and_image() {
+        let (sets, order) = build(1);
+        assert_eq!(order, ORDER);
+        assert_eq!(check(&sets, &QUEUE_IDS[..1]), Ok(()));
+        let q = image(&sets[0]);
+        assert_eq!(r64(&q, 0xa4), sets[0].sched_ctx);
+        assert_eq!(r64(&q, 0x18), sets[0].qinfo + 0xb0);
+        assert_eq!(QUEUE_IDS[0], 15);
+    }
+
+    #[test]
+    fn two_queues_own_every_object() {
+        let (sets, order) = build(2);
+        assert_eq!((&order[..9], &order[9..]), (&ORDER[..], &ORDER[..]));
+        // A second queue leaves queue 0's objects where one queue puts them.
+        assert_eq!(handles(&sets[0]), handles(&build(1).0[0]));
+        assert_eq!(check(&sets, &QUEUE_IDS[..2]), Ok(()));
+        assert_ne!(sets[0].sched_ctx, sets[1].sched_ctx);
+        assert_ne!(r64(&image(&sets[0]), 0xa4), r64(&image(&sets[1]), 0xa4));
+        assert_ne!(r64(&image(&sets[0]), 0x18), r64(&image(&sets[1]), 0x18));
+    }
+
+    #[test]
+    fn every_queue_count_holds() {
+        for n in 1..=QUEUES_MAX {
+            let (sets, _) = build(n);
+            assert_eq!(check(&sets, &QUEUE_IDS[..n]), Ok(()), "{n} queues");
+        }
+    }
+
+    /// a71e1a8601's second queue: its own objects except queue 0's scheduling context.
+    #[test]
+    fn shared_scheduling_context_fails() {
+        let (mut sets, _) = build(2);
+        sets[1].sched_ctx = sets[0].sched_ctx;
+        assert_eq!(
+            check(&sets, &QUEUE_IDS[..2]),
+            Err("SchedCtx shared between queues".into())
+        );
+    }
+
+    #[test]
+    fn any_shared_object_fails() {
+        for k in 0..ORDER.len() {
+            let (mut sets, _) = build(2);
+            let mut h1 = handles(&sets[1]);
+            h1[k].1 = handles(&sets[0])[k].1;
+            let s = &mut sets[1];
+            for (obj, va) in h1 {
+                let slot = match obj {
+                    Obj::QInfo => &mut s.qinfo,
+                    Obj::QState => &mut s.qstate,
+                    Obj::Ring => &mut s.ring,
+                    Obj::UserStamp => &mut s.user_stamp,
+                    Obj::FwStamp => &mut s.fw_stamp,
+                    Obj::SchedCtx => &mut s.sched_ctx,
+                    Obj::Notifier => &mut s.notifier,
+                    Obj::Threshold => &mut s.threshold,
+                    Obj::JobList => &mut s.job_list,
+                };
+                *slot = va;
+            }
+            assert_eq!(
+                check(&sets, &QUEUE_IDS[..2]),
+                Err(format!("{:?} shared between queues", ORDER[k]))
+            );
+        }
+    }
+
+    #[test]
+    fn bad_queue_ids_fail() {
+        let (sets, _) = build(2);
+        assert!(check(&sets, &[15, 15]).is_err());
+        assert!(check(&sets, &[15, 17]).is_err());
+        // 0x30 and 0x31 would share busy bits 48 and 49 with render's 0x70 and 0x71.
+        assert!(check(&sets, &[0x30, 0x31]).is_err());
+        assert!(check(&sets, &[0x7f, 0x80]).is_err());
+    }
+}
