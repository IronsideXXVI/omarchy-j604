+/// One queue object, sized and placed as the queues have always had it.
+fn alloc_queue_obj(o: &mut Objects, obj: Obj) -> Result<Arc<FwObject>> {
+    let (size, class) = match obj {
+        Obj::QInfo => (qinfo::SIZE, cmd_fw(tuning::FWC_QUEUE)),
+        Obj::QState => (qstate::SIZE, Class::Fw),
+        Obj::Ring => (sizes::QUEUE_CAP as usize * 8, cmd_fw(tuning::FWC_RING)),
+        Obj::UserStamp | Obj::FwStamp => (8, Class::Shared),
+        Obj::SchedCtx => (sched_ctx::SIZE, cmd_fw(tuning::FWC_QUEUE)),
+        Obj::Notifier => (0x1000, Class::Fw),
+        Obj::Threshold => (24, Class::Fw),
+        Obj::JobList => (job_list::SIZE, cmd_fw(tuning::FWC_QUEUE)),
+    };
+    alloc(o, size, class, None, 0, false)
+}
