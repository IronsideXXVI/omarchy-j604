From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 23:24:11 +0000
Subject: [PATCH] dt-bindings: power: apple,pmgr-s2r: describe the
 T8132 sequence

T8132's suspend-to-RAM sequence needs 17 register windows: the PMGR
commit, power state, gate, cluster, AON and wake blocks, SPMI notify
enables, PMC voters, DCS, clock mux and SoC performance words, and the
AMCC and MCC words. It also needs the AP wake sources to leave unmasked.

Describe them for apple,t8132-pmgr-s2r, keep T6021's three named
registers, and add apple,wake-enable. The names follow Aurora's
apple,t8132-sleep node (aurora-silicon/linux#1314).

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../bindings/power/apple,pmgr-s2r.yaml        | 83 ++++++++++++++++---
 1 file changed, 73 insertions(+), 10 deletions(-)

diff --git a/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml b/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml
index 2272eba448..6284f3c341 100644
--- a/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml
+++ b/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml
@@ -50,20 +50,23 @@ properties:
 
   reg:
     description:
-      Optional where the registers are not known (T8132); the clock
-      generator, PLL and timer steps are then left out.
+      T6021 - the SoC clock generator, PLL off-mode control and PMGR
+      suspend-to-RAM timer. T8132 - optional, the windows of the sequence
+      macOS uses on that SoC; without them T8132 has no suspend-to-RAM.
     minItems: 1
-    items:
-      - description: SoC clock generator
-      - description: SoC PLL off-mode control
-      - description: PMGR suspend-to-RAM timer
+    maxItems: 17
 
   reg-names:
     minItems: 1
-    items:
-      - const: clkgen
-      - const: pll
-      - const: s2r-timer
+    maxItems: 17
+
+  apple,wake-enable:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 1
+    maxItems: 32
+    description:
+      T8132 - the AP wake sources left unmasked during suspend-to-RAM, as
+      numbered by the ADT's ap-wake-sources.
 
   apple,pmgr:
     $ref: /schemas/types.yaml#/definitions/phandle
@@ -119,6 +122,66 @@ required:
 dependentRequired:
   reg: [ reg-names ]
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: apple,t6021-pmgr-s2r
+    then:
+      properties:
+        reg:
+          maxItems: 3
+        reg-names:
+          items:
+            - const: clkgen
+            - const: pll
+            - const: s2r-timer
+        apple,wake-enable: false
+  - if:
+      properties:
+        compatible:
+          const: apple,t8132-pmgr-s2r
+    then:
+      properties:
+        reg:
+          items:
+            - description: PMGR suspend-to-RAM commit
+            - description: PMGR power states
+            - description: PMGR AON power states
+            - description: CPU power gates
+            - description: CPU cluster power targets
+            - description: AON misc controls
+            - description: AP wake masks and status
+            - description: SPMI controller
+            - description: SPMI notify enable
+            - description: PMC voters
+            - description: DCS performance state
+            - description: SoC clock muxes
+            - description: SoC performance state
+            - description: AMCC plane 0
+            - description: AMCC plane 1
+            - description: MCC channel 0
+            - description: MCC channel 1
+        reg-names:
+          items:
+            - const: commit
+            - const: ps
+            - const: ps-aon
+            - const: pwrgate
+            - const: cluster
+            - const: aon-misc
+            - const: wake
+            - const: spmi
+            - const: spmi-a0
+            - const: pmc-voters
+            - const: dcs
+            - const: clk-mux
+            - const: clk-perf
+            - const: amcc0
+            - const: amcc1
+            - const: mcc0
+            - const: mcc1
+
 additionalProperties: false
 
 examples:
-- 
2.43.0

