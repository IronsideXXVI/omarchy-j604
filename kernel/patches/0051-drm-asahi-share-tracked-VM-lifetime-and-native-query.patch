+            #[cfg(CONFIG_DRM_ASAHI_G16)]
+            g16: None,
             raw_dev: core::ptr::null_mut(),
             raw_stats: core::ptr::null_mut(),
             stats: None,
@@ -404,6 +410,8 @@ impl AsahiPlatformDriver {
             _reg: reg,
             g17: None,
             m3: Some(backend),
+            #[cfg(CONFIG_DRM_ASAHI_G16)]
+            g16: None,
             raw_dev: core::ptr::null_mut(),
             raw_stats: core::ptr::null_mut(),
             stats: None,
@@ -456,6 +464,43 @@ impl AsahiPlatformDriver {
             _reg: reg,
             g17: Some(gpu),
             m3: None,
+            #[cfg(CONFIG_DRM_ASAHI_G16)]
+            g16: None,
