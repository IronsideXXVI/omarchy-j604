+}
+
+#[cfg(CONFIG_DRM_ASAHI_G16)]
+impl AsahiPlatformDriver {
+    pub(crate) fn probe_g16<'bound>(
+        pdev: &'bound platform::Device<Core<'_>>,
+        cfg: &'static crate::g16::Config,
+    ) -> Result<AsahiPlatformDriverData<'bound>> {
+        // SAFETY: the qualified UAT output width constrains this device's DMA.
+        unsafe { pdev.dma_set_mask_and_coherent(DmaMask::try_new(cfg.uat_oas)?)? };
+        let resources = regs::Resources::new(pdev)?;
+        let res = regs::G16Resources::new(pdev)?;
+        let drm = drm::UnregisteredDevice::<AsahiDrmDriver>::new(pdev, Ok(()))?;
+        let gpu = crate::g16::Gpu::new(pdev, &drm, cfg, res)?;
+        let data_gpu = gpu.clone() as Arc<dyn gpu::Gpu>;
+        let data = try_pin_init!(AsahiDrmRegistrationData {
+            gpu: data_gpu,
+            resources,
+        });
+        // SAFETY: registration is stored in bound platform data and never forgotten.
+        let reg = unsafe { drm::Registration::new(pdev.as_ref(), drm, data, 0)? };
+        let raw_dev = pdev.as_ref().as_raw();
+        let raw_stats = crate::sysfs_exports::register(raw_dev, core::ptr::null(), false)?;
+        Ok(AsahiPlatformDriverData {
+            _device: reg.device().into(),
+            _reg: reg,
+            g17: None,
+            m3: None,
+            g16: Some(gpu),
             raw_dev,
             raw_stats,
             stats: None,
diff --git a/drivers/gpu/drm/asahi/gem.rs b/drivers/gpu/drm/asahi/gem.rs
index 72238159d0..d3e4aa4b46 100644
--- a/drivers/gpu/drm/asahi/gem.rs
+++ b/drivers/gpu/drm/asahi/gem.rs
@@ -470,7 +470,19 @@ pub(crate) fn prepare_new_object(gem: &Object) -> Result {
 #[cfg(CONFIG_DRM_ASAHI_G15)]
 extern "C" { fn asahi_g15_dma_coherent(dev: *mut core::ffi::c_void) -> bool; }
 
-#[cfg(not(CONFIG_DRM_ASAHI_G15))]
+/// Without G15, the G16 backend (which requires a non-coherent DMA device) only needs the DMA
+/// mapping of the new object; it does not interpret DMA addresses as CPU physical addresses.
+/// With both backends, the G15 variant above serves G16 as well.
+#[cfg(all(CONFIG_DRM_ASAHI_G16, not(CONFIG_DRM_ASAHI_G15)))]
+pub(crate) fn prepare_new_object(gem: &Object) -> Result {
+    // SAFETY: G16 objects belong to the retained bound platform device; user object
+    // creation occurs only after registration and before a file can outlive its device.
+    let dev: &kernel::device::Device = gem.dev().as_ref().as_ref();
+    let _sgt = held_sg_table(gem, unsafe { dev.as_bound() })?;
+    Ok(())
+}
+
+#[cfg(all(not(CONFIG_DRM_ASAHI_G15), not(CONFIG_DRM_ASAHI_G16)))]
 pub(crate) fn prepare_new_object(_gem: &Object) -> Result { Err(EINVAL) }
 /// Large user BOs have a cheap ENOMEM fallback instead of per-folio reclaim.
 /// Keep ordinary resource allocations and kernel-owned backing on their existing
