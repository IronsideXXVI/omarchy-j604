diff --git a/drivers/gpu/drm/apple/dcp-m4-edr-test.c b/drivers/gpu/drm/apple/dcp-m4-edr-test.c
new file mode 100644
index 0000000000..50d814b267
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-edr-test.c
@@ -0,0 +1,198 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/*
+ * EDR words of the T8132 panel swap (dcp-m4-edr.h) with the J604's ADT
+ * values: a 1600 nit peak (LmaxProduct), a potential headroom of 16.0, a 600
+ * nit SDR maximum.  The binary64 encoding, where each word lands in the
+ * record, the start ramp, a brightness change during EDR, the end of EDR in
+ * one swap, the ramp after a blank, and that SDR frames carry nothing.
+ */
+
+#include <kunit/test.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "dcp-m4-edr.h"
+
+#define J604_PEAK	1600U
+#define J604_CEILING	dcp_edr_ceiling(16U << 16)
+#define SWAP_SIZE	0x588
+
+static void edr_binary64(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(1, 1), 0x3ff0000000000000ULL);
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(16, 1), 0x4030000000000000ULL);
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(1600, 1), 0x4099000000000000ULL);
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(1000, 16000), 0x3fb0000000000000ULL);
+	/* 1 / 3 rounds to nearest. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(1, 3), 0x3fd5555555555555ULL);
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(0, 1), 0ULL);
+	KUNIT_EXPECT_EQ(test, dcp_m4_binary64_ratio(1, 0), 0ULL);
+}
+
+/* The desktop 26.x dcp_swap offsets (Aurora iomfb_template.h static_asserts). */
+static void edr_words_land_at_the_desktop_offsets(struct kunit *test)
+{
+	const struct dcp_m4_edr_words w = { .nits = 1600, .hm = 16000, .used = 16000,
+					    .limit = 1600 * 13 };
+	u8 *swap = kunit_kzalloc(test, SWAP_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, swap);
+	dcp_m4_swap_set_edr(swap, &w);
+	KUNIT_EXPECT_EQ(test, swap[0x354], 1);
+	KUNIT_EXPECT_EQ(test, swap[0x358], 0);
+	KUNIT_EXPECT_EQ(test, swap[0x359], 1);
+	KUNIT_EXPECT_EQ(test, swap[0x35a], 1);
+	KUNIT_EXPECT_EQ(test, swap[0x35b], 0);
+	KUNIT_EXPECT_EQ(test, swap[0x35c], 1);
+	KUNIT_EXPECT_EQ(test, swap[0x35d], 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x35e), 0x4099000000000000ULL);
+	/* limit 2080 nits, scale 1 / 16, headroom used 16 */
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x376), 0x40a0400000000000ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x37e), 0x3fb0000000000000ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x3e6), 0x4030000000000000ULL);
+}
+
+/* Words left out leave their flag and value alone. */
+static void edr_words_left_out(struct kunit *test)
+{
+	const struct dcp_m4_edr_words w = { .nits = 140, .hm = 1000 };
+	u8 *swap = kunit_kzalloc(test, SWAP_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, swap);
+	dcp_m4_swap_set_edr(swap, &w);
+	KUNIT_EXPECT_EQ(test, swap[0x359], 0);
+	KUNIT_EXPECT_EQ(test, swap[0x35c], 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x376), 0ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x3e6), 0ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x37e), 0x3ff0000000000000ULL);
+}
+
+static void edr_sdr_frames_carry_nothing(struct kunit *test)
+{
+	struct dcp_m4_edr_state st = {};
+	struct dcp_m4_edr_words w;
+
+	for (unsigned int i = 0; i < 10; i++)
+		KUNIT_EXPECT_FALSE(test, dcp_m4_edr_step(&st, false, i & 1, 140, J604_PEAK,
+							 J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, st.hm, 0U);
+	/* The colour tags of an SDR frame stay the ones 1.607 sends. */
+	KUNIT_EXPECT_EQ(test, DCP_M4_XFER_SRGB, 13);
+	KUNIT_EXPECT_EQ(test, DCP_M4_PRIMARIES_P3_D65, 12);
+}
+
+/* At 140 nits SDR white the panel reaches its peak: H = 1600 / 140. */
+static void edr_ramp_to_the_peak(struct kunit *test)
+{
+	struct dcp_m4_edr_state st = {};
+	struct dcp_m4_edr_words w;
+	unsigned int swaps = 0;
+	u32 last = 0;
+
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(J604_PEAK, 140, J604_CEILING), 11428U);
+	while (dcp_m4_edr_step(&st, true, false, 140, J604_PEAK, J604_CEILING, &w)) {
+		KUNIT_EXPECT_GT(test, w.hm, last);
+		KUNIT_EXPECT_EQ(test, w.used, w.hm);
+		KUNIT_EXPECT_LE(test, w.nits, J604_PEAK);
+		KUNIT_EXPECT_EQ(test, w.nits, 140 * w.hm / 1000);
+		/* The brightness limit runs with the ramp only. */
+		KUNIT_EXPECT_EQ(test, w.limit, w.hm == 11428 ? 0 : w.nits * 13);
+		last = w.hm;
+		KUNIT_ASSERT_LT(test, ++swaps, 100U);
+	}
+	KUNIT_EXPECT_EQ(test, st.hm, 11428U);
+	KUNIT_EXPECT_EQ(test, 140 * st.hm / 1000, 1599U);
+	KUNIT_EXPECT_TRUE(test, st.sent);
+}
+
+/* Dim SDR white: the potential headroom caps H; bright: the peak does. */
+static void edr_ceiling_and_sdr_maximum(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, J604_CEILING, 16000U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(J604_PEAK, 50, J604_CEILING), 16000U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(J604_PEAK, 600, J604_CEILING), 2666U);
+	KUNIT_EXPECT_EQ(test, dcp_edr_target(J604_PEAK, 1600, J604_CEILING), 1000U);
+}
+
+static void edr_settle(struct dcp_m4_edr_state *st, u32 sdr)
+{
+	struct dcp_m4_edr_words w;
+
+	for (unsigned int i = 0; i < 100; i++)
+		if (!dcp_m4_edr_step(st, true, false, sdr, J604_PEAK, J604_CEILING, &w))
+			break;
+}
+
+/* A brightness change during EDR carries SDR white x H, not SDR white. */
+static void edr_brightness_change(struct kunit *test)
+{
+	struct dcp_m4_edr_state st = {};
+	struct dcp_m4_edr_words w;
+
+	edr_settle(&st, 400);
+	KUNIT_EXPECT_EQ(test, st.hm, 4000U);
+	KUNIT_ASSERT_TRUE(test, dcp_m4_edr_step(&st, true, true, 400, J604_PEAK,
+						 J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, w.nits, 1600U);
+	/* Brighter SDR white: less headroom at once, the level holds the peak. */
+	KUNIT_ASSERT_TRUE(test, dcp_m4_edr_step(&st, true, true, 500, J604_PEAK,
+						 J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, w.hm, 3200U);
+	KUNIT_EXPECT_EQ(test, w.nits, 1600U);
+}
+
+/* EDR ends in one swap: H 1.0, headroom used 1.0, then the firmware's values. */
+static void edr_ends_in_one_swap(struct kunit *test)
+{
+	struct dcp_m4_edr_state st = {};
+	struct dcp_m4_edr_words w;
+
+	edr_settle(&st, 140);
+	KUNIT_ASSERT_TRUE(test, dcp_m4_edr_step(&st, false, false, 140, J604_PEAK,
+						 J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, w.hm, 1000U);
+	KUNIT_EXPECT_EQ(test, w.used, 1000U);
+	KUNIT_EXPECT_EQ(test, w.nits, 140U);
+	KUNIT_EXPECT_EQ(test, w.limit, 0U);
+	KUNIT_EXPECT_EQ(test, st.hm, 0U);
+	KUNIT_EXPECT_FALSE(test, st.sent);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_edr_step(&st, false, false, 140, J604_PEAK,
+						  J604_CEILING, &w));
+}
+
+/* After a blank the ramp starts from 1.0 again; an unlit panel gets nothing. */
+static void edr_restart_and_unlit(struct kunit *test)
+{
+	struct dcp_m4_edr_state st = {};
+	struct dcp_m4_edr_words w;
+
+	edr_settle(&st, 140);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_edr_step(&st, true, false, 0, J604_PEAK,
+						  J604_CEILING, &w));
+	st.restart = true;
+	KUNIT_ASSERT_TRUE(test, dcp_m4_edr_step(&st, true, false, 140, J604_PEAK,
+						 J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, w.hm, 1048U);
+	KUNIT_EXPECT_FALSE(test, st.restart);
+}
+
+static struct kunit_case m4_edr_cases[] = {
+	KUNIT_CASE(edr_binary64),
+	KUNIT_CASE(edr_words_land_at_the_desktop_offsets),
+	KUNIT_CASE(edr_words_left_out),
+	KUNIT_CASE(edr_sdr_frames_carry_nothing),
+	KUNIT_CASE(edr_ramp_to_the_peak),
+	KUNIT_CASE(edr_ceiling_and_sdr_maximum),
+	KUNIT_CASE(edr_brightness_change),
+	KUNIT_CASE(edr_ends_in_one_swap),
+	KUNIT_CASE(edr_restart_and_unlit),
+	{}
+};
+
+static struct kunit_suite m4_edr_suite = {
+	.name = "apple-dcp-m4-edr",
+	.test_cases = m4_edr_cases,
+};
+
+kunit_test_suite(m4_edr_suite);
diff --git a/drivers/gpu/drm/apple/dcp-panel-edid-test.c b/drivers/gpu/drm/apple/dcp-panel-edid-test.c
index 399f6e5bfd..ccede015f8 100644
--- a/drivers/gpu/drm/apple/dcp-panel-edid-test.c
+++ b/drivers/gpu/drm/apple/dcp-panel-edid-test.c
@@ -10,6 +10,7 @@
 
 #include <kunit/test.h>
 #include <linux/errno.h>
+#include <linux/hdmi.h>
 #include <linux/string.h>
 
 #include <drm/drm_atomic_state_helper.h>
@@ -258,6 +259,79 @@ static void panel_edid_update_publishes_the_block(struct kunit *test)
 	KUNIT_EXPECT_TRUE(test, list_empty(&connector->probed_modes));
 }
 
+/*
+ * An HDR panel (T8132 panel_edr): a third, CTA-861 block with BT.2020 RGB and
+ * HDR static metadata for SDR and PQ, the peak as maximum luminance.
+ */
+static void panel_edid_hdr_block(struct kunit *test)
+{
+	u8 *e = kunit_kzalloc(test, DCP_PANEL_EDID_HDR_BLOCKS * EDID_LENGTH, GFP_KERNEL);
+	const u8 *cta = e + 2 * EDID_LENGTH;
+	const struct drm_edid *edid;
+	struct dcp_panel_id id;
+
+	KUNIT_ASSERT_NOT_NULL(test, e);
+	panel_id_j516(test, &id);
+	KUNIT_EXPECT_EQ(test, dcp_panel_edid_build_hdr(&id, J516_W_MM, J516_H_MM, e), -EINVAL);
+	id.hdr_max_nits = 1600;
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build_hdr(&id, J516_W_MM, J516_H_MM, e), 0);
+	edid = drm_edid_alloc(e, DCP_PANEL_EDID_HDR_BLOCKS * EDID_LENGTH);
+	KUNIT_ASSERT_NOT_NULL(test, edid);
+	KUNIT_EXPECT_TRUE(test, drm_edid_valid(edid));
+	drm_edid_free(edid);
+	KUNIT_EXPECT_EQ(test, e[126], 2);
+	for (unsigned int i = 0; i < DCP_PANEL_EDID_HDR_BLOCKS; i++)
+		KUNIT_EXPECT_EQ(test, sum(e + i * EDID_LENGTH, EDID_LENGTH), 0);
+	KUNIT_EXPECT_EQ(test, cta[0], 0x02);
+	KUNIT_EXPECT_EQ(test, cta[1], 3);
+	/* Colorimetry: BT2020_RGB. */
+	KUNIT_EXPECT_EQ(test, cta[4], 0xe3);
+	KUNIT_EXPECT_EQ(test, cta[5], 0x05);
+	KUNIT_EXPECT_EQ(test, cta[6], 0x80);
+	/* HDR static metadata: SDR + ST 2084, type 1, 1600 nits = 50 x 2^(160 / 32). */
+	KUNIT_EXPECT_EQ(test, cta[8], 0xe6);
+	KUNIT_EXPECT_EQ(test, cta[9], 0x06);
+	KUNIT_EXPECT_EQ(test, cta[10], 0x05);
+	KUNIT_EXPECT_EQ(test, cta[11], 0x01);
+	KUNIT_EXPECT_EQ(test, cta[12], 160);
+	KUNIT_EXPECT_EQ(test, cta[13], 160);
+	KUNIT_EXPECT_EQ(test, cta[14], 0);
+	KUNIT_EXPECT_EQ(test, cta[2], 15);
+}
+
+/* The connector reads the HDR capability back from the published EDID. */
+static void panel_edid_update_publishes_hdr(struct kunit *test)
+{
+	struct panel_edid_test *t;
+	struct drm_connector *connector;
+	struct dcp_panel_id id;
+	struct device *dev;
+	int ret;
+
+	dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	t = drm_kunit_helper_alloc_drm_device(test, dev, struct panel_edid_test, drm,
+					      DRIVER_MODESET);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, t);
+	connector = &t->connector;
+	ret = drmm_connector_init(&t->drm, connector, &panel_edid_connector_funcs,
+				  DRM_MODE_CONNECTOR_eDP, NULL);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	panel_id_j516(test, &id);
+	id.hdr_max_nits = 1600;
+	mutex_lock(&t->drm.mode_config.mutex);
+	ret = dcp_panel_edid_update(connector, &id, J516_W_MM, J516_H_MM);
+	mutex_unlock(&t->drm.mode_config.mutex);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_NOT_NULL(test, connector->edid_blob_ptr);
+	KUNIT_EXPECT_EQ(test, connector->edid_blob_ptr->length, 3 * EDID_LENGTH);
+	KUNIT_EXPECT_TRUE(test, connector->display_info.hdr_sink_metadata.hdmi_type1.eotf &
+				BIT(HDMI_EOTF_SMPTE_ST2084));
+	KUNIT_EXPECT_EQ(test, connector->display_info.hdr_sink_metadata.hdmi_type1.max_cll, 160);
+	KUNIT_EXPECT_TRUE(test, list_empty(&connector->probed_modes));
+}
+
 static struct kunit_case panel_edid_cases[] = {
 	KUNIT_CASE(panel_id_from_compatible),
 	KUNIT_CASE(panel_id_needs_a_model_and_a_known_vendor),
@@ -265,6 +339,8 @@ static struct kunit_case panel_edid_cases[] = {
 	KUNIT_CASE(panel_edid_timings_are_the_panels),
 	KUNIT_CASE(panel_edid_refuses_a_size_it_cannot_hold),
 	KUNIT_CASE(panel_edid_update_publishes_the_block),
+	KUNIT_CASE(panel_edid_hdr_block),
+	KUNIT_CASE(panel_edid_update_publishes_hdr),
 	{}
 };
 
