diff --git a/drivers/media/platform/apple/avd/avd-protocol.rst b/drivers/media/platform/apple/avd/avd-protocol.rst
new file mode 100644
index 0000000000..5445295843
--- /dev/null
+++ b/drivers/media/platform/apple/avd/avd-protocol.rst
@@ -0,0 +1,150 @@
+AVD queued transport implementation status
+==========================================
+
+The pool owns sixteen independently tagged slots.  A source/destination pair
+and a runtime-PM reference remain owned by the slot until in-order retirement
+within its context.  A duplicate or obsolete tag cannot complete a reused
+slot.  Inbox-full leaves a prepared slot reserved and retries without losing
+its buffers.  Timeout or streamoff resets the whole engine before failing all
+slots affected by that reset.  Slot deadlines survive inbox retries.
+
+The first commit adding avd-queue.h is the shared interface.  Later additions
+only extend it.  Codec callbacks own codec-private state and must release that
+state from retire(), including when prepare() failed part way through.
+
+Open firmware compatibility
+--------------------------
+
+The deployed, untagged open-firmware protocol has a one-frame limit.  Existing
+codec run() callbacks build a DMA-visible per-slot program; only the backend
+writes those instructions to the VP FIFO.  That compatibility backend retains
+the old host-side PP kick.  A native frame_ops program must use the queued
+avd-fw transport before it can replace the compatibility path; this backend
+returns EOPNOTSUPP for native programs rather than guessing their wire format.
+
+Partial HOLD_CAPTURE slice requests use buf_done_and_job_finish(), returning
+the copied OUTPUT slice while CAPTURE remains held on the ready list. Final
+slices use job_finish_detach(): it atomically transfers both ready buffers to
+the frame slot and releases m2m dispatch without completing either buffer.
+The next picture can prepare while the decoder still owns the earlier frame.
+The slot returns those buffers only after its tagged completion or quiesced
+recovery. The queue capability flags are never toggled around job_finish().
+This requires the matching V4L2 m2m detach API; an external-module deployment
+must install the matching m2m module as well as apple-avd.
+
+Apple Borage transport
+----------------------
+
+Only T6040 has Borage match data.  The Apple backend contains the 64-byte
+little-endian connection configuration, session command builders, decode
+prefix, eight-entry inbox publishing, a 64-entry completion shadow and bounded
+20-word result parsing.  Type 7 is VP/parsing completion and never releases a
+buffer.  The notification address rule has one definition,
+AVD_APPLE_NOTIFY_BASE, so a capture can correct it.
+
+Boot checks a nonzero ITCM span and a nonzero/non-all-ones version word before
+accepting a preloaded image.  A separately installed firmware image can restore
+ITCM after power loss.  The last image word is zero padded without reading
+past the firmware object.  No Apple image is embedded in this source tree.
+
+Activation remains disabled in match data: the supplied clean specification
+has no ITCM register offsets, link programming sequence, result-area address,
+result field layout or final-completion value.  It would be unsafe to invent
+these or reuse the different open-firmware mailbox.  The closest executable
+path is the open compatibility backend.  The Apple register description and
+reply layout must be completed together from clean facts; setting verified
+alone is insufficient.  The DT must then describe the complete Apple aperture
+as an owned named resource before probe can map it.
+
+Unresolved field ledger
+-----------------------
+
+This is the single ledger for fields marked [C] in the common transport.  No
+semantic names have been assigned to the unknown bits.  Codec-specific fields
+remain in their codec packers' ledgers.
+
+==============================  ================================================
+Field                           Source and required evidence
+==============================  ================================================
+Config +00/+08/+10/+18/+20/      SPEC 3.2: exact values, meanings unproved;
+28/+2c/+30/+38                   capture connection construction and LinkUp
+ITCM start/end/clear/enable      SPEC 3.1: operations, offsets/values absent;
+                                clean per-SoC register ledger required
+IMEM version-word offset        SPEC 3.1: display format proved, offset absent
+Mailbox link register writes    SPEC 3.2: aperture 1, state 4, LinkUp proved;
+                                offsets and bit operations absent
+Mailbox ready register          SPEC 3.1: status 1, poll 10 us; offset absent
+Mailbox notification word       SPEC 4.2; expected inbox-entry address from MIT
+                                aura trace_avd.py V3 precedent; capture Borage
+Inbox consumption/full rule     SPEC 4.2: host positions modulo eight;
+                                hardware consumer register/doorbell absent
+Result-area base/indexing       SPEC 4.3: 64 entries, 20 words; base and mailbox
+                                notification interpretation absent
+Reply type/client/frame/status  SPEC 4.3: correlation proved, word layout absent;
+                                synthetic KUnit layout is not a hardware fact
+Final reply type/status values  SPEC 4.3: only VP done = 7 proved; capture final
+                                completion and error replies before activation
+Decode +00 bit 9                SPEC 5.2: boolean argument, meaning unproved;
+                                left zero until the producer is established
+Decode +50..+5f                 SPEC 5: Borage extension, nonzero use unproved;
+                                initialized to zero before codec packing
+Commands 3/4 and other values   SPEC 5.1: unproved; never sent
+PIODMA mapping stream binding   SPEC 7: three mapper roles proved, Linux binding
+                                and per-domain fp/program DVA ownership pending
+Retention and clock floors      SPEC 8: per-SoC capture required; no guessed knobs
+==============================  ================================================
+
+Licensed implementation references: eiln/avd (MIT), avd_emu.py, and
+https://github.com/aurora-silicon/aura/blob/main/proxyclient/hv/trace_avd.py
+(MIT).  The Borage facts above come from the supplied clean SPEC sections 3-5;
+no binary or captured Apple command images are used.
+
+Firmware-advertised multi-VP pools
+---------------------------------
+
+The queued open transport uses the optional ABI 2 feature bit 3 and the AVM2
+pool record at SRAM +0x7f80. Its eight u32 words are magic 0x41564d32, version 1,
+four codec VP masks (HEVC, H.264, VP9, AV1), an inferred-count codec mask, and a
+zero reserved word. Masks must be disjoint, within the firmware VP register
+limit and consistent with its codec mask. An absent or malformed extension
+keeps the k4m single-VP selector and two H.264/HEVC banks. Reload clears all
+cached masks and rotation state before negotiation, so an older image cannot
+inherit a prior multi-VP capability.
+
+For a valid pool the host rotates successive submissions through its hardware
+VP indices. The prepared program names its private FIFO, not a VP; retrying a
+busy mailbox cannot consume a rotation turn or alter the saved program/FIFO.
+Separate streams share that rotation, so they also use distinct engines.
+Firmware retains exclusive VP picture ownership through DONE and feeds the
+SRAM programs in order. PP starts strictly in descriptor submission order,
+even when VP completion order differs. Within each context, the host preserves
+submission and retirement order.
+
+H.264 and HEVC allocate one scratch bank per advertised VP plus a bank that PP
+may still own, bounded by the physical FIFO count. The VP work of the next
+picture reads its own bitstream and slice state; reference reconstruction is
+consumed by the ordered PP stage. Buffers, instruction FIFOs and scratch banks
+remain owned through PP completion, not merely VP DONE. No reference wait or
+probability dependency is removed by choosing another engine.
+
+VP9 retains its two banks and producer-side backward-adaptation barrier from
+the VP-DONE implementation. Its tagged VP callback remains separate from full
+PP retirement. AV1 publishes per-bank coherent CDF output after its tagged VP callback,
+while updated segmentation maps and reference motion fields retain their PP
+barriers. Only PP retirement releases banks and saves CDFs into CAPTURE tails.
+See tests/README.rst for the dependency matrix and hardware qualification limit.
+
+Pool counts live in the firmware image, not an additional host SoC table.
+The avd-fw v5-t2 T6040 counts (HEVC 4, H.264 4, VP9 1, AV1 3) are inferred from
+T8132 and marked as inferred by the image. The v2/v3/v4/v5-t0/v5-t1 pools use
+the public codec variant counts. The T6020 v3-t2 image reuses v3-t1 tunables;
+it and all multi-engine silicon behavior still require device qualification.
+
+The host program fixture checks negotiation, invalid/overlapping/absent pool
+fallback, reset, rotation, bank limits, saved FIFO retry and unchanged legacy
+programs. It emits both ordinary and multi-VP programs. Run the routed test
+with ``--multi`` to verify the production H.264 submissions use all advertised
+engines, retain each bank through PP, handle reversed VP DONE, and keep PP and
+retirement in order. The firmware transport test covers every advertised codec
+and engine and tagged VP notifications on every image. These event models do
+not decode pixels or establish throughput.
diff --git a/drivers/media/platform/apple/avd/avd-queue-internal.h b/drivers/media/platform/apple/avd/avd-queue-internal.h
new file mode 100644
index 0000000000..c5b9c06836
--- /dev/null
+++ b/drivers/media/platform/apple/avd/avd-queue-internal.h
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef AVD_QUEUE_INTERNAL_H_
+#define AVD_QUEUE_INTERNAL_H_
+
+#include <linux/errno.h>
+#include <linux/jiffies.h>
+#include <linux/limits.h>
+
+#include "avd-queue.h"
+
+/* Caller serializes the pool; tags are never recycled during device lifetime. */
+static inline int avd_slot_reserve(struct avd_frame *f, struct avd_ctx *ctx,
+				   u64 seq)
+{
+	if (f->state != AVD_FRAME_FREE)
+		return -EBUSY;
+	if (!seq || seq > (U32_MAX >> 4))
+		return -EOVERFLOW;
+	f->seq = seq;
+	f->tag = (seq << 4) | f->idx;
+	f->ctx = ctx;
+	f->state = AVD_FRAME_RESERVED;
+	f->dep = AVD_DEP_NONE;
+	f->status = 0;
+	f->vp_done = false;
+	f->vp_retired = false;
+	f->prog_words = 0;
+	f->codec_priv = NULL;
+	return 0;
+}
+
+/* A full inbox owns nothing: keep the prepared slot, tag and deadline. */
+static inline void avd_slot_submit_result(struct avd_frame *f, int status)
+{
+	if (status == -EBUSY) {
+		f->state = AVD_FRAME_RESERVED;
+	} else if (status) {
+		f->status = status;
+		f->state = AVD_FRAME_DONE;
+	}
+}
+
+static inline bool avd_slot_complete(struct avd_frame *f, u32 tag, int status)
+{
+	if (f->state != AVD_FRAME_SUBMITTED || f->tag != tag)
+		return false;
+	f->status = status;
+	f->state = AVD_FRAME_DONE;
+	return true;
+}
+
+static inline bool avd_slot_first(const struct avd_frame *pool,
+				  const struct avd_frame *f)
+{
+	unsigned int i;
+
+	for (i = 0; i < AVD_MAX_FRAMES; i++)
+		if (pool[i].state != AVD_FRAME_FREE && pool[i].ctx == f->ctx &&
+		    pool[i].seq < f->seq)
+			return false;
+	return true;
+}
+
+static inline bool avd_slot_expired(const struct avd_frame *f, unsigned long now)
+{
+	return (f->state == AVD_FRAME_SUBMITTED ||
+		f->state == AVD_FRAME_RESERVED) && time_after_eq(now, f->deadline);
+}
+
+/* Posted frames may overlap, but never pass an earlier reserved frame. */
+static inline bool avd_slot_submit_first(const struct avd_frame *pool,
+					const struct avd_frame *f)
+{
+	unsigned int i;
+
+	for (i = 0; i < AVD_MAX_FRAMES; i++)
+		if (pool[i].state == AVD_FRAME_RESERVED && pool[i].ctx == f->ctx &&
+		    pool[i].seq < f->seq)
+			return false;
+	return true;
+}
+
+static inline bool avd_inbox_full(unsigned int producer, unsigned int consumer)
+{
+	return ((producer + 1) & 7) == consumer;
+}
+
+#endif /* AVD_QUEUE_INTERNAL_H_ */
diff --git a/drivers/media/platform/apple/avd/avd-queue-test.c b/drivers/media/platform/apple/avd/avd-queue-test.c
new file mode 100644
index 0000000000..8d343b1b93
--- /dev/null
+++ b/drivers/media/platform/apple/avd/avd-queue-test.c
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <kunit/test.h>
+#include <linux/unaligned.h>
+
+#include "avd.h"
+#include "avd-apple-protocol.h"
+#include "avd-queue-internal.h"
+
+static void avd_slots_and_tags(struct kunit *test)
+{
+	struct avd_frame *pool;
+	struct avd_ctx *ctx = (void *)test;
+	unsigned int i;
+
+	pool = kunit_kcalloc(test, AVD_MAX_FRAMES, sizeof(*pool), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, pool);
+	for (i = 0; i < AVD_MAX_FRAMES; i++) {
+		pool[i].idx = i;
+		KUNIT_EXPECT_EQ(test, avd_slot_reserve(&pool[i], ctx, i + 1), 0);
+		KUNIT_EXPECT_EQ(test, pool[i].tag, ((i + 1) << 4) | i);
+		KUNIT_EXPECT_EQ(test, pool[i].state, AVD_FRAME_RESERVED);
+		KUNIT_EXPECT_EQ(test, avd_slot_reserve(&pool[i], ctx, 100), -EBUSY);
+		KUNIT_EXPECT_FALSE(test, avd_slot_complete(&pool[i], pool[i].tag, 0));
+		pool[i].state = AVD_FRAME_SUBMITTED;
+		KUNIT_EXPECT_FALSE(test, avd_slot_complete(&pool[i], pool[i].tag + 16, 0));
+		KUNIT_EXPECT_TRUE(test, avd_slot_complete(&pool[i], pool[i].tag, 0));
+		KUNIT_EXPECT_FALSE(test, avd_slot_complete(&pool[i], pool[i].tag, -EIO));
+	}
+	pool[0].state = AVD_FRAME_FREE;
+	KUNIT_EXPECT_EQ(test, avd_slot_reserve(&pool[0], ctx, 0), -EOVERFLOW);
+	KUNIT_EXPECT_EQ(test, avd_slot_reserve(&pool[0], ctx, (u64)(U32_MAX >> 4) + 1),
+			-EOVERFLOW);
+	KUNIT_ASSERT_EQ(test, avd_slot_reserve(&pool[0], ctx, 100), 0);
+	pool[0].state = AVD_FRAME_SUBMITTED;
+	KUNIT_EXPECT_FALSE(test, avd_slot_complete(&pool[0], 16, 0));
+}
+
+static void avd_retirement_order(struct kunit *test)
+{
+	struct avd_frame *pool;
+	struct avd_ctx *a = (void *)test;
+	struct avd_ctx *b = (void *)&pool;
+
+	pool = kunit_kcalloc(test, AVD_MAX_FRAMES, sizeof(*pool), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, pool);
+	KUNIT_ASSERT_EQ(test, avd_slot_reserve(&pool[0], a, 1), 0);
+	KUNIT_ASSERT_EQ(test, avd_slot_reserve(&pool[1], b, 2), 0);
+	KUNIT_ASSERT_EQ(test, avd_slot_reserve(&pool[2], a, 3), 0);
+	pool[0].state = AVD_FRAME_SUBMITTED;
+	pool[1].state = AVD_FRAME_SUBMITTED;
+	pool[2].state = AVD_FRAME_SUBMITTED;
+	KUNIT_ASSERT_TRUE(test, avd_slot_complete(&pool[2], pool[2].tag, 0));
+	KUNIT_EXPECT_FALSE(test, avd_slot_first(pool, &pool[2]));
+	KUNIT_EXPECT_TRUE(test, avd_slot_first(pool, &pool[1]));
+	KUNIT_ASSERT_TRUE(test, avd_slot_complete(&pool[0], pool[0].tag, -ETIMEDOUT));
+	KUNIT_EXPECT_TRUE(test, avd_slot_first(pool, &pool[0]));
+	pool[0].state = AVD_FRAME_FREE;
+	KUNIT_EXPECT_TRUE(test, avd_slot_first(pool, &pool[2]));
+	KUNIT_EXPECT_EQ(test, pool[0].status, -ETIMEDOUT);
+}
+
+static void avd_watchdog_and_retry(struct kunit *test)
+{
+	struct avd_frame f = { .state = AVD_FRAME_SUBMITTED, .deadline = ULONG_MAX - 2 };
+	unsigned int producer, consumer;
+	u32 tag = 0x124;
+	unsigned long deadline = f.deadline;
+
+	f.tag = tag;
+	avd_slot_submit_result(&f, -EBUSY);
+	KUNIT_EXPECT_EQ(test, f.state, AVD_FRAME_RESERVED);
+	KUNIT_EXPECT_EQ(test, f.tag, tag);
+	KUNIT_EXPECT_EQ(test, f.deadline, deadline);
+	f.state = AVD_FRAME_SUBMITTED;
+	avd_slot_submit_result(&f, 0);
+	KUNIT_EXPECT_EQ(test, f.state, AVD_FRAME_SUBMITTED);
+
+	KUNIT_EXPECT_FALSE(test, avd_slot_expired(&f, ULONG_MAX - 3));
+	KUNIT_EXPECT_TRUE(test, avd_slot_expired(&f, ULONG_MAX - 2));
+	KUNIT_EXPECT_TRUE(test, avd_slot_expired(&f, 1));
+	f.state = AVD_FRAME_DONE;
+	KUNIT_EXPECT_FALSE(test, avd_slot_expired(&f, 1));
+	f.state = AVD_FRAME_RESERVED;
+	KUNIT_EXPECT_TRUE(test, avd_slot_expired(&f, 1));
+	for (producer = 0; producer < 8; producer++) {
+		for (consumer = 0; consumer < 8; consumer++)
+			KUNIT_EXPECT_EQ(test, avd_inbox_full(producer, consumer),
+					((producer + 1) & 7) == consumer);
+		consumer = (producer + 1) & 7;
+		KUNIT_EXPECT_TRUE(test, avd_inbox_full(producer, consumer));
+		/* A consumer advance reopens the same pending inbox slot. */
+		consumer = (consumer + 1) & 7;
+		KUNIT_EXPECT_FALSE(test, avd_inbox_full(producer, consumer));
+		KUNIT_EXPECT_EQ(test, avd_apple_notification(producer),
+				0x01482cf8U + 0x60 * producer);
+	}
+}
+
+static void avd_completion_parser(struct kunit *test)
+{
+	/* Synthetic layout for parser testing; never a claimed Borage wire ABI. */
+	struct avd_apple_reply_layout layout = {
+		.type_word = 0, .type_mask = 0x1f,
+		.client_word = 1, .client_shift = 16, .client_mask = 0x3ff,
+		.frame_word = 3, .status_word = 4, .done_type = 8, .verified = true,
+	};
+	struct avd_apple_reply reply;
+	u32 record[AVD_APPLE_RESULT_WORDS] = { 7, 5 << 16, 0, 0x12340 };
+
+	KUNIT_EXPECT_EQ(test, avd_apple_parse_reply(record, 19, &layout, &reply), -EMSGSIZE);
+	KUNIT_EXPECT_EQ(test, avd_apple_parse_reply(record, 20, &layout, &reply), -EINPROGRESS);
+	record[0] = 8;
+	KUNIT_ASSERT_EQ(test, avd_apple_parse_reply(record, 20, &layout, &reply), 0);
+	KUNIT_EXPECT_EQ(test, reply.client, 5U);
+	KUNIT_EXPECT_EQ(test, reply.frame, 0x12340U);
+	KUNIT_EXPECT_EQ(test, reply.status, 0);
+	record[4] = 1;
+	KUNIT_ASSERT_EQ(test, avd_apple_parse_reply(record, 20, &layout, &reply), 0);
+	KUNIT_EXPECT_EQ(test, reply.status, -EIO);
+	record[0] = 3;
+	KUNIT_EXPECT_EQ(test, avd_apple_parse_reply(record, 20, &layout, &reply), -ENOMSG);
+	layout.frame_word = 20;
+	KUNIT_EXPECT_EQ(test, avd_apple_parse_reply(record, 20, &layout, &reply), -EINVAL);
+	layout.verified = false;
+	KUNIT_EXPECT_EQ(test, avd_apple_parse_reply(record, 20, &layout, &reply), -EOPNOTSUPP);
+}
+
+static void avd_command_builders(struct kunit *test)
+{
+	struct avd_frame f = { .idx = 15, .frame_num = 0x1234 };
+	u32 cmd[24];
+	const u64 config[] = {
+		0, 0x01558000, 0x01558a00, 0x01558e00, 0,
+		0x000000040004000aULL, 0, 0x01100008,
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(config); i++)
+		KUNIT_EXPECT_EQ(test, get_unaligned_le64(avd_borage_config + i * 8), config[i]);
+	KUNIT_ASSERT_EQ(test, avd_apple_decode_prefix(&f, 1023, 15, 3), 0);
+	KUNIT_EXPECT_EQ(test, f.cmd[0], 1U | (15U << 10) | (1023U << 22));
+	KUNIT_EXPECT_EQ(test, f.cmd[1], 15U | (3U << 16));
+	KUNIT_EXPECT_EQ(test, f.cmd[3], 0x1234U);
+	KUNIT_EXPECT_EQ(test, f.cmd[23], 0U);
+	KUNIT_EXPECT_EQ(test, avd_apple_decode_prefix(&f, 1024, 0, 0), -EINVAL);
+	KUNIT_EXPECT_EQ(test, avd_apple_decode_prefix(&f, 0, 16, 0), -EINVAL);
+	KUNIT_EXPECT_EQ(test, avd_apple_decode_prefix(&f, 0, 0, 4), -EINVAL);
+	KUNIT_ASSERT_EQ(test, avd_apple_session_command(cmd, 2, 6, 17, 42), 0);
+	KUNIT_EXPECT_EQ(test, cmd[0], 6U | (2U << 16));
+	KUNIT_EXPECT_EQ(test, cmd[1], 17U);
+	KUNIT_EXPECT_EQ(test, cmd[2], 42U);
+	KUNIT_EXPECT_EQ(test, cmd[23], 0U);
+	KUNIT_EXPECT_EQ(test, avd_apple_session_command(cmd, 2, 3, 0, 0), -EINVAL);
+}
+
+static unsigned int avd_test_max_inflight(struct avd_dev *avd)
+{
+	return AVD_MAX_FRAMES;
+}
+
+static void avd_dispatch_reservation(struct kunit *test)
+{
+	static const struct avd_backend_ops backend = {
+		.max_inflight = avd_test_max_inflight,
+	};
+	struct avd_dev *avd = kunit_kzalloc(test, sizeof(*avd), GFP_KERNEL);
+	struct avd_ctx *ctx = kunit_kcalloc(test, 2, sizeof(*ctx), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, avd);
+	KUNIT_ASSERT_NOT_NULL(test, ctx);
+	spin_lock_init(&avd->queue_lock);
+	avd->backend = &backend;
+	ctx[0].dev = avd;
+	ctx[1].dev = avd;
+	/* Every context with work is ready; capacity is checked at dispatch. */
+	KUNIT_EXPECT_EQ(test, avd_queue_ready(&ctx[0]), 1);
+	KUNIT_EXPECT_EQ(test, avd_queue_ready(&ctx[1]), 1);
+	avd->inflight = AVD_MAX_FRAMES;
+	KUNIT_EXPECT_EQ(test, avd_queue_ready(&ctx[1]), 1);
+	avd->inflight = 1;
+	avd->frames[0].state = AVD_FRAME_SUBMITTED;
+	avd->frames[0].ctx = &ctx[1];
+	ctx[1].next_dep = AVD_DEP_PREV_DONE;
+	KUNIT_EXPECT_EQ(test, avd_queue_ready(&ctx[1]), 0);
+	avd->frames[0].state = AVD_FRAME_FREE;
+	KUNIT_EXPECT_EQ(test, avd_queue_ready(&ctx[1]), 1);
+}
+
+static void avd_submit_order(struct kunit *test)
+{
+	struct avd_frame *pool;
+	struct avd_ctx *a = (void *)test, *b = (void *)&pool;
+
+	pool = kunit_kcalloc(test, AVD_MAX_FRAMES, sizeof(*pool), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, pool);
+	pool[1].idx = 1;
+	pool[2].idx = 2;
+	KUNIT_ASSERT_EQ(test, avd_slot_reserve(&pool[0], a, 1), 0);
+	KUNIT_ASSERT_EQ(test, avd_slot_reserve(&pool[1], a, 2), 0);
+	KUNIT_ASSERT_EQ(test, avd_slot_reserve(&pool[2], b, 3), 0);
+	KUNIT_EXPECT_TRUE(test, avd_slot_submit_first(pool, &pool[0]));
+	KUNIT_EXPECT_FALSE(test, avd_slot_submit_first(pool, &pool[1]));
+	KUNIT_EXPECT_TRUE(test, avd_slot_submit_first(pool, &pool[2]));
+	pool[0].state = AVD_FRAME_SUBMITTED;
+	KUNIT_EXPECT_TRUE(test, avd_slot_submit_first(pool, &pool[1]));
+	avd_slot_submit_result(&pool[0], -EBUSY);
+	KUNIT_EXPECT_FALSE(test, avd_slot_submit_first(pool, &pool[1]));
+}
+
+static struct kunit_case avd_queue_cases[] = {
+	KUNIT_CASE(avd_slots_and_tags),
+	KUNIT_CASE(avd_retirement_order),
+	KUNIT_CASE(avd_watchdog_and_retry),
+	KUNIT_CASE(avd_completion_parser),
+	KUNIT_CASE(avd_command_builders),
+	KUNIT_CASE(avd_dispatch_reservation),
+	KUNIT_CASE(avd_submit_order),
+	{}
+};
+
+static struct kunit_suite avd_queue_suite = {
+	.name = "apple-avd-queue",
+	.test_cases = avd_queue_cases,
+};
+
+kunit_test_suite(avd_queue_suite);
diff --git a/drivers/media/platform/apple/avd/avd-queue.c b/drivers/media/platform/apple/avd/avd-queue.c
new file mode 100644
index 0000000000..22e40b631a
--- /dev/null
+++ b/drivers/media/platform/apple/avd/avd-queue.c
@@ -0,0 +1,707 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/pm_runtime.h>
+#include <linux/reset.h>
+#include <linux/slab.h>
+#include <linux/sizes.h>
+
+#include "avd.h"
+#include "avd-queue-internal.h"
+
+#define AVD_FRAME_TIMEOUT msecs_to_jiffies(2000)
+/* A stream is stopped at its first frame that fails in hardware. */
+#define AVD_CTX_MAX_HW_ERRORS 1
+/* Never reset the decoder more often than this. */
+#define AVD_RECOVER_GAP_MS 20
+/* A third recovery parks the decoder until AVD_STORM_WINDOW ends. */
+#define AVD_STORM_MAX 2
+#define AVD_STORM_WINDOW msecs_to_jiffies(60000)
+#define AVD_RETRY_DELAY msecs_to_jiffies(1)
+#define AVD_PROGRAM_SIZE SZ_2M
+
+/* PM test fixtures use backends without a transport. */
+static unsigned int avd_max_inflight(struct avd_dev *avd)
+{
+	return avd->backend->max_inflight ? avd->backend->max_inflight(avd) : 1;
+}
+
+bool avd_backend_is_apple(const struct avd_dev *avd)
+{
+	return avd->backend == &avd_apple_backend;
+}
+
+/* Only the CPU callback releases a probability dependency, never the IRQ. */
+static void avd_retire_vp(struct avd_dev *avd)
+{
+	unsigned int i;
+
+	for (i = 0; i < AVD_MAX_FRAMES; i++) {
+		struct avd_frame *f = &avd->frames[i];
+		const struct avd_coded_fmt_ops *ops;
+
+		if (f->state == AVD_FRAME_FREE || !f->vp_done || f->vp_retired)
+			continue;
+		ops = f->ctx->coded_fmt_desc->ops;
+		/* A reset/error must not publish partial symbol counts. */
+		if (!f->status && ops && ops->vp_done) {
+			dma_rmb();
+			ops->vp_done(f->ctx, f->dst);
+		}
+		f->vp_retired = true;
+	}
+}
+
+/* queue_mutex excludes callbacks and context destruction from retirement. */
+static void avd_retire(struct avd_dev *avd)
+{
+	struct avd_frame *f;
+	unsigned long flags;
+	unsigned int i;
+	bool progress;
+
+	do {
+		progress = false;
+		for (i = 0; i < AVD_MAX_FRAMES; i++) {
+			struct avd_ctx *ctx;
+			enum vb2_buffer_state state;
+
+			f = &avd->frames[i];
+			spin_lock_irqsave(&avd->queue_lock, flags);
+			if (f->state != AVD_FRAME_DONE ||
+			    !avd_slot_first(avd->frames, f)) {
+				spin_unlock_irqrestore(&avd->queue_lock, flags);
+				continue;
+			}
+			spin_unlock_irqrestore(&avd->queue_lock, flags);
+			ctx = f->ctx;
+			state = f->status ? VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE;
+			if (!f->status) {
+				ctx->hw_errors = 0;
+			} else if (++ctx->hw_errors >= AVD_CTX_MAX_HW_ERRORS && !ctx->broken) {
+				ctx->broken = true;
+				dev_err(avd->dev, "stream stopped after %u failed frames; restart streaming to retry\n",
+					ctx->hw_errors);
+			}
+			if (ctx->coded_fmt_desc->frame_ops) {
+				if (ctx->coded_fmt_desc->frame_ops->retire)
+					ctx->coded_fmt_desc->frame_ops->retire(ctx, f, state);
+			} else if (ctx->coded_fmt_desc->ops->done) {
+				ctx->coded_fmt_desc->ops->done(ctx, f->src, f->dst, state);
+			}
+			if (ctx->coded_fmt_desc->frame_ops && f->src->vb2_buf.req_obj.req)
+				v4l2_ctrl_request_complete(f->src->vb2_buf.req_obj.req,
+							   &ctx->ctrl_hdl);
+			/* CAPTURE first: OUTPUT completion signals the media request. */
+			if (f->scheduler_held) {
+				v4l2_m2m_buf_done_and_job_finish(avd->m2m_dev,
+								 ctx->fh.m2m_ctx, state);
+			} else {
+				v4l2_m2m_buf_done(f->dst, state);
+				v4l2_m2m_buf_done(f->src, state);
+			}
+			spin_lock_irqsave(&avd->queue_lock, flags);
+			f->ctx = NULL;
+			f->src = NULL;
+			f->dst = NULL;
+			f->state = AVD_FRAME_FREE;
+			avd->inflight--;
+			spin_unlock_irqrestore(&avd->queue_lock, flags);
+			avd_pm_queue_changed(avd);
+			pm_runtime_mark_last_busy(avd->dev);
+			pm_runtime_put_autosuspend(avd->dev);
+			progress = true;
+		}
+	} while (progress);
+}
+
+/* A reset invalidates every firmware-owned slot, including other clients. */
+static void avd_reset_queue(struct avd_dev *avd, int status)
+{
+	struct avd_ctx *ctx;
+	unsigned long flags;
+	unsigned int i;
+	int ret;
+
+	/*
+	 * Every decoder reset is a risk to the whole machine (three hard hangs
+	 * on the J616s followed timeouts and resets), so recover sparingly:
+	 * at least AVD_RECOVER_GAP_MS apart, at most AVD_STORM_MAX times in
+	 * AVD_STORM_WINDOW, and never again after a recovery fails. Exhausting
+	 * the budget parks DMA until the window ends; only a failed recovery
+	 * retires the decoder until the module is reloaded.
+	 */
+	if (avd->faulted) {
+		ret = -ENODEV;
+	} else {
+		if (!avd->storm_count ||
+		    time_after(jiffies, avd->storm_start + AVD_STORM_WINDOW)) {
+			avd->storm_start = jiffies;
+			avd->storm_count = 0;
+		}
+		if (++avd->storm_count > AVD_STORM_MAX) {
+			ret = avd_pm_park(avd);
+			if (!ret) {
+				avd->rest_until = avd->storm_start + AVD_STORM_WINDOW;
+				dev_warn(avd->dev, "decoder resting after repeated resets, new frames fail for up to %u s\n",
+					 jiffies_to_msecs(avd->rest_until - jiffies) / 1000 + 1);
+				ret = -EBUSY;
+			}
+		} else {
+			if (avd->last_recover &&
+			    time_before(jiffies, avd->last_recover +
+					msecs_to_jiffies(AVD_RECOVER_GAP_MS)))
+				msleep(AVD_RECOVER_GAP_MS);
+			ret = avd_pm_recover(avd);
+			avd->last_recover = jiffies ?: 1;
+		}
+		if (ret && !avd->rest_until) {
+			WRITE_ONCE(avd->faulted, true);
+			dev_err(avd->dev, "decoder retired after a failed reset (%d): reload the module to use it again\n",
+				ret);
+		}
+	}
+	avd->compat_active = NULL;
+	list_for_each_entry(ctx, &avd->contexts, queue_node)
+		ctx->session_started = false;
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	for (i = 0; i < AVD_MAX_FRAMES; i++) {
+		if (avd->frames[i].state == AVD_FRAME_FREE)
+			continue;
+		avd->frames[i].status = status;
+		avd->frames[i].state = AVD_FRAME_DONE;
+	}
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	if (!ret)
+		avd_pm_enable_irq(avd);
+}
+
+static int avd_send_frame(struct avd_dev *avd, struct avd_frame *f)
+{
+	unsigned long flags;
+	int ret;
+
+	if (!avd_slot_submit_first(avd->frames, f))
+		return -EBUSY;
+	if (f->dep == AVD_DEP_PREV_DONE && !avd_slot_first(avd->frames, f))
+		return -EBUSY;
+	if ((!f->ctx->session_started ||
+	     f->ctx->session_generation != avd->fw_generation) &&
+	    avd->backend->session_start) {
+		ret = avd->backend->session_start(f->ctx);
+		if (ret)
+			return ret;
+		f->ctx->session_started = true;
+		f->ctx->session_generation = avd->fw_generation;
+	}
+	/* Publish ownership before the doorbell; IRQs may arrive in submit(). */
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	f->state = AVD_FRAME_SUBMITTED;
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	dma_wmb();
+	ret = avd->backend->submit(avd, f);
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	avd_slot_submit_result(f, ret);
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	return ret;
+}
+
+static void avd_queue_worker(struct work_struct *work)
+{
+	struct avd_dev *avd = container_of(to_delayed_work(work),
+					 struct avd_dev, queue_work);
+	struct avd_ctx *ctx;
+	unsigned long flags;
+	unsigned int i;
+	bool pending;
+	unsigned long delay = AVD_FRAME_TIMEOUT;
+
+	mutex_lock(&avd->queue_mutex);
+	if (avd->stopping)
+		goto unlock;
+	for (i = 0; i < AVD_MAX_FRAMES; i++) {
+		bool expired;
+
+		spin_lock_irqsave(&avd->queue_lock, flags);
+		expired = avd_slot_expired(&avd->frames[i], jiffies);
+		spin_unlock_irqrestore(&avd->queue_lock, flags);
+		if (expired) {
+			struct avd_frame *t = &avd->frames[i];
+
+			dev_err(avd->dev, "frame tag %#x timed out (%p4cc, state %d, %u in flight, %s)\n",
+				t->tag, t->ctx ? &t->ctx->coded_fmt_desc->fourcc : &(u32){0},
+				t->state, avd->inflight, avd->backend->name);
+			avd_qfw_debug(avd, t, "timeout");
+			avd_reset_queue(avd, -ETIMEDOUT);
+			break;
+		}
+	}
+	avd_retire_vp(avd);
+	avd_retire(avd);
+	for (i = 0; i < AVD_MAX_FRAMES; i++) {
+		struct avd_frame *f = &avd->frames[i];
+		int ret;
+
+		if (f->state != AVD_FRAME_RESERVED)
+			continue;
+		ret = avd_send_frame(avd, f);
+		if (ret && ret != -EBUSY) {
+			spin_lock_irqsave(&avd->queue_lock, flags);
+			f->status = ret;
+			f->state = AVD_FRAME_DONE;
+			spin_unlock_irqrestore(&avd->queue_lock, flags);
+		}
+	}
+	avd_retire(avd);
+	/* Restart a job that found no free slot. */
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	ctx = avd->inflight < avd_max_inflight(avd) ? avd->deferred_ctx : NULL;
+	if (ctx)
+		avd->deferred_ctx = NULL;
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	if (ctx)
+		schedule_work(&ctx->submit_work);
+	/* Freed slots/dependencies must wake contexts whose job_ready was false. */
+	list_for_each_entry(ctx, &avd->contexts, queue_node)
+		v4l2_m2m_try_schedule(ctx->fh.m2m_ctx);
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	pending = avd->inflight != 0;
+	for (i = 0; i < AVD_MAX_FRAMES; i++) {
+		struct avd_frame *f = &avd->frames[i];
+		unsigned long remaining;
+
+		if (f->state == AVD_FRAME_FREE)
+			continue;
+		remaining = time_after(f->deadline, jiffies) ? f->deadline - jiffies : 0;
+		if (f->state == AVD_FRAME_RESERVED)
+			remaining = min(remaining, AVD_RETRY_DELAY);
+		delay = min(delay, remaining);
+	}
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	if (pending)
+		mod_delayed_work(system_dfl_wq, &avd->queue_work, delay);
+ unlock:
+	mutex_unlock(&avd->queue_mutex);
+}
+
+void avd_frame_complete(struct avd_dev *avd, u32 tag, int status)
+{
+	struct avd_frame *f = &avd->frames[tag & (AVD_MAX_FRAMES - 1)];
+	unsigned long flags;
+	bool accepted;
+
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	accepted = avd_slot_complete(f, tag, status);
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	if (accepted)
+		mod_delayed_work(system_dfl_wq, &avd->queue_work, 0);
+}
+
+/* No buffer, FIFO or descriptor ownership is released by a VP event. */
+void avd_frame_vp_complete(struct avd_dev *avd, u32 tag)
+{
+	struct avd_frame *f = &avd->frames[tag & (AVD_MAX_FRAMES - 1)];
+	unsigned long flags;
+	bool accepted;
+
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	accepted = f->state == AVD_FRAME_SUBMITTED && f->tag == tag && !f->vp_done;
+	if (accepted)
+		f->vp_done = true;
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	if (accepted)
+		mod_delayed_work(system_dfl_wq, &avd->queue_work, 0);
+}
+
+int avd_queue_ready(void *priv)
+{
+	struct avd_ctx *ctx = priv;
+	struct avd_dev *avd = ctx->dev;
+	unsigned long flags;
+	unsigned int i;
+	bool ready;
+
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	/*
+	 * A retired decoder still schedules: submission fails
+	 * those frames at once, so clients see errors instead of waiting.
+	 */
+	/*
+	 * Slot capacity is not a readiness condition: every context with work
+	 * enters the m2m job queue, which runs them in order, and a job that
+	 * finds no free slot is deferred until one retires. Gating readiness on
+	 * one reserved context let the first context in the list win every
+	 * time and starved the others (multi-stream decodes timing out).
+	 */
+	ready = !READ_ONCE(ctx->draining) && !READ_ONCE(avd->stopping);
+	if (ready && ctx->next_dep == AVD_DEP_PREV_DONE) {
+		/* Legacy codecs may hold several pictures in separate banks. */
+		unsigned int limit = ctx->coded_fmt_desc && !ctx->coded_fmt_desc->frame_ops ?
+				     max(ctx->max_frames, 1U) : 1, held = 0;
+
+		for (i = 0; i < AVD_MAX_FRAMES; i++)
+			if (avd->frames[i].state != AVD_FRAME_FREE &&
+			    avd->frames[i].ctx == ctx)
+				held++;
+		ready = held < limit;
+	}
+	if (ready && ctx->coded_fmt_desc && !ctx->coded_fmt_desc->frame_ops &&
+	    ctx->coded_fmt_desc->ops->ready)
+		ready = ctx->coded_fmt_desc->ops->ready(ctx);
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	return ready;
+}
+
+static void avd_queue_submit_work(struct work_struct *work)
+{
+	struct avd_ctx *ctx = container_of(work, struct avd_ctx, submit_work);
+	struct avd_dev *avd = ctx->dev;
+	const struct avd_codec_frame_ops *ops = ctx->coded_fmt_desc->frame_ops;
+	struct avd_frame *f = NULL;
+	unsigned long flags;
+	unsigned int i;
+	int ret;
+
+	mutex_lock(&avd->queue_mutex);
+	/* A queued retry can outlive drain/abort finishing its m2m dispatch. */
+	if (v4l2_m2m_get_curr_priv(avd->m2m_dev) != ctx)
+		goto unlock;
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	if (avd->deferred_ctx == ctx)
+		avd->deferred_ctx = NULL;
+	if (avd->stopping || ctx->draining || READ_ONCE(avd->faulted) || ctx->broken ||
+	    (avd->rest_until && time_before(jiffies, avd->rest_until))) {
+		struct vb2_v4l2_buffer *src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+
+		spin_unlock_irqrestore(&avd->queue_lock, flags);
+		/* Complete the request's controls too, or its fd never signals. */
+		if (src && src->vb2_buf.req_obj.req)
+			v4l2_ctrl_request_complete(src->vb2_buf.req_obj.req, &ctx->ctrl_hdl);
+		v4l2_m2m_buf_done_and_job_finish(avd->m2m_dev, ctx->fh.m2m_ctx,
+						 VB2_BUF_STATE_ERROR);
+		goto unlock;
+	}
+	if (avd->inflight < avd_max_inflight(avd)) {
+		for (i = 0; i < AVD_MAX_FRAMES; i++) {
+			if (avd->frames[i].state == AVD_FRAME_FREE) {
+				f = &avd->frames[i];
+				break;
+			}
+		}
+	}
+	if (!f) {
+		/* Keep the m2m job; the worker restarts it when a slot frees. */
+		avd->deferred_ctx = ctx;
+		spin_unlock_irqrestore(&avd->queue_lock, flags);
+		mod_delayed_work(system_dfl_wq, &avd->queue_work, 0);
+		goto unlock;
+	}
+	ret = avd_slot_reserve(f, ctx, ++avd->frame_seq);
+	if (!ret)
+		avd->inflight++;
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	if (WARN_ON(ret)) {
+		v4l2_m2m_buf_done_and_job_finish(avd->m2m_dev, ctx->fh.m2m_ctx,
+						 VB2_BUF_STATE_ERROR);
+		goto unlock;
+	}
+	ret = pm_runtime_resume_and_get(avd->dev);
+	if (ret < 0)
+		goto fail_no_pm;
+	f->src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	f->dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+	/*
+	 * Partial slices retain CAPTURE through the ordinary m2m HOLD API.
+	 * Final slices detach both buffers and release dispatch atomically;
+	 * neither DMA-owned buffer is completed by that early handoff.
+	 */
+	f->scheduler_held = (ctx->fh.m2m_ctx->out_q_ctx.q.subsystem_flags &
+			     VB2_V4L2_FL_SUPPORTS_M2M_HOLD_CAPTURE_BUF) &&
+			    (f->src->flags & V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF);
+	f->frame_num = f->tag;
+	f->deadline = jiffies + AVD_FRAME_TIMEOUT;
+	if (avd->rest_until) {
+		/* Reset while still parked; retain the recovery pacing at expiry. */
+		if (avd->last_recover &&
+		    time_before(jiffies, avd->last_recover +
+				msecs_to_jiffies(AVD_RECOVER_GAP_MS)))
+			msleep(AVD_RECOVER_GAP_MS);
+		ret = avd_pm_recover(avd);
+		avd->last_recover = jiffies ?: 1;
+		if (ret) {
+			WRITE_ONCE(avd->faulted, true);
+			dev_err(avd->dev, "decoder retired after a failed wake (%d)\n", ret);
+			goto fail;
+		}
+		avd->rest_until = 0;
+		avd->storm_count = 0;
+		avd_pm_enable_irq(avd);
+	}
+	memset(f->cmd, 0, sizeof(f->cmd));
+	if (ops) {
+		if (!f->prog->cpu) {
+			ret = avd_buf_alloc(avd, f->prog, AVD_PROGRAM_SIZE);
+			if (ret)
+				goto fail;
+		}
+		/* NULL fp is also the codec-facing indication of an open program. */
+		f->fp = NULL;
+		if (avd_backend_is_apple(avd)) {
+			struct avd_buf *fp = avd->frame_fp[f->idx];
+
+			if (!fp) {
+				fp = devm_kzalloc(avd->dev, sizeof(*fp), GFP_KERNEL);
+				avd->frame_fp[f->idx] = fp;
+			}
+			f->fp = fp;
+			if (!f->fp) {
+				ret = -ENOMEM;
+				goto fail;
+			}
+			if (!f->fp->cpu) {
+				ret = avd_buf_alloc(avd, f->fp, avd->variant->fp_size);
+				if (ret)
+					goto fail;
+			}
+		}
+		if (f->src->vb2_buf.req_obj.req) {
+			ret = v4l2_ctrl_request_setup(f->src->vb2_buf.req_obj.req, &ctx->ctrl_hdl);
+			if (ret)
+				goto fail;
+		}
+		ret = ops->prepare(ctx, f);
+	} else {
+		avd->building = f;
+		avd->compat_held = false;
+		ret = ctx->coded_fmt_desc->ops->run(ctx);
+		avd->building = NULL;
+	}
+	if (ret)
+		goto fail;
+	ctx->next_dep = ops ? f->dep : AVD_DEP_PREV_DONE;
+	if ((ops && (f->src->flags & V4L2_BUF_FLAG_M2M_HOLD_CAPTURE_BUF)) ||
+	    (!ops && avd->compat_held)) {
+		if (ops && ops->retire)
+			ops->retire(ctx, f, VB2_BUF_STATE_DONE);
+		else if (!ops && ctx->coded_fmt_desc->ops->done)
+			ctx->coded_fmt_desc->ops->done(ctx, f->src, f->dst, VB2_BUF_STATE_DONE);
+		if (ops && f->src->vb2_buf.req_obj.req)
+			v4l2_ctrl_request_complete(f->src->vb2_buf.req_obj.req, &ctx->ctrl_hdl);
+		spin_lock_irqsave(&avd->queue_lock, flags);
+		f->state = AVD_FRAME_FREE;
+		f->ctx = NULL;
+		avd->inflight--;
+		spin_unlock_irqrestore(&avd->queue_lock, flags);
+		avd_pm_queue_changed(avd);
+		pm_runtime_mark_last_busy(avd->dev);
+		pm_runtime_put_autosuspend(avd->dev);
+		v4l2_m2m_buf_done_and_job_finish(avd->m2m_dev, ctx->fh.m2m_ctx,
+						 VB2_BUF_STATE_DONE);
+		goto unlock;
+	}
+	v4l2_m2m_buf_copy_metadata(f->src, f->dst);
+	ret = avd_send_frame(avd, f);
+	if (ret && ret != -EBUSY) {
+		spin_lock_irqsave(&avd->queue_lock, flags);
+		f->status = ret;
+		f->state = AVD_FRAME_DONE;
+		spin_unlock_irqrestore(&avd->queue_lock, flags);
+	}
+	/* Atomically detach both buffers to the slot and release dispatch. */
+	if (!f->scheduler_held)
+		v4l2_m2m_job_finish_detach(avd->m2m_dev, ctx->fh.m2m_ctx);
+	mod_delayed_work(system_dfl_wq, &avd->queue_work, 0);
+	goto unlock;
+ fail:
+	/* Failed preparation still transfers its buffers before retirement. */
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	f->status = ret;
+	f->state = AVD_FRAME_DONE;
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	if (!f->scheduler_held)
+		v4l2_m2m_job_finish_detach(avd->m2m_dev, ctx->fh.m2m_ctx);
+	mod_delayed_work(system_dfl_wq, &avd->queue_work, 0);
+	goto unlock;
+ fail_no_pm:
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	f->state = AVD_FRAME_FREE;
+	f->ctx = NULL;
+	avd->inflight--;
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	avd_pm_queue_changed(avd);
+	v4l2_m2m_buf_done_and_job_finish(avd->m2m_dev, ctx->fh.m2m_ctx,
+					 VB2_BUF_STATE_ERROR);
+ unlock:
+	mutex_unlock(&avd->queue_mutex);
+}
+
+void avd_queue_run(void *priv)
+{
+	struct avd_ctx *ctx = priv;
+
+	/* try_schedule() may invoke device_run synchronously under queue_mutex. */
+	schedule_work(&ctx->submit_work);
+}
+
+/* True while any slot still belongs to @ctx; the caller holds no queue lock. */
+static bool avd_ctx_has_frames(struct avd_dev *avd, struct avd_ctx *ctx)
+{
+	unsigned long flags;
+	unsigned int i;
+	bool busy = false;
+
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	for (i = 0; i < AVD_MAX_FRAMES; i++)
+		if (avd->frames[i].state != AVD_FRAME_FREE && avd->frames[i].ctx == ctx)
+			busy = true;
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	return busy;
+}
+
+void avd_queue_drain(struct avd_ctx *ctx)
+{
+	struct avd_dev *avd = ctx->dev;
+	unsigned long flags;
+	unsigned int i;
+	bool finish_deferred = false;
+	int ret;
+
+	/* Session stop/reset accesses registers even when there are no frames. */
+	ret = pm_runtime_resume_and_get(avd->dev);
+	avd_pm_drain_begin(avd);
+	mutex_lock(&avd->queue_mutex);
+	spin_lock_irqsave(&avd->queue_lock, flags);
+	WRITE_ONCE(ctx->draining, true);
+	if (avd->deferred_ctx == ctx) {
+		avd->deferred_ctx = NULL;
+		finish_deferred = true;
+	}
+	/* Prepared but never handed to the decoder: nothing to wait for. */
+	for (i = 0; i < AVD_MAX_FRAMES; i++) {
+		struct avd_frame *f = &avd->frames[i];
+
+		if (f->ctx == ctx && f->state == AVD_FRAME_RESERVED) {
+			f->status = -ECANCELED;
+			f->state = AVD_FRAME_DONE;
+		}
+	}
+	spin_unlock_irqrestore(&avd->queue_lock, flags);
+	/* A deferred job is still m2m's running job: end it so abort can wait. */
+	if (finish_deferred)
+		v4l2_m2m_buf_done_and_job_finish(avd->m2m_dev, ctx->fh.m2m_ctx,
+						 VB2_BUF_STATE_ERROR);
+	avd_retire(avd);
+
+	/*
+	 * Frames the decoder already owns finish on their own, or the queue
+	 * worker times them out and recovers. Closing one stream must not reset
+	 * the decoder under every other stream's frames: that reset, with their
+	 * DMA in flight, preceded the J616s hangs. Wait for this context's own
+	 * frames instead, without the queue mutex so the worker can retire them.
+	 */
+	if (ret >= 0 && !avd->stopping && avd_ctx_has_frames(avd, ctx)) {
+		mod_delayed_work(system_dfl_wq, &avd->queue_work, 0);
+		mutex_unlock(&avd->queue_mutex);
+		wait_event_timeout(avd->pm.idle_wait, !avd_ctx_has_frames(avd, ctx),
+				   AVD_FRAME_TIMEOUT + msecs_to_jiffies(1000));
+		mutex_lock(&avd->queue_mutex);
+		avd_retire(avd);
+	}
+	/* Last resort (worker stopped or wedged): cancel through a reset. */
+	for (i = 0; ret >= 0 && i < AVD_MAX_FRAMES; i++) {
+		if (avd->frames[i].state != AVD_FRAME_FREE && avd->frames[i].ctx == ctx) {
+			dev_warn(avd->dev, "stream close: frames still owned by the decoder, resetting\n");
+			if (avd->backend->abort)
+				avd->backend->abort(ctx);
+			avd_reset_queue(avd, -ECANCELED);
+			break;
+		}
+	}
+	avd_retire(avd);
+	if (ret >= 0 && ctx->session_started && avd->backend->session_stop &&
+	    ctx->session_generation == avd->fw_generation)
+		avd->backend->session_stop(ctx);
+	ctx->session_started = false;
+	if (!avd->stopping)
+		mod_delayed_work(system_dfl_wq, &avd->queue_work, 0);
+	mutex_unlock(&avd->queue_mutex);
+	avd_pm_drain_end(avd);
+	if (ret >= 0) {
+		pm_runtime_mark_last_busy(avd->dev);
+		pm_runtime_put_autosuspend(avd->dev);
+	}
+}
+
+void avd_queue_abort(void *priv)
+{
+	avd_queue_drain(priv);
+}
+
+void avd_queue_add_ctx(struct avd_ctx *ctx)
+{
+	struct avd_ctx *other;
+	u32 id;
+
+	INIT_WORK(&ctx->submit_work, avd_queue_submit_work);
+	mutex_lock(&ctx->dev->queue_mutex);
+	/* Borage decode prefix has ten client bits. */
+	for (id = 0; id < 1024; id++) {
+		bool used = false;
+
+		list_for_each_entry(other, &ctx->dev->contexts, queue_node)
+			used |= other->client_id == id;
+		if (!used)
+			break;
+	}
+	ctx->client_id = id;
+	list_add_tail(&ctx->queue_node, &ctx->dev->contexts);
+	mutex_unlock(&ctx->dev->queue_mutex);
+}
+
+void avd_queue_del_ctx(struct avd_ctx *ctx)
+{
+	avd_queue_drain(ctx);
+	mutex_lock(&ctx->dev->queue_mutex);
+	if (ctx->dev->compat_ctx == ctx)
+		ctx->dev->compat_ctx = NULL;
+	list_del_init(&ctx->queue_node);
+	mutex_unlock(&ctx->dev->queue_mutex);
+}
+
+int avd_queue_init(struct avd_dev *avd)
+{
+	unsigned int i;
+
+	spin_lock_init(&avd->queue_lock);
+	mutex_init(&avd->queue_mutex);
+	INIT_LIST_HEAD(&avd->contexts);
+	INIT_DELAYED_WORK(&avd->queue_work, avd_queue_worker);
+	for (i = 0; i < AVD_MAX_FRAMES; i++) {
+		struct avd_frame *f = &avd->frames[i];
+
+		f->idx = i;
+		f->prog = devm_kzalloc(avd->dev, sizeof(*f->prog), GFP_KERNEL);
+		if (!f->prog)
+			return -ENOMEM;
+	}
+	return 0;
+}
+
+void avd_queue_cleanup(struct avd_dev *avd)
+{
+	unsigned int i;
+
+	mutex_lock(&avd->queue_mutex);
+	WRITE_ONCE(avd->stopping, true);
+	if (avd->inflight) {
+		avd_reset_queue(avd, -ESHUTDOWN);
+		avd_retire(avd);
+	}
+	mutex_unlock(&avd->queue_mutex);
+	cancel_delayed_work_sync(&avd->queue_work);
+	for (i = 0; i < AVD_MAX_FRAMES; i++) {
+		avd_buf_free(avd, avd->frames[i].prog);
+		if (avd->frame_fp[i])
+			avd_buf_free(avd, avd->frame_fp[i]);
+	}
+}
