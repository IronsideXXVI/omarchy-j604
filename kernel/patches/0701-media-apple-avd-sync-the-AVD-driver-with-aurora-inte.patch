diff --git a/drivers/media/platform/apple/avd/avd-backend-apple.c b/drivers/media/platform/apple/avd/avd-backend-apple.c
new file mode 100644
index 0000000000..aaa06ba8c9
--- /dev/null
+++ b/drivers/media/platform/apple/avd/avd-backend-apple.c
@@ -0,0 +1,317 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <linux/firmware.h>
+#include <linux/iopoll.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+#include "avd.h"
+#include "avd-apple-protocol.h"
+#include "avd-queue-internal.h"
+
+/* SPEC 3.2. Unknown field meanings are intentionally not named. */
+const u8 avd_borage_config[64] = {
+	[0x0a] = 0x55, [0x0b] = 0x01, /* +0x08: 0x01558000 */
+	[0x09] = 0x80,
+	[0x11] = 0x8a, [0x12] = 0x55, [0x13] = 0x01,
+	[0x19] = 0x8e, [0x1a] = 0x55, [0x1b] = 0x01,
+	[0x28] = 0x0a, [0x2a] = 0x04,
+	[0x2c] = 0x04,
+	[0x38] = 0x08, [0x3a] = 0x10, [0x3b] = 0x01,
+};
+
+/*
+ * Source: clean SPEC 3-5, AppleAVD 993.1 / T6040 Borage. The SPEC does
+ * not supply the ITCM/version register offsets, link register operations or
+ * reply field layout. Do not substitute V3/open-firmware offsets for them.
+ * avd-protocol.rst records every unresolved field and its source/capture.
+ */
+const struct avd_apple_hw avd_borage_hw = {
+	.fw_name = "apple/avd-apple-t6040.bin",
+	.verified = false,
+};
+
+struct avd_apple {
+	void __iomem *regs;
+	const struct avd_apple_hw *hw;
+	const struct firmware *image;
+	u32 shadow[AVD_APPLE_SHADOW_SIZE];
+	unsigned int shadow_read;
+	unsigned int shadow_write;
+	unsigned int producer;
+	u32 version;
+};
+
+static void avd_apple_release_image(void *data)
+{
+	struct avd_apple *apple = data;
+
+	release_firmware(apple->image);
+}
+
+static int avd_apple_image_present(struct avd_apple *apple)
+{
+	const struct avd_apple_hw *hw = apple->hw;
+	u32 start = readl(apple->regs + hw->itcm_start);
+	u32 end = readl(apple->regs + hw->itcm_end);
+	u32 version;
+
+	if (end <= start || end - start < 4 || end - start > hw->imem_size ||
+	    hw->version_offset > end - start - 4)
+		return -ENOENT;
+	version = readl(apple->regs + hw->imem + hw->version_offset);
+	if (!version || version == U32_MAX)
+		return -ENOENT;
+	apple->version = version;
+	return 0;
+}
+
+static int avd_apple_probe(struct avd_dev *avd)
+{
+	const struct avd_apple_hw *hw = avd->variant->apple;
+	struct avd_apple *apple;
+	int ret;
+
+	if (!hw || !hw->verified || !hw->reply.verified) {
+		dev_info(avd->dev, "Apple transport awaits Borage register/reply facts; using open firmware\n");
+		return -EOPNOTSUPP;
+	}
+	apple = devm_kzalloc(avd->dev, sizeof(*apple), GFP_KERNEL);
+	if (!apple)
+		return -ENOMEM;
+	apple->hw = hw;
+	apple->regs = devm_platform_ioremap_resource_byname(avd->pdev, "apple");
+	if (IS_ERR(apple->regs))
+		return PTR_ERR(apple->regs);
+	/* Firmware bytes remain in vendorfw; this driver never embeds an image. */
+	ret = firmware_request_nowarn(&apple->image, hw->fw_name, avd->dev);
+	if (ret && ret != -ENOENT)
+		return ret;
+	ret = devm_add_action_or_reset(avd->dev, avd_apple_release_image, apple);
+	if (ret)
+		return ret;
+	avd->backend_priv = apple;
+	return 0;
+}
+
+static int avd_apple_load(struct avd_dev *avd)
+{
+	struct avd_apple *apple = avd->backend_priv;
+	const struct avd_apple_hw *hw = apple->hw;
+	const struct firmware *fw = apple->image;
+	size_t i, rounded;
+
+	if (!fw)
+		return -ENOENT;
+	if (!fw->size || fw->size > hw->imem_size ||
+	    hw->imem_size < 4 || hw->version_offset > hw->imem_size - 4)
+		return -EINVAL;
+	rounded = ALIGN(fw->size, 4);
+	if (rounded > hw->imem_size)
+		return -EFBIG;
+	writel(hw->itcm_clear_value, apple->regs + hw->itcm_clear);
+	writel(0, apple->regs + hw->itcm_start);
+	writel(rounded, apple->regs + hw->itcm_end);
+	/* Bounded word copies pad the last word without reading past fw->data. */
+	for (i = 0; i < rounded; i += 4) {
+		u8 bytes[4] = {};
+
+		memcpy(bytes, fw->data + i, min_t(size_t, 4, fw->size - i));
+		writel(get_unaligned_le32(bytes), apple->regs + hw->imem + i);
+	}
+	writel(hw->itcm_enable_value, apple->regs + hw->itcm_enable);
+	return avd_apple_image_present(apple);
+}
+
+static int avd_apple_boot(struct avd_dev *avd)
+{
+	struct avd_apple *apple = avd->backend_priv;
+	const struct avd_apple_hw *hw = apple->hw;
+	u32 value;
+	int ret;
+
+	ret = avd_apple_image_present(apple);
+	if (ret) {
+		ret = avd_apple_load(avd);
+		if (ret)
+			return ret;
+	} else {
+		/* Suspend stopped the MCPU without clearing the retained image. */
+		writel(hw->itcm_enable_value, apple->regs + hw->itcm_enable);
+	}
+	dev_info(avd->dev, "Apple MCPU firmware %u.%u.%u (%08x)\n",
+		 apple->version >> 8, (apple->version >> 4) & 0xf,
+		 apple->version & 0xf, apple->version);
+	/* SPEC 3.2: decode connection, aperture 1, state 4, then LinkUp. */
+	writel(hw->link_setup_value, apple->regs + hw->link_setup);
+	ret = readl_poll_timeout(apple->regs + hw->link_state, value,
+				 value == 4, 10, 10000);
+	if (ret)
+		return ret;
+	writel(hw->link_up_value, apple->regs + hw->link_up);
+	ret = readl_poll_timeout(apple->regs + hw->ready, value,
+				 value == 1, 10, 10000);
+	if (!ret) {
+		apple->producer = 0;
+		apple->shadow_read = 0;
+		apple->shadow_write = 0;
+	}
+	return ret;
+}
+
+static void avd_apple_shutdown(struct avd_dev *avd)
+{
+	struct avd_apple *apple = avd->backend_priv;
+
+	/* MCPU disable value must be proved together with enable in the ledger. */
+	writel(0, apple->regs + apple->hw->itcm_enable);
+}
+
+static unsigned int avd_apple_max_inflight(struct avd_dev *avd)
+{
+	/*
+	 * Every frame in VP->PP flight owns one hardware instruction FIFO
+	 * (EXEC bits 7:4), so the FIFO count bounds the frames in flight:
+	 * 15 on v3+ tier 1 parts, 7 on T8103 and T8140.
+	 */
+	return min_t(unsigned int, AVD_MAX_FRAMES, avd->variant->fifo_slots ?: 1);
+}
+
+static int avd_apple_send(struct avd_dev *avd, const u32 cmd[24])
+{
+	struct avd_apple *apple = avd->backend_priv;
+	const struct avd_apple_hw *hw = apple->hw;
+	unsigned int consumer = readl(apple->regs + hw->inbox_consumer) & 7;
+	u32 address = AVD_APPLE_INBOX_BASE + apple->producer * AVD_APPLE_COMMAND_SIZE;
+	unsigned int i;
+
+	if (avd_inbox_full(apple->producer, consumer))
+		return -EBUSY;
+	for (i = 0; i < 24; i++)
+		writel(cmd[i], apple->regs + address - hw->aperture_origin + i * 4);
+	/* MMIO commands and coherent fp payload precede the four-byte doorbell. */
+	wmb();
+	writel(avd_apple_notification(apple->producer), apple->regs + hw->notify);
+	apple->producer = (apple->producer + 1) & 7;
+	return 0;
+}
+
+static int avd_apple_session_start(struct avd_ctx *ctx)
+{
+	u32 cmd[24] = {};
+
+	if (avd_apple_session_command(cmd, ctx->client_id, 0, 0, 0))
+		return -EINVAL;
+	return avd_apple_send(ctx->dev, cmd);
+}
+
+static void avd_apple_session_stop(struct avd_ctx *ctx)
+{
+	u32 cmd[24] = {};
+
+	if (avd_apple_session_command(cmd, ctx->client_id, 2, 0, 0))
+		return;
+	if (avd_apple_send(ctx->dev, cmd))
+		dev_warn(ctx->dev->dev, "session stop inbox full\n");
+}
+
+static void avd_apple_abort(struct avd_ctx *ctx)
+{
+	u32 cmd[24] = {};
+
+	if (avd_apple_session_command(cmd, ctx->client_id, 5, 0, 0))
+		return;
+	/* Core follows abort with reset before returning any DMA buffer. */
+	avd_apple_send(ctx->dev, cmd);
+}
+
+static int avd_apple_set_property(struct avd_ctx *ctx, u32 property, u32 value)
+{
+	u32 cmd[24] = {};
+
+	if (avd_apple_session_command(cmd, ctx->client_id, 6, property, value))
+		return -EINVAL;
+	return avd_apple_send(ctx->dev, cmd);
+}
+
+static int avd_apple_submit(struct avd_dev *avd, struct avd_frame *f)
+{
+	const struct avd_codec_frame_ops *ops = f->ctx->coded_fmt_desc->frame_ops;
+	u32 selector;
+	int ret;
+
+	if (!ops || !ops->pack_cmd || !f->fp->cpu || f->ctx->client_id >= 1024)
+		return -EOPNOTSUPP;
+	/* SPEC 5.2 prefix precedes the codec-specific builder. */
+	selector = get_unaligned_le32(f->fp->cpu + 4) & 0xf;
+	ret = avd_apple_decode_prefix(f, f->ctx->client_id, selector, f->seq & 3);
+	if (ret)
+		return ret;
+	ret = ops->pack_cmd(f->ctx, f);
+	if (ret)
+		return ret;
+	return avd_apple_send(avd, f->cmd);
+}
+
+static irqreturn_t avd_apple_irq(struct avd_dev *avd)
+{
+	struct avd_apple *apple = avd->backend_priv;
+	const struct avd_apple_hw *hw = apple->hw;
+	unsigned int budget = AVD_APPLE_SHADOW_SIZE;
+
+	while (budget-- && (readl(apple->regs + hw->receive_status) & hw->receive_pending)) {
+		unsigned int next = (apple->shadow_write + 1) & 63;
+
+		if (next == apple->shadow_read)
+			break;
+		apple->shadow[apple->shadow_write] = readl(apple->regs + hw->receive);
+		apple->shadow_write = next;
+		writel(hw->receive_ack_value, apple->regs + hw->receive_ack);
+	}
+	while (apple->shadow_read != apple->shadow_write) {
+		u32 record[AVD_APPLE_RESULT_WORDS];
+		struct avd_apple_reply reply;
+		unsigned int i;
+		int ret;
+
+		/* Result notification indexing must be verified with the layout. */
+		u32 index = apple->shadow[apple->shadow_read];
+
+		apple->shadow_read = (apple->shadow_read + 1) & 63;
+		if (index >= AVD_APPLE_SHADOW_SIZE)
+			continue;
+		for (i = 0; i < AVD_APPLE_RESULT_WORDS; i++)
+			record[i] = readl(apple->regs + hw->result_base +
+					  index * sizeof(record) + i * 4);
+		ret = avd_apple_parse_reply(record, ARRAY_SIZE(record), &hw->reply, &reply);
+		if (ret)
+			continue;
+		for (i = 0; i < AVD_MAX_FRAMES; i++) {
+			struct avd_frame *f = &avd->frames[i];
+
+			if (f->state == AVD_FRAME_SUBMITTED && f->frame_num == reply.frame &&
+			    f->ctx->client_id == reply.client) {
+				dma_rmb();
+				avd_frame_complete(avd, f->tag, reply.status);
+				break;
+			}
+		}
+	}
+	mod_delayed_work(system_dfl_wq, &avd->queue_work, 0);
+	return IRQ_HANDLED;
+}
+
+const struct avd_backend_ops avd_apple_backend = {
+	.name = "apple-mcpu",
+	.probe = avd_apple_probe,
+	.boot = avd_apple_boot,
+	.shutdown = avd_apple_shutdown,
+	.max_inflight = avd_apple_max_inflight,
+	.session_start = avd_apple_session_start,
+	.session_stop = avd_apple_session_stop,
+	.submit = avd_apple_submit,
+	.abort = avd_apple_abort,
+	.set_property = avd_apple_set_property,
+	.irq = avd_apple_irq,
+	.suspend = avd_pm_backend_suspend,
+	.resume = avd_pm_backend_resume,
+};
diff --git a/drivers/media/platform/apple/avd/avd-backend-open.c b/drivers/media/platform/apple/avd/avd-backend-open.c
new file mode 100644
index 0000000000..d2054d06f9
--- /dev/null
+++ b/drivers/media/platform/apple/avd/avd-backend-open.c
@@ -0,0 +1,286 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Legacy transport split from avd-drv.c; Copyright The Asahi Linux Contributors. */
+#include <linux/delay.h>
+#include <linux/iopoll.h>
+#include <linux/jiffies.h>
+#include <linux/overflow.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "avd.h"
+#include "avd-inst.h"
+#include "avd-regs.h"
+
+/*
+ * Compatibility transport for firmware without the queued-program ABI. The
+ * codec's CPU builder emits a per-slot DMA-visible instruction stream. Only
+ * this backend touches the VP FIFO. Its untagged PP interrupt limits it to one
+ * frame; the queued avd-fw transport can replace these ops without changing
+ * buffer ownership in the core.
+ */
+int avd_open_build_program(struct avd_ctx *ctx)
+{
+	struct avd_dev *avd = ctx->dev;
+	struct avd_frame *f = avd->building;
+	struct avd_job *job = &ctx->job;
+	size_t count = 1, pos = 0, i, j;
+	u32 *words, mask, start, fifo;
+	int ret;
+
+	if (!f || !job->segments)
+		return -EINVAL;
+	for (i = 0; i <= job->num; i++) {
+		if (job->segments[i].num > AVD_MAX_INST ||
+		    check_add_overflow(count, job->segments[i].num + !!i, &count))
+			return -EOVERFLOW;
+	}
+	if (count > SIZE_MAX / sizeof(u32))
+		return -EOVERFLOW;
+	if (f->prog->size < count * sizeof(u32)) {
+		ret = avd_buf_alloc(avd, f->prog, count * sizeof(u32));
+		if (ret)
+			return ret;
+	}
+	mask = job->codec == AVD_CODEC_VP9 && avd->variant->revision == 3 ?
+		AVD_OP_EXEC_REV3_VP9_MASK : 0;
+	start = AVD_OP_EXEC_FLAG_START_REV4(avd->variant->revision == 4) |
+		AVD_OP_EXEC_FLAG_START_REV3(avd->variant->revision == 3);
+	/* The queued transport gives every frame in flight its own FIFO. */
+	ctx->fifo_idx = avd_backend_is_qfw(avd) ? f->idx : 0;
+	fifo = AVD_OP_EXEC_FIFO_IDX(ctx->fifo_idx);
+	f->fifo_iova = ctx->job_fifo ?: ctx->inst.addr;
+	ctx->job_fifo = 0;
+	words = f->prog->cpu;
+	words[pos++] = AVD_OP_EXEC | mask | start | fifo;
+	for (i = 0; i <= job->num; i++) {
+		for (j = 0; j < job->segments[i].num; j++)
+			words[pos++] = job->segments[i].instructions[j];
+		if (i)
+			words[pos++] = AVD_OP_EXEC | mask | fifo |
+				       AVD_OP_EXEC_FLAG_END(i == job->num);
+	}
+	f->prog_words = pos;
+	f->cmd[0] = job->codec;
+	/* A mailbox retry may outlive the next preparation on this context. */
+	f->cmd[1] = avd_backend_is_qfw(avd) && ctx->coded_fmt_desc->ops->pp_kicks ?
+		    ctx->coded_fmt_desc->ops->pp_kicks(ctx) - 1 : 0;
+	kvfree(job->segments);
+	job->segments = NULL;
+	return 0;
+}
+
+static unsigned int avd_open_max_inflight(struct avd_dev *avd)
+{
+	return 1;
+}
+
+static int avd_open_submit(struct avd_dev *avd, struct avd_frame *f)
+{
+	struct avd_ctx *ctx = f->ctx;
+	u32 codec = f->cmd[0], vp = 0;
+	u32 *words = f->prog->cpu;
+	unsigned int i;
+	void __iomem *reg;
+	u32 max;
+
+	if (avd->compat_active)
+		return -EBUSY;
+	/* Native frame_ops require firmware-side PP chaining and tagged replies. */
+	if (ctx->coded_fmt_desc->frame_ops)
+		return -EOPNOTSUPP;
+	if (codec > AVD_CODEC_AV1 || !words || !f->prog_words ||
+	    f->prog_words > f->prog->size / sizeof(u32))
+		return -EINVAL;
+	if (!(avd->capabilities & BIT(codec)))
+		return -EOPNOTSUPP;
+	for (i = 0; i < codec; i++)
+		vp += avd->variant->vp_slots[i];
+	if (avd->variant->vp_slot_base[codec])
+		vp = avd->variant->vp_slot_base[codec];
+	avd->variant->configure_stream(avd, ctx->inst.addr, ctx->fifo_idx, vp);
+	reg = avd->ctrl + avd->variant->vp_slot_offset + vp * 4;
+	avd->compat_active = f;
+	avd->compat_ctx = ctx;
+	avd->compat_pp_kicked = false;
+	max = readl(avd->ctrl + avd->variant->submit_queue_max_offset + vp * 4);
+	for (i = 0; i < f->prog_words; i++) {
+		/*
+		 * Never write the VP FIFO register without room in its queue: a
+		 * write the block cannot accept may stall the bus. The old driver
+		 * only looked between segments, and programs exceed the 128-word
+		 * queue. Wait a bounded time for room, then give the frame to
+		 * the watchdog instead of writing.
+		 */
+		if (max) {
+			u32 cur = readl(avd->ctrl +
+					avd->variant->submit_queue_status_offset + vp * 4);
+
+			if (cur >= max &&
+			    readl_relaxed_poll_timeout(avd->ctrl +
+					avd->variant->submit_queue_status_offset + vp * 4,
+					cur, cur < max, 5, 2000)) {
+				dev_err_ratelimited(avd->dev,
+						    "VP%u queue full (%u/%u), not writing\n",
+						    vp, cur, max);
+				f->deadline = jiffies;
+				return 0;
+			}
+		}
+		writel(words[i], reg);
+	}
+	return 0;
+}
+
+static irqreturn_t avd_open_irq(struct avd_dev *avd)
+{
+	struct avd_frame *f = avd->compat_active;
+	u32 status;
+
+	if (!avd_mbox_pop(avd, &status))
+		return IRQ_HANDLED;
+	if (!f) {
+		/*
+		 * The old driver kicked PP for every VP DONE. A VP DONE with no
+		 * frame in flight (its frame already completed on a surplus PP
+		 * DONE of a multi-kick picture) still needs that kick, or the
+		 * next picture's PP is never started and it times out.
+		 */
+		if ((status & 0x11000) == 0 && (status & 0x100) && avd->compat_ctx &&
+		    avd->compat_ctx->coded_fmt_desc->ops->submit)
+			avd->compat_ctx->coded_fmt_desc->ops->submit(avd->compat_ctx);
+		return IRQ_HANDLED;
+	}
+	if (status & 0x1000) {
+		/*
+		 * Only the PP this driver kicked for the active frame can finish
+		 * it. A surplus PP DONE of a multi-kick picture used to complete
+		 * the next frame early, so userspace reused its buffers while the
+		 * engine was still writing them.
+		 */
+		if (!avd->compat_pp_kicked) {
+			dev_dbg_ratelimited(avd->dev, "PP DONE before the frame's VP, ignored\n");
+			return IRQ_HANDLED;
+		}
+		avd->compat_active = NULL;
+		avd->compat_pp_kicked = false;
+		avd_frame_complete(avd, f->tag, 0);
+	} else if (status & 0x100) {
+		/* Old firmware only: no request tag and no firmware-side PP kick. */
+		if (f->ctx->coded_fmt_desc->ops->submit)
+			f->ctx->coded_fmt_desc->ops->submit(f->ctx);
+		avd->compat_pp_kicked = true;
+	} else {
+		dev_err_ratelimited(avd->dev, "open firmware error %#x\n", status);
+		f->deadline = jiffies;
+		mod_delayed_work(system_dfl_wq, &avd->queue_work, 0);
+	}
+	return IRQ_HANDLED;
+}
+
+const struct avd_backend_ops avd_open_backend = {
+	.name = "open-compat",
+	.boot = avd_boot,
+	.shutdown = avd_shutdown,
+	.max_inflight = avd_open_max_inflight,
+	.submit = avd_open_submit,
+	.irq = avd_open_irq,
+	.suspend = avd_pm_backend_suspend,
+	.resume = avd_pm_backend_resume,
+};
+
+static void avd_open_capabilities(struct avd_dev *avd)
+{
+	static const struct {
+		const char *name;
+		u32 bit;
+	} codecs[] = {
+		{ "h265", AVD_CAPABILITY_HEVC },
+		{ "h264", AVD_CAPABILITY_H264 },
+		{ "vp9", AVD_CAPABILITY_VP9 },
+		{ "av1", AVD_CAPABILITY_AV1 },
+	};
+	const char *info;
+	unsigned int i;
+
+	/* Without a CODECS trailer, keep codecs that need a newer firmware hidden. */
+	avd->capabilities = avd->variant->capabilities &
+			    ~avd->variant->fw_caps_required;
+	avd->fw_capabilities = avd->capabilities;
+	if (!avd->fw || avd->fw->size < 0x40)
+		return;
+	info = (const char *)avd->fw->data + avd->fw->size - 0x40;
+	if (memcmp(info, "CODECS:", 7))
+		return;	/* fw_capabilities already set above */
+	avd->capabilities = 0;
+	for (i = 0; i < ARRAY_SIZE(codecs); i++)
+		if (strnstr(info, codecs[i].name, 0x40))
+			avd->capabilities |= avd->variant->capabilities & codecs[i].bit;
+	avd->fw_capabilities = avd->capabilities;
+}
+
+static int avd_open_request_firmware(struct avd_dev *avd)
+{
+	int ret;
+
+	if (!avd->variant->fw_name_fallback)
+		return request_firmware(&avd->fw, avd->variant->fw_name, avd->dev);
+	ret = firmware_request_nowarn(&avd->fw, avd->variant->fw_name, avd->dev);
+	if (ret != -ENOENT)
+		return ret;
+	dev_info(avd->dev, "%s not installed, using %s\n",
+		 avd->variant->fw_name, avd->variant->fw_name_fallback);
+	return request_firmware(&avd->fw, avd->variant->fw_name_fallback, avd->dev);
+}
+
+int avd_backend_select(struct avd_dev *avd)
+{
+	int ret;
+
+	/* Apple probe returns -ENOENT only when no usable image is present. */
+	if (avd->variant->apple) {
+		ret = avd_apple_backend.probe(avd);
+		if (!ret) {
+			avd->backend = &avd_apple_backend;
+			avd->capabilities = avd->variant->capabilities;
+			return 0;
+		}
+		if (ret != -ENOENT && ret != -EOPNOTSUPP)
+			return ret;
+	}
+	avd->backend = &avd_open_backend;
+	ret = avd_open_request_firmware(avd);
+	if (!ret)
+		avd_open_capabilities(avd);
+	if (!ret)
+		ret = avd_qfw_probe(avd);
+	return ret;
+}
+
+int avd_backend_boot(struct avd_dev *avd)
+{
+	int ret;
+
+	if (!avd_backend_is_apple(avd)) {
+		avd_pm_prepare_piodma(avd);
+		avd_qfw_prepare_boot(avd);
+	}
+	ret = avd->backend->boot(avd);
+	/* Never switch command ABIs after frames have used this backend. */
+	if (ret == -ENOENT && !avd->fw_generation && avd_backend_is_apple(avd)) {
+		ret = avd_open_request_firmware(avd);
+		if (!ret)
+			ret = avd_qfw_probe(avd);
+		if (ret)
+			return ret;
+		avd->backend = &avd_open_backend;
+		avd_open_capabilities(avd);
+		avd_pm_prepare_piodma(avd);
+		avd_qfw_prepare_boot(avd);
+		ret = avd->backend->boot(avd);
+	}
+	if (!ret)
+		avd_qfw_select(avd);
+	if (!ret)
+		avd->fw_generation++;
+	return ret;
+}
diff --git a/drivers/media/platform/apple/avd/avd-backend-queue.c b/drivers/media/platform/apple/avd/avd-backend-queue.c
new file mode 100644
index 0000000000..36ae764906
--- /dev/null
+++ b/drivers/media/platform/apple/avd/avd-backend-queue.c
@@ -0,0 +1,516 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Queued transport for the open AVD firmware (avd-fw queue ABI 2).
+ *
+ * The codec's CPU builder still produces the per-frame instruction program.
+ * Instead of writing it word by word into the VP FIFO register and kicking
+ * the PP from the VP-done interrupt, the host streams the program into a word
+ * ring in CM3 SRAM and posts one descriptor per frame. The firmware feeds the
+ * VP FIFO from SRAM, starts PP itself when the VP is done, and posts a tagged
+ * completion. No PIODMA (and so no second DART stream) is involved.
+ */
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+
+#include "avd.h"
+#include "avd-inst.h"
+#include "avd-regs.h"
+
+#define AVDQ_MAGIC		0x41565131	/* "AVQ1" */
+#define AVDQ_VERSION		2
+#define AVDQ_COUNT		16
+#define AVDQ_DESC_BYTES		64
+#define AVDQ_RING_OFFSET	0x8000
+#define AVDQ_INFO		0x7fc0
+/* Firmware private state starts here; the SRAM ring must end before it. */
+#define AVDQ_RING_LIMIT		0x6000
+#define AVDQ_INFO_RP		(AVDQ_INFO + 0x38)
+#define AVDQ_INFO_WP		(AVDQ_INFO + 0x3c)
+#define AVDQ_FEAT_SRAM_RING	BIT(0)
+#define AVDQ_FEAT_MULTI_KICK	BIT(1)
+#define AVDQ_FEAT_VP_DONE	BIT(2)
+#define AVDQ_FEAT_MULTI_VP	BIT(3)
+#define AVDQ_POOL_OFFSET	0x7f80
+#define AVDQ_POOL_MAGIC		0x41564d32 /* AVM2 */
+#define AVDQ_POOL_VERSION	1
+#define AVDQ_MAX_VPS		12
+#define AVDQ_FLAG_VP_DONE	BIT(1)
+#define AVDQ_VP_NOTIFY		0x54540000
+#define AVDQ_FLAG_SRAM		BIT(0)
+#define AVDQ_MAX_PP_EXTRA	255
+#define AVDQ_STATE_SUBMITTED	1
+#define AVDQ_STATE_COMPLETE	2
+#define AVDQ_NOTIFY_MASK	0xffff0000
+#define AVDQ_NOTIFY		0x54530000
+/* SRAM addresses as the CM3 doorbell sees them: 0x01000000 + offset from AVD base. */
+#define AVDQ_CM3_APERTURE(off)	(0x01000000 + (off))
+#define AVD_REG_MBOX0_STATUS	0x50
+#define AVD_REG_MBOX0_SEND	0x54
+#define AVDQ_MBOX_STATUS_EMPTY	BIT(17)
+#define AVDQ_STREAM_TIMEOUT_US	(1000 * USEC_PER_MSEC)
+
+/* Descriptor word offsets (bytes), avd-fw docs/queue.md. */
+enum {
+	D_MAGIC = 0x00, D_TAG = 0x04, D_CODEC = 0x08, D_VP = 0x0c,
+	D_PROG_LO = 0x10, D_PROG_HI = 0x14, D_WORDS = 0x18, D_KICK = 0x1c,
+	D_STATE = 0x20, D_STATUS = 0x24, D_CTAG = 0x28, D_FLAGS = 0x2c,
+	D_PP_EXTRA = 0x30, D_PP_CONT = 0x34, D_RSVD0 = 0x38, D_RSVD1 = 0x3c,
+};
+
+struct avd_qfw {
+	void __iomem *sram;
+	resource_size_t sram_size;
+	u32 aperture;		/* expected CM3 address of SRAM byte 0 */
+	u32 ring_off;
+	u32 ring_words;
+	u32 wp;			/* host write count, free-running */
+	u32 fifo_slots;
+	u32 codec_mask;		/* info+0x24, bit n = codec n */
+	u32 vp_pool[4];		/* firmware masks of hardware VP indices */
+	u32 next_vp[4];		/* per-codec rotation; queue_mutex owns submission */
+	bool multi_vp;
+	bool vp_done;
+	bool usable;		/* last boot found a matching ABI 2 image */
+};
+
+static bool avd_qfw_pool_valid(const u32 *pool, u32 limit, u32 codecs)
+{
+	u32 used = 0;
+	unsigned int codec;
+
+	if (pool[0] != AVDQ_POOL_MAGIC || pool[1] != AVDQ_POOL_VERSION ||
+	    !limit || limit > AVDQ_MAX_VPS || pool[7] || (pool[6] & ~codecs))
+		return false;
+	for (codec = 0; codec < 4; codec++) {
+		u32 mask = pool[2 + codec];
+
+		if (!!mask != !!(codecs & BIT(codec)) ||
+		    mask >> limit || (mask & used))
+			return false;
+		used |= mask;
+	}
+	return true;
+}
+
+static unsigned int avd_qfw_pick_vp(struct avd_qfw *q, u32 codec, u32 fallback)
+{
+	unsigned int n;
+
+	if (!q->multi_vp)
+		return fallback;
+	for (n = 0; n < AVDQ_MAX_VPS; n++) {
+		unsigned int vp = (q->next_vp[codec] + n) % AVDQ_MAX_VPS;
+
+		if (q->vp_pool[codec] & BIT(vp)) {
+			q->next_vp[codec] = (vp + 1) % AVDQ_MAX_VPS;
+			return vp;
+		}
+	}
+	return fallback;
+}
+
+static unsigned int avd_qfw_bank_limit(struct avd_qfw *q, unsigned int codec)
+{
+	unsigned int banks = 1;
+	u32 pool;
+
+	/* Old queue firmware and VP9 retain the two-bank overlap path. */
+	if (!q->multi_vp || codec == AVD_CODEC_VP9 || codec > AVD_CODEC_AV1)
+		return 2;
+	/* One bank per VP plus one retained by PP. No SoC counts in the host. */
+	for (pool = q->vp_pool[codec]; pool; pool &= pool - 1)
+		banks++;
+	return min_t(unsigned int, banks, q->fifo_slots);
+}
+
+static void __iomem *avd_qfw_desc(struct avd_qfw *q, unsigned int idx)
+{
+	return q->sram + AVDQ_RING_OFFSET + idx * AVDQ_DESC_BYTES;
+}
+
+/* Arguments of dev_dbg() are evaluated only when dynamic debug is enabled. */
+void avd_qfw_debug(struct avd_dev *avd, struct avd_frame *f, const char *where)
+{
+	struct avd_qfw *q = avd->qfw;
+	void __iomem *d;
+
+	if (!avd_backend_is_qfw(avd))
+		return;
+	d = avd_qfw_desc(q, f->idx);
+	dev_dbg(avd->dev,
+		"queue %s: tag %#x slot %u host %u desc %u status %u ctag %#x rp %#x wp %#x mbox0 %#x mbox1 %#x\n",
+		where, f->tag, f->idx, f->state, readl(d + D_STATE),
+		readl(d + D_STATUS), readl(d + D_CTAG),
+		readl(q->sram + AVDQ_INFO_RP), readl(q->sram + AVDQ_INFO_WP),
+		readl(avd->mbox + AVD_REG_MBOX0_STATUS),
+		readl(avd->mbox + AVD_REG_MBOX1_STATUS));
+}
+
+int avd_qfw_probe(struct avd_dev *avd)
+{
+	struct resource *code, *sram;
+	struct avd_qfw *q;
+
+	code = platform_get_resource_byname(avd->pdev, IORESOURCE_MEM, "code");
+	sram = platform_get_resource_byname(avd->pdev, IORESOURCE_MEM, "sram");
+	if (!code || !sram || sram->start < code->start ||
+	    resource_size(sram) < AVDQ_RING_OFFSET + AVDQ_COUNT * AVDQ_DESC_BYTES)
+		return 0;	/* no queue mode on this node: legacy transport only */
+	q = devm_kzalloc(avd->dev, sizeof(*q), GFP_KERNEL);
+	if (!q)
+		return -ENOMEM;
+	q->sram = devm_ioremap_resource(avd->dev, sram);
+	if (IS_ERR(q->sram))
+		return PTR_ERR(q->sram);
+	q->sram_size = resource_size(sram);
+	/* The code window sits at +0x80000 from the decoder base on every SoC. */
+	q->aperture = AVDQ_CM3_APERTURE(0x80000 + (u32)(sram->start - code->start));
+	avd->qfw = q;
+	return 0;
+}
+
+/* Read the firmware's info block after boot; true when ABI 2 queue mode fits. */
+static bool avd_qfw_check(struct avd_dev *avd)
+{
+	struct avd_qfw *q = avd->qfw;
+	u32 info[16];
+	unsigned int i;
+
+	if (!q)
+		return false;
+	for (i = 0; i < ARRAY_SIZE(info); i++)
+		info[i] = readl(q->sram + AVDQ_INFO + 4 * i);
+	q->usable = false;
+	q->vp_done = false;
+	q->multi_vp = false;
+	for (i = 0; i < 4; i++) {
+		q->vp_pool[i] = 0;
+		q->next_vp[i] = 0;
+	}
+	if (info[0] != AVDQ_MAGIC) {
+		/*
+		 * A legacy image writes no block. An ABI 2 image writes it at its own
+		 * SRAM address, so a DT sram window that does not match lands here too.
+		 */
+		dev_info_once(avd->dev, "no queue info block at sram +%#x, using legacy transport\n",
+			      AVDQ_INFO);
+		return false;
+	}
+	if (info[1] != AVDQ_VERSION || info[2] != AVDQ_COUNT ||
+	    info[3] != AVDQ_DESC_BYTES || info[5] != AVDQ_RING_OFFSET ||
+	    !(info[11] & AVDQ_FEAT_SRAM_RING) ||
+	    !(info[11] & AVDQ_FEAT_MULTI_KICK)) {
+		dev_info_once(avd->dev, "open firmware queue ABI %u not supported, using legacy transport\n",
+			      info[1]);
+		return false;
+	}
+	if (info[4] != q->aperture) {
+		dev_warn_once(avd->dev, "firmware SRAM aperture %#x, node needs %#x: wrong image tier, using legacy transport\n",
+			      info[4], q->aperture);
+		return false;
+	}
+	if (info[13] < 1024 || info[12] % 4 ||
+	    (u64)info[12] + 4ULL * info[13] > AVDQ_RING_LIMIT ||
+	    !info[10] || info[10] > AVDQ_COUNT || info[14] || info[15]) {
+		dev_warn_once(avd->dev, "firmware SRAM ring geometry invalid, using legacy transport\n");
+		return false;
+	}
+	q->vp_done = info[11] & AVDQ_FEAT_VP_DONE;
+	q->ring_off = info[12];
+	q->ring_words = info[13];
+	q->fifo_slots = min_t(u32, info[10], avd->variant->fifo_slots ?: 1);
+	q->codec_mask = info[9];
+	if (info[11] & AVDQ_FEAT_MULTI_VP) {
+		u32 pool[8];
+
+		for (i = 0; i < ARRAY_SIZE(pool); i++)
+			pool[i] = readl(q->sram + AVDQ_POOL_OFFSET + 4 * i);
+		if (avd_qfw_pool_valid(pool, info[8], info[9])) {
+			for (i = 0; i < 4; i++)
+				q->vp_pool[i] = pool[2 + i];
+			q->multi_vp = true;
+		} else {
+			dev_warn_once(avd->dev, "invalid firmware VP pool, using one VP per codec\n");
+		}
+	}
+	q->wp = 0;
+	q->usable = true;
+	dev_dbg(avd->dev, "queue ABI %u: aperture %#x ring %#x/%u words FIFO slots %u codecs %#x\n",
+		info[1], info[4], q->ring_off, q->ring_words, q->fifo_slots, q->codec_mask);
+	return true;
+}
+
+static int avd_qfw_boot(struct avd_dev *avd)
+{
+	int ret = avd_boot(avd);
+
+	if (ret)
+		return ret;
+	/* AP -> CM3 doorbells use mailbox 0; completions stay on mailbox 1. */
+	writel_relaxed(AVD_MBOX_ENABLE, avd->mbox + AVD_REG_MBOX0_STATUS);
+	return 0;
+}
+
+static unsigned int avd_qfw_max_inflight(struct avd_dev *avd)
+{
+	/* Each frame in flight owns one hardware instruction FIFO (EXEC 7:4). */
+	return min_t(unsigned int, AVD_MAX_FRAMES, avd->qfw->fifo_slots);
+}
+
+static void avd_qfw_fail_all(struct avd_dev *avd)
+{
+	unsigned int i;
+
+	/* ABI: any fatal word or I/O status needs a whole-queue reset. */
+	for (i = 0; i < AVD_MAX_FRAMES; i++)
+		if (avd->frames[i].state == AVD_FRAME_SUBMITTED)
+			avd->frames[i].deadline = jiffies;
+	mod_delayed_work(system_dfl_wq, &avd->queue_work, 0);
+}
+
+static int avd_qfw_stream(struct avd_dev *avd, const u32 *words, u32 count)
+{
+	struct avd_qfw *q = avd->qfw;
+	unsigned long timeout = jiffies + usecs_to_jiffies(AVDQ_STREAM_TIMEOUT_US);
+	u32 done = 0;
+
+	while (done < count) {
+		u32 rp = readl(q->sram + AVDQ_INFO_RP);
+		u32 used = q->wp - rp, space, pos, chunk;
+
+		if (used > q->ring_words)
+			return -EIO;
+		space = q->ring_words - used;
+		if (!space) {
+			if (time_after(jiffies, timeout))
+				return -ETIMEDOUT;
+			usleep_range(20, 50);
+			continue;
+		}
+		pos = q->wp % q->ring_words;
+		chunk = min3(space, count - done, q->ring_words - pos);
+		/* The free-running u32 counter can wrap before the word ring does. */
+		chunk = min_t(u64, chunk, (1ULL << 32) - q->wp);
+		/*
+		 * Word stores only: memcpy_toio() would use 64-bit and byte
+		 * stores, and the CM3 data SRAM is only ever accessed with
+		 * 32-bit ones elsewhere (info block, descriptors).
+		 */
+		__iowrite32_copy(q->sram + q->ring_off + 4 * pos, words + done, chunk);
+		q->wp += chunk;
+		done += chunk;
+		/* Words before the count that publishes them. */
+		wmb();
+		writel(q->wp, q->sram + AVDQ_INFO_WP);
+	}
+	return 0;
+}
+
+static int avd_qfw_submit(struct avd_dev *avd, struct avd_frame *f)
+{
+	struct avd_qfw *q = avd->qfw;
+	struct avd_ctx *ctx = f->ctx;
+	u32 codec = f->cmd[0], vp = 0, kick, cont, mask, extra = f->cmd[1];
+	u32 *words = f->prog->cpu;
+	void __iomem *d = avd_qfw_desc(q, f->idx);
+	unsigned int i;
+	int ret;
+
+	if (ctx->coded_fmt_desc->frame_ops)
+		return -EOPNOTSUPP;
+	if (codec > AVD_CODEC_AV1 || !words || !f->prog_words ||
+	    f->prog_words > f->prog->size / sizeof(u32))
+		return -EINVAL;
+	if (!(avd->capabilities & BIT(codec)))
+		return -EOPNOTSUPP;
+	/* The program's EXEC words name FIFO f->idx; it must be a real FIFO. */
+	if (f->idx >= q->fifo_slots)
+		return -EINVAL;
+	/* The prepared picture owns this FIFO, including across inbox retries. */
+	if (!f->fifo_iova)
+		return -EINVAL;
+	/* A busy inbox owns nothing; retry this same prepared frame later. */
+	if (!(readl(avd->mbox + AVD_REG_MBOX0_STATUS) & AVDQ_MBOX_STATUS_EMPTY))
+		return -EBUSY;
+	for (i = 0; i < codec; i++)
+		vp += avd->variant->vp_slots[i];
+	if (avd->variant->vp_slot_base[codec])
+		vp = avd->variant->vp_slot_base[codec];
+	if (extra > AVDQ_MAX_PP_EXTRA)
+		return -E2BIG;
+	/* Advance only after all retry/error exits; prepared programs are VP-neutral. */
+	vp = avd_qfw_pick_vp(q, codec, vp);
+
+	mask = codec == AVD_CODEC_VP9 && avd->variant->revision == 3 ?
+		AVD_OP_EXEC_REV3_VP9_MASK : 0;
+	cont = AVD_OP_EXEC | mask | AVD_OP_EXEC_FIFO_IDX(f->idx) |
+	       AVD_OP_EXEC_FIFO_MASK(avd->variant->fifo_slots);
+	kick = cont | AVD_OP_EXEC_FLAG_START_REV4(avd->variant->revision == 4) |
+	       AVD_OP_EXEC_FLAG_START_REV3(avd->variant->revision == 3 &&
+					   codec != AVD_CODEC_AV1);
+
+	/* FIFO registers of other live frames are never touched. */
+	avd->variant->configure_stream(avd, f->fifo_iova, f->idx, vp);
+
+	writel(AVDQ_MAGIC, d + D_MAGIC);
+	writel(f->tag, d + D_TAG);
+	writel(codec, d + D_CODEC);
+	writel(vp, d + D_VP);
+	writel(q->wp, d + D_PROG_LO);
+	writel(0, d + D_PROG_HI);
+	writel(f->prog_words, d + D_WORDS);
+	writel(kick, d + D_KICK);
+	writel(0, d + D_STATUS);
+	writel(0, d + D_CTAG);
+	writel(AVDQ_FLAG_SRAM | (q->vp_done && ctx->coded_fmt_desc->ops->vp_done ?
+				AVDQ_FLAG_VP_DONE : 0), d + D_FLAGS);
+	writel(extra, d + D_PP_EXTRA);
+	writel(extra ? cont : 0, d + D_PP_CONT);
+	writel(0, d + D_RSVD0);
+	writel(0, d + D_RSVD1);
+	writel(AVDQ_STATE_SUBMITTED, d + D_STATE);
+	/* Descriptor before the doorbell that hands it to the firmware. */
+	wmb();
+	(void)readl(d + D_STATE);	/* flush posted aperture writes */
+	avd_qfw_debug(avd, f, "doorbell");
+	dev_dbg(avd->dev, "queue program: tag %#x vp %u fifo %pad words %zu kick %#x start %#x end %#x\n",
+		f->tag, vp, &f->fifo_iova, f->prog_words, kick, words[0],
+		words[f->prog_words - 1]);
+	writel(q->aperture + AVDQ_RING_OFFSET + f->idx * AVDQ_DESC_BYTES,
+	       avd->mbox + AVD_REG_MBOX0_SEND);
+
+	/* The firmware may start feeding while the rest of the program streams in. */
+	ret = avd_qfw_stream(avd, words, f->prog_words);
+	avd_qfw_debug(avd, f, "streamed");
+	if (ret) {
+		dev_err_ratelimited(avd->dev, "queue: program stream failed: %d\n", ret);
+		/* The descriptor is already posted: only a reset releases it. */
+		f->deadline = jiffies;
+	}
+	return 0;
+}
+
+static irqreturn_t avd_qfw_irq(struct avd_dev *avd)
+{
+	struct avd_qfw *q = avd->qfw;
+	unsigned int n;
+	u32 word;
+
+	/* At most one VP and PP token per slot, plus one fatal token. */
+	for (n = 0; n < 2 * AVDQ_COUNT + 1 && avd_mbox_pop(avd, &word); n++) {
+		struct avd_frame *f;
+		void __iomem *d;
+		u32 state, status, ctag;
+		unsigned int idx;
+
+		if ((word & AVDQ_NOTIFY_MASK) == AVDQ_VP_NOTIFY && q->vp_done) {
+			idx = word & 15;
+			d = avd_qfw_desc(q, idx);
+			/* Separate record: PP completion may already have been published. */
+			state = readl(d + D_RSVD1);
+			ctag = readl(d + D_RSVD0);
+			f = &avd->frames[idx];
+			if (state == 1 && !((ctag ^ word) & 0xfff0) &&
+			    f->state == AVD_FRAME_SUBMITTED && ctag == f->tag)
+				avd_frame_vp_complete(avd, ctag);
+			continue;
+		}
+		if ((word & AVDQ_NOTIFY_MASK) != AVDQ_NOTIFY) {
+			dev_err_ratelimited(avd->dev,
+					    "queue: firmware reported %#x, resetting\n", word);
+			avd_qfw_fail_all(avd);
+			continue;
+		}
+		idx = word & 15;
+		d = avd_qfw_desc(q, idx);
+		state = readl(d + D_STATE);
+		status = readl(d + D_STATUS);
+		ctag = readl(d + D_CTAG);
+		f = &avd->frames[idx];
+		avd_qfw_debug(avd, f, "completion");
+		if (state != AVDQ_STATE_COMPLETE || ((ctag ^ word) & 0xfff0) ||
+		    f->state != AVD_FRAME_SUBMITTED || ctag != f->tag) {
+			dev_warn_ratelimited(avd->dev, "queue: stale completion %#x (state %u tag %#x)\n",
+					     word, state, ctag);
+			continue;
+		}
+		if (status > 1) {
+			/* An I/O error is not proof of quiescence, even for one frame. */
+			avd_qfw_fail_all(avd);
+			continue;
+		}
+		writel(0, d + D_STATE);
+		avd_frame_complete(avd, ctag, status ? -EINVAL : 0);
+	}
+	return IRQ_HANDLED;
+}
+
+const struct avd_backend_ops avd_qfw_backend = {
+	.name = "open-queue",
+	.boot = avd_qfw_boot,
+	.shutdown = avd_shutdown,
+	.max_inflight = avd_qfw_max_inflight,
+	.submit = avd_qfw_submit,
+	.irq = avd_qfw_irq,
+	.suspend = avd_pm_backend_suspend,
+	.resume = avd_pm_backend_resume,
+};
+
+bool avd_backend_is_qfw(const struct avd_dev *avd)
+{
+	return avd->backend == &avd_qfw_backend;
+}
+
+bool avd_qfw_has_vp_done(const struct avd_dev *avd)
+{
+	return avd_backend_is_qfw(avd) && avd->qfw->vp_done;
+}
+
+unsigned int avd_qfw_picture_banks(const struct avd_dev *avd, unsigned int codec)
+{
+	return avd_backend_is_qfw(avd) ? avd_qfw_bank_limit(avd->qfw, codec) : 1;
+}
+
+/*
+ * SRAM survives a CM3 reload, so a stale info block from an earlier ABI 2
+ * image could make a legacy image look queue capable. Clear the magic before
+ * every open-firmware boot; only an image that publishes it again qualifies.
+ */
+void avd_qfw_prepare_boot(struct avd_dev *avd)
+{
+	if (avd->qfw)
+		writel(0, avd->qfw->sram + AVDQ_INFO);
+}
+
+/*
+ * Called after every successful open-firmware boot (probe, resume, reset),
+ * with no frame owned by the firmware. Picks the queued transport when the
+ * loaded image speaks ABI 2 for this node, else the legacy one.
+ */
+void avd_qfw_select(struct avd_dev *avd)
+{
+	const struct avd_backend_ops *old = avd->backend;
+
+	if (old != &avd_open_backend && old != &avd_qfw_backend)
+		return;
+	if (avd_qfw_check(avd)) {
+		/* Legacy boot left mailbox 0 disabled. */
+		writel_relaxed(AVD_MBOX_ENABLE, avd->mbox + AVD_REG_MBOX0_STATUS);
+		avd->backend = &avd_qfw_backend;
+		/*
+		 * Codecs held back for a newer firmware (T6040 HEVC) are
+		 * enabled by a queue image that lists them in its codec mask.
+		 */
+		avd->capabilities = avd->fw_capabilities |
+			(avd->variant->capabilities & avd->qfw->codec_mask);
+	} else {
+		avd->backend = &avd_open_backend;
+		avd->capabilities = avd->fw_capabilities;
+	}
+	if (avd->backend != old)
+		dev_info(avd->dev, "using %s transport (%u frames in flight)\n",
+			 avd->backend->name, avd->backend->max_inflight(avd));
+}
