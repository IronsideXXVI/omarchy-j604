From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 00:57:28 +0000
Subject: [PATCH] iommu/apple-dart: Skip the DCP segment walk while no leaf has
 changed

Until the IOMFB session is qualified, every message the host sends the
DCP first runs the full health check. For each of the DCP (SID23),
PIODMA (SID16) and, once it exists, scanout (SID0) streams that check
compares the inherited roots and leaves and then validates the
firmware segments: an OF walk of the consumer's memory-region list and,
for every 16 KiB page of every segment, one locked translate of that
page. On the J604 the 1.606 r8 startup statistics put the costliest of
329 startup checks at 3401 us, of which 1864 us is the DCP stream and
1448 us the scanout stream, with 263 checks between 1 and 2 ms.

The walk's other inputs are fixed at admission: the device tree, the
reserved-memory snapshot and the ADT segment table. What can change is
the leaves it reads, and the caller has just compared all of them under
the table lock: SID23 against the leaf verdict cache, SID0 and SID16
against expected[]. Count every write to expected[] and qualified[] in
walk_gen, record the node and the count of the last full walk that
passed, and skip the walk while the count stands still for that node.
A changed leaf, a host map or unmap, or a first check runs the full walk
as before, so the verdict for a given table state is unchanged.

The leaf compare itself, the root compare, the register reads and the
IRQ-off time of the leaf loop are unchanged. The skip only happens
right after a leaf compare done under the same lock that read the
count.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/iommu/apple-dart-dcp.h | 59 ++++++++++++++++++++++++++++++++--
 drivers/iommu/apple-dart.c     | 17 ++++++++--
 2 files changed, 70 insertions(+), 6 deletions(-)

diff --git a/drivers/iommu/apple-dart-dcp.h b/drivers/iommu/apple-dart-dcp.h
index 7d20909201..ddf976dc85 100644
--- a/drivers/iommu/apple-dart-dcp.h
+++ b/drivers/iommu/apple-dart-dcp.h
@@ -23,6 +23,15 @@ struct apple_dart_dcp {
 	 * changed leaf needs the (fixed-input) qualification again.
 	 */
 	u64 *qualified[DCP_DART_ENTRIES];
+	/* Bumped under lock on every expected[] or qualified[] write. A full
+	 * validate walk that passed for node "walked" at walk_gen "walked_gen"
+	 * gives the same verdict while the counter stands still: its other
+	 * inputs (DT, reserved memory, the ADT segment table) are fixed at
+	 * admission, and the caller has just compared every leaf it reads.
+	 */
+	unsigned long walk_gen;
+	unsigned long walked_gen;
+	struct device_node *walked;
 	u64 entry[DCP_DART_ENTRIES];
 	struct resource leaf_regions[64];
 	unsigned int nr_leaf_regions;
@@ -535,6 +544,20 @@ static bool apple_dart_j713_scanout_node(struct device_node *node)
 		of_device_is_compatible(node, "apple,t8132-display-diagnostics");
 }
 
+/* Record a passed full walk, unless expected[] or qualified[] moved meanwhile. */
+static void apple_dart_dcp_walked(struct apple_dart_dcp *dcp, struct device_node *node,
+				  unsigned long gen)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&dcp->lock, flags);
+	if (!dcp->failed && dcp->walk_gen == gen) {
+		dcp->walked = node;
+		dcp->walked_gen = gen;
+	}
+	spin_unlock_irqrestore(&dcp->lock, flags);
+}
+
 static int apple_dart_frontend_validate(struct apple_dart_dcp *dcp,
 				       struct device_node *consumer)
 {
@@ -542,7 +565,8 @@ static int apple_dart_frontend_validate(struct apple_dart_dcp *dcp,
 	struct of_phandle_args spec;
 	u32 wanted = dcp->sid == 0 ? BIT(4) | BIT(6) : BIT(5);
 	u32 seen = 0;
-	unsigned long flags;
+	unsigned long flags, gen;
+	bool walked;
 	int nr, ret;
 
 	if (!apple_dart_dcp_registers(dcp))
@@ -565,9 +589,16 @@ static int apple_dart_frontend_validate(struct apple_dart_dcp *dcp,
 				}
 	}
 snapshot_done:
+	gen = dcp->walk_gen;
+	walked = dcp->walked == consumer && dcp->walked_gen == gen;
 	spin_unlock_irqrestore(&dcp->lock, flags);
 	if (ret)
 		return ret;
+	/* Every leaf just matched expected[], which has not changed since a full
+	 * walk passed for this consumer: the walk below would give the same verdict.
+	 */
+	if (walked)
+		return 0;
 
 	alias = of_find_node_by_path(dcp->sid == 0 ? "disp0" : "disp0_piodma");
 	ret = alias && consumer == alias && of_device_is_available(alias) &&
@@ -652,7 +683,10 @@ put_node:
 		if (ret)
 			return ret;
 	}
-	return seen == wanted && apple_dart_dcp_registers(dcp) ? 0 : -EINVAL;
+	if (seen != wanted || !apple_dart_dcp_registers(dcp))
+		return -EINVAL;
+	apple_dart_dcp_walked(dcp, consumer, gen);
+	return 0;
 }
 
 /* Read-only admission; SID0 later maps only free slices, SID16 only via its pair API. */
@@ -721,7 +755,21 @@ static const struct attribute_group apple_dart_frontend_group = {
 	.attrs = apple_dart_frontend_attrs,
 };
 
+static int __apple_dart_dcp_validate(struct apple_dart_dcp *dcp, struct device *dev,
+				     unsigned long gen);
+
 static int apple_dart_dcp_validate(struct apple_dart_dcp *dcp, struct device *dev)
+{
+	unsigned long flags, gen;
+
+	spin_lock_irqsave(&dcp->lock, flags);
+	gen = dcp->walk_gen;
+	spin_unlock_irqrestore(&dcp->lock, flags);
+	return __apple_dart_dcp_validate(dcp, dev, gen);
+}
+
+static int __apple_dart_dcp_validate(struct apple_dart_dcp *dcp, struct device *dev,
+				     unsigned long gen)
 {
 	struct device_node *node;
 	const char *uuid;
@@ -839,8 +887,10 @@ put_node:
 	/* The walk above did not re-read the registers per page. */
 	if (!ret && !apple_dart_dcp_registers(dcp))
 		ret = -EBUSY;
-	if (!ret)
+	if (!ret) {
 		dcp->owner = dev;
+		apple_dart_dcp_walked(dcp, dev->of_node, gen);
+	}
 	return ret;
 }
 
@@ -1016,6 +1066,7 @@ static int apple_dart_dcp_map_owned(struct apple_dart_dcp *dcp, u64 iova, phys_a
 		dcp->expected[root][leaf + i] = pte;
 		WRITE_ONCE(dcp->table[root][leaf + i], pte);
 	}
+	dcp->walk_gen++;
 	dma_wmb();
 	if (mapped)
 		*mapped += count * size;
@@ -1118,6 +1169,8 @@ static size_t apple_dart_dcp_unmap(struct apple_dart_dcp *dcp, u64 iova,
 	}
 	for (size_t i = 0; i < cleared; i++)
 		dcp->expected[root][leaf + i] = 0;
+	if (cleared)
+		dcp->walk_gen++;
 	unmapped = cleared * size;
 	goto out;
 refuse:
diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 2c76c7312c..155d7cdd55 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -2964,8 +2964,8 @@ int apple_dart_dcp_check(struct device *dev)
 	struct iommu_domain *domain = iommu_get_domain_for_dev(dev);
 	struct apple_dart_domain *dd;
 	struct apple_dart_dcp *dcp;
-	unsigned long flags;
-	bool drift = false;
+	unsigned long flags, gen;
+	bool drift = false, walked;
 	int ret;
 
 	if (!domain || domain->owner != &apple_dart_iommu_ops || !iommu_is_dma_domain(domain))
@@ -3000,14 +3000,25 @@ int apple_dart_dcp_check(struct device *dev)
 					break;
 				}
 				dcp->qualified[i][j] = leaf;
+				dcp->walk_gen++;
 			}
 		if (drift)
 			break;
 	}
+	gen = dcp->walk_gen;
+	walked = dcp->sid == 23 && dcp->owner == dev && dcp->walked == dev->of_node &&
+		 dcp->walked_gen == gen;
 	spin_unlock_irqrestore(&dcp->lock, flags);
 	if (drift)
 		goto failed;
-	ret = apple_dart_dcp_validate(dcp, dev);
+	/* SID23: the loop above compared every foreign leaf, the only leaves the
+	 * segment walk reads, and none changed since a full walk passed for this
+	 * owner. Its other inputs are fixed at admission: same verdict.
+	 */
+	if (walked)
+		return 0;
+	ret = dcp->sid == 23 ? __apple_dart_dcp_validate(dcp, dev, gen) :
+			       apple_dart_dcp_validate(dcp, dev);
 	if (ret)
 		goto failed;
 	return 0;
