From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 14:16:30 +0000
Subject: [PATCH] soc: apple: pmp: log the values the firmware asks
 for, behind a parameter

The PMP firmware pulls its board values (lts-voltage, lts-config,
fast-die-ctrl-*, the DVFS tables) by name through REGISTER_IOREG, and
the driver answers each one from the matching apple,tunable-* property
without a log line. Whether a firmware actually asked for a value, and
what it got, can therefore not be read from a running system.

Add apple_pmp.ioreg_log. When it is non-zero, every request is logged
with its position, the property name, the number of bytes answered (0
when the property is absent or too large) and an FNV-1a hash of those
bytes, so the list can be compared with what macOS hands the same
firmware from the same ADT. The default, 0, logs nothing and leaves
every answer unchanged.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/pmp.rs | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/drivers/soc/apple/pmp.rs b/drivers/soc/apple/pmp.rs
index ee263c9250..0b875c2bb9 100644
--- a/drivers/soc/apple/pmp.rs
+++ b/drivers/soc/apple/pmp.rs
@@ -367,7 +367,9 @@ fn register_ioreg(&self, addr: u64) -> Result<u64> {
         let mut size = u32::from_le_bytes(unsafe {
             <&[u8] as TryInto<[u8; 4]>>::try_into(&msg_buf.as_ref()[0x40..0x44]).unwrap()
         });
+        let log = module_parameters::ioreg_log.value() != 0;
         if size == 0 {
+            let mut fnv: u32 = 0x811c_9dc5;
             let mut name_vec = KVec::with_capacity(0x31, GFP_KERNEL)?;
             name_vec
                 .extend_from_slice(unsafe { &msg_buf.as_ref()[0..0x30] }, GFP_KERNEL)
@@ -406,12 +408,34 @@ fn register_ioreg(&self, addr: u64) -> Result<u64> {
                         val_buf.as_mut()[0..len].copy_from_slice(&data);
                     }
                     size = len as u32;
+                    if log {
+                        fnv = data
+                            .iter()
+                            .fold(fnv, |h, &b| (h ^ u32::from(b)).wrapping_mul(0x0100_0193));
+                    }
                 }
             } else {
                 // Not every boot loader provides every tunable the firmware
                 // asks for, and the firmware starts without them.
                 dev_dbg!(self.dev, "unknown property {:?}", name_str);
             }
+            if log {
+                dev_info!(
+                    self.dev,
+                    "ioreg #{} {:?}: {} bytes, fnv1a {:08x}\n",
+                    state.ioreg_entries.len() + 1,
+                    name_str,
+                    size,
+                    fnv
+                );
+            }
+        } else if log {
+            dev_info!(
+                self.dev,
+                "ioreg #{}: firmware-sized, {} bytes\n",
+                state.ioreg_entries.len() + 1,
+                size
+            );
         }
         state.ioreg_entries.push(size, GFP_KERNEL)?;
         let index = state.ioreg_entries.len() as u64;
@@ -1021,4 +1045,10 @@ fn unbind<'bound>(_dev: &'bound platform::Device<Core<'_>>, this: Pin<&Self::Dat
     name: "apple_pmp",
     description: "Apple Power Management Processor",
     license: "Dual MIT/GPL",
+    params: {
+        ioreg_log: u8 {
+            default: 0,
+            description: "Log each value the firmware asks for (name, bytes, FNV-1a); 0 = off",
+        },
+    },
 }
