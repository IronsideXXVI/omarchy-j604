From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 04:57:33 +0000
Subject: [PATCH 350/353] dt-bindings: power: apple,pmgr-s2r: add the T8132 ADT
 power gates

The J604's boot firmware gives macOS's PMGR driver four power-gate words
in the ADT's /arm-io/pmgr pwrgate-regs, as {pmgr reg index, offset,
mask, value} records. Describe them for the T8132 sequence: two more
optional windows, pmgr0 and pmgr1 (pmgr reg[0] and reg[1]), and
apple,pwrgate-regs, the records copied as they are.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../bindings/power/apple,pmgr-s2r.yaml        | 25 +++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml b/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml
index f42684cd03..ce809b148b 100644
--- a/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml
+++ b/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml
@@ -54,11 +54,11 @@ properties:
       suspend-to-RAM timer. T8132 - optional, the windows of the sequence
       macOS uses on that SoC; without them T8132 has no suspend-to-RAM.
     minItems: 1
-    maxItems: 17
+    maxItems: 19
 
   reg-names:
     minItems: 1
-    maxItems: 17
+    maxItems: 19
 
   apple,wake-enable:
     $ref: /schemas/types.yaml#/definitions/uint32-array
@@ -108,6 +108,21 @@ properties:
       apple,tunable-* tables for them let the sequence take the block down at
       the commit and bring it back on the wake.
 
+  apple,pwrgate-regs:
+    $ref: /schemas/types.yaml#/definitions/uint32-matrix
+    maxItems: 8
+    items:
+      items:
+        - description: window, 0 for pmgr0 and 1 for pmgr1
+          maximum: 1
+        - description: offset in the window
+        - description: mask
+        - description: value
+    description:
+      T8132 - the ADT's pmgr pwrgate-regs records, copied as they are. The
+      words are read before each sleep, and may be written as the boot
+      loader applies the ADT's {reg, offset, mask, value} tables.
+
   apple,pinctrl:
     $ref: /schemas/types.yaml#/definitions/phandle
     description:
@@ -170,6 +185,9 @@ allOf:
             - description: AMCC plane 1
             - description: MCC channel 0
             - description: MCC channel 1
+            - description: PMGR window 0, for apple,pwrgate-regs
+            - description: PMGR window 1, for apple,pwrgate-regs
+          minItems: 17
         reg-names:
           items:
             - const: commit
@@ -189,6 +207,9 @@ allOf:
             - const: amcc1
             - const: mcc0
             - const: mcc1
+            - const: pmgr0
+            - const: pmgr1
+          minItems: 17
 
 additionalProperties: false
 
-- 
2.43.0

