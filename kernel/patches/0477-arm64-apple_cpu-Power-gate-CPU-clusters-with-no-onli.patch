-	/* PMGR stop and power-down WFI, for suspend to RAM */
-	APPLE_DIE_STOP,
+	/*
+	 * PMGR stop and power-down WFI, with the CPU complex in deep sleep;
+	 * the cluster is gated
+	 */
+	APPLE_DIE_GATE,
 };
 
