 arch/arm64/Kconfig                 |   8 +
 arch/arm64/include/asm/apple_cpu.h |  24 +
 arch/arm64/kernel/apple_cpu.c      | 945 +++++++++++++++++++++++++++--
 3 files changed, 929 insertions(+), 48 deletions(-)

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 829b3bd1c1..a1699d0ae0 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -1615,6 +1615,7 @@ config ARM64_APPLE_CPU_HOTPLUG
 	depends on ARCH_APPLE && HOTPLUG_CPU
 	default ARCH_APPLE
 	select KEXEC_CORE
+	select MFD_SYSCON
 	help
 	  Lets spin-table secondary CPUs of Apple SoCs go offline, on systems
 	  whose device tree describes their PMGR CPU controls. An offline CPU
@@ -1626,6 +1627,13 @@ config ARM64_APPLE_CPU_HOTPLUG
 	  CPU stop control and are started again through the boot loader's
 	  resident secondary entry path, which jumps back to the holding pen.
 
+	  When the last online CPU of a cluster goes offline, the cluster is
+	  power gated as a whole (apple_cpu.cluster_gating, on by default),
+	  provided the boot loader's re-entry path is known to stay off its
+	  console UARTs: an m1n1 that publishes the warm boot mailbox, or the
+	  exact m1n1 v1.6.1 image. Its CPUs are then started again through
+	  that path once the cluster is powered up.
+
 # Common NUMA Features
 config NUMA
 	bool "NUMA Memory Allocation and Scheduler Support"
