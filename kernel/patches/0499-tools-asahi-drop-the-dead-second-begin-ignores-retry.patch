From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
Date: Tue, 3 Nov 2026 09:16:51 -0600
Subject: [PATCH] tools: asahi: drop the dead second begin-ignores-retry
 control entry

w7X's re-review nit: next() takes the first match, so the second entry could
never be selected. Nine distinct mutants; --mutations still passes.

Signed-off-by: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
(cherry picked from commit efff25c15c4f1abb1fb141d87ecfe07432bdb3c4)
---
 tools/asahi/pmp-agx-vote-tests.py | 1 -
 1 file changed, 1 deletion(-)

diff --git a/tools/asahi/pmp-agx-vote-tests.py b/tools/asahi/pmp-agx-vote-tests.py
index 17d829217e..fd0f1d0e3c 100755
--- a/tools/asahi/pmp-agx-vote-tests.py
+++ b/tools/asahi/pmp-agx-vote-tests.py
@@ -40,7 +40,6 @@ CONTROLS = [
      'return v->enabled && !v->voted && !v->stopped && ((void)now, (!v->failures || true));'),
     ('begin-ignores-retry', 'return v->enabled && !v->voted && !v->stopped && (!v->failures || agx_vote_retry_reached(v, now));',
      'return v->enabled && !v->voted && !v->stopped && ((void)now, !v->failures);'),
-    ('begin-ignores-retry', '(!v->failures || agx_vote_retry_reached(v, now))', '!v->failures'),
     ('retry-revival', '|| (agx_sms_t)(v->retry_at - now) > (agx_sms_t)AGX_VOTE_RETRY_MS', ''),
 ]
 
