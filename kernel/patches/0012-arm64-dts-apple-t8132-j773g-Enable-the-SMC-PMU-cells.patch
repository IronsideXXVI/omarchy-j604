From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sean Dolbec <sdolbec1@gmail.com>
Date: Sun, 1 Nov 2026 21:02:23 -0500
Subject: [PATCH] arm64: dts: apple: t8132-j773g: Enable the SMC, PMU cells,
 reboot and RTC

Enable the SMC on the Mac mini and give it the reboot and RTC children,
fed by the main PMU's (Abbey, SPMI 0xe) NVMEM cells. This gives the mini
power-off, reboot, the RTC and the power button (macsmc-input), and the
SMC GPIO that switches the Wi-Fi port's power.

The cell offsets come from this mini's macOS IORegistry: pmu-main@E
"pmu,abbey", info-leg_scrpad 0xf800, info-pm_setting 0x2001,
info-clock_offset 0x2100 (6 bytes), info-fault_shadow 0x867b (0x10),
info-scrpad_socd 0x8b00 (0x1800). The state cells sit at leg_scrpad + 1,
+ 2 and + 0xf, as on the other Apple families. These values are the
same as on the M4 MacBook Air (J713).

Tested on a J773g (2026-10-17) with the same nodes under GravityLinux's
gravity-m4 7.1.13 kernel: the PMU cells appear, macsmc-reboot and
macsmc-rtc bind, rtc0 keeps time across reboots and `systemctl poweroff`
turns the mini off (power LED off). Without the shutdown flag it
restarted instead.

Signed-off-by: Sean Dolbec <sdolbec1@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t8132-j773g.dts | 72 +++++++++++++++++++++++
 1 file changed, 72 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j773g.dts b/arch/arm64/boot/dts/apple/t8132-j773g.dts
index 0583cb9d19..12ba8b854b 100644
--- a/arch/arm64/boot/dts/apple/t8132-j773g.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j773g.dts
@@ -23,3 +23,75 @@
 &framebuffer0 {
 	power-domains = <&ps_dispext0_fe>, <&ps_dptx_phy>;
 };
+
+&smc_mbox {
+	status = "okay";
+};
+
+&smc {
+	status = "okay";
+
+	smc_reboot: reboot {
+		compatible = "apple,smc-reboot";
+		nvmem-cells = <&shutdown_flag>, <&boot_stage>,
+			      <&boot_error_count>, <&panic_count>;
+		nvmem-cell-names = "shutdown_flag", "boot_stage",
+				   "boot_error_count", "panic_count";
+	};
+
+	smc_rtc: rtc {
+		compatible = "apple,smc-rtc";
+		nvmem-cells = <&rtc_offset>;
+		nvmem-cell-names = "rtc_offset";
+	};
+};
+
+&nub_spmi {
+	status = "okay";
+
+	pmic1: pmic@e {
+		compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
+		reg = <0xe SPMI_USID>;
+
+		nvmem-layout {
+			compatible = "fixed-layout";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			pm_setting: pm-setting@2001 {
+				reg = <0x2001 0x1>;
+			};
+
+			rtc_offset: rtc-offset@2100 {
+				reg = <0x2100 0x6>;
+			};
+
+			fault_shadow: fault-shadow@867b {
+				reg = <0x867b 0x10>;
+			};
+
+			socd: socd@8b00 {
+				reg = <0x8b00 0x1800>;
+			};
+
+			boot_stage: boot-stage@f801 {
+				reg = <0xf801 0x1>;
+			};
+
+			boot_error_count: boot-error-count@f802,0 {
+				reg = <0xf802 0x1>;
+				bits = <0 4>;
+			};
+
+			panic_count: panic-count@f802,4 {
+				reg = <0xf802 0x1>;
+				bits = <4 4>;
+			};
+
+			shutdown_flag: shutdown-flag@f80f,3 {
+				reg = <0xf80f 0x1>;
+				bits = <3 1>;
+			};
+		};
+	};
+};
