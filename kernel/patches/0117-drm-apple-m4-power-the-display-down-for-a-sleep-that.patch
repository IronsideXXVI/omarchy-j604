From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 15:56:14 +0000
Subject: [PATCH] drm/apple: m4: power the display down for a sleep
 that powers the SoC down

A sleep that powers the SoC down (pm_suspend_via_firmware(), set by
apple-s2r) cuts the power of the M4 display coprocessor, so its suspend
refused such a sleep while the coprocessor was running. The PMP refused
it too while the DCP held its retained DISP vote.

The display power-down already brings the DCP into the state that sleep
leaves it in, on purpose: iomfb_m4_power_gate() stops the CPU and powers
the display DARTs, the PMP DISP vote, the PMC interface enables and the
PMGR domains down, and leaves firmware, endpoints and shared buffers in
DRAM. iomfb_m4_power_ungate() brings it all back on the next frame
through RTKit's retained wake. The s2idle suspend uses it as an optional
extra; this makes it the condition of the firmware sleep.

iomfb_m4_suspend_firmware(): with a live, unfailed session on a board
that has the power-down (apple,pmc-interface), appledrm.power_gate_ms
not 0, nothing scanned out and the display blanked, power the DCP down
(or find it down already), then arm the PMP for this sleep with
apple_pmp_j713_display_sleep_enable(). Anything that cannot run refuses
the sleep with -EBUSY and the reason in the log, as before; a power-down
done before such a refusal stays, as after a blank. power_gate_ms = 0
keeps its meaning, "never", here too. The resume disarms the PMP
(apple_pmp_j713_display_sleep_disable()) and keeps the DCP down until
the next frame, as after display sleep; a PMP left stopped makes that
frame's DISP get fail with -EBUSY, and the session fails, the display
staying off.

The decision is in dcp-m4-sleep.h (pure, KUnit in the next commit).
Hibernation still refuses (dcp_platform_freeze()). The AGX vote still
refuses the sleep at the PMP while the GPU holds it.

[j604: this consumer commit replaces the refusal of 3cbc675c1d for the
boards that have the power-down; the rest of the DCP driver is unchanged.]

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
(cherry picked from commit dee9d16ee6d9cd8bb007c26ac22ae677d5dfd2e6)
(cherry picked from commit 634941c8ef39cc37c3745804ca6fd5e84859cf2d)
---
 drivers/gpu/drm/apple/dcp-m4-sleep.h | 97 ++++++++++++++++++++++++++++
 drivers/gpu/drm/apple/dcp.c          | 15 +++++
 drivers/gpu/drm/apple/iomfb_m4.c     | 58 +++++++++++++++++
 drivers/gpu/drm/apple/iomfb_m4.h     |  3 +
 4 files changed, 173 insertions(+)
 create mode 100644 drivers/gpu/drm/apple/dcp-m4-sleep.h

diff --git a/drivers/gpu/drm/apple/dcp-m4-sleep.h b/drivers/gpu/drm/apple/dcp-m4-sleep.h
new file mode 100644
index 0000000000..73b7bafcaa
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-sleep.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * T8132 (M4) display and a system sleep that powers the SoC down
+ * (pm_suspend_via_firmware()). Decisions only, no hardware: unit tested by
+ * dcp-m4-sleep-test.c.
+ *
+ * Such a sleep cuts the power of the display coprocessor and its domains.
+ * The display power-down of iomfb_m4_power_gate() already brings the DCP to
+ * that state on purpose: CPU stopped, display DARTs, PMP DISP vote, PMC
+ * interface and PMGR domains down, firmware and shared buffers left in DRAM
+ * for iomfb_m4_power_ungate(). So the sleep may go ahead only once that
+ * power-down has happened (or can happen now) for a live, unfailed session
+ * on a board that has it, with nothing scanned out and the display blanked.
+ */
+#ifndef _DCP_M4_SLEEP_H
+#define _DCP_M4_SLEEP_H
+
+#include <linux/types.h>
+
+enum dcp_m4_fw_sleep_verdict {
+	DCP_M4_FW_SLEEP_OK,
+	/* No display session was started: nothing here can stop that firmware. */
+	DCP_M4_FW_SLEEP_NO_SESSION,
+	/* The session failed. */
+	DCP_M4_FW_SLEEP_FAILED,
+	/* The board has no display power-down (no apple,pmc-interface). */
+	DCP_M4_FW_SLEEP_NO_GATE,
+	/* appledrm.power_gate_ms = 0: the display is never powered down. */
+	DCP_M4_FW_SLEEP_GATE_OFF,
+	/* A frame, or the startup surface, is still scanned out. */
+	DCP_M4_FW_SLEEP_SCANNING,
+	/* The display was not powered down by a blank. */
+	DCP_M4_FW_SLEEP_NOT_BLANKED,
+	/* The power-down did not complete (iomfb_m4_power_gate()). */
+	DCP_M4_FW_SLEEP_GATE_FAILED,
+	/* The PMP did not take the arming (apple_pmp_j713_display_sleep_enable()). */
+	DCP_M4_FW_SLEEP_PMP_REFUSED,
+};
+
+struct dcp_m4_fw_sleep_state {
+	bool runtime;		/* a display session was started */
+	bool failed;		/* it failed */
+	bool gated;		/* the DCP and its domains are down already */
+	bool gate_capable;	/* the board has the power-down */
+	bool gate_enabled;	/* appledrm.power_gate_ms is not 0 */
+	bool scanning;		/* a frame or the startup surface is scanned out */
+	bool display_off;	/* blanked: setPowerState(0) done by the blank */
+};
+
+/* Whether the sleep may go ahead, before the power-down is started. */
+static inline enum dcp_m4_fw_sleep_verdict
+dcp_m4_fw_sleep_check(const struct dcp_m4_fw_sleep_state *s)
+{
+	if (!s->runtime)
+		return DCP_M4_FW_SLEEP_NO_SESSION;
+	if (s->failed)
+		return DCP_M4_FW_SLEEP_FAILED;
+	/* Down already (a blank longer than power_gate_ms): nothing left to do. */
+	if (s->gated)
+		return DCP_M4_FW_SLEEP_OK;
+	if (!s->gate_capable)
+		return DCP_M4_FW_SLEEP_NO_GATE;
+	if (!s->gate_enabled)
+		return DCP_M4_FW_SLEEP_GATE_OFF;
+	if (s->scanning)
+		return DCP_M4_FW_SLEEP_SCANNING;
+	if (!s->display_off)
+		return DCP_M4_FW_SLEEP_NOT_BLANKED;
+	return DCP_M4_FW_SLEEP_OK;
+}
+
+static inline const char *dcp_m4_fw_sleep_reason(enum dcp_m4_fw_sleep_verdict verdict)
+{
+	switch (verdict) {
+	case DCP_M4_FW_SLEEP_OK:
+		return "display powered down";
+	case DCP_M4_FW_SLEEP_NO_SESSION:
+		return "no display session to stop";
+	case DCP_M4_FW_SLEEP_FAILED:
+		return "the display session failed";
+	case DCP_M4_FW_SLEEP_NO_GATE:
+		return "no display firmware stop on this board (no display power-down)";
+	case DCP_M4_FW_SLEEP_GATE_OFF:
+		return "display power-down disabled (appledrm.power_gate_ms=0)";
+	case DCP_M4_FW_SLEEP_SCANNING:
+		return "panel still scanning out";
+	case DCP_M4_FW_SLEEP_NOT_BLANKED:
+		return "display not blanked";
+	case DCP_M4_FW_SLEEP_GATE_FAILED:
+		return "display power-down failed";
+	case DCP_M4_FW_SLEEP_PMP_REFUSED:
+		return "the PMP did not release the display for this sleep";
+	}
+	return "unknown";
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 9696b5da32..8edd1cb09b 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -7043,6 +7043,21 @@ static int dcp_platform_suspend(struct device *dev)
 	if (dcp_takeover_was_aborted(dcp))
 		return -EBUSY;
 
+	/*
+	 * T8132, a sleep that powers the SoC down: the coprocessor must not be
+	 * running when its power goes. Its display power-down stops it and powers
+	 * its domains down, and releases the PMP DISP vote; then the PMP is armed
+	 * for this sleep (iomfb_m4_suspend_firmware()). Where that cannot run the
+	 * sleep is refused, as asahi does for G16; suspend-to-idle goes on below.
+	 */
+	if (pm_suspend_via_firmware() && iomfb_is_m4(dcp)) {
+		int ret = iomfb_m4_suspend_firmware(dcp);
+
+		if (!ret)
+			device_set_wakeup_path(dev);
+		return ret;
+	}
+
 	/*
 	 * T8132: setPowerState powers the display down; the coprocessor keeps
 	 * running and its power domains stay on, as below, unless the internal
diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index afcac21853..28cfd449a1 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -56,6 +56,7 @@
 #include "dcp-edr.h"
 
 #include "dcp-m4-profile.h"
+#include "dcp-m4-sleep.h"
 #include "dcp-m4-protocol.h"
 #include "dcp-m4-transaction.h"
 #include "dcp-m4-timing.h"
@@ -5906,11 +5907,68 @@ int iomfb_m4_suspend(struct apple_dcp *owner)
 	return ret;
 }
 
+/*
+ * A sleep that powers the SoC down (pm_suspend_via_firmware()). Once
+ * iomfb_m4_power_gate() has stopped the DCP CPU and powered its DARTs and
+ * domains down, the DCP keeps nothing that the sleep can lose: firmware,
+ * endpoints and shared buffers stay in DRAM, and the next frame brings it up
+ * from there (iomfb_m4_power_ungate()), as after display sleep. The power-down
+ * also put the PMP DISP vote: then arm the PMP for this sleep. Whatever cannot
+ * run refuses the sleep (-EBUSY); a power-down done before the refusal stays,
+ * as after a blank.
+ */
+int iomfb_m4_suspend_firmware(struct apple_dcp *owner)
+{
+	struct iomfb_m4 *dcp = owner->v26_6;
+	enum dcp_m4_fw_sleep_verdict verdict;
+	struct dcp_m4_fw_sleep_state st;
+	int ret = 0;
+
+	if (!dcp) {
+		dev_err(owner->dev, "no display backend: refusing the sleep\n");
+		return -EBUSY;
+	}
+	cancel_delayed_work_sync(&dcp->gate_work);
+	mutex_lock(&dcp->lock);
+	st = (struct dcp_m4_fw_sleep_state) {
+		.runtime = !!dcp->runtime,
+		.failed = READ_ONCE(dcp->error) != 0,
+		.gated = dcp->gated,
+		.gate_capable = dcp->gate_capable,
+		.gate_enabled = READ_ONCE(power_gate_ms) != 0,
+		.scanning = dcp->active_fb || dcp->active_frame.dva,
+		.display_off = dcp->display_off && !dcp->powered_off,
+	};
+	verdict = dcp_m4_fw_sleep_check(&st);
+	if (verdict == DCP_M4_FW_SLEEP_OK && !dcp->gated && iomfb_m4_power_gate(dcp))
+		verdict = DCP_M4_FW_SLEEP_GATE_FAILED;
+	if (verdict == DCP_M4_FW_SLEEP_OK) {
+		ret = apple_pmp_j713_display_sleep_enable(dcp->dev);
+		if (ret)
+			verdict = DCP_M4_FW_SLEEP_PMP_REFUSED;
+	}
+	mutex_unlock(&dcp->lock);
+	if (verdict == DCP_M4_FW_SLEEP_PMP_REFUSED) {
+		dev_err(dcp->dev, "%s (%d): refusing the sleep\n",
+			dcp_m4_fw_sleep_reason(verdict), ret);
+		return -EBUSY;
+	}
+	if (verdict != DCP_M4_FW_SLEEP_OK) {
+		dev_err(dcp->dev, "%s: refusing the sleep\n", dcp_m4_fw_sleep_reason(verdict));
+		return -EBUSY;
+	}
+	dev_info(dcp->dev, "display coprocessor and domains down, DISP released for this sleep\n");
+	return 0;
+}
+
 int iomfb_m4_resume(struct apple_dcp *owner)
 {
 	struct iomfb_m4 *dcp = owner->v26_6;
 	int ret;
 
+	/* The sleep this DCP armed is over (iomfb_m4_suspend_firmware()). */
+	apple_pmp_j713_display_sleep_disable(owner->dev);
+
 	/*
 	 * Messages received from now on are of this epoch (see suspend);
 	 * every one RTKit received before is dispatched with the old one first.
diff --git a/drivers/gpu/drm/apple/iomfb_m4.h b/drivers/gpu/drm/apple/iomfb_m4.h
index 10401abe4c..921ca2f62f 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.h
+++ b/drivers/gpu/drm/apple/iomfb_m4.h
@@ -89,6 +89,8 @@ int iomfb_m4_present(struct apple_dcp *dcp, struct drm_framebuffer *fb,
 		     dma_addr_t dva, size_t mapped);
 int iomfb_m4_blank(struct apple_dcp *dcp);
 int iomfb_m4_suspend(struct apple_dcp *dcp);
+/* A sleep that powers the SoC down: 0 once the DCP is down and the PMP armed, else -EBUSY. */
+int iomfb_m4_suspend_firmware(struct apple_dcp *dcp);
 int iomfb_m4_resume(struct apple_dcp *dcp);
 void iomfb_m4_configure_backlight(struct apple_dcp *dcp);
 void iomfb_m4_quiesce(struct apple_dcp *dcp);
@@ -176,6 +178,7 @@ static inline int iomfb_m4_present(struct apple_dcp *dcp, struct drm_framebuffer
 }
 static inline int iomfb_m4_blank(struct apple_dcp *dcp) { return -ENODEV; }
 static inline int iomfb_m4_suspend(struct apple_dcp *dcp) { return -ENODEV; }
+static inline int iomfb_m4_suspend_firmware(struct apple_dcp *dcp) { return -EBUSY; }
 static inline int iomfb_m4_resume(struct apple_dcp *dcp) { return -ENODEV; }
 static inline void iomfb_m4_configure_backlight(struct apple_dcp *dcp) { }
 static inline void iomfb_m4_quiesce(struct apple_dcp *dcp) { }
