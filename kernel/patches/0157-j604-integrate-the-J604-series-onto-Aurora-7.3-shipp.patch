+/*
+ * For a consumer whose own power-up leaves the filter undefined: write every entry back
+ * unless all of them hold already, then check them all.
+ */
+static int apple_dart_dapf_apply(struct apple_dart *dart)
+{
+	if (!dart->dapf_count)
+		return -ENODEV;
+	if (apple_dart_dapf_matches(dart))
+		return 0;
+	if (readl(dart->regs + DART_DAPF_LOCK) & DART_DAPF_LOCKED)
+		return -EPERM;
+
+	apple_dart_dapf_write(dart);
+	return apple_dart_dapf_matches(dart) ? 0 : -EIO;
+}
