diff --git a/drivers/media/platform/apple/scaler/apple-scaler-drv.c b/drivers/media/platform/apple/scaler/apple-scaler-drv.c
new file mode 100644
index 0000000000..eeab021803
--- /dev/null
+++ b/drivers/media/platform/apple/scaler/apple-scaler-drv.c
@@ -0,0 +1,853 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple silicon scaler and colour-space converter (MSR), V4L2 mem2mem.
+ *
+ * Every Apple silicon SoC has one or more MSR engines: memory-to-memory
+ * scalers with a programmable colour-space converter, chroma resampling,
+ * flip/rotate and alpha fill. Hardware-version 10 (M1) through 22 (A18 Pro)
+ * are programmed directly through MMIO and report completion with an
+ * interrupt; later generations front the engine with firmware and are not
+ * handled here.
+ *
+ * The OUTPUT queue takes the source image, the CAPTURE queue the result.
+ * This version converts between formats at the same size: Y'CbCr <->
+ * R'G'B' with the colorimetry of the Y'CbCr side, chroma resampling and
+ * alpha fill. Scaling comes once the filter path is qualified.
+ */
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iommu.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+#include <linux/reset.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
+
+#include <media/v4l2-common.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fh.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "apple-scaler-hw.h"
+#include "apple-scaler-regs.h"
+
+#define ASC_NAME		"apple-scaler"
+#define ASC_MIN_REG_SIZE	0x28000
+#define ASC_MIN_SIZE		16
+#define ASC_MAX_SIZE		16384
+#define ASC_STRIDE_ALIGN	128
+#define ASC_JOB_TIMEOUT_MS	500
+#define ASC_IDLE_TIMEOUT_US	10000
+
+/**
+ * struct apple_scaler_variant - per-SoC engine description
+ * @hw_version: MSR hardware-version of this SoC (from the hardware description)
+ * @num_reg: number of register apertures the binding describes
+ */
+struct apple_scaler_variant {
+	u32 hw_version;
+	unsigned int num_reg;
+};
+
+struct apple_scaler {
+	struct device *dev;
+	void __iomem *regs;
+	const struct apple_scaler_variant *variant;
+	struct dev_pm_domain_list *pd_list;
+	struct reset_control *rst;
+	struct mutex lock;	/* serialises ioctls and queue state */
+	struct v4l2_device v4l2_dev;
+	struct video_device vdev;
+	struct v4l2_m2m_dev *m2m_dev;
+	int irq;
+	u32 id;
+
+	spinlock_t hw_lock;	/* protects the fields below */
+	struct apple_scaler_ctx *active;
+	bool need_init;
+	u32 transform_id;
+	struct delayed_work watchdog;
+	struct asc_reg writes[ASC_JOB_MAX_WRITES];
+};
+
+struct apple_scaler_ctx {
+	struct v4l2_fh fh;
+	struct apple_scaler *asc;
+	struct v4l2_pix_format_mplane src;	/* OUTPUT queue */
+	struct v4l2_pix_format_mplane dst;	/* CAPTURE queue */
+	u32 sequence;
+};
+
+static struct apple_scaler_ctx *asc_file_to_ctx(struct file *file)
+{
+	return container_of(file_to_v4l2_fh(file), struct apple_scaler_ctx, fh);
+}
+
+static u32 asc_read(struct apple_scaler *asc, u32 reg)
+{
+	return readl_relaxed(asc->regs + reg);
+}
+
+static void asc_write(struct apple_scaler *asc, u32 reg, u32 val)
+{
+	writel_relaxed(val, asc->regs + reg);
+}
+
+/* ---- hardware --------------------------------------------------------- */
+
+/*
+ * After power-up or a failed job: wait for idle, pulse the engine reset
+ * (no register may be read while it is held), clear stale status and
+ * enable completion and errors.
+ */
+static int asc_hw_init(struct apple_scaler *asc)
+{
+	u32 v;
+	int ret;
+
+	ret = readl_relaxed_poll_timeout(asc->regs + ASC_IS_RUNNING, v, !(v & BIT(0)),
+					 10, ASC_IDLE_TIMEOUT_US);
+	if (ret)
+		return ret;
+	asc_write(asc, ASC_RESET, ASC_RESET_ENGINE);
+	asc_write(asc, ASC_RESET, 0);
+	ret = readl_relaxed_poll_timeout(asc->regs + ASC_IS_RUNNING, v, !(v & BIT(0)),
+					 10, ASC_IDLE_TIMEOUT_US);
+	if (ret)
+		return ret;
+	asc_write(asc, ASC_IRQ_STATUS, asc_read(asc, ASC_IRQ_STATUS));
+	asc_write(asc, ASC_IRQ_ENABLE, ASC_IRQ_DONE | ASC_IRQ_ERRORS);
+	asc->need_init = false;
+	return 0;
+}
+
+static void asc_finish(struct apple_scaler *asc, struct apple_scaler_ctx *ctx, int err)
+{
+	struct v4l2_m2m_ctx *m2m = ctx->fh.m2m_ctx;
+	enum vb2_buffer_state state = err ? VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE;
+	struct vb2_v4l2_buffer *src, *dst;
+	unsigned int i;
+
+	src = v4l2_m2m_src_buf_remove(m2m);
+	dst = v4l2_m2m_dst_buf_remove(m2m);
+	if (src && dst) {
+		for (i = 0; i < dst->vb2_buf.num_planes; i++)
+			vb2_set_plane_payload(&dst->vb2_buf, i,
+					      err ? 0 : ctx->dst.plane_fmt[i].sizeimage);
+		v4l2_m2m_buf_copy_metadata(src, dst);
+		dst->sequence = ctx->sequence++;
+		v4l2_m2m_buf_done(src, state);
+		v4l2_m2m_buf_done(dst, state);
+	}
+	pm_runtime_put_autosuspend(asc->dev);
+	v4l2_m2m_job_finish(asc->m2m_dev, m2m);
+}
+
+/* A failed job leaves the engine in an unknown state: reset before the next. */
+static void asc_recover(struct apple_scaler *asc)
+{
+	asc->need_init = true;
+}
+
+static irqreturn_t asc_irq(int irq, void *data)
+{
+	struct apple_scaler *asc = data;
+	struct apple_scaler_ctx *ctx;
+	u32 status;
+	int err = 0;
+
+	if (pm_runtime_get_if_active(asc->dev) <= 0)
+		return IRQ_NONE;
+
+	spin_lock(&asc->hw_lock);
+	status = asc_read(asc, ASC_IRQ_STATUS);
+	if (!status) {
+		spin_unlock(&asc->hw_lock);
+		pm_runtime_put_noidle(asc->dev);
+		return IRQ_NONE;
+	}
+	asc_write(asc, ASC_IRQ_STATUS, status);
+	ctx = asc->active;
+	if (!ctx || !(status & (ASC_IRQ_DONE | ASC_IRQ_ERRORS))) {
+		spin_unlock(&asc->hw_lock);
+		dev_warn_ratelimited(asc->dev, "unexpected interrupt, status %#x\n", status);
+		pm_runtime_put_noidle(asc->dev);
+		return IRQ_HANDLED;
+	}
+	asc->active = NULL;
+	if (status & ASC_IRQ_ERRORS) {
+		dev_err_ratelimited(asc->dev, "job failed: status %#x debug %#x\n",
+				    status, asc_read(asc, ASC_DEBUG_STATUS));
+		err = -EIO;
+	}
+	spin_unlock(&asc->hw_lock);
+	pm_runtime_put_noidle(asc->dev);
+
+	cancel_delayed_work(&asc->watchdog);
+	if (err)
+		asc_recover(asc);
+	asc_finish(asc, ctx, err);
+	return IRQ_HANDLED;
+}
+
+static void asc_watchdog(struct work_struct *work)
+{
+	struct apple_scaler *asc = container_of(work, struct apple_scaler, watchdog.work);
+	struct apple_scaler_ctx *ctx;
+	unsigned long flags;
+
+	spin_lock_irqsave(&asc->hw_lock, flags);
+	ctx = asc->active;
+	asc->active = NULL;
+	if (ctx)
+		asc_write(asc, ASC_IRQ_ENABLE, 0);
+	spin_unlock_irqrestore(&asc->hw_lock, flags);
+	if (ctx) {
+		dev_err(asc->dev, "job timed out (running %#x)\n",
+			asc_read(asc, ASC_IS_RUNNING));
+		asc_recover(asc);
+		asc_finish(asc, ctx, -ETIMEDOUT);
+	}
+}
+
+static void asc_image(struct asc_image *img, const struct v4l2_pix_format_mplane *pix,
+		      struct vb2_buffer *vb)
+{
+	unsigned int i;
+
+	img->fmt = asc_find_format(pix->pixelformat);
+	img->width = pix->width;
+	img->height = pix->height;
+	for (i = 0; i < img->fmt->planes; i++) {
+		if (pix->num_planes > 1) {
+			img->dva[i] = vb2_dma_contig_plane_dma_addr(vb, i);
+			img->stride[i] = pix->plane_fmt[i].bytesperline;
+		} else {
+			/* Chroma follows luma in the same buffer, at the same stride. */
+			img->dva[i] = vb2_dma_contig_plane_dma_addr(vb, 0) +
+				      (u64)i * pix->plane_fmt[0].bytesperline * pix->height;
+			img->stride[i] = pix->plane_fmt[0].bytesperline;
+		}
+	}
+}
+
+static void asc_device_run(void *priv)
+{
+	struct apple_scaler_ctx *ctx = priv;
+	struct apple_scaler *asc = ctx->asc;
+	struct vb2_v4l2_buffer *src, *dst;
+	struct asc_job job = {};
+	struct asc_csc csc;
+	unsigned long flags;
+	int n, ret;
+
+	src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+	ret = pm_runtime_resume_and_get(asc->dev);
+	if (ret < 0) {
+		pm_runtime_get_noresume(asc->dev);
+		asc_finish(asc, ctx, ret);
+		return;
+	}
+
+	/*
+	 * Engine reset and interrupt setup, once per power-up and after any
+	 * failure. If the engine does not go idle, fall back to the PMGR reset
+	 * of its power domain and try once more.
+	 */
+	if (asc->need_init) {
+		ret = asc_hw_init(asc);
+		if (ret && asc->rst && !reset_control_reset(asc->rst))
+			ret = asc_hw_init(asc);
+		if (ret) {
+			dev_err_ratelimited(asc->dev, "engine does not go idle: %d\n", ret);
+			asc_finish(asc, ctx, -EIO);
+			return;
+		}
+	}
+
+	asc_image(&job.src, &ctx->src, &src->vb2_buf);
+	asc_image(&job.dst, &ctx->dst, &dst->vb2_buf);
+	if (job.src.fmt->yuv != job.dst.fmt->yuv) {
+		const struct v4l2_pix_format_mplane *y = job.src.fmt->yuv ? &ctx->src : &ctx->dst;
+
+		ret = asc_csc_compute(y->ycbcr_enc, y->quantization, job.src.fmt->yuv, &csc);
+		if (ret) {
+			asc_finish(asc, ctx, ret);
+			return;
+		}
+		job.csc = &csc;
+	}
+
+	spin_lock_irqsave(&asc->hw_lock, flags);
+	/* Job tags as the engine is driven on macOS: a counter above bit 3, bit 2 set. */
+	job.transform_id = (++asc->transform_id << 3) | BIT(2);
+	n = asc_job_build(&job, asc->writes, ARRAY_SIZE(asc->writes));
+	if (n < 0) {
+		spin_unlock_irqrestore(&asc->hw_lock, flags);
+		asc_finish(asc, ctx, n);
+		return;
+	}
+	asc->active = ctx;
+	/* Buffers must be visible to the engine before START, the last write. */
+	dma_wmb();
+	for (int i = 0; i < n; i++)
+		writel(asc->writes[i].val, asc->regs + asc->writes[i].off);
+	spin_unlock_irqrestore(&asc->hw_lock, flags);
+	schedule_delayed_work(&asc->watchdog, msecs_to_jiffies(ASC_JOB_TIMEOUT_MS));
+}
+
+static const struct v4l2_m2m_ops asc_m2m_ops = {
+	.device_run = asc_device_run,
+};
+
+/* ---- formats ---------------------------------------------------------- */
+
+/*
+ * Fill in a format the engine can take. The CAPTURE side has the OUTPUT
+ * size (no scaling yet). The Y'CbCr side of a conversion carries the
+ * colorimetry; the R'G'B' side is full range with the same primaries and
+ * transfer function, since the engine converts only the encoding.
+ */
+static void asc_fill(struct v4l2_pix_format_mplane *pix, const struct v4l2_pix_format_mplane *ref,
+		     u32 default_fourcc)
+{
+	const struct asc_format *f = asc_find_format(pix->pixelformat);
+	u32 w = ref ? ref->width : pix->width, h = ref ? ref->height : pix->height;
+	struct v4l2_pix_format_mplane in = *pix;
+
+	if (!f)
+		f = asc_find_format(default_fourcc);
+	w = clamp_t(u32, ALIGN(w, f->hsub), ASC_MIN_SIZE, ASC_MAX_SIZE);
+	h = clamp_t(u32, ALIGN(h, f->vsub), ASC_MIN_SIZE, ASC_MAX_SIZE);
+
+	memset(pix, 0, sizeof(*pix));
+	v4l2_fill_pixfmt_mp_aligned(pix, f->fourcc, w, h, ASC_STRIDE_ALIGN);
+	pix->field = V4L2_FIELD_NONE;
+
+	if (ref && ref->colorspace != V4L2_COLORSPACE_DEFAULT) {
+		pix->colorspace = ref->colorspace;
+		pix->xfer_func = ref->xfer_func;
+	} else {
+		pix->colorspace = in.colorspace ?: V4L2_COLORSPACE_REC709;
+		pix->xfer_func = in.xfer_func;
+	}
+	if (f->yuv) {
+		pix->ycbcr_enc = in.ycbcr_enc;
+		if (ref && v4l2_is_format_yuv(v4l2_format_info(ref->pixelformat)))
+			pix->ycbcr_enc = ref->ycbcr_enc;
+		if (pix->ycbcr_enc == V4L2_YCBCR_ENC_DEFAULT)
+			pix->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(pix->colorspace);
+		/* Only the encodings the matrix can express. */
+		if (pix->ycbcr_enc != V4L2_YCBCR_ENC_601 && pix->ycbcr_enc != V4L2_YCBCR_ENC_709 &&
+		    pix->ycbcr_enc != V4L2_YCBCR_ENC_BT2020)
+			pix->ycbcr_enc = V4L2_YCBCR_ENC_709;
+		pix->quantization = in.quantization;
+		if (ref && v4l2_is_format_yuv(v4l2_format_info(ref->pixelformat)))
+			pix->quantization = ref->quantization;
+		if (pix->quantization == V4L2_QUANTIZATION_DEFAULT)
+			pix->quantization = V4L2_QUANTIZATION_LIM_RANGE;
+	} else {
+		pix->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+		pix->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	}
+	if (pix->xfer_func == V4L2_XFER_FUNC_DEFAULT)
+		pix->xfer_func = V4L2_MAP_XFER_FUNC_DEFAULT(pix->colorspace);
+}
+
+static int asc_querycap(struct file *file, void *priv, struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, ASC_NAME, sizeof(cap->driver));
+	strscpy(cap->card, "Apple scaler/CSC", sizeof(cap->card));
+	return 0;
+}
+
+static int asc_enum_fmt(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	const struct asc_format *fmt = asc_format_by_index(f->index);
+
+	if (!fmt)
+		return -EINVAL;
+	f->pixelformat = fmt->fourcc;
+	return 0;
+}
+
+static int asc_enum_framesizes(struct file *file, void *priv, struct v4l2_frmsizeenum *fs)
+{
+	const struct asc_format *f = asc_find_format(fs->pixel_format);
+
+	if (fs->index || !f)
+		return -EINVAL;
+	fs->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fs->stepwise = (struct v4l2_frmsize_stepwise){
+		ASC_MIN_SIZE, ASC_MAX_SIZE, f->hsub, ASC_MIN_SIZE, ASC_MAX_SIZE, f->vsub,
+	};
+	return 0;
+}
+
+static int asc_g_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	f->fmt.pix_mp = asc_file_to_ctx(file)->src;
+	return 0;
+}
+
+static int asc_g_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	f->fmt.pix_mp = asc_file_to_ctx(file)->dst;
+	return 0;
+}
+
+static int asc_try_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	asc_fill(&f->fmt.pix_mp, NULL, V4L2_PIX_FMT_NV12M);
+	return 0;
+}
+
+static int asc_try_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	asc_fill(&f->fmt.pix_mp, &asc_file_to_ctx(file)->src, V4L2_PIX_FMT_ARGB32);
+	return 0;
+}
+
+static int asc_s_fmt_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct apple_scaler_ctx *ctx = asc_file_to_ctx(file);
+
+	if (vb2_is_busy(v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx)) ||
+	    vb2_is_busy(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
+		return -EBUSY;
+	asc_fill(&f->fmt.pix_mp, NULL, V4L2_PIX_FMT_NV12M);
+	ctx->src = f->fmt.pix_mp;
+	asc_fill(&ctx->dst, &ctx->src, V4L2_PIX_FMT_ARGB32);
+	return 0;
+}
+
+static int asc_s_fmt_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct apple_scaler_ctx *ctx = asc_file_to_ctx(file);
+
+	if (vb2_is_busy(v4l2_m2m_get_dst_vq(ctx->fh.m2m_ctx)))
+		return -EBUSY;
+	asc_fill(&f->fmt.pix_mp, &ctx->src, V4L2_PIX_FMT_ARGB32);
+	ctx->dst = f->fmt.pix_mp;
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops asc_ioctl_ops = {
+	.vidioc_querycap = asc_querycap,
+	.vidioc_enum_fmt_vid_out = asc_enum_fmt,
+	.vidioc_enum_fmt_vid_cap = asc_enum_fmt,
+	.vidioc_enum_framesizes = asc_enum_framesizes,
+	.vidioc_g_fmt_vid_out_mplane = asc_g_fmt_out,
+	.vidioc_g_fmt_vid_cap_mplane = asc_g_fmt_cap,
+	.vidioc_try_fmt_vid_out_mplane = asc_try_fmt_out,
+	.vidioc_try_fmt_vid_cap_mplane = asc_try_fmt_cap,
+	.vidioc_s_fmt_vid_out_mplane = asc_s_fmt_out,
+	.vidioc_s_fmt_vid_cap_mplane = asc_s_fmt_cap,
+
+	.vidioc_reqbufs = v4l2_m2m_ioctl_reqbufs,
+	.vidioc_querybuf = v4l2_m2m_ioctl_querybuf,
+	.vidioc_qbuf = v4l2_m2m_ioctl_qbuf,
+	.vidioc_dqbuf = v4l2_m2m_ioctl_dqbuf,
+	.vidioc_prepare_buf = v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_create_bufs = v4l2_m2m_ioctl_create_bufs,
+	.vidioc_expbuf = v4l2_m2m_ioctl_expbuf,
+	.vidioc_streamon = v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff = v4l2_m2m_ioctl_streamoff,
+
+	.vidioc_subscribe_event = v4l2_ctrl_subscribe_event,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
+};
+
+/* ---- queues ----------------------------------------------------------- */
+
+static struct v4l2_pix_format_mplane *asc_q_fmt(struct apple_scaler_ctx *ctx, u32 type)
+{
+	return V4L2_TYPE_IS_OUTPUT(type) ? &ctx->src : &ctx->dst;
+}
+
+static int asc_queue_setup(struct vb2_queue *q, unsigned int *nbufs, unsigned int *nplanes,
+			   unsigned int sizes[], struct device *alloc_devs[])
+{
+	struct v4l2_pix_format_mplane *pix = asc_q_fmt(vb2_get_drv_priv(q), q->type);
+	unsigned int i;
+
+	if (*nplanes) {
+		if (*nplanes != pix->num_planes)
+			return -EINVAL;
+		for (i = 0; i < *nplanes; i++)
+			if (sizes[i] < pix->plane_fmt[i].sizeimage)
+				return -EINVAL;
+		return 0;
+	}
+	*nplanes = pix->num_planes;
+	for (i = 0; i < *nplanes; i++)
+		sizes[i] = pix->plane_fmt[i].sizeimage;
+	return 0;
+}
+
+static int asc_buf_prepare(struct vb2_buffer *vb)
+{
+	struct v4l2_pix_format_mplane *pix = asc_q_fmt(vb2_get_drv_priv(vb->vb2_queue), vb->type);
+	unsigned int i;
+
+	for (i = 0; i < pix->num_planes; i++) {
+		if (vb2_plane_size(vb, i) < pix->plane_fmt[i].sizeimage)
+			return -EINVAL;
+		if (vb2_dma_contig_plane_dma_addr(vb, i) & (ASC_STRIDE_ALIGN - 1))
+			return -EINVAL;
+		if (V4L2_TYPE_IS_OUTPUT(vb->type))
+			vb2_set_plane_payload(vb, i, pix->plane_fmt[i].sizeimage);
+		else
+			vb2_set_plane_payload(vb, i, 0);
+	}
+	return 0;
+}
+
+static void asc_buf_queue(struct vb2_buffer *vb)
+{
+	struct apple_scaler_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+
+	v4l2_m2m_buf_queue(ctx->fh.m2m_ctx, to_vb2_v4l2_buffer(vb));
+}
+
+static int asc_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	struct apple_scaler_ctx *ctx = vb2_get_drv_priv(q);
+
+	if (V4L2_TYPE_IS_OUTPUT(q->type))
+		ctx->sequence = 0;
+	return 0;
+}
+
+static void asc_stop_streaming(struct vb2_queue *q)
+{
+	struct apple_scaler_ctx *ctx = vb2_get_drv_priv(q);
+	struct vb2_v4l2_buffer *vbuf;
+
+	for (;;) {
+		vbuf = V4L2_TYPE_IS_OUTPUT(q->type) ? v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx) :
+						      v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+		if (!vbuf)
+			break;
+		v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_ERROR);
+	}
+}
+
+static const struct vb2_ops asc_qops = {
+	.queue_setup = asc_queue_setup,
+	.buf_prepare = asc_buf_prepare,
+	.buf_queue = asc_buf_queue,
+	.start_streaming = asc_start_streaming,
+	.stop_streaming = asc_stop_streaming,
+};
+
+static int asc_init_queue(struct apple_scaler_ctx *ctx, struct vb2_queue *q, u32 type)
+{
+	q->type = type;
+	q->io_modes = VB2_MMAP | VB2_DMABUF;
+	q->drv_priv = ctx;
+	q->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	q->ops = &asc_qops;
+	q->mem_ops = &vb2_dma_contig_memops;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	q->lock = &ctx->asc->lock;
+	q->dev = ctx->asc->dev;
+	return vb2_queue_init(q);
+}
+
+static int asc_queue_init(void *priv, struct vb2_queue *src, struct vb2_queue *dst)
+{
+	int ret = asc_init_queue(priv, src, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+
+	return ret ?: asc_init_queue(priv, dst, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+}
+
+/* ---- file operations -------------------------------------------------- */
+
+static int asc_open(struct file *file)
+{
+	struct apple_scaler *asc = video_drvdata(file);
+	struct apple_scaler_ctx *ctx;
+	int ret;
+
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx)
+		return -ENOMEM;
+	ctx->asc = asc;
+	ctx->src.width = 1920;
+	ctx->src.height = 1080;
+	ctx->src.pixelformat = V4L2_PIX_FMT_NV12M;
+	asc_fill(&ctx->src, NULL, V4L2_PIX_FMT_NV12M);
+	ctx->dst.pixelformat = V4L2_PIX_FMT_ARGB32;
+	asc_fill(&ctx->dst, &ctx->src, V4L2_PIX_FMT_ARGB32);
+	v4l2_fh_init(&ctx->fh, video_devdata(file));
+
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(asc->m2m_dev, ctx, asc_queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		v4l2_fh_exit(&ctx->fh);
+		kfree(ctx);
+		return ret;
+	}
+	v4l2_fh_add(&ctx->fh, file);
+	return 0;
+}
+
+static int asc_release(struct file *file)
+{
+	struct apple_scaler_ctx *ctx = asc_file_to_ctx(file);
+	struct apple_scaler *asc = ctx->asc;
+
+	mutex_lock(&asc->lock);
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	mutex_unlock(&asc->lock);
+	v4l2_fh_del(&ctx->fh, file);
+	v4l2_fh_exit(&ctx->fh);
+	kfree(ctx);
+	return 0;
+}
+
+static const struct v4l2_file_operations asc_fops = {
+	.owner = THIS_MODULE,
+	.open = asc_open,
+	.release = asc_release,
+	.poll = v4l2_m2m_fop_poll,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = v4l2_m2m_fop_mmap,
+};
+
+/* ---- power management and probe --------------------------------------- */
+
+static int asc_runtime_suspend(struct device *dev)
+{
+	return 0;
+}
+
+static int asc_runtime_resume(struct device *dev)
+{
+	struct apple_scaler *asc = dev_get_drvdata(dev);
+
+	/* The engine loses its state when powered down. */
+	asc->need_init = true;
+	return 0;
+}
+
+static int asc_suspend(struct device *dev)
+{
+	struct apple_scaler *asc = dev_get_drvdata(dev);
+
+	v4l2_m2m_suspend(asc->m2m_dev);
+	return pm_runtime_force_suspend(dev);
+}
+
+static int asc_resume(struct device *dev)
+{
+	struct apple_scaler *asc = dev_get_drvdata(dev);
+	int ret = pm_runtime_force_resume(dev);
+
+	if (ret)
+		return ret;
+	v4l2_m2m_resume(asc->m2m_dev);
+	return 0;
+}
+
+static const struct dev_pm_ops asc_pm_ops = {
+	RUNTIME_PM_OPS(asc_runtime_suspend, asc_runtime_resume, NULL)
+	SYSTEM_SLEEP_PM_OPS(asc_suspend, asc_resume)
+};
+
+static int asc_identify(struct apple_scaler *asc)
+{
+	u32 running, status;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(asc->dev);
+	if (ret < 0)
+		return dev_err_probe(asc->dev, ret, "failed to power up\n");
+
+	asc->id = asc_read(asc, ASC_HW_VERSION);
+	running = asc_read(asc, ASC_IS_RUNNING);
+	status = asc_read(asc, ASC_IRQ_STATUS);
+	/* Masked until the first job enables it. */
+	asc_write(asc, ASC_IRQ_ENABLE, 0);
+	if (status)
+		asc_write(asc, ASC_IRQ_STATUS, status);
+
+	pm_runtime_put_sync_suspend(asc->dev);
+
+	if (running)
+		dev_warn(asc->dev, "engine busy at probe (%#x)\n", running);
+	dev_info(asc->dev, "MSR hardware-version %u, id %#x, stale status %#x\n",
+		 asc->variant->hw_version, asc->id, status);
+	return 0;
+}
+
+static void asc_cleanup(void *data)
+{
+	struct apple_scaler *asc = data;
+
+	cancel_delayed_work_sync(&asc->watchdog);
+	if (asc->m2m_dev)
+		v4l2_m2m_release(asc->m2m_dev);
+	v4l2_device_unregister(&asc->v4l2_dev);
+}
+
+static int asc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct apple_scaler *asc;
+	struct video_device *vdev;
+	struct resource *res;
+	int ret;
+
+	asc = devm_kzalloc(dev, sizeof(*asc), GFP_KERNEL);
+	if (!asc)
+		return -ENOMEM;
+	asc->dev = dev;
+	asc->variant = of_device_get_match_data(dev);
+	if (!asc->variant)
+		return -ENODEV;
+	mutex_init(&asc->lock);
+	spin_lock_init(&asc->hw_lock);
+	INIT_DELAYED_WORK(&asc->watchdog, asc_watchdog);
+	asc->need_init = true;
+	platform_set_drvdata(pdev, asc);
+
+	if (!device_iommu_mapped(dev))
+		return dev_err_probe(dev, -ENODEV, "no IOMMU\n");
+
+	/*
+	 * MSR-V and the ASE core domain below it; link both so they are on
+	 * exactly while the engine is runtime-active.
+	 */
+	if (of_count_phandle_with_args(dev->of_node, "power-domains",
+				       "#power-domain-cells") > 1) {
+		static const struct dev_pm_domain_attach_data pd_data = {
+			.pd_flags = PD_FLAG_DEV_LINK_ON,
+		};
+
+		ret = devm_pm_domain_attach_list(dev, &pd_data, &asc->pd_list);
+		if (ret < 0)
+			return dev_err_probe(dev, ret, "failed to attach power domains\n");
+	} else if (!dev->pm_domain) {
+		return dev_err_probe(dev, -ENODEV, "requires a power domain\n");
+	}
+
+	if (!platform_get_resource(pdev, IORESOURCE_MEM, asc->variant->num_reg - 1))
+		return dev_err_probe(dev, -EINVAL, "expected %u register ranges\n",
+				     asc->variant->num_reg);
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (resource_size(res) < ASC_MIN_REG_SIZE)
+		return dev_err_probe(dev, -EINVAL, "MSR aperture too small\n");
+	asc->regs = devm_ioremap_resource(dev, res);
+	if (IS_ERR(asc->regs))
+		return PTR_ERR(asc->regs);
+
+	asc->rst = devm_reset_control_get_optional_exclusive(dev, NULL);
+	if (IS_ERR(asc->rst))
+		return dev_err_probe(dev, PTR_ERR(asc->rst), "failed to get reset\n");
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(64));
+	if (ret)
+		return ret;
+
+	pm_runtime_set_autosuspend_delay(dev, 100);
+	pm_runtime_use_autosuspend(dev);
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	ret = asc_identify(asc);
+	if (ret)
+		return ret;
+
+	/* Interrupt 0 is the MSR (completion/error); 1 is the PIODMA engine. */
+	asc->irq = platform_get_irq(pdev, 0);
+	if (asc->irq < 0)
+		return asc->irq;
+	ret = devm_request_irq(dev, asc->irq, asc_irq, 0, dev_name(dev), asc);
+	if (ret)
+		return ret;
+
+	ret = v4l2_device_register(dev, &asc->v4l2_dev);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, asc_cleanup, asc);
+	if (ret)
+		return ret;
+	asc->m2m_dev = v4l2_m2m_init(&asc_m2m_ops);
+	if (IS_ERR(asc->m2m_dev)) {
+		ret = PTR_ERR(asc->m2m_dev);
+		asc->m2m_dev = NULL;
+		return ret;
+	}
+
+	vdev = &asc->vdev;
+	strscpy(vdev->name, ASC_NAME, sizeof(vdev->name));
+	vdev->fops = &asc_fops;
+	vdev->ioctl_ops = &asc_ioctl_ops;
+	vdev->release = video_device_release_empty;
+	vdev->lock = &asc->lock;
+	vdev->v4l2_dev = &asc->v4l2_dev;
+	vdev->vfl_dir = VFL_DIR_M2M;
+	vdev->device_caps = V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_STREAMING;
+	video_set_drvdata(vdev, asc);
+	return video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+}
+
+static void asc_remove(struct platform_device *pdev)
+{
+	struct apple_scaler *asc = platform_get_drvdata(pdev);
+
+	video_unregister_device(&asc->vdev);
+}
+
+/* J604 runtime ADT /arm-io/scaler0: hardware-version 0x14. */
+static const struct apple_scaler_variant apple_scaler_t8132 = {
+	.hw_version = 20,
+	.num_reg = 4,
+};
+
+static const struct apple_scaler_variant apple_scaler_t6041 = {
+	.hw_version = 21,
+	.num_reg = 4,
+};
+
+static const struct apple_scaler_variant apple_scaler_t8140 = {
+	.hw_version = 22,
+	.num_reg = 4,
+};
+
+static const struct of_device_id asc_of_match[] = {
+	{ .compatible = "apple,t8132-scaler", .data = &apple_scaler_t8132 },
+	{ .compatible = "apple,t6041-scaler", .data = &apple_scaler_t6041 },
+	{ .compatible = "apple,t8140-scaler", .data = &apple_scaler_t8140 },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, asc_of_match);
+
+static struct platform_driver asc_driver = {
+	.probe = asc_probe,
+	.remove = asc_remove,
+	.driver = {
+		.name = ASC_NAME,
+		.of_match_table = asc_of_match,
+		.pm = pm_ptr(&asc_pm_ops),
+	},
+};
+module_platform_driver(asc_driver);
+
+MODULE_DESCRIPTION("Apple silicon scaler and colour-space converter");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/apple/scaler/apple-scaler-hw.c b/drivers/media/platform/apple/scaler/apple-scaler-hw.c
new file mode 100644
index 0000000000..5eb645a776
--- /dev/null
+++ b/drivers/media/platform/apple/scaler/apple-scaler-hw.c
@@ -0,0 +1,423 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple silicon scaler/CSC (MSR): format table, colour matrices and
+ * scale ratios in register encoding.
+ *
+ * The colour matrices are derived here from the luma coefficients the
+ * standards define (Kr, Kb), not looked up, so every encoding/range pair
+ * comes from one formula. The format codes and component orders are the
+ * values the engine is driven with for those layouts.
+ */
+#include <linux/array_size.h>
+#include <linux/bits.h>
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/wordpart.h>
+
+#include <kunit/visibility.h>
+
+#include "apple-scaler-hw.h"
+
+#define ASC_SWIZZLE_IDENTITY	0x03020100
+#define ASC_SWIZZLE_CBCR	0x03000102
+
+static const struct asc_format asc_formats[] = {
+	{
+		/* Bytes B, G, R, A in memory. */
+		.fourcc = V4L2_PIX_FMT_ARGB32, .layout = 0x1, .code = 0x1e,
+		.sampling = 0x0, .swizzle = ASC_SWIZZLE_IDENTITY, .planes = 1,
+		.bpp = { 4 }, .hsub = 1, .vsub = 1, .alpha = true,
+	}, {
+		.fourcc = V4L2_PIX_FMT_XRGB32, .layout = 0x1, .code = 0x1e,
+		.sampling = 0x0, .swizzle = ASC_SWIZZLE_IDENTITY, .planes = 1,
+		.bpp = { 4 }, .hsub = 1, .vsub = 1,
+	}, {
+		.fourcc = V4L2_PIX_FMT_NV12M, .layout = 0xc, .code = 0x1,
+		.sampling = 0x6, .swizzle = ASC_SWIZZLE_CBCR, .planes = 2,
+		.bpp = { 1, 2 }, .hsub = 2, .vsub = 2, .yuv = true,
+	}, {
+		.fourcc = V4L2_PIX_FMT_NV12, .layout = 0xc, .code = 0x1,
+		.sampling = 0x6, .swizzle = ASC_SWIZZLE_CBCR, .planes = 2,
+		.bpp = { 1, 2 }, .hsub = 2, .vsub = 2, .yuv = true,
+	}, {
+		/* 10 bits in the top of each 16-bit sample. */
+		.fourcc = V4L2_PIX_FMT_P010, .layout = 0xc, .code = 0x2,
+		.sampling = 0x12, .swizzle = ASC_SWIZZLE_CBCR, .planes = 2,
+		.bpp = { 2, 4 }, .hsub = 2, .vsub = 2, .yuv = true, .wide = true,
+	},
+};
+
+const struct asc_format *asc_format_by_index(unsigned int index)
+{
+	return index < ARRAY_SIZE(asc_formats) ? &asc_formats[index] : NULL;
+}
+EXPORT_SYMBOL_IF_KUNIT(asc_format_by_index);
+
+const struct asc_format *asc_find_format(u32 fourcc)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(asc_formats); i++)
+		if (asc_formats[i].fourcc == fourcc)
+			return &asc_formats[i];
+	return NULL;
+}
+EXPORT_SYMBOL_IF_KUNIT(asc_find_format);
+
+/* Luma coefficients Kr and Kb in units of 1/10000. */
+struct asc_luma {
+	s64 kr, kb;
+};
+
+static int asc_luma_coefs(enum v4l2_ycbcr_encoding enc, struct asc_luma *l)
+{
+	switch (enc) {
+	case V4L2_YCBCR_ENC_601:
+	case V4L2_YCBCR_ENC_XV601:
+		*l = (struct asc_luma){ 2990, 1140 };
+		return 0;
+	case V4L2_YCBCR_ENC_709:
+	case V4L2_YCBCR_ENC_XV709:
+		*l = (struct asc_luma){ 2126, 722 };
+		return 0;
+	case V4L2_YCBCR_ENC_BT2020:
+		*l = (struct asc_luma){ 2627, 593 };
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+/* round(num / den) for signed num and positive den */
+static s64 asc_div_round(s64 num, s64 den)
+{
+	return num >= 0 ? div64_s64(num + den / 2, den) : -div64_s64(-num + den / 2, den);
+}
+
+/* A coefficient num/den (with the range scale sn/sd applied) in Q3.12. */
+static s16 asc_q12(s64 num, s64 den, s64 sn, s64 sd)
+{
+	return (s16)asc_div_round(num * sn << ASC_CSC_COEF_SHIFT, den * sd);
+}
+
+/*
+ * Offsets are in units of 2^-24 of full scale. The engine works on a
+ * 16-bit internal scale, so the limited-range black level (8-bit code 16)
+ * is 0x1010 there; the chroma midpoint is 0x8020 (10-bit code 512). These
+ * are the levels the engine is driven with on macOS for every encoding
+ * and depth.
+ */
+#define ASC_LUMA_BLACK	(0x1010 << 8)
+#define ASC_CHROMA_MID	(0x8020 << 8)
+
+/**
+ * asc_csc_compute - colour conversion between Y'CbCr and R'G'B'
+ * @enc: Y'CbCr encoding (luma coefficients)
+ * @quant: range of the Y'CbCr side (the R'G'B' side is full range)
+ * @yuv_to_rgb: direction
+ * @csc: result in register encoding
+ *
+ * Return: 0, or -EINVAL for an encoding the matrix cannot express.
+ */
+int asc_csc_compute(enum v4l2_ycbcr_encoding enc,
+		    enum v4l2_quantization quant, bool yuv_to_rgb,
+		    struct asc_csc *csc)
+{
+	const s64 one = 10000;
+	bool limited = quant != V4L2_QUANTIZATION_FULL_RANGE;
+	/* Range scales: luma 219/255 and chroma 224/255 for limited range. */
+	s64 yn = limited ? 219 : 1, yd = limited ? 255 : 1;
+	s64 cn = limited ? 224 : 1, cd = limited ? 255 : 1;
+	struct asc_luma l;
+	s64 kg;
+	int i;
+
+	if (asc_luma_coefs(enc, &l))
+		return -EINVAL;
+	kg = one - l.kr - l.kb;
+	memset(csc, 0, sizeof(*csc));
+
+	if (yuv_to_rgb) {
+		/* R = Y + 2(1-Kr) Cr, B = Y + 2(1-Kb) Cb, G from Y = Kr R + Kg G + Kb B */
+		for (i = 0; i < 3; i++)
+			csc->coef[i][0] = asc_q12(1, 1, yd, yn);
+		csc->coef[0][2] = asc_q12(2 * (one - l.kr), one, cd, cn);
+		csc->coef[1][1] = asc_q12(-2 * l.kb * (one - l.kb), one * kg, cd, cn);
+		csc->coef[1][2] = asc_q12(-2 * l.kr * (one - l.kr), one * kg, cd, cn);
+		csc->coef[2][1] = asc_q12(2 * (one - l.kb), one, cd, cn);
+		csc->pre[0] = limited ? -ASC_LUMA_BLACK : 0;
+		csc->pre[1] = -ASC_CHROMA_MID;
+		csc->pre[2] = -ASC_CHROMA_MID;
+	} else {
+		/* Y = Kr R + Kg G + Kb B, Cb = (B - Y) / 2(1-Kb), Cr = (R - Y) / 2(1-Kr) */
+		csc->coef[0][0] = asc_q12(l.kr, one, yn, yd);
+		csc->coef[0][1] = asc_q12(kg, one, yn, yd);
+		csc->coef[0][2] = asc_q12(l.kb, one, yn, yd);
+		csc->coef[1][0] = asc_q12(-l.kr, 2 * (one - l.kb), cn, cd);
+		csc->coef[1][1] = asc_q12(-kg, 2 * (one - l.kb), cn, cd);
+		csc->coef[1][2] = asc_q12(1, 2, cn, cd);
+		csc->coef[2][0] = asc_q12(1, 2, cn, cd);
+		csc->coef[2][1] = asc_q12(-kg, 2 * (one - l.kr), cn, cd);
+		csc->coef[2][2] = asc_q12(-l.kb, 2 * (one - l.kr), cn, cd);
+		csc->post[0] = limited ? ASC_LUMA_BLACK : 0;
+		csc->post[1] = ASC_CHROMA_MID;
+		csc->post[2] = ASC_CHROMA_MID;
+	}
+	return 0;
+}
+EXPORT_SYMBOL_IF_KUNIT(asc_csc_compute);
+
+u32 asc_csc_offset_reg(s32 offset)
+{
+	return (u32)offset & ASC_CSC_OFFSET_MASK;
+}
+EXPORT_SYMBOL_IF_KUNIT(asc_csc_offset_reg);
+
+/**
+ * asc_scale_ratio - one scaler ratio register value
+ * @in: input extent in pixels
+ * @out: output extent in pixels
+ *
+ * Return: in/out in Q22 with the two lowest bits clear, as the engine
+ * takes it; 0 if @out is 0.
+ */
+u32 asc_scale_ratio(u32 in, u32 out)
+{
+	if (!out)
+		return 0;
+	return (u32)div_u64((u64)in << ASC_RATIO_SHIFT, out) & ~3u;
+}
+EXPORT_SYMBOL_IF_KUNIT(asc_scale_ratio);
+
+/*
+ * Job programming. The engine takes the whole pipeline state for every
+ * job; nothing carries over from the previous one. The order below follows
+ * the pipeline (source, destination, chroma, scaler, CSC, memory system)
+ * and ends with the pre-start tag and START.
+ */
+struct asc_emit {
+	struct asc_reg *w;
+	unsigned int n, max;
+};
+
+static void asc_emit(struct asc_emit *e, u32 off, u32 val)
+{
+	if (e->n < e->max)
+		e->w[e->n] = (struct asc_reg){ off, val };
+	e->n++;
+}
+
+/* Source (read DMA) and destination (write DMA) register banks. */
+struct asc_dma_regs {
+	u32 layout, code, sampling, plane, stride, offset, swizzle, size;
+	u32 plane_width, plane_height;
+	u32 flag;	/* or-ed into layout-adjacent words on the write side */
+};
+
+static const struct asc_dma_regs asc_rdma = {
+	.layout = 0x180, .code = 0x184, .sampling = 0x188, .plane = 0x198,
+	.stride = 0x1d8, .offset = 0x1e8, .swizzle = 0x1f8, .size = 0x1fc,
+	.plane_width = 0x234, .plane_height = 0x244, .flag = 0,
+};
+
+static const struct asc_dma_regs asc_wdma = {
+	.layout = 0x280, .code = 0x284, .sampling = 0x288, .plane = 0x290,
+	.stride = 0x2c0, .offset = 0x2cc, .swizzle = 0x2d8, .size = 0x2dc,
+	.plane_width = 0x308, .plane_height = 0x314, .flag = BIT(15),
+};
+
+static void asc_emit_image(struct asc_emit *e, const struct asc_dma_regs *r,
+			   const struct asc_image *img)
+{
+	const struct asc_format *f = img->fmt;
+	/* Plane 2 is never used; the engine still takes it at luma size. */
+	u32 pw[3] = { img->width, img->width / f->hsub, img->width };
+	u32 ph[3] = { img->height, img->height / f->vsub, img->height };
+	unsigned int i, nplanes = f->planes == 1 ? 3 : f->planes;
+
+	asc_emit(e, r->layout, f->layout);
+	asc_emit(e, r->code, r->flag | f->code);
+	asc_emit(e, r->sampling, r->flag | f->sampling);
+	if (r->flag)
+		asc_emit(e, r->sampling + 4, r->flag);
+	else {
+		asc_emit(e, r->sampling + 4, 0);
+		asc_emit(e, r->sampling + 8, 0);
+	}
+	for (i = 0; i < nplanes; i++) {
+		u64 dva = i < f->planes ? img->dva[i] : 0;
+
+		asc_emit(e, r->plane + 8 * i, lower_32_bits(dva));
+		asc_emit(e, r->plane + 8 * i + 4, upper_32_bits(dva));
+		asc_emit(e, r->stride + 4 * i, i < f->planes ? img->stride[i] : 0);
+	}
+	for (i = 0; i < 3; i++)
+		asc_emit(e, r->offset + 4 * i, 0);
+	asc_emit(e, r->swizzle, f->swizzle);
+	asc_emit(e, r->size, img->width);
+	asc_emit(e, r->size + 4, img->height);
+	for (i = 0; i < 3; i++) {
+		asc_emit(e, r->plane_width + 4 * i, f->planes == 1 ? img->width : pw[i]);
+		asc_emit(e, r->plane_height + 4 * i, f->planes == 1 ? img->height : ph[i]);
+	}
+}
+
+/* Per-plane memory request words, as the engine is driven on macOS. */
+static void asc_emit_memory(struct asc_emit *e, const struct asc_job *job)
+{
+	const struct asc_format *s = job->src.fmt, *d = job->dst.fmt;
+	u32 wide = s->wide ? BIT(1) : 0;
+	unsigned int i;
+
+	for (i = 0; i < 4; i++) {
+		asc_emit(e, 0x204 + 4 * i, 0x0007d311);
+		asc_emit(e, 0x214 + 4 * i, 0x00000707);
+		asc_emit(e, 0x224 + 4 * i, 0x00000020);
+	}
+	for (i = 0; i < 3; i++) {
+		asc_emit(e, 0x2e4 + 4 * i, 0x000ac211);
+		asc_emit(e, 0x2f0 + 4 * i, 0x0c0ac207);
+		asc_emit(e, 0x2fc + 4 * i, 0x04000620);
+	}
+	asc_emit(e, 0x254, 1);
+
+	for (i = 0; i < 4; i++)
+		asc_emit(e, 0x13800 + 4 * i, 0);
+	asc_emit(e, 0x13810, 0x8 | wide);
+	asc_emit(e, 0x13814, (s->yuv ? 0x28 : 0x8) | wide);
+	asc_emit(e, 0x13818, (s->yuv ? 0x28 : 0x8) | wide);
+	asc_emit(e, 0x1381c, s->yuv ? 0x20 : 0x8);
+	asc_emit(e, 0x13c04, 0);
+	asc_emit(e, 0x13c10, 0x8);
+	asc_emit(e, 0x13c14, d->yuv ? 0x28 : 0x8);
+	asc_emit(e, 0x13c18, d->yuv ? 0x28 : 0x8);
+	asc_emit(e, 0x13c1c, d->yuv ? 0x20 : 0x8);
+	asc_emit(e, 0x13c00, 1);
+}
+
+static void asc_emit_chroma(struct asc_emit *e, const struct asc_job *job)
+{
+	/* Upsampler interpolation weights, 0x800 = one half. */
+	static const u32 up[8] = { 0, 0x800, 0x800, 0, 0, 0x800, 0x800, 0 };
+	/* 2x2 ordered-dither index pattern, repeated over 4x4. */
+	static const u32 dither[16] = { 0, 2, 0, 2, 3, 1, 3, 1, 0, 2, 0, 2, 3, 1, 3, 1 };
+	const struct asc_format *s = job->src.fmt, *d = job->dst.fmt;
+	unsigned int i;
+
+	asc_emit(e, 0x800, s->yuv && s->hsub > 1 ? 0xd : 0xc);
+	if (s->yuv && s->hsub > 1)
+		for (i = 0; i < ARRAY_SIZE(up); i++)
+			asc_emit(e, 0x804 + 4 * i, up[i]);
+	asc_emit(e, 0x824, 0xc);
+	asc_emit(e, 0x900, d->yuv && d->hsub > 1 ? 0x00010103 : 0);
+	if (s->wide && !d->wide) {
+		asc_emit(e, 0xa00, 0x02020200);
+		for (i = 0; i < ARRAY_SIZE(dither); i++)
+			asc_emit(e, 0xa80 + 4 * i, dither[i]);
+	} else {
+		asc_emit(e, 0xa00, 0);
+	}
+}
+
+/* Scaler at 1:1: polyphase filters off, unit ratios, zero initial phase. */
+static void asc_emit_unscaled(struct asc_emit *e, const struct asc_job *job)
+{
+	static const u32 base[2] = { 0x1000, 0x2000 };
+	u32 flags = job->src.fmt->yuv && job->src.fmt->hsub > 1 ? BIT(1) : 0;
+	u32 one = 1u << ASC_RATIO_SHIFT;
+	unsigned int i;
+
+	for (i = 0; i < 2; i++) {
+		asc_emit(e, base[i], flags);
+		asc_emit(e, base[i] + 0x04, 0);
+		asc_emit(e, base[i] + 0x08, 0);
+		asc_emit(e, base[i] + 0x0c, one);
+		asc_emit(e, base[i] + 0x10, one);
+		asc_emit(e, base[i] + 0x14, one);
+		asc_emit(e, base[i] + 0x18, one);
+		asc_emit(e, base[i] + 0x1c, 0);
+		asc_emit(e, base[i] + 0x20, one);
+		asc_emit(e, base[i] + 0x24, one);
+	}
+	asc_emit(e, 0x480, 0);
+}
+
+static void asc_emit_csc(struct asc_emit *e, const struct asc_csc *csc)
+{
+	unsigned int r, c;
+
+	asc_emit(e, ASC_CSC_MODE, ASC_CSC_MODE_DEFAULT);
+	for (c = 0; c < 3; c++)
+		asc_emit(e, ASC_CSC_PRE_OFFSET(c), asc_csc_offset_reg(csc->pre[c]));
+	for (r = 0; r < 3; r++)
+		for (c = 0; c < 3; c++)
+			asc_emit(e, ASC_CSC_COEF(r, c), (u16)csc->coef[r][c]);
+	for (c = 0; c < 3; c++)
+		asc_emit(e, ASC_CSC_POST_OFFSET(c), asc_csc_offset_reg(csc->post[c]));
+	/* Output clamps: full signed range on every channel. */
+	for (c = 0; c < 3; c++) {
+		asc_emit(e, 0xa98c + 4 * c, 0x80000001);
+		asc_emit(e, 0xa998 + 4 * c, 0x7fffffff);
+		asc_emit(e, 0xa9a4 + 4 * c, 0x80000001);
+		asc_emit(e, 0xa9b0 + 4 * c, 0x7fffffff);
+	}
+	asc_emit(e, ASC_CSC_CTRL, ASC_CSC_CTRL_ENABLE);
+}
+
+/* Control words the engine is driven with for every job on macOS. */
+static const struct asc_reg asc_job_fixed[] = {
+	{ 0x000e4, 0x00000000 }, { 0x000e8, 0x00000038 }, { 0x00124, 0x00000000 },
+	{ 0x00380, 0x00000000 }, { 0x03000, 0x00000000 }, { 0x07418, 0xffffffff },
+	{ 0x16000, 0x00000000 }, { 0x16004, 0x244024c0 }, { 0x16080, 0x00000000 },
+	{ 0x16084, 0x0b710367 }, { 0x16088, 0x00000128 }, { 0x16504, 0x02000500 },
+	{ 0x16508, 0x00003200 }, { 0x1651c, 0x00851400 }, { 0x16534, 0x00000008 },
+	{ 0x16568, 0x00250500 }, { 0x16588, 0x00496513 }, { 0x16600, 0x00000015 },
+	{ 0x16800, 0x00000000 }, { 0x25080, 0x00000000 }, { 0x2e300, 0x03804038 },
+	{ 0x2e304, 0xa0a0a0a0 }, { 0x2e308, 0x02550000 }, { 0x2e30c, 0x02550255 },
+	{ 0x2e310, 0x00000000 }, { 0x2e314, 0x00100008 }, { 0x2e318, 0x02550000 },
+};
+
+/**
+ * asc_job_build - register writes for one job, in order
+ * @job: the conversion; source and destination must be the same size
+ * @w: output array
+ * @max: capacity of @w
+ *
+ * Return: number of writes, -EINVAL for a job this path cannot run, or
+ * -ENOSPC if @w is too small.
+ */
+int asc_job_build(const struct asc_job *job, struct asc_reg *w, unsigned int max)
+{
+	const struct asc_format *s = job->src.fmt, *d = job->dst.fmt;
+	struct asc_emit e = { .w = w, .max = max };
+	unsigned int i;
+
+	if (!s || !d || job->src.width != job->dst.width ||
+	    job->src.height != job->dst.height)
+		return -EINVAL;
+	/* Y'CbCr <-> R'G'B' needs a matrix; same-family jobs must not have one. */
+	if ((s->yuv != d->yuv) != !!job->csc)
+		return -EINVAL;
+
+	asc_emit(&e, ASC_CSC_CTRL, ASC_CSC_CTRL_BYPASS);
+	asc_emit_image(&e, &asc_rdma, &job->src);
+	asc_emit_image(&e, &asc_wdma, &job->dst);
+	asc_emit_memory(&e, job);
+	/* Alpha fill: constant opaque alpha when the source has none. */
+	asc_emit(&e, 0x8c, (d->alpha && !s->alpha ? BIT(31) : 0) | 0xffff);
+	asc_emit_chroma(&e, job);
+	asc_emit_unscaled(&e, job);
+	if (job->csc)
+		asc_emit_csc(&e, job->csc);
+	for (i = 0; i < ARRAY_SIZE(asc_job_fixed); i++)
+		asc_emit(&e, asc_job_fixed[i].off, asc_job_fixed[i].val);
+	asc_emit(&e, 0x110, job->transform_id);
+	asc_emit(&e, 0x098, 0xfffffffe);
+	asc_emit(&e, 0x080, 1);
+
+	return e.n <= max ? e.n : -ENOSPC;
+}
+EXPORT_SYMBOL_IF_KUNIT(asc_job_build);
diff --git a/drivers/media/platform/apple/scaler/apple-scaler-hw.h b/drivers/media/platform/apple/scaler/apple-scaler-hw.h
new file mode 100644
index 0000000000..cf371272dc
--- /dev/null
+++ b/drivers/media/platform/apple/scaler/apple-scaler-hw.h
@@ -0,0 +1,127 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Apple silicon scaler/CSC (MSR): pipeline field encodings.
+ *
+ * These helpers compute register values from V4L2 state. They touch no
+ * hardware, so KUnit checks them against the values the engine is known
+ * to accept.
+ */
+#ifndef APPLE_SCALER_HW_H
+#define APPLE_SCALER_HW_H
+
+#include <linux/types.h>
+#include <linux/videodev2.h>
+
+/* Colour-space converter block. */
+#define ASC_CSC_CTRL			0x3800
+#define   ASC_CSC_CTRL_BYPASS		0x000e0000
+#define   ASC_CSC_CTRL_ENABLE		0x000e0003
+#define ASC_CSC_MODE			0x3804
+#define   ASC_CSC_MODE_DEFAULT		0xc
+#define ASC_CSC_PRE_OFFSET(i)		(0x3808 + 4 * (i))
+#define ASC_CSC_COEF(row, col)		(0x3814 + 4 * (3 * (row) + (col)))
+#define ASC_CSC_POST_OFFSET(i)		(0x3838 + 4 * (i))
+
+/* Matrix coefficients are signed Q3.12. */
+#define ASC_CSC_COEF_SHIFT		12
+/* Offsets are signed fractions of full scale: 1.0 = 1 << 24, 26-bit field. */
+#define ASC_CSC_OFFSET_SHIFT		24
+#define ASC_CSC_OFFSET_MASK		GENMASK(25, 0)
+
+/* Scale ratios are unsigned Q22. */
+#define ASC_RATIO_SHIFT			22
+
+/**
+ * struct asc_csc - one colour conversion, in register encoding
+ * @coef: 3x3 matrix, row = output channel, column = input channel
+ * @pre: offsets added to the input channels before the matrix
+ * @post: offsets added to the output channels after the matrix
+ */
+struct asc_csc {
+	s16 coef[3][3];
+	s32 pre[3];
+	s32 post[3];
+};
+
+/**
+ * struct asc_format - a pixel format the engine reads and writes
+ * @fourcc: V4L2 pixel format
+ * @layout: layout class (source 0x180 / destination 0x280)
+ * @code: format code (source 0x184; destination 0x284 without bit 15)
+ * @sampling: subsampling descriptor (source 0x188 / destination 0x288 without bit 15)
+ * @swizzle: component order (source 0x1f8 / destination 0x2d8)
+ * @planes: colour planes (each needs its own DMA address)
+ * @bpp: bytes per sample position of each plane, at that plane's resolution
+ * @hsub: horizontal chroma subsampling of plane 1
+ * @vsub: vertical chroma subsampling of plane 1
+ * @yuv: Y'CbCr format (needs the CSC to pair with RGB)
+ * @alpha: carries an alpha channel
+ * @wide: samples are 16 bits in memory (more than 8 significant bits)
+ */
+struct asc_format {
+	u32 fourcc;
+	u32 layout;
+	u32 code;
+	u32 sampling;
+	u32 swizzle;
+	u8 planes;
+	u8 bpp[2];
+	u8 hsub;
+	u8 vsub;
+	bool yuv;
+	bool alpha;
+	bool wide;
+};
+
+/* One register write: byte offset in the MSR aperture and value. */
+struct asc_reg {
+	u32 off;
+	u32 val;
+};
+
+#define ASC_MAX_PLANES		2
+#define ASC_JOB_MAX_WRITES	224
+
+/**
+ * struct asc_image - one side of a job
+ * @fmt: pixel format
+ * @width: width in pixels
+ * @height: height in pixels
+ * @dva: DMA address of each colour plane
+ * @stride: bytes per line of each colour plane
+ */
+struct asc_image {
+	const struct asc_format *fmt;
+	u32 width;
+	u32 height;
+	u64 dva[ASC_MAX_PLANES];
+	u32 stride[ASC_MAX_PLANES];
+};
+
+/**
+ * struct asc_job - a complete conversion
+ * @src: image read
+ * @dst: image written
+ * @csc: colour conversion, or NULL to pass components through
+ * @transform_id: tag the engine carries for this job
+ */
+struct asc_job {
+	struct asc_image src;
+	struct asc_image dst;
+	const struct asc_csc *csc;
+	u32 transform_id;
+};
+
+int asc_job_build(const struct asc_job *job, struct asc_reg *w, unsigned int max);
+
+const struct asc_format *asc_find_format(u32 fourcc);
+const struct asc_format *asc_format_by_index(unsigned int index);
+
+int asc_csc_compute(enum v4l2_ycbcr_encoding enc,
+		    enum v4l2_quantization quant, bool yuv_to_rgb,
+		    struct asc_csc *csc);
+u32 asc_csc_offset_reg(s32 offset);
+
+u32 asc_scale_ratio(u32 in, u32 out);
+
+#endif /* APPLE_SCALER_HW_H */
diff --git a/drivers/media/platform/apple/scaler/apple-scaler-regs.h b/drivers/media/platform/apple/scaler/apple-scaler-regs.h
new file mode 100644
index 0000000000..6abbcb7759
--- /dev/null
+++ b/drivers/media/platform/apple/scaler/apple-scaler-regs.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Apple silicon scaler/CSC (MSR) register map, global block.
+ *
+ * Offsets are bytes from the start of the MSR aperture (reg index 0).
+ * The global control registers are common to every direct-MMIO MSR
+ * generation (hardware-version 10 through 22).
+ */
+#ifndef APPLE_SCALER_REGS_H
+#define APPLE_SCALER_REGS_H
+
+#include <linux/bits.h>
+
+#define ASC_HW_VERSION			0x0000
+#define ASC_RESET			0x0004
+#define   ASC_RESET_ENGINE		BIT(0)
+#define ASC_RESET_APIODMA		0x0008
+#define ASC_IS_RUNNING			0x000c
+#define ASC_REG_FIFO_AVAIL		0x0014
+#define ASC_IRQ_ENABLE			0x0018
+#define ASC_IRQ_STATUS			0x001c
+#define   ASC_IRQ_DONE			BIT(0)
+#define   ASC_IRQ_DEBUG_ERROR		BIT(1)
+#define   ASC_IRQ_READ_ERROR		BIT(3)
+#define   ASC_IRQ_WRITE_ERROR		BIT(4)
+#define   ASC_IRQ_DECOMPRESS_ERROR	BIT(9)
+#define   ASC_IRQ_CONTEXT_SWITCH	BIT(10)
+#define   ASC_IRQ_AXI_ERROR		BIT(12)
+#define   ASC_IRQ_ERRORS		(ASC_IRQ_DEBUG_ERROR | ASC_IRQ_READ_ERROR | \
+					 ASC_IRQ_WRITE_ERROR | ASC_IRQ_DECOMPRESS_ERROR | \
+					 ASC_IRQ_AXI_ERROR)
+#define ASC_FRAME_COUNT			0x0020
+#define ASC_START			0x0080
+#define ASC_PRE_START			0x0098
+#define ASC_DEBUG_STATUS		0x009c
+#define ASC_TRANSFORM_ID		0x0110
+
+#endif /* APPLE_SCALER_REGS_H */
diff --git a/drivers/media/platform/apple/scaler/apple-scaler-test.c b/drivers/media/platform/apple/scaler/apple-scaler-test.c
new file mode 100644
index 0000000000..4e61ad54e5
--- /dev/null
+++ b/drivers/media/platform/apple/scaler/apple-scaler-test.c
@@ -0,0 +1,482 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests for the Apple scaler/CSC register encodings.
+ *
+ * The expected words are what the engine was driven with for the same
+ * conversions in our macOS capture (traces/display/20261108-msr-trace),
+ * and they equal the textbook BT.601/BT.709/BT.2020 matrices in Q3.12.
+ */
+#include <kunit/test.h>
+#include <linux/array_size.h>
+#include <linux/math.h>
+#include <linux/string.h>
+
+#include "apple-scaler-hw.h"
+#include "apple-scaler-regs.h"
+
+struct asc_csc_case {
+	const char *name;
+	enum v4l2_ycbcr_encoding enc;
+	enum v4l2_quantization quant;
+	bool yuv_to_rgb;
+	u16 coef[9];
+	u32 pre[3];
+	u32 post[3];
+};
