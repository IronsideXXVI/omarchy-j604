index 0000000000..7d14b5e95a
--- /dev/null
+++ b/include/linux/soc/apple/sleep.h
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Apple SoC system sleep helpers
+ *
+ * Each power-down call (..._off(), ..._gate()) records what it changed so
+ * that the matching ..._restore() puts back exactly those register fields;
+ * a restore without a preceding power-down call is a no-op. If a power-down
+ * call fails part way, the matching restore still undoes the part that was
+ * applied.
+ *
+ * apple_sleep_pmgr_wake() sets bit 31 of PMGR_SOC + 0xc000, the first PMGR
+ * write needed after the SoC returns from suspend-to-RAM.
+ *
+ * apple_sleep_ap_wake_arm() masks every AP wake source except those listed
+ * in apple,ap-wake-sources, for suspend-to-RAM; it returns -ENOENT if the
+ * node lists none.
+ *
+ * All calls are atomic (spinlocked regmaps, busy-waits of at most 8 ms per
+ * register) and may be made with interrupts disabled. The power-down calls
+ * return -ENODEV if the PMGR sleep node is absent; the others then do
+ * nothing.
+ */
+
+#ifndef _LINUX_SOC_APPLE_SLEEP_H_
+#define _LINUX_SOC_APPLE_SLEEP_H_
+
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+#include <linux/types.h>
+
+struct device;
+
+#if IS_ENABLED(CONFIG_APPLE_SLEEP)
+
+int apple_sleep_sio_off(void);
+void apple_sleep_sio_restore(void);
+int apple_sleep_afr_off(void);
+void apple_sleep_afr_restore(void);
+int apple_sleep_soc_clusters_off(void);
+void apple_sleep_soc_clusters_restore(void);
+int apple_sleep_cpm_gate(void);
+void apple_sleep_cpm_restore(void);
+void apple_sleep_pmgr_wake(void);
+int apple_sleep_ap_wake_arm(void);
+void apple_sleep_ap_wake_restore(void);
+/*
+ * From the SMC's driver, in its noirq resume: the SMC woke the AP for the lid alone, and the
+ * lid reads closed. If nothing else woke the SoC, the PM core goes back to sleep once every
+ * device has resumed.
+ */
+void apple_sleep_lid_closed_wake(void);
+
+#else
+
+static inline int apple_sleep_sio_off(void) { return -ENODEV; }
+static inline void apple_sleep_sio_restore(void) { }
+static inline int apple_sleep_afr_off(void) { return -ENODEV; }
+static inline void apple_sleep_afr_restore(void) { }
+static inline int apple_sleep_soc_clusters_off(void) { return -ENODEV; }
+static inline void apple_sleep_soc_clusters_restore(void) { }
+static inline int apple_sleep_cpm_gate(void) { return -ENODEV; }
+static inline void apple_sleep_cpm_restore(void) { }
+static inline void apple_sleep_pmgr_wake(void) { }
+static inline int apple_sleep_ap_wake_arm(void) { return -ENODEV; }
+static inline void apple_sleep_ap_wake_restore(void) { }
+static inline void apple_sleep_lid_closed_wake(void) { }
+
+#endif
+
+/*
+ * Coprocessors that suspend-to-RAM takes down (apple-s2r). A coprocessor that
+ * can't be stopped until the sleep is certain, and comes back only through a
+ * real sleep, registers here. Once its driver has quiesced it and set it
+ * ready, ->enter() runs every registered @last_check with interrupts off and
+ * one CPU up (a negative return refuses the sleep, and the coprocessor must
+ * still be able to carry on), then the enclave's @tell, then, past the last
+ * refusal, each @last_stop: those registered with _first() before the others.
+ * For a coprocessor registered with an ASC, the run bit is cleared after its
+ * @last_stop. @last_stop can't refuse; the sleep goes on.
+ * apple_sleep_coproc_stopped() tells a resume path whether that happened: after
+ * a refused or aborted sleep, false means the coprocessor still runs.
+ * T8132 has no PCIe ANS block: @pcie_ans must be false.
+ */
+#if IS_ENABLED(CONFIG_APPLE_S2R)
+int apple_sleep_coproc_register(struct device *dev, void __iomem *asc, bool pcie_ans,
+				int (*last_stop)(void *data), void *data);
+int apple_sleep_coproc_register_first(struct device *dev, int (*last_stop)(void *data),
+				      void *data);
+void apple_sleep_coproc_unregister(struct device *dev);
+int apple_sleep_coproc_set_last_check(struct device *dev, int (*last_check)(void *data));
+int apple_sleep_enclave_register(struct device *dev, int (*tell)(void *data), void *data);
+void apple_sleep_enclave_unregister(struct device *dev);
+void apple_sleep_coproc_set_ready(struct device *dev, bool ready);
+bool apple_sleep_coproc_stopped(struct device *dev);
+/* After a deep sleep, put back the pins it reset. ANS's driver calls it before the run bit. */
+void apple_sleep_restore_pins(void);
+#else
+static inline int apple_sleep_coproc_register(struct device *dev, void __iomem *asc,
+					      bool pcie_ans, int (*last_stop)(void *data),
+					      void *data) { return -EOPNOTSUPP; }
+static inline int apple_sleep_coproc_register_first(struct device *dev,
+						    int (*last_stop)(void *data),
+						    void *data) { return -EOPNOTSUPP; }
+static inline void apple_sleep_coproc_unregister(struct device *dev) { }
+static inline int apple_sleep_coproc_set_last_check(struct device *dev,
+						    int (*last_check)(void *data)) { return -EOPNOTSUPP; }
+static inline int apple_sleep_enclave_register(struct device *dev, int (*tell)(void *data),
+					       void *data) { return -EOPNOTSUPP; }
+static inline void apple_sleep_enclave_unregister(struct device *dev) { }
+static inline void apple_sleep_coproc_set_ready(struct device *dev, bool ready) { }
+static inline bool apple_sleep_coproc_stopped(struct device *dev) { return false; }
+static inline void apple_sleep_restore_pins(void) { }
+#endif
+
+/*
+ * Aurora's T8140 controller cuts the USB-C debug link before the SMC's notice.
+ * apple-s2r stops no debug link, so there is nothing to wait out.
+ */
+static inline bool apple_sleep_debug_link_cut(void)
+{
+	return false;
+}
+
+/*
+ * Nor does a sleep here cold-reset a port controller to end one: there is no
+ * debug link to rearm and no setup to expect from that after the wake.
+ */
+static inline bool apple_sleep_debug_link_was_cut(struct device *dev)
+{
+	return false;
+}
+
+static inline bool apple_sleep_debug_link_cut_peek(struct device *dev)
+{
+	return false;
+}
+
+/*
+ * A USB host that sleeps in place (see apple_atcphy_sleep_prepare()) needs its
+ * PHY's controller power control, which only Aurora's T8140 PHY has. apple-s2r
+ * lowers no ATC power domain itself, so there is no USB_AON domain to keep for
+ * such a host, and as none sleeps in place, no port has a USB wake to arm.
+ */
+static inline void apple_sleep_usb_set_asleep(bool asleep)
+{
+}
+
+static inline void apple_sleep_usb_set_wake_ports(unsigned long ports)
+{
+}
+
+static inline bool apple_sleep_usb_port_can_wake(unsigned int port)
+{
+	return false;
+}
+
+#endif /* _LINUX_SOC_APPLE_SLEEP_H_ */
