+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * MacBook Pro (14-inch, M4, 2024): the J604 delta on top of Aurora's
+ * t8132-j604.dts (DjDeveloperr's ADT-derived board file and the shared T8132
+ * files). Everything below is what the 1.617 J604 series described
+ * for this machine and Aurora 7.3 does not; the original commits and authors
+ * are those of the 1.617 series.
+ *
+ * Storage, the nub SPMI bus and its PMU stay as 1.617 described them (proven
+ * with m1n1 1.608): Aurora's boot-loader-filled placeholders and the aliases
+ * that ask the boot loader to fill them are removed for this board.
+ */
+
+/ {
+	aliases {
+		/delete-property/ ans;
+		/delete-property/ ans-mbox;
+		/delete-property/ sart-ans;
+		/delete-property/ spmi-primary;
+		/delete-property/ pmu-primary;
+		/delete-property/ nvram;
+	};
+};
+
+/delete-node/ &{/soc/nvme@40000};
+/delete-node/ &{/soc/iommu@10000};
+/delete-node/ &{/soc/mbox@0};
+/delete-node/ &{/soc/spmi@0};
+
+/* The speaker amps and the sound card, gated as on 1.617 (macaudio + tas2764 safety chain). */
+&{/soc/i2c@3ad01c000/codec@38} { status = "okay"; };
+&{/soc/i2c@3ad01c000/codec@39} { status = "okay"; };
+&{/soc/i2c@3ad01c000/codec@3a} { status = "okay"; };
+&{/soc/i2c@3ad01c000/codec@3b} { status = "okay"; };
+&{/soc/i2c@3ad01c000/codec@3c} { status = "okay"; };
+&{/soc/i2c@3ad01c000/codec@3d} { status = "okay"; };
+&{/sound} { status = "okay"; };
+
+/* The boot framebuffer keeps no power domains (1.617: drop them, the DCP owns the display). */
+&{/chosen/framebuffer@0} { /delete-property/ power-domains; };
+
+/*
+ * The video decoder keeps 1.617's node (avd@3a1080000, the four named windows
+ * the AVD driver maps); Aurora's video-decoder@3a0000000 is a disabled
+ * placeholder ("the driver register layout is not selected here") and stays so.
+ */
+
+/* ---- generated delta (1.617 J604 DT vs Aurora 7.3 + the lines above) ---- */
+
+/ {
+	pmgr_s2r: power-management-s2r {
+		compatible = "apple,t8132-pmgr-s2r";
+		apple,pmgr = <&pmgr>;
+		apple,cpu-clusters = <0x00 0x01>;
