+	apple_rtkit_mailbox_off(rtk);
+
+	/* Twice, each time from what it reads back. */
+	writel(readl(cpu_control) & ~APPLE_ASC_CPU_CONTROL_RUN, cpu_control);
+	writel(readl(cpu_control) & ~APPLE_ASC_CPU_CONTROL_RUN, cpu_control);
