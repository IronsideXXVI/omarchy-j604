+EXPORT_SYMBOL_GPL(apple_rtkit_mailbox_recv_off);
+
+int apple_rtkit_sleep_stop(struct apple_rtkit *rtk, void __iomem *cpu_control)
+{
+	int ret;
+
+	ret = apple_rtkit_sleep_idle(rtk, cpu_control);
+	if (ret)
+		return ret;
