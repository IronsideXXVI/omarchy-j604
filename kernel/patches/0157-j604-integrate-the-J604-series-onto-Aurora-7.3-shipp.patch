new file mode 100644
index 0000000000..81f34c7ff3
--- /dev/null
+++ b/drivers/soc/apple/pmp-display-sleep-test.c
@@ -0,0 +1,263 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * KUnit tests for the retained PMP votes through a system sleep that stops
+ * the PMP (pmp-display-sleep.h). No hardware: a model of the bridge's vote
+ * state, driven in the order the PM core and the DCP drive the real one.
+ */
+#include <kunit/test.h>
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include "pmp-display-sleep.h"
+
+/* The bridge's vote state as the model drives it: get/put as the consumer calls them. */
+struct model {
+	struct pmp_display_sleep s;
+	struct pmp_display_sleep_votes v;
+	unsigned int sends;
+};
+
+/* apple_pmp_j713_display_get(): sends only when admitted and not yet held. */
+static int model_get_disp(struct model *m)
+{
+	if (!pmp_display_sleep_admits(&m->s))
+		return -EBUSY;
+	if (!m->v.disp_held) {
+		m->sends++;
+		m->v.disp_held = true;
+	}
+	return 0;
+}
+
+/* apple_pmp_j713_display_put(): a vote not held needs nothing sent. */
+static int model_put_disp(struct model *m)
+{
+	if (m->v.disp_held) {
+		m->sends++;
+		m->v.disp_held = false;
+	}
+	return 0;
+}
+
+static void model_boot(struct model *m)
+{
+	*m = (struct model) {};
+	/* Probe: the DCP takes DISP at bring-up. */
+	model_get_disp(m);
+}
+
+/* No consumer: refused, as before the check, whatever the votes are; nothing changes. */
+static void pmp_sleep_refused_without_consumer(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+	/* Even with every vote released, the refusal stays until a consumer opts in. */
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+	KUNIT_EXPECT_TRUE(test, pmp_display_sleep_admits(&m.s));
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+}
+
+/* The consumer's suspend runs first and releases DISP; the PMP stops; resume reverses it. */
+static void pmp_sleep_teardown_restore_order(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	/* DCP .suspend: power gate (put), then arm this sleep (display_sleep_enable). */
+	KUNIT_EXPECT_EQ(test, model_put_disp(&m), 0);
+	KUNIT_EXPECT_EQ(test, m.sends, 2U);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	/* PMP suspend_late. */
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_TRUE(test, m.s.asleep);
+	/* Nothing reaches the stopped PMP. */
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), -EBUSY);
+	KUNIT_EXPECT_FALSE(test, m.v.disp_held);
+	KUNIT_EXPECT_EQ(test, m.sends, 2U);
+	/* PMP resume_early, then DCP .resume: ungate, get. */
+	pmp_display_sleep_leave(&m.s);
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+	KUNIT_EXPECT_TRUE(test, m.v.disp_held);
+	KUNIT_EXPECT_EQ(test, m.sends, 3U);
+	/* The wake ended the arming: a second sleep arms again, the same way. */
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	pmp_display_sleep_leave(&m.s);
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+}
+
+/* Wrong order: the PMP asked before its consumer released DISP. Refused; nothing changes. */
+static void pmp_sleep_refused_disp_held(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	m.s.consumer = true;
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_DISP_HELD);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+	KUNIT_EXPECT_TRUE(test, m.v.disp_held);
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+	KUNIT_EXPECT_EQ(test, m.sends, 1U);
+}
+
+/* AGX has no release: once the GPU took it, every such sleep is refused. */
+static void pmp_sleep_refused_agx_held(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	m.s.consumer = true;
+	model_put_disp(&m);
+	m.v.agx_held = true;
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_AGX_HELD);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+}
+
+static void pmp_sleep_refused_pending_or_failed(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	m.s.consumer = true;
+	model_put_disp(&m);
+	m.v.pending = true;
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_PENDING);
+	m.v.pending = false;
+	m.v.error = -EPROTO;		/* closed stream: DISP could not be taken again */
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_FAILED);
+	m.v.error = 0;
+	m.v.provider_error = -EIO;	/* failed owner: before any other reason */
+	m.v.pending = true;
+	m.v.agx_held = true;
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_FAILED);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+}
+
+/* suspend_late for a PMP still stopped from a refused sleep; wake twice. */
+static void pmp_sleep_enter_leave_idempotent(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	m.s.consumer = true;
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_TRUE(test, m.s.asleep);
+	pmp_display_sleep_leave(&m.s);
+	pmp_display_sleep_leave(&m.s);
+	KUNIT_EXPECT_TRUE(test, pmp_display_sleep_admits(&m.s));
+	/* Leave without enter (resume after a refused suspend_late) changes nothing. */
+	pmp_display_sleep_leave(&m.s);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+}
+
+/* Arming while DISP is still held (the consumer did not power down) is refused. */
+static void pmp_sleep_arm_refused_disp_held(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_DISP_HELD);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	/* A failed owner refuses before anything else. */
+	model_put_disp(&m);
+	m.v.provider_error = -EIO;
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_FAILED);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+}
+
+/* One arming, one sleep: after wake an unarmed sleep is refused again. */
+static void pmp_sleep_arm_one_sleep(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	pmp_display_sleep_leave(&m.s);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+	/* Display used, blanked and powered down again, but not armed: refused. */
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+}
+
+/* A sleep aborted after the consumer armed it, before the PMP stopped: its resume disarms. */
+static void pmp_sleep_disarm_on_resume(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	pmp_display_sleep_disarm(&m.s);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	KUNIT_EXPECT_TRUE(test, pmp_display_sleep_admits(&m.s));
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_NO_CONSUMER);
+	/* Disarm with nothing armed changes nothing. */
+	pmp_display_sleep_disarm(&m.s);
+	KUNIT_EXPECT_FALSE(test, m.s.consumer);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+}
+
+/* Armed by the display, but the GPU holds AGX: still refused; the display's resume disarms. */
+static void pmp_sleep_armed_agx_still_refused(struct kunit *test)
+{
+	struct model m;
+
+	model_boot(&m);
+	m.v.agx_held = true;
+	model_put_disp(&m);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_AGX_HELD);
+	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+	pmp_display_sleep_disarm(&m.s);
+	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
+}
+
+static void pmp_sleep_reasons(struct kunit *test)
+{
+	enum pmp_display_sleep_verdict v;
+
+	for (v = PMP_DISPLAY_SLEEP_OK; v <= PMP_DISPLAY_SLEEP_DISP_HELD; v++)
+		KUNIT_EXPECT_STRNEQ(test, pmp_display_sleep_reason(v), "unknown");
+	KUNIT_EXPECT_NOT_NULL(test, strstr(pmp_display_sleep_reason(PMP_DISPLAY_SLEEP_NO_CONSUMER),
+					   "retained power votes have no teardown"));
+}
+
+static struct kunit_case pmp_display_sleep_cases[] = {
+	KUNIT_CASE(pmp_sleep_refused_without_consumer),
+	KUNIT_CASE(pmp_sleep_teardown_restore_order),
+	KUNIT_CASE(pmp_sleep_refused_disp_held),
+	KUNIT_CASE(pmp_sleep_refused_agx_held),
+	KUNIT_CASE(pmp_sleep_refused_pending_or_failed),
+	KUNIT_CASE(pmp_sleep_enter_leave_idempotent),
+	KUNIT_CASE(pmp_sleep_arm_refused_disp_held),
+	KUNIT_CASE(pmp_sleep_arm_one_sleep),
+	KUNIT_CASE(pmp_sleep_disarm_on_resume),
+	KUNIT_CASE(pmp_sleep_armed_agx_still_refused),
+	KUNIT_CASE(pmp_sleep_reasons),
+	{}
+};
+
+static struct kunit_suite pmp_display_sleep_suite = {
+	.name = "apple-pmp-display-sleep",
+	.test_cases = pmp_display_sleep_cases,
+};
+
+kunit_test_suite(pmp_display_sleep_suite);
+
+MODULE_DESCRIPTION("Apple PMP retained vote system sleep tests");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/soc/apple/pmp-display-sleep.h b/drivers/soc/apple/pmp-display-sleep.h
new file mode 100644
index 0000000000..a59ae97a5e
--- /dev/null
+++ b/drivers/soc/apple/pmp-display-sleep.h
@@ -0,0 +1,141 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * The retained DISP/AGX votes through a system sleep that stops the PMP
+ * (pmp-display.c, pmp-export.c). Decisions only, no hardware: unit tested
+ * by pmp-display-sleep-test.c.
+ *
+ * The bridge cannot release a vote on its own. DISP is released by its
+ * consumer, the DCP, which powers the display domains down first and calls
+ * apple_pmp_j713_display_put() (iomfb_m4_power_gate()); it takes the vote
+ * again with apple_pmp_j713_display_get() after power-up. AGX has no release
+ * at all. So a sleep that stops the PMP may only go ahead when the consumer
+ * has released DISP for this sleep and armed it (pmp_display_sleep_arm()),
+ * AGX is not held, nothing is in flight and the request stream works; from
+ * then until wake no vote may be taken, since a stopped PMP cannot accept
+ * one. The arming lasts one sleep: wake clears it, and so does the
+ * consumer's resume (pmp_display_sleep_disarm()).
+ */
+#ifndef _APPLE_PMP_DISPLAY_SLEEP_H
+#define _APPLE_PMP_DISPLAY_SLEEP_H
+
+#include <linux/types.h>
+
+enum pmp_display_sleep_verdict {
+	PMP_DISPLAY_SLEEP_OK,
+	/* DISP not released and this sleep not armed (apple_pmp_j713_display_sleep_enable()). */
+	PMP_DISPLAY_SLEEP_NO_CONSUMER,
+	/* The PMP owner failed, or an ambiguous reply closed the request stream. */
+	PMP_DISPLAY_SLEEP_FAILED,
+	/* A vote request is in flight. */
+	PMP_DISPLAY_SLEEP_PENDING,
+	/* The AGX vote is held: it has no release. */
+	PMP_DISPLAY_SLEEP_AGX_HELD,
+	/* The DISP vote is held: its consumer has not powered the display down. */
+	PMP_DISPLAY_SLEEP_DISP_HELD,
+};
+
+struct pmp_display_sleep {
+	/* Armed for this sleep: the consumer released DISP. Cleared at wake. */
+	bool consumer;
+	/* Between apple_pmp_display_sleep() and apple_pmp_display_wake(). */
+	bool asleep;
+};
+
+/* The vote state the decision reads, as pmp-display.c keeps it. */
+struct pmp_display_sleep_votes {
+	int provider_error;
+	int error;
+	bool pending;
+	bool disp_held;
+	bool agx_held;
+};
+
+static inline enum pmp_display_sleep_verdict
+pmp_display_sleep_check(const struct pmp_display_sleep *s, const struct pmp_display_sleep_votes *v)
+{
+	/* First: without a consumer nothing else is asked, as before this check existed. */
+	if (!s->consumer)
+		return PMP_DISPLAY_SLEEP_NO_CONSUMER;
+	if (v->provider_error)
+		return PMP_DISPLAY_SLEEP_FAILED;
+	if (v->pending)
+		return PMP_DISPLAY_SLEEP_PENDING;
+	if (v->agx_held)
+		return PMP_DISPLAY_SLEEP_AGX_HELD;
+	if (v->disp_held)
+		return PMP_DISPLAY_SLEEP_DISP_HELD;
+	/* Released, but the consumer could not take DISP again after wake. */
+	if (v->error)
+		return PMP_DISPLAY_SLEEP_FAILED;
+	return PMP_DISPLAY_SLEEP_OK;
+}
+
+/* Enter the sleep if allowed. Already asleep: nothing could have changed, OK. */
+static inline enum pmp_display_sleep_verdict
+pmp_display_sleep_enter(struct pmp_display_sleep *s, const struct pmp_display_sleep_votes *v)
+{
+	enum pmp_display_sleep_verdict verdict;
+
+	if (s->asleep)
+		return PMP_DISPLAY_SLEEP_OK;
+	verdict = pmp_display_sleep_check(s, v);
+	if (verdict == PMP_DISPLAY_SLEEP_OK)
+		s->asleep = true;
+	return verdict;
+}
+
+/* Wake: votes may be taken again, and the next sleep needs a new arming. */
+static inline void pmp_display_sleep_leave(struct pmp_display_sleep *s)
+{
+	s->asleep = false;
+	s->consumer = false;
+}
+
+/*
+ * The consumer, in its suspend, once it has powered the display down and put
+ * DISP: arm this sleep. Refused while DISP is still held or the owner failed;
+ * nothing changes then.
+ */
+static inline enum pmp_display_sleep_verdict
+pmp_display_sleep_arm(struct pmp_display_sleep *s, const struct pmp_display_sleep_votes *v)
+{
+	if (v->provider_error)
+		return PMP_DISPLAY_SLEEP_FAILED;
+	if (v->disp_held)
+		return PMP_DISPLAY_SLEEP_DISP_HELD;
+	s->consumer = true;
+	return PMP_DISPLAY_SLEEP_OK;
+}
+
+/* The consumer's resume: also ends a sleep that was aborted before the PMP stopped. */
+static inline void pmp_display_sleep_disarm(struct pmp_display_sleep *s)
+{
+	s->consumer = false;
+}
+
+/* Whether a vote may be taken now: not while the PMP is stopped for a sleep. */
+static inline bool pmp_display_sleep_admits(const struct pmp_display_sleep *s)
+{
+	return !s->asleep;
+}
+
+static inline const char *pmp_display_sleep_reason(enum pmp_display_sleep_verdict verdict)
+{
+	switch (verdict) {
+	case PMP_DISPLAY_SLEEP_OK:
+		return "votes released";
+	case PMP_DISPLAY_SLEEP_NO_CONSUMER:
+		return "retained power votes have no teardown (DISP not released for this sleep)";
+	case PMP_DISPLAY_SLEEP_FAILED:
+		return "the vote stream failed";
+	case PMP_DISPLAY_SLEEP_PENDING:
+		return "a vote request is in flight";
+	case PMP_DISPLAY_SLEEP_AGX_HELD:
+		return "the AGX vote is held and has no release";
+	case PMP_DISPLAY_SLEEP_DISP_HELD:
+		return "the DISP vote is still held (display not powered down)";
+	}
+	return "unknown";
+}
+
+#endif
diff --git a/drivers/soc/apple/pmp-display.c b/drivers/soc/apple/pmp-display.c
index 6496faef3f..b9a322fca8 100644
--- a/drivers/soc/apple/pmp-display.c
+++ b/drivers/soc/apple/pmp-display.c
@@ -21,6 +21,8 @@
 #include <linux/unaligned.h>
 #include <linux/soc/apple/pmp-display.h>
 
+#include "pmp-display-sleep.h"
+
 /* AGX: command 0x0f, logical device 5, state 1. The reply carries no tag. */
 #define PMP_AGX_REQUEST		0x0020f50100000000ULL
 #define PMP_DISP_REQUEST	0x0020f80100000000ULL
@@ -221,6 +223,8 @@ struct apple_pmp_display {
 	struct pmp_power_vote vote;
 	struct device_link *link[PMP_POWER_COUNT];
 	bool agx_table_valid;
+	/* System sleep that stops the PMP (pmp-display-sleep.h); under @lock. */
+	struct pmp_display_sleep sleep;
 };
 
 /* One qualified supplier; published once, never freed during its epoch. */
@@ -439,7 +443,8 @@ static int pmp_power_get(struct device *consumer, enum pmp_power_kind kind)
 	spin_lock_irqsave(&p->lock, flags);
 	/* Reset before publishing pending: an immediate reply must not be lost. */
 	reinit_completion(&p->reply);
-	ret = pmp_vote_begin(&p->vote, kind);
+	/* A PMP stopped for a system sleep takes no vote until apple_pmp_display_wake(). */
+	ret = pmp_display_sleep_admits(&p->sleep) ? pmp_vote_begin(&p->vote, kind) : -EBUSY;
 	spin_unlock_irqrestore(&p->lock, flags);
 	if (ret <= 0)
 		goto out;
@@ -566,3 +571,128 @@ int apple_pmp_j713_gpu_get(struct device *consumer)
 	return apple_pmp_display_board() ? pmp_power_get(consumer, PMP_POWER_AGX) : -ENODEV;
 }
 EXPORT_SYMBOL_GPL(apple_pmp_j713_gpu_get);
+
+/*
+ * System sleep that stops the PMP (pmp-export.c). The bridge releases no
+ * vote itself: DISP is released by its consumer, which powers the display
+ * domains down and calls apple_pmp_j713_display_put() in its suspend, and
+ * takes it again with apple_pmp_j713_display_get() in its resume, once the
+ * PMP is back. The device link apple_pmp_j713_display_prepare() made orders
+ * that suspend before the PMP's and that resume after it. AGX has no
+ * release: a held AGX vote keeps refusing such a sleep.
+ *
+ * The consumer arms each such sleep after its put
+ * (apple_pmp_j713_display_sleep_enable()); the arming ends at the PMP's wake
+ * and with apple_pmp_j713_display_sleep_disable() in the consumer's resume.
+ * Unarmed, apple_pmp_display_sleep() refuses, as the PMP did before.
+ */
+int apple_pmp_j713_display_sleep_enable(struct device *consumer)
+{
+	enum pmp_display_sleep_verdict verdict = PMP_DISPLAY_SLEEP_OK;
+	struct pmp_display_sleep_votes v = {};
+	struct apple_pmp_display *p;
+	unsigned long flags;
+	int ret;
+
+	if (!apple_pmp_display_board())
+		return -ENODEV;
+	p = pmp_power_consumer(consumer, PMP_POWER_DISP);
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+	/* Every get and put sends under the request lock: none is half done while it is held. */
+	mutex_lock(&p->request);
+	ret = p->link[PMP_POWER_DISP] ? 0 : -ENODEV;
+	if (!ret) {
+		spin_lock_irqsave(&p->lock, flags);
+		v.provider_error = p->vote.provider_error;
+		v.disp_held = p->vote.held[PMP_POWER_DISP];
+		verdict = pmp_display_sleep_arm(&p->sleep, &v);
+		spin_unlock_irqrestore(&p->lock, flags);
+		if (verdict == PMP_DISPLAY_SLEEP_FAILED)
+			ret = v.provider_error;
+		else if (verdict != PMP_DISPLAY_SLEEP_OK)
+			ret = -EBUSY;
+	}
+	mutex_unlock(&p->request);
+	if (!ret)
+		dev_info(p->dev, "%s released the retained DISP vote for this sleep\n",
+			 dev_name(consumer));
+	else if (verdict != PMP_DISPLAY_SLEEP_OK)
+		dev_err(p->dev, "%s: %s: sleep not armed\n", dev_name(consumer),
+			pmp_display_sleep_reason(verdict));
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_pmp_j713_display_sleep_enable);
+
+/* The consumer's resume: the sleep it armed is over, whether or not the PMP stopped. */
+void apple_pmp_j713_display_sleep_disable(struct device *consumer)
+{
+	struct apple_pmp_display *p;
+	unsigned long flags;
+
+	if (!apple_pmp_display_board())
+		return;
+	p = pmp_power_consumer(consumer, PMP_POWER_DISP);
+	if (IS_ERR(p))
+		return;
+	spin_lock_irqsave(&p->lock, flags);
+	pmp_display_sleep_disarm(&p->sleep);
+	spin_unlock_irqrestore(&p->lock, flags);
+}
+EXPORT_SYMBOL_GPL(apple_pmp_j713_display_sleep_disable);
+
+/*
+ * From the PMP's suspend_late, before it stops. 0: no vote is held or in
+ * flight, and none is taken until apple_pmp_display_wake(). Otherwise
+ * nothing changed and the sleep is refused: -EBUSY, or the error of a
+ * failed vote stream.
+ */
+int apple_pmp_display_sleep(void)
+{
+	/* Pairs with the release in apple_pmp_display_register(). */
+	struct apple_pmp_display *p = smp_load_acquire(&pmp_display);
+	enum pmp_display_sleep_verdict verdict;
+	struct pmp_display_sleep_votes v;
+	unsigned long flags;
+	int ret;
+
+	if (!p) {
+		pr_err("pmp-display: no vote bridge, retained power votes have no teardown: refusing the sleep\n");
+		return -EBUSY;
+	}
+	/* Every get and put sends under the request lock: nothing is in flight while it is held. */
+	mutex_lock(&p->request);
+	spin_lock_irqsave(&p->lock, flags);
+	v = (struct pmp_display_sleep_votes) {
+		.provider_error = p->vote.provider_error,
+		.error = p->vote.error,
+		.pending = p->vote.pending != PMP_POWER_NONE,
+		.disp_held = p->vote.held[PMP_POWER_DISP],
+		.agx_held = p->vote.held[PMP_POWER_AGX],
+	};
+	verdict = pmp_display_sleep_enter(&p->sleep, &v);
+	spin_unlock_irqrestore(&p->lock, flags);
+	mutex_unlock(&p->request);
+
+	if (verdict == PMP_DISPLAY_SLEEP_OK) {
+		dev_dbg(p->dev, "retained votes released: none taken until wake\n");
+		return 0;
+	}
+	ret = verdict == PMP_DISPLAY_SLEEP_FAILED ? (v.provider_error ?: v.error ?: -EIO) : -EBUSY;
+	dev_err(p->dev, "%s: refusing the sleep\n", pmp_display_sleep_reason(verdict));
+	return ret;
+}
+
+/* From the PMP's resume_early, or when its sleep did not happen: votes may be taken again. */
+void apple_pmp_display_wake(void)
+{
+	/* Pairs with the release in apple_pmp_display_register(). */
+	struct apple_pmp_display *p = smp_load_acquire(&pmp_display);
+	unsigned long flags;
+
+	if (!p)
+		return;
+	spin_lock_irqsave(&p->lock, flags);
+	pmp_display_sleep_leave(&p->sleep);
+	spin_unlock_irqrestore(&p->lock, flags);
+}
diff --git a/drivers/soc/apple/pmp-export.c b/drivers/soc/apple/pmp-export.c
index 41091755a7..577aace748 100644
--- a/drivers/soc/apple/pmp-export.c
+++ b/drivers/soc/apple/pmp-export.c
@@ -1,15 +1,24 @@
 // SPDX-License-Identifier: GPL-2.0-only OR MIT
 #include <linux/device.h>
 #include <linux/export.h>
+#include <linux/io.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/pm.h>
 #include <linux/soc/apple/pmp.h>
+#include <linux/soc/apple/pmp-display.h>
 #include <linux/soc/apple/pmp-report.h>
+#include <linux/soc/apple/rtkit.h>
+#include <linux/soc/apple/sleep.h>
+#include <linux/suspend.h>
 
 /* Join removal and serialize the firmware's untagged power reply stream. */
 static DEFINE_MUTEX(pmp_lock);
 static const void *pmp_data;
 static struct device *pmp_device;
+/* The firmware is stopped for a system sleep. */
+static bool pmp_asleep;
 
 int apple_pmp_register(struct device *dev, const void *data)
 {
@@ -66,6 +75,8 @@ int apple_pmp_set_device_power(u8 command, u16 device_id, u32 enabled)
 	guard(mutex)(&pmp_lock);
 	if (!pmp_data)
 		return -ENODEV;
+	if (pmp_asleep)
+		return -EAGAIN;
 	/* The matched native report must be ready; never use an elapsed-time fallback. */
 	ret = apple_pmp_report_wait_supplier_ready(pmp_device, 5000);
 	if (ret)
@@ -104,9 +115,164 @@ int apple_pmp_t6030_gpu_ready(void)
 	guard(mutex)(&pmp_lock);
 	if (!pmp_data)
 		return -ENODEV;
+	if (pmp_asleep)
+		return -EAGAIN;
 	ret = apple_pmp_report_set_t6030_gfx(pmp_device, false);
 	if (ret)
 		return ret;
 	return apple_pmp_report_set_t6030_gfx(pmp_device, true);
 }
 EXPORT_SYMBOL_GPL(apple_pmp_t6030_gpu_ready);
+
+/*
+ * The PMP's idle is a point of no return: an idled PMP doesn't come back with its power kept,
+ * and only a real sleep restarts it. Where the sleep driver can take them, its idle
+ * and stop move to the sleep's last step, after every refusal: a refused sleep then finds it
+ * still running, and the GPU's request, withdrawn at the commit, reaches a running PMP.
+ */
+static struct apple_pmp_commit_stop pmp_commit;
+static bool pmp_commit_registered, pmp_commit_used;
+
+/* Interrupts off, one CPU: what apple_pmp_sleep() does, through pointers taken before. */
+static int apple_pmp_commit_stop_fn(void *unused)
+{
+	struct apple_pmp_commit_stop *c = &pmp_commit;
+	unsigned int us;
+	size_t i;
+	int ret;
+
+	ret = apple_rtkit_sleep_idle_polled(c->rtk, c->control, &us);
+	apple_rtkit_mailbox_recv_off(c->rtk);
+	for (i = 0; c->sram && i < c->count; i++)
+		c->words[i] = readl_relaxed(c->sram + 4 * i);
+	/* Told to idle, it can't carry on whatever it answered: the sleep goes on. */
+	return ret ? 1 : 0;
+}
+
+/*
+ * Retained J713 power votes have no teardown. On T8140 an unbind leaves the firmware running,
+ * and a commit with it running reset the SoC: its sleep registration is what refuses
+ * then, every sleep until reboot, since a rebind can't register again.
+ */
+bool apple_pmp_keep_bound(void)
+{
+	return apple_pmp_display_retained_board() || of_machine_is_compatible("apple,t8140");
+}
+
+/* Whether the sleep's last step takes the PMP: registered with the sleep driver, once. */
+static bool apple_pmp_commit_available(struct device *dev)
+{
+	void __iomem *asc;
+	int idx;
+
+	if (pmp_commit_registered)
+		return true;
+	idx = of_property_match_string(dev->of_node, "reg-names", "asc");
+	asc = idx >= 0 ? of_iomap(dev->of_node, idx) : NULL;
+	if (!asc)
+		return false;
+	if (apple_sleep_coproc_register(dev, asc, false, apple_pmp_commit_stop_fn, NULL)) {
+		iounmap(asc);
+		return false;
+	}
+	pmp_commit_registered = true;
+
+	return true;
+}
+
+static int apple_pmp_commit_prepare(struct device *dev)
+{
+	int ret;
+
+	ret = apple_pmp_sleep_prepare(pmp_data, &pmp_commit);
+	if (ret)
+		return ret;
+	apple_sleep_coproc_set_ready(dev, true);
+	pmp_commit_used = true;
+	dev_dbg(dev, "idle and stop left for the sleep's commit\n");
+
+	return 0;
+}
+
+static int apple_pmp_suspend_late(struct device *dev)
+{
+	bool at_commit, retained;
+	int ret;
+
+	if (!pm_suspend_via_firmware())
+		return 0;
+	/*
+	 * Retained power votes have no teardown of their own: only a consumer
+	 * that released its vote lets the PMP stop, and no vote is taken until
+	 * resume. Without such a consumer this refuses (-EBUSY), as before.
+	 */
+	retained = apple_pmp_display_retained_board();
+	if (retained) {
+		ret = apple_pmp_display_sleep();
+		if (ret)
+			return ret;
+	}
+
+	guard(mutex)(&pmp_lock);
+	if (pmp_device != dev || pmp_asleep) {
+		/* Not stopped here; one still stopped from a refused sleep stays closed. */
+		if (retained && !pmp_asleep)
+			apple_pmp_display_wake();
+		return 0;
+	}
+	at_commit = apple_pmp_commit_available(dev);
+	apple_pmp_report_sleep(dev, at_commit);
+	ret = at_commit ? apple_pmp_commit_prepare(dev) : apple_pmp_sleep(pmp_data);
+	if (ret) {
+		apple_pmp_report_wake(dev, false);
+		apple_pmp_display_wake();
+		return dev_err_probe(dev, ret, "firmware did not go idle for sleep\n");
+	}
+	pmp_asleep = true;
+
+	return 0;
+}
+
+static int apple_pmp_resume_early(struct device *dev)
+{
+	int ret;
+
+	guard(mutex)(&pmp_lock);
+	if (!pmp_asleep)
+		return 0;
+	/* Left for the commit: if the sleep was refused before it, the firmware never idled. */
+	if (pmp_commit_used) {
+		bool stopped = apple_sleep_coproc_stopped(dev);
+
+		pmp_commit_used = false;
+		apple_sleep_coproc_set_ready(dev, false);
+		if (!pm_resume_via_firmware() && !stopped) {
+			pmp_asleep = false;
+			apple_pmp_report_wake(dev, true);
+			apple_pmp_display_wake();
+			dev_info(dev, "sleep refused before the commit: firmware never stopped\n");
+			return 0;
+		}
+	}
+	/* A stopped firmware doesn't restart with its power kept: the next real sleep does. */
+	if (!pm_resume_via_firmware()) {
+		dev_warn(dev, "sleep refused: firmware stays stopped until a real sleep\n");
+		return 0;
+	}
+	pmp_asleep = false;
