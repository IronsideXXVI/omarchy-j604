+/*
+ * apple,dapf-ranges: absent leaves the DART probing without a filter to restore; it must
+ * otherwise be start and end pairs that fit the dapf registers, 0x40 per entry.
+ */
+static void apple_dart_test_dapf_count(struct kunit *test)
+{
+	/* the T8132 ISP DART: a 16 KiB dapf bank, 13 ranges */
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 26, SZ_16K), 13);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 2, SZ_16K), 1);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 512, SZ_16K), 256);
+	/* a dapf reg without the property: no filter to restore, the DART still probes */
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(false, -EINVAL, SZ_16K), 0);
+	/* present but no value, an odd cell count, or a cell size that is not 64 bits */
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, -ENODATA, SZ_16K), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 0, SZ_16K), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 25, SZ_16K), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, -EINVAL, SZ_16K), -EINVAL);
+	/* more entries than the registers hold */
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 514, SZ_16K), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 26, 12 * 0x40), -EINVAL);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_count(true, 26, 13 * 0x40), 13);
+}
+
+#define APPLE_DART_TEST_DAPF_FILL	0xa5
+
+static void apple_dart_test_vfree_dapf(void *p)
+{
+	vfree(p);
+}
+
+/* A DART with a two-entry filter in a bank of three, every byte of the bank 0xa5. */
+static struct apple_dart *apple_dart_test_dapf(struct kunit *test, u8 **bank)
+{
+	static const u64 ranges[] = { 0x380704000, 0x380704063, 0x382824000, 0x382824004 };
+	struct apple_dart *dart;
+	void *regs;
+
+	dart = kunit_kzalloc(test, sizeof(*dart), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dart);
+	dart->dev = kunit_device_register(test, "apple-dart-dapf-test");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dart->dev);
+	regs = vzalloc(SZ_16K);
+	KUNIT_ASSERT_NOT_NULL(test, regs);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test, apple_dart_test_vfree_dapf, regs), 0);
+	dart->regs = (__force void __iomem *)regs;
+	*bank = kunit_kmalloc(test, 3 * DART_DAPF_STRIDE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, *bank);
+	memset(*bank, APPLE_DART_TEST_DAPF_FILL, 3 * DART_DAPF_STRIDE);
+	dart->dapf = (__force void __iomem *)*bank;
+	dart->dapf_count = 2;
+	dart->dapf_ranges = kunit_kmalloc(test, sizeof(ranges), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dart->dapf_ranges);
+	memcpy(dart->dapf_ranges, ranges, sizeof(ranges));
+	dart->dapf_r20 = kunit_kcalloc(test, 2, sizeof(*dart->dapf_r20), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, dart->dapf_r20);
+	dart->dapf_r20[0] = 1;
+	dart->dapf_r20[1] = 1;
+	dev_set_drvdata(dart->dev, dart);
+	return dart;
+}
+
+/*
+ * Each entry fills its own 0x40-byte slot with exactly the loader's words and leaves every
+ * other byte alone; the exported call does the same for a bound, active DART.
+ */
+static void apple_dart_test_dapf_restore(struct kunit *test)
+{
+	u8 expect[DART_DAPF_STRIDE];
+	struct apple_dart *dart;
+	unsigned int i;
+	u8 *bank;
+
+	dart = apple_dart_test_dapf(test, &bank);
+	KUNIT_ASSERT_EQ(test, apple_dart_dapf_restore(dart->dev), 0);
+
+	for (i = 0; i < dart->dapf_count; i++) {
+		memset(expect, APPLE_DART_TEST_DAPF_FILL, sizeof(expect));
+		put_unaligned_le32(0x31, &expect[0x00]);
+		put_unaligned_le32(0, &expect[0x04]);
+		put_unaligned_le64(dart->dapf_ranges[2 * i], &expect[0x08]);
+		put_unaligned_le64(dart->dapf_ranges[2 * i + 1], &expect[0x10]);
+		put_unaligned_le32(1, &expect[0x20]);
+		KUNIT_EXPECT_MEMEQ_MSG(test, bank + i * DART_DAPF_STRIDE, expect,
+				       sizeof(expect), "entry %u", i);
+	}
+	/* The slot after the last entry is untouched. */
+	KUNIT_EXPECT_NULL(test, memchr_inv(bank + 2 * DART_DAPF_STRIDE,
+					   APPLE_DART_TEST_DAPF_FILL, DART_DAPF_STRIDE));
+
+	/* Not bound yet: the consumer defers. */
+	dev_set_drvdata(dart->dev, NULL);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_restore(dart->dev), -EPROBE_DEFER);
+}
+
+/* Only bits 7:0 of the config word and bits 63:2 of the end read back. */
+static void apple_dart_test_dapf_matches(struct kunit *test)
+{
+	struct apple_dart *dart;
+	u8 *bank;
+
+	dart = apple_dart_test_dapf(test, &bank);
+	KUNIT_EXPECT_FALSE(test, apple_dart_dapf_matches(dart));
+	apple_dart_dapf_write(dart);
+	KUNIT_EXPECT_TRUE(test, apple_dart_dapf_matches(dart));
+
+	writeq(0x380704063 | 3, dart->dapf + 0x10);
+	writel(0xff00 | 0x31, dart->dapf + 0x00);
+	KUNIT_EXPECT_TRUE(test, apple_dart_dapf_matches(dart));
+
+	/* Every entry counts, not only the first. */
+	writeq(0x382828000, dart->dapf + DART_DAPF_STRIDE + 0x08);
+	KUNIT_EXPECT_FALSE(test, apple_dart_dapf_matches(dart));
+	apple_dart_dapf_write(dart);
+	writel(1, dart->dapf + DART_DAPF_STRIDE + 0x04);
+	KUNIT_EXPECT_FALSE(test, apple_dart_dapf_matches(dart));
+	apple_dart_dapf_write(dart);
+	writel(0, dart->dapf + DART_DAPF_STRIDE + 0x20);
+	KUNIT_EXPECT_FALSE(test, apple_dart_dapf_matches(dart));
+}
+
+/* A locked filter: fine while it holds, refused and left alone otherwise. No filter: -ENODEV. */
+static void apple_dart_test_dapf_locked(struct kunit *test)
+{
+	struct apple_dart *dart;
+	u8 *bank;
+
+	dart = apple_dart_test_dapf(test, &bank);
+	writel(DART_DAPF_LOCKED, dart->regs + DART_DAPF_LOCK);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_apply(dart), -EPERM);
+	KUNIT_EXPECT_NULL(test, memchr_inv(bank, APPLE_DART_TEST_DAPF_FILL, 3 * DART_DAPF_STRIDE));
+
+	apple_dart_dapf_write(dart);
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_apply(dart), 0);
+
+	dart->dapf_count = 0;
+	KUNIT_EXPECT_EQ(test, apple_dart_dapf_apply(dart), -ENODEV);
+}
