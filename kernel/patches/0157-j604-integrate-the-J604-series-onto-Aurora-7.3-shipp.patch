+/**
+ * apple_dart_dapf_restore() - write a DART's address filter back
+ * @dev: the DART
+ *
+ * The DART owns its address filter: the registers and the entries, from
+ * apple,dapf-ranges. A consumer whose power-up clears the filter, as the T8132 ISP's
+ * ISP_SYS does, calls this after each power-up and before its firmware starts, while its
+ * device link keeps the DART runtime-active.
+ *
+ * Return: 0 once every entry holds, -EPROBE_DEFER before the DART is bound, -ENODEV
+ * without a filter, -EAGAIN while the DART is suspended, -EPERM if it's locked with other
+ * entries, -EIO if the entries didn't take.
+ */
+int apple_dart_dapf_restore(struct device *dev)
+{
+	struct apple_dart *dart = dev_get_drvdata(dev);
+
+	if (!dart)
+		return -EPROBE_DEFER;
+	if (!pm_runtime_active(dev))
+		return -EAGAIN;
+	return apple_dart_dapf_apply(dart);
+}
+EXPORT_SYMBOL_GPL(apple_dart_dapf_restore);
