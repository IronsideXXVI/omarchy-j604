+/* Its power state can only be lowered once this has finished. */
+static int dcp_s2r_stop_streams(struct apple_dcp *dcp)
+{
+	if (!dcp->s2r_dcp_dart)
+		return -ENODEV;
+
+	return apple_dart_display_streams(dcp->s2r_dcp_dart, DCP_S2R_DCP_STREAMS, false, true);
