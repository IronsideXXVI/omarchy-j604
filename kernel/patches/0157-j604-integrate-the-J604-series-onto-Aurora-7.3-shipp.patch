+			#size-cells = <0x00>;
+			port@0 {
+				reg = <0x00>;
+				dpaudio1_dcpext0: endpoint {
+					remote-endpoint = <&dcpext0_audio>;
+				};
+			};
+		};
+	};
+};
+
+&cpu_e0 {
+	apple,cpu-ctrl = <&cpu_ctrl 0x00 0x00>;
+	apple,cpu-impl-reg = /bits/ 64 <0x210050000>;
+};
+
+&cpu_e1 {
+	apple,cpu-ctrl = <&cpu_ctrl 0x00 0x01>;
+	apple,cpu-impl-reg = /bits/ 64 <0x210150000>;
+};
