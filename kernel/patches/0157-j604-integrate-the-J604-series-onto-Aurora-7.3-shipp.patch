+			return true;
+		}
+		ret = -EIO;
+	}
+
+	dev_warn(appledwc->dev, "host lost its state in the sleep (%d, GUID %#x): restarting it\n",
+		 ret, guid);
+	ret = dwc3_apple_exit(appledwc);
+	if (ret)
+		dev_err(appledwc->dev, "Failed to stop after sleep, err=%d\n", ret);
+	else
+		dwc3_apple_start_after_sleep(appledwc, DWC3_APPLE_HOST);
+
+	return false;
+}
+
+/*
+ * After a deep sleep that left a T8132 host registered: kept if the resume set the core up
+ * again, or if the sleep didn't cut the power and the core still has the GUID written before
+ * it. Otherwise restart the host as after a stop, and the devices enumerate again; a core that
+ * couldn't be released from reset is left alone. A role that arrived during the sleep is
+ * taken up now. Returns whether the host and its devices were kept.
+ */
+static bool dwc3_apple_reset_resume_kept(struct dwc3_apple *appledwc)
+{
+	struct dwc3 *dwc = &appledwc->dwc;
+	bool kept = false, lost = appledwc->sleep_lost;
+	u32 guid = 0;
+	int ret;
+
+	appledwc->sleep_reset_resume = false;
+	appledwc->sleep_lost = false;
+	if (appledwc->sleep_reinit) {
+		appledwc->sleep_reinit = false;
+		kept = true;
+	} else if (appledwc->sleep_dead) {
+		return false;
+	} else if (!lost) {
+		/* The power stayed: the core is out of reset and may be read. */
+		guid = dwc3_readl(dwc, DWC3_GUID);
+		if (guid == DWC3_APPLE_SLEEP_GUID) {
+			dwc3_writel(dwc, DWC3_GUID, appledwc->sleep_guid);
+			kept = true;
+		}
+	}
+
+	if (kept && appledwc->sleep_state == DWC3_APPLE_HOST)
+		return true;
+	if (!kept)
+		dev_warn(appledwc->dev,
+			 "host lost its state in the sleep (lost %d, GUID %#x): restarting it\n",
+			 lost, guid);
+	ret = dwc3_apple_exit(appledwc);
+	if (ret) {
+		dev_err(appledwc->dev, "Failed to stop after sleep, err=%d\n", ret);
+		return false;
+	}
+	if (!appledwc->shutting_down && (appledwc->sleep_state == DWC3_APPLE_HOST ||
+					 appledwc->sleep_state == DWC3_APPLE_DEVICE))
+		dwc3_apple_start_after_sleep(appledwc, appledwc->sleep_state);
+
+	return false;
+}
+
+/*
+ * Runs before the freezer, when the sleep's real target isn't known yet, so this goes by the
+ * state "mem" means now. Writing "freeze" with deep selected costs a USB restart and nothing else.
+ * A stop that fails refuses the sleep. PM_POST_SUSPEND follows an abandoned sleep as well.
+ */
+static int dwc3_apple_pm_notify_locked(struct dwc3_apple *appledwc, unsigned long action,
+				       bool in_place, bool lose, bool *finish, bool *kept,
+				       bool *lose_finish)
+{
+	struct device *dev = appledwc->dev;
+	enum dwc3_apple_sleep_plan plan;
+	int ret;
+
+	lockdep_assert_held(&appledwc->lock);
+
+	switch (action) {
+	case PM_SUSPEND_PREPARE:
+		if (pm_suspend_default_s2idle() || appledwc->shutting_down) {
+			*finish = in_place;
+			*kept = true;
+			break;
+		}
+		if (appledwc->sleep_dead) {
+			dev_err(dev, "refusing the sleep: the core is gone until a reboot\n");
+			return notifier_from_errno(-EIO);
+		}
+		plan = dwc3_apple_sleep_plan(appledwc->state, in_place, lose);
+		/* A PHY that agreed to lose the host but isn't asked to is let go again. */
+		*lose_finish = lose && plan != DWC3_APPLE_SLEEP_RESET_RESUME;
+		/*
+		 * A T8132 host stays registered: xHCI suspends as usual, and at the resume
+		 * dwc3_apple_t8132_reset_resume() brings it back. The wakeup setting stays.
+		 */
+		if (plan == DWC3_APPLE_SLEEP_RESET_RESUME) {
+			appledwc->sleep_guid = dwc3_readl(&appledwc->dwc, DWC3_GUID);
+			dwc3_writel(&appledwc->dwc, DWC3_GUID, DWC3_APPLE_SLEEP_GUID);
+			appledwc->sleep_state = DWC3_APPLE_HOST;
+			appledwc->sleep_reset_resume = true;
+			break;
+		}
+		/* xHCI suspends and resumes as usual, and the wakeup setting stays. */
+		if (plan == DWC3_APPLE_SLEEP_IN_PLACE) {
+			appledwc->sleep_guid = dwc3_readl(&appledwc->dwc, DWC3_GUID);
+			dwc3_writel(&appledwc->dwc, DWC3_GUID, DWC3_APPLE_SLEEP_GUID);
+			appledwc->sleep_in_place = true;
+			/* For the port controllers' USB wake. Changes after this go unseen. */
+			apple_sleep_usb_set_wake_ports(dwc3_apple_hub_wake_ports(appledwc));
+			break;
+		}
+		appledwc->sleep_state = appledwc->state;
+		ret = dwc3_apple_exit(appledwc);
+		if (ret)
+			return notifier_from_errno(ret);
+		/* A wakeup path would keep the domain on, and it's going away. */
+		appledwc->sleep_wakeup = device_may_wakeup(dev);
+		device_set_wakeup_enable(dev, false);
+		appledwc->sleep_stopped = true;
+		break;
+	case PM_POST_SUSPEND:
+		if (appledwc->sleep_reset_resume) {
+			*kept = dwc3_apple_reset_resume_kept(appledwc);
+			*lose_finish = true;
+			break;
+		}
+		if (appledwc->sleep_in_place) {
+			apple_sleep_usb_set_wake_ports(0);
+			*kept = dwc3_apple_sleep_kept(appledwc);
+			*finish = true;
+			break;
+		}
+		if (!appledwc->sleep_stopped)
+			break;
+		appledwc->sleep_stopped = false;
+		device_set_wakeup_enable(dev, appledwc->sleep_wakeup);
+		if (appledwc->shutting_down ||
+		    (appledwc->sleep_state != DWC3_APPLE_HOST &&
+		     appledwc->sleep_state != DWC3_APPLE_DEVICE))
+			break;
+		dwc3_apple_start_after_sleep(appledwc, appledwc->sleep_state);
+		break;
+	default:
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+/*
+ * The PHY's sleep prepare and finish may take the SuperSpeed port down and up, under the
+ * controller's device lock, so they run outside the glue's lock.
+ */
+static int dwc3_apple_pm_notify(struct notifier_block *nb, unsigned long action, void *unused)
+{
+	struct dwc3_apple *appledwc = container_of(nb, struct dwc3_apple, pm_nb);
+	bool in_place = false, lose = false, finish = false, kept = false, lose_finish = false;
+	int ret;
+
+	/*
+	 * The last wake's SuperSpeed restore ends before this sleep looks at the PHY. The hub
+	 * check takes the glue's lock, and has nothing to look at until the sleep is over.
+	 */
+	if (action == PM_SUSPEND_PREPARE) {
+		flush_work(&appledwc->sleep_finish);
+		cancel_delayed_work_sync(&appledwc->hub_check);
+	}
+	if (action == PM_SUSPEND_PREPARE && !pm_suspend_default_s2idle()) {
+		bool persist = READ_ONCE(persist_sleep);
+		enum dwc3_apple_state state;
+		bool usable;
+
+		scoped_guard(mutex, &appledwc->lock) {
+			state = appledwc->state;
+			usable = !appledwc->shutting_down && !appledwc->sleep_dead;
+		}
+		in_place = usable && appledwc->fixed_hub && state == DWC3_APPLE_HOST &&
+			   !apple_atcphy_sleep_prepare(appledwc->usb2_phy);
+		lose = usable && dwc3_apple_sleep_may_lose(state, in_place, persist) &&
+		       !apple_atcphy_sleep_lose_prepare(appledwc->usb2_phy);
+	}
+
+	scoped_guard(mutex, &appledwc->lock)
+		ret = dwc3_apple_pm_notify_locked(appledwc, action, in_place, lose, &finish, &kept,
+						  &lose_finish);
+
+	/* After a wake, user space doesn't wait for SuperSpeed: it comes back in the background. */
+	if (finish && action == PM_POST_SUSPEND) {
+		WRITE_ONCE(appledwc->sleep_finish_kept, kept);
+		queue_work(system_unbound_wq, &appledwc->sleep_finish);
+	} else if (finish) {
+		apple_atcphy_sleep_finish(appledwc->usb2_phy, kept);
+	}
+	if (lose_finish)
+		apple_atcphy_sleep_lose_finish(appledwc->usb2_phy);
+
+	return ret;
+}
