From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Tue, 10 Nov 2026 01:37:12 -0500
Subject: [PATCH] arm64: dts: apple: t8132-j713: name the host-owned
 DARTs' clock protection

A deep sleep with a dock or an external display attached powers off the
DARTs of the ACIO NHIs, the tunneled PCIe ports and the external display
coprocessors, and their hosts restore them. Give each of them its clock
protection slice, which also marks it as one its host may power-cycle.

Signed-off-by: Erik Bourget <erik@ebourget.net>
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 94b349cce31dfa4ab44489b7853ef671abdfe6c7)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j713.dts | 37 ++++++++++++++++++++++++
 1 file changed, 37 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713.dts b/arch/arm64/boot/dts/apple/t8132-j713.dts
index 3c217debd1..172b24b34d 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j713.dts
@@ -180,6 +180,43 @@
 	apple,bridge-link = <&dcpext1 4 0x800104>;
 };
 
+/*
+ * A deep sleep with a dock attached powers these off: their hosts (the ACIO
+ * NHIs, the tunneled PCIe ports and the external DCPs) take them down and
+ * restore them, with these clock protection slices.
+ */
+&usb4_0_dart {
+	apple,clock-protection = <&ps_prot 15>;
+};
+
+&usb4_1_dart {
+	apple,clock-protection = <&ps_prot 19>;
+};
+
+&usb4_0_pcie_dart {
+	apple,clock-protection = <&ps_prot 14>;
+};
+
+&usb4_1_pcie_dart {
+	apple,clock-protection = <&ps_prot 18>;
+};
+
+&dcpext0_dart {
+	apple,clock-protection = <&ps_prot 5>;
+};
+
+&dispext0_dart {
+	apple,clock-protection = <&ps_prot 4>;
+};
+
+&dcpext1_dart {
+	apple,clock-protection = <&ps_prot 30>;
+};
+
+&dispext1_dart {
+	apple,clock-protection = <&ps_prot 29>;
+};
+
 /* Native radio recovery is required before admitting system sleep. */
 &pcie0 {
 	status = "okay";
-- 
