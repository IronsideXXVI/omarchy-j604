From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 21:49:45 +0000
Subject: [PATCH] drm/asahi: G16: put the Globals words macOS has at
 INIT in place before INIT

The macOS 26B123 host has 28 Globals words in place at INIT that our initdata leaves zero.
From +0x34 on its layout sits 4 bytes above ours, the G17 region C layout, and 25 of them are
words G17 documents as required: unk_34, unk_3c, unk_54..unk_66 with the context-switch period
byte, max_power_mw (36294 here), the unk_7c4..unk_7f8 table, unk_9a4, unk_9d0 and unk_e3d.
The firmware copies Globals at import, so the words written after READY (g16_runtime_words)
cannot stand in for them; with those alone the GPU cores stayed powered at idle.

Write the set in the initdata, behind g16_globals_required (default 1, read at boot).

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/fw/initdata.rs | 68 ++++++++++++++++++++++++
 drivers/gpu/drm/asahi/g16/initdata.rs    |  8 +++
 drivers/gpu/drm/asahi/g16/params.rs      | 18 +++++++
 3 files changed, 94 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16/fw/initdata.rs b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
index 78dc31440a..8a00b56ad4 100644
--- a/drivers/gpu/drm/asahi/g16/fw/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
@@ -134,6 +134,48 @@ pub(crate) mod globals {
     const _: () = assert!(IDLE_POWER_OFF + 4 <= SIZE);
     const _: () = assert!(POWER_ASSERT_TALLY + 4 <= SIZE);
     const _: () = assert!(DOORBELL_TALLY + 4 <= PSTATE_SELECTORS[0]);
+    /// The Globals words the macOS 26B123 host has in place at INIT that the qualified image
+    /// leaves zero (MEASURED, list 14 INIT snapshot), at our offsets: from +0x34 on its
+    /// layout sits 4 bytes above ours, which is the G17 region C layout, where all but three
+    /// of these are documented as required (unk_34, unk_3c, unk_54..unk_66 and the
+    /// context-switch period byte at +0x6a, unk_7c4..unk_7f8, unk_9a4, unk_9d0, unk_e3d at
+    /// +0xe2c here). +0x84 is G17's max_power_mw (macOS: 36294 at INIT, 26250 later; G17
+    /// leaves the value per SoC); +0x7e0 is 0.7 on macOS G16 (G17: 0.6); +0x9d8 = 50 and
+    /// +0xe08 = 250 are macOS-only. The firmware copies Globals at import, so these go in
+    /// before INIT.
+    pub(crate) const REQUIRED: [(usize, u32); 28] = [
+        (0x34, 1),
+        (0x3c, 120),
+        (0x54, 0x0028_ffff),
+        (0x58, 0x0000_ffff),
+        (0x5c, 0x0001_0000),
+        (0x60, 0x0001_0000),
+        (0x64, 0x0003_0000),
+        (0x68, 0x0001_0000),
+        (0x84, 36294),
+        (0x7c4, 1250),
+        (0x7c8, 0x3f80_0000),
+        (0x7cc, 0x3f4c_cccd),
+        (0x7d0, 0x3e4c_cccd),
+        (0x7d4, 0x3f66_6666),
+        (0x7d8, 0x3dcc_cccd),
+        (0x7dc, 0x3e80_0000),
+        (0x7e0, 0x3f33_3333),
+        (0x7e4, 0x3f66_6666),
+        (0x7e8, 6),
+        (0x7ec, 1),
+        (0x7f0, 1),
+        (0x7f4, 100),
+        (0x7f8, 100),
+        (0x9a4, 1),
+        (0x9d0, 1),
+        (0x9d8, 50),
+        (0xe08, 250),
+        (0xe2c, 1),
+    ];
+    const _: () =
+        assert!(REQUIRED[8].0 == DOORBELL_TALLY + 4 && REQUIRED[8].0 + 4 == PSTATE_SELECTORS[0]);
+    const _: () = assert!(REQUIRED[27].0 + 4 <= POWER_ASSERT_TALLY);
 }
 
 /// Writes the Globals policy words; `idle_power_off` adds only [`globals::IDLE_POWER_OFF`].
@@ -452,6 +494,8 @@ pub(crate) struct Input {
     pub(crate) performance: Performance,
     /// Set [`globals::IDLE_POWER_OFF`] (testing knob, off in the qualified encoding).
     pub(crate) idle_power_off: bool,
+    /// Also write [`globals::REQUIRED`] (`g16_globals_required`).
+    pub(crate) globals_required: bool,
 }
 
 pub(crate) fn object_va(va: u64, size: usize) -> bool {
@@ -596,6 +640,11 @@ pub(crate) fn encode(
     put32(objects[id::ACTIVITY_FRAGMENT], 0xc30, 0xffffffff)?;
     let g = &mut objects[id::GLOBALS];
     encode_globals_policy(g, input.idle_power_off)?;
+    if input.globals_required {
+        for (at, value) in globals::REQUIRED {
+            put32(g, at, value)?;
+        }
+    }
     for at in globals::PSTATE_SELECTORS {
         put32(g, at, 100 * ceiling)?;
     }
@@ -720,4 +769,23 @@ fn the_word_matches_g17_region_c_and_misses_the_policy_words() {
         assert!(globals::POLICY.contains(&(0x9bc, 40)));
         assert!(globals::POLICY.contains(&(0x9cc, 50)));
     }
+
+    #[test]
+    fn the_required_words_miss_every_other_globals_word() {
+        for (at, _) in globals::REQUIRED {
+            assert!(at % 4 == 0 && at + 4 <= globals::SIZE);
+            assert!(!globals::POLICY.iter().any(|(p, _)| *p == at));
+            assert!(!globals::PSTATE_SELECTORS.contains(&at));
+            assert!(!globals::RUNTIME_WORDS.iter().any(|(r, _)| *r == at));
+            for live in [
+                globals::IDLE_POWER_OFF,
+                globals::DOORBELL_TALLY,
+                globals::EFFORT,
+                globals::EFFORT_SEQ,
+                globals::POWER_ASSERT_TALLY,
+            ] {
+                assert!(at != live);
+            }
+        }
+    }
 }
diff --git a/drivers/gpu/drm/asahi/g16/initdata.rs b/drivers/gpu/drm/asahi/g16/initdata.rs
index d10250f872..06d7ee1aae 100644
--- a/drivers/gpu/drm/asahi/g16/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/initdata.rs
@@ -157,7 +157,15 @@ pub(crate) fn build(
         ktrace_mask: 0,
         progress_recovery: 1,
         idle_power_off: idle_power_off_level != 0,
+        globals_required: super::params::globals_required(),
     };
+    if input.globals_required {
+        dev_info!(
+            dev,
+            "M4 initdata: {} Globals words macOS has at INIT written (g16_globals_required=1)\n",
+            globals::REQUIRED.len()
+        );
+    }
     if input.idle_power_off {
         dev_info!(
             dev,
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 5656df1ac0..b0badf5b41 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -1057,6 +1057,24 @@ pub(crate) fn selectors_macos() -> bool {
     "G16: performance selectors (default 0: the host utilization governor's state x 100; 1: 1000 as macOS whenever the cooling ceiling allows the top state, else that ceiling; runtime 0644)"
 );
 
+/// Storage of `g16_globals_required` (0644, default 1; read when the initdata is built).
+static GLOBALS_REQUIRED: AtomicU32 = AtomicU32::new(1);
+
+/// Whether the initdata Globals carries the words macOS has in place at INIT that the
+/// qualified image leaves zero (G17 region C's required words, at our offsets).
+pub(crate) fn globals_required() -> bool {
+    GLOBALS_REQUIRED.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    GLOBALS_REQUIRED_PARAM,
+    GLOBALS_REQUIRED_PARMTYPE,
+    GLOBALS_REQUIRED_PARM,
+    GLOBALS_REQUIRED,
+    "g16_globals_required",
+    "G16: write the 28 Globals words macOS has at INIT (G17 region C required words, max power 36294 mW) before INIT (default 1; 0: left zero, as before; read at boot)"
+);
+
 /// Storage of `g16_runtime_words` (0644, default 1; read at boot after READY).
 static RUNTIME_WORDS: AtomicU32 = AtomicU32::new(1);
 
-- 
2.43.0

