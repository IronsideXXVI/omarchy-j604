From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 02:29:33 +0000
Subject: [PATCH] drm/asahi: g16: Optionally give the full render units
 16 MiB PB heaps

Each render VM builds two full render units (0 and 1) whose PB heaps are
256 MiB each, next to compact units 2.. that run with 16 MiB heaps of
128 blocks. On a stock desktop two render VMs pin 1024 MiB of PB heap
in the full units alone; macOS backs 12-20 MiB of parameter buffer for
the whole system.

Add g16_pb_heap16 (default 0, latched at the first render unit built).
With it the full units back only the first 16 MiB of their heap window
and seed their PB managers with 128 blocks, as the compact units do.
The window and its address are unchanged. The M4 firmware gets the
whole heap up front and has no growth protocol, so a render that
outgrows it faults exactly as it would on a compact unit today.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 33 +++++++++++++++++++++++++++++
 drivers/gpu/drm/asahi/g16/pools.rs  |  4 ++++
 2 files changed, 37 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 30e39137cb..abc23fda2d 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -1281,6 +1281,39 @@ pub(crate) fn fs_tile_bit16() -> bool {
     "G16: set bit 16 of the FS tile mode word (register 0x10039, +0x9d8) as macOS does on application renders (default 0: off; 1: set; runtime 0644, read per render)"
 );
 
+/// Storage of `g16_pb_heap16` (0644, default 0; latched at its first read).
+static PB_HEAP16: AtomicU32 = AtomicU32::new(0);
+/// 0 until latched, then 1 (off) or 2 (on).
+static PB_HEAP16_LATCH: AtomicU32 = AtomicU32::new(0);
+
+/// Whether the two full render units of a VM (0 and 1) back a 16 MiB PB heap of 128 blocks, as
+/// the compact units 2.. do, instead of 256 MiB of 2048 blocks. The M4 firmware is given the
+/// whole heap up front and has no growth protocol: a render whose parameter buffer outgrows the
+/// heap is a firmware fault, as it already would be on a compact unit. Read once, at the first
+/// render unit a VM builds, so every VM of the boot is built the same way.
+pub(crate) fn pb_heap16() -> bool {
+    let l = PB_HEAP16_LATCH.load(Ordering::Acquire);
+    if l != 0 {
+        return l == 2;
+    }
+    let v = if PB_HEAP16.load(Ordering::Relaxed) != 0 {
+        2
+    } else {
+        1
+    };
+    let _ = PB_HEAP16_LATCH.compare_exchange(0, v, Ordering::AcqRel, Ordering::Acquire);
+    PB_HEAP16_LATCH.load(Ordering::Acquire) == 2
+}
+
+live_u32_param!(
+    PB_HEAP16_PARAM,
+    PB_HEAP16_PARMTYPE,
+    PB_HEAP16_PARM,
+    PB_HEAP16,
+    "g16_pb_heap16",
+    "G16: back the PB heap of the full render units 0 and 1 with 16 MiB (128 blocks) as the compact units, instead of 256 MiB each (default 0; latched at the first render unit built, set it as a module option)"
+);
+
 /// Storage of `g16_ktrace_keep` (runtime 0644, default 0).
 static KTRACE_KEEP: AtomicU32 = AtomicU32::new(0);
 
diff --git a/drivers/gpu/drm/asahi/g16/pools.rs b/drivers/gpu/drm/asahi/g16/pools.rs
index afd5a30b85..df68f53320 100644
--- a/drivers/gpu/drm/asahi/g16/pools.rs
+++ b/drivers/gpu/drm/asahi/g16/pools.rs
@@ -147,6 +147,10 @@ fn new(o: &mut Objects, k: u64, compact: bool) -> Result<Self> {
                 client::compact_window(k) + client::COMPACT_PB_HEAP_OFF,
                 client::COMPACT_PB_HEAP_SIZE,
             )
+        } else if super::params::pb_heap16() {
+            // g16_pb_heap16: the full units back only the first 16 MiB of their heap window,
+            // as the compact units do; the window and its address stay.
+            (client::pb_heap(k), client::COMPACT_PB_HEAP_SIZE)
         } else {
             (client::pb_heap(k), client::PB_HEAP_SIZE)
         };
