From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sun, 1 Nov 2026 19:01:23 +1100
Subject: [PATCH] pmdomain: apple: pmc: provide cluster enable bits as power
 domains

On T8140 the video encoder cluster (VENC-CLSTR-V) has an enable bit in a
PMC control word, with a matching status word. The PMP only raises the
encoder performance state while the cluster is enabled, and macOS sets
the bit, under its PMC lock, whenever the encoder is powered.

Describe such bits as child nodes with apple,cluster-bit, in an optional
"clusters" register range (control word, then status), and provide each
as a power domain: power on sets the bit and waits for its status, power
off clears it. The read-modify-write runs under the PMC lock.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit 7e87ed301342bf0d9a4af84a073202aee005d7d7)
[j604: binding conflict resolved by hand: a15y keeps the fixed voters,rails reg/reg-names items form; clusters added as optional third item (minItems 2) instead of Aurora oneOf order variants]
---
 .../devicetree/bindings/power/apple,pmc.yaml  |  32 +++++
 drivers/pmdomain/apple/pmc.c                  | 114 ++++++++++++++++++
 2 files changed, 146 insertions(+)

diff --git a/Documentation/devicetree/bindings/power/apple,pmc.yaml b/Documentation/devicetree/bindings/power/apple,pmc.yaml
index 1a92ae2ade..e9263427f8 100644
--- a/Documentation/devicetree/bindings/power/apple,pmc.yaml
+++ b/Documentation/devicetree/bindings/power/apple,pmc.yaml
@@ -29,16 +29,20 @@ properties:
       - apple,t8140-pmc
 
   reg:
+    minItems: 2
     items:
       - description: Perf-state floor words of the voter agents
       - description: |
           Per-agent words holding the floor the PMC honours for each agent,
           and per-rail interface enable words
+      - description: The cluster enable control word followed by its status word
 
   reg-names:
+    minItems: 2
     items:
       - const: voters
       - const: rails
+      - const: clusters
 
   nonposted-mmio: true
 
@@ -131,6 +135,34 @@ patternProperties:
       - apple,rail
       - apple,level
 
+  '^cluster-[a-z0-9-]+$':
+    type: object
+    description: |
+      A cluster enable bit in the "clusters" words, provided as a power
+      domain. The bit is set, and its status awaited, while the domain is
+      powered. The T8140 video encoder cluster must be enabled for the PMP to
+      raise the encoder's performance state.
+    additionalProperties: false
+
+    properties:
+      label:
+        description: Name of the power domain.
+
+      '#power-domain-cells':
+        const: 0
+
+      power-domains:
+        maxItems: 1
+
+      apple,cluster-bit:
+        $ref: /schemas/types.yaml#/definitions/uint32
+        maximum: 31
+        description: Bit of the cluster in the control and status words.
+
+    required:
+      - '#power-domain-cells'
+      - apple,cluster-bit
+
   '^performance-controller@[0-9a-f]+$':
     type: object
     description: The host performance controller's voter agent.
diff --git a/drivers/pmdomain/apple/pmc.c b/drivers/pmdomain/apple/pmc.c
index 212a570685..3b6518774e 100644
--- a/drivers/pmdomain/apple/pmc.c
+++ b/drivers/pmdomain/apple/pmc.c
@@ -44,6 +44,7 @@
 #include <linux/slab.h>
 #include <linux/soc/apple/pmc.h>
 #include <linux/spinlock.h>
+#include <linux/string_choices.h>
 #include <linux/thermal.h>
 #include <linux/workqueue.h>
 
@@ -94,6 +95,8 @@ struct apple_pmc {
 	const struct apple_pmc_hw *hw;
 	void __iomem *voters;
 	void __iomem *rails;
+	/* Optional cluster enable control and status words (T8140). */
+	void __iomem *clusters;
 	/*
 	 * Serializes read-modify-write cycles on enable and floor words, and
 	 * protects @enable and @dcs_state.
@@ -123,6 +126,8 @@ struct apple_pmc {
  * @rail: with @floor, the rail
  * @level: with @floor, the performance state held while powered
  * @on: with @floor, whether the floor is held; protected by pmc->lock
+ * @cluster: the domain is a cluster enable bit in the "clusters" region
+ * @bit: with @cluster, the bit in the control and status words
  */
 struct apple_pmc_domain {
 	struct generic_pm_domain genpd;
@@ -134,6 +139,8 @@ struct apple_pmc_domain {
 	unsigned int rail;
 	unsigned int level;
 	bool on;
+	bool cluster;
+	unsigned int bit;
 	bool provider;
 };
 
@@ -637,10 +644,39 @@ static int apple_pmc_floor_set(struct apple_pmc_domain *dom, bool on)
 	return ret;
 }
 
+/* The cluster control word is at +0 and its status at +4. */
+#define APPLE_PMC_CLUSTER_CTRL		0x0
+#define APPLE_PMC_CLUSTER_STATUS	0x4
+#define APPLE_PMC_CLUSTER_TIMEOUT_US	10000
+
+static int apple_pmc_cluster_set(struct apple_pmc_domain *dom, bool on)
+{
+	struct apple_pmc *pmc = dom->pmc;
+	u32 mask = BIT(dom->bit), val;
+	unsigned long flags;
+	int ret;
+
+	raw_spin_lock_irqsave(&pmc->lock, flags);
+	val = readl(pmc->clusters + APPLE_PMC_CLUSTER_CTRL);
+	writel(on ? val | mask : val & ~mask,
+	       pmc->clusters + APPLE_PMC_CLUSTER_CTRL);
+	raw_spin_unlock_irqrestore(&pmc->lock, flags);
+
+	ret = readl_poll_timeout_atomic(pmc->clusters + APPLE_PMC_CLUSTER_STATUS,
+					val, !!(val & mask) == on, 1,
+					APPLE_PMC_CLUSTER_TIMEOUT_US);
+	if (ret)
+		dev_err(pmc->dev, "%s: cluster bit %u did not turn %s (status %#x)\n",
+			dom->genpd.name, dom->bit, str_on_off(on), val);
+	return ret;
+}
+
 static int apple_pmc_domain_power_on(struct generic_pm_domain *genpd)
 {
 	struct apple_pmc_domain *dom = genpd_to_apple_pmc_domain(genpd);
 
+	if (dom->cluster)
+		return apple_pmc_cluster_set(dom, true);
 	if (dom->floor)
 		return apple_pmc_floor_set(dom, true);
 	return apple_pmc_agent_enable(dom->pmc, dom->agent, true);
@@ -650,6 +686,8 @@ static int apple_pmc_domain_power_off(struct generic_pm_domain *genpd)
 {
 	struct apple_pmc_domain *dom = genpd_to_apple_pmc_domain(genpd);
 
+	if (dom->cluster)
+		return apple_pmc_cluster_set(dom, false);
 	if (dom->floor)
 		return apple_pmc_floor_set(dom, false);
 	return apple_pmc_agent_enable(dom->pmc, dom->agent, false);
@@ -743,6 +781,75 @@ static int apple_pmc_domain_add(struct apple_pmc *pmc, struct device_node *np)
 	return 0;
 }
 
+/*
+ * A cluster enable bit, set while the domain is powered: the T8140 video
+ * encoder cluster must be enabled before its performance request takes
+ * effect. Starts off; the bootloader leaves the bits clear.
+ */
+static int apple_pmc_cluster_add(struct apple_pmc *pmc, struct device_node *np)
+{
+	struct device *dev = pmc->dev;
+	struct apple_pmc_domain *dom;
+	struct of_phandle_args parent;
+	const char *label;
+	u32 bit;
+	int i, ret;
+
+	if (!pmc->clusters)
+		return dev_err_probe(dev, -EINVAL, "%pOF: no clusters region\n", np);
+	if (of_property_read_u32(np, "apple,cluster-bit", &bit) || bit >= 32)
+		return dev_err_probe(dev, -EINVAL, "%pOF: invalid cluster bit\n", np);
+
+	dom = kzalloc_obj(*dom);
+	if (!dom)
+		return -ENOMEM;
+
+	dom->pmc = pmc;
+	dom->np = of_node_get(np);
+	dom->cluster = true;
+	dom->bit = bit;
+	if (of_property_read_string(np, "label", &label))
+		label = np->name;
+	dom->genpd.name = kasprintf(GFP_KERNEL, "pmc-%s", label);
+	if (!dom->genpd.name) {
+		of_node_put(dom->np);
+		kfree(dom);
+		return -ENOMEM;
+	}
+	dom->genpd.power_on = apple_pmc_domain_power_on;
+	dom->genpd.power_off = apple_pmc_domain_power_off;
+
+	ret = pm_genpd_init(&dom->genpd, NULL,
+			    !(readl(pmc->clusters + APPLE_PMC_CLUSTER_STATUS) & BIT(bit)));
+	if (ret) {
+		of_node_put(dom->np);
+		kfree(dom->genpd.name);
+		kfree(dom);
+		return dev_err_probe(dev, ret, "%pOF: genpd init failed\n", np);
+	}
+	list_add_tail(&dom->list, &pmc->domains);
+
+	ret = of_genpd_add_provider_simple(np, &dom->genpd);
+	if (ret)
+		return dev_err_probe(dev, ret, "%pOF: provider failed\n", np);
+	dom->provider = true;
+
+	for (i = 0; !of_parse_phandle_with_args(np, "power-domains",
+						"#power-domain-cells", i,
+						&parent); i++) {
+		struct of_phandle_args child = { .np = np };
+
+		ret = of_genpd_add_subdomain(&parent, &child);
+		of_node_put(parent.np);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "%pOF: failed to join parent domain\n",
+					     np);
+	}
+
+	return 0;
+}
+
 /* A rail floor held through the AP's agent while the domain is powered. */
 static int apple_pmc_floor_add(struct apple_pmc *pmc, struct device_node *np)
 {
@@ -890,6 +997,11 @@ static int apple_pmc_probe(struct platform_device *pdev)
 	pmc->rails = devm_platform_ioremap_resource_byname(pdev, "rails");
 	if (IS_ERR(pmc->rails))
 		return PTR_ERR(pmc->rails);
+	if (platform_get_resource_byname(pdev, IORESOURCE_MEM, "clusters")) {
+		pmc->clusters = devm_platform_ioremap_resource_byname(pdev, "clusters");
+		if (IS_ERR(pmc->clusters))
+			return PTR_ERR(pmc->clusters);
+	}
 
 	/* An unpowered PMC reads all-ones; do not write to it. */
 	for (rail = 0; rail < pmc->hw->rails; rail++) {
@@ -938,6 +1050,8 @@ static int apple_pmc_probe(struct platform_device *pdev)
 			continue;
 		if (of_property_present(child, "apple,rail"))
 			ret = apple_pmc_floor_add(pmc, child);
+		else if (of_property_present(child, "apple,cluster-bit"))
+			ret = apple_pmc_cluster_add(pmc, child);
 		else
 			ret = apple_pmc_domain_add(pmc, child);
 		if (ret) {
