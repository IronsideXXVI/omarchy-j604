From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 12:03:12 +0000
Subject: [PATCH] drm/asahi: g16: Count the running performance state
 while work is in flight

The poll pass already checks the firmware's running performance state
in the session check, but never records it, so there is no way to tell
which state the GPU actually runs in under load.

While profiling is on (g16_prof or debug bit 49), count every poll pass
that has work in flight by the state the firmware reports, and print
the counts as a "pstate_busy:" line in the stats file. With profiling
off nothing is read or counted.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/poll.rs | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 15c585b6ba..e3e36c4e2a 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -44,6 +44,10 @@
 pub(crate) const TAIL_WINDOW_NS: u64 = 300_000;
 /// End of the current `g16_tail_us` window (`now_ns()`), 0 for none.
 static TAIL_UNTIL_NS: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+/// Poll passes with work in flight, by the firmware's running performance state (rows S0-S9),
+/// counted only while profiling is on (`g16_prof`); the row frequencies are in the boot log.
+static PSTATE_BUSY: [core::sync::atomic::AtomicU64; 10] =
+    [const { core::sync::atomic::AtomicU64::new(0) }; 10];
 use crate::module_parameters;
 
 impl_has_hr_timer! {
@@ -409,6 +413,11 @@ pub(crate) fn poll(&mut self, evented: bool, done: &mut Completions) -> Result<b
         let mut pre = Lap::start();
         self.session.check()?;
         pre.lap(&mut self.engine.prof.check_ns);
+        if pre.on() && !self.engine.flights.is_empty() {
+            if let Ok(state) = self.session.regs.pstate() {
+                PSTATE_BUSY[state as usize].fetch_add(1, Ordering::Relaxed);
+            }
+        }
         // g16_pass_check_once: session.check() just verified the adopted UAT bindings.
         let once = params::pass_check_once();
         if once {
@@ -1293,6 +1302,21 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
             self.power.effective, self.power.temperature_mc, self.power.updates,
             self.power.sensor_errors
         )?;
+        let busy = |i: usize| PSTATE_BUSY[i].load(Ordering::Relaxed);
+        writeln!(
+            f,
+            "pstate_busy: S0 {} S1 {} S2 {} S3 {} S4 {} S5 {} S6 {} S7 {} S8 {} S9 {}",
+            busy(0),
+            busy(1),
+            busy(2),
+            busy(3),
+            busy(4),
+            busy(5),
+            busy(6),
+            busy(7),
+            busy(8),
+            busy(9)
+        )?;
         writeln!(
             f,
             "idle_selector: param {:?} selected {} selects {}",
-- 
