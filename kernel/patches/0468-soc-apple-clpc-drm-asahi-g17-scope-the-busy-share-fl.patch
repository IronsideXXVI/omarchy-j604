From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AxxzyWasTaken <axxzytte@gmail.com>
Date: Thu, 12 Nov 2026 22:48:53 +0000
Subject: [PATCH] soc: apple: clpc, drm/asahi: g17: scope the
 busy-share floor and light effort to T6041

The M4 Pro shares the CLPC compatible and the G17 code with the M4 Max,
so both changes reached it unmeasured.

Give T6041 its own CLPC table, picked on an "apple,t6041" machine, and
leave apple_clpc_hw_t6040 as integration/aurora has it. Move the light
effort thresholds from five module parameters into the per-SoC G17
Config, set only for T6041; other SoCs run every submission at full
effort and report the busy share unscaled.

Signed-off-by: AxxzyWasTaken <axxzytte@gmail.com>

[clpc.c and tools/asahi test parts only; the g17 parts need 37559c1233, not carried]
(cherry picked from commit 33db416ba26b3e0228cac02b9b5a87fde6719298)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/clpc.c             | 83 +++++++++++++++++++++-------
 tools/asahi/clpc-gpu-demand-tests.py | 13 +++--
 2 files changed, 70 insertions(+), 26 deletions(-)

diff --git a/drivers/soc/apple/clpc.c b/drivers/soc/apple/clpc.c
index f183e7734e..82ae411308 100644
--- a/drivers/soc/apple/clpc.c
+++ b/drivers/soc/apple/clpc.c
@@ -1447,6 +1447,8 @@ static const struct platform_profile_ops apple_clpc_profile_ops = {
 	.profile_set = apple_clpc_profile_set,
 };
 
+static const struct apple_clpc_hw *apple_clpc_machine_hw(const struct apple_clpc_hw *hw);
+
 static int apple_clpc_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -1461,7 +1463,7 @@ static int apple_clpc_probe(struct platform_device *pdev)
 
 	clpc->dev = dev;
 	clpc->pmc = dev->parent;
-	clpc->hw = of_device_get_match_data(dev);
+	clpc->hw = apple_clpc_machine_hw(of_device_get_match_data(dev));
 	/* T6040 firmware keeps GFX powered for its whole lifetime. A separate
 	 * host publication/idle input, not that supplier state, drives demand;
 	 * the T8132 and M5 (T8142) GPU drivers report through the same input.
@@ -1719,9 +1721,8 @@ static const struct apple_clpc_hw apple_clpc_hw_t8140 = {
 /*
  * T6040: DCS states 0-5 on rail 0, fabric states 0-2 on rail 1. No cluster
  * runs below a quarter of its maximum (P 1260 of 4512 MHz, E 1020 of
- * 2592 MHz), so the first column only completes the table. Both clusters
- * take their quarters from 4512 MHz, so the E cluster at its top speed
- * (57 %) gets the third column, not the fourth. With the floor held at DCS 5
+ * 2592 MHz), so the first column only completes the table. A busy cluster
+ * in the upper half asks for the top states. With the floor held at DCS 5
  * and fabric 2 the CPUs read 237-242 GB/s at 135 ns DRAM latency, against
  * 41 GB/s and 314 ns at 0 and 0. The second column is provisional until the
  * power of each DCS state is measured.
@@ -1729,34 +1730,24 @@ static const struct apple_clpc_hw apple_clpc_hw_t8140 = {
  * A cluster requests only after three busy samples in a row (12 ms). At idle
  * a single busy sample raised the floor about 60 % of the time, from short
  * bursts of background work; three in a row bring that to about 11 %.
- * GPU demand bypasses the CPU streak and takes its states from gpu_busy by
- * the busy share the GPU driver reports, the qualified DCS 5 / fabric 2 at
- * the top or with no share reported, until publication/in-flight demand
- * ends and HOLD_MS expires.
+ * GPU demand bypasses the CPU streak and uses the same qualified DCS 5 /
+ * fabric 2 states until publication/in-flight demand ends and HOLD_MS expires.
  * GFX supplier power cannot drive this input: firmware keeps it always on.
  */
 static const struct apple_clpc_hw apple_clpc_hw_t6040 = {
 	.rail = { [APPLE_CLPC_DCS] = 0, [APPLE_CLPC_SOC] = 1 },
 	.map = {
-		[APPLE_CLPC_DCS] = { 1, 1, 3, 4 },
-		[APPLE_CLPC_SOC] = { 0, 0, 0, 0 },
+		[APPLE_CLPC_DCS] = { 1, 2, 5, 5 },
+		[APPLE_CLPC_SOC] = { 0, 1, 2, 2 },
 	},
 	.sustain = 3,
 	.gpu_demand = false,
 	.gpu_input = true,
-	.gpu_busy = {
-		[APPLE_CLPC_DCS] = { 1, 2, 4, 5 },
-		[APPLE_CLPC_SOC] = { 0, 0, 0, 2 },
-	},
-	.gpu_busy_mid = 160,
-	.gpu_busy_high = 500,
-	.gpu_busy_top = 800,
-	.level_khz = 4512000,
 	/*
 	 * ANE work needs two things its own floor (PMC SoC-max: fabric 2)
 	 * does not give it. ResNet-50 streams about 50 MB of weights per
-	 * inference and runs DRAM bound at DCS 0, so hold the qualified
-	 * DCS 5 / fabric 2. And the engine runs at a speed set by
+	 * inference and runs DRAM bound at DCS 0, so hold the DCS 5 / fabric
+	 * 2 a busy CPU cluster gets. And the engine runs at a speed set by
 	 * the frequency of the second P cluster (cpu-map cluster2), whatever
 	 * runs on it: MobileNetV1 takes 65-375 us of engine time (mean 165)
 	 * with that cluster at its idle frequency and 88-91 us with it at
@@ -1777,6 +1768,58 @@ static const struct apple_clpc_hw apple_clpc_hw_t6040 = {
 	.low_power_machine = "apple,t6041",
 };
 
+/*
+ * T6041 (M4 Max): the M4 Pro's DCS and fabric states, with the floor scaled
+ * to what the work needs. The M4 Pro shares the CLPC compatible and keeps
+ * apple_clpc_hw_t6040; apple_clpc_probe() picks this table on an
+ * "apple,t6041" machine.
+ *
+ * A busy CPU cluster asks for DCS 1, 1, 3 or 4 and fabric 0. Both clusters
+ * take their quarters from 4512 MHz, so the E cluster at its top speed
+ * (57 %) gets the third column, not the fourth. Measured on a J616c with a
+ * 3 GB/s copy: DCS 0 / fabric 0 5.46 W at 309 ns DRAM latency, DCS 3 6.22 W
+ * at 166 ns, DCS 4 6.92 W at 114 ns, DCS 5 7.04 W at 113 ns; fabric 1 and 2
+ * add 0.3 and 1.4 W with less gain than a DCS step.
+ *
+ * GPU work takes its states from gpu_busy by the busy share the GPU driver
+ * reports, DCS 5 / fabric 2 at the top or with no share reported, until
+ * publication/in-flight demand ends and HOLD_MS expires. Scrolling a
+ * browser went from 24.9 to 22.1 W on AC with this and the G17 light
+ * effort, against the T6040 table.
+ *
+ * The ANE keeps the T6040 rails. Its cluster floor was measured on the
+ * M4 Pro only and is left out here.
+ */
+static const struct apple_clpc_hw apple_clpc_hw_t6041 = {
+	.rail = { [APPLE_CLPC_DCS] = 0, [APPLE_CLPC_SOC] = 1 },
+	.map = {
+		[APPLE_CLPC_DCS] = { 1, 1, 3, 4 },
+		[APPLE_CLPC_SOC] = { 0, 0, 0, 0 },
+	},
+	.sustain = 3,
+	.gpu_demand = false,
+	.gpu_input = true,
+	.gpu_busy = {
+		[APPLE_CLPC_DCS] = { 1, 2, 4, 5 },
+		[APPLE_CLPC_SOC] = { 0, 0, 0, 2 },
+	},
+	.gpu_busy_mid = 160,
+	.gpu_busy_high = 500,
+	.gpu_busy_top = 800,
+	.level_khz = 4512000,
+	.ane = { [APPLE_CLPC_DCS] = 5, [APPLE_CLPC_SOC] = 2 },
+	.low_power_khz = 2808000,
+	.low_power_machine = "apple,t6041",
+};
+
+/* The M4 Max shares the M4 Pro's compatible but has its own table. */
+static const struct apple_clpc_hw *apple_clpc_machine_hw(const struct apple_clpc_hw *hw)
+{
+	if (hw == &apple_clpc_hw_t6040 && of_machine_is_compatible("apple,t6041"))
+		return &apple_clpc_hw_t6041;
+	return hw;
+}
+
 /*
  * T8142: DCS states 0-7 on rail 0, fabric states 0-4 on rail 1. The fabric
  * state bounds CPU memory bandwidth: four P cores copy at ~40 GB/s with the
diff --git a/tools/asahi/clpc-gpu-demand-tests.py b/tools/asahi/clpc-gpu-demand-tests.py
index d867b80efe..08f7be9e58 100644
--- a/tools/asahi/clpc-gpu-demand-tests.py
+++ b/tools/asahi/clpc-gpu-demand-tests.py
@@ -30,7 +30,8 @@ def main():
     types = '\n'.join(item(source, s) + ';' for s in [
         'struct apple_clpc_hw {', 'struct apple_clpc_vote {'])
     tables = '\n'.join(item(source, 'static const struct apple_clpc_hw ' + n) + ';'
-                       for n in ['apple_clpc_hw_t8132', 'apple_clpc_hw_t8140', 'apple_clpc_hw_t6040'])
+                       for n in ['apple_clpc_hw_t8132', 'apple_clpc_hw_t8140', 'apple_clpc_hw_t6040',
+                                 'apple_clpc_hw_t6041'])
     methods = '\n'.join(item(source, s) for s in [
         'static unsigned int apple_clpc_vote(', 'static u32 apple_clpc_floor(',
         'static bool apple_clpc_gpu_streaming(',
@@ -177,13 +178,13 @@ static void check_t6040_ane(void) {
  ane.active=true; jiffies=2040; apple_clpc_sample(&c); assert(qos_adds==1 && qos_min==3756000);
 }
 
-// T6040 GPU work takes its floor from the busy share the driver reports:
+// T6041 GPU work takes its floor from the busy share the driver reports:
 // DCS 1, 2, 4 or 5 and fabric 0, 0, 0 or 2, split at 160, 500 and 800
 // permille. A higher level applies at once, a lower one at the first sample
 // at least 400 ms after the last one that asked for the current level or more.
-static void check_t6040_busy(void) {
+static void check_t6041_busy(void) {
  struct apple_clpc_gpu gpu={0};
- struct apple_clpc c={.hw=&apple_clpc_hw_t6040,.agent=1,.mask=3,.gpu=&gpu};
+ struct apple_clpc c={.hw=&apple_clpc_hw_t6041,.agent=1,.mask=3,.gpu=&gpu};
  assert(c.hw->gpu_busy_mid==160 && c.hw->gpu_busy_high==500 && c.hw->gpu_busy_top==800);
  read_error=vote_error=0; pmgr_status=0xf0; pmp_floor=0; published=~0u;
  // No share reported: the top of the table, as before the busy share.
@@ -314,14 +315,14 @@ int main(void) {
  assert(published==0x12 && c.last_reason==1);
  c.clusters[0].request[0]=c.clusters[0].request[1]=0;
  jiffies=264; apple_clpc_sample(&c); assert(published==0);
- check_t6040_busy();
+ check_t6041_busy();
  check_t8132();
  check_read_error();
  check_t8140();
  check_t8140_dense();
  check_t8140_ane();
  check_t6040_ane();
- puts("PASS: T6040 and T8132 host demand; T6040 GPU busy share and down-step hold; T8140 ANE, streaming, dense work, read errors and PMP backoff; idle release");
+ puts("PASS: T6040 and T8132 host demand; T6041 GPU busy share and down-step hold; T8140 ANE, streaming, dense work, read errors and PMP backoff; idle release");
 }
 '''
     code = code.replace('#define APPLE_PMC_RAIL_SHIFT(r) ((r)*8)', rail_shift)
-- 
2.43.0

