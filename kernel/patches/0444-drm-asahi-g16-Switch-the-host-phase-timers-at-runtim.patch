From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 05:32:39 +0000
Subject: [PATCH] drm/asahi: g16: Switch the host phase timers at
 runtime

The G16 phase timers behind the prof: line of aurora-g16/stats (drain,
retire and whole poll passes) run only with debug_flags bit 49, and
debug_flags is read once at probe. Timing the host retire tail of a
running system therefore needs a module reload or a reboot.

Add g16_prof (runtime 0644, default 0). With 1 the timers run as with
bit 49; with 0 nothing changes: Lap::start still reads the clock only
while profiling is on.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/engine.rs |  5 +++--
 drivers/gpu/drm/asahi/g16/params.rs | 18 ++++++++++++++++++
 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 07da2ce132..c1563b380b 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -378,7 +378,7 @@ pub(crate) struct Stats {
 }
 
 /// Host-side phase timers of publication and polling, on with `debug_flags` bit 49
-/// (`Debug1`); printed as the `prof:` line of `aurora-g16/stats`. A measurement aid: nothing is
+/// (`Debug1`, read at probe) or at runtime with `g16_prof=1`; printed as the `prof:` line of `aurora-g16/stats`. A measurement aid: nothing is
 /// timed while the flag is off.
 #[derive(Default)]
 pub(crate) struct Prof {
@@ -406,7 +406,8 @@ pub(crate) struct Prof {
 
 impl Lap {
     pub(crate) fn start() -> Self {
-        Lap(crate::debug::debug_enabled(crate::debug::DebugFlags::Debug1).then(now_ns))
+        let on = crate::debug::debug_enabled(crate::debug::DebugFlags::Debug1) || super::params::prof();
+        Lap(on.then(now_ns))
     }
 
     /// Adds the time since the start or the last lap to `acc`.
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 32cf12d5ab..a6696e058c 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -592,6 +592,24 @@ pub(crate) fn tail_us() -> u32 {
     "G16: re-poll interval right after a firmware event, us (default 0: four 5 us busy polls, then g16_resnap_us; 5..100; runtime 0644)"
 );
 
+/// Storage of `g16_prof` (runtime 0644, default 0).
+static PROF: AtomicU32 = AtomicU32::new(0);
+
+/// Whether the host phase timers ([`super::engine::Lap`]) run without `debug_flags` bit 49,
+/// which is read only at probe. Counts accumulate into the `prof:` line of `aurora-g16/stats`.
+pub(crate) fn prof() -> bool {
+    PROF.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    PROF_PARAM,
+    PROF_PARMTYPE,
+    PROF_PARM,
+    PROF,
+    "g16_prof",
+    "G16: run the host phase timers of the aurora-g16/stats prof: line (default 0: only with debug_flags bit 49; 1: on; runtime 0644)"
+);
+
 /// Storage of `g16_effort` (runtime 0644, default 0).
 static EFFORT: AtomicU32 = AtomicU32::new(0);
 
-- 
