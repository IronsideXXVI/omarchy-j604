From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 07:29:52 +0000
Subject: [PATCH] drm/apple: m4: optionally send the other mini-LED BLM
 properties

On the J604 a uniform 25 % gray still costs 69 % of full white's backlight
power, and BLMAHMode makes no difference at 0, 1, 2 or 3. macOS publishes
seven more BLM runtime properties for this panel, among them enableLAC,
BLMPLimitCfg and BLMPowergateEnable. Linux never sends any of them, and the
values the DCP holds after a Linux start cannot be read back.

Add a blm_props parameter, "id=value,...", which sends any of those
properties (ModeBlm 167, BLMVLEDManual 169, BLMAHMode 171, BLMPLimitCfg
172, enableBLMSloper 173, enableLAC 174, BLMPowergateEnable 178,
BLMStandbyEnable 215) through applyProperty after the next swap, the way
blm_ah_mode sends 171, and logs each status. Other ids are refused. Empty,
the default, sends nothing, so nothing changes until it is written.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/iomfb_m4.c | 129 +++++++++++++++++++++++++++----
 1 file changed, 116 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index ad11fdd291..0d36265917 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -142,6 +142,92 @@ static void iomfb_m4_blm_work(struct work_struct *work);
 MODULE_PARM_DESC(blm_ah_mode,
 		 "Internal mini-LED panel: BLM Adaptive Headroom mode sent to the DCP (RuntimeProperty 171; macOS on the J604: 2; -1: send nothing, the default; applies after the next swap)");
 
+/*
+ * The other BLM runtime properties of the 25G83 table, sent the same way, so
+ * that each can be compared with macOS's value on one boot. macOS on the J604
+ * (26B123) publishes ModeBlm (167) 0, BLMVLEDManual (169) 220, BLMPLimitCfg
+ * (172) 1, enableBLMSloper (173) 1, enableLAC (174) 1, BLMPowergateEnable
+ * (178) 1 and BLMStandbyEnable (215) 0. "id=value,...", only those ids and
+ * 171; empty, the default, sends nothing. Applies after the next swap.
+ */
+#define DCP_M4_BLM_PROPS_MAX	8
+
+struct dcp_m4_blm_prop {
+	u32 id, value;
+};
+
+static const u16 dcp_m4_blm_prop_ids[] = { 167, 169, 171, 172, 173, 174, 178, 215 };
+static struct dcp_m4_blm_prop blm_props[DCP_M4_BLM_PROPS_MAX];
+static unsigned int blm_props_count;
+static DEFINE_MUTEX(blm_props_lock);
+
+static bool dcp_m4_blm_prop_ok(u32 id)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(dcp_m4_blm_prop_ids); i++)
+		if (id == dcp_m4_blm_prop_ids[i])
+			return true;
+	return false;
+}
+
+static int blm_props_set(const char *val, const struct kernel_param *kp)
+{
+	struct dcp_m4_blm_prop p[DCP_M4_BLM_PROPS_MAX];
+	unsigned int n = 0;
+	char *buf, *s, *tok, *eq;
+	int ret = 0;
+
+	buf = kstrdup(val, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	s = strim(buf);
+	while ((tok = strsep(&s, ",")) && *tok) {
+		eq = strchr(tok, '=');
+		if (!eq || n == DCP_M4_BLM_PROPS_MAX) {
+			ret = -EINVAL;
+			goto out;
+		}
+		*eq = '\0';
+		if (kstrtou32(tok, 0, &p[n].id) || kstrtou32(eq + 1, 0, &p[n].value) ||
+		    !dcp_m4_blm_prop_ok(p[n].id)) {
+			ret = -EINVAL;
+			goto out;
+		}
+		n++;
+	}
+	mutex_lock(&blm_props_lock);
+	memcpy(blm_props, p, n * sizeof(p[0]));
+	blm_props_count = n;
+	mutex_unlock(&blm_props_lock);
+	atomic_inc(&blm_ah_gen);
+out:
+	kfree(buf);
+	return ret;
+}
+
+static int blm_props_get(char *buf, const struct kernel_param *kp)
+{
+	unsigned int i;
+	int len = 0;
+
+	mutex_lock(&blm_props_lock);
+	for (i = 0; i < blm_props_count; i++)
+		len += sysfs_emit_at(buf, len, "%s%u=%u", i ? "," : "",
+				     blm_props[i].id, blm_props[i].value);
+	mutex_unlock(&blm_props_lock);
+	return len + sysfs_emit_at(buf, len, "\n");
+}
+
+static const struct kernel_param_ops blm_props_ops = {
+	.set = blm_props_set,
+	.get = blm_props_get,
+};
+
+module_param_cb(blm_props, &blm_props_ops, NULL, 0644);
+MODULE_PARM_DESC(blm_props,
+		 "Internal mini-LED panel: more BLM runtime properties sent to the DCP, \"id=value,...\" (ids 167 169 171 172 173 174 178 215; empty: none, the default; applies after the next swap)");
+
 static unsigned int power_gate_ms;
 /* Given on the command line or written: the machine default stays out. */
 static bool power_gate_ms_given;
@@ -5339,12 +5425,31 @@ static void iomfb_m4_idle_cache_kick(struct iomfb_m4 *dcp)
 		mod_delayed_work(dcp->runtime->wq, &dcp->blm_work, 0);
 }
 
+/* Under dcp->lock. An RPC failure has already failed the session. */
+static void iomfb_m4_blm_send(struct iomfb_m4 *dcp, u32 id, u32 value)
+{
+	struct { __le32 id, value; } method = { cpu_to_le32(id), cpu_to_le32(value) };
+	__le32 out = 0;
+	int ret;
+
+	ret = dcp_m4_runtime_live(dcp->runtime);
+	if (!ret)
+		ret = dcp_m4_runtime_call_stream(dcp->runtime, 467, 0, false, &method,
+						 sizeof(method), &out, sizeof(out));
+	if (id == DCP_M4_PROP_BLM_AH_MODE)
+		dev_info(dcp->dev, "BLMAHMode %d sent: rpc %d, applyProperty status %#x\n",
+			 (int)value, ret, le32_to_cpu(out));
+	else
+		dev_info(dcp->dev, "BLM property %u = %u sent: rpc %d, applyProperty status %#x\n",
+			 id, value, ret, le32_to_cpu(out));
+}
+
 static void iomfb_m4_blm_work(struct work_struct *work)
 {
 	struct iomfb_m4 *dcp = container_of(to_delayed_work(work), struct iomfb_m4, blm_work);
-	struct { __le32 id, value; } method;
-	int gen, mode, ret;
-	__le32 out = 0;
+	struct dcp_m4_blm_prop props[DCP_M4_BLM_PROPS_MAX];
+	unsigned int i, n;
+	int gen, mode;
 
 	mutex_lock(&dcp->lock);
 	gen = atomic_read(&blm_ah_gen);
@@ -5354,16 +5459,14 @@ static void iomfb_m4_blm_work(struct work_struct *work)
 	    dcp->powered_off || gen == dcp->blm_gen)
 		goto out;
 	dcp->blm_gen = gen;
-	if (mode < 0)
-		goto out;
-	method.id = cpu_to_le32(DCP_M4_PROP_BLM_AH_MODE);
-	method.value = cpu_to_le32(mode);
-	ret = dcp_m4_runtime_live(dcp->runtime);
-	if (!ret)
-		ret = dcp_m4_runtime_call_stream(dcp->runtime, 467, 0, false, &method,
-						 sizeof(method), &out, sizeof(out));
-	dev_info(dcp->dev, "BLMAHMode %d sent: rpc %d, applyProperty status %#x\n",
-		 mode, ret, le32_to_cpu(out));
+	mutex_lock(&blm_props_lock);
+	n = blm_props_count;
+	memcpy(props, blm_props, n * sizeof(props[0]));
+	mutex_unlock(&blm_props_lock);
+	if (mode >= 0)
+		iomfb_m4_blm_send(dcp, DCP_M4_PROP_BLM_AH_MODE, mode);
+	for (i = 0; i < n; i++)
+		iomfb_m4_blm_send(dcp, props[i].id, props[i].value);
 out:
 	mutex_unlock(&dcp->lock);
 }
-- 
2.43.0

