From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 00:26:33 +0000
Subject: [PATCH] accel/ane: power up the J604 Neural Engine by default

The T8132 platform is identify-only: after the preload identity it stops
before power-up, because there is no published T8132 engine tunable
table. ane_t6021.h16_power_unqualified lifts the stop for a
qualification run.

That run passed on the J604 (MacBook Pro 14-inch, M4) with the pinned
H16 26.6.2 25G83 J604 preload: the five ANE power states and the three
ANE DARTs came up, the five DAPF records were written and read back,
RTKit reached READY with no engine tunables, the ABI 3 accel node
registered, and H16G programs ran bit-exact against a CPU reference
(the add-128 KUnit fixture and a mil-hwx-compiler 128x128 matmul),
with a second and third H16_LOAD accepted after close.

Mark a firmware profile as qualified and power a qualified profile on
an identify-only platform by default. Only the J604 profile is
qualified: the generic T8132 profile, and any preload accepted through
h16_preload_digest, still stop after the identity. The new parameter
ane_t6021.h16_power (default on) is the off-switch: h16_power=0 keeps
the J604 at the identify-only stop, as before.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/accel/ane/ane_h16_backend.c   | 19 ++++++++++++++++++-
 drivers/accel/ane/ane_h16_boot.h      |  5 +++++
 drivers/accel/ane/ane_h16_boot_data.h |  7 +++++--
 3 files changed, 28 insertions(+), 3 deletions(-)

diff --git a/drivers/accel/ane/ane_h16_backend.c b/drivers/accel/ane/ane_h16_backend.c
index ab277254aa..ab04c2d55b 100644
--- a/drivers/accel/ane/ane_h16_backend.c
+++ b/drivers/accel/ane/ane_h16_backend.c
@@ -60,6 +60,8 @@ struct ane_h16_device {
 	struct device *dart[3];
 	u32 powered;
 	u32 darts_powered;
+	/* The matched preload profile is qualified to power up on this board. */
+	bool qualified;
 	u64 preload_phys[2];
 	struct list_head mappings;
 	struct iommu_domain *domain;
@@ -1486,6 +1488,16 @@ module_param(h16_power_unqualified, bool, 0444);
 MODULE_PARM_DESC(h16_power_unqualified,
 		 "Power and boot an H16 ANE whose platform is identify-only (default: off)");
 
+/*
+ * An identify-only platform still powers a preload whose profile is
+ * qualified on its board (the J604). Clearing this keeps every such
+ * engine at the identify-only stop, as before the profile qualified.
+ */
+static bool h16_power = true;
+module_param(h16_power, bool, 0444);
+MODULE_PARM_DESC(h16_power,
+		 "Power and boot an H16 ANE whose firmware profile is qualified on this board (default: on)");
+
 /*
  * The SHA-256 (64 hex digits) of a live preload whose build has no pinned
  * digest yet, as the "layout but digest" line names it. It is honoured only
@@ -1568,6 +1580,7 @@ static int ane_h16_preload_identity(struct ane_h16_device *h)
 		}
 		b->build = p->build;
 		identity = p->identity;
+		h->qualified = p->qualified;
 	}
 	if (ret) {
 		dev_err(h->dev, "H16 preload matches none of %u firmware profiles, error %d\n",
@@ -1644,10 +1657,14 @@ static int ane_h16_advance(struct ane_h16_device *h, enum ane_h16_stage stage)
 	if (!h->acquired) {
 		h->acquired = true;
 		ret = ane_h16_preload_identity(h);
-		if (!ret && h->boot.soc->identify_only && !h16_power_unqualified) {
+		if (!ret && h->boot.soc->identify_only && !h16_power_unqualified &&
+		    !(h16_power && h->qualified)) {
 			dev_info(h->dev, "H16 preload identified; this SoC stops before power-up\n");
 			ret = -EOPNOTSUPP;
 			planned_stop = true;
+		} else if (!ret && h->boot.soc->identify_only && !h16_power_unqualified) {
+			dev_info(h->dev, "H16 preload identified; profile qualified on this board%s\n",
+				 h->boot.soc->no_engine_tunables ? ", no engine tunables" : "");
 		} else if (!ret && h->boot.soc->identify_only) {
 			dev_warn(h->dev, "H16 preload identified; unqualified power-up (h16_power_unqualified)%s\n",
 				 h->boot.soc->no_engine_tunables ? ", no engine tunables" : "");
diff --git a/drivers/accel/ane/ane_h16_boot.h b/drivers/accel/ane/ane_h16_boot.h
index d4f88c7d78..52a477f36e 100644
--- a/drivers/accel/ane/ane_h16_boot.h
+++ b/drivers/accel/ane/ane_h16_boot.h
@@ -118,6 +118,11 @@ struct ane_h16_profile {
 	const char *identity;
 	const struct ane_h16_preload_rule *preload;
 	const struct ane_h16_build *build;
+	/*
+	 * Proven to power up and run programs on the board this preload is
+	 * pinned to, so an identify-only platform powers it by default.
+	 */
+	bool qualified;
 };
 
 struct ane_h16_boot;
diff --git a/drivers/accel/ane/ane_h16_boot_data.h b/drivers/accel/ane/ane_h16_boot_data.h
index 0ce8b0f48f..0e37f1ad87 100644
--- a/drivers/accel/ane/ane_h16_boot_data.h
+++ b/drivers/accel/ane/ane_h16_boot_data.h
@@ -454,14 +454,17 @@ static const struct ane_h16_preload_rule ane_h16_preload_25g83_j604 = {
 
 /*
  * T8132 builds. The build values are the 26A428 ones the T604x 25G83 build
- * uses (same RTKit, same DATA end); the T8132 platform stops after the
- * preload identity, before any of them is used (see ane_h16_t8132_platform).
+ * uses (same RTKit, same DATA end). The T8132 platform stops after the
+ * preload identity (see ane_h16_t8132_platform) unless the profile is
+ * qualified: the J604 preload boots with them, with no engine tunables,
+ * and runs H16G programs bit-exact against a CPU reference.
  */
 static const struct ane_h16_profile ane_h16_profiles_t8132[] __maybe_unused = {
 	{
 		.identity = "H16 26.6.2 25G83 J604",
 		.preload = &ane_h16_preload_25g83_j604,
 		.build = &ane_h16_build_26a428,
+		.qualified = true,
 	},
 	{
 		.identity = "H16 26.6.2 25G83 T8132",
