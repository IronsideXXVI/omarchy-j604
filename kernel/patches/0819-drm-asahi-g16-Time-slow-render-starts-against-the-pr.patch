From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 17:42:37 +0000
Subject: [PATCH] drm/asahi: g16: Time slow render starts against the
 previous completion

About a quarter of render.light's commands are published before their
predecessor ends, yet start 100 us or more after it ended, most of
them over 150 us after the host read the predecessor's event. The
host is not what they wait on. Two firmware-side readings remain:
the next TA waits for the firmware's own completion work on the
previous command, which takes about 200 us from its end to the
completion event, or the firmware dispatches it on a timer tick.

Under g16_prof, also count those slow starts against the time the
host received the previous render's completion event, in 20 us steps
(or before it), and by their phase in a 1 ms period of the stage
timer. Starts that cluster just after the event mean the dispatch
waits for completion work; starts that cluster on one phase mean a
timer. Two new stats lines, render_tail_ev and
render_tail_phase1ms_50us. No behaviour changes.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/poll.rs | 44 +++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 442f4ecc74..676c2cdc15 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -71,6 +71,16 @@
 /// this start, 16 = started before that read, 17 = no read recorded.
 static RENDER_TAIL: [core::sync::atomic::AtomicU64; 18] =
     [const { core::sync::atomic::AtomicU64::new(0) }; 18];
+/// The same slow starts against the host's receipt of the previous render's completion event:
+/// 0 = started before it, 1-16 = 20 us steps after it, 17 = later, 18 = no event time
+/// (`g16_prof`).
+static TAIL_VS_EV: [core::sync::atomic::AtomicU64; 19] =
+    [const { core::sync::atomic::AtomicU64::new(0) }; 19];
+/// The same slow starts by their phase in a 1 ms period of the stage timer, 50 us bins.
+static TAIL_PHASE: [core::sync::atomic::AtomicU64; 20] =
+    [const { core::sync::atomic::AtomicU64::new(0) }; 20];
+/// Counter time the host received the previous render's completion event (`g16_prof`).
+static RENDER_PREV_EV: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
 /// Poll passes with work in flight, by the firmware's running performance state (rows S0-S9),
 /// counted only while profiling is on (`g16_prof`); the row frequencies are in the boot log.
 static PSTATE_BUSY: [core::sync::atomic::AtomicU64; 10] =
@@ -1339,6 +1349,20 @@ fn stat_retire(&mut self, f: &Flight) {
                                     ((ns(lo_c - read) / 10_000) as usize).min(15)
                                 };
                                 RENDER_TAIL[bin].fetch_add(1, Ordering::Relaxed);
+                                let pev = RENDER_PREV_EV.load(Ordering::Relaxed);
+                                let vb = if pev == 0 {
+                                    18
+                                } else if lo_c < pev {
+                                    0
+                                } else {
+                                    (1 + (ns(lo_c - pev) / 20_000) as usize).min(17)
+                                };
+                                TAIL_VS_EV[vb].fetch_add(1, Ordering::Relaxed);
+                                let p1ms = hz / 1000;
+                                if p1ms != 0 {
+                                    let pb = ((lo % p1ms) * 20 / p1ms) as usize;
+                                    TAIL_PHASE[pb.min(19)].fetch_add(1, Ordering::Relaxed);
+                                }
                             }
                         }
                     } else if lo_c >= prev {
@@ -1350,6 +1374,7 @@ fn stat_retire(&mut self, f: &Flight) {
                 if c == 1 && prof_on {
                     let read = LAST_EVENT_READ.load(Ordering::Relaxed);
                     RENDER_PREV_READ.store(read, Ordering::Relaxed);
+                    RENDER_PREV_EV.store(if hi_c <= ev { ev } else { 0 }, Ordering::Relaxed);
                 }
                 s.lat_n += 1;
                 s.start_hist[usize::from(kind != 0)][((start / 10_000) as usize).min(31)] += 1;
@@ -1538,6 +1563,25 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
             RENDER_TAIL[16].load(Ordering::Relaxed),
             RENDER_TAIL[17].load(Ordering::Relaxed)
         )?;
+        write!(
+            f,
+            "render_tail_ev: before {} after_20us",
+            TAIL_VS_EV[0].load(Ordering::Relaxed)
+        )?;
+        for b in TAIL_VS_EV.iter().skip(1).take(16) {
+            write!(f, " {}", b.load(Ordering::Relaxed))?;
+        }
+        writeln!(
+            f,
+            " later {} no_ev {}",
+            TAIL_VS_EV[17].load(Ordering::Relaxed),
+            TAIL_VS_EV[18].load(Ordering::Relaxed)
+        )?;
+        write!(f, "render_tail_phase1ms_50us:")?;
+        for b in TAIL_PHASE.iter() {
+            write!(f, " {}", b.load(Ordering::Relaxed))?;
+        }
+        writeln!(f)?;
         writeln!(
             f,
             "idle_selector: param {:?} selected {} selects {}",
