From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 04:57:09 +0000
Subject: [PATCH] media: apple: isp: add a switch for macOS's AE
 integration table

At every stream start macOS selects auto exposure integration table 4 on
the T8132 camera; the rest of the command is zero. The table decides how
exposure time and gain are traded in dim light, where this camera's
picture turns magenta, and the driver has never sent it.

Add the command and macos_ae_table, off by default, so its effect can be
measured in low light before it becomes the default. It is read at
stream start; a refusal is reported once and the stream goes on.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-cam.c | 17 +++++++++++++++++
 drivers/media/platform/apple/isp/isp-cmd.c | 11 +++++++++++
 drivers/media/platform/apple/isp/isp-cmd.h | 11 +++++++++++
 3 files changed, 39 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 121a38d6e3..b1e5661db6 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -696,6 +696,17 @@ module_param(macos_mbnr_chroma, bool, 0644);
 MODULE_PARM_DESC(macos_mbnr_chroma,
 		 "Leave MBNR chroma noise reduction off, as macOS does (default: off)");
 
+/*
+ * macOS also picks auto exposure integration table 4 on this camera at
+ * every stream start (the rest of the command is zero). It decides how
+ * exposure time and gain are traded in dim light, so it is offered as a
+ * switch, off by default, until a low-light side-by-side shows its effect.
+ */
+static bool macos_ae_table;
+module_param(macos_ae_table, bool, 0644);
+MODULE_PARM_DESC(macos_ae_table,
+		 "Select the auto exposure integration table macOS selects on this camera (default: off)");
+
 /*
  * macOS sets this Mac's auto exposure stability thresholds to 16 and 8 for
  * every camera session; macos_ae_stability=N gives back 32 and 20.
@@ -1505,6 +1516,12 @@ static int isp_ch_configure_capture(struct apple_isp *isp, u32 ch)
 	isp_ch_macos_session(isp, ch);
 	isp_ch_macos_colour(isp, ch);
 
+	if (READ_ONCE(macos_ae_table) && isp->hw->macos_session_settings) {
+		err = isp_cmd_ch_ae_integration_table_set(isp, ch, 4);
+		if (err)
+			dev_warn_once(isp->dev, "AE integration table refused: %d\n", err);
+	}
+
 	if (READ_ONCE(macos_sif_format))
 		err = isp_cmd_ch_sif_pixel_format_set(isp, ch, 1, 0, 1);
 	else
diff --git a/drivers/media/platform/apple/isp/isp-cmd.c b/drivers/media/platform/apple/isp/isp-cmd.c
index 7158221ff1..7387607b0b 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.c
+++ b/drivers/media/platform/apple/isp/isp-cmd.c
@@ -705,6 +705,17 @@ int isp_cmd_ch_ae_stability_set(struct apple_isp *isp, u32 chan, u32 stability)
 	return CISP_SEND_IN(isp, args);
 }
 
+int isp_cmd_ch_ae_integration_table_set(struct apple_isp *isp, u32 chan,
+					u32 table)
+{
+	struct cmd_ch_ae_integration_table_set args = {
+		.opcode = CISP_OPCODE(CISP_CMD_CH_AE_INTEGRATION_TABLE_SET),
+		.chan = chan,
+		.table = table,
+	};
+	return CISP_SEND_IN(isp, args);
+}
+
 int isp_cmd_ch_ae_stability_to_stable_set(struct apple_isp *isp, u32 chan,
 					  u32 stability)
 {
diff --git a/drivers/media/platform/apple/isp/isp-cmd.h b/drivers/media/platform/apple/isp/isp-cmd.h
index 193d087549..25560185f5 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.h
+++ b/drivers/media/platform/apple/isp/isp-cmd.h
@@ -58,6 +58,7 @@
 #define CISP_CMD_CH_AE_GAIN_CAP_SET			     0x020c
 #define CISP_CMD_CH_AE_STABILITY_SET			     0x021a
 #define CISP_CMD_CH_AE_STABILITY_TO_STABLE_SET		     0x0229
+#define CISP_CMD_CH_AE_INTEGRATION_TABLE_SET		     0x0240
 #define CISP_CMD_CH_AE_2WAYSPEED_SET			     0x0243
 #define CISP_CMD_CH_SENSOR_NVM_GET			     0x0501
 #define CISP_CMD_CH_SENSOR_PERMODULE_LSC_INFO_GET	     0x0507
@@ -761,6 +762,14 @@ struct cmd_ch_ae_stability_to_stable_set {
 } __packed;
 static_assert(sizeof(struct cmd_ch_ae_stability_to_stable_set) == 0x10);
 
+struct cmd_ch_ae_integration_table_set {
+	u64 opcode;
+	u32 chan;
+	u32 table;
+	u8 entries[0xc4];
+} __packed;
+static_assert(sizeof(struct cmd_ch_ae_integration_table_set) == 0xd4);
+
 struct cmd_ch_ae_frame_rate_max_get {
 	u64 opcode;
 	u32 chan;
@@ -822,6 +831,8 @@ static_assert(sizeof(struct cmd_apple_ch_ae_flicker_freq_update_current_set) ==
 int isp_cmd_ch_ae_stability_set(struct apple_isp *isp, u32 chan, u32 stability);
 int isp_cmd_ch_ae_stability_to_stable_set(struct apple_isp *isp, u32 chan,
 					  u32 stability);
+int isp_cmd_ch_ae_integration_table_set(struct apple_isp *isp, u32 chan,
+					u32 table);
 int isp_cmd_ch_ae_frame_rate_max_get(struct apple_isp *isp, u32 chan,
 				     struct cmd_ch_ae_frame_rate_max_get *args);
 int isp_cmd_ch_ae_frame_rate_max_set(struct apple_isp *isp, u32 chan,
-- 
2.43.0

