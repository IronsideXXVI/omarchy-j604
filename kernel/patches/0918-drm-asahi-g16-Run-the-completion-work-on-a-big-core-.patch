From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 23:09:56 +0000
Subject: [PATCH] drm/asahi: g16: Run the completion work on a big core
 while GPU work is out by default

The completion work runs on the CPU that queued it, which for the
firmware's mailbox interrupt and the re-poll timer is often an
efficiency core. On a big core the queue-to-run time of that work is
shorter and compute.light at depth 1 gets faster; keeping it there
also at an idle desktop costs power, because the idle passes then wake
the performance cluster.

Make g16_worker_big default to 3: the work goes to one big core while
flights or pending jobs are out and stays where it was queued
otherwise. 0 restores the old placement at runtime.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 5f9bfa5e4d..823f5968e2 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -940,16 +940,16 @@ pub(crate) fn rt_poll() -> bool {
     "G16: retire after a firmware event on the SCHED_FIFO poller thread instead of the CFS worker (default 0; 1: on; runtime 0644)"
 );
 
-/// Storage of `g16_worker_big` (runtime 0644, default 0).
-static WORKER_BIG: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_worker_big` (runtime 0644, default 3).
+static WORKER_BIG: AtomicU32 = AtomicU32::new(3);
 
-/// Where the poll/completion work runs: 0 (default) `system_highpri_wq` on the CPU that
+/// Where the poll/completion work runs: 0 `system_highpri_wq` on the CPU that
 /// queued it (the mailbox interrupt's or the hrtimer's CPU, often an efficiency core); 1 the
 /// unbound high-priority `aurora_g16_big` queue limited to the CPUs of maximum capacity;
 /// 2 `system_highpri_wq` on one such CPU chosen at probe (no migration between passes);
-/// 3 as 2 while GPU work is outstanding (flights or pending, as publish() last saw them),
-/// else as 0, so the idle firmware messages keep their pass on the CPU that took them.
-/// With 1 or 2, scheduler submit queues (`aurora_g16_hi`) created afterwards are limited to
+/// 3 (default) as 2 while GPU work is outstanding (flights or pending, as publish() last saw
+/// them), else as 0, so the idle firmware messages keep their pass on the CPU that took them.
+/// With 1, 2 or 3, scheduler submit queues (`aurora_g16_hi`) created afterwards are limited to
 /// the same CPUs. Read per queueing.
 pub(crate) fn worker_big() -> u32 {
     match WORKER_BIG.load(Ordering::Relaxed) {
@@ -964,7 +964,7 @@ pub(crate) fn worker_big() -> u32 {
     WORKER_BIG_PARM,
     WORKER_BIG,
     "g16_worker_big",
-    "G16: run the completion/poll work on the max-capacity CPUs (default 0: where queued; 1: unbound high-priority queue on those CPUs; 2: one such CPU chosen at probe; 3: as 2 only while GPU work is outstanding; runtime 0644)"
+    "G16: run the completion/poll work on the max-capacity CPUs (0: where queued; 1: unbound high-priority queue on those CPUs; 2: one such CPU chosen at probe; 3, the default: as 2 only while GPU work is outstanding; runtime 0644)"
 );
 
 /// Storage of `g16_pmp_agx` (runtime 0644, default 1).
-- 
