From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Sun, 8 Nov 2026 21:54:34 +1100
Subject: [PATCH] accel/ane: refuse bytes after the last H16 task

On the J616s, a staged H16G program whose __text carried zero padding
after its final task loaded and ran, but the next EXECUTE on the device
timed out every time (13/13). The structural walk accepts zero padding
to 16 bytes and zero blocks between tasks, so nothing caught it.

Have the task-stream walk report where the last task ends. For H16
programs, refuse any section that continues past it: 4, 8 or 12 bytes of
padding and trailing zero blocks alike. H17 keeps the current rule
until it has its own device evidence.

The shared KUnit fixture now ends its one task at the section end, and a
new case covers the exact end plus every refused tail on both forms.

Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Assisted-by: LLM
(cherry picked from commit d9fab835f97c13208aa9df0925897242624dfd36)
---
 drivers/accel/ane/ane_h16_hwx.c              | 11 +++++-
 drivers/accel/ane/ane_h16_hwx_test.c         | 36 ++++++++++++++++++++
 drivers/accel/ane/ane_h16_hwx_test_fixture.h |  5 +--
 drivers/accel/ane/ane_h16_tasks.h            | 10 ++++--
 4 files changed, 56 insertions(+), 6 deletions(-)

diff --git a/drivers/accel/ane/ane_h16_hwx.c b/drivers/accel/ane/ane_h16_hwx.c
index aaa38d29e6..cca48baeb3 100644
--- a/drivers/accel/ane/ane_h16_hwx.c
+++ b/drivers/accel/ane/ane_h16_hwx.c
@@ -212,6 +212,7 @@ static int hwx_program(struct hwx_parser *p)
 	struct ane_h16_hwx *info = &p->info;
 	u32 length = get_unaligned_le32(c + 4), records, record_limit, i;
 	u32 prologue = info->subtype == ANE_HWX_SUBTYPE_H17 ? 0 : 1;
+	size_t final_end = 0;
 	u64 work_limit = 0;
 	bool mixed = length == 0x8c0;
 	/* Nonzero cells only; every other byte is checked below. */
@@ -297,10 +298,18 @@ static int hwx_program(struct hwx_parser *p)
 	if (!memcmp(c, expected, length)) {
 		ret = ane_hx_task_stream_validate_limit(p->bytes + info->text.offset,
 							info->text.size, info->tasks, prologue,
-							&record_limit);
+							&record_limit, &final_end);
 		/* This compiler hint need not equal the encoded record count. */
 		if (!ret && (!records || records > record_limit))
 			ret = -ENOEXEC;
+		/*
+		 * On H16 the final task must end the section: zero padding or
+		 * zero blocks after it leave the engine armed, and the next
+		 * EXECUTE on the device times out.
+		 */
+		if (!ret && info->subtype == ANE_HWX_SUBTYPE_H16 &&
+		    final_end != info->text.size)
+			ret = -ENOEXEC;
 	}
 	kfree(expected);
 	return ret;
diff --git a/drivers/accel/ane/ane_h16_hwx_test.c b/drivers/accel/ane/ane_h16_hwx_test.c
index 1b852982f3..fc48ca002b 100644
--- a/drivers/accel/ane/ane_h16_hwx_test.c
+++ b/drivers/accel/ane/ane_h16_hwx_test.c
@@ -301,6 +301,41 @@ static void hwx_staged_counts_test(struct kunit *test)
 	}
 }
 
+/*
+ * Trailing zero bytes after the last H16 task leave the engine armed, and the
+ * next EXECUTE times out. The final task must end the section exactly.
+ */
+static void hwx_final_task_end_test(struct kunit *test)
+{
+	static const u32 tails[] = { 4, 8, 12, 12 + 16 };
+	struct ane_h16_hwx info;
+	unsigned int form, i;
+
+	for (form = 0; form < 2; form++) {
+		struct hwx_fixture *f = fixture_create(test, form, false);
+		u8 *section, *program;
+		u64 end;
+
+		KUNIT_ASSERT_NOT_NULL(test, f);
+		/* One task with two records ends at 68; __const starts at 128. */
+		fixture_tasks(f, 1, 2);
+		section = f->bytes + f->text_command + 72;
+		program = f->bytes + f->program;
+		end = get_unaligned_le64(section + 40);
+		KUNIT_ASSERT_EQ(test, end, 68ULL);
+		KUNIT_EXPECT_EQ(test, ane_h16_hwx_validate(f->bytes, f->size, &info), 0);
+		for (i = 0; i < ARRAY_SIZE(tails); i++) {
+			put_unaligned_le64(end + tails[i], section + 40);
+			put_unaligned_le32((end + tails[i]) / 4, program + 0x824);
+			KUNIT_EXPECT_EQ_MSG(test, ane_h16_hwx_validate(f->bytes, f->size, &info),
+					    -ENOEXEC, "form %u tail %u", form, tails[i]);
+		}
+		put_unaligned_le64(end, section + 40);
+		put_unaligned_le32(end / 4, program + 0x824);
+		KUNIT_EXPECT_EQ(test, ane_h16_hwx_validate(f->bytes, f->size, &info), 0);
+	}
+}
+
 static void hwx_geometry_test(struct kunit *test)
 {
 	struct hwx_fixture *f = fixture_create(test, false, false);
@@ -569,6 +604,7 @@ static struct kunit_case hwx_cases[] = {
 	KUNIT_CASE(hwx_surface_order_test),
 	KUNIT_CASE(hwx_program_test),
 	KUNIT_CASE(hwx_staged_counts_test),
+	KUNIT_CASE(hwx_final_task_end_test),
 	KUNIT_CASE(hwx_geometry_test),
 	KUNIT_CASE(hwx_symbols_test),
 	KUNIT_CASE(hwx_relocations_test),
diff --git a/drivers/accel/ane/ane_h16_hwx_test_fixture.h b/drivers/accel/ane/ane_h16_hwx_test_fixture.h
index e129550d84..13650e9f02 100644
--- a/drivers/accel/ane/ane_h16_hwx_test_fixture.h
+++ b/drivers/accel/ane/ane_h16_hwx_test_fixture.h
@@ -87,7 +87,8 @@ static struct hwx_fixture *fixture_create(struct kunit *test, bool mixed, bool k
 	f->text_command = f->cursor;
 	text_section = fixture_segment(f, "__TEXT", text, SZ_32K, SZ_16K, 5,
 				       mixed ? 4 : 0, 2);
-	fixture_section(text_section, "__TEXT", "__text", text, 64, SZ_16K,
+	/* The one task ends the section: H16 refuses bytes after the last task. */
+	fixture_section(text_section, "__TEXT", "__text", text, 60, SZ_16K,
 			14, kernel ? 0x128 : 0x28);
 	fixture_section(text_section + 80, "__TEXT", "__const", text + 64,
 			SZ_16K, SZ_16K + 64, 6, 0x26);
@@ -116,7 +117,7 @@ static struct hwx_fixture *fixture_create(struct kunit *test, bool mixed, bool k
 		put_unaligned_le64(kern, c + 0x90);
 	put_unaligned_le64(text, c + 0x810);
 	put_unaligned_le32(4, c + 0x820);
-	put_unaligned_le32(16, c + 0x824);
+	put_unaligned_le32(15, c + 0x824);
 	put_unaligned_le32(1, c + 0x830);
 	put_unaligned_le32(U32_MAX, c + 0x838);
 	put_unaligned_le32(U32_MAX, c + 0x83c);
diff --git a/drivers/accel/ane/ane_h16_tasks.h b/drivers/accel/ane/ane_h16_tasks.h
index 413be2af81..a375d77ae6 100644
--- a/drivers/accel/ane/ane_h16_tasks.h
+++ b/drivers/accel/ane/ane_h16_tasks.h
@@ -42,10 +42,10 @@ static inline bool ane_h16_register_valid(u32 word)
  */
 static inline int
 ane_hx_task_stream_validate_limit(const void *text, size_t size, u32 expected_tasks,
-				  u32 prologue, u32 *record_limit)
+				  u32 prologue, u32 *record_limit, size_t *final_end)
 {
 	const u8 *p = text;
-	size_t pos = 16;
+	size_t pos = 16, last = 0;
 	u32 tasks = 0, limit = 0;
 
 	if (!p || !expected_tasks || size < 16 || size > ANE_H16_TASK_MAX ||
@@ -103,6 +103,7 @@ ane_hx_task_stream_validate_limit(const void *text, size_t size, u32 expected_ta
 		padded = end == size ? end : ALIGN(end, 16);
 		if (padded > size || memchr_inv(p + end, 0, padded - end))
 			return -ENOEXEC;
+		last = end;
 		pos = padded;
 		if (++tasks > expected_tasks)
 			return -ENOEXEC;
@@ -111,13 +112,16 @@ ane_hx_task_stream_validate_limit(const void *text, size_t size, u32 expected_ta
 		return -ENOEXEC;
 	if (record_limit)
 		*record_limit = limit;
+	if (final_end)
+		*final_end = last;
 	return 0;
 }
 
 static inline int
 ane_hx_task_stream_validate(const void *text, size_t size, u32 expected_tasks, u32 prologue)
 {
-	return ane_hx_task_stream_validate_limit(text, size, expected_tasks, prologue, NULL);
+	return ane_hx_task_stream_validate_limit(text, size, expected_tasks, prologue, NULL,
+						 NULL);
 }
 
 static inline int
