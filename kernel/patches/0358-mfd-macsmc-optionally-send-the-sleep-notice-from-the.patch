diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
index d876028773..8b146ae63e 100644
--- a/drivers/mfd/macsmc.c
+++ b/drivers/mfd/macsmc.c
@@ -1117,6 +1117,132 @@ static void apple_smc_clock_mark(struct apple_smc *smc)
 	apple_sleep_smc_clock_mark(smc_us, before, after);
 }
 
+/*
+ * smc-notice-late (bring-up, default off): send slpa and the AP idle notice
+ * from the sleep's finisher, right before the commit, instead of here. On
+ * macOS the SMC stamps the sleep (CLSP) within 1 ms of the last AP step;
+ * ours tells it at this noirq, before the whole sleep sequence. Only with
+ * the T8132 sequence; a sleep that stops before the finisher's end never
+ * sends it, and .complete takes the warning back as for any refusal.
+ */
+static bool notice_late;
+module_param(notice_late, bool, 0644);
+MODULE_PARM_DESC(notice_late,
+		 "Bring-up: send the SMC's sleep notice from the T8132 sleep's finisher, right before the commit (default: off)");
+
+/* The finisher has interrupts off and timekeeping suspended: counted 10 us steps, 200 ms. */
+#define SMC_COUNTED_STEP_US	10
+#define SMC_COUNTED_STEPS	20000
+
+/*
+ * One command from the finisher: no lock (no other CPU and no interrupt
+ * runs there) and no clock, the reply polled for a counted time.
+ */
+static int apple_smc_cmd_counted(struct apple_smc *smc, u64 cmd, smc_key key, u64 size)
+{
+	unsigned int i;
+	u64 msg;
+
+	if (smc->boot_stage != APPLE_SMC_INITIALIZED || smc->atomic_mode || smc->ap_notified)
+		return -EIO;
+
+	reinit_completion(&smc->cmd_done);
+	smc->msg_id = (smc->msg_id + 1) & 0xf;
+	msg = (FIELD_PREP(SMC_MSG, cmd) |
+	       FIELD_PREP(SMC_SIZE, size) |
+	       FIELD_PREP(SMC_ID, smc->msg_id) |
+	       FIELD_PREP(SMC_DATA, key));
+	if (apple_rtkit_send_message(smc->rtk, SMC_ENDPOINT, msg, NULL, true))
+		return -EIO;
+
+	for (i = 0; ; i++) {
+		apple_rtkit_poll(smc->rtk);
+		if (completion_done(&smc->cmd_done))
+			break;
+		if (i == SMC_COUNTED_STEPS)
+			return -ETIMEDOUT;
+		udelay(SMC_COUNTED_STEP_US);
+	}
+
+	if (FIELD_GET(SMC_ID, smc->cmd_ret) != smc->msg_id)
+		return -EIO;
+	if (FIELD_GET(SMC_RESULT, smc->cmd_ret))
+		return -EIO;
+
+	return FIELD_GET(SMC_SIZE, smc->cmd_ret);
+}
+
+/*
+ * The late notice, from apple-s2r's T8132 finisher: the SMC's clock (for
+ * smc-stamp), slpa, the arm gap, the AP idle notice and the idle gap, the
+ * order of apple_smc_sleep_commit(). 0 once the SMC took the notice; an
+ * idle notice not answered is taken back, as at noirq.
+ */
+static int apple_smc_notice_late(void *data)
+{
+	struct apple_smc *smc = data;
+	u32 slpa = SMC_KEY(slpa);
+	u64 smc_us, before, after;
+	unsigned int us = 0;
+	int ret;
+
+	before = get_cycles();
+	ret = apple_smc_cmd_counted(smc, SMC_MSG_READ_KEY, SMC_KEY(CLKU), sizeof(smc_us));
+	after = get_cycles();
+	if (ret == sizeof(smc_us)) {
+		apple_smc_read_sram(smc, &smc_us, sizeof(smc_us));
+		apple_sleep_smc_clock_mark(smc_us, before, after);
+	}
+
+	memcpy_toio(smc->shmem.iomem, &slpa, sizeof(slpa));
+	ret = apple_smc_cmd_counted(smc, SMC_MSG_WRITE_KEY, SMC_KEY(MBSE), sizeof(slpa));
+	if (ret >= 0) {
+		mdelay(SMC_SLEEP_ARM_MS);
+		smc->ap_notified = true;
+		ret = apple_rtkit_ap_power_polled(smc->rtk, false, &us);
+		if (ret) {
+			unsigned int back;
+
+			apple_rtkit_ap_power_polled(smc->rtk, true, &back);
+			smc->ap_notified = false;
+		} else {
+			mdelay(SMC_SLEEP_IDLE_MS);
+		}
+	}
+
+	smc->late_ret = ret < 0 ? ret : 0;
+	smc->late_us = us;
+	return smc->late_ret;
+}
+
+/* At noirq: leave the notice to the finisher, when asked and when it can take it. */
+static bool apple_smc_notice_late_arm(struct apple_smc *smc)
+{
+	if (!READ_ONCE(notice_late))
+		return false;
+	if (apple_sleep_smc_late_register(apple_smc_notice_late, smc, sizeof(*smc))) {
+		dev_warn(smc->dev, "smc-notice-late: no T8132 finisher to send it, sent now\n");
+		return false;
+	}
+	smc->late_ret = -ENODATA;
+	smc->late_us = 0;
+	smc->notice_late = true;
+	return true;
+}
+
+static void apple_smc_notice_late_end(struct apple_smc *smc)
+{
+	if (!smc->notice_late)
+		return;
+	apple_sleep_smc_late_unregister(smc);
+	smc->notice_late = false;
+	if (smc->late_ret == -ENODATA)
+		dev_info(smc->dev, "smc-notice-late: not sent, the sleep stopped before the finisher's end\n");
+	else
+		dev_info(smc->dev, "smc-notice-late: sent from the finisher: %d, idle answered in %u us\n",
+			 smc->late_ret, smc->late_us);
+}
+
 static int apple_smc_suspend_noirq(struct device *dev)
 {
 	struct apple_smc *smc = dev_get_drvdata(dev);
@@ -1128,6 +1254,10 @@ static int apple_smc_suspend_noirq(struct device *dev)
 	apple_smc_set_polled(smc, true);
 	if (apple_sleep_debug_link_cut())
 		apple_smc_outbox_settle(smc);
+	if (apple_smc_notice_late_arm(smc)) {
+		apple_smc_set_polled(smc, false);
+		return 0;
+	}
 	apple_smc_clock_mark(smc);
 	ret = apple_smc_sleep_commit(smc);
 	apple_smc_set_polled(smc, false);
@@ -1139,6 +1269,7 @@ static int apple_smc_resume_noirq(struct device *dev)
 {
 	struct apple_smc *smc = dev_get_drvdata(dev);
 
+	apple_smc_notice_late_end(smc);
 	if (smc->ap_notified) {
 		apple_smc_set_polled(smc, true);
 		apple_smc_sleep_wake(smc);
