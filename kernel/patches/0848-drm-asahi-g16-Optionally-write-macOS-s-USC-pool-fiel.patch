From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 00:01:15 +0000
Subject: [PATCH] drm/asahi: g16: Optionally write macOS's USC pool
 fields in the render tables

Every TA and FS record carries a USC private-memory pool word, register
0xa5a1 in the TA table and 0xa5a9 in the FS table, which we write as the
constant 0x6000400020. macOS 26B123 writes a per-pipeline field at bit
32 of both: for the same gpubench renders, at 64x64 and at 1920x1080,
0xa9 in the TA word and 0xb5 in the FS word; its own compositor's
renders carry 0xfe and 0x116..0x200.

Add g16_usc_pool (runtime, read per render, default 0: unchanged). 1
writes macOS's gpubench values (TA 0xa9, FS 0xb5) into that field, and
2..0xffff writes the given value into both, so the field can be scanned
without a rebuild.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/engine.rs | 17 +++++++++++++++++
 drivers/gpu/drm/asahi/g16/params.rs | 24 ++++++++++++++++++++++++
 2 files changed, 41 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 3c12a00fd1..a2429ba42a 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -2158,6 +2158,23 @@ fn prefix_render(
                 w.copy_from_slice(&(u64::from_le_bytes(v) | bit).to_le_bytes());
             }
         }
+        // g16_usc_pool: the USC private-memory pool word of the TA (0xa5a1) and FS (0xa5a9)
+        // register tables. Ours is the constant 0x6000400020; macOS writes a per-pipeline
+        // field at bit 32 (TA 0xa9 / FS 0xb5 for the gpubench renders).
+        if let Some((ta_pool, fs_pool)) = params::usc_pool() {
+            let ta = work::ta::SEL.iter().position(|&s| s == 0xa5a1).ok_or(EINVAL)?;
+            let fs = work::fs::SEL.iter().position(|&s| s == 0xa5a9).ok_or(EINVAL)?;
+            for (v, at, pool) in [
+                (&mut scratch.ta, work::ta::REGS + work::REG_RECORD * ta + 4, ta_pool),
+                (&mut scratch.fs, work::fs::REGS + work::REG_RECORD * fs + 4, fs_pool),
+            ] {
+                let w = v.get_mut(at..at + 8).ok_or(EINVAL)?;
+                let mut b = [0u8; 8];
+                b.copy_from_slice(w);
+                let low = u64::from_le_bytes(b) & 0xffff_ffff;
+                w.copy_from_slice(&(low | u64::from(pool) << 32).to_le_bytes());
+            }
+        }
         encode::render_attachments(&mut scratch.tas[..], 0, &cmd.vertex_attachments);
         encode::render_attachments(&mut scratch.fss[..], 1, &cmd.fragment_attachments);
         params::render_patch_apply(&mut scratch.tas[..], &mut scratch.fss[..]);
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 5aa6869180..931d494901 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -1090,6 +1090,30 @@ pub(crate) fn fs_tile_bit16() -> bool {
     "G16: set bit 16 of the FS tile mode word (register 0x10039, +0x9d8) as macOS does on application renders (default 0: off; 1: set; runtime 0644, read per render)"
 );
 
+/// Storage of `g16_usc_pool` (runtime 0644, default 0).
+static USC_POOL: AtomicU32 = AtomicU32::new(0);
+
+/// The USC private-memory pool fields (bits 32..47 of TA register 0xa5a1 and FS register
+/// 0xa5a9, as TA / FS) a render writes instead of our constant 0x60: none (0, default),
+/// the values macOS 26B123 writes for the gpubench pipelines at 64x64 and 1920x1080 (1: TA
+/// 0xa9, FS 0xb5), or the given value in both (2..0xffff).
+pub(crate) fn usc_pool() -> Option<(u32, u32)> {
+    match USC_POOL.load(Ordering::Relaxed) {
+        0 => None,
+        1 => Some((0xa9, 0xb5)),
+        v => Some((v & 0xffff, v & 0xffff)),
+    }
+}
+
+live_u32_param!(
+    USC_POOL_PARAM,
+    USC_POOL_PARMTYPE,
+    USC_POOL_PARM,
+    USC_POOL,
+    "g16_usc_pool",
+    "G16: the USC private-memory pool field (bits 32.. of TA 0xa5a1 / FS 0xa5a9) of every render (default 0: our 0x60; 1: macOS's TA 0xa9 / FS 0xb5; 2..0xffff: that value in both; runtime 0644, read per render)"
+);
+
 /// Storage of `g16_fs_isp_bit0` (runtime 0644, default 0).
 static FS_ISP_BIT0: AtomicU32 = AtomicU32::new(0);
 
-- 
2.43.0

