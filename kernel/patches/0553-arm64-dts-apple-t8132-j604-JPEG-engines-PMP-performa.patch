From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 08:27:19 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: JPEG engines' PMP
 performance request

Traced on the J604 under macOS 26B123 (VideoToolbox's hardware JPEG
encoder on 30 3840x2160 frames, then an 8K JPEG decode through
ImageIO): the PMP request word gains bit 22 for each session
(0x209000 -> 0x609000) and SOC-DEV-DVFS entry 420 is held at main
level 2 while the engine runs. Only jpeg0 was used.

Add the matching report entry, as the AVD's and the encoder's are, and
give both JPEG engines it as their "perf" power domain, which the
driver holds while the engine is runtime-active.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index 85409af756..1f2f975f29 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -874,6 +874,9 @@ &ane_dart2 {
 };
 
 &jpeg0 {
+	/* the JPEG PMP performance request second (see &pmp_report) */
+	power-domains = <&ps_jpg>, <&pmp_report_jpg>;
+	power-domain-names = "core", "perf";
 	status = "okay";
 };
 
@@ -882,6 +885,8 @@ &dart_jpeg00 {
 };
 
 &jpeg1 {
+	power-domains = <&ps_jpg>, <&pmp_report_jpg>;
+	power-domain-names = "core", "perf";
 	status = "okay";
 };
 
@@ -1469,6 +1474,22 @@ pmp_report_venc_sys: report@13 {
 		apple,no-ack;
 	};
 
+	/*
+	 * JPEG, q8-media-eng-1 (macOS 26B123, VideoToolbox hardware JPEG encode of
+	 * 30 4K frames and an 8K decode): bit 22 (JPG, table position 22) is set
+	 * for each session and SOC-DEV-DVFS entry 420 held at main level 2 while
+	 * the engine runs; only jpeg0 was used.
+	 */
+	pmp_report_jpg: report@16 {
+		compatible = "apple,t6000-pmp-v2-report-entry";
+		reg = <0x16>;
+		label = "pmp-jpg";
+		#power-domain-cells = <0>;
+		power-domains = <&ps_jpg>;
+		apple,dvfs = <420 2>;
+		apple,no-ack;
+	};
+
 	pmp_report_msr: report@15 {
 		compatible = "apple,t6000-pmp-v2-report-entry";
 		reg = <0x15>;
-- 
2.43.0

