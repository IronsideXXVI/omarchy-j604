From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 00:19:14 +0000
Subject: [PATCH] drm: apple: dcp: let an idle T8132 HDMI output
 release its PHY and crossbar

The T8132 HDMI output takes its DisplayPort-only PHY (DP mode) and its
crossbar output at probe and keeps both. That holds their power domain
up while nothing is attached, even after the dcpext itself has powered
down for idle.

Add hdmi_idle_release, off by default. When it is set, the idle
power-down also lets go of the crossbar output, as a Type-C route that
borrows the pipeline does, and puts the PHY in its safe state. The next
HPD sample that sees a display takes both back before it connects,
through the steps probe and resume use: the PHY to DisplayPort, then
dcp_fixed_output_select(). The resume reinit does the same for a
released output. The fabric lock is taken on its own after hpd_mutex
is dropped, the same lock order the HPD thread uses. The HPD line and
the converter power are not touched.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 1e87d6f076f1fa32aaecada764649c1087e73a88)
---
 drivers/gpu/drm/apple/dcp-fabric.c   | 68 ++++++++++++++++++++++++++++
 drivers/gpu/drm/apple/dcp-fabric.h   |  1 +
 drivers/gpu/drm/apple/dcp-internal.h |  2 +
 drivers/gpu/drm/apple/dcp.c          |  8 ++++
 4 files changed, 79 insertions(+)

diff --git a/drivers/gpu/drm/apple/dcp-fabric.c b/drivers/gpu/drm/apple/dcp-fabric.c
index e1b68273eb..53ce27df60 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.c
+++ b/drivers/gpu/drm/apple/dcp-fabric.c
@@ -1271,6 +1271,8 @@ void dcp_fabric_hdmi_resume(struct apple_dcp *dcp)
  * out of DP and back into it, and the crossbar output selected again if the
  * HDMI route holds it. No HDMI link is up when this runs.
  */
+static void dcp_fixed_hdmi_unpark_locked(struct apple_dcp *dcp);
+
 static void dcp_fixed_hdmi_reinit_locked(struct apple_dcp *dcp, const char *why)
 {
 	int ret = 0;
@@ -1279,6 +1281,14 @@ static void dcp_fixed_hdmi_reinit_locked(struct apple_dcp *dcp, const char *why)
 	if (!dcp->external_native || !dcp->fixed_phy || !dcp->hdmi_hpd)
 		return;
 	dev_info(dcp->dev, "HDMI: setting up the output again (%s)\n", why);
+	if (dcp->hdmi_parked) {
+		if (dcp->hdmi_pwren)
+			gpiod_set_value_cansleep(dcp->hdmi_pwren, 1);
+		if (dcp->dp2hdmi_pwren)
+			gpiod_set_value_cansleep(dcp->dp2hdmi_pwren, 1);
+		dcp_fixed_hdmi_unpark_locked(dcp);
+		return;
+	}
 	if (dcp->hdmi_pwren)
 		gpiod_set_value_cansleep(dcp->hdmi_pwren, 1);
 	if (dcp->dp2hdmi_pwren)
@@ -1314,6 +1324,61 @@ void dcp_fabric_hdmi_reinit(struct apple_dcp *dcp, const char *why)
 	dcp_fixed_hdmi_reinit_locked(dcp, why);
 }
 
+/*
+ * T8132 HDMI output, idle with nothing attached: its DP-only PHY and the
+ * crossbar output stay taken from probe on, which keeps their power domain
+ * up. With hdmi_idle_release, the idle power-down of the dcpext lets both go,
+ * as a Type-C route that borrows the pipeline does (dcp_typec_route_activate()),
+ * and the next HPD sample takes them again before it connects. The HPD line and
+ * the converter power stay as they are.
+ */
+static void dcp_fixed_hdmi_unpark_locked(struct apple_dcp *dcp)
+{
+	struct typec_altmode alt = { .svid = USB_TYPEC_DP_SID };
+	struct typec_mux_state state = { .alt = &alt, .mode = TYPEC_DP_STATE_C };
+	int ret = 0;
+
+	lockdep_assert_held(&dcp_typec_fabric_lock);
+	if (!dcp->hdmi_parked)
+		return;
+	dcp->hdmi_parked = false;
+	if (dcp->typec_mux && dcp->phy_managed_by_typec)
+		ret = typec_mux_set(dcp->typec_mux, &state);
+	if (ret)
+		dev_warn(dcp->dev, "HDMI: PHY not taken again after idle: %d\n", ret);
+	ret = dcp_fixed_output_select(dcp);
+	if (ret)
+		dev_warn(dcp->dev, "HDMI: crossbar output not taken again after idle: %d\n", ret);
+}
+
+void dcp_fabric_hdmi_park(struct apple_dcp *dcp)
+{
+	struct typec_mux_state state = { .mode = TYPEC_STATE_SAFE };
+	int ret = 0;
+
+	guard(mutex)(&dcp_typec_fabric_lock);
+	if (!dcp->external_native || !dcp->fixed_phy || !dcp->hdmi_hpd || dcp->hdmi_parked)
+		return;
+	if (dcp->active_typec_route || gpiod_get_value_cansleep(dcp->hdmi_hpd) > 0)
+		return;
+	if (dcp->fixed_xbar && dcp->fixed_route_selected) {
+		scoped_guard(mutex, &dcp->tb_lock)
+			dcp->direct_xbar_up = NULL;
+		ret = mux_control_deselect(dcp->fixed_xbar);
+		if (ret) {
+			dev_warn(dcp->dev, "HDMI: crossbar output not let go: %d\n", ret);
+			return;
+		}
+		dcp->fixed_route_selected = false;
+	}
+	if (dcp->typec_mux && dcp->phy_managed_by_typec)
+		ret = typec_mux_set(dcp->typec_mux, &state);
+	if (ret)
+		dev_warn(dcp->dev, "HDMI: PHY not let go: %d\n", ret);
+	dcp->hdmi_parked = true;
+	dev_info(dcp->dev, "HDMI: PHY and crossbar output let go while idle\n");
+}
+
 /* A Thunderbolt tunnel holds its pipeline; direct moves never steal it. */
 static bool dcp_typec_tunnel_held(struct apple_dcp *dcp)
 {
@@ -5251,6 +5316,9 @@ irqreturn_t dcp_dp2hdmi_hpd(int irq, void *data)
 void dcp_fabric_hdmi_sample(struct apple_dcp *dcp)
 {
 	guard(mutex)(&dcp_typec_fabric_lock);
+	if (dcp->hdmi_parked && dcp->hdmi_hpd &&
+	    gpiod_get_value_cansleep(dcp->hdmi_hpd) > 0)
+		dcp_fixed_hdmi_unpark_locked(dcp);
 	dcp_hdmi_update_locked(dcp);
 	/* Attached or not may have changed. */
 	dcp_t8132_idle_kick(dcp);
diff --git a/drivers/gpu/drm/apple/dcp-fabric.h b/drivers/gpu/drm/apple/dcp-fabric.h
index b121074a47..288e4b342c 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.h
+++ b/drivers/gpu/drm/apple/dcp-fabric.h
@@ -131,6 +131,7 @@ void dcp_fabric_hdmi_retry(struct apple_dcp *dcp);
 irqreturn_t dcp_dp2hdmi_hpd_edge(int irq, void *data);
 irqreturn_t dcp_dp2hdmi_hpd(int irq, void *data);
 void dcp_fabric_hdmi_sample(struct apple_dcp *dcp);
+void dcp_fabric_hdmi_park(struct apple_dcp *dcp);
 void dcp_fabric_shutdown_dptx(struct apple_dcp *dcp);
 
 /* DPTX operations supplied by the DCP firmware layer. */
diff --git a/drivers/gpu/drm/apple/dcp-internal.h b/drivers/gpu/drm/apple/dcp-internal.h
index 0511036ba5..6271d10a23 100644
--- a/drivers/gpu/drm/apple/dcp-internal.h
+++ b/drivers/gpu/drm/apple/dcp-internal.h
@@ -910,6 +910,8 @@ struct apple_dcp {
 	u32 fixed_dptx_phy;
 	u32 fixed_mux_index;
 	bool fixed_route_selected;
+	/* T8132 HDMI: PHY and crossbar output let go while idle (hdmi_idle_release) */
+	bool hdmi_parked;
 	struct apple_connector *fixed_connector;
 	struct apple_connector *typec_connector;
 	int hdmi_hpd_irq;
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 7bd6f4f221..b3e2ad0b69 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -339,6 +339,11 @@ bool dcp_h17p_external_ready(struct device_node *np)
 }
 
 static bool show_notch;
+static bool hdmi_idle_release;
+module_param(hdmi_idle_release, bool, 0644);
+MODULE_PARM_DESC(hdmi_idle_release,
+		 "T8132 HDMI: let the DP PHY and crossbar output go while the dcpext is idle (default: N; experimental)");
+
 static unsigned int dcpext_idle_ms = DCP_M4_EXT_IDLE_MS_DEFAULT;
 module_param(dcpext_idle_ms, uint, 0644);
 MODULE_PARM_DESC(dcpext_idle_ms,
@@ -6698,6 +6703,9 @@ static void dcp_t8132_idle_work(struct work_struct *work)
 		     (dcp->dptxep && afk_compact_orphans_pending(dcp->dptxep));
 	verdict = iomfb_m4_ext_idle_gate(dcp, &in);
 	mutex_unlock(&dcp->hpd_mutex);
+	/* The fabric lock is taken on its own, not under hpd_mutex. */
+	if (verdict == DCP_M4_EXT_IDLE_DOWN && READ_ONCE(hdmi_idle_release))
+		dcp_fabric_hdmi_park(dcp);
 	if (verdict == DCP_M4_EXT_IDLE_RECHECK && ms)
 		mod_delayed_work(system_freezable_wq, &dcp->t8132_idle_wq,
 				 msecs_to_jiffies(ms));
-- 
2.43.0

