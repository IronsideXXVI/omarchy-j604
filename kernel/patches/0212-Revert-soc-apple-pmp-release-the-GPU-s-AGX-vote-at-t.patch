-	KUNIT_EXPECT_TRUE(test, m.s.agx_at_commit);
-	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
-	KUNIT_EXPECT_TRUE(test, m.v.agx_held);
