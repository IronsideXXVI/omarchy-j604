-/*
- * The PMP's last stop at the sleep's commit, interrupts off and one CPU up,
- * after the GPU's (registered first) and before the PMP idles: the AGX
- * release, if the GPU armed it. 1: sent, 0: nothing to send, negative: the
- * send failed. The vote no longer counts as held either way.
- */
-int apple_pmp_display_commit(struct apple_rtkit *rtk)
-{
-	/* Pairs with the release in apple_pmp_display_register(). */
-	struct apple_pmp_display *p = smp_load_acquire(&pmp_display);
-	bool send;
-
-	if (!p)
-		return 0;
-	/* Nothing else runs now: the lock is free, taken for its ordering. */
-	spin_lock(&p->lock);
-	send = pmp_display_sleep_commit_agx(&p->sleep, &p->vote.held[PMP_POWER_AGX]);
-	spin_unlock(&p->lock);
-	if (!send)
-		return 0;
-	return apple_rtkit_send_polled(rtk, PMP_ENDPOINT, PMP_AGX_RELEASE) ?: 1;
-}
