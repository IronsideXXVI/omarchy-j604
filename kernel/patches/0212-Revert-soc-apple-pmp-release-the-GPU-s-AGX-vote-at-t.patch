-
-/* Whether this sleep needs the commit for AGX: the PMP refuses one that can't take it. */
-bool apple_pmp_display_agx_at_commit(void)
-{
-	/* Pairs with the release in apple_pmp_display_register(). */
-	struct apple_pmp_display *p = smp_load_acquire(&pmp_display);
-	unsigned long flags;
-	bool armed;
-
-	if (!p)
-		return false;
-	spin_lock_irqsave(&p->lock, flags);
-	armed = p->sleep.agx_at_commit && p->vote.held[PMP_POWER_AGX];
-	spin_unlock_irqrestore(&p->lock, flags);
-	return armed;
-}
