-	m.v.error = -EPROTO;
-	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm_agx(&m.s, &m.v), PMP_DISPLAY_SLEEP_FAILED);
-	KUNIT_EXPECT_FALSE(test, m.s.agx_at_commit);
-	m.v.error = 0;
-	m.v.agx_held = false;
-	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm_agx(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
-	KUNIT_EXPECT_FALSE(test, m.s.agx_at_commit);
-}
