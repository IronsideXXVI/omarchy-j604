From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 16:22:46 +0000
Subject: [PATCH] thunderbolt: apple: Optionally wake from
 suspend-to-idle on a plug event

With router_sleep off (the default), the routers stay awake through
suspend-to-idle, and a USB4 or Thunderbolt plug or unplug arrives as a
control packet on RX ring 0. That interrupt is not a wakeup source, so
the packet is handled while the system stays asleep. Plugging a dock
into a sleeping Mac wakes it under macOS, where the NHI is a wake source.

Add plug_wake (default N). With it set, a suspend-to-idle that goes ahead
arms RX ring 0's interrupt as a wakeup after the domain has suspended,
and resume disarms it. Sleeps that power the SoC down, and router_sleep,
are left as they are. A refused sleep arms nothing, because that device
is never resumed.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/thunderbolt/apple.c | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/drivers/thunderbolt/apple.c b/drivers/thunderbolt/apple.c
index c05f61140b..4e559610f7 100644
--- a/drivers/thunderbolt/apple.c
+++ b/drivers/thunderbolt/apple.c
@@ -344,6 +344,17 @@ module_param(host_clx, bool, 0444);
 MODULE_PARM_DESC(host_clx,
 		 "Allow CL link power states on ACIO generations that keep their links in CL0 (T8132; default N; experimental)");
 
+/*
+ * Through suspend-to-idle the routers stay awake (router_sleep off) and a
+ * plug or unplug arrives as a control packet on RX ring 0. That interrupt is
+ * not a wakeup source, so it is handled without ending the sleep. With this
+ * set it is one for suspend-to-idle, as the NHI is a wake source in macOS.
+ */
+static bool plug_wake;
+module_param(plug_wake, bool, 0644);
+MODULE_PARM_DESC(plug_wake,
+		 "Wake from suspend-to-idle on a USB4/Thunderbolt plug or unplug (control ring interrupt; default N; experimental)");
+
 static bool cio_s2r;
 module_param(cio_s2r, bool, 0400);
 MODULE_PARM_DESC(cio_s2r, "Enable experimental J713/J604 attached-dock system sleep");
@@ -1343,6 +1354,8 @@ struct apple_nhi {
 
 	int *tx_irqs;
 	int *rx_irqs;
+	/* RX ring 0's interrupt is armed as a wakeup for this sleep (plug_wake) */
+	bool plug_wake_armed;
 	const char **tx_irq_names;
 	const char **rx_irq_names;
 	size_t n_rings;
@@ -2815,6 +2828,7 @@ static bool apple_nhi_has_pcie_tunnel(struct apple_cio *acio)
 static int apple_nhi_suspend_noirq(struct device *dev)
 {
 	struct apple_nhi *anhi = dev_get_drvdata(dev);
+	int ret;
 
 	if (anhi->cio_prepared)
 		return apple_nhi_cio_suspend(anhi);
@@ -2847,7 +2861,15 @@ static int apple_nhi_suspend_noirq(struct device *dev)
 		return -EBUSY;
 	}
 
-	return tb_domain_suspend_noirq(anhi->tb);
+	ret = tb_domain_suspend_noirq(anhi->tb);
+	/* Only a sleep that goes ahead: a refused one never resumes this device. */
+	if (!ret && READ_ONCE(plug_wake) && !READ_ONCE(router_sleep) &&
+	    pm_suspend_target_state == PM_SUSPEND_TO_IDLE && anhi->rx_irqs[0] > 0 &&
+	    !enable_irq_wake(anhi->rx_irqs[0])) {
+		anhi->plug_wake_armed = true;
+		dev_info(dev, "plug_wake: control ring interrupt armed for this sleep\n");
+	}
+	return ret;
 }
 
 static int apple_nhi_resume_noirq(struct device *dev)
@@ -2856,6 +2878,10 @@ static int apple_nhi_resume_noirq(struct device *dev)
 
 	if (anhi->cio_prepared)
 		return apple_nhi_cio_resume(anhi);
+	if (anhi->plug_wake_armed) {
+		disable_irq_wake(anhi->rx_irqs[0]);
+		anhi->plug_wake_armed = false;
+	}
 	anhi->acio->resume_activity = atomic64_read(&anhi->tb->remote_activity);
 	WRITE_ONCE(anhi->acio->resume_link_pending, true);
 	return tb_domain_resume_noirq(anhi->tb);
-- 
2.43.0

