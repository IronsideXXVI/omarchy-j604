diff --git a/drivers/gpu/drm/apple/dcp-m4-ext-sink-test.c b/drivers/gpu/drm/apple/dcp-m4-ext-sink-test.c
new file mode 100644
index 0000000000..d06af45aa7
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-ext-sink-test.c
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/*
+ * The sink of a T8132 external output (dcp-m4-ext-sink.h): which EDID its
+ * connector publishes, whether the sink is wide gamut, and which primaries
+ * its frames carry.
+ */
+
+#include <kunit/test.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_modes.h>
+
+#include "dcp-m4-ext-sink.h"
+
+#define XY3(rx, ry, gx, gy, bx, by) {						\
+	{ DCP_M4_XY(rx), DCP_M4_XY(ry) }, { DCP_M4_XY(gx), DCP_M4_XY(gy) },	\
+	{ DCP_M4_XY(bx), DCP_M4_XY(by) } }
+
+static const u32 srgb[3][2] = XY3(6400, 3300, 3000, 6000, 1500, 600);
+static const u32 p3[3][2] = XY3(6800, 3200, 2650, 6900, 1500, 600);
+static const u32 bt2020[3][2] = XY3(7080, 2920, 1700, 7970, 1310, 460);
+static const u32 adobe[3][2] = XY3(6400, 3300, 2100, 7100, 1500, 600);
+/* A typical office monitor, a little beyond sRGB */
+static const u32 office[3][2] = XY3(6500, 3300, 3100, 6200, 1500, 500);
+/* Display P3 listed blue, green, red: the other winding */
+static const u32 p3_reversed[3][2] = XY3(1500, 600, 2650, 6900, 6800, 3200);
+static const u32 none[3][2] = {};
+static const u32 line[3][2] = XY3(1000, 1000, 2000, 2000, 3000, 3000);
+
+static void ext_sink_edid_pick(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_edid_pick(true, true, 4, 4), DCP_M4_EXT_EDID_SINK);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_edid_pick(true, false, 4, 4), DCP_M4_EXT_EDID_SINK);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_edid_pick(false, true, 4, 4), DCP_M4_EXT_EDID_BUILT);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_edid_pick(false, false, 4, 4), DCP_M4_EXT_EDID_NONE);
+	/* DisplayAttributes of an earlier sink describe nothing now */
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_edid_pick(true, true, 3, 4), DCP_M4_EXT_EDID_NONE);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_edid_pick(false, true, 3, 4), DCP_M4_EXT_EDID_NONE);
+}
+
+static void ext_sink_wide_by_area(struct kunit *test)
+{
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(srgb, false));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(office, false));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(p3, false));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(p3_reversed, false));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(bt2020, false));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(adobe, false));
+}
+
+/* Chromaticity decides where it is usable; BT.2020 RGB only without it. */
+static void ext_sink_wide_without_chromaticity(struct kunit *test)
+{
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xy_usable(none));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xy_usable(line));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xy_usable(srgb));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(none, true));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(none, false));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(line, true));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(line, false));
+	/* An sRGB panel that takes BT.2020 RGB signalling stays an sRGB sink */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(srgb, true));
+}
+
+static void ext_sink_edid_chromaticity(struct kunit *test)
+{
+	u8 b[EDID_LENGTH] = {};
+	u32 c[3][2];
+
+	/* 10-bit red 655,338 green 307,614 blue 154,61 */
+	b[25] = 3 << 6 | 2 << 4 | 3 << 2 | 2;
+	b[26] = 2 << 6 | 1 << 4;
+	b[27] = 655 >> 2;
+	b[28] = 338 >> 2;
+	b[29] = 307 >> 2;
+	b[30] = 614 >> 2;
+	b[31] = 154 >> 2;
+	b[32] = 61 >> 2;
+	dcp_m4_edid_chromaticity(b, c);
+	KUNIT_EXPECT_EQ(test, c[0][0], 655U * 64);
+	KUNIT_EXPECT_EQ(test, c[0][1], 338U * 64);
+	KUNIT_EXPECT_EQ(test, c[1][0], 307U * 64);
+	KUNIT_EXPECT_EQ(test, c[1][1], 614U * 64);
+	KUNIT_EXPECT_EQ(test, c[2][0], 154U * 64);
+	KUNIT_EXPECT_EQ(test, c[2][1], 61U * 64);
+	/* ... which is an sRGB-sized panel */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(c, false));
+}
+
+static void ext_sink_primaries(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, DCP_M4_PRIMARIES_BT709, 1);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_primaries(true, false, false), DCP_M4_PRIMARIES_BT2020);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_primaries(true, true, true), DCP_M4_PRIMARIES_BT2020);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_primaries(false, true, false), DCP_M4_PRIMARIES_BT2020);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_primaries(false, true, true), DCP_M4_PRIMARIES_BT2020);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_primaries(false, false, true), DCP_M4_PRIMARIES_P3_D65);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_primaries(false, false, false), DCP_M4_PRIMARIES_BT709);
+	KUNIT_EXPECT_STREQ(test, dcp_m4_primaries_name(DCP_M4_PRIMARIES_BT709), "BT.709 (sRGB)");
+	KUNIT_EXPECT_STREQ(test, dcp_m4_primaries_name(DCP_M4_PRIMARIES_P3_D65), "Display P3");
+	KUNIT_EXPECT_STREQ(test, dcp_m4_primaries_name(DCP_M4_PRIMARIES_BT2020), "BT.2020");
+}
+
+/* DisplayAttributes of an HDR10 television, and 1080p60 for its timing. */
+static void hdr_tv(struct dcp_display_metadata *m, struct drm_display_mode *mode)
+{
+	*m = (struct dcp_display_metadata){
+		.width_cm = 121, .height_cm = 68, .gamma = 144179,
+		.product = 0x7101, .serial = 1, .week = 10, .year = 2024,
+		.manufacturer = "SAM", .name = "TEST TV",
+		.pq = true, .static_metadata_type1 = true, .bt2020_rgb = true,
+		.max_luminance = 800U << 16, .max_fall = 400U << 16, .min_luminance = 1U << 12,
+	};
+	memcpy(m->chromaticity, p3, sizeof(p3));
+	m->white[0] = DCP_M4_XY(3127);
+	m->white[1] = DCP_M4_XY(3290);
+	*mode = (struct drm_display_mode){
+		.clock = 148500, .hdisplay = 1920, .hsync_start = 2008, .hsync_end = 2052,
+		.htotal = 2200, .vdisplay = 1080, .vsync_start = 1084, .vsync_end = 1089,
+		.vtotal = 1125, .flags = DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC,
+	};
+}
+
+/* The data block of extended @tag in CTA extension @cta, NULL if none. */
+static const u8 *cta_block(const u8 *cta, u8 tag)
+{
+	for (unsigned int i = 4; i < cta[2] && i < EDID_LENGTH; i += 1 + (cta[i] & 31))
+		if (cta[i] >> 5 == 7 && (cta[i] & 31) >= 1 && cta[i + 1] == tag)
+			return cta + i;
+	return NULL;
+}
+
+/* What a compositor reads for HDR is in the EDID built for a PQ sink. */
+static void ext_sink_built_edid_hdr(struct kunit *test)
+{
+	struct dcp_display_metadata m;
+	struct drm_display_mode mode;
+	const struct drm_edid *edid;
+	const u8 *raw, *db;
+	u32 c[3][2];
+
+	hdr_tv(&m, &mode);
+	edid = dcp_metadata_edid(&m, &mode);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(edid));
+	KUNIT_EXPECT_TRUE(test, drm_edid_valid(edid));
+	raw = (const u8 *)drm_edid_raw(edid);
+	KUNIT_ASSERT_NOT_NULL(test, raw);
+	KUNIT_ASSERT_EQ(test, raw[126], 1);
+	KUNIT_EXPECT_EQ(test, raw[EDID_LENGTH], 0x02);
+	db = cta_block(raw + EDID_LENGTH, 0x06);
+	KUNIT_ASSERT_NOT_NULL(test, db);
+	KUNIT_EXPECT_EQ(test, db[2] & 0x05, 0x05);	/* SDR and ST 2084 */
+	KUNIT_EXPECT_EQ(test, db[3] & 1, 1);		/* static metadata type 1 */
+	db = cta_block(raw + EDID_LENGTH, 0x05);
+	KUNIT_ASSERT_NOT_NULL(test, db);
+	KUNIT_EXPECT_EQ(test, db[2] & 0x80, 0x80);	/* BT.2020 RGB */
+	/* ... and the sink's primaries, read back as wide gamut */
+	dcp_m4_edid_chromaticity(raw, c);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sink_wide(c, false));
+	drm_edid_free(edid);
+
+	/* A sink without PQ: the base block alone, still with its primaries */
+	m.pq = false;
+	memcpy(m.chromaticity, srgb, sizeof(srgb));
+	edid = dcp_metadata_edid(&m, &mode);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_OR_NULL(edid));
+	raw = (const u8 *)drm_edid_raw(edid);
+	KUNIT_ASSERT_NOT_NULL(test, raw);
+	KUNIT_EXPECT_EQ(test, raw[126], 0);
+	dcp_m4_edid_chromaticity(raw, c);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_sink_wide(c, false));
+	drm_edid_free(edid);
+}
+
+static struct kunit_case m4_ext_sink_cases[] = {
+	KUNIT_CASE(ext_sink_edid_pick),
+	KUNIT_CASE(ext_sink_wide_by_area),
+	KUNIT_CASE(ext_sink_wide_without_chromaticity),
+	KUNIT_CASE(ext_sink_edid_chromaticity),
+	KUNIT_CASE(ext_sink_primaries),
+	KUNIT_CASE(ext_sink_built_edid_hdr),
+	{}
+};
+
+static struct kunit_suite m4_ext_sink_suite = {
+	.name = "apple-dcp-m4-ext-sink",
+	.test_cases = m4_ext_sink_cases,
+};
+
+kunit_test_suite(m4_ext_sink_suite);
diff --git a/drivers/gpu/drm/apple/dcp-m4-ext-sink.h b/drivers/gpu/drm/apple/dcp-m4-ext-sink.h
new file mode 100644
index 0000000000..5f543e6178
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-ext-sink.h
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * What a T8132 external output (firmware 26.6.2) tells user space and its
+ * frames about the sink: the EDID its DRM connector publishes, and the
+ * primaries its SDR frames are tagged with.
+ *
+ * Like the desktop 26.x external processors (dcp.c), the dcpext hands out
+ * no EDID blob; it sends the sink's DisplayAttributes as a property, as it
+ * sends TimingElements.  The sink's own EDID, where DisplayAttributes carry
+ * one, is published as it is; else an EDID is built from their identity
+ * and colour (dcp_metadata_edid(): with PQ, a CTA-861 extension with the
+ * colorimetry and HDR static metadata data blocks a compositor reads);
+ * else none.
+ *
+ * A frame's primaries are an H.273 ColourPrimaries code point (surface
+ * +0x14, dcp-m4-edr.h): BT.2020 for PQ and for a BT2020_RGB Colorspace;
+ * Display P3 for a wide gamut sink; BT.709 (sRGB) for any other sink and
+ * when nothing is known about it.  Wide gamut: the sink's primaries span a
+ * CIE 1931 xy triangle at least as large as the mean of the sRGB and the
+ * Display P3 triangles; without usable chromaticity, a sink that takes
+ * BT.2020 RGB.
+ *
+ * Pure functions, for the KUnit suite.
+ */
+#ifndef APPLE_DCP_M4_EXT_SINK_H
+#define APPLE_DCP_M4_EXT_SINK_H
+
+#include <linux/math.h>
+#include <linux/types.h>
+
+#include "dcp-display-metadata.h"
+#include "dcp-m4-edr.h"
+
+/* The EDID an external connector publishes. */
+enum dcp_m4_ext_edid {
+	DCP_M4_EXT_EDID_NONE,
+	DCP_M4_EXT_EDID_SINK,	/* the sink's own, found in its DisplayAttributes */
+	DCP_M4_EXT_EDID_BUILT,	/* built from its DisplayAttributes */
+};
+
+/*
+ * For the sink of generation @gen, from its DisplayAttributes received in
+ * generation @attr_gen: the sink's own EDID if they carried one
+ * (@sink_edid), else one built from their identity and colour (@metadata).
+ */
+static inline enum dcp_m4_ext_edid dcp_m4_ext_edid_pick(bool sink_edid, bool metadata,
+							int attr_gen, int gen)
+{
+	if (attr_gen != gen)
+		return DCP_M4_EXT_EDID_NONE;
+	if (sink_edid)
+		return DCP_M4_EXT_EDID_SINK;
+	return metadata ? DCP_M4_EXT_EDID_BUILT : DCP_M4_EXT_EDID_NONE;
+}
+
+/* CIE 1931 x or y given in units of 1/10000, in the metadata's 1/65536. */
+#define DCP_M4_XY(v)	((u32)(((v) * 65536U + 5000U) / 10000U))
+
+/* Twice the signed area of a triangle of xy points in 1/65536 units. */
+static inline s64 dcp_m4_xy_area2(const u32 c[3][2])
+{
+	return ((s64)c[1][0] - c[0][0]) * ((s64)c[2][1] - c[0][1]) -
+	       ((s64)c[1][1] - c[0][1]) * ((s64)c[2][0] - c[0][0]);
+}
+
+/* Primaries every coordinate of which lies in (0, 1), not on one line. */
+static inline bool dcp_m4_xy_usable(const u32 c[3][2])
+{
+	for (unsigned int i = 0; i < 3; i++)
+		for (unsigned int j = 0; j < 2; j++)
+			if (!c[i][j] || c[i][j] >= 65536)
+				return false;
+	return dcp_m4_xy_area2(c) != 0;
+}
+
+/* Whether a sink with primaries @c (1/65536) is a wide gamut one. */
+static inline bool dcp_m4_ext_sink_wide(const u32 c[3][2], bool bt2020_rgb)
+{
+	static const u32 srgb[3][2] = {
+		{ DCP_M4_XY(6400), DCP_M4_XY(3300) },
+		{ DCP_M4_XY(3000), DCP_M4_XY(6000) },
+		{ DCP_M4_XY(1500), DCP_M4_XY(600) },
+	};
+	static const u32 p3[3][2] = {
+		{ DCP_M4_XY(6800), DCP_M4_XY(3200) },
+		{ DCP_M4_XY(2650), DCP_M4_XY(6900) },
+		{ DCP_M4_XY(1500), DCP_M4_XY(600) },
+	};
+
+	if (!dcp_m4_xy_usable(c))
+		return bt2020_rgb;
+	return 2 * abs(dcp_m4_xy_area2(c)) >=
+	       abs(dcp_m4_xy_area2(srgb)) + abs(dcp_m4_xy_area2(p3));
+}
+
+/*
+ * The red, green and blue chromaticity of an EDID base block @b (bytes
+ * 25-32, ten bits each) in 1/65536 units.
+ */
+static inline void dcp_m4_edid_chromaticity(const u8 *b, u32 c[3][2])
+{
+	c[0][0] = (b[27] << 2 | (b[25] >> 6 & 3)) * 64;
+	c[0][1] = (b[28] << 2 | (b[25] >> 4 & 3)) * 64;
+	c[1][0] = (b[29] << 2 | (b[25] >> 2 & 3)) * 64;
+	c[1][1] = (b[30] << 2 | (b[25] & 3)) * 64;
+	c[2][0] = (b[31] << 2 | (b[26] >> 6 & 3)) * 64;
+	c[2][1] = (b[32] << 2 | (b[26] >> 4 & 3)) * 64;
+}
+
+/*
+ * The primaries of the frames on a link: BT.2020 for PQ or a BT2020_RGB
+ * Colorspace (@bt2020), else per the sink (@wide).
+ */
+static inline u8 dcp_m4_ext_primaries(bool pq, bool bt2020, bool wide)
+{
+	if (pq || bt2020)
+		return DCP_M4_PRIMARIES_BT2020;
+	return wide ? DCP_M4_PRIMARIES_P3_D65 : DCP_M4_PRIMARIES_BT709;
+}
+
+static inline const char *dcp_m4_primaries_name(u8 primaries)
+{
+	switch (primaries) {
+	case DCP_M4_PRIMARIES_BT2020:
+		return "BT.2020";
+	case DCP_M4_PRIMARIES_P3_D65:
+		return "Display P3";
+	case DCP_M4_PRIMARIES_BT709:
+		return "BT.709 (sRGB)";
+	default:
+		return "unknown";
+	}
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-frame-test.c b/drivers/gpu/drm/apple/dcp-m4-frame-test.c
index e321765337..4861183329 100644
--- a/drivers/gpu/drm/apple/dcp-m4-frame-test.c
+++ b/drivers/gpu/drm/apple/dcp-m4-frame-test.c
@@ -185,6 +185,31 @@ static void frame_surface_colour_tags(struct kunit *test)
 	}
 }
 
+/* BT.709 on an SDR frame only: PQ and BT.2020 SDR keep BT.2020. */
+static void frame_surface_bt709_tag(struct kunit *test)
+{
+	static const struct { bool pq, bt2020, bt709; u8 prim, xfer; } t[] = {
+		{ false, false, true, 1, 13 }, { false, true, true, 9, 13 },
+		{ true, false, true, 9, 16 }, { false, false, false, 12, 13 },
+	};
+	u8 *s = kunit_kzalloc(test, DCP_M4_SURFACE_SIZE, GFP_KERNEL);
