From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 21:36:23 +0000
Subject: [PATCH] drm/asahi: g16: Optionally publish before the
 trailing polls

A poll pass woken by a firmware event busy-polls four more times, 5 us
apart, after its retirement loop, to catch receipts that complete just
after the event. Each of those rounds also drains the event ring, checks
for hangs and reads the oldest flight's receipt, so a pass that has
already retired a flight reaches publish() 40-50 us after it freed the
unit, with the device lock held. On render.light at depth 64
(experimental 1.1026) that span,
from the last retirement to publish(), measured 54.3 us with per-render
reports and 7.7 us without them (timer-driven passes, no trailing polls).

Add the runtime switch g16_tail_cut (default 0). When set, an evented
pass that has retired a flight ends its trailing polls at once and goes
on to publish into the freed unit; the next event or the completion
re-poll catches later receipts. Passes that retired nothing poll as
before. The passes cut and the polls skipped are printed as the
tailcut: stats line.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 19 +++++++++++++++++++
 drivers/gpu/drm/asahi/g16/poll.rs   | 27 +++++++++++++++++++++++++++
 2 files changed, 46 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 37f031e64a..81bb069645 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2012,6 +2012,25 @@ fn render_patch_parse_u32(text: &str) -> Option<u32> {
         },
     });
 
+/// Storage of `g16_tail_cut` (runtime 0644, default 0).
+static TAIL_CUT: AtomicU32 = AtomicU32::new(0);
+
+/// Whether a pass woken by a firmware event ends its four trailing 5 us busy polls as soon as
+/// it has retired a flight, so that the same pass publishes into the freed unit at once. The
+/// next event or the completion re-poll catches later receipts. 0: the polls as before.
+pub(crate) fn tail_cut() -> bool {
+    TAIL_CUT.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    TAIL_CUT_PARAM,
+    TAIL_CUT_PARMTYPE,
+    TAIL_CUT_PARM,
+    TAIL_CUT,
+    "g16_tail_cut",
+    "G16: 1: an evented pass that retired a flight skips its remaining trailing 5 us polls and publishes at once (default 0: as before; runtime 0644)"
+);
+
 /// Storage of `g16_tail_us` (runtime 0644, default 0).
 static TAIL_US: AtomicU32 = AtomicU32::new(0);
 
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 63c4d9dab4..2e1350bd3b 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -44,6 +44,23 @@
 pub(crate) const TAIL_WINDOW_NS: u64 = 300_000;
 /// End of the current `g16_tail_us` window (`now_ns()`), 0 for none.
 static TAIL_UNTIL_NS: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+/// `g16_tail_cut` counters: evented passes whose trailing polls ended at a retirement; the
+/// trailing 5 us polls so skipped.
+static TAILCUT_N: [core::sync::atomic::AtomicU64; 2] =
+    [const { core::sync::atomic::AtomicU64::new(0) }; 2];
+
+/// The `tailcut:` line of the stats file.
+fn tailcut_stats(f: &mut fmt::Formatter<'_>) -> fmt::Result {
+    let v = |i: usize| TAILCUT_N[i].load(Ordering::Relaxed);
+    writeln!(
+        f,
+        "tailcut: on {} passes {} polls_skipped {}",
+        u32::from(params::tail_cut()),
+        v(0),
+        v(1)
+    )
+}
+
 /// The tile-buffer words of the last render published, for the stats line `fswords:`: the
 /// FS record's tilebuffer control, tile mode and ISP control, the utile config, sample size
 /// and samples, ZLS control, PPP multisample control and the framebuffer size.
@@ -851,6 +868,7 @@ pub(crate) fn retire(&mut self, evented: bool, done: &mut Completions) -> Result
         }
         self.engine.stats.retire_src = if evented { 0 } else { 2 };
         let mut ret;
+        let mut freed = false;
 
         loop {
             let mut lap = Lap::start();
@@ -867,11 +885,19 @@ pub(crate) fn retire(&mut self, evented: bool, done: &mut Completions) -> Result
                 }
                 let outcome = self.retire_outcome(receipt);
                 self.retire_oldest(receipt, outcome, done);
+                freed = true;
                 ret = self.retired();
             }
             if ret.is_err() || tail == 0 || self.engine.flights.is_empty() {
                 break;
             }
+            // g16_tail_cut: this pass freed a unit; publish into it now instead of after the
+            // remaining trailing polls (the next event or the re-poll catches later receipts).
+            if freed && params::tail_cut() {
+                TAILCUT_N[0].fetch_add(1, Ordering::Relaxed);
+                TAILCUT_N[1].fetch_add(tail.max(0) as u64, Ordering::Relaxed);
+                break;
+            }
             tail -= 1;
             self.engine.stats.retire_src = 1;
             delay::udelay(Delta::from_micros(5));
@@ -1858,6 +1884,7 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
         writeln!(f)?;
         super::pools::write_size_stats(f)?;
         super::pools::write_lazy_stats(f)?;
+        tailcut_stats(f)?;
         let forms = &super::engine::FS_FORMS;
         writeln!(
             f,
-- 
