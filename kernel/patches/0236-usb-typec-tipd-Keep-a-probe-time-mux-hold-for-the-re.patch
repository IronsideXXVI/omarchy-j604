 	KUNIT_CASE(cd321x_reset_setup_retry_test),
diff --git a/drivers/usb/typec/tipd/cd321x-pm.h b/drivers/usb/typec/tipd/cd321x-pm.h
index 8260e559b0..18f586682f 100644
--- a/drivers/usb/typec/tipd/cd321x-pm.h
+++ b/drivers/usb/typec/tipd/cd321x-pm.h
@@ -314,11 +314,14 @@ static inline unsigned int cd321x_pm_mux_held(struct cd321x_pm_state *pm,
 		pm->attempts_left = 0;
 		return 0;
 	}
-	if (pm->phase == CD321X_PM_RUNNING)
-		pm->attempts_left = CD321X_RESUME_ATTEMPTS;
-	else
-		pm->attempts_left++;
-	pm->phase = CD321X_PM_REVALIDATE;
+	/* A probe-time SAFE timeout joins this series without enabling workers. */
+	if (pm->phase != CD321X_PM_INITIALIZING) {
+		if (pm->phase == CD321X_PM_RUNNING)
+			pm->attempts_left = CD321X_RESUME_ATTEMPTS;
+		else
+			pm->attempts_left++;
+		pm->phase = CD321X_PM_REVALIDATE;
+	}
 	pm->mux_retries++;
 	pm->mux_retry_ms = clamp(2 * pm->mux_retry_ms, CD321X_MUX_RETRY_MS,
 				 CD321X_MUX_RETRY_MAX_MS);
diff --git a/drivers/usb/typec/tipd/core.c b/drivers/usb/typec/tipd/core.c
index 979d99b923..33863b9203 100644
--- a/drivers/usb/typec/tipd/core.c
+++ b/drivers/usb/typec/tipd/core.c
@@ -963,10 +963,11 @@ static void cd321x_retry_held_mux(struct cd321x *cd321x)
 	if (!cd321x->pm.mux_retry_ms)
 		dev_info(cd321x->tps.dev, "Type-C mux held up, retrying\n");
 	delay = cd321x_pm_mux_held(&cd321x->pm, now_ms);
