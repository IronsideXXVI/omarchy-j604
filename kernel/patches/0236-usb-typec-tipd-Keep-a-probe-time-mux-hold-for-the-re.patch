+ assert(c.pm.phase==CD321X_PM_INITIALIZING&&c.pm.mux_retry_ms&&c.pm.force_reconnect);
+ assert(!c.resume_work.pending&&!c.update_work.pending&&cd321x_pm_ready(&c.pm));
