From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 02:39:15 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: let the DCP power its display
 domains down

Describe the internal display power-down resources for the J604, as
decc8256fe does for the J713, from the J604 Apple device tree (macOS
27.2 runtime, 

- dart-dcp clock-protection-slice-index 0x2a (42) and dart-disp0 8:
  apple,clock-protection on dcp_dart and disp0_dart;
- pmgr bwr-agent and boost-agent: DISP_INT is record 0 of both, with
  power state 0x35 (DISP_SYS): pmc_disp0 bits 0/0, named by the DCP's
  apple,pmc-interface;
- the three display power states are consumer-switched.

The retention workaround of disp_cpu is the J713 macOS capture:
0x2504c is a J604 ADT pmgr pwrgate-regs entry, but its bit values and
0x25070 are not yet seen on a J604 (TO-VERIFY). Everything here is used
only with appledrm.power_gate_ms set (default 0).

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../boot/dts/apple/t8132-j604-display.dtsi    | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi
index bf7a946aa3..17ce442a6d 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-display.dtsi
@@ -56,6 +56,8 @@
 		interrupts = <AIC_IRQ 678 IRQ_TYPE_LEVEL_HIGH>; /* DCP-DART-2 */
 		#iommu-cells = <1>;
 		apple,dma-range = <0x100 0x0 0x10 0x0>; /* DCP-DART-4, DCP-DART-5 */
+		/* J604 ADT dart-dcp clock-protection-slice-index 0x2a (macOS 27.2 runtime) */
+		apple,clock-protection = <&ps_prot 42>;
 	};
 
 	/* Display frontend DART: SID0 scanout, SID16 PIODMA. */
@@ -66,6 +68,8 @@
 		interrupts = <AIC_IRQ 678 IRQ_TYPE_LEVEL_HIGH>; /* DCP-DDART-3 */
 		#iommu-cells = <1>;
 		apple,dma-range = <0x100 0x0 0x10 0x0>; /* DCP-DDART-5, DCP-DDART-6 */
+		/* J604 ADT dart-disp0 clock-protection-slice-index 8 (macOS 27.2 runtime) */
+		apple,clock-protection = <&ps_prot 8>;
 		status = "disabled"; /* Enabled by the loader. */
 	};
 
@@ -84,6 +88,12 @@
 		mbox-names = "mbox";
 		iommus = <&dcp_dart 23>; /* DCP-12 */
 		power-domains = <&ps_disp_cpu>; /* DCP-17 */
+		/*
+		 * J604 ADT pmgr bwr-agent/boost-agent: DISP_INT is bit 0 of both
+		 * (record index), its power state 0x35 = DISP_SYS. Used only with
+		 * appledrm.power_gate_ms set (default 0).
+		 */
+		apple,pmc-interface = <&pmc_disp0>;
 		dma-noncoherent;
 		apple,j713-native-piodma; /* DCPEN-OPT-1 */
 		apple,j713-native-scanout; /* DCPEN-OPT-2 */
@@ -116,15 +126,29 @@
  * over: Linux registers them but never writes them (t8132-j713-pmgr.dtsi
  * policy for these three). The boot framebuffer keeps its own domains.
  */
+/*
+ * The DCP powers these three down while the display is blanked, only with
+ * appledrm.power_gate_ms set (default 0: never).
+ */
 &ps_disp_sys {
 	apple,firmware-owned; /* DCPEN-PD-1 */
+	apple,consumer-switched;
 };
 
 &ps_disp_fe {
 	apple,firmware-owned; /* DCPEN-PD-2 */
+	apple,consumer-switched;
 };
 
 &ps_disp_cpu {
 	status = "okay"; /* DCPEN-PD-3 */
 	apple,firmware-owned;
+	apple,consumer-switched;
+	/*
+	 * Power-gate retention workaround as macOS sets it while off.
+	 * 0x2504c is a J604 ADT pmgr pwrgate-regs entry (block 0); the bit
+	 * values and 0x25070 are the J713 macOS capture: TO-VERIFY on J604
+	 * (read both registers under macOS 27.2 during display sleep).
+	 */
+	apple,retention-workaround = <0x2504c 0x3 0x3>, <0x25070 0x1 0x0>;
 };
