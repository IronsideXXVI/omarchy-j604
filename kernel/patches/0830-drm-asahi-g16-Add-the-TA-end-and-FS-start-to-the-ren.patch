From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 20:53:18 +0000
Subject: [PATCH] drm/asahi: g16: Add the TA end and FS start to the
 render flight trace

The flight trace keeps each render's TA start and FS end, so the time
between them cannot be split into the TA, the wait of the FS for its
own TA and the FS itself.

Keep the TA end and FS start stage stamps as well and print them as
ta_end and fs_start on each ftrace: line. Also move the stats file's
doc comment back onto stats_show, which the trace function had taken
over.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/poll.rs | 37 ++++++++++++++++++++-----------
 1 file changed, 24 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index cf2f216e1d..9e8edf7e21 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -64,11 +64,11 @@
 static RENDER_PREV_READ: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
 
 /// Entries of the render flight trace (g16_prof): the last [`FLIGHT_TRACE_N`] retired
-/// render flights, each publication, TA start, FS end, completion event, lock and retirement
-/// time on the architectural counter (0 when not seen).
+/// render flights, each publication, TA start, FS end, completion event, lock, retirement,
+/// TA end and FS start time on the architectural counter (0 when not seen).
 const FLIGHT_TRACE_N: usize = 32;
-static FLIGHT_TRACE: [[core::sync::atomic::AtomicU64; 6]; FLIGHT_TRACE_N] =
-    [const { [const { core::sync::atomic::AtomicU64::new(0) }; 6] }; FLIGHT_TRACE_N];
+static FLIGHT_TRACE: [[core::sync::atomic::AtomicU64; 8]; FLIGHT_TRACE_N] =
+    [const { [const { core::sync::atomic::AtomicU64::new(0) }; 8] }; FLIGHT_TRACE_N];
 static FLIGHT_TRACE_HEAD: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
 /// Renders published behind renders they wait on with no wait record (`g16_same_queue_nowait`).
 pub(crate) static RENDER_NOWAIT: core::sync::atomic::AtomicU64 =
@@ -270,10 +270,9 @@ fn fwpower_show(v: &FwPower, f: &mut fmt::Formatter<'_>) -> fmt::Result {
     )
 }
 
-/// The `aurora-g16/stats` debugfs file contents.
 /// The `ftrace:` lines of the stats file, oldest first: per retired render flight, the times
-/// in ns of TA start, FS end, completion event, lock and retirement after its publication, and
-/// its publication after the previous traced flight's.
+/// in ns of TA start, TA end, FS start, FS end, completion event, lock and retirement after its
+/// publication, and its publication after the previous traced flight's.
 fn write_flight_trace(f: &mut fmt::Formatter<'_>) -> fmt::Result {
     let freq = super::engine::counter_hz();
     if freq == 0 {
@@ -284,16 +283,18 @@ fn write_flight_trace(f: &mut fmt::Formatter<'_>) -> fmt::Result {
     let mut prev = 0;
     for i in 0..FLIGHT_TRACE_N {
         let e = &FLIGHT_TRACE[(head + i) % FLIGHT_TRACE_N];
-        let v: [u64; 6] = core::array::from_fn(|k| e[k].load(Ordering::Relaxed));
+        let v: [u64; 8] = core::array::from_fn(|k| e[k].load(Ordering::Relaxed));
         if v[0] == 0 {
             continue;
         }
         let after = |t: u64| if t >= v[0] { ns(t - v[0]) } else { 0 };
         writeln!(
             f,
-            "ftrace: pub_gap {} start {} end {} event {} lock {} retire {}",
+            "ftrace: pub_gap {} start {} ta_end {} fs_start {} end {} event {} lock {} retire {}",
             if prev != 0 && v[0] >= prev { ns(v[0] - prev) } else { 0 },
             after(v[1]),
+            after(v[6]),
+            after(v[7]),
             after(v[2]),
             after(v[3]),
             after(v[4]),
@@ -304,6 +305,7 @@ fn write_flight_trace(f: &mut fmt::Formatter<'_>) -> fmt::Result {
     Ok(())
 }
 
+/// The `aurora-g16/stats` debugfs file contents.
 fn stats_show(shared: &Arc<Shared>, f: &mut fmt::Formatter<'_>) -> fmt::Result {
     let state = shared.state.lock();
     match state.as_deref() {
@@ -1515,10 +1517,19 @@ fn stat_retire(&mut self, f: &Flight) {
                     let slot = (FLIGHT_TRACE_HEAD.fetch_add(1, Ordering::Relaxed) as usize)
                         % FLIGHT_TRACE_N;
                     let ev_seen = if hi_c <= ev { ev } else { 0 };
-                    for (cell, v) in FLIGHT_TRACE[slot]
-                        .iter()
-                        .zip([f.published_ticks, lo_c, hi_c, ev_seen, locked, now_ticks])
-                    {
+                    // TA end and FS start of this flight's stage stamps (qse: 0 TA, 1 FS).
+                    let ta_end = if qse[0].1 != 0 { to_counter(qse[0].1) } else { 0 };
+                    let fs_start = if qse[1].0 != u64::MAX { to_counter(qse[1].0) } else { 0 };
+                    for (cell, v) in FLIGHT_TRACE[slot].iter().zip([
+                        f.published_ticks,
+                        lo_c,
+                        hi_c,
+                        ev_seen,
+                        locked,
+                        now_ticks,
+                        ta_end,
+                        fs_start,
+                    ]) {
                         cell.store(v, Ordering::Relaxed);
                     }
                 }
-- 
