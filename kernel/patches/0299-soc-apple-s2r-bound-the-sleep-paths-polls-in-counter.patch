From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 03:58:08 +0000
Subject: [PATCH] soc: apple: s2r: bound the sleep paths' polls in
 counter time, and split with every coprocessor stopped

The sleep paths poll blocks that are going down or coming up, with
readl_poll_timeout_atomic(), which bounds a poll by the number of reads
times its step. A block that answers each read slowly stretches a 50 ms
bound into minutes, which ends at the watchdog and not at the error the
poll would return. Bound every poll of this driver by the arch counter
instead: it runs with interrupts off and timekeeping suspended, and the
read that ends a poll at its deadline is still judged.

The split step stops ANS alone, so every other coprocessor (the display
controllers, SIO, PMP, the GPU, ISP, AOP) keeps running while ATC0, the
APCIe block and ANS go down and come back under it, unlike a real sleep.
split_depth 8 stops all of them first, as a real sleep does, then runs
the whole lowering and the raise; they stay stopped until a reboot.

Only the T8132 sequence's bring-up runs reach either change in a sleep;
split_depth is 0 by default.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/apple-s2r.c | 116 +++++++++++++++++++++++-----------
 1 file changed, 78 insertions(+), 38 deletions(-)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index db6e019836..dbf1ac2afe 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -113,6 +113,7 @@
 #include <asm/apple_cpu.h>
 #include <asm/memory.h>
 #include <asm/sections.h>
+#include <asm/arch_timer.h>
 #include <asm/smp_plat.h>
 #include <asm/suspend.h>
 #include <asm/sysreg.h>
@@ -120,6 +121,38 @@
 
 #include "apple-s2r.h"
 
+/*
+ * s2r_poll_atomic() with its bound in counter time, not in reads:
+ * the sleep paths poll blocks that are going down or coming up, and a read
+ * of one can take far longer than the poll's step, which would stretch a
+ * 50 ms bound into minutes. The arch counter runs with interrupts off and
+ * timekeeping suspended. The counter is read before the register, so the
+ * read that ends a poll at its deadline is still judged by the condition.
+ */
+#define s2r_poll_atomic(addr, val, cond, delay_us, timeout_us)			\
+({									\
+	void __iomem *__s2r_addr = (addr);				\
+	unsigned long __s2r_delay = (delay_us);				\
+	u64 __s2r_end = __arch_counter_get_cntvct() +			\
+		(u64)(timeout_us) * (read_sysreg(cntfrq_el0) / USEC_PER_SEC);	\
+	int __s2r_ret;							\
+	for (;;) {							\
+		u64 __s2r_now = __arch_counter_get_cntvct();		\
+		(val) = readl(__s2r_addr);				\
+		if (cond) {						\
+			__s2r_ret = 0;					\
+			break;						\
+		}							\
+		if (__s2r_now > __s2r_end) {				\
+			__s2r_ret = -ETIMEDOUT;				\
+			break;						\
+		}							\
+		if (__s2r_delay)					\
+			udelay(__s2r_delay);				\
+	}								\
+	__s2r_ret;							\
+})
+
 /*
  * T8132 sequence: register layouts and values, SOURCE (Aurora's
  * drivers/soc/apple/sleep.c, aurora-silicon/linux#1314, from macOS's sleep
@@ -1028,7 +1061,7 @@ MODULE_PARM_DESC(debug_begin_as_idle, "Bring-up: do not declare a suspend-to-RAM
 
 static uint split_depth;
 module_param(split_depth, uint, 0644);
-MODULE_PARM_DESC(split_depth, "For bring-up, with t8132_sequence and abort_before=16 (the split step): how much of the IO lowering runs before it is raised again: 1 ANS stopped only, 2 + ATC0, 3 + APCIe root ports stopped, 4 + APCIe PHY, 5 + APCIe clock and system domains, 6 + AXI enables and GP, 7 + the ANS domain; 0 is all of it (default: 0)");
+MODULE_PARM_DESC(split_depth, "For bring-up, with t8132_sequence and abort_before=16 (the split step): how much of the IO lowering runs before it is raised again: 1 ANS stopped only, 2 + ATC0, 3 + APCIe root ports stopped, 4 + APCIe PHY, 5 + APCIe clock and system domains, 6 + AXI enables and GP, 7 + the ANS domain, 8 all of it with every coprocessor stopped first as in a real sleep (they stay stopped until a reboot); 0 is all of it (default: 0)");
 
 static bool t8132_time_trail;
 module_param(t8132_time_trail, bool, 0644);
@@ -1521,10 +1554,10 @@ static int apple_s2r_t8132_perf_wait(void __iomem *reg, unsigned int state)
 {
 	u32 val;
 
-	return readl_poll_timeout_atomic(reg, val,
-					 (val & (T8132_DCS_BUSY | T8132_DCS_STATE)) ==
-					 FIELD_PREP(T8132_DCS_STATE, state),
-					 1, T8132_DCS_TIMEOUT_US);
+	return s2r_poll_atomic(reg, val,
+			       (val & (T8132_DCS_BUSY | T8132_DCS_STATE)) ==
+			       FIELD_PREP(T8132_DCS_STATE, state),
+			       1, T8132_DCS_TIMEOUT_US);
 }
 
 static bool apple_s2r_t8132_ps_on(struct apple_s2r *s2r, u32 offset)
@@ -1551,8 +1584,8 @@ static int apple_s2r_t8132_ps_raise_start(void __iomem *reg)
 
 	writel((readl(reg) & ~(T8132_PS_AUTO_ENABLE | GENMASK(11, 0))) | T8132_PS_TARGET, reg);
 
-	return readl_poll_timeout_atomic(reg, now, (now & T8132_PS_ACTUAL) == T8132_PS_ACTUAL,
-					 1, T8132_PS_TIMEOUT_US);
+	return s2r_poll_atomic(reg, now, (now & T8132_PS_ACTUAL) == T8132_PS_ACTUAL,
+			       1, T8132_PS_TIMEOUT_US);
 }
 
 static void apple_s2r_t8132_ps_raise(void __iomem *reg)
@@ -1566,8 +1599,8 @@ static int apple_s2r_t8132_ps_wait_off(void __iomem *reg)
 {
 	u32 val;
 
-	return readl_poll_timeout_atomic(reg, val, !FIELD_GET(T8132_PS_ACTUAL, val), 10,
-					 T8132_PS_TIMEOUT_US);
+	return s2r_poll_atomic(reg, val, !FIELD_GET(T8132_PS_ACTUAL, val), 10,
+			       T8132_PS_TIMEOUT_US);
 }
 
 /*
@@ -1590,10 +1623,10 @@ static int apple_s2r_t8132_ps_restore(void __iomem *reg, u32 saved)
 	}
 
 	writel(keep, reg);
-	ret = readl_poll_timeout_atomic(reg, now,
-					FIELD_GET(T8132_PS_ACTUAL, now) ==
-					FIELD_GET(T8132_PS_TARGET, saved),
-					1, T8132_PS_TIMEOUT_US);
+	ret = s2r_poll_atomic(reg, now,
+			      FIELD_GET(T8132_PS_ACTUAL, now) ==
+			      FIELD_GET(T8132_PS_TARGET, saved),
+			      1, T8132_PS_TIMEOUT_US);
 	if (saved & T8132_PS_AUTO_ENABLE)
 		writel(keep | T8132_PS_AUTO_ENABLE, reg);
 
@@ -1812,9 +1845,9 @@ static void apple_s2r_t8132_match(struct apple_s2r *s2r)
 			continue;
 		writel((val & ~(T8132_PS_AUTO_ENABLE | GENMASK(11, 0))) | T8132_PS_AON_ON_STATE,
 		       reg);
-		readl_poll_timeout_atomic(reg, now,
-					  FIELD_GET(T8132_PS_ACTUAL, now) == T8132_PS_AON_ON_STATE,
-					  1, T8132_PS_TIMEOUT_US);
+		s2r_poll_atomic(reg, now,
+				FIELD_GET(T8132_PS_ACTUAL, now) == T8132_PS_AON_ON_STATE,
+				1, T8132_PS_TIMEOUT_US);
 	}
 	t->matched = true;
 
@@ -1898,8 +1931,8 @@ static bool apple_s2r_t8132_ps_wait_on(void __iomem *reg, u32 val)
 	if (!FIELD_GET(T8132_PS_TARGET, val))
 		return false;
 
-	return !readl_poll_timeout_atomic(reg, val, FIELD_GET(T8132_PS_ACTUAL, val), 1,
-					  T8132_PS_TIMEOUT_US);
+	return !s2r_poll_atomic(reg, val, FIELD_GET(T8132_PS_ACTUAL, val), 1,
+				T8132_PS_TIMEOUT_US);
 }
 
 static int apple_s2r_t8132_ps_raise_full(void __iomem *reg)
@@ -1937,8 +1970,8 @@ static int apple_s2r_t8132_port_stop(struct apple_s2r *s2r, int i)
 	if (readl(port + APCIE_PORT_LINKSTS) & APCIE_PORT_LINKSTS_UP) {
 		writel(APCIE_PORT_L2_ENTER, port + APCIE_PORT_L2);
 		/* An endpoint with no driver (removed before the sleep) may never answer. */
-		if (readl_poll_timeout_atomic(port + APCIE_PORT_L2, val,
-					      !(val & APCIE_PORT_L2_BUSY), 10, APCIE_PORT_STOP_US))
+		if (s2r_poll_atomic(port + APCIE_PORT_L2, val,
+				    !(val & APCIE_PORT_L2_BUSY), 10, APCIE_PORT_STOP_US))
 			t->l2_timeouts++;
 	}
 	/* The endpoint keeps its power and firmware, in reset until its host releases it. */
@@ -1962,8 +1995,8 @@ static int apple_s2r_t8132_port_stop(struct apple_s2r *s2r, int i)
 	writel(readl(phy) & ~APCIE_PORT_PHY_EN0, phy);
 	writel(readl(phy) | APCIE_PHY_CTRL_RESET, phy);
 	writel(readl(phy) & ~APCIE_PHY_CTRL_CLK0REQ, phy);
-	ret = readl_poll_timeout_atomic(phy, val, !(val & APCIE_PHY_CTRL_CLK0ACK), 1,
-					APCIE_POLL_US);
+	ret = s2r_poll_atomic(phy, val, !(val & APCIE_PHY_CTRL_CLK0ACK), 1,
+			      APCIE_POLL_US);
 	writel(readl(phy) & ~APCIE_PHY_CTRL_CLK1REQ, phy);
 
 	writel(readl(port + APCIE_PORT_APPCLK) & ~APCIE_PORT_APPCLK_EN, port + APCIE_PORT_APPCLK);
@@ -2003,11 +2036,11 @@ static int apple_s2r_t8132_apcie_phy_off(struct apple_s2r_t8132 *t)
 
 	writel(readl(ctrl) | APCIE_PHY_CTRL_RESET, ctrl);
 	writel(readl(ctrl) & ~APCIE_PHY_CTRL_CLK1REQ, ctrl);
-	ret = readl_poll_timeout_atomic(ctrl, val, !(val & APCIE_PHY_CTRL_CLK1ACK), 1,
-					APCIE_POLL_US);
+	ret = s2r_poll_atomic(ctrl, val, !(val & APCIE_PHY_CTRL_CLK1ACK), 1,
+			      APCIE_POLL_US);
 	writel(readl(ctrl) & ~APCIE_PHY_CTRL_CLK0REQ, ctrl);
-	ret |= readl_poll_timeout_atomic(ctrl, val, !(val & APCIE_PHY_CTRL_CLK0ACK), 1,
-					 APCIE_POLL_US);
+	ret |= s2r_poll_atomic(ctrl, val, !(val & APCIE_PHY_CTRL_CLK0ACK), 1,
+			       APCIE_POLL_US);
 	writel(readl(ctrl) & ~APCIE_PHY_CTRL_UP, ctrl);
 	writel(readl(run) & ~APCIE_PHY_RUN_EN2, run);
 	writel(readl(run) & ~APCIE_PHY_RUN_EN, run);
@@ -2023,7 +2056,7 @@ static int apple_s2r_t8132_apcie_clk_off(struct apple_s2r_t8132 *t)
 
 	writel(readl(clk) & ~APCIE_CLK_RUN, clk);
 	writel(readl(clk) | APCIE_CLK_OFF, clk);
-	ret = readl_poll_timeout_atomic(clk, val, !(val & APCIE_CLK_BUSY), 1, APCIE_POLL_US);
+	ret = s2r_poll_atomic(clk, val, !(val & APCIE_CLK_BUSY), 1, APCIE_POLL_US);
 	writel(readl(clk) | APCIE_CLK_OFF2, clk);
 
 	return ret;
@@ -2140,8 +2173,8 @@ static int apple_s2r_t8132_raise_apcie(struct apple_s2r *s2r)
 	/* Both off bits: the lowering sets them, and only a power-off clears OFF. */
 	writel(readl(t->apcie_clkgen + APCIE_CLK_CTRL) & ~(APCIE_CLK_OFF2 | APCIE_CLK_OFF),
 	       t->apcie_clkgen + APCIE_CLK_CTRL);
-	ret = readl_poll_timeout_atomic(t->apcie_clkgen + APCIE_CLK_CTRL, val,
-					!(val & APCIE_CLK_BUSY), 1, APCIE_POLL_US);
+	ret = s2r_poll_atomic(t->apcie_clkgen + APCIE_CLK_CTRL, val,
+			      !(val & APCIE_CLK_BUSY), 1, APCIE_POLL_US);
 	if (ret)
 		return ret;
 
@@ -2151,11 +2184,11 @@ static int apple_s2r_t8132_raise_apcie(struct apple_s2r *s2r)
 
 	apple_tunable_apply(t->apcie_phy, t->apcie_phy_tunable);
 	writel(readl(ctrl) | APCIE_PHY_CTRL_CLK0REQ, ctrl);
-	ret = readl_poll_timeout_atomic(ctrl, val, val & APCIE_PHY_CTRL_CLK0ACK, 1, APCIE_POLL_US);
+	ret = s2r_poll_atomic(ctrl, val, val & APCIE_PHY_CTRL_CLK0ACK, 1, APCIE_POLL_US);
 	if (ret)
 		return ret;
 	writel(readl(ctrl) | APCIE_PHY_CTRL_CLK1REQ, ctrl);
-	ret = readl_poll_timeout_atomic(ctrl, val, val & APCIE_PHY_CTRL_CLK1ACK, 1, APCIE_POLL_US);
+	ret = s2r_poll_atomic(ctrl, val, val & APCIE_PHY_CTRL_CLK1ACK, 1, APCIE_POLL_US);
 	if (ret)
 		return ret;
 	writel(readl(ctrl) & ~APCIE_PHY_CTRL_RESET, ctrl);
@@ -2167,8 +2200,8 @@ static int apple_s2r_t8132_raise_apcie(struct apple_s2r *s2r)
 	writel(readl(t->apcie_phy_ip + APCIE_PHY_IP_PLL_CTL) & ~APCIE_PHY_IP_PLL_HOLD,
 	       t->apcie_phy_ip + APCIE_PHY_IP_PLL_CTL);
 	writel(readl(run) | APCIE_PHY_RUN_EN2, run);
-	ret = readl_poll_timeout_atomic(t->apcie_phy + APCIE_PHY_READY, val, val & BIT(0), 1,
-					APCIE_POLL_US);
+	ret = s2r_poll_atomic(t->apcie_phy + APCIE_PHY_READY, val, val & BIT(0), 1,
+			      APCIE_POLL_US);
 	if (ret)
 		return ret;
 	writel(readl(t->apcie_phy + APCIE_PHY_COMMON) | BIT(0), t->apcie_phy + APCIE_PHY_COMMON);
@@ -2178,8 +2211,8 @@ static int apple_s2r_t8132_raise_apcie(struct apple_s2r *s2r)
 	writel(0x140, t->apcie_rc + APCIE_RC_READY_CFG);
 	writel(1, t->apcie_rc + APCIE_RC_READY_START);
 
-	return readl_poll_timeout_atomic(t->apcie_rc + APCIE_RC_READY_STAT, val, val & BIT(0), 1,
-					 APCIE_POLL_US);
+	return s2r_poll_atomic(t->apcie_rc + APCIE_RC_READY_STAT, val, val & BIT(0), 1,
+			       APCIE_POLL_US);
 }
 
 /**
@@ -2636,9 +2669,9 @@ static void apple_s2r_t8132_return(struct apple_s2r *s2r)
 	t->stop_read |= BIT(2);
 
 	writel(T8132_CLUSTER_ON, t->cluster + T8132_CLUSTER_E);
-	t->cluster_e_ret = readl_poll_timeout_atomic(t->cluster + T8132_CLUSTER_E, val,
-						     val & T8132_CLUSTER_E_READY, 1,
-						     T8132_CLUSTER_TIMEOUT_US);
+	t->cluster_e_ret = s2r_poll_atomic(t->cluster + T8132_CLUSTER_E, val,
+					   val & T8132_CLUSTER_E_READY, 1,
+					   T8132_CLUSTER_TIMEOUT_US);
 	writel(T8132_CLUSTER_ON, t->cluster + T8132_CLUSTER_P);
 	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_BACK_CLUSTERS);
 
@@ -3125,6 +3158,13 @@ static int apple_s2r_enter(suspend_state_t state)
 		apple_s2r_crumb(s2r, S2R_CRUMB_COPROCS_FIRST);
 		apple_s2r_coprocs_stop(false);
 		apple_s2r_crumb(s2r, S2R_CRUMB_COPROCS_LAST);
+	} else if (t8132_sequence && READ_ONCE(abort_before) == S2R_STEP_T8132_RAISE &&
+		   READ_ONCE(split_depth) == 8) {
+		/* The real sleep's condition: no coprocessor runs while the IO goes down. */
+		apple_s2r_coprocs_stop(true);
+		apple_s2r_crumb(s2r, S2R_CRUMB_COPROCS_FIRST);
+		apple_s2r_coprocs_stop(false);
+		apple_s2r_crumb(s2r, S2R_CRUMB_COPROCS_LAST);
 	} else if (t8132_sequence && READ_ONCE(abort_before) == S2R_STEP_T8132_RAISE) {
 		apple_s2r_coprocs_stop_ans();
 		apple_s2r_crumb(s2r, S2R_CRUMB_COPROCS_LAST);
