@@ -0,0 +1,422 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! `g16_render_fs_run`: FS ordering once per firmware run, as pure rules.
+//!
+//! Every render writes a Stamp barrier on the FS ring ahead of its FS work. The barrier holds
+//! the FS queue until the TA stamp (`fw_stamp[0]`, written when the render's TA finishes)
+//! reaches the render's own target, so no FS starts before its TA. On this firmware the
+//! barrier is required: without it an FS has started before its own TA ended. macOS's render
+//! queues carry no barrier work at all; its firmware orders the pair itself.
+//!
+//! With the switch on, a render published behind at least one firmware run of FS work that is
+//! already exposed and not finished joins a batch of at most one run (`RUN`). The first render
+//! of the batch writes its barrier entry and its FS work; the later ones write only their FS
+//! work. The FS WRITE cursor, the FS submit record and the FS doorbell wait for the end of the
+//! pass, and the opening barrier is then re-encoded to wait for the newest render's target.
+//! Targets rise with the draw ordinal and the TA ring is consumed in order, so when the barrier
+//! passes, the TA of every render in the batch has finished.
+//!
+//! Both costs of a batch, the later exposure and the wait for the newest TA, are hidden only
+//! while older FS work is still queued. A render that finds less than one run of FS work ahead
+//! first exposes any open batch and then publishes with its own barrier, record and doorbell,
+//! so a shallow queue keeps the per-render form and gains no wait.
+
+use core::sync::atomic::AtomicU64;
+
+/// Renders per firmware run (class-2 limit of 8 TA and FS starts, 25G83 0x595c8).
+pub(crate) const RUN: u32 = 4;
+
+/// The open batch: renders whose FS entries are written but not yet exposed.
+#[derive(Default, Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Batch {
+    /// Renders in the batch; 0 = no batch open.
+    pub(crate) renders: u32,
+    /// FS ring index of the batch's one barrier entry.
+    pub(crate) slot: u32,
+    /// FS ring head after the newest FS work entry.
+    pub(crate) head: u32,
+    /// Own stamp value of the opening render (the barrier's `own` field).
+    pub(crate) own: u32,
+    /// Target of the newest render: the wait value of the batch's barrier.
+    pub(crate) wait: u32,
+}
+
+impl Batch {
+    /// Whether a batch is open.
+    pub(crate) fn is_open(&self) -> bool {
+        self.renders != 0
+    }
+
+    /// The FS ring head the next entry is written at while a batch is open (the FS WRITE
+    /// cursor is stale until the flush).
+    pub(crate) fn join_head(&self) -> Option<u32> {
+        if self.is_open() {
+            Some(self.head)
+        } else {
+            None
+        }
+    }
+
+    /// Notes a render published into the batch: the FS ring head before (`start`) and after
+    /// (`head`) its entries, and its TA stamp target.
+    pub(crate) fn note(&mut self, start: u32, head: u32, target: u32) {
+        if self.renders == 0 {
+            self.slot = start;
+            self.own = target;
+        }
+        self.renders = self.renders.saturating_add(1);
+        self.head = head;
+        self.wait = target;
+    }
+
+    /// Closes the batch and returns it, if one was open.
+    pub(crate) fn take(&mut self) -> Option<Batch> {
+        if self.is_open() {
+            Some(core::mem::take(self))
+        } else {
+            None
+        }
+    }
+}
+
+/// Most renders in one batch for switch value `word`: 0 = off; otherwise one firmware run.
+pub(crate) fn cap(word: u32) -> u32 {
+    if word == 0 {
+        0
+    } else {
+        RUN
+    }
+}
+
+/// Whether a render publication defers its FS record into the batch: the switch is on, the
+/// render goes behind running flights, both render queues are registered (no registering
+/// first record), each pipe has its own doorbell (`g16_onebell` 0) and the FS barrier is in
+/// use (`g16_render_quiet` below 2).
+pub(crate) fn defer(word: u32, ahead: bool, registered: bool, onebell: u32, quiet: u32) -> bool {
+    cap(word) != 0 && ahead && registered && onebell == 0 && quiet < 2
+}
+
+/// Whether the open batch must be exposed before the next render: it is open and either that
+/// render does not defer or the batch holds `cap(word)` renders.
+pub(crate) fn flush_first(b: &Batch, defer: bool, word: u32) -> bool {
+    b.is_open() && (!defer || b.renders >= cap(word))
+}
+
+/// `g16_render_fs_run`: renders behind running flights that found a run of FS work ahead
+/// (they batch), and those that did not (they publish with their own barrier, record and
+/// doorbell).
+pub(crate) static AHEAD_N: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+
+/// Exposed renders with FS work queued at each decision: 0, 1, 2, 3-4, 5-8, 9 and more.
+pub(crate) static AHEAD_HIST: [AtomicU64; 6] = [const { AtomicU64::new(0) }; 6];
+
+/// Exposed renders whose FS has not finished: the `unfinished` render flights (FS stamp below
+/// their target) less the `batched` ones still held in the open batch.
+pub(crate) fn queued(unfinished: u32, batched: u32) -> u32 {
+    unfinished.saturating_sub(batched)
+}
+
+/// Whether a render may join or open a batch: only with at least one run of exposed renders'
+/// FS work still queued ahead of it. With the FS queue drained, the batch's pass-end exposure
+/// and its wait for the newest render's TA would idle the FS.
+pub(crate) fn ahead_ok(queued: u32) -> bool {
+    queued >= RUN
+}
+
+/// Histogram slot of `n` exposed renders with FS queued.
+pub(crate) fn ahead_slot(n: u32) -> usize {
+    match n {
+        0 => 0,
+        1 => 1,
+        2 => 2,
+        3..=4 => 3,
+        5..=8 => 4,
+        _ => 5,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const CAP: u32 = 256;
+    const STEP: u32 = 0x100;
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    enum Entry {
+        Barrier(u32),
+        Fs(u32),
+    }
+
+    /// Writes `n` renders (targets `t0`, `t0 + STEP`, ...) from FS ring head `start`, as the
+    /// engine does; `wrong` keeps the opening render's target as the batch wait. Returns the
+    /// FS WRITE cursor at the end of the pass.
+    fn publish(
+        batch: bool,
+        wrong: bool,
+        start: u32,
+        t0: u32,
+        n: u32,
+        ring: &mut [Option<Entry>],
+    ) -> u32 {
+        publish_cap(u32::from(batch), wrong, start, t0, n, ring)
+    }
+
+    fn close(b: &mut Batch, wrong: bool, ring: &mut [Option<Entry>]) {
+        if let Some(t) = b.take() {
+            let wait = if wrong { t.own } else { t.wait };
+            ring[t.slot as usize] = Some(Entry::Barrier(wait));
+        }
+    }
+
+    /// As the engine with switch value `word` (0 = per-render barriers): a full batch is
+    /// exposed before the next render opens a new one.
+    fn publish_cap(
+        word: u32,
+        wrong: bool,
+        start: u32,
+        t0: u32,
+        n: u32,
+        ring: &mut [Option<Entry>],
+    ) -> u32 {
+        let batch = cap(word) != 0;
+        let mut b = Batch::default();
+        let mut head = start;
+        for i in 0..n {
+            let target = t0 + STEP * i;
+            if flush_first(&b, batch, word) {
+                close(&mut b, wrong, ring);
+            }
+            let s = if batch {
+                b.join_head().unwrap_or(head)
+            } else {
+                head
+            };
+            let mut h = s;
+            if !(batch && b.is_open()) {
+                ring[h as usize] = Some(Entry::Barrier(target));
+                h = (h + 1) % CAP;
+            }
+            ring[h as usize] = Some(Entry::Fs(target));
+            h = (h + 1) % CAP;
+            if batch {
+                b.note(s, h, target);
+            }
+            head = h;
+        }
+        if batch {
+            assert_eq!(b.head, head);
+            assert_eq!(b.renders, (n - 1) % cap(word) + 1);
+        }
+        close(&mut b, wrong, ring);
+        assert!(!b.is_open());
+        head
+    }
+
+    /// Firmware model: the TAs finish in ring order, one per step, each raising the TA stamp
+    /// to its target; between steps the FS queue consumes entries up to WRITE, a barrier
+    /// holding while the stamp is below its wait. False if an FS is consumed before its TA
+    /// finished, or the queue never drains.
+    fn run(ring: &[Option<Entry>], start: u32, write: u32, t0: u32, n: u32) -> bool {
+        let mut stamp = t0 - STEP;
+        let mut read = start;
+        for done in 0..=n {
+            if done > 0 {
+                stamp = t0 + STEP * (done - 1);
+            }
+            while read != write {
+                match ring[read as usize] {
+                    Some(Entry::Barrier(w)) if stamp < w => break,
+                    Some(Entry::Barrier(_)) => {}
+                    Some(Entry::Fs(t)) if stamp < t => return false,
+                    Some(Entry::Fs(_)) => {}
+                    None => return false,
+                }
+                read = (read + 1) % CAP;
+            }
+        }
+        read == write
+    }
+
+    fn entries(start: u32, write: u32) -> u32 {
+        write.wrapping_add(CAP).wrapping_sub(start) % CAP
+    }
+
+    #[test]
+    fn per_render_barriers_order_every_fs() {
+        for &start in &[0, 100, 250] {
+            for n in 1..=8 {
+                let mut ring = [None; CAP as usize];
+                let w = publish(false, false, start, 5 * STEP, n, &mut ring);
+                assert_eq!(entries(start, w), 2 * n);
+                assert!(run(&ring, start, w, 5 * STEP, n));
+            }
+        }
+    }
+
+    #[test]
+    fn batch_orders_every_fs_behind_its_ta() {
+        for &start in &[0, 100, 250, 255] {
+            for n in 1..=RUN {
+                let mut ring = [None; CAP as usize];
+                let w = publish(true, false, start, 5 * STEP, n, &mut ring);
+                assert_eq!(entries(start, w), n + 1);
+                assert_eq!(
+                    ring[start as usize],
+                    Some(Entry::Barrier(5 * STEP + STEP * (n - 1)))
+                );
+                assert!(run(&ring, start, w, 5 * STEP, n));
+            }
+        }
+    }
+
+    #[test]
+    fn capped_batches_order_every_fs_and_cost_one_barrier_per_cap() {
+        for word in [1, 2, 99] {
+            let k = cap(word);
+            for &start in &[0, 250] {
+                for n in 1..=24 {
+                    let mut ring = [None; CAP as usize];
+                    let w = publish_cap(word, false, start, 5 * STEP, n, &mut ring);
+                    assert_eq!(entries(start, w), n + n.div_ceil(k));
+                    assert!(run(&ring, start, w, 5 * STEP, n));
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn a_run_of_queued_fs_gates_the_batch() {
+        // A drained or shallow FS queue publishes at once; a run of queued FS work batches.
+        for q in 0..RUN {
+            assert!(!ahead_ok(q));
+        }
+        assert!(ahead_ok(RUN));
+        assert!(ahead_ok(7));
+        // Renders held in the open batch are not queued at the FS yet.
+        assert_eq!(queued(5, 2), 3);
+        assert_eq!(queued(1, 3), 0);
+        assert_eq!(ahead_slot(0), 0);
+        assert_eq!(ahead_slot(2), 2);
+        assert_eq!(ahead_slot(4), 3);
+        assert_eq!(ahead_slot(8), 4);
+        assert_eq!(ahead_slot(9), 5);
+    }
+
+    #[test]
+    fn cap_values() {
+        assert_eq!(
+            (cap(0), cap(1), cap(2), cap(16), cap(99)),
+            (0, RUN, RUN, RUN, RUN)
+        );
+        let mut b = Batch::default();
+        assert!(!flush_first(&b, true, 1) && !flush_first(&b, false, 1));
+        for i in 0..RUN {
+            assert!(!flush_first(&b, true, 1));
+            b.note(i, i + 1, i);
+        }
+        assert!(flush_first(&b, true, 1));
+        assert!(flush_first(&b, true, 5));
+        assert!(flush_first(&b, false, 5));
+    }
+
+    /// As the engine with the switch on and a per-render decision: bit `i` of `pattern` set
+    /// means render `i` found a run of FS work ahead and joins or opens the batch; clear means
+    /// it first exposes the open batch and publishes with its own barrier. Returns the FS WRITE
+    /// cursor at the end of the pass and the barrier entries written.
+    fn publish_mixed(pattern: u32, start: u32, t0: u32, n: u32, ring: &mut [Option<Entry>]) -> (u32, u32) {
+        let mut b = Batch::default();
+        let mut head = start;
+        let mut barriers = 0;
+        for i in 0..n {
+            let target = t0 + STEP * i;
+            let defer = pattern & (1 << i) != 0;
+            if flush_first(&b, defer, 1) {
+                close(&mut b, false, ring);
+            }
+            let s = if defer {
+                b.join_head().unwrap_or(head)
+            } else {
+                head
+            };
+            let mut h = s;
+            if !(defer && b.is_open()) {
+                ring[h as usize] = Some(Entry::Barrier(target));
+                barriers += 1;
+                h = (h + 1) % CAP;
+            }
+            ring[h as usize] = Some(Entry::Fs(target));
+            h = (h + 1) % CAP;
+            if defer {
+                b.note(s, h, target);
+            }
+            head = h;
+        }
+        close(&mut b, false, ring);
+        (head, barriers)
+    }
+
+    #[test]
+    fn mixed_own_and_batched_renders_order_every_fs() {
+        // Every mix of shallow (own barrier) and deep (batched) renders over 10 publications
+        // orders each FS behind its TA and writes no more barriers than per-render publication.
+        let n = 10;
+        for pattern in 0..(1u32 << n) {
+            for &start in &[0, 250] {
+                let mut ring = [None; CAP as usize];
+                let (w, barriers) = publish_mixed(pattern, start, 5 * STEP, n, &mut ring);
+                assert_eq!(entries(start, w), n + barriers);
+                assert!(barriers <= n);
+                assert!(run(&ring, start, w, 5 * STEP, n));
+            }
+        }
+        // All deep: one barrier per run.
+        let mut ring = [None; CAP as usize];
+        let (_, barriers) = publish_mixed(u32::MAX, 0, 5 * STEP, 8, &mut ring);
+        assert_eq!(barriers, 8 / RUN);
+    }
+
+    #[test]
+    fn model_catches_an_fs_before_its_ta() {
+        // The 1.1004 hazard: a batch barrier keyed on the opening render alone lets the
+        // second FS run before its TA. The model must reject it.
+        for n in 2..=8 {
+            let mut ring = [None; CAP as usize];
+            let w = publish(true, true, 0, 5 * STEP, n, &mut ring);
+            assert!(!run(&ring, 0, w, 5 * STEP, n));
+        }
+    }
+
+    #[test]
+    fn note_keeps_opening_slot_and_newest_wait() {
+        let mut b = Batch::default();
+        assert_eq!(b.join_head(), None);
+        b.note(10, 12, 0x500);
+        b.note(12, 13, 0x600);
+        b.note(13, 14, 0x700);
+        assert_eq!(b.join_head(), Some(14));
+        assert_eq!(
+            b.take(),
+            Some(Batch {
+                renders: 3,
+                slot: 10,
+                head: 14,
+                own: 0x500,
+                wait: 0x700
+            })
+        );
+        assert_eq!(b.take(), None);
+    }
+
+    #[test]
+    fn defer_only_when_switched_on_behind_registered_queues() {
+        assert!(defer(1, true, true, 0, 0));
+        assert!(defer(1, true, true, 0, 1));
+        assert!(!defer(0, true, true, 0, 0));
+        assert!(defer(2, true, true, 0, 0));
+        assert!(!defer(1, false, true, 0, 0));
+        assert!(!defer(1, true, false, 0, 0));
+        assert!(!defer(1, true, true, 1, 0));
+        assert!(!defer(1, true, true, 0, 2));
+    }
+}
