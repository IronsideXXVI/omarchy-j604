From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 21:30:20 -0600
Subject: [PATCH] arm64: dts: apple: t8132: Add the ATC3 USB-C controller and
 SPMI A1

The MacBook Pro (14-inch, M4) has a third USB-C port, on the right. It is
served by the fourth Apple Type-C block, ATC3: this machine's device tree
has usb-drd0, usb-drd1 and usb-drd3 but no usb-drd2 (atc-phy2 has another
port type). The port controller of ATC3 sits on a second nub SPMI bus, A1.
Neither is described yet.

Describe the SPMI A1 bus, the ATC3 PHY, the two DWC3 DARTs and the DWC3
controller, mirroring the ATC0 and ATC1 nodes: disabled, USB2 only.

All values come from the J604 Apple device tree (26B123 runtime capture):

  /arm-io/nub-spmi-a1    reg 0x388a08000 (+0x4000), AIC 522,
                         power state NUB_SPMI_A1 (ps_nub_spmi_a1)
  /arm-io/atc-phy3       reg[0] 0x41aa90000 (+0x4000); the PIPE handler
                         is usb-drd3 reg[3] 0x41aa84000 (+0x4000)
  /arm-io/usb-drd3       reg[0] 0x41a280000 (+0x11800), AIC 1465
  /arm-io/dart-usb3      reg 0x41af00000 and 0x41af80000 (+0xc000 each),
                         AIC 1469
  usb-drd3 clock-gates   ATC3-USB-V, i.e. ATC3_USB (ps_atc3_usb)

These nodes have the same property names as their ATC0 counterparts in
that device tree (atc-phy0, usb-drd0, dart-usb0); only the addresses,
interrupts and per-instance calibration differ. The DART windows are
0xc000 like those of every other T8132 DART, so the T8110 reset path stays
inside them.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 65 ++++++++++++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 5e6138534c..f0b96c8c55 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -765,6 +765,19 @@
 			status = "disabled";
 		};
 
+		nub_spmi_a1: spmi@388a08000 {
+			compatible = "apple,t8132-spmi", "apple,t8103-spmi";
+			reg = <0x3 0x88a08000 0x0 0x4000>;
+			#address-cells = <2>;
+			#size-cells = <0>;
+			#interrupt-cells = <2>;
+			interrupt-controller;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 522 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_nub_spmi_a1>;
+			status = "disabled";
+		};
+
 		smc_mbox: mailbox@38c608000 {
 			compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
 			reg = <0x3 0x8c608000 0x0 0x4000>;
@@ -898,6 +911,58 @@
 			status = "disabled";
 		};
 
+		atcphy3: phy@41aa90000 {
+			compatible = "apple,t8132-atcphy";
+			reg = <0x4 0x1aa90000 0x0 0x4000>,
+			      <0x4 0x1aa84000 0x0 0x4000>;
+			reg-names = "usb2phy", "pipehandler";
+			#phy-cells = <1>;
+			#reset-cells = <0>;
+			orientation-switch;
+			mode-switch;
+			power-domains = <&ps_atc3_usb>;
+			status = "disabled";
+		};
+
+		dwc3_3_dart_0: iommu@41af00000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x1af00000 0x0 0xc000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1469 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			power-domains = <&ps_atc3_usb>;
+			status = "disabled";
+		};
+
+		dwc3_3_dart_1: iommu@41af80000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x1af80000 0x0 0xc000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1469 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <1>;
+			power-domains = <&ps_atc3_usb>;
+			status = "disabled";
+		};
+
+		dwc3_3: usb@41a280000 {
+			compatible = "apple,t8132-dwc3";
+			reg = <0x4 0x1a280000 0x0 0xcd00>,
+			      <0x4 0x1a28cd00 0x0 0x3200>;
+			reg-names = "dwc3-core", "dwc3-apple";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1465 IRQ_TYPE_LEVEL_HIGH>;
+			dr_mode = "otg";
+			maximum-speed = "high-speed";
+			usb-role-switch;
+			role-switch-default-mode = "host";
+			iommus = <&dwc3_3_dart_0 0>, <&dwc3_3_dart_1 1>;
+			power-domains = <&ps_atc3_usb>;
+			resets = <&atcphy3>;
+			phys = <&atcphy3 PHY_TYPE_USB2>;
+			phy-names = "usb2-phy";
+			status = "disabled";
+		};
+
 		ans_mbox: mailbox@481608000 {
 			compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
 			reg = <0x4 0x81608000 0x0 0x4000>;
