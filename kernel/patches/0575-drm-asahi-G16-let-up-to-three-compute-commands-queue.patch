-            (super::params::horizon(), 1)
+            (super::params::horizon(), super::params::horizon_depth())
         } else if resident >= 2 {
             (true, resident as u64 - 1)
         } else {
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
