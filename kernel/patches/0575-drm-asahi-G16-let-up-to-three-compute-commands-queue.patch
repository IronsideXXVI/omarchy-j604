--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -906,11 +906,13 @@ pub(crate) fn enqueue(&mut self, job: Arc<Job>) -> Result {
     fn ahead_ok(&self, job: &Job) -> bool {
         let n = self.engine.flights.len();
         if matches!(command(job, job.progress.sent()), Some(Command::Compute(_))) {
-            // g16_horizon = 1: one compute command behind a running healthy compute-only
-            // flight, in the other split UMA slot (Slots::claim_compute finds it free only
+            // g16_horizon = N: up to N compute commands behind a running healthy compute-only
+            // flight, each in its own split UMA slot (Slots::claim_compute finds one free only
             // with the overlap rule); never behind or beside render.
             return params::horizon()
-                && n < sizes::FLIGHTS.min(sizes::COMPUTE_SLOTS)
+                && n < sizes::FLIGHTS
+                    .min(sizes::COMPUTE_SLOTS)
+                    .min(1 + params::horizon_depth() as usize)
                 && self.engine.queue_registered
                 && !self.engine.frozen
                 && self.engine.flights.iter().all(|f| {
diff --git a/drivers/gpu/drm/asahi/g16/hw.rs b/drivers/gpu/drm/asahi/g16/hw.rs
index e9d3ecb178..65d2575678 100644
--- a/drivers/gpu/drm/asahi/g16/hw.rs
+++ b/drivers/gpu/drm/asahi/g16/hw.rs
@@ -201,7 +201,8 @@ pub(crate) mod client {
     pub(crate) const CLIENT_APERTURE: Range<u64> = 0x7000000000..0x7100000000;
     pub(crate) const COMPACT_WINDOW: Range<u64> = 0x1000000000..0x9000000000;
 
-    // Two persistent compute units, each in its own 64 MiB interval and reused across
+    // Persistent compute units (sizes::COMPUTE_SLOTS), each in its own 64 MiB interval, reused
+    // across
     // application queues. Every alias is inside Mesa's reserved driver hole.
     pub(crate) const fn compute_base(k: u64) -> u64 {
         0x7001000000 + k * 0x04000000
@@ -348,7 +349,17 @@ pub(crate) mod sizes {
     pub(crate) const POOL_SIZE: u64 = 0x200000;
     pub(crate) const FREELIST_SEED: u32 = 8192;
     pub(crate) const QUEUE_CAP: u32 = 256;
-    pub(crate) const COMPUTE_SLOTS: usize = 2;
+    /// Compute units a VM may hold, one compute command in flight per unit, each binding its own
+    /// split UMA slot (compute 1 + k of the 32 per class of the 25G83 layout). Units 0 and 1 are
+    /// the qualified ones; 2 and 3 take the next 64 MiB intervals below the render units, so a
+    /// compute horizon of up to three commands can stay queued behind a running one.
+    pub(crate) const COMPUTE_SLOTS: usize = 4;
+    const _: () = assert!(
+        super::client::compute_context(COMPUTE_SLOTS as u64 - 1) + 0x40000
+            <= super::client::render_base(0)
+            && super::client::WORK_PAGE + COMPUTE_SLOTS as u64 * super::client::CWORK_STRIDE
+                <= super::client::compute_base(0)
+    );
     pub(crate) const RENDER_SLOTS: usize = 2;
     pub(crate) const CT_BUFS: usize = 0;
     pub(crate) const CLUSTER_PB_PAGES: u32 = 0x3c;
