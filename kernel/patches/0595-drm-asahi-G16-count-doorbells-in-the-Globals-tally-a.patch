From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 18:54:46 +0000
Subject: [PATCH] drm/asahi: G16: count doorbells in the Globals tally
 as macOS does

The J604 GPU never powers off at idle: the GFX power word reads on for
all of a 60 s idle desktop, with the firmware allowed to power off,
with a device-control tally at +0xe40 and with Globals re-imported.

A capture of macOS 26B123 on the J604 shows its host writing one
Globals word live: +0x84 counts up by one per doorbell (+16210 across a
window with about 16.5k doorbells on all pipes, +5 across an idle
leg), from zero at init. Its policy words sit four bytes above ours
from +0x34 on (its +0x7c, +0x8c, +0x9c0 and +0xe2c are our +0x78,
+0x88, +0x9bc and +0xe28), so the word is our +0x80, which we never
wrote. The +0xe40 word we counted device controls in is zero on macOS.

Add one to Globals +0x80 before every doorbell, boot doorbells
included, and show it in the stats file. g16_doorbell_tally (default
1, runtime 0644) set to 0 leaves it unwritten. g16_power_tally now
defaults to 0, since macOS leaves +0xe40 at zero.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/boot.rs        | 15 ++++++++++++++-
 drivers/gpu/drm/asahi/g16/fw/initdata.rs |  7 +++++++
 drivers/gpu/drm/asahi/g16/params.rs      | 24 +++++++++++++++++++++---
 drivers/gpu/drm/asahi/g16/poll.rs        |  9 +++++++--
 4 files changed, 49 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/boot.rs b/drivers/gpu/drm/asahi/g16/boot.rs
index 868fb10c7a..08b5e87620 100644
--- a/drivers/gpu/drm/asahi/g16/boot.rs
+++ b/drivers/gpu/drm/asahi/g16/boot.rs
@@ -425,6 +425,9 @@ pub(crate) struct Session {
     pub(crate) regs: regs::Regs,
     pub(crate) adt: GpuAdt,
     uat: Arc<mmu::Uat>,
+    /// The Globals object once initdata is built: every doorbell adds one to its
+    /// [`super::fw::initdata::globals::DOORBELL_TALLY`] (`g16_doorbell_tally`).
+    pub(crate) globals: Option<Arc<super::object::FwObject>>,
 }
 
 impl Session {
@@ -445,8 +448,16 @@ pub(crate) fn check(&self) -> Result {
         self.uat.check_adopted_bindings()
     }
 
-    /// Sends a mailbox message.
+    /// Sends a mailbox message. A doorbell first adds one to the Globals doorbell tally, as
+    /// macOS does before each of its doorbells (`g16_doorbell_tally`).
     pub(crate) fn send(&mut self, endpoint: u8, message: u64) -> Result {
+        if endpoint == hw::ep::DOORBELL && super::params::doorbell_tally() {
+            if let Some(g) = self.globals.as_ref() {
+                let at = super::fw::initdata::globals::DOORBELL_TALLY;
+                g.w32(at, g.r32(at)?.wrapping_add(1))?;
+                regs::wmb();
+            }
+        }
         self.rtkit.send(endpoint, message)
     }
 
@@ -867,6 +878,7 @@ pub(crate) fn start(
         regs,
         adt,
         uat,
+        globals: None,
     };
     let mut events = Events::new();
     let mut built = None;
@@ -874,6 +886,7 @@ pub(crate) fn start(
         events.reserve()?;
         // Every host object and every context-0 alias is prepared before RUN is set.
         built = Some(initdata::build(&d, &session.adt, &mut objects)?);
+        session.globals = built.as_ref().and_then(|(init, _, _)| init.globals.clone());
         objects.window.lock().bootstrap(&d, &session.uat)?;
         uat::tlbi_all();
         if session.regs.asc_control()? & regs::ASC_RUN != 0 {
diff --git a/drivers/gpu/drm/asahi/g16/fw/initdata.rs b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
index 69cb266a0d..5f6f3e0287 100644
--- a/drivers/gpu/drm/asahi/g16/fw/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
@@ -114,8 +114,15 @@ pub(crate) mod globals {
     /// the block sits 0x11 lower here and the tally is the aligned word at +0xe40 (zero in the
     /// qualified image).
     pub(crate) const POWER_ASSERT_TALLY: usize = 0xe40;
+    /// The host doorbell tally: macOS 26B123 adds one to Globals +0x84 before each doorbell
+    /// (MEASURED, list 13: +16210 across a window with ~16.5k doorbells on all pipes, +5 across
+    /// an idle leg). Its policy words sit 4 bytes above ours from +0x34 on (its +0x7c/+0x8c/
+    /// +0x9c0/+0xe2c are our +0x78/+0x88/+0x9bc/+0xe28), so the 25G83 word is +0x80. The
+    /// qualified image leaves it zero; nothing else of ours writes it.
+    pub(crate) const DOORBELL_TALLY: usize = 0x80;
     const _: () = assert!(IDLE_POWER_OFF + 4 <= SIZE);
     const _: () = assert!(POWER_ASSERT_TALLY + 4 <= SIZE);
+    const _: () = assert!(DOORBELL_TALLY + 4 <= PSTATE_SELECTORS[0]);
 }
 
 /// Writes the Globals policy words; `idle_power_off` adds only [`globals::IDLE_POWER_OFF`].
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 3c691d0f6b..2d6371e463 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -977,8 +977,8 @@ pub(crate) fn s2idle() -> bool {
     "G16: at suspend-to-idle, drain the GPU (never refusing the sleep) and publish the idle performance floor; poll at resume (default 1; 0: no s2idle callbacks, as before; runtime 0644)"
 );
 
-/// Storage of `g16_power_tally` (runtime 0644, default 1).
-static POWER_TALLY: AtomicU32 = AtomicU32::new(1);
+/// Storage of `g16_power_tally` (runtime 0644, default 0: macOS leaves that word zero).
+static POWER_TALLY: AtomicU32 = AtomicU32::new(0);
 
 /// Whether each power-asserting device-control record also adds one to the Globals
 /// power-assert tally, so the firmware's count of drained records and the host's agree and the
@@ -993,7 +993,7 @@ pub(crate) fn power_tally() -> bool {
     POWER_TALLY_PARM,
     POWER_TALLY,
     "g16_power_tally",
-    "G16: count power-asserting device controls in the Globals power-assert tally, as the firmware counts them, so idle cores can power off (default 1; 0: tally left at zero, as before; runtime 0644, takes effect from the next record)"
+    "G16: count power-asserting device controls in Globals +0xe40 (default 0: macOS 26B123 leaves that word zero; 1: count, as k907-k911; runtime 0644, takes effect from the next record)"
 );
 
 /// Storage of `g16_reimport` (runtime 0644, default 1).
@@ -1016,6 +1016,24 @@ pub(crate) fn reimport() -> bool {
     "G16: follow each power-asserting device control with a Globals import, so the firmware's copy carries the matching power-assert tally (default 1; 0: import at boot only, as before; runtime 0644)"
 );
 
+/// Storage of `g16_doorbell_tally` (runtime 0644, default 1).
+static DOORBELL_TALLY: AtomicU32 = AtomicU32::new(1);
+
+/// Whether each doorbell first adds one to the Globals doorbell tally (+0x80), as macOS does
+/// before each of its doorbells.
+pub(crate) fn doorbell_tally() -> bool {
+    DOORBELL_TALLY.load(Ordering::Relaxed) != 0
+}
+
+live_u32_param!(
+    DOORBELL_TALLY_PARAM,
+    DOORBELL_TALLY_PARMTYPE,
+    DOORBELL_TALLY_PARM,
+    DOORBELL_TALLY,
+    "g16_doorbell_tally",
+    "G16: add one to the Globals doorbell tally (+0x80) before each doorbell, as macOS does (default 1; 0: never written, as before; runtime 0644)"
+);
+
 /// Storage of `g16_pb_pool` (runtime 0644, default 8).
 static PB_POOL: AtomicU32 = AtomicU32::new(8);
 
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 972a2b3ff2..9972c57f87 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -1130,7 +1130,7 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
         )?;
         writeln!(
             f,
-            "idle_power_off: published {} requested {} boot_level {} changes {} tally {} counting {}",
+            "idle_power_off: published {} requested {} boot_level {} changes {} tally {} counting {} doorbells {}",
             self.init.idle_power_off,
             params::idle_power_off(),
             self.init.idle_power_off_level,
@@ -1140,7 +1140,12 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
                 .as_ref()
                 .and_then(|g| g.r32(super::fw::initdata::globals::POWER_ASSERT_TALLY).ok())
                 .unwrap_or(0),
-            u32::from(params::power_tally())
+            u32::from(params::power_tally()),
+            self.init
+                .globals
+                .as_ref()
+                .and_then(|g| g.r32(super::fw::initdata::globals::DOORBELL_TALLY).ok())
+                .unwrap_or(0)
         )?;
         writeln!(
             f,
-- 
