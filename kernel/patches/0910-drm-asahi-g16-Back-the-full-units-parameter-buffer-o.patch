     pub(crate) fn heap_blocks_unit(&self) -> u32 {
-        self.blocks
+        self.backed.load(Ordering::Acquire)
+    }
+    /// `g16_pb_lazy`: maps more of this unit's heap window, from the last backed block, so
+    /// that `want` blocks (rounded up to 16, at most the window; the whole window on the last
+    /// step) are backed. Called only in SUBMIT under the VM's resource lock, so growth steps
+    /// of one unit never race. Managers are seeded from `heap_blocks_unit` at publication, so
+    /// none is ever handed a block before it is mapped: the new blocks are published to the
+    /// firmware's view and the client VM first, and `backed` is raised after that.
+    pub(crate) fn grow(
+        &self,
+        factory: &super::object::Factory,
+        vm: &crate::mmu::Vm,
+        want: u32,
+    ) -> Result {
+        if !self.lazy {
+            return Ok(());
+        }
+        let backed = self.backed.load(Ordering::Acquire);
+        let mut target = (want.min(self.window).div_ceil(16) * 16).min(self.window);
+        if target <= backed {
+            return Ok(());
+        }
+        let Some(step) = self.grown.iter().position(|g| g.as_ref().is_none()) else {
+            return Err(ENOSPC);
+        };
+        if step + 1 == GROW_STEPS {
+            target = self.window;
+        }
+        let start = super::engine::now_ns();
+        if let Err(e) = self.map_step(factory, vm, step, backed, target) {
+            LAZY_PB[2].fetch_add(1, Ordering::Relaxed);
+            return Err(e);
+        }
+        self.backed.store(target, Ordering::Release);
+        let ns = super::engine::now_ns().wrapping_sub(start);
+        LAZY_PB[0].fetch_add(1, Ordering::Relaxed);
+        LAZY_PB[1].fetch_add(u64::from(target - backed), Ordering::Relaxed);
+        LAZY_PB[4].fetch_add(ns, Ordering::Relaxed);
+        LAZY_PB[5].fetch_max(ns, Ordering::Relaxed);
+        Ok(())
+    }
+    /// One growth step of [`Self::grow`]: blocks `from..to` of the window, mapped into the
+    /// firmware's view and the client VM at their window address and published.
+    fn map_step(
+        &self,
+        factory: &super::object::Factory,
+        vm: &crate::mmu::Vm,
+        step: usize,
+        from: u32,
+        to: u32,
+    ) -> Result {
+        let mut o = factory.objects(vm);
+        let heap = alloc(
+            &mut o,
+            (u64::from(to - from) * buffer::BLOCK_BYTES) as usize,
+            Class::Shared,
+            Some((
+                self.heap_va + u64::from(from) * buffer::BLOCK_BYTES,
+                pte::LEAF_NC,
+            )),
+            false,
+        )?;
+        o.finish_private()?;
+        let growth = KBox::new(
+            Growth {
+                _heap: heap,
+                _objects: o,
+            },
+            GFP_KERNEL,
+        )?;
+        if !self.grown.get(step).ok_or(EINVAL)?.populate(growth) {
+            return Err(EBUSY);
+        }
+        Ok(())
     }
 }
