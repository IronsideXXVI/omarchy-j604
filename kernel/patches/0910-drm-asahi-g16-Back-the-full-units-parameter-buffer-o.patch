 );
 
+/// Storage of `g16_pb_lazy` (0644, default 0; latched at its first read).
+static PB_LAZY: AtomicU32 = AtomicU32::new(0);
+/// 0 until latched, then the latched value plus one.
+static PB_LAZY_LATCH: AtomicU32 = AtomicU32::new(0);
+
+/// The floor, in blocks, of a lazily backed PB heap, if `g16_pb_lazy` is set: the full render
+/// units keep their whole PB heap window (its address and size) but back only its first
+/// `floor` blocks when built, and map more of it, in SUBMIT, when the blocks their renders were
+/// seen holding ask for it (three times the in-flight free-block ring distance, as macOS sizes
+/// its parameter buffer), or the whole window once a render held three quarters of its
+/// manager's blocks. A manager is never seeded with more blocks than are backed. The firmware
+/// is still given each manager's whole heap up front and has no growth protocol, so a render
+/// that outgrows its manager faults as with `g16_pb_blocks`. 1 means 256 blocks (32 MiB); other
+/// values are rounded up to 16 blocks and kept within the manager's limits.
+pub(crate) fn pb_lazy() -> Option<u32> {
+    let mut l = PB_LAZY_LATCH.load(Ordering::Acquire);
+    if l == 0 {
+        let v = PB_LAZY.load(Ordering::Relaxed);
+        let _ = PB_LAZY_LATCH.compare_exchange(
+            0,
+            v.saturating_add(1),
+            Ordering::AcqRel,
+            Ordering::Acquire,
+        );
+        l = PB_LAZY_LATCH.load(Ordering::Acquire);
+    }
+    match l.wrapping_sub(1) {
+        0 => None,
+        1 => Some(256),
+        v => Some(
+            (v.clamp(super::fw::buffer::MIN_BLOCKS, super::fw::buffer::MAX_BLOCKS)
+                .div_ceil(16)
+                * 16)
+                .min(super::fw::buffer::MAX_BLOCKS),
+        ),
+    }
+}
+
+live_u32_param!(
+    PB_LAZY_PARAM,
+    PB_LAZY_PARMTYPE,
+    PB_LAZY_PARM,
+    PB_LAZY,
+    "g16_pb_lazy",
+    "G16: back the full render units' PB heap lazily from a floor of N blocks (128 KiB each; 1 = 256 = 32 MiB) and grow it in SUBMIT to three times the blocks in use, or to the whole window once a render held 3/4 of its manager (default 0: whole heap at build; latched at the first read, set it as a module option)"
+);
