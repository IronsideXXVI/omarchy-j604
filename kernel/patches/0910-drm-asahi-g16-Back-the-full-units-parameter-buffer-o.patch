+/// `g16_pb_lazy`: most growth steps of one unit's PB heap; the last one maps the rest of it.
+const GROW_STEPS: usize = 8;
+
+/// `g16_pb_lazy`: [0] growth steps mapped, [1] blocks they mapped, [2] steps that failed,
+/// [3] unit slots latched to the whole window (a render held 3/4 of its manager), [4] total
+/// and [5] longest nanoseconds a step took in SUBMIT.
+pub(crate) static LAZY_PB: [AtomicU64; 6] = [const { AtomicU64::new(0) }; 6];
+
+/// `g16_pb_lazy` stats line.
+pub(crate) fn write_lazy_stats(f: &mut impl fmt::Write) -> fmt::Result {
+    writeln!(
+        f,
+        "pb_lazy: floor {} grows {} grown_blocks {} fails {} near_full {} total_us {} max_us {}",
+        super::params::pb_lazy().unwrap_or(0),
+        LAZY_PB[0].load(Ordering::Relaxed),
+        LAZY_PB[1].load(Ordering::Relaxed),
+        LAZY_PB[2].load(Ordering::Relaxed),
+        LAZY_PB[3].load(Ordering::Relaxed),
+        LAZY_PB[4].load(Ordering::Relaxed) / 1000,
+        LAZY_PB[5].load(Ordering::Relaxed) / 1000
+    )
+}
+
+/// `g16_pb_lazy`: what one VM's renders were seen holding, per PB slot. Kept by the VM's render
+/// arena and handed to each of its PB managers, which update it from the in-flight samples.
+pub(crate) struct LazyHint {
+    /// The widest free-block ring distance a manager on this slot was seen at.
+    hw: [AtomicU32; super::hw::sizes::RENDER_UNITS],
+    /// A manager on this slot was seen holding 3/4 of its seeded blocks.
+    near: [AtomicBool; super::hw::sizes::RENDER_UNITS],
+}
+impl LazyHint {
+    pub(crate) fn new() -> Result<Arc<Self>> {
+        Ok(Arc::new(
+            Self {
+                hw: [const { AtomicU32::new(0) }; super::hw::sizes::RENDER_UNITS],
+                near: [const { AtomicBool::new(false) }; super::hw::sizes::RENDER_UNITS],
+            },
+            GFP_KERNEL,
+        )?)
+    }
+    /// The blocks unit `k`'s heap should have backed: three times its high water, or every
+    /// block once it was near full (the allocator caps this at its window).
+    pub(crate) fn want(&self, k: usize) -> u32 {
+        match (self.near.get(k), self.hw.get(k)) {
+            (Some(near), _) if near.load(Ordering::Relaxed) => u32::MAX,
+            (_, Some(hw)) => size_want(hw.load(Ordering::Relaxed)),
+            _ => 0,
+        }
+    }
+    fn sample(&self, slot: usize, used: u32, seeded: u32) {
+        if let Some(hw) = self.hw.get(slot) {
+            hw.fetch_max(used, Ordering::Relaxed);
+        }
+        if seeded != 0 && used.saturating_mul(4) >= seeded.saturating_mul(3) {
+            if let Some(near) = self.near.get(slot) {
+                if !near.swap(true, Ordering::Relaxed) {
+                    LAZY_PB[3].fetch_add(1, Ordering::Relaxed);
+                }
+            }
+        }
+    }
+}
+
+/// One `g16_pb_lazy` growth step: the blocks it maps and the objects that map them.
+struct Growth {
+    _heap: Arc<FwObject>,
+    _objects: Objects,
+}
+
