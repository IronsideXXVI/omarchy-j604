From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 00:40:11 +0000
Subject: [PATCH] soc: apple: s2r: T8132: enable the P cluster power
 gate, report the wake words

Three things for the T8132 sequence (apple_s2r.t8132_sequence only):

 - The P cluster's power-gate enable (bit 31 at +0x60 of the
   power-gate block) is set at ->enter, before any other step of the
   sequence. iBoot leaves only the E cluster's set on the J604.
   Aurora enables the power-gate node at boot (its 3bd4bd1bf8) and
   its wake writes both enables (sleep.c pwrgate_wake 0x000 and
   0x060, in aurora-silicon/linux#1314, Bartosz Nitka and Diljit
   Singh). An abort puts the old value back; a real wake keeps it,
   as there. One line reports both words at ->enter and after.

 - Right after the AP wake masks are armed, the words from +0x08 to
   +0x2c of the wake block are read back and reported. Aurora's T8132
   layout has the masks at +0x08 and the status at +0x28; apple-sleep,
   taken from T6020, uses +0x0c and +0x30. The read-back settles which
   one this machine has. Reads only.

 - The probe no longer warns that the CPU cluster power-down is left
   out on a T8132 node in this mode: the sequence powers the clusters
   down through their own cluster words, not apple,cluster-power-state.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/apple-s2r.c | 71 +++++++++++++++++++++++++++++++++++
 1 file changed, 71 insertions(+)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 602f186a9d..6929f9343d 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -145,6 +145,11 @@
 #define T8132_PWRGATE_ON		0x80000000
 #define T8132_PWRGATE_WAKE_0		0x000
 #define T8132_PWRGATE_WAKE_1		0x060
+/* The CPU clusters' power-gate enables: E at +0x0 (iBoot sets it), P at +0x60 */
+#define T8132_PWRGATE_CLUSTER_E		0x000
+#define T8132_PWRGATE_CLUSTER_P		0x060
+/* Wake block words read back once the masks are armed: +0x08 to +0x2c */
+#define T8132_WAKE_RB_WORDS		10
 #define T8132_PWRGATE_CPM_0		0x0a0
 #define T8132_PWRGATE_CPM_1		0x0a8
 
@@ -332,6 +337,15 @@ struct apple_s2r_t8132 {
 	unsigned int stop_read;
 	bool wd2_armed;
 
+	/* The wake words as read back right after arming the masks */
+	u32 wake_rb[T8132_WAKE_RB_WORDS];
+	bool wake_rb_ok;
+	/* The cluster power-gate words at ->enter, and after the P enable */
+	u32 pg_saved[2];
+	u32 pg_now[2];
+	bool pg_changed;
+	bool pg_read;
+
 	/* PMU boot stage byte: macOS's sleep value is written at the match */
 	bool pmu_written;
 	bool pmu_orig_ok;
@@ -1503,6 +1517,15 @@ static void apple_s2r_t8132_wake_arm(struct apple_s2r *s2r)
 		t->wake_armed[i] = ~val[i];
 	}
 	t->wake_done = true;
+
+	/*
+	 * Which layout is right is open: Aurora's T8132 one (masks +0x08, status
+	 * +0x28) or apple-sleep's (masks +0x0c, latched +0x30). The read-back of
+	 * the armed words settles it; reads only.
+	 */
+	for (i = 0; i < T8132_WAKE_RB_WORDS; i++)
+		t->wake_rb[i] = readl(t->wake + 0x08 + 4 * i);
+	t->wake_rb_ok = true;
 }
 
 static void apple_s2r_t8132_wake_restore(struct apple_s2r *s2r)
@@ -1918,6 +1941,37 @@ static int apple_s2r_t8132_refuse(struct apple_s2r *s2r)
 	return 0;
 }
 
+/*
+ * The P cluster's power-gate enable, as macOS and Aurora have it (Aurora's DT
+ * enables the power-gate node at boot, 3bd4bd1bf8; its wake writes both
+ * enables, sleep.c pwrgate_wake {0x000, 0x060}). iBoot leaves only E's set
+ * on the J604 (MEASURED). Set before anything of the sequence
+ * runs; an abort puts the old value back, a real wake keeps it, as Aurora's.
+ */
+static void apple_s2r_t8132_pg_enable(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+
+	t->pg_saved[0] = readl(t->pwrgate + T8132_PWRGATE_CLUSTER_E);
+	t->pg_saved[1] = readl(t->pwrgate + T8132_PWRGATE_CLUSTER_P);
+	t->pg_changed = !(t->pg_saved[1] & T8132_PWRGATE_ON);
+	if (t->pg_changed)
+		writel(t->pg_saved[1] | T8132_PWRGATE_ON, t->pwrgate + T8132_PWRGATE_CLUSTER_P);
+	t->pg_now[0] = readl(t->pwrgate + T8132_PWRGATE_CLUSTER_E);
+	t->pg_now[1] = readl(t->pwrgate + T8132_PWRGATE_CLUSTER_P);
+	t->pg_read = true;
+}
+
+static void apple_s2r_t8132_pg_undo(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+
+	if (!t->pg_changed)
+		return;
+	t->pg_changed = false;
+	writel(t->pg_saved[1], t->pwrgate + T8132_PWRGATE_CLUSTER_P);
+}
+
 /* ->enter's T8132 part, past the coprocessors' refusals and stops. */
 static int apple_s2r_t8132_enter(struct apple_s2r *s2r)
 {
@@ -1933,6 +1987,7 @@ static int apple_s2r_t8132_enter(struct apple_s2r *s2r)
 	ret = apple_s2r_check(s2r, S2R_STEP_T8132_WAKE);
 	if (ret)
 		return ret;
+	apple_s2r_t8132_pg_enable(s2r);
 	apple_s2r_t8132_wake_arm(s2r);
 
 	ret = apple_s2r_check(s2r, S2R_STEP_T8132_MATCH);
@@ -1955,6 +2010,10 @@ static int apple_s2r_t8132_enter(struct apple_s2r *s2r)
 
 	apple_s2r_t8132_match_undo(s2r);
 	apple_s2r_t8132_wake_restore(s2r);
+	if (ret)
+		apple_s2r_t8132_pg_undo(s2r);
+	else
+		t->pg_changed = false;
 
 	return ret;
 }
@@ -1973,6 +2032,15 @@ static void apple_s2r_t8132_report(struct apple_s2r *s2r)
 			 t->stop_word[0], t->stop_word[1], t->stop_word[2],
 			 t->returned ? "back from the sleep" : "after the abort");
 	t->stop_read = 0;
+	if (t->pg_read)
+		dev_info(s2r->dev, "T8132: cluster power gates at ->enter E %#x P %#x, before the sequence E %#x P %#x%s\n",
+			 t->pg_saved[0], t->pg_saved[1], t->pg_now[0], t->pg_now[1],
+			 t->returned ? "" : " (P put back after the abort)");
+	t->pg_read = false;
+	if (t->wake_rb_ok)
+		dev_info(s2r->dev, "T8132: wake words read back +0x08..+0x2c: %*ph\n",
+			 (int)sizeof(t->wake_rb), t->wake_rb);
+	t->wake_rb_ok = false;
 	if (!t->returned)
 		return;
 	t->returned = false;
@@ -2688,6 +2756,9 @@ static int apple_s2r_probe(struct platform_device *pdev)
 	} else if (of_device_is_compatible(np, "apple,t6021-pmgr-s2r")) {
 		s2r->cluster_ps = s2r->pmgr;
 		s2r->cluster_ps_base = CLUSTER_PS_T6021;
+	} else if (t8132_sequence && of_device_is_compatible(np, "apple,t8132-pmgr-s2r")) {
+		/* Not used by the T8132 sequence: it writes the clusters' own words. */
+		dev_info(dev, "T8132 sequence: CPU clusters go down through their cluster words, not apple,cluster-power-state\n");
 	} else {
 		dev_warn(dev, "no apple,cluster-power-state: CPU cluster power-down left out\n");
 	}
