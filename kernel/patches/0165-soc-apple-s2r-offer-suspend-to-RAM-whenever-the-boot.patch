From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 9 Nov 2026 23:26:21 +0000
Subject: [PATCH] soc: apple: s2r: offer suspend-to-RAM whenever the
 boot firmware opts in

Suspend-to-RAM needs the boot firmware to take a waking core back to the
kernel, and the driver already refuses to register without that: no
mailbox in /chosen, no verified reset vector, or a core whose RVBAR is
not locked to it, and probe returns -ENODEV. The enable parameter on top
of that kept it off on firmware that does opt in, which the shipped
m1n1-aurora now does (asahi,s2r-mailbox and asahi,s2r-reset-vector are
in /chosen on the J604).

Drop that extra step, as PSCI does for SYSTEM_SUSPEND: offer the state
whenever the firmware says it can. Once the ops are registered the PM
core makes "deep" the default mem sleep (suspend_set_ops()), so systemd's
default MemorySleepMode picks it with no command line. On firmware
without the mailbox nothing registers, mem_sleep keeps s2idle as its only
and default entry, and every sleep request stays suspend-to-idle.

apple_s2r.enable=0 on the command line keeps suspend-to-idle.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/soc/apple/Kconfig     | 6 ++++--
 drivers/soc/apple/apple-s2r.c | 6 +++---
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/drivers/soc/apple/Kconfig b/drivers/soc/apple/Kconfig
index a97e136a16..68ee0107e3 100644
--- a/drivers/soc/apple/Kconfig
+++ b/drivers/soc/apple/Kconfig
@@ -94,8 +94,10 @@ config APPLE_S2R
 	  kernel on wake. Takes the SoC into suspend-to-RAM once all
 	  devices and secondary CPUs are down, and restores it on wake.
 
-	  Off unless enabled with apple_s2r.enable=1 on the kernel
-	  command line.
+	  It registers only when the boot firmware publishes a warm boot
+	  mailbox and the reset vector every core is locked to, so with
+	  older firmware the system keeps suspend-to-idle. apple_s2r.enable=0
+	  on the kernel command line keeps suspend-to-idle as well.
 
 config APPLE_CLUSTER_PWRGATE
 	bool "Apple SoC CPU cluster power gates"
diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 8f0c4067d7..3be5f5aebb 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -525,9 +525,9 @@ static void apple_s2r_coprocs_stop(bool first)
 	dsb(sy);
 }
 
-static bool enable;
+static bool enable = true;
 module_param(enable, bool, 0444);
-MODULE_PARM_DESC(enable, "Offer suspend-to-RAM (\"deep\" mem sleep); needs firmware warm boot support (default: off)");
+MODULE_PARM_DESC(enable, "Offer suspend-to-RAM (\"deep\" mem sleep) when the boot firmware publishes a verified warm boot mailbox; 0 keeps suspend-to-idle (default: on)");
 
 static ulong warm_flags;
 module_param(warm_flags, ulong, 0644);
@@ -1137,7 +1137,7 @@ static int apple_s2r_probe(struct platform_device *pdev)
 	int ret;
 
 	if (!enable) {
-		dev_info(dev, "suspend-to-RAM disabled; enable with apple_s2r.enable=1\n");
+		dev_info(dev, "suspend-to-RAM disabled by apple_s2r.enable=0\n");
 		return -ENODEV;
 	}
 
