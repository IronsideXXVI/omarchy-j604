     ))
 }
 
+fn u64_at(data: &[u8], at: usize) -> Result<u64, Error> {
+    let end = at.checked_add(8).ok_or(Error::Malformed)?;
+    Ok(u64::from_le_bytes(
+        data.get(at..end)
+            .ok_or(Error::Malformed)?
+            .try_into()
+            .map_err(|_| Error::Malformed)?,
+    ))
+}
+
 fn string_is(data: &[u8], expected: &[u8]) -> bool {
     data.strip_suffix(&[0]) == Some(expected)
 }
@@ -187,3 +197,68 @@ pub(crate) fn parse(data: &[u8]) -> Result<Source, Error> {
     }
     Ok(source)
 }
+
+/// Most `/arm-io/gfx-asc` firmware segments accepted from the original ADT.
+pub(crate) const MAX_SEGMENTS: usize = 4;
+
+/// One `/arm-io/gfx-asc` firmware segment, as the boot loader filled `segment-ranges`.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Segment {
+    pub(crate) pa: u64,
+    pub(crate) iova: u64,
+    pub(crate) size: u64,
+    pub(crate) flags: u32,
+    /// Named `__TEXT` in `segment-names`.
+    pub(crate) text: bool,
+    /// Named `__DATA` in `segment-names`.
+    pub(crate) data: bool,
+}
+
+/// The gfx-asc firmware segments, in `segment-names` order.
+pub(crate) struct Segments<'a> {
+    /// The raw `segment-names` value.
+    pub(crate) names: &'a [u8],
+    pub(crate) count: usize,
+    pub(crate) list: [Segment; MAX_SEGMENTS],
+}
+
+/// Decodes `/arm-io/gfx-asc` `segment-names` and `segment-ranges`. Each 32-byte range record is
+/// `{u64 pa; u64 iova; u64 remap; u32 size; u32 flags}`; every record needs one name. Nothing
+/// here qualifies a layout: that is the board owner's decision.
+pub(crate) fn segments(data: &[u8]) -> Result<Segments<'_>, Error> {
+    if data.is_empty() || data.len() > 0x20_0000 {
+        return Err(Error::Malformed);
+    }
+    let tree = Tree { data };
+    tree.node_end(0, 0, &mut 0)?;
+    let asc = tree.child(tree.child(0, b"arm-io")?, b"gfx-asc")?;
+    let names = tree.property(asc, b"segment-names")?;
+    let ranges = tree.property(asc, b"segment-ranges")?;
+    if ranges.is_empty() || ranges.len() % 32 != 0 || ranges.len() / 32 > MAX_SEGMENTS {
+        return Err(Error::Shape);
+    }
+    let mut segments = Segments {
+        names,
+        count: 0,
+        list: [Segment::default(); MAX_SEGMENTS],
+    };
+    let mut named = names
+        .split(|&c| c == b';' || c == 0)
+        .filter(|name| !name.is_empty());
+    for (index, record) in ranges.chunks_exact(32).enumerate() {
+        let name = named.next().ok_or(Error::Shape)?;
+        segments.list[index] = Segment {
+            pa: u64_at(record, 0)?,
+            iova: u64_at(record, 8)?,
+            size: u32_at(record, 24)?.into(),
+            flags: u32_at(record, 28)?,
+            text: name == b"__TEXT",
+            data: name == b"__DATA",
+        };
+        segments.count = index + 1;
+    }
+    if named.next().is_some() {
+        return Err(Error::Shape);
+    }
+    Ok(segments)
+}
