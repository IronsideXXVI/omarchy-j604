diff --git a/drivers/gpu/drm/asahi/g16/adt/perf.rs b/drivers/gpu/drm/asahi/g16/adt/perf.rs
index 1824cd2553..8c22f5ed78 100644
--- a/drivers/gpu/drm/asahi/g16/adt/perf.rs
