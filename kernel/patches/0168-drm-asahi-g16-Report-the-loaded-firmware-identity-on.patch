+/*
+ * Any T8132 machine. On one that asahi_g16_board() does not qualify, this
+ * selects the read-only firmware identity report; it never admits a board.
+ */
+bool asahi_g16_identify_board(void)
+{
+	return of_machine_is_compatible("apple,t8132");
+}
+
 /*
  * Keep the GFX domain powered for the whole (retained) session. Never released,
  * like the firmware session itself.
diff --git a/drivers/gpu/drm/asahi/g16/identity.rs b/drivers/gpu/drm/asahi/g16/identity.rs
index 466a97867a..cbd430862c 100644
--- a/drivers/gpu/drm/asahi/g16/identity.rs
+++ b/drivers/gpu/drm/asahi/g16/identity.rs
@@ -8,11 +8,17 @@
 //! `hw_ids` at start ([`super::boot`]). An unknown build or revision is refused with its measured
 //! identity. The canonical object VAs, the initdata graph, the board templates and the work
 //! layouts all belong to one build, so nothing is written before the build is identified.
+//!
+//! A T8132 board the backend does not qualify gets [`report_unqualified`] instead: the same
+//! measurement, read-only, with the entropy records located rather than assumed, so that the
+//! board can be qualified from its own loaded image.
 
-use kernel::{bindings, device, fmt, prelude::*};
+use core::ops::Range;
+use kernel::{bindings, c_str, device, fmt, prelude::*, str::BStr};
 
+use super::adt::{self, perf};
 use super::boot::glue;
-use super::hw::FirmwareBuild;
+use super::hw::{self, FirmwareBuild};
 
 /// Lowercase hex of a byte string, as `%*phN` prints it.
 pub(crate) struct Hex<'a>(pub(crate) &'a [u8]);
@@ -98,3 +104,196 @@ pub(crate) fn firmware(
     }
     Err(EINVAL)
 }
+
+/// Upper bound for the TEXT of an unqualified board (the qualified TEXT is 0x60000 bytes).
+const REPORT_TEXT_MAX: u64 = 0x10_0000;
+
+/// The loaded firmware identity of a board the backend does not qualify.
+pub(crate) struct Loaded {
+    pub(crate) text_size: u64,
+    pub(crate) data_size: u64,
+    /// Located `GKTS` and `ECAP` record offsets in TEXT.
+    pub(crate) gkts: usize,
+    pub(crate) ecap: usize,
+    /// SHA-256 of TEXT with both 8-byte entropy payloads zeroed, as [`firmware`] hashes it.
+    pub(crate) sha256: [u8; 32],
+}
+
+/// The offset of the only `tag` record with an 8-byte payload in `text`; `None` when there is
+/// none or more than one.
+fn find_record(text: &[u8], tag: &[u8; 4]) -> Option<usize> {
+    let length = 8u32.to_le_bytes();
+    let mut found = None;
+    for at in 0..text.len().saturating_sub(15) {
+        if text[at..at + 4] != tag[..] || text[at + 4..at + 8] != length {
+            continue;
+        }
+        if found.replace(at).is_some() {
+            return None;
+        }
+    }
+    found
+}
+
+/// Logs the original ADT performance states, the input a board performance selection needs.
+fn report_performance(dev: &device::Device, source: &[u8]) {
+    match perf::parse(source) {
+        Ok(table) => {
+            dev_info!(
+                dev,
+                "G16: unqualified board: {} performance states\n",
+                table.count
+            );
+            for state in 0..table.count {
+                dev_info!(
+                    dev,
+                    "G16: unqualified board: state {}: {} MHz {} mV, SRAM {} MHz {} mV\n",
+                    state,
+                    table.frequency_mhz[state],
+                    table.core_mv[state],
+                    table.sram_frequency_mhz[state],
+                    table.sram_mv[state]
+                );
+            }
+        }
+        Err(error) => dev_info!(
+            dev,
+            "G16: unqualified board: performance states rejected: {:?}\n",
+            error
+        ),
+    }
+}
+
+/// Measures the loaded TEXT. Its range must be the boot loader's published `fw-text` no-map
+/// reservation, outside System RAM, and the original ADT's first gfx-asc segment, `__TEXT`, at
+/// the same address and size. Nothing else is mapped and nothing is written.
+fn loaded(dev: &device::Device) -> Result<Loaded> {
+    let (start, size) = glue::reserved_region(dev, c_str!("fw-text")).inspect_err(|_| {
+        dev_info!(
+            dev,
+            "G16: unqualified board: no fw-text reservation published\n"
+        )
+    })?;
+    let end = start.checked_add(size).ok_or(EINVAL)?;
+    if start == 0
+        || size == 0
+        || size > REPORT_TEXT_MAX
+        || (start | size) & (hw::PAGE - 1) != 0
+        || end - 1 > (hw::PA_MASK | (hw::PAGE - 1))
+        || !glue::ram_disjoint(start, size)
+    {
+        dev_info!(
+            dev,
+            "G16: unqualified board: fw-text {:#x}+{:#x} not readable\n",
+            start,
+            size
+        );
+        return Err(EINVAL);
+    }
+    let text: Range<u64> = start..end;
+    let (source, source_pa) =
+        adt::original_adt(core::slice::from_ref(&text)).inspect_err(|error| {
+            dev_info!(
+                dev,
+                "G16: unqualified board: original ADT export not usable: {:?}\n",
+                error
+            )
+        })?;
+    dev_info!(
+        dev,
+        "G16: unqualified board: original ADT PA={:#x} bytes={:#x} sha256={}\n",
+        source_pa,
+        source.len(),
+        Hex(&glue::sha256(&source))
+    );
+    report_performance(dev, &source);
+    let segments = perf::segments(&source).map_err(|error| {
+        dev_info!(
+            dev,
+            "G16: unqualified board: gfx-asc segments rejected: {:?}\n",
+            error
+        );
+        EINVAL
+    })?;
+    dev_info!(
+        dev,
+        "G16: unqualified board: gfx-asc segments \"{}\"\n",
+        BStr::from_bytes(segments.names.strip_suffix(&[0]).unwrap_or(segments.names))
+    );
+    let list = &segments.list[..segments.count];
+    for (index, segment) in list.iter().enumerate() {
+        dev_info!(
+            dev,
+            "G16: unqualified board: segment {}: PA={:#x} IOVA={:#x} size={:#x} flags={:#x}\n",
+            index,
+            segment.pa,
+            segment.iova,
+            segment.size,
+            segment.flags
+        );
+    }
+    if !list[0].text || list[0].pa != start || list[0].size != size {
+        dev_info!(
+            dev,
+            "G16: unqualified board: fw-text is not the ADT __TEXT segment\n"
+        );
+        return Err(EINVAL);
+    }
+    let data_size = list
+        .iter()
+        .find(|segment| segment.data)
+        .map_or(0, |s| s.size);
+    let size = usize::try_from(size)?;
+    let mut copy = copy_physical(start, size)?;
+    if copy.as_slice() != copy_physical(start, size)?.as_slice() {
+        dev_info!(
+            dev,
+            "G16: unqualified board: TEXT changed while it was read\n"
+        );
+        return Err(EAGAIN);
+    }
+    let (Some(gkts), Some(ecap)) = (find_record(&copy, b"GKTS"), find_record(&copy, b"ECAP"))
+    else {
+        // TEXT carries per-boot entropy, so a digest of the raw image identifies nothing.
+        dev_info!(
+            dev,
+            "G16: unqualified board: TEXT {:#x} DATA {:#x}: no unique GKTS and ECAP records\n",
+            size,
+            data_size
+        );
+        return Err(ENOENT);
+    };
+    copy[gkts + 8..gkts + 16].fill(0);
+    copy[ecap + 8..ecap + 16].fill(0);
+    Ok(Loaded {
+        text_size: size as u64,
+        data_size,
+        gkts,
+        ecap,
+        sha256: glue::sha256(&copy),
+    })
+}
+
+/// Logs the identity of the firmware the boot loader of an unqualified T8132 board left in
+/// place. Read-only: no PMP, no power domain, no firmware-visible write.
+pub(crate) fn report_unqualified(dev: &device::Device) -> Option<Loaded> {
+    let loaded = loaded(dev)
+        .inspect_err(|error| {
+            dev_info!(
+                dev,
+                "G16: unqualified board: firmware identity not reported: {:?}\n",
+                error
+            )
+        })
+        .ok()?;
+    dev_info!(
+        dev,
+        "G16: unqualified board: TEXT {:#x} DATA {:#x} GKTS {:#x} ECAP {:#x} sha256 {}\n",
+        loaded.text_size,
+        loaded.data_size,
+        loaded.gkts,
+        loaded.ecap,
+        Hex(&loaded.sha256)
+    );
+    Some(loaded)
+}
