From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 00:55:53 +0000
Subject: [PATCH] drm/asahi: g16: split the firmware start delay by VM
 switches

A serialized render command on the J604 waits about 0.67 ms from its
publication to its first firmware event. In a browser animation about
one render command in four belongs to a different VM than the one
before it (browser and compositor take turns), and the render unit is
then retargeted to the new VM.

Report the publication to first event time of render prefixes separately
for prefixes whose VM matches the previous render prefix and for those
that switch VM, so the cost of a switch can be told from the cost of a
publication. Debugfs only.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 23c6d7b604d5eaca752328d5485f116d04a5e2de)
---
 drivers/gpu/drm/asahi/g16/engine.rs |  6 ++++++
 drivers/gpu/drm/asahi/g16/poll.rs   | 14 ++++++++++++++
 2 files changed, 20 insertions(+)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 2f4f05d372..020379265b 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -272,6 +272,12 @@ pub(crate) struct Stats {
     pub(crate) lat_last_bad: [u64; 4],
     /// Publication to first firmware event of render prefixes, 100 us buckets (last: >= 2 ms).
     pub(crate) first_hist: [u64; 21],
+    /// Publication to first firmware event of render prefixes, split by whether the prefix's
+    /// VM differs from the previous retired render prefix's VM: [0] same, [1] cross (count, ns).
+    pub(crate) first_vm_n: [u64; 2],
+    pub(crate) first_vm_ns: [u64; 2],
+    /// VM id of the last retired render prefix (0: none yet).
+    pub(crate) last_render_vm: u64,
     /// [0] compute, [1] render, [2] mixed.
     pub(crate) count: [u64; 3],
     /// Commands whose first queue WRITE advanced, compute then render. These counters are
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 5c4c956362..145f3511b0 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -871,6 +871,9 @@ fn stat_retire(&mut self, f: &Flight) {
             if kind == 1 {
                 let b = ((first - f.published_ns) / 100_000).min(20) as usize;
                 s.first_hist[b] += 1;
+                let cross = usize::from(s.last_render_vm != 0 && s.last_render_vm != f.job.vm.id);
+                s.first_vm_n[cross] += 1;
+                s.first_vm_ns[cross] += first - f.published_ns;
             }
             s.first_ns[kind] += first - f.published_ns;
             s.last_ns[kind] += last - f.published_ns;
@@ -880,6 +883,9 @@ fn stat_retire(&mut self, f: &Flight) {
         if kind == 2 {
             s.count[2] += f.count as u64;
         }
+        if kind == 1 {
+            s.last_render_vm = f.job.vm.id;
+        }
         s.prefixes[kind] += 1;
         s.busy_ns[kind] += d;
         s.max_ns[kind] = s.max_ns[kind].max(d);
@@ -1114,6 +1120,14 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
             write!(f, " {}", n)?;
         }
         writeln!(f)?;
+        writeln!(
+            f,
+            "first_vm: same {} same_us {} cross {} cross_us {}",
+            s.first_vm_n[0],
+            s.first_vm_ns[0] / 1000,
+            s.first_vm_n[1],
+            s.first_vm_ns[1] / 1000
+        )?;
         // The phase timers of debug_flags bit 49, and the scrub flush waits.
         let p = &self.engine.prof;
         writeln!(
