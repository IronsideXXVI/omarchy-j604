From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jonathan Goyvaerts <jonathan.goyvaerts@gmail.com>
Date: Wed, 14 Oct 2026 19:05:55 +0000
Subject: [PATCH] soc: apple: aop: Bounds-check the boot argument table

patch_bootargs() takes the offset and size of the firmware's boot
argument table from the AOP's own SRAM and walks its records with
unchecked slice indexing. A table or record length that does not fit,
or a patched record longer than eight bytes, panics the kernel on an
out-of-bounds slice.

Check the table against the mapped region before reading it, and each
record header and length against the table while walking it, and fail
the probe with -EINVAL on a malformed table. A key missing from the
table is still skipped, so firmware without one of them behaves as
before.

Signed-off-by: Jonathan Goyvaerts <jonathan.goyvaerts@gmail.com>
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/aop.rs | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/drivers/soc/apple/aop.rs b/drivers/soc/apple/aop.rs
index 9cd99f6330..8ca4655adf 100644
--- a/drivers/soc/apple/aop.rs
+++ b/drivers/soc/apple/aop.rs
@@ -1542,23 +1542,35 @@ impl AopData {
     ) -> Result<()> {
         let offset = aop_mmio.read32(BOOTARGS_OFFSET) as usize;
         let size = aop_mmio.read32(BOOTARGS_SIZE) as usize;
+        if offset > aop_mmio.size() || size > aop_mmio.size() - offset {
+            return Err(EINVAL);
+        }
         let mut arg_bytes = KVec::<u8>::from_elem(0, size, GFP_KERNEL)?;
         let aop_io_array: Mmio<'_, [u8; AOP_MMIO_SIZE]> = aop_mmio.try_cast()?;
         let bootargs = io_project!(aop_io_array, [try: offset .. offset+size]);
         bootargs.copy_to_slice(&mut arg_bytes);
         let mut idx = 0;
         while idx < size {
+            if size - idx < 8 {
+                return Err(EINVAL);
+            }
             let key = u32::from_le_bytes(arg_bytes[idx..idx + 4].try_into().unwrap());
-            let size = u32::from_le_bytes(arg_bytes[idx + 4..idx + 8].try_into().unwrap()) as usize;
+            let len = u32::from_le_bytes(arg_bytes[idx + 4..idx + 8].try_into().unwrap()) as usize;
             idx += 8;
+            if len > size - idx {
+                return Err(EINVAL);
+            }
             for (k, v) in patches.iter() {
                 if *k != key {
                     continue;
                 }
-                arg_bytes[idx..idx + size].copy_from_slice(&v.to_le_bytes()[..size]);
+                if len > mem::size_of::<u64>() {
+                    return Err(EINVAL);
+                }
+                arg_bytes[idx..idx + len].copy_from_slice(&v.to_le_bytes()[..len]);
                 break;
             }
-            idx += size;
+            idx += len;
         }
         bootargs.copy_from_slice(&arg_bytes);
         Ok(())
