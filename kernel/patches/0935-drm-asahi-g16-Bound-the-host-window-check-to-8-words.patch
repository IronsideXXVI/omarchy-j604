From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 18 Nov 2026 19:52:44 +0000
Subject: [PATCH] drm/asahi: g16: Bound the host window check to 8
 words by default

Every poll pass and every submission checks the host window by reading
back, uncached, every linked shared-L2 entry of the 64 GiB host window.
An entry stays linked for the rest of the boot once anything was mapped
in its 32 MiB, so the check grows with every client mix the boot has run
and a light compute command gets slower the longer the boot runs.

Make g16_window_check_n default to 8. A check still verifies the
firmware root words and then reads 8 linked words round robin, so every
linked word is read at least once every ceil(linked / 8) checks, and
linking a new entry still compares all 2048 words. On the J604, light
compute took 31.15 us with the bound and 31.23 us with every linked
word read on a fresh boot; after one, two and three stress sets it took
30.66, 30.60 and 30.48 us with the bound against 33.37, 33.70 and
31.63 us with every linked word read.

Writing 0 at run time restores the full check.

RESULT: to be filled by the release owner

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/params.rs | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 70022c422b..6c237832da 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -515,14 +515,15 @@ pub(crate) fn compute_onebell() -> u32 {
     "G16: doorbells of the compute publications of one publish pass (default 2: after the first record and when the pass ends; 0: one after each record; 1: one when the pass ends; runtime 0644)"
 );
 
-/// Storage of `g16_window_check_n` (runtime 0644, default 0).
-static WINDOW_CHECK_N: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_window_check_n` (runtime 0644, default 8).
+static WINDOW_CHECK_N: AtomicU32 = AtomicU32::new(8);
 
 /// Shared-L2 words one host-window check reads back (g16/winscan.rs). 0: every linked word on
 /// every check, as before. N: the root words and N linked words round robin, so every linked
 /// word is still read at least once every ceil(linked / N) checks while a check's cost stops
 /// growing with the host-window VA the boot has ever used. Linking a new entry (sync_range)
-/// still compares all 2048 words. Read at each check.
+/// still compares all 2048 words. Read at each check. Default 8; 0 restores the full check
+/// of 1.1065 and earlier.
 pub(crate) fn window_check_n() -> u32 {
     WINDOW_CHECK_N.load(Ordering::Relaxed)
 }
@@ -533,7 +534,7 @@ pub(crate) fn window_check_n() -> u32 {
     WINDOW_CHECK_N_PARM,
     WINDOW_CHECK_N,
     "g16_window_check_n",
-    "G16: shared-L2 words one host-window check reads (default 0: every linked word; N: N linked words round robin, each still read every ceil(linked/N) checks; runtime 0644)"
+    "G16: shared-L2 words one host-window check reads (default 8; 0: every linked word, as up to 1.1065; N: N linked words round robin, each still read every ceil(linked/N) checks; runtime 0644)"
 );
 
 live_u32_param!(
