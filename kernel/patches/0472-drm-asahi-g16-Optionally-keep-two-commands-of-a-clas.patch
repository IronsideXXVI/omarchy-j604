diff --git a/drivers/gpu/drm/asahi/g16/pools/lifetime.rs b/drivers/gpu/drm/asahi/g16/pools/lifetime.rs
index baf623b272..7885a8c059 100644
--- a/drivers/gpu/drm/asahi/g16/pools/lifetime.rs
+++ b/drivers/gpu/drm/asahi/g16/pools/lifetime.rs
@@ -4,6 +4,60 @@
 //! reusable: a distinct, fully retired owner must replace it in the same hardware slot.
 //! Core-only so the transition system is executable in host tests.
 
+use core::sync::atomic::{AtomicU32, Ordering};
+
+/// Storage of `g16_overlap` (runtime 0644, default 0; declared in params.rs).
+pub(crate) static OVERLAP: AtomicU32 = AtomicU32::new(0);
+
+/// Storage of `g16_uma_split` (0644, default 0; declared in params.rs). Read once, at the
+/// first G16 slot use of the boot, and latched: it must be set before the GPU is used
+/// (module option in the initramfs).
+pub(crate) static UMA_SPLIT: AtomicU32 = AtomicU32::new(0);
+
+/// The boot's UMA slot mode: 2 until latched, then 0 or 1.
+static SPLIT_LATCH: AtomicU32 = AtomicU32::new(2);
+
+/// Whether each of the two owners of a class binds its own firmware UMA slot.
+///
+/// Off (the qualified layout): every compute command names UMA slot 1 and every render
+/// command UMA slot 33, so the two owners of a class are two storage copies that take turns
+/// binding ONE firmware slot. The firmware keeps that slot bound to the last publisher's
+/// descriptor, free list and pool table until the next publication rebinds it; hence the
+/// displacement rule below. On: owner k binds slot base + k (compute 1/2, render 33/34; the
+/// 25G83 layout has 32 per class), so no firmware slot is ever bound by two owners.
+pub(crate) fn uma_split() -> bool {
+    let l = SPLIT_LATCH.load(Ordering::Acquire);
+    if l != 2 {
+        return l == 1;
+    }
+    let v = u32::from(UMA_SPLIT.load(Ordering::Relaxed) != 0);
+    let _ = SPLIT_LATCH.compare_exchange(2, v, Ordering::AcqRel, Ordering::Acquire);
+    SPLIT_LATCH.load(Ordering::Acquire) == 1
+}
+
+/// The firmware UMA slot owner `k` of a class binds: `base` (1 compute, 33 render) for both
+/// owners, or `base + k` with the split latched.
+pub(crate) fn uma_slot(base: u32, k: usize) -> u32 {
+    if uma_split() {
+        base + k as u32
+    } else {
+        base
+    }
+}
+
+/// With `g16_overlap` set AND the UMA split latched, a fully retired owner is reusable at once
+/// (released at completion) and publication is not serialized against the other owner, so
+/// two commands of a class can be in flight, each on its own firmware UMA slot. Without the
+/// split two owners in flight would bind one firmware slot at once: overlap has no effect.
+fn overlap() -> bool {
+    OVERLAP.load(Ordering::Relaxed) != 0 && uma_split()
+}
+
+#[cfg(test)]
+fn reset_latch() {
+    SPLIT_LATCH.store(2, Ordering::Release);
+}
+
 #[derive(Copy, Clone, Debug, Eq, PartialEq)]
 enum State {
     Fresh,
@@ -76,6 +130,7 @@ pub(crate) fn available(&self, k: usize) -> bool {
         };
         match u.state {
             State::Fresh => true,
+            State::Retired if overlap() => true,
             State::Retired => self.last_owner.is_some_and(|b| {
                 b != k
                     && self.units[b].state == State::Retired
@@ -116,8 +171,9 @@ pub(crate) fn publish(&mut self, k: usize) -> bool {
         if self.units[k].state != State::Preparing || self.sequence == u64::MAX {
             return false;
         }
-        // Publication must be serialized against every owner of this hardware slot.
-        if self.units.iter().any(|u| u.state == State::Published) {
+        // Publication is serialized against every owner of this hardware slot, unless
+        // g16_overlap releases owners at completion.
+        if !overlap() && self.units.iter().any(|u| u.state == State::Published) {
             return false;
         }
         self.sequence += 1;
@@ -128,7 +184,13 @@ pub(crate) fn publish(&mut self, k: usize) -> bool {
     }
     /// Called only after the caller has established complete, exact wire retirement.
     pub(crate) fn retire(&mut self, k: usize) -> bool {
-        if self.units[k].state != State::Published || self.last_owner != Some(k) {
+        // Oldest first: never while the other owner is in flight with an older publication.
+        // Checked in either g16_overlap mode, so switching it off while two are in flight
+        // strands neither. With one in flight this is the last owner, as before.
+        let b = 1 - k;
+        let older_in_flight = self.units[b].state == State::Published
+            && self.units[b].publication < self.units[k].publication;
+        if self.units[k].state != State::Published || older_in_flight {
             return false;
         }
         self.units[k].state = State::Retired;
@@ -144,6 +206,77 @@ pub(crate) fn quarantine(&mut self, k: usize) {
 mod tests {
     use super::*;
     #[test]
+    fn overlap_releases_at_completion_and_keeps_order() {
+        reset_latch();
+        UMA_SPLIT.store(1, Ordering::Relaxed);
+        OVERLAP.store(1, Ordering::Relaxed);
+        let mut l = Lifetime::new();
+        assert!(l.claim(0));
+        assert!(l.publish(0));
+        assert!(l.claim(1));
+        assert!(l.publish(1)); // Two in flight.
+        assert!(!l.retire(1)); // The newest may not retire before the oldest...
+        OVERLAP.store(0, Ordering::Relaxed);
+        assert!(l.retire(0)); // ...and the oldest retires with overlap switched off.
+        assert!(l.retire(1));
+        OVERLAP.store(1, Ordering::Relaxed);
+        assert!(l.claim(0)); // Released at completion.
+        assert!(l.publish(0));
+        assert!(l.claim(1));
+        assert!(l.publish(1));
+        OVERLAP.store(0, Ordering::Relaxed);
+        UMA_SPLIT.store(0, Ordering::Relaxed);
+        reset_latch();
+    }
+    #[test]
+    fn c1_overlap_without_split_keeps_one_owner_per_firmware_slot() {
+        reset_latch();
+        UMA_SPLIT.store(0, Ordering::Relaxed);
+        OVERLAP.store(1, Ordering::Relaxed);
+        let mut l = Lifetime::new();
+        assert!(l.claim(0));
+        assert!(l.publish(0));
+        assert!(l.claim(1));
+        assert!(!l.publish(1)); // Both would bind slot 1 (33): refused.
+        l.cancel(1);
+        assert!(l.retire(0));
+        assert!(!l.claim(0)); // No release at completion: displacement still required.
+        assert_eq!(uma_slot(1, 0), uma_slot(1, 1));
+        OVERLAP.store(0, Ordering::Relaxed);
+        reset_latch();
+    }
+    #[test]
+    fn c1_two_in_flight_never_share_a_firmware_slot() {
+        reset_latch();
+        UMA_SPLIT.store(1, Ordering::Relaxed);
+        OVERLAP.store(1, Ordering::Relaxed);
+        let mut l = Lifetime::new();
+        assert!(l.claim(0) && l.publish(0) && l.claim(1) && l.publish(1));
+        for base in [1u32, 33] {
+            assert_ne!(uma_slot(base, 0), uma_slot(base, 1));
+        }
+        // Within the 25G83 per-class ranges (compute 1..=32, render 33..=64).
+        assert!((1..=32).contains(&uma_slot(1, 1)) && (33..=64).contains(&uma_slot(33, 1)));
+        OVERLAP.store(0, Ordering::Relaxed);
+        UMA_SPLIT.store(0, Ordering::Relaxed);
+        reset_latch();
+    }
+    #[test]
+    fn split_is_latched_once_per_boot() {
+        reset_latch();
+        UMA_SPLIT.store(1, Ordering::Relaxed);
+        assert!(uma_split());
+        UMA_SPLIT.store(0, Ordering::Relaxed); // A later write does not rebind live slots.
+        assert!(uma_split());
+        assert_eq!((uma_slot(1, 0), uma_slot(1, 1), uma_slot(33, 1)), (1, 2, 34));
+        reset_latch();
+        assert!(!uma_split());
+        UMA_SPLIT.store(1, Ordering::Relaxed);
+        assert!(!uma_split()); // Latched off for this "boot".
+        UMA_SPLIT.store(0, Ordering::Relaxed);
+        reset_latch();
+    }
+    #[test]
     fn distinct_retired_displacement_is_required() {
         let mut l = Lifetime::new();
         assert!(l.claim(0));
