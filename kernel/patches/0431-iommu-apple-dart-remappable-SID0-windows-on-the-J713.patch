From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 4 Nov 2026 21:52:06 -0500
Subject: [PATCH] iommu: apple-dart: remappable SID0 windows on the J713
 external display DARTs

Direct scanout of client framebuffers needs SID0 mappings the host can take
down again. A window is one whole free 32 MiB slice of the SID0 arena,
claimed by the host until reboot; nothing else maps into it.

- apple_dart_dcp_dispext_window_claim() claims one, or returns -ENOSPC;
- apple_dart_dcp_dispext_window_map() maps caller-owned 16 KiB pages at
  the start of an empty window, flushes SID0 and reads every PTE back;
- apple_dart_dcp_dispext_window_unmap() checks every PTE against what was
  written, clears them all, flushes, and reads them back as invalid.

An external display DART's arena now takes up to ten free slices at
admission; it still needs only the four its retained surfaces use. Any
failure retires the whole DART, and the caller then keeps the pages until
reboot.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit b81316facb3a9ef9e17966a9b7042d7b347ef046)
---
 drivers/iommu/apple-dart-dcp-shared.h | 229 ++++++++++++++++++++++++++
 drivers/iommu/apple-dart-dcp.h        |  24 ++-
 include/linux/soc/apple/dart.h        |  25 +++
 3 files changed, 273 insertions(+), 5 deletions(-)

diff --git a/drivers/iommu/apple-dart-dcp-shared.h b/drivers/iommu/apple-dart-dcp-shared.h
index 565ec38051..f597edd6b6 100644
--- a/drivers/iommu/apple-dart-dcp-shared.h
+++ b/drivers/iommu/apple-dart-dcp-shared.h
@@ -520,6 +520,29 @@ static struct apple_dart_dcp *apple_dart_dcp_dispext_pio(struct device *piodma)
 	return pio;
 }
 
+/*
+ * The SID0 frontend of an external display DART, from its PIODMA
+ * child, once that child's check (registers, roots, ownership) passed; a
+ * failed check retires the whole DART.
+ */
+static struct apple_dart_dcp *apple_dart_dcp_dispext_sid0(struct device *piodma)
+{
+	struct apple_dart_dcp *pio = apple_dart_dcp_dispext_pio(piodma);
+	int ret;
+
+	if (!pio)
+		return NULL;
+	/* Unconfirmed power since sleep (-EAGAIN) retires nothing: it waits. */
+	ret = __apple_dart_dcp_check(piodma);
+	if (ret == -EAGAIN)
+		return NULL;
+	if (ret) {
+		apple_dart_dcp_dispext_fail(pio->dart, "the PIODMA check failed: %d", ret);
+		return NULL;
+	}
+	return pio->dart->frontend[0];
+}
+
 /*
  * J713 external DCP: with the DART's power confirmed on by the caller
  * (its firmware last powered it up, under the lock that serialises that), both
@@ -546,6 +569,192 @@ static int __apple_dart_dcp_dispext_qualify(struct device *piodma)
 	return 0;
 }
 
+/*
+ * J713 external DCP: claim a free SID0 arena slice (one not yet used
+ * by a surface, firmware-owned or holding a table) as a remappable host
+ * window at *@dva, until reboot. -ENOSPC without one.
+ */
+static int __apple_dart_dcp_dispext_window_claim(struct device *piodma, u64 *dva)
+{
+	struct apple_dart_dcp *dcp = apple_dart_dcp_dispext_sid0(piodma);
+	unsigned int root;
+	unsigned long flags;
+	int ret = -ENOSPC;
+
+	if (!dcp || !dva)
+		return -ENODEV;
+	mutex_lock(&dcp->alloc_lock);
+	/* A register mismatch retires the whole DART, see apple_dart_dcp_registers(). */
+	if (apple_dart_dispext_retired(dcp->dart) || !apple_dart_dcp_registers(dcp)) {
+		ret = -EIO;
+		goto unlock;
+	}
+	spin_lock_irqsave(&dcp->lock, flags);
+	for (root = 0; root < DCP_DART_ENTRIES; root++)
+		if (test_bit(root, dcp->arena) && !test_bit(root, dcp->claimed) &&
+		    !test_bit(root, dcp->foreign) && !dcp->entry[root] &&
+		    !READ_ONCE(dcp->root[root]))
+			break;
+	if (root != DCP_DART_ENTRIES) {
+		set_bit(root, dcp->claimed);
+		set_bit(root, dcp->shared_roots); /* Private map only, never generic unmap. */
+		set_bit(root, dcp->window);
+		*dva = DCP_DART_ALIAS + root * DCP_DART_SLICE;
+		ret = 0;
+	}
+	spin_unlock_irqrestore(&dcp->lock, flags);
+unlock:
+	mutex_unlock(&dcp->alloc_lock);
+	return ret;
+}
+
+/* The window slice at @dva, or -1 if it is none. */
+static int apple_dart_dcp_window_root(struct apple_dart_dcp *dcp, u64 dva)
+{
+	unsigned int root = (dva >> 25) & 2047;
+
+	if (!apple_dart_dcp_iova(dva) || (dva & (DCP_DART_SLICE - 1)) ||
+	    dva != DCP_DART_ALIAS + root * DCP_DART_SLICE || !test_bit(root, dcp->window) ||
+	    !test_bit(root, dcp->claimed) || !test_bit(root, dcp->arena) ||
+	    test_bit(root, dcp->foreign))
+		return -1;
+	return root;
+}
+
+/*
+ * J713 external DCP: map @count caller-owned pages (@phys, 16 KiB each)
+ * at the start of the empty window @dva; TLB flush, then every PTE read back.
+ * On any error the window and the pages stay as they are: the caller keeps
+ * the pages until reboot.
+ */
+static int __apple_dart_dcp_dispext_window_map(struct device *piodma, u64 dva,
+					       const phys_addr_t *phys, unsigned int count)
+{
+	struct apple_dart_dcp *dcp = apple_dart_dcp_dispext_sid0(piodma);
+	int root, ret;
+
+	if (!dcp)
+		return -ENODEV;
+	if (!phys || !count || count > DCP_DART_ENTRIES)
+		return -EINVAL;
+	for (unsigned int i = 0; i < count; i++)
+		if ((phys[i] & (DCP_DART_PAGE - 1)) || phys[i] >> 42)
+			return -EINVAL;
+	mutex_lock(&dcp->alloc_lock);
+	root = apple_dart_dcp_window_root(dcp, dva);
+	ret = -EINVAL;
+	if (root < 0)
+		goto unlock;
+	ret = -EIO;
+	if (apple_dart_dispext_retired(dcp->dart))
+		goto unlock;
+	if (!apple_dart_dcp_registers(dcp) || apple_dart_fault_pending(dcp->dart))
+		goto failed;
+	ret = -EBUSY;
+	for (unsigned int i = 0; dcp->expected[root] && i < DCP_DART_ENTRIES; i++)
+		if (dcp->expected[root][i])
+			goto unlock;
+	for (unsigned int i = 0; i < count; i++) {
+		size_t mapped = 0;
+
+		ret = apple_dart_dcp_map_owned(dcp, dva + (u64)i * DCP_DART_PAGE, phys[i],
+					       DCP_DART_PAGE, 1, IOMMU_READ | IOMMU_WRITE,
+					       GFP_KERNEL, &mapped, true);
+		if (!ret && mapped != DCP_DART_PAGE)
+			ret = -EIO;
+		if (ret)
+			goto failed;
+	}
+	ret = apple_dart_dcp_flush(dcp);
+	if (!ret)
+		ret = __apple_dart_dcp_check(piodma);
+	for (unsigned int i = 0; !ret && i < count; i++) {
+		u64 pte = READ_ONCE(dcp->table[root][i]);
+
+		if (apple_dart_dcp_translate(dcp, dva + (u64)i * DCP_DART_PAGE) != phys[i] ||
+		    pte != dcp->expected[root][i] || !dcp_dart_pte_frontend(pte))
+			ret = -EIO;
+	}
+	if (READ_ONCE(dcp->root[root]) != dcp->entry[root])
+		ret = -EIO;
+	if (!ret)
+		goto unlock;
+failed:
+	apple_dart_dcp_dispext_fail(dcp->dart, "window map at %#llx failed: %d", dva, ret);
+	dev_err(piodma, "SID0 window %#llx: mapping %u pages failed: %d; pages retained\n",
+		dva, count, ret);
+unlock:
+	mutex_unlock(&dcp->alloc_lock);
+	return ret;
+}
+
+/*
+ * J713 external DCP: clear every PTE of the window @dva, TLB flush,
+ * then read every one back as invalid. The number of pages unmapped, or an
+ * error, after which the window's pages must be kept until reboot (a stale
+ * translation may survive).
+ */
+static int __apple_dart_dcp_dispext_window_unmap(struct device *piodma, u64 dva)
+{
+	struct apple_dart_dcp *dcp = apple_dart_dcp_dispext_sid0(piodma);
+	unsigned long flags;
+	int root, ret, cleared = 0;
+
+	if (!dcp)
+		return -ENODEV;
+	mutex_lock(&dcp->alloc_lock);
+	root = apple_dart_dcp_window_root(dcp, dva);
+	ret = -EINVAL;
+	if (root < 0)
+		goto unlock;
+	ret = 0;
+	if (!dcp->table[root])
+		goto unlock;
+	ret = -EIO;
+	if (apple_dart_dispext_retired(dcp->dart))
+		goto unlock;
+	if (!apple_dart_dcp_registers(dcp) || apple_dart_fault_pending(dcp->dart))
+		goto failed;
+	spin_lock_irqsave(&dcp->lock, flags);
+	if (READ_ONCE(dcp->root[root]) != dcp->entry[root]) {
+		spin_unlock_irqrestore(&dcp->lock, flags);
+		goto failed;
+	}
+	for (unsigned int i = 0; i < DCP_DART_ENTRIES; i++)
+		if (READ_ONCE(dcp->table[root][i]) != dcp->expected[root][i]) {
+			spin_unlock_irqrestore(&dcp->lock, flags);
+			goto failed;
+		}
+	for (unsigned int i = 0; i < DCP_DART_ENTRIES; i++) {
+		if (!dcp->expected[root][i])
+			continue;
+		WRITE_ONCE(dcp->table[root][i], 0);
+		dcp->expected[root][i] = 0;
+		cleared++;
+	}
+	dma_wmb();
+	spin_unlock_irqrestore(&dcp->lock, flags);
+	ret = apple_dart_dcp_flush(dcp);
+	if (!ret)
+		ret = __apple_dart_dcp_check(piodma);
+	for (unsigned int i = 0; !ret && i < DCP_DART_ENTRIES; i++)
+		if (READ_ONCE(dcp->table[root][i]) ||
+		    apple_dart_dcp_translate(dcp, dva + (u64)i * DCP_DART_PAGE))
+			ret = -EIO;
+	if (!ret) {
+		ret = cleared;
+		goto unlock;
+	}
+failed:
+	if (!ret)
+		ret = -EIO;
+	apple_dart_dcp_dispext_fail(dcp->dart, "window unmap at %#llx failed: %d", dva, ret);
+	dev_err(piodma, "SID0 window %#llx: unmap failed: %d; pages retained\n", dva, ret);
+unlock:
+	mutex_unlock(&dcp->alloc_lock);
+	return ret;
+}
+
 static int __apple_dart_dcp_shared_map(struct device *dev, struct device *piodma,
 				       u64 phys, u64 dva, size_t size)
 {
@@ -668,3 +877,23 @@ int apple_dart_dcp_dispext_qualify(struct device *piodma)
 	return APPLE_DART_DISPEXT_GATED(piodma, __apple_dart_dcp_dispext_qualify(piodma));
 }
 EXPORT_SYMBOL_GPL(apple_dart_dcp_dispext_qualify);
+
+int apple_dart_dcp_dispext_window_claim(struct device *piodma, u64 *dva)
+{
+	return APPLE_DART_DISPEXT_GATED(piodma, __apple_dart_dcp_dispext_window_claim(piodma, dva));
+}
+EXPORT_SYMBOL_GPL(apple_dart_dcp_dispext_window_claim);
+
+int apple_dart_dcp_dispext_window_map(struct device *piodma, u64 dva, const phys_addr_t *phys,
+				      unsigned int count)
+{
+	return APPLE_DART_DISPEXT_GATED(piodma,
+		__apple_dart_dcp_dispext_window_map(piodma, dva, phys, count));
+}
+EXPORT_SYMBOL_GPL(apple_dart_dcp_dispext_window_map);
+
+int apple_dart_dcp_dispext_window_unmap(struct device *piodma, u64 dva)
+{
+	return APPLE_DART_DISPEXT_GATED(piodma, __apple_dart_dcp_dispext_window_unmap(piodma, dva));
+}
+EXPORT_SYMBOL_GPL(apple_dart_dcp_dispext_window_unmap);
diff --git a/drivers/iommu/apple-dart-dcp.h b/drivers/iommu/apple-dart-dcp.h
index 743f0c9490..87a35bc5ef 100644
--- a/drivers/iommu/apple-dart-dcp.h
+++ b/drivers/iommu/apple-dart-dcp.h
@@ -45,6 +45,8 @@ struct apple_dart_dcp {
 	DECLARE_BITMAP(claimed, DCP_DART_ENTRIES);
 	DECLARE_BITMAP(shared_roots, DCP_DART_ENTRIES);
 	DECLARE_BITMAP(arena, DCP_DART_ENTRIES); /* SID0 retained surfaces only. */
+	/* SID0 arena slices claimed as remappable host windows. */
+	DECLARE_BITMAP(window, DCP_DART_ENTRIES);
 	unsigned long retained; /* SID0 pages pinned after an uncertain unmap. */
 	u32 ttbr;
 	unsigned int sid;
@@ -173,6 +175,8 @@ struct apple_dart_dcp_allocation {
 
 /* SID0 slices for the retained copy surfaces; generic DMA gets the other free ones. */
 #define DCP_DART_SCANOUT_SLOTS	4
+/* An external display DART's SID0 arena: the surfaces and host windows. */
+#define DCP_DART_DISPEXT_SLOTS	10
 
 static bool apple_dart_has_borrowed(struct apple_dart *dart)
 {
@@ -356,18 +360,28 @@ static int apple_dart_dcp_excluded(struct apple_dart *dart, u64 start, u64 end)
 						"J713 DCP inherited tables");
 }
 
-/* Fixed at admission, so every reservation query reports the same SID0 slices. */
+/*
+ * Fixed at admission, so every reservation query reports the same SID0 slices.
+ * An external display DART takes up to DCP_DART_DISPEXT_SLOTS, for its host
+ * windows (direct scanout) besides the retained surfaces; it needs only
+ * DCP_DART_SCANOUT_SLOTS.
+ */
 static int apple_dart_dcp_arena(struct apple_dart_dcp *dcp)
 {
+	unsigned int want = dcp->dart->dispext ? DCP_DART_DISPEXT_SLOTS :
+			    DCP_DART_SCANOUT_SLOTS;
 	unsigned int slots = 0;
 
-	for (unsigned int i = 0; i < DCP_DART_ENTRIES && slots < DCP_DART_SCANOUT_SLOTS; i++) {
+	for (unsigned int i = 0; i < DCP_DART_ENTRIES && slots < want; i++) {
 		if (dcp->entry[i] || test_bit(i, dcp->foreign))
 			continue;
 		set_bit(i, dcp->arena);
 		slots++;
 	}
-	return slots == DCP_DART_SCANOUT_SLOTS ? 0 : -ENOSPC;
+	if (dcp->dart->dispext)
+		dev_dbg(dcp->dart->dev, "SID0 arena: %u of %u slices (%u for surfaces)\n",
+			slots, want, DCP_DART_SCANOUT_SLOTS);
+	return slots >= DCP_DART_SCANOUT_SLOTS ? 0 : -ENOSPC;
 }
 
 /* Snapshot only this consumer's real no-map reservations, before table admission. */
@@ -1423,8 +1437,8 @@ static size_t apple_dart_dcp_unmap(struct apple_dart_dcp *dcp, u64 iova,
 	 * the caller would take the IOVA as unmapped and reuse it, or free
 	 * pages still mapped. It is unreachable here: this generic path serves
 	 * only SID23 and SID0 DMA domains, and an external display DART's SID0
-	 * has no generic DMA user (its host mappings are the private scanout
-	 * APIs, which never come through here).
+	 * has no generic DMA user (its host mappings are the private window and
+	 * scanout APIs, which never come through here).
 	 */
 	if (!apple_dart_dispext_get(dcp->dart)) {
 		dev_err_ratelimited(dcp->dart->dev, "SID%u unmap at %llx while unconfirmed since sleep: refused\n",
diff --git a/include/linux/soc/apple/dart.h b/include/linux/soc/apple/dart.h
index 69c9820792..ce81d6ec5b 100644
--- a/include/linux/soc/apple/dart.h
+++ b/include/linux/soc/apple/dart.h
@@ -39,6 +39,15 @@ void *apple_dart_dcp_dispext_scanout_alloc(struct device *piodma, size_t size, u
 /* An adopted external display DART's state after its power-up; reads only. */
 int apple_dart_dcp_dispext_state(struct device_node *consumer);
 
+/*
+ * Remappable host windows in SID0 of an external display DART: one
+ * whole arena slice each, claimed until reboot, mapped and unmapped by the
+ * host only (every change flushed and read back). Pages are the caller's.
+ */
+int apple_dart_dcp_dispext_window_claim(struct device *piodma, u64 *dva);
+int apple_dart_dcp_dispext_window_map(struct device *piodma, u64 dva, const phys_addr_t *phys,
+				      unsigned int count);
+int apple_dart_dcp_dispext_window_unmap(struct device *piodma, u64 dva);
 /* Power confirmed on by the caller: both frontends as adopted, no fault. */
 int apple_dart_dcp_dispext_qualify(struct device *piodma);
 
@@ -83,6 +92,22 @@ static inline int apple_dart_dcp_dispext_state(struct device_node *consumer)
 	return -EOPNOTSUPP;
 }
 
+static inline int apple_dart_dcp_dispext_window_claim(struct device *piodma, u64 *dva)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline int apple_dart_dcp_dispext_window_map(struct device *piodma, u64 dva,
+						    const phys_addr_t *phys, unsigned int count)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline int apple_dart_dcp_dispext_window_unmap(struct device *piodma, u64 dva)
+{
+	return -EOPNOTSUPP;
+}
+
 static inline int apple_dart_dcp_dispext_qualify(struct device *piodma)
 {
 	return -EOPNOTSUPP;
