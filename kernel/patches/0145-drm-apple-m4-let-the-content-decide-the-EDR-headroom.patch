From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 9 Nov 2026 00:23:37 +0000
Subject: [PATCH] drm/apple: m4: let the content decide the EDR
 headroom

An EDR swap on the T8132 panel asks for the panel's whole headroom
whenever the frame is PQ: SDR white times peak / SDR white, up to the
ADT ceiling. That suits a compositor that turns PQ on for one
fullscreen HDR window only. A compositor that keeps the panel in PQ
all the time, as macOS keeps it in EDR, would hold the backlight at
the panel's peak for an SDR desktop and scale every frame down.

The firmware shows PQ n nits at n / 100 of SDR white, so content whose
brightest pixel is MaxCLL nits needs headroom MaxCLL / 100. Add
dcp_m4_edr_content(): that, between 1.0 and what the panel allows,
and the panel's bound as before when MaxCLL is 0 (not given).
dcp_m4_edr_step() takes it from the new cll field of its state. An SDR
desktop kept in PQ with MaxCLL 100 then runs at headroom 1.0: the
panel at SDR white, the scale at 1. KUnit cases for the helper and
for a ramp that follows the content up and back down.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/gpu/drm/apple/dcp-m4-edr-test.c | 64 ++++++++++++++++++++++++-
 drivers/gpu/drm/apple/dcp-m4-edr.h      | 32 ++++++++++++-
 2 files changed, 93 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-m4-edr-test.c b/drivers/gpu/drm/apple/dcp-m4-edr-test.c
index 72b511fbce..e292488001 100644
--- a/drivers/gpu/drm/apple/dcp-m4-edr-test.c
+++ b/drivers/gpu/drm/apple/dcp-m4-edr-test.c
@@ -5,7 +5,8 @@
  * values: a 1600 nit peak (LmaxProduct), a potential headroom of 16.0, a 600
  * nit SDR maximum.  The binary64 encoding, where each word lands in the
  * record, the start ramp, a brightness change during EDR, the end of EDR in
- * one swap, the ramp after a blank, and that SDR frames carry nothing.
+ * one swap, the ramp after a blank, that SDR frames carry nothing, and that
+ * the headroom follows the content's MaxCLL.
  */
 
 #include <kunit/test.h>
@@ -177,6 +178,65 @@ static void edr_restart_and_unlit(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, st.restart);
 }
 
+/* MaxCLL over PQ 100 (SDR white), within [1.0, the bound]; 0: the bound. */
+static void edr_content_headroom(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 0), 16000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(3333, 0), 3333U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 100), 1000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 80), 1000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 1), 1000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 203), 2030U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 1000), 10000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(3333, 1000), 3333U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(16000, 65535), 16000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(1000, 400), 1000U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_edr_content(0, 400), 1000U);
+}
+
+/*
+ * An SDR desktop kept in PQ (MaxCLL at SDR white) runs at H 1.0: the panel
+ * level is SDR white and the scale 1, as without EDR.  HDR content raises H
+ * to what it needs, in steps; when it goes, H is 1.0 again in one swap while
+ * the frames stay PQ.
+ */
+static void edr_follows_the_content(struct kunit *test)
+{
+	struct dcp_m4_edr_state st = { .cll = 100 };
+	struct dcp_m4_edr_words w;
+
+	KUNIT_ASSERT_TRUE(test, dcp_m4_edr_step(&st, true, false, 480, J604_PEAK,
+						J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, w.hm, 1000U);
+	KUNIT_EXPECT_EQ(test, w.used, 1000U);
+	KUNIT_EXPECT_EQ(test, w.nits, 480U);
+	KUNIT_EXPECT_EQ(test, w.limit, 0U);
+	KUNIT_EXPECT_TRUE(test, st.sent);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_edr_step(&st, true, false, 480, J604_PEAK,
+						 J604_CEILING, &w));
+	/* A 1000 nit clip at 140 nits SDR white: H 10.0, below the peak's 11.428. */
+	st.cll = 1000;
+	edr_settle(&st, 140);
+	KUNIT_EXPECT_EQ(test, st.hm, 10000U);
+	/* Brighter than the panel: the peak bounds it, as before. */
+	st.cll = 4000;
+	edr_settle(&st, 140);
+	KUNIT_EXPECT_EQ(test, st.hm, 11428U);
+	/* The clip goes, the desktop stays PQ: H 1.0 in one swap. */
+	st.cll = 100;
+	KUNIT_ASSERT_TRUE(test, dcp_m4_edr_step(&st, true, false, 140, J604_PEAK,
+						J604_CEILING, &w));
+	KUNIT_EXPECT_EQ(test, w.hm, 1000U);
+	KUNIT_EXPECT_EQ(test, w.used, 1000U);
+	KUNIT_EXPECT_EQ(test, w.nits, 140U);
+	KUNIT_EXPECT_EQ(test, st.hm, 1000U);
+	KUNIT_EXPECT_TRUE(test, st.sent);
+	/* No MaxCLL: the bound, as before this change. */
+	st.cll = 0;
+	edr_settle(&st, 140);
+	KUNIT_EXPECT_EQ(test, st.hm, 11428U);
+}
+
 /* Bright surroundings: the user's 600 nit full scale shows the ADT 1001. */
 static void boost_scales_the_user_level(struct kunit *test)
 {
@@ -207,6 +267,8 @@ static struct kunit_case m4_edr_cases[] = {
 	KUNIT_CASE(edr_brightness_change),
 	KUNIT_CASE(edr_ends_in_one_swap),
 	KUNIT_CASE(edr_restart_and_unlit),
+	KUNIT_CASE(edr_content_headroom),
+	KUNIT_CASE(edr_follows_the_content),
 	KUNIT_CASE(boost_scales_the_user_level),
 	{}
 };
diff --git a/drivers/gpu/drm/apple/dcp-m4-edr.h b/drivers/gpu/drm/apple/dcp-m4-edr.h
index 4858c57e6b..864509b8fc 100644
--- a/drivers/gpu/drm/apple/dcp-m4-edr.h
+++ b/drivers/gpu/drm/apple/dcp-m4-edr.h
@@ -89,14 +89,42 @@ struct dcp_m4_edr_words {
 struct dcp_m4_edr_state {
 	u32 hm;		/* applied headroom x1000; 0: none, the firmware's values */
 	u32 sdr;	/* SDR white of the last EDR swap */
+	u32 cll;	/* MaxCLL of the frames in nits; 0: not given */
 	bool sent;	/* swaps carry headroom used */
 	bool restart;	/* the next EDR ramp starts again from 1.0 */
 };
 
+/*
+ * The firmware shows PQ n nits at n / 100 of SDR white (above), so PQ 100 is
+ * SDR white, and content whose brightest pixel is @cll nits (the MaxCLL of
+ * HDR_OUTPUT_METADATA) needs headroom @cll / 100.  The headroom of a frame is
+ * that, within [1.0, @bound], @bound being what the panel allows
+ * (dcp_edr_target()).  0: the compositor gave no MaxCLL, so @bound, as before.
+ * A compositor that keeps an SDR desktop in PQ and sends MaxCLL 100 or less
+ * keeps the panel at SDR white with the scale at 1, as without EDR, and the
+ * headroom rises only while brighter content is on screen.
+ */
+#define DCP_M4_EDR_SDR_PQ_NITS		100U
+
+static inline u32 dcp_m4_edr_content(u32 bound, u32 cll)
+{
+	u64 hm;
+
+	if (!cll)
+		return bound;
+	hm = div_u64((u64)cll * DCP_EDR_UNITY, DCP_M4_EDR_SDR_PQ_NITS);
+	if (hm > bound)
+		hm = bound;
+	if (hm < DCP_EDR_UNITY)
+		hm = DCP_EDR_UNITY;
+	return hm;
+}
+
 /*
  * dcp_edr_prepare() for one present.  @edr: the frame is BT.2020 PQ shown as
  * EDR; @carries: the swap carries a new SDR white @sdr, otherwise @sdr is the
- * level that stands.  Returns true with @w set when the swap carries words.
+ * level that stands; @st->cll the content's MaxCLL (dcp_m4_edr_content()).
+ * Returns true with @w set when the swap carries words.
  */
 static inline bool dcp_m4_edr_step(struct dcp_m4_edr_state *st, bool edr, bool carries,
 				   u32 sdr, u32 peak, u32 ceiling,
@@ -112,7 +140,7 @@ static inline bool dcp_m4_edr_step(struct dcp_m4_edr_state *st, bool edr, bool c
 	if (!sdr)
 		return false;	/* off: a swap that turns the panel off keeps its zero */
 	if (edr)
-		target = dcp_edr_target(peak, sdr, ceiling);
+		target = dcp_m4_edr_content(dcp_edr_target(peak, sdr, ceiling), st->cll);
 	if (restart && edr) {
 		cur = DCP_EDR_UNITY;
 		prev_sdr = sdr;
