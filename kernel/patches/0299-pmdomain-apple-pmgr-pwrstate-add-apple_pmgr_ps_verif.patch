From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Tue, 10 Nov 2026 00:00:20 -0500
Subject: [PATCH] pmdomain: apple: pmgr-pwrstate: add
 apple_pmgr_ps_verify_state()

A driver that takes its power domains down and up itself around a
system sleep, through the genpd suspend and resume helpers, has to know
that each one really reached the state it asked for before it goes on:
the next step either removes power from, or touches, the block behind
it. Add a helper that polls the state word of a virtual power-domain
device for fully on or fully off.

It refuses a device whose power domain is not a genpd, and firmware-owned
and inherited-on states, which the driver does not control.

Signed-off-by: Erik Bourget <erik@ebourget.net>
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit ce2d7ead7f3ab1786f08cf2f38a7f95ffd620667)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/pmdomain/apple/pmgr-pwrstate.c  | 32 +++++++++++++++++++++++++
 include/linux/soc/apple/pmgr-pwrstate.h | 18 ++++----------
 2 files changed, 37 insertions(+), 13 deletions(-)

diff --git a/drivers/pmdomain/apple/pmgr-pwrstate.c b/drivers/pmdomain/apple/pmgr-pwrstate.c
index 9236f0a860..cfc8c520d8 100644
--- a/drivers/pmdomain/apple/pmgr-pwrstate.c
+++ b/drivers/pmdomain/apple/pmgr-pwrstate.c
@@ -447,6 +447,37 @@ static int apple_pmgr_ps_power_off(struct generic_pm_domain *genpd)
 	return ret;
 }
 
+/* genpd's runtime suspend callback, as it installs it in every genpd's dev_pm_domain. */
+static int (*apple_pmgr_genpd_runtime_suspend)(struct device *dev);
+
+/* Check the physical result of genpd's void syscore suspend/resume helpers. */
+int apple_pmgr_ps_verify_state(struct device *domain_dev, bool on)
+{
+	int (*genpd_suspend)(struct device *dev) = READ_ONCE(apple_pmgr_genpd_runtime_suspend);
+	struct generic_pm_domain *genpd;
+	struct apple_pmgr_ps *ps;
+	u32 value, mask = APPLE_PMGR_PS_LEVELS | APPLE_PMGR_BUSY |
+			  APPLE_PMGR_RESET | APPLE_PMGR_PS_RESET | APPLE_PMGR_DEV_DISABLE;
+
+	/* Only a genpd's dev_pm_domain is embedded in one: anything else is refused. */
+	if (!domain_dev->pm_domain || !genpd_suspend ||
+	    domain_dev->pm_domain->ops.runtime_suspend != genpd_suspend)
+		return -EINVAL;
+	genpd = pd_to_genpd(domain_dev->pm_domain);
+	if (genpd->power_on != apple_pmgr_ps_power_on ||
+	    !(genpd->flags & GENPD_FLAG_IRQ_SAFE))
+		return -EOPNOTSUPP;
+	ps = genpd_to_apple_pmgr_ps(genpd);
+	if (ps->firmware_owned || ps->inherited_on)
+		return -EPERM;
+	if (!on)
+		mask |= APPLE_PMGR_AUTO_ENABLE;
+	return regmap_read_poll_timeout_atomic(ps->regmap, ps->offset, value,
+					      (value & mask) == (on ? APPLE_PMGR_PS_ALL_ON : 0),
+					      1, APPLE_PMGR_PS_PARENT_TIMEOUT);
+}
+EXPORT_SYMBOL_GPL(apple_pmgr_ps_verify_state);
+
 /**
  * apple_pmgr_ps_cycle() - power gate a domain and turn it on again
  * @np: the power state node, as named by a consumer's power-domains
@@ -995,6 +1026,7 @@ static int apple_pmgr_ps_probe(struct platform_device *pdev)
 		dev_err(dev, "pm_genpd_init failed\n");
 		return ret;
 	}
+	WRITE_ONCE(apple_pmgr_genpd_runtime_suspend, ps->genpd.domain.ops.runtime_suspend);
 
 	ret = of_genpd_add_provider_simple(node, &ps->genpd);
 	if (ret < 0) {
diff --git a/include/linux/soc/apple/pmgr-pwrstate.h b/include/linux/soc/apple/pmgr-pwrstate.h
index a52b9c0602..fdf852b475 100644
--- a/include/linux/soc/apple/pmgr-pwrstate.h
+++ b/include/linux/soc/apple/pmgr-pwrstate.h
@@ -8,17 +8,8 @@ struct device;
 struct device_node;
 
 #if IS_ENABLED(CONFIG_APPLE_PMGR_PWRSTATE)
-/*
- * Power off (child first) or on (parent first) the chain of
- * apple,consumer-switched power states that starts at @consumer's power
- * domain. The consumer has stopped its coprocessor before power-off and
- * starts it again after power-on. The check says, changing nothing, whether
- * the power-off can run now.
- */
-int apple_pmgr_ps_consumer_check(struct device *consumer);
-int apple_pmgr_ps_consumer_off(struct device *consumer);
-int apple_pmgr_ps_consumer_on(struct device *consumer);
 int apple_pmgr_ps_cycle(struct device_node *np);
+int apple_pmgr_ps_verify_state(struct device *domain_dev, bool on);
 /*
  * Power off (child first) or on (parent first) the chain of
  * apple,consumer-switched power states that starts at @consumer's power
@@ -30,9 +21,10 @@ int apple_pmgr_ps_consumer_check(struct device *consumer);
 int apple_pmgr_ps_consumer_off(struct device *consumer);
 int apple_pmgr_ps_consumer_on(struct device *consumer);
 #else
-static inline int apple_pmgr_ps_consumer_check(struct device *consumer) { return -EOPNOTSUPP; }
-static inline int apple_pmgr_ps_consumer_off(struct device *consumer) { return -EOPNOTSUPP; }
-static inline int apple_pmgr_ps_consumer_on(struct device *consumer) { return -EOPNOTSUPP; }
+static inline int apple_pmgr_ps_verify_state(struct device *domain_dev, bool on)
+{
+	return -EOPNOTSUPP;
+}
 static inline int apple_pmgr_ps_cycle(struct device_node *np) { return -EOPNOTSUPP; }
 static inline int apple_pmgr_ps_consumer_check(struct device *consumer) { return -EOPNOTSUPP; }
 static inline int apple_pmgr_ps_consumer_off(struct device *consumer) { return -EOPNOTSUPP; }
-- 
