+                assert!(!t.is_empty(), "queue {q} took no command");
+                let want: Vec<u32> = (1..=t.len() as u64).map(stamp).collect();
+                assert_eq!(*t, want, "queue {q} of {queues}: one step per command");
+            }
         }
-        assert!(!logic::last_retired_target(&last, 0x13, 0x500));
+        // One queue: exactly the shared numbering of before.
+        assert_eq!(targets(1, 23, false), targets(1, 23, true));
+        // Negative control: one shared ordinal makes both queues' stamps skip values.
+        let old = targets(2, 6, true);
+        assert_eq!(old[1], [stamp(1), stamp(3), stamp(5)]);
+        assert_eq!(old[0], [stamp(2), stamp(4), stamp(6)]);
     }
 
     #[test]
