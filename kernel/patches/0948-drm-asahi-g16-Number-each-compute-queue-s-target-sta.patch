+    /// The targets each queue's commands carry when `count` independent commands are placed
+    /// behind running work on `queues` queues, numbered per queue (as the engine does) or from
+    /// one shared ordinal (as 1.1071 did).
+    fn targets(queues: usize, count: usize, shared: bool) -> Vec<Vec<u32>> {
+        let registered = [true; QUEUES_MAX];
+        let (mut ordinal, mut others) = (0u64, [0u64; QUEUES_MAX]);
+        let mut last = 0;
+        let mut out = vec![Vec::new(); queues];
+        for _ in 0..count {
+            let Place::Queue(q) = place(&st(queues, last, &registered[..queues], true)) else {
+                panic!("an independent command waited");
+            };
+            let from = if shared {
+                ordinal
+            } else {
+                last_ordinal(q, ordinal, &others)
+            };
+            let n = logic::next_ordinal(from).unwrap();
+            if shared {
+                ordinal = n;
+            } else {
+                set_last_ordinal(q, n, &mut ordinal, &mut others);
+            }
+            out[q].push(stamp(n));
+            last = q;
+        }
+        out
+    }
+
