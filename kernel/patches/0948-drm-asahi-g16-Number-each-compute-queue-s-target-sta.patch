+/// Entries of the last complete receipts: compute queue 0, TA, FS, then compute queues 1 to 3
+/// (`g16_compute_queues`), which count their own ordinals.
+pub(crate) const LAST_RETIRED: usize = 6;
+
+/// The entry of compute queue `q` (0 to 3) among the last complete receipts.
+pub(crate) const fn last_retired_compute(q: usize) -> usize {
+    match q % 4 {
+        0 => 0,
+        q => q + 2,
+    }
+}
