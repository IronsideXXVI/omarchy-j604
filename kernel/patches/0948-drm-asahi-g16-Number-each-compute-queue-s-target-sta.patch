+/// The last compute ordinal of compute queue `q`: queue 0's is the engine's `ordinal`, as with
+/// one queue, and queue 1.. keep theirs in `others` (index 0 unused). A command's stamp target
+/// is its ordinal times 0x100, so with one ordinal per queue each queue's stamp advances by one
+/// step per command of that queue. With one ordinal for all queues, queue 1's stamp skipped
+/// every ordinal queue 0 took, and the firmware stopped with "DAG: Non Sequential Stamp
+/// Updates" on queue 1's stamp (1.1071, two queues).
+pub(crate) fn last_ordinal(q: usize, ordinal: u64, others: &[u64; QUEUES_MAX]) -> u64 {
+    match q % QUEUES_MAX {
+        0 => ordinal,
+        q => others[q],
+    }
+}
+
+/// Records `n` as the last compute ordinal of compute queue `q` (see [`last_ordinal`]).
+pub(crate) fn set_last_ordinal(
+    q: usize,
+    n: u64,
+    ordinal: &mut u64,
+    others: &mut [u64; QUEUES_MAX],
+) {
+    match q % QUEUES_MAX {
+        0 => *ordinal = n,
+        q => others[q] = n,
+    }
+}
+
