From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 07:42:06 +0000
Subject: [PATCH] pmdomain: apple: pmp-report: hold the T8132 GFX power
 request as macOS does

macOS 26B123 on the J604 keeps PS-REQ bit 12 set for the whole run: in a hypervisor trace of
86 s its request word reads 0x209000 or 0x309000 at every write. Bit 12 is AGX's position in
the ADT's soc-device table (device ID 5, record 12 of 34). Its GPU firmware powers GFX down
about ten times a second at idle; ours, with bit 12 clear and only the PMP mailbox's AGX
request, never does.

Hold bit 12 once the PMP runs, without an acknowledgement (macOS never reads it on this
SoC), behind t8132_gfx_request (default on, read at probe); the request shadow keeps it
across a wake. 0 leaves the bit clear.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/pmdomain/apple/pmp-report.c | 36 +++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/drivers/pmdomain/apple/pmp-report.c b/drivers/pmdomain/apple/pmp-report.c
index f31a852504..a1a2554302 100644
--- a/drivers/pmdomain/apple/pmp-report.c
+++ b/drivers/pmdomain/apple/pmp-report.c
@@ -192,6 +192,7 @@ static const struct apple_pmp_report_offsets apple_pmp_offsets_t600x;
 static const struct apple_pmp_report_offsets apple_pmp_offsets_t8132;
 static void apple_pmp_report_dvfs_write(struct apple_pmp_report *rep, u32 entry, u64 val);
 static void apple_pmp_report_dvfs_write_locked(struct apple_pmp_report *rep, u32 entry, u64 val);
+static int apple_pmp_report_set_state(struct apple_pmp_report *rep, u32 id, bool enable, bool no_ack);
 
 /* T6001 AGX request (see the engine below set_state): AGX is soc-device record 9 on the T6001. */
 #define APPLE_PMP_T6001_AGX_ID 9
@@ -492,6 +493,36 @@ static void apple_pmp_report_t8132_dvfs_trial(struct apple_pmp_report *rep)
 		 t8132_dvfs_entry, t8132_dvfs_entry, word);
 }
 
+/*
+ * T8132 GFX power request (default on). macOS 26B123 holds PS-REQ bit 12 for the whole run (hypervisor
+ * trace of the J604, list 14: the request word reads 0x209000 or 0x309000 in all 3 writes of 86 s, GFX,
+ * DISP and MSR held, AVD toggling), and bit 12 is AGX's position in the ADT's soc-device table (device
+ * ID 5, record 12 of 34). Its GPU firmware powers GFX down about ten times a second at idle; ours, with
+ * only the PMP mailbox's AGX request (pmp-display) and bit 12 clear, never does. Hold the bit once the
+ * PMP runs, without waiting for an acknowledgement (macOS never reads it on this SoC). The shadow keeps
+ * it across a system sleep's wake. 0 leaves bit 12 clear, as before.
+ */
+#define PMP_T8132_GFX_REQUEST_BIT	12
+static bool t8132_gfx_request = true;
+module_param(t8132_gfx_request, bool, 0444);
+MODULE_PARM_DESC(t8132_gfx_request,
+		 "T8132: hold the GFX power request (PS-REQ bit 12) as macOS does (default on; 0: bit 12 clear, as before)");
+
+static void apple_pmp_report_t8132_gfx_request(struct apple_pmp_report *rep)
+{
+	int ret;
+
+	if (rep->offsets != &apple_pmp_offsets_t8132 || !t8132_gfx_request)
+		return;
+	ret = apple_pmp_report_set_state(rep, PMP_T8132_GFX_REQUEST_BIT, true, true);
+	if (ret)
+		dev_warn(rep->dev, "t8132: GFX power request (PS-REQ bit %d) not held: %d\n",
+			 PMP_T8132_GFX_REQUEST_BIT, ret);
+	else
+		dev_info(rep->dev, "t8132: GFX power request (PS-REQ bit %d) held as macOS\n",
+			 PMP_T8132_GFX_REQUEST_BIT);
+}
+
 /*
  * T8132 memory bandwidth vote (default off). Under a CPU memory load macOS
  * writes SOC-DEV-DVFS entries 409 and 411, always as a pair, at main level
@@ -2529,6 +2560,11 @@ static int apple_pmp_report_probe(struct platform_device *pdev)
 	else if (t8132_dvfs_entry && rep->offsets == &apple_pmp_offsets_t8132)
 		dev_warn(dev, "t8132 DVFS trial: PMP not running at probe, not applied\n");
 
+	if (!rep->defer && apple_pmp_report_running(rep))
+		apple_pmp_report_t8132_gfx_request(rep);
+	else if (t8132_gfx_request && rep->offsets == &apple_pmp_offsets_t8132)
+		dev_warn(dev, "t8132: PMP not running at probe, GFX power request not held\n");
+
 	return 0;
 }
 
