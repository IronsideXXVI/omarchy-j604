From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 12:45:59 +0000
Subject: [PATCH] soc: apple: sleep: let a T8132 sleep skip the boot
 object's DRAM check

The boot object checks the wake ranges the kernel names (the resume
stub, the saved context, a pattern and the stash) before it takes
resume_pa, whenever the kernel arms that check at the commit. Add
t8132_dram_check (default on, as today) so a run can leave it out.
Off, the check is disarmed explicitly: the boot object clears the magic
only after a check it ran, so one armed for an earlier, aborted sleep
would otherwise survive into this wake with stale ranges.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/sleep.c | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index e1ec3893ec..9cb5cce6dd 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -4178,6 +4178,15 @@ static void t8132_el_check_report(struct apple_sleep *s)
 		 t8132_elchk2_text_len(), t8132_elchk2 ? "on" : "off");
 }
 
+/*
+ * r7: aura CRCs the wake ranges before it takes resume_pa. Off: disarmed, and aura
+ * resumes unchecked.
+ */
+static bool t8132_dram_check = true;
+module_param(t8132_dram_check, bool, 0644);
+MODULE_PARM_DESC(t8132_dram_check,
+		 "T8132: have the boot object check the wake ranges in DRAM before it resumes (default: on)");
+
 static bool t8132_cpu_perf_down = true;
 module_param(t8132_cpu_perf_down, bool, 0644);
 MODULE_PARM_DESC(t8132_cpu_perf_down,
@@ -4334,7 +4343,15 @@ static int t8132_sleep_commit(unsigned long unused)
 	WRITE_ONCE(arm64_resume_armed, 1);
 	dcache_clean_poc((unsigned long)&arm64_resume_armed,
 			 (unsigned long)(&arm64_resume_armed + 1));
-	t8132_arm_dram_check(s);
+	if (READ_ONCE(t8132_dram_check)) {
+		t8132_arm_dram_check(s);
+	} else if (s->mbox_check) {
+		/* One armed for an earlier, aborted sleep must not survive into this wake. */
+		WRITE_ONCE(s->mbox_check->magic, 0);
+		dcache_clean_poc((unsigned long)s->mbox,
+				 (unsigned long)s->mbox + AURA_S2R_CHECKED_SIZE);
+		s->check_ranges = 0;
+	}
 	t8132_arm_el_check();
 	t8132_arm_el_check2();
 	t8132_arm_stubcfg();
-- 
