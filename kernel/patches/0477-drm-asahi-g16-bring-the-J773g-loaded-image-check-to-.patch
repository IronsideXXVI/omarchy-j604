From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 10:28:37 +0000
Subject: [PATCH] drm/asahi: g16: bring the J773g loaded-image check to
 #1191's final revision

Bring to its revision in aurora-silicon/linux#1191:
commit 1c60450bf5 ("drm/asahi: g16: Accept the J773g loaded 25G83
image").
This tree carried an earlier revision from aurora-silicon/linux#1718:
commit 9b49d76db4 ("drm/asahi: g16: Accept the J773g loaded 25G83
image").
Only the difference between the two: the comment names the DILS record
at 0x5c90f, whose 8 rewritten bytes at 0x5c917 are unchanged, and the
tests check that the other builds have no boot-filled ranges and find
the J773g build by identity. No runtime change.

Based on 1c60450bf5 from aurora-silicon/linux#1191
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/fwid.rs   | 4 +++-
 drivers/gpu/drm/asahi/g16/hw.rs | 6 +++---
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/asahi/fwid.rs b/drivers/gpu/drm/asahi/fwid.rs
index 7b63124c4b..44ec1d04c1 100644
--- a/drivers/gpu/drm/asahi/fwid.rs
+++ b/drivers/gpu/drm/asahi/fwid.rs
@@ -535,6 +535,7 @@ fn j713_accepts_both_loaded_images() {
         for (i, digest) in digests.into_iter().enumerate() {
             let found = measured(builds, 0x13c000, &[[0x5c8df, 0x5c9c2]], digest).unwrap();
             assert!(core::ptr::eq(found, &builds[i]));
+            assert!(builds[i].boot_filled.is_empty());
             assert!(measured(builds, 0x138000, &[[0x5c8df, 0x5c9c2]], digest).is_none());
         }
         assert!(measured(builds, 0x13c000, &[[0x5c8df, 0x5c9c2]], [0; 32]).is_none());
@@ -550,7 +551,8 @@ fn j773g_accepts_its_loaded_image() {
             0x40, 0xd3, 0xe8, 0x5a,
         ];
         let found = measured(builds, 0x13c000, &[[0x5c8df, 0x5c9c2]], digest).unwrap();
-        assert_eq!(found.name, "Apple GFX 25G83 (normalized loaded image, J773g)");
+        assert!(core::ptr::eq(found, &builds[2]));
+        // The header word and the DILS record's 8 bytes, outside both entropy records.
         assert_eq!(found.boot_filled, &[(0x224, 4), (0x5c917, 8)]);
         assert!(measured(builds, 0x138000, &[[0x5c8df, 0x5c9c2]], digest).is_none());
     }
diff --git a/drivers/gpu/drm/asahi/g16/hw.rs b/drivers/gpu/drm/asahi/g16/hw.rs
index 75df601667..7a013707ed 100644
--- a/drivers/gpu/drm/asahi/g16/hw.rs
+++ b/drivers/gpu/drm/asahi/g16/hw.rs
@@ -65,9 +65,9 @@ pub(crate) mod t8132 {
                 ],
             },
             FirmwareBuild {
-                // The 25G83 image as loaded by iBoot on a J773g (Mac mini). iBoot rewrites
-                // the header word at 0x224 and the 8-byte DILS payload at 0x5c917 on every
-                // boot there; they are zeroed before hashing.
+                // The 25G83 image as loaded by iBoot on a J773g (Mac mini). iBoot also rewrites
+                // the header word at 0x224 and the 8 bytes of the DILS record at 0x5c90f on
+                // every boot there; they are zeroed before hashing.
                 name: "Apple GFX 25G83 (normalized loaded image, J773g)",
                 text_size: 0x60000,
                 data_size: 0x13c000,
-- 
2.43.0

