From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 19:26:24 +0000
Subject: [PATCH] dmaengine: apple-sio: start the T8132 SIO on protocol 10 only

The T8132 SIO (apple,t8132-sio) had no driver path: its node stayed
disabled. m1n1 now builds its boot tables in the T6030's protocol-10
layout from the J604 ADT, whose SIO node carries the same records (DMA
shims SSPI, SUAR, SAUD; device types dSPI, dUAR, dDPA) with the firmware
pre-loaded.

Which protocol the T8132 firmware speaks is not known before it runs. It
reports it in its start message, before the driver sends any table. Add
APPLE_SIO_T8132 (on top of APPLE_SIO_T6030, default y): a T8132 SIO goes
through the protocol-10 boot-table check before any hardware access, as a
T6030 does, records the protocol from the start message, and is stopped
again with "SIO protocol vN, boot tables for protocol 10; leaving the
SIO stopped" unless N is 10. Without the option a T8132 SIO is left
stopped, as a T6030 is without APPLE_SIO_T6030.

Descriptors are published whole on both protocol-10 SoCs. The DisplayPort
audio FIFO threshold stays at 0x800 on the T8132: the J604 ADT records
dp-audio0/1 with FIFO 0x800 and threshold 0x800 (channels 0x64, 0x66);
only the T6030 refills at 0x600.

KUnit: the probe test gains T8132 nodes with protocol-10 and earlier
tables (taken with the option, refused before DMA setup without it), and
a protocol test: a T8132 goes on with 10 only (not 9, 11 or no start
message); other SIOs whatever they report.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/dma/Kconfig                   | 18 +++++++-
 drivers/dma/apple-sio-probe-test.c    | 59 ++++++++++++++++++++++----
 drivers/dma/apple-sio-probe-test.dtso | 32 +++++++++++++-
 drivers/dma/apple-sio.c               | 61 +++++++++++++++++++++++++--
 4 files changed, 155 insertions(+), 15 deletions(-)

diff --git a/drivers/dma/Kconfig b/drivers/dma/Kconfig
index 94f9c2e286..5d91735d44 100644
--- a/drivers/dma/Kconfig
+++ b/drivers/dma/Kconfig
@@ -112,8 +112,9 @@ config APPLE_SIO_KUNIT_TEST
 	help
 	  Check which SIO device-tree nodes the probe goes on with: the
 	  generic SIO of the M1 and M2 in every configuration, and a T6030
-	  SIO only with APPLE_SIO_T6030 and protocol-10 boot tables. Run it
-	  both with and without APPLE_SIO_T6030.
+	  or T8132 SIO only with its support built and protocol-10 boot
+	  tables; and which firmware protocols a started SIO goes on with.
+	  Run it with and without APPLE_SIO_T6030 and APPLE_SIO_T8132.
 
 config APPLE_SIO_T6030
 	bool "Apple SIO on the M3 Pro (T6030)"
@@ -128,6 +129,19 @@ config APPLE_SIO_T6030
 	  are protocol-10 tables, which a boot loader without T6030 support
 	  does not build. Without this option a T6030 SIO is left stopped.
 
+config APPLE_SIO_T8132
+	bool "Apple SIO on the M4 (T8132)"
+	depends on APPLE_SIO_T6030
+	default y
+	help
+	  Start the SIO of the T8132 (apple,t8132-sio) with the protocol-10
+	  boot tables its boot loader builds, as for the T6030, once their
+	  layout checks out and only when the firmware reports protocol 10
+	  as it starts; otherwise the SIO is stopped again and the reported
+	  protocol logged. Its DisplayPort audio channels keep the 0x800-byte
+	  threshold its system device tree records. Without this option a
+	  T8132 SIO is left stopped.
+
 config APPLE_SIO_T6030_KUNIT_TEST
 	bool "KUnit tests for the T6030 SIO boot-table check" if !KUNIT_ALL_TESTS
 	depends on APPLE_SIO=y && APPLE_SIO_T6030 && KUNIT=y
diff --git a/drivers/dma/apple-sio-probe-test.c b/drivers/dma/apple-sio-probe-test.c
index 7049c8acb5..e817db5b20 100644
--- a/drivers/dma/apple-sio-probe-test.c
+++ b/drivers/dma/apple-sio-probe-test.c
@@ -1,10 +1,12 @@
 // SPDX-License-Identifier: GPL-2.0-only OR MIT
 /*
  * Included by apple-sio.c: which SIO nodes the probe goes on with, with and
- * without APPLE_SIO_T6030. The test devices have no register range, so a probe
- * that goes on toward the hardware stops there with -EINVAL; a refused node
- * returns -ENODEV first.
+ * without APPLE_SIO_T6030 and APPLE_SIO_T8132. The test devices have no
+ * register range, so a probe that goes on toward the hardware stops there with
+ * -EINVAL; a refused node returns -ENODEV first. Then which protocols a started
+ * SIO goes on with.
  */
+#include <kunit/device.h>
 #include <kunit/of.h>
 #include <kunit/platform_device.h>
 #include <kunit/test.h>
@@ -14,15 +16,20 @@ OF_OVERLAY_DECLARE(apple_sio_probe_test);
 static void sio_probe_nodes_test(struct kunit *test)
 {
 	const bool t6030 = IS_ENABLED(CONFIG_APPLE_SIO_T6030);
+	const bool t8132 = IS_ENABLED(CONFIG_APPLE_SIO_T8132);
 	const struct {
 		const char *path;
 		int err;
+		bool unbuilt;
 	} cases[] = {
 		/* M1/M2: the generic SIO, either way */
-		{ "/sio-probe-test/sio-probe-test-t8103", -EINVAL },
+		{ "/sio-probe-test/sio-probe-test-t8103", -EINVAL, false },
 		/* T6030: only with its support built, and with protocol-10 tables */
-		{ "/sio-probe-test/sio-probe-test-t6030-v10", t6030 ? -EINVAL : -ENODEV },
-		{ "/sio-probe-test/sio-probe-test-t6030-earlier", -ENODEV },
+		{ "/sio-probe-test/sio-probe-test-t6030-v10", t6030 ? -EINVAL : -ENODEV, !t6030 },
+		{ "/sio-probe-test/sio-probe-test-t6030-earlier", -ENODEV, !t6030 },
+		/* T8132: the same, with its own support */
+		{ "/sio-probe-test/sio-probe-test-t8132-v10", t8132 ? -EINVAL : -ENODEV, !t8132 },
+		{ "/sio-probe-test/sio-probe-test-t8132-earlier", -ENODEV, !t8132 },
 	};
 	unsigned int i;
 
@@ -38,15 +45,51 @@ static void sio_probe_nodes_test(struct kunit *test)
 		KUNIT_ASSERT_NOT_NULL_MSG(test, pdev->dev.of_node, "%s", cases[i].path);
 		mask = pdev->dev.coherent_dma_mask;
 		KUNIT_EXPECT_EQ_MSG(test, sio_probe(pdev), cases[i].err, "%s", cases[i].path);
-		/* Without its support, a T6030 is refused before its DMA is set up */
-		if (!t6030 && cases[i].err == -ENODEV)
+		/* Without its support, a SoC's SIO is refused before its DMA is set up */
+		if (cases[i].unbuilt)
 			KUNIT_EXPECT_EQ_MSG(test, pdev->dev.coherent_dma_mask, mask, "%s",
 					    cases[i].path);
 	}
 }
 
+/* A started T8132 SIO goes on with protocol 10 only; other SIOs whatever they report. */
+static void sio_protocol_test(struct kunit *test)
+{
+	const struct {
+		bool t8132;
+		u32 protocol;
+		int err;
+	} cases[] = {
+		{ true, 10, 0 },
+		{ true, 11, -ENODEV },
+		{ true, 9, -ENODEV },
+		/* No start message recorded */
+		{ true, 0, -ENODEV },
+		{ false, 11, 0 },
+		{ false, 0, 0 },
+	};
+	struct sio_data *sio;
+	unsigned int i;
+
+	sio = kunit_kzalloc(test, sizeof(*sio), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sio);
+	sio->dev = kunit_device_register(test, "apple-sio-protocol-test");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, sio->dev);
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		if (cases[i].t8132 && !IS_ENABLED(CONFIG_APPLE_SIO_T8132))
+			continue;
+#if IS_ENABLED(CONFIG_APPLE_SIO_T8132)
+		sio->t8132 = cases[i].t8132;
+#endif
+		sio->protocol = cases[i].protocol;
+		KUNIT_EXPECT_EQ_MSG(test, sio_check_protocol(sio), cases[i].err,
+				    "t8132 %d protocol %u", cases[i].t8132, cases[i].protocol);
+	}
+}
+
 static struct kunit_case sio_probe_test_cases[] = {
 	KUNIT_CASE(sio_probe_nodes_test),
+	KUNIT_CASE(sio_protocol_test),
 	{}
 };
 
diff --git a/drivers/dma/apple-sio-probe-test.dtso b/drivers/dma/apple-sio-probe-test.dtso
index 79f3346bea..b964a10e1c 100644
--- a/drivers/dma/apple-sio-probe-test.dtso
+++ b/drivers/dma/apple-sio-probe-test.dtso
@@ -3,8 +3,9 @@
 /plugin/;
 
 /*
- * SIO nodes for the probe test: an M1 one, and T6030 ones with the tables of a
- * T6030-aware boot loader and of an earlier one. The container is not a bus, so
+ * SIO nodes for the probe test: an M1 one, and T6030 and T8132 ones with the
+ * tables of a boot loader that builds protocol-10 tables for them and of an
+ * earlier one. The container is not a bus, so
  * nothing binds to them; the test calls the probe itself.
  */
 &{/} {
@@ -43,5 +44,32 @@
 						     0x1a 0x58 0x1b 0x40 0x22 0x59 0x23 0xa0
 						     0x1c 0x5a 0x1d 0x40>;
 		};
+
+		m4_w: m4-w {
+			iommu-addresses = <&m4 0x0 0x30000 0x0 0x4000>, <&m4 0x0 0x34000 0x0 0x20000>,
+					  <&m4 0x0 0x54000 0x0 0x4000>, <&m4 0x0 0x58000 0x0 0x4000>;
+		};
+
+		m4: sio-probe-test-t8132-v10 {
+			compatible = "apple,t8132-sio", "apple,sio";
+			dma-channels = <128>;
+			memory-region = <&m4_w>;
+			apple,sio-firmware-params = <0x1e 0x30 0x1f 0x30 0xb 0x31 0xc 0x1b80
+						     0xf 0x34 0x10 0x1e000 0x30d 0x54 0x30e 0x4000
+						     0x1a 0x58 0x1b 0x40 0x22 0x59 0x23 0xd8
+						     0x1c 0x5a 0x1d 0x48>;
+		};
+
+		m4_old_w: m4-old-w { iommu-addresses = <&m4_earlier 0x0 0x30000 0x0 0x2c000>; };
+
+		m4_earlier: sio-probe-test-t8132-earlier {
+			compatible = "apple,t8132-sio", "apple,sio";
+			dma-channels = <128>;
+			memory-region = <&m4_old_w>;
+			apple,sio-firmware-params = <0x1e 0x30 0x1f 0x30 0xb 0x31 0xc 0x1b80
+						     0xf 0x34 0x10 0x1e000 0x30d 0x54 0x30e 0x4000
+						     0x1a 0x58 0x1b 0x40 0x22 0x59 0x23 0xa0
+						     0x1c 0x5a 0x1d 0x40>;
+		};
 	};
 };
diff --git a/drivers/dma/apple-sio.c b/drivers/dma/apple-sio.c
index b212460a12..b3a7c2a988 100644
--- a/drivers/dma/apple-sio.c
+++ b/drivers/dma/apple-sio.c
@@ -168,6 +168,11 @@ struct sio_data {
 #if IS_ENABLED(CONFIG_APPLE_SIO_T6030)
 	bool t6030;
 #endif
+#if IS_ENABLED(CONFIG_APPLE_SIO_T8132)
+	bool t8132;
+#endif
+	/* The firmware's protocol, from its start message */
+	u32 protocol;
 	struct sio_chan channels[];
 };
 
@@ -200,6 +205,21 @@ static inline bool sio_is_t6030(struct sio_data *sio)
 #endif
 }
 
+static inline bool sio_is_t8132(struct sio_data *sio)
+{
+#if IS_ENABLED(CONFIG_APPLE_SIO_T8132)
+	return sio->t8132;
+#else
+	return false;
+#endif
+}
+
+/* Started with protocol-10 boot tables: the T6030, and the T8132, whose loader builds them too */
+static inline bool sio_has_p10_tables(struct sio_data *sio)
+{
+	return sio_is_t6030(sio) || sio_is_t8132(sio);
+}
+
 #if IS_ENABLED(CONFIG_APPLE_SIO_T6030)
 /*
  * Boot tables of the T6030 SIO firmware, protocol 10. The boot loader builds them from the ADT
@@ -490,10 +510,10 @@ static struct sio_tx *sio_alloc_tx(struct sio_chan *siochan, dma_addr_t buf_addr
 		}
 
 		/*
-		 * T6030: publish the whole descriptor, its other fields zero;
-		 * a slot may come back from an earlier transfer.
+		 * Protocol-10 firmware: publish the whole descriptor, its other
+		 * fields zero; a slot may come back from an earlier transfer.
 		 */
-		if (sio_is_t6030(siochan->host))
+		if (sio_has_p10_tables(siochan->host))
 			memset(d, 0, sizeof(*d));
 		d->flag = 1; /* not sure what's up with this */
 		d->iova = buf_addr + period_len * i;
@@ -1195,6 +1215,7 @@ static void sio_recv_msg(void *cookie, u8 ep, u64 msg)
 
 	switch (type) {
 	case MSG_STARTED:
+		sio->protocol = data;
 		dev_info(sio->dev, "SIO protocol v%u\n", data);
 		type = MSG_ACK; /* Pretend this is an ACK */
 		fallthrough;
@@ -1463,6 +1484,21 @@ badprop:
 	return dev_err_probe(sio->dev, err, "failed to read '%s'\n", propname);
 }
 
+#define SIO_PROTOCOL_P10	10
+
+/*
+ * A T8132's firmware protocol is only known from its start message, and its
+ * boot tables are protocol-10 ones: send them to no other protocol.
+ */
+static int sio_check_protocol(struct sio_data *sio)
+{
+	if (!sio_is_t8132(sio) || sio->protocol == SIO_PROTOCOL_P10)
+		return 0;
+	dev_err(sio->dev, "SIO protocol v%u, boot tables for protocol %u; leaving the SIO stopped\n",
+		sio->protocol, SIO_PROTOCOL_P10);
+	return -ENODEV;
+}
+
 static int sio_probe(struct platform_device *pdev)
 {
 	struct device_node *np = pdev->dev.of_node;
@@ -1480,6 +1516,10 @@ static int sio_probe(struct platform_device *pdev)
 	    of_device_is_compatible(np, "apple,t6030-sio"))
 		return dev_err_probe(&pdev->dev, -ENODEV,
 				     "T6030 SIO support (APPLE_SIO_T6030) not built; leaving the SIO stopped\n");
+	if (!IS_ENABLED(CONFIG_APPLE_SIO_T8132) &&
+	    of_device_is_compatible(np, "apple,t8132-sio"))
+		return dev_err_probe(&pdev->dev, -ENODEV,
+				     "T8132 SIO support (APPLE_SIO_T8132) not built; leaving the SIO stopped\n");
 
 	err = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(42));
 	if (err)
@@ -1506,6 +1546,15 @@ static int sio_probe(struct platform_device *pdev)
 			return err;
 	}
 #endif
+#if IS_ENABLED(CONFIG_APPLE_SIO_T8132)
+	sio->t8132 = of_device_is_compatible(np, "apple,t8132-sio");
+	/* Its loader builds the T6030's tables; checked before any hardware access */
+	if (sio->t8132) {
+		err = sio_t6030_check_boot_tables(&pdev->dev);
+		if (err)
+			return err;
+	}
+#endif
 
 	sio->base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(sio->base))
@@ -1577,6 +1626,12 @@ static int sio_probe(struct platform_device *pdev)
 		return dev_err_probe(&pdev->dev, err, "starting SIO service\n");
 	}
 
+	err = sio_check_protocol(sio);
+	if (err) {
+		apple_rtkit_shutdown(sio->rtk);
+		return err;
+	}
+
 	err = sio_send_dt_params(sio);
 	if (err < 0)
 		return dev_err_probe(&pdev->dev, err, "failed to send boot-up parameters\n");
