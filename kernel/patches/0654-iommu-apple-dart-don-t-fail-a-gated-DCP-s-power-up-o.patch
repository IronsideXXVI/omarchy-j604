From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 08:52:11 +0000
Subject: [PATCH] iommu/apple-dart: don't fail a gated DCP's power-up
 on a stream the wake set up

A DCP on the J604 that was power-gated before a deep sleep (the panel
blanked by the lock screen for more than appledrm.power_gate_ms) never
came back. The firmware wake rebuilds its DART the way iBoot sets it
up, and the power-up check compares every stream with what this kernel
saved at power-down. iBoot gives SID6 a page table that this kernel
had left unused, so the check failed:

  apple-dart 30a340000.iommu: SID6 TTBR0 01200000, had 00000000
  apple-dart 30a340000.iommu: DCP SID23 retired: power-up: state lost (-5)
  apple-dcp 30ae00000.dcp: Retained DCP session quarantined: -5

The quarantined session fails every later atomic check, so the panel
stayed dark and every later suspend failed in apple-drm with -EIO.

After a real sleep, leave out of the check a stream that was unused
here at power-down (off, no TCR, no page table). Power-up enables only
the streams that were on at power-down, so such a stream stays off and
does no DMA whatever the wake left in it. Every stream this kernel set
up, the lock and the protection are still checked as before. A stream
left set up by the wake is logged once.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/iommu/apple-dart.c | 48 +++++++++++++++++++++++++++++++++++---
 1 file changed, 45 insertions(+), 3 deletions(-)

diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 1203ba49a7..0fcac376db 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -6352,13 +6352,17 @@ static __maybe_unused int apple_dart_suspend(struct device *dev)
  * controller in host mode, holds the domain on. Such a consumer may still be
  * doing DMA, so the DART must not be reset under it.
  */
-static bool apple_dart_state_retained(struct apple_dart *dart)
+static bool apple_dart_state_retained_except(struct apple_dart *dart, u64 ignore)
 {
 	bool live = false;
 	unsigned int sid, idx;
 
 	for (sid = 0; sid < dart->num_streams; sid++) {
-		u32 tcr = apple_dart_readl(dart, DART_TCR(dart, sid));
+		u32 tcr;
+
+		if (sid < 64 && (ignore & BIT_ULL(sid)))
+			continue;
+		tcr = apple_dart_readl(dart, DART_TCR(dart, sid));
 
 		if (tcr != dart->save_tcr[sid]) {
 			if (dart->host_off_slept)
@@ -6391,6 +6395,43 @@ static bool apple_dart_state_retained(struct apple_dart *dart)
 	return live;
 }
 
+static bool apple_dart_state_retained(struct apple_dart *dart)
+{
+	return apple_dart_state_retained_except(dart, 0);
+}
+
+/*
+ * After a real sleep a DCP's DART comes back as the wake rebuilt it, the way
+ * iBoot sets it up: a stream this kernel had left unused (no TCR, no page
+ * table) when it powered the DART down can come back with iBoot's page table
+ * (J604: SID6 TTBR0 0x01200000, had 0). Power-up enables only the streams that
+ * were on at power-down, so such a stream stays off and does no DMA: it is no
+ * sign that the state this kernel set up was lost. These are the streams to
+ * leave out of the check, each said once.
+ */
+static u64 apple_dart_slept_unused(struct apple_dart *dart)
+{
+	unsigned int sid, idx, n = min_t(unsigned int, dart->num_streams, 32);
+	u64 ignore = 0;
+
+	for (sid = 0; sid < n; sid++) {
+		bool unused = !(dart->off_streams & BIT(sid)) && !dart->save_tcr[sid];
+
+		for (idx = 0; unused && idx < dart->hw->ttbr_count; idx++)
+			unused = !dart->save_ttbr[sid][idx];
+		if (!unused)
+			continue;
+		ignore |= BIT_ULL(sid);
+		if (apple_dart_readl(dart, DART_TCR(dart, sid)) ||
+		    apple_dart_readl(dart, DART_TTBR(dart, sid, 0)))
+			dev_info(dart->dev,
+				 "SID%u left set up by the wake (TCR %08x TTBR0 %08x), unused here: stays off\n",
+				 sid, apple_dart_readl(dart, DART_TCR(dart, sid)),
+				 apple_dart_readl(dart, DART_TTBR(dart, sid, 0)));
+	}
+	return ignore;
+}
+
 /*
  * Flush the TLBs of every stream with a command of its own. A stream map flush
  * is not enough for the whole DART: where the streams of a map are remapped
@@ -6973,7 +7014,8 @@ static int apple_dart_host_power_on(struct apple_dart *dart)
 	if ((!dart->host_off_slept && readl(dart->regs + DART_T8110_ENABLE_STREAMS)) ||
 	    readl(dart->regs + DART_T8110_PROTECT) != dart->off_protect ||
 	    readl(dart->regs + DART_T8110_PROTECT_LOCK) != dart->off_lock ||
-	    !apple_dart_state_retained(dart))
+	    !apple_dart_state_retained_except(dart, dart->host_off_slept ?
+					      apple_dart_slept_unused(dart) : 0))
 		goto fail;
 	dart->host_off_slept = false;
 	why = "commands";
-- 
2.43.0

