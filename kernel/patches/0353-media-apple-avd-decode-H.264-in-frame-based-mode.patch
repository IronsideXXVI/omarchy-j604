+	if (!num_active || num_active > V4L2_H264_REF_LIST_LEN)
+		return -EINVAL;
+	num_init = min_t(unsigned int, num_init, V4L2_H264_REF_LIST_LEN);
+
+	/* the list is cut to num_active entries; the extra slot starts empty */
+	for (c = 0; c <= num_active; c++) {
+		if (c < num_init && c < num_active) {
+			tmp[c] = list[c];
+		} else {
+			tmp[c].index = AVD_H264_NO_REF;
+			tmp[c].fields = V4L2_H264_FRAME_REF;
+		}
+	}
+
+	for (unsigned int i = 0; i < num_mods; i++) {
+		int idx;
+
+		if (ref_idx >= num_active)
+			return -EINVAL;
+		if (mods[i].idc < 2) {
+			s64 abs_diff = (s64)mods[i].val + 1;
+			s64 no_wrap;
+
+			if (abs_diff > max_frame_num)
+				return -EINVAL;
+			if (mods[i].idc == 0) {
+				no_wrap = pred - abs_diff;
+				if (no_wrap < 0)
+					no_wrap += max_frame_num;
+			} else {
+				no_wrap = pred + abs_diff;
+				if (no_wrap >= max_frame_num)
+					no_wrap -= max_frame_num;
+			}
+			pred = no_wrap;
+			idx = find_short_term(decode,
+					      no_wrap > curr ? no_wrap - max_frame_num :
+							       no_wrap,
+					      curr, max_frame_num);
+		} else {
+			idx = find_long_term(decode, mods[i].val);
+		}
+		if (idx < 0)
+			return -EINVAL;
+
+		for (c = num_active; c > ref_idx; c--)
+			tmp[c] = tmp[c - 1];
+		tmp[ref_idx].index = idx;
+		tmp[ref_idx].fields = V4L2_H264_FRAME_REF;
+		ref_idx++;
+		for (c = ref_idx, n = ref_idx; c <= num_active; c++)
+			if (tmp[c].index != idx)
+				tmp[n++] = tmp[c];
+	}
+
+	if (tmp[0].index == AVD_H264_NO_REF)
+		return -EINVAL;
+	for (c = 0; c < num_active; c++)
+		list[c] = tmp[c].index == AVD_H264_NO_REF ? tmp[0] : tmp[c];
+	return 0;
+}
