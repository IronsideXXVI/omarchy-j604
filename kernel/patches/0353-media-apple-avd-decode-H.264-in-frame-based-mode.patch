+/**
+ * avd_h264_next_nal() - next NAL unit of an Annex-B byte stream
+ * @buf: the stream
+ * @len: its length
+ * @pos: in, where to search from; out, where to search for the one after
+ * @start: out, the first byte of the NAL unit (its header)
+ * @nal_len: out, its length without trailing zero bytes
+ *
+ * Return: whether a NAL unit was found.
+ */
+VISIBLE_IF_KUNIT bool avd_h264_next_nal(const u8 *buf, u32 len, u32 *pos,
+					u32 *start, u32 *nal_len)
+{
+	u32 i = *pos, s, e;
+
+	while (i + 3 <= len &&
+	       !(buf[i] == 0 && buf[i + 1] == 0 && buf[i + 2] == 1))
+		i++;
+	if (i + 3 > len)
+		return false;
+	s = i + 3;
+	for (i = s; i + 3 <= len; i++)
+		if (buf[i] == 0 && buf[i + 1] == 0 && buf[i + 2] <= 1)
+			break;
+	if (i + 3 > len)
+		i = len;
+	e = i;
+	while (e > s && !buf[e - 1])
+		e--;
+	*start = s;
+	*nal_len = e - s;
+	*pos = i;
+	return true;
+}
