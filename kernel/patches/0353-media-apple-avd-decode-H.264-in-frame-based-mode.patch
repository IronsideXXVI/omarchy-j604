From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 09:47:45 +0000
Subject: [PATCH] media: apple: avd: decode H.264 in frame-based mode

Chromium's V4L2 stateless H.264 decoder sets the decode mode to
FRAME_BASED, prefixes each slice with an Annex-B start code, puts all
of a picture's slices into one OUTPUT buffer and sends no slice
parameters. The driver offered slice-based mode only, so Chromium could
not decode H.264 on the AVD at all.

Offer V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED and
V4L2_STATELESS_H264_START_CODE_ANNEX_B, keeping SLICE_BASED and NONE as
the defaults, so clients that use the defaults are unchanged. In
frame-based mode, split the buffer at its start codes and read each
slice header (H.264 7.3.3, frame pictures only, which the driver already
requires): the fields the instruction builder uses, the prediction weight
table, and header_bit_size counted the way avd_h264_find_slice_data()
expects. Build the final reference lists from the v4l2-h264 initial
lists and the slice's ref_pic_list_modification() (8.2.4.3), then queue
each slice through the existing per-slice path and submit the picture
once.

Chromium also states the picture format before any stream data with an
SPS that carries only the chroma format and bit depths (profile_idc 0,
no frame_mbs_only_flag). try_ctrl and start() refused it as interlaced.
Check such an SPS for its format fields only; every picture's SPS is
still checked in full before it is decoded.

KUnit: the header reader on real x264 slices (CABAC and CAVLC, I/P/B,
list modification, weights, emulation prevention), synthetic slices
(chroma weights, unsupported and malformed headers), the list
modification (wrap, long-term, errors) and the start-code splitter.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit eec68d9b9412a53310637b90945915d533d8a757)
---
 drivers/media/platform/apple/avd/avd-h264.c | 850 ++++++++++++++++++--
 1 file changed, 780 insertions(+), 70 deletions(-)

diff --git a/drivers/media/platform/apple/avd/avd-h264.c b/drivers/media/platform/apple/avd/avd-h264.c
index db4830e7ac..daf24d03ff 100644
--- a/drivers/media/platform/apple/avd/avd-h264.c
+++ b/drivers/media/platform/apple/avd/avd-h264.c
@@ -15,6 +15,7 @@
 
 #include <kunit/visibility.h>
 #include <linux/dev_printk.h>
+#include <linux/minmax.h>
 #include <linux/mm.h>
 
 #include <media/v4l2-h264.h>
@@ -102,6 +103,9 @@ struct avd_h264_ctx {
 	struct avd_bank bank[AVD_H264_BANKS];
 	/* bank of the picture being built */
 	struct avd_bank *b;
+
+	/* frame-based mode: the slice being queued, read from its header */
+	struct avd_h264_slice_hdr hdr;
 };
 
 /* ffmpeg submits wrong timestamp, use first_mb_in_slice as a workaround */
@@ -672,8 +676,9 @@ static int avd_h264_validate_slice(struct avd_ctx *ctx,
 	return 0;
 }
 
-static int avd_h264_validate_sps(struct avd_ctx *ctx,
-				 const struct v4l2_ctrl_h264_sps *sps)
+/* The picture format an SPS asks for: chroma format and bit depths. */
+static int avd_h264_validate_sps_format(struct avd_ctx *ctx,
+					const struct v4l2_ctrl_h264_sps *sps)
 {
 	if (sps->chroma_format_idc > 2)
 		/* Only 4:0:0, 4:2:0 and 4:2:2 are supported */
@@ -691,6 +696,17 @@ static int avd_h264_validate_sps(struct avd_ctx *ctx,
 	if (sps->chroma_format_idc == 2 && sps->bit_depth_luma_minus8 == 2)
 		/* 4:2:2 10 bit would need P210; P010 is too small for its chroma */
 		return -EINVAL;
+
+	return 0;
+}
+
+static int avd_h264_validate_sps(struct avd_ctx *ctx,
+				 const struct v4l2_ctrl_h264_sps *sps)
+{
+	int ret = avd_h264_validate_sps_format(ctx, sps);
+
+	if (ret)
+		return ret;
 	if (!(sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY))
 		/* no interlaced support */
 		return -EINVAL;
@@ -746,7 +762,11 @@ static int avd_h264_start(struct avd_ctx *ctx)
 	if (!ctrl)
 		return -EINVAL;
 
-	ret = avd_h264_validate_sps(ctx, ctrl->p_new.p_h264_sps);
+	/*
+	 * The SPS may still be a client's format-only one (see try_ctrl);
+	 * every picture's SPS is checked in full before it is decoded.
+	 */
+	ret = avd_h264_validate_sps_format(ctx, ctrl->p_new.p_h264_sps);
 	if (ret)
 		return ret;
 
@@ -986,130 +1006,808 @@ static void avd_h264_abort_picture(struct avd_ctx *ctx,
 	buf->bank = 0;
 }
 
-static int avd_h264_run(struct avd_ctx *ctx)
+/*
+ * H.264 slice headers for frame-based decoding. In
+ * V4L2_STATELESS_H264_DECODE_MODE_FRAME_BASED a client sends whole pictures
+ * and no slice parameters (Chromium does). The instruction builder needs them,
+ * so they are read here from each slice NAL unit and filled the way a
+ * slice-based client fills them (H.264 7.3.3, 7.3.3.1, 7.3.3.2 and 8.2.4.3).
+ * Frame pictures only: the driver refuses an SPS without frame_mbs_only_flag.
+ */
+
+/* RefPicList position that holds "no reference picture" */
+#define AVD_H264_NO_REF		0xff
+
+/* bound for the dec_ref_pic_marking() operation loop */
+#define AVD_H264_MAX_MMCO	66
+
+struct avd_rbsp {
+	const u8 *data;
+	u32 len;
+	u32 pos;	/* byte of data[] that holds the next bit */
+	u8 bit;		/* next bit of that byte, 0 is the MSB */
+	u8 zeros;	/* zero bytes just read */
+	u8 cur;
+	u32 bits;	/* RBSP bits read, emulation prevention not counted */
+	bool err;
+};
+
+static u32 rbsp_bit(struct avd_rbsp *r)
 {
-	struct avd_h264_ctx *h264_ctx = ctx->priv;
-	struct v4l2_h264_reflist_builder reflist_builder;
-	struct avd_h264_run run;
-	size_t held = h264_ctx->b->busy && !h264_ctx->b->submitted ?
-		      h264_ctx->b->slice_num : 0;
+	u32 v;
+
+	if (r->err)
+		return 0;
+	if (!r->bit) {
+		/* in 00 00 03 the 03 is emulation prevention, not data */
+		if (r->zeros >= 2 && r->pos < r->len && r->data[r->pos] == 0x03) {
+			r->pos++;
+			r->zeros = 0;
+		}
+		if (r->pos >= r->len) {
+			r->err = true;
+			return 0;
+		}
+		r->cur = r->data[r->pos];
+		r->zeros = r->cur ? 0 : r->zeros + 1;
+	}
+	v = (r->cur >> (7 - r->bit)) & 1;
+	if (++r->bit == 8) {
+		r->bit = 0;
+		r->pos++;
+	}
+	r->bits++;
+	return v;
+}
+
+static u32 rbsp_u(struct avd_rbsp *r, unsigned int n)
+{
+	u32 v = 0;
+
+	while (n--)
+		v = (v << 1) | rbsp_bit(r);
+	return v;
+}
+
+static u32 rbsp_ue(struct avd_rbsp *r)
+{
+	unsigned int lz = 0;
+
+	while (!rbsp_bit(r)) {
+		if (r->err || ++lz > 31) {
+			r->err = true;
+			return 0;
+		}
+	}
+	return (u32)((1ULL << lz) - 1 + rbsp_u(r, lz));
+}
+
+static s64 rbsp_se(struct avd_rbsp *r)
+{
+	u32 k = rbsp_ue(r);
+
+	return k & 1 ? (s64)(k >> 1) + 1 : -(s64)(k >> 1);
+}
+
+static bool avd_h264_in(s64 v, s64 lo, s64 hi)
+{
+	return v >= lo && v <= hi;
+}
+
+static int parse_pred_weights(struct avd_rbsp *r,
+			      const struct v4l2_ctrl_h264_sps *sps,
+			      struct avd_h264_slice_hdr *h)
+{
+	struct v4l2_ctrl_h264_pred_weights *pw = &h->pw;
+	bool chroma = sps->chroma_format_idc != 0;
+	unsigned int lists = h->sl.slice_type == V4L2_H264_SLICE_TYPE_B ? 2 : 1;
+	u32 v;
+
+	v = rbsp_ue(r);
+	if (v > 7)
+		return -EINVAL;
+	pw->luma_log2_weight_denom = v;
+	if (chroma) {
+		v = rbsp_ue(r);
+		if (v > 7)
+			return -EINVAL;
+		pw->chroma_log2_weight_denom = v;
+	}
+
+	for (unsigned int l = 0; l < lists; l++) {
+		struct v4l2_h264_weight_factors *f = &pw->weight_factors[l];
+		unsigned int n = 1 + (l ? h->sl.num_ref_idx_l1_active_minus1 :
+				      h->sl.num_ref_idx_l0_active_minus1);
+
+		for (unsigned int i = 0; i < n; i++) {
+			if (rbsp_bit(r)) {
+				s64 w = rbsp_se(r), o = rbsp_se(r);
+
+				if (!avd_h264_in(w, -128, 127) || !avd_h264_in(o, -128, 127))
+					return -EINVAL;
+				f->luma_weight[i] = w;
+				f->luma_offset[i] = o;
+			} else {
+				f->luma_weight[i] = 1 << pw->luma_log2_weight_denom;
+				f->luma_offset[i] = 0;
+			}
+			if (!chroma)
+				continue;
+			if (rbsp_bit(r)) {
+				for (unsigned int j = 0; j < 2; j++) {
+					s64 w = rbsp_se(r), o = rbsp_se(r);
+
+					if (!avd_h264_in(w, -128, 127) ||
+					    !avd_h264_in(o, -128, 127))
+						return -EINVAL;
+					f->chroma_weight[i][j] = w;
+					f->chroma_offset[i][j] = o;
+				}
+			} else {
+				for (unsigned int j = 0; j < 2; j++) {
+					f->chroma_weight[i][j] =
+						1 << pw->chroma_log2_weight_denom;
+					f->chroma_offset[i][j] = 0;
+				}
+			}
+		}
+	}
+
+	return r->err ? -EINVAL : 0;
+}
+
+static int skip_dec_ref_pic_marking(struct avd_rbsp *r, bool idr)
+{
+	if (idr) {
+		rbsp_bit(r);	/* no_output_of_prior_pics_flag */
+		rbsp_bit(r);	/* long_term_reference_flag */
+		return 0;
+	}
+	if (!rbsp_bit(r))	/* adaptive_ref_pic_marking_mode_flag */
+		return 0;
+	for (unsigned int i = 0; i < AVD_H264_MAX_MMCO; i++) {
+		u32 op = rbsp_ue(r);
+
+		if (r->err || op > 6)
+			return -EINVAL;
+		if (!op)
+			return 0;
+		if (op == 1 || op == 3)
+			rbsp_ue(r);	/* difference_of_pic_nums_minus1 */
+		if (op == 2)
+			rbsp_ue(r);	/* long_term_pic_num */
+		if (op == 3 || op == 6)
+			rbsp_ue(r);	/* long_term_frame_idx */
+		if (op == 4)
+			rbsp_ue(r);	/* max_long_term_frame_idx_plus1 */
+	}
+	return -EINVAL;
+}
+
+/**
+ * avd_h264_parse_slice() - read a slice header
+ * @nal: the slice NAL unit, from its header byte, without a start code
+ * @len: its length in bytes
+ * @sps: the active SPS
+ * @pps: the active PPS
+ * @h: filled with the slice parameters, prediction weights and the
+ *     reference list modifications
+ *
+ * header_bit_size counts from the NAL header byte and leaves out emulation
+ * prevention bytes, as avd_h264_find_slice_data() expects.
+ *
+ * Return: 0, -EINVAL for a malformed header, -EOPNOTSUPP for syntax the
+ * instruction builder does not handle (SP/SI, separate colour planes, slice
+ * groups, field pictures).
+ */
+VISIBLE_IF_KUNIT int avd_h264_parse_slice(const u8 *nal, u32 len,
+					  const struct v4l2_ctrl_h264_sps *sps,
+					  const struct v4l2_ctrl_h264_pps *pps,
+					  struct avd_h264_slice_hdr *h)
+{
+	struct v4l2_ctrl_h264_slice_params *sl = &h->sl;
+	struct avd_rbsp r = { .data = nal, .len = len };
+	u32 mbs = (u32)(sps->pic_width_in_mbs_minus1 + 1) *
+		  (sps->pic_height_in_map_units_minus1 + 1);
+	unsigned int type, nlists;
+	bool idr;
+	s64 s;
+	u32 v;
 	int ret;
 
-	avd_h264_run_preamble(ctx, &run);
+	memset(h, 0, sizeof(*h));
+	if ((sps->flags & V4L2_H264_SPS_FLAG_SEPARATE_COLOUR_PLANE) ||
+	    !(sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY) ||
+	    pps->num_slice_groups_minus1)
+		return -EOPNOTSUPP;
+	if (sps->log2_max_frame_num_minus4 > 12 ||
+	    sps->log2_max_pic_order_cnt_lsb_minus4 > 12 ||
+	    sps->pic_order_cnt_type > 2 || pps->weighted_bipred_idc > 2)
+		return -EINVAL;
 
-	if (run.base.setup_err) {
-		ret = run.base.setup_err;
-		goto err_free_jobs;
+	if (rbsp_bit(&r))		/* forbidden_zero_bit */
+		return -EINVAL;
+	h->nal_ref_idc = rbsp_u(&r, 2);
+	h->nal_unit_type = rbsp_u(&r, 5);
+	if (h->nal_unit_type != 1 && h->nal_unit_type != 5)
+		return -EINVAL;
+	idr = h->nal_unit_type == 5;
+
+	v = rbsp_ue(&r);
+	if (v >= mbs)
+		return -EINVAL;
+	sl->first_mb_in_slice = v;
+
+	v = rbsp_ue(&r);
+	if (v > 9)
+		return -EINVAL;
+	type = v % 5;
+	if (type == V4L2_H264_SLICE_TYPE_SP || type == V4L2_H264_SLICE_TYPE_SI)
+		return -EOPNOTSUPP;
+	if (idr && type != V4L2_H264_SLICE_TYPE_I)
+		return -EINVAL;
+	sl->slice_type = type;
+
+	if (rbsp_ue(&r) != pps->pic_parameter_set_id)
+		return -EINVAL;
+	h->frame_num = rbsp_u(&r, sps->log2_max_frame_num_minus4 + 4);
+	if (idr)
+		rbsp_ue(&r);		/* idr_pic_id */
+
+	if (sps->pic_order_cnt_type == 0) {
+		/* pic_order_cnt_lsb */
+		rbsp_u(&r, sps->log2_max_pic_order_cnt_lsb_minus4 + 4);
+		if (pps->flags &
+		    V4L2_H264_PPS_FLAG_BOTTOM_FIELD_PIC_ORDER_IN_FRAME_PRESENT)
+			rbsp_se(&r);	/* delta_pic_order_cnt_bottom */
+	} else if (sps->pic_order_cnt_type == 1 &&
+		   !(sps->flags & V4L2_H264_SPS_FLAG_DELTA_PIC_ORDER_ALWAYS_ZERO)) {
+		rbsp_se(&r);		/* delta_pic_order_cnt[0] */
+		if (pps->flags &
+		    V4L2_H264_PPS_FLAG_BOTTOM_FIELD_PIC_ORDER_IN_FRAME_PRESENT)
+			rbsp_se(&r);	/* delta_pic_order_cnt[1] */
 	}
-	if (!run.sps || !run.pps || !run.slice_params || !run.decode_params) {
-		ret = -EINVAL;
-		goto err_free_jobs;
+
+	if (pps->flags & V4L2_H264_PPS_FLAG_REDUNDANT_PIC_CNT_PRESENT) {
+		v = rbsp_ue(&r);
+		if (v > 127)
+			return -EINVAL;
+		sl->redundant_pic_cnt = v;
 	}
 
-	/* Recheck controls applied from this request before building instructions. */
-	ret = avd_h264_validate_sps(ctx, run.sps);
-	if (!ret)
-		ret = avd_h264_validate_pps(ctx, run.pps);
-	if (!ret)
-		ret = avd_h264_validate_slice(ctx, run.slice_params);
+	if (type == V4L2_H264_SLICE_TYPE_B && rbsp_bit(&r))
+		sl->flags |= V4L2_H264_SLICE_FLAG_DIRECT_SPATIAL_MV_PRED;
+
+	/* I slices use no list, P slices list 0 only: 0 for the unused ones */
+	if (type != V4L2_H264_SLICE_TYPE_I)
+		sl->num_ref_idx_l0_active_minus1 =
+			pps->num_ref_idx_l0_default_active_minus1;
+	if (type == V4L2_H264_SLICE_TYPE_B)
+		sl->num_ref_idx_l1_active_minus1 =
+			pps->num_ref_idx_l1_default_active_minus1;
+	if (type != V4L2_H264_SLICE_TYPE_I && rbsp_bit(&r)) {
+		v = rbsp_ue(&r);
+		if (v > 31)
+			return -EINVAL;
+		sl->num_ref_idx_l0_active_minus1 = v;
+		if (type == V4L2_H264_SLICE_TYPE_B) {
+			v = rbsp_ue(&r);
+			if (v > 31)
+				return -EINVAL;
+			sl->num_ref_idx_l1_active_minus1 = v;
+		}
+	}
+	if (sl->num_ref_idx_l0_active_minus1 > 31 ||
+	    sl->num_ref_idx_l1_active_minus1 > 31)
+		return -EINVAL;
+
+	/* ref_pic_list_modification() */
+	nlists = type == V4L2_H264_SLICE_TYPE_B ? 2 :
+		 type == V4L2_H264_SLICE_TYPE_P ? 1 : 0;
+	for (unsigned int l = 0; l < nlists; l++) {
+		if (!rbsp_bit(&r))
+			continue;
+		for (;;) {
+			v = rbsp_ue(&r);
+			if (r.err)
+				return -EINVAL;
+			if (v == 3)
+				break;
+			if (v > 2 || h->num_mods[l] >= AVD_H264_MAX_LIST_MODS)
+				return -EINVAL;
+			h->mods[l][h->num_mods[l]].idc = v;
+			h->mods[l][h->num_mods[l]].val = rbsp_ue(&r);
+			h->num_mods[l]++;
+		}
+	}
+
+	if (V4L2_H264_CTRL_PRED_WEIGHTS_REQUIRED(pps, sl)) {
+		ret = parse_pred_weights(&r, sps, h);
+		if (ret)
+			return ret;
+	}
+
+	if (h->nal_ref_idc) {
+		ret = skip_dec_ref_pic_marking(&r, idr);
+		if (ret)
+			return ret;
+	}
+
+	if ((pps->flags & V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE) &&
+	    type != V4L2_H264_SLICE_TYPE_I) {
+		v = rbsp_ue(&r);
+		if (v > 2)
+			return -EINVAL;
+		sl->cabac_init_idc = v;
+	}
+
+	s = rbsp_se(&r);
+	/* SliceQPY = 26 + pic_init_qp_minus26 + slice_qp_delta in -QpBdOffsetY..51 */
+	if (!avd_h264_in(26 + pps->pic_init_qp_minus26 + s,
+			 -6 * (s64)sps->bit_depth_luma_minus8, 51))
+		return -EINVAL;
+	sl->slice_qp_delta = s;
+
+	if (pps->flags & V4L2_H264_PPS_FLAG_DEBLOCKING_FILTER_CONTROL_PRESENT) {
+		v = rbsp_ue(&r);
+		if (v > 2)
+			return -EINVAL;
+		sl->disable_deblocking_filter_idc = v;
+		if (v != 1) {
+			s64 a = rbsp_se(&r), b = rbsp_se(&r);
+
+			if (!avd_h264_in(a, -6, 6) || !avd_h264_in(b, -6, 6))
+				return -EINVAL;
+			sl->slice_alpha_c0_offset_div2 = a;
+			sl->slice_beta_offset_div2 = b;
+		}
+	}
+
+	/* the slice data must follow the header */
+	if (r.err || r.pos >= len)
+		return -EINVAL;
+	sl->header_bit_size = r.bits;
+	return 0;
+}
+
+static int find_short_term(const struct v4l2_ctrl_h264_decode_params *decode,
+			   s64 pic_num, s64 curr, u32 max_frame_num)
+{
+	for (unsigned int i = 0; i < V4L2_H264_NUM_DPB_ENTRIES; i++) {
+		const struct v4l2_h264_dpb_entry *e = &decode->dpb[i];
+		s64 wrap;
+
+		if ((e->flags & (V4L2_H264_DPB_ENTRY_FLAG_VALID |
+				 V4L2_H264_DPB_ENTRY_FLAG_ACTIVE |
+				 V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM)) !=
+		    (V4L2_H264_DPB_ENTRY_FLAG_VALID | V4L2_H264_DPB_ENTRY_FLAG_ACTIVE))
+			continue;
+		/* FrameNumWrap (8.2.4.1); PicNum = FrameNumWrap for frames */
+		wrap = e->frame_num > curr ? (s64)e->frame_num - max_frame_num :
+					     e->frame_num;
+		if (wrap == pic_num)
+			return i;
+	}
+	return -1;
+}
+
+static int find_long_term(const struct v4l2_ctrl_h264_decode_params *decode,
+			  u32 long_term_pic_num)
+{
+	const u32 want = V4L2_H264_DPB_ENTRY_FLAG_VALID |
+			 V4L2_H264_DPB_ENTRY_FLAG_ACTIVE |
+			 V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM;
+
+	/* for long-term entries V4L2 carries LongTermPicNum in frame_num */
+	for (unsigned int i = 0; i < V4L2_H264_NUM_DPB_ENTRIES; i++)
+		if ((decode->dpb[i].flags & want) == want &&
+		    decode->dpb[i].frame_num == long_term_pic_num)
+			return i;
+	return -1;
+}
+
+/**
+ * avd_h264_modify_list() - final reference list of a frame slice
+ * @list: in, the initial list (8.2.4.2) of @num_init entries; out, the
+ *        first @num_active entries of the final list
+ * @num_init: entries of the initial list
+ * @num_active: num_ref_idx_lX_active_minus1 + 1
+ * @mods: the slice's ref_pic_list_modification() operations for this list
+ * @num_mods: their number
+ * @decode: decode parameters with the DPB
+ * @sps: the active SPS
+ *
+ * Applies 8.2.4.3. Positions without a reference picture (a list longer
+ * than the references available) take the first entry, as FFmpeg does, so
+ * a stream that never uses them still decodes.
+ *
+ * Return: 0, or -EINVAL when an operation names a picture that is not in the
+ * DPB or the list stays empty.
+ */
+VISIBLE_IF_KUNIT int avd_h264_modify_list(struct v4l2_h264_reference *list,
+					  unsigned int num_init,
+					  unsigned int num_active,
+					  const struct avd_h264_list_mod *mods,
+					  unsigned int num_mods,
+					  const struct v4l2_ctrl_h264_decode_params *decode,
+					  const struct v4l2_ctrl_h264_sps *sps)
+{
+	struct v4l2_h264_reference tmp[V4L2_H264_REF_LIST_LEN + 1];
+	u32 max_frame_num = 1U << (sps->log2_max_frame_num_minus4 + 4);
+	s64 curr = decode->frame_num, pred = curr;
+	unsigned int ref_idx = 0, c, n;
