From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:16 -0500
Subject: [PATCH] soc: apple: t8140-sleep: put the AP pins back before ANS
 starts

A deep sleep resets the AP pin controller: after macOS's wake every pin
reads the same reset value. Right before ANS's run bit, macOS writes 1
at 0xc48, clears every interrupt group's pending bits and puts back 212
of the 216 pins, all but 49 to 51 and 134: each written back as it
reads, then as it was, its lock bit last.

The pin controller's driver puts back only the pins it configured
itself. That was narrowed after an earlier restore of every pin took an
SError; it wrote them without the 0xc48 write first and read all 216. It
isn't enough for ANS: with only those back, ANS's firmware can't bring
up its NAND link after the wake. Which of the other pins the link needs
isn't known, so all of them go back, as macOS does it.

Save the pins at the sleep's begin, before any device suspends, and put
them back when ANS's driver asks, right before its run bit. The pin
controller and the pins to leave alone come from the DT. On a J700, over
three sleeps in a row, 113 of the 212 pins had changed each time and ANS
came back each time.

Signed-off-by: Diljit Singh <hey@djdev.me>

[j604 backport: ported from t8140-sleep.c into apple-s2r.c (t8140-sleep.c removed): pins saved in ->begin, marked lost on a real resume, put back on ANS's request; generic Apple GPIO layout (pinctrl-apple-gpio.c REG_GPIO/REG_GPIOx_LOCK/REG_IRQ); the 0xc48 write and skip list are T8140 macOS facts, so the path runs only where the DT names apple,pinctrl, which the J604 DT does not yet (TO-VERIFY, DS1 probe); binding gets apple,pinctrl and apple,pinctrl-skip-pins as in 75baed64ff]
Assisted-by: Claude:claude-opus-5.5

---
 .../bindings/power/apple,pmgr-s2r.yaml        |  13 +++
 drivers/nvme/host/apple.c                     |   2 +
 drivers/soc/apple/apple-s2r.c                 | 101 ++++++++++++++++++
 include/linux/soc/apple/sleep.h               |   3 +
 4 files changed, 119 insertions(+)

diff --git a/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml b/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml
index fbb4e6bc95..2272eba448 100644
--- a/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml
+++ b/Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml
@@ -97,6 +97,19 @@ properties:
       goes to sleep, so that a suspend-to-RAM that never resumes ends in a
       reset. Its registers stay owned by the watchdog's own node.
 
+  apple,pinctrl:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      The pin controller whose pins a deep sleep resets. Its pins are saved
+      before a sleep and put back after it, before the storage controller
+      starts.
+
+  apple,pinctrl-skip-pins:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description:
+      Pins of that controller to leave alone across a sleep, neither saved nor
+      put back.
+
 required:
   - compatible
   - apple,pmgr
diff --git a/drivers/nvme/host/apple.c b/drivers/nvme/host/apple.c
index e7adb2c589..a19223b642 100644
--- a/drivers/nvme/host/apple.c
+++ b/drivers/nvme/host/apple.c
@@ -2777,6 +2777,8 @@ static int apple_nvme_resume_early(struct device *dev)
 	anv->sleep_idled = false;
 	if (anv->sleep_stop)
 		apple_sleep_coproc_set_ready(dev, false);
+	/* Its link doesn't come up with the pins as the sleep left them. */
+	apple_sleep_restore_pins();
 	/* macOS writes the SART's entries back again right before the run bit. */
 	if (anv->sart)
 		apple_sart_replay(anv->sart);
diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 16809868c1..50dff16cb7 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -61,6 +61,7 @@
  */
 
 #include <linux/bitfield.h>
+#include <linux/bitmap.h>
 #include <linux/bits.h>
 #include <linux/cleanup.h>
 #include <linux/device.h>
@@ -73,6 +74,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
+#include <linux/of_irq.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
 #include <linux/soc/apple/sleep.h>
@@ -233,10 +235,77 @@ struct apple_s2r {
 	u32 wdt_saved_alarm;
 
 	struct syscore syscore;
+
+	/* The AP pins, which a deep sleep resets (apple,pinctrl) */
+	void __iomem *pins;
+	u32 *pins_saved;
+	unsigned long *pins_skip;
+	unsigned int npins;
+	unsigned int pin_irq_groups;
+	bool pins_saved_valid;
+	bool pins_lost;
 };
 
 static struct apple_s2r *apple_s2r;
 
+#define PIN_REG(n)		(4 * (n))
+#define PIN_LOCK		BIT(21)
+#define PIN_CTL			0xc48
+#define PIN_IRQ(g, w)		(0x800 + 0x40 * (g) + 4 * (w))
+
+/* Before any device suspends, with the pins' domain on. Skipped pins aren't read. */
+static void apple_s2r_pins_save(struct apple_s2r *s2r)
+{
+	unsigned int pin;
+
+	s2r->pins_lost = false;
+	s2r->pins_saved_valid = false;
+	if (!s2r->pins)
+		return;
+	for (pin = 0; pin < s2r->npins; pin++)
+		if (!test_bit(pin, s2r->pins_skip))
+			s2r->pins_saved[pin] = readl(s2r->pins + PIN_REG(pin));
+	s2r->pins_saved_valid = true;
+}
+
+/*
+ * A deep sleep resets every pin, and the pin controller's driver puts back only the
+ * ones it configured. Where the DT names the pin controller, all of them go back
+ * right before ANS's run bit: 1 written at 0xc48, every interrupt group's pending
+ * bits cleared, then each pin written back as it reads, then as it was, its lock bit
+ * last (as Aurora's T8140 sleep controller does it, from macOS there).
+ */
+void apple_sleep_restore_pins(void)
+{
+	struct apple_s2r *s2r = apple_s2r;
+	unsigned int pin, grp, w, changed = 0;
+
+	if (!s2r || !s2r->pins_lost)
+		return;
+	s2r->pins_lost = false;
+
+	writel(1, s2r->pins + PIN_CTL);
+	for (grp = 0; grp < s2r->pin_irq_groups; grp++)
+		for (w = 0; w < DIV_ROUND_UP(s2r->npins, 32); w++)
+			writel(U32_MAX, s2r->pins + PIN_IRQ(grp, w));
+	for (pin = 0; pin < s2r->npins; pin++) {
+		void __iomem *reg = s2r->pins + PIN_REG(pin);
+		u32 want = s2r->pins_saved[pin], cur;
+
+		if (test_bit(pin, s2r->pins_skip))
+			continue;
+		cur = readl(reg);
+		changed += cur != want;
+		writel(cur, reg);
+		if (want & PIN_LOCK)
+			writel(want & ~PIN_LOCK, reg);
+		writel(want, reg);
+	}
+	dev_info(s2r->dev, "%u of %u AP pins changed by the sleep, all put back\n", changed,
+		 s2r->npins - bitmap_weight(s2r->pins_skip, s2r->npins));
+}
+EXPORT_SYMBOL_GPL(apple_sleep_restore_pins);
+
 /* Coprocessor ASC: CPU control (run bit) and status, as nvme-apple's ANS */
 #define ASC_CPU_CONTROL		0x44
 #define ASC_CPU_CONTROL_RUN	BIT(4)
@@ -804,6 +873,7 @@ static void apple_s2r_syscore_resume(void *data)
 	if (s2r->resumed) {
 		apple_s2r_sep_on(s2r);
 		apple_cpu_power_cycled();
+		s2r->pins_lost = s2r->pins_saved_valid;
 	}
 	if (done & S2R_DONE_CPU_CLUSTERS)
 		apple_s2r_cpu_clusters_restore(s2r);
@@ -864,6 +934,8 @@ static void apple_s2r_wake(void)
  */
 static int apple_s2r_begin(suspend_state_t state)
 {
+	if (apple_s2r)
+		apple_s2r_pins_save(apple_s2r);
 	pm_set_suspend_via_firmware();
 	return 0;
 }
@@ -952,6 +1024,34 @@ static int apple_s2r_verify_reset_vector(struct apple_s2r *s2r)
 }
 
 /* The watchdog driver owns the registers: map them without claiming them */
+/* The pins to leave alone come from the DT: reading one may fault. */
+static void apple_s2r_map_pins(struct apple_s2r *s2r)
+{
+	struct device_node *np = of_parse_phandle(s2r->dev->of_node, "apple,pinctrl", 0);
+	u32 npins, pin;
+	int i, n;
+
+	if (!np)
+		return;
+	if (!of_device_is_available(np) || of_property_read_u32(np, "apple,npins", &npins) ||
+	    !npins || npins > 512)
+		goto out;
+	s2r->pins_saved = devm_kcalloc(s2r->dev, npins, sizeof(*s2r->pins_saved), GFP_KERNEL);
+	s2r->pins_skip = devm_bitmap_zalloc(s2r->dev, npins, GFP_KERNEL);
+	if (!s2r->pins_saved || !s2r->pins_skip)
+		goto out;
+	n = of_property_count_u32_elems(s2r->dev->of_node, "apple,pinctrl-skip-pins");
+	for (i = 0; i < n; i++)
+		if (!of_property_read_u32_index(s2r->dev->of_node, "apple,pinctrl-skip-pins", i,
+						&pin) && pin < npins)
+			set_bit(pin, s2r->pins_skip);
+	s2r->pin_irq_groups = of_irq_count(np);
+	s2r->npins = npins;
+	s2r->pins = of_iomap(np, 0);
+out:
+	of_node_put(np);
+}
+
 static int apple_s2r_map_wdt(struct apple_s2r *s2r)
 {
 	struct device_node *wdt_np;
@@ -1072,6 +1172,7 @@ static int apple_s2r_probe(struct platform_device *pdev)
 	ret = apple_s2r_map_wdt(s2r);
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to map apple,watchdog\n");
+	apple_s2r_map_pins(s2r);
 
 	apple_s2r = s2r;
 
diff --git a/include/linux/soc/apple/sleep.h b/include/linux/soc/apple/sleep.h
index 688a4997e0..bc020a4501 100644
--- a/include/linux/soc/apple/sleep.h
+++ b/include/linux/soc/apple/sleep.h
@@ -85,6 +85,8 @@ int apple_sleep_enclave_register(struct device *dev, int (*tell)(void *data), vo
 void apple_sleep_enclave_unregister(struct device *dev);
 void apple_sleep_coproc_set_ready(struct device *dev, bool ready);
 bool apple_sleep_coproc_stopped(struct device *dev);
+/* After a deep sleep, put back the pins it reset. ANS's driver calls it before the run bit. */
+void apple_sleep_restore_pins(void);
 #else
 static inline int apple_sleep_coproc_register(struct device *dev, void __iomem *asc,
 					      bool pcie_ans, int (*last_stop)(void *data),
@@ -100,6 +102,7 @@ static inline int apple_sleep_enclave_register(struct device *dev, int (*tell)(v
 static inline void apple_sleep_enclave_unregister(struct device *dev) { }
 static inline void apple_sleep_coproc_set_ready(struct device *dev, bool ready) { }
 static inline bool apple_sleep_coproc_stopped(struct device *dev) { return false; }
+static inline void apple_sleep_restore_pins(void) { }
 #endif
 
 #endif /* _LINUX_SOC_APPLE_SLEEP_H_ */
