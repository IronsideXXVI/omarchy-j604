From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Fri, 30 Oct 2026 10:42:55 +1100
Subject: [PATCH] wifi: brcmfmac: query assoc_info with a full-sized buffer

Since commit cda37449d576 ("wifi: brcmfmac bound association IEs to
returned payloads") the "assoc_info" iovar is queried with an 8-byte
buffer, the size of the two lengths the driver reads. The firmware fails
a get whose buffer is shorter than its whole association record, so
every association on the BCM4387 and BCM4388 now logs

  brcmf_get_assoc_ies: could not get assoc info (-52)

and cfg80211 gets no association request or response IEs, and the WMM
AC priorities are never read. Saved boot logs show the message on every
association after that change and on none before it.

Query with WL_ASSOC_INFO_MAX bytes as before, into the buffer the IE
queries already use, and keep the bounds checks on what the firmware
returns.

Fixes: cda37449d576 ("wifi: brcmfmac bound association IEs to returned payloads")
Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit cfbedf606e557cb3a5ba3ba645df0a8272d1029f)
---
 .../broadcom/brcm80211/brcmfmac/cfg80211.c    | 27 ++++++++++++-------
 1 file changed, 17 insertions(+), 10 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
index 8d20847cb7..4b5c6d870e 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -6574,30 +6574,37 @@ static s32 brcmf_get_assoc_ies(struct brcmf_cfg80211_info *cfg,
 	s32 err;
 
 	brcmf_clear_assoc_ies(cfg);
-	err = brcmf_fil_iovar_data_get_len(ifp, "assoc_info", &assoc_info,
-					   sizeof(assoc_info), &received);
+	buffer = kzalloc(WL_EXTRA_BUF_MAX, GFP_KERNEL);
+	if (!buffer)
+		return -ENOMEM;
+	/*
+	 * The firmware fails the query with a buffer shorter than its whole
+	 * association record, so ask with WL_ASSOC_INFO_MAX bytes and take
+	 * the two lengths that lead the reply.
+	 */
+	err = brcmf_fil_iovar_data_get_len(ifp, "assoc_info", buffer,
+					   WL_ASSOC_INFO_MAX, &received);
 	if (err) {
 		bphy_err(drvr, "could not get assoc info (%d)\n", err);
-		return err;
+		goto done;
 	}
 	if (received < sizeof(assoc_info)) {
 		bphy_err(drvr, "short assoc info: received %u required %zu\n",
 			 received, sizeof(assoc_info));
-		return -EBADMSG;
+		err = -EBADMSG;
+		goto done;
 	}
+	memcpy(&assoc_info, buffer, sizeof(assoc_info));
 	req_len = le32_to_cpu(assoc_info.req_len);
 	resp_len = le32_to_cpu(assoc_info.resp_len);
 	if (req_len > WL_EXTRA_BUF_MAX || resp_len > WL_EXTRA_BUF_MAX) {
 		bphy_err(drvr, "invalid lengths in assoc info: req %u resp %u\n",
 			 req_len, resp_len);
-		return -EINVAL;
-	}
-	if (req_len || resp_len) {
-		buffer = kzalloc(WL_EXTRA_BUF_MAX, GFP_KERNEL);
-		if (!buffer)
-			return -ENOMEM;
+		err = -EINVAL;
+		goto done;
 	}
 	if (req_len) {
+		memset(buffer, 0, WL_EXTRA_BUF_MAX);
 		err = brcmf_fil_iovar_data_get_len(ifp, "assoc_req_ies", buffer,
 						   max_t(u32, req_len, WL_ASSOC_INFO_MAX),
 						   &received);
