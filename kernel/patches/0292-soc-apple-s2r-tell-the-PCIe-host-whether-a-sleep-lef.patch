From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 02:17:23 +0000
Subject: [PATCH] soc: apple: s2r: tell the PCIe host whether a sleep
 left a root port down

After a T8132 sleep that lowered ANS's APCIe block, apple-s2r raises the
block again and marks every root port it stopped as down, until its host
trains it again and says so with apple_sleep_apcie_port_up(). The host
has no way to read that state: it cannot tell a port it has to set up
again from one the sleep never touched, nor from a block that did not
come back, whose port registers abort.

Export apple_sleep_apcie_port_down(): 1 for a port the sleep stopped
when the block came back, 0 for a port it did not stop, -EIO when the
raise failed. Without CONFIG_APPLE_S2R it reads 0, so a host never
restarts a port.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/soc/apple/apple-s2r.c   | 21 +++++++++++++++++++++
 include/linux/soc/apple/sleep.h |  3 +++
 2 files changed, 24 insertions(+)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 1e3a254bd2..d4b7654c4b 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -2045,6 +2045,27 @@ void apple_sleep_radio_port_up(void)
 }
 EXPORT_SYMBOL_GPL(apple_sleep_radio_port_up);
 
+/**
+ * apple_sleep_apcie_port_down() - whether a T8132 sleep left a root port of ANS's APCIe block down
+ * @port: the root port's number (its "portN" window)
+ *
+ * For the PCIe host, in its noirq resume: 1 if the sleep stopped the port and the block came back
+ * up, so the host has to set the port up again; 0 if the port was not stopped; -EIO if the block
+ * did not come back, when the port's registers would abort.
+ */
+int apple_sleep_apcie_port_down(unsigned int port)
+{
+	struct apple_s2r_t8132 *t;
+
+	if (!apple_s2r || port >= APCIE_MAX_PORTS)
+		return 0;
+	t = &apple_s2r->t8132;
+	if (!READ_ONCE(t->apcie_ports[port].down))
+		return 0;
+	return t->pcie_ans_on_ret ? -EIO : 1;
+}
+EXPORT_SYMBOL_GPL(apple_sleep_apcie_port_down);
+
 static void __iomem *apple_s2r_t8132_apcie_block(struct apple_s2r *s2r, struct device_node *np,
 						 const char *name, const char *prop,
 						 struct apple_tunable **tun)
diff --git a/include/linux/soc/apple/sleep.h b/include/linux/soc/apple/sleep.h
index cb4f02955e..5c8690ed6b 100644
--- a/include/linux/soc/apple/sleep.h
+++ b/include/linux/soc/apple/sleep.h
@@ -99,6 +99,8 @@ void apple_sleep_restore_pins(void);
 /* The PCIe host retrained a root port (or the radio's, port 0) after a T8132 sleep. */
 void apple_sleep_apcie_port_up(unsigned int port);
 void apple_sleep_radio_port_up(void);
+/* Whether a T8132 sleep left that root port down: 1 down, 0 not, -EIO if the block stayed off. */
+int apple_sleep_apcie_port_down(unsigned int port);
 #else
 static inline int apple_sleep_coproc_register(struct device *dev, void __iomem *asc,
 					      bool pcie_ans, int (*last_stop)(void *data),
@@ -117,6 +119,7 @@ static inline bool apple_sleep_coproc_stopped(struct device *dev) { return false
 static inline void apple_sleep_restore_pins(void) { }
 static inline void apple_sleep_apcie_port_up(unsigned int port) { }
 static inline void apple_sleep_radio_port_up(void) { }
+static inline int apple_sleep_apcie_port_down(unsigned int port) { return 0; }
 #endif
 
