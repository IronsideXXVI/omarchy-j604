From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 05:30:57 +0000
Subject: [PATCH] wifi: brcmfmac: pcie: Optionally reset the chip at
 shutdown

The PCIe driver has no shutdown hook, and a reboot shuts devices down
without removing them. The firmware keeps running through the reset:
still associated, and with power save on it naps with the link in L1
substates. If a warm reset does not cycle the radio's power, the boot
firmware that brings the radio's PCIe port up again finds the chip
still running instead of in its reset state.

Add a shutdown hook. It stops the bus and resets the chip the way
remove does, then leaves ASPM off so the link stays in L0 until the
reset. It frees nothing, because the reset has already stopped DMA into
the host buffers.

It is off by default (pcie_shutdown_reset=0). A reboot A/B on that
machine with power save on and off did not reproduce the stall, so no
machine is known to need it yet.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../broadcom/brcm80211/brcmfmac/pcie.c        | 54 +++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
index 337bc48fe1..f4ed5b23d6 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -3606,11 +3606,65 @@ static const struct pci_device_id brcmf_pcie_devid_table[] = {
 MODULE_DEVICE_TABLE(pci, brcmf_pcie_devid_table);
 
 
+/*
+ * Leave the chip the way a cold boot finds it. A reboot shuts devices down
+ * without removing them, so without this the firmware keeps running through
+ * the reset: still associated, napping in power save with the link in L1
+ * substates. The Apple boot firmware that brings the radio's PCIe port up
+ * again before Linux can then wait on it until a watchdog resets the machine.
+ * Stop the bus and reset the chip as remove does, then keep ASPM off so the
+ * link stays in L0 until the reset. The host buffers stay: nothing frees
+ * them on the way down, and the reset has stopped the DMA into them.
+ * Off by default until a machine is shown to need it.
+ */
+static bool brcmf_pcie_shutdown_reset;
+module_param_named(pcie_shutdown_reset, brcmf_pcie_shutdown_reset, bool, 0644);
+MODULE_PARM_DESC(pcie_shutdown_reset, "Reset the PCIe chip at shutdown and reboot (default off)");
+
+static void brcmf_pcie_shutdown(struct pci_dev *pdev)
+{
+	struct brcmf_pciedev_info *devinfo;
+	struct brcmf_bus *bus;
+	struct brcmf_if *ifp;
+	u32 lsc;
+	int i;
+
+	if (!brcmf_pcie_shutdown_reset)
+		return;
+	bus = dev_get_drvdata(&pdev->dev);
+	if (!bus)
+		return;
+	devinfo = bus->bus_priv.pcie->devinfo;
+	if (!devinfo->ci || devinfo->state != BRCMFMAC_PCIE_STATE_UP)
+		return;
+
+	for (i = 0; bus->drvr && i < BRCMF_MAX_IFS; i++) {
+		ifp = bus->drvr->iflist[i];
+		if (ifp && ifp->ndev)
+			netif_tx_disable(ifp->ndev);
+	}
+	brcmf_pcie_fwcon_timer(devinfo, false);
+	brcmf_bus_change_state(bus, BRCMF_BUS_DOWN);
+	devinfo->state = BRCMFMAC_PCIE_STATE_DOWN;
+	brcmf_pcie_intr_disable(devinfo);
+	if (devinfo->irq_allocated)
+		synchronize_irq(pdev->irq);
+	brcmf_bus_cancel_reset_work(bus);
+
+	brcmf_pcie_reset_device(devinfo);
+
+	pci_read_config_dword(pdev, BRCMF_PCIE_REG_LINK_STATUS_CTRL, &lsc);
+	pci_write_config_dword(pdev, BRCMF_PCIE_REG_LINK_STATUS_CTRL,
+			       lsc & ~BRCMF_PCIE_LINK_STATUS_CTRL_ASPM_ENAB);
+	pci_clear_master(pdev);
+}
+
 static struct pci_driver brcmf_pciedrvr = {
 	.name = KBUILD_MODNAME,
 	.id_table = brcmf_pcie_devid_table,
 	.probe = brcmf_pcie_probe,
 	.remove = brcmf_pcie_remove,
+	.shutdown = brcmf_pcie_shutdown,
 #ifdef CONFIG_PM
 	.driver.pm = &brcmf_pciedrvr_pm,
 #endif
-- 
2.43.0

