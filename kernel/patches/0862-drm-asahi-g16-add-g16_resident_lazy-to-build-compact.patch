+    /// The checks and references of [`PoolSet::prepare`] for this unit.
+    pub(crate) fn prepare_unit(&self) -> Result<AllocatorRefs> {
+        if self.published.load(Ordering::Acquire) && !self.retired()? {
+            return Err(EBUSY);
+        }
+        // Descriptor pointer/counter and slot must still identify this exact retained unit.
+        if read64(&self.descriptor, 0)? != self.descriptor.va
+            || self.descriptor.r32(8)? != self.uma_slot
+            || read64(&self.descriptor, 0x4c)? != self.submitted.va
+        {
+            return Err(EINVAL);
+        }
+        self.refs()
+    }
+    /// [`PoolSet::publish`] for this unit.
+    pub(crate) fn publish_unit(&self, submitted: u64) -> Result {
+        let next = read64(&self.submitted, 0)?;
+        if submitted != next.checked_add(2).ok_or(EOVERFLOW)? {
+            return Err(EINVAL);
+        }
+        self.submitted.w64(0, submitted)?;
+        self.published.store(true, Ordering::Release);
+        Ok(())
+    }
+    pub(crate) fn heap_gva_unit(&self) -> Result<u64> {
+        gva(&self.heap)
+    }
+    pub(crate) fn heap_blocks_unit(&self) -> u32 {
