+impl RenderInner {
+    /// Units this VM has built: the first ones plus those built later, in order.
+    pub(crate) fn unit_count(&self) -> usize {
+        let mut n = self.passes.len();
+        while n < self.ext.len() && self.ext[n].as_ref().is_some() {
+            n += 1;
+        }
+        n
+    }
+    /// Unit `k`'s pass slot, if built.
+    pub(crate) fn pass(&self, k: usize) -> Option<&PassSlot> {
+        self.passes
+            .get(k)
+            .or_else(|| self.ext.get(k)?.as_ref().map(|u| &u.pass))
+    }
+    /// Every built unit's pass slot.
+    pub(crate) fn units(&self) -> impl Iterator<Item = &PassSlot> {
+        (0..self.unit_count()).filter_map(move |k| self.pass(k))
+    }
+    fn alloc_unit(&self, k: usize) -> Result<&Allocator> {
+        self.pools
+            .get(k)
+            .or_else(|| self.ext.get(k)?.as_ref().map(|u| &u.alloc))
+            .ok_or(EINVAL)
+    }
+    pub(crate) fn pool_prepare(&self, k: usize) -> Result<AllocatorRefs> {
+        self.alloc_unit(k)?.prepare_unit()
+    }
+    pub(crate) fn pool_publish(&self, k: usize, submitted: u64) -> Result {
+        self.alloc_unit(k)?.publish_unit(submitted)
+    }
+    pub(crate) fn pool_retired(&self, k: usize) -> Result<bool> {
+        self.alloc_unit(k)?.retired()
+    }
+    pub(crate) fn heap_gva(&self, k: usize) -> Result<u64> {
+        self.alloc_unit(k)?.heap_gva_unit()
+    }
+    pub(crate) fn heap_blocks(&self, k: usize) -> Result<u32> {
+        Ok(self.alloc_unit(k)?.heap_blocks_unit())
+    }
+}
