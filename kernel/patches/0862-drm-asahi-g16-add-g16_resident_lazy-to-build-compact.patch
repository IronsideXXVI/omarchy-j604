+    /// `g16_resident_lazy`: builds unit `k` (the next one) in SUBMIT. Called under the VM's
+    /// resource lock, so units are built one at a time and in order.
+    fn extend(&self, factory: &Factory, vm: &mmu::Vm, k: usize) -> Result {
+        if k < self.passes.len() || k >= self.ext.len() || self.ext[k].as_ref().is_some() {
+            return Err(EINVAL);
+        }
+        let start = super::engine::now_ns();
+        let compact = super::params::resident_compact();
+        let mut objects = factory.objects(vm);
+        let pass = PassSlot::new(&mut objects, k as u64, 1, compact)?;
+        let alloc = PoolSet::build_unit(&mut objects, k, compact)?;
+        objects.finish_private()?;
+        let unit = KBox::new(
+            ExtUnit {
+                pass,
+                alloc,
+                _objects: objects,
+            },
+            GFP_KERNEL,
+        )?;
+        if !self.ext[k].populate(unit) {
+            return Err(EBUSY);
+        }
+        let ns = super::engine::now_ns().wrapping_sub(start);
+        LAZY_STATS[0].fetch_add(1, Ordering::Relaxed);
+        LAZY_STATS[1].fetch_add(ns, Ordering::Relaxed);
+        LAZY_STATS[2].fetch_max(ns, Ordering::Relaxed);
+        Ok(())
