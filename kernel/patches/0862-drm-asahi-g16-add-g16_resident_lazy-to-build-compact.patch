+/// Storage of `g16_resident_lazy` (0644, default 0; read when a VM builds its render units).
+static RESIDENT_LAZY: AtomicU32 = AtomicU32::new(0);
+
+/// A VM's first render builds only the two full render units; the compact ones are built in
+/// SUBMIT, one at a time, when the VM has more render commands outstanding than units.
+pub(crate) fn resident_lazy() -> bool {
+    RESIDENT_LAZY.load(Ordering::Relaxed) != 0
+}
