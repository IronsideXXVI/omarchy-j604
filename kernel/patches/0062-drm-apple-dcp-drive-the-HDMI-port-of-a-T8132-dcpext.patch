 drivers/gpu/drm/apple/dcp-fabric-test.c |  18 ++
 drivers/gpu/drm/apple/dcp-fabric.c      |   8 +-
 drivers/gpu/drm/apple/dcp-fabric.h      |   1 +
 drivers/gpu/drm/apple/dcp-hdmi.c        |   7 +-
 drivers/gpu/drm/apple/dcp-internal.h    |   7 +
 drivers/gpu/drm/apple/dcp.c             | 281 +++++++++++++++++++++++-
 drivers/gpu/drm/apple/dcp.h             |   1 +
 drivers/gpu/drm/apple/dptxep.c          |   2 +
 drivers/gpu/drm/apple/iomfb_m4.c        |   2 +
 drivers/gpu/drm/apple/t8132_ext_drm.c   |  11 +-
