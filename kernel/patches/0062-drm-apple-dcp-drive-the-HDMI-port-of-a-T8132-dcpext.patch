diff --git a/drivers/gpu/drm/apple/dcp-fabric-core.c b/drivers/gpu/drm/apple/dcp-fabric-core.c
index 6a7fab89c1..4d787164ed 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-core.c
+++ b/drivers/gpu/drm/apple/dcp-fabric-core.c
@@ -531,5 +531,25 @@ bool dcp_fabric_t6030_link(bool tunnel, bool has_xbar, bool t6030_dpin)
 }
 EXPORT_SYMBOL_GPL(dcp_fabric_t6030_link);
 
+/*
+ * A T8132 dcpext's HDMI output can connect only once the adopted IOMFB
+ * session is open and the DPTX remote port service is published; both come
+ * from the firmware after probe. Their arrival kicks the start work again,
+ * so the bounded retries only cover a missed kick.
+ */
+enum dcp_fabric_t8132_hdmi_step
+dcp_fabric_t8132_hdmi_step(bool has_fixed, bool dead, bool session_ready,
+			   bool service_ready, unsigned int tries,
+			   unsigned int max_tries)
+{
+	if (!has_fixed || dead)
+		return DCP_FABRIC_T8132_HDMI_IDLE;
+	if (session_ready && service_ready)
+		return DCP_FABRIC_T8132_HDMI_START;
+	return tries < max_tries ? DCP_FABRIC_T8132_HDMI_RETRY :
+				   DCP_FABRIC_T8132_HDMI_IDLE;
+}
+EXPORT_SYMBOL_GPL(dcp_fabric_t8132_hdmi_step);
+
 MODULE_DESCRIPTION("Apple display fabric decisions");
 MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/gpu/drm/apple/dcp-fabric-core.h b/drivers/gpu/drm/apple/dcp-fabric-core.h
index 602e7b2efb..d1f8755ade 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-core.h
+++ b/drivers/gpu/drm/apple/dcp-fabric-core.h
@@ -212,4 +212,19 @@ u32 dcp_fabric_port_crtc_mask(bool secondary, bool ordered_dual, bool typec_only
 enum dcp_fabric_attach_action dcp_fabric_attach_action(bool external);
 bool dcp_fabric_t6030_link(bool tunnel, bool has_xbar, bool t6030_dpin);
 
+/* What the start work of a T8132 dcpext's HDMI output does next. */
+enum dcp_fabric_t8132_hdmi_step {
+	/* Nothing: no HDMI output, a dead coprocessor, or retries used up. */
+	DCP_FABRIC_T8132_HDMI_IDLE,
+	/* Try again later: the IOMFB session or the DPTX service is not up. */
+	DCP_FABRIC_T8132_HDMI_RETRY,
+	/* Watch the HPD line and act on its level. */
+	DCP_FABRIC_T8132_HDMI_START,
+};
+
+enum dcp_fabric_t8132_hdmi_step
+dcp_fabric_t8132_hdmi_step(bool has_fixed, bool dead, bool session_ready,
+			   bool service_ready, unsigned int tries,
+			   unsigned int max_tries);
+
 #endif /* __APPLE_DCP_FABRIC_CORE_H__ */
diff --git a/drivers/gpu/drm/apple/dcp-fabric-test.c b/drivers/gpu/drm/apple/dcp-fabric-test.c
index ef6381b159..a22f05c190 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-test.c
+++ b/drivers/gpu/drm/apple/dcp-fabric-test.c
@@ -251,6 +251,7 @@ static const struct fabric_scenario scenarios[] = {
 	{ "S50d_external_attach_dispatch_core", 53 },
 	{ "S50e_t6030_crossbar_core", 54 },
 	{ "S50f_unwired_m3_ports_core", 55 },
+	{ "S50g_t8132_hdmi_start_core", 56 },
 };
 
 static void fabric_scenario_desc(const struct fabric_scenario *scenario,
@@ -472,6 +473,23 @@ static void fabric_scenario_test(struct kunit *test)
 		KUNIT_EXPECT_FALSE(test, dcp_fabric_t6030_link(true, true, false));
 		KUNIT_EXPECT_FALSE(test, dcp_fabric_t6030_link(true, false, true));
 		break;
+	case 56:
+		/* No HDMI output, or a dead coprocessor: nothing to start. */
+		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_hdmi_step(false, false, true, true, 0, 4),
+				DCP_FABRIC_T8132_HDMI_IDLE);
+		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_hdmi_step(true, true, true, true, 0, 4),
+				DCP_FABRIC_T8132_HDMI_IDLE);
+		/* Session and DPTX service up: start, whatever the retries. */
+		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_hdmi_step(true, false, true, true, 9, 4),
+				DCP_FABRIC_T8132_HDMI_START);
+		/* Either missing: retry, until the retries are used up. */
+		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_hdmi_step(true, false, false, true, 0, 4),
+				DCP_FABRIC_T8132_HDMI_RETRY);
+		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_hdmi_step(true, false, true, false, 3, 4),
+				DCP_FABRIC_T8132_HDMI_RETRY);
+		KUNIT_EXPECT_EQ(test, dcp_fabric_t8132_hdmi_step(true, false, true, false, 4, 4),
+				DCP_FABRIC_T8132_HDMI_IDLE);
+		break;
 	case 55:
 		f.port[0].next = NULL;
 		KUNIT_EXPECT_EQ(test, dcp_fabric_tunnel_request(f.port, 2, 0, &found), -ENODEV);
diff --git a/drivers/gpu/drm/apple/dcp-fabric.c b/drivers/gpu/drm/apple/dcp-fabric.c
index e00de74092..96191bc942 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.c
+++ b/drivers/gpu/drm/apple/dcp-fabric.c
@@ -5213,12 +5213,18 @@ irqreturn_t dcp_dp2hdmi_hpd(int irq, void *data)
 	if (dcp->fw_compat == DCP_FIRMWARE_V_26_6_DESKTOP)
 		return dcp_desktop_dp2hdmi_hpd(dcp);
 
+	dcp_fabric_hdmi_sample(dcp);
+	return IRQ_HANDLED;
+}
+
+/* Act on the HDMI HPD level, as its interrupt thread does. */
+void dcp_fabric_hdmi_sample(struct apple_dcp *dcp)
+{
 	guard(mutex)(&dcp_typec_fabric_lock);
 	dcp_hdmi_update_locked(dcp);
 	/* The GPIO edge detector is off throughout an oneshot handler. */
 	if (dcp_hdmi_settle_enabled(dcp))
 		mod_delayed_work(system_freezable_wq, &dcp->hdmi_recheck_wq, 0);
-	return IRQ_HANDLED;
 }
 
 void dcp_link(struct platform_device *pdev, struct apple_crtc *crtc,
diff --git a/drivers/gpu/drm/apple/dcp-fabric.h b/drivers/gpu/drm/apple/dcp-fabric.h
index edca8065bd..8cff4ae230 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.h
+++ b/drivers/gpu/drm/apple/dcp-fabric.h
@@ -130,6 +130,7 @@ void dcp_fabric_hdmi_reinit(struct apple_dcp *dcp, const char *why);
 void dcp_fabric_hdmi_retry(struct apple_dcp *dcp);
 irqreturn_t dcp_dp2hdmi_hpd_edge(int irq, void *data);
 irqreturn_t dcp_dp2hdmi_hpd(int irq, void *data);
+void dcp_fabric_hdmi_sample(struct apple_dcp *dcp);
 void dcp_fabric_shutdown_dptx(struct apple_dcp *dcp);
 
 /* DPTX operations supplied by the DCP firmware layer. */
diff --git a/drivers/gpu/drm/apple/dcp-hdmi.c b/drivers/gpu/drm/apple/dcp-hdmi.c
index 0603de2a0e..d88aeebffd 100644
--- a/drivers/gpu/drm/apple/dcp-hdmi.c
+++ b/drivers/gpu/drm/apple/dcp-hdmi.c
@@ -19,7 +19,9 @@
  *    the rate those modes use, because not every request of the converter
  *    shows up as a pulse on the GPIO.
  *
- * Only the T6030 external coprocessor with a fixed HDMI route uses this.
+ * The T6030 and T8132 external coprocessors with a fixed HDMI route use
+ * this. Whether the T8132 DPTX firmware services the request is not known
+ * yet; one it refuses ends the polling (dcp_hdmi_work()).
  */
 
 #include <linux/atomic.h>
@@ -212,7 +214,8 @@ int dcp_hdmi_init(struct apple_dcp *dcp)
 
 	if (!dcp->hdmi_hpd ||
 	    dcp->fixed_connector_type != DRM_MODE_CONNECTOR_HDMIA ||
-	    !of_device_is_compatible(dcp->dev->of_node, "apple,t6030-dcpext"))
+	    (!of_device_is_compatible(dcp->dev->of_node, "apple,t6030-dcpext") &&
+	     !of_device_is_compatible(dcp->dev->of_node, "apple,t8132-dcpext")))
 		return 0;
 
 	hdmi = devm_kzalloc(dcp->dev, sizeof(*hdmi), GFP_KERNEL);
diff --git a/drivers/gpu/drm/apple/dcp-internal.h b/drivers/gpu/drm/apple/dcp-internal.h
index 6046a0f216..a462b62b14 100644
--- a/drivers/gpu/drm/apple/dcp-internal.h
+++ b/drivers/gpu/drm/apple/dcp-internal.h
@@ -982,6 +982,13 @@ struct apple_dcp {
 	bool hdmi_edge_seen;
 	struct delayed_work hdmi_settle_wq;
 	struct delayed_work hdmi_recheck_wq;
+	/* T8132 dcpext HDMI output start, see dcp_t8132_hdmi_work() */
+	struct delayed_work t8132_hdmi_wq;
+	unsigned int t8132_hdmi_tries;
+	/* Work and PM context only. */
+	bool t8132_hdmi_irq_on;
+	/* Set once the output and the Type-C routes are set up. */
+	bool t8132_hdmi;
 	/* T6030 HDMI converter service requests, see dcp-hdmi.c */
 	struct dcp_hdmi *hdmi;
 
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 33d07605d9..0d72c7ebaf 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -6390,6 +6390,266 @@ static int dcp_desktop_probe_routes(struct apple_dcp *dcp)
  * disabled, so the port controllers do not wait for them; the adopted
  * session stays.
  */
+/*
+ * The HDMI port of a T8132 board (J604: t8132-j604-hdmi.dtsi): an HDMI-A
+ * connector with the converter's hot-plug GPIO on a dcpext.
+ */
+static bool dcp_t8132_hdmi_described(struct device_node *np)
+{
+	return of_device_is_compatible(np, "apple,t8132-dcpext") &&
+	       dcp_connector_type_from_dt(np) == DRM_MODE_CONNECTOR_HDMIA &&
+	       of_property_present(np, "hdmi-hpd-gpios");
+}
+
+/* -EPROBE_DEFER while the provider of GPIO @con has not probed. */
+static int dcp_gpio_supplier(struct device *dev, const char *con)
+{
+	struct gpio_desc *desc = gpiod_get_optional(dev, con, GPIOD_ASIS);
+
+	if (PTR_ERR_OR_ZERO(desc) == -EPROBE_DEFER)
+		return -EPROBE_DEFER;
+	if (!IS_ERR_OR_NULL(desc))
+		gpiod_put(desc);
+	return 0;
+}
+
+/*
+ * Whether the HDMI output's DP PHY, crossbar and GPIOs are there. The
+ * output is taken after the adoption, which no deferral may follow; other
+ * errors are left to dcp_t8132_hdmi_setup(), which reports them.
+ */
+static int dcp_t8132_hdmi_suppliers(struct device *dev)
+{
+	struct mux_control *xbar;
+	struct phy *phy;
+
+	if (!dcp_t8132_hdmi_described(dev->of_node))
+		return 0;
+	phy = of_phy_get(dev->of_node, "dp-phy");
+	if (PTR_ERR_OR_ZERO(phy) == -EPROBE_DEFER)
+		return -EPROBE_DEFER;
+	if (!IS_ERR(phy))
+		of_phy_put(phy);
+	xbar = mux_control_get(dev, "dp-xbar");
+	if (PTR_ERR_OR_ZERO(xbar) == -EPROBE_DEFER)
+		return -EPROBE_DEFER;
+	if (!IS_ERR(xbar))
+		mux_control_put(xbar);
+	if (dcp_gpio_supplier(dev, "hdmi-hpd") ||
+	    dcp_gpio_supplier(dev, "hdmi-pwren") ||
+	    dcp_gpio_supplier(dev, "dp2hdmi-pwren"))
+		return -EPROBE_DEFER;
+	return 0;
+}
+
+/*
+ * Takes the HDMI output as the generic fixed output path of probe does
+ * (dcp_platform_probe_pipe()), inside the caller's devres group: the DP PHY,
+ * the HPD GPIO with its converter service state and edge interrupt (left
+ * disabled), the converter and port power (switched on: the HPD line needs
+ * them), the crossbar output and the PHY's DisplayPort mode.
+ */
+static int dcp_t8132_hdmi_take(struct apple_dcp *dcp)
+{
+	struct device *dev = dcp->dev;
+	u32 mux_index;
+	int irq, ret;
+
+	dcp->phy = devm_phy_get(dev, "dp-phy");
+	if (IS_ERR(dcp->phy))
+		return PTR_ERR(dcp->phy);
+	dcp->fixed_phy = dcp->phy;
+	dcp->dptx_phy = dcp->fixed_dptx_phy;
+	dcp->hdmi_hpd = devm_gpiod_get(dev, "hdmi-hpd", GPIOD_IN);
+	if (IS_ERR(dcp->hdmi_hpd))
+		return PTR_ERR(dcp->hdmi_hpd);
+	dcp->fixed_connector_type = DRM_MODE_CONNECTOR_HDMIA;
+	dcp->connector_type = DRM_MODE_CONNECTOR_HDMIA;
+	ret = dcp_hdmi_init(dcp);
+	if (ret)
+		return ret;
+	irq = gpiod_to_irq(dcp->hdmi_hpd);
+	if (irq < 0)
+		return irq;
+	ret = devm_request_threaded_irq(dev, irq, dcp_dp2hdmi_hpd_edge,
+					dcp_dp2hdmi_hpd,
+					IRQF_ONESHOT | IRQF_NO_AUTOEN |
+					IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING,
+					"dp2hdmi-hpd-irq", dcp);
+	if (ret)
+		return ret;
+	dcp->hdmi_hpd_irq = irq;
+
+	dcp->hdmi_pwren = devm_gpiod_get_optional(dev, "hdmi-pwren", GPIOD_OUT_HIGH);
+	if (IS_ERR(dcp->hdmi_pwren))
+		return PTR_ERR(dcp->hdmi_pwren);
+	dcp->dp2hdmi_pwren = devm_gpiod_get_optional(dev, "dp2hdmi-pwren",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(dcp->dp2hdmi_pwren))
+		return PTR_ERR(dcp->dp2hdmi_pwren);
+
+	ret = of_property_read_u32(dev->of_node, "mux-index", &mux_index);
+	if (ret)
+		return ret;
+	dcp->fixed_mux_index = mux_index;
+	dcp->xbar = devm_mux_control_get(dev, "dp-xbar");
+	if (IS_ERR(dcp->xbar))
+		return PTR_ERR(dcp->xbar);
+	ret = devm_add_action_or_reset(dev, dcp_release_fixed_route, dcp);
+	if (ret)
+		return ret;
+	dcp->fixed_xbar = dcp->xbar;
+	ret = mux_control_select(dcp->fixed_xbar, mux_index);
+	if (ret)
+		dev_warn(dev, "HDMI: crossbar output %u not selected: %d\n",
+			 mux_index, ret);
+	else
+		dcp->fixed_route_selected = true;
+
+	/* The PHY runs DisplayPort only (as for the T6030 HDMI port). */
+	dcp->typec_mux = fwnode_typec_mux_get(dev_fwnode(dev));
+	if (!IS_ERR_OR_NULL(dcp->typec_mux)) {
+		struct typec_altmode alt = { .svid = USB_TYPEC_DP_SID };
+		struct typec_mux_state state = {
+			.alt = &alt,
+			.mode = TYPEC_DP_STATE_C,
+		};
+
+		ret = typec_mux_set(dcp->typec_mux, &state);
+		if (ret)
+			dev_warn(dev, "HDMI: PHY not switched to DisplayPort: %d\n", ret);
+		else
+			dcp->phy_managed_by_typec = true;
+	} else {
+		dev_warn(dev, "HDMI: no PHY mode switch: %d\n",
+			 PTR_ERR_OR_ZERO(dcp->typec_mux));
+		dcp->typec_mux = NULL;
+	}
+	return 0;
+}
+
+/* Undoes the fields dcp_t8132_hdmi_take() set; its devres group is gone. */
+static void dcp_t8132_hdmi_clear(struct apple_dcp *dcp)
+{
+	dcp->phy = NULL;
+	dcp->fixed_phy = NULL;
+	dcp->hdmi_hpd = NULL;
+	dcp->hdmi_hpd_irq = 0;
+	dcp->hdmi_pwren = NULL;
+	dcp->dp2hdmi_pwren = NULL;
+	dcp->xbar = NULL;
+	dcp->fixed_xbar = NULL;
+	dcp->phy_managed_by_typec = false;
+	dcp->fixed_connector_type = DRM_MODE_CONNECTOR_eDP;
+	dcp->connector_type = DRM_MODE_CONNECTOR_eDP;
+}
+
+/*
+ * The HDMI output of an adopted T8132 dcpext. Probe cannot fail any more
+ * (the session is pinned), so an output that cannot be taken is left out
+ * and the Type-C routes go on without it.
+ */
+static void dcp_t8132_hdmi_setup(struct apple_dcp *dcp)
+{
+	struct device *dev = dcp->dev;
+	void *group;
+	int ret;
+
+	if (!dcp_t8132_hdmi_described(dev->of_node))
+		return;
+	group = devres_open_group(dev, NULL, GFP_KERNEL);
+	if (!group) {
+		dev_warn(dev, "HDMI port not set up: %d\n", -ENOMEM);
+		return;
+	}
+	ret = dcp_t8132_hdmi_take(dcp);
+	if (ret) {
+		devres_release_group(dev, group);
+		dcp_t8132_hdmi_clear(dcp);
+		dev_warn(dev, "HDMI port not set up: %d; Type-C displays go on\n", ret);
+		return;
+	}
+	devres_remove_group(dev, group);
+	dev_info(dev, "HDMI port: DP PHY %u, crossbar output %u\n",
+		 dcp->fixed_dptx_phy, dcp->fixed_mux_index);
+}
+
+#define DCP_T8132_HDMI_RETRY_MS	500
+#define DCP_T8132_HDMI_TRIES	60
+
+/*
+ * Starts the HDMI output once the firmware can connect it: enables the HPD
+ * interrupt and acts on the level, which edges before it were not seen for.
+ * Kicked by probe, by the DPTX service's publication, by the IOMFB session
+ * start and by resume.
+ */
+static void dcp_t8132_hdmi_work(struct work_struct *work)
+{
+	struct apple_dcp *dcp = container_of(to_delayed_work(work),
+					     struct apple_dcp, t8132_hdmi_wq);
+	unsigned int tries = READ_ONCE(dcp->t8132_hdmi_tries);
+
+	switch (dcp_fabric_t8132_hdmi_step(!!dcp->fixed_phy, READ_ONCE(dcp->ext_dead),
+					   iomfb_m4_external_ready(dcp),
+					   dptx_service_available(&dcp->dptxport[0]),
+					   tries, DCP_T8132_HDMI_TRIES)) {
+	case DCP_FABRIC_T8132_HDMI_IDLE:
+		if (tries >= DCP_T8132_HDMI_TRIES)
+			dev_info(dcp->dev, "HDMI: waiting for the display processor's DPTX service\n");
+		return;
+	case DCP_FABRIC_T8132_HDMI_RETRY:
+		WRITE_ONCE(dcp->t8132_hdmi_tries, tries + 1);
+		mod_delayed_work(system_freezable_wq, &dcp->t8132_hdmi_wq,
+				 msecs_to_jiffies(DCP_T8132_HDMI_RETRY_MS));
+		return;
+	case DCP_FABRIC_T8132_HDMI_START:
+		break;
+	}
+	WRITE_ONCE(dcp->t8132_hdmi_tries, 0);
+	if (!dcp->t8132_hdmi_irq_on) {
+		dcp->t8132_hdmi_irq_on = true;
+		enable_irq(dcp->hdmi_hpd_irq);
+	}
+	dcp_fabric_hdmi_sample(dcp);
+}
+
+void dcp_t8132_hdmi_kick(struct apple_dcp *dcp)
+{
+	if (!READ_ONCE(dcp->t8132_hdmi))
+		return;
+	WRITE_ONCE(dcp->t8132_hdmi_tries, 0);
+	mod_delayed_work(system_freezable_wq, &dcp->t8132_hdmi_wq, 0);
+}
+
+/* After the Type-C routes: the HDMI presence logic counts them. */
