From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 07:46:45 +0000
Subject: [PATCH] dt-bindings: power: reset: apple,smc-reboot: add the
 failed-boot record cells

Two more optional PMU cells tell what ended the previous boot: the boot
stage a failed boot had reached, which the boot loader keeps next to the
error counts, and the PMU's fault shadow. Allow them after pm_setting.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 8d378977ede8f5f0a03cf1d6fc8e2babbae7760f)
---
 .../devicetree/bindings/power/reset/apple,smc-reboot.yaml     | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Documentation/devicetree/bindings/power/reset/apple,smc-reboot.yaml b/Documentation/devicetree/bindings/power/reset/apple,smc-reboot.yaml
index 1b20e48561..c5ba77cbc7 100644
--- a/Documentation/devicetree/bindings/power/reset/apple,smc-reboot.yaml
+++ b/Documentation/devicetree/bindings/power/reset/apple,smc-reboot.yaml
@@ -30,6 +30,8 @@ properties:
       - description: Counter for boot errors
       - description: Counter for system panics
       - description: The PMU's power-on policy (after a power loss, at power connect)
+      - description: Stage a failed boot had reached, as the boot loader records it
+      - description: The PMU's record of the fault that ended the previous boot
 
   nvmem-cell-names:
     minItems: 4
@@ -39,6 +41,8 @@ properties:
       - const: boot_error_count
       - const: panic_count
       - const: pm_setting
+      - const: boot_error_stage
+      - const: fault_shadow
 
 required:
   - compatible
-- 
