From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 23:22:13 +0000
Subject: [PATCH] soc: apple: pmp: keep the GPU's AGX vote through a
 deep sleep

The PMP refused a firmware-driven suspend while the GPU held its AGX vote,
because no release was sent. Aurora's G16 sleep path (6edf2561ab, Bartosz
Nitka), which the GPU now follows, keeps that vote through the sleep, as
measured on a J713 over 8 sleeps; its PMP takes such a sleep (390530cd3c).
Let the vote stay held here too. The DISP vote still has to be released by
the display first.

Only a firmware-driven suspend reaches this check; suspend-to-idle does not
change.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/pmp-display-sleep-test.c | 22 +++++++++++-----------
 drivers/soc/apple/pmp-display-sleep.h      |  5 ++---
 2 files changed, 13 insertions(+), 14 deletions(-)

diff --git a/drivers/soc/apple/pmp-display-sleep-test.c b/drivers/soc/apple/pmp-display-sleep-test.c
index 81f34c7ff3..9a8e74e5bf 100644
--- a/drivers/soc/apple/pmp-display-sleep-test.c
+++ b/drivers/soc/apple/pmp-display-sleep-test.c
@@ -108,8 +108,8 @@ static void pmp_sleep_refused_disp_held(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, m.sends, 1U);
 }
 
-/* AGX has no release: once the GPU took it, every such sleep is refused. */
-static void pmp_sleep_refused_agx_held(struct kunit *test)
+/* The GPU's AGX vote stays through the sleep: it does not refuse it. */
+static void pmp_sleep_agx_kept(struct kunit *test)
 {
 	struct model m;
 
@@ -117,8 +117,8 @@ static void pmp_sleep_refused_agx_held(struct kunit *test)
 	m.s.consumer = true;
 	model_put_disp(&m);
 	m.v.agx_held = true;
-	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_AGX_HELD);
-	KUNIT_EXPECT_FALSE(test, m.s.asleep);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_TRUE(test, m.s.asleep);
 }
 
 static void pmp_sleep_refused_pending_or_failed(struct kunit *test)
@@ -212,8 +212,8 @@ static void pmp_sleep_disarm_on_resume(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, m.s.asleep);
 }
 
-/* Armed by the display, but the GPU holds AGX: still refused; the display's resume disarms. */
-static void pmp_sleep_armed_agx_still_refused(struct kunit *test)
+/* Armed by the display while the GPU holds AGX: the sleep goes on with the vote kept. */
+static void pmp_sleep_armed_agx_kept(struct kunit *test)
 {
 	struct model m;
 
@@ -221,9 +221,9 @@ static void pmp_sleep_armed_agx_still_refused(struct kunit *test)
 	m.v.agx_held = true;
 	model_put_disp(&m);
 	KUNIT_EXPECT_EQ(test, pmp_display_sleep_arm(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
-	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_AGX_HELD);
-	KUNIT_EXPECT_FALSE(test, m.s.asleep);
-	pmp_display_sleep_disarm(&m.s);
+	KUNIT_EXPECT_EQ(test, pmp_display_sleep_enter(&m.s, &m.v), PMP_DISPLAY_SLEEP_OK);
+	KUNIT_EXPECT_TRUE(test, m.s.asleep);
+	pmp_display_sleep_leave(&m.s);
 	KUNIT_EXPECT_EQ(test, model_get_disp(&m), 0);
 }
 
@@ -241,13 +241,13 @@ static struct kunit_case pmp_display_sleep_cases[] = {
 	KUNIT_CASE(pmp_sleep_refused_without_consumer),
 	KUNIT_CASE(pmp_sleep_teardown_restore_order),
 	KUNIT_CASE(pmp_sleep_refused_disp_held),
-	KUNIT_CASE(pmp_sleep_refused_agx_held),
+	KUNIT_CASE(pmp_sleep_agx_kept),
 	KUNIT_CASE(pmp_sleep_refused_pending_or_failed),
 	KUNIT_CASE(pmp_sleep_enter_leave_idempotent),
 	KUNIT_CASE(pmp_sleep_arm_refused_disp_held),
 	KUNIT_CASE(pmp_sleep_arm_one_sleep),
 	KUNIT_CASE(pmp_sleep_disarm_on_resume),
-	KUNIT_CASE(pmp_sleep_armed_agx_still_refused),
+	KUNIT_CASE(pmp_sleep_armed_agx_kept),
 	KUNIT_CASE(pmp_sleep_reasons),
 	{}
 };
diff --git a/drivers/soc/apple/pmp-display-sleep.h b/drivers/soc/apple/pmp-display-sleep.h
index a59ae97a5e..d2f7d43014 100644
--- a/drivers/soc/apple/pmp-display-sleep.h
+++ b/drivers/soc/apple/pmp-display-sleep.h
@@ -28,7 +28,7 @@ enum pmp_display_sleep_verdict {
 	PMP_DISPLAY_SLEEP_FAILED,
 	/* A vote request is in flight. */
 	PMP_DISPLAY_SLEEP_PENDING,
-	/* The AGX vote is held: it has no release. */
+	/* Unused: the GPU's AGX vote stays through a sleep. */
 	PMP_DISPLAY_SLEEP_AGX_HELD,
 	/* The DISP vote is held: its consumer has not powered the display down. */
 	PMP_DISPLAY_SLEEP_DISP_HELD,
@@ -60,8 +60,7 @@ pmp_display_sleep_check(const struct pmp_display_sleep *s, const struct pmp_disp
 		return PMP_DISPLAY_SLEEP_FAILED;
 	if (v->pending)
 		return PMP_DISPLAY_SLEEP_PENDING;
-	if (v->agx_held)
-		return PMP_DISPLAY_SLEEP_AGX_HELD;
+	/* The GPU's AGX vote stays held through the sleep, as Aurora's G16 path keeps it. */
 	if (v->disp_held)
 		return PMP_DISPLAY_SLEEP_DISP_HELD;
 	/* Released, but the consumer could not take DISP again after wake. */
