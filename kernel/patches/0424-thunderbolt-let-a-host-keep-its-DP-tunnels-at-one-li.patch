From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 4 Nov 2026 22:19:15 -0500
Subject: [PATCH] thunderbolt: let a host keep its DP tunnels at one link rate,
 HBR2 at most

On the M4 (T8132) both DP IN adapters of a host router feed one ATC PHY,
and the second DP IN stream only shows when both streams run at one link
rate: HBR3 next to HBR stays dark, while HBR next to HBR and HBR2 next to
HBR2 both show. Two 4K60 streams fit at HBR2.

Add a host DP policy, TB_HOST_DP_HBR2_MAX, for such a host:

- a DP tunnel from the host router's DP IN adapters offers HBR2 at most:
  both DP_LOCAL_CAPs are capped (UHBR rates cleared) before they go to the
  other side's DP_REMOTE_CAP, so that the DP OUT and the DPTX both see the
  capped rate; in bandwidth allocation mode the non-reduced rate, the
  granularity base and the maximum bandwidth a request is checked against
  use the capped rate, and the estimated bandwidth is at most what the
  capped rate takes at the non-reduced lanes;
- when the bandwidth has to be reduced, the rate is kept and the lanes go
  first (x4, x2, x1); only a tunnel with no other DP tunnel up on the host
  router falls to a lower rate after that;
- a second DP tunnel takes the link rate of the one already up, with fewer
  lanes if need be, or is not set up at all.

This narrows the cases where the two streams could differ; the DPTX still
trains the link itself, so the PHY driver checks the rates too.

No host sets the policy yet.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit fb08eb3db0fdbc4f7324159a1df16af00d560813)
---
 drivers/thunderbolt/nhi.h    |   6 ++
 drivers/thunderbolt/tb.c     |  20 ++++-
 drivers/thunderbolt/test.c   |  43 +++++++++++
 drivers/thunderbolt/tunnel.c | 137 ++++++++++++++++++++++++++++++++++-
 drivers/thunderbolt/tunnel.h |   9 +++
 5 files changed, 210 insertions(+), 5 deletions(-)

diff --git a/drivers/thunderbolt/nhi.h b/drivers/thunderbolt/nhi.h
index 4e2e914668..69aecbd972 100644
--- a/drivers/thunderbolt/nhi.h
+++ b/drivers/thunderbolt/nhi.h
@@ -224,6 +224,12 @@ struct tb_nhi_ops {
 #define TB_HOST_DP_KEEP_DPRX_TIMEOUT	BIT(3)
 #define TB_HOST_DP_ADAPTER_QUIRKS		BIT(4)
 #define TB_HOST_DP_INITIAL_BW_GRANT	BIT(5)
+/*
+ * Both DP IN streams of a host PHY must run at one link rate: DP tunnels
+ * from the host's DP IN adapters offer at most HBR2, at which two 4K60
+ * streams still fit.
+ */
+#define TB_HOST_DP_HBR2_MAX		BIT(6)
 
 /*
  * Minimal number of vectors when we use MSI-X. Two for control channel
diff --git a/drivers/thunderbolt/tb.c b/drivers/thunderbolt/tb.c
index c646171303..ec5a3f67f1 100644
--- a/drivers/thunderbolt/tb.c
+++ b/drivers/thunderbolt/tb.c
@@ -1510,7 +1510,8 @@ tb_recalc_estimated_bandwidth_for_group(struct tb_bandwidth_group *group)
 			      estimated_bw + group->reserved);
 
 		if (usb4_dp_port_set_estimated_bandwidth(in,
-				estimated_bw + group->reserved))
+				tb_dp_cap_bandwidth(tunnel,
+						    estimated_bw + group->reserved)))
 			tb_tunnel_warn(tunnel,
 				       "failed to update estimated bandwidth\n");
 	}
@@ -2149,6 +2150,23 @@ err_rpm_put:
 	pm_runtime_put_autosuspend(&in->sw->dev);
 }
 
+/*
+ * The link rate (Mb/s per lane) another DP tunnel from @tunnel's host router
+ * was given under TB_HOST_DP_HBR2_MAX, 0 if there is none. Called with the
+ * domain lock held, from the tunnel's activation.
+ */
+u32 tb_dp_host_shared_rate(const struct tb_tunnel *tunnel)
+{
+	struct tb_cm *tcm = tb_priv(tunnel->tb);
+	struct tb_tunnel *t;
+
+	list_for_each_entry(t, &tcm->tunnel_list, list)
+		if (t != tunnel && tb_tunnel_is_dp(t) && t->host_rate &&
+		    t->src_port->sw == tunnel->src_port->sw)
+			return t->host_rate;
+	return 0;
+}
+
 static void tb_tunnel_dp(struct tb *tb)
 {
 	struct tb_cm *tcm = tb_priv(tb);
diff --git a/drivers/thunderbolt/test.c b/drivers/thunderbolt/test.c
index 7f3cdfc1d6..26e6e9880f 100644
--- a/drivers/thunderbolt/test.c
+++ b/drivers/thunderbolt/test.c
@@ -3604,8 +3604,51 @@ static void tb_test_apple_right_dpin_wiring(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, tb_apple_nhi_needs_bw_grant(&missing));
 }
 
+/*
+ * TB_HOST_DP_HBR2_MAX: a second DP tunnel keeps the rate of the first and
+ * gives up lanes instead; alone, lanes go before the rate.
+ */
+static void tb_test_dp_reduce_bandwidth_shared(struct kunit *test)
+{
+	u32 rate, lanes;
+
+	/* Room for HBR2 x4: nothing reduced. */
+	KUNIT_EXPECT_EQ(test, tb_dp_reduce_bandwidth_shared(20000, 5400, 4, 5400, 4, 0,
+							    &rate, &lanes), 0);
+	KUNIT_EXPECT_EQ(test, rate, 5400);
+	KUNIT_EXPECT_EQ(test, lanes, 4);
+	KUNIT_EXPECT_EQ(test, tb_dp_reduce_bandwidth_shared(20000, 5400, 4, 5400, 4, 5400,
+							    &rate, &lanes), 0);
+	KUNIT_EXPECT_EQ(test, rate, 5400);
+	KUNIT_EXPECT_EQ(test, lanes, 4);
+	/* 10000 Mb/s: HBR2 x2, never HBR x4. */
+	KUNIT_EXPECT_EQ(test, tb_dp_reduce_bandwidth_shared(10000, 5400, 4, 5400, 4, 5400,
+							    &rate, &lanes), 0);
+	KUNIT_EXPECT_EQ(test, rate, 5400);
+	KUNIT_EXPECT_EQ(test, lanes, 2);
+	KUNIT_EXPECT_EQ(test, tb_dp_reduce_bandwidth_shared(10000, 5400, 4, 5400, 4, 0,
+							    &rate, &lanes), 0);
+	KUNIT_EXPECT_EQ(test, rate, 5400);
+	KUNIT_EXPECT_EQ(test, lanes, 2);
+	/* 4000 Mb/s: alone, a lower rate; next to an HBR2 tunnel, nothing. */
+	KUNIT_EXPECT_EQ(test, tb_dp_reduce_bandwidth_shared(4000, 5400, 4, 5400, 4, 0,
+							    &rate, &lanes), 0);
+	KUNIT_EXPECT_LT(test, rate, 5400);
+	KUNIT_EXPECT_EQ(test, tb_dp_reduce_bandwidth_shared(4000, 5400, 4, 5400, 4, 5400,
+							    &rate, &lanes), -ENOSR);
+	/* The other tunnel's rate, lower than this one's: taken, at x4. */
+	KUNIT_EXPECT_EQ(test, tb_dp_reduce_bandwidth_shared(20000, 5400, 4, 5400, 4, 2700,
+							    &rate, &lanes), 0);
+	KUNIT_EXPECT_EQ(test, rate, 2700);
+	KUNIT_EXPECT_EQ(test, lanes, 4);
+	/* A rate this sink cannot run: refused. */
+	KUNIT_EXPECT_EQ(test, tb_dp_reduce_bandwidth_shared(20000, 5400, 4, 2700, 4, 5400,
+							    &rate, &lanes), -ENOSR);
+}
+
 static struct kunit_case tb_test_cases[] = {
 	KUNIT_CASE(tb_test_apple_right_dpin_wiring),
+	KUNIT_CASE(tb_test_dp_reduce_bandwidth_shared),
 	KUNIT_CASE(tb_test_dp_generation),
 	KUNIT_CASE(tb_test_dp_dprx_deferred_first),
 	KUNIT_CASE(tb_test_dp_dprx_cancel),
diff --git a/drivers/thunderbolt/tunnel.c b/drivers/thunderbolt/tunnel.c
index 3c99c25df6..b95f768ad8 100644
--- a/drivers/thunderbolt/tunnel.c
+++ b/drivers/thunderbolt/tunnel.c
@@ -914,13 +914,84 @@ static int tb_dp_reduce_bandwidth(int max_bw, u32 in_rate, u32 in_lanes,
 	return -ENOSR;
 }
 
+/*
+ * As tb_dp_reduce_bandwidth(), for a host whose DP IN streams of a PHY share
+ * one link rate (TB_HOST_DP_HBR2_MAX): the rate is kept and the lanes are
+ * reduced (x4, x2, x1). @shared_rate, the rate of a DP tunnel already up on
+ * the same host router, is the only rate allowed (0: none). Without one, the
+ * highest rate both sides take comes first, then the usual combinations.
+ * @max_bw 0 is no bandwidth limit.
+ */
+int tb_dp_reduce_bandwidth_shared(int max_bw, u32 in_rate, u32 in_lanes, u32 out_rate,
+				  u32 out_lanes, u32 shared_rate, u32 *new_rate, u32 *new_lanes)
+{
+	static const u32 lanes[] = { 4, 2, 1 };
+	u32 rate = shared_rate ?: min(in_rate, out_rate);
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(lanes); i++) {
+		if (rate > in_rate || rate > out_rate)
+			break;
+		if (lanes[i] > in_lanes || lanes[i] > out_lanes)
+			continue;
+		if (!max_bw || tb_dp_bandwidth(rate, lanes[i]) <= max_bw) {
+			*new_rate = rate;
+			*new_lanes = lanes[i];
+			return 0;
+		}
+	}
+	if (shared_rate)
+		return -ENOSR;
+	return tb_dp_reduce_bandwidth(max_bw, in_rate, in_lanes, out_rate, out_lanes,
+				      new_rate, new_lanes);
+}
+
+/*
+ * The highest DP link rate (Mb/s per lane) a tunnel from @in offers its
+ * DPTX, 0 for no cap: HBR2 from the DP IN adapters of a host that needs
+ * one link rate for both DP IN streams of a PHY (TB_HOST_DP_HBR2_MAX).
+ */
+static u32 tb_dp_host_rate_cap(struct tb_tunnel *tunnel, struct tb_port *in)
+{
+	if (!tb_port_is_apple_host_dpin(in) ||
+	    !tb_host_dp_policy(tunnel->tb->nhi, TB_HOST_DP_HBR2_MAX))
+		return 0;
+	return 5400;
+}
+
+/* @val (a DP_LOCAL_CAP) with its rate capped at the tunnel's cap, if any. */
+static u32 tb_dp_cap_limit_rate(struct tb_tunnel *tunnel, u32 val)
+{
+	if (!tunnel->max_rate)
+		return val;
+	val &= ~(DP_COMMON_CAP_UHBR10 | DP_COMMON_CAP_UHBR13_5 | DP_COMMON_CAP_UHBR20);
+	if (tb_dp_cap_get_rate(val) > tunnel->max_rate)
+		val = tb_dp_cap_set_rate(val, tunnel->max_rate);
+	return val;
+}
+
+/*
+ * @bw (Mb/s) at most what the tunnel's capped rate needs at the non-reduced
+ * lanes, rounded up to the DP IN adapter's granularity; @bw itself without
+ * a cap. For the estimated bandwidth the DPTX is given.
+ */
+int tb_dp_cap_bandwidth(struct tb_tunnel *tunnel, int bw)
+{
+	return tunnel->max_bw ? min(bw, tunnel->max_bw) : bw;
+}
+
 static int tb_dp_xchg_caps(struct tb_tunnel *tunnel)
 {
 	u32 out_dp_cap, out_rate, out_lanes, in_dp_cap, in_rate, in_lanes, bw;
 	struct tb_port *out = tunnel->dst_port;
 	struct tb_port *in = tunnel->src_port;
+	u32 shared_rate = 0;
 	int ret, max_bw;
 
+	/* No bandwidth cap until the bandwidth allocation mode is known. */
+	tunnel->max_rate = tb_dp_host_rate_cap(tunnel, in);
+	tunnel->max_bw = 0;
+	tunnel->host_rate = 0;
+
 	/*
 	 * Copy DP_LOCAL_CAP register to DP_REMOTE_CAP register for
 	 * newer generation hardware.
@@ -947,6 +1018,21 @@ static int tb_dp_xchg_caps(struct tb_tunnel *tunnel)
 	if (ret)
 		return ret;
 
+	/*
+	 * Both sides see the capped rate: the DP OUT through its remote caps,
+	 * the DPTX through the DP IN's.
+	 */
+	if (tunnel->max_rate &&
+	    (tb_dp_cap_get_rate_ext(in_dp_cap) > tunnel->max_rate ||
+	     tb_dp_cap_get_rate_ext(out_dp_cap) > tunnel->max_rate)) {
+		tb_tunnel_dbg(tunnel,
+			      "DP IN %u, DP OUT %u Mb/s per lane capped at %u Mb/s\n",
+			      tb_dp_cap_get_rate_ext(in_dp_cap), tb_dp_cap_get_rate_ext(out_dp_cap),
+			      tunnel->max_rate);
+		in_dp_cap = tb_dp_cap_limit_rate(tunnel, in_dp_cap);
+		out_dp_cap = tb_dp_cap_limit_rate(tunnel, out_dp_cap);
+	}
+
 	/* Write IN local caps to OUT remote caps */
 	ret = tb_port_write(out, &in_dp_cap, TB_CFG_PORT,
 			    out->cap_adap + DP_REMOTE_CAP, 1);
@@ -975,16 +1061,38 @@ static int tb_dp_xchg_caps(struct tb_tunnel *tunnel)
 	else
 		max_bw = tunnel->max_up;
 
-	if (max_bw && bw > max_bw) {
+	/*
+	 * Under TB_HOST_DP_HBR2_MAX a second DP tunnel from the host router
+	 * takes the link rate of the one already up, whatever bandwidth there
+	 * is: both DP IN streams of the PHY run at one rate.
+	 */
+	if (tunnel->max_rate)
+		shared_rate = tb_dp_host_shared_rate(tunnel);
+
+	if ((max_bw && bw > max_bw) ||
+	    (shared_rate && shared_rate != min(in_rate, out_rate))) {
 		u32 new_rate, new_lanes, new_bw;
 
-		ret = tb_dp_reduce_bandwidth(max_bw, in_rate, in_lanes,
-					     out_rate, out_lanes, &new_rate,
-					     &new_lanes);
+		if (tunnel->max_rate)
+			ret = tb_dp_reduce_bandwidth_shared(max_bw, in_rate, in_lanes,
+							    out_rate, out_lanes, shared_rate,
+							    &new_rate, &new_lanes);
+		else
+			ret = tb_dp_reduce_bandwidth(max_bw, in_rate, in_lanes,
+						     out_rate, out_lanes, &new_rate,
+						     &new_lanes);
+		if (ret && shared_rate) {
+			tb_tunnel_info(tunnel, "the other DP tunnel's link rate (%u Mb/s) is not available: not tunneling\n",
+				       shared_rate);
+			return ret;
+		}
 		if (ret) {
 			tb_tunnel_info(tunnel, "not enough bandwidth\n");
 			return ret;
 		}
+		/* The DPTX's non-reduced rate is no higher, see tb_dp_cap_limit_rate(). */
+		if (tunnel->max_rate)
+			tunnel->max_rate = min(tunnel->max_rate, new_rate);
 
 		new_bw = tb_dp_bandwidth(new_rate, new_lanes);
 		tb_tunnel_dbg(tunnel,
@@ -999,6 +1107,9 @@ static int tb_dp_xchg_caps(struct tb_tunnel *tunnel)
 		out_dp_cap = tb_dp_cap_set_lanes(out_dp_cap, new_lanes);
 	}
 
+	if (tunnel->max_rate)
+		tunnel->host_rate = min(in_rate, tb_dp_cap_get_rate(out_dp_cap));
+
 	/*
 	 * Titan Ridge does not disable AUX timers when it gets
 	 * SET_CONFIG with SET_LTTPR_MODE set. This causes problems with
@@ -1064,6 +1175,10 @@ static int tb_dp_bandwidth_alloc_mode_enable(struct tb_tunnel *tunnel)
 	if (ret)
 		return ret;
 
+	/* The DPTX's non-reduced rate is the capped one. */
+	in_dp_cap = tb_dp_cap_limit_rate(tunnel, in_dp_cap);
+	out_dp_cap = tb_dp_cap_limit_rate(tunnel, out_dp_cap);
+
 	in_rate = tb_dp_cap_get_rate(in_dp_cap);
 	in_lanes = tb_dp_cap_get_lanes(in_dp_cap);
 	out_rate = tb_dp_cap_get_rate(out_dp_cap);
@@ -1108,6 +1223,17 @@ static int tb_dp_bandwidth_alloc_mode_enable(struct tb_tunnel *tunnel)
 	if (ret)
 		return ret;
 
+	/*
+	 * The DPTX is never told of more bandwidth than the capped rate takes
+	 * at these lanes.
+	 */
+	if (tunnel->max_rate) {
+		tunnel->max_bw = roundup(non_reduced_bw, granularity);
+		tb_tunnel_dbg(tunnel,
+			      "non-reduced %u Mb/s x%u, estimated bandwidth at most %d Mb/s\n",
+			      rate, lanes, tunnel->max_bw);
+	}
+
 	/*
 	 * Bandwidth estimation is pretty much what we have in
 	 * max_up/down fields. For discovery we just read what the
@@ -1117,6 +1243,7 @@ static int tb_dp_bandwidth_alloc_mode_enable(struct tb_tunnel *tunnel)
 		estimated_bw = tunnel->max_down;
 	else
 		estimated_bw = tunnel->max_up;
+	estimated_bw = tb_dp_cap_bandwidth(tunnel, estimated_bw);
 
 	tb_tunnel_dbg(tunnel, "estimated bandwidth %d Mb/s\n", estimated_bw);
 
@@ -1513,6 +1640,8 @@ static int tb_dp_bandwidth_mode_maximum_bandwidth(struct tb_tunnel *tunnel,
 	if (ret)
 		return ret;
 
+	/* No request above the capped rate is granted. */
+	cap = tb_dp_cap_limit_rate(tunnel, cap);
 	rate = tb_dp_cap_get_rate_ext(cap);
 	lanes = tb_dp_cap_get_lanes(cap);
 
diff --git a/drivers/thunderbolt/tunnel.h b/drivers/thunderbolt/tunnel.h
index dee1b1f43a..0755a78e96 100644
--- a/drivers/thunderbolt/tunnel.h
+++ b/drivers/thunderbolt/tunnel.h
@@ -105,6 +105,11 @@ struct tb_tunnel {
 	int allocated_up;
 	int allocated_down;
 	bool bw_mode;
+	/* host cap of a DP tunnel's link rate (Mb/s per lane, 0 none), and its bandwidth */
+	u32 max_rate;
+	int max_bw;
+	/* under TB_HOST_DP_HBR2_MAX: the link rate the DPTX was offered (Mb/s per lane) */
+	u32 host_rate;
 	bool dprx_started;
 	bool dprx_canceled;
 	u64 host_dp_generation;
@@ -131,6 +136,10 @@ struct tb_tunnel *tb_tunnel_discover_dp(struct tb *tb, struct tb_port *in,
 					void (*callback)(struct tb_tunnel *));
 void tb_dp_tunnel_cancel_dprx(struct tb_tunnel *tunnel);
 bool tb_apple_nhi_needs_bw_grant(struct tb_nhi *nhi);
+int tb_dp_cap_bandwidth(struct tb_tunnel *tunnel, int bw);
+int tb_dp_reduce_bandwidth_shared(int max_bw, u32 in_rate, u32 in_lanes, u32 out_rate,
+				  u32 out_lanes, u32 shared_rate, u32 *new_rate, u32 *new_lanes);
+u32 tb_dp_host_shared_rate(const struct tb_tunnel *tunnel);
 struct tb_tunnel *tb_tunnel_alloc_dp(struct tb *tb, struct tb_port *in,
 				     struct tb_port *out, int link_nr,
 				     int max_up, int max_down,
