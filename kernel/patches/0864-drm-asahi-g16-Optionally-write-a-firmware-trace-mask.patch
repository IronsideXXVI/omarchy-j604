From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 03:26:59 +0000
Subject: [PATCH] drm/asahi: g16: Optionally write a firmware trace
 mask

The firmware's trace gate is not a Main word. 25G83 loads it from the
first word of the control object, whose address the init block carries,
and the driver writes that word as 0.

Add g16_ktrace_mask (load time, default 0) to choose the value, so the
firmware trace ring can be filled for a measurement boot. The default
writes the same 0 as before.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/asahi_core.rs   | 4 ++++
 drivers/gpu/drm/asahi/g16/initdata.rs | 2 +-
 drivers/gpu/drm/asahi/g16/params.rs   | 8 ++++++++
 3 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/asahi/asahi_core.rs b/drivers/gpu/drm/asahi/asahi_core.rs
index 577a9efedc..954ba8fbf8 100644
--- a/drivers/gpu/drm/asahi/asahi_core.rs
+++ b/drivers/gpu/drm/asahi/asahi_core.rs
@@ -283,6 +283,10 @@ fn init(module: &'static kernel::ThisModule) -> impl PinInit<Self, Error> {
             default: 0,
             description: "G16: Main +0xf38 = 1 and +0x2568 = core count, as macOS (default 0)",
         },
+        g16_ktrace_mask: u32 {
+            default: 0,
+            description: "G16: firmware trace mask written to CONTROL+0 at init (default 0: none)",
+        },
         g16_j604_main: u32 {
             default: 0,
             description: "G16: J604 Main tables as macOS has them (default 0; needs eleven rows)",
diff --git a/drivers/gpu/drm/asahi/g16/initdata.rs b/drivers/gpu/drm/asahi/g16/initdata.rs
index b072f26566..e4766f8826 100644
--- a/drivers/gpu/drm/asahi/g16/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/initdata.rs
@@ -166,7 +166,7 @@ pub(crate) fn build(
         scratch: 0,
         lower_uma: wire::BOOTSTRAP_START,
         lower_parameter: wire::BOOTSTRAP_START + 0x8000,
-        ktrace_mask: 0,
+        ktrace_mask: super::params::ktrace_mask(),
         progress_recovery: 1,
         idle_power_off: idle_power_off_level != 0,
         globals_required: super::params::globals_required(),
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 56562e6b4c..f2bc617769 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -658,6 +658,14 @@ pub(crate) fn main_nap() -> bool {
     module_parameters::g16_main_nap.value() != 0
 }
 
+/// `g16_ktrace_mask` (load time): the word written to CONTROL+0 at init. 25G83 copies it into
+/// its trace gate (0x192db4) from fn 0x3350, which INIT points at CONTROL through init-block
+/// +0xa8. Bit 0 enables the event-handler trace points, bit 1 the scheduler ones, bit 2 the power
+/// ones. 0 (the default) is the value written before this parameter existed.
+pub(crate) fn ktrace_mask() -> u32 {
+    module_parameters::g16_ktrace_mask.value()
+}
+
 /// Enabled GPU cores, from the identity read at power-up (0 before it).
 static CORES: AtomicU32 = AtomicU32::new(0);
 
-- 
