+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! `g16_compute_queues`: the firmware compute queue a compute command goes to. Core only, so
+//! the rule runs as a host test together with the retirement model below.
+//!
+//! The firmware runs the commands of one queue one at a time (StartCompute sets the queue's
+//! busy bit and the wait op parks that queue until it clears) and different queues at once.
+//! A command therefore goes to a queue other than its predecessor's only when it names no
+//! command still running. Retirement stays in publication order, and each flight is proved
+//! with the stamps and cursors of its own queue, which no other queue writes.
+
+/// Firmware compute queues at most.
+pub(crate) const QUEUES_MAX: usize = 4;
+
+/// Firmware queue ids (the submit record's event byte) of compute queues 0, 1, 2 and 3: 15
+/// as before, then 16, 17 and 18. Their busy bits (id mod 64) differ from render's 0x70 and
+/// 0x71 (48 and 49) and from `g16_render_qids` 0x13 and 0x14.
+pub(crate) const QUEUE_IDS: [u8; QUEUES_MAX] = [15, 16, 17, 18];
+
+/// Where the next compute command goes.
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Place {
+    /// On this queue.
+    Queue(usize),
+    /// Not now: it is published once the running flights it may depend on have retired.
+    Wait,
+}
+
+/// What [`place`] decides from.
+#[derive(Copy, Clone, Debug)]
+pub(crate) struct State<'a> {
+    /// Latched queues, 1 up to [`QUEUES_MAX`].
+    pub(crate) queues: usize,
+    /// Queue of the most recent compute publication.
+    pub(crate) last: usize,
+    /// Queues whose first (registering) submit record was published.
+    pub(crate) registered: &'a [bool],
+    /// Some flight is running: the command would go behind it.
+    pub(crate) ahead: bool,
+    /// `g16_job_ahead` or `g16_same_queue_nowait` is on: a command may rely on the order of
+    /// its queue instead of a retirement, so every command uses queue 0.
+    pub(crate) queue_order: bool,
+    /// Some running compute flight is on a queue other than 0.
+    pub(crate) running_off_zero: bool,
+    /// Every barrier, historical prior and in-fence of the command has retired.
+    pub(crate) waits_retired: bool,
+}
+
+/// The queue for the next compute command. With one queue always queue 0, as before.
+pub(crate) fn place(s: &State<'_>) -> Place {
+    let n = s.queues.clamp(1, QUEUES_MAX).min(s.registered.len());
+    if n <= 1 {
+        return Place::Queue(0);
+    }
+    if s.queue_order {
+        return if s.ahead && s.running_off_zero {
+            Place::Wait
+        } else {
+            Place::Queue(0)
+        };
+    }
+    if !s.ahead {
+        // Nothing runs: a queue is registered on an idle engine, as queue 0 always was.
+        if let Some(q) = (0..n).find(|&q| !s.registered[q]) {
+            return Place::Queue(q);
+        }
+        return Place::Queue((s.last + 1) % n);
+    }
+    if !s.waits_retired {
+        // It names a running command. Not reached while queue_order is off: a command goes
+        // behind running flights only once everything it names has retired.
+        return Place::Wait;
+    }
+    let next = (s.last + 1) % n;
+    if s.registered[next] {
+        Place::Queue(next)
+    } else {
+        Place::Queue(s.last % n)
+    }
+}
+
+#[cfg(test)]
+#[path = "recovery/logic.rs"]
+#[allow(dead_code)]
+mod logic;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn st(queues: usize, last: usize, registered: &[bool], ahead: bool) -> State<'_> {
+        State {
+            queues,
+            last,
+            registered,
+            ahead,
+            queue_order: false,
+            running_off_zero: false,
+            waits_retired: true,
+        }
+    }
+
+    #[test]
+    fn one_queue_is_queue_zero() {
+        for ahead in [false, true] {
+            let mut s = st(1, 0, &[true, true], ahead);
+            assert_eq!(place(&s), Place::Queue(0));
+            s.waits_retired = false;
+            s.queue_order = true;
+            s.running_off_zero = true;
+            assert_eq!(place(&s), Place::Queue(0));
+        }
+    }
+
+    #[test]
+    fn queues_register_only_on_an_idle_engine() {
+        assert_eq!(place(&st(2, 0, &[false, false], false)), Place::Queue(0));
+        assert_eq!(place(&st(2, 0, &[true, false], false)), Place::Queue(1));
+        // Behind running work an unregistered queue is never the target.
+        assert_eq!(place(&st(2, 0, &[true, false], true)), Place::Queue(0));
+        assert_eq!(
+            place(&st(4, 1, &[true, true, false, false], true)),
+            Place::Queue(1)
+        );
+    }
+
+    #[test]
+    fn independent_commands_rotate() {
+        let r = [true; 4];
+        assert_eq!(place(&st(2, 0, &r, true)), Place::Queue(1));
+        assert_eq!(place(&st(2, 1, &r, true)), Place::Queue(0));
+        assert_eq!(place(&st(4, 3, &r, true)), Place::Queue(0));
+        assert_eq!(place(&st(3, 1, &r, false)), Place::Queue(2));
+    }
+
+    #[test]
+    fn a_command_naming_running_work_waits() {
+        let r = [true; 2];
+        let mut s = st(2, 0, &r, true);
+        s.waits_retired = false;
+        assert_eq!(place(&s), Place::Wait);
+        // Alone, nothing it names can still run.
+        s.ahead = false;
+        assert_eq!(place(&s), Place::Queue(1));
+    }
+
+    #[test]
+    fn recovery_names_each_queue_id() {
+        let last = [Some(0x500), None, None];
+        for id in QUEUE_IDS {
+            assert!(logic::last_retired_target(&last, u32::from(id), 0x500));
+            assert!(!logic::last_retired_target(&last, u32::from(id), 0x600));
+        }
+        assert!(!logic::last_retired_target(&last, 0x13, 0x500));
+    }
+
+    #[test]
+    fn queue_order_modes_keep_queue_zero() {
+        let r = [true; 2];
+        let mut s = st(2, 1, &r, true);
+        s.queue_order = true;
+        assert_eq!(place(&s), Place::Queue(0));
+        s.running_off_zero = true;
+        assert_eq!(place(&s), Place::Wait);
+        s.ahead = false;
+        assert_eq!(place(&s), Place::Queue(0));
+    }
+
+    // Retirement model: commands 1..=N rotate over two queues; each queue finishes its own
+    // commands in order (one at a time), the queues in any interleaving. The host retires the
+    // oldest flight only when its OWN queue's stamp cell reached its target within that
+    // queue's newest target. A shared cell or the shared completion count alone would not do.
+    fn stamp(n: u64) -> u32 {
+        (n as u32).wrapping_mul(0x100)
+    }
+
+    /// Every interleaving of two in-order sequences of lengths a and b, as queue choices.
+    fn interleavings(a: usize, b: usize, cur: &mut Vec<usize>, out: &mut Vec<Vec<usize>>) {
+        if a == 0 && b == 0 {
+            out.push(cur.clone());
+            return;
+        }
+        if a > 0 {
+            cur.push(0);
+            interleavings(a - 1, b, cur, out);
+            cur.pop();
+        }
+        if b > 0 {
+            cur.push(1);
+            interleavings(a, b - 1, cur, out);
+            cur.pop();
+        }
+    }
+
+    struct Run {
+        early_per_queue: usize,
+        early_shared_cell: usize,
+        early_count_alone: usize,
+        retired: usize,
+    }
+
+    fn run(n: u64, base: u64, finish: &[usize]) -> Run {
+        // Command i (base + 1 ..= base + n) goes to queue (i - base - 1) % 2.
+        let cmds: Vec<(u64, usize)> = (1..=n)
+            .map(|i| (base + i, ((i - 1) % 2) as usize))
+            .collect();
+        let mut tail = [0u32; 2];
+        for &(c, q) in cmds.iter() {
+            tail[q] = stamp(c);
+        }
+        let mut cell = [stamp(base), stamp(base)];
+        let mut count = 0u64;
+        let mut finished = vec![false; n as usize];
+        let mut next = [0usize; 2];
+        let per_queue: Vec<Vec<usize>> = (0..2)
+            .map(|q| (0..n as usize).filter(|&i| cmds[i].1 == q).collect())
+            .collect();
+        let mut oldest = 0usize;
+        let mut r = Run {
+            early_per_queue: 0,
+            early_shared_cell: 0,
+            early_count_alone: 0,
+            retired: 0,
+        };
+        for &q in finish {
+            let i = per_queue[q][next[q]];
+            next[q] += 1;
+            finished[i] = true;
+            cell[q] = stamp(cmds[i].0);
+            // One shared cell would hold whichever command finished last.
+            let shared = stamp(cmds[i].0);
+            count += 1;
+            while oldest < n as usize {
+                let (c, oq) = cmds[oldest];
+                let own = logic::stamp_reached(cell[oq], stamp(c), tail[oq]);
+                let via_shared = logic::stamp_reached(shared, stamp(c), stamp(base + n));
+                let via_count = count >= oldest as u64 + 1;
+                if !finished[oldest] {
+                    r.early_per_queue += usize::from(own);
+                    r.early_shared_cell += usize::from(via_shared);
+                    r.early_count_alone += usize::from(via_count);
+                }
+                if !(own && via_count) {
+                    break;
+                }
+                assert!(finished[oldest], "retired before its own command finished");
+                oldest += 1;
+                r.retired += 1;
+            }
+        }
+        r
+    }
+
+    #[test]
+    fn out_of_order_finishes_never_retire_early() {
+        for (n, base) in [(6u64, 0u64), (7, 41), (6, (1u64 << 24) - 3)] {
+            let a = n.div_ceil(2) as usize;
+            let b = (n / 2) as usize;
+            let mut all = Vec::new();
+            interleavings(a, b, &mut Vec::new(), &mut all);
+            let (mut shared_hits, mut count_hits) = (0, 0);
+            for finish in all.iter() {
+                let r = run(n, base, finish);
+                assert_eq!(r.early_per_queue, 0);
+                assert_eq!(
+                    r.retired, n as usize,
+                    "every flight retires once all finished"
+                );
+                shared_hits += r.early_shared_cell;
+                count_hits += r.early_count_alone;
+            }
+            // Negative controls: one shared cell, or the shared count alone, would retire a
+            // command whose own work had not finished in some interleaving.
+            assert!(shared_hits > 0 && count_hits > 0);
+        }
+    }
+}
