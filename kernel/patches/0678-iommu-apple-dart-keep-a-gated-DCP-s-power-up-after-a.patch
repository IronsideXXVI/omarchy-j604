From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 10:53:54 +0000
Subject: [PATCH] iommu: apple-dart: keep a gated DCP's power-up after
 a deep sleep

On the J604 (T8132) every deep sleep entered with the panel on powers
the internal DCP down inside the suspend path, and the power-up check
after the wake then quarantined the display:

  apple-dart 30a340000.iommu: SID6 TTBR0 03200000, had 00000000
  apple-dart 30a340000.iommu: DCP SID23 retired: power-up: state lost (-5)
  apple-dcp 30ae00000.dcp: Retained DCP session quarantined: -5

and every later suspend failed in the display driver with -EIO.

The wake rebuilds the DCP's DART as iBoot set it up, not as this kernel
left it at power-down. With this change applied the J604 logs, for the
one stream that differs:

  apple-dart 30a340000.iommu: SID6 after the wake: on 0 (had 0),
  TCR 00000001 (had 00000001), TTBR0 01000000 (had 00000000)

SID6 is iBoot's: it was off at power-down with iBoot's TCR
(TRANSLATE_ENABLE) and no page table, and each wake writes it another
TTBR0 (0x01000000, 0x01200000, 0x03200000 seen), none with the valid
bit. The DART is protected and locked and was adopted from iBoot with no
writes.

What the check protects is the page tables of this kernel's streams:
they stay in memory and the retained DCP session maps through them. So,
after a real sleep and before the check:

- a stream with a valid saved page table is ours: write its saved TCR
  and TTBRs back and keep it in the check, so the power-up still fails
  if the DART does not take them;
- any other stream is put back as it was at power-down and left out of
  the check; on a DART whose TTBRs and TCRs were locked at power-down it
  is not written, and stays as the wake handed it over, as at boot;
- a stream the wake turned on that was off at power-down goes off again,
  so the stream enable reads back as saved.

The check also compares TTBRs by their valid bit: a mismatch where
neither value is valid translates nothing and is no loss. Each stream
that differs after a wake is logged at debug level. The boot line that
called the internal display DART a "J713" one now names the board from
the machine's compatible.

KUnit: the J604 values (invalid wake TTBRs, locked, on or off, TCR 0 or
TRANSLATE_ENABLE), write-back on an unlocked DART, a valid saved TTBR
restored or lost, a valid wake TTBR on a stream with no table of ours,
and an invalid TTBR without a sleep.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/iommu/apple-dart-test.c | 161 ++++++++++++++++++++++++++++++++
 drivers/iommu/apple-dart.c      | 123 +++++++++++++++++++++++-
 2 files changed, 279 insertions(+), 5 deletions(-)

diff --git a/drivers/iommu/apple-dart-test.c b/drivers/iommu/apple-dart-test.c
index 49f3514e9a..f8b79210b6 100644
--- a/drivers/iommu/apple-dart-test.c
+++ b/drivers/iommu/apple-dart-test.c
@@ -1117,6 +1117,162 @@ static void apple_dart_test_host_power_refused(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, apple_dart_test_slice(dart), 0x12U);
 }
 
+/*
+ * Power-up after a real sleep, with the values a J604 read (1.926 boot 57fd7070, 1.928 boot
+ * ed446d35): the wake left SID6 TTBR0 0x03200000 (0x01200000 on 1.923 boot 87d1369e) where the
+ * power-down state had 0. The internal display DART is TTBR/TCR protected and locked.
+ */
+static const u32 apple_dart_test_wake_ttbr[] = { 0x03200000, 0x01200000 };
+
+struct apple_dart_test_sleep {
+	u32 drop_offset;	/* a register write the DART does not take, 0 for none */
+};
+
+static void apple_dart_test_sleep_writel(struct apple_dart *dart, u32 value, u32 offset)
+{
+	struct kunit *test = kunit_get_current_test();
+	struct apple_dart_test_sleep *sleep = test ? test->priv : NULL;
+
+	if (sleep && sleep->drop_offset && offset == sleep->drop_offset)
+		return;
+	/* DISABLE_STREAMS clears ENABLE_STREAMS bits, as the hardware does. */
+	if (offset == DART_T8110_DISABLE_STREAMS)
+		writel(readl(dart->regs + DART_T8110_ENABLE_STREAMS) & ~value,
+		       dart->regs + DART_T8110_ENABLE_STREAMS);
+	writel(value, dart->regs + offset);
+}
+
+static struct apple_dart *apple_dart_test_slept_dart(struct kunit *test, bool locked, u32 tcr6,
+						     bool on6, u32 wake_ttbr6)
+{
+	struct apple_dart *dart = apple_dart_test_host_dart(test);
+	struct apple_dart_test_sleep *sleep;
+
+	sleep = kunit_kzalloc(test, sizeof(*sleep), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sleep);
+	test->priv = sleep;
+	kunit_activate_static_stub(test, apple_dart_writel, apple_dart_test_sleep_writel);
+	dart->num_streams = 8;
+	if (!locked) {
+		writel(0, dart->regs + DART_T8110_PROTECT);
+		writel(0, dart->regs + DART_T8110_PROTECT_LOCK);
+	}
+	writel(tcr6, dart->regs + DART_TCR(dart, 6));
+	KUNIT_ASSERT_EQ(test, apple_dart_host_power_off(dart), 0);
+	/* SID6 on at power-down with nothing in it. */
+	if (on6)
+		dart->off_streams |= BIT(6);
+	/* The wake, as the J604 read it. */
+	dart->host_off_slept = true;
+	writel(wake_ttbr6, dart->regs + DART_TTBR(dart, 6, 0));
+	return dart;
+}
+
+/* The J604 case: a TTBR without its valid bit is no loss, on or off, TCR 0 or not. */
+static void apple_dart_test_host_power_slept_invalid_ttbr(struct kunit *test)
+{
+	unsigned int i, variant;
+
+	for (i = 0; i < ARRAY_SIZE(apple_dart_test_wake_ttbr); i++) {
+		for (variant = 0; variant < 4; variant++) {
+			u32 tcr6 = variant & 1 ? DART_T8110_TCR_TRANSLATE_ENABLE : 0;
+			bool on6 = variant & 2;
+			struct apple_dart *dart;
+
+			dart = apple_dart_test_slept_dart(test, true, tcr6, on6,
+							  apple_dart_test_wake_ttbr[i]);
+			KUNIT_EXPECT_EQ_MSG(test, apple_dart_host_power_on(dart), 0,
+					    "TTBR0 %08x tcr %08x on %d",
+					    apple_dart_test_wake_ttbr[i], tcr6, on6);
+			KUNIT_EXPECT_FALSE(test, READ_ONCE(dart->host_off));
+			/* Locked: nothing written. */
+			KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_TTBR(dart, 6, 0)),
+					apple_dart_test_wake_ttbr[i]);
+			KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_T8110_ENABLE_STREAMS),
+					on6 ? BIT(6) : 0U);
+		}
+	}
+}
+
+/* Unlocked, the saved state goes back, and a stream the wake turned on goes off. */
+static void apple_dart_test_host_power_slept_write_back(struct kunit *test)
+{
+	struct apple_dart *dart = apple_dart_test_slept_dart(test, false, 0, false, 0x03200000);
+
+	writel(BIT(6), dart->regs + DART_T8110_ENABLE_STREAMS);
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_on(dart), 0);
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_TTBR(dart, 6, 0)), 0U);
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_T8110_ENABLE_STREAMS), 0U);
+	KUNIT_EXPECT_FALSE(test, READ_ONCE(dart->host_off));
+}
+
+/* A valid saved TTBR that comes back different: restored if the DART takes it, else lost. */
+static void apple_dart_test_host_power_slept_valid_ttbr(struct kunit *test)
+{
+	const u32 saved = apple_dart_hw_t8110.ttbr_valid | 0x1234;
+	const u32 other = apple_dart_hw_t8110.ttbr_valid | 0x5678;
+	struct apple_dart_test_sleep *sleep;
+	struct apple_dart *dart;
+
+	dart = apple_dart_test_slept_dart(test, true, 0, false, 0);
+	writel(other, dart->regs + DART_TTBR(dart, 1, 0));
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_on(dart), -EIO);
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_TTBR(dart, 1, 0)), other);
+	KUNIT_EXPECT_TRUE(test, READ_ONCE(dart->host_off));
+
+	dart = apple_dart_test_slept_dart(test, false, 0, false, 0);
+	writel(other, dart->regs + DART_TTBR(dart, 1, 0));
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_on(dart), 0);
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_TTBR(dart, 1, 0)), saved);
+
+	dart = apple_dart_test_slept_dart(test, false, 0, false, 0);
+	sleep = test->priv;
+	sleep->drop_offset = DART_TTBR(dart, 1, 0);
+	writel(other, dart->regs + DART_TTBR(dart, 1, 0));
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_on(dart), -EIO);
+	KUNIT_EXPECT_TRUE(test, READ_ONCE(dart->host_off));
+}
+
+/*
+ * A valid TTBR the wake gave a stream with no table of ours (J604 1.929 boot 4554d16a: SID6 TCR
+ * 0x1 kept, TTBR0 0x01000000, saved 0): on the locked DART it is iBoot's and stays, not written;
+ * on an unlocked one it is put back to the saved state. Either way the power-up goes on, unless
+ * the stream was on at power-down on the locked DART: power-up would enable it through that
+ * table.
+ */
+static void apple_dart_test_host_power_slept_foreign_valid(struct kunit *test)
+{
+	const u32 wake = apple_dart_hw_t8110.ttbr_valid | 0x01000000;
+	struct apple_dart *dart;
+
+	dart = apple_dart_test_slept_dart(test, true, DART_T8110_TCR_TRANSLATE_ENABLE, false,
+					  wake);
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_on(dart), 0);
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_TTBR(dart, 6, 0)), wake);
+	KUNIT_EXPECT_FALSE(test, READ_ONCE(dart->host_off));
+
+	dart = apple_dart_test_slept_dart(test, false, DART_T8110_TCR_TRANSLATE_ENABLE, false,
+					  wake);
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_on(dart), 0);
+	KUNIT_EXPECT_EQ(test, readl(dart->regs + DART_TTBR(dart, 6, 0)), 0U);
+	KUNIT_EXPECT_FALSE(test, READ_ONCE(dart->host_off));
+
+	dart = apple_dart_test_slept_dart(test, true, DART_T8110_TCR_TRANSLATE_ENABLE, true, wake);
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_on(dart), -EIO);
+	KUNIT_EXPECT_TRUE(test, READ_ONCE(dart->host_off));
+}
+
+/* Without a sleep an invalid TTBR that differs is no loss either (a valid one: host_power_lost). */
+static void apple_dart_test_host_power_invalid_ttbr_no_sleep(struct kunit *test)
+{
+	struct apple_dart *dart = apple_dart_test_host_dart(test);
+
+	dart->num_streams = 8;
+	KUNIT_ASSERT_EQ(test, apple_dart_host_power_off(dart), 0);
+	writel(0x03200000, dart->regs + DART_TTBR(dart, 6, 0));
+	KUNIT_EXPECT_EQ(test, apple_dart_host_power_on(dart), 0);
+}
+
 /*
  * Generic SID0 DMA while the DCP has the DART powered down: translations,
  * flushes and unmaps use the page tables only, and the power-up flushes.
@@ -1347,6 +1503,11 @@ static struct kunit_case apple_dart_test_cases[] = {
 	KUNIT_CASE(apple_dart_test_host_power_lost),
 	KUNIT_CASE(apple_dart_test_host_power_refused),
 	KUNIT_CASE(apple_dart_test_host_power_tables),
+	KUNIT_CASE(apple_dart_test_host_power_slept_invalid_ttbr),
+	KUNIT_CASE(apple_dart_test_host_power_slept_write_back),
+	KUNIT_CASE(apple_dart_test_host_power_slept_valid_ttbr),
+	KUNIT_CASE(apple_dart_test_host_power_slept_foreign_valid),
+	KUNIT_CASE(apple_dart_test_host_power_invalid_ttbr_no_sleep),
 #endif
 	{}
 };
diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 1203ba49a7..0a42d4e8a2 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -855,6 +855,19 @@ static bool apple_dart_frontend_enabled;
 module_param_named(j713_display, apple_dart_frontend_enabled, bool, 0600);
 MODULE_PARM_DESC(j713_display, "Enable explicit J713 display DART admission after arming watchdog");
 
+/* The machine's first compatible string, for log lines that name the board. */
+static const char *apple_dart_board(void)
+{
+	struct device_node *root = of_find_node_by_path("/");
+	const char *board = NULL;
+
+	if (root) {
+		of_property_read_string(root, "compatible", &board);
+		of_node_put(root);
+	}
+	return board ?: "unknown board";
+}
+
 static int apple_dart_dcp_invalidate_tlb(struct apple_dart_stream_map *stream_map);
 
 #include "apple-dart-dcp.h"
@@ -5659,8 +5672,8 @@ static int apple_dart_probe(struct platform_device *pdev)
 			ret = -EINVAL;
 			goto err_clk_disable;
 		}
-		dev_info(dev, "J713 display DART version %04x, locked %d\n",
-			 dart->version, dart->locked);
+		dev_info(dev, "%s display DART version %04x, locked %d\n",
+			 apple_dart_board(), dart->version, dart->locked);
 		ret = res->start == 0x30a340000ULL || j713_dcpext ?
 			apple_dart_dcp_prepare(dart) :
 			dart->dispext ? apple_dart_dispext_prepare(dart) :
@@ -6352,13 +6365,17 @@ static __maybe_unused int apple_dart_suspend(struct device *dev)
  * controller in host mode, holds the domain on. Such a consumer may still be
  * doing DMA, so the DART must not be reset under it.
  */
-static bool apple_dart_state_retained(struct apple_dart *dart)
+static bool apple_dart_state_retained_except(struct apple_dart *dart, u64 skip)
 {
 	bool live = false;
 	unsigned int sid, idx;
 
 	for (sid = 0; sid < dart->num_streams; sid++) {
-		u32 tcr = apple_dart_readl(dart, DART_TCR(dart, sid));
+		u32 tcr;
+
+		if (sid < 64 && (skip & BIT_ULL(sid)))
+			continue;
+		tcr = apple_dart_readl(dart, DART_TCR(dart, sid));
 
 		if (tcr != dart->save_tcr[sid]) {
 			if (dart->host_off_slept)
@@ -6374,6 +6391,9 @@ static bool apple_dart_state_retained(struct apple_dart *dart)
 			u32 ttbr = apple_dart_readl(dart, DART_TTBR(dart, sid, idx));
 
 			if (ttbr != dart->save_ttbr[sid][idx]) {
+				/* Without its valid bit a TTBR translates nothing: not a loss. */
+				if (!((ttbr | dart->save_ttbr[sid][idx]) & dart->hw->ttbr_valid))
+					continue;
 				if (dart->host_off_slept)
 					dev_info(dart->dev, "SID%u TTBR%u %08x, had %08x\n",
 						 sid, idx, ttbr, dart->save_ttbr[sid][idx]);
@@ -6391,6 +6411,98 @@ static bool apple_dart_state_retained(struct apple_dart *dart)
 	return live;
 }
 
+static bool apple_dart_state_retained(struct apple_dart *dart)
+{
+	return apple_dart_state_retained_except(dart, 0);
+}
+
+/*
+ * Before the state check of a power-up after a real sleep. The wake rebuilds a
+ * DCP's DART as iBoot set it up, not as this kernel left it at power-down: on
+ * the J604 the internal display DART comes back with SID6 TTBR0 0x01000000,
+ * 0x01200000 or 0x03200000 where its power-down state had 0, while SID6 keeps
+ * the TCR iBoot gave it (TRANSLATE_ENABLE) and stays off.
+ *
+ * Only a stream with a valid page table of this kernel's at power-down holds
+ * state that can be lost: the tables live in memory and the retained DCP
+ * session maps through them. Such a stream gets its saved TCR and TTBRs written
+ * back and stays in the check, so it fails if the DART does not take them. Any
+ * other stream is put back as it was and left out of the check. A stream the
+ * wake turned on that was off at power-down goes off again, so the stream
+ * enable at power-up reads back as saved.
+ *
+ * A DART whose TTBRs and TCRs were protected and locked at power-down (the
+ * J604's internal display DART, adopted from iBoot with no writes) is not
+ * written: its streams without a table of ours are iBoot's and stay as the wake
+ * handed them over, as iBoot's boot did, unless such a stream was on at
+ * power-down and now has a valid table: power-up would enable it through a
+ * table this kernel does not know, so it stays in the check.
+ */
+static u64 apple_dart_slept_restore(struct apple_dart *dart)
+{
+	unsigned int sid, idx, n = min_t(unsigned int, dart->num_streams, 32);
+	u32 enabled = readl(dart->regs + DART_T8110_ENABLE_STREAMS);
+	u32 extra = enabled & ~dart->off_streams;
+	bool locked = dart->off_protect & dart->off_lock & DART_T8110_PROTECT_TTBR_TCR;
+	u64 skip = 0;
+
+	if (n < 32)
+		extra &= GENMASK(n - 1, 0);
+	for (sid = 0; sid < dart->num_streams; sid++) {
+		u32 tcr = apple_dart_readl(dart, DART_TCR(dart, sid));
+		u32 ttbr0 = apple_dart_readl(dart, DART_TTBR(dart, sid, 0));
+		bool ours = false, live = false, held = tcr == dart->save_tcr[sid];
+		bool was_on = sid < 32 && (dart->off_streams & BIT(sid));
+
+		for (idx = 0; idx < dart->hw->ttbr_count; idx++) {
+			u32 ttbr = apple_dart_readl(dart, DART_TTBR(dart, sid, idx));
+
+			ours |= !!(dart->save_ttbr[sid][idx] & dart->hw->ttbr_valid);
+			live |= !!(ttbr & dart->hw->ttbr_valid);
+			held &= ttbr == dart->save_ttbr[sid][idx];
+		}
+		if (held && !(sid < 32 && (extra & BIT(sid))))
+			continue;
+
+		if (!locked && !held) {
+			/* A TCR the wake changed: translation off, the tables, then the TCR. */
+			if (tcr != dart->save_tcr[sid])
+				apple_dart_writel(dart, dart->hw->tcr_disabled,
+						  DART_TCR(dart, sid));
+			for (idx = 0; idx < dart->hw->ttbr_count; idx++)
+				apple_dart_writel(dart, dart->save_ttbr[sid][idx],
+						  DART_TTBR(dart, sid, idx));
+			if (tcr != dart->save_tcr[sid])
+				apple_dart_writel(dart, dart->save_tcr[sid], DART_TCR(dart, sid));
+			held = apple_dart_readl(dart, DART_TCR(dart, sid)) == dart->save_tcr[sid];
+			for (idx = 0; idx < dart->hw->ttbr_count; idx++)
+				held &= apple_dart_readl(dart, DART_TTBR(dart, sid, idx)) ==
+					dart->save_ttbr[sid][idx];
+		}
+		dev_dbg(dart->dev,
+			"SID%u after the wake: on %d (had %d), TCR %08x (had %08x), TTBR0 %08x (had %08x): %s\n",
+			sid, sid < 32 && (enabled & BIT(sid)), was_on,
+			tcr, dart->save_tcr[sid], ttbr0, dart->save_ttbr[sid][0],
+			ours ? (held ? "ours, as saved" : locked ? "ours, locked, not written" :
+				"ours, write not taken") :
+			locked ? (was_on && live ?
+				  "not ours, locked, on with a valid table: checked" :
+				  "not ours, locked: left as the wake set it") :
+			held ? "not ours, put back" : "not ours, write not taken");
+		if (ours || sid >= 64)
+			continue;
+		if (locked ? !(was_on && live) :
+		    held || apple_dart_readl(dart, DART_TCR(dart, sid)) == dart->hw->tcr_disabled)
+			skip |= BIT_ULL(sid);
+	}
+	if (extra) {
+		dev_dbg(dart->dev, "streams %08x turned on by the wake, off at power-down: turned off\n",
+			extra);
+		apple_dart_writel(dart, extra, DART_T8110_DISABLE_STREAMS);
+	}
+	return skip;
+}
+
 /*
  * Flush the TLBs of every stream with a command of its own. A stream map flush
  * is not enough for the whole DART: where the streams of a map are remapped
@@ -6973,7 +7085,8 @@ static int apple_dart_host_power_on(struct apple_dart *dart)
 	if ((!dart->host_off_slept && readl(dart->regs + DART_T8110_ENABLE_STREAMS)) ||
 	    readl(dart->regs + DART_T8110_PROTECT) != dart->off_protect ||
 	    readl(dart->regs + DART_T8110_PROTECT_LOCK) != dart->off_lock ||
-	    !apple_dart_state_retained(dart))
+	    !apple_dart_state_retained_except(dart, dart->host_off_slept ?
+					      apple_dart_slept_restore(dart) : 0))
 		goto fail;
 	dart->host_off_slept = false;
 	why = "commands";
-- 
2.43.0

