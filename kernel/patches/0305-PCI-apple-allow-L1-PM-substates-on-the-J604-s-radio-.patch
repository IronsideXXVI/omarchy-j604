From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 05:11:27 +0000
Subject: [PATCH] PCI: apple: allow L1 PM substates on the J604's radio
 link

macOS runs the J604's radio link with all four L1 PM substates: the
ADT's /arm-io/apcie/pci-bridge0 carries pci-l1pm-control 0x4055190f,
which as an L1 PM Substates Control 1 word enables ASPM and PCI-PM L1.1
and L1.2. Both ends of the link advertise them, CLKREQ# is muxed for
the port and LTR is enabled, but on a devicetree platform the ASPM core
leaves the L1 substates out of a link's default, so the link only ever
goes to L1.

With radio_l1ss set, allow them on that link once the host has scanned
it: pci_enable_link_state() on the radio's function 0, L0s and L1 kept.
The ASPM core still enables only what both ends support and computes
the timings itself.

Off by default; only J604 machines act on it.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/pci/controller/pcie-apple.c | 34 +++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/drivers/pci/controller/pcie-apple.c b/drivers/pci/controller/pcie-apple.c
index fb1d9896c6..d382044a3a 100644
--- a/drivers/pci/controller/pcie-apple.c
+++ b/drivers/pci/controller/pcie-apple.c
@@ -73,6 +73,11 @@ static int link_up_timeout = 500;
 module_param(link_up_timeout, int, 0644);
 MODULE_PARM_DESC(link_up_timeout, "PCIe link training timeout in milliseconds");
 
+static bool radio_l1ss;
+module_param(radio_l1ss, bool, 0444);
+MODULE_PARM_DESC(radio_l1ss,
+		 "J604: allow the L1.1 and L1.2 substates (ASPM and PCI-PM) on the radio's link, as the ADT has macOS run them (default off)");
+
 static bool t8132_port_restart;
 module_param(t8132_port_restart, bool, 0644);
 MODULE_PARM_DESC(t8132_port_restart,
@@ -4029,6 +4034,33 @@ static int apple_pcie_attach_domains(struct apple_pcie *pcie)
 	return 0;
 }
 
+/*
+ * The J604 ADT's /arm-io/apcie/pci-bridge0 has pci-l1pm-control 0x4055190f: as an
+ * L1 PM Substates Control 1 word, all four enables (ASPM and PCI-PM L1.1 and L1.2),
+ * so macOS runs the radio's link (root port 0) with them. Both ends advertise them,
+ * CLKREQ# is muxed and LTR is on, but the ASPM core leaves L1 substates out of a
+ * devicetree platform's default. Allow them on that one link; the ASPM core still
+ * enables only what both ends support and works out the timings itself.
+ */
+static void apple_pcie_radio_l1ss(struct pci_host_bridge *bridge)
+{
+	struct pci_dev *root, *ep = NULL;
+	int ret;
+
+	root = pci_get_slot(bridge->bus, PCI_DEVFN(0, 0));
+	if (root && root->subordinate)
+		ep = pci_get_slot(root->subordinate, PCI_DEVFN(0, 0));
+	if (ep) {
+		ret = pci_enable_link_state(ep, PCIE_LINK_STATE_L0S | PCIE_LINK_STATE_L1 |
+					    PCIE_LINK_STATE_L1_1 | PCIE_LINK_STATE_L1_2 |
+					    PCIE_LINK_STATE_L1_1_PCIPM |
+					    PCIE_LINK_STATE_L1_2_PCIPM);
+		pci_info(ep, "radio link: L1 substates allowed, as the ADT has them: %d\n", ret);
+	}
+	pci_dev_put(ep);
+	pci_dev_put(root);
+}
+
 static int apple_pcie_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -4249,6 +4281,8 @@ static int apple_pcie_probe(struct platform_device *pdev)
 
 	if (pcie->hw->tunneled)
 		pci_walk_bus(bridge->bus, apple_pcie_tunnel_keep_d0, NULL);
+	else if (READ_ONCE(radio_l1ss) && of_machine_is_compatible("apple,j604"))
+		apple_pcie_radio_l1ss(bridge);
 
 	return 0;
 }
