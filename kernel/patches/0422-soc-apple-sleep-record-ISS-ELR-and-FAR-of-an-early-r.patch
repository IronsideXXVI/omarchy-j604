From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 04:22:39 +0000
Subject: [PATCH] soc: apple: sleep: record ISS, ELR and FAR of an
 early resume exception

The early resume vectors leave only ESR's class and the low byte of
its ISS in PMU scratch, which names the kind of fault but not where.
The free bytes after it, 0xf804-0xf80e, hold more: ISS[23:0],
ELR[31:0] and FAR[23:0], with 0x80, the MMU state and the class
written to 0xf804 last as the valid marker.

macsmc-reboot reads the 11 bytes and prints the faulting instruction
as a symbol. The image is under 4 GiB and does not cross a 4 GiB
boundary, so ELR's high bits are those of a kernel VA when the MMU
was on, or of the image's PA when it was off, from which the kernel
VA follows. KASLR is off in this configuration; with it on, the
address is rebuilt with the next boot's offset. Cleared after reading
and in reboot_prepare as before.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi |  4 +-
 drivers/power/reset/macsmc-reboot.c           | 51 +++++++++++++++----
 drivers/soc/apple/sleep.c                     | 46 ++++++++++++++---
 3 files changed, 81 insertions(+), 20 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index 8622d82729..594b92e09a 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -200,9 +200,9 @@ boot_error_count: boot-error-count@f802,0 {
 				boot_error_stage: boot-error-stage@f803 {
 					reg = <0xf803 0x01>;
 				};
-				/* An early resume exception: ESR class, ISS, 0xa5. */
+				/* An early resume exception: EC, ISS, ELR, FAR. */
 				resume_exception: resume-exception@f804 {
-					reg = <0xf804 0x03>;
+					reg = <0xf804 0x0b>;
 				};
 				panic_count: panic-count@f802,4 {
 					reg = <0xf802 0x01>;
diff --git a/drivers/power/reset/macsmc-reboot.c b/drivers/power/reset/macsmc-reboot.c
index 8a9b855794..9da1bac1f4 100644
--- a/drivers/power/reset/macsmc-reboot.c
+++ b/drivers/power/reset/macsmc-reboot.c
@@ -13,6 +13,10 @@
 #include <linux/platform_device.h>
 #include <linux/reboot.h>
 #include <linux/slab.h>
+#include <linux/unaligned.h>
+#if IS_ENABLED(CONFIG_ARM64)
+#include <asm/memory.h>
+#endif
 #include <linux/sysfs.h>
 
 struct macsmc_reboot_nvmem {
@@ -237,26 +241,53 @@ static void macsmc_reboot_print_last_end(struct macsmc_reboot *reboot)
 }
 
 /*
- * Optional: the record an early resume exception leaves (ESR class, ISS low byte, then
- * 0xa5 when valid, see apple-sleep). Printed once and cleared, so a stale one is never
- * read as new, at boot and again before a clean reboot.
+ * Optional: the record an early resume exception leaves in PMU scratch (apple-sleep):
+ * 0x80 | MMU on << 6 | EC, then ISS[23:0], ELR[31:0] and FAR[23:0], little-endian.
+ * Printed once and cleared, at boot and again before a clean reboot, so a stale one
+ * is never read as new.
  */
+#define RESUME_EXC_LEN		11
+#define RESUME_EXC_VALID	BIT(7)
+#define RESUME_EXC_MMU		BIT(6)
+
+static void macsmc_reboot_print_resume_exception(struct macsmc_reboot *reboot, const u8 *rec)
+{
+	bool mmu = rec[0] & RESUME_EXC_MMU;
+	u32 iss = get_unaligned_le24(rec + 1);
+	u32 elr = get_unaligned_le32(rec + 4);
+	u32 far = get_unaligned_le24(rec + 8);
+	unsigned long addr = 0;
+
+#if IS_ENABLED(CONFIG_ARM64)
+	/*
+	 * The kernel image is under 4 GiB and does not cross a 4 GiB boundary, so the high
+	 * bits are this boot's: of a kernel VA with the MMU on, of the image's PA with it off.
+	 */
+	if (mmu)
+		addr = (unsigned long)upper_32_bits((unsigned long)&system_state) << 32 | elr;
+	else
+		addr = __phys_to_kimg((phys_addr_t)upper_32_bits(__pa_symbol(&system_state)) << 32 |
+				      elr);
+#endif
+	dev_warn(reboot->dev,
+		 "previous boot: exception early on a resume: EC %#x ISS %#x at %pS (ELR low %#x, MMU %s), FAR low %#x\n",
+		 rec[0] & 0x3f, iss, (void *)addr, elr, mmu ? "on" : "off", far);
+}
+
 static void macsmc_reboot_resume_exception(struct macsmc_reboot *reboot, bool print)
 {
 	struct nvmem_cell *cell = nvmem_cell_get(reboot->dev, "resume_exception");
-	u8 zero[3] = {};
+	u8 zero[RESUME_EXC_LEN] = {};
 	size_t len = 0;
 	u8 *rec;
 
 	if (IS_ERR(cell))
 		return;
 	rec = nvmem_cell_read(cell, &len);
-	if (!IS_ERR(rec) && len >= 3 && rec[2] == 0xa5 && print)
-		dev_warn(reboot->dev,
-			 "previous boot: exception early on a resume: ESR class %#x, ISS low byte %#x\n",
-			 rec[0], rec[1]);
-	if (!IS_ERR(rec) && len >= 3 && (rec[0] || rec[1] || rec[2]))
-		nvmem_cell_write(cell, zero, sizeof(zero));
+	if (!IS_ERR(rec) && len >= RESUME_EXC_LEN && (rec[0] & RESUME_EXC_VALID) && print)
+		macsmc_reboot_print_resume_exception(reboot, rec);
+	if (!IS_ERR(rec) && memchr_inv(rec, 0, len))
+		nvmem_cell_write(cell, zero, min(len, sizeof(zero)));
 	if (!IS_ERR(rec))
 		kfree(rec);
 	nvmem_cell_put(cell);
diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index 6e0d8bc891..2b8d67dc50 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -2994,9 +2994,10 @@ static void apple_sleep_wait_still_on(struct apple_sleep *s)
  * vectors (before init_kernel_el) or the hyp stub's (after it), and both spin: the
  * reset then reads as the stub's 60 s. These vectors are in .text, used by PA while
  * the MMU is off and by kernel VA once _cpu_resume runs. Each restarts WD2 by class,
- * sync 145 s, SError 160 s, IRQ or FIQ 175 s, then leaves ESR's class and ISS low
- * byte in PMU scratch 0xf804/0xf805 with 0xa5 in 0xf806, which macsmc-reboot prints
- * on the next boot. The SPMI writes come last: WD2 resets the SoC either way.
+ * sync 145 s, SError 160 s, IRQ or FIQ 175 s, then leaves a record in PMU scratch
+ * 0xf804-0xf80e, which macsmc-reboot prints on the next boot: ISS[23:0], ELR[31:0],
+ * FAR[23:0], then 0x80 | MMU on << 6 | EC in 0xf804 last. The SPMI writes come last:
+ * WD2 resets the SoC either way.
  */
 u64 t8132_catch_io[4];
 asm(
@@ -3055,6 +3056,7 @@ asm(
 "\tadrp\tx10, t8132_catch_io\n"
 "\tadd\tx10, x10, :lo12:t8132_catch_io\n"
 "\tmrs\tx11, sctlr_el2\n"
+"\tubfx\tw5, w11, #0, #1\n"
 "\ttbz\tx11, #0, 1f\n"
 "\tadd\tx10, x10, #16\n"
 "1:\n"
@@ -3078,14 +3080,42 @@ asm(
 "\tstr\tw14, [x11, #0x2c]\n"
 "\tcbz\tx12, 9f\n"
 "\tmrs\tx15, esr_el2\n"
-"\tmov\tw0, #0xf804\n"
-"\tubfx\tw1, w15, #26, #6\n"
-"\tbl\tt8132_catch_pmu_write\n"
+"\tmrs\tx16, elr_el2\n"
+"\tmrs\tx17, far_el2\n"
 "\tmov\tw0, #0xf805\n"
-"\tand\tw1, w15, #0xff\n"
+"\tubfx\tx1, x15, #0, #8\n"
 "\tbl\tt8132_catch_pmu_write\n"
 "\tmov\tw0, #0xf806\n"
-"\tmov\tw1, #0xa5\n"
+"\tubfx\tx1, x15, #8, #8\n"
+"\tbl\tt8132_catch_pmu_write\n"
+"\tmov\tw0, #0xf807\n"
+"\tubfx\tx1, x15, #16, #8\n"
+"\tbl\tt8132_catch_pmu_write\n"
+"\tmov\tw0, #0xf808\n"
+"\tubfx\tx1, x16, #0, #8\n"
+"\tbl\tt8132_catch_pmu_write\n"
+"\tmov\tw0, #0xf809\n"
+"\tubfx\tx1, x16, #8, #8\n"
+"\tbl\tt8132_catch_pmu_write\n"
+"\tmov\tw0, #0xf80a\n"
+"\tubfx\tx1, x16, #16, #8\n"
+"\tbl\tt8132_catch_pmu_write\n"
+"\tmov\tw0, #0xf80b\n"
+"\tubfx\tx1, x16, #24, #8\n"
+"\tbl\tt8132_catch_pmu_write\n"
+"\tmov\tw0, #0xf80c\n"
+"\tubfx\tx1, x17, #0, #8\n"
+"\tbl\tt8132_catch_pmu_write\n"
+"\tmov\tw0, #0xf80d\n"
+"\tubfx\tx1, x17, #8, #8\n"
+"\tbl\tt8132_catch_pmu_write\n"
+"\tmov\tw0, #0xf80e\n"
+"\tubfx\tx1, x17, #16, #8\n"
+"\tbl\tt8132_catch_pmu_write\n"
+"\tmov\tw0, #0xf804\n"
+"\tubfx\tw1, w15, #26, #6\n"
+"\torr\tw1, w1, w5, lsl #6\n"
+"\torr\tw1, w1, #0x80\n"
 "\tbl\tt8132_catch_pmu_write\n"
 "9:\n"
 "\twfe\n"
-- 
