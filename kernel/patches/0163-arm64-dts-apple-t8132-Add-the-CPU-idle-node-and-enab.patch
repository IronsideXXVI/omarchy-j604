From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Sat, 24 Oct 2026 16:39:04 -0400
Subject: [PATCH] arm64: dts: apple: t8132: Add the CPU idle node and enable it
 on J713

Describe the T8132 CPU idle controller, disabled by default as on T6040
and T8140, and enable it on the MacBook Air J713.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 3ef17de48d0362cef5b13022f0674ba79f4ea314)
[J713 hunk context differs: this tree's t8132-j713.dts has no cpufreq or
 qspi nodes, so &cpuidle goes before &fpwm1; the change is the same.]
---
 arch/arm64/boot/dts/apple/t8132-j713.dts | 4 ++++
 arch/arm64/boot/dts/apple/t8132.dtsi     | 5 +++++
 2 files changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713.dts b/arch/arm64/boot/dts/apple/t8132-j713.dts
index e1fc5d47f4..8ebee9b830 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j713.dts
@@ -30,6 +30,10 @@
 	};
 };
 
+&cpuidle {
+	status = "okay";
+};
+
 &fpwm1 {
 	status = "okay";
 };
diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index a96d6e2c55..5e6138534c 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -18,6 +18,11 @@
 	#address-cells = <2>;
 	#size-cells = <2>;
 
+	cpuidle: cpuidle {
+		compatible = "apple,t8132-cpuidle";
+		status = "disabled";
+	};
+
 	cpus {
 		#address-cells = <2>;
 		#size-cells = <0>;
