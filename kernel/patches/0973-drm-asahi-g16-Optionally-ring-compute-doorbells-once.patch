@@ -3357,6 +3357,29 @@ pub(crate) fn lone_ctx_skip() -> bool {
     "G16: 1 = with g16_notifier_cached, retire a render with nothing behind it without the cached record CONTEXT words; stamps, receipts and scene times still prove it (default 1; 0 holds such a render until its cached CONTEXT words are cleaned)"
 );
 
+/// Storage of `g16_compute_bell_group` (runtime 0644, default 0).
+static COMPUTE_BELL_GROUP: AtomicU32 = AtomicU32::new(0);
+
+/// `g16_compute_bell_group` k (2 to 16): a compute publication made while at least k compute
+/// commands are already in flight posts its record without ringing; the k-th such publication
+/// rings for all of them, so one firmware scheduler call takes the group. Any compute ring
+/// covers the owed records, and they are rung at the end of any publish pass that finds fewer
+/// than k compute commands in flight (compute_bell.rs). 0 (default) or any other value: every
+/// compute publication rings as `g16_compute_onebell` says, as before. Read at each compute
+/// publication and publish pass.
+pub(crate) fn compute_bell_group() -> u32 {
+    COMPUTE_BELL_GROUP.load(Ordering::Relaxed)
+}
+
+live_u32_param!(
+    COMPUTE_BELL_GROUP_PARAM,
+    COMPUTE_BELL_GROUP_PARMTYPE,
+    COMPUTE_BELL_GROUP_PARM,
+    COMPUTE_BELL_GROUP,
+    "g16_compute_bell_group",
+    "G16: k = compute records behind k others ring once per k publications (2-16; default 0, off)"
+);
+
 /// Storage of `g16_ta_short` (runtime 0644, default 1).
 static TA_SHORT: AtomicU32 = AtomicU32::new(1);
 
