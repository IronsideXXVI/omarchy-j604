diff --git a/drivers/gpu/drm/asahi/g16/compute_bell.rs b/drivers/gpu/drm/asahi/g16/compute_bell.rs
new file mode 100644
index 0000000000..616345e2bf
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16/compute_bell.rs
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! `g16_compute_bell_group`: compute doorbells rung for a group of publications, as pure rules.
+//!
+//! Every compute publication posts a submit record on the one compute channel and, with
+//! `g16_compute_onebell` 2, the first record of each publish pass rings and the pass end rings
+//! for the rest. Each doorbell starts a firmware scheduler call, which launches every record
+//! visible at that moment. At depth the compute queues already hold several commands, so a new
+//! one need not be launched at once; ringing once for a group of publications lets one
+//! scheduler call take the whole group, as the render group does (bell_group.rs).
+//!
+//! With group size k (2 to 16): a publication made while at least k compute commands are
+//! already in flight posts its record without a doorbell; the k-th such publication rings for
+//! all of them. A publication made with fewer than k in flight rings as before (onebell rules),
+//! and any compute ring covers every owed record, the end-of-pass onebell ring included. At the
+//! end of every publish pass, owed records are rung once fewer than k compute commands are in
+//! flight, so a record is never left unrung once the queues drain: at most k - 1 are owed at
+//! any time, so when every rung command has retired the rule rings.
+//!
+//! There is one group for the engine: both firmware compute queues are rung through the same
+//! compute submit channel, and each record names its own queue.
+
+use core::sync::atomic::{AtomicU32, AtomicU64};
+
+/// The publication rings (covering any owed records).
+pub(crate) const RING: u8 = 0;
+/// The publication posts its record without a doorbell.
+pub(crate) const DEFER: u8 = 1;
+/// The publication completes a group: it rings for the group's records.
+pub(crate) const PAY: u8 = 2;
+
+/// Compute publications posted without a doorbell since the last compute ring. Written only
+/// under the device lock.
+pub(crate) static OWED: AtomicU32 = AtomicU32::new(0);
+/// Compute rings in the post loop that were not a group's payment, publications deferred,
+/// rings that paid a group, and owed rings paid at the end of a publish pass (statistics).
+pub(crate) static N: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+
+/// The group size in effect: 0 (off) unless the word is 2 to 16.
+pub(crate) const fn group(word: u32) -> u32 {
+    if word >= 2 && word <= 16 {
+        word
+    } else {
+        0
+    }
+}
+
+/// What a compute publication does, from the group size `k`, the compute commands already in
+/// flight and the publications owed so far.
+pub(crate) const fn decide(k: u32, ahead: usize, owed: u32) -> u8 {
+    let k = group(k);
+    if k == 0 || ahead < k as usize {
+        RING
+    } else if owed + 1 >= k {
+        PAY
+    } else {
+        DEFER
+    }
+}
+
+/// Whether owed records are rung at the end of a publish pass: always when the word is off
+/// (owed only after it was turned off), else once fewer than k compute commands are in flight.
+pub(crate) const fn settle(k: u32, owed: u32, in_flight: usize) -> bool {
+    let k = group(k);
+    owed != 0 && (k == 0 || in_flight < k as usize)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn off_rings_every_publication() {
+        for ahead in 0..20 {
+            for w in [0, 1, 17, 100] {
+                assert_eq!(decide(w, ahead, 0), RING);
+            }
+        }
+    }
+
+    #[test]
+    fn defers_behind_k_and_pays_the_kth() {
+        assert_eq!(decide(4, 4, 0), DEFER);
+        assert_eq!(decide(4, 6, 1), DEFER);
+        assert_eq!(decide(4, 7, 2), DEFER);
+        assert_eq!(decide(4, 8, 3), PAY);
+        assert_eq!(decide(2, 5, 0), DEFER);
+        assert_eq!(decide(2, 5, 1), PAY);
+    }
+
+    #[test]
+    fn rings_with_fewer_than_k_ahead() {
+        assert_eq!(decide(4, 3, 2), RING);
+        assert_eq!(decide(4, 0, 0), RING);
+    }
+
+    #[test]
+    fn settle_rules() {
+        assert!(!settle(4, 0, 0));
+        assert!(!settle(4, 2, 5));
+        assert!(settle(4, 2, 3));
+        assert!(settle(0, 1, 9));
+    }
+
+    /// A long run of publications with at least k ahead never owes more than k - 1, and once
+    /// every rung command has retired (in flight = owed) the end-of-pass rule rings.
+    #[test]
+    fn never_owes_k_and_always_settles() {
+        for k in 2..=16u32 {
+            let mut owed = 0u32;
+            for i in 0..200usize {
+                match decide(k, k as usize + i % 5, owed) {
+                    DEFER => owed += 1,
+                    _ => owed = 0,
+                }
+                assert!(owed < k);
+                if owed != 0 {
+                    assert!(settle(k, owed, owed as usize));
+                }
+            }
+        }
+    }
+}
diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 5313481c4f..c5366b6258 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -984,6 +984,22 @@ fn ring_owed_compute(&mut self) -> Result {
         self.session.ring(Channel::Compute)?;
         self.engine.cbell_rung = true;
         self.engine.stats.cbell[1] += 1;
+        // g16_compute_bell_group: the ring covers the group's owed records too.
+        super::compute_bell::OWED.store(0, Ordering::Relaxed);
+        Ok(())
+    }
+    /// `g16_compute_bell_group`: rings the compute pipe for records posted without a
+    /// doorbell, once fewer than the group's compute commands are in flight.
+    fn ring_owed_compute_group(&mut self) -> Result {
+        let owed = super::compute_bell::OWED.load(Ordering::Relaxed);
+        let in_flight = self.engine.flights.iter().filter(|x| x.computes != 0).count();
+        if !super::compute_bell::settle(params::compute_bell_group(), owed, in_flight) {
+            return Ok(());
+        }
+        self.session.ring(Channel::Compute)?;
+        self.engine.cbell_rung = true;
+        super::compute_bell::OWED.store(0, Ordering::Relaxed);
+        super::compute_bell::N[3].fetch_add(1, Ordering::Relaxed);
         Ok(())
     }
 
@@ -1851,6 +1867,17 @@ pub(crate) fn publish(&mut self, done: &mut Completions) -> Result {
         } else {
             super::bell_group::OWED.store(0, Ordering::Relaxed);
         }
+        // g16_compute_bell_group: compute records posted without a doorbell are rung once
+        // fewer than the group's compute commands are in flight (compute_bell.rs).
+        if self.recovery.failed().is_none() {
+            if let Err(e) = self.ring_owed_compute_group() {
+                if result.is_ok() {
+                    result = Err(e);
+                }
+            }
+        } else {
+            super::compute_bell::OWED.store(0, Ordering::Relaxed);
+        }
         // Work left pending behind running flights waits for one of them to retire.
         self.engine.window_wait =
             !self.engine.pending.is_empty() && !self.engine.flights.is_empty();
@@ -2256,6 +2283,17 @@ fn publish_prefix_into(
             } else {
                 super::bell_group::RING
             };
+            // g16_compute_bell_group: a compute record behind enough compute commands may wait
+            // for a later compute doorbell (compute_bell.rs); one group for the compute channel.
+            let cgroup = if render {
+                super::compute_bell::RING
+            } else {
+                super::compute_bell::decide(
+                    params::compute_bell_group(),
+                    self.engine.flights.iter().filter(|x| x.computes != 0).count(),
+                    super::compute_bell::OWED.load(Ordering::Relaxed),
+                )
+            };
             for &channel in channels {
                 let (qinfo, head, event, fresh) = match channel {
                     Channel::Compute => (
@@ -2298,7 +2336,18 @@ fn publish_prefix_into(
                 if onebell == 0 {
                     // g16_compute_onebell: a registered compute queue's record may wait for the
                     // one doorbell at the end of this publish pass.
-                    if channel == Channel::Compute && !fresh && self.defer_compute_bell() {
+                    if channel == Channel::Compute
+                        && !fresh
+                        && cgroup == super::compute_bell::DEFER
+                    {
+                        // g16_compute_bell_group: owed; a later compute ring covers it.
+                        super::compute_bell::OWED.fetch_add(1, Ordering::Relaxed);
+                        super::compute_bell::N[1].fetch_add(1, Ordering::Relaxed);
+                    } else if channel == Channel::Compute
+                        && !fresh
+                        && cgroup != super::compute_bell::PAY
+                        && self.defer_compute_bell()
+                    {
                         self.engine.cbell_owed = true;
                         self.engine.stats.cbell[0] += 1;
                     } else if group == super::bell_group::DEFER && channel != Channel::Compute {
@@ -2308,6 +2357,10 @@ fn publish_prefix_into(
                         if channel == Channel::Compute {
                             self.engine.cbell_rung = true;
                             self.engine.cbell_owed = false;
+                            // g16_compute_bell_group: this ring covers every owed record.
+                            super::compute_bell::OWED.store(0, Ordering::Relaxed);
+                            let i = usize::from(cgroup == super::compute_bell::PAY) * 2;
+                            super::compute_bell::N[i].fetch_add(1, Ordering::Relaxed);
                         }
                     }
                 }
