+    /// `g16_fw_cached` kinds. Queue objects: queue info, scheduler contexts, job lists and the
+    /// registration barrier (and the receipt then reads the uncached cursors only).
+    pub(crate) const FWC_QUEUE: u32 = 0x1;
+    /// Compute commands: the work image, its sequence object and barrier.
+    pub(crate) const FWC_COMPUTE: u32 = 0x2;
+    /// Render TA: the TA work image and sequence.
+    pub(crate) const FWC_TA: u32 = 0x4;
+    /// Render FS: the FS work image, sequence and the pass slot's barriers.
+    pub(crate) const FWC_FS: u32 = 0x8;
+    /// The queues' work rings (written by the host for every command).
+    pub(crate) const FWC_RING: u32 = 0x10;
+    /// Whether the command objects of `kind` use the ASC-cached classes (`g16_fw_cached`,
+    /// default none: uncached mappings from creation). Session-global initdata keeps its own
+    /// explicit cache classes.
+    pub(crate) fn fw_cached(kind: u32) -> bool {
+        super::super::params::fw_cached(kind)
     }
     /// Handle EP 0x20 drain requests in the mailbox interrupt.
