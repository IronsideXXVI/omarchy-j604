     's2r-split-ans-tests.py': [(out(), PASS)]
         + mutations('--mutation', ('notice-depth', 'depth-seven', 'depth-zero',
                                    'not-split', 'mode-unknown', 'lowers-real',
diff --git a/tools/asahi/s2r-resume-trail-tests.py b/tools/asahi/s2r-resume-trail-tests.py
new file mode 100755
index 0000000000..9cfd522c6c
--- /dev/null
+++ b/tools/asahi/s2r-resume-trail-tests.py
@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Execute apple-s2r's resume_trail selection on the host.
+
+The breadcrumb enum, the class enum and table, and apple_s2r_rt_class(),
+apple_s2r_rt_secs() and apple_s2r_rt_phase() are extracted from the driver
+and compiled on the host. This checks which crumb each device callback phase
+gets, which class each driver name maps to, and that the watchdog times of
+the classes stay apart and below the syscore resume's 120 s. It also checks
+that every driver name in the table is the .name of that driver's source.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+DRIVERS = {
+    'apple-dart': 'drivers/iommu/apple-dart.c',
+    'apple-pmgr-pwrstate': 'drivers/pmdomain/apple/pmgr-pwrstate.c',
+    'pcie-apple': 'drivers/pci/controller/pcie-apple.c',
+    'nvme-apple': 'drivers/nvme/host/apple.c',
+    'phy-apple-atc': 'drivers/phy/apple/atc.c',
+    'apple-gpio-pinctrl': 'drivers/pinctrl/pinctrl-apple-gpio.c',
+}
+MUTATIONS = {
+    'secs-step': ('#define S2R_RT_STEP_SECS\t8', '#define S2R_RT_STEP_SECS\t4'),
+    'secs-base': ('#define S2R_RT_BASE_SECS\t12', '#define S2R_RT_BASE_SECS\t0'),
+    'secs-clamp': ('if (class >= S2R_RT_CLASSES)', 'if (class > S2R_RT_CLASSES)'),
+    'phase-event': ('if (event != PM_EVENT_RESUME || !pm_ops)', 'if ((event && 0) || !pm_ops)'),
+    'phase-early': ('"early", 5', '"late", 4'),
+    'class-loop': ('i < S2R_RT_OTHER; i++', 'i < S2R_RT_PINCTRL; i++'),
+    'class-name': ('[S2R_RT_PCIE] = "pcie-apple"', '[S2R_RT_PCIE] = "apple-pcie"'),
+    'crumb-value': ('S2R_CRUMB_RT_WAKE = 0x36', 'S2R_CRUMB_RT_WAKE = 0x46'),
+}
+
+PRELUDE = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint8_t u8;
+#define PM_EVENT_SUSPEND 0x0002
+#define PM_EVENT_RESUME 0x0010
+'''
+
+CASES = r'''
+int main(void) {
+    unsigned int c, d;
+    /* the crumbs: counted 0x3X values, between syscore done and ->finish in meaning */
+    assert(S2R_CRUMB_RT_WAKE == 0x36 && S2R_CRUMB_RT_NOIRQ == 0x37 && S2R_CRUMB_RT_EARLY == 0x38);
+    assert(S2R_CRUMB_SYSCORE == 0x39 && S2R_CRUMB_FINISH == 0x3a && S2R_CRUMB_END == 0x3d);
+    /* phases: resume only, noirq and early only, every info prefix */
+    assert(apple_s2r_rt_phase("noirq power domain ", PM_EVENT_RESUME) == 0x37);
+    assert(apple_s2r_rt_phase("noirq type ", PM_EVENT_RESUME) == 0x37);
+    assert(apple_s2r_rt_phase("noirq class ", PM_EVENT_RESUME) == 0x37);
+    assert(apple_s2r_rt_phase("noirq bus ", PM_EVENT_RESUME) == 0x37);
+    assert(apple_s2r_rt_phase("noirq driver ", PM_EVENT_RESUME) == 0x37);
+    assert(apple_s2r_rt_phase("early power domain ", PM_EVENT_RESUME) == 0x38);
+    assert(apple_s2r_rt_phase("early driver ", PM_EVENT_RESUME) == 0x38);
+    assert(apple_s2r_rt_phase("driver ", PM_EVENT_RESUME) == 0);
+    assert(apple_s2r_rt_phase("power domain ", PM_EVENT_RESUME) == 0);
+    assert(apple_s2r_rt_phase("", PM_EVENT_RESUME) == 0);
+    assert(apple_s2r_rt_phase(NULL, PM_EVENT_RESUME) == 0);
+    assert(apple_s2r_rt_phase("noirq driver ", PM_EVENT_SUSPEND) == 0);
+    assert(apple_s2r_rt_phase("early driver ", PM_EVENT_SUSPEND) == 0);
+    /* classes */
+    assert(apple_s2r_rt_class("apple-dart") == S2R_RT_DART);
+    assert(apple_s2r_rt_class("apple-pmgr-pwrstate") == S2R_RT_PMGR);
+    assert(apple_s2r_rt_class("pcie-apple") == S2R_RT_PCIE);
+    assert(apple_s2r_rt_class("nvme-apple") == S2R_RT_NVME);
+    assert(apple_s2r_rt_class("phy-apple-atc") == S2R_RT_ATC);
+    assert(apple_s2r_rt_class("apple-gpio-pinctrl") == S2R_RT_PINCTRL);
+    assert(apple_s2r_rt_class("apple-admac") == S2R_RT_OTHER);
+    assert(apple_s2r_rt_class("apple-dart-x") == S2R_RT_OTHER);
+    assert(apple_s2r_rt_class("platform") == S2R_RT_OTHER);
+    assert(apple_s2r_rt_class("") == S2R_RT_OTHER);
+    assert(apple_s2r_rt_class(NULL) == S2R_RT_OTHER);
+    /* times: the published table, 8 s apart, all well below 120 s */
+    {
+        static const unsigned int want[S2R_RT_CLASSES] = { 12, 20, 28, 36, 44, 52, 60, 68 };
+        for (c = 0; c < S2R_RT_CLASSES; c++) {
+            assert(apple_s2r_rt_secs(c) == want[c]);
+            assert(apple_s2r_rt_secs(c) + 8 + 19 < 120);
+            for (d = 0; d < c; d++)
+                assert(apple_s2r_rt_secs(c) - apple_s2r_rt_secs(d) >= 8);
+        }
+        assert(apple_s2r_rt_secs(S2R_RT_CLASSES) == 68);
+        assert(apple_s2r_rt_secs(0xffffffffu) == 68);
+    }
+    puts("apple-s2r resume_trail: every phase, driver and class selects as documented");
+    return 0;
+}
+'''
+
+
+def extract(source):
+    crumb = re.search(r'enum apple_s2r_crumb \{.*?\n\};\n', source, re.S).group(0)
+    cls = re.search(r'enum apple_s2r_rt_class \{.*?\n\};\n', source, re.S).group(0)
+    table = re.search(r'static const char \*const apple_s2r_rt_drivers\[.*?\n\};\n', source, re.S).group(0)
+    defines = ''.join(l + '\n' for l in source.splitlines() if re.match(r'#define S2R_RT_', l))
+    code = crumb + cls + table + defines
+    for fn in ('static unsigned int apple_s2r_rt_class(', 'static unsigned int apple_s2r_rt_secs(',
+               'static u8 apple_s2r_rt_phase('):
+        start = source.index(fn)
+        code += source[start:source.index('\n}\n', start) + 3]
+    return code
+
+
+def check_names(code):
+    names = re.findall(r'\[S2R_RT_\w+\] = "([^"]+)"', code)
+    assert sorted(names) == sorted(DRIVERS), f'table names {names}'
+    for name, path in DRIVERS.items():
+        text = (ROOT / path).read_text()
+        assert re.search(r'\.name\s*=\s*"%s"' % re.escape(name), text), \
+            f'{name}: not the .name of {path}'
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', type=Path)
+    parser.add_argument('--mutation', choices=MUTATIONS)
+    args = parser.parse_args()
+    code = extract((ROOT / 'drivers/soc/apple/apple-s2r.c').read_text())
+    if args.mutation:
+        old, new = MUTATIONS[args.mutation]
+        assert old in code, f'missing mutation site: {old}'
+        code = code.replace(old, new, 1)
+    try:
+        check_names(code)
+    except AssertionError as e:
+        print(f'Assertion failed: driver names: {e}')
+        raise SystemExit(1)
+    with tempfile.TemporaryDirectory(prefix='s2r-resume-trail-') as tmp:
+        out = args.out or Path(tmp)
+        out.mkdir(parents=True, exist_ok=True)
+        unit = out / 's2r-resume-trail.c'
+        binary = out / 's2r-resume-trail'
+        unit.write_text(PRELUDE + code + CASES)
+        subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-Wall', '-Wextra',
+                        '-Werror', '-Wno-unused-function', str(unit), '-o', str(binary)],
+                       check=True)
+        result = subprocess.run([str(binary)])
+        raise SystemExit(1 if result.returncode else 0)
+
+
+if __name__ == '__main__':
+    main()
