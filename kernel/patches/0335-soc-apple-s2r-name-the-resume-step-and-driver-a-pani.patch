@@ -1259,6 +1276,10 @@ static bool t8132_time_trail;
 module_param(t8132_time_trail, bool, 0644);
 MODULE_PARM_DESC(t8132_time_trail, "For bring-up, with t8132_sequence and wdt_from_enter: at each step past the match, arm the watchdog again with that step's own time (20 s apart), so that the time of a reset names the step a hang came from (default: off)");
 
+static bool resume_trail;
+module_param(resume_trail, bool, 0644);
+MODULE_PARM_DESC(resume_trail, "For bring-up, with breadcrumb: after syscore resume (0x39), write 0x36 at ->wake, 0x37 at the first noirq and 0x38 at the first early device resume callback; with the watchdog armed from ->enter (wdt_from_enter, wdt_timeout), a panic or an oops from syscore resume to ->end arms it again with a time that names the driver of the last device callback (12 s none yet, 20 DART, 28 PMGR power state, 36 PCIe, 44 NVMe, 52 ATC PHY, 60 pinctrl, 68 any other) and keeps the panic from restarting before it (default: off)");
+
 static bool t8132_sequence;
 module_param(t8132_sequence, bool, 0444);
 MODULE_PARM_DESC(t8132_sequence, "Bring-up, T8132 only: run suspend-to-RAM with the sequence macOS uses on that SoC (as Aurora measured and ported it) instead of the CPU complex one, which T8132 lacks; needs its register windows and apple,wake-enable in the device tree. A real sleep is still refused while a display CPU or ANS's PCIe block is on, so only bring-up runs with abort_before go ahead (default: off, deep is not offered on T8132)");
@@ -1388,6 +1409,14 @@ enum apple_s2r_crumb {
 	 * left to user space: the bring-up sentinel's "alive after the call" mark.
 	 */
 	S2R_CRUMB_T8132_FATAL,
+	/*
+	 * resume_trail, after syscore resume. The T8132 sequence never writes
+	 * these before it; on the other SoCs they name CPU complex steps of
+	 * ->enter, which come before 0x39 in the trail.
+	 */
+	S2R_CRUMB_RT_WAKE = 0x36,	/* ->wake: interrupts on, CPUs tried */
+	S2R_CRUMB_RT_NOIRQ,		/* 0x37 first noirq device resume callback */
+	S2R_CRUMB_RT_EARLY,		/* 0x38 first early device resume callback */
 	/*
 	 * T8132 sequence, past the match. The byte holds macOS's 0x50 from the
 	 * match; these replace it until it is written back right before the
@@ -1418,6 +1447,71 @@ enum apple_s2r_crumb {
 	S2R_CRUMB_T8132_BACK_DONE,	/* 0x66 the return done */
 };
 
+/*
+ * resume_trail: the driver of the last device resume callback, as a class
+ * whose watchdog time (apple_s2r_rt_secs()) names it after a panic or an
+ * oops. The classes are the drivers whose resume reads or restarts a block
+ * that a deep sleep powered down.
+ */
+enum apple_s2r_rt_class {
+	S2R_RT_NONE,		/* no device callback since syscore resume */
+	S2R_RT_DART,
+	S2R_RT_PMGR,
+	S2R_RT_PCIE,
+	S2R_RT_NVME,
+	S2R_RT_ATC,
+	S2R_RT_PINCTRL,
+	S2R_RT_OTHER,
+	S2R_RT_CLASSES,
+};
+
+static const char *const apple_s2r_rt_drivers[S2R_RT_OTHER] = {
+	[S2R_RT_DART] = "apple-dart",
+	[S2R_RT_PMGR] = "apple-pmgr-pwrstate",
+	[S2R_RT_PCIE] = "pcie-apple",
+	[S2R_RT_NVME] = "nvme-apple",
+	[S2R_RT_ATC] = "phy-apple-atc",
+	[S2R_RT_PINCTRL] = "apple-gpio-pinctrl",
+};
+
+static unsigned int apple_s2r_rt_class(const char *driver)
+{
+	unsigned int i;
+
+	if (!driver)
+		return S2R_RT_OTHER;
+	for (i = S2R_RT_DART; i < S2R_RT_OTHER; i++)
+		if (!strcmp(driver, apple_s2r_rt_drivers[i]))
+			return i;
+	return S2R_RT_OTHER;
+}
+
+/*
+ * 8 s apart from 12 s: every slot wider than the spread of the next boot's
+ * clock set, the last one well before the syscore resume's own 120 s.
+ */
+#define S2R_RT_BASE_SECS	12
+#define S2R_RT_STEP_SECS	8
+
+static unsigned int apple_s2r_rt_secs(unsigned int class)
+{
+	if (class >= S2R_RT_CLASSES)
+		class = S2R_RT_OTHER;
+	return S2R_RT_BASE_SECS + S2R_RT_STEP_SECS * class;
+}
+
+/* The crumb of a device callback's phase: 0 outside the noirq and early resume */
+static u8 apple_s2r_rt_phase(const char *pm_ops, int event)
+{
+	if (event != PM_EVENT_RESUME || !pm_ops)
+		return 0;
+	if (!strncmp(pm_ops, "noirq", 5))
+		return S2R_CRUMB_RT_NOIRQ;
+	if (!strncmp(pm_ops, "early", 5))
+		return S2R_CRUMB_RT_EARLY;
+	return 0;
+}
+
 /*
  * Find the PMU boot stage byte: the boot-stage cell of the PMU's nvmem
  * layout. The cell API cannot be used for the writes: its regmap and the
@@ -1532,6 +1626,81 @@ static void apple_s2r_wdt_arm(struct apple_s2r *s2r)
 	apple_s2r_wdt_arm_secs(s2r, wdt_timeout);
 }
 
+/* resume_trail: every device callback from syscore resume to ->end */
+static void apple_s2r_rt_callback(void *data, struct device *dev, const char *pm_ops,
+				  int event)
+{
+	struct apple_s2r *s2r = data;
+	u8 phase;
+
+	if (!READ_ONCE(s2r->rt_live) || event != PM_EVENT_RESUME)
+		return;
+	WRITE_ONCE(s2r->rt_class, apple_s2r_rt_class(dev_driver_string(dev)));
+	phase = apple_s2r_rt_phase(pm_ops, event);
+	if (phase && xchg(&s2r->rt_phase, phase) != phase)
+		apple_s2r_crumb(s2r, phase);
+}
+
+/* ->begin: track this cycle's resume callbacks, with the breadcrumb on */
+static void apple_s2r_rt_begin(struct apple_s2r *s2r)
+{
+	WRITE_ONCE(s2r->rt_live, false);
+	s2r->rt_phase = 0;
+	s2r->rt_class = S2R_RT_NONE;
+	s2r->rt_fired = 0;
+	if (!READ_ONCE(resume_trail) || !s2r->crumb_on || s2r->rt_on)
+		return;
+	if (register_trace_device_pm_callback_start(apple_s2r_rt_callback, s2r)) {
+		dev_warn(s2r->dev, "resume_trail: device callbacks cannot be traced\n");
+		return;
+	}
+	s2r->rt_on = true;
+}
+
+/* ->end: every device resumed */
+static void apple_s2r_rt_end(struct apple_s2r *s2r)
+{
+	WRITE_ONCE(s2r->rt_live, false);
+	if (!s2r->rt_on)
+		return;
+	unregister_trace_device_pm_callback_start(apple_s2r_rt_callback, s2r);
+	tracepoint_synchronize_unregister();
+	s2r->rt_on = false;
+}
+
+/*
+ * A panic or an oops inside the window: the watchdog, armed by this driver
+ * through the resume, gets the last driver's time. The first one counts.
+ * Never sleeps, takes no lock: register writes only.
+ */
+static bool apple_s2r_rt_fire(struct apple_s2r *s2r)
+{
+	if (!READ_ONCE(s2r->rt_live) || !s2r->wdt_armed)
+		return false;
+	if (!s2r->rt_fired++)
+		apple_s2r_wdt_arm_secs(s2r, apple_s2r_rt_secs(READ_ONCE(s2r->rt_class)));
+	return true;
+}
+
+static int apple_s2r_rt_panic(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct apple_s2r *s2r = container_of(nb, struct apple_s2r, rt_panic_nb);
+
+	/* The watchdog's time is the record: no restart before it */
+	if (apple_s2r_rt_fire(s2r))
+		WRITE_ONCE(panic_timeout, 0);
+	return NOTIFY_DONE;
+}
+
+static int apple_s2r_rt_die(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct apple_s2r *s2r = container_of(nb, struct apple_s2r, rt_die_nb);
+
+	if (event == DIE_OOPS)
+		apple_s2r_rt_fire(s2r);
+	return NOTIFY_DONE;
+}
+
 /*
  * t8132_time_trail: each step past the match arms the watchdog with its own
  * time, so that a reset names the step without the PMU byte (whose 0x4X
@@ -3639,6 +3808,8 @@ static void apple_s2r_syscore_resume(void *data)
 
 	if (!done) {
 		apple_s2r_crumb(s2r, S2R_CRUMB_SYSCORE);
+		if (s2r->rt_on)
+			WRITE_ONCE(s2r->rt_live, true);
 		return;
 	}
 
@@ -3664,6 +3835,8 @@ static void apple_s2r_syscore_resume(void *data)
 	if (done & S2R_DONE_WAKE)
 		apple_sleep_ap_wake_restore();
 	apple_s2r_crumb(s2r, S2R_CRUMB_SYSCORE);
+	if (s2r->rt_on)
+		WRITE_ONCE(s2r->rt_live, true);
 }
 
 static const struct syscore_ops apple_s2r_syscore_ops = {
@@ -3716,6 +3889,9 @@ static void apple_s2r_wake(void)
 	struct apple_s2r_mailbox *mb = s2r->mailbox;
 	u64 flags;
 
+	if (READ_ONCE(s2r->rt_live))
+		apple_s2r_crumb(s2r, S2R_CRUMB_RT_WAKE);
+
 	flags = 0;
 	if (mb) {
 		/* The firmware updated the mailbox with the caches off */
@@ -3780,6 +3956,7 @@ static int apple_s2r_begin(suspend_state_t state)
 		}
 		apple_s2r_pins_save(apple_s2r);
 		apple_s2r_crumb_begin(apple_s2r);
+		apple_s2r_rt_begin(apple_s2r);
 		if (t8132_sequence)
 			apple_s2r_t8132_begin(apple_s2r);
 	}
@@ -3829,8 +4006,10 @@ static void apple_s2r_resume_end(void)
 	}
 	if (apple_s2r)
 		WRITE_ONCE(apple_s2r->t8132.hold_apcie, false);
-	if (apple_s2r)
+	if (apple_s2r) {
 		apple_s2r_crumb(apple_s2r, S2R_CRUMB_END);
+		apple_s2r_rt_end(apple_s2r);
+	}
 	if (apple_s2r && apple_s2r->t8132.wd2_armed) {
 		writel(0, apple_s2r->wdt + T8132_WD2_CTL);
 		apple_s2r->t8132.wd2_armed = false;
@@ -4094,6 +4273,12 @@ static int apple_s2r_probe(struct platform_device *pdev)
 	s2r->pm_nb.notifier_call = apple_s2r_pm_notify;
 	register_pm_notifier(&s2r->pm_nb);
 
+	/* resume_trail; they do nothing outside its window */
+	s2r->rt_panic_nb.notifier_call = apple_s2r_rt_panic;
+	atomic_notifier_chain_register(&panic_notifier_list, &s2r->rt_panic_nb);
+	s2r->rt_die_nb.notifier_call = apple_s2r_rt_die;
+	register_die_notifier(&s2r->rt_die_nb);
+
 	/*
 	 * The M4 GPU firmware has no stop and warm restart yet, so its driver
 	 * refuses a sleep that powers the SoC down once the firmware ran: with
diff --git a/tools/asahi/run-host-tests.py b/tools/asahi/run-host-tests.py
