From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 17:16:04 +0000
Subject: [PATCH] tools/asahi: pmu-rtc-tests: model the firmware-driven
 suspend check

apple_pmu_rtc_prepare() now lets a mem sleep through when the suspend is
firmware-driven or the debug_allow_mem bring-up switch is set, and the
host test no longer builds: the switch is declared ahead of the
extracted callbacks, and the fixture has no pm_suspend_via_firmware()
or READ_ONCE(). Declare them in the prelude and cover both new ways
through, plus the refusal without either.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 tools/asahi/pmu-rtc-tests.py | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/tools/asahi/pmu-rtc-tests.py b/tools/asahi/pmu-rtc-tests.py
index 469cacc4b3..857411699b 100644
--- a/tools/asahi/pmu-rtc-tests.py
+++ b/tools/asahi/pmu-rtc-tests.py
@@ -70,6 +70,10 @@ struct regmap {
     int ops, fail;
 };
 static int disabled, pm_suspend_target_state = PM_SUSPEND_TO_IDLE;
+#define READ_ONCE(x) (x)
+/* The driver's bring-up switch, declared ahead of the extracted callbacks. */
+static bool debug_allow_mem, suspend_via_firmware;
+static bool pm_suspend_via_firmware(void) { return suspend_via_firmware; }
 static inline __attribute__((unused)) s64 sign_extend64(u64 v, int bit) { return (s64)(v << (63 - bit)) >> (63 - bit); }
 static u64 get_unaligned_le64(const void *p) { u64 v; memcpy(&v, p, 8); return v; }
 static void mutex_lock(struct mutex *m) { (void)m; }
@@ -275,6 +279,14 @@ static void run_variant(int v) {
     reset(v); assert(!apple_pmu_rtc_prepare(&dev));
     pm_suspend_target_state = 2;
     assert(apple_pmu_rtc_prepare(&dev) == -EBUSY);
+    /* A firmware-driven suspend keeps the alarm armed in the PMU. */
+    suspend_via_firmware = true;
+    assert(!apple_pmu_rtc_prepare(&dev));
+    suspend_via_firmware = false;
+    debug_allow_mem = true;
+    assert(!apple_pmu_rtc_prepare(&dev));
+    debug_allow_mem = false;
+    assert(apple_pmu_rtc_prepare(&dev) == -EBUSY);
     pm_suspend_target_state = PM_SUSPEND_TO_IDLE;
 }
 int main(void) {
