From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sun, 1 Nov 2026 09:41:14 +1100
Subject: [PATCH] media: v4l2: add ProRes frame and profile definitions

Define a complete-frame ProRes compressed format and a six-entry encoder
profile menu. Add contiguous little-endian 16-bit P216 and P416 raw formats
for semiplanar 4:2:2 and 4:4:4 storage, with core format descriptions.

These are RFC allocations. Merge this interface together with its first
driver consumer after media review, rather than as a standalone ABI.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit d19566074600fae96f0b8a6f6f55174555f0ed1d)
(cherry picked from commit eb38f077b6331bab3f141fd07947614db8bdd25b)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/media/v4l2-core/v4l2-ctrls-defs.c | 15 +++++++++++++++
 drivers/media/v4l2-core/v4l2-ioctl.c      |  3 +++
 include/uapi/linux/v4l2-controls.h        | 10 ++++++++++
 include/uapi/linux/videodev2.h            |  4 ++++
 4 files changed, 32 insertions(+)

diff --git a/drivers/media/v4l2-core/v4l2-ctrls-defs.c b/drivers/media/v4l2-core/v4l2-ctrls-defs.c
index e062f20884..1fdbe1d93a 100644
--- a/drivers/media/v4l2-core/v4l2-ctrls-defs.c
+++ b/drivers/media/v4l2-core/v4l2-ctrls-defs.c
@@ -498,6 +498,15 @@ const char * const *v4l2_ctrl_get_menu(u32 id)
 		"Region Grid",
 		NULL,
 	};
+	static const char * const prores_profile[] = {
+		"422 Proxy",
+		"422 LT",
+		"422",
+		"422 HQ",
+		"4444",
+		"4444 XQ",
+		NULL,
+	};
 
 	static const char * const av1_profile[] = {
 		"Main",
@@ -738,6 +747,8 @@ const char * const *v4l2_ctrl_get_menu(u32 id)
 		return hevc_tier;
 	case V4L2_CID_MPEG_VIDEO_HEVC_LOOP_FILTER_MODE:
 		return hevc_loop_filter_mode;
+	case V4L2_CID_MPEG_VIDEO_PRORES_PROFILE:
+		return prores_profile;
 	case V4L2_CID_MPEG_VIDEO_AV1_PROFILE:
 		return av1_profile;
 	case V4L2_CID_MPEG_VIDEO_AV1_LEVEL:
@@ -1044,6 +1055,9 @@ const char *v4l2_ctrl_get_name(u32 id)
 	case V4L2_CID_MPEG_VIDEO_REF_NUMBER_FOR_PFRAMES:	return "Reference Frames for a P-Frame";
 	case V4L2_CID_MPEG_VIDEO_PREPEND_SPSPPS_TO_IDR:		return "Prepend SPS and PPS to IDR";
 
+	/* ProRes controls */
+	case V4L2_CID_MPEG_VIDEO_PRORES_PROFILE:			return "ProRes Profile";
+
 	/* AV1 controls */
 	case V4L2_CID_MPEG_VIDEO_AV1_PROFILE:			return "AV1 Profile";
 	case V4L2_CID_MPEG_VIDEO_AV1_LEVEL:			return "AV1 Level";
@@ -1419,6 +1433,7 @@ void v4l2_ctrl_fill(u32 id, const char **name, enum v4l2_ctrl_type *type,
 	case V4L2_CID_MPEG_VIDEO_HEVC_SIZE_OF_LENGTH_FIELD:
 	case V4L2_CID_MPEG_VIDEO_HEVC_TIER:
 	case V4L2_CID_MPEG_VIDEO_HEVC_LOOP_FILTER_MODE:
+	case V4L2_CID_MPEG_VIDEO_PRORES_PROFILE:
 	case V4L2_CID_MPEG_VIDEO_AV1_PROFILE:
 	case V4L2_CID_MPEG_VIDEO_AV1_LEVEL:
 	case V4L2_CID_STATELESS_HEVC_DECODE_MODE:
diff --git a/drivers/media/v4l2-core/v4l2-ioctl.c b/drivers/media/v4l2-core/v4l2-ioctl.c
index a2b650f4ec..7137770318 100644
--- a/drivers/media/v4l2-core/v4l2-ioctl.c
+++ b/drivers/media/v4l2-core/v4l2-ioctl.c
@@ -1478,6 +1478,8 @@ static void v4l_fill_fmtdesc(struct v4l2_fmtdesc *fmt)
 	case V4L2_PIX_FMT_Y210:		descr = "10-bit YUYV Packed"; break;
 	case V4L2_PIX_FMT_Y212:		descr = "12-bit YUYV Packed"; break;
 	case V4L2_PIX_FMT_Y216:		descr = "16-bit YUYV Packed"; break;
+	case V4L2_PIX_FMT_P216:		descr = "16-bit Y/CbCr 4:2:2"; break;
+	case V4L2_PIX_FMT_P416:		descr = "16-bit Y/CbCr 4:4:4"; break;
 	case V4L2_META_FMT_RPI_BE_CFG:	descr = "RPi PiSP BE Config format"; break;
 	case V4L2_META_FMT_RPI_FE_CFG:  descr = "RPi PiSP FE Config format"; break;
 	case V4L2_META_FMT_RPI_FE_STATS: descr = "RPi PiSP FE Statistics format"; break;
@@ -1516,6 +1518,7 @@ static void v4l_fill_fmtdesc(struct v4l2_fmtdesc *fmt)
 		case V4L2_PIX_FMT_VP9_FRAME:    descr = "VP9 Frame"; break;
 		case V4L2_PIX_FMT_HEVC:		descr = "HEVC"; break; /* aka H.265 */
 		case V4L2_PIX_FMT_HEVC_SLICE:	descr = "HEVC Parsed Slice Data"; break;
+		case V4L2_PIX_FMT_PRORES:		descr = "ProRes"; break;
 		case V4L2_PIX_FMT_FWHT:		descr = "FWHT"; break; /* used in vicodec */
 		case V4L2_PIX_FMT_FWHT_STATELESS:	descr = "FWHT Stateless"; break; /* used in vicodec */
 		case V4L2_PIX_FMT_SPK:		descr = "Sorenson Spark"; break;
diff --git a/include/uapi/linux/v4l2-controls.h b/include/uapi/linux/v4l2-controls.h
index affec0ab47..25a6116195 100644
--- a/include/uapi/linux/v4l2-controls.h
+++ b/include/uapi/linux/v4l2-controls.h
@@ -921,6 +921,16 @@ enum v4l2_mpeg_video_av1_level {
 
 #define V4L2_CID_MPEG_VIDEO_AVERAGE_QP  (V4L2_CID_CODEC_BASE + 657)
 
+#define V4L2_CID_MPEG_VIDEO_PRORES_PROFILE (V4L2_CID_CODEC_BASE + 658)
+enum v4l2_mpeg_video_prores_profile {
+	V4L2_MPEG_VIDEO_PRORES_PROFILE_PROXY = 0,
+	V4L2_MPEG_VIDEO_PRORES_PROFILE_LT = 1,
+	V4L2_MPEG_VIDEO_PRORES_PROFILE_STANDARD = 2,
+	V4L2_MPEG_VIDEO_PRORES_PROFILE_HQ = 3,
+	V4L2_MPEG_VIDEO_PRORES_PROFILE_4444 = 4,
+	V4L2_MPEG_VIDEO_PRORES_PROFILE_4444_XQ = 5,
+};
+
 /*  MPEG-class control IDs specific to the CX2341x driver as defined by V4L2 */
 #define V4L2_CID_CODEC_CX2341X_BASE				(V4L2_CTRL_CLASS_CODEC | 0x1000)
 #define V4L2_CID_MPEG_CX2341X_VIDEO_SPATIAL_FILTER_MODE		(V4L2_CID_CODEC_CX2341X_BASE+0)
diff --git a/include/uapi/linux/videodev2.h b/include/uapi/linux/videodev2.h
index eda4492e40..6cdeda3dd9 100644
--- a/include/uapi/linux/videodev2.h
+++ b/include/uapi/linux/videodev2.h
@@ -660,6 +660,9 @@ struct v4l2_pix_format {
 #define V4L2_PIX_FMT_P010    v4l2_fourcc('P', '0', '1', '0') /* 24  Y/CbCr 4:2:0 10-bit per component */
 #define V4L2_PIX_FMT_P012    v4l2_fourcc('P', '0', '1', '2') /* 24  Y/CbCr 4:2:0 12-bit per component */
 
+#define V4L2_PIX_FMT_P216    v4l2_fourcc('P', '2', '1', '6') /* 32  Y/CbCr 4:2:2 16-bit */
+#define V4L2_PIX_FMT_P416    v4l2_fourcc('P', '4', '1', '6') /* 48  Y/CbCr 4:4:4 16-bit */
+
 /* two non contiguous planes - one Y, one Cr + Cb interleaved  */
 #define V4L2_PIX_FMT_NV12M   v4l2_fourcc('N', 'M', '1', '2') /* 12  Y/CbCr 4:2:0  */
 #define V4L2_PIX_FMT_NV21M   v4l2_fourcc('N', 'M', '2', '1') /* 21  Y/CrCb 4:2:0  */
@@ -753,6 +756,7 @@ struct v4l2_pix_format {
 #define V4L2_PIX_FMT_MJPEG    v4l2_fourcc('M', 'J', 'P', 'G') /* Motion-JPEG   */
 #define V4L2_PIX_FMT_JPEG     v4l2_fourcc('J', 'P', 'E', 'G') /* JFIF JPEG     */
 #define V4L2_PIX_FMT_DV       v4l2_fourcc('d', 'v', 's', 'd') /* 1394          */
+#define V4L2_PIX_FMT_PRORES   v4l2_fourcc('P', 'R', 'E', 'S') /* ProRes frame */
 #define V4L2_PIX_FMT_MPEG     v4l2_fourcc('M', 'P', 'E', 'G') /* MPEG-1/2/4 Multiplexed */
 #define V4L2_PIX_FMT_H264     v4l2_fourcc('H', '2', '6', '4') /* H264 with start codes */
 #define V4L2_PIX_FMT_H264_NO_SC v4l2_fourcc('A', 'V', 'C', '1') /* H264 without start codes */
