From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Tue, 3 Nov 2026 00:52:00 +1100
Subject: [PATCH] pmdomain: apple: pmc: allow a floor on the DCS rail

A rail floor could not sit on the DCS rail, since the AP agent's DCS
vote carries the DCS limit. Let a DCS floor share that vote instead:
without a limit the AP votes the higher of its inherited vote and the
floors held, and with a limit the higher of the other agents' demand and
the floors, capped by the limit as before. The thermal limit therefore
still wins over any floor.

KUnit: a DCS floor above the inherited vote, under a limit, and its
release back to the inherited vote.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit d08f9cf923c5097eec2d9907fb9c740e6f962b63)
[j604: a15y apple_pmc_hw has no agent_rails (Aurora T6040 5ae9585175 not carried; it is 0, every rail, for T8132/T8140): that term dropped from the rail check]
---
 .../devicetree/bindings/power/apple,pmc.yaml  |  3 +-
 drivers/pmdomain/apple/pmc-test.c             | 32 +++++++++++++++++++
 drivers/pmdomain/apple/pmc.c                  | 25 +++++++++++----
 3 files changed, 52 insertions(+), 8 deletions(-)

diff --git a/Documentation/devicetree/bindings/power/apple,pmc.yaml b/Documentation/devicetree/bindings/power/apple,pmc.yaml
index e9263427f8..6cad221048 100644
--- a/Documentation/devicetree/bindings/power/apple,pmc.yaml
+++ b/Documentation/devicetree/bindings/power/apple,pmc.yaml
@@ -110,7 +110,8 @@ patternProperties:
       A rail floor, provided as a power domain. While the domain is powered,
       the AP's voter agent holds the rail at least at the given performance
       state. Floors on the same rail combine to the highest powered one. The
-      AP agent must be a static voter, and the DCS rail cannot have a floor.
+      AP agent must be a static voter. A floor on the DCS rail shares the AP
+      agent's DCS vote with the DCS limit, which caps it.
     additionalProperties: false
 
     properties:
diff --git a/drivers/pmdomain/apple/pmc-test.c b/drivers/pmdomain/apple/pmc-test.c
index ec09fbf018..bf0ec124ee 100644
--- a/drivers/pmdomain/apple/pmc-test.c
+++ b/drivers/pmdomain/apple/pmc-test.c
@@ -278,7 +278,39 @@ static void apple_pmc_test_floor_pending_timeout(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, dom->on);
 }
 
+/*
+ * A DCS floor raises the AP's DCS vote above its inherited vote while held,
+ * yields to the DCS limit, and gives the inherited vote back when released.
+ */
+static void apple_pmc_test_dcs_floor(struct kunit *test)
+{
+	struct apple_pmc *pmc = apple_pmc_test_alloc(test);
+	const struct apple_pmc_hw *hw = pmc->hw;
+	struct apple_pmc_domain *dom;
+
+	INIT_LIST_HEAD(&pmc->domains);
+	apple_pmc_test_set_dcs_vote(pmc, hw->ap_agent, 1);
+	pmc->ap_dcs_vote = apple_pmc_ap_dcs_read(pmc);
+	pmc->enable[hw->dcs_rail] = BIT(1) | BIT(hw->ap_agent);
+	dom = apple_pmc_test_floor(test, pmc, hw->dcs_rail, hw->dcs_max);
+
+	KUNIT_ASSERT_EQ(test, apple_pmc_floor_set(dom, true), 0);
+	KUNIT_EXPECT_EQ(test, apple_pmc_ap_dcs_read(pmc), hw->dcs_max);
+	/* The limit caps the floor; the other agents ask for nothing. */
+	pmc->dcs_state = 3;
+	apple_pmc_dcs_vote(pmc);
+	KUNIT_EXPECT_EQ(test, apple_pmc_ap_dcs_read(pmc), hw->dcs_max - 3);
+	pmc->dcs_state = 0;
+	apple_pmc_dcs_vote(pmc);
+	KUNIT_EXPECT_EQ(test, apple_pmc_ap_dcs_read(pmc), hw->dcs_max);
+	KUNIT_ASSERT_EQ(test, apple_pmc_floor_set(dom, false), 0);
+	KUNIT_EXPECT_EQ(test, apple_pmc_ap_dcs_read(pmc), 1);
+	/* Other rails of the AP's floor word are untouched. */
+	KUNIT_EXPECT_EQ(test, apple_pmc_test_ap_floor(pmc) & ~APPLE_PMC_RAIL_MASK(hw->dcs_rail), 0U);
+}
+
 static struct kunit_case apple_pmc_test_cases[] = {
+	KUNIT_CASE(apple_pmc_test_dcs_floor),
 	KUNIT_CASE(apple_pmc_test_partial_enable),
 	KUNIT_CASE(apple_pmc_test_release_restores_ap_vote),
 	KUNIT_CASE(apple_pmc_test_agent_enable),
diff --git a/drivers/pmdomain/apple/pmc.c b/drivers/pmdomain/apple/pmc.c
index 3b6518774e..3c5a1f1598 100644
--- a/drivers/pmdomain/apple/pmc.c
+++ b/drivers/pmdomain/apple/pmc.c
@@ -114,6 +114,8 @@ struct apple_pmc {
 	unsigned long dcs_state;
 	/* DCS state the AP's agent voted for before probe, kept without a limit. */
 	unsigned int ap_dcs_vote;
+	/* Highest DCS floor held by a floor domain; protected by @lock. */
+	unsigned int dcs_floor;
 	/* Power cost of each DCS state in mW, if a model is described. */
 	u32 dcs_power[APPLE_PMC_MAX_STATES];
 	struct delayed_work dcs_work;
@@ -389,19 +391,20 @@ static unsigned int apple_pmc_ap_dcs_read(struct apple_pmc *pmc)
 
 /*
  * Caller holds pmc->lock. Vote through the AP's agent for what the other
- * agents ask for, capped by the limit; without a limit, put back the vote
- * the AP's agent had before probe.
+ * agents ask for and the DCS floors held, capped by the limit; without a
+ * limit, the vote the AP's agent had before probe or the floors, if higher.
  */
 static void apple_pmc_dcs_vote(struct apple_pmc *pmc)
 {
 	const struct apple_pmc_hw *hw = pmc->hw;
 	void __iomem *reg = pmc->voters + hw->ap_agent * hw->agent_stride;
 	u32 mask = APPLE_PMC_RAIL_MASK(hw->dcs_rail);
-	unsigned int state = pmc->ap_dcs_vote;
+	unsigned int state = max(pmc->ap_dcs_vote, pmc->dcs_floor);
 	u32 old, val;
 
 	if (pmc->dcs_state)
-		state = min_t(unsigned int, apple_pmc_dcs_demand(pmc),
+		state = min_t(unsigned int,
+			      max(apple_pmc_dcs_demand(pmc), pmc->dcs_floor),
 			      hw->dcs_max - pmc->dcs_state);
 
 	old = readl(reg);
@@ -621,6 +624,13 @@ static int apple_pmc_floor_apply(struct apple_pmc *pmc, unsigned int rail)
 		if (dom->floor && dom->rail == rail && dom->on)
 			level = max(level, dom->level);
 
+	/* The AP's DCS vote also carries the DCS limit; it combines both. */
+	if (rail == pmc->hw->dcs_rail) {
+		pmc->dcs_floor = level;
+		apple_pmc_dcs_vote(pmc);
+		return 0;
+	}
+
 	return __apple_pmc_floor_update(pmc, pmc->hw->ap_agent,
 					APPLE_PMC_RAIL_MASK(rail),
 					level << APPLE_PMC_RAIL_SHIFT(rail));
@@ -863,10 +873,11 @@ static int apple_pmc_floor_add(struct apple_pmc *pmc, struct device_node *np)
 	if (of_property_read_u32(np, "apple,rail", &rail) ||
 	    of_property_read_u32(np, "apple,level", &level))
 		return dev_err_probe(dev, -EINVAL, "%pOF: missing rail or level\n", np);
-	/* The DCS rail's AP vote belongs to the DCS limit. */
-	if (rail >= hw->rails || rail == hw->dcs_rail)
+	/* A DCS floor shares the AP's DCS vote with the DCS limit, which caps it. */
+	if (rail >= hw->rails)
 		return dev_err_probe(dev, -EINVAL, "%pOF: invalid rail %u\n", np, rail);
-	if (!level || level >= APPLE_PMC_MAX_STATES)
+	if (!level || level >= APPLE_PMC_MAX_STATES ||
+	    (rail == hw->dcs_rail && level > hw->dcs_max))
 		return dev_err_probe(dev, -EINVAL, "%pOF: invalid level %u\n", np, level);
 	if (!(pmc->static_agents & BIT(hw->ap_agent)))
 		return dev_err_probe(dev, -EINVAL,
