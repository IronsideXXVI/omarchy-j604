From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RJ Skerry-Ryan <rryan@alum.mit.edu>
Date: Mon, 12 Oct 2026 07:53:04 -0700
Subject: [PATCH] dt-bindings: arm: apple: Add CPU power controls

The Apple PMGR stops and starts individual CPU cores, which then come out
of reset at their RVBAR, and powers CPU clusters up and down. A CPU
cluster that lost power needs its CPU complex (ACC) registers set up
again before a core runs in it.

Describe a node collecting the PMGR CPU start/stop registers and the CPU
complex registers of each cluster, with a phandle to the PMGR syscon
holding the cluster power states. CPU nodes point at it with
apple,cpu-ctrl, giving their cluster and core index, and give the address
of their implementation registers (RVBAR and core status) in
apple,cpu-impl-reg.

Signed-off-by: RJ Skerry-Ryan <rryan@alum.mit.edu>
[dylan: carried from aurora-silicon/linux c52689c3a4e6; one tool trailer of the original message is not reproduced here, see the upstream commit for the full text]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../bindings/arm/apple/apple,cpu-ctrl.yaml    | 80 +++++++++++++++++++
 .../devicetree/bindings/arm/cpus.yaml         | 17 ++++
 2 files changed, 97 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/arm/apple/apple,cpu-ctrl.yaml

diff --git a/Documentation/devicetree/bindings/arm/apple/apple,cpu-ctrl.yaml b/Documentation/devicetree/bindings/arm/apple/apple,cpu-ctrl.yaml
new file mode 100644
index 0000000000..762d8d49f6
--- /dev/null
+++ b/Documentation/devicetree/bindings/arm/apple/apple,cpu-ctrl.yaml
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/arm/apple/apple,cpu-ctrl.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple SoC CPU power controls
+
+maintainers:
+  - RJ Skerry-Ryan <rryan@alum.mit.edu>
+
+description: |
+  The Apple PMGR stops and starts individual CPU cores and powers CPU
+  clusters up and down. A started core comes out of reset at its RVBAR.
+  Secondary CPUs are brought up by the boot loader through a spin table;
+  with these controls they can also be taken offline and restarted.
+
+  This node collects the PMGR CPU start/stop registers and the CPU complex
+  (ACC) registers of each cluster, which must be re-initialised after the
+  cluster loses power. The cluster power states live in the PMGR and are
+  referenced through a phandle.
+
+  CPU nodes refer to this node with the "apple,cpu-ctrl" property, which
+  also gives the cluster and core index of the CPU, and give the physical
+  address of their implementation registers (RVBAR and core status) in
+  "apple,cpu-impl-reg".
+
+properties:
+  $nodename:
+    pattern: "^cpu-ctrl@[0-9a-f]+$"
+
+  compatible:
+    const: apple,t6020-cpu-ctrl
+
+  reg:
+    minItems: 1
+    items:
+      - description: PMGR CPU start/stop registers
+      - description: CPU complex registers of cluster 0
+      - description: CPU complex registers of cluster 1
+      - description: CPU complex registers of cluster 2
+
+  reg-names:
+    minItems: 1
+    items:
+      - const: cpu-start
+      - const: acc0
+      - const: acc1
+      - const: acc2
+
+  apple,pmgr:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      PMGR syscon holding the CPU cluster power states. Without it, and
+      without a cluster's CPU complex registers, that cluster is never
+      powered down.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        cpu_ctrl: cpu-ctrl@28e0a8000 {
+            compatible = "apple,t6020-cpu-ctrl";
+            reg = <0x2 0x8e0a8000 0x0 0x40>,
+                  <0x2 0x10e00000 0x0 0x50000>,
+                  <0x2 0x11e00000 0x0 0x50000>,
+                  <0x2 0x12e00000 0x0 0x50000>;
+            reg-names = "cpu-start", "acc0", "acc1", "acc2";
+            apple,pmgr = <&pmgr>;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/arm/cpus.yaml b/Documentation/devicetree/bindings/arm/cpus.yaml
index cb77cae013..ac66327e1b 100644
--- a/Documentation/devicetree/bindings/arm/cpus.yaml
+++ b/Documentation/devicetree/bindings/arm/cpus.yaml
@@ -391,6 +391,23 @@ properties:
     deprecated: true
     description: Use 'mem-supply' instead
 
+  apple,cpu-ctrl:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    items:
+      - items:
+          - description: phandle to the apple,t6020-cpu-ctrl node
+          - description: cluster index of the CPU
+          - description: core index of the CPU within its cluster
+    description:
+      PMGR controls used to stop and restart this spin-table CPU, see
+      arm/apple/apple,cpu-ctrl.yaml.
+
+  apple,cpu-impl-reg:
+    $ref: /schemas/types.yaml#/definitions/uint64
+    description:
+      Physical address of the CPU's implementation registers, holding its
+      RVBAR and core power status. Required with apple,cpu-ctrl.
+
   fsl,soc-operating-points:
     $ref: /schemas/types.yaml#/definitions/uint32-matrix
     description: FSL i.MX6 Soc operation-points when change cpu frequency
