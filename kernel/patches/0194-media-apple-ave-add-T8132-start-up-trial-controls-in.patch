From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 03:49:04 +0000
Subject: [PATCH] media: apple: ave: add T8132 start-up trial controls
 in debugfs

The T8132 (M4) variant is probe only because the values its firmware
start needs are not known: the device number and type the boot
configuration carries, the coprocessor register family, and the command
layout of its H16G build (TEXT CRC 9308d2ab, AppleAVE2FW 9003.78.0 like
the T6041's H16S). None of them is in the ADT. Upstream found that a
wrong device number makes the firmware stop after its hello rather than
hang, so candidates can be tried on the machine itself, one per boot.

Add three root-only debugfs files for the T8132 that do nothing until
used:

  t8132_regs   powers the encoder and reads the code base, control,
               status and boot argument registers at the T6041 offsets
               and the mailbox, and says whether the code base matches
               the loader's TEXT address (what iBoot programs);
  t8132_trial  takes "<device id> <device type>" and arms the next start
               with those values, the T6041 register family and the
               9003.78.0 layout, only while the firmware has never run;
  fw_log       the firmware log ring of the last start, kept when its
               buffer is released.

A trial start also logs the firmware hello. Without a write to
t8132_trial nothing changes: every encode is refused as before.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/ave/ave-drv.c | 152 ++++++++++++++++++++-
 drivers/media/platform/apple/ave/ave-fw.c  |  28 +++-
 drivers/media/platform/apple/ave/ave.h     |  11 ++
 3 files changed, 189 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/apple/ave/ave-drv.c b/drivers/media/platform/apple/ave/ave-drv.c
index cd7ac47bad..2e458ccbd8 100644
--- a/drivers/media/platform/apple/ave/ave-drv.c
+++ b/drivers/media/platform/apple/ave/ave-drv.c
@@ -20,6 +20,8 @@
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
 #include <linux/pm_runtime.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
 
 #include "ave.h"
 #include "ave-regs.h"
@@ -185,6 +187,141 @@ static int ave_inject_wedge(void *data, u64 value)
 }
 DEFINE_DEBUGFS_ATTRIBUTE(ave_inject_wedge_fops, NULL, ave_inject_wedge, "%llu\n");
 
+/*
+ * T8132 bring-up aids, root only and inert until used. The T8132 variant is
+ * probe only because its start-up values are not known; these let one boot
+ * test candidates without a rebuild:
+ *   t8132_regs   reads the coprocessor code base, control, status and boot
+ *                argument at the T6041 (v40) offsets and the mailbox, with
+ *                the encoder powered, and starts nothing;
+ *   t8132_trial  takes "<device id> <device type>": the next start uses the
+ *                T6041 register family, the 9003.78.0 command layout
+ *                (unqualified) and those values; only while the firmware has
+ *                never run, so each candidate needs a fresh boot;
+ *   fw_log       the firmware log ring of the last start.
+ */
+static int ave_t8132_regs_show(struct seq_file *s, void *unused)
+{
+	struct ave_dev *ave = s->private;
+	u64 vcbar, want;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(ave->dev);
+	if (ret < 0)
+		return ret;
+	mutex_lock(&ave->hw_lock);
+	if (ave->fw_state != AVE_FW_OFF) {
+		ret = -EBUSY;
+		goto out;
+	}
+	vcbar = readq(ave->coproc + AVE_COPROC_VCBAR);
+	want = ave->text.iova | AVE_COPROC_VCBAR_VALID;
+	seq_printf(s, "vcbar %#llx loader-text-iova %#llx v40-expects %#llx %s\n",
+		   vcbar, ave->text.iova, want,
+		   vcbar == want ? "match" : "differs");
+	seq_printf(s, "ctrl %#x status %#x boot_arg %#x keep_mappings %#x\n",
+		   readl(ave->coproc + AVE_COPROC_CTRL),
+		   readl(ave->coproc + AVE_COPROC_STATUS),
+		   readl(ave->coproc + AVE_COPROC_BOOT_ARG),
+		   readl(ave->coproc + AVE_COPROC_KEEP_MAPPINGS));
+	seq_printf(s, "mbox status %#x scratch", readl(ave->mbox + AVE_MBOX_STATUS));
+	for (unsigned int i = 0; i < AVE_MBOX_SCRATCH_COUNT; i++)
+		seq_printf(s, " %#x", readl(ave->mbox + AVE_MBOX_SCRATCH(i)));
+	seq_puts(s, "\n");
+out:
+	mutex_unlock(&ave->hw_lock);
+	pm_runtime_put_autosuspend(ave->dev);
+	return ret;
+}
+DEFINE_SHOW_ATTRIBUTE(ave_t8132_regs);
+
+static ssize_t ave_t8132_trial_write(struct file *file, const char __user *ubuf,
+				     size_t len, loff_t *ppos)
+{
+	struct ave_dev *ave = file->private_data;
+	struct ave_variant *v = &ave->trial_variant;
+	unsigned int id, type;
+	char buf[32];
+	ssize_t ret;
+
+	if (!len || len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+	if (sscanf(buf, "%u %u", &id, &type) != 2 || !id || !type || id > 255 ||
+	    type > 255)
+		return -EINVAL;
+
+	mutex_lock(&ave->hw_lock);
+	if (ave->fw_state != AVE_FW_OFF || ave->data_dirty ||
+	    ave->text_crc != AVE_FW_TEXT_CRC_T8132_25G83) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (!ave->trial_log)
+		ave->trial_log = devm_kzalloc(ave->dev, AVE_LOG_BYTES, GFP_KERNEL);
+	if (!ave->trial_log) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	*v = ave_t8132;
+	v->regs = &ave_coproc_v40;
+	v->boot_device_id = id;
+	v->device_type = type;
+	v->boot_arg_value = AVE_COPROC_BOOT_ARG_VALUE;
+	v->timebase_multiplier = 1;
+	v->vcbar_mask = U64_MAX;
+	v->vcbar_flags = AVE_COPROC_VCBAR_VALID;
+	v->boot_qualified = true;
+	ave->variant = v;
+	ave->layout = &ave_layout_9003_78_0;
+	ave->trial = true;
+	dev_warn(ave->dev,
+		 "T8132 start trial armed: device %u type %u, v40 registers, %s layout (unqualified)\n",
+		 id, type, ave->layout->name);
+	ret = len;
+out:
+	mutex_unlock(&ave->hw_lock);
+	return ret;
+}
+
+static const struct file_operations ave_t8132_trial_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = ave_t8132_trial_write,
+	.llseek = noop_llseek,
+};
+
+static ssize_t ave_fw_log_read(struct file *file, char __user *ubuf,
+			       size_t len, loff_t *ppos)
+{
+	struct ave_dev *ave = file->private_data;
+	void *copy;
+	ssize_t ret;
+
+	copy = kvzalloc(AVE_LOG_BYTES, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+	mutex_lock(&ave->hw_lock);
+	if (ave->log.cpu)
+		memcpy(copy, ave->log.cpu,
+		       min_t(size_t, ave->log.size, AVE_LOG_BYTES));
+	else if (ave->trial_log)
+		memcpy(copy, ave->trial_log, AVE_LOG_BYTES);
+	mutex_unlock(&ave->hw_lock);
+	ret = simple_read_from_buffer(ubuf, len, ppos, copy, AVE_LOG_BYTES);
+	kvfree(copy);
+	return ret;
+}
+
+static const struct file_operations ave_fw_log_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = ave_fw_log_read,
+	.llseek = default_llseek,
+};
+
 static void ave_debugfs_init(struct ave_dev *ave)
 {
 	static const char *const names[2][AVE_IMAGE_COUNT] = {
@@ -192,8 +329,21 @@ static void ave_debugfs_init(struct ave_dev *ave)
 		{ "last_start_hevc", "last_process0_hevc" },
 	};
 
-	if (!IS_ENABLED(CONFIG_DEBUG_FS) || !ave->layout)
+	if (!IS_ENABLED(CONFIG_DEBUG_FS))
+		return;
+	if (!ave->layout) {
+		if (ave->variant != &ave_t8132 ||
+		    ave->text_crc != AVE_FW_TEXT_CRC_T8132_25G83)
+			return;
+		ave->debugfs = debugfs_create_dir("apple-ave", NULL);
+		debugfs_create_file("t8132_regs", 0400, ave->debugfs, ave,
+				    &ave_t8132_regs_fops);
+		debugfs_create_file("t8132_trial", 0200, ave->debugfs, ave,
+				    &ave_t8132_trial_fops);
+		debugfs_create_file("fw_log", 0400, ave->debugfs, ave,
+				    &ave_fw_log_fops);
 		return;
+	}
 	ave->debugfs = debugfs_create_dir("apple-ave", NULL);
 	if (ave->layout->abi == &ave_abi_6070) {
 		debugfs_create_file("lifecycle_test", 0200, ave->debugfs, ave,
diff --git a/drivers/media/platform/apple/ave/ave-fw.c b/drivers/media/platform/apple/ave/ave-fw.c
index 4311e8874a..28c06d2870 100644
--- a/drivers/media/platform/apple/ave/ave-fw.c
+++ b/drivers/media/platform/apple/ave/ave-fw.c
@@ -278,14 +278,34 @@ int ave_alloc(struct ave_dev *ave, struct ave_buf *b, size_t size,
  * Lifecycle support and streaming qualification are independent: a known
  * transport is not enough to send unqualified Start/Process payloads.
  */
+/*
+ * The layout a firmware build must run with. An armed T8132 trial runs the
+ * H16G build, which carries the same 9003.78.0 version as the T6041's H16S,
+ * on that layout, unqualified.
+ */
+static const struct ave_fw_layout *ave_fw_expected_layout(struct ave_dev *ave)
+{
+	if (ave->trial && ave->text_crc == AVE_FW_TEXT_CRC_T8132_25G83)
+		return &ave_layout_9003_78_0;
+	return ave_layout_for_crc(ave->text_crc);
+}
+
 int ave_fw_check_boot(struct ave_dev *ave)
 {
 	if (ave->variant->boot_qualified && ave->variant->regs && ave->layout &&
-	    ave->layout == ave_layout_for_crc(ave->text_crc))
+	    ave->layout == ave_fw_expected_layout(ave))
 		return 0;
 	return -EOPNOTSUPP;
 }
 
+/* Keep the firmware log of a trial start. Caller holds hw_lock. */
+void ave_fw_trial_snapshot(struct ave_dev *ave)
+{
+	if (ave->trial && ave->trial_log && ave->log.cpu)
+		memcpy(ave->trial_log, ave->log.cpu,
+		       min_t(size_t, ave->log.size, AVE_LOG_BYTES));
+}
+
 int ave_fw_check_build(struct ave_dev *ave)
 {
 	if (!ave_fw_check_boot(ave) && ave->layout->encode_ready)
@@ -306,6 +326,7 @@ void ave_fw_release_boot(struct ave_dev *ave)
 		ave->extra0_mapped = false;
 	}
 	ave_free(ave, &ave->heap);
+	ave_fw_trial_snapshot(ave);
 	ave_free(ave, &ave->log);
 	ave_free(ave, &ave->boot_cfg);
 	ave_free(ave, &ave->ipc);
@@ -542,14 +563,19 @@ static int ave_fw_boot(struct ave_dev *ave)
 	if (ret) {
 		dev_err(ave->dev, "firmware did not answer (status %#x)\n",
 			readl(ave->coproc + ave->variant->regs->status));
+		ave_fw_trial_snapshot(ave);
 		return ret;
 	}
 	for (unsigned int i = 0; i < 4; i++)
 		hello[i] = readl(ave->mbox + AVE_MBOX_SCRATCH(i));
 	dma_rmb();
+	if (ave->trial)
+		dev_info(ave->dev, "trial: hello {%#x, %#x, %#x, %#x}\n",
+			 hello[0], hello[1], hello[2], hello[3]);
 
 	ret = ave_ipc_negotiate(ave, hello);
 	if (ret) {
+		ave_fw_trial_snapshot(ave);
 		dev_err(ave->dev, "firmware start-up failed: %d\n", ret);
 		return ret;
 	}
diff --git a/drivers/media/platform/apple/ave/ave.h b/drivers/media/platform/apple/ave/ave.h
index 8abe90415f..487dd33c0a 100644
--- a/drivers/media/platform/apple/ave/ave.h
+++ b/drivers/media/platform/apple/ave/ave.h
@@ -142,6 +142,8 @@ enum ave_opcode {
 #define AVE_FW_TEXT_CRC_9003_78_0 0x69c54454
 /* The M4 Pro (T6040) build of the same 25G83 firmware. */
 #define AVE_FW_TEXT_CRC_T6040_25G83 0x68d5f9f6
+/* H16G (T8132) AppleAVE2FW 9003.78.0 from 25G83: start-up values not known yet. */
+#define AVE_FW_TEXT_CRC_T8132_25G83 0x9308d2ab
 
 struct ave_ctx;
 
@@ -212,6 +214,14 @@ struct ave_dev {
 	size_t extra0_map_size;
 	bool extra0_mapped;
 	bool module_pinned;
+	/*
+	 * T8132 start trial (debugfs, root only): a copy of the probe-only
+	 * variant with candidate start-up values, and the firmware log of the
+	 * last start kept after its buffer is released.
+	 */
+	struct ave_variant trial_variant;
+	bool trial;
+	void *trial_log;
 	/* A 6070 lifecycle command is serialized per logical operation. */
 	struct ave_reply expected[AVE_OP_COUNT];
 	u64 ipc_fw_base;
@@ -381,6 +391,7 @@ extern const struct ave_variant ave_t6000, ave_t8112;
 
 /* ave-fw.c */
 u64 ave_fw_vcbar(const struct ave_variant *variant, u64 text_iova);
+void ave_fw_trial_snapshot(struct ave_dev *ave);
 int ave_fw_probe(struct ave_dev *ave);
 void ave_fw_remove(struct ave_dev *ave);
 int ave_fw_ensure_running(struct ave_dev *ave);
