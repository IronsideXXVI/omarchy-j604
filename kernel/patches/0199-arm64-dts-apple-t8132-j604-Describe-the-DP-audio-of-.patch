From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 18:44:15 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: Describe the DP audio
 of the second external display processor

The J604 has two external display processors. dcpext0 drives the HDMI
port and can take a USB-C route; its audio interface, DPA1, is already
described. dcpext1 drives the USB-C display routes, and in the J604 ADT
its audio is dp-audio2: SIO channel 0x68, power gate DPA2, under DPA_P.
None of that was described, so a monitor on a USB-C route that dcpext1
drives gets no sound device.

Describe audio-controller-2 with that channel and power domain, link it
to dcpext1's port@0 as DPA1 is linked to dcpext0, and enable DPA2. The
DCP driver starts the AV audio service of any processor whose port@0
links an available audio device (av.c), and dcpext1's firmware offers
that service. The DP audio interface of a T8132 external processor binds
on its own and gets a card once a sink is connected.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit 97317cd9a40432f068fa3a78a79ac203a9f4a4aa)
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 31 ++++++++++++++++++-
 1 file changed, 30 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index d244cec244..b2c72ce41d 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -79,6 +79,24 @@
 			};
 		};
 	};
+	/* J604 ADT: dcpext1's audio is dp-audio2 (SIO channel 0x68, power gate DPA2). */
+	dpaudio2: audio-controller-2 {
+		compatible = "apple,t8132-dpaudio", "apple,dpaudio";
+		dmas = <&sio 0x68>;
+		dma-names = "tx";
+		power-domains = <&ps_dpa2>;
+		status = "okay";
+		ports {
+			#address-cells = <0x01>;
+			#size-cells = <0x00>;
+			port@0 {
+				reg = <0x00>;
+				dpaudio2_dcpext1: endpoint {
+					remote-endpoint = <&dcpext1_audio>;
+				};
+			};
+		};
+	};
 };
 
 &cpu_e0 {
@@ -603,8 +621,9 @@
 	status = "disabled";
 };
 
+/* J604 ADT: DPA2 (pmgr 0x470) under DPA_P; dcpext1's DP audio. */
 &ps_dpa2 {
-	status = "disabled";
+	status = "okay";
 };
 
 &ps_atc2_cio_usb {
@@ -1550,6 +1569,16 @@
 			};
 		};
 	};
+	ports {
+		#address-cells = <0x01>;
+		#size-cells = <0x00>;
+		port@0 {
+			reg = <0x00>;
+			dcpext1_audio: endpoint {
+				remote-endpoint = <&dpaudio2_dcpext1>;
+			};
+		};
+	};
 };
 
 &cpu_pmu {
-- 
