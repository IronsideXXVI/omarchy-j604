From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 17:22:09 +0000
Subject: [PATCH] phy: apple: atc: let a T8132 USB4/Thunderbolt mode go with a
 deep sleep

A T8132 PHY in a USB4 or Thunderbolt mode owns a common-power epoch,
and atcphy_suspend() refuses any sleep but suspend-to-idle with a host
on it while it does, as the epoch would be lost. So with a USB4 or
Thunderbolt cable in, a sleep that powers the SoC down (apple-s2r,
pm_suspend_via_firmware()) is refused by the PHY, whatever ACIO does.

Such a sleep takes ACIO's coprocessor, the NHI and the routers' links
down with the SoC as well, so the port has to start over after it in any
case: ACIO powers its port off before the sleep and the port controller
restores it after (next commit). The PHY only has to come back in its
mode before that restart.

So in a sleep that powers the SoC down, a CIO mode with nothing left on
it (no host on the controller, which was stopped, no DisplayPort tunnel
user, no PIPE handoff or mode change pending) lets its epoch go. At the
resume, atcphy_sleep_lost_cio() forgets the epoch if the block reads
cold (one still up wasn't lost and stays) and has atcphy_resume() run
the restore, which sets the tracked mode up again as after a power
domain switch-off, with the T8132 CIO tunables. This is the T8132
counterpart of atcphy_sleep_lost_dp(), which covers T8140 DisplayPort.

Suspend-to-idle and the other generations are unchanged; a plain USB
mode keeps the rule of the previous commits. KUnit: the admission (not
without a firmware sleep, not with a tunnel user, a host or a pending
handoff, not for USB3) and the resume marking (not without a firmware
resume, not for a block still up, not for a plain USB mode, cold block).

TO-VERIFY on the J604 (deep sleep there is still refused elsewhere: a
bound dcpext and the GPU), dev-loop check on a kboot-s2r boot with a
USB4 or Thunderbolt dock: `echo mem > /sys/power/state` is no longer
refused by phy-apple-atc; after the wake dmesg shows the mode set up
again before "restarting port after system sleep", and the dock's
devices come back (boltctl list, lsusb -t).

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>

---
 drivers/phy/apple/atc-test.c | 84 ++++++++++++++++++++++++++++++++++++
 drivers/phy/apple/atc.c      | 44 ++++++++++++++++++-
 2 files changed, 126 insertions(+), 2 deletions(-)

diff --git a/drivers/phy/apple/atc-test.c b/drivers/phy/apple/atc-test.c
index ea083c4aff..1385f6affd 100644
--- a/drivers/phy/apple/atc-test.c
+++ b/drivers/phy/apple/atc-test.c
@@ -1441,6 +1441,86 @@ static struct kunit_suite atcphy_mux_test_suite = {
 
 kunit_test_suite(atcphy_mux_test_suite);
 
+#ifdef CONFIG_SUSPEND
+/* A USB4/TBT epoch with nothing on it goes with a sleep that powers the SoC down, only then. */
+static void atcphy_test_t8132_cio_lose(struct kunit *test)
+{
+	struct apple_atcphy *atcphy = atcphy_test_alloc_t8132_pd_off(test, APPLE_ATCPHY_MODE_TBT);
+	suspend_state_t target = pm_suspend_target_state;
+	unsigned int flags = pm_suspend_global_flags;
+
+	atcphy->pd_was_off = false;
+	atcphy->t8132_ss = true;
+	atcphy->t8132_common_owned = true;
+	dev_set_drvdata(atcphy->dev, atcphy);
+	pm_suspend_target_state = PM_SUSPEND_MEM;
+
+	/* Not a sleep that powers the SoC down: refused as before */
+	pm_suspend_global_flags = 0;
+	KUNIT_EXPECT_EQ(test, atcphy_suspend(atcphy->dev), -EBUSY);
+
+	pm_set_suspend_via_firmware();
+	KUNIT_EXPECT_EQ(test, atcphy_suspend(atcphy->dev), 0);
+	KUNIT_EXPECT_TRUE(test, atcphy->t8132_suspended);
+	atcphy->t8132_suspended = false;
+
+	/* A DP tunnel or a host still on it, or a PIPE handoff pending: refused */
+	atcphy->tunnel_users = 1;
+	KUNIT_EXPECT_EQ(test, atcphy_suspend(atcphy->dev), -EBUSY);
+	atcphy->tunnel_users = 0;
+	atcphy->host_active = true;
+	KUNIT_EXPECT_EQ(test, atcphy_suspend(atcphy->dev), -EBUSY);
+	atcphy->host_active = false;
+	atcphy->pipe_pending = true;
+	KUNIT_EXPECT_EQ(test, atcphy_suspend(atcphy->dev), -EBUSY);
+	atcphy->pipe_pending = false;
+
+	/* A plain USB3 epoch keeps its own rule */
+	atcphy->mode = APPLE_ATCPHY_MODE_USB3;
+	KUNIT_EXPECT_EQ(test, atcphy_suspend(atcphy->dev), -EBUSY);
+	KUNIT_EXPECT_FALSE(test, atcphy->t8132_suspended);
+
+	pm_suspend_global_flags = flags;
+	pm_suspend_target_state = target;
+}
+
+/* At the resume: a cold block gives its USB4/TBT epoch up and the restore is due. */
+static void atcphy_test_t8132_sleep_lost_cio(struct kunit *test)
+{
+	struct apple_atcphy *atcphy = atcphy_test_alloc_t8132_pd_off(test, APPLE_ATCPHY_MODE_USB4);
+	unsigned int flags = pm_suspend_global_flags;
+
+	atcphy->pd_was_off = false;
+	atcphy->t8132_common_owned = true;
+	scoped_guard(mutex, &atcphy->lock) {
+		/* Not after a sleep that powered the SoC down: nothing was lost */
+		pm_suspend_global_flags = 0;
+		atcphy_sleep_lost_cio(atcphy);
+		KUNIT_EXPECT_FALSE(test, atcphy->pd_was_off);
+
+		pm_set_resume_via_firmware();
+		/* A block still up kept its epoch */
+		atcphy_sleep_lost_cio(atcphy);
+		KUNIT_EXPECT_TRUE(test, atcphy->t8132_common_owned);
+		KUNIT_EXPECT_FALSE(test, atcphy->pd_was_off);
+
+		/* A plain USB mode is the controller's, see apple_atcphy_sleep_lost() */
+		writel(ATCPHY_POWER_CLAMP_EN, atcphy->regs.core + ATCPHY_POWER_CTRL);
+		atcphy->mode = APPLE_ATCPHY_MODE_USB3;
+		atcphy_sleep_lost_cio(atcphy);
+		KUNIT_EXPECT_TRUE(test, atcphy->t8132_common_owned);
+		KUNIT_EXPECT_FALSE(test, atcphy->pd_was_off);
+		atcphy->mode = APPLE_ATCPHY_MODE_USB4;
+
+		/* A cold block: forgotten, and the restore will set the mode up again */
+		atcphy_sleep_lost_cio(atcphy);
+		KUNIT_EXPECT_FALSE(test, atcphy->t8132_common_owned);
+		KUNIT_EXPECT_TRUE(test, atcphy->pd_was_off);
+	}
+	pm_suspend_global_flags = flags;
+}
+#endif
+
 static struct kunit_case atcphy_t8132_pm_test_cases[] = {
 	KUNIT_CASE(atcphy_test_t8132_rpm_busy),
 	KUNIT_CASE(atcphy_test_t8132_rpm_hold),
@@ -1451,6 +1531,10 @@ static struct kunit_case atcphy_t8132_pm_test_cases[] = {
 #endif
 	KUNIT_CASE(atcphy_test_t8132_lose_gate),
 	KUNIT_CASE(atcphy_test_t8132_sleep_lost),
+#ifdef CONFIG_SUSPEND
+	KUNIT_CASE(atcphy_test_t8132_cio_lose),
+	KUNIT_CASE(atcphy_test_t8132_sleep_lost_cio),
+#endif
 	{}
 };
 
diff --git a/drivers/phy/apple/atc.c b/drivers/phy/apple/atc.c
index f28029d032..bf5146ebe9 100644
--- a/drivers/phy/apple/atc.c
+++ b/drivers/phy/apple/atc.c
@@ -7013,6 +7013,43 @@ void apple_atcphy_sleep_lose_finish(struct phy *usb2_phy)
 }
 EXPORT_SYMBOL_GPL(apple_atcphy_sleep_lose_finish);
 
+/*
+ * A T8132 PHY in a USB4 or Thunderbolt mode with nothing on it: ACIO powers its port off at
+ * the start of a sleep that powers the SoC down (apple_cio's sleep teardown), the controller
+ * was stopped with it, and no DisplayPort tunnel uses the lanes. The common-power epoch then
+ * goes with the SoC, and atcphy_sleep_lost_cio() brings the mode back at the resume, before
+ * the port controller restarts ACIO on it.
+ */
+static bool atcphy_cio_may_lose(const struct apple_atcphy *atcphy)
+{
+	return atcphy->hw->gen == ATCPHY_GENERATION_T8132 && atcphy->hw->restore_after_pd_off &&
+	       !atcphy->dp_only && pm_suspend_via_firmware() && atcphy_mode_is_cio(atcphy->mode) &&
+	       !atcphy->host_active && !atcphy->tunnel_users && !atcphy->mode_dirty &&
+	       !atcphy->pipe_pending;
+}
+
+/*
+ * After a sleep that powered the SoC down, a T8132 PHY in a USB4 or Thunderbolt mode lost its
+ * common block behind its power domain's back (atcphy_cio_may_lose()). The epoch is forgotten
+ * if the block reads cold, and the tracked mode is set up again by the restore that follows.
+ * One still up wasn't lost and is left as it is.
+ */
+static void atcphy_sleep_lost_cio(struct apple_atcphy *atcphy)
+{
+	lockdep_assert_held(&atcphy->lock);
+	if (atcphy->hw->gen != ATCPHY_GENERATION_T8132 || !atcphy->hw->restore_after_pd_off ||
+	    atcphy->dp_only || !pm_resume_via_firmware() || !atcphy_mode_is_cio(atcphy->mode))
+		return;
+	if (atcphy->t8132_common_owned) {
+		if (!atcphy_t8132_cold(atcphy))
+			return;
+		atcphy->t8132_common_owned = false;
+	}
+	WRITE_ONCE(atcphy->pd_was_off, true);
+	dev_dbg(atcphy->dev, "USB4/Thunderbolt mode %d lost in the sleep: setting it up again\n",
+		atcphy->mode);
+}
+
 static int atcphy_suspend(struct device *dev)
 {
 	struct apple_atcphy *atcphy = dev_get_drvdata(dev);
@@ -7029,13 +7066,15 @@ static int atcphy_suspend(struct device *dev)
 	 * then keeps the power domain on across system sleep, so the link stays
 	 * as it is. Without a host, or in a deeper sleep state, it is lost; a host
 	 * that comes back in place after losing its power gives it up with the
-	 * power and admits a new one at the wake (apple_atcphy_sleep_lost()).
+	 * power and admits a new one at the wake (apple_atcphy_sleep_lost()), and
+	 * so does a USB4 or Thunderbolt mode with nothing left on it in a sleep
+	 * that powers the SoC down (atcphy_sleep_lost_cio()).
 	 * DisplayPort on a DisplayPort-only PHY is set up again after its
 	 * domain was off, see atcphy_restore_after_pd_off().
 	 */
 	if (atcphy->t8132_common_owned && !atcphy->dp_only &&
 	    (!atcphy->host_active || pm_suspend_target_state != PM_SUSPEND_TO_IDLE) &&
-	    !(atcphy->sleep_lose && atcphy->host_active))
+	    !(atcphy->sleep_lose && atcphy->host_active) && !atcphy_cio_may_lose(atcphy))
 		return -EBUSY;
 	/* Do not admit a new epoch after this check and before resume. */
 	atcphy->t8132_suspended = true;
@@ -7067,6 +7106,7 @@ static int atcphy_resume(struct device *dev)
 	 */
 	if (atcphy->idle_rpm && pm_runtime_status_suspended(dev))
 		return 0;
+	atcphy_sleep_lost_cio(atcphy);
 	atcphy_restore_after_pd_off(atcphy);
 
 	return 0;
