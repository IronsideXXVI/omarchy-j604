From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 13:24:30 +0000
Subject: [PATCH] soc: apple: clpc: leave the J604's E cluster uncapped
 in low-power

The low-power profile holds every cluster at the first table frequency
at or above the ADT's ceiling, 2088 MHz, which stops the J604's E
cluster at 2172 MHz. macOS's Low Power mode holds only the P cluster:
on AC, under ten threads and under one thread, the E cluster still
reaches its 2892 MHz top (powermetrics, macOS 26B123), and the P
cluster stays at 2088 MHz.

Apply the ceiling on the J604 only to clusters whose table has that
frequency. The P cluster keeps its 2088 MHz ceiling, and the E cluster
keeps its top. Other machines are unchanged.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/clpc.c | 25 +++++++++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/drivers/soc/apple/clpc.c b/drivers/soc/apple/clpc.c
index 4229a0a1be..6fb71060c5 100644
--- a/drivers/soc/apple/clpc.c
+++ b/drivers/soc/apple/clpc.c
@@ -113,6 +113,9 @@ enum apple_clpc_rail {
  *	sharing this CLPC without it get no low-power profile. NULL for any
  * @stock: the table whose CPU map and level_khz floor_stock returns to; NULL
  *	for none
+ * @low_power_fast_only: the low-power ceiling holds only the clusters that
+ *	have @low_power_khz in their table; the others keep their top, as macOS's
+ *	Low Power mode leaves the J604's E cluster at 2892 MHz
  * @low_power_mw: package power (the SMC's PHPC key) the low-power profile
  *	holds the CPU clusters to; 0 for none
  * @gpu_busy: state of each rail for reported GPU work below @gpu_busy_mid,
@@ -151,6 +154,7 @@ struct apple_clpc_hw {
 	bool idle_on_time;
 	unsigned int low_power_khz;
 	const char *low_power_machine;
+	bool low_power_fast_only;
 	unsigned int low_power_mw;
 	const struct apple_clpc_hw *stock;
 };
@@ -1013,6 +1017,17 @@ static unsigned int apple_clpc_step_khz(struct cpufreq_policy *policy,
 	return best;
 }
 
+/* Whether @khz is one of the policy's table frequencies */
+static bool apple_clpc_has_khz(struct cpufreq_policy *policy, unsigned int khz)
+{
+	struct cpufreq_frequency_table *pos;
+
+	cpufreq_for_each_valid_entry(pos, policy->freq_table)
+		if (pos->frequency == khz)
+			return true;
+	return false;
+}
+
 /* The package power the SMC reports (PHPC, a float in W), in mW. */
 static int apple_clpc_read_power(struct apple_clpc *clpc)
 {
@@ -1099,7 +1114,9 @@ static void apple_clpc_profile_limit(struct apple_clpc *clpc)
 			clpc->update_errors++;
 		/* The top: the first table frequency at or above hw->low_power_khz */
 		cl->top_khz = apple_clpc_step_khz(policy[i], clpc->low_power_khz - 1, true);
-		if (cl->top_khz < clpc->low_power_khz)
+		if (cl->top_khz < clpc->low_power_khz ||
+		    (clpc->hw->low_power_fast_only &&
+		     !apple_clpc_has_khz(policy[i], clpc->low_power_khz)))
 			cl->top_khz = policy[i]->cpuinfo.max_freq;
 		if (!low)
 			cl->max_khz = 0;
@@ -1755,12 +1772,15 @@ static const struct apple_clpc_hw apple_clpc_hw_t8132 = {
 	/*
 	 * The J604's ADT (25G83 and 26B123) has macOS's Low Power mode CPU
 	 * ceiling, clpc cpu-low-power-frequency-max = 2088 MHz, a P cluster
-	 * state; the E cluster stops at its 2172 MHz state. macOS's package
+	 * state. macOS holds only the P cluster there: in Low Power on AC the
+	 * E cluster still reaches 2892 MHz (powermetrics, ten threads and one
+	 * thread, macOS 26B123), so the E cluster keeps its top. macOS's package
 	 * target in that mode is not measured on the J604, so the profile has
 	 * the ceiling only, as T6041's. Other T8132 Macs are not checked.
 	 */
 	.low_power_khz = 2088000,
 	.low_power_machine = "apple,j604",
+	.low_power_fast_only = true,
 };
 
 /*
@@ -1788,6 +1808,7 @@ static const struct apple_clpc_hw apple_clpc_hw_t8132_j604 = {
 	.level_khz = 4464000,
 	.low_power_khz = 2088000,
 	.low_power_machine = "apple,j604",
+	.low_power_fast_only = true,
 	.stock = &apple_clpc_hw_t8132,
 };
 
-- 
2.43.0

