From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 21:45:56 +0000
Subject: [PATCH] drm/asahi: g16: Keep up to 16 render commands
 resident by default

At depth 64 macOS keeps about 18 render commands queued in the M4
firmware ring (29 at most). This driver kept 8, one per render unit.
On the J604, lowering the depth at runtime from 8 to 4 made
render.light 15% slower (152.5 to 175.6 us per submission), so the
depth binds.

Default g16_resident to 16. The render units every VM allocates follow
it (g16_resident_units 0) as compact units, 2 + 16 at most, bounded by
the client aperture; each unit costs about 50 MiB in a VM that renders,
so a rendering client holds about 400 MiB more than at 8. g16_resident
stays runtime-adjustable downward, and 8 restores the old depth.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/params.rs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 987e2c1cb9..f3899f286c 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -1427,8 +1427,8 @@ pub(crate) fn pb_pool() -> u32 {
     "G16: PB managers a VM keeps for reuse instead of building one per render command in SUBMIT (default 8; 0: one per command, as before; max 16; runtime 0644)"
 );
 
-/// Storage of `g16_resident` (runtime 0644, default 8).
-static RESIDENT: AtomicU32 = AtomicU32::new(8);
+/// Storage of `g16_resident` (runtime 0644, default 16).
+static RESIDENT: AtomicU32 = AtomicU32::new(16);
 
 /// Render pass units per VM, latched at the first G16 slot setup of the boot: 0 until then.
 static RESIDENT_LATCH: AtomicU32 = AtomicU32::new(0);
@@ -1525,7 +1525,7 @@ pub(crate) fn resident_credits() -> u32 {
     RESIDENT_PARM,
     RESIDENT,
     "g16_resident",
-    "G16: render commands that may be resident in the firmware rings at once, each in its own render unit (default 8; 0 or 1: off; 2..4, 2..18 with g16_resident_compact=1; >= 3 must be set at module load to allocate the extra units; needs g16_overlap=1 and g16_uma_split=1; runtime 0644)"
+    "G16: render commands that may be resident in the firmware rings at once, each in its own render unit (default 16; 0 or 1: off; 2..4, 2..18 with g16_resident_compact=1; >= 3 must be set at module load to allocate the extra units; needs g16_overlap=1 and g16_uma_split=1; runtime 0644)"
 );
 
 /// Storage of `g16_submit_ahead` (runtime 0644, default 0).
-- 
