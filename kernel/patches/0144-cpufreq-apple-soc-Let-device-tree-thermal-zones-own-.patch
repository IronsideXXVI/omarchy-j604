From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 07:28:06 -0600
Subject: [PATCH] cpufreq: apple-soc: Let device-tree thermal zones own the
 higher P-states

T8132 holds every cluster at or below P-state 4 until a board thermal
policy calls apple_soc_cpufreq_set_thermal_owner(). The only such policy
is a board-specific driver, so every other T8132 board runs capped even
when its device tree already describes the usual Linux thermal policy:
a thermal zone that binds the cluster's CPUs to a passive trip through
the cpufreq cooling device.

Treat such zones as the board thermal policy. At policy init, find the
zones whose cooling maps name a CPU of the cluster on a passive trip.
A watchdog then samples them every 500 ms and releases the cap only
while every one of them

 - is registered and reads at least 5 C and below its hot trip,
 - has this policy's cooling device bound to a passive trip, and
 - has a hot trip above that passive trip and a critical trip at or
   above the hot trip.

Ownership is taken after ten consecutive good samples below the clear
point (temperature minus hysteresis) of the lowest bound passive trip,
and given back after two consecutive bad ones: a read error, a missing
zone or binding, or a temperature outside that band. The hot trip is
the release point, so a zone without one never takes ownership and
boards without zones keep their current behaviour. Ownership by a zone
and through apple_soc_cpufreq_set_thermal_owner() are independent;
either releases the cap. The policy rwsem is only try-locked, because
->exit() cancels the watchdog with it held for writing.

The checks and the watchdog follow j604_thermal_owner, an out-of-tree
module used on the MacBook Pro (14-inch, M4) with an earlier kernel,
without its board gate, fixed CPU masks and fixed temperatures.

The new ARM_APPLE_SOC_CPUFREQ_THERMAL_ZONES option (default y) can
turn this off.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/cpufreq/Kconfig.arm         |  15 ++
 drivers/cpufreq/apple-soc-cpufreq.c | 302 +++++++++++++++++++++++++++-
 2 files changed, 316 insertions(+), 1 deletion(-)

diff --git a/drivers/cpufreq/Kconfig.arm b/drivers/cpufreq/Kconfig.arm
index a441668f9e..754d8b0490 100644
--- a/drivers/cpufreq/Kconfig.arm
+++ b/drivers/cpufreq/Kconfig.arm
@@ -32,6 +32,21 @@ config ARM_APPLE_SOC_CPUFREQ
 	  This adds the CPUFreq driver for Apple Silicon machines
 	  (e.g. Apple M1).
 
+config ARM_APPLE_SOC_CPUFREQ_THERMAL_ZONES
+	bool "Let device-tree thermal zones own the higher Apple CPU P-states"
+	depends on ARM_APPLE_SOC_CPUFREQ && CPU_THERMAL
+	default y
+	help
+	  Some Apple SoCs (T8132) keep every CPU cluster at a low P-state
+	  until a board thermal policy takes over the higher ones. With this
+	  option, the device-tree thermal zones that bind a cluster's CPUs to
+	  a passive trip, and that have a hot trip above it and a critical
+	  trip, are such a policy: the cluster gets its full range while the
+	  zones read plausible temperatures below their hot trips, and goes
+	  back to the low ceiling when they do not.
+
+	  Boards without such zones are not affected. If unsure, say Y.
+
 config ARM_ARMADA_37XX_CPUFREQ
 	tristate "Armada 37xx CPUFreq support"
 	depends on ARCH_MVEBU || COMPILE_TEST
diff --git a/drivers/cpufreq/apple-soc-cpufreq.c b/drivers/cpufreq/apple-soc-cpufreq.c
index 85e592faa0..af9e8758ac 100644
--- a/drivers/cpufreq/apple-soc-cpufreq.c
+++ b/drivers/cpufreq/apple-soc-cpufreq.c
@@ -30,6 +30,7 @@
 #include <linux/soc/apple/cpufreq-thermal.h>
 #include <linux/soc/apple/pmp-report.h>
 #include <linux/spinlock.h>
+#include <linux/thermal.h>
 #include <linux/tick.h>
 #include <linux/timer.h>
 #include <linux/workqueue.h>
@@ -217,6 +218,8 @@ struct apple_soc_cpufreq_info {
 	u64 ps1_shift;
 };
 
+struct apple_zone_owner;
+
 struct apple_cpu_priv {
 	struct apple_fast_die *fast_die;
 	struct device *cpu_dev;
@@ -226,6 +229,9 @@ struct apple_cpu_priv {
 	unsigned int expected_pstate;
 	struct freq_qos_request unmanaged_cap;
 	bool thermal_owned;
+	/* Device-tree thermal zones own the states above the cap. */
+	bool zone_owned;
+	struct apple_zone_owner *zone_owner;
 	/*
 	 * Lazy verification, see apple_soc_cpufreq_lazy_request(): the lock
 	 * serialises the command register, expected_pstate and
@@ -1291,7 +1297,7 @@ static s32 apple_soc_cpufreq_owner_cap(struct cpufreq_policy *policy)
 
 	lockdep_assert_held(&apple_soc_thermal_owner_lock);
 
-	return priv->thermal_owned ? FREQ_QOS_MAX_DEFAULT_VALUE :
+	return priv->thermal_owned || priv->zone_owned ? FREQ_QOS_MAX_DEFAULT_VALUE :
 		apple_soc_cpufreq_unmanaged_max(policy);
 }
 
@@ -1327,6 +1333,296 @@ int apple_soc_cpufreq_set_thermal_owner(struct cpufreq_policy *policy, bool owne
 }
 EXPORT_SYMBOL_GPL(apple_soc_cpufreq_set_thermal_owner);
 
+#if IS_ENABLED(CONFIG_ARM_APPLE_SOC_CPUFREQ_THERMAL_ZONES)
+/*
+ * Device-tree thermal zones as the board thermal policy
+ *
+ * A board describes its CPU thermal policy the usual way: a thermal zone whose
+ * cooling maps bind a cluster's CPUs to a passive trip. On a SoC that needs a
+ * thermal owner, the zones that do so for a cluster take over its higher
+ * states while they are seen to work, and give them back when they are not.
+ * Every such zone must
+ *
+ *  - be registered and read a temperature of at least APPLE_ZONE_MIN_MC and
+ *    below its hot trip,
+ *  - have the policy's cpufreq cooling device bound to a passive trip, and
+ *  - have a hot trip above the lowest such passive trip and a critical trip
+ *    at or above the hot trip.
+ *
+ * The hot trip is where the cap comes back, so a zone without one never takes
+ * ownership. Ownership is taken after APPLE_ZONE_GOOD consecutive good samples
+ * below the clear point (temperature minus hysteresis) of the lowest bound
+ * passive trip, and given back after APPLE_ZONE_BAD consecutive bad ones.
+ * Without any such zone the cluster keeps its unmanaged ceiling as before.
+ * Ownership by a zone and by apple_soc_cpufreq_set_thermal_owner() are
+ * independent; either one releases the cap.
+ */
+#define APPLE_ZONE_MAX		4
+#define APPLE_ZONE_POLL_MS	500
+#define APPLE_ZONE_MIN_MC	5000
+#define APPLE_ZONE_BAD		2
+#define APPLE_ZONE_GOOD		10
+
+struct apple_zone_owner {
+	struct cpufreq_policy *policy;
+	struct delayed_work work;
+	struct device_node *zones[APPLE_ZONE_MAX];
+	unsigned int nr_zones;
+	unsigned int bad, good;
+	int last_error;
+};
+
+struct apple_zone_check {
+	struct thermal_zone_device *tz;
+	struct thermal_cooling_device *cdev;
+	int passive, passive_clear, hot, critical;
+};
+
+/* Does a cooling map of @zone bind a CPU in @cpus to a passive trip? */
+static bool apple_zone_cools(struct device_node *zone, const struct cpumask *cpus)
+{
+	struct device_node *maps __free(device_node) =
+		of_get_child_by_name(zone, "cooling-maps");
+
+	if (!maps)
+		return false;
+
+	for_each_child_of_node_scoped(maps, map) {
+		struct device_node *trip __free(device_node) =
+			of_parse_phandle(map, "trip", 0);
+		const char *type;
+		int i, n;
+
+		if (!trip || of_property_read_string(trip, "type", &type) ||
+		    strcmp(type, "passive"))
+			continue;
+
+		n = of_count_phandle_with_args(map, "cooling-device", "#cooling-cells");
+		for (i = 0; i < n; i++) {
+			struct of_phandle_args spec;
+			int cpu;
+
+			if (of_parse_phandle_with_args(map, "cooling-device",
+						       "#cooling-cells", i, &spec))
+				continue;
+			cpu = of_cpu_node_to_id(spec.np);
+			of_node_put(spec.np);
+			if (cpu >= 0 && cpumask_test_cpu(cpu, cpus))
+				return true;
+		}
+	}
+
+	return false;
+}
+
+static int apple_zone_check_trip(struct thermal_trip *trip, void *data)
+{
+	struct apple_zone_check *c = data;
+	int temp = READ_ONCE(trip->temperature);
+
+	if (temp == THERMAL_TEMP_INVALID)
+		return 0;
+
+	switch (trip->type) {
+	case THERMAL_TRIP_CRITICAL:
+		c->critical = min(c->critical, temp);
+		break;
+	case THERMAL_TRIP_HOT:
+		c->hot = min(c->hot, temp);
+		break;
+	case THERMAL_TRIP_PASSIVE:
+		if (temp < c->passive &&
+		    thermal_trip_is_bound_to_cdev(c->tz, trip, c->cdev)) {
+			c->passive = temp;
+			c->passive_clear = temp - READ_ONCE(trip->hysteresis);
+		}
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
+
+/* Is the protection of @zone in place? 0 and the clear point, or a reason. */
+static int apple_zone_check(struct device_node *zone,
+			    struct thermal_cooling_device *cdev,
+			    int *temp, int *clear)
+{
+	struct apple_zone_check c = {
+		.cdev = cdev,
+		.passive = INT_MAX,
+		.hot = INT_MAX,
+		.critical = INT_MAX,
+	};
+	int ret;
+
+	/* Device-tree zones are registered under their node name. */
+	c.tz = thermal_zone_get_by_name(zone->name);
+	if (IS_ERR(c.tz))
+		return PTR_ERR(c.tz);
+	ret = thermal_zone_get_temp(c.tz, temp);
+	if (!ret)
+		ret = for_each_thermal_trip(c.tz, apple_zone_check_trip, &c);
+	thermal_zone_put(c.tz);
+	if (ret)
+		return ret;
+
+	if (c.passive == INT_MAX || c.hot == INT_MAX || c.critical == INT_MAX ||
+	    c.passive >= c.hot || c.hot > c.critical)
+		return -ENOLINK;
+	if (*temp < APPLE_ZONE_MIN_MC || *temp >= c.hot)
+		return -ERANGE;
+
+	*clear = c.passive_clear;
+	return 0;
+}
+
+static void apple_zone_owner_set(struct apple_zone_owner *zo, bool owned)
+{
+	struct cpufreq_policy *policy = zo->policy;
+	struct apple_cpu_priv *priv = policy->driver_data;
+	int ret;
+
+	scoped_guard(mutex, &apple_soc_thermal_owner_lock) {
+		priv->zone_owned = owned;
+		ret = freq_qos_update_request(&priv->unmanaged_cap,
+					      apple_soc_cpufreq_owner_cap(policy));
+	}
+
+	if (ret < 0)
+		dev_err(priv->cpu_dev, "CPUs %*pbl: thermal zone ownership update failed: %d\n",
+			cpumask_pr_args(policy->related_cpus), ret);
+	else if (owned)
+		dev_info(priv->cpu_dev, "CPUs %*pbl: thermal zones own the states above P%u\n",
+			 cpumask_pr_args(policy->related_cpus),
+			 priv->info->max_unmanaged_pstate);
+	else
+		dev_warn(priv->cpu_dev, "CPUs %*pbl: thermal zone protection lost (%d): back at P%u or below\n",
+			 cpumask_pr_args(policy->related_cpus), zo->last_error,
+			 priv->info->max_unmanaged_pstate);
+}
+
+static void apple_zone_owner_work(struct work_struct *work)
+{
+	struct apple_zone_owner *zo = container_of(to_delayed_work(work),
+						   struct apple_zone_owner, work);
+	struct cpufreq_policy *policy = zo->policy;
+	struct apple_cpu_priv *priv = policy->driver_data;
+	int ret = 0, temp = 0, clear = 0;
+	struct device_node *failed = NULL;
+	bool cool = true;
+	unsigned int i;
+
+	/*
+	 * ->exit() cancels this work with the policy rwsem held for writing,
+	 * so never wait for it here: skip the sample instead. The rwsem keeps
+	 * policy->cdev registered while its bindings are checked.
+	 */
+	if (!down_read_trylock(&policy->rwsem))
+		goto again;
+
+	if (!policy->cdev)
+		ret = -ENOLINK;
+	for (i = 0; !ret && i < zo->nr_zones; i++) {
+		ret = apple_zone_check(zo->zones[i], policy->cdev, &temp, &clear);
+		if (ret)
+			failed = zo->zones[i];
+		else if (temp >= clear)
+			cool = false;
+	}
+
+	if (ret != zo->last_error && ret && !priv->zone_owned)
+		dev_info(priv->cpu_dev, "CPUs %*pbl: %s%pOFn not usable as thermal owner (%d, %d mC)\n",
+			 cpumask_pr_args(policy->related_cpus),
+			 failed ? "thermal zone " : "no cooling device for ",
+			 failed ?: zo->zones[0], ret, temp);
+	zo->last_error = ret;
+
+	if (ret) {
+		zo->good = 0;
+		if (priv->zone_owned && ++zo->bad >= APPLE_ZONE_BAD)
+			apple_zone_owner_set(zo, false);
+	} else {
+		zo->bad = 0;
+		if (!cool)
+			zo->good = 0;
+		else if (!priv->zone_owned && ++zo->good >= APPLE_ZONE_GOOD)
+			apple_zone_owner_set(zo, true);
+	}
+
+	up_read(&policy->rwsem);
+again:
+	queue_delayed_work(system_freezable_power_efficient_wq, &zo->work,
+			   msecs_to_jiffies(APPLE_ZONE_POLL_MS));
+}
+
+static void apple_zone_owner_init(struct cpufreq_policy *policy)
+{
+	struct apple_cpu_priv *priv = policy->driver_data;
+	struct device_node *tzs __free(device_node) = NULL;
+	struct apple_zone_owner *zo;
+	unsigned int i;
+
+	if (!priv->info->needs_thermal_owner)
+		return;
+	tzs = of_find_node_by_name(NULL, "thermal-zones");
+	if (!tzs)
+		return;
+
+	zo = kzalloc_obj(*zo);
+	if (!zo) {
+		dev_warn(priv->cpu_dev, "no memory for thermal zone ownership\n");
+		return;
+	}
+
+	for_each_available_child_of_node_scoped(tzs, zone) {
+		if (!apple_zone_cools(zone, policy->cpus))
+			continue;
+		if (zo->nr_zones == APPLE_ZONE_MAX) {
+			dev_warn(priv->cpu_dev, "CPUs %*pbl: more than %u thermal zones, keeping P%u or below\n",
+				 cpumask_pr_args(policy->cpus), APPLE_ZONE_MAX,
+				 priv->info->max_unmanaged_pstate);
+			goto fail;
+		}
+		zo->zones[zo->nr_zones++] = of_node_get(zone);
+	}
+	if (!zo->nr_zones)
+		goto fail;
+
+	zo->policy = policy;
+	zo->last_error = 1;	/* report the first state, whatever it is */
+	INIT_DELAYED_WORK(&zo->work, apple_zone_owner_work);
+	priv->zone_owner = zo;
+	queue_delayed_work(system_freezable_power_efficient_wq, &zo->work,
+			   msecs_to_jiffies(APPLE_ZONE_POLL_MS));
+	return;
+
+fail:
+	for (i = 0; i < zo->nr_zones; i++)
+		of_node_put(zo->zones[i]);
+	kfree(zo);
+}
+
+static void apple_zone_owner_exit(struct apple_cpu_priv *priv)
+{
+	struct apple_zone_owner *zo = priv->zone_owner;
+	unsigned int i;
+
+	if (!zo)
+		return;
+
+	cancel_delayed_work_sync(&zo->work);
+	for (i = 0; i < zo->nr_zones; i++)
+		of_node_put(zo->zones[i]);
+	kfree(zo);
+	priv->zone_owner = NULL;
+}
+#else
+static void apple_zone_owner_init(struct cpufreq_policy *policy) { }
+static void apple_zone_owner_exit(struct apple_cpu_priv *priv) { }
+#endif /* CONFIG_ARM_APPLE_SOC_CPUFREQ_THERMAL_ZONES */
+
 static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
 {
 	struct cpufreq_frequency_table *p;
@@ -1472,6 +1768,8 @@ static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
 	policy->fast_switch_possible = !info->verify_transition || info->lazy_verify;
 	policy->suspend_freq = freq_table[0].frequency;
 
+	apple_zone_owner_init(policy);
+
 	return 0;
 
 out_clear_policy:
@@ -1495,6 +1793,8 @@ static void apple_soc_cpufreq_exit(struct cpufreq_policy *policy)
 {
 	struct apple_cpu_priv *priv = policy->driver_data;
 
+	/* Stop sampling the thermal zones before the cap request goes away. */
+	apple_zone_owner_exit(priv);
 	/*
 	 * The governor has stopped and the policy goes away: stop the verify
 	 * timer, report a failure it had yet to report, drop a pending request.
