From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 22:44:19 +0000
Subject: [PATCH] arm64: apple: let a core powered down alone be tried
 again, for bring-up

A core powered down while its cluster stays up is never started again:
the driver refuses it, because on T6020 such a core does not fetch its
reset vector until its cluster is power cycled. Whether T8132 has the
same restriction is not known; on the J604 an aborted suspend-to-RAM
powers the parked cores down this way, and they then stay offline until
a reboot.

Add two bring-up parameters to find out without suspending:
 - debug_lone_core (default off) allows the rest; off, nothing changes;
 - debug_power_down=<cpu> powers one offline, parked secondary down
   through the PMGR, as the suspend-to-RAM entry does, its cluster up.

With debug_lone_core set, bringing such a core online starts it through
the PMGR and the boot loader re-entry path, as for a core of a power
gated cluster, instead of refusing it. Each step logs a line, with the
PMGR stop bits, and the core logs one when it is back.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 arch/arm64/kernel/apple_cpu.c | 66 +++++++++++++++++++++++++++++++++++
 1 file changed, 66 insertions(+)

diff --git a/arch/arm64/kernel/apple_cpu.c b/arch/arm64/kernel/apple_cpu.c
index 35696ddaa4..6988035221 100644
--- a/arch/arm64/kernel/apple_cpu.c
+++ b/arch/arm64/kernel/apple_cpu.c
@@ -109,6 +109,19 @@ module_param(unproven_acc, bool, 0644);
 MODULE_PARM_DESC(unproven_acc,
 		 "Use the CPU complex of clusters whose layout is not proven on this SoC (T8132: only its p-state request) for state save and re-init (default: off)");
 
+/*
+ * Bring-up: whether a core powered down on its own, its cluster staying up,
+ * can be started again. On T6020 it cannot (see the top of this file); on
+ * other SoCs nobody knows. With this set, debug_power_down=<cpu> powers one
+ * parked secondary down through the PMGR, and the next online of a core in
+ * that state starts it through the PMGR and the boot loader re-entry path
+ * instead of refusing it. Off: both are refused, nothing changes.
+ */
+static bool debug_lone_core;
+module_param(debug_lone_core, bool, 0644);
+MODULE_PARM_DESC(debug_lone_core,
+		 "Bring-up: allow debug_power_down, and start a core powered down while its cluster stayed up instead of refusing it (default: off)");
+
 /* Core power control, see apple_cpu_power_down() and apple_cpu_park() */
 #define SYS_IMP_APL_CYC_OVRD		sys_reg(3, 5, 15, 5, 0)
 #define CYC_OVRD_DISABLE_WFI_RET	BIT_ULL(0)
@@ -366,6 +379,8 @@ struct apple_cpu {
 	u64 park_cmd;
 	/* Set by the core once it is about to park */
 	bool parked;
+	/* Powered down alone through debug_power_down, not started since */
+	bool lone;
 };
 
 #define APPLE_MAX_CPU_CTRLS		4
@@ -1724,6 +1739,11 @@ static int apple_spin_table_cpu_boot(unsigned int cpu)
 	case APPLE_CPU_OFF:
 		return apple_cpu_start(cpu, ac);
 	case APPLE_CPU_STOPPED:
+		if (READ_ONCE(debug_lone_core)) {
+			pr_info("CPU%u: starting a core powered down while its cluster stayed up (debug_lone_core): stop %#x\n",
+				cpu, readl(ac->cluster->ctrl->start + CPU_START_STOP));
+			return apple_cpu_start(cpu, ac);
+		}
 		pr_err("CPU%u: powered down while its cluster stayed up, cannot start until the cluster is power gated\n",
 		       cpu);
 		return -EIO;
@@ -1750,6 +1770,11 @@ static void apple_spin_table_cpu_postboot(void)
 		return;
 
 	ac->state = APPLE_CPU_RUNNING;
+	if (ac->lone) {
+		ac->lone = false;
+		pr_info("CPU%u: online again after a power-down alone (debug_lone_core)\n",
+			smp_processor_id());
+	}
 
 	cl = ac->cluster;
 	if (cl->acc_ovrd_dirty) {
@@ -1759,6 +1784,47 @@ static void apple_spin_table_cpu_postboot(void)
 	}
 }
 
+/* debug_power_down=<cpu>: power one parked secondary down alone */
+static int apple_cpu_debug_power_down_set(const char *val,
+					  const struct kernel_param *kp)
+{
+	struct apple_cpu *ac;
+	unsigned int cpu;
+	int ret;
+
+	if (!READ_ONCE(debug_lone_core))
+		return -EPERM;
+	ret = kstrtouint(val, 0, &cpu);
+	if (ret)
+		return ret;
+	if (cpu >= nr_cpu_ids)
+		return -EINVAL;
+
+	/* No CPU goes online or offline meanwhile. */
+	cpu_maps_update_begin();
+	ac = apple_cpus[cpu];
+	if (cpu_online(cpu) || !ac || ac->state != APPLE_CPU_PARKED) {
+		ret = -EBUSY;
+	} else {
+		ret = apple_cpu_park_power_down(cpu, ac);
+		if (!ret) {
+			ac->lone = true;
+			pr_info("CPU%u: powered down alone, its cluster up (debug_lone_core): stop %#x\n",
+				cpu, readl(ac->cluster->ctrl->start + CPU_START_STOP));
+		}
+	}
+	cpu_maps_update_done();
+
+	return ret;
+}
+
+static const struct kernel_param_ops apple_cpu_debug_power_down_ops = {
+	.set = apple_cpu_debug_power_down_set,
+};
+module_param_cb(debug_power_down, &apple_cpu_debug_power_down_ops, NULL, 0200);
+MODULE_PARM_DESC(debug_power_down,
+		 "Bring-up, with debug_lone_core: write the number of an offline (parked) secondary CPU to power it down through the PMGR");
+
 const struct cpu_operations apple_spin_table_ops = {
 	.name		= "spin-table",
 	.cpu_init	= smp_spin_table_cpu_init,
-- 
2.43.0

