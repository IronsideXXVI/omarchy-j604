From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 07:52:12 +0000
Subject: [PATCH] arm64: mark each init_el2 block on a platform's way
 back

If a T8132 deep sleep's resume stops before init_kernel_el's mark 59
with no exception recorded, the stall is in init_el2_hcr or one of
init_el2_state's blocks (the resume stub's catch vectors are live
there).

On that way back only, restart the platform's resume watchdog at
init_el2's entry (39 s), after the MMU-on clean (38 s), after
init_el2_hcr (37 s) and after each of init_el2_state's 14 blocks
(36 s down to 23 s). The marks are a call, el_resume_wd2(), gated like
el_resume_mark; init_el2_state takes them through an optional mark
argument that only head.S passes, so every other user expands as
before.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/include/asm/el2_setup.h | 60 +++++++++++++++++++++++++++++-
 arch/arm64/kernel/head.S           | 42 +++++++++++++++++++++
 2 files changed, 100 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/include/asm/el2_setup.h b/arch/arm64/include/asm/el2_setup.h
index 1da277baac..ea96b6fe08 100644
--- a/arch/arm64/include/asm/el2_setup.h
+++ b/arch/arm64/include/asm/el2_setup.h
@@ -460,23 +460,79 @@
  * if VHE was not available. The kernel context will be upgraded to VHE
  * if possible later on in the boot process
  *
- * Regs: x0, x1 and x2 are clobbered.
+ * Regs: x0, x1 and x2 are clobbered; with mark=1 also x3 and lr (el_resume_wd2, head.S).
  */
-.macro init_el2_state
+.macro init_el2_state, mark=0
 	__init_el2_sctlr
+	.if	\mark
+	mov	w1, #36
+	bl	el_resume_wd2
+	.endif
 	__init_el2_hcrx
+	.if	\mark
+	mov	w1, #35
+	bl	el_resume_wd2
+	.endif
 	__init_el2_timers
+	.if	\mark
+	mov	w1, #34
+	bl	el_resume_wd2
+	.endif
 	__init_el2_debug
+	.if	\mark
+	mov	w1, #33
+	bl	el_resume_wd2
+	.endif
 	__init_el2_brbe
+	.if	\mark
+	mov	w1, #32
+	bl	el_resume_wd2
+	.endif
 	__init_el2_lor
+	.if	\mark
+	mov	w1, #31
+	bl	el_resume_wd2
+	.endif
 	__init_el2_stage2
+	.if	\mark
+	mov	w1, #30
+	bl	el_resume_wd2
+	.endif
 	__init_el2_gicv3
+	.if	\mark
+	mov	w1, #29
+	bl	el_resume_wd2
+	.endif
 	__init_el2_gicv5
+	.if	\mark
+	mov	w1, #28
+	bl	el_resume_wd2
+	.endif
 	__init_el2_hstr
+	.if	\mark
+	mov	w1, #27
+	bl	el_resume_wd2
+	.endif
 	__init_el2_nvhe_idregs
+	.if	\mark
+	mov	w1, #26
+	bl	el_resume_wd2
+	.endif
 	__init_el2_cptr
+	.if	\mark
+	mov	w1, #25
+	bl	el_resume_wd2
+	.endif
 	__init_el2_fgt
+	.if	\mark
+	mov	w1, #24
+	bl	el_resume_wd2
+	.endif
 	__init_el2_fgt2
+	.if	\mark
+	mov	w1, #23
+	bl	el_resume_wd2
+	.endif
 .endm
 
 #ifndef __KVM_NVHE_HYPERVISOR__
diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index 85552fb383..65cf702061 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -316,6 +316,35 @@ SYM_FUNC_END(__primary_switched)
 	.endm
 #endif
 
+#if defined(CONFIG_ARM64_CTXR_EXECMEM) && defined(CONFIG_CPU_PM)
+/*
+ * el_resume_mark as a call, for many points in a row: w1 = seconds. Uses x1-x3 and lr,
+ * so only where lr is dead: in init_el2 once ELR_EL2 holds the return address.
+ */
+SYM_FUNC_START_LOCAL(el_resume_wd2)
+	cbz	x22, 1f
+	adr_l	x2, arm64_resume_armed
+	ldr	w2, [x2]
+	cbz	w2, 1f
+	adr_l	x3, arm64_resume_wdt
+	ldr	x2, [x3]
+	cbz	x2, 1f
+	ldr	w3, [x3, #16]
+	mul	w3, w3, w1
+	str	wzr, [x2, #0x2c]
+	str	wzr, [x2, #0x20]
+	str	w3, [x2, #0x28]
+	mov	w3, #1
+	str	w3, [x2, #0x2c]
+1:	ret
+SYM_FUNC_END(el_resume_wd2)
+
+	.macro	el_mark, secs
+	mov	w1, #\secs
+	bl	el_resume_wd2
+	.endm
+#endif
+
 SYM_FUNC_START(init_kernel_el)
 	mrs	x1, CurrentEL
 	cmp	x1, #CurrentEL_EL2
@@ -334,6 +363,9 @@ SYM_INNER_LABEL(init_el1, SYM_L_LOCAL)
 
 SYM_INNER_LABEL(init_el2, SYM_L_LOCAL)
 	msr	elr_el2, lr
+#if defined(CONFIG_ARM64_CTXR_EXECMEM) && defined(CONFIG_CPU_PM)
+	el_mark 39			// resuming: init_el2 entered
+#endif
 
 	// clean all HYP code to the PoC if we booted at EL2 with the MMU on
 	cbz	x0, 0f
@@ -347,9 +379,19 @@ SYM_INNER_LABEL(init_el2, SYM_L_LOCAL)
 	msr	sctlr_el2, x0
 	isb
 0:
+#if defined(CONFIG_ARM64_CTXR_EXECMEM) && defined(CONFIG_CPU_PM)
+	el_mark 38			// resuming: past the MMU-on clean
+#endif
 
 	init_el2_hcr	HCR_HOST_NVHE_FLAGS | HCR_ATA
+#if defined(CONFIG_ARM64_CTXR_EXECMEM) && defined(CONFIG_CPU_PM)
+	el_mark 37			// resuming: init_el2_hcr done
+#endif
+#if defined(CONFIG_ARM64_CTXR_EXECMEM) && defined(CONFIG_CPU_PM)
+	init_el2_state 1		// marks 36 .. 23, one per block
+#else
 	init_el2_state
+#endif
 
 	/* Hypervisor stub */
 	adr_l	x0, __hyp_stub_vectors
-- 
2.43.0

