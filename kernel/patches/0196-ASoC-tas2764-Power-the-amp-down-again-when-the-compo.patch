From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Sun, 1 Nov 2026 11:44:33 -0500
Subject: [PATCH] ASoC: tas2764: Power the amp down again when the component
 probe fails

tas2764_codec_probe() enables the SDZ supply and raises the shutdown GPIO
before it resets the amp and writes its setup. When one of those writes
fails, or an amp in an SDZ group can't get its fault IRQ, the probe
returns with the supply still enabled. ASoC doesn't call the component's
remove after a failed probe, so nothing balances that enable, and every
later probe attempt adds another. The supply then stays on after the
card is removed and, for an amp outside an SDZ group, through system
sleep as well.

Undo the power-up on those failures: lower the shutdown GPIO and drop
the supply enable, as the remove does. There is no enable to drop when
the amp has no SDZ supply (its SDZ is a GPIO, or not described), or
when its group failed and the supply was already forced off.

Signed-off-by: Erik Bourget <erik@ebourget.net>
[eryk: rebased onto integration/aurora 21f7ffcf, where the SDZ supply is
 optional: skip regulator_disable() when the amp has none]
Signed-off-by: Eryk Wieliczko <eryk@wieliczko.ninja>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit d0b1cd6d3b1b217b4c92072c2e359735b42ba38b)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 sound/soc/codecs/tas2764.c | 33 ++++++++++++++++++++++-----------
 1 file changed, 22 insertions(+), 11 deletions(-)

diff --git a/sound/soc/codecs/tas2764.c b/sound/soc/codecs/tas2764.c
index 025a111e26..8de574533e 100644
--- a/sound/soc/codecs/tas2764.c
+++ b/sound/soc/codecs/tas2764.c
@@ -1046,23 +1046,23 @@ static int tas2764_codec_probe(struct snd_soc_component *component)
 	if (tas2764->irq) {
 		ret = snd_soc_component_write(tas2764->component, TAS2764_INT_MASK0, 0x00);
 		if (ret < 0)
-			return ret;
+			goto err_sdz;
 
 		ret = snd_soc_component_write(tas2764->component, TAS2764_INT_MASK1, 0xff);
 		if (ret < 0)
-			return ret;
+			goto err_sdz;
 
 		ret = snd_soc_component_write(tas2764->component, TAS2764_INT_MASK2, 0xff);
 		if (ret < 0)
-			return ret;
+			goto err_sdz;
 
 		ret = snd_soc_component_write(tas2764->component, TAS2764_INT_MASK3, 0xff);
 		if (ret < 0)
-			return ret;
+			goto err_sdz;
 
 		ret = snd_soc_component_write(tas2764->component, TAS2764_INT_MASK4, 0xff);
 		if (ret < 0)
-			return ret;
+			goto err_sdz;
 	}
 
 	if (tas2764->i_sense_slot != -1 && tas2764->v_sense_slot != -1) {
@@ -1070,7 +1070,7 @@ static int tas2764_codec_probe(struct snd_soc_component *component)
 						   tas2764->v_sense_slot);
 
 		if (ret < 0)
-			return ret;
+			goto err_sdz;
 	}
 
 	switch (tas2764->devid) {
@@ -1079,7 +1079,7 @@ static int tas2764_codec_probe(struct snd_soc_component *component)
 					TAS2764_PWR_CTRL_BOP_SRC,
 					TAS2764_PWR_CTRL_BOP_SRC);
 		if (ret < 0)
-			return ret;
+			goto err_sdz;
 
 		for (i = 0; i < ARRAY_SIZE(sn012776_bop_presets); i++) {
 			ret = snd_soc_component_write(component,
@@ -1087,14 +1087,14 @@ static int tas2764_codec_probe(struct snd_soc_component *component)
 						sn012776_bop_presets[i]);
 
 			if (ret < 0)
-				return ret;
+				goto err_sdz;
 		}
 
 		/* Apply all enabled Apple quirks */
 		ret = tas2764_apply_init_quirks(tas2764);
 
 		if (ret < 0)
-			return ret;
+			goto err_sdz;
 
 		break;
 	default:
@@ -1110,8 +1110,10 @@ static int tas2764_codec_probe(struct snd_soc_component *component)
 		ret = request_threaded_irq(tas2764->irq, NULL, tas2764_irq,
 					   IRQF_ONESHOT | IRQF_SHARED | IRQF_TRIGGER_LOW,
 					   "tas2764", tas2764);
-		if (ret && tas2764->sdz_group)
-			return dev_err_probe(tas2764->dev, ret, "SDZ group needs its fault IRQ\n");
+		if (ret && tas2764->sdz_group) {
+			dev_err_probe(tas2764->dev, ret, "SDZ group needs its fault IRQ\n");
+			goto err_sdz;
+		}
 		if (ret)
 			dev_warn(tas2764->dev, "failed to request IRQ: %d\n", ret);
 		else
@@ -1119,6 +1121,15 @@ static int tas2764_codec_probe(struct snd_soc_component *component)
 	}
 
 	return 0;
+
+err_sdz:
+	/* Undo the power-up: ASoC doesn't call the remove after a failed probe */
+	if (tas2764->sdz_gpio)
+		gpiod_set_value_cansleep(tas2764->sdz_gpio, 0);
+	/* As in the remove: no supply to drop with a GPIO SDZ, none left in a failed group */
+	if (tas2764->sdz_reg && !tas2764_group_failed(tas2764))
+		regulator_disable(tas2764->sdz_reg);
+	return ret;
 }
 
 static void tas2764_codec_remove(struct snd_soc_component *component)
