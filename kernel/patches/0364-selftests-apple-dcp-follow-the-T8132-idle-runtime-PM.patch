+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/lifecycle.py
@@ -3,7 +3,7 @@
 """Actual disconnect authority, DWC3 teardown and firmware resource admission."""
 from pathlib import Path
 import re
-from common import block, apple_function, internal_inline, atc_mux_without_pm, source_defines, ATC_POST_TUNABLE, tipd_pm_header
+from common import block, apple_function, internal_inline, atc_mux_without_pm, source_defines, ATC_POST_TUNABLE, tipd_pm_header, atc_restore_helpers
 
 def disconnect(root):
     # Copyright 2026 Ryan Murray
@@ -1045,6 +1045,10 @@ def teardown(root):
                      'dwc3_core_exit_after_phy_power_off', 'dwc3_core_exit',
                      'dwc3_core_remove_common', 'dwc3_core_remove', 'dwc3_core_remove_no_shutdown')
     names['atc'] += ('atcphy_dwc3_reset_deassert',)
+    if atc_restore_helpers(files['atc']):
+        # A USB2-only PHY is brought back as at probe after its domain was off.
+        at = names['atc'].index('atcphy_restore_after_pd_off')
+        names['atc'] = names['atc'][:at] + ('atcphy_setup_pipehandler',) + names['atc'][at:]
     names['atc'] = tuple(name for name in names['atc'] if name not in ('atcphy_get_mode_config', 'j700_field_update'))
     names = {n: tuple(name for name in group if re.search(r'^(?:static [^\n]*\b|(?:int|void) )' + name + r'\(', files[n], re.M))
              for n, group in names.items()}
diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/phy.py b/tools/testing/selftests/drivers/gpu/apple-dcp/phy.py
index 18bc3c78c9..9235010f2b 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/phy.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/phy.py
@@ -4,7 +4,7 @@
 from pathlib import Path
 import re
 from common import (block, source_defines, atc_mux_without_pm, ATC_POST_TUNABLE,
-                    atc_function, ATC_SPLIT, ATC_T8103_LIVE)
+                    atc_function, ATC_SPLIT, ATC_T8103_LIVE, atc_restore_helpers)
 
 def parking(root):
 
@@ -47,6 +47,8 @@ struct apple_atcphy {
     bool usb3_port_off, park_owed;
     bool t8103_dummy_pending, t8103_usb3_retry, t8103_usb3_workaround;
     bool dp_only, pd_was_off, tunnel_clock_on;
+    /* T8132 idle runtime PM; these PHYs never power down while idle. */
+    bool idle_rpm, rpm_held;
     unsigned int tunnel_rate, tunnel_users;
     struct { bool aux, pll; unsigned int pairs, rate; } dp_t8122;
     enum atcphy_mode mode, typec_mode;
@@ -166,6 +168,7 @@ static int atcphy_configure(struct apple_atcphy *, enum atcphy_mode);
     for name in ('core_read32', 'atcphy_get_mode_config', 'j700_field_update', 'j700_pma_idle'):
         parts.append(function(atc, name))
     parts.append(dp)
+    parts.append(atc_restore_helpers(atc))
     for name in ('atcphy_configure_lanes', 'j700_aux_enable', 'j700_aux_disable',
                  'atcphy_enable_dp_aux', 'atcphy_disable_dp_aux', 'atcphy_power_off',
                  'atcphy_power_on', *ATC_POST_TUNABLE, 'atcphy_configure', 'atcphy_set_orientation',
diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/pm.py b/tools/testing/selftests/drivers/gpu/apple-dcp/pm.py
index 189f1e678d..3872506124 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/pm.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/pm.py
@@ -4,7 +4,7 @@
 from pathlib import Path
 import os, re, subprocess
 import phy
-from common import block, tipd_pm_header, atc_function
+from common import block, tipd_pm_header, atc_function, ATC_RPM
 
 def ownership(root, usb_unreachable=False):
     ns=phy.parking(root)
@@ -171,6 +171,8 @@ static void usb_mark_last_busy(struct usb_device *u) {
  assert(root_locked&&!pm_phy->lock);
  if(u==&link_device)assert(link_locked);else assert(u==&roots[3]&&!link_locked);
 }
+/* Only an idle-power-off PHY takes a hold of its own; the fixture PHY never does. */
+static void __attribute__((unused)) pm_runtime_get_noresume(struct device *d) { (void)d; assert(!"PHY runtime PM hold"); }
 static void pm_runtime_put_autosuspend(struct device *d) {
  assert(root_locked&&!pm_phy->lock);
  if(d==&link_device.dev){assert(link_locked&&link_pm_refs==1);link_pm_refs--;}
@@ -428,6 +430,8 @@ int main(void)
        ('atcphy_park_retry_delay','atcphy_park_retry','atcphy_park_due','atcphy_mux_change'))
      helpers+=ns['function'](s,'atcphy_mux_update')+'\n'
      # Lane fixtures provide the target mapping and locked body; use the real callback here.
+     # The mux callback powers an idle-power-off PHY first; this PHY is not one.
+     helpers+=''.join(atc_function(s,name) for name in ATC_RPM)
      marker=re.search(r'^static int atcphy_mux_set\(',s,re.M).group()
      helpers+=ns['block'](s,marker)+'\n'
     else:
