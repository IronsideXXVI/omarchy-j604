diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index f3d9e22e8a..acb51b4c3d 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -895,6 +895,62 @@ pub(crate) fn flights() -> usize {
     "G16: render commands in flight at once, 1 (default, the qualified one-at-a-time protocol) or 2 (one render published behind a running render; experimental; runtime 0644)"
 );
 
+/// Storage of `g16_resident` (runtime 0644, default 0).
+static RESIDENT: AtomicU32 = AtomicU32::new(0);
+
+/// Render pass units per VM, latched at the first G16 slot setup of the boot: 0 until then.
+static RESIDENT_LATCH: AtomicU32 = AtomicU32::new(0);
+
+/// Render pass units every VM allocates: 2 (the qualified layout), or `g16_resident`
+/// clamped to 3..=[`hw::sizes::RENDER_UNITS`] when it is set before the GPU is first used
+/// (module option in the initramfs). Latched once; later changes of `g16_resident` only
+/// lower the depth ([`resident`]).
+pub(crate) fn resident_units() -> usize {
+    let l = RESIDENT_LATCH.load(Ordering::Acquire);
+    if l != 0 {
+        return l as usize;
+    }
+    let v = RESIDENT.load(Ordering::Relaxed);
+    let units = if v >= 3 {
+        v.min(hw::sizes::RENDER_UNITS as u32)
+    } else {
+        2
+    };
+    let _ = RESIDENT_LATCH.compare_exchange(0, units, Ordering::AcqRel, Ordering::Acquire);
+    RESIDENT_LATCH.load(Ordering::Acquire) as usize
+}
+
+/// Resident render depth: how many render commands may sit in the firmware's TA/FS rings at
+/// once, each in its own render pass unit, retired in order as their receipts complete (one
+/// ring-service event may retire several). 0 (`g16_resident` < 2, or `g16_overlap` /
+/// `g16_uma_split` not in effect): off, `g16_flights`/`g16_depth` decide as before.
+/// Otherwise `g16_resident` bounded by [`resident_units`] and the flight capacity. Explicit
+/// barriers and historical priors still wait for completion; a job's later commands still
+/// wait for its earlier ones (one job never occupies two flights).
+pub(crate) fn resident() -> usize {
+    let v = RESIDENT.load(Ordering::Relaxed) as usize;
+    if v < 2 || !super::pools::lifetime::overlap_active() {
+        return 0;
+    }
+    v.min(resident_units()).min(hw::sizes::FLIGHTS)
+}
+
+/// Scheduler credits of a queue created now: [`hw::sizes::SCHEDULER_CREDITS`], or the
+/// latched resident units when larger, so `g16_resident` jobs of one queue can be admitted
+/// together.
+pub(crate) fn resident_credits() -> u32 {
+    (resident_units() as u32).max(hw::sizes::SCHEDULER_CREDITS)
+}
+
+live_u32_param!(
+    RESIDENT_PARAM,
+    RESIDENT_PARMTYPE,
+    RESIDENT_PARM,
+    RESIDENT,
+    "g16_resident",
+    "G16: render commands that may be resident in the firmware rings at once, each in its own render unit (default 0: off; 2..4; >= 3 must be set at module load to allocate the extra units; needs g16_overlap=1 and g16_uma_split=1; runtime 0644)"
+);
+
 /// Storage of `g16_submit_ahead` (runtime 0644, default 0).
 static SUBMIT_AHEAD: AtomicU32 = AtomicU32::new(0);
 
