diff --git a/drivers/gpu/drm/asahi/g16/short_acct.rs b/drivers/gpu/drm/asahi/g16/short_acct.rs
new file mode 100644
index 0000000000..c2e752ad44
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16/short_acct.rs
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+//! `g16_short_acct`: stage time for renders published with the short sequences. Core only, so
+//! the rules run as host tests.
+//!
+//! With `g16_fs_short` a render that asks for no timestamps has no FS start and end stamps, and
+//! with `g16_ta_short` no TA end stamp, so the client's fdinfo fragment and vertex time and the
+//! stage statistics stop advancing for such renders. With N = `g16_short_acct` one eligible
+//! render of a queue in about N (a jittered interval, so that a workload with a period cannot
+//! align with the samples) keeps both long forms and is measured by its own stamps, exactly as
+//! with the words off. Every short render of that queue is credited the moving average of its
+//! queue's sampled spans, per stage. Credit starts once the queue's first sample retired.
+
+use core::sync::atomic::{AtomicU32, Ordering};
+
+/// Stages with a short form: 0 TA (vertex), 1 FS (fragment).
+pub(crate) const STAGES: usize = 2;
+/// A new sample weighs 1/8 in the average.
+pub(crate) const EMA_SHIFT: u32 = 3;
+/// Largest sampling interval.
+pub(crate) const N_MAX: u32 = 1024;
+/// Largest span averaged, in stamp ticks (0.7 s at 24 MHz); the average keeps 8 fraction bits.
+pub(crate) const SPAN_MAX: u32 = (1 << 24) - 1;
+
+/// Per-queue sampling and averages. Read and written under the engine lock; the atomics only
+/// make the state shareable through the queue's `Arc`.
+pub(crate) struct State {
+    /// Eligible renders still to publish short before the next sample.
+    until: AtomicU32,
+    /// Jitter generator state.
+    rng: AtomicU32,
+    /// Moving average of the sampled spans, per stage, in 1/256 stamp ticks (0: no sample yet).
+    mean: [AtomicU32; STAGES],
+}
+
+impl State {
+    pub(crate) const fn new() -> Self {
+        Self {
+            until: AtomicU32::new(0),
+            rng: AtomicU32::new(0x9e37_79b9),
+            mean: [const { AtomicU32::new(0) }; STAGES],
+        }
+    }
+
+    /// Called once per eligible render (no timestamp outputs, a short word on) at publication,
+    /// with `n` = `g16_short_acct`: whether this render is a sample and keeps the long forms.
+    /// The first eligible render of a queue is always a sample. `n` 0: never.
+    pub(crate) fn sample_due(&self, n: u32) -> bool {
+        if n == 0 {
+            return false;
+        }
+        let until = self.until.load(Ordering::Relaxed);
+        if until > 0 {
+            self.until.store(until - 1, Ordering::Relaxed);
+            return false;
+        }
+        let (next, rng) = interval(self.rng.load(Ordering::Relaxed), n);
+        self.rng.store(rng, Ordering::Relaxed);
+        self.until.store(next - 1, Ordering::Relaxed);
+        true
+    }
+
+    /// Folds a sampled render's measured span of `stage` into the average.
+    pub(crate) fn note(&self, stage: usize, ticks: u64) {
+        if let Some(m) = self.mean.get(stage) {
+            let t = ticks.clamp(1, u64::from(SPAN_MAX)) as u32;
+            m.store(ema(m.load(Ordering::Relaxed), t), Ordering::Relaxed);
+        }
+    }
+
+    /// The span a short render of this queue is credited for `stage`; None before the first
+    /// sample.
+    pub(crate) fn credit(&self, stage: usize) -> Option<u32> {
+        self.mean
+            .get(stage)
+            .map(|m| m.load(Ordering::Relaxed))
+            .filter(|&m| m != 0)
+            .map(|m| ((m + 128) >> 8).max(1))
+    }
+}
+
+/// The renders until the next sample with `n` = `g16_short_acct` (2 to [`N_MAX`]; 1 counts as
+/// 2), drawn evenly from n - n/4 to n + n/4, and the generator's next state.
+pub(crate) fn interval(rng: u32, n: u32) -> (u32, u32) {
+    let n = n.clamp(2, N_MAX);
+    let next = rng.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+    let lo = n - n / 4;
+    let span = 2 * (n / 4) + 1;
+    (lo + (next >> 16) % span, next)
+}
+
+/// The moving average (1/256 ticks) after one more sample of `sample` ticks: the first sample
+/// as it is, then each new one weighing 1 / 2^[`EMA_SHIFT`]. The step rounds toward zero in
+/// both directions, so it has no drift of its own.
+pub(crate) fn ema(mean: u32, sample: u32) -> u32 {
+    let s = i64::from(sample.min(SPAN_MAX)) << 8;
+    if mean == 0 {
+        return s.max(1) as u32;
+    }
+    let m = i64::from(mean);
+    (m + (s - m) / (1 << EMA_SHIFT)).clamp(1, i64::from(u32::MAX)) as u32
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Publishes `count` eligible renders whose true spans are `span(i)`, samples retiring
+    /// `lag` renders later, and returns (credited total, true total of the short renders,
+    /// samples).
+    fn run(n: u32, count: usize, lag: usize, span: impl Fn(usize) -> u32) -> (u64, u64, u32) {
+        let st = State::new();
+        let mut sampled = vec![false; count];
+        let (mut credit, mut truth, mut samples) = (0u64, 0u64, 0u32);
+        for i in 0..count + lag {
+            if i < count {
+                sampled[i] = st.sample_due(n);
+            }
+            // Retire render i - lag.
+            if i >= lag {
+                let r = i - lag;
+                if sampled[r] {
+                    st.note(1, u64::from(span(r)));
+                    samples += 1;
+                } else if let Some(c) = st.credit(1) {
+                    credit += u64::from(c);
+                    truth += u64::from(span(r));
+                }
+            }
+        }
+        (credit, truth, samples)
+    }
+
+    #[test]
+    fn off_never_samples_and_credits_nothing() {
+        let st = State::new();
+        assert!((0..1000).all(|_| !st.sample_due(0)));
+        assert_eq!(st.credit(0), None);
+        assert_eq!(st.credit(1), None);
+    }
+
+    #[test]
+    fn the_first_render_is_a_sample_and_the_rate_is_one_in_n() {
+        for n in [2u32, 8, 16, 64] {
+            let st = State::new();
+            assert!(st.sample_due(n));
+            let k = (0..100_000).filter(|_| st.sample_due(n)).count() as f64;
+            let rate = 100_000.0 / k;
+            assert!(
+                (rate - f64::from(n)).abs() <= f64::from(n) * 0.05,
+                "n {n}: one in {rate}"
+            );
+        }
+    }
+
+    #[test]
+    fn intervals_stay_within_a_quarter_of_n() {
+        let mut rng = 1;
+        for _ in 0..10_000 {
+            let (k, r) = interval(rng, 16);
+            assert!((12..=20).contains(&k), "{k}");
+            rng = r;
+        }
+        assert_eq!(interval(5, 1).0, interval(5, 2).0);
+        assert!(interval(5, u32::MAX).0 <= N_MAX + N_MAX / 4);
+    }
+
+    #[test]
+    fn a_steady_stream_is_credited_its_own_total() {
+        // render.light: about 2.5 us of FS (60 ticks) with +-10 % noise, 64 in flight.
+        let (credit, truth, samples) = run(16, 20_000, 64, |i| 54 + (i * 7919 % 13) as u32);
+        assert!(samples > 1000);
+        let err = (credit as f64 - truth as f64) / truth as f64;
+        assert!(err.abs() < 0.02, "error {err}");
+    }
+
+    #[test]
+    fn jitter_breaks_a_period_that_divides_n() {
+        // Two passes per frame, 10 and 30 ticks: a fixed interval of 16 would sample one kind
+        // only and credit 10 or 30 for every render; the jittered one credits about 20.
+        let (credit, truth, _) = run(16, 40_000, 8, |i| if i % 2 == 0 { 10 } else { 30 });
+        let err = (credit as f64 - truth as f64) / truth as f64;
+        assert!(err.abs() < 0.05, "error {err}");
+        let st = State::new();
+        let fixed = (0..40_000).map(|i| (i % 16 == 0, if i % 2 == 0 { 10 } else { 30 }));
+        for (s, v) in fixed {
+            if s {
+                st.note(1, v);
+            }
+        }
+        assert_eq!(
+            st.credit(1),
+            Some(10),
+            "the fixed interval sees one kind only"
+        );
+    }
+
+    #[test]
+    fn a_step_in_the_workload_is_followed() {
+        // 60 ticks, then 120: after the step the credit converges to the new span.
+        let st = State::new();
+        for v in [60u64; 200].iter().chain([120u64; 200].iter()) {
+            st.note(1, *v);
+        }
+        let c = st.credit(1).unwrap();
+        assert!((115..=120).contains(&c), "{c}");
+        assert_eq!(ema(0, 0), 1);
+        assert_eq!(ema(60 << 8, 60), 60 << 8);
+        assert_eq!(ema(0, u32::MAX), SPAN_MAX << 8);
+    }
+}
-- 
