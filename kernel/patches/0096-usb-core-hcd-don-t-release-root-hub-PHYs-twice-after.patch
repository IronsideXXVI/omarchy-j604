From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:05:43 -0500
Subject: [PATCH] usb: core: hcd: don't release root hub PHYs twice
 after a failed resume

A system suspend of a root hub powers its PHYs off, and exits them when
the controller can't wake the system. hcd_bus_resume() takes them back
before the bus resume, and releases them again if that fails. When the
HCD is then removed, usb_remove_hcd() releases them a third time, and the
phy core takes the power count below zero.

The J700's DWC3 glue keeps xHCI away from a core that came back from a
deep sleep without its registers, so the bus resume fails with -ESHUTDOWN
and the glue restarts the host. The USB3 PHY's count then ends one
short. The restarted host's own root hub suspend at the next sleep takes
it to zero, and the PHY's power_off turns the SuperSpeed side off under
the sleeping host, which refused that sleep ("USB changed for the sleep
(mode 0, PIPE 0, host 0): refusing it", measured on a J700). Nothing logs
the count itself, so that it is what the refusal hit is inferred from
the code: the hcd_bus_resume() failure path and usb_remove_hcd() both
release the PHYs, and phy_power_off() doesn't check for zero.

Track with a flag whether a system suspend released the PHYs. Resume
takes them back only then, a failed resume releases only what it took
(an autoresume takes nothing), a suspend after a raced autoresume doesn't
release them again, and removal releases only what is still held.

Signed-off-by: Diljit Singh <hey@djdev.me>
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/usb/core/hcd.c  | 25 ++++++++++++++++++++-----
 include/linux/usb/hcd.h |  1 +
 2 files changed, 21 insertions(+), 5 deletions(-)

diff --git a/drivers/usb/core/hcd.c b/drivers/usb/core/hcd.c
index 8e8a5f59b3..0ea6a9a729 100644
--- a/drivers/usb/core/hcd.c
+++ b/drivers/usb/core/hcd.c
@@ -2280,7 +2280,9 @@ int hcd_bus_suspend(struct usb_device *rhdev, pm_message_t msg)
 		usb_set_device_state(rhdev, USB_STATE_SUSPENDED);
 		hcd->state = HC_STATE_SUSPENDED;
 
-		if (!PMSG_IS_AUTO(msg))
+		/* A suspend after a raced autoresume finds them released already. */
+		if (!PMSG_IS_AUTO(msg) &&
+		    !test_and_set_bit(HCD_FLAG_PHY_SUSPENDED, &hcd->flags))
 			usb_phy_roothub_suspend(hcd->self.sysdev,
 						hcd->phy_roothub);
 
@@ -2321,11 +2323,12 @@ int hcd_bus_resume(struct usb_device *rhdev, pm_message_t msg)
 		return 0;
 	}
 
-	if (!PMSG_IS_AUTO(msg)) {
+	if (!PMSG_IS_AUTO(msg) && test_bit(HCD_FLAG_PHY_SUSPENDED, &hcd->flags)) {
 		status = usb_phy_roothub_resume(hcd->self.sysdev,
 						hcd->phy_roothub);
 		if (status)
 			return status;
+		clear_bit(HCD_FLAG_PHY_SUSPENDED, &hcd->flags);
 	}
 
 	if (!hcd->driver->bus_resume)
@@ -2368,7 +2371,11 @@ int hcd_bus_resume(struct usb_device *rhdev, pm_message_t msg)
 		}
 	} else {
 		hcd->state = old_state;
-		usb_phy_roothub_suspend(hcd->self.sysdev, hcd->phy_roothub);
+		/* Only release what this resume took: an autoresume took nothing. */
+		if (!PMSG_IS_AUTO(msg)) {
+			usb_phy_roothub_suspend(hcd->self.sysdev, hcd->phy_roothub);
+			set_bit(HCD_FLAG_PHY_SUSPENDED, &hcd->flags);
+		}
 		dev_dbg(&rhdev->dev, "bus %s fail, err %d\n",
 				"resume", status);
 		if (status != -ESHUTDOWN)
@@ -3084,8 +3091,16 @@ void usb_remove_hcd(struct usb_hcd *hcd)
 	usb_deregister_bus(&hcd->self);
 	hcd_buffer_destroy(hcd);
 
-	usb_phy_roothub_power_off(hcd->phy_roothub);
-	usb_phy_roothub_exit(hcd->phy_roothub);
+	/*
+	 * A root hub whose resume failed still has its PHYs released by the suspend,
+	 * powered off and, without wakeup, exited too. Don't release them twice.
+	 */
+	if (!test_bit(HCD_FLAG_PHY_SUSPENDED, &hcd->flags)) {
+		usb_phy_roothub_power_off(hcd->phy_roothub);
+		usb_phy_roothub_exit(hcd->phy_roothub);
+	} else if (device_may_wakeup(hcd->self.sysdev)) {
+		usb_phy_roothub_exit(hcd->phy_roothub);
+	}
 
 	usb_put_invalidate_rhdev(hcd);
 	hcd->flags = 0;
diff --git a/include/linux/usb/hcd.h b/include/linux/usb/hcd.h
index 604b9dda94..b8bf424370 100644
--- a/include/linux/usb/hcd.h
+++ b/include/linux/usb/hcd.h
@@ -112,6 +112,7 @@ struct usb_hcd {
 #define HCD_FLAG_DEAD			6	/* controller has died? */
 #define HCD_FLAG_INTF_AUTHORIZED	7	/* authorize interfaces? */
 #define HCD_FLAG_DEFER_RH_REGISTER	8	/* Defer roothub registration */
+#define HCD_FLAG_PHY_SUSPENDED		9	/* root hub PHYs released by a suspend */
 
 	/* The flags can be tested using these macros; they are likely to
 	 * be slightly faster than test_bit().
