From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:09:38 -0500
Subject: [PATCH] soc: apple: t8140-sleep, mfd: macsmc: take a lid closing
 during sleep as a dark wake

The SMC wakes the J700 for the lid closing as well as for it opening,
with the same wake record bit ("lid"). The machine then woke fully with
the lid closed, and logind ignores the lid for 30 s after a resume, so
it stayed awake (measured on a J700).

macOS takes that wake and goes back to sleep. In the 25G83 kernel, read
statically, AppleSMCPMU's _sendLidStateToRootDomainGated sends 0x10
(kIOPMClamshellClosed) to the root domain, whose dark wake policy then
calls privateSleepSystem() with 0x6c (Maintenance) unless the machine is
in desktop mode on AC.

Do the same through the PM core's dark wake. The sleep driver records in
.wake whether only the SMC's own sources woke the SoC, which it finds by
their names in its table of the ADT's wake sources. The SMC's noirq
resume, still polled, reads MSLD when the wake record is the lid alone,
the bit taken from its table of reasons by name, and reports a closed
lid to the sleep driver, which sets the dark wake flag when nothing else
woke the SoC. Any other source or reason, an open lid or a failed read
gives a normal wake. A display plugged in during the sleep wakes the AP
with its own reason. Unlike macOS, a closed lid sleeps again with an
external display attached on AC too: desktop mode isn't modelled here.

The wake record's wakeup event is reported after the lid check, and not
for a dark wake: with wakeup_count in use, it would abort the sleep that
follows.

A KUnit case checks that MSLD is read only for the lid alone, after
MBSE = waka.

Signed-off-by: Diljit Singh <hey@djdev.me>

[j604 backport: t8140-sleep.c part ported to our apple-sleep.c (t8140-sleep.c removed): woken sources taken in
apple_sleep_ap_wake_restore() (syscore, before devices resume) as latched & ~mask, compared with
apple,smc-wake-sources (new binding property); no property means never a dark wake. The J604 values come
only from the J604 ADT: smc-wake-sources <161 183> = SMC.CPUWakeupAP, SMC.OutboxNotEmpty, and the lid bit
of apple_smc_wake_reason_bit()'s per-SoC table from the ADT smc-pmu node (MEASURED). The macOS behaviour
described above is the original author's account; no Apple code was read for this port and no value in it
comes from one.]
Assisted-by: Claude:claude-opus-5.5

---
 .../bindings/power/apple,pmgr-sleep.yaml      | 10 ++++
 .../boot/dts/apple/t8132-j604-sleep.dtsi      |  2 +
 drivers/mfd/macsmc-test.c                     | 42 ++++++++++++++
 drivers/mfd/macsmc.c                          | 43 +++++++++++++-
 drivers/soc/apple/apple-sleep.c               | 56 +++++++++++++++++++
 include/linux/soc/apple/sleep.h               |  7 +++
 6 files changed, 158 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/power/apple,pmgr-sleep.yaml b/Documentation/devicetree/bindings/power/apple,pmgr-sleep.yaml
index 17dd8d1770..9de2cce5f4 100644
--- a/Documentation/devicetree/bindings/power/apple,pmgr-sleep.yaml
+++ b/Documentation/devicetree/bindings/power/apple,pmgr-sleep.yaml
@@ -74,6 +74,16 @@ properties:
       Power state nodes behind the AFR; the AFR is only turned off when all
       of these are powered down
 
+  apple,smc-wake-sources:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 1
+    maxItems: 8
+    items:
+      maximum: 262
+    description:
+      Bit numbers of the SMC's own AP wake sources. A wake that only these
+      raised and that the SMC reports as the lid closing is a dark wake.
+
   apple,ap-wake-sources:
     $ref: /schemas/types.yaml#/definitions/uint32-array
     minItems: 1
diff --git a/arch/arm64/boot/dts/apple/t8132-j604-sleep.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-sleep.dtsi
index 0dacfb1417..a58b5f2c6d 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-sleep.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-sleep.dtsi
@@ -59,6 +59,8 @@
 		apple,ap-wake-sources = <5 12 14 42 60 64 68 69 70 71 72 73 74 75
 					 85 104 122 123 138 145 150 156 161 183
 					 229>;
+		/* Of those, the SMC's: SMC.CPUWakeupAP and SMC.OutboxNotEmpty */
+		apple,smc-wake-sources = <161 183>;
 		status = "disabled";
 	};
 };
diff --git a/drivers/mfd/macsmc-test.c b/drivers/mfd/macsmc-test.c
index 5e38da0dab..16d6fdae7c 100644
--- a/drivers/mfd/macsmc-test.c
+++ b/drivers/mfd/macsmc-test.c
@@ -13,6 +13,7 @@ struct macsmc_test_context {
 	u32 seen[8];
 	unsigned int seen_count;
 	int ap_power_result;
+	u64 record;
 };
 
 #define MACSMC_TEST_AP_IDLE	0
@@ -279,6 +280,46 @@ static void macsmc_notice_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, ctx->seen[3], SMC_KEY(MBSW));
 }
 
+/* MBSW reads ctx->record, MSLD reads closed. */
+static int macsmc_test_lid_read(struct apple_smc *smc, smc_key key, void *buf, size_t size)
+{
+	struct macsmc_test_context *ctx = container_of(smc, struct macsmc_test_context, smc);
+
+	if (ctx->seen_count < ARRAY_SIZE(ctx->seen))
+		ctx->seen[ctx->seen_count++] = key;
+	memset(buf, 0, size);
+	if (key == SMC_KEY(MBSW) && size == sizeof(ctx->record))
+		put_unaligned_le64(ctx->record, buf);
+	else if (key == SMC_KEY(MSLD))
+		*(u8 *)buf = 1;
+	return size;
+}
+
+static void macsmc_lid_wake_test(struct kunit *test)
+{
+	struct macsmc_test_context *ctx = test->priv;
+
+	kunit_activate_static_stub(test, apple_smc_ap_power, macsmc_test_ap_power);
+	kunit_activate_static_stub(test, apple_smc_read, macsmc_test_lid_read);
+	ctx->result = 4;
+
+	/* The lid alone: MSLD is read last, after macOS's own order. */
+	ctx->record = BIT_ULL(10);
+	apple_smc_sleep_wake(&ctx->smc);
+	KUNIT_ASSERT_EQ(test, ctx->seen_count, 5U);
+	KUNIT_EXPECT_EQ(test, ctx->seen[0], (u32)MACSMC_TEST_AP_ON);
+	KUNIT_EXPECT_EQ(test, ctx->seen[1], SMC_KEY(MBSE));
+	KUNIT_EXPECT_EQ(test, ctx->seen[2], SMC_KEY(MBSW));
+	KUNIT_EXPECT_EQ(test, ctx->seen[3], SMC_KEY(waka));
+	KUNIT_EXPECT_EQ(test, ctx->seen[4], SMC_KEY(MSLD));
+
+	/* The lid with anything else is a normal wake: the lid isn't read. */
+	ctx->seen_count = 0;
+	ctx->record = BIT_ULL(10) | BIT_ULL(0);
+	apple_smc_sleep_wake(&ctx->smc);
+	KUNIT_EXPECT_EQ(test, ctx->seen_count, 4U);
+}
+
 static void macsmc_wake_reason_test(struct kunit *test)
 {
 	char names[128];
@@ -304,6 +345,7 @@ static struct kunit_case macsmc_parser_cases[] = {
 	KUNIT_CASE(macsmc_sleep_order_test),
 	KUNIT_CASE(macsmc_sleep_refused_test),
 	KUNIT_CASE(macsmc_notice_test),
+	KUNIT_CASE(macsmc_lid_wake_test),
 	KUNIT_CASE(macsmc_wake_reason_test),
 	{}
 };
diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
index 659a92c8ac..ed352edd2a 100644
--- a/drivers/mfd/macsmc.c
+++ b/drivers/mfd/macsmc.c
@@ -880,8 +880,43 @@ static void apple_smc_notice_on(struct apple_smc *smc)
 	apple_smc_wake_reason_names(smc->wake_record, names, sizeof(names));
 	dev_info(smc->dev, "wake record: MBSE %#x, MBSW %8ph%s%s\n", event, record,
 		 names[0] ? ": " : "", names);
-	if (smc->wake_record)
-		pm_wakeup_event(smc->dev, 0);
+}
+
+/* MBSW's bit for a wake reason, by its name, or -1. */
+static int apple_smc_wake_reason_bit(const char *name)
+{
+	const struct apple_smc_wake_reason *r;
+	unsigned int i, n;
+
+	r = apple_smc_wake_table(&n);
+	for (i = 0; i < n; i++)
+		if (!strcmp(r[i].name, name))
+			return r[i].bit;
+
+	return -1;
+}
+
+/*
+ * Woken for the lid alone, which the SMC reports for the lid opening and for it closing:
+ * tell the sleep driver if it's closed now.
+ */
+static void apple_smc_lid_wake(struct apple_smc *smc)
+{
+	int bit = apple_smc_wake_reason_bit("lid");
+	u8 lid = 0;
+	int ret;
+
+	if (bit < 0 || smc->wake_record != BIT_ULL(bit))
+		return;
+
+	ret = apple_smc_read_u8(smc, SMC_KEY(MSLD), &lid);
+	if (ret < 0) {
+		dev_warn(smc->dev, "Failed to read the lid after a wake: %d\n", ret);
+		return;
+	}
+	dev_info(smc->dev, "woken for the lid, which is %s\n", lid ? "closed" : "open");
+	if (lid)
+		apple_sleep_lid_closed_wake();
 }
 
 static void apple_smc_sleep_wake(struct apple_smc *smc)
@@ -889,6 +924,10 @@ static void apple_smc_sleep_wake(struct apple_smc *smc)
 	apple_smc_notice_on(smc);
 	apple_smc_write_mbse(smc, SMC_KEY(waka));
 	smc->sleep_warned = false;
+	apple_smc_lid_wake(smc);
+	/* A dark wake isn't one: with wakeup_count in use, it would abort the sleep after it. */
+	if (smc->wake_record && !pm_dark_wake())
+		pm_wakeup_event(smc->dev, 0);
 }
 
 static int apple_smc_prepare(struct device *dev)
diff --git a/drivers/soc/apple/apple-sleep.c b/drivers/soc/apple/apple-sleep.c
index 37accaccb8..a633fdeb8c 100644
--- a/drivers/soc/apple/apple-sleep.c
+++ b/drivers/soc/apple/apple-sleep.c
@@ -180,6 +180,9 @@ struct apple_sleep {
 	u32 wake_saved[16];
 	bool has_wake_sources;
 	bool wake_done;
+	/* The SMC's own sources (apple,smc-wake-sources), and whether only they woke the SoC */
+	u32 smc_wake[16];
+	bool smc_woke_alone;
 
 	struct notifier_block pm_nb;
 	struct dentry *debugfs;
@@ -651,6 +654,7 @@ int apple_sleep_ap_wake_arm(void)
 		s->wake_saved[i] = readl(reg);
 		writel(s->wake_armed[i], reg);
 	}
+	s->smc_woke_alone = false;
 	s->wake_done = true;
 
 	return 0;
@@ -662,15 +666,42 @@ void apple_sleep_ap_wake_restore(void)
 	struct apple_sleep *s = apple_sleep;
 	unsigned int i;
 
+	bool any = false, other = false;
+
 	if (!s || !s->wake_done)
 		return;
 	s->wake_done = false;
 
+	/* What woke the SoC, among the sources this sleep left enabled (mask bit 0) */
+	for (i = 0; i < s->hw->n_wake; i++) {
+		u32 woke = readl(s->wake + s->hw->wake_latched + 4 * i) & ~s->wake_armed[i];
+
+		other |= !!(woke & ~s->smc_wake[i]);
+		any |= !!woke;
+	}
+	s->smc_woke_alone = any && !other;
+
 	for (i = 0; i < s->hw->n_wake; i++)
 		writel(s->wake_saved[i], s->wake + s->hw->wake_mask + 4 * i);
 }
 EXPORT_SYMBOL_GPL(apple_sleep_ap_wake_restore);
 
+/*
+ * macOS takes the wake for a lid closing during the sleep as a dark one: every driver
+ * wakes, the display stays off, and the system sleeps again as soon as it sees the lid
+ * closed.
+ */
+void apple_sleep_lid_closed_wake(void)
+{
+	struct apple_sleep *s = apple_sleep;
+
+	if (!s || !s->smc_woke_alone)
+		return;
+	dev_info(s->dev, "the lid closed during the sleep: dark wake\n");
+	pm_set_dark_wake();
+}
+EXPORT_SYMBOL_GPL(apple_sleep_lid_closed_wake);
+
 static int apple_sleep_s2idle_prepare_late(void)
 {
 	unsigned int st = READ_ONCE(stages);
@@ -879,6 +910,28 @@ out:
 	return ret;
 }
 
+/* The SMC's own AP wake sources, to tell a wake for it alone from any other */
+static int apple_sleep_get_smc_wake_sources(struct apple_sleep *s)
+{
+	struct device *dev = s->dev;
+	int count, i;
+	u32 bit;
+
+	count = of_property_count_u32_elems(dev->of_node, "apple,smc-wake-sources");
+	if (count == -EINVAL)
+		return 0;
+	if (count <= 0)
+		return dev_err_probe(dev, -EINVAL, "bad apple,smc-wake-sources\n");
+	for (i = 0; i < count; i++) {
+		if (of_property_read_u32_index(dev->of_node, "apple,smc-wake-sources", i, &bit) ||
+		    bit / 32 >= s->hw->n_wake)
+			return dev_err_probe(dev, -EINVAL, "invalid SMC wake source\n");
+		s->smc_wake[bit / 32] |= BIT(bit % 32);
+	}
+
+	return 0;
+}
+
 static int apple_sleep_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -953,6 +1006,9 @@ static int apple_sleep_probe(struct platform_device *pdev)
 		return ret;
 
 	ret = apple_sleep_get_wake_sources(s);
+	if (ret)
+		return ret;
+	ret = apple_sleep_get_smc_wake_sources(s);
 	if (ret)
 		return ret;
 
diff --git a/include/linux/soc/apple/sleep.h b/include/linux/soc/apple/sleep.h
index c7cf50f2f4..f1ce68ee12 100644
--- a/include/linux/soc/apple/sleep.h
+++ b/include/linux/soc/apple/sleep.h
@@ -43,6 +43,12 @@ void apple_sleep_cpm_restore(void);
 void apple_sleep_pmgr_wake(void);
 int apple_sleep_ap_wake_arm(void);
 void apple_sleep_ap_wake_restore(void);
+/*
+ * From the SMC's driver, in its noirq resume: the SMC woke the AP for the lid alone, and the
+ * lid reads closed. If nothing else woke the SoC, the PM core goes back to sleep once every
+ * device has resumed.
+ */
+void apple_sleep_lid_closed_wake(void);
 
 #else
 
@@ -57,6 +63,7 @@ static inline void apple_sleep_cpm_restore(void) { }
 static inline void apple_sleep_pmgr_wake(void) { }
 static inline int apple_sleep_ap_wake_arm(void) { return -ENODEV; }
 static inline void apple_sleep_ap_wake_restore(void) { }
+static inline void apple_sleep_lid_closed_wake(void) { }
 
 #endif
 
