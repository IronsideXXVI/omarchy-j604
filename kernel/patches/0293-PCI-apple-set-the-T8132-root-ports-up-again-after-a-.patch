From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 02:21:14 +0000
Subject: [PATCH] PCI: apple: set the T8132 root ports up again after a
 deep sleep

A T8132 suspend-to-RAM powers ANS's APCIe block down and, before any
device resumes, back up (apple-s2r). The block returns with the root
ports it stopped left down: on the J604 the Wi-Fi/Bluetooth radio's
(port 0) and the SD card reader's (port 2). Everything the boot loader
set up per port is gone, and this host does nothing on resume, so the
radio, Bluetooth and the SD reader stay away until a reboot.

Behind pcie_apple.t8132_port_restart (default off), for each port of
the T8132 built-in host that apple_sleep_apcie_port_down() reports down
after such a sleep, put back:

- the boot loader's port setup: m1n1's fixed register values, the
  port's apple,tunable-port table, the application clock, the port
  PHY's two reference clocks and its release from reset, the port
  released and idle, as m1n1 does it on the T8122-compatible path the
  T8132 takes;
- the root port's DesignWare registers: its apple,tunable-rc, -rc-gen3
  and -rc-gen4 tables, then the link capability and control words the
  boot loader set from the ADT, read before the sleep;
- what probe did then: the endpoint reset with probe's timing, the
  clock gating, the port's MSI routing, the RID-to-SID entries and
  interrupt mask read before the sleep, and link training with probe's
  endpoint-reset retries.

The four tables are the ADT's, which m1n1 publishes on each port's DT
node; a port without all four is left as before, with a log line at
probe. The pins the sleep reset (PERST# among them) are put back first,
since ANS's driver may not have done it yet; apple_sleep_restore_pins()
does it once. A port this cannot bring back, or whose block stayed off,
has its downstream configuration access blocked and is logged. A port
brought back is reported to apple-s2r with apple_sleep_apcie_port_up(),
so the next sleep stops it again. The PCI core then restores the root
ports' and endpoints' configuration space as after any system sleep.

Nothing changes with the parameter off, for suspend-to-idle, or on any
host other than the T8132 built-in one.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/pci/controller/Kconfig      |   1 +
 drivers/pci/controller/pcie-apple.c | 268 +++++++++++++++++++++++++++-
 2 files changed, 268 insertions(+), 1 deletion(-)

diff --git a/drivers/pci/controller/Kconfig b/drivers/pci/controller/Kconfig
index a58abe6b19..61b943f6e5 100644
--- a/drivers/pci/controller/Kconfig
+++ b/drivers/pci/controller/Kconfig
@@ -70,6 +70,7 @@ config PCIE_APPLE
 	tristate "Apple PCIe controller"
 	depends on ARCH_APPLE || COMPILE_TEST
 	depends on APPLE_DART || !APPLE_DART
+	depends on APPLE_S2R || !APPLE_S2R
 	depends on OF
 	depends on PCI_MSI
 	depends on PAGE_SIZE_16KB || COMPILE_TEST
diff --git a/drivers/pci/controller/pcie-apple.c b/drivers/pci/controller/pcie-apple.c
index 67d4f3050e..b2ba1d3472 100644
--- a/drivers/pci/controller/pcie-apple.c
+++ b/drivers/pci/controller/pcie-apple.c
@@ -40,6 +40,7 @@
 #include <linux/rcupdate.h>
 #include <linux/reset.h>
 #include <linux/soc/apple/dart.h>
+#include <linux/soc/apple/sleep.h>
 #include <linux/soc/apple/t8132.h>
 #include <linux/soc/apple/tunable.h>
 #include <linux/suspend.h>
@@ -72,6 +73,15 @@ static int link_up_timeout = 500;
 module_param(link_up_timeout, int, 0644);
 MODULE_PARM_DESC(link_up_timeout, "PCIe link training timeout in milliseconds");
 
+static bool t8132_port_restart;
+module_param(t8132_port_restart, bool, 0644);
+MODULE_PARM_DESC(t8132_port_restart,
+		 "Set the T8132 built-in host's root ports up again after a deep sleep cut their power (default off)");
+
+/* A T8132 built-in root port's own tables, and the DesignWare words kept over a deep sleep. */
+#define APPLE_PCIE_T8132_TABLES		4
+#define APPLE_PCIE_T8132_DBI		5
+
 /* T8103 (original M1) and related SoCs */
 #define CORE_RC_PHYIF_CTL		0x00024
 #define   CORE_RC_PHYIF_CTL_RUN		BIT(0)
@@ -541,6 +551,11 @@ struct apple_pcie_port {
 	void __iomem		*intr2axi;	/* adopt_link: this port's */
 	u8			adopted_bus;	/* adopt_link: the secondary bus */
 	unsigned long		adopted_slots;	/* adopt_link: RID2SID slots routed (slot == SID) */
+	/* T8132 built-in host: what a restart after a deep sleep needs. */
+	struct apple_tunable	*restart_tun[APPLE_PCIE_T8132_TABLES];
+	u32			saved_dbi[APPLE_PCIE_T8132_DBI];
+	bool			restart_ok;
+	bool			restart_saved;
 };
 
 static int apple_pcie_managed_admit(struct apple_pcie_port *port);
@@ -2508,6 +2523,49 @@ static int apple_pcie_port_reset_endpoint(struct apple_pcie *pcie,
 					  stat & PORT_STATUS_READY, 100, 250000);
 }
 
+static const char * const apple_pcie_t8132_tables[APPLE_PCIE_T8132_TABLES] = {
+	"apple,tunable-port", "apple,tunable-rc", "apple,tunable-rc-gen3", "apple,tunable-rc-gen4",
+};
+
+/*
+ * A T8132 built-in root port's own tables, which the boot loader applied once from the ADT and
+ * publishes on the port's node (m1n1: the port's window, then its slice of the config window).
+ * Without all four, or without room for the boot loader's port setup, the port stays down after
+ * a deep sleep, as before.
+ */
+static void apple_pcie_t8132_restart_tables(struct apple_pcie *pcie,
+					    struct apple_pcie_port *port)
+{
+	struct platform_device *platform = to_platform_device(pcie->dev);
+	struct resource *res, *cfg, slice;
+	char name[16];
+	int i;
+
+	if (pcie->hw != &t602x_hw || pcie->managed_sids ||
+	    !of_device_is_compatible(pcie->dev->of_node, "apple,t8132-pcie"))
+		return;
+	snprintf(name, sizeof(name), "port%d", port->idx);
+	res = platform_get_resource_byname(platform, IORESOURCE_MEM, name);
+	cfg = platform_get_resource_byname(platform, IORESOURCE_MEM, "config");
+	if (!res || !cfg || resource_size(res) < SZ_16K ||
+	    resource_size(cfg) < ((resource_size_t)port->idx + 1) * SZ_32K)
+		return;
+	slice = DEFINE_RES_MEM(cfg->start + (resource_size_t)port->idx * SZ_32K, SZ_32K);
+	for (i = 0; i < APPLE_PCIE_T8132_TABLES; i++) {
+		struct apple_tunable *t;
+
+		t = devm_apple_tunable_parse(pcie->dev, port->np, apple_pcie_t8132_tables[i],
+					     i ? &slice : res);
+		if (IS_ERR(t)) {
+			dev_info(pcie->dev, "port %pOF: no %s (%pe), no restart after a deep sleep\n",
+				 port->np, apple_pcie_t8132_tables[i], t);
+			return;
+		}
+		port->restart_tun[i] = t;
+	}
+	port->restart_ok = true;
+}
+
 static int apple_pcie_setup_port(struct apple_pcie *pcie,
 				 struct device_node *np)
 {
@@ -2593,6 +2651,7 @@ static int apple_pcie_setup_port(struct apple_pcie *pcie,
 			port->phy = NULL;
 			goto err_teardown;
 		}
+		apple_pcie_t8132_restart_tables(pcie, port);
 	}
 	if (pcie->hw->tunneled) {
 		bool preinit_ok;
@@ -4912,6 +4971,210 @@ static int apple_pcie_check_adopted_s2idle(struct apple_pcie *pcie)
 	return error;
 }
 
+/*
+ * The T8132 built-in host after a deep sleep (pcie_apple.t8132_port_restart, default off).
+ *
+ * A T8132 suspend-to-RAM powers ANS's APCIe block down and, before any device resumes, back up
+ * (apple-s2r). The block returns with the root ports it stopped left down: the Wi-Fi/Bluetooth
+ * radio's (port 0) and the J604 SD card reader's (port 2). Everything the boot loader set up per
+ * port is gone. For each port the sleep left down this puts back:
+ * - the boot loader's port setup: its fixed register values, the port's own table, the
+ *   application clock, the port PHY's two reference clocks and its release from reset, the port
+ *   released and idle (SOURCE m1n1 src/pcie.c, the T8122-compatible path the T8132 takes);
+ * - the root port's DesignWare registers: its three tables, then the link capability and control
+ *   words the boot loader set from the ADT, as read before the sleep;
+ * - what probe did then: the endpoint reset with probe's timing, the clock gating, the port's MSI
+ *   routing, the RID-to-SID entries and interrupt mask read before the sleep, and link training
+ *   with probe's endpoint-reset retries.
+ * The PCI core then restores the root ports' and endpoints' configuration space as after any
+ * system sleep. A port this cannot bring back, or whose block stayed off, stays down with its
+ * downstream configuration access blocked.
+ */
+#define APPLE_PCIE_T8132_EXP		0x70	/* the root port's PCIe capability */
+#define DWC_PORT_LINK_CONTROL		0x710
+#define DWC_LINK_WIDTH_SPEED_CONTROL	0x80c
+#define DWC_DBI_RO_WR			0x8bc
+#define   DWC_DBI_RO_WR_EN		BIT(0)
+
+static const u32 apple_pcie_t8132_dbi[APPLE_PCIE_T8132_DBI] = {
+	APPLE_PCIE_T8132_EXP + PCI_EXP_LNKCAP,
+	APPLE_PCIE_T8132_EXP + PCI_EXP_LNKCAP2,
+	APPLE_PCIE_T8132_EXP + PCI_EXP_LNKCTL2,	/* 16 bits */
+	DWC_PORT_LINK_CONTROL,
+	DWC_LINK_WIDTH_SPEED_CONTROL,
+};
+
+struct apple_pcie_reg_val {
+	u16 off;
+	u32 val;
+};
+
+/* m1n1's values, in its order: before the RID-to-SID and MSI map clears, and after. */
+static const struct apple_pcie_reg_val apple_pcie_t8132_port_init[] = {
+	{ 0x088, 0x110 }, { 0x100, 0xffffffff }, { 0x148, 0xffffffff }, { 0x210, 0xffffffff },
+	{ 0x080, 0 }, { 0x084, 0 }, { 0x104, 0xfffffff0 }, { 0x124, 0x100 }, { 0x16c, 0 },
+	{ 0x13c, 0x10 }, { 0x800, 0x100100 }, { 0x808, 0x1000ff }, { 0x82c, 0 },
+};
+
+static const struct apple_pcie_reg_val apple_pcie_t8132_port_init2[] = {
+	{ 0x130, 0x3000000 }, { 0x140, 0x10 }, { 0x144, 0x253770 }, { 0x21c, 0 }, { 0x834, 0 },
+	{ 0x83c, 0 },
+};
+
+/* Before the sleep, with the block still powered. */
+static void apple_pcie_t8132_save(struct apple_pcie *pcie)
+{
+	struct apple_pcie_port *port;
+	int i;
+
+	list_for_each_entry(port, &pcie->ports, entry) {
+		void __iomem *dbi = pcie->cfg->win + (port->idx << 15);
+
+		port->restart_saved = false;
+		/* A port an earlier sleep left down has registers that abort. */
+		if (!READ_ONCE(t8132_port_restart) || !pm_suspend_via_firmware() ||
+		    !port->restart_ok || !port->perst || READ_ONCE(port->link_failed) ||
+		    apple_sleep_apcie_port_down(port->idx))
+			continue;
+		for (i = 0; i < APPLE_PCIE_T8132_DBI; i++)
+			port->saved_dbi[i] = readl_relaxed(dbi + apple_pcie_t8132_dbi[i]);
+		for_each_set_bit(i, port->sid_map, port->sid_map_sz)
+			port->saved_rid2sid[i] =
+				apple_pcie_port_readl(port, port_rid2sid_offset(port, i));
+		port->saved_intmask = apple_pcie_port_readl(port, PORT_INTMSK);
+		port->restart_saved = true;
+	}
+}
+
+static int apple_pcie_t8132_port_setup(struct apple_pcie *pcie, struct apple_pcie_port *port)
+{
+	void __iomem *dbi = pcie->cfg->win + (port->idx << 15);
+	void __iomem *phy = port->phy + PHY_LANE_CFG;
+	int attempt, i, ret;
+	u32 stat;
+
+	for (i = 0; i < ARRAY_SIZE(apple_pcie_t8132_port_init); i++)
+		apple_pcie_port_writel(port, apple_pcie_t8132_port_init[i].val,
+				       apple_pcie_t8132_port_init[i].off);
+	for (i = 0; i < 16; i++)
+		apple_pcie_port_writel(port, 0, PORT_T602X_RID2SID + 4 * i);
+	for (i = 0; i < 512; i++)
+		apple_pcie_port_writel(port, 0, PORT_T602X_MSIMAP + 4 * i);
+	for (i = 0; i < ARRAY_SIZE(apple_pcie_t8132_port_init2); i++)
+		apple_pcie_port_writel(port, apple_pcie_t8132_port_init2[i].val,
+				       apple_pcie_t8132_port_init2[i].off);
+	apple_tunable_apply(port->base, port->restart_tun[0]);
+	apple_pcie_port_rmw_set(port, PORT_APPCLK_EN, PORT_APPCLK);
+
+	/* Both reference clocks, then the PHY out of reset and its two clock enables, in order. */
+	rmw_clear(PHY_LANE_CFG_REFCLK0REQ | PHY_LANE_CFG_REFCLK1REQ, phy);
+	rmw_set(PHY_LANE_CFG_REFCLK0REQ, phy);
+	ret = readl_relaxed_poll_timeout(phy, stat, stat & PHY_LANE_CFG_REFCLK0ACK, 100, 50000);
+	if (ret)
+		return ret;
+	rmw_set(PHY_LANE_CFG_REFCLK1REQ, phy);
+	ret = readl_relaxed_poll_timeout(phy, stat, stat & PHY_LANE_CFG_REFCLK1ACK, 100, 50000);
+	if (ret)
+		return ret;
+	rmw_clear(PHY_LANE_CFG_REFBUF_OFF, phy);
+	rmw_set(BIT(9), phy);
+	rmw_set(BIT(10), phy);
+
+	apple_pcie_port_rmw_set(port, PORT_PERST_OFF, pcie->hw->port_perst);
+	ret = readl_relaxed_poll_timeout(port->base + PORT_STATUS, stat,
+					 stat & PORT_STATUS_READY, 100, 250000);
+	if (ret)
+		return ret;
+	ret = readl_relaxed_poll_timeout(port->base + PORT_LINKSTS, stat,
+					 !(stat & PORT_LINKSTS_BUSY), 100, 250000);
+	if (ret)
+		return ret;
+
+	rmw_set(DWC_DBI_RO_WR_EN, dbi + DWC_DBI_RO_WR);
+	for (i = 1; i < APPLE_PCIE_T8132_TABLES; i++)
+		apple_tunable_apply(dbi, port->restart_tun[i]);
+	for (i = 0; i < APPLE_PCIE_T8132_DBI; i++) {
+		if (apple_pcie_t8132_dbi[i] == APPLE_PCIE_T8132_EXP + PCI_EXP_LNKCTL2)
+			writew_relaxed(port->saved_dbi[i], dbi + apple_pcie_t8132_dbi[i]);
+		else
+			writel_relaxed(port->saved_dbi[i], dbi + apple_pcie_t8132_dbi[i]);
+	}
+	rmw_clear(DWC_DBI_RO_WR_EN, dbi + DWC_DBI_RO_WR);
+
+	/* From here as at probe: apple_pcie_setup_link() and apple_pcie_setup_port(). */
+	ret = apple_pcie_port_reset_endpoint(pcie, port);
+	if (ret)
+		return ret;
+	rmw_set(PHY_LANE_CFG_REFCLKCGEN, phy);
+	apple_pcie_port_rmw_clear(port, PORT_APPCLK_CGDIS, PORT_APPCLK);
+	apple_pcie_tunnel_restore_irq_hw(port);
+	for_each_set_bit(i, port->sid_map, port->sid_map_sz)
+		apple_pcie_rid2sid_write(port, i, port->saved_rid2sid[i]);
+
+	for (attempt = 0; ; attempt++) {
+		apple_pcie_port_writel(port, PORT_LTSSMCTL_START, PORT_LTSSMCTL);
+		ret = readl_relaxed_poll_timeout(port->base + PORT_LINKSTS, stat,
+						 stat & PORT_LINKSTS_UP, 1000,
+						 link_up_timeout * USEC_PER_MSEC);
+		if (!ret || attempt == LINK_RESET_RETRIES)
+			break;
+		dev_info(pcie->dev, "%pOF link down after %dms (LTSSM %#x), resetting the endpoint\n",
+			 port->np, link_up_timeout, apple_pcie_port_ltssm(pcie, port));
+		ret = apple_pcie_port_reset_endpoint(pcie, port);
+		if (ret)
+			return ret;
+	}
+	if (ret) {
+		dev_warn(pcie->dev, "%pOF link didn't come up after the sleep (LTSSM %#x)\n",
+			 port->np, apple_pcie_port_ltssm(pcie, port));
+		return ret;
+	}
+
+	/* The link-up event of the training is not one to report. */
+	apple_pcie_port_writel(port, ~0, PORT_INTSTAT);
+	/* The port helper uses a relaxed MMIO write: clear before unmasking. */
+	wmb();
+	apple_pcie_port_writel(port, port->saved_intmask, PORT_INTMSK);
+	stat = readw_relaxed(dbi + APPLE_PCIE_T8132_EXP + PCI_EXP_LNKSTA);
+	dev_info(pcie->dev, "port %pOF set up again after the sleep: link up, gen %u x%u, %d endpoint resets\n",
+		 port->np, (u32)FIELD_GET(PCI_EXP_LNKSTA_CLS, stat),
+		 (u32)FIELD_GET(PCI_EXP_LNKSTA_NLW, stat), attempt);
+	return 0;
+}
+
+static void apple_pcie_t8132_restart(struct apple_pcie *pcie)
+{
+	struct apple_pcie_port *port;
+	int down, ret;
+
+	list_for_each_entry(port, &pcie->ports, entry) {
+		if (!port->restart_saved)
+			continue;
+		port->restart_saved = false;
+		if (!pm_resume_via_firmware())
+			continue;
+		down = apple_sleep_apcie_port_down(port->idx);
+		if (!down)
+			continue;
+		if (down < 0) {
+			WRITE_ONCE(port->link_failed, true);
+			dev_err(pcie->dev, "port %pOF: its APCIe block stayed off after the sleep: %d\n",
+				port->np, down);
+			continue;
+		}
+		/* PERST# is a pin the sleep reset; ANS's driver may not have put it back yet. */
+		apple_sleep_restore_pins();
+		ret = apple_pcie_t8132_port_setup(pcie, port);
+		if (ret) {
+			WRITE_ONCE(port->link_failed, true);
+			dev_err(pcie->dev, "port %pOF: restart after the sleep failed: %d\n",
+				port->np, ret);
+			continue;
+		}
+		apple_sleep_apcie_port_up(port->idx);
+	}
+}
+
 static int apple_pcie_suspend_noirq(struct device *dev)
 {
 	struct apple_pcie *pcie = apple_pcie_lookup(dev);
@@ -4929,6 +5192,7 @@ static int apple_pcie_suspend_noirq(struct device *dev)
 		return ret;
 	}
 	if (!pcie->hw->tunneled) {
+		apple_pcie_t8132_save(pcie);
 		if (pm_suspend_no_platform() && pcie->num_pds)
 			return apple_pcie_hold_domains(pcie);
 		return 0;
@@ -5002,8 +5266,10 @@ static int apple_pcie_resume_noirq(struct device *dev)
 		}
 		return ret;
 	}
-	if (!pcie->hw->tunneled)
+	if (!pcie->hw->tunneled) {
+		apple_pcie_t8132_restart(pcie);
 		return 0;
+	}
 	if (pcie->resume_failed)
 		return -EIO;
 	/*
