diff --git a/drivers/gpu/drm/asahi/g16/winscan.rs b/drivers/gpu/drm/asahi/g16/winscan.rs
new file mode 100644
index 0000000000..f756c9952c
--- /dev/null
+++ b/drivers/gpu/drm/asahi/g16/winscan.rs
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! `g16_window_check_n`: which linked shared-L2 words one host-window check reads. Core only.
+//!
+//! The shared L2 of the 64 GiB host window has one entry per 32 MiB. An entry is linked the
+//! first time anything is mapped in its 32 MiB and is never unlinked (its L3 table is never
+//! freed), so the number of linked entries is the most host-window VA a boot has ever used:
+//! it grows with every client mix and never shrinks. Each window check (every poll pass and
+//! every submission) reads every linked entry back. With a budget N, a check reads N of them
+//! round robin, so its cost no longer grows with the boot's history, and every linked entry
+//! is still read at least once every ceil(linked / N) checks.
+
+use core::ops::Range;
+use core::sync::atomic::{AtomicU64, Ordering};
+
+/// Writes the indices of the nonzero entries of `image` into `out`, in index order, and
+/// returns how many were written (at most `out.len()`).
+pub(crate) fn collect(image: &[u64], out: &mut [u16]) -> usize {
+    let mut n = 0;
+    for (i, &e) in image.iter().enumerate() {
+        if e != 0 && n < out.len() {
+            out[n] = i as u16;
+            n += 1;
+        }
+    }
+    n
+}
+
+/// The positions in a list of `len` linked entries that one check reads, as two ranges (the
+/// second one when the batch wraps), and the cursor after it. A budget of 0, or one not
+/// smaller than `len`, reads all of them and leaves the cursor at 0.
+pub(crate) fn batch(len: usize, cursor: usize, budget: usize) -> ([Range<usize>; 2], usize) {
+    if budget == 0 || budget >= len {
+        return ([0..len, 0..0], 0);
+    }
+    let start = cursor % len;
+    let end = start + budget;
+    if end <= len {
+        ([start..end, 0..0], end % len)
+    } else {
+        ([start..len, 0..end - len], end - len)
+    }
+}
+
+/// [0] window checks made with a budget, [1] shared-L2 words they read.
+pub(crate) static WINDOW_N: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+
+pub(crate) fn note(words: usize) {
+    WINDOW_N[0].fetch_add(1, Ordering::Relaxed);
+    WINDOW_N[1].fetch_add(words as u64, Ordering::Relaxed);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn positions(r: &[Range<usize>; 2]) -> Vec<usize> {
+        r[0].clone().chain(r[1].clone()).collect()
+    }
+
+    #[test]
+    fn collect_lists_linked_entries_in_order() {
+        let mut image = vec![0u64; 2048];
+        for i in [3usize, 4, 100, 2047] {
+            image[i] = 0x1000 * i as u64 | 3;
+        }
+        let mut out = vec![0u16; 2048];
+        let n = collect(&image, &mut out);
+        assert_eq!(&out[..n], &[3, 4, 100, 2047]);
+        let mut short = [0u16; 2];
+        assert_eq!(collect(&image, &mut short), 2);
+        assert_eq!(short, [3, 4]);
+        assert_eq!(collect(&[0u64; 16], &mut out), 0);
+    }
+
+    #[test]
+    fn budget_zero_or_large_reads_everything() {
+        for (len, budget) in [(0, 0), (7, 0), (7, 7), (7, 100), (0, 5)] {
+            let (r, next) = batch(len, 3, budget);
+            assert_eq!(positions(&r), (0..len).collect::<Vec<_>>(), "len {len} budget {budget}");
+            assert_eq!(next, 0);
+        }
+    }
+
+    #[test]
+    fn every_entry_within_ceil_len_over_budget_checks() {
+        for len in 1..70usize {
+            for budget in 1..len {
+                for start in 0..len {
+                    let mut seen = vec![0u32; len];
+                    let mut cursor = start;
+                    for _ in 0..len.div_ceil(budget) {
+                        let (r, next) = batch(len, cursor, budget);
+                        let p = positions(&r);
+                        assert_eq!(p.len(), budget);
+                        for x in p {
+                            seen[x] += 1;
+                        }
+                        cursor = next;
+                    }
+                    let all = seen.iter().all(|&s| s >= 1);
+                    assert!(all, "len {len} budget {budget} start {start}");
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn a_grown_list_keeps_the_cursor_in_range() {
+        // The list grew from 10 to 12 entries between checks: the old cursor stays valid.
+        let (r, next) = batch(12, 9, 4);
+        assert_eq!(positions(&r), vec![9, 10, 11, 0]);
+        assert_eq!(next, 1);
+        // A cursor past the end (the list was rebuilt shorter) wraps instead of indexing out.
+        let (r, _) = batch(5, 9, 2);
+        assert_eq!(positions(&r), vec![4, 0]);
+    }
+
+    #[test]
+    fn counters() {
+        let before = WINDOW_N[1].load(Ordering::Relaxed);
+        note(8);
+        assert_eq!(WINDOW_N[1].load(Ordering::Relaxed), before + 8);
+    }
+}
