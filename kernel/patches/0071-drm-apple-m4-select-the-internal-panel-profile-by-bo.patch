From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 4 Nov 2026 05:25:39 -0600
Subject: [PATCH] drm/apple: m4: select the internal panel profile by board

The firmware 26.6.2 backend has one panel profile, for the MacBook Air
(13-inch, M4), and keeps the rest of that board's panel in code: the
machine and firmware UUID it admits, the 64 notch rows of the boot
console, the exact timing element it accepts and the mode it derives
from it, and the 500 and 120 nits backlight limits.

Move all of these into the profile and turn the profile into a table of
board records, the way the v14.7 backend picks its board record
(dcp_v14_board_select() and iomfb_v14_7_board() in iomfb_v14_7.c).
iomfb_m4_init() now selects the record whose machine compatible and
firmware UUID match, and refuses with "no board record for this
machine" otherwise. The mode is derived from the record's timing
attributes, so the J713 still gets 2560x1664 with the same sync,
totals, clock and refresh as before.

The only record is still the J713 and its values are unchanged, so
nothing changes on any machine.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
[dylan: conflict with aurora a150a02ca3 ("drm/apple: m4: Cache a static
 frame while nothing is flipping", tier-c 4e04221eb7), which adds
 swap_intent to the J713 profile. The J713 board record in iomfb_m4.c
 carries it unchanged (.swap_intent = 0x17c); every other J713 value is
 as before.]
---
 drivers/gpu/drm/apple/dcp-m4-frame.h   |  3 +-
 drivers/gpu/drm/apple/dcp-m4-profile.h | 34 +++++++------
 drivers/gpu/drm/apple/dcp-m4-timing.h  | 20 ++++----
 drivers/gpu/drm/apple/iomfb_m4.c       | 67 +++++++++++++++++++++-----
 4 files changed, 87 insertions(+), 37 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-m4-frame.h b/drivers/gpu/drm/apple/dcp-m4-frame.h
index cb84457f07..e822e2cc8b 100644
--- a/drivers/gpu/drm/apple/dcp-m4-frame.h
+++ b/drivers/gpu/drm/apple/dcp-m4-frame.h
@@ -199,7 +199,8 @@ static inline int dcp_m4_swap_encode_full(void *output, size_t length, u32 swap_
 	u8 *data = output;
 	u32 mask = 0;
 
-	if (length != DCP_M4_SWAP_SIZE || !swap_id || (brightness_change && nits > 500) ||
+	if (length != DCP_M4_SWAP_SIZE || !swap_id ||
+	    (brightness_change && nits > dcp_m4_pf->brightness_max) ||
 	    (!primary && !upper) || (keep & ~0xeU))
 		return -EINVAL;
 	if (primary && frame && check(frame))
diff --git a/drivers/gpu/drm/apple/dcp-m4-profile.h b/drivers/gpu/drm/apple/dcp-m4-profile.h
index 4cbed603d3..3cd83799ce 100644
--- a/drivers/gpu/drm/apple/dcp-m4-profile.h
+++ b/drivers/gpu/drm/apple/dcp-m4-profile.h
@@ -4,10 +4,17 @@
 
 #include <linux/types.h>
 
-/* Firmware 26.6.2 internal-panel ABI, qualified for the T8132/J713 handoff. */
+/*
+ * Firmware 26.6.2 internal-panel record of one board: the board and firmware
+ * it is qualified for, its panel and its first physical mode, and the swap
+ * ABI of that firmware.
+ */
 struct dcp_m4_profile {
 	const char *name;
+	const char *machine;		/* board compatible */
+	const char *firmware_uuid;	/* exact apple,firmware-uuid */
 	u32 panel_width, panel_height;
+	u32 notch_height;		/* rows a notchless boot console omits */
 	u32 boot_stride;		/* D101: inherited framebuffer stride */
 	u32 swap_size;			/* A407 input */
 	u32 swap_surface;		/* plane-0 surface */
@@ -22,21 +29,18 @@ struct dcp_m4_profile {
 	u16 open_method;		/* first client open */
 	u32 brightness_max, brightness_default;
 	u32 width_mm, height_mm;
+	/*
+	 * Exact Horizontal and VerticalAttributes of the preferred timing
+	 * element: Active, Total, FrontPorch, SyncWidth, BackPorch,
+	 * PreciseSyncRate (16.16), SyncPolarity, PixelRepetition.
+	 */
+	u32 timing[2][8];
 };
 
-static const struct dcp_m4_profile dcp_m4_profile_j713 = {
-	.name = "J713",
-	.panel_width = 2560, .panel_height = 1664, .boot_stride = 10240,
-	.swap_size = 0x1bd8, .swap_surface = 0x588, .swap_dva = 0xe38,
-	.swap_nullable = 0x1bcb, .swap_tail = 0x1bd6, .swap_nits = 0x35e,
-	.swap_intent = 0x17c,
-	.disabled_color = 0xff000000,
-	.done_method = 590, .done_size = 0x730, .open_method = 457,
-	.brightness_max = 500, .brightness_default = 120,
-	.width_mm = 0, .height_mm = 0,
-};
-
-/* This generation backend admits one qualified internal-panel ABI. */
-static const struct dcp_m4_profile *const dcp_m4_pf = &dcp_m4_profile_j713;
+/*
+ * The record of the running board, chosen once by iomfb_m4_init() before any
+ * firmware session exists. A machine has at most one internal DCP.
+ */
+extern const struct dcp_m4_profile *dcp_m4_pf;
 
 #endif
diff --git a/drivers/gpu/drm/apple/dcp-m4-timing.h b/drivers/gpu/drm/apple/dcp-m4-timing.h
index e85908b659..a15f7c3522 100644
--- a/drivers/gpu/drm/apple/dcp-m4-timing.h
+++ b/drivers/gpu/drm/apple/dcp-m4-timing.h
@@ -12,7 +12,7 @@
 
 #define DCP_M4_TIMING_TOKENS 2048
 
-/* The first qualified J713 physical mode, not a generic panel-mode fallback. */
+/* The board's first qualified physical mode, not a generic panel-mode fallback. */
 struct dcp_m4_timing {
 	u32 id, color_id;
 	u32 hdisplay, hsync_start, hsync_end, htotal;
@@ -148,16 +148,13 @@ static inline int dcp_m4_timing_axis(const struct dcp_m4_timing_parser *p,
 		"Active", "Total", "FrontPorch", "SyncWidth", "BackPorch", "PreciseSyncRate",
 		"SyncPolarity", "PixelRepetition",
 	};
-	static const u32 values[2][8] = {
-		{ 2560, 2640, 8, 32, 40, 6877358, 1, 0 },
-		{ 1664, 1749, 33, 8, 44, 3932166, 1, 0 },
-	};
+	const u32 *values = dcp_m4_pf->timing[vertical];
 	int axis = dcp_m4_timing_field(p, mode, name, 1);
 
 	if (axis < 0)
 		return axis;
 	for (unsigned int i = 0; i < 8; i++)
-		if (!dcp_m4_timing_equals(p, axis, fields[i], 4, values[vertical][i]))
+		if (!dcp_m4_timing_equals(p, axis, fields[i], 4, values[i]))
 			return -EINVAL;
 	/* Exact qualified values also establish active + porches + sync == total. */
 	return 0;
@@ -166,6 +163,7 @@ static inline int dcp_m4_timing_axis(const struct dcp_m4_timing_parser *p,
 static inline int dcp_m4_parse_timing(const void *data, size_t size, struct dcp_m4_timing *out)
 {
 	struct dcp_m4_timing_parser *p;
+	const u32 *h = dcp_m4_pf->timing[0], *v = dcp_m4_pf->timing[1];
 	static const char * const color_fields[] = {
 		"ID", "Depth", "PixelEncoding", "DynamicRange", "EOTF", "Colorimetry", "SupportsDSC",
 	};
@@ -209,10 +207,12 @@ static inline int dcp_m4_parse_timing(const void *data, size_t size, struct dcp_
 			goto done;
 	*out = (struct dcp_m4_timing) {
 		.id = 2, .color_id = 1,
-		.hdisplay = 2560, .hsync_start = 2568, .hsync_end = 2600, .htotal = 2640,
-		.vdisplay = 1664, .vsync_start = 1697, .vsync_end = 1705, .vtotal = 1749,
-		.clock_khz = ((2640ULL * 1749 * 3932166 >> 16) + 500) / 1000,
-		.refresh_16_16 = 3932166,
+		.hdisplay = h[0], .hsync_start = h[0] + h[2],
+		.hsync_end = h[0] + h[2] + h[3], .htotal = h[1],
+		.vdisplay = v[0], .vsync_start = v[0] + v[2],
+		.vsync_end = v[0] + v[2] + v[3], .vtotal = v[1],
+		.clock_khz = (((u64)h[1] * v[1] * v[5] >> 16) + 500) / 1000,
+		.refresh_16_16 = v[5],
 	};
 	ret = 0;
 done:
diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index d11e640b76..6fec59f6ca 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-only OR MIT
 /*
- * Apple DCP firmware 26.6.2 (T8132/J713).
+ * Apple DCP firmware 26.6.2 (T8132 internal panel, per-board records).
  *
  * The appledrm component and KMS paths own this controller.  This backend owns
  * only its generation-specific EP37 RPC ABI and retained firmware session.
@@ -45,6 +45,49 @@
 #include "dcp-m4-timing.h"
 #include "dcp-m4-memory.h"
 #include "dcp-m4-callback.h"
+
+/*
+ * One record per board whose loader hands over the running internal panel.
+ * A board without a record keeps its boot framebuffer.
+ */
+static const struct dcp_m4_profile dcp_m4_profiles[] = {
+	{
+		.name = "J713",
+		.machine = "apple,j713",
+		.firmware_uuid = "81BAF476-679D-3CC0-8C6A-E6B6FA659D5E",
+		.panel_width = 2560, .panel_height = 1664, .notch_height = 64,
+		.boot_stride = 10240,
+		.swap_size = 0x1bd8, .swap_surface = 0x588, .swap_dva = 0xe38,
+		.swap_nullable = 0x1bcb, .swap_tail = 0x1bd6, .swap_nits = 0x35e,
+		.swap_intent = 0x17c,
+		.disabled_color = 0xff000000,
+		.done_method = 590, .done_size = 0x730, .open_method = 457,
+		.brightness_max = 500, .brightness_default = 120,
+		.width_mm = 0, .height_mm = 0,
+		.timing = {
+			{ 2560, 2640, 8, 32, 40, 6877358, 1, 0 },
+			{ 1664, 1749, 33, 8, 44, 3932166, 1, 0 },
+		},
+	},
+};
+
+const struct dcp_m4_profile *dcp_m4_pf __read_mostly = &dcp_m4_profiles[0];
+
+static const struct dcp_m4_profile *dcp_m4_profile_select(struct device *dev)
+{
+	const char *uuid;
+
+	if (of_property_read_string(dev->of_node, "apple,firmware-uuid", &uuid))
+		return NULL;
+	for (unsigned int i = 0; i < ARRAY_SIZE(dcp_m4_profiles); i++) {
+		const struct dcp_m4_profile *pf = &dcp_m4_profiles[i];
+
+		if (of_machine_is_compatible(pf->machine) &&
+		    !strcmp(uuid, pf->firmware_uuid))
+			return pf;
+	}
+	return NULL;
+}
 #include "dcp-m4-property.h"
 #include "dcp-m4-frame.h"
 
@@ -934,17 +977,17 @@ static int dcp_m4_boot_framebuffer_check(void)
 		if (!of_device_is_available(np))
 			continue;
 		found++;
-		/* The inherited console may exclude the notch (64 lines on J713). */
+		/* The inherited console may exclude the notch rows. */
 		if (of_property_read_u32(np, "width", &width) ||
 		    of_property_read_u32(np, "height", &height) ||
 		    of_property_read_u32(np, "stride", &stride) ||
 		    width != dcp_m4_pf->panel_width || stride != dcp_m4_pf->boot_stride ||
 		    (height != dcp_m4_pf->panel_height &&
-		     height != dcp_m4_pf->panel_height - 64)) {
+		     height != dcp_m4_pf->panel_height - dcp_m4_pf->notch_height)) {
 			of_node_put(np);
 			return -EINVAL;
 		}
-		/* The inherited console can exclude the 64-line notch region. */
+		/* The inherited console can exclude the notch region. */
 		ret = 0;
 	}
 	return found > 1 ? -EINVAL : ret;
@@ -1132,18 +1175,19 @@ int iomfb_m4_init(struct apple_dcp *owner)
 {
 	struct platform_device *pdev = to_platform_device(owner->dev);
 	struct device *dev = owner->dev;
+	const struct dcp_m4_profile *pf;
 	struct iomfb_m4 *dcp;
 	struct resource *res;
-	const char *uuid;
 	int ret;
 
-	if (!of_machine_is_compatible("apple,j713") ||
-	    !of_device_is_compatible(dev->of_node, "apple,t8132-dcp") ||
+	pf = dcp_m4_profile_select(dev);
+	if (!pf)
+		return dev_err_probe(dev, -ENODEV, "no board record for this machine\n");
+	if (!of_device_is_compatible(dev->of_node, "apple,t8132-dcp") ||
 	    !iomfb_m4_firmware_property(dev->of_node, "apple,firmware-version") ||
-	    !iomfb_m4_firmware_property(dev->of_node, "apple,firmware-compat") ||
-	    of_property_read_string(dev->of_node, "apple,firmware-uuid", &uuid) ||
-	    strcmp(uuid, "81BAF476-679D-3CC0-8C6A-E6B6FA659D5E"))
+	    !iomfb_m4_firmware_property(dev->of_node, "apple,firmware-compat"))
 		return dev_err_probe(dev, -ENODEV, "unqualified firmware 26.6.2 handoff\n");
+	dcp_m4_pf = pf;
 	ret = dcp_m4_dart_check(dev);
 	if (ret)
 		return dev_err_probe(dev, ret, "inherited SID23 domain not qualified\n");
@@ -1657,7 +1701,8 @@ void iomfb_m4_configure_backlight(struct apple_dcp *owner)
 
 	if (dcp_backlight_active(owner))
 		return;
-	ret = dcp_backlight_configure(owner, 500, false, 0, true, 120,
+	ret = dcp_backlight_configure(owner, dcp_m4_pf->brightness_max, false, 0,
+				      true, dcp_m4_pf->brightness_default,
 				      iomfb_m4_backlight_kick);
 	if (ret && ret != -EBUSY)
 		dev_err(owner->dev, "firmware 26.6.2 backlight unavailable: %d\n", ret);
