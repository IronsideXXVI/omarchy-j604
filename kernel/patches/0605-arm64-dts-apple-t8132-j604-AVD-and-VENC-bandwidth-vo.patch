From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 20:11:31 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: AVD and VENC bandwidth
 votes

Give the AVD's PMP report entry the memory bandwidth vote macOS writes
for a decode (level 19) and the video encoder's the one it holds while
encoding (18), so that the vote is raised while each runs and lowered
when it idles.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index 71df651078..e08093a8c0 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -1471,6 +1471,14 @@ pmp_report_avd_sys: report@14 {
 		 */
 		power-domains = <&ps_avd_sys>, <&pmp_report_msr>;
 		apple,dvfs = <418 2>;
+		/*
+		 * The memory bandwidth vote macOS writes to SOC-DEV-DVFS 409 +
+		 * 411 at the start of each flat-out decode (q-media-1: level 19
+		 * for HEVC 10-bit and H.264, 18 for AV1). Without it a 4K 10-bit
+		 * frame takes 0.42 ms longer here than on macOS, which pays
+		 * nothing for 10-bit on the same SoC.
+		 */
+		apple,bw-vote = <19>;
 		apple,no-ack;
 	};
 
@@ -1487,6 +1495,8 @@ pmp_report_venc_sys: report@13 {
 		#power-domain-cells = <0>;
 		power-domains = <&ps_venc_sys>, <&pmc_soc_max>;
 		apple,dvfs = <417 2>;
+		/* macOS holds 409 + 411 at main level 0x12 while it encodes. */
+		apple,bw-vote = <18>;
 		apple,no-ack;
 	};
 
-- 
