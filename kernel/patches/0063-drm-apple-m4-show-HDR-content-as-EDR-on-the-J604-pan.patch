diff --git a/drivers/gpu/drm/apple/dcp-m4-edr.h b/drivers/gpu/drm/apple/dcp-m4-edr.h
new file mode 100644
index 0000000000..d9efa31803
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-edr.h
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * EDR on the internal panel of the T8132 backend (firmware 26.6.2): the swap
+ * words and the per-swap headroom, as the desktop 26.x driver drives them
+ * (Aurora's dcp_edr_prepare(), ae07fd5bb6 / 7e6b33aa91 / 43f112d09a).  The
+ * 26.6.2 A407 record opens with the desktop 26.x dcp_swap layout (0x588 bytes,
+ * then the surfaces; dcp-m4-frame.h), so the words sit at its offsets.
+ *
+ * With applied headroom H (x1000), a swap asks for brightness SDR white x H,
+ * display EDR scale 1 / H and, while the frame uses EDR, headroom used H; the
+ * firmware shows a PQ surface at (PQ nits / 100) x the scale x the panel level,
+ * so PQ 100 lands at SDR white and highlights reach the panel peak.  H rises
+ * one step per swap (dcp_edr_next()), never above the ADT potential headroom.
+ *
+ * Pure functions on a byte record, for the KUnit suite.
+ */
+#ifndef APPLE_DCP_M4_EDR_H
+#define APPLE_DCP_M4_EDR_H
+
+#include <linux/bits.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+
+#include "dcp-edr.h"
+
+#define DCP_M4_SWAP_BL_UPDATE		0x354	/* u8: the panel level is valid */
+#define DCP_M4_SWAP_BL_FLAGS		0x358	/* u8[6]: which of the words below */
+#define DCP_M4_SWAP_BL_NITS		0x35e	/* binary64: the panel level, nits */
+#define DCP_M4_SWAP_BL_LIMIT		0x376	/* binary64, bl_flags[1]: brightness limit */
+#define DCP_M4_SWAP_EDR_SCALE		0x37e	/* binary64, bl_flags[2]: SDR white / level */
+#define DCP_M4_SWAP_EDR_HEADROOM	0x3e6	/* binary64, bl_flags[4]: headroom used */
+
+/* The IOSurface colour tags of a surface record. */
+#define DCP_M4_SURFACE_XFER		0x13
+#define DCP_M4_SURFACE_PRIMARIES	0x14
+#define DCP_M4_XFER_SRGB		13
+#define DCP_M4_XFER_PQ			16
+#define DCP_M4_PRIMARIES_BT2020		9
+#define DCP_M4_PRIMARIES_P3_D65		12
+
+/* The highest panel level an EDR swap may ask for (PQ's own ceiling). */
+#define DCP_M4_EDR_MAX_NITS		10000U
+
+/* The binary64 nearest @num / @den, for small positive integers; 0 for 0. */
+static inline u64 dcp_m4_binary64_ratio(u64 num, u64 den)
+{
+	u64 mantissa = 0;
+	int exponent = 0;
+
+	if (!num || !den)
+		return 0;
+	while (num >= 2 * den) {
+		den <<= 1;
+		exponent++;
+	}
+	while (num < den) {
+		num <<= 1;
+		exponent--;
+	}
+	/* den <= num < 2 den: 53 quotient bits, then round to nearest */
+	for (unsigned int i = 0; i < 53; i++) {
+		mantissa <<= 1;
+		if (num >= den) {
+			mantissa |= 1;
+			num -= den;
+		}
+		num <<= 1;
+	}
+	if (num >= den && ++mantissa == 1ULL << 53) {
+		mantissa >>= 1;
+		exponent++;
+	}
+	return (u64)(exponent + 1023) << 52 | (mantissa & GENMASK_ULL(51, 0));
+}
+
+/* What one swap carries; 0 leaves a word out (the firmware keeps it). */
+struct dcp_m4_edr_words {
+	u32 nits;	/* the panel level: SDR white x hm / 1000 */
+	u32 hm;		/* applied headroom x1000: display EDR scale 1000 / hm */
+	u32 used;	/* headroom used x1000 */
+	u32 limit;	/* brightness limit x10, while the ramp runs */
+};
+
+struct dcp_m4_edr_state {
+	u32 hm;		/* applied headroom x1000; 0: none, the firmware's values */
+	u32 sdr;	/* SDR white of the last EDR swap */
+	bool sent;	/* swaps carry headroom used */
+	bool restart;	/* the next EDR ramp starts again from 1.0 */
+};
+
+/*
+ * dcp_edr_prepare() for one present.  @edr: the frame is BT.2020 PQ shown as
+ * EDR; @carries: the swap carries a new SDR white @sdr, otherwise @sdr is the
+ * level that stands.  Returns true with @w set when the swap carries words.
+ */
+static inline bool dcp_m4_edr_step(struct dcp_m4_edr_state *st, bool edr, bool carries,
+				   u32 sdr, u32 peak, u32 ceiling,
+				   struct dcp_m4_edr_words *w)
+{
+	u32 cur = st->hm ?: DCP_EDR_UNITY, target = DCP_EDR_UNITY, next, nits;
+	u32 prev_sdr = st->sdr;
+	bool restart = st->restart;
+
+	st->restart = false;
+	if (!edr && !st->hm)
+		return false;	/* no EDR, and none to wind down */
+	if (!sdr)
+		return false;	/* off: a swap that turns the panel off keeps its zero */
+	if (edr)
+		target = dcp_edr_target(peak, sdr, ceiling);
+	if (restart && edr) {
+		cur = DCP_EDR_UNITY;
+		prev_sdr = sdr;
+	}
+	st->sdr = sdr;
+	if (cur == target && !carries && !restart && st->sent == edr)
+		return false;
+
+	/* Up in steps; down at once (a still desktop may send no further swap). */
+	next = dcp_edr_next(cur, target, prev_sdr, sdr);
+	nits = min_t(u64, (u64)sdr * next / DCP_EDR_UNITY, DCP_M4_EDR_MAX_NITS);
+	*w = (struct dcp_m4_edr_words) { .nits = nits, .hm = next };
+	if (edr) {
+		w->used = next;
+		st->sent = true;
+	} else if (st->sent) {
+		w->used = DCP_EDR_UNITY;
+		st->sent = false;
+	}
+	if (next != target && next != cur)
+		w->limit = nits * 13;
+	/* Back at 1.0 without EDR: leave the firmware's values alone again. */
+	st->hm = (!edr && next == DCP_EDR_UNITY) ? 0 : next;
+	return true;
+}
+
+/* Write @w into an encoded swap record (after dcp_m4_swap_encode_full()). */
+static inline void dcp_m4_swap_set_edr(u8 *swap, const struct dcp_m4_edr_words *w)
+{
+	swap[DCP_M4_SWAP_BL_UPDATE] = 1;
+	put_unaligned_le64(dcp_m4_binary64_ratio(w->nits, 1), swap + DCP_M4_SWAP_BL_NITS);
+	swap[DCP_M4_SWAP_BL_FLAGS + 2] = 1;
+	put_unaligned_le64(dcp_m4_binary64_ratio(DCP_EDR_UNITY, w->hm),
+			   swap + DCP_M4_SWAP_EDR_SCALE);
+	if (w->used) {
+		swap[DCP_M4_SWAP_BL_FLAGS + 4] = 1;
+		put_unaligned_le64(dcp_m4_binary64_ratio(w->used, DCP_EDR_UNITY),
+				   swap + DCP_M4_SWAP_EDR_HEADROOM);
+	}
+	if (w->limit) {
+		swap[DCP_M4_SWAP_BL_FLAGS + 1] = 1;
+		put_unaligned_le64(dcp_m4_binary64_ratio(w->limit, 10),
+				   swap + DCP_M4_SWAP_BL_LIMIT);
+	}
+}
+
+#endif
