+	for_each_new_connector_in_state(commit, connector, state, i)
+		if (state->crtc == crtc)
+			conn_state = state;
+	if (!conn_state && owner->connector && owner->connector->base.state &&
+	    owner->connector->base.state->crtc == crtc)
+		conn_state = owner->connector->base.state;
+	return conn_state;
