diff --git a/drivers/gpu/drm/apple/dcp-panel-edid.c b/drivers/gpu/drm/apple/dcp-panel-edid.c
index 97eee16101..4554554e26 100644
--- a/drivers/gpu/drm/apple/dcp-panel-edid.c
+++ b/drivers/gpu/drm/apple/dcp-panel-edid.c
@@ -26,6 +26,7 @@
 #include <linux/ctype.h>
 #include <linux/errno.h>
 #include <linux/kernel.h>
+#include <linux/math64.h>
 #include <linux/minmax.h>
 #include <linux/slab.h>
 #include <linux/string.h>
@@ -327,20 +328,88 @@ int dcp_panel_edid_build(const struct dcp_panel_id *id, int width_mm, int height
 	return 0;
 }
 
+/* CTA-861.3 luminance code: 50 x 2^(cv / 32) cd/m2, the highest not above @nits. */
+static u8 cta_luminance(u32 nits)
+{
+	/* 1000 x 2^(i / 32) */
+	static const u16 frac[32] = {
+		1000, 1022, 1044, 1067, 1091, 1114, 1139, 1164, 1189, 1215, 1242,
+		1269, 1297, 1325, 1354, 1384, 1414, 1445, 1477, 1509, 1542, 1576,
+		1610, 1646, 1682, 1719, 1756, 1795, 1834, 1874, 1915, 1957,
+	};
+	u32 cv = 0;
+
+	while (cv < 255 && div_u64((50ULL * frac[(cv + 1) % 32]) << ((cv + 1) / 32), 1000) <= nits)
+		cv++;
+	return cv;
+}
+
+/*
+ * The CTA-861 extension of an HDR panel: a Colorimetry block with BT.2020
+ * RGB and an HDR Static Metadata block with the SDR and SMPTE ST 2084
+ * transfer functions, metadata type 1, the peak as maximum and maximum
+ * frame-average luminance, and no minimum (as Aurora's desktop 26.x panels).
+ */
+static void cta_hdr_block(u16 max_nits, u8 *ext)
+{
+	u8 *d = ext + 4, cv = cta_luminance(max_nits);
+
+	memset(ext, 0, EDID_LENGTH);
+	ext[0] = CEA_EXT;
+	ext[1] = 3;
+	/* Use extended tag 7, length 3: Colorimetry (5), BT2020_RGB, no metadata. */
+	d[0] = 7 << 5 | 3;
+	d[1] = 0x05;
+	d[2] = BIT(7);
+	d[3] = 0;
+	d += 4;
+	/* Extended tag 7, length 6: HDR Static Metadata (6). */
+	d[0] = 7 << 5 | 6;
+	d[1] = 0x06;
+	d[2] = BIT(0) | BIT(2);	/* traditional gamma SDR, SMPTE ST 2084 */
+	d[3] = BIT(0);		/* static metadata type 1 */
+	d[4] = cv;
+	d[5] = cv;
+	d[6] = 0;
+	d += 7;
+	/* No detailed timings: they would start where the data blocks end. */
+	ext[2] = d - ext;
+	checksum(ext, EDID_LENGTH);
+}
+
+int dcp_panel_edid_build_hdr(const struct dcp_panel_id *id, int width_mm, int height_mm,
+			     u8 edid[DCP_PANEL_EDID_HDR_BLOCKS * EDID_LENGTH])
+{
+	int ret;
+
+	if (!id->hdr_max_nits)
+		return -EINVAL;
+	ret = dcp_panel_edid_build(id, width_mm, height_mm, edid);
+	if (ret)
+		return ret;
+	((struct edid *)edid)->extensions = DCP_PANEL_EDID_HDR_BLOCKS - 1;
+	checksum(edid, EDID_LENGTH);
+	cta_hdr_block(id->hdr_max_nits, edid + 2 * EDID_LENGTH);
+	return 0;
+}
+
 int dcp_panel_edid_update(struct drm_connector *connector, const struct dcp_panel_id *id,
 			  int width_mm, int height_mm)
 {
+	size_t size = (id->hdr_max_nits ? DCP_PANEL_EDID_HDR_BLOCKS : DCP_PANEL_EDID_BLOCKS) *
+		      EDID_LENGTH;
 	const struct drm_edid *edid;
 	u8 *blocks;
 	int ret;
 
-	blocks = kmalloc(DCP_PANEL_EDID_BLOCKS * EDID_LENGTH, GFP_KERNEL);
+	blocks = kmalloc(DCP_PANEL_EDID_HDR_BLOCKS * EDID_LENGTH, GFP_KERNEL);
 	if (!blocks)
 		return -ENOMEM;
-	ret = dcp_panel_edid_build(id, width_mm, height_mm, blocks);
+	ret = id->hdr_max_nits ? dcp_panel_edid_build_hdr(id, width_mm, height_mm, blocks) :
+				 dcp_panel_edid_build(id, width_mm, height_mm, blocks);
 	if (ret)
 		goto out;
-	edid = drm_edid_alloc(blocks, DCP_PANEL_EDID_BLOCKS * EDID_LENGTH);
+	edid = drm_edid_alloc(blocks, size);
 	if (!edid) {
 		ret = -ENOMEM;
 		goto out;
