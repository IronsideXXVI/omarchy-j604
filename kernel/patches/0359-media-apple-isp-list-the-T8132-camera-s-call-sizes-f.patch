From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 23:22:43 +0000
Subject: [PATCH] media: apple: isp: list the T8132 camera's call sizes
 from probe

The call sizes derived from the device tree presets (640x480, 1280x960,
1080x1080) are added at the first stream on a deferred-start SoC, unless
early_call_sizes is set. On the J604 a browser lists the formats before it
opens the camera, so 640x480, which macOS offers, is missing until some
stream has run in that boot; asking for it gets 1280x720.

List them from probe on T8132, as the derivation needs only the presets.
Other deferred-start SoCs keep early_call_sizes as it was.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/media/platform/apple/isp/isp-cam.c | 10 ++++++++--
 tools/asahi/isp-camera-sizes-tests.py      |  4 ++++
 tools/asahi/run-host-tests.py              |  2 +-
 3 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index 397241cc81..47f553f3d4 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -529,13 +529,19 @@ static int isp_add_call_sizes(struct apple_isp *isp)
 static bool early_call_sizes;
 module_param(early_call_sizes, bool, 0444);
 MODULE_PARM_DESC(early_call_sizes,
-		 "Deferred-start SoCs: list the derived call sizes from probe instead of after the first stream (default: off)");
+		 "Deferred-start SoCs: list the derived call sizes from probe instead of after the first stream (default: off; always on T8132)");
 
 int apple_isp_add_early_call_sizes(struct apple_isp *isp)
 {
 	int err;
 
-	if (!early_call_sizes || !isp->hw->deferred_start)
+	/*
+	 * The T8132 camera always lists them from probe: macOS offers 640x480
+	 * among its sizes, and applications list the formats before they open a
+	 * stream.
+	 */
+	if (!isp->hw->deferred_start ||
+	    !(early_call_sizes || isp->hw->imx958_wide_cfg6))
 		return 0;
 
 	err = isp_add_call_sizes(isp);
diff --git a/tools/asahi/isp-camera-sizes-tests.py b/tools/asahi/isp-camera-sizes-tests.py
index 0d7af663dd..b5e87c5cec 100755
--- a/tools/asahi/isp-camera-sizes-tests.py
+++ b/tools/asahi/isp-camera-sizes-tests.py
@@ -12,6 +12,7 @@ against a J604-like preset list (config 5, 1920x1080 and 1280x720). They must:
   1080x1920 at (980, 400) and 1328x1760 at (856, 480), never enlarged;
 - cut every other wide size from the selected window by the call-size rule,
   which stays as it was (checked over a grid of sources and sizes);
+- list the derived call sizes (640x480) from probe on T8132;
 - carry no upscale probe any more.
 """
 import argparse
@@ -34,6 +35,7 @@ MUTATIONS = {
     'tall-offset': ('isp-cam.c', '\t.crop_offset = { 176, 400 },', '\t.crop_offset = { 176, 494 },'),
     'offered-always': ('isp-cam.c', '\treturn !preset->wide_only || apple_isp_wide_view(isp);', '\treturn true;'),
     'refactor-odd': ('isp-cam.c', '\t       !((source->crop_offset.x | source->crop_offset.y) & 1) &&\n', ''),
+    'early-off': ('isp-cam.c', '\t    !(early_call_sizes || isp->hw->imx958_wide_cfg6))', '\t    !early_call_sizes)'),
     'refactor-bound': ('isp-cam.c', '\t       source->crop_size.y <= source->input_dim.y - source->crop_offset.y;', '\t       true;'),
 }
 
@@ -181,6 +183,8 @@ PORTRAIT = {(1080, 1920): (980, 400, 1080, 1920), (1328, 1760): (856, 480, 1328,
 
 def run(src, work):
     cam, hdr = src['isp-cam.c'], src['isp-drv.h']
+    if '!(early_call_sizes || isp->hw->imx958_wide_cfg6)' not in func(cam, 'apple_isp_add_early_call_sizes'):
+        fail('the T8132 camera must list its call sizes (640x480) from probe')
     for f in FILES:
         if 'upscale' in src[f]:
             fail(f'{f} still carries the upscale probe')
diff --git a/tools/asahi/run-host-tests.py b/tools/asahi/run-host-tests.py
index f21fb4f280..65e00586df 100755
--- a/tools/asahi/run-host-tests.py
+++ b/tools/asahi/run-host-tests.py
@@ -231,7 +231,7 @@ ASAHI_TESTS = {
         + mutations('--mutant', ('refill-count', 'no-retry', 'no-cancel', 'worker-allocation'), out()),
     'isp-camera-sizes-tests.py': [(out(), PASS)]
         + mutations('--mutation', ('view-off', 'window-0', 'tall-from-window', 'tall-unflagged', 'tall-offset',
-                                   'offered-always', 'refactor-odd', 'refactor-bound'), out()),
+                                   'offered-always', 'refactor-odd', 'refactor-bound', 'early-off'), out()),
     'tiled-split-tests.py': [(out(), PASS), (out() + ['--mutations'], PASS)],
     'tunnel-route-tests.py': [(out(), PASS)],
 }
-- 
