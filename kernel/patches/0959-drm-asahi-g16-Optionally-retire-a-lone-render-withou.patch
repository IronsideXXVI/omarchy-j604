@@ -40,6 +40,14 @@
 use super::regs::EngineState;
 use super::{params, Firmware, Shared, POLL_WORK};
 
+#[path = "lone_ctx.rs"]
+pub(crate) mod lone_ctx;
+
+/// `g16_notifier_cached`: lone-render proof passes that every uncached witness passed, by their
+/// cached CONTEXT words: matched, held back, retired without them (`g16_lone_ctx_skip`).
+pub(crate) static LONE_CTX_N: [core::sync::atomic::AtomicU64; 3] =
+    [const { core::sync::atomic::AtomicU64::new(0) }; 3];
+
 /// `g16_submit_defer`: compute submissions only queued [0], and published by their own pass
 /// while the switch was on [1].
 pub(crate) static SUBMIT_DEFER_N: [core::sync::atomic::AtomicU64; 2] =
@@ -1357,16 +1365,39 @@ fn retired_snapshot(&mut self) -> Result<Retirement> {
             let ta_end = unit.scene.r64(0x608)?;
             let fs_start = unit.scene.r64(0x620)?;
             let fs_end = unit.scene.r64(0x628)?;
-            full &= g.notifier.r32(notifier_page::TA_STAMP)? == f.ta_target
-                && g.notifier.r32(notifier_page::FS_STAMP)? == f.fs_target
-                && g.record_page().r32(notifier::CONTEXT)? == f.job.vm.slot
-                && g.record_page()
-                    .r32(notifier_page::FS_RECORD + notifier::CONTEXT)?
-                    == f.job.vm.slot
-                && f.job.resources.render()?.pool_retired(k)?
-                && ta_start != 0
-                && ta_end > ta_start
-                && (f.fs_short || (fs_start != 0 && fs_end > fs_start));
+            if g.records.is_none() {
+                full &= g.notifier.r32(notifier_page::TA_STAMP)? == f.ta_target
+                    && g.notifier.r32(notifier_page::FS_STAMP)? == f.fs_target
+                    && g.record_page().r32(notifier::CONTEXT)? == f.job.vm.slot
+                    && g.record_page()
+                        .r32(notifier_page::FS_RECORD + notifier::CONTEXT)?
+                        == f.job.vm.slot
+                    && f.job.resources.render()?.pool_retired(k)?
+                    && ta_start != 0
+                    && ta_end > ta_start
+                    && (f.fs_short || (fs_start != 0 && fs_end > fs_start));
+            } else {
+                // `g16_notifier_cached`: the CONTEXT words are the one host read of the
+                // ASC-cached record page. The uncached witnesses first, then CONTEXT, counted;
+                // `g16_lone_ctx_skip` retires without it (lone_ctx.rs).
+                let proved = g.notifier.r32(notifier_page::TA_STAMP)? == f.ta_target
+                    && g.notifier.r32(notifier_page::FS_STAMP)? == f.fs_target
+                    && f.job.resources.render()?.pool_retired(k)?
+                    && ta_start != 0
+                    && ta_end > ta_start
+                    && (f.fs_short || (fs_start != 0 && fs_end > fs_start));
+                let ctx = proved
+                    && g.record_page().r32(notifier::CONTEXT)? == f.job.vm.slot
+                    && g.record_page()
+                        .r32(notifier_page::FS_RECORD + notifier::CONTEXT)?
+                        == f.job.vm.slot;
+                let (retire, counter) =
+                    lone_ctx::lone_ctx(proved, ctx, super::params::lone_ctx_skip());
+                if let Some(i) = counter {
+                    LONE_CTX_N[i].fetch_add(1, Ordering::Relaxed);
+                }
+                full &= retire;
+            }
         }
         if full {
             if rw_alone {
@@ -2523,6 +2554,14 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
             s.tsplit_other_ns / 1000,
             s.submit_retires
         )?;
+        writeln!(
+            f,
+            "lone_ctx: skip {} matched {} held {} skipped {}",
+            u32::from(super::params::lone_ctx_skip()),
+            LONE_CTX_N[lone_ctx::MATCHED].load(Ordering::Relaxed),
+            LONE_CTX_N[lone_ctx::HELD].load(Ordering::Relaxed),
+            LONE_CTX_N[lone_ctx::SKIPPED].load(Ordering::Relaxed)
+        )?;
         writeln!(
             f,
             "submit_defer: n {} deferred {} published {}",
