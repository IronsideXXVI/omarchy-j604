 drivers/gpu/drm/asahi/g16/params.rs   | 22 ++++++++
 drivers/gpu/drm/asahi/g16/poll.rs     | 59 +++++++++++++++++----
 3 files changed, 146 insertions(+), 10 deletions(-)
