From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Fri, 30 Oct 2026 22:35:34 -0400
Subject: [PATCH] ASoC: tas2764: Defer software shutdown with
 apple,deferred-shutdown

On the J713 the AOP keeps the speaker TDM bus running for a while after
a playback stream stops, and the speaker protection still reads the
amplifiers' I/V sense words in that time. Each amp is muted and then
shut down in turn as the stream ends, so the shutdowns land in that
tail. The right tweeter's voltage sense slot then reads full scale for
about 20 samples at every stream stop, even for a stream of digital
silence played with the volume locked; the protection daemons charge
that as power.

With apple,deferred-shutdown, mute the amp at the stream's end as
before, but put it in software shutdown only 150 ms later, after the bus
has stopped (it ran on for up to 73 ms on the J713). A stream that
starts in between cancels it. Suspend and removal shut the amp down at
once. Such an amp sees the bus clock stop while it waits, and may see it
latched again after its shutdown; that clock-only fault is expected then
and no longer logged. Amps without the property keep the current
behaviour.

On a J713 the full-scale words in the stream tails go from about 90 per
test (three silent streams and a chord) to none, with no fault logged,
and every amp still ends in software shutdown.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 1b8098c6203abc3136e9bf9b8f6c07606faee624)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 sound/soc/codecs/tas2764.c | 70 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 70 insertions(+)

diff --git a/sound/soc/codecs/tas2764.c b/sound/soc/codecs/tas2764.c
index 9b5fdb43c7..9918209f59 100644
--- a/sound/soc/codecs/tas2764.c
+++ b/sound/soc/codecs/tas2764.c
@@ -20,6 +20,7 @@
 #include <linux/of.h>
 #include <linux/of_device.h>
 #include <linux/slab.h>
+#include <linux/workqueue.h>
 #include <sound/soc.h>
 #include <sound/pcm.h>
 #include <sound/pcm_params.h>
@@ -72,12 +73,27 @@ struct tas2764_priv {
 		int tx_mode;
 		unsigned int tx_mask;
 	} idle_slot_config;
+
+	/* apple,deferred-shutdown: software shutdown waits for the bus clock to stop */
+	bool deferred_shutdown;
+	/* Muted at a stream's end, until the next one: the bus clock may stop */
+	bool stream_stopped;
+	struct delayed_work shutdown_work;
 };
 
 #include "tas2764-quirks.h"
 
 /* LTCH0 faults that shut the whole SDZ group down: over temperature, over current */
 #define TAS2764_INT_LTCH0_GROUP_FAULTS	(BIT(0) | BIT(1))
+#define TAS2764_INT_LTCH0_TDM_CLOCK	BIT(2)
+
+/*
+ * With apple,deferred-shutdown, how long after a stream's end the muted amp
+ * goes to software shutdown.  On the J713 the AOP's speaker bus ran on for
+ * up to 3520 frames (73 ms at 48 kHz) after a stream's end; this leaves
+ * margin over that.
+ */
+#define TAS2764_DEFERRED_SHUTDOWN_MS	150
 
 static bool tas2764_group_failed(struct tas2764_priv *tas2764)
 {
@@ -206,6 +222,17 @@ static irqreturn_t tas2764_irq(int irq, void *data)
 		latched[i] = val;
 	}
 
+	/*
+	 * An amp muted at a stream's end with its shutdown deferred, or shut
+	 * down since, sees the bus clock stop: that is expected, not a fault.
+	 */
+	if (latched[0] == TAS2764_INT_LTCH0_TDM_CLOCK && READ_ONCE(tas2764->stream_stopped)) {
+		snd_soc_component_update_bits(tas2764->component, TAS2764_INT_CLK_CFG,
+					      TAS2764_INT_CLK_CFG_IRQZ_CLR,
+					      TAS2764_INT_CLK_CFG_IRQZ_CLR);
+		return IRQ_HANDLED;
+	}
+
 	for (i = 0; i < 8; i++) {
 		if (latched[0] & BIT(i)) {
 			dev_crit_ratelimited(tas2764->dev, "%s\n",
@@ -269,6 +296,8 @@ static int tas2764_update_pwr_ctrl(struct tas2764_priv *tas2764)
 	return 0;
 }
 
+static void tas2764_flush_shutdown(struct tas2764_priv *tas2764);
+
 #ifdef CONFIG_PM
 /*
  * Members of an SDZ group keep the shared SDZ line high across system sleep: the amp waits in
@@ -286,6 +315,8 @@ static int tas2764_codec_suspend(struct snd_soc_component *component)
 	struct tas2764_priv *tas2764 = snd_soc_component_get_drvdata(component);
 	int ret;
 
+	tas2764_flush_shutdown(tas2764);
+
 	ret = snd_soc_component_update_bits(component, TAS2764_PWR_CTRL,
 					    TAS2764_PWR_CTRL_MASK,
 					    TAS2764_PWR_CTRL_SHUTDOWN);
@@ -390,6 +421,26 @@ static int tas2764_startup(struct snd_pcm_substream *substream, struct snd_soc_d
 	return 0;
 }
 
+static void tas2764_shutdown_work(struct work_struct *work)
+{
+	struct tas2764_priv *tas2764 = container_of(to_delayed_work(work),
+						    struct tas2764_priv, shutdown_work);
+	int ret;
+
+	tas2764->dac_powered = false;
+	ret = tas2764_update_pwr_ctrl(tas2764);
+	/* a failed group has its SDZ supply forced off already */
+	if (ret && !tas2764_group_failed(tas2764))
+		dev_err(tas2764->dev, "deferred shutdown failed: %d\n", ret);
+}
+
+/* A deferred shutdown happens now (suspend, removal) */
+static void tas2764_flush_shutdown(struct tas2764_priv *tas2764)
+{
+	if (cancel_delayed_work_sync(&tas2764->shutdown_work))
+		tas2764_shutdown_work(&tas2764->shutdown_work.work);
+}
+
 static int tas2764_mute(struct snd_soc_dai *dai, int mute, int direction)
 {
 	struct tas2764_priv *tas2764 =
@@ -397,6 +448,11 @@ static int tas2764_mute(struct snd_soc_dai *dai, int mute, int direction)
 	int ret;
 
 	if (!mute) {
+		if (tas2764->deferred_shutdown) {
+			/* still muted from the last stream: no shutdown in between */
+			cancel_delayed_work_sync(&tas2764->shutdown_work);
+			WRITE_ONCE(tas2764->stream_stopped, false);
+		}
 		tas2764->dac_powered = true;
 		ret = tas2764_update_pwr_ctrl(tas2764);
 		if (ret)
@@ -412,6 +468,14 @@ static int tas2764_mute(struct snd_soc_dai *dai, int mute, int direction)
 		/* Wait for ramp-down */
 		usleep_range(6000, 7000);
 
+		if (tas2764->deferred_shutdown) {
+			/* the bus still runs: shut down once its clock has stopped */
+			WRITE_ONCE(tas2764->stream_stopped, true);
+			schedule_delayed_work(&tas2764->shutdown_work,
+					      msecs_to_jiffies(TAS2764_DEFERRED_SHUTDOWN_MS));
+			return 0;
+		}
+
 		tas2764->dac_powered = false;
 		ret = tas2764_update_pwr_ctrl(tas2764);
 		if (ret)
@@ -1010,6 +1074,8 @@ static void tas2764_codec_remove(struct snd_soc_component *component)
 {
 	struct tas2764_priv *tas2764 = snd_soc_component_get_drvdata(component);
 
+	tas2764_flush_shutdown(tas2764);
+
 	/* A failed group's supply was forced off: there is no enable left to balance. */
 	if (tas2764_group_failed(tas2764))
 		return;
@@ -1161,6 +1227,9 @@ static int tas2764_parse_dt(struct device *dev, struct tas2764_priv *tas2764)
 	if (ret)
 		tas2764->v_sense_slot = -1;
 
+	tas2764->deferred_shutdown = of_property_read_bool(dev->of_node,
+							   "apple,deferred-shutdown");
+
 	return tas2764_group_join(dev, tas2764);
 }
 
@@ -1178,6 +1247,7 @@ static int tas2764_i2c_probe(struct i2c_client *client)
 
 	tas2764->dev = &client->dev;
 	tas2764->irq = client->irq;
+	INIT_DELAYED_WORK(&tas2764->shutdown_work, tas2764_shutdown_work);
 	i2c_set_clientdata(client, tas2764);
 	dev_set_drvdata(&client->dev, tas2764);
 
