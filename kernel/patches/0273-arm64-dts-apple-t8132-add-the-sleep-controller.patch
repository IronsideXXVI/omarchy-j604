From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bartosz Nitka <niteria@gmail.com>
Date: Sun, 8 Nov 2026 15:12:39 +0100
Subject: [PATCH] arm64: dts: apple: t8132: add the sleep controller

Describe the sleep controller with the register blocks its driver
programs, the wake sources from the J713's ADT, and the display
coprocessors that must be off before a commit.

Assisted-by: LLM
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 917549272231bec9f0b0e30919c8c5e5ed5babba)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 43 ++++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 61556392c9..e90ad620cc 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -563,6 +563,49 @@ pmgr_mini: power-management@388280000 {
 			/* child nodes are added in t8132-pmgr.dtsi */
 		};
 
+		sleep: sleep-controller@380700000 {
+			compatible = "apple,t8132-sleep";
+			reg = <0x3 0x80700000 0x0 0x18000>,
+			      <0x3 0x80724000 0x0 0x2000>,
+			      <0x3 0x80734000 0x0 0x10>,
+			      <0x3 0x80768000 0x0 0x40>,
+			      <0x3 0x80780000 0x0 0x8>,
+			      <0x3 0x882d4000 0x0 0x4>,
+			      <0x3 0x882b0000 0x0 0x30>,
+			      <0x3 0x882b8000 0x0 0x44>,
+			      <0x3 0x88004000 0x0 0x48>,
+			      <0x2 0x20024000 0x0 0x1000>,
+			      <0x2 0x20064000 0x0 0x1000>,
+			      <0x3 0x828a9c14 0x0 0x4>,
+			      <0x2 0x10e70000 0x0 0x1000>,
+			      <0x2 0x11e70000 0x0 0x1000>,
+			      <0x3 0x88714000 0x0 0x84>,
+			      <0x3 0x82800000 0x0 0x10000>,
+			      <0x3 0x8005c000 0x0 0x4>,
+			      <0x3 0x88280000 0x0 0x10000>,
+			      <0x3 0x88908040 0x0 0x4>,
+			      <0x3 0x80040040 0x0 0x18>,
+			      <0x2 0x20400580 0x0 0x10>,
+			      <0x2 0x20800580 0x0 0x10>,
+			      <0x3 0x803d0bc8 0x0 0x10>,
+			      <0x3 0x80058000 0x0 0x10004>,
+			      <0x3 0x80780010 0x0 0x4>;
+			reg-names = "ps", "pwrgate", "cpu-start", "cllt", "cluster",
+				    "commit", "wdt", "aon-misc", "wake",
+				    "amcc0", "amcc1", "pmc-dcp",
+				    "dvfm-e", "dvfm-p", "spmi", "pmc-voters", "dcs",
+				    "ps-aon", "spmi-a0", "clk-mux", "mcc0", "mcc1",
+				    "ptd", "clk-perf", "cluster-dcs";
+			/*
+			 * The same sources as T8140's, by name, from the J713 ADT's
+			 * /arm-io/pmgr ap-wake-sources: NUB.SPMI0.SW3, ATC0.USBWakeup,
+			 * SMC.CPUWakeupAP, SMC.OutboxNotEmpty, MTP.DOCK.CHANNELS.AP0.IRQ
+			 * and MTP.OutboxNotEmpty.
+			 */
+			apple,wake-enable = <145 69 161 183 85 104>;
+			apple,display-coprocessors = <&dcp>, <&dcpext0>, <&dcpext1>;
+		};
+
 		wdt: watchdog@3882b0000 {
 			compatible = "apple,t8132-wdt", "apple,t8103-wdt";
 			reg = <0x3 0x882b0000 0x0 0x4000>;
-- 
2.43.0

