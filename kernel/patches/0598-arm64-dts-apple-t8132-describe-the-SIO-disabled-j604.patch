From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 06:06:41 +0000
Subject: [PATCH] arm64: dts: apple: t8132: describe the SIO, disabled; j604:
 HDMI audio

Describe the T8132 SIO with its ASC mailbox and DART, all disabled: the
SIO's firmware tables need boot loader support first. Every value is the
J604 Apple device tree's (arm-io sio and dart-sio: windows, mailbox at
coprocessor + 0x8000 and its interrupts 1078-1081, DART interrupt 1074,
SIO on DART stream 0, power gate SIO_CPU).

Describe the J604 HDMI port's DisplayPort audio interface, DPA1 (ADT
dp-audio1: SIO channel 0x66, power gate DPA1, the dp-audio node dcpext0
names), linked to dcpext0 as on the M3 Pro HDMI port. It stays disabled with
the SIO.

(backported from commit 6de4b8e4a92ae4a0394879a32790d0c49a4586df)
[j604: t8132-sio.dtsi with the dart_sio0 node of upstream commit 20366a7088
 (t8132-peripherals.dtsi), whose values are the J604 ADT's too; without the
 clocks (no provider in this tree). The SIO is not given the sio alias, so
 that the boot loader does not start it with tables of another firmware
 protocol (m1n1 sio.c builds the pre-T6030 layout for any SoC but the T6030).
 The T8132 SIO protocol is to be determined (H3-D4 of ports-3 round 2).]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 .../arm64/boot/dts/apple/t8132-j604-hdmi.dtsi | 40 +++++++++++++--
 arch/arm64/boot/dts/apple/t8132-sio.dtsi      | 49 +++++++++++++++++++
 arch/arm64/boot/dts/apple/t8132.dtsi          |  1 +
 3 files changed, 87 insertions(+), 3 deletions(-)
 create mode 100644 arch/arm64/boot/dts/apple/t8132-sio.dtsi

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-hdmi.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-hdmi.dtsi
index 29770e0b44..5e0b80f254 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-hdmi.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-hdmi.dtsi
@@ -33,9 +33,10 @@
  * the coprocessor over (t8132-j604-dcpext.dtsi). Until then the PHY stays
  * powered down.
  *
- * The port's audio is DPA1 (ADT dp-audio1, SIO channel 0x66, the dp-audio
- * node dcpext0 names), as on the M3 Pro HDMI port. It is not described: this
- * tree has no T8132 SIO node yet.
+ * The port's audio is DPA1 (ADT dp-audio1, SIO channel 0x66, power gate DPA1,
+ * the dp-audio node dcpext0 names), as on the M3 Pro HDMI port. It stays
+ * disabled with the T8132 SIO (t8132-sio.dtsi), which needs boot loader
+ * support for its firmware tables first.
  *
  * Copyright The Asahi Linux Contributors
  */
@@ -110,6 +111,13 @@
 		#address-cells = <1>;
 		#size-cells = <0>;
 
+		port@0 {
+			reg = <0>;
+			dcpext0_audio: endpoint {
+				remote-endpoint = <&dpaudio1_dcpext0>;
+			};
+		};
+
 		port@1 {
 			reg = <1>;
 			dcpext0_dpout: endpoint {
@@ -119,6 +127,32 @@
 	};
 };
 
+/*
+ * DPA1: the HDMI port's DisplayPort audio, SIO channel 0x66. It has no
+ * registers of its own (ADT dp-audio1 has no reg), so it is no soc child.
+ */
+/ {
+	dpaudio1: audio-controller-1 {
+		compatible = "apple,t8132-dpaudio", "apple,dpaudio";
+		dmas = <&sio 0x66>;
+		dma-names = "tx";
+		power-domains = <&ps_dpa1>;
+		status = "disabled";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				dpaudio1_dcpext0: endpoint {
+					remote-endpoint = <&dcpext0_audio>;
+				};
+			};
+		};
+	};
+};
+
 &atc2_dpxbar {
 	status = "okay";
 };
diff --git a/arch/arm64/boot/dts/apple/t8132-sio.dtsi b/arch/arm64/boot/dts/apple/t8132-sio.dtsi
new file mode 100644
index 0000000000..3d5034b332
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8132-sio.dtsi
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * T8132 SIO resources; channel layout and firmware regions require loader
+ * support.
+ *
+ * Every value is the J604 Apple device tree's (arm-io sio, dart-sio):
+ * coprocessor window and auxiliary window, the ASC mailbox at coprocessor
+ * + 0x8000 with its four interrupts, the DART with its interrupt and the SIO
+ * on its stream 0, power gate SIO_CPU.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+&soc {
+	dart_sio0: iommu@3ad060000 {
+		compatible = "apple,t8132-dart", "apple,t8110-dart";
+		reg = <0x3 0xad060000 0x0 0xc000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1074 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		status = "disabled";
+	};
+
+	sio_mbox: mailbox@3ade08000 {
+		compatible = "apple,t8132-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x3 0xade08000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 1078 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 1079 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 1080 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 1081 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+		power-domains = <&ps_sio_cpu>;
+		status = "disabled";
+	};
+
+	sio: dma-controller@3ade00000 {
+		compatible = "apple,t8132-sio", "apple,sio";
+		reg = <0x3 0xade00000 0x0 0x88000>,
+		      <0x3 0xad850000 0x0 0x4000>;
+		#dma-cells = <1>;
+		mboxes = <&sio_mbox>;
+		iommus = <&dart_sio0 0>;
+		power-domains = <&ps_sio_cpu>;
+		status = "disabled";
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 7fecf0f809..a3683307b5 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -1744,5 +1744,6 @@
 };
 
 #include "t8132-pmgr.dtsi"
+#include "t8132-sio.dtsi"
 #include "t8132-usb4.dtsi"
 #include "t8132-memory.dtsi"
