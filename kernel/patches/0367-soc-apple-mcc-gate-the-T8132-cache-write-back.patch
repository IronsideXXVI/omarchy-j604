From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 18:43:56 +0000
Subject: [PATCH 367/368] soc: apple: mcc: gate the T8132 cache write-back

The previous commit writes T8132's system level cache back and turns it
off at every firmware-driven suspend. On a boot that m1n1 starts
directly a T8132 sleep is refused before the commit, so the write-back
would only cost the cache until the wake.

Do it only when apple_mcc.t8132_writeback is set, default off, and the
boot can commit a T8132 sleep (apple_cpu_t8132_dse_allowed(): a boot
through aura's boot object). Off, T8132's cache is left as it was
before the write-back existed. Suspend-to-idle never reaches it.

Assisted-by: LLM
---
 drivers/soc/apple/mcc.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/drivers/soc/apple/mcc.c b/drivers/soc/apple/mcc.c
index 89cd3b807c..9f2bcbe02b 100644
--- a/drivers/soc/apple/mcc.c
+++ b/drivers/soc/apple/mcc.c
@@ -19,6 +19,9 @@
 #include <linux/platform_device.h>
 #include <linux/pm.h>
 #include <linux/suspend.h>
+#ifdef CONFIG_ARM64
+#include <asm/apple_cpu.h>
+#endif
 
 #if IS_ENABLED(CONFIG_APPLE_MCC_KUNIT_TEST)
 #include <kunit/static_stub.h>
@@ -125,6 +128,25 @@ static int apple_mcc_disable_t8132(struct apple_mcc *mcc)
 	return 0;
 }
 
+/*
+ * The write-back leaves T8132's cache off until the wake. It is only worth that on a
+ * boot that can commit a T8132 sleep: one through aura's boot object, which is what
+ * apple_cpu_t8132_dse_allowed() says. Opt-in until such sleeps are proven here.
+ */
+static bool t8132_writeback;
+module_param(t8132_writeback, bool, 0644);
+MODULE_PARM_DESC(t8132_writeback,
+		 "T8132: write the system level cache back and turn it off at a firmware-driven sleep, only on a boot that can commit one (default: off)");
+
+static bool apple_mcc_t8132_writeback(void)
+{
+#ifdef CONFIG_ARM64
+	return READ_ONCE(t8132_writeback) && apple_cpu_t8132_dse_allowed();
+#else
+	return false;
+#endif
+}
+
 static int apple_mcc_wait_boot_dma(struct device *dev)
 {
 	struct of_phandle_iterator it;
@@ -283,6 +305,9 @@ static int apple_mcc_suspend_noirq(struct device *dev)
 
 	if (!pm_suspend_via_firmware() || !mcc->enabled)
 		return 0;
+	/* Off, T8132's cache is left as it is, as before the write-back existed. */
+	if (mcc->retained && !apple_mcc_t8132_writeback())
+		return 0;
 	if (mcc->retained) {
 		ret = apple_mcc_disable_t8132(mcc);
 		if (ret)
-- 
