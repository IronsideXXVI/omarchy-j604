From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 02:55:55 +0000
Subject: [PATCH] drm/apple: m4: let held J604 panel swaps start sooner
 after the tick between

swap_pace starts a held swap a quarter tick (1.04 ms) after the tick
between two 120 Hz refreshes is out of its reach, which leaves it about
3.3 ms to make the next grid tick. Measured on the J604 with a 60 fps
video, 23 of 930 held swaps completed one tick after their grid tick and
1 one tick before it, so the late side needs the room more.

Make the margin swap_pace_margin_us (0644, default 520 us, at most a
quarter tick), giving held swaps half a millisecond more for the grid
tick while keeping clear of the tick between.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/gpu/drm/apple/iomfb_m4.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index 0d2562121d..a1672a3331 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -199,6 +199,11 @@ module_param(swap_pace_min_us, uint, 0644);
 MODULE_PARM_DESC(swap_pace_min_us,
 		 "J604: with swap_pace, hold frames only while the smoothed interval between swaps is at least this long, us (default 14600, about 3.5 ticks: 60 fps and slower video; 0 = every frame)");
 
+static unsigned int swap_pace_margin_us = 520;
+module_param(swap_pace_margin_us, uint, 0644);
+MODULE_PARM_DESC(swap_pace_margin_us,
+		 "J604: with swap_pace, how far past the reach of the tick between two refreshes a held swap starts, us (default 520; at most a quarter tick)");
+
 static unsigned int swap_pace_lead_us;
 module_param(swap_pace_lead_us, uint, 0644);
 MODULE_PARM_DESC(swap_pace_lead_us,
@@ -2711,8 +2716,13 @@ static unsigned long dcp_m4_swap_pace_us(struct dcp_m4_runtime *r)
 	/* The first grid tick base + k * half (k even) at least lead + margin ahead. */
 	k = div64_u64(now + lead + margin - base + half - 1, half);
 	k += k & 1;
-	/* Start once the tick before it, base + (k - 1) * half, is out of reach by margin. */
-	start = base + (k - 1) * half + margin - lead;
+	/*
+	 * Start once the tick before it, base + (k - 1) * half, is out of reach
+	 * by swap_pace_margin_us: held swaps that take long still make the grid
+	 * tick (measured: late ones outnumber early ones with a quarter tick).
+	 */
+	start = base + (k - 1) * half - lead +
+		min_t(u64, div_u64(freq * READ_ONCE(swap_pace_margin_us), USEC_PER_SEC), margin);
 	WRITE_ONCE(r->pace_e, base + k * half);
 	if (start <= now) {
 		r->pace_n[1]++;
