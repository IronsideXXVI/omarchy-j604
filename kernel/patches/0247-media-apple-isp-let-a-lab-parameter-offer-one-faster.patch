From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 05:08:27 +0000
Subject: [PATCH] media: apple: isp: let a lab parameter offer one
 faster frame rate

The driver offers 30, 25, 24, 20 and 15 frames per second. Three of the
thirteen sensor configurations the J604 firmware reports are timed for
60 frames per second (their line length times frame length at the
1.02 GHz sensor clock), but no request above 30 can reach the firmware,
so whether it delivers them cannot be measured.

Add apple_isp.lab_fps, off by default and read at load, that offers one
extra rate between 31 and 120 first in the frame interval list and
lets VIDIOC_S_PARM select it. The auto exposure limits then carry that
rate as for any other. 0 or a value outside the range leaves the list
as it was.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-v4l2.c | 41 ++++++++++++++++++---
 1 file changed, 36 insertions(+), 5 deletions(-)

diff --git a/drivers/media/platform/apple/isp/isp-v4l2.c b/drivers/media/platform/apple/isp/isp-v4l2.c
index d0769f8e55..d701884abe 100644
--- a/drivers/media/platform/apple/isp/isp-v4l2.c
+++ b/drivers/media/platform/apple/isp/isp-v4l2.c
@@ -31,6 +31,37 @@ static void isp_vb2_set_min_buffers(struct apple_isp *isp);
 /* Capture rates offered to userspace, in frames per second */
 static const unsigned int isp_frame_rates[] = { 30, 25, 24, 20, 15 };
 
+/*
+ * Lab: one extra rate above the standard list, offered first, for measuring
+ * the sensor configurations that run faster than 30 frames per second. The
+ * firmware decides what it delivers; this only lets the request reach it.
+ * 0, the default, or a value outside 31..120 changes nothing.
+ */
+static unsigned int lab_fps;
+module_param(lab_fps, uint, 0444);
+MODULE_PARM_DESC(lab_fps,
+		 "Lab: offer this frame rate (31..120) in addition to the standard ones (default: 0 = off)");
+
+static bool isp_lab_fps(void)
+{
+	return lab_fps > ISP_FRAME_RATE_DEFAULT && lab_fps <= 120;
+}
+
+static unsigned int isp_num_rates(void)
+{
+	return ARRAY_SIZE(isp_frame_rates) + isp_lab_fps();
+}
+
+static unsigned int isp_rate(unsigned int index)
+{
+	if (isp_lab_fps()) {
+		if (!index)
+			return lab_fps;
+		index--;
+	}
+	return isp_frame_rates[index];
+}
+
 struct isp_buflist_buffer {
 	u64 iovas[ISP_MAX_PLANES];
 	u32 flags[ISP_MAX_PLANES];
@@ -852,7 +883,7 @@ static int isp_vidioc_enum_frameintervals(struct file *file, void *fh,
 	struct apple_isp *isp = video_drvdata(file);
 	int i;
 
-	if (interval->index >= ARRAY_SIZE(isp_frame_rates))
+	if (interval->index >= isp_num_rates())
 		return -EINVAL;
 
 	if (interval->pixel_format != V4L2_PIX_FMT_NV12 &&
@@ -871,21 +902,21 @@ static int isp_vidioc_enum_frameintervals(struct file *file, void *fh,
 
 	interval->type = V4L2_FRMIVAL_TYPE_DISCRETE;
 	interval->discrete.numerator = 1;
-	interval->discrete.denominator = isp_frame_rates[interval->index];
+	interval->discrete.denominator = isp_rate(interval->index);
 	return 0;
 }
 
 /* Returns the supported rate whose frame interval is closest to @tpf. */
 static unsigned int isp_closest_frame_rate(const struct v4l2_fract *tpf)
 {
-	unsigned int best = isp_frame_rates[0];
+	unsigned int best = isp_rate(0);
 
 	/*
 	 * |n/d - 1/r| = |n * r - d| / (d * r), so the closest rate has the
 	 * smallest |n * r - d| / r; compare those by cross-multiplying.
 	 */
-	for (int i = 1; i < ARRAY_SIZE(isp_frame_rates); i++) {
-		unsigned int rate = isp_frame_rates[i];
+	for (unsigned int i = 1; i < isp_num_rates(); i++) {
+		unsigned int rate = isp_rate(i);
 		u64 err = abs_diff((u64)tpf->numerator * rate,
 				   (u64)tpf->denominator);
 		u64 best_err = abs_diff((u64)tpf->numerator * best,
-- 
