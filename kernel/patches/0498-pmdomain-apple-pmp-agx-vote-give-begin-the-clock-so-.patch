From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
Date: Tue, 3 Nov 2026 09:13:24 -0600
Subject: [PATCH] pmdomain: apple: pmp-agx-vote: give begin the clock so a
 backoff cannot strand or spam the vote

w7X's review of the first cut (a7330a53) found a blocking regression and two
correct behaviours to keep. The gate on begin had to know the time, so
agx_vote_begin() now takes now (the caller reads it under its lock; the glue
passes apple_pmp_agx_now_ms() beside its existing end and next reads):

- begin returns false during a failed-set backoff before the deadline (decide
  would return NONE; the retry timer drives the set), and true again once the
  deadline has passed. The first cut's unconditional !v->failures stranded the
  vote after one failed set whose retry timer fired idle: failures is only
  cleared by a successful SET, so every later begin refused forever. Case 23
  is that sequence (failed set, end before the retry, timer fires idle, a
  later begin must kick and the set must land); the begin-ignores-retry
  mutant is exactly the first cut's expression and dies at it (line 363).
- The other direction is pinned too: begin-backoff-kick (kick during the
  window regardless of the deadline) dies at the kick-storm case (line 357),
  so the gate cannot silently decay into "always kick" again.

Case 23 exists because the simulator cases kept the operation alive through
the backoff; this one ends it first. The begin signature change touches the
suite's helper, four header-only call sites, and the one glue call.

Proof: plain suite 23 cases selfcheck ok; --mutations catches all nine
mutants (owed-set-branch, owed-failures, stopped-in-begin, stopped-in-decide,
wrap-reached, set-write-ends, begin-backoff-kick, begin-ignores-retry,
retry-revival); check-kick-guard still passes on pmp-report.c; the tree
runner passes the registered vote entries.

Signed-off-by: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
(cherry picked from commit 2ec389ca6e6d1ac94297fe094313d99202376ed5)
---
 drivers/pmdomain/apple/pmp-agx-vote.h | 11 +++++----
 drivers/pmdomain/apple/pmp-report.c   |  2 +-
 tools/asahi/pmp-agx-vote-tests.c      | 35 +++++++++++++++++++++------
 tools/asahi/pmp-agx-vote-tests.py     |  9 +++++--
 tools/aurora-ci/host-tests.json       | 14 +++++++++++
 5 files changed, 56 insertions(+), 15 deletions(-)

diff --git a/drivers/pmdomain/apple/pmp-agx-vote.h b/drivers/pmdomain/apple/pmp-agx-vote.h
index ef0845b897..f6ded0e238 100644
--- a/drivers/pmdomain/apple/pmp-agx-vote.h
+++ b/drivers/pmdomain/apple/pmp-agx-vote.h
@@ -59,13 +59,14 @@ static inline bool agx_vote_retry_reached(const struct agx_vote *v, agx_ms_t now
 	       || (agx_sms_t)(v->retry_at - now) > (agx_sms_t)AGX_VOTE_RETRY_MS;
 }
 
-/* An operation starts. True: run the reconcile step now. */
-static inline bool agx_vote_begin(struct agx_vote *v)
+/* An operation starts. now is the operation's start time in ms (any wrapping clock; the caller reads it
+ * under its lock). True: run the reconcile step now. During a failed-set backoff before the deadline it is
+ * false (decide would return NONE, and the retry timer drives the set); once the deadline has passed it is
+ * true again, so a failed set whose timer fired idle does not strand the vote. */
+static inline bool agx_vote_begin(struct agx_vote *v, agx_ms_t now)
 {
 	v->users++;
-	/* While a failed set is in backoff the retry timer drives the set: decide would return NONE here, so
-	 * asking for a reconciliation only burns a kick per operation until the deadline. */
-	return v->enabled && !v->voted && !v->stopped && !v->failures;
+	return v->enabled && !v->voted && !v->stopped && (!v->failures || agx_vote_retry_reached(v, now));
 }
 
 /* An operation ends. Returns the delay in ms after which the reconcile step must run, 0 when none is needed. */
diff --git a/drivers/pmdomain/apple/pmp-report.c b/drivers/pmdomain/apple/pmp-report.c
index 8d9b825316..d4b4b493bd 100644
--- a/drivers/pmdomain/apple/pmp-report.c
+++ b/drivers/pmdomain/apple/pmp-report.c
@@ -1477,7 +1477,7 @@ void apple_pmp_agx_activity_begin(void)
 
 	spin_lock_irqsave(&apple_pmp_agx_vote_lock, flags);
 	v->enabled = READ_ONCE(agx_vote);
-	kick = agx_vote_begin(v);
+	kick = agx_vote_begin(v, apple_pmp_agx_now_ms());
 	spin_unlock_irqrestore(&apple_pmp_agx_vote_lock, flags);
 	if (kick)
 		apple_pmp_agx_vote_kick(0);
diff --git a/tools/asahi/pmp-agx-vote-tests.c b/tools/asahi/pmp-agx-vote-tests.c
index f58c592b9a..ed7ed85722 100644
--- a/tools/asahi/pmp-agx-vote-tests.c
+++ b/tools/asahi/pmp-agx-vote-tests.c
@@ -63,7 +63,7 @@ static void reconcile(struct sim *s)
 
 static void begin(struct sim *s)
 {
-	if (agx_vote_begin(&s->v)) {
+	if (agx_vote_begin(&s->v, s->now)) {
 		s->kicks++;
 		arm(s, 0);
 	}
@@ -233,7 +233,7 @@ int main(void)
 		// the header alone, as the reviewer reproduced it: decide (CLEAR), begin, applied, next
 		struct agx_vote v = {.enabled = true, .voted = true, .idle_ms = 100, .idle_at = 0};
 		CHECK(agx_vote_decide(&v, 100) == AGX_VOTE_CLEAR);
-		CHECK(!agx_vote_begin(&v));
+		CHECK(!agx_vote_begin(&v, 100));
 		agx_vote_applied(&v, AGX_VOTE_CLEAR, 0, 100);
 		CHECK(v.users == 1 && !v.voted);
 		CHECK(agx_vote_next(&v, 100) == 1);                // not 0: a set is owed
@@ -292,11 +292,11 @@ int main(void)
 		struct agx_vote v = {.enabled = true, .idle_ms = 100};
 		agx_vote_refuse(&v);
 		CHECK(v.stopped && !v.voted);
-		CHECK(!agx_vote_begin(&v));                            // a user, but no kick
+		CHECK(!agx_vote_begin(&v, 0));                         // a user, but no kick
 		CHECK(agx_vote_decide(&v, 0) == AGX_VOTE_NONE && agx_vote_next(&v, 0) == 0);
 		CHECK(agx_vote_resume(&v));                            // work in flight: the reconcile step must run
 		struct agx_vote w = {.enabled = true, .idle_ms = 100};
-		CHECK(agx_vote_begin(&w));
+		CHECK(agx_vote_begin(&w, 0));
 		agx_vote_applied(&w, AGX_VOTE_SET, -110, 500);          // the set was not acknowledged
 		CHECK(w.failures == 1 && w.retry_at == 500 + AGX_VOTE_RETRY_MS);
 		CHECK(agx_vote_next(&w, 500) == AGX_VOTE_RETRY_MS);      // the retry deadline, not 1 ms
@@ -317,7 +317,7 @@ int main(void)
 	{
 		// exactly the reviewer's interleaving, on the header alone: decide, then end, then the write lands
 		struct agx_vote v = {.enabled = true, .idle_ms = 0};
-		CHECK(agx_vote_begin(&v) && v.users == 1);
+		CHECK(agx_vote_begin(&v, 5000) && v.users == 1);
 		CHECK(agx_vote_decide(&v, 5000) == AGX_VOTE_SET);
 		CHECK(agx_vote_end(&v, 5001) == 0);                   // the end during the write sees voted false: no timer
 		CHECK(v.users == 0);
@@ -358,8 +358,29 @@ int main(void)
 		advance_to(&s, AGX_VOTE_RETRY_MS);
 		CHECK(s.sets == 2 && s.bit && s.v.failures == 0);
 		// the header alone
-		struct agx_vote v = {.enabled = true, .failures = 1};
-		CHECK(!agx_vote_begin(&v));
+		struct agx_vote v = {.enabled = true, .failures = 1, .retry_at = 100};
+		CHECK(!agx_vote_begin(&v, 0));
+		CHECK(agx_vote_begin(&v, 100));
+	}
+	// 23. w7X's regression repro for the first cut of the backoff gate: a failed set whose retry timer fires
+	// while the GPU is idle left failures set forever, and begin never asked for the set again. The kick
+	// must come back once the deadline has passed.
+	{
+		struct sim s = fresh(true, 100, 0);
+		s.fail_sets = 1;
+		begin(&s); advance_to(&s, 0);
+		CHECK(s.v.failures == 1 && s.armed);
+		end(&s);                                               // the operation ends long before the retry
+		advance_to(&s, AGX_VOTE_RETRY_MS);                     // the timer fires idle: nothing to do
+		CHECK(s.v.failures == 1 && !s.armed && !s.bit);
+		int kicks = s.kicks;
+		begin(&s);                                             // a later operation: the kick must come back
+		advance_to(&s, s.now + 1);
+		CHECK(s.kicks == kicks + 1 && s.sets == 2 && s.bit && s.v.failures == 0);
+		// the header alone: inside the window no kick, past it the kick returns
+		struct agx_vote v = {.enabled = true, .failures = 1, .retry_at = 100};
+		CHECK(!agx_vote_begin(&v, 50));
+		CHECK(agx_vote_begin(&v, 100));
 	}
 	printf("AGX-VOTE-SELFCHECK-OK\n");
 	return 0;
diff --git a/tools/asahi/pmp-agx-vote-tests.py b/tools/asahi/pmp-agx-vote-tests.py
index 881a2e85d6..17d829217e 100755
--- a/tools/asahi/pmp-agx-vote-tests.py
+++ b/tools/asahi/pmp-agx-vote-tests.py
@@ -30,12 +30,17 @@ HEADER = 'drivers/pmdomain/apple/pmp-agx-vote.h'
 CONTROLS = [
     ('owed-set-branch', '\tif (v->users && !v->voted && !v->failures)\n\t\treturn 1;\n', ''),
     ('owed-failures', 'if (v->users && !v->voted && !v->failures)\n\t\treturn 1;', 'if (v->users && !v->voted)\n\t\treturn 1;'),
-    ('stopped-in-begin', 'return v->enabled && !v->voted && !v->stopped && !v->failures;', 'return v->enabled && !v->voted && !v->failures;'),
+    ('stopped-in-begin', 'return v->enabled && !v->voted && !v->stopped && (!v->failures || agx_vote_retry_reached(v, now));',
+     'return v->enabled && !v->voted && (!v->failures || agx_vote_retry_reached(v, now));'),
     ('stopped-in-decide', 'if (!v->enabled || v->stopped)\n\t\treturn v->voted ? AGX_VOTE_CLEAR : AGX_VOTE_NONE;',
      'if (!v->enabled)\n\t\treturn v->voted ? AGX_VOTE_CLEAR : AGX_VOTE_NONE;'),
     ('wrap-reached', 'return (agx_sms_t)(now - t) >= 0;', 'return now >= t;'),
     ('set-write-ends', 'return agx_vote_reached(now, at) ? 1 : at - now;', 'return agx_vote_reached(now, at) ? 0 : at - now;'),
-    ('begin-backoff-kick', 'return v->enabled && !v->voted && !v->stopped && !v->failures;', 'return v->enabled && !v->voted && !v->stopped;'),
+    ('begin-backoff-kick', 'return v->enabled && !v->voted && !v->stopped && (!v->failures || agx_vote_retry_reached(v, now));',
+     'return v->enabled && !v->voted && !v->stopped && ((void)now, (!v->failures || true));'),
+    ('begin-ignores-retry', 'return v->enabled && !v->voted && !v->stopped && (!v->failures || agx_vote_retry_reached(v, now));',
+     'return v->enabled && !v->voted && !v->stopped && ((void)now, !v->failures);'),
+    ('begin-ignores-retry', '(!v->failures || agx_vote_retry_reached(v, now))', '!v->failures'),
     ('retry-revival', '|| (agx_sms_t)(v->retry_at - now) > (agx_sms_t)AGX_VOTE_RETRY_MS', ''),
 ]
 
diff --git a/tools/aurora-ci/host-tests.json b/tools/aurora-ci/host-tests.json
index deef327017..9287a29f8c 100644
--- a/tools/aurora-ci/host-tests.json
+++ b/tools/aurora-ci/host-tests.json
@@ -2360,6 +2360,20 @@
    "expect": "pass",
    "note": "self-checking: exits 0 when the mutant aborts"
   },
+  {
+   "name": "tools/asahi/pmp-agx-vote-tests.py --mutation begin-ignores-retry",
+   "group": "tools",
+   "argv": [
+    "python3",
+    "tools/asahi/pmp-agx-vote-tests.py",
+    "--mutation",
+    "begin-ignores-retry",
+    "--output",
+    "{output}"
+   ],
+   "expect": "pass",
+   "note": "self-checking: exits 0 when the mutant aborts"
+  },
   {
    "name": "tools/asahi/pmp-agx-vote-tests.py --mutation retry-revival",
    "group": "tools",
