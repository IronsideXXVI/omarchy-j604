From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 09:36:31 +0000
Subject: [PATCH] tools/asahi: Point the M4 PMU model test at the T8132
 entry

The model test compiles the M4 event placement code against a sysreg
model; it does not look at which SoCs use it. Check the match table as
well: apple,t6040-pmu, apple,t8132-pmu and apple,t8140-pmu must each reach
m4_pmu_init() under their own PMU name. A mutation that puts the T8132
entry on the M1 layout must be caught.

This qualifies the code path only. The counting itself on T8132 cores is
measured on the machine.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
(cherry picked from commit daf6467fe9ae2c765ed8f7c62ab9e4ce5004a39d)
(cherry picked from commit 5be90925e2d1f93623199ba1051225f94caaa220)
---
 tools/asahi/apple-m4-pmu-tests.py | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/tools/asahi/apple-m4-pmu-tests.py b/tools/asahi/apple-m4-pmu-tests.py
index ed2d988987..97239084b5 100755
--- a/tools/asahi/apple-m4-pmu-tests.py
+++ b/tools/asahi/apple-m4-pmu-tests.py
@@ -23,6 +23,9 @@ MUTATIONS = {
     'cycles-anywhere': ('\t\treturn BIT(0);\n', '\t\treturn BIT(0) | M4_PMU_CNTR_EVT;\n'),
     # Counters 8 and 9 exposed although they never count.
     'expose-8-9': ('#define M4_PMU_CNTR_EVT\t\t\tGENMASK(7, 2)', '#define M4_PMU_CNTR_EVT\t\t\tGENMASK(9, 2)'),
+    # The T8132 entry on the M1 layout instead of the M4 one.
+    't8132-m1-init': ('\tcpu_pmu->name = "apple_t8132_pmu";\n\treturn m4_pmu_init(cpu_pmu);',
+                      '\tcpu_pmu->name = "apple_t8132_pmu";\n\treturn m1_pmu_init(cpu_pmu, ARMPMU_EVT_63BIT);'),
     # Filter flags back inside the 16-bit event field.
     'flags-in-event': ('M1_PMU_CFG_COUNT_USER\t\t\t\t\t= BIT(16),', 'M1_PMU_CFG_COUNT_USER\t\t\t\t\t= BIT(8),'),
 }
@@ -128,6 +131,22 @@ int main(void)
 '''
 
 
+M4_SOCS = ('t6040', 't8132', 't8140')
+
+
+def check_of_table(source):
+    """Each M4-generation compatible must reach m4_pmu_init()."""
+    table = block(source, 'static const struct of_device_id m1_pmu_of_device_ids[] = {')
+    for soc in M4_SOCS:
+        m = re.search(r'"apple,' + soc + r'-pmu",\s*\.data = (\w+)', table)
+        if not m:
+            raise SystemExit('FAIL apple,%s-pmu is not in the match table' % soc)
+        body = function(source, m.group(1))
+        if ('"apple_%s_pmu"' % soc) not in body or 'return m4_pmu_init(cpu_pmu);' not in body:
+            raise SystemExit('FAIL apple,%s-pmu does not take the M4 layout (%s)' % (soc, m.group(1)))
+    print('PASS apple,{t6040,t8132,t8140}-pmu take m4_pmu_init and their own names')
+
+
 def main():
     parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument('--mutation', choices=sorted(MUTATIONS))
@@ -137,6 +156,7 @@ def main():
         old, new = MUTATIONS[args.mutation]
         assert source.count(old) == 1, args.mutation
         source = source.replace(old, new)
+    check_of_table(source)
     defines = '\n'.join(re.findall(r'^#define (?:M1_PMU_CFG_EVENT|M4_PMU_\w+)\b.*$', source, re.M))
     parts = [defines,
              block(source, 'enum m1_pmu_events {'),
