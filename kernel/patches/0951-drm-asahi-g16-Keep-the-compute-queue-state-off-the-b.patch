+/// `g16_compute_queues`: the newest published target and ring head and the registration of
+/// compute queues 1.. (index 0 unused: queue 0 keeps Engine's `target`, `head` and
+/// `queue_registered`), their last ordinals (queue 0 keeps `ordinal`, see
+/// [`cqueue::last_ordinal`]), the queue of the latest compute publication, compute publications
+/// per queue, placements that waited for running work to retire, and the stage stamps of queues
+/// 1.. captured with the recovery snapshot. `g16_cq_split_us`: one entry per client (VM slot) and
+/// the placements that kept a queue.
+pub(crate) struct ComputeQueues {
+    pub(crate) target: [u32; QUEUES_MAX],
+    pub(crate) ordinal: [u64; QUEUES_MAX],
+    pub(crate) head: [u32; QUEUES_MAX],
+    pub(crate) registered: [bool; QUEUES_MAX],
+    pub(crate) last: usize,
+    pub(crate) published: [u64; QUEUES_MAX],
+    pub(crate) waits: u64,
+    pub(crate) clients: KVec<cqueue::Client>,
+    pub(crate) kept: u64,
+    pub(crate) stage: [u32; QUEUES_MAX],
+}
+
+/// Built in its own frame, so that its by-value image never joins the boot path's frames.
+#[inline(never)]
+fn new_compute_queues() -> Result<KBox<ComputeQueues>> {
+    let clients = KVec::from_elem(cqueue::Client::NONE, cqueue::CLIENTS, GFP_KERNEL)?;
+    KBox::new(
+        ComputeQueues {
+            target: [0; QUEUES_MAX],
+            ordinal: [0; QUEUES_MAX],
+            head: [0; QUEUES_MAX],
+            registered: [false; QUEUES_MAX],
+            last: 0,
+            published: [0; QUEUES_MAX],
+            waits: 0,
+            clients,
+            kept: 0,
+            stage: [0; QUEUES_MAX],
+        },
+        GFP_KERNEL,
+    )
+    .map_err(|_| ENOMEM)
+}
+
