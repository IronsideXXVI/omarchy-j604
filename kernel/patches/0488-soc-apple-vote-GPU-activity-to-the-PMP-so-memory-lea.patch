diff --git a/drivers/gpu/drm/asahi/gpu.rs b/drivers/gpu/drm/asahi/gpu.rs
index 84d82bb188..60acb7a2d5 100644
--- a/drivers/gpu/drm/asahi/gpu.rs
+++ b/drivers/gpu/drm/asahi/gpu.rs
@@ -1284,6 +1284,9 @@ impl GpuManager::ver {
             .with(|raw, _inner| raw.pending_submissions.fetch_add(1, Ordering::Acquire));
 
         mod_dev_dbg!(self.dev, "OP start (pending: {})\n", val + 1);
+        // SAFETY: Takes no arguments and does nothing unless pmp_report.agx_vote is set on a T6001. The matching end call is made
+        // by OpGuard's Drop, and the guard is created right below, so every path out of here (including a failed kick) pairs it.
+        unsafe { kernel::bindings::apple_pmp_agx_activity_begin() };
         let guard = OpGuard(self.clone());
         self.kick_firmware()?;
         Ok(guard)
@@ -1804,5 +1807,7 @@ impl GpuManagerPriv for GpuManager::ver {
             .with(|raw, _inner| raw.pending_submissions.fetch_sub(1, Ordering::Release));
 
         mod_dev_dbg!(self.dev, "OP end (pending: {})\n", val - 1);
+        // SAFETY: Pairs with the begin call in start_op(); callable from any context.
+        unsafe { kernel::bindings::apple_pmp_agx_activity_end() };
     }
 }
diff --git a/drivers/pmdomain/apple/pmp-agx-vote.h b/drivers/pmdomain/apple/pmp-agx-vote.h
new file mode 100644
index 0000000000..70ad71c514
--- /dev/null
+++ b/drivers/pmdomain/apple/pmp-agx-vote.h
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * When the T6001 AGX request (PS-REQ bit 9 of the PMP report) is set and cleared.
+ *
+ * The GPU driver counts operations in flight (begin/end). The request is set when the first operation starts and cleared
+ * idle_ms after the last one ends, so a decode stream (a burst every ~10 ms) holds one vote and an idle GPU drops it. All state
+ * changes are in these functions; the caller serializes them with one spinlock and does the register write between
+ * agx_vote_decide() and agx_vote_applied(). Times are milliseconds from any wrapping clock.
+ */
+#ifndef PMP_AGX_VOTE_H
+#define PMP_AGX_VOTE_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+/* jiffies_to_msecs() returns u32: the clock wraps every 49.7 days, and every compare below is done in 32 bits. */
+typedef u32 agx_ms_t;
+typedef s32 agx_sms_t;
+#else
+#include <stdbool.h>
+#include <stdint.h>
+typedef uint32_t agx_ms_t;
+typedef int32_t agx_sms_t;
+#endif
+
+/* After a set that was not acknowledged (or a PMP that is not running), wait this long before trying again. */
+#define AGX_VOTE_RETRY_MS 1000
+
+struct agx_vote {
+	bool enabled;		/* the module parameter */
+	bool voted;		/* bit 9 is set and was acknowledged */
+	unsigned int users;	/* GPU operations in flight */
+	agx_ms_t idle_ms;	/* keep the vote this long after the last operation ends */
+	agx_ms_t idle_at;	/* when users last fell to 0 */
+	unsigned int failures;	/* consecutive failed sets; the backoff applies only while this is nonzero */
+	agx_ms_t retry_at;	/* with failures: no new set before this */
+};
+
+enum agx_vote_action {
+	AGX_VOTE_NONE,
+	AGX_VOTE_SET,
+	AGX_VOTE_CLEAR,
+};
+
+static inline bool agx_vote_reached(agx_ms_t now, agx_ms_t t)
+{
+	return (agx_sms_t)(now - t) >= 0;
+}
+
+/* An operation starts. True: run the reconcile step now. */
+static inline bool agx_vote_begin(struct agx_vote *v)
+{
+	v->users++;
+	return v->enabled && !v->voted;
+}
+
+/* An operation ends. Returns the delay in ms after which the reconcile step must run, 0 when none is needed. */
+static inline agx_ms_t agx_vote_end(struct agx_vote *v, agx_ms_t now)
+{
+	if (!v->users)		/* unbalanced end: ignored */
+		return 0;
+	if (--v->users)
+		return 0;
+	v->idle_at = now;
+	if (!v->enabled || !v->voted)
+		return 0;
+	return v->idle_ms ? v->idle_ms : 1;
+}
+
+/* What the reconcile step must do now. */
+static inline enum agx_vote_action agx_vote_decide(const struct agx_vote *v, agx_ms_t now)
+{
+	if (!v->enabled)
+		return v->voted ? AGX_VOTE_CLEAR : AGX_VOTE_NONE;
+	if (v->users)
+		return !v->voted && (!v->failures || agx_vote_reached(now, v->retry_at)) ? AGX_VOTE_SET : AGX_VOTE_NONE;
+	if (v->voted && agx_vote_reached(now, v->idle_at + v->idle_ms))
+		return AGX_VOTE_CLEAR;
+	return AGX_VOTE_NONE;
+}
+
+/* Delay in ms until the reconcile step must run again, 0 when no timer is needed. */
+static inline agx_ms_t agx_vote_next(const struct agx_vote *v, agx_ms_t now)
+{
+	agx_ms_t at;
+
+	if (!v->enabled)
+		return 0;
+	if (v->users && !v->voted && v->failures)
+		at = v->retry_at;
+	else if (!v->users && v->voted)
+		at = v->idle_at + v->idle_ms;
+	else
+		return 0;
+	return agx_vote_reached(now, at) ? 0 : at - now;
+}
+
+/* Record the outcome of the register write for `action` (ret 0: acknowledged). */
+static inline void agx_vote_applied(struct agx_vote *v, enum agx_vote_action action, int ret, agx_ms_t now)
+{
+	if (action == AGX_VOTE_SET) {
+		if (ret) {
+			v->failures++;
+			v->retry_at = now + AGX_VOTE_RETRY_MS;
+		} else {
+			v->voted = true;
+			v->failures = 0;
+		}
+	} else if (action == AGX_VOTE_CLEAR) {
+		v->voted = false;	/* the write was made; the caller logs an unacknowledged clear */
+	}
+}
+
+/* The GPU driver unbinds: drop the vote now. True when bit 9 is set and the caller must write the clear. */
+static inline bool agx_vote_release(struct agx_vote *v)
+{
+	bool was_voted = v->voted;
+
+	v->voted = false;
+	return was_voted;
+}
+
+#endif /* PMP_AGX_VOTE_H */
diff --git a/drivers/pmdomain/apple/pmp-report.c b/drivers/pmdomain/apple/pmp-report.c
index 4b3ce3c656..e29dce40b8 100644
--- a/drivers/pmdomain/apple/pmp-report.c
+++ b/drivers/pmdomain/apple/pmp-report.c
@@ -31,6 +31,7 @@
 #include <linux/uuid.h>
 #include <linux/workqueue.h>
 
+#include "pmp-agx-vote.h"
 #include "pmp-report-validation.h"
 
 #define PMP_REPORT_READY 0x1
@@ -80,6 +81,18 @@ struct apple_pmp_report {
 };
 
 static const struct apple_pmp_report_offsets apple_pmp_offsets_t6030;
+static const struct apple_pmp_report_offsets apple_pmp_offsets_t600x;
+
+/* T6001 AGX request (see the engine below set_state): AGX is soc-device record 9 on the T6001. */
+#define APPLE_PMP_T6001_AGX_ID 9
+static bool agx_vote;
+static struct agx_vote apple_pmp_agx_vote_state = {.idle_ms = 100};
+static DEFINE_SPINLOCK(apple_pmp_agx_vote_lock);
+/* Serializes the vote work, the unbind release and the report's removal. */
+static DEFINE_MUTEX(apple_pmp_agx_vote_mutex);
+static void apple_pmp_agx_vote_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(apple_pmp_agx_vote_work, apple_pmp_agx_vote_fn);
+static void apple_pmp_agx_vote_stop(void);
 
 /* Bound report regions, protected by RCU until managed teardown drains readers. */
 static LIST_HEAD(apple_pmp_reports);
@@ -168,6 +181,11 @@ static void apple_pmp_report_release(void *data)
 
 	/* Withdraw child providers while their power callbacks can still use MMIO. */
 	of_platform_depopulate(rep->dev);
+	if (rep->offsets == &apple_pmp_offsets_t600x) {
+		cancel_delayed_work_sync(&apple_pmp_agx_vote_work);
+		guard(mutex)(&apple_pmp_agx_vote_mutex);
+		apple_pmp_agx_vote_stop();
+	}
 	mutex_lock(&apple_pmp_reports_lock);
 	if (!list_empty(&rep->list))
 		list_del_rcu(&rep->list);
@@ -1314,6 +1332,160 @@ static int apple_pmp_report_set_state(struct apple_pmp_report *rep, u32 id,
 		50000);
 }
 
+/*
+ * T6001 AGX request. T2 showed that setting PS-REQ bit 9 (AGX, soc-device record 9) lifts the GPU read roof from 241 to 368 GB/s: the PMP
+ * leaves memory at its idle floor for a GPU that is busy but has not asked. The GPU driver reports operations in flight
+ * (apple_pmp_agx_activity_begin/end); the request is set while any operation runs and cleared agx_vote_idle_ms after the last one ends, at
+ * GPU unbind and when this report goes away. The decisions are in pmp-agx-vote.h (unit tested); this is the glue.
+ * Off by default (pmp_report.agx_vote): with it off nothing is written.
+ */
+static unsigned int agx_vote_idle_ms = 100;
+
+static agx_ms_t apple_pmp_agx_now_ms(void)
+{
+	return jiffies_to_msecs(jiffies);
+}
+
+static void apple_pmp_agx_vote_kick(unsigned long delay_ms)
+{
+	mod_delayed_work(system_wq, &apple_pmp_agx_vote_work, msecs_to_jiffies(delay_ms));
+}
+
+static int apple_pmp_agx_vote_param_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	if (!ret)
+		apple_pmp_agx_vote_kick(0);	/* switching off clears at once, switching on votes if the GPU is busy */
+	return ret;
+}
+
+static const struct kernel_param_ops apple_pmp_agx_vote_ops = {
+	.set = apple_pmp_agx_vote_param_set,
+	.get = param_get_bool,
+};
+module_param_cb(agx_vote, &apple_pmp_agx_vote_ops, &agx_vote, 0644);
+MODULE_PARM_DESC(agx_vote, "T6001: set the AGX power request in the PMP report while the GPU has work in flight (default: off)");
+module_param(agx_vote_idle_ms, uint, 0644);
+MODULE_PARM_DESC(agx_vote_idle_ms, "Keep the AGX request this many ms after the last GPU operation ends (default: 100)");
+
+/* Write the AGX request of the bound T6001 report: -ENODEV without one, -EAGAIN (nothing written) when the PMP does not run. */
+static int apple_pmp_agx_write(bool enable, bool no_ack)
+{
+	struct apple_pmp_report *rep;
+	int ret = -ENODEV;
+
+	if (!of_machine_is_compatible("apple,t6001"))
+		return ret;
+	rcu_read_lock();
+	list_for_each_entry_rcu(rep, &apple_pmp_reports, list) {
+		if (rep->offsets != &apple_pmp_offsets_t600x)
+			continue;
+		if (enable && !(readq(rep->base + rep->offsets->status) & PMP_REPORT_READY))
+			ret = -EAGAIN;
+		else
+			ret = apple_pmp_report_set_state(rep, APPLE_PMP_T6001_AGX_ID, enable, no_ack);
+		break;
+	}
+	rcu_read_unlock();
+	return ret;
+}
+
+/* Clear a request that is still set. Caller holds apple_pmp_agx_vote_mutex. */
+static void apple_pmp_agx_vote_stop(void)
+{
+	unsigned long flags;
+	bool voted;
+
+	spin_lock_irqsave(&apple_pmp_agx_vote_lock, flags);
+	voted = agx_vote_release(&apple_pmp_agx_vote_state);
+	spin_unlock_irqrestore(&apple_pmp_agx_vote_lock, flags);
+	if (voted)
+		apple_pmp_agx_write(false, true);
+}
+
+static void apple_pmp_agx_vote_fn(struct work_struct *work)
+{
+	struct agx_vote *v = &apple_pmp_agx_vote_state;
+	enum agx_vote_action act;
+	unsigned long flags;
+	agx_ms_t now, next = 0;
+	int ret = 0;
+
+	guard(mutex)(&apple_pmp_agx_vote_mutex);
+	spin_lock_irqsave(&apple_pmp_agx_vote_lock, flags);
+	v->enabled = READ_ONCE(agx_vote);
+	v->idle_ms = READ_ONCE(agx_vote_idle_ms);
+	now = apple_pmp_agx_now_ms();
+	act = agx_vote_decide(v, now);
+	spin_unlock_irqrestore(&apple_pmp_agx_vote_lock, flags);
+
+	if (act != AGX_VOTE_NONE) {
+		const bool set = act == AGX_VOTE_SET;
+
+		ret = apple_pmp_agx_write(set, false);
+		if (ret == -ETIMEDOUT) {
+			pr_err("pmp_report: AGX request %s not acknowledged, clearing\n", set ? "set" : "clear");
+			apple_pmp_agx_write(false, true);
+		}
+		if (!set)
+			ret = 0;	/* a clear is final: the state is "not voted" whatever happened */
+		spin_lock_irqsave(&apple_pmp_agx_vote_lock, flags);
+		agx_vote_applied(v, act, ret, now);
+		next = agx_vote_next(v, apple_pmp_agx_now_ms());
+		spin_unlock_irqrestore(&apple_pmp_agx_vote_lock, flags);
+	} else {
+		spin_lock_irqsave(&apple_pmp_agx_vote_lock, flags);
+		next = agx_vote_next(v, now);
+		spin_unlock_irqrestore(&apple_pmp_agx_vote_lock, flags);
+	}
+	if (next)
+		apple_pmp_agx_vote_kick(next);
+}
+
+void apple_pmp_agx_activity_begin(void)
+{
+	struct agx_vote *v = &apple_pmp_agx_vote_state;
+	unsigned long flags;
+	bool kick;
+
+	spin_lock_irqsave(&apple_pmp_agx_vote_lock, flags);
+	v->enabled = READ_ONCE(agx_vote);
+	kick = agx_vote_begin(v);
+	spin_unlock_irqrestore(&apple_pmp_agx_vote_lock, flags);
+	if (kick)
+		apple_pmp_agx_vote_kick(0);
+}
+EXPORT_SYMBOL_GPL(apple_pmp_agx_activity_begin);
+
+void apple_pmp_agx_activity_end(void)
+{
+	struct agx_vote *v = &apple_pmp_agx_vote_state;
+	unsigned long flags;
+	agx_ms_t delay;
+
+	spin_lock_irqsave(&apple_pmp_agx_vote_lock, flags);
+	v->enabled = READ_ONCE(agx_vote);
+	v->idle_ms = READ_ONCE(agx_vote_idle_ms);
+	delay = agx_vote_end(v, apple_pmp_agx_now_ms());
+	spin_unlock_irqrestore(&apple_pmp_agx_vote_lock, flags);
+	if (delay)
+		apple_pmp_agx_vote_kick(delay);
+}
+EXPORT_SYMBOL_GPL(apple_pmp_agx_activity_end);
+
+/*
+ * The GPU driver unbinds: clear the request now instead of waiting out the idle time, so it is never left set past the GPU's
+ * power-domain release (the T6030 fix clears before it releases its vote). Process context.
+ */
+void apple_pmp_agx_activity_release(void)
+{
+	cancel_delayed_work_sync(&apple_pmp_agx_vote_work);
+	guard(mutex)(&apple_pmp_agx_vote_mutex);
+	apple_pmp_agx_vote_stop();
+}
+EXPORT_SYMBOL_GPL(apple_pmp_agx_activity_release);
+
 /* Find and check the report before taking the GPU vote; optionally update it. */
 static int apple_pmp_report_t6030_gfx(struct device *supplier, const bool *enable)
 {
diff --git a/include/linux/soc/apple/pmp-report.h b/include/linux/soc/apple/pmp-report.h
index 1d0689f31c..7fb5327a7b 100644
--- a/include/linux/soc/apple/pmp-report.h
+++ b/include/linux/soc/apple/pmp-report.h
@@ -21,7 +21,27 @@ int apple_pmp_report_set_t6030_gfx(struct device *supplier, bool enable);
 int apple_pmp_report_wait_ready(struct device_node *entry, unsigned long timeout);
 int apple_pmp_report_fast_die_effort(const struct device_node *np,
 				     unsigned int lane, u8 *effort);
+/*
+ * T6001: the GPU driver reports each operation in flight. With the pmp_report.agx_vote parameter set, the AGX request (PS-REQ bit 9) is
+ * set while any operation runs and cleared agx_vote_idle_ms after the last one ends. Parameter off: no effect. Both may be called from
+ * any context. release() clears the request at once (GPU driver unbind), process context.
+ */
+void apple_pmp_agx_activity_begin(void);
+void apple_pmp_agx_activity_end(void);
+void apple_pmp_agx_activity_release(void);
 #else
+static inline void apple_pmp_agx_activity_begin(void)
+{
+}
+
+static inline void apple_pmp_agx_activity_end(void)
+{
+}
+
+static inline void apple_pmp_agx_activity_release(void)
+{
+}
+
 static inline int apple_pmp_report_wait_supplier_ready(struct device *supplier,
 						unsigned int timeout_ms)
 {
diff --git a/rust/bindings/bindings_helper.h b/rust/bindings/bindings_helper.h
index acc2d82a10..b97b2965d9 100644
--- a/rust/bindings/bindings_helper.h
+++ b/rust/bindings/bindings_helper.h
@@ -109,6 +109,7 @@
 #include <linux/soc/apple/pmp-display.h>
 #include <linux/soc/apple/rtkit.h>
 #include <linux/soc/apple/pmp.h>
+#include <linux/soc/apple/pmp-report.h>
 #include <linux/suspend.h>
 #include <linux/sys_soc.h>
 #include <linux/task_work.h>
