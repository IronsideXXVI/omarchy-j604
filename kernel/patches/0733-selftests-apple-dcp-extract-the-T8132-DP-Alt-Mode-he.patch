From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 20:15:12 +0000
Subject: [PATCH] selftests: apple-dcp: extract the T8132 DP Alt Mode helpers

The DP Alt Mode series for T8132 Type-C ports split two decisions out of
functions these host tests extract, and the extracted code no longer
compiled: atcphy_typec_target_mode() and atcphy_mux_check() now ask
atcphy_t8132_dp_lanes(), and dcp_typec_route_set() and
dcp_typec_route_deactivate() call dcp_typec_route_t8132(),
dcp_typec_route_dp_alt() and dcp_typec_connect_sink(). Every unit built
on the ATC mux or the actual DCP route set failed with an implicit
declaration (31 of 87).

Extract atcphy_t8132_dp_lanes() with the mode mapping and the mux check
(older sources have none and get nothing), and give the quiesce PHY the
t8132_ss field it reads (false: an ordinary port). Extract
dcp_typec_dp_four_lanes(), dcp_typec_route_dp_alt() and
dcp_typec_connect_sink() as they are, over the real
dcp_fabric_t8132_dp_alt() the units already compile. Only the dcpext
compatible, the lanes apple_atc_dp_alt_lanes() reports and the dcpext's
reconnect work are fixture state, counted; by default no route is a
dcpext, so the PHY is never asked and every scenario runs as before.
Sources without these helpers keep the old dcp_typec_route_no_dp_alt()
shim.

Add t8132-dp-alt-routing: on a T8132 dcpext route, pin assignment C
without DP calibration and pin D with it are taken as applied and not
routed, and calibrated pin E takes the route and connects through the
dcpext's reconnect work (tries reset), never through the DPTX connect of
a connector the dcpext does not have.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 .../selftests/drivers/gpu/apple-dcp/common.py |  5 +-
 .../drivers/gpu/apple-dcp/quiesce.py          |  4 +-
 .../drivers/gpu/apple-dcp/transaction.py      | 49 +++++++++++++++++++
 3 files changed, 55 insertions(+), 3 deletions(-)

diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/common.py b/tools/testing/selftests/drivers/gpu/apple-dcp/common.py
index ab355c6fcd..2d46493f35 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/common.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/common.py
@@ -163,7 +163,10 @@ def atc_mux_without_pm(source):
 
     The PM fixtures replace only this adapter with the actual mux update/callback.
     """
-    mapping = block(source, 'static enum atcphy_mode atcphy_typec_target_mode(')
+    # T8132 DP Alt Mode: the mode mapping and the mux check ask whether the PHY
+    # runs four DP lanes; older sources have no such helper (atc_function: '').
+    mapping = (atc_function(source, 'atcphy_t8132_dp_lanes') +
+               block(source, 'static enum atcphy_mode atcphy_typec_target_mode('))
     locked = block(source, 'static int atcphy_mux_set_locked(')
     if 'static int atcphy_mux_switch(' not in source:
         return mapping + '\n' + locked + r'''
diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/quiesce.py b/tools/testing/selftests/drivers/gpu/apple-dcp/quiesce.py
index 189f86dde9..26c9d86e44 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/quiesce.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/quiesce.py
@@ -128,7 +128,7 @@ static void gpiod_set_value_cansleep(void *p,int v) { (void)p;assert(v==1);gpio_
  if not parent:functions+=block(core,'static void tps6598x_drop_partner(')+'\n'+block(core,'static int tps6598x_set_data_role(')+'\n'
  # The fixed-hub SuperSpeed handover moved the locked mux body to atcphy_mux_switch();
  # atcphy_mux_set_locked() also reports whether a SuperSpeed port may come back up.
- split=[atc_cio_helpers(atc)]+[atc_function(atc,name) for name in ('atcphy_usb3_port_ready','atcphy_mux_check','atcphy_mux_park','atcphy_mux_switch')]
+ split=[atc_cio_helpers(atc)]+[atc_function(atc,name) for name in ('atcphy_t8132_dp_lanes','atcphy_usb3_port_ready','atcphy_mux_check','atcphy_mux_park','atcphy_mux_switch')]
  functions+=block(core,'static '+('void' if parent else 'int')+' tps6598x_disconnect(')+'\n'+block(core,'static '+('void' if parent else 'int')+' cd321x_remove(')+'\n'+block(core,'void tipd_remove(')+'\n'
  ordinary_phy=r'''
 /* Actual ordinary-port ATC power-off, mux recheck and USB2 init; MMIO leaves. */
@@ -148,7 +148,7 @@ struct apple_atcphy {
  const struct atcphy_hw *hw;
  struct { void *usb2phy; } regs;
  bool fixed_usb2,host_active,mode_dirty,pipe_pending,usb_off_pending,ss_tunables,dp_tunables,cio_tunables;
- bool usb3_port_off,park_owed,dp_only,pd_was_off;
+ bool usb3_port_off,park_owed,dp_only,pd_was_off,t8132_ss;
  bool t8103_dummy_pending,t8103_usb3_retry,t8103_usb3_workaround;
  enum atcphy_mode mode,typec_mode;
  enum atcphy_pipehandler_state pipe_state;
diff --git a/tools/testing/selftests/drivers/gpu/apple-dcp/transaction.py b/tools/testing/selftests/drivers/gpu/apple-dcp/transaction.py
index b41f7e2f80..15bf7bffd1 100644
--- a/tools/testing/selftests/drivers/gpu/apple-dcp/transaction.py
+++ b/tools/testing/selftests/drivers/gpu/apple-dcp/transaction.py
@@ -114,6 +114,27 @@ static int mux_control_deselect(struct mux_control *m) { (void)m;event('C');xbar
     static int __attribute__((unused)) dcp_dptx_recover_irq(struct apple_dcp *d) { (void)d;assert(!"IRQ_HPD recovery");return -EINVAL; }
     static int __attribute__((unused)) of_property_read_string(void *np,const char *name,const char **out) { (void)np;(void)name;(void)out;return -EINVAL; }
     '''+''.join(apple_function(ROOT,name) for name in ('apple_connector_invalidate_edid','apple_connector_set_pipeline','dcp_modes_end_typec','dcp_typec_port_busy'))
+    # T8132 DP Alt Mode split the route's DP alt decision and the sink connect
+    # out of dcp_typec_route_set(). They are extracted as they are; only the
+    # dcpext compatible, the lanes the port's PHY reports and the dcpext's
+    # reconnect work are fixture state (counted). Default: no dcpext, so every
+    # route takes DP alt mode and the PHY is never asked.
+    x2=('static bool dcp_typec_route_t8132(const struct apple_dcp_typec_route *route)' in dcp and
+        'static void dcp_typec_connect_sink(struct apple_dcp *dcp)' in dcp)
+    if x2:
+        extra=extra.replace('static bool dcp_typec_route_no_dp_alt(const struct apple_dcp_typec_route *route) { (void)route; return false; }',
+            r'''static bool t8132_dcpext;
+    static int dp_alt_lanes=-ENOENT,lane_calls,reconnect_calls;
+    static bool dcp_typec_route_t8132(const struct apple_dcp_typec_route *route) { (void)route;return t8132_dcpext; }
+    static bool dcp_is_t8132_ext(const struct apple_dcp *d) { (void)d;return t8132_dcpext; }
+    static int apple_atc_dp_alt_lanes(void *phy) { (void)phy;assert(t8132_dcpext);lane_calls++;return dp_alt_lanes; }
+    static void dcp_queue_typec_reconnect(struct apple_dcp *d,unsigned long delay) { assert(t8132_dcpext&&!d->typec_connector&&!delay);reconnect_calls++; }''',1)
+        assert 'dcp_typec_route_no_dp_alt' not in extra
+        extra=extra.replace('    #define TYPEC_DP_STATE_F 15\n','    #define TYPEC_DP_STATE_C 12\n    #define TYPEC_DP_STATE_D 13\n    #define TYPEC_DP_STATE_E 14\n    #define TYPEC_DP_STATE_F 15\n',1)
+        actual=actual.replace('struct apple_dcp { int external_lock,external_error;','struct apple_dcp { int external_lock,external_error;\n     int typec_reconnect_tries;',1)
+        extra+=''.join(block(dcp,marker)+'\n' for marker in (
+            'static bool dcp_typec_dp_four_lanes(', 'static enum dcp_fabric_t8132_dp_alt\ndcp_typec_route_dp_alt(',
+            'static void dcp_typec_connect_sink('))
     pos=actual.index('static int dcp_typec_route_deactivate(')
     actual=actual[:pos]+extra+actual[pos:]
     # The fabric core split: availability is the real dcp_fabric_available() over
@@ -186,6 +207,32 @@ static int late_finish_error(struct typec_mux_dev *m,struct typec_mux_state *s)
       assert(port.owner==&route&&port.safe_pending&&!port.safe_finish_ready&&route.selected&&route.deactivate_xbar_done&&route.deactivate_error==-EIO);
       xbar_error=0;assert(typec_mux_set(&mux,&safe)==-EIO&&port.owner==&route&&port.safe_pending&&xbar_calls==1);
      }
+     if(argv[1][0]=='p') {
+#ifdef T8132_DP_ALT_FIXTURE
+      /* T8132 dcpext: DP Alt Mode only on four calibrated lanes (pin C/E). */
+      assert(typec_mux_set(&mux,&safe)==0&&!port.owner&&lane_calls==0);
+      t8132_dcpext=true;display.typec_connector=NULL;display.typec_cable_connected=false;display.typec_reconnect_tries=7;
+      struct typec_altmode alt={.svid=USB_TYPEC_DP_SID};
+      struct typec_displayport_data data={.status=DP_STATUS_HPD_STATE};
+      struct typec_mux_state c={.alt=&alt,.mode=TYPEC_DP_STATE_C,.data=&data},d=c,e=c;
+      d.mode=TYPEC_DP_STATE_D;e.mode=TYPEC_DP_STATE_E;
+      dp_alt_lanes=0;
+      int ret=typec_mux_set(&mux,&c);
+      fprintf(stderr,"pin C, no DP calibration: ret=%d lanes=%d owner=%p wanted=%d reconnects=%d\n",ret,lane_calls,(void *)port.owner,port.dp_wanted,reconnect_calls);
+      assert(ret==0&&lane_calls>=1&&!port.owner&&!port.dp_wanted&&!reconnect_calls&&!connect_calls);
+      dp_alt_lanes=4;lane_calls=0;
+      ret=typec_mux_set(&mux,&d);
+      fprintf(stderr,"pin D, calibrated: ret=%d lanes=%d owner=%p wanted=%d reconnects=%d\n",ret,lane_calls,(void *)port.owner,port.dp_wanted,reconnect_calls);
+      assert(ret==0&&lane_calls>=1&&!port.owner&&!port.dp_wanted&&!reconnect_calls&&!connect_calls);
+      lane_calls=0;
+      ret=typec_mux_set(&mux,&e);
+      fprintf(stderr,"pin E, calibrated: ret=%d lanes=%d owner=%p wanted=%d reconnects=%d tries=%d\n",ret,lane_calls,(void *)port.owner,port.dp_wanted,reconnect_calls,display.typec_reconnect_tries);
+      assert(ret==0&&lane_calls>=1&&port.owner==&route&&port.dp_wanted&&reconnect_calls==1&&!display.typec_reconnect_tries&&display.typec_cable_connected&&!connect_calls);
+      puts("PASS T8132 dcpext DP alt: uncalibrated C and pin D not routed, calibrated E routed and connected from the reconnect work");
+#else
+      assert(!"no T8132 DP alt fixture in this source");
+#endif
+     }
      if(argv[1][0]=='f') {
       mux.mux_devs[0]=&display_provider;mux.mux_devs[1]=&phy_provider;phy_provider.finish=late_finish_error;
       assert(typec_mux_set(&mux,&safe)==-EIO);
@@ -206,6 +253,8 @@ static int late_finish_error(struct typec_mux_dev *m,struct typec_mux_state *s)
     check('provider-order-releases-failed-lease',actual,(('release',),))
     check('failed-safe-allows-new-dp-admission',actual,(('dp',),))
     check('altmode-safe-skips-quiescence',actual,(('altmode',),))
+    if x2:
+        check('t8132-dp-alt-routing','#define T8132_DP_ALT_FIXTURE 1\n'+actual,(('pin',),))
 
     # Real pthread fabric/consumer mutexes. Pause the SAFE actor after its actual
     # DCP prepare has returned and released its locks, before any set callback.
