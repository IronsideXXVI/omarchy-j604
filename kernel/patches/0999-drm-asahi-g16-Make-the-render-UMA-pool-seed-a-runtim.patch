From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 21 Nov 2026 23:13:50 +0000
Subject: [PATCH] drm/asahi: g16: Make the render UMA pool seed a
 runtime switch

Every render unit that builds its own UMA pool allocates 32 MiB and
seeds all 8192 pages into the free list at build time, so the pool is
fully backed before the firmware takes a single page. Hyprland and
quickshell each keep one such pool, which is 64 MiB of the idle
desktop's GPU memory.

Add g16_uma_seed_pages (runtime 0644, default 8192). A unit built while
it is set backs and seeds only that many pages: the pool allocation, the
free-page entries, the 2 MiB page-list rows and the descriptor counts at
+0x24/+0x2c all follow it. Only whole rows are accepted (a multiple of
512 from 512 to 8192); any other value reads as 8192. Units already
built keep their seed.

The default keeps today's layout byte for byte. 2048 (8 MiB per pool)
is the value to try. It frees 48 MiB on the desktop if the firmware
never draws past it, and the pool's use at retirement says whether it
does.
---
 drivers/gpu/drm/asahi/g16/fw/buffer.rs |  6 ++++--
 drivers/gpu/drm/asahi/g16/params.rs    | 25 +++++++++++++++++++++++++
 drivers/gpu/drm/asahi/g16/pools.rs     |  7 +++++--
 drivers/gpu/drm/asahi/g16/slots.rs     | 10 ++++++----
 4 files changed, 40 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/fw/buffer.rs b/drivers/gpu/drm/asahi/g16/fw/buffer.rs
index 8c340e93ec3..3197bed9aab 100644
--- a/drivers/gpu/drm/asahi/g16/fw/buffer.rs
+++ b/drivers/gpu/drm/asahi/g16/fw/buffer.rs
@@ -120,6 +120,7 @@ pub(crate) fn uma_manager_image(
     state_gpu: u64,
     list_gpu: u64,
     submitted_fw: u64,
+    seed: u32,
 ) -> [u8; uma_manager::SIZE] {
     let mut m = [0; uma_manager::SIZE];
     put64(&mut m, 0, descriptor);
@@ -127,8 +128,8 @@ pub(crate) fn uma_manager_image(
     put32(&mut m, 0x10, 2);
     put64(&mut m, 0x14, state_gpu);
     put32(&mut m, 0x1c, 16384);
-    put32(&mut m, 0x24, 8192);
-    put32(&mut m, 0x2c, 8192);
+    put32(&mut m, 0x24, seed);
+    put32(&mut m, 0x2c, seed);
     put64(&mut m, 0x30, list_gpu);
     put32(&mut m, 0x40, 4);
     put32(&mut m, 0x48, 128);
@@ -196,6 +197,7 @@ fn exact_m4_uma_and_lists() {
             0x7012000000,
             0x7012020000,
             0xfffffc2000700000,
+            8192,
         );
         assert_eq!(r64(&m, 0), 0xfffffc2000400000);
         assert_eq!(r32(&m, 8), 33);
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 57df446cc4e..8ad5df6e4a4 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2963,6 +2963,31 @@ pub(crate) fn pb_pool() -> u32 {
     "G16: PB managers a VM keeps for reuse instead of building one per render command in SUBMIT (default 8; 0: one per command, as before; max 16; runtime 0644)"
 );
 
+/// Storage of `g16_uma_seed_pages` (runtime 0644, default 8192; read when a render unit
+/// builds its own UMA pool).
+static UMA_SEED_PAGES: AtomicU32 = AtomicU32::new(8192);
+
+/// 4 KiB pages seeded into a render unit's private UMA pool, which is also the pool's
+/// backing (pages x 4 KiB). The firmware takes free pages from the descriptor counts at
+/// +0x24/+0x2c and from the 2 MiB rows of the page list, so only whole rows are accepted:
+/// a multiple of 512 from 512 to 8192. Any other value reads as 8192. Read when the unit
+/// is built, so units built before the switch was set keep their seed.
+pub(crate) fn uma_seed_pages() -> u32 {
+    match UMA_SEED_PAGES.load(Ordering::Relaxed) {
+        v @ 512..=8192 if v % 512 == 0 => v,
+        _ => 8192,
+    }
+}
+
+live_u32_param!(
+    UMA_SEED_PAGES_PARAM,
+    UMA_SEED_PAGES_PARMTYPE,
+    UMA_SEED_PAGES_PARM,
+    UMA_SEED_PAGES,
+    "g16_uma_seed_pages",
+    "G16: 4 KiB pages seeded into each render unit's private UMA pool, whole 2 MiB rows, 512..8192 (default 8192 = 32 MiB; read when a unit builds its pool)"
+);
+
 /// Storage of `g16_unit_one_pool` (runtime 0644, default 1; read when a unit is built).
 static UNIT_ONE_POOL: AtomicU32 = AtomicU32::new(1);
 
diff --git a/drivers/gpu/drm/asahi/g16/pools.rs b/drivers/gpu/drm/asahi/g16/pools.rs
index 26f54bcaef7..360ab4ffa4a 100644
--- a/drivers/gpu/drm/asahi/g16/pools.rs
+++ b/drivers/gpu/drm/asahi/g16/pools.rs
@@ -486,9 +486,11 @@ fn new(o: &mut Objects, k: u64, compact: bool) -> Result<Self> {
             nc(at(client::render_descriptor(k), 0x2030000)),
             false,
         )?;
+        // g16_uma_seed_pages: the pool is backed only as far as it is seeded.
+        let seed = super::params::uma_seed_pages();
         let pool = alloc(
             o,
-            0x2000000,
+            seed as usize * 0x1000,
             Class::Shared,
             nc(at(client::render_pool(k), 0)),
             false,
@@ -537,7 +539,7 @@ fn new(o: &mut Objects, k: u64, compact: bool) -> Result<Self> {
             nc(base + 0x2070000),
             true,
         )?;
-        super::slots::init_uma_pool(&state, &list, gva(&pool)?)?;
+        super::slots::init_uma_pool(&state, &list, gva(&pool)?, seed as usize)?;
         let uma_slot = lifetime::uma_slot(engine::RENDER_UMA_SLOT, k as usize);
         descriptor.write(
             0,
@@ -547,6 +549,7 @@ fn new(o: &mut Objects, k: u64, compact: bool) -> Result<Self> {
                 gva(&state)?,
                 gva(&list)?,
                 submitted.va,
+                seed,
             ),
         )?;
         Ok(Self {
diff --git a/drivers/gpu/drm/asahi/g16/slots.rs b/drivers/gpu/drm/asahi/g16/slots.rs
index e0caf9778f2..29b2ad6cabb 100644
--- a/drivers/gpu/drm/asahi/g16/slots.rs
+++ b/drivers/gpu/drm/asahi/g16/slots.rs
@@ -37,19 +37,20 @@ pub(crate) struct ComputeSlot {
 }
 
 /// Initializes the private pool exactly once, before it is exposed. Never called on reuse.
-pub(crate) fn init_uma_pool(state: &FwObject, list: &FwObject, pool: u64) -> Result {
-    if pool & 0x3fff != 0 {
+/// `pages` is the seeded page count: whole 512-page (2 MiB) rows, at most 8192.
+pub(crate) fn init_uma_pool(state: &FwObject, list: &FwObject, pool: u64, pages: usize) -> Result {
+    if pool & 0x3fff != 0 || pages == 0 || pages > 8192 || pages % 512 != 0 {
         return Err(EINVAL);
     }
     let mut chunk = [0u8; 512];
-    for first in (0..8192).step_by(64) {
+    for first in (0..pages).step_by(64) {
         for j in 0..64 {
             chunk[j * 8..j * 8 + 8]
                 .copy_from_slice(&(pool + ((first + j) as u64) * 0x1000).to_le_bytes());
         }
         state.write(first * 8, &chunk)?;
     }
-    for i in 0..16 {
+    for i in 0..pages / 512 {
         list.w64(i * 64, (1u64 << 61) | (pool + i as u64 * 0x200000))?;
     }
     Ok(())
@@ -144,6 +145,7 @@ pub(crate) fn new(
                 &unit.pool_state,
                 &unit.page_list,
                 unit.pool.gva.ok_or(EINVAL)?,
+                8192,
             )?;
         }
         Ok(unit)
