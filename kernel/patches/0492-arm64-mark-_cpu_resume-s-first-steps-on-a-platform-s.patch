From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 12:27:37 +0000
Subject: [PATCH] arm64: mark _cpu_resume's first steps on a platform's
 way back

_cpu_resume restarts the platform's resume watchdog at its entry (48 s)
and after the context loads (45 s), with finalise_el2 and the
mpidr_hash lookup between them unmarked. Restart it after
finalise_el2 returns (85 s) and once the hash index is in x7 (95 s).
Both sit five seconds from any other mark, so a stop in either step
reads apart from its neighbours.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/kernel/sleep.S | 2 ++
 drivers/soc/apple/sleep.c | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/kernel/sleep.S b/arch/arm64/kernel/sleep.S
index 7d6e93f651..45cc011fc9 100644
--- a/arch/arm64/kernel/sleep.S
+++ b/arch/arm64/kernel/sleep.S
@@ -181,6 +181,7 @@ SYM_FUNC_START(_cpu_resume)
 1:
 	mov	x0, x19
 	bl	finalise_el2
+	resume_mark 85, 1		// finalise_el2 returned
 
 	mrs	x1, mpidr_el1
 	adr_l	x8, mpidr_hash		// x8 = struct mpidr_hash virt address
@@ -190,6 +191,7 @@ SYM_FUNC_START(_cpu_resume)
 	ldp	w3, w4, [x8, #MPIDR_HASH_SHIFTS]
 	ldp	w5, w6, [x8, #(MPIDR_HASH_SHIFTS + 8)]
 	compute_mpidr_hash x7, x3, x4, x5, x6, x1, x2
+	resume_mark 95, 1		// mpidr_hash read, index in x7
 
 	/* x7 contains hash index, let's use it to grab context pointer */
 	ldr_l	x0, sleep_save_stash
diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index 628a054be7..45a3885d31 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -4828,7 +4828,7 @@ static void t8132_catch_init(struct platform_device *pdev, struct apple_sleep *s
 			 (unsigned long)t8132_catch_io + sizeof(t8132_catch_io));
 	arm64_resume_vbar = __pa_symbol(t8132_resume_vectors);
 	arm64_resume_vbar_va = (unsigned long)t8132_resume_vectors;
-	/* Marks inside the resume assembly: 57 54 65 48 45 42 s, see WDT_SUSPEND_SECS. */
+	/* Marks inside the resume assembly: 57 54 65 48 85 95 45 42 s, see WDT_SUSPEND_SECS. */
 	arm64_resume_wdt[0] = wdt->start;
 	arm64_resume_wdt[1] = (unsigned long)s->wdt;
 	arm64_resume_wdt[2] = WDT_TICKS_PER_S;
-- 
2.43.0

