From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bartosz Nitka <niteria@gmail.com>
Date: Fri, 6 Nov 2026 18:02:08 +0100
Subject: [PATCH] soc: apple: pmp-display: let the J713 DCP release its
 DISP vote

The J713 DCP takes its PMP DISP vote (power command 0x0f, logical device
8, state 1) when it activates, and the vote is held until reboot. macOS
releases it after stopping the DCP and before powering the display
domains down, and takes it again before powering them up.

Add apple_pmp_j713_display_put(): the same power command with state 0,
sent through the PMP owner's serialized request path (which consumes the
exact reply), after which apple_pmp_j713_display_get() takes the vote
again. The Rust owner forwards the release word to
apple_pmp_set_device_power(), which already handles state 0.

One request is in flight at a time, as before. A release that was not
transmitted leaves the vote held; one whose outcome is unknown leaves it
neither held nor available again, so the display cannot come back up on
a vote that may be gone. Other accepted votes are kept.

apple_pmp_j713_display_check_release() says, changing nothing, whether the
vote can be released now and taken again later: held, nothing in flight,
and admission open, as the later get is a new request and a failed
untagged request closes admission. The DCP asks before it powers down.

Host test: release and retake, a release with nothing held, one while
another request is pending, one that was not sent and one without a
reply, and the release check, also with admission closed by another
request.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit f5c6286286e9003e1109107a2b46e65f2b417ff0)
[j604: conflicts resolved by hand: a15y already generalises apple_pmp_j713_board() to apple_pmp_display_board() for prepare/check/get; kept that with the new pmp_power_check(..., false) argument; the new check_release/put keep the J713 gate here (widened in a separate j604 commit); header comment merged; selftests/drivers/gpu/apple-dcp/m4-error-paths.py not carried on a15y, dropped]
(cherry picked from commit 47a4950045b3e098975968f09c32f94d5974a430)
(cherry picked from commit 966e249fe4e57e3a0fa58d6f61a4463e79c00342)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/pmp-display.c       | 132 ++++++++++++++++++++++++--
 drivers/soc/apple/pmp.rs              |   2 +
 include/linux/soc/apple/pmp-display.h |  11 ++-
 3 files changed, 135 insertions(+), 10 deletions(-)

diff --git a/drivers/soc/apple/pmp-display.c b/drivers/soc/apple/pmp-display.c
index 46502e704f..d30e677b02 100644
--- a/drivers/soc/apple/pmp-display.c
+++ b/drivers/soc/apple/pmp-display.c
@@ -24,6 +24,8 @@
 /* AGX: command 0x0f, logical device 5, state 1. The reply carries no tag. */
 #define PMP_AGX_REQUEST		0x0020f50100000000ULL
 #define PMP_DISP_REQUEST	0x0020f80100000000ULL
+/* DISP, state 0: released while its DCP has powered the display domains down. */
+#define PMP_DISP_RELEASE	0x0020f80000000000ULL
 #define PMP_POWER_REPLY		0x0021000000000000ULL
 #define PMP_ENDPOINT		0x20
 
@@ -41,6 +43,8 @@ struct pmp_power_vote {
 	/* A failed PMP owner invalidates every accepted vote as well. */
 	int provider_error;
 	enum pmp_power_kind pending;
+	/* The pending request releases its vote rather than taking it. */
+	bool releasing;
 	bool held[PMP_POWER_COUNT];
 };
 
@@ -48,7 +52,11 @@ static void pmp_vote_fail(struct pmp_power_vote *s, int error)
 {
 	if (!s->error)
 		s->error = error < 0 ? error : -EIO;
+	/* A release with an unknown outcome no longer counts as held. */
+	if (s->pending && s->releasing)
+		s->held[s->pending] = false;
 	s->pending = PMP_POWER_NONE;
+	s->releasing = false;
 }
 
 /* The Rust owner latches every ambiguous transaction as a provider failure.
@@ -57,10 +65,12 @@ static void pmp_vote_fail(struct pmp_power_vote *s, int error)
  */
 static void pmp_vote_send_failed(struct pmp_power_vote *s)
 {
-	if (s->provider_error)
+	if (s->provider_error) {
 		pmp_vote_fail(s, s->provider_error);
-	else
+	} else {
 		s->pending = PMP_POWER_NONE;
+		s->releasing = false;
+	}
 }
 
 /* One means send the request, zero means the same retained vote is held. */
@@ -80,6 +90,52 @@ static int pmp_vote_begin(struct pmp_power_vote *s, enum pmp_power_kind kind)
 	return 1;
 }
 
+/* One means send the release, zero means the vote is not held. */
+static int pmp_vote_begin_release(struct pmp_power_vote *s, enum pmp_power_kind kind)
+{
+	if (kind <= PMP_POWER_NONE || kind >= PMP_POWER_COUNT)
+		return -EINVAL;
+	if (s->provider_error)
+		return s->provider_error;
+	if (!s->held[kind])
+		return 0;
+	if (s->error)
+		return s->error;
+	if (s->pending)
+		return -EBUSY;
+	s->pending = kind;
+	s->releasing = true;
+	return 1;
+}
+
+/*
+ * Whether a vote can be released now and taken again later, changing
+ * nothing: held, no request in flight, and admission open (a failed untagged
+ * request closes it, and the later get is a new request).
+ */
+static int pmp_vote_check_release(struct pmp_power_vote *s, enum pmp_power_kind kind)
+{
+	if (kind <= PMP_POWER_NONE || kind >= PMP_POWER_COUNT)
+		return -EINVAL;
+	if (s->provider_error)
+		return s->provider_error;
+	if (!s->held[kind])
+		return -ENODEV;
+	if (s->error)
+		return s->error;
+	return s->pending ? -EBUSY : 0;
+}
+
+/* Released, or the outcome is unknown and admission is closed. */
+static int pmp_vote_finish_release(struct pmp_power_vote *s, enum pmp_power_kind kind)
+{
+	if (s->provider_error)
+		return s->provider_error;
+	if (s->pending == kind && s->releasing)
+		pmp_vote_fail(s, -ETIMEDOUT);
+	return s->held[kind] || s->error ? s->error ?: -EIO : 0;
+}
+
 /* Accepted votes are retained even if a different untagged request fails. */
 static int pmp_vote_check(struct pmp_power_vote *s, enum pmp_power_kind kind)
 {
@@ -110,8 +166,9 @@ static void pmp_vote_reply(struct pmp_power_vote *s, u8 endpoint, u64 word)
 		pmp_vote_fail(s, -EPROTO);
 		return;
 	}
-	s->held[s->pending] = true;
+	s->held[s->pending] = !s->releasing;
 	s->pending = PMP_POWER_NONE;
+	s->releasing = false;
 }
 
 /*
@@ -345,7 +402,7 @@ out:
 	return ret;
 }
 
-static int pmp_power_check(struct device *consumer, enum pmp_power_kind kind)
+static int pmp_power_check(struct device *consumer, enum pmp_power_kind kind, bool release)
 {
 	struct apple_pmp_display *p = pmp_power_consumer(consumer, kind);
 	unsigned long flags;
@@ -354,7 +411,7 @@ static int pmp_power_check(struct device *consumer, enum pmp_power_kind kind)
 	if (IS_ERR(p))
 		return PTR_ERR(p);
 	spin_lock_irqsave(&p->lock, flags);
-	ret = pmp_vote_check(&p->vote, kind);
+	ret = release ? pmp_vote_check_release(&p->vote, kind) : pmp_vote_check(&p->vote, kind);
 	spin_unlock_irqrestore(&p->lock, flags);
 	return ret;
 }
@@ -412,6 +469,55 @@ out:
 	return ret;
 }
 
+/*
+ * Release the DISP vote while the consumer has powered the display domains
+ * down; apple_pmp_j713_display_get() takes it again before power-up. An
+ * ambiguous release closes admission: the vote is then neither held nor
+ * taken again.
+ */
+static int pmp_power_put(struct device *consumer, enum pmp_power_kind kind)
+{
+	struct apple_pmp_display *p = pmp_power_consumer(consumer, kind);
+	unsigned long flags;
+	int ret;
+
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+	if (kind != PMP_POWER_DISP)
+		return -EINVAL;
+	device_lock(p->dev);
+	mutex_lock(&p->request);
+	if (p->dev->driver != p->driver || !dev_get_drvdata(p->dev)) {
+		ret = -ENODEV;
+		apple_pmp_display_fail(p, ret);
+		goto out;
+	}
+	spin_lock_irqsave(&p->lock, flags);
+	reinit_completion(&p->reply);
+	ret = pmp_vote_begin_release(&p->vote, kind);
+	spin_unlock_irqrestore(&p->lock, flags);
+	if (ret <= 0)
+		goto out;
+	ret = p->send(p->cookie, PMP_DISP_RELEASE);
+	if (ret) {
+		spin_lock_irqsave(&p->lock, flags);
+		pmp_vote_send_failed(&p->vote);
+		spin_unlock_irqrestore(&p->lock, flags);
+		goto out;
+	}
+	spin_lock_irqsave(&p->lock, flags);
+	pmp_vote_reply(&p->vote, PMP_ENDPOINT, PMP_POWER_REPLY);
+	ret = pmp_vote_finish_release(&p->vote, kind);
+	spin_unlock_irqrestore(&p->lock, flags);
+	if (!ret)
+		dev_dbg(p->dev, "Retained DISP vote released: request=%016llx\n",
+			PMP_DISP_RELEASE);
+out:
+	mutex_unlock(&p->request);
+	device_unlock(p->dev);
+	return ret;
+}
+
 /* Probe creates the retained supplier links; get/check never change owners. */
 int apple_pmp_j713_display_prepare(struct device *consumer)
 {
@@ -427,13 +533,19 @@ EXPORT_SYMBOL_GPL(apple_pmp_j713_gpu_prepare);
 
 int apple_pmp_j713_display_check(struct device *consumer)
 {
-	return apple_pmp_display_board() ? pmp_power_check(consumer, PMP_POWER_DISP) : -ENODEV;
+	return apple_pmp_display_board() ? pmp_power_check(consumer, PMP_POWER_DISP, false) : -ENODEV;
 }
 EXPORT_SYMBOL_GPL(apple_pmp_j713_display_check);
 
+int apple_pmp_j713_display_check_release(struct device *consumer)
+{
+	return apple_pmp_j713_board() ? pmp_power_check(consumer, PMP_POWER_DISP, true) : -ENODEV;
+}
+EXPORT_SYMBOL_GPL(apple_pmp_j713_display_check_release);
+
 int apple_pmp_j713_gpu_check(struct device *consumer)
 {
-	return apple_pmp_display_board() ? pmp_power_check(consumer, PMP_POWER_AGX) : -ENODEV;
+	return apple_pmp_display_board() ? pmp_power_check(consumer, PMP_POWER_AGX, false) : -ENODEV;
 }
 EXPORT_SYMBOL_GPL(apple_pmp_j713_gpu_check);
 
@@ -443,6 +555,12 @@ int apple_pmp_j713_display_get(struct device *consumer)
 }
 EXPORT_SYMBOL_GPL(apple_pmp_j713_display_get);
 
+int apple_pmp_j713_display_put(struct device *consumer)
+{
+	return apple_pmp_j713_board() ? pmp_power_put(consumer, PMP_POWER_DISP) : -ENODEV;
+}
+EXPORT_SYMBOL_GPL(apple_pmp_j713_display_put);
+
 int apple_pmp_j713_gpu_get(struct device *consumer)
 {
 	return apple_pmp_display_board() ? pmp_power_get(consumer, PMP_POWER_AGX) : -ENODEV;
diff --git a/drivers/soc/apple/pmp.rs b/drivers/soc/apple/pmp.rs
index 2212509efd..39cc8821e0 100644
--- a/drivers/soc/apple/pmp.rs
+++ b/drivers/soc/apple/pmp.rs
@@ -487,6 +487,8 @@ unsafe extern "C" fn display_send(cookie: *const kernel::ffi::c_void, word: u64)
     match word {
         0x0020f50100000000 => unsafe { bindings::apple_pmp_set_device_power(0x0f, 5, 1) },
         0x0020f80100000000 => unsafe { bindings::apple_pmp_set_device_power(0x0f, 8, 1) },
+        // DISP released while its DCP has powered the display domains down.
+        0x0020f80000000000 => unsafe { bindings::apple_pmp_set_device_power(0x0f, 8, 0) },
         _ => EINVAL.to_errno(),
     }
 }
diff --git a/include/linux/soc/apple/pmp-display.h b/include/linux/soc/apple/pmp-display.h
index bf3548e186..ce60120085 100644
--- a/include/linux/soc/apple/pmp-display.h
+++ b/include/linux/soc/apple/pmp-display.h
@@ -43,13 +43,18 @@ void apple_pmp_display_fail(struct apple_pmp_display *display, int error);
 struct apple_pmp_display *apple_pmp_display_bound_owner(struct device *dev);
 
 /* Retained votes share the existing PMP owner's untagged request stream.
- * Prepare is probe-only; accepted DISP/AGX votes and supplier links persist
- * until reboot. The display and GPU entry points serve every
- * apple_pmp_display_board().
+ * Prepare is probe-only; supplier links persist until reboot, and so do
+ * accepted DISP/AGX votes, except that the DCP releases its DISP vote while
+ * it has powered the display domains down (put) and takes it again (get).
+ * Before that it asks, changing nothing, whether the vote can be released
+ * now and taken again later (check_release). The display and GPU entry
+ * points serve every apple_pmp_display_board().
  */
 int apple_pmp_j713_display_prepare(struct device *consumer);
 int apple_pmp_j713_display_get(struct device *consumer);
+int apple_pmp_j713_display_put(struct device *consumer);
 int apple_pmp_j713_display_check(struct device *consumer);
+int apple_pmp_j713_display_check_release(struct device *consumer);
 int apple_pmp_j713_gpu_prepare(struct device *consumer);
 int apple_pmp_j713_gpu_get(struct device *consumer);
 int apple_pmp_j713_gpu_check(struct device *consumer);
