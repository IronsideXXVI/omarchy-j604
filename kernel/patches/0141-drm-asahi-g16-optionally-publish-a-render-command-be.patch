diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 0aee9a9d57..c65a4d1b96 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -485,6 +485,24 @@ live_u32_param!(
     "G16: stop and warm-restart the firmware across suspend-to-RAM (testing; default 0; runtime 0644)"
 );
 
+/// Storage of `g16_flights` (runtime 0644): 1 publishes one command at a time (the qualified
+/// protocol, default); 2 lets one render command be published behind a running one.
+static FLIGHTS: AtomicU32 = AtomicU32::new(1);
+
+/// Render commands that may be in flight at once, 1 or 2.
+pub(crate) fn flights() -> usize {
+    FLIGHTS.load(Ordering::Relaxed).clamp(1, 2) as usize
+}
+
+live_u32_param!(
+    FLIGHTS_PARAM,
+    FLIGHTS_PARMTYPE,
+    FLIGHTS_PARM,
+    FLIGHTS,
+    "g16_flights",
+    "G16: render commands in flight at once, 1 (default, the qualified one-at-a-time protocol) or 2 (one render published behind a running render; experimental; runtime 0644)"
+);
+
 /// Fragment-only dependency publication has not been qualified on this backend.
 pub(crate) fn early_tiling() -> bool {
     false
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index ff553dd5e4..5c4c956362 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -337,6 +337,48 @@ impl Firmware {
         Ok(true)
     }
 
+    /// The receipt of the oldest of two flights: the firmware cursors passed its entries
+    /// (`start`..`head`) within the newest publication (`tail`), and each submit-pipe
+    /// cursor passed its record within the newest record. The queue busy flag belongs to
+    /// the later flight then and is not part of the proof.
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn queue_receipt_behind(
+        &self,
+        channel: Channel,
+        state: &super::object::FwObject,
+        info: &super::object::FwObject,
+        start: u32,
+        head: u32,
+        tail: u32,
+        record: u32,
+    ) -> Result<bool> {
+        let m = super::hw::sizes::QUEUE_CAP;
+        if start >= m || head >= m || tail >= m || record >= 256 {
+            return Err(EINVAL);
+        }
+        for offset in [qstate::READ, qstate::WRITE] {
+            if !ring_passed(state.r32(offset)?, start, head, tail, m) {
+                return Ok(false);
+            }
+        }
+        if !super::hw::tuning::FW_CACHED {
+            for offset in [0x20, 0x24, 0x28] {
+                if !ring_passed(info.r32(offset)?, start, head, tail, m) {
+                    return Ok(false);
+                }
+            }
+        }
+        let pipe = self.channels.channel(channel);
+        let newest = self.channels.producer(channel);
+        let first = record.wrapping_add(255) % 256;
+        for cursor in [pipe.read()?, pipe.completion()?, pipe.write()?] {
+            if !ring_passed(cursor, first, record, newest, 256) {
+                return Ok(false);
+            }
+        }
+        Ok(true)
+    }
+
     /// A full receipt includes stage and notifier stamps, every physical consumer,
     /// the private allocator completion and the internal timestamp pair. An aborted
     /// receipt omits only the writes firmware does not make for an aborted command,
@@ -375,7 +417,51 @@ impl Firmware {
                 && start != 0
                 && end > start;
         }
-        if f.renders != 0 {
+        // A later render flight behind the oldest (g16_flights = 2) moves the shared stamps,
+        // cursors and notifier records past it: prove the oldest by "reached" then.
+        let behind = self.engine.flights.len() > 1;
+        if f.renders != 0 && behind {
+            let g = &self.graph.render;
+            let e = &self.engine;
+            if !stamp_reached(g.fw_stamp[0].r32(0)?, f.ta_target, e.ta_target)
+                || !stamp_reached(g.fw_stamp[1].r32(0)?, f.fs_target, e.fs_target)
+                || !self.queue_receipt_behind(
+                    Channel::Ta,
+                    &g.qstate[0],
+                    &g.qinfo[0],
+                    f.ta_start,
+                    f.ta_head,
+                    e.ta_head,
+                    f.rec[0],
+                )?
+                || !self.queue_receipt_behind(
+                    Channel::Fs,
+                    &g.qstate[1],
+                    &g.qinfo[1],
+                    f.fs_start,
+                    f.fs_head,
+                    e.fs_head,
+                    f.rec[1],
+                )?
+            {
+                return Ok(Retirement::Pending);
+            }
+            let k = f.claims.pass[0] as usize;
+            let unit = f.job.resources.render()?.passes.get(k).ok_or(EINVAL)?;
+            let ta_start = unit.scene.r64(0x600)?;
+            let ta_end = unit.scene.r64(0x608)?;
+            let fs_start = unit.scene.r64(0x620)?;
+            let fs_end = unit.scene.r64(0x628)?;
+            let ta_note = g.notifier.r32(notifier_page::TA_STAMP)?;
+            let fs_note = g.notifier.r32(notifier_page::FS_STAMP)?;
+            full &= stamp_reached(ta_note, f.ta_target, e.ta_target)
+                && stamp_reached(fs_note, f.fs_target, e.fs_target)
+                && f.job.resources.render()?.pools.retired(k)?
+                && ta_start != 0
+                && ta_end > ta_start
+                && fs_start != 0
+                && fs_end > fs_start;
+        } else if f.renders != 0 {
             let g = &self.graph.render;
             if g.fw_stamp[0].r32(0)? != f.ta_target
                 || g.fw_stamp[1].r32(0)? != f.fs_target
