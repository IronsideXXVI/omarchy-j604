@@ -734,6 +740,24 @@ impl Firmware {
         Ok(())
     }
 
+    /// Whether `job`'s next command may be published behind the flights now running
+    /// (`g16_flights` = 2): it is a render command, every running flight is a healthy
+    /// render-only prefix, the render allocators are past their priming prefix, and a
+    /// flight slot is free. Its own exact prior-command dependencies are still checked
+    /// before publication; a dependency on a running command keeps it pending.
+    fn ahead_ok(&self, job: &Job) -> bool {
+        let n = self.engine.flights.len();
+        n < params::flights().min(sizes::FLIGHTS)
+            && self.engine.draw != 0
+            && !self.engine.frozen
+            && matches!(command(job, job.progress.sent()), Some(Command::Render(_)))
+            && self
+                .engine
+                .flights
+                .iter()
+                .all(|f| f.computes == 0 && f.renders != 0 && !f.doomed && !f.recovery_suspect)
+    }
+
     /// Publishes one command after the preceding command's complete wire receipt. Ordinary
     /// preparation failures fail the affected job, including after its earlier commands
     /// retired. A publication marked uncertain denotes potentially visible firmware state
@@ -760,8 +784,12 @@ impl Firmware {
             };
             let job = self.engine.pending[index].clone();
             // Even a failed job may have an earlier command in flight. An aggregate
-            // error fence must not race that command's access to user buffers.
-            if !self.engine.flights.is_empty() {
+            // error fence must not race that command's access to user buffers: a job of
+            // a failed VM waits until nothing is in flight. Otherwise a render command may
+            // go behind running render commands only as ahead_ok() allows.
+            if !self.engine.flights.is_empty()
+                && (job.vm.status.get() != 0 || !self.ahead_ok(&job))
+            {
                 self.engine.stats.hold[0] += 1;
                 break;
             }
@@ -956,7 +984,9 @@ impl Firmware {
         f: &mut Flight,
         visible: &mut bool,
     ) -> Result {
-        if !self.engine.flights.is_empty() {
+        // Behind a running render command only as ahead_ok() allows (g16_flights = 2).
+        let ahead = !self.engine.flights.is_empty();
+        if ahead && !self.ahead_ok(job) {
             return Err(EAGAIN);
         }
         let index = job.progress.sent();
@@ -987,10 +1017,18 @@ impl Firmware {
         for &channel in channels {
             let pipe = self.channels.channel(channel);
             let producer = self.channels.producer(channel);
-            if pipe.read()? != producer
-                || pipe.completion()? != producer
-                || pipe.write()? != producer
-            {
+            // Alone: every earlier record consumed and completed. Behind a running command:
+            // the host cursor is ours and there is room behind the unconsumed records.
+            let busy = if ahead {
+                pipe.write()? != producer
+                    || producer.wrapping_add(RING_SLOTS).wrapping_sub(pipe.read()?) % RING_SLOTS
+                        >= sizes::AHEAD_RECORDS
+            } else {
+                pipe.read()? != producer
+                    || pipe.completion()? != producer
+                    || pipe.write()? != producer
+            };
+            if busy {
                 self.engine.chan_wait = true;
                 return Err(EAGAIN);
             }
@@ -1124,7 +1162,11 @@ impl Firmware {
                     event,
                     new_queue: u8::from(fresh),
                 };
-                self.channels.post(channel, &record)?;
+                if ahead {
+                    self.channels.post_ahead(channel, &record)?;
+                } else {
+                    self.channels.post(channel, &record)?;
+                }
                 self.session.ring(channel)?;
             }
             Ok(())
@@ -1155,6 +1197,9 @@ impl Firmware {
         }
         self.engine.events = self.events.compute_events;
         self.engine.stage_seen = self.events.stage_events;
+        if ahead {
+            self.engine.stats.overlaps += 1;
+        }
         self.stat_publish(f);
         self.renew_deadlines();
         job.progress.set_sent(index + 1);
