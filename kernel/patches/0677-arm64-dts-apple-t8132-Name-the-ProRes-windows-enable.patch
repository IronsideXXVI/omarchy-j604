From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 20:51:12 +0000
Subject: [PATCH] arm64: dts: apple: t8132: Name the ProRes windows;
 enable ProRes on the J604

The driver maps the ProRes windows by name. Name the T8132 node's three
windows, and enable the engine, its DART and its SCODEC power state on
the J604. The engine binds only when its per-machine initialization
table is installed.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi    | 14 +++++++++++++-
 arch/arm64/boot/dts/apple/t8132-peripherals.dtsi |  1 +
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index 04c140ea06..416aa11b96 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -396,8 +396,20 @@ &ps_dispext0_cpu {
 	status = "okay";
 };
 
+/*
+ * ProRes: the engine, its DART and SCODEC, the power state that holds both.
+ * apple-prores binds only when apple/prores-t8132-init.bin is installed.
+ */
 &ps_scodec {
-	status = "disabled";
+	status = "okay";
+};
+
+&dart_apr0 {
+	status = "okay";
+};
+
+&apr {
+	status = "okay";
 };
 
 &ps_scodec_streaming {
diff --git a/arch/arm64/boot/dts/apple/t8132-peripherals.dtsi b/arch/arm64/boot/dts/apple/t8132-peripherals.dtsi
index a222fbc4c7..b9167eb3a3 100644
--- a/arch/arm64/boot/dts/apple/t8132-peripherals.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-peripherals.dtsi
@@ -378,6 +378,7 @@ apr: video-codec@281000000 {
 		reg = <0x2 0x81000000 0x0 0x4000>,
 		      <0x2 0x80000000 0x0 0x1000000>,
 		      <0x2 0x810c0000 0x0 0x4000>;
+		reg-names = "core", "wrapper", "aux";
 		interrupt-parent = <&aic>;
 		interrupts = <AIC_IRQ 1147 IRQ_TYPE_LEVEL_HIGH>,
 		             <AIC_IRQ 1184 IRQ_TYPE_LEVEL_HIGH>;
-- 
2.43.0

