From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Mon, 2 Nov 2026 01:53:36 -0500
Subject: [PATCH] dt-bindings: pci: apple,pcie: Add the T8132 PCIe-C
 controllers

T8132 PCIe-C controllers follow T8122 and T8103, with nine register
blocks and an MSI vector slice of the window they share with the
internal PCIe controller.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 4e61e32825925b9493c92b6b8a63f6f33790cbe2)
---
 .../devicetree/bindings/pci/apple,pcie.yaml   | 30 ++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/pci/apple,pcie.yaml b/Documentation/devicetree/bindings/pci/apple,pcie.yaml
index 285a1a93cf..a634b4ff89 100644
--- a/Documentation/devicetree/bindings/pci/apple,pcie.yaml
+++ b/Documentation/devicetree/bindings/pci/apple,pcie.yaml
@@ -68,6 +68,10 @@ properties:
           - const: apple,t8112-pciec
           - const: apple,t8103-pciec
       - const: apple,t6000-pciec
+      - items:
+          - const: apple,t8132-pciec
+          - const: apple,t8122-pciec
+          - const: apple,t8103-pciec
 
   reg:
     minItems: 3
@@ -92,6 +96,12 @@ properties:
   msi-ranges:
     maxItems: 1
 
+  apple,msi-vector-base:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      First vector of this PCIe-C controller's slice of the MSI window it
+      shares with the internal PCIe controller.
+
   iommu-map: true
   iommu-map-mask: true
 
@@ -172,6 +182,14 @@ required:
 unevaluatedProperties: false
 
 allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8132-pciec
+    then:
+      required:
+        - apple,msi-vector-base
   - $ref: /schemas/pci/pci-host-bridge.yaml#
   - $ref: /schemas/interrupt-controller/msi-controller.yaml#
   - if:
@@ -219,7 +237,7 @@ allOf:
       properties:
         reg:
           minItems: 5
-          maxItems: 7
+          maxItems: 9
         reg-names:
           oneOf:
             - items:
@@ -236,6 +254,16 @@ allOf:
                 - const: debug
                 - const: ltssm
                 - enum: [intr2axi, oe-fabric]
+            - items:
+                - const: config
+                - const: rc
+                - const: port0
+                - const: fabric
+                - const: debug
+                - const: ioa
+                - const: ltssm
+                - const: intr2axi
+                - const: oe-fabric
         interrupts:
           maxItems: 1
         ranges:
