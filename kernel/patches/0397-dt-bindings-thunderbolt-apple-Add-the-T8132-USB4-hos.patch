From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Mon, 2 Nov 2026 01:52:27 -0500
Subject: [PATCH] dt-bindings: thunderbolt: apple: Add the T8132 USB4 host
 routers

T8132 has two ACIO host routers with the T6030 layout. Their MxWrap co-
processor control registers are a fourth reg entry, and their NHIs use
24 DART streams like T6030's. Their CIO reconfig shares the T6000
layout.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 425586632088e8b0171c881efd8bb07cbc6c7110)
---
 .../bindings/reset/apple,t8103-cio-reset.yaml      |  4 +++-
 .../thunderbolt/apple,t8103-usb4-acio.yaml         | 14 ++++++++++++++
 .../bindings/thunderbolt/apple,t8103-usb4-nhi.yaml |  2 ++
 3 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/reset/apple,t8103-cio-reset.yaml b/Documentation/devicetree/bindings/reset/apple,t8103-cio-reset.yaml
index 83f307d3fc..592dea2580 100644
--- a/Documentation/devicetree/bindings/reset/apple,t8103-cio-reset.yaml
+++ b/Documentation/devicetree/bindings/reset/apple,t8103-cio-reset.yaml
@@ -35,7 +35,9 @@ properties:
           - const: apple,t8112-cio-reset
           - const: apple,t8103-cio-reset
       - items:
-          - const: apple,t6020-cio-reset
+          - enum:
+              - apple,t6020-cio-reset
+              - apple,t8132-cio-reset
           - const: apple,t6000-cio-reset
 
   reg:
diff --git a/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-acio.yaml b/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-acio.yaml
index 3396087864..90717301e2 100644
--- a/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-acio.yaml
+++ b/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-acio.yaml
@@ -38,6 +38,7 @@ properties:
               - apple,t6031-usb4-acio
               - apple,t8112-usb4-acio
               - apple,t8122-usb4-acio
+              - apple,t8132-usb4-acio
           - const: apple,t8103-usb4-acio
 
   reg:
@@ -49,6 +50,7 @@ properties:
           PCIe adapter configuration space of the USB4 router. Present where
           the root complex exposes the adapter separately, so that the tunnel
           can be configured before a PCIe-C link is brought up.
+      - description: MxWrap co-processor control registers, on T8132
 
   reg-names:
     minItems: 2
@@ -56,6 +58,7 @@ properties:
       - const: rc
       - const: sram
       - const: pcie-adapter
+      - const: cpu
 
   mboxes:
     maxItems: 1
@@ -179,6 +182,17 @@ required:
 
 allOf:
   - $ref: /schemas/usb/usb-switch.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t8132-usb4-acio
+    then:
+      properties:
+        reg:
+          minItems: 4
+        reg-names:
+          minItems: 4
 
 additionalProperties: false
 
diff --git a/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-nhi.yaml b/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-nhi.yaml
index 49b60aaa8d..d6dffe3ec8 100644
--- a/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-nhi.yaml
+++ b/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-nhi.yaml
@@ -30,6 +30,7 @@ properties:
               - apple,t6031-usb4-nhi
               - apple,t8112-usb4-nhi
               - apple,t8122-usb4-nhi
+              - apple,t8132-usb4-nhi
           - const: apple,t8103-usb4-nhi
 
   reg:
@@ -144,6 +145,7 @@ allOf:
               - apple,t6030-usb4-nhi
               - apple,t6031-usb4-nhi
               - apple,t8122-usb4-nhi
+              - apple,t8132-usb4-nhi
               - apple,t8142-usb4-nhi
     then:
       properties:
