From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 10:44:15 +0000
Subject: [PATCH] arm64: dts: apple: t8132: take #1314's J713
 board-file split

aurora-silicon/linux#1314 was rewritten (d0ac23c1cf -> 025305c642).
Its device tree commits now keep what only the J713 has run, deep sleep
included, in t8132-j713.dts instead of t8132-j713-j715.dtsi, which the
J715 shares: the sleep controller, the SEP and its domains, the ACIO
hosts' PHYs and the PMGR policy for the SEP domain. t8132.dtsi now
leaves the CPU cluster power gates disabled, for a board that sleeps
to enable.

This applies the rewrite's change to each file, from the old revisions
k881 carries to the new ones. The J713 files now equal 025305c642's.
Two of the rewritten commits (DCP address cells, DART clock protection)
only changed context, and need nothing.

Based on 59924d08ea, 95024c2df0, c247eaf598, aa72186d9d and a16793240c
from aurora-silicon/linux#1314.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../arm64/boot/dts/apple/t8132-j713-j715.dtsi | 14 ----
 .../arm64/boot/dts/apple/t8132-j713-usb4.dtsi |  4 --
 arch/arm64/boot/dts/apple/t8132-j713.dts      | 66 ++++++++++++++++++-
 arch/arm64/boot/dts/apple/t8132.dtsi          |  4 +-
 drivers/soc/apple/t8132-platform-data.dts     |  7 ++
 5 files changed, 75 insertions(+), 20 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi b/arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi
index 0fa670f5eb..3e1417dabb 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j713-j715.dtsi
@@ -139,20 +139,6 @@ &dcp {
 	#size-cells = <2>;
 };
 
-/* The enclave must take the sleep request, so its driver has to bind. */
-&sep_dart {
-	status = "okay";
-};
-
-&sep {
-	/*
-	 * Without a domain the driver tells the enclave at .suspend, and a sleep
-	 * refused after that finds it gated with its mailbox gone.
-	 */
-	power-domains = <&ps_sep>, <&ps_gpio>;
-	status = "okay";
-};
-
 /* External displays: both pipes, routed to either USB-C port. */
 &dcpext0_mbox {
 	status = "okay";
diff --git a/arch/arm64/boot/dts/apple/t8132-j713-usb4.dtsi b/arch/arm64/boot/dts/apple/t8132-j713-usb4.dtsi
index 2cac000d60..baf76ce4c5 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713-usb4.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j713-usb4.dtsi
@@ -32,8 +32,6 @@ &usb4_1_mbox {
 
 &usb4_0_acio {
 	status = "okay";
-	phys = <&atcphy0 PHY_TYPE_USB3>;
-	phy-names = "cio";
 
 	ports {
 		#address-cells = <1>;
@@ -51,8 +49,6 @@ usb4_0_acio_tbt: endpoint {
 
 &usb4_1_acio {
 	status = "okay";
-	phys = <&atcphy1 PHY_TYPE_USB3>;
-	phy-names = "cio";
 
 	ports {
 		#address-cells = <1>;
diff --git a/arch/arm64/boot/dts/apple/t8132-j713.dts b/arch/arm64/boot/dts/apple/t8132-j713.dts
index 172b24b34d..cfaa76f22c 100644
--- a/arch/arm64/boot/dts/apple/t8132-j713.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j713.dts
@@ -78,6 +78,36 @@ &aop_audio {
 	apple,machine-kind = "MacBook Air";
 };
 
+/* Deep sleep has been brought up and tested on this machine only. */
+&sleep {
+	status = "okay";
+};
+
+/* Deep sleep needs both CPU clusters' power gates; iBoot enables E's only. */
+&cluster_pwrgate {
+	status = "okay";
+};
+
+/* The enclave must take the sleep request, so its driver has to bind. */
+&sep_dart {
+	status = "okay";
+};
+
+/* Only named: the sleep's last refusal reads its state to see the enclave gate. */
+&ps_sep {
+	apple,firmware-owned;
+	status = "okay";
+};
+
+&sep {
+	/*
+	 * Without a domain the driver tells the enclave at .suspend, and a sleep
+	 * refused after that finds it gated with its mailbox gone.
+	 */
+	power-domains = <&ps_sep>, <&ps_gpio>;
+	status = "okay";
+};
+
 /*
  * The four SN012776 speaker amps, held in hardware shutdown until the sound
  * card enables them (ADT /arm-io/i2c3/audio-speaker at 0x38 and its
@@ -168,18 +198,41 @@ &dcp {
 };
 
 /*
- * The external display system domains have a bus bridge in front of their
+ * Each external DCP powers its CPU, front-end and system domains off around
+ * a deep sleep. The system domains have a bus bridge in front of their
  * block: its link words are 0x800104 past the start of the block's disp-3
  * registers (reg 4 of the external DCP).
  */
 &ps_dispext0_sys {
+	apple,consumer-switched;
 	apple,bridge-link = <&dcpext0 4 0x800104>;
 };
 
+&ps_dispext0_fe {
+	apple,consumer-switched;
+};
+
+&ps_dispext0_cpu {
+	apple,consumer-switched;
+	/* Power-gate retention workaround, as macOS sets it while off. */
+	apple,retention-workaround = <0x256cc 0x3 0x3>, <0x256f0 0x3 0x0>;
+};
+
 &ps_dispext1_sys {
+	apple,consumer-switched;
 	apple,bridge-link = <&dcpext1 4 0x800104>;
 };
 
+&ps_dispext1_fe {
+	apple,consumer-switched;
+};
+
+&ps_dispext1_cpu {
+	apple,consumer-switched;
+	/* Power-gate retention workaround, as macOS sets it while off. */
+	apple,retention-workaround = <0x25b4c 0x3 0x3>, <0x25b70 0x3 0x0>;
+};
+
 /*
  * A deep sleep with a dock attached powers these off: their hosts (the ACIO
  * NHIs, the tunneled PCIe ports and the external DCPs) take them down and
@@ -229,3 +282,14 @@ &dart_apcie0 {
 &port00 {
 	clkreq-gpios = <&pinctrl_ap 160 GPIO_ACTIVE_LOW>;
 };
+
+/* Each ACIO host powers its Type-C PHY down and up around a deep sleep with a dock. */
+&usb4_0_acio {
+	phys = <&atcphy0 PHY_TYPE_USB3>;
+	phy-names = "cio";
+};
+
+&usb4_1_acio {
+	phys = <&atcphy1 PHY_TYPE_USB3>;
+	phy-names = "cio";
+};
diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 0982e40370..25d89d3ccb 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -569,12 +569,14 @@ pmgr_mini: power-management@388280000 {
 
 		/*
 		 * The CPU clusters' power-gate enables, in /arm-io/pmgr reg[34]:
-		 * cluster-id 0 (E) at +0x0, 1 (P) at +0x60. iBoot sets E's only.
+		 * cluster-id 0 (E) at +0x0, 1 (P) at +0x60. iBoot sets E's only; a
+		 * board that sleeps enables this.
 		 */
 		cluster_pwrgate: power-gate@380724000 {
 			compatible = "apple,t8132-cluster-pwrgate", "apple,cluster-pwrgate";
 			reg = <0x3 0x80724000 0x0 0x4>,
 			      <0x3 0x80724060 0x0 0x4>;
+			status = "disabled";
 		};
 
 		sleep: sleep-controller@380700000 {
diff --git a/drivers/soc/apple/t8132-platform-data.dts b/drivers/soc/apple/t8132-platform-data.dts
index c5f48ecb6e..a68afc8bfb 100644
--- a/drivers/soc/apple/t8132-platform-data.dts
+++ b/drivers/soc/apple/t8132-platform-data.dts
@@ -37,6 +37,13 @@ pmgr_mini: power-management@388280000 {
 #include "../../../arch/arm64/boot/dts/apple/t8132-j713-usb4-pmgr.dtsi"
 #include "../../../arch/arm64/boot/dts/apple/t8132-memory.dtsi"
 
+/* The J713's SEP domain, for its deep sleep: every other board keeps it off. */
+&ps_sep {
+	apple,firmware-owned;
+	status = "okay";
+	apple,policy-machine = "apple,j713";
+};
+
 /* The J713's ACIO power states: every other board keeps its own (or none). */
 &ps_atc0_pcie {
 	apple,policy-machine = "apple,j713";
-- 
2.43.0

