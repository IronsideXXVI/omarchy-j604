From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Thu, 29 Oct 2026 15:48:59 -0400
Subject: [PATCH] soc: apple: clpc: Hold the T8132 GPU floor for reported GPU
 work

The T8132 CLPC votes the qualified M5/F3 floor (DCS 5, fabric 3) whenever
GFX is powered. The G16 firmware keeps GFX powered while the GPU idles, so
on a J713 the DRAM controller and the fabric stay at their top states the
whole time the system is awake, also at an idle desktop.

Take the GPU's share of the floor from the work the GPU driver reports
instead, as on T6040: the floor is held while work is in flight, and
released HOLD_MS after the last of it retires. CPU demand is unchanged.
Continuous rendering, such as video playback or animations, keeps work
coming more often than HOLD_MS and holds the floor as before; the saving is
at a desktop where nothing redraws.

On a J713:
- at an idle desktop the floor is released about 90% of the time, and
  system power drops by about 0.45 W, from 6.3 to 5.9 W on the same boot;
- under glmark2 the floor is held while the GPU works and the score is
  unchanged. With the floor released outright it drops by about 45%, so
  GPU work does need it;
- video playback holds the floor throughout, as before;
- suspend-to-idle and resume are unaffected.

The GPU's floor now depends on the J713 device tree linking the GPU to the
CLPC (apple,clpc): without that link nothing reports GPU work and it gets
no floor. The J713 device tree is built and shipped with its kernel. It
keeps apple,gpu-power-state on the T8132 CLPC for older kernels; it is no
longer used. A KUnit case covers the T8132 input gate.

Signed-off-by: Erik Bourget <erik@ebourget.net>
[eryk: follow the change in the host model, tools/asahi/clpc-gpu-demand-tests.py,
 which failed to build: extract apple_clpc_gpu_input_demand(), aim the
 omit-host-demand mutation at its call, model T8132 on reported work, and
 move the read-error check (bf86f720c006) to T8140, the table that still
 reads the GFX power state]
Signed-off-by: Eryk Wieliczko <eryk@wieliczko.ninja>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit ab308acbb92166a54f3e8c57913f43e5920bd933)
[j604: dropped hunk for tools/asahi/clpc-gpu-demand-tests.py, absent in 1.604]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/clpc.c | 84 ++++++++++++++++++++++++++++++++++------
 1 file changed, 72 insertions(+), 12 deletions(-)

diff --git a/drivers/soc/apple/clpc.c b/drivers/soc/apple/clpc.c
index 7b27085ca3..387b6bf0c9 100644
--- a/drivers/soc/apple/clpc.c
+++ b/drivers/soc/apple/clpc.c
@@ -517,6 +517,25 @@ static void apple_clpc_gpu_floor_count(struct apple_clpc *clpc, bool released)
 	clpc->gpu_floor_released = released;
 }
 
+/*
+ * The GPU driver's input, where it drives demand instead of the GFX power
+ * state: every rail at its top state while the driver reports work.
+ */
+static bool apple_clpc_gpu_input_demand(const struct apple_clpc_hw *hw,
+					struct apple_clpc_gpu *gpu,
+					unsigned int *demand)
+{
+	u64 updated, sequence;
+	unsigned int rail;
+
+	if (!gpu || hw->gpu_demand ||
+	    !apple_clpc_gpu_active(gpu, &updated, &sequence))
+		return false;
+	for (rail = 0; rail < APPLE_CLPC_RAILS; rail++)
+		demand[rail] = max(demand[rail], hw->map[rail][APPLE_CLPC_LEVELS - 1]);
+	return true;
+}
+
 static void apple_clpc_sample(struct apple_clpc *clpc)
 {
 	unsigned int demand[APPLE_CLPC_RAILS] = {};
@@ -542,16 +561,8 @@ static void apple_clpc_sample(struct apple_clpc *clpc)
 	for (rail = 0; rail < APPLE_CLPC_RAILS; rail++)
 		if (demand[rail])
 			reason |= 1;
-	if (clpc->gpu && !clpc->hw->gpu_demand) {
-		u64 updated, sequence;
-
-		if (apple_clpc_gpu_active(clpc->gpu, &updated, &sequence)) {
-			reason |= 2;
-			for (rail = 0; rail < APPLE_CLPC_RAILS; rail++)
-				demand[rail] = max(demand[rail],
-						clpc->hw->map[rail][APPLE_CLPC_LEVELS - 1]);
-		}
-	}
+	if (apple_clpc_gpu_input_demand(clpc->hw, clpc->gpu, demand))
+		reason |= 2;
 	if (clpc->gpu_pmgr) {
 		/* Both run every sample: each tracks state across samples. */
 		bool late = time_after(now, clpc->gpu_sampled +
@@ -854,6 +865,13 @@ static DEFINE_SIMPLE_DEV_PM_OPS(apple_clpc_pm_ops, apple_clpc_suspend,
 
 /* Only the stock M5/F3 busy floor is qualified on T8132. Do not invent
  * intermediate frequency-to-memory tables; idle can still release the vote.
+ *
+ * The G16 firmware keeps graphics powered while the GPU idles, so its power
+ * state would hold the floor up all the time: on J713 that keeps the DCS and
+ * the fabric at their top states at an idle desktop, about 0.45 W more than
+ * with the floor released. The GPU driver reports its work instead, as on
+ * T6040, and gets the M5/F3 floor while it has work in flight. Without that
+ * floor, rendering is about 45% slower.
  */
 static const struct apple_clpc_hw apple_clpc_hw_t8132 = {
 	.rail = { [APPLE_CLPC_DCS] = 0, [APPLE_CLPC_SOC] = 1 },
@@ -861,8 +879,7 @@ static const struct apple_clpc_hw apple_clpc_hw_t8132 = {
 		[APPLE_CLPC_DCS] = { 5, 5, 5, 5 },
 		[APPLE_CLPC_SOC] = { 3, 3, 3, 3 },
 	},
-	.gpu_demand = true,
-	.gpu = { [APPLE_CLPC_DCS] = 5, [APPLE_CLPC_SOC] = 3 },
+	.gpu_demand = false,
 };
 
 /*
@@ -1041,7 +1058,50 @@ static void apple_clpc_gpu_dense_test(struct kunit *test)
 						       sequence, 0, false));
 }
 
+/* T8132: the GPU driver's reported work, not GFX power, gets the M5/F3 floor. */
+static void apple_clpc_t8132_gpu_input_test(struct kunit *test)
+{
+	struct apple_clpc_hw power_state = apple_clpc_hw_t8132;
+	unsigned int demand[APPLE_CLPC_RAILS] = {};
+	struct apple_clpc_gpu *gpu = kzalloc_obj(*gpu);
+
+	KUNIT_ASSERT_NOT_NULL(test, gpu);
+	kref_init(&gpu->ref);
+	spin_lock_init(&gpu->lock);
+	KUNIT_EXPECT_FALSE(test, apple_clpc_hw_t8132.gpu_demand);
+
+	/* No input, or no work reported: no GPU floor. */
+	KUNIT_EXPECT_FALSE(test, apple_clpc_gpu_input_demand(&apple_clpc_hw_t8132,
+							     NULL, demand));
+	KUNIT_EXPECT_FALSE(test, apple_clpc_gpu_input_demand(&apple_clpc_hw_t8132,
+							     gpu, demand));
+	KUNIT_EXPECT_EQ(test, demand[APPLE_CLPC_DCS], 0u);
+	KUNIT_EXPECT_EQ(test, demand[APPLE_CLPC_SOC], 0u);
+
+	/* Work in flight: DCS 5 and fabric 3. */
+	apple_clpc_gpu_set_active(gpu, true);
+	KUNIT_EXPECT_TRUE(test, apple_clpc_gpu_input_demand(&apple_clpc_hw_t8132,
+							    gpu, demand));
+	KUNIT_EXPECT_EQ(test, demand[APPLE_CLPC_DCS], 5u);
+	KUNIT_EXPECT_EQ(test, demand[APPLE_CLPC_SOC], 3u);
+
+	/* A table that follows GFX power ignores the input. */
+	power_state.gpu_demand = true;
+	memset(demand, 0, sizeof(demand));
+	KUNIT_EXPECT_FALSE(test, apple_clpc_gpu_input_demand(&power_state, gpu,
+							     demand));
+	KUNIT_EXPECT_EQ(test, demand[APPLE_CLPC_DCS], 0u);
+
+	/* Drained: nothing more is asked; the vote's hold releases it. */
+	apple_clpc_gpu_set_active(gpu, false);
+	KUNIT_EXPECT_FALSE(test, apple_clpc_gpu_input_demand(&apple_clpc_hw_t8132,
+							     gpu, demand));
+	KUNIT_EXPECT_EQ(test, demand[APPLE_CLPC_DCS], 0u);
+	apple_clpc_gpu_put(gpu);
+}
+
 static struct kunit_case apple_clpc_cases[] = {
+	KUNIT_CASE(apple_clpc_t8132_gpu_input_test),
 	KUNIT_CASE(apple_clpc_gpu_dense_test),
 	KUNIT_CASE(apple_clpc_gpu_cold_wake_test),
 	KUNIT_CASE(apple_clpc_gpu_request_lifetime_test),
