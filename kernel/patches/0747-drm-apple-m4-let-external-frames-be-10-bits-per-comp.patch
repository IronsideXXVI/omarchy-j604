From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 21:23:31 +0000
Subject: [PATCH] drm/apple: m4: let external frames be 10 bits per
 component

The frame check of a T8132 external output takes only XRGB8888 and
ARGB8888, so a compositor's 10 bpc framebuffer can never reach the
link, and an HDR10 link carries 8-bit PQ, which bands.

Take every format the panel's single-surface path presents (8 or 10
bits per component; 'l10r' is the surface's ARGB2101010 OSType) on
external frames too, and add the pure parts of presenting them: the
opaque surface format of a DRM format (the plane has no alpha to blend
with), and retagging a copy surface with the format of the frame copied
into it, which then takes the whole frame.

Three new KUnit cases in apple-dcp-m4-frame.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
(cherry picked from commit 9cf36424fe9232b32fe896340a8c632a5174e06d)
---
 drivers/gpu/drm/apple/dcp-m4-frame-test.c | 62 +++++++++++++++++++++++
 drivers/gpu/drm/apple/dcp-m4-frame.h      | 31 +++++++++++-
 2 files changed, 91 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-m4-frame-test.c b/drivers/gpu/drm/apple/dcp-m4-frame-test.c
index 4861183329..a038520ad8 100644
--- a/drivers/gpu/drm/apple/dcp-m4-frame-test.c
+++ b/drivers/gpu/drm/apple/dcp-m4-frame-test.c
@@ -210,6 +210,65 @@ static void frame_surface_bt709_tag(struct kunit *test)
 	}
 }
 
+/* External frames: 8 or 10 bits per component, presented opaque. */
+static void frame_ext_formats(struct kunit *test)
+{
+	static const struct { u32 fourcc; enum dcp_m4_frame_format format; } t[] = {
+		{ DRM_FORMAT_XRGB8888, DCP_M4_XRGB8888 },
+		{ DRM_FORMAT_ARGB8888, DCP_M4_XRGB8888 },
+		{ DRM_FORMAT_XRGB2101010, DCP_M4_XRGB2101010 },
+		{ DRM_FORMAT_ARGB2101010, DCP_M4_XRGB2101010 },
+	};
+	enum dcp_m4_frame_format format;
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(t); i++) {
+		KUNIT_EXPECT_EQ(test, dcp_m4_ext_format(t[i].fourcc, &format), 0);
+		KUNIT_EXPECT_EQ(test, format, t[i].format);
+	}
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_format(DRM_FORMAT_NV12, &format), -EINVAL);
+	KUNIT_EXPECT_EQ(test, dcp_m4_ext_format(DRM_FORMAT_RGB565, &format), -EINVAL);
+}
+
+static void frame_ext_check_10bit(struct kunit *test)
+{
+	struct dcp_m4_frame f = {
+		.dva = 1ULL << 40, .backing_size = 3840ULL * 4 * 2160,
+		.width = 3840, .height = 2160, .stride = 3840 * 4,
+		.format = DCP_M4_XRGB2101010, .bt709 = true,
+	};
+	u8 *s = kunit_kzalloc(test, DCP_M4_SURFACE_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_EXPECT_EQ(test, dcp_m4_frame_check_ext(&f), 0);
+	dcp_m4_surface_encode(s, &f);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(s + 0x0b), 0x6c313072U);	/* 'l10r' */
+	KUNIT_EXPECT_EQ(test, s[2], 1);
+	KUNIT_EXPECT_EQ(test, s[DCP_M4_SURFACE_PRIMARIES], DCP_M4_PRIMARIES_BT709);
+	f.format = DCP_M4_XRGB8888;
+	KUNIT_EXPECT_EQ(test, dcp_m4_frame_check_ext(&f), 0);
+	f.format = DCP_M4_ARGB2101010;
+	KUNIT_EXPECT_EQ(test, dcp_m4_frame_check_ext(&f), 0);
+	f.format = (enum dcp_m4_frame_format)7;
+	KUNIT_EXPECT_EQ(test, dcp_m4_frame_check_ext(&f), -EINVAL);
+	/* Still 4 bytes a pixel: a pitch under that is refused */
+	f.format = DCP_M4_XRGB2101010;
+	f.stride = 3840 * 3 + 64 - (3840 * 3) % 64;
+	KUNIT_EXPECT_EQ(test, dcp_m4_frame_check_ext(&f), -EINVAL);
+}
+
+static void frame_ext_retag(struct kunit *test)
+{
+	struct dcp_m4_frame f = { .format = DCP_M4_XRGB8888 };
+
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_retag(&f, DCP_M4_XRGB8888));
+	KUNIT_EXPECT_EQ(test, f.format, DCP_M4_XRGB8888);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_retag(&f, DCP_M4_XRGB2101010));
+	KUNIT_EXPECT_EQ(test, f.format, DCP_M4_XRGB2101010);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_ext_retag(&f, DCP_M4_XRGB2101010));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_retag(&f, DCP_M4_XRGB8888));
+	KUNIT_EXPECT_EQ(test, f.format, DCP_M4_XRGB8888);
+}
+
 static struct kunit_case m4_frame_cases[] = {
 	KUNIT_CASE(frame_drm_formats),
 	KUNIT_CASE(frame_format_helpers),
@@ -218,6 +277,9 @@ static struct kunit_case m4_frame_cases[] = {
 	KUNIT_CASE(frame_output_colour),
 	KUNIT_CASE(frame_surface_colour_tags),
 	KUNIT_CASE(frame_surface_bt709_tag),
+	KUNIT_CASE(frame_ext_formats),
+	KUNIT_CASE(frame_ext_check_10bit),
+	KUNIT_CASE(frame_ext_retag),
 	{}
 };
 
diff --git a/drivers/gpu/drm/apple/dcp-m4-frame.h b/drivers/gpu/drm/apple/dcp-m4-frame.h
index 202ac5f259..2c08d1beed 100644
--- a/drivers/gpu/drm/apple/dcp-m4-frame.h
+++ b/drivers/gpu/drm/apple/dcp-m4-frame.h
@@ -234,7 +234,8 @@ static inline u64 dcp_m4_nits_binary64(u32 nits)
 }
 
 /*
- * External outputs: any qualified size up to 3840x2160, same surface layout.
+ * External outputs: any qualified size up to 3840x2160, 8 or 10 bits per
+ * component, same surface layout.
  * The frame must already be described at its wire DVA in an owned mapping.
  */
 static inline int dcp_m4_frame_check_ext(const struct dcp_m4_frame *frame)
@@ -246,11 +247,37 @@ static inline int dcp_m4_frame_check_ext(const struct dcp_m4_frame *frame)
 	    !size || size > 0xffffffffULL || frame->backing_size < size ||
 	    !frame->dva || frame->dva % 0x4000 || frame->dva >= (1ULL << 42) ||
 	    size > (1ULL << 42) - frame->dva ||
-	    (frame->format != DCP_M4_XRGB8888 && frame->format != DCP_M4_ARGB8888))
+	    !dcp_m4_format_valid(frame->format))
 		return -EINVAL;
 	return 0;
 }
 
+/*
+ * The surface format an external frame of DRM format @fourcc is presented
+ * in: 8 or 10 bits per component, opaque (the plane has no alpha to blend
+ * with); -EINVAL for any other format.
+ */
+static inline int dcp_m4_ext_format(u32 fourcc, enum dcp_m4_frame_format *format)
+{
+	int ret = dcp_m4_drm_format(fourcc, format);
+
+	if (!ret)
+		*format = dcp_m4_format_opaque_of(*format);
+	return ret;
+}
+
+/*
+ * A copy surface takes the format of the frame copied into it: true if
+ * that changed it, when the whole frame must be copied.
+ */
+static inline bool dcp_m4_ext_retag(struct dcp_m4_frame *f, enum dcp_m4_frame_format format)
+{
+	if (f->format == format)
+		return false;
+	f->format = format;
+	return true;
+}
+
 /*
  * One upper surface of an indexed swap (cursor/overlay contract): firmware
  * surface-array index 1..3, a fully on-panel destination (the caller clips),
