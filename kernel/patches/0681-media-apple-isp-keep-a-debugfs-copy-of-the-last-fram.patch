From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 07:46:37 +0000
Subject: [PATCH] media: apple: isp: keep a debugfs copy of the last
 frame's metadata

Where the firmware reports what it measured in the per-frame metadata
(face boxes, white balance, exposure) is known for some sensors and not
for others; on T8132 the layout is not verified.

Add two root-only debugfs files: meta_snapshot, off by default, makes the
driver copy each returned metadata buffer into meta_last, up to 16 KiB.
Comparing copies taken with and without a face in frame, or with a
setting on and off, shows which section carries it. A read may mix two
frames; it is a debugging aid only.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit d136ba3d8070a17653c1fcf04957be4b09beeec3)
---
 drivers/media/platform/apple/isp/isp-drv.c  |  9 +++++++++
 drivers/media/platform/apple/isp/isp-drv.h  |  6 ++++++
 drivers/media/platform/apple/isp/isp-v4l2.c | 15 +++++++++++++++
 3 files changed, 30 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index abbc07ed04..3b1a12a884 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -528,6 +528,15 @@ static void apple_isp_debugfs_init(struct apple_isp *isp)
 			    &isp_stream_config_fops);
 	debugfs_create_u32("extra_frame_rate", 0600, isp->debugfs,
 			   &isp->extra_frame_rate);
+
+	isp->meta_snap.data = devm_kzalloc(isp->dev, ISP_META_SNAP_SIZE,
+					   GFP_KERNEL);
+	if (!isp->meta_snap.data)
+		return;
+	isp->meta_snap.size = ISP_META_SNAP_SIZE;
+	debugfs_create_bool("meta_snapshot", 0600, isp->debugfs,
+			    &isp->meta_snap_on);
+	debugfs_create_blob("meta_last", 0400, isp->debugfs, &isp->meta_snap);
 }
 
 static int apple_isp_init_presets(struct apple_isp *isp)
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index aa4dc3a0aa..88f22f4a07 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -4,6 +4,7 @@
 #ifndef __ISP_DRV_H__
 #define __ISP_DRV_H__
 
+#include <linux/debugfs.h>
 #include <linux/hrtimer.h>
 #include <linux/list.h>
 #include <linux/maple_tree.h>
@@ -45,6 +46,8 @@
  */
 #define ISP_BUFLIST_HDR_SIZE  0x10
 #define ISP_BUFLIST_DESC_SIZE 0x40
+#define ISP_META_SNAP_SIZE 0x4000
+
 #define ISP_CMD_AREA_SIZE(capmeta) \
 	(ISP_BUFLIST_HDR_SIZE + ISP_BUFLIST_DESC_SIZE * \
 	 (ISP_MAX_BUFFERS + (capmeta) + ISP_MAX_BUFFERS))
@@ -503,6 +506,9 @@ struct apple_isp {
 	bool stream_config_set;
 	u32 extra_frame_rate;
 	struct dentry *debugfs;
+	/* debugfs meta_snapshot / meta_last: a copy of the last frame's metadata */
+	bool meta_snap_on;
+	struct debugfs_blob_wrapper meta_snap;
 	/* configurations the firmware has, once a deferred start detected them */
 	u32 num_fw_presets;
 
diff --git a/drivers/media/platform/apple/isp/isp-v4l2.c b/drivers/media/platform/apple/isp/isp-v4l2.c
index ec0d2e1778..f3b589bda4 100644
--- a/drivers/media/platform/apple/isp/isp-v4l2.c
+++ b/drivers/media/platform/apple/isp/isp-v4l2.c
@@ -154,6 +154,20 @@ static void isp_meta_read_exposure(struct apple_isp *isp,
 	WRITE_ONCE(isp->frame_gain, gain);
 }
 
+/*
+ * With debugfs meta_snapshot on, keep a copy of each returned metadata
+ * buffer in meta_last, to find where the firmware reports what it
+ * measured (face boxes, white balance) for a sensor whose layout is not
+ * known. A read may see two frames mixed; it is a debugging aid.
+ */
+static void isp_meta_snapshot(struct apple_isp *isp, const struct isp_surf *meta)
+{
+	if (!READ_ONCE(isp->meta_snap_on) || !isp->meta_snap.data || !meta->virt)
+		return;
+	memcpy(isp->meta_snap.data, meta->virt,
+	       min_t(size_t, meta->size, isp->meta_snap.size));
+}
+
 void ipc_bt_complete(struct apple_isp *isp)
 {
 	struct isp_buffer *buf, *tmp;
@@ -215,6 +229,7 @@ int ipc_bt_handle(struct apple_isp *isp, struct isp_channel *chan)
 				if ((u32)bufd->iovas[0] == (u32)meta->iova) {
 					WARN_ON(!meta->submitted);
 					isp_meta_read_exposure(isp, meta);
+					isp_meta_snapshot(isp, meta);
 					if (isp_is_p010(isp))
 						__set_bit(j, &isp->meta_returned);
 					else
-- 
