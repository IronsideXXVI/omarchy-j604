diff --git a/drivers/media/platform/apple/scaler/apple-scaler-hw.c b/drivers/media/platform/apple/scaler/apple-scaler-hw.c
new file mode 100644
index 0000000000..2cbff1aee9
--- /dev/null
+++ b/drivers/media/platform/apple/scaler/apple-scaler-hw.c
@@ -0,0 +1,192 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple silicon scaler/CSC (MSR): format table, colour matrices and
+ * scale ratios in register encoding.
+ *
+ * The colour matrices are derived here from the luma coefficients the
+ * standards define (Kr, Kb), not looked up, so every encoding/range pair
+ * comes from one formula. The format codes and component orders are the
+ * values the engine is driven with for those layouts.
+ */
+#include <linux/array_size.h>
+#include <linux/bits.h>
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include <kunit/visibility.h>
+
+#include "apple-scaler-hw.h"
+
+#define ASC_SWIZZLE_IDENTITY	0x03020100
+#define ASC_SWIZZLE_CBCR	0x03000102
+
+static const struct asc_format asc_formats[] = {
+	{
+		/* Bytes B, G, R, A in memory. */
+		.fourcc = V4L2_PIX_FMT_ARGB32, .layout = 0x1, .code = 0x1e,
+		.sampling = 0x0, .swizzle = ASC_SWIZZLE_IDENTITY, .planes = 1,
+		.bpp = { 4 }, .hsub = 1, .vsub = 1, .alpha = true,
+	}, {
+		.fourcc = V4L2_PIX_FMT_XRGB32, .layout = 0x1, .code = 0x1e,
+		.sampling = 0x0, .swizzle = ASC_SWIZZLE_IDENTITY, .planes = 1,
+		.bpp = { 4 }, .hsub = 1, .vsub = 1,
+	}, {
+		.fourcc = V4L2_PIX_FMT_NV12M, .layout = 0xc, .code = 0x1,
+		.sampling = 0x6, .swizzle = ASC_SWIZZLE_CBCR, .planes = 2,
+		.bpp = { 1, 2 }, .hsub = 2, .vsub = 2, .yuv = true,
+	}, {
+		.fourcc = V4L2_PIX_FMT_NV12, .layout = 0xc, .code = 0x1,
+		.sampling = 0x6, .swizzle = ASC_SWIZZLE_CBCR, .planes = 2,
+		.bpp = { 1, 2 }, .hsub = 2, .vsub = 2, .yuv = true,
+	}, {
+		/* 10 bits in the top of each 16-bit sample. */
+		.fourcc = V4L2_PIX_FMT_P010, .layout = 0xc, .code = 0x2,
+		.sampling = 0x12, .swizzle = ASC_SWIZZLE_CBCR, .planes = 2,
+		.bpp = { 2, 4 }, .hsub = 2, .vsub = 2, .yuv = true,
+	},
+};
+
+const struct asc_format *asc_format_by_index(unsigned int index)
+{
+	return index < ARRAY_SIZE(asc_formats) ? &asc_formats[index] : NULL;
+}
+EXPORT_SYMBOL_IF_KUNIT(asc_format_by_index);
+
+const struct asc_format *asc_find_format(u32 fourcc)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(asc_formats); i++)
+		if (asc_formats[i].fourcc == fourcc)
+			return &asc_formats[i];
+	return NULL;
+}
+EXPORT_SYMBOL_IF_KUNIT(asc_find_format);
+
+/* Luma coefficients Kr and Kb in units of 1/10000. */
+struct asc_luma {
+	s64 kr, kb;
+};
+
+static int asc_luma_coefs(enum v4l2_ycbcr_encoding enc, struct asc_luma *l)
+{
+	switch (enc) {
+	case V4L2_YCBCR_ENC_601:
+	case V4L2_YCBCR_ENC_XV601:
+		*l = (struct asc_luma){ 2990, 1140 };
+		return 0;
+	case V4L2_YCBCR_ENC_709:
+	case V4L2_YCBCR_ENC_XV709:
+		*l = (struct asc_luma){ 2126, 722 };
+		return 0;
+	case V4L2_YCBCR_ENC_BT2020:
+		*l = (struct asc_luma){ 2627, 593 };
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+/* round(num / den) for signed num and positive den */
+static s64 asc_div_round(s64 num, s64 den)
+{
+	return num >= 0 ? div64_s64(num + den / 2, den) : -div64_s64(-num + den / 2, den);
+}
+
+/* A coefficient num/den (with the range scale sn/sd applied) in Q3.12. */
+static s16 asc_q12(s64 num, s64 den, s64 sn, s64 sd)
+{
+	return (s16)asc_div_round(num * sn << ASC_CSC_COEF_SHIFT, den * sd);
+}
+
+/*
+ * Offsets are in units of 2^-24 of full scale. The engine works on a
+ * 16-bit internal scale, so the limited-range black level (8-bit code 16)
+ * is 0x1010 there; the chroma midpoint is 0x8020 (10-bit code 512). These
+ * are the levels the engine is driven with on macOS for every encoding
+ * and depth.
+ */
+#define ASC_LUMA_BLACK	(0x1010 << 8)
+#define ASC_CHROMA_MID	(0x8020 << 8)
+
+/**
+ * asc_csc_compute - colour conversion between Y'CbCr and R'G'B'
+ * @enc: Y'CbCr encoding (luma coefficients)
+ * @quant: range of the Y'CbCr side (the R'G'B' side is full range)
+ * @yuv_to_rgb: direction
+ * @csc: result in register encoding
+ *
+ * Return: 0, or -EINVAL for an encoding the matrix cannot express.
+ */
+int asc_csc_compute(enum v4l2_ycbcr_encoding enc,
+		    enum v4l2_quantization quant, bool yuv_to_rgb,
+		    struct asc_csc *csc)
+{
+	const s64 one = 10000;
+	bool limited = quant != V4L2_QUANTIZATION_FULL_RANGE;
+	/* Range scales: luma 219/255 and chroma 224/255 for limited range. */
+	s64 yn = limited ? 219 : 1, yd = limited ? 255 : 1;
+	s64 cn = limited ? 224 : 1, cd = limited ? 255 : 1;
+	struct asc_luma l;
+	s64 kg;
+	int i;
+
+	if (asc_luma_coefs(enc, &l))
+		return -EINVAL;
+	kg = one - l.kr - l.kb;
+	memset(csc, 0, sizeof(*csc));
+
+	if (yuv_to_rgb) {
+		/* R = Y + 2(1-Kr) Cr, B = Y + 2(1-Kb) Cb, G from Y = Kr R + Kg G + Kb B */
+		for (i = 0; i < 3; i++)
+			csc->coef[i][0] = asc_q12(1, 1, yd, yn);
+		csc->coef[0][2] = asc_q12(2 * (one - l.kr), one, cd, cn);
+		csc->coef[1][1] = asc_q12(-2 * l.kb * (one - l.kb), one * kg, cd, cn);
+		csc->coef[1][2] = asc_q12(-2 * l.kr * (one - l.kr), one * kg, cd, cn);
+		csc->coef[2][1] = asc_q12(2 * (one - l.kb), one, cd, cn);
+		csc->pre[0] = limited ? -ASC_LUMA_BLACK : 0;
+		csc->pre[1] = -ASC_CHROMA_MID;
+		csc->pre[2] = -ASC_CHROMA_MID;
+	} else {
+		/* Y = Kr R + Kg G + Kb B, Cb = (B - Y) / 2(1-Kb), Cr = (R - Y) / 2(1-Kr) */
+		csc->coef[0][0] = asc_q12(l.kr, one, yn, yd);
+		csc->coef[0][1] = asc_q12(kg, one, yn, yd);
+		csc->coef[0][2] = asc_q12(l.kb, one, yn, yd);
+		csc->coef[1][0] = asc_q12(-l.kr, 2 * (one - l.kb), cn, cd);
+		csc->coef[1][1] = asc_q12(-kg, 2 * (one - l.kb), cn, cd);
+		csc->coef[1][2] = asc_q12(1, 2, cn, cd);
+		csc->coef[2][0] = asc_q12(1, 2, cn, cd);
+		csc->coef[2][1] = asc_q12(-kg, 2 * (one - l.kr), cn, cd);
+		csc->coef[2][2] = asc_q12(-l.kb, 2 * (one - l.kr), cn, cd);
+		csc->post[0] = limited ? ASC_LUMA_BLACK : 0;
+		csc->post[1] = ASC_CHROMA_MID;
+		csc->post[2] = ASC_CHROMA_MID;
+	}
+	return 0;
+}
+EXPORT_SYMBOL_IF_KUNIT(asc_csc_compute);
+
+u32 asc_csc_offset_reg(s32 offset)
+{
+	return (u32)offset & ASC_CSC_OFFSET_MASK;
+}
+EXPORT_SYMBOL_IF_KUNIT(asc_csc_offset_reg);
+
+/**
+ * asc_scale_ratio - one scaler ratio register value
+ * @in: input extent in pixels
+ * @out: output extent in pixels
+ *
+ * Return: in/out in Q22 with the two lowest bits clear, as the engine
+ * takes it; 0 if @out is 0.
+ */
+u32 asc_scale_ratio(u32 in, u32 out)
+{
+	if (!out)
+		return 0;
+	return (u32)div_u64((u64)in << ASC_RATIO_SHIFT, out) & ~3u;
+}
+EXPORT_SYMBOL_IF_KUNIT(asc_scale_ratio);
diff --git a/drivers/media/platform/apple/scaler/apple-scaler-hw.h b/drivers/media/platform/apple/scaler/apple-scaler-hw.h
new file mode 100644
index 0000000000..3093aebc3d
--- /dev/null
+++ b/drivers/media/platform/apple/scaler/apple-scaler-hw.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Apple silicon scaler/CSC (MSR): pipeline field encodings.
+ *
+ * These helpers compute register values from V4L2 state. They touch no
+ * hardware, so KUnit checks them against the values the engine is known
+ * to accept.
+ */
+#ifndef APPLE_SCALER_HW_H
+#define APPLE_SCALER_HW_H
+
+#include <linux/types.h>
+#include <linux/videodev2.h>
+
+/* Colour-space converter block. */
+#define ASC_CSC_CTRL			0x3800
+#define   ASC_CSC_CTRL_BYPASS		0x000e0000
+#define   ASC_CSC_CTRL_ENABLE		0x000e0003
+#define ASC_CSC_MODE			0x3804
+#define   ASC_CSC_MODE_DEFAULT		0xc
+#define ASC_CSC_PRE_OFFSET(i)		(0x3808 + 4 * (i))
+#define ASC_CSC_COEF(row, col)		(0x3814 + 4 * (3 * (row) + (col)))
+#define ASC_CSC_POST_OFFSET(i)		(0x3838 + 4 * (i))
+
+/* Matrix coefficients are signed Q3.12. */
+#define ASC_CSC_COEF_SHIFT		12
+/* Offsets are signed fractions of full scale: 1.0 = 1 << 24, 26-bit field. */
+#define ASC_CSC_OFFSET_SHIFT		24
+#define ASC_CSC_OFFSET_MASK		GENMASK(25, 0)
+
+/* Scale ratios are unsigned Q22. */
+#define ASC_RATIO_SHIFT			22
+
+/**
+ * struct asc_csc - one colour conversion, in register encoding
+ * @coef: 3x3 matrix, row = output channel, column = input channel
+ * @pre: offsets added to the input channels before the matrix
+ * @post: offsets added to the output channels after the matrix
+ */
+struct asc_csc {
+	s16 coef[3][3];
+	s32 pre[3];
+	s32 post[3];
+};
+
+/**
+ * struct asc_format - a pixel format the engine reads and writes
+ * @fourcc: V4L2 pixel format
+ * @layout: layout class (source 0x180 / destination 0x280)
+ * @code: format code (source 0x184; destination 0x284 without bit 15)
+ * @sampling: subsampling descriptor (source 0x188 / destination 0x288 without bit 15)
+ * @swizzle: component order (source 0x1f8 / destination 0x2d8)
+ * @planes: colour planes (each needs its own DMA address)
+ * @bpp: bytes per sample position of each plane, at that plane's resolution
+ * @hsub: horizontal chroma subsampling of plane 1
+ * @vsub: vertical chroma subsampling of plane 1
+ * @yuv: Y'CbCr format (needs the CSC to pair with RGB)
+ * @alpha: carries an alpha channel
+ */
+struct asc_format {
+	u32 fourcc;
+	u32 layout;
+	u32 code;
+	u32 sampling;
+	u32 swizzle;
+	u8 planes;
+	u8 bpp[2];
+	u8 hsub;
+	u8 vsub;
+	bool yuv;
+	bool alpha;
+};
+
+const struct asc_format *asc_find_format(u32 fourcc);
+const struct asc_format *asc_format_by_index(unsigned int index);
+
+int asc_csc_compute(enum v4l2_ycbcr_encoding enc,
+		    enum v4l2_quantization quant, bool yuv_to_rgb,
+		    struct asc_csc *csc);
+u32 asc_csc_offset_reg(s32 offset);
+
+u32 asc_scale_ratio(u32 in, u32 out);
+
+#endif /* APPLE_SCALER_HW_H */
diff --git a/drivers/media/platform/apple/scaler/apple-scaler-test.c b/drivers/media/platform/apple/scaler/apple-scaler-test.c
new file mode 100644
index 0000000000..58f3b2f6f3
--- /dev/null
+++ b/drivers/media/platform/apple/scaler/apple-scaler-test.c
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests for the Apple scaler/CSC register encodings.
+ *
+ * The expected words are what the engine was driven with for the same
+ * conversions in our macOS capture (traces/display/20261108-msr-trace),
+ * and they equal the textbook BT.601/BT.709/BT.2020 matrices in Q3.12.
+ */
+#include <kunit/test.h>
+#include <linux/array_size.h>
+#include <linux/math.h>
+#include <linux/string.h>
+
+#include "apple-scaler-hw.h"
+
+struct asc_csc_case {
+	const char *name;
+	enum v4l2_ycbcr_encoding enc;
+	enum v4l2_quantization quant;
+	bool yuv_to_rgb;
+	u16 coef[9];
+	u32 pre[3];
+	u32 post[3];
+};
+
+static const struct asc_csc_case asc_csc_cases[] = {
+	{ "BT.709 limited to RGB", V4L2_YCBCR_ENC_709, V4L2_QUANTIZATION_LIM_RANGE, true,
+	  { 0x12a1, 0x0000, 0x1caf, 0x12a1, 0xfc97, 0xf779, 0x12a1, 0x21cc, 0x0000 },
+	  { 0x03eff000, 0x037fe000, 0x037fe000 }, { 0, 0, 0 } },
+	{ "BT.601 limited to RGB", V4L2_YCBCR_ENC_601, V4L2_QUANTIZATION_LIM_RANGE, true,
+	  { 0x12a1, 0x0000, 0x1989, 0x12a1, 0xf9bb, 0xf2fe, 0x12a1, 0x2047, 0x0000 },
+	  { 0x03eff000, 0x037fe000, 0x037fe000 }, { 0, 0, 0 } },
+	{ "BT.709 full to RGB", V4L2_YCBCR_ENC_709, V4L2_QUANTIZATION_FULL_RANGE, true,
+	  { 0x1000, 0x0000, 0x1932, 0x1000, 0xfd01, 0xf883, 0x1000, 0x1db1, 0x0000 },
+	  { 0x00000000, 0x037fe000, 0x037fe000 }, { 0, 0, 0 } },
+	{ "BT.2020 limited to RGB", V4L2_YCBCR_ENC_BT2020, V4L2_QUANTIZATION_LIM_RANGE, true,
+	  { 0x12a1, 0x0000, 0x1adc, 0x12a1, 0xfd01, 0xf598, 0x12a1, 0x2245, 0x0000 },
+	  { 0x03eff000, 0x037fe000, 0x037fe000 }, { 0, 0, 0 } },
+	{ "RGB to BT.709 limited", V4L2_YCBCR_ENC_709, V4L2_QUANTIZATION_LIM_RANGE, false,
+	  { 0x02ec, 0x09d4, 0x00fe, 0xfe64, 0xfa95, 0x0707, 0x0707, 0xf99e, 0xff5b },
+	  { 0, 0, 0 }, { 0x00101000, 0x00802000, 0x00802000 } },
+	{ "RGB to BT.601 limited", V4L2_YCBCR_ENC_601, V4L2_QUANTIZATION_LIM_RANGE, false,
+	  { 0x041c, 0x0811, 0x0191, 0xfda1, 0xfb58, 0x0707, 0x0707, 0xfa1e, 0xfedb },
+	  { 0, 0, 0 }, { 0x00101000, 0x00802000, 0x00802000 } },
+};
+
+static void asc_csc_case_desc(const struct asc_csc_case *c, char *desc)
+{
+	strscpy(desc, c->name, KUNIT_PARAM_DESC_SIZE);
+}
+
+KUNIT_ARRAY_PARAM(asc_csc, asc_csc_cases, asc_csc_case_desc);
+
+static void asc_test_csc(struct kunit *test)
+{
+	const struct asc_csc_case *c = test->param_value;
+	struct asc_csc csc;
+	int i;
+
+	KUNIT_ASSERT_EQ(test, asc_csc_compute(c->enc, c->quant, c->yuv_to_rgb, &csc), 0);
+	for (i = 0; i < 9; i++)
+		KUNIT_EXPECT_EQ_MSG(test, (u16)csc.coef[i / 3][i % 3], c->coef[i],
+				    "coefficient %d", i);
+	for (i = 0; i < 3; i++) {
+		KUNIT_EXPECT_EQ_MSG(test, asc_csc_offset_reg(csc.pre[i]), c->pre[i],
+				    "pre-offset %d", i);
+		KUNIT_EXPECT_EQ_MSG(test, asc_csc_offset_reg(csc.post[i]), c->post[i],
+				    "post-offset %d", i);
+	}
+}
+
+static void asc_test_csc_rejects(struct kunit *test)
+{
+	struct asc_csc csc;
+
+	KUNIT_EXPECT_EQ(test, asc_csc_compute(V4L2_YCBCR_ENC_SMPTE240M,
+					      V4L2_QUANTIZATION_LIM_RANGE, true, &csc),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, asc_csc_compute(V4L2_YCBCR_ENC_BT2020_CONST_LUM,
+					      V4L2_QUANTIZATION_LIM_RANGE, true, &csc),
+			-EINVAL);
+}
+
+/* Every matrix row must reproduce white and black exactly (to rounding). */
+static void asc_test_csc_white(struct kunit *test)
+{
+	static const enum v4l2_ycbcr_encoding encs[] = {
+		V4L2_YCBCR_ENC_601, V4L2_YCBCR_ENC_709, V4L2_YCBCR_ENC_BT2020,
+	};
+	struct asc_csc csc;
+	int e, row;
+
+	for (e = 0; e < ARRAY_SIZE(encs); e++) {
+		KUNIT_ASSERT_EQ(test, asc_csc_compute(encs[e], V4L2_QUANTIZATION_FULL_RANGE,
+						      false, &csc), 0);
+		/* RGB -> YCbCr: Y row sums to 1.0, chroma rows to 0. */
+		KUNIT_EXPECT_LE(test, abs(csc.coef[0][0] + csc.coef[0][1] + csc.coef[0][2] - 4096), 1);
+		for (row = 1; row < 3; row++)
+			KUNIT_EXPECT_LE(test, abs(csc.coef[row][0] + csc.coef[row][1] +
+						  csc.coef[row][2]), 1);
+	}
+}
+
+static void asc_test_ratio(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, asc_scale_ratio(1920, 1920), 0x400000);
+	KUNIT_EXPECT_EQ(test, asc_scale_ratio(1920, 1280), 0x600000);
+	KUNIT_EXPECT_EQ(test, asc_scale_ratio(1280, 1920), 0x2aaaa8);
+	KUNIT_EXPECT_EQ(test, asc_scale_ratio(640, 1920), 0x155554);
+	KUNIT_EXPECT_EQ(test, asc_scale_ratio(1920, 640), 0xc00000);
+	KUNIT_EXPECT_EQ(test, asc_scale_ratio(1, 0), 0);
+}
+
+static void asc_test_formats(struct kunit *test)
+{
+	const struct asc_format *f;
+	unsigned int i;
+
+	f = asc_find_format(V4L2_PIX_FMT_NV12M);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_EXPECT_EQ(test, f->layout, 0xc);
+	KUNIT_EXPECT_EQ(test, f->code, 0x1);
+	KUNIT_EXPECT_EQ(test, f->sampling, 0x6);
+	KUNIT_EXPECT_EQ(test, f->swizzle, 0x03000102);
+
+	f = asc_find_format(V4L2_PIX_FMT_ARGB32);
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_EXPECT_EQ(test, f->code, 0x1e);
+	KUNIT_EXPECT_EQ(test, f->swizzle, 0x03020100);
+
+	KUNIT_EXPECT_NULL(test, asc_find_format(V4L2_PIX_FMT_YUYV));
+
+	for (i = 0; (f = asc_format_by_index(i)); i++) {
+		KUNIT_EXPECT_GE(test, f->planes, 1);
+		KUNIT_EXPECT_LE(test, f->planes, 2);
+		KUNIT_EXPECT_EQ(test, f->yuv, f->layout != 0x1);
+		KUNIT_EXPECT_EQ(test, f->planes == 2, f->yuv);
+	}
+}
+
+static struct kunit_case asc_test_cases[] = {
+	KUNIT_CASE_PARAM(asc_test_csc, asc_csc_gen_params),
+	KUNIT_CASE(asc_test_csc_rejects),
+	KUNIT_CASE(asc_test_csc_white),
+	KUNIT_CASE(asc_test_ratio),
+	KUNIT_CASE(asc_test_formats),
+	{}
+};
+
+static struct kunit_suite asc_test_suite = {
+	.name = "apple-scaler",
+	.test_cases = asc_test_cases,
+};
+kunit_test_suite(asc_test_suite);
+
+MODULE_IMPORT_NS("EXPORTED_FOR_KUNIT_TESTING");
+MODULE_DESCRIPTION("KUnit tests for the Apple scaler/CSC encodings");
+MODULE_LICENSE("GPL");
