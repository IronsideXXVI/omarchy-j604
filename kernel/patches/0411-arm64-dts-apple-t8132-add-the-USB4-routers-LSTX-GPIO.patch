From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Mon, 2 Nov 2026 18:49:25 -0500
Subject: [PATCH] arm64: dts: apple: t8132: add the USB4 routers' LSTX GPIOs

Give each router its LSTX pin as a GPIO, which the host holds once the
router has stopped.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 57cd06ca7e13ee11b1c19f85664a462a73641985)
---
 arch/arm64/boot/dts/apple/t8132-usb4.dtsi | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-usb4.dtsi b/arch/arm64/boot/dts/apple/t8132-usb4.dtsi
index 882afd83a5..f4b29870ff 100644
--- a/arch/arm64/boot/dts/apple/t8132-usb4.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-usb4.dtsi
@@ -12,7 +12,7 @@
  */
 
 &pinctrl_aop {
-	/* LSTX, handed to each router once it is up (ADT acioN.gpio-lstx). */
+	/* LSTX, handed to each router once it is up and held as a GPIO while it is off. */
 	usb4_0_lstx_pins: usb4-0-lstx-pins {
 		pinmux = <APPLE_PINMUX(17, 1)>;
 	};
@@ -63,6 +63,7 @@
 		resets = <&cio_reset 0>;
 		pinctrl-names = "lstx";
 		pinctrl-0 = <&usb4_0_lstx_pins>;
+		lstx-gpios = <&pinctrl_aop 17 GPIO_ACTIVE_HIGH>;
 
 		power-domains = <&ps_atc0_cio>,
 				<&ps_atc0_cio_pcie>,
@@ -178,6 +179,7 @@
 		resets = <&cio_reset 1>;
 		pinctrl-names = "lstx";
 		pinctrl-0 = <&usb4_1_lstx_pins>;
+		lstx-gpios = <&pinctrl_aop 19 GPIO_ACTIVE_HIGH>;
 
 		power-domains = <&ps_atc1_cio>,
 				<&ps_atc1_cio_pcie>,
