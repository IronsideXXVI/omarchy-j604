 	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, ctrl);
 	spmi_controller_set_drvdata(ctrl, t);
 	ctrl->cmd = sn201202x_test_cmd;
+	ctrl->read_cmd = sn201202x_test_read_cmd;
+	ctrl->write_cmd = sn201202x_test_write_cmd;
