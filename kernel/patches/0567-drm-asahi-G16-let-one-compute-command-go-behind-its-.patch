From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 13:42:38 +0000
Subject: [PATCH] drm/asahi: G16: let one compute command go behind its
 predecessor by default

macOS keeps G16G commands resident and kicks each one as it is
published; with g16_horizon at 0 our compute path publishes one command
at a time and the firmware waits a full host round trip between them.
On the J604 the horizon window (format A: one compute command behind its
running predecessor in the other split UMA slot, one kick and one
completion per command) measured compute.light at depth 64 210.4 ->
165.0 us per submit and the core-a geomean 4.18x -> 3.84x of the Mini,
with deqp-vk compute, render and sync clean.

Make 1 the default. It still takes effect only with g16_overlap and the
UMA split, both on by default since resident render depth shipped;
explicit barriers and historical priors still wait for completion, and
0 restores the one-at-a-time protocol at run time.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/params.rs | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index e6dcc6a70f..3c2282ee7d 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -575,8 +575,8 @@ pub(crate) fn submit_ts() -> u32 {
     "G16: clock of the submit record time word (default 0: architectural counter; 1: firmware stage clock, 24 MHz; runtime 0644)"
 );
 
-/// Storage of `g16_horizon` (runtime 0644, default 0).
-static HORIZON: AtomicU32 = AtomicU32::new(0);
+/// Storage of `g16_horizon` (runtime 0644, default 1).
+static HORIZON: AtomicU32 = AtomicU32::new(1);
 
 /// Compute horizon, format A (per-command ahead posting): with `g16_horizon` = 1, a queue's
 /// next compute command may be published behind its running compute predecessor, into the
@@ -584,8 +584,9 @@ pub(crate) fn submit_ts() -> u32 {
 /// completion per command, as macOS does on G16G). Takes effect only while `g16_overlap` is set
 /// and the UMA split is latched, which make the second compute owner reusable at once. Explicit
 /// barriers and historical priors still wait for completion; one job never occupies two
-/// flights. 0 (default) keeps the qualified one-compute-at-a-time protocol. 2 (format B, several
-/// commands in one prefix) is reserved and acts as 0.
+/// flights. 1 is the default (J604, k884 window: compute.light d64 210.4 -> 165.0 us/submit, deqp-vk
+/// compute/render/sync clean); 0 keeps the qualified one-compute-at-a-time protocol. 2 (format B,
+/// several commands in one prefix) is reserved and acts as 0.
 pub(crate) fn horizon() -> bool {
     HORIZON.load(Ordering::Relaxed) == 1 && super::pools::lifetime::overlap_active()
 }
@@ -596,7 +597,7 @@ pub(crate) fn horizon() -> bool {
     HORIZON_PARM,
     HORIZON,
     "g16_horizon",
-    "G16: compute commands of one queue that may go behind its running compute predecessor (default 0: none; 1: one, needs g16_overlap=1 and g16_uma_split=1; 2 reserved; runtime 0644)"
+    "G16: compute commands of one queue that may go behind its running compute predecessor (default 1: one, needs g16_overlap=1 and g16_uma_split=1; 0: none; 2 reserved; runtime 0644)"
 );
 
 /// Storage of `g16_depth` (runtime 0644, default 0).
-- 
