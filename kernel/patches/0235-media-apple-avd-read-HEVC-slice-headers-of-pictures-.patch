--- /dev/null
+++ b/drivers/media/platform/apple/avd/avd-hevc-parse.c
@@ -0,0 +1,549 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Apple AVD: HEVC slice segment headers for frame-based decoding.
+ *
+ * A client such as Chromium sends each picture as Annex-B slice NAL units
+ * (three-byte start codes) in one OUTPUT buffer with the SPS, PPS and decode
+ * parameters, but no slice parameters. The instruction builder needs them, so
+ * they are read here from each slice segment header (H.265 7.3.6.1-7.3.6.3)
+ * and filled the way a slice-based client fills them: reference lists as DPB
+ * indices built from the decode parameters (8.3.4), chroma offsets derived
+ * (7-56), the picture order count of the picture. The parts of the header the
+ * decode parameters already describe in bits (the short-term and long-term
+ * reference picture sets) are skipped by those sizes.
+ *
+ * Each slice's region of the buffer starts at its start code (or at the end of
+ * the previous slice, so NAL units in between belong to it): data_byte_offset
+ * counts from there to the first slice data byte and bit_size covers the whole
+ * region, so the regions are contiguous as the instruction builder expects.
+ *
+ * Copyright The Aurora Silicon Contributors
+ */
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/log2.h>
+#include <linux/string.h>
+
+#include "avd-hevc-parse.h"
+
+#define SL_LF_ACROSS	V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_LOOP_FILTER_ACROSS_SLICES_ENABLED
+#define PPS_LF_ACROSS	V4L2_HEVC_PPS_FLAG_PPS_LOOP_FILTER_ACROSS_SLICES_ENABLED
+#define SL_COL_FROM_L0	V4L2_HEVC_SLICE_PARAMS_FLAG_COLLOCATED_FROM_L0
+
+#define NAL_IDR_W_RADL	19
+#define NAL_IDR_N_LP	20
+#define NAL_BLA_W_LP	16
+#define NAL_RSV_IRAP_23	23
+
+struct hevc_rbsp {
+	const u8 *data;
+	u32 len;
+	u32 pos;	/* byte of data[] that holds the next bit */
+	u8 bit;		/* next bit of that byte, 0 is the MSB */
+	u8 zeros;	/* zero bytes just read */
+	u8 cur;
+	bool err;
+};
+
+static u32 rbsp_bit(struct hevc_rbsp *r)
+{
+	u32 v;
+
+	if (r->err)
+		return 0;
+	if (!r->bit) {
+		/* in 00 00 03 the 03 is emulation prevention, not data */
+		if (r->zeros >= 2 && r->pos < r->len && r->data[r->pos] == 0x03) {
+			r->pos++;
+			r->zeros = 0;
+		}
+		if (r->pos >= r->len) {
+			r->err = true;
+			return 0;
+		}
+		r->cur = r->data[r->pos];
+		r->zeros = r->cur ? 0 : r->zeros + 1;
+	}
+	v = (r->cur >> (7 - r->bit)) & 1;
+	if (++r->bit == 8) {
+		r->bit = 0;
+		r->pos++;
+	}
+	return v;
+}
+
+static u32 rbsp_u(struct hevc_rbsp *r, unsigned int n)
+{
+	u32 v = 0;
+
+	while (n--)
+		v = (v << 1) | rbsp_bit(r);
+	return v;
+}
+
+static void rbsp_skip(struct hevc_rbsp *r, u32 n)
+{
+	while (n-- && !r->err)
+		rbsp_bit(r);
+}
+
+static u32 rbsp_ue(struct hevc_rbsp *r)
+{
+	unsigned int zeros = 0;
+
+	while (!rbsp_bit(r) && !r->err)
+		if (++zeros > 31) {
+			r->err = true;
+			return 0;
+		}
+	return ((1U << zeros) - 1) + rbsp_u(r, zeros);
+}
+
+static s32 rbsp_se(struct hevc_rbsp *r)
+{
+	u32 k = rbsp_ue(r);
+
+	return k & 1 ? (s32)((k + 1) / 2) : -(s32)(k / 2);
+}
+
+/* Ceil(Log2(n)) for n >= 1 */
+static unsigned int ceil_log2(u32 n)
+{
+	return n > 1 ? order_base_2(n) : 0;
+}
+
+bool avd_hevc_annexb(const u8 *buf, u32 len)
+{
+	/*
+	 * A NAL header's second byte is never 0 (nuh_temporal_id_plus1), so a
+	 * buffer that starts with 00 00 01 holds start codes.
+	 */
+	return len >= 4 && !buf[0] && !buf[1] &&
+	       (buf[2] == 1 || (!buf[2] && buf[3] == 1));
+}
+
+static int parse_pred_weights(struct hevc_rbsp *r, bool chroma, bool b_slice,
+			      u8 n0, u8 n1, struct v4l2_hevc_pred_weight_table *pw)
+{
+	u8 luma_flags[2][V4L2_HEVC_DPB_ENTRIES_NUM_MAX] = {};
+	u8 chroma_flags[2][V4L2_HEVC_DPB_ENTRIES_NUM_MAX] = {};
+	u32 denom = rbsp_ue(r);
+	s32 cdenom = 0;
+	int list, i, j;
+
+	if (denom > 7)
+		return -EINVAL;
+	pw->luma_log2_weight_denom = denom;
+	if (chroma) {
+		cdenom = rbsp_se(r);
+		if ((s32)denom + cdenom < 0 || (s32)denom + cdenom > 7)
+			return -EINVAL;
+		pw->delta_chroma_log2_weight_denom = cdenom;
+	}
+	for (list = 0; list < (b_slice ? 2 : 1); list++) {
+		u8 n = list ? n1 : n0;
+		s8 *dlw = list ? pw->delta_luma_weight_l1 : pw->delta_luma_weight_l0;
+		s8 *lo = list ? pw->luma_offset_l1 : pw->luma_offset_l0;
+		s8 (*dcw)[2] = list ? pw->delta_chroma_weight_l1 : pw->delta_chroma_weight_l0;
+		s8 (*co)[2] = list ? pw->chroma_offset_l1 : pw->chroma_offset_l0;
+
+		for (i = 0; i <= n; i++)
+			luma_flags[list][i] = rbsp_bit(r);
+		if (chroma)
+			for (i = 0; i <= n; i++)
+				chroma_flags[list][i] = rbsp_bit(r);
+		for (i = 0; i <= n; i++) {
+			if (luma_flags[list][i]) {
+				s32 dw = rbsp_se(r), off = rbsp_se(r);
+
+				if (dw < -128 || dw > 127 || off < -128 || off > 127)
+					return -EINVAL;
+				dlw[i] = dw;
+				lo[i] = off;
+			}
+			if (!chroma_flags[list][i])
+				continue;
+			for (j = 0; j < 2; j++) {
+				s32 dw = rbsp_se(r), doff = rbsp_se(r);
+				s32 cl2 = (s32)denom + cdenom;
+				s32 w = (1 << cl2) + dw, off;
+
+				if (dw < -128 || dw > 127 || doff < -512 || doff > 511)
+					return -EINVAL;
+				dcw[i][j] = dw;
+				/* 7-56, 8-bit offsets (no high_precision_offsets) */
+				off = 128 - ((128 * w) >> cl2) + doff;
+				co[i][j] = clamp(off, -128, 127);
+			}
+		}
+	}
+	return r->err ? -EINVAL : 0;
+}
+
+/* RefPicListX as DPB indices (8.3.4), with list_entry_lX if modified. */
+static int build_list(const struct v4l2_ctrl_hevc_decode_params *dec, bool l1,
+		      u8 num_active, const u8 *entries, bool modified, u8 *out)
+{
+	u8 temp[V4L2_HEVC_DPB_ENTRIES_NUM_MAX];
+	u32 total = dec->num_poc_st_curr_before + dec->num_poc_st_curr_after +
+		    dec->num_poc_lt_curr;
+	u32 n = max_t(u32, num_active, total), r = 0, i;
+
+	if (!total || n > V4L2_HEVC_DPB_ENTRIES_NUM_MAX)
+		return -EINVAL;
+	while (r < n) {
+		const u8 *first = l1 ? dec->poc_st_curr_after : dec->poc_st_curr_before;
+		const u8 *second = l1 ? dec->poc_st_curr_before : dec->poc_st_curr_after;
+		u8 nfirst = l1 ? dec->num_poc_st_curr_after : dec->num_poc_st_curr_before;
+		u8 nsecond = l1 ? dec->num_poc_st_curr_before : dec->num_poc_st_curr_after;
+
+		for (i = 0; i < nfirst && r < n; i++)
+			temp[r++] = first[i];
+		for (i = 0; i < nsecond && r < n; i++)
+			temp[r++] = second[i];
+		for (i = 0; i < dec->num_poc_lt_curr && r < n; i++)
+			temp[r++] = dec->poc_lt_curr[i];
+	}
+	for (i = 0; i < num_active; i++) {
+		u8 idx = modified ? entries[i] : i;
+
+		if (idx >= n || temp[idx] >= V4L2_HEVC_DPB_ENTRIES_NUM_MAX)
+			return -EINVAL;
+		out[i] = temp[idx];
+	}
+	return 0;
+}
+
+/**
+ * avd_hevc_parse_slice() - read one slice segment header
+ * @nal: the NAL unit, from its two-byte header, no start code
+ * @len: bytes of @nal
+ * @sps, @pps, @dec: the picture's parameters
+ * @prev: the previous slice segment of the picture, or NULL for the first one
+ *	  (a dependent slice segment takes its header fields from it)
+ * @sl: filled; bit_size and data_byte_offset relative to @nal
+ * @entry_points: receives entry_point_offset_minus1 + 1 of each entry point
+ * @max_entry_points: room in @entry_points
+ * @header_bytes: bytes of @nal before the slice data (header + alignment)
+ *
+ * Return: 0, or -EINVAL for a header this driver cannot describe.
+ */
+int avd_hevc_parse_slice(const u8 *nal, u32 len,
+			 const struct v4l2_ctrl_hevc_sps *sps,
+			 const struct v4l2_ctrl_hevc_pps *pps,
+			 const struct v4l2_ctrl_hevc_decode_params *dec,
+			 const struct v4l2_ctrl_hevc_slice_params *prev,
+			 struct v4l2_ctrl_hevc_slice_params *sl,
+			 u32 *entry_points, u32 max_entry_points,
+			 u32 *header_bytes)
+{
+	struct hevc_rbsp r = { .data = nal, .len = len };
+	u32 ctb_log2, w_ctbs, h_ctbs, nut, v, i;
+	bool first, dependent = false, sao_luma = false, sao_chroma = false;
+	bool chroma = !(sps->flags & V4L2_HEVC_SPS_FLAG_SEPARATE_COLOUR_PLANE) &&
+		      sps->chroma_format_idc;
+	u64 pf = pps->flags;
+
+	if (len < 3 || (nal[0] & 0x80))
+		return -EINVAL;
+	nut = (nal[0] >> 1) & 0x3f;
+	if (nut > 21 || (nut > 9 && nut < 16))
+		return -EINVAL;
+	r.pos = 2;
+	memset(sl, 0, sizeof(*sl));
+	sl->nal_unit_type = nut;
+	sl->nuh_temporal_id_plus1 = nal[1] & 7;
+	sl->slice_pic_order_cnt = dec->pic_order_cnt_val;
+	sl->short_term_ref_pic_set_size = dec->short_term_ref_pic_set_size;
+	sl->long_term_ref_pic_set_size = dec->long_term_ref_pic_set_size;
+
+	ctb_log2 = sps->log2_min_luma_coding_block_size_minus3 + 3 +
+		   sps->log2_diff_max_min_luma_coding_block_size;
+	w_ctbs = DIV_ROUND_UP(sps->pic_width_in_luma_samples, 1U << ctb_log2);
+	h_ctbs = DIV_ROUND_UP(sps->pic_height_in_luma_samples, 1U << ctb_log2);
+
+	first = rbsp_bit(&r);
+	if (nut >= NAL_BLA_W_LP && nut <= NAL_RSV_IRAP_23)
+		rbsp_bit(&r);			/* no_output_of_prior_pics_flag */
+	if (rbsp_ue(&r) != pps->pic_parameter_set_id)
+		return -EINVAL;
+	if (!first) {
+		if (pf & V4L2_HEVC_PPS_FLAG_DEPENDENT_SLICE_SEGMENT_ENABLED)
+			dependent = rbsp_bit(&r);
+		sl->slice_segment_addr = rbsp_u(&r, ceil_log2(w_ctbs * h_ctbs));
+		if (sl->slice_segment_addr >= w_ctbs * h_ctbs)
+			return -EINVAL;
+	}
+	if (dependent) {
+		if (!prev)
+			return -EINVAL;
+		/* 7.4.7.1: a dependent segment's header is the previous one's */
+		*sl = (struct v4l2_ctrl_hevc_slice_params) {
+			.nal_unit_type = nut,
+			.nuh_temporal_id_plus1 = nal[1] & 7,
+			.slice_segment_addr = sl->slice_segment_addr,
+		};
+		memcpy(&sl->slice_type, &prev->slice_type,
+		       offsetof(struct v4l2_ctrl_hevc_slice_params, reserved0) -
+		       offsetof(struct v4l2_ctrl_hevc_slice_params, slice_type));
+		memcpy(sl->ref_idx_l0, prev->ref_idx_l0, sizeof(sl->ref_idx_l0));
+		memcpy(sl->ref_idx_l1, prev->ref_idx_l1, sizeof(sl->ref_idx_l1));
+		sl->short_term_ref_pic_set_size = prev->short_term_ref_pic_set_size;
+		sl->long_term_ref_pic_set_size = prev->long_term_ref_pic_set_size;
+		sl->pred_weight_table = prev->pred_weight_table;
+		sl->flags = prev->flags | V4L2_HEVC_SLICE_PARAMS_FLAG_DEPENDENT_SLICE_SEGMENT;
+	} else {
+		bool p_or_b, b, tmvp = false, deblock_off, override = false;
+		u8 n0 = pps->num_ref_idx_l0_default_active_minus1;
+		u8 n1 = pps->num_ref_idx_l1_default_active_minus1;
+		u8 entries[2][V4L2_HEVC_DPB_ENTRIES_NUM_MAX] = {};
+		bool modified[2] = {};
+		u32 total = dec->num_poc_st_curr_before + dec->num_poc_st_curr_after +
+			    dec->num_poc_lt_curr;
+		int ret;
+
+		/* collocated_from_l0_flag is inferred to be 1 when absent (7.4.7.1) */
+		sl->flags |= SL_COL_FROM_L0;
+		rbsp_skip(&r, pps->num_extra_slice_header_bits);
+		v = rbsp_ue(&r);
+		if (v > V4L2_HEVC_SLICE_TYPE_I)
+			return -EINVAL;
+		sl->slice_type = v;
+		p_or_b = v != V4L2_HEVC_SLICE_TYPE_I;
+		b = v == V4L2_HEVC_SLICE_TYPE_B;
+		if (pf & V4L2_HEVC_PPS_FLAG_OUTPUT_FLAG_PRESENT)
+			rbsp_bit(&r);		/* pic_output_flag */
+		if (sps->flags & V4L2_HEVC_SPS_FLAG_SEPARATE_COLOUR_PLANE)
+			sl->colour_plane_id = rbsp_u(&r, 2);
+		if (nut != NAL_IDR_W_RADL && nut != NAL_IDR_N_LP) {
+			rbsp_skip(&r, sps->log2_max_pic_order_cnt_lsb_minus4 + 4);
+			if (!rbsp_bit(&r))	/* short_term_ref_pic_set_sps_flag */
+				rbsp_skip(&r, dec->short_term_ref_pic_set_size);
+			else if (sps->num_short_term_ref_pic_sets > 1)
+				rbsp_skip(&r, ceil_log2(sps->num_short_term_ref_pic_sets));
+			if (sps->flags & V4L2_HEVC_SPS_FLAG_LONG_TERM_REF_PICS_PRESENT)
+				rbsp_skip(&r, dec->long_term_ref_pic_set_size);
+			if (sps->flags & V4L2_HEVC_SPS_FLAG_SPS_TEMPORAL_MVP_ENABLED)
+				tmvp = rbsp_bit(&r);
+		}
+		if (tmvp)
+			sl->flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_TEMPORAL_MVP_ENABLED;
+		if (sps->flags & V4L2_HEVC_SPS_FLAG_SAMPLE_ADAPTIVE_OFFSET) {
+			sao_luma = rbsp_bit(&r);
+			if (chroma)
+				sao_chroma = rbsp_bit(&r);
+		}
+		if (sao_luma)
+			sl->flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_LUMA;
+		if (sao_chroma)
+			sl->flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_CHROMA;
+		if (p_or_b) {
+			if (rbsp_bit(&r)) {	/* num_ref_idx_active_override_flag */
+				v = rbsp_ue(&r);
+				if (v > 14)
+					return -EINVAL;
+				n0 = v;
+				if (b) {
+					v = rbsp_ue(&r);
+					if (v > 14)
+						return -EINVAL;
+					n1 = v;
+				}
+			}
+			if ((pf & V4L2_HEVC_PPS_FLAG_LISTS_MODIFICATION_PRESENT) && total > 1) {
+				unsigned int bits = ceil_log2(total);
+				int l;
+
+				for (l = 0; l < (b ? 2 : 1); l++) {
+					modified[l] = rbsp_bit(&r);
+					if (!modified[l])
+						continue;
+					for (i = 0; i <= (l ? n1 : n0); i++)
+						entries[l][i] = rbsp_u(&r, bits);
+				}
+			}
+			if (b && rbsp_bit(&r))
+				sl->flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_MVD_L1_ZERO;
+			if ((pf & V4L2_HEVC_PPS_FLAG_CABAC_INIT_PRESENT) && rbsp_bit(&r))
+				sl->flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_CABAC_INIT;
+			if (tmvp) {
+				bool from_l0 = true;
+
+				if (b)
+					from_l0 = rbsp_bit(&r);
+				if (!from_l0)
+					sl->flags &= ~SL_COL_FROM_L0;
+				if ((from_l0 && n0 > 0) || (!from_l0 && n1 > 0)) {
+					v = rbsp_ue(&r);
+					if (v > (from_l0 ? n0 : n1))
+						return -EINVAL;
+					sl->collocated_ref_idx = v;
+				}
+			}
+			if (((pf & V4L2_HEVC_PPS_FLAG_WEIGHTED_PRED) && !b) ||
+			    ((pf & V4L2_HEVC_PPS_FLAG_WEIGHTED_BIPRED) && b)) {
+				ret = parse_pred_weights(&r, chroma, b, n0, n1,
+							 &sl->pred_weight_table);
+				if (ret)
+					return ret;
+			}
+			v = rbsp_ue(&r);
+			if (v > 4)
+				return -EINVAL;
+			sl->five_minus_max_num_merge_cand = v;
+			sl->num_ref_idx_l0_active_minus1 = n0;
+			sl->num_ref_idx_l1_active_minus1 = b ? n1 : 0;
+			ret = build_list(dec, false, n0 + 1, entries[0], modified[0],
+					 sl->ref_idx_l0);
+			if (!ret && b)
+				ret = build_list(dec, true, n1 + 1, entries[1], modified[1],
+						 sl->ref_idx_l1);
+			if (ret)
+				return ret;
+		}
+		v = rbsp_se(&r);
+		if ((s32)v < -128 || (s32)v > 127)
+			return -EINVAL;
+		sl->slice_qp_delta = (s32)v;
+		if (pf & V4L2_HEVC_PPS_FLAG_PPS_SLICE_CHROMA_QP_OFFSETS_PRESENT) {
+			s32 cb = rbsp_se(&r), cr = rbsp_se(&r);
+
+			if (cb < -12 || cb > 12 || cr < -12 || cr > 12)
+				return -EINVAL;
+			sl->slice_cb_qp_offset = cb;
+			sl->slice_cr_qp_offset = cr;
+		}
+		deblock_off = !!(pf & V4L2_HEVC_PPS_FLAG_PPS_DISABLE_DEBLOCKING_FILTER);
+		sl->slice_beta_offset_div2 = pps->pps_beta_offset_div2;
+		sl->slice_tc_offset_div2 = pps->pps_tc_offset_div2;
+		if (pf & V4L2_HEVC_PPS_FLAG_DEBLOCKING_FILTER_OVERRIDE_ENABLED)
+			override = rbsp_bit(&r);
+		if (override) {
+			deblock_off = rbsp_bit(&r);
+			if (!deblock_off) {
+				s32 beta = rbsp_se(&r), tc = rbsp_se(&r);
+
+				if (beta < -6 || beta > 6 || tc < -6 || tc > 6)
+					return -EINVAL;
+				sl->slice_beta_offset_div2 = beta;
+				sl->slice_tc_offset_div2 = tc;
+			}
+		}
+		if (deblock_off)
+			sl->flags |= V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_DEBLOCKING_FILTER_DISABLED;
+		/* inferred equal to the PPS flag when absent */
+		if ((pf & PPS_LF_ACROSS) && (sao_luma || sao_chroma || !deblock_off)) {
+			if (rbsp_bit(&r))
+				sl->flags |= SL_LF_ACROSS;
+		} else if (pf & PPS_LF_ACROSS) {
+			sl->flags |= SL_LF_ACROSS;
+		}
+	}
+	if (pf & (V4L2_HEVC_PPS_FLAG_TILES_ENABLED |
+		  V4L2_HEVC_PPS_FLAG_ENTROPY_CODING_SYNC_ENABLED)) {
+		u32 n = rbsp_ue(&r), bits;
+
+		if (n > max_entry_points || n >= AVD_HEVC_MAX_ENTRY_POINTS)
+			return -EINVAL;
+		sl->num_entry_point_offsets = n;
+		if (n) {
+			bits = rbsp_ue(&r) + 1;
+			if (bits > 32)
+				return -EINVAL;
+			for (i = 0; i < n; i++)
+				entry_points[i] = rbsp_u(&r, bits) + 1;
+		}
+	}
+	if (pf & V4L2_HEVC_PPS_FLAG_SLICE_SEGMENT_HEADER_EXTENSION_PRESENT)
+		rbsp_skip(&r, 8 * rbsp_ue(&r));
+	/* byte_alignment(): one bit equal to 1, then zero bits */
+	if (!rbsp_bit(&r))
+		return -EINVAL;
+	while (r.bit && !r.err)
+		if (rbsp_bit(&r))
+			return -EINVAL;
+	if (r.err || r.pos >= len)
+		return -EINVAL;
+	*header_bytes = r.pos;
+	sl->data_byte_offset = r.pos;
+	sl->bit_size = len * 8;
+	return 0;
+}
+
+/* Next start code at or after *pos; returns its length (3 or 4) or 0. */
+static u32 next_start_code(const u8 *buf, u32 len, u32 *pos)
+{
+	u32 i;
+
+	for (i = *pos; i + 3 <= len; i++) {
+		if (buf[i] || buf[i + 1])
+			continue;
+		if (buf[i + 2] == 1) {
+			*pos = i;
+			return 3;
+		}
+		if (i + 4 <= len && !buf[i + 2] && buf[i + 3] == 1) {
+			*pos = i;
+			return 4;
+		}
+	}
+	*pos = len;
+	return 0;
+}
+
+/**
+ * avd_hevc_parse_picture() - slice parameters of an Annex-B picture
+ *
+ * Fills one entry of @sl per slice segment NAL unit and the picture's entry
+ * points in slice order. Each slice's region runs from the end of the previous
+ * slice (the buffer start for the first) to the end of its own NAL unit, so
+ * start codes and non-slice NAL units count as header bytes of the next slice.
+ *
+ * Return: 0, or -EINVAL if any slice header cannot be described.
+ */
+int avd_hevc_parse_picture(const u8 *buf, u32 len,
+			   const struct v4l2_ctrl_hevc_sps *sps,
+			   const struct v4l2_ctrl_hevc_pps *pps,
+			   const struct v4l2_ctrl_hevc_decode_params *dec,
+			   struct v4l2_ctrl_hevc_slice_params *sl, u32 max_slices,
+			   u32 *entry_points, u32 max_entry_points,
+			   u32 *num_slices, u32 *num_entry_points)
+{
+	u32 pos = 0, region = 0, ns = 0, nep = 0;
+	u32 sc = next_start_code(buf, len, &pos);
+
+	if (!sc || pos)
+		return -EINVAL;
+	while (sc) {
+		u32 nal = pos + sc, end = nal, hdr, nut;
+		int ret;
+
+		sc = next_start_code(buf, len, &end);
+		/* trailing zero bytes belong to the next start code (B.2) */
+		pos = end;
+		while (end > nal && !buf[end - 1])
+			end--;
+		if (end - nal < 2)
+			return -EINVAL;
+		nut = (buf[nal] >> 1) & 0x3f;
+		if (nut > 21 || (nut > 9 && nut < 16))
+			continue;	/* not a slice: header bytes of the next one */
+		if (ns == max_slices)
+			return -EINVAL;
+		ret = avd_hevc_parse_slice(buf + nal, end - nal, sps, pps, dec,
+					   ns ? &sl[ns - 1] : NULL, &sl[ns],
+					   entry_points + nep, max_entry_points - nep, &hdr);
+		if (ret)
+			return ret;
+		sl[ns].data_byte_offset = nal - region + hdr;
+		sl[ns].bit_size = (end - region) * 8;
+		nep += sl[ns].num_entry_point_offsets;
+		region = end;
+		ns++;
+	}
+	if (!ns)
+		return -EINVAL;
+	*num_slices = ns;
+	*num_entry_points = nep;
+	return 0;
+}
diff --git a/drivers/media/platform/apple/avd/avd-hevc-parse.h b/drivers/media/platform/apple/avd/avd-hevc-parse.h
