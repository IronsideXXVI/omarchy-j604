+/*
+ * A request that carries SLICE_PARAMS (VA-API) is described by them and takes
+ * the slice-parameter path unchanged. A request without them (Chromium) gets
+ * them read from its picture, which must then be Annex-B (a slice NAL unit
+ * never starts with two zero bytes, so a start code at the start of the buffer
+ * is unambiguous), and only with hevc_frame_parse on. Anything else is
+ * refused before it reaches the hardware: the stale SLICE_PARAMS of an
+ * earlier request never describe this picture.
+ */
+static bool avd_hevc_req_has_slices(struct avd_ctx *ctx,
+				    struct avd_hevc_run *run)
+{
+	struct media_request *req = run->base.bufs.src->vb2_buf.req_obj.req;
+	struct v4l2_ctrl_handler *hdl;
+	bool has;
+
+	if (!req)
+		return true;
+	hdl = v4l2_ctrl_request_hdl_find(req, &ctx->ctrl_hdl);
+	if (!hdl)
+		return false;
+	has = v4l2_ctrl_request_hdl_ctrl_find(hdl,
+					      V4L2_CID_STATELESS_HEVC_SLICE_PARAMS);
+	v4l2_ctrl_request_hdl_put(hdl);
+	return has;
+}
+
+static int avd_hevc_frame_slices(struct avd_ctx *ctx, struct avd_hevc_run *run)
+{
+	struct vb2_buffer *src = &run->base.bufs.src->vb2_buf;
+	struct v4l2_ctrl_hevc_slice_params *sl;
+	u32 len = vb2_get_plane_payload(src, 0), ns, nep;
+	const u8 *data = vb2_plane_vaddr(src, 0);
+	u32 *ep;
+	int ret;
+
+	if (avd_hevc_req_has_slices(ctx, run))
+		return run->num_slices && run->sl[0].bit_size ? 0 : -EINVAL;
+	if (!data || !avd_hevc_annexb(data, len))
+		return -EINVAL;
+	if (!avd_hevc_frame_parse_enabled()) {
+		dev_warn_once(ctx->dev->dev,
+			      "HEVC picture without slice parameters refused; hevc_frame_parse=1 reads them\n");
+		return -EINVAL;
+	}
+	if (!run->decode || !run->sps || !run->pps)
+		return -EINVAL;
+
+	sl = kvcalloc(AVD_HEVC_MAX_SLICES, sizeof(*sl), GFP_KERNEL);
+	ep = kvcalloc(AVD_HEVC_MAX_ENTRY_POINTS, sizeof(*ep), GFP_KERNEL);
+	if (!sl || !ep) {
+		ret = -ENOMEM;
+		goto err;
+	}
+	ret = avd_hevc_parse_picture(data, len, run->sps, run->pps, run->decode,
+				     sl, AVD_HEVC_MAX_SLICES, ep,
+				     AVD_HEVC_MAX_ENTRY_POINTS, &ns, &nep);
+	if (ret) {
+		dev_dbg(ctx->dev->dev, "HEVC picture slice headers unreadable: %d\n", ret);
+		goto err;
+	}
+	kvfree(run->sl);
+	kvfree(run->entry_point_offsets);
+	run->sl = sl;
+	run->num_slices = ns;
+	run->entry_point_offsets = ep;
+	run->num_entry_point_offsets = nep;
+	run->parsed = true;
+	return 0;
+
+err:
+	kvfree(sl);
+	kvfree(ep);
+	return ret;
+}
+
 static int avd_hevc_run(struct avd_ctx *ctx)
 {
