+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Apple AVD: HEVC slice segment headers for frame-based decoding.
+ *
+ * Copyright The Aurora Silicon Contributors
+ */
+#ifndef _AVD_HEVC_PARSE_H
+#define _AVD_HEVC_PARSE_H
+
+#include <linux/types.h>
+#include <media/v4l2-ctrls.h>
+
+/* Most slice segments and entry points one picture may describe. */
+#define AVD_HEVC_MAX_SLICES	600
+#define AVD_HEVC_MAX_ENTRY_POINTS	256
+
+bool avd_hevc_annexb(const u8 *buf, u32 len);
+int avd_hevc_parse_slice(const u8 *nal, u32 len,
+			 const struct v4l2_ctrl_hevc_sps *sps,
+			 const struct v4l2_ctrl_hevc_pps *pps,
+			 const struct v4l2_ctrl_hevc_decode_params *dec,
+			 const struct v4l2_ctrl_hevc_slice_params *prev,
+			 struct v4l2_ctrl_hevc_slice_params *sl,
+			 u32 *entry_points, u32 max_entry_points,
+			 u32 *header_bytes);
+int avd_hevc_parse_picture(const u8 *buf, u32 len,
+			   const struct v4l2_ctrl_hevc_sps *sps,
+			   const struct v4l2_ctrl_hevc_pps *pps,
+			   const struct v4l2_ctrl_hevc_decode_params *dec,
+			   struct v4l2_ctrl_hevc_slice_params *sl, u32 max_slices,
+			   u32 *entry_points, u32 max_entry_points,
+			   u32 *num_slices, u32 *num_entry_points);
+
+#endif /* _AVD_HEVC_PARSE_H */
diff --git a/drivers/media/platform/apple/avd/avd-hevc-test.c b/drivers/media/platform/apple/avd/avd-hevc-test.c
new file mode 100644
index 0000000000..e4ea282341
--- /dev/null
+++ b/drivers/media/platform/apple/avd/avd-hevc-test.c
@@ -0,0 +1,385 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests for the AVD HEVC frame-based slice header reader.
+ *
+ * Every slice header here is written field by field from H.265 7.3.6.1 with a
+ * bit writer that inserts emulation prevention bytes, then read back.
+ *
+ * Copyright The Aurora Silicon Contributors
+ */
+#include <kunit/test.h>
+#include <linux/string.h>
+
+#include "avd-hevc-parse.h"
+
+struct bw {
+	u8 buf[256];
+	u32 bytes;	/* RBSP bytes completed */
+	u32 acc, nacc;
+};
+
+static void put(struct bw *w, u32 v, unsigned int n)
+{
+	while (n--) {
+		w->acc = (w->acc << 1) | ((v >> n) & 1);
+		if (++w->nacc == 8) {
+			w->buf[w->bytes++] = w->acc;
+			w->acc = 0;
+			w->nacc = 0;
+		}
+	}
+}
+
+static void ue(struct bw *w, u32 v)
+{
+	u32 x = v + 1;
+	unsigned int len = fls(x);
+
+	put(w, 0, len - 1);
+	put(w, x, len);
+}
+
+static void se(struct bw *w, s32 v)
+{
+	ue(w, v > 0 ? 2 * v - 1 : -2 * v);
+}
+
+/* byte_alignment(), then 'data' bytes of slice data (0xa5) */
+static void finish(struct bw *w, unsigned int data)
+{
+	put(w, 1, 1);
+	while (w->nacc)
+		put(w, 0, 1);
+	while (data--)
+		w->buf[w->bytes++] = 0xa5;
+}
+
+/* NAL bytes with emulation prevention: returns length written to out */
+static u32 escape(const struct bw *w, u8 *out)
+{
+	u32 i, n = 0, zeros = 0;
+
+	for (i = 0; i < w->bytes; i++) {
+		if (zeros >= 2 && w->buf[i] <= 3) {
+			out[n++] = 3;
+			zeros = 0;
+		}
+		out[n++] = w->buf[i];
+		zeros = w->buf[i] ? 0 : zeros + 1;
+	}
+	return n;
+}
+
+static void nal_header(struct bw *w, u8 type)
+{
+	put(w, 0, 1);		/* forbidden_zero_bit */
+	put(w, type, 6);
+	put(w, 0, 6);		/* nuh_layer_id */
+	put(w, 1, 3);		/* nuh_temporal_id_plus1 */
+}
+
+static void params(struct v4l2_ctrl_hevc_sps *sps, struct v4l2_ctrl_hevc_pps *pps,
+		   struct v4l2_ctrl_hevc_decode_params *dec)
+{
+	memset(sps, 0, sizeof(*sps));
+	memset(pps, 0, sizeof(*pps));
+	memset(dec, 0, sizeof(*dec));
+	sps->pic_width_in_luma_samples = 1920;
+	sps->pic_height_in_luma_samples = 1088;
+	sps->chroma_format_idc = 1;
+	sps->log2_min_luma_coding_block_size_minus3 = 0;
+	sps->log2_diff_max_min_luma_coding_block_size = 3;	/* 64x64 CTBs: 30x17 */
+	sps->log2_max_pic_order_cnt_lsb_minus4 = 4;		/* 8-bit POC lsb */
+	sps->num_short_term_ref_pic_sets = 3;
+	sps->flags = V4L2_HEVC_SPS_FLAG_SAMPLE_ADAPTIVE_OFFSET |
+		     V4L2_HEVC_SPS_FLAG_SPS_TEMPORAL_MVP_ENABLED;
+	pps->pic_parameter_set_id = 0;
+	pps->num_ref_idx_l0_default_active_minus1 = 1;
+	pps->num_ref_idx_l1_default_active_minus1 = 0;
+	pps->pps_beta_offset_div2 = 1;
+	pps->pps_tc_offset_div2 = -1;
+	pps->flags = V4L2_HEVC_PPS_FLAG_PPS_SLICE_CHROMA_QP_OFFSETS_PRESENT |
+		     V4L2_HEVC_PPS_FLAG_DEBLOCKING_FILTER_OVERRIDE_ENABLED |
+		     V4L2_HEVC_PPS_FLAG_PPS_LOOP_FILTER_ACROSS_SLICES_ENABLED |
+		     V4L2_HEVC_PPS_FLAG_CABAC_INIT_PRESENT;
+	dec->pic_order_cnt_val = 8;
+	dec->num_poc_st_curr_before = 2;
+	dec->poc_st_curr_before[0] = 3;
+	dec->poc_st_curr_before[1] = 1;
+	dec->num_poc_st_curr_after = 1;
+	dec->poc_st_curr_after[0] = 5;
+}
+
+static void hevc_idr_i_slice(struct kunit *test)
+{
+	struct v4l2_ctrl_hevc_sps sps;
+	struct v4l2_ctrl_hevc_pps pps;
+	struct v4l2_ctrl_hevc_decode_params dec;
+	struct v4l2_ctrl_hevc_slice_params sl;
+	struct bw w = {};
+	u8 nal[300];
+	u32 ep[4], hdr, n;
+
+	params(&sps, &pps, &dec);
+	nal_header(&w, 19);	/* IDR_W_RADL */
+	put(&w, 1, 1);		/* first_slice_segment_in_pic_flag */
+	put(&w, 0, 1);		/* no_output_of_prior_pics_flag */
+	ue(&w, 0);		/* slice_pic_parameter_set_id */
+	ue(&w, 2);		/* slice_type I */
+	put(&w, 1, 1);		/* slice_sao_luma_flag */
+	put(&w, 0, 1);		/* slice_sao_chroma_flag */
+	se(&w, -3);		/* slice_qp_delta */
+	se(&w, 2);		/* slice_cb_qp_offset */
+	se(&w, -1);		/* slice_cr_qp_offset */
+	put(&w, 1, 1);		/* deblocking_filter_override_flag */
+	put(&w, 0, 1);		/* slice_deblocking_filter_disabled_flag */
+	se(&w, -2);		/* slice_beta_offset_div2 */
+	se(&w, 3);		/* slice_tc_offset_div2 */
+	put(&w, 1, 1);		/* slice_loop_filter_across_slices_enabled_flag */
+	n = w.bytes;
+	finish(&w, 10);
+	n = escape(&w, nal);
+
+	KUNIT_ASSERT_EQ(test, avd_hevc_parse_slice(nal, n, &sps, &pps, &dec, NULL, &sl,
+						   ep, 4, &hdr), 0);
+	KUNIT_EXPECT_EQ(test, sl.nal_unit_type, 19);
+	KUNIT_EXPECT_EQ(test, sl.slice_type, V4L2_HEVC_SLICE_TYPE_I);
+	/* inferred when absent (7.4.7.1), as libva sets it */
+	KUNIT_EXPECT_TRUE(test, sl.flags &
+			  V4L2_HEVC_SLICE_PARAMS_FLAG_COLLOCATED_FROM_L0);
+	KUNIT_EXPECT_EQ(test, sl.slice_qp_delta, -3);
+	KUNIT_EXPECT_EQ(test, sl.slice_cb_qp_offset, 2);
+	KUNIT_EXPECT_EQ(test, sl.slice_cr_qp_offset, -1);
+	KUNIT_EXPECT_EQ(test, sl.slice_beta_offset_div2, -2);
+	KUNIT_EXPECT_EQ(test, sl.slice_tc_offset_div2, 3);
+	KUNIT_EXPECT_EQ(test, sl.slice_pic_order_cnt, 8);
+	KUNIT_EXPECT_EQ(test, sl.slice_segment_addr, 0);
+	KUNIT_EXPECT_TRUE(test, sl.flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_LUMA);
+	KUNIT_EXPECT_FALSE(test, sl.flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_CHROMA);
+	KUNIT_EXPECT_TRUE(test, sl.flags &
+			  V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_LOOP_FILTER_ACROSS_SLICES_ENABLED);
+	KUNIT_EXPECT_EQ(test, hdr, n - 10);
+	KUNIT_EXPECT_EQ(test, sl.data_byte_offset, n - 10);
+	KUNIT_EXPECT_EQ(test, sl.bit_size, n * 8);
+}
+
+static void hevc_b_slice_lists(struct kunit *test)
+{
+	struct v4l2_ctrl_hevc_sps sps;
+	struct v4l2_ctrl_hevc_pps pps;
+	struct v4l2_ctrl_hevc_decode_params dec;
+	struct v4l2_ctrl_hevc_slice_params sl;
+	struct bw w = {};
+	u8 nal[300];
+	u32 ep[4], hdr, n;
+
+	params(&sps, &pps, &dec);
+	pps.flags |= V4L2_HEVC_PPS_FLAG_LISTS_MODIFICATION_PRESENT |
+		     V4L2_HEVC_PPS_FLAG_WEIGHTED_BIPRED | V4L2_HEVC_PPS_FLAG_TILES_ENABLED;
+	nal_header(&w, 1);	/* TRAIL_R */
+	put(&w, 0, 1);		/* first_slice_segment_in_pic_flag */
+	ue(&w, 0);		/* pps id */
+	put(&w, 37, 9);		/* slice_segment_address, Ceil(Log2(510)) = 9 bits */
+	ue(&w, 0);		/* slice_type B */
+	put(&w, 0x5a, 8);	/* slice_pic_order_cnt_lsb */
+	put(&w, 1, 1);		/* short_term_ref_pic_set_sps_flag */
+	put(&w, 2, 2);		/* short_term_ref_pic_set_idx */
+	put(&w, 1, 1);		/* slice_temporal_mvp_enabled_flag */
+	put(&w, 0, 1);		/* sao luma */
+	put(&w, 1, 1);		/* sao chroma */
+	put(&w, 1, 1);		/* num_ref_idx_active_override_flag */
+	ue(&w, 1);		/* num_ref_idx_l0_active_minus1 */
+	ue(&w, 1);		/* num_ref_idx_l1_active_minus1 */
+	put(&w, 1, 1);		/* ref_pic_list_modification_flag_l0 */
+	put(&w, 2, 2);		/* list_entry_l0[0]: Ceil(Log2(3)) = 2 bits */
+	put(&w, 0, 2);		/* list_entry_l0[1] */
+	put(&w, 0, 1);		/* ref_pic_list_modification_flag_l1 */
+	put(&w, 1, 1);		/* mvd_l1_zero_flag */
+	put(&w, 1, 1);		/* cabac_init_flag */
+	put(&w, 0, 1);		/* collocated_from_l0_flag */
+	ue(&w, 1);		/* collocated_ref_idx */
+	/* pred_weight_table */
+	ue(&w, 6);		/* luma_log2_weight_denom */
+	se(&w, -1);		/* delta_chroma_log2_weight_denom */
+	put(&w, 0x2, 2);	/* luma_weight_l0_flag[0..1] */
+	put(&w, 0x1, 2);	/* chroma_weight_l0_flag[0..1] */
+	se(&w, 4); se(&w, -7);	/* l0[0]: luma weight/offset (flag 1 on [0]) */
+	se(&w, 3); se(&w, 10);	/* l0[1] chroma 0: delta weight, delta offset */
+	se(&w, -2); se(&w, -4);	/* l0[1] chroma 1 */
+	put(&w, 0, 2);		/* luma_weight_l1_flag[0..1] */
+	put(&w, 0, 2);		/* chroma_weight_l1_flag[0..1] */
+	ue(&w, 1);		/* five_minus_max_num_merge_cand */
+	se(&w, 4);		/* slice_qp_delta */
+	se(&w, 0); se(&w, 0);	/* chroma qp offsets */
+	put(&w, 0, 1);		/* deblocking_filter_override_flag */
+	put(&w, 0, 1);		/* slice_loop_filter_across_slices_enabled_flag */
+	ue(&w, 2);		/* num_entry_point_offsets */
+	ue(&w, 11);		/* offset_len_minus1: 12 bits */
+	put(&w, 99, 12);
+	put(&w, 1999, 12);
+	finish(&w, 8);
+	n = escape(&w, nal);
+
+	KUNIT_ASSERT_EQ(test, avd_hevc_parse_slice(nal, n, &sps, &pps, &dec, NULL, &sl,
+						   ep, 4, &hdr), 0);
+	KUNIT_EXPECT_EQ(test, sl.slice_type, V4L2_HEVC_SLICE_TYPE_B);
+	KUNIT_EXPECT_EQ(test, sl.slice_segment_addr, 37);
+	KUNIT_EXPECT_EQ(test, sl.num_ref_idx_l0_active_minus1, 1);
+	KUNIT_EXPECT_EQ(test, sl.num_ref_idx_l1_active_minus1, 1);
+	/* RefPicListTemp0 = {3, 1, 5}; modified: [2] -> 5, [0] -> 3 */
+	KUNIT_EXPECT_EQ(test, sl.ref_idx_l0[0], 5);
+	KUNIT_EXPECT_EQ(test, sl.ref_idx_l0[1], 3);
+	/* RefPicListTemp1 = {5, 3, 1} */
+	KUNIT_EXPECT_EQ(test, sl.ref_idx_l1[0], 5);
+	KUNIT_EXPECT_EQ(test, sl.ref_idx_l1[1], 3);
+	KUNIT_EXPECT_EQ(test, sl.collocated_ref_idx, 1);
+	KUNIT_EXPECT_FALSE(test, sl.flags & V4L2_HEVC_SLICE_PARAMS_FLAG_COLLOCATED_FROM_L0);
+	KUNIT_EXPECT_TRUE(test, sl.flags & V4L2_HEVC_SLICE_PARAMS_FLAG_MVD_L1_ZERO);
+	KUNIT_EXPECT_TRUE(test, sl.flags & V4L2_HEVC_SLICE_PARAMS_FLAG_CABAC_INIT);
+	KUNIT_EXPECT_TRUE(test, sl.flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_TEMPORAL_MVP_ENABLED);
+	KUNIT_EXPECT_TRUE(test, sl.flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_CHROMA);
+	KUNIT_EXPECT_EQ(test, sl.pred_weight_table.luma_log2_weight_denom, 6);
+	KUNIT_EXPECT_EQ(test, sl.pred_weight_table.delta_chroma_log2_weight_denom, -1);
+	KUNIT_EXPECT_EQ(test, sl.pred_weight_table.delta_luma_weight_l0[0], 4);
+	KUNIT_EXPECT_EQ(test, sl.pred_weight_table.luma_offset_l0[0], -7);
+	KUNIT_EXPECT_EQ(test, sl.pred_weight_table.delta_chroma_weight_l0[1][0], 3);
+	/* ChromaWeight = 32 + 3 = 35: 128 - (128 * 35 >> 5) + 10 = -2 */
+	KUNIT_EXPECT_EQ(test, sl.pred_weight_table.chroma_offset_l0[1][0], -2);
+	/* ChromaWeight = 30: 128 - 120 - 4 = 4 */
+	KUNIT_EXPECT_EQ(test, sl.pred_weight_table.chroma_offset_l0[1][1], 4);
+	KUNIT_EXPECT_EQ(test, sl.five_minus_max_num_merge_cand, 1);
+	KUNIT_EXPECT_EQ(test, sl.slice_qp_delta, 4);
+	KUNIT_EXPECT_EQ(test, sl.num_entry_point_offsets, 2);
+	KUNIT_EXPECT_EQ(test, ep[0], 100);
+	KUNIT_EXPECT_EQ(test, ep[1], 2000);
+	KUNIT_EXPECT_EQ(test, hdr, n - 8);
+}
+
+static void hevc_dependent_segment(struct kunit *test)
+{
+	struct v4l2_ctrl_hevc_sps sps;
+	struct v4l2_ctrl_hevc_pps pps;
+	struct v4l2_ctrl_hevc_decode_params dec;
+	struct v4l2_ctrl_hevc_slice_params prev = {}, sl;
+	struct bw w = {};
+	u8 nal[64];
+	u32 ep[4], hdr, n;
+
+	params(&sps, &pps, &dec);
+	pps.flags |= V4L2_HEVC_PPS_FLAG_DEPENDENT_SLICE_SEGMENT_ENABLED;
+	prev.slice_type = V4L2_HEVC_SLICE_TYPE_P;
+	prev.slice_qp_delta = 5;
+	prev.ref_idx_l0[0] = 3;
+	prev.flags = V4L2_HEVC_SLICE_PARAMS_FLAG_CABAC_INIT;
+	nal_header(&w, 1);
+	put(&w, 0, 1);		/* not the first segment */
+	ue(&w, 0);
+	put(&w, 1, 1);		/* dependent_slice_segment_flag */
+	put(&w, 100, 9);	/* slice_segment_address */
+	finish(&w, 4);
+	n = escape(&w, nal);
+
+	KUNIT_ASSERT_EQ(test, avd_hevc_parse_slice(nal, n, &sps, &pps, &dec, &prev, &sl,
+						   ep, 4, &hdr), 0);
+	KUNIT_EXPECT_EQ(test, sl.slice_segment_addr, 100);
+	KUNIT_EXPECT_EQ(test, sl.slice_type, V4L2_HEVC_SLICE_TYPE_P);
+	KUNIT_EXPECT_EQ(test, sl.slice_qp_delta, 5);
+	KUNIT_EXPECT_EQ(test, sl.ref_idx_l0[0], 3);
+	KUNIT_EXPECT_TRUE(test, sl.flags & V4L2_HEVC_SLICE_PARAMS_FLAG_DEPENDENT_SLICE_SEGMENT);
+	KUNIT_EXPECT_TRUE(test, sl.flags & V4L2_HEVC_SLICE_PARAMS_FLAG_CABAC_INIT);
+	/* a dependent segment needs a previous one */
+	KUNIT_EXPECT_EQ(test, avd_hevc_parse_slice(nal, n, &sps, &pps, &dec, NULL, &sl,
+						   ep, 4, &hdr), -EINVAL);
+}
+
+static void hevc_picture_regions(struct kunit *test)
+{
+	struct v4l2_ctrl_hevc_sps sps;
+	struct v4l2_ctrl_hevc_pps pps;
+	struct v4l2_ctrl_hevc_decode_params dec;
+	struct v4l2_ctrl_hevc_slice_params *sl;
+	struct bw a = {}, b = {};
+	u8 buf[256], na[64], nb[64];
+	u32 ep[4], ns = 0, nep = 0, la, lb, pos = 0;
+
+	sl = kunit_kcalloc(test, 4, sizeof(*sl), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sl);
+	params(&sps, &pps, &dec);
+	nal_header(&a, 19);
+	put(&a, 1, 1); put(&a, 0, 1); ue(&a, 0); ue(&a, 2);
+	put(&a, 0, 1); put(&a, 0, 1);		/* sao */
+	se(&a, 0); se(&a, 0); se(&a, 0);	/* qp delta, chroma offsets */
+	put(&a, 0, 1);				/* no deblocking override */
+	put(&a, 0, 1);				/* loop filter across slices */
+	finish(&a, 6);
+	la = escape(&a, na);
+	nal_header(&b, 19);
+	put(&b, 0, 1); put(&b, 0, 1); ue(&b, 0); put(&b, 255, 9); ue(&b, 2);
+	put(&b, 0, 1); put(&b, 0, 1);
+	se(&b, 0); se(&b, 0); se(&b, 0);
+	put(&b, 0, 1); put(&b, 0, 1);
+	finish(&b, 5);
+	lb = escape(&b, nb);
+
+	/*
+	 * 3-byte start code, slice A, an AUD (type 35) with a 4-byte start
+	 * code, slice B with a 4-byte start code
+	 */
+	buf[pos++] = 0; buf[pos++] = 0; buf[pos++] = 1;
+	memcpy(buf + pos, na, la); pos += la;
+	buf[pos++] = 0; buf[pos++] = 0; buf[pos++] = 0; buf[pos++] = 1;
+	buf[pos++] = 35 << 1; buf[pos++] = 1; buf[pos++] = 0x50;
+	buf[pos++] = 0; buf[pos++] = 0; buf[pos++] = 0; buf[pos++] = 1;
+	memcpy(buf + pos, nb, lb); pos += lb;
+
+	KUNIT_EXPECT_TRUE(test, avd_hevc_annexb(buf, pos));
+	KUNIT_EXPECT_FALSE(test, avd_hevc_annexb(na, la));
+	KUNIT_ASSERT_EQ(test, avd_hevc_parse_picture(buf, pos, &sps, &pps, &dec, sl, 4,
+						     ep, 4, &ns, &nep), 0);
+	KUNIT_ASSERT_EQ(test, ns, 2);
+	/* slice A: start code + NAL; its data after the header */
+	KUNIT_EXPECT_EQ(test, sl[0].bit_size, (3 + la) * 8);
+	KUNIT_EXPECT_EQ(test, sl[0].bit_size / 8 - sl[0].data_byte_offset, 6);
+	/* slice B's region: the AUD and both start codes are its prefix */
+	KUNIT_EXPECT_EQ(test, sl[1].bit_size, (pos - 3 - la) * 8);
+	KUNIT_EXPECT_EQ(test, sl[1].bit_size / 8 - sl[1].data_byte_offset, 5);
+	KUNIT_EXPECT_EQ(test, sl[1].slice_segment_addr, 255);
+	/* the regions cover the buffer contiguously */
+	KUNIT_EXPECT_EQ(test, (sl[0].bit_size + sl[1].bit_size) / 8, pos);
+}
+
+static void hevc_refusals(struct kunit *test)
+{
+	struct v4l2_ctrl_hevc_sps sps;
+	struct v4l2_ctrl_hevc_pps pps;
+	struct v4l2_ctrl_hevc_decode_params dec;
+	struct v4l2_ctrl_hevc_slice_params *sl;
+	u8 junk[8] = { 0, 0, 1, 0x40, 1, 0, 0, 0 };	/* VPS only */
+	u32 ep[4], ns, nep;
+
+	sl = kunit_kcalloc(test, 2, sizeof(*sl), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sl);
+	params(&sps, &pps, &dec);
+	/* no slice in the picture */
+	KUNIT_EXPECT_EQ(test, avd_hevc_parse_picture(junk, 8, &sps, &pps, &dec, sl, 2,
+						     ep, 4, &ns, &nep), -EINVAL);
+	/* does not start with a start code */
+	KUNIT_EXPECT_EQ(test, avd_hevc_parse_picture(junk + 3, 5, &sps, &pps, &dec, sl, 2,
+						     ep, 4, &ns, &nep), -EINVAL);
+}
+
+static struct kunit_case avd_hevc_cases[] = {
+	KUNIT_CASE(hevc_idr_i_slice),
+	KUNIT_CASE(hevc_b_slice_lists),
+	KUNIT_CASE(hevc_dependent_segment),
+	KUNIT_CASE(hevc_picture_regions),
+	KUNIT_CASE(hevc_refusals),
+	{}
+};
+
+static struct kunit_suite avd_hevc_suite = {
+	.name = "avd-hevc-frame",
+	.test_cases = avd_hevc_cases,
+};
+
+kunit_test_suite(avd_hevc_suite);
