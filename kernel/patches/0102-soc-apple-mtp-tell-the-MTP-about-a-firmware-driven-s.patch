From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:33 -0500
Subject: [PATCH] soc: apple: mtp: tell the MTP about a firmware-driven
 suspend

An adopted MTP session refuses anything but suspend-to-idle, since
nothing was known about what it needs. macOS leaves the MTP running
across a sleep and sends it only the AP power state: idle 280 ms before
the commit, on 73 ms after the wake, and no HELLO. Measured twice on
T8140 under aura, with the same six mailbox messages each time. With the
idle notice it also sets report 0xc1 on the DockChannel HID comm
interface to 1, and to 2 after the on notice.

So on a firmware-driven suspend rtkit-helper sends those notices and no
longer refuses. If the idle notice isn't answered, the sleep is refused
and nothing more is sent: macOS never sends an AP on to undo it, and one
sent while the firmware may still be going idle may be what kept it from
answering again. .complete looks whether a late answer came, and sends
AP on only then. The idle notice goes out in .prepare, before any driver
stops its own coprocessor, as macOS tells the MTP first of all: a sleep
it refuses has stopped nothing yet. The on notice goes out in .resume,
or in .complete for a sleep refused before this device suspended.
dockchannel-hid sets the host state after the idle notice and back after
the on notice, macOS's order, which the device link keeps; a firmware
that doesn't answer only logs, and isn't told of the wake.
Suspend-to-idle and every path without pm_suspend_via_firmware() are
unchanged.

With the debug host gone the DockChannel FIFO stays full, and each
console character waits out the whole retry count. After one character
times out, the console tries the next without waiting, until there's
room again, so printing on the way into and out of a sleep doesn't hold
anything up.

Signed-off-by: Diljit Singh <hey@djdev.me>


[deep-sleep-2: conflict was Aurora-only DockChannel ring/power-method-2 context, ours kept; the host-state 0xc1 calls (1 after the idle notice, 2 after the on notice: T8140-traced, TO-VERIFY on T8132), the rtkit-helper AP notices and the console change apply unchanged; all only under pm_suspend_via_firmware()]
Assisted-by: Claude:claude-opus-5.5

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/hid/dockchannel-hid/dockchannel-hid.c | 40 ++++++++-
 drivers/soc/apple/rtkit-helper.c              | 88 +++++++++++++++++++
 drivers/tty/serial/apple_dockchannel.h        | 10 ++-
 tools/asahi/mtp-pm-tests.py                   |  8 +-
 4 files changed, 139 insertions(+), 7 deletions(-)

diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid.c b/drivers/hid/dockchannel-hid/dockchannel-hid.c
index a752c22495..fcdcdc1d2c 100644
--- a/drivers/hid/dockchannel-hid/dockchannel-hid.c
+++ b/drivers/hid/dockchannel-hid/dockchannel-hid.c
@@ -21,6 +21,7 @@
 #include <linux/soc/apple/dockchannel.h>
 #include <linux/soc/apple/rtkit-helper.h>
 #include <linux/string.h>
+#include <linux/suspend.h>
 #include <linux/unaligned.h>
 #include <linux/of.h>
 #include "../hid-ids.h"
@@ -86,6 +87,9 @@ struct dchid_init_hdr {
 #define CMD_REGISTER_RING 0x91
 #define CMD_SEND_FIRMWARE 0x95
 #define CMD_ENABLE_INTERFACE 0xb4
+#define CMD_HOST_STATE 0xc1
+#define HOST_STATE_SLEEP 1
+#define HOST_STATE_AWAKE 2
 #define CMD_ACK_GPIO_CMD 0xa1
 
 struct dchid_init_block_hdr {
@@ -202,6 +206,8 @@ struct dockchannel_hid {
 	bool inherited_mtp;
 	/* Between the system sleep suspend and resume callbacks */
 	bool suspended;
+	/* The firmware was told of a sleep and has not been told of the wake */
+	bool host_asleep;
 
 	/* Held from probe on when the multi-touch interface uses power method 2 */
 	struct gpio_desc *afe_reset;
@@ -447,6 +453,14 @@ static int dchid_comm_cmd(struct dockchannel_hid *dchid, void *cmd, size_t size)
 	return dchid_cmd(dchid->comm, HID_FEATURE_REPORT, REQ_SET_REPORT, cmd, size, NULL, 0);
 }
 
+static int dchid_host_state(struct dockchannel_hid *dchid, u8 state)
+{
+	u8 msg[] = { CMD_HOST_STATE, state };
+	int ret = dchid_comm_cmd(dchid, msg, sizeof(msg));
+
+	return ret < 0 ? ret : 0;
+}
+
 static int dchid_enable_interface(struct dchid_iface *iface)
 {
 	u8 msg[] = { CMD_ENABLE_INTERFACE, iface->index };
@@ -1768,10 +1782,13 @@ static void dockchannel_hid_remove(struct platform_device *pdev)
 }
 
 /*
- * The coprocessor keeps running across suspend-to-idle: there is no known
- * sleep command for it, and its RTKit session and the trackpad AFE power
- * sequence are not restartable. Only mark the sleep window, in which input
- * may wake the system and requests from the HID core fail fast.
+ * The coprocessor keeps running across suspend-to-idle, and its RTKit session
+ * and the trackpad AFE power sequence are not restartable. Mark the sleep
+ * window, in which input may wake the system and requests from the HID core
+ * fail fast. A firmware-driven suspend also sets the host state, after the idle
+ * notice the helper sends in its .prepare, and the wake sets it back after the
+ * helper's .resume has sent the on notice, the device link ordering the two. That
+ * is macOS's order.
  */
 static int dockchannel_hid_suspend(struct device *dev)
 {
@@ -1788,6 +1805,13 @@ static int dockchannel_hid_suspend(struct device *dev)
 		if (ret)
 			goto unwind;
 	}
+	if (pm_suspend_via_firmware()) {
+		/* A firmware that doesn't answer isn't a reason to stay awake. */
+		ret = dchid_host_state(dchid, HOST_STATE_SLEEP);
+		if (ret)
+			dev_warn(dev, "host state not set: %d\n", ret);
+		dchid->host_asleep = !ret;
+	}
 	WRITE_ONCE(dchid->suspended, true);
 	return 0;
 
@@ -1807,6 +1831,14 @@ static int dockchannel_hid_resume(struct device *dev)
 	struct dockchannel_hid *dchid = dev_get_drvdata(dev);
 	int i, ret = 0;
 
+	if (dchid->host_asleep) {
+		dchid->host_asleep = false;
+		ret = dchid_host_state(dchid, HOST_STATE_AWAKE);
+		if (ret)
+			dev_warn(dev, "host state not restored: %d\n", ret);
+		ret = 0;
+	}
+
 	/* Allow feature requests again before notifying any HID driver. */
 	WRITE_ONCE(dchid->suspended, false);
 	for (i = 0; i < MAX_INTERFACES; i++) {
diff --git a/drivers/soc/apple/rtkit-helper.c b/drivers/soc/apple/rtkit-helper.c
index 07b5840da8..498d1413e1 100644
--- a/drivers/soc/apple/rtkit-helper.c
+++ b/drivers/soc/apple/rtkit-helper.c
@@ -39,6 +39,10 @@ struct apple_rtkit_helper {
 	 * it does not list must not replace storage the firmware still owns.
 	 */
 	bool strict_buffers;
+	/* The firmware was told the AP is going to sleep. */
+	bool ap_idle;
+	/* It was told, gave no answer, and wasn't told otherwise. */
+	bool idle_unanswered;
 
 	void __iomem *asc_base;
 
@@ -380,16 +384,97 @@ static void apple_rtkit_helper_remove(struct platform_device *pdev)
 	writel_relaxed(0, helper->asc_base + APPLE_ASC_CPU_CONTROL);
 }
 
+static int apple_rtkit_helper_ap_power(struct apple_rtkit_helper *helper, bool on)
+{
+	int ret = apple_rtkit_ap_power(helper->rtk, on);
+
+	if (ret)
+		dev_err(helper->dev, "AP power notice (%s) not answered: %d\n",
+			on ? "on" : "idle", ret);
+	/*
+	 * Nothing is sent to undo an unanswered idle notice, which macOS never does:
+	 * .complete looks whether a late answer came, and only then sends AP on.
+	 */
+	if (ret && !on)
+		helper->idle_unanswered = true;
+	return ret;
+}
+
+static int apple_rtkit_helper_ap_idle(struct apple_rtkit_helper *helper)
+{
+	int ret;
+
+	if (helper->ap_idle)
+		return 0;
+	ret = apple_rtkit_helper_ap_power(helper, false);
+	if (ret)
+		return ret;
+	helper->ap_idle = true;
+	dev_dbg(helper->dev, "AP idle notice answered for a sleep\n");
+	return 0;
+}
+
+static void apple_rtkit_helper_ap_on(struct apple_rtkit_helper *helper)
+{
+	if (!helper->ap_idle)
+		return;
+	helper->ap_idle = false;
+	if (!apple_rtkit_helper_ap_power(helper, true))
+		dev_dbg(helper->dev, "AP on notice answered after a sleep\n");
+}
+
+/*
+ * macOS tells this coprocessor first of all. Told before any driver stops its own,
+ * an unanswered notice refuses a sleep that has stopped nothing yet.
+ */
+static int __maybe_unused apple_rtkit_helper_prepare(struct device *dev)
+{
+	if (!pm_suspend_via_firmware())
+		return 0;
+	return apple_rtkit_helper_ap_idle(dev_get_drvdata(dev));
+}
+
+/* A sleep refused before this device's .suspend never calls its .resume. */
+static void __maybe_unused apple_rtkit_helper_complete(struct device *dev)
+{
+	struct apple_rtkit_helper *helper = dev_get_drvdata(dev);
+
+	if (helper->idle_unanswered) {
+		bool late = !apple_rtkit_is_running(helper->rtk);
+
+		helper->idle_unanswered = false;
+		dev_info(dev, "after the unanswered idle notice: %s\n",
+			 late ? "its answer came late, sending AP on" :
+				"still no answer, nothing sent");
+		helper->ap_idle = late;
+	}
+	apple_rtkit_helper_ap_on(helper);
+}
+
 static int __maybe_unused apple_rtkit_helper_suspend(struct device *dev)
 {
 	struct apple_rtkit_helper *helper = dev_get_drvdata(dev);
 
+	/*
+	 * A firmware-driven suspend keeps this coprocessor running. It hears the
+	 * AP's power state and nothing else, so an adopted session stays live.
+	 * That is measured on T8140 and unverified on other SoCs.
+	 */
+	if (pm_suspend_via_firmware())
+		return apple_rtkit_helper_ap_idle(helper);
+
 	/* Only suspend-to-idle has a verified live-session retention contract. */
 	if (helper->adopted && pm_suspend_target_state != PM_SUSPEND_TO_IDLE)
 		return -EBUSY;
 	return 0;
 }
 
+static int __maybe_unused apple_rtkit_helper_resume(struct device *dev)
+{
+	apple_rtkit_helper_ap_on(dev_get_drvdata(dev));
+	return 0;
+}
+
 static int __maybe_unused apple_rtkit_helper_freeze(struct device *dev)
 {
 	struct apple_rtkit_helper *helper = dev_get_drvdata(dev);
@@ -399,7 +484,10 @@ static int __maybe_unused apple_rtkit_helper_freeze(struct device *dev)
 }
 
 static const struct dev_pm_ops apple_rtkit_helper_pm_ops = {
+	.prepare = pm_sleep_ptr(apple_rtkit_helper_prepare),
+	.complete = pm_sleep_ptr(apple_rtkit_helper_complete),
 	.suspend = pm_sleep_ptr(apple_rtkit_helper_suspend),
+	.resume = pm_sleep_ptr(apple_rtkit_helper_resume),
 	.freeze = pm_sleep_ptr(apple_rtkit_helper_freeze),
 	.poweroff = pm_sleep_ptr(apple_rtkit_helper_freeze),
 };
diff --git a/drivers/tty/serial/apple_dockchannel.h b/drivers/tty/serial/apple_dockchannel.h
index 97fcccc6a5..51c73e4825 100644
--- a/drivers/tty/serial/apple_dockchannel.h
+++ b/drivers/tty/serial/apple_dockchannel.h
@@ -24,13 +24,19 @@
  */
 #define DOCKCHANNEL_NEVER_WAIT	"apple,tx-never-wait"
 
-/* Waiting for room, at most DOCKCHANNEL_TX_RETRIES reads per character. */
+/*
+ * Waiting for room, at most DOCKCHANNEL_TX_RETRIES reads per character. After
+ * one character times out, the next is tried without waiting, until there is
+ * room again.
+ */
 static inline void dockchannel_wait_putc(void __iomem *data, unsigned char c)
 {
-	unsigned int retries = DOCKCHANNEL_TX_RETRIES;
+	static bool no_reader;
+	unsigned int retries = no_reader ? 1 : DOCKCHANNEL_TX_RETRIES;
 
 	while (readl(data + DOCKCHANNEL_TX_FREE) == 0 && --retries)
 		cpu_relax();
+	no_reader = !retries;
 	if (!retries)
 		return;
 
diff --git a/tools/asahi/mtp-pm-tests.py b/tools/asahi/mtp-pm-tests.py
index 4f4d183021..fe4a55aa16 100644
--- a/tools/asahi/mtp-pm-tests.py
+++ b/tools/asahi/mtp-pm-tests.py
@@ -46,12 +46,18 @@ static bool cancel_delayed_work_sync(struct delayed_work *w) { bool p = w->pendi
 static bool schedule_delayed_work(struct delayed_work *w, unsigned long d) { w->queued++; w->pending = true; return true; }
 struct hid_device { struct magicmouse_sc *data; int id; };
 struct dchid_iface { struct hid_device *hid; };
-struct dockchannel_hid { struct dchid_iface *ifaces[MAX_INTERFACES]; bool suspended; };
+struct dockchannel_hid { struct dchid_iface *ifaces[MAX_INTERFACES]; bool suspended, host_asleep; };
 struct device { struct dockchannel_hid *data; };
 static struct dockchannel_hid *transport;
 static unsigned suspends[16], resumes[16], key_releases;
 static int suspend_error_at = -1, resume_error_at = -1;
 static void *dev_get_drvdata(struct device *d) { return d->data; }
+#define HOST_STATE_SLEEP 1
+#define HOST_STATE_AWAKE 2
+#define dev_warn(...) ((void)0)
+/* Not a firmware-driven suspend: the host state is never set here. */
+static bool pm_suspend_via_firmware(void) { return false; }
+static int dchid_host_state(struct dockchannel_hid *d, int state) { (void)d; (void)state; assert(0); return 0; }
 static void *hid_get_drvdata(struct hid_device *d) { return d->data; }
 static void magicmouse_force_key(struct magicmouse_sc *m, bool down) {
     assert(!down); key_releases++;
