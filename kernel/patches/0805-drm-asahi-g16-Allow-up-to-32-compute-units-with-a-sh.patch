+    /// Compute units 16.. (`g16_compute_units` > 16, only with `g16_compute_shared_pool`):
+    /// no pool of their own (they allocate from unit 0's), so only the preemption buffer
+    /// (+0), the auxiliary buffer (+64 KiB) and the context store (+256 KiB) are placed, one
+    /// 512 KiB stride each, in the free interval above the compute work pages and below
+    /// compute unit 0.
+    pub(crate) const COMPUTE_SMALL_BASE: u64 = 0x7000800000;
+    pub(crate) const COMPUTE_SMALL_STRIDE: u64 = 0x80000;
+    pub(crate) const fn compute_small(k: u64) -> u64 {
+        COMPUTE_SMALL_BASE + (k - super::sizes::COMPUTE_SLOTS as u64) * COMPUTE_SMALL_STRIDE
     }
