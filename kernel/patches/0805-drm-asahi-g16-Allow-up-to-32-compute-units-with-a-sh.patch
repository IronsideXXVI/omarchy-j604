+    pub(crate) const COMPUTE_UNITS_MAX: usize = 32;
+    const _: () = assert!(
+        COMPUTE_UNITS_MAX <= 32
+            && super::client::WORK_PAGE + COMPUTE_UNITS_MAX as u64 * super::client::CWORK_STRIDE
+                <= super::client::COMPUTE_SMALL_BASE
+            && super::client::compute_small(COMPUTE_UNITS_MAX as u64 - 1)
+                + super::client::COMPUTE_SMALL_STRIDE
+                <= super::client::compute_base(0)
+    );
