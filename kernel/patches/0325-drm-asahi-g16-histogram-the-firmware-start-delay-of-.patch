From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 00:30:44 +0000
Subject: [PATCH] drm/asahi: g16: histogram the firmware start delay of
 render commands

On the J604 a serialized render command waits about 0.66 ms from its
publication to its first firmware event, while its TA stage takes about
11 us. Posting the TA record first did not change that. A fixed setup cost
and a delay until the firmware's next periodic look at its queues give the
same mean but different distributions.

Add a 100 us histogram (0 to 2 ms, last bucket open) of publication to
first firmware event for render prefixes, and keep the raw counter values
of the last prefix whose stage stamps did not fall between publication and
retirement on the architectural counter, so the time base of those stamps
can be worked out. Both are debugfs only.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit f6982a04a39d7bc648c3afb9c363687f73fd6f96)
---
 drivers/gpu/drm/asahi/g16/engine.rs |  5 +++++
 drivers/gpu/drm/asahi/g16/poll.rs   | 18 ++++++++++++++++--
 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 54094898cd..766176f357 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -267,6 +267,11 @@ pub(crate) struct Stats {
     pub(crate) start_ticks: u64,
     pub(crate) start_max_ticks: u64,
     pub(crate) tail_ticks: u64,
+    /// The last prefix that failed that check: publication, first stage start, last stage end
+    /// and retirement, raw 24 MHz ticks (to find the stamps' time base).
+    pub(crate) lat_last_bad: [u64; 4],
+    /// Publication to first firmware event of render prefixes, 100 us buckets (last: >= 2 ms).
+    pub(crate) first_hist: [u64; 21],
     /// [0] compute, [1] render, [2] mixed.
     pub(crate) count: [u64; 3],
     /// Commands whose first queue WRITE advanced, compute then render. These counters are
diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 7f83f2626e..1c17301c8f 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -769,6 +769,7 @@ fn stat_retire(&mut self, f: &Flight) {
                 s.lat_n += 1;
             } else {
                 s.lat_bad += 1;
+                s.lat_last_bad = [f.published_ticks, lo, hi, now_ticks];
             }
         }
         for b in 0..3 {
@@ -785,6 +786,10 @@ fn stat_retire(&mut self, f: &Flight) {
             last = last.max(t);
         }
         if first > f.published_ns && last <= now {
+            if kind == 1 {
+                let b = ((first - f.published_ns) / 100_000).min(20) as usize;
+                s.first_hist[b] += 1;
+            }
             s.first_ns[kind] += first - f.published_ns;
             s.last_ns[kind] += last - f.published_ns;
         }
@@ -1011,13 +1016,22 @@ pub(crate) fn write_stats(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
         )?;
         writeln!(
             f,
-            "latency: n {} bad {} start_us {} start_max_us {} tail_us {}",
+            "latency: n {} bad {} start_us {} start_max_us {} tail_us {} last_bad {} {} {} {}",
             s.lat_n,
             s.lat_bad,
             s.start_ticks / 24,
             s.start_max_ticks / 24,
-            s.tail_ticks / 24
+            s.tail_ticks / 24,
+            s.lat_last_bad[0],
+            s.lat_last_bad[1],
+            s.lat_last_bad[2],
+            s.lat_last_bad[3]
         )?;
+        write!(f, "first_hist_100us:")?;
+        for n in s.first_hist.iter() {
+            write!(f, " {}", n)?;
+        }
+        writeln!(f)?;
         // The phase timers of debug_flags bit 49, and the scrub flush waits.
         let p = &self.engine.prof;
         writeln!(
