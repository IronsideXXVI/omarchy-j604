From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 11:12:30 +0000
Subject: [PATCH] accel/ane: let the T8132 Neural Engine power up
 without engine tunables (opt-in)

The T8132 platform stops after the preload identity because no engine
tunable table is published for it. Aurora's H16 table is T6041-only, the
J604 ADT carries tunables only for the ANE DARTs, and there is no other
open source for the values. Allow a qualification run that powers and boots
the engine without one, behind a parameter:

- ane_t6021.h16_power_unqualified (bool, default off) lifts the
  identify_only stop. The boot then runs as on the T6041, with five DAPF
  records and no XL window, and a warning names the run as unqualified.
- The T8132 platform sets no_engine_tunables. The boot takes CE as before,
  logs that it applies no engine tunable and writes none. Only iBoot's
  state, the ADT DART tunables (DART driver) and the DAPF records apply.
- ane_t6021.h16_preload_digest (64 hex digits) accepts a live preload
  digest for a build whose pinned digest is still all zero, after its
  layout matched, so a first window can identify and boot without a
  rebuild. It can never replace a pinned digest. A later build pins the
  value in ane_h16_preload_25g83_t8132.
- As on the T6041, system sleep cycles the T8132 engine cold from the
  preload (sleep_cold), so a booted engine does not refuse s2idle.

The default stays identify-only. It flips to powered in its own commit
only after the qualification run passes: firmware boot, bit-exact H16
selftests, no hang in a bounded loop, a perf baseline recorded, idle power
not regressed and s2idle clean. A T8132 tunable table, if Aurora or
omarchy-ane publish one, comes as its own pick and clears
no_engine_tunables.

KUnit: with no_engine_tunables the boot reaches startup with CE taken and
no tunable written.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/accel/ane/ane_fw_platform.c   | 12 ++++++-
 drivers/accel/ane/ane_fw_platform.h   |  8 ++++-
 drivers/accel/ane/ane_h16_backend.c   | 47 +++++++++++++++++++++++++--
 drivers/accel/ane/ane_h16_boot.h      |  4 +++
 drivers/accel/ane/ane_h16_boot_test.c | 20 ++++++++++++
 5 files changed, 86 insertions(+), 5 deletions(-)

diff --git a/drivers/accel/ane/ane_fw_platform.c b/drivers/accel/ane/ane_fw_platform.c
index 3b4bbfd7be..606b5daf38 100644
--- a/drivers/accel/ane/ane_fw_platform.c
+++ b/drivers/accel/ane/ane_fw_platform.c
@@ -83,7 +83,9 @@ const struct ane_fw_platform ane_h16_platform = {
  * at 0x100000c0000, and five DAPF records in dapf-instance-0 where the
  * T6041 has four. The H16 backend maps aux-3 as its XL window, programs
  * four DAPF records and applies T6041 tunables, none of which fits the
- * T8132 yet: the platform identifies the preload and stops.
+ * T8132 yet: the platform identifies the preload and stops, unless
+ * ane_t6021.h16_power_unqualified is set (five DAPF records, no XL window,
+ * no engine tunables).
  */
 static const char * const ane_h16_t8132_reg_names[] = {
 	"engine", "pmgr", "aux-0", "aux-1", "aux-2", "aux-4",
@@ -132,6 +134,14 @@ const struct ane_fw_platform ane_h16_t8132_platform = {
 	.safe_reset = false,
 	.dapf_range_count = 5,
 	.no_xl = true,
+	/*
+	 * No published T8132 engine tunable table: the unqualified power-up
+	 * (h16_power_unqualified) applies none. A table, when one exists, is
+	 * carried in its own commit and clears this.
+	 */
+	.no_engine_tunables = true,
+	/* As the T6041: system sleep cycles the engine cold from the preload. */
+	.sleep_cold = true,
 	.identify_only = true,
 };
 
diff --git a/drivers/accel/ane/ane_fw_platform.h b/drivers/accel/ane/ane_fw_platform.h
index 402d17378c..e735fa82df 100644
--- a/drivers/accel/ane/ane_fw_platform.h
+++ b/drivers/accel/ane/ane_fw_platform.h
@@ -84,9 +84,15 @@ struct ane_fw_platform {
 	 * maps it and tunable groups that name it are skipped.
 	 */
 	bool no_xl;
+	/*
+	 * No qualified engine tunable table for this SoC: the boot applies
+	 * none (iBoot's state, the ADT DART tunables and DAPF only).
+	 */
+	bool no_engine_tunables;
 	/*
 	 * Stop after the preload identity: preflight, resource geometry and the
-	 * firmware digest only, no power, DART or engine access.
+	 * firmware digest only, no power, DART or engine access. The
+	 * ane_t6021.h16_power_unqualified parameter lifts the stop.
 	 */
 	bool identify_only;
 };
diff --git a/drivers/accel/ane/ane_h16_backend.c b/drivers/accel/ane/ane_h16_backend.c
index e77b33b66c..0b1ee65a8c 100644
--- a/drivers/accel/ane/ane_h16_backend.c
+++ b/drivers/accel/ane/ane_h16_backend.c
@@ -3,6 +3,7 @@
 #include <linux/debugfs.h>
 #include <linux/delay.h>
 #include <linux/dma-map-ops.h>
+#include <linux/hex.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
 #include <linux/iommu.h>
@@ -1491,6 +1492,40 @@ static int ane_h16_acquire(struct platform_device *pdev, struct ane_h16_device *
 	return 0;
 }
 
+/*
+ * A platform marked identify_only (the T8132) stops after the preload
+ * identity. This lifts the stop for a qualification run: the engine is
+ * powered and booted with what the platform describes, which for the T8132
+ * means no engine tunables. Off by default until that run passes.
+ */
+static bool h16_power_unqualified;
+module_param(h16_power_unqualified, bool, 0444);
+MODULE_PARM_DESC(h16_power_unqualified,
+		 "Power and boot an H16 ANE whose platform is identify-only (default: off)");
+
+/*
+ * The SHA-256 (64 hex digits) of a live preload whose build has no pinned
+ * digest yet, as the "layout but digest" line names it. It is honoured only
+ * for a profile whose pinned digest is all zero and whose layout matched, so
+ * it can never replace a pinned digest. A later build pins the value.
+ */
+static char *h16_preload_digest;
+module_param(h16_preload_digest, charp, 0444);
+MODULE_PARM_DESC(h16_preload_digest,
+		 "Accept this preload SHA-256 for a build with no pinned digest (64 hex digits)");
+
+static bool ane_h16_digest_param(const u8 *digest, const u8 *pinned)
+{
+	u8 want[SHA256_DIGEST_SIZE];
+
+	if (!h16_preload_digest || strlen(h16_preload_digest) != 2 * SHA256_DIGEST_SIZE ||
+	    memchr_inv(pinned, 0, SHA256_DIGEST_SIZE))
+		return false;
+	if (hex2bin(want, h16_preload_digest, SHA256_DIGEST_SIZE))
+		return false;
+	return !memcmp(want, digest, SHA256_DIGEST_SIZE);
+}
+
 static int ane_h16_preload_identity(struct ane_h16_device *h)
 {
 	struct ane_h16_boot *b = &h->boot;
@@ -1542,8 +1577,11 @@ static int ane_h16_preload_identity(struct ane_h16_device *h)
 			/* The layout matched; name the image so a new build can be pinned. */
 			dev_info(h->dev, "H16 preload has the %s layout but digest %*phN\n",
 				 p->identity, (int)sizeof(digest), digest);
-			ret = -ENOEXEC;
-			continue;
+			if (!ane_h16_digest_param(digest, p->preload->digest)) {
+				ret = -ENOEXEC;
+				continue;
+			}
+			dev_info(h->dev, "H16 preload digest accepted by h16_preload_digest (no pinned digest)\n");
 		}
 		b->build = p->build;
 		identity = p->identity;
@@ -1622,9 +1660,12 @@ static int ane_h16_advance(struct ane_h16_device *h, enum ane_h16_stage stage)
 	if (!h->acquired) {
 		h->acquired = true;
 		ret = ane_h16_preload_identity(h);
-		if (!ret && h->boot.soc->identify_only) {
+		if (!ret && h->boot.soc->identify_only && !h16_power_unqualified) {
 			dev_info(h->dev, "H16 preload identified; this SoC stops before power-up\n");
 			ret = -EOPNOTSUPP;
+		} else if (!ret && h->boot.soc->identify_only) {
+			dev_warn(h->dev, "H16 preload identified; unqualified power-up (h16_power_unqualified)%s\n",
+				 h->boot.soc->no_engine_tunables ? ", no engine tunables" : "");
 		}
 		if (!ret)
 			ret = ane_h16_acquire(to_platform_device(h->dev), h);
diff --git a/drivers/accel/ane/ane_h16_boot.h b/drivers/accel/ane/ane_h16_boot.h
index 1ef37422a7..3e49e9f21e 100644
--- a/drivers/accel/ane/ane_h16_boot.h
+++ b/drivers/accel/ane/ane_h16_boot.h
@@ -421,6 +421,10 @@ static inline int ane_h16_prepare(struct ane_h16_boot *b)
 
 	if (ret)
 		return ret;
+	if (b->soc->no_engine_tunables) {
+		b->ops->log(b->ctx, "engine tunables: none for this SoC", 0, f->tunable_count);
+		return 0;
+	}
 	for (i = 0; i < f->tunable_count; i++) {
 		const struct ane_h16_tunables *group = &f->tunables[i];
 
diff --git a/drivers/accel/ane/ane_h16_boot_test.c b/drivers/accel/ane/ane_h16_boot_test.c
index d63e1408a6..7cbcdbb1c1 100644
--- a/drivers/accel/ane/ane_h16_boot_test.c
+++ b/drivers/accel/ane/ane_h16_boot_test.c
@@ -645,6 +645,25 @@ static void ane_h16_no_xl_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, s->tuning_writes, s->expect_tuning);
 }
 
+/*
+ * No engine tunables (T8132 unqualified power-up): CE is still taken, no
+ * tunable is written, and the boot reaches startup.
+ */
+static void ane_h16_no_engine_tunables_test(struct kunit *test)
+{
+	struct ane_h16_sim *s = test->priv;
+
+	s->soc.no_xl = true;
+	s->soc.no_engine_tunables = true;
+	s->soc.dapf_range_count = 5;
+	s->expect_tuning = 0;
+	KUNIT_ASSERT_EQ(test, ane_h16_run(&s->boot, ANE_H16_STARTUP), 0);
+	KUNIT_EXPECT_TRUE(test, s->boot.ran);
+	KUNIT_EXPECT_FALSE(test, s->boot.quarantined);
+	KUNIT_EXPECT_EQ(test, s->tuning_writes, 0U);
+	KUNIT_EXPECT_EQ(test, s->command_count, 4U);
+}
+
 static void ane_h16_happy_test(struct kunit *test)
 {
 	struct ane_h16_sim *s = test->priv;
@@ -1272,6 +1291,7 @@ static struct kunit_case ane_h16_boot_cases[] = {
 	KUNIT_CASE(ane_h16_alloc_reuse_test),
 	KUNIT_CASE(ane_h16_happy_test),
 	KUNIT_CASE(ane_h16_no_xl_test),
+	KUNIT_CASE(ane_h16_no_engine_tunables_test),
 	KUNIT_CASE(ane_h16_locked_matching_test),
 	KUNIT_CASE(ane_h16_dapf_program_test),
 	KUNIT_CASE(ane_h16_dapf_five_test),
