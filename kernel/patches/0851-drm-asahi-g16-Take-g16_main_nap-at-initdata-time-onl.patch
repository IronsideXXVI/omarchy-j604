From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 00:32:36 +0000
Subject: [PATCH] drm/asahi: g16: Take g16_main_nap at initdata time
 only

g16_main_nap was a runtime switch that wrote Main +0xf38 into the live
Main object. 25G83 reads that word at its own init as well: with it set,
it registers the perf-state completion interrupts and their semaphore,
and every later perf-state change waits on them instead of polling the
state register. Set after init, the next perf-state change would wait
for interrupts that were never registered and end in the firmware's
perf-state timeout or a wait without end.

Make g16_main_nap a load-time parameter, written with the initdata only,
and drop the runtime write that "Optionally let the firmware make its
power-off request" added. With the switch off nothing changes.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/asahi_core.rs   |  4 ++++
 drivers/gpu/drm/asahi/g16/initdata.rs |  1 +
 drivers/gpu/drm/asahi/g16/params.rs   | 24 ++++++--------------
 drivers/gpu/drm/asahi/g16/power.rs    | 32 ---------------------------
 4 files changed, 12 insertions(+), 49 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_core.rs b/drivers/gpu/drm/asahi/asahi_core.rs
index 82b1cabb3f..4e1cfd363c 100644
--- a/drivers/gpu/drm/asahi/asahi_core.rs
+++ b/drivers/gpu/drm/asahi/asahi_core.rs
@@ -267,6 +267,10 @@ fn init(module: &'static kernel::ThisModule) -> impl PinInit<Self, Error> {
             default: 0,
             description: "G16: J604 with eleven DVFS rows, ADT state 4 kept (default 0)",
         },
+        g16_main_nap: u32 {
+            default: 0,
+            description: "G16: Main +0xf38 = 1 and +0x2568 = core count, as macOS (default 0)",
+        },
         g16_j604_main: u32 {
             default: 0,
             description: "G16: J604 Main tables as macOS has them (default 0; needs eleven rows)",
diff --git a/drivers/gpu/drm/asahi/g16/initdata.rs b/drivers/gpu/drm/asahi/g16/initdata.rs
index ff708888fa..f31c0cd232 100644
--- a/drivers/gpu/drm/asahi/g16/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/initdata.rs
@@ -21,6 +21,7 @@ pub(crate) struct InitData {
     /// Recovery/scheduler owner: root.FirmwareData, not the small Control.
     pub(crate) control: Option<Arc<FwObject>>,
     pub(crate) ready_control: Option<Arc<FwObject>>,
+    #[allow(dead_code)]
     pub(crate) main: Option<Arc<FwObject>>,
     /// Fault/recovery activity; retained under the historical field name.
     #[allow(dead_code)]
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index a9e4ff2312..766d65af96 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -520,26 +520,16 @@ pub(crate) fn max_pstate() -> u32 {
     "G16: highest governed performance state (default 0: the table's top; 1..top; runtime 0644)"
 );
 
-/// Storage of `g16_main_nap` (runtime 0644, default 0).
-static MAIN_NAP: AtomicU32 = AtomicU32::new(0);
-
-/// `g16_main_nap`: write the two Main words macOS 26B123 has on the J604 where ours keeps the
-/// J713's: +0xf38 = 1, on which 25G83 makes its guarded power call 1 whenever it powers the
-/// GPU off (0x3b600) and on entering NAP (0x358e8), and +0x2568 = the enabled core count.
-/// The firmware reads +0xf38 at each of those, so a change applies at the next one.
+/// `g16_main_nap` (load time): write the two Main words macOS 26B123 has on the J604 where ours
+/// keeps the J713's: +0xf38 = 1 and +0x2568 = the enabled core count. 25G83 reads +0xf38 at its
+/// init to register the perf-state completion interrupts (0x34420) and later both waits on them
+/// in every perf-state change (0x2e560) and makes its guarded power call 1 at power-off and NAP
+/// entry, so the word is only valid from INIT: set later, a perf-state change would wait for
+/// interrupts that were never registered.
 pub(crate) fn main_nap() -> bool {
-    MAIN_NAP.load(Ordering::Relaxed) != 0
+    module_parameters::g16_main_nap.value() != 0
 }
 
-live_u32_param!(
-    MAIN_NAP_PARAM,
-    MAIN_NAP_PARMTYPE,
-    MAIN_NAP_PARM,
-    MAIN_NAP,
-    "g16_main_nap",
-    "G16: Main +0xf38 = 1 and +0x2568 = core count, as macOS (default 0; runtime 0644)"
-);
-
 /// Enabled GPU cores, from the identity read at power-up (0 before it).
 static CORES: AtomicU32 = AtomicU32::new(0);
 
diff --git a/drivers/gpu/drm/asahi/g16/power.rs b/drivers/gpu/drm/asahi/g16/power.rs
index a8e7a66446..bb3acb37da 100644
--- a/drivers/gpu/drm/asahi/g16/power.rs
+++ b/drivers/gpu/drm/asahi/g16/power.rs
@@ -174,8 +174,6 @@ pub(crate) struct Power {
     pub(crate) decisions: u64,
     last_decision: Option<(u32, u32, u32, u32, Option<Error>)>,
     pub(crate) utilization: policy::Governor,
-    /// The `g16_main_nap` value last written into the live Main object.
-    main_nap: Option<bool>,
 }
 
 impl Drop for Power {
@@ -222,7 +220,6 @@ pub(crate) fn new(dev: &device::Device) -> Result<Self> {
             decisions: 0,
             last_decision: None,
             utilization: policy::Governor::new(),
-            main_nap: None,
         })
     }
 
@@ -279,34 +276,6 @@ fn ceiling(&mut self, now: u64, idle: bool) -> (u32, bool) {
 }
 
 impl Firmware {
-    /// `g16_main_nap` at runtime: written into the live Main object, read by the firmware at
-    /// its next power-off or NAP entry. The first pass rewrites what INIT wrote.
-    fn service_main_nap(&mut self) -> Result {
-        use super::fw::initdata::hwdata;
-        let want = params::main_nap();
-        if self.power.main_nap == Some(want) {
-            return Ok(());
-        }
-        let cores = if want { params::main_cores() } else { hwdata::CORES_J713 };
-        let main = self.init.main.as_ref().ok_or(ENODEV)?;
-        main.w32(hwdata::NAP_REQUEST, u32::from(want))?;
-        main.w32(hwdata::CORES, cores)?;
-        wmb();
-        if self.power.main_nap.is_some() || want {
-            dev_info!(
-                self.dev(),
-                "M4 power: g16_main_nap={}: Main +{:#x} = {}, +{:#x} = {}\n",
-                u32::from(want),
-                hwdata::NAP_REQUEST,
-                u32::from(want),
-                hwdata::CORES,
-                cores
-            );
-        }
-        self.power.main_nap = Some(want);
-        Ok(())
-    }
-
     /// Runs after firmware acceptance, before publication and while polling
     /// active work. Provider, governor and budget reads occur at most every
     /// 5 ms, independently of completion polling. Only the three
@@ -317,7 +286,6 @@ pub(crate) fn service_power(&mut self) -> Result {
             return Err(error);
         }
         self.service_idle_power_off()?;
-        self.service_main_nap()?;
         // g16_idle_selector: keep the idle value while idle; once work is in flight or
         // pending, force the busy value out below, before any publication.
         if self.power.idle_selected {
-- 
