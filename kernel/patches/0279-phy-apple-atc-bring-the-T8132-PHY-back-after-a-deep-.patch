From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bartosz Nitka <niteria@gmail.com>
Date: Mon, 9 Nov 2026 11:34:50 +0100
Subject: [PATCH] phy: apple: atc: bring the T8132 PHY back after a
 deep sleep

A deep sleep takes the PHY's state behind its power domain's back. Treat
the resume as a domain power-off, so that the next PHY operation sets the
PIPE handler up again, its dummy PHY enable included: a deep sleep clears
that bit (PIPEHANDLER_NONSELECTED_OVERRIDE reads 0x1332, not 0x9332), and
USB3's PIPE lock is not acked without it. Set the clamp on a block that
reads reset values.

Assisted-by: LLM
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 90cfba48fb13a0b3948e17d1f68107d93e227caa)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/phy/apple/atc.c | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/drivers/phy/apple/atc.c b/drivers/phy/apple/atc.c
index f3eadd7184..db03be525a 100644
--- a/drivers/phy/apple/atc.c
+++ b/drivers/phy/apple/atc.c
@@ -3983,9 +3983,21 @@ static int atcphy_configure_t8132(struct apple_atcphy *atcphy, enum atcphy_mode
 		goto done;
 	}
 
+	/* A deep sleep took the block's power: it comes back at reset values, clamp not set yet. */
+	if (!core_read32(atcphy, ATCPHY_POWER_CTRL) && !core_read32(atcphy, ATCPHY_POWER_STAT) &&
+	    !(core_read32(atcphy, ATCPHY_MISC) & ~ATCPHY_MISC_LANE_SWAP)) {
+		dev_dbg(atcphy->dev, "PHY at reset values, setting the clamp\n");
+		core_set32(atcphy, ATCPHY_POWER_CTRL, ATCPHY_POWER_CLAMP_EN);
+		udelay(1);
+	}
 	/* Never reset an inherited common-power epoch to manufacture a cold state. */
-	if (!atcphy_t8132_cold(atcphy))
+	if (!atcphy_t8132_cold(atcphy)) {
+		dev_err(atcphy->dev, "PHY not cold: ctrl %#x stat %#x misc %#x\n",
+			core_read32(atcphy, ATCPHY_POWER_CTRL),
+			core_read32(atcphy, ATCPHY_POWER_STAT),
+			core_read32(atcphy, ATCPHY_MISC));
 		return -EBUSY;
+	}
 	atcphy_usb2_power_on(atcphy);
 	ndelay(500);
 	/* A touched failure retains this epoch without guessing a rollback. */
@@ -7131,6 +7143,9 @@ static int atcphy_resume_noirq(struct device *dev)
 	struct apple_atcphy *atcphy = dev_get_drvdata(dev);
 
 	guard(mutex)(&atcphy->lock);
+	/* A real sleep took T8132's PHY state behind its power domain's back. */
+	if (atcphy->hw->gen == ATCPHY_GENERATION_T8132 && pm_resume_via_firmware())
+		WRITE_ONCE(atcphy->pd_was_off, true);
 	if (!atcphy->hibernated) {
 		atcphy_sleep_lost_common(atcphy);
 		return 0;
-- 
