From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 08:57:23 +0000
Subject: [PATCH] drm/asahi: g16: allow up to 12 compute units per VM

macOS keeps about 20 render submissions resident in the G16G
firmware ring at depth 64 (hypervisor trace of macOS 26B123 on the
J604), so the firmware starts each one while the host is still
retiring earlier ones. Our compute path keeps at most 8 commands in
flight, one per compute unit. With about 16 us of firmware work per
small command and about 150 us from a completion to the next
publication on our side, 8 units drain before the host refills them,
and most commands find the firmware idle.

Raise the unit cap to 12. Units 8..11 take the free interval above
render pass slot 1's tilemap, below the dynamic client range, at the
same stride as units 4..7. The default stays 8 units: nothing changes
unless g16_compute_units is set to 9..12 at module load, together
with g16_horizon (up to units - 1). Each extra unit costs about
33 MiB per VM that runs compute.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/hw.rs     | 18 +++++++++++++-----
 drivers/gpu/drm/asahi/g16/params.rs |  2 +-
 2 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/hw.rs b/drivers/gpu/drm/asahi/g16/hw.rs
index 315c58b62c..9e514a82b0 100644
--- a/drivers/gpu/drm/asahi/g16/hw.rs
+++ b/drivers/gpu/drm/asahi/g16/hw.rs
@@ -207,10 +207,15 @@ pub(crate) mod client {
     pub(crate) const fn compute_base(k: u64) -> u64 {
         if k < 4 {
             0x7001000000 + k * 0x04000000
-        } else {
+        } else if k < 8 {
             COMPUTE_HIGH_BASE + (k - 4) * COMPUTE_HIGH_STRIDE
+        } else {
+            COMPUTE_EXTRA_BASE + (k - 8) * COMPUTE_HIGH_STRIDE
         }
     }
+    /// Compute units 8.. (`g16_compute_units` > 8): the free interval after render pass slot 1's
+    /// tilemap and below the dynamic client range at 0x7040000000, at the same 36 MiB stride.
+    pub(crate) const COMPUTE_EXTRA_BASE: u64 = 0x7037000000;
     /// Compute units 4.. (`g16_compute_units`): the free interval between render pass slot 0's
     /// tilemap and pass slot 1 (`FS_WORK_PAGE + WORK_STRIDE`), 36 MiB apart (a unit spans
     /// 0x20c0000: the 32 MiB pool, then state, list, preempt, aux and context).
@@ -361,15 +366,18 @@ pub(crate) mod sizes {
     /// Compute units a VM may hold at most, one compute command in flight per unit, each
     /// binding its own split UMA slot (compute 1 + k of the 32 per class of the 25G83 layout).
     /// Units 0 and 1 are the qualified ones; 2 and 3 take the next 64 MiB intervals below the
-    /// render units; 4..7 the free interval below render pass slot 1. How many a VM allocates
-    /// is `g16_compute_units` (latched).
-    pub(crate) const COMPUTE_SLOTS: usize = 8;
+    /// render units; 4..7 the free interval below render pass slot 1; 8..11 the free interval
+    /// above pass slot 1's tilemap. How many a VM allocates is `g16_compute_units` (latched).
+    pub(crate) const COMPUTE_SLOTS: usize = 12;
     const _: () = assert!(
         super::client::compute_context(3) + 0x40000 <= super::client::render_base(0)
             && super::client::TILEMAP + super::client::TILEMAP_SIZE
                 <= super::client::COMPUTE_HIGH_BASE
-            && super::client::compute_context(COMPUTE_SLOTS as u64 - 1) + 0x40000
+            && super::client::compute_context(7) + 0x40000
                 <= super::client::FS_WORK_PAGE + super::client::WORK_STRIDE
+            && super::client::TILEMAP + super::client::TILEMAP_SIZE + super::client::WORK_STRIDE
+                <= super::client::COMPUTE_EXTRA_BASE
+            && super::client::compute_context(COMPUTE_SLOTS as u64 - 1) + 0x40000 <= 0x7040000000
             && super::client::WORK_PAGE + COMPUTE_SLOTS as u64 * super::client::CWORK_STRIDE
                 <= super::client::compute_base(0)
     );
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 7529d5630b..629e5a542e 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -626,7 +626,7 @@ pub(crate) fn compute_units() -> usize {
     COMPUTE_UNITS_PARM,
     COMPUTE_UNITS,
     "g16_compute_units",
-    "G16: compute units per VM, one compute command in flight each (default 8; 2..8; 4 = k908; latched at the engine start, set it as a module option)"
+    "G16: compute units per VM, one compute command in flight each (default 8; 2..12; 4 = k908; 9..12 = deeper compute queue, ~33 MiB per unit; latched at the engine start, set it as a module option)"
 );
 
 live_u32_param!(
