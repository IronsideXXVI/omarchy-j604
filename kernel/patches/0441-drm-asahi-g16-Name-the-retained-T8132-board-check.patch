From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sean Dolbec <sdolbec1@gmail.com>
Date: Wed, 4 Nov 2026 14:52:32 -0500
Subject: [PATCH] drm/asahi: g16: Name the retained T8132 board check

Use the shared retained T8132 predicate at the G16 board check. The old
apple_pmp_j713_board() already selected firmware-qualified T8132 machines,
including J773g, so this is a rename with no admission change. The later
handoff, firmware identity, DMA and hardware identity checks remain.

A prior J773g bring-up stack admitted the handoff and reached firmware
READY with subsequent changes; this rename was not isolated on hardware.

Signed-off-by: Sean Dolbec <sdolbec1@gmail.com>
[dylan: one tool trailer of the original message is not reproduced here]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/boot.rs | 2 +-
 drivers/gpu/drm/asahi/g16/glue.c  | 4 ++--
 drivers/gpu/drm/asahi/g16/mod.rs  | 2 +-
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/boot.rs b/drivers/gpu/drm/asahi/g16/boot.rs
index 9db287fb8c..d46a813b6f 100644
--- a/drivers/gpu/drm/asahi/g16/boot.rs
+++ b/drivers/gpu/drm/asahi/g16/boot.rs
@@ -62,7 +62,7 @@ fn asahi_g16_reserved_region(
         ) -> core::ffi::c_int;
     }
 
-    /// A qualified J713/T8132 board.
+    /// A qualified T8132 board (J713, J773g).
     pub(crate) fn board() -> bool {
         // SAFETY: Reads the machine compatible strings only.
         unsafe { asahi_g16_board() }
diff --git a/drivers/gpu/drm/asahi/g16/glue.c b/drivers/gpu/drm/asahi/g16/glue.c
index a07032a1b6..ba990103fa 100644
--- a/drivers/gpu/drm/asahi/g16/glue.c
+++ b/drivers/gpu/drm/asahi/g16/glue.c
@@ -202,10 +202,10 @@ int asahi_g16_tvm_enable(struct device *dev)
 	return ret;
 }
 
-/* Whether this is a qualified J713/T8132 board. */
+/* Whether this T8132 board's retained PMP carries the GPU's AGX vote. */
 bool asahi_g16_board(void)
 {
-	return apple_pmp_j713_board();
+	return apple_pmp_t8132_retained_board();
 }
 
 /*
diff --git a/drivers/gpu/drm/asahi/g16/mod.rs b/drivers/gpu/drm/asahi/g16/mod.rs
index 4e6af9df06..e0eccf6db6 100644
--- a/drivers/gpu/drm/asahi/g16/mod.rs
+++ b/drivers/gpu/drm/asahi/g16/mod.rs
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-only OR MIT
 
-//! G16 GPU support (T8132, M4: J713; the qualified 25G83 firmware).
+//! G16 GPU support (T8132, M4: J713 and J773g; the qualified 25G83 firmware).
 //!
 //! G16 firmware is *classic*: one ring per engine (TA, FS, compute) and ordering expressed by
 //! in-ring barrier records that wait on another queue's stamp, unlike the G17 kick-ring/QID
-- 
2.43.0

