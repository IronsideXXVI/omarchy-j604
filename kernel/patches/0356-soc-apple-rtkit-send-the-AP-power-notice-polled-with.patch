From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 08:11:50 +0000
Subject: [PATCH 356/358] soc: apple: rtkit: send the AP power notice polled,
 with a counted wait

apple_rtkit_ap_power_noirq() polls the mailbox but still waits on
jiffies and wait_for_completion_timeout(), so it can't run once
timekeeping is suspended and interrupts are off, as in a sleep's last
steps. apple_rtkit_sleep_idle_polled() already has a path that can: the
replies are fetched by apple_mbox_poll() for a counted number of 10 us
steps, through a receive callback that only tracks the state acks,
answers notifications and echoes OSLOG counters.

Let apple_rtkit_polled_state() ask for and wait for any state rather
than idle alone (its two callers still ask for idle), and add
apple_rtkit_ap_power_polled(): the AP power notice alone, on or idle,
for a co-processor that keeps running, with what is already waiting
answered first and the normal receive callback given back after.

Assisted-by: LLM
---
 drivers/soc/apple/rtkit.c       | 43 +++++++++++++++++++++++++++++----
 include/linux/soc/apple/rtkit.h |  7 ++++++
 2 files changed, 45 insertions(+), 5 deletions(-)

diff --git a/drivers/soc/apple/rtkit.c b/drivers/soc/apple/rtkit.c
index a02ed59ebc..dd62b8cfe9 100644
--- a/drivers/soc/apple/rtkit.c
+++ b/drivers/soc/apple/rtkit.c
@@ -2466,12 +2466,12 @@ static void apple_rtkit_polled_rx(struct apple_mbox *mbox, struct apple_mbox_msg
 	}
 }
 
-static int apple_rtkit_polled_state(struct apple_rtkit *rtk, u8 type, unsigned int *state,
-				    unsigned int *us)
+static int apple_rtkit_polled_state(struct apple_rtkit *rtk, u8 type, unsigned int want,
+				    unsigned int *state, unsigned int *us)
 {
 	struct apple_mbox_msg msg = {
 		.msg0 = FIELD_PREP(APPLE_RTKIT_MGMT_TYPE, type) |
-			FIELD_PREP(APPLE_RTKIT_MGMT_PWR_STATE, APPLE_RTKIT_PWR_STATE_IDLE),
+			FIELD_PREP(APPLE_RTKIT_MGMT_PWR_STATE, want),
 		.msg1 = APPLE_RTKIT_EP_MGMT,
 	};
 	int i;
@@ -2485,7 +2485,7 @@ static int apple_rtkit_polled_state(struct apple_rtkit *rtk, u8 type, unsigned i
 
 	for (i = 0; i < APPLE_RTKIT_POLLED_LOOPS; i++) {
 		apple_mbox_poll(rtk->mbox);
-		if (READ_ONCE(*state) == APPLE_RTKIT_PWR_STATE_IDLE)
+		if (READ_ONCE(*state) == want)
 			return 0;
 		udelay(APPLE_RTKIT_POLLED_STEP_US);
 		*us += APPLE_RTKIT_POLLED_STEP_US;
@@ -2519,9 +2519,10 @@ int apple_rtkit_sleep_idle_polled(struct apple_rtkit *rtk, void __iomem *cpu_con
 	}
 
 	ret = apple_rtkit_polled_state(rtk, APPLE_RTKIT_MGMT_SET_AP_PWR_STATE,
-				       &rtk->ap_power_state, us);
+				       APPLE_RTKIT_PWR_STATE_IDLE, &rtk->ap_power_state, us);
 	if (!ret)
 		ret = apple_rtkit_polled_state(rtk, APPLE_RTKIT_MGMT_SET_IOP_PWR_STATE,
+					       APPLE_RTKIT_PWR_STATE_IDLE,
 					       &rtk->iop_power_state, us);
 	if (!ret)
 		ret = readl_poll_timeout_atomic(cpu_control + APPLE_ASC_CPU_STATUS, status,
@@ -2537,6 +2538,38 @@ int apple_rtkit_sleep_idle_polled(struct apple_rtkit *rtk, void __iomem *cpu_con
 }
 EXPORT_SYMBOL_GPL(apple_rtkit_sleep_idle_polled);
 
+int apple_rtkit_ap_power_polled(struct apple_rtkit *rtk, bool on, unsigned int *us)
+{
+	unsigned int want = on ? APPLE_RTKIT_PWR_STATE_ON : APPLE_RTKIT_PWR_STATE_IDLE;
+	unsigned long flags;
+	u64 owed;
+	int ret;
+
+	*us = 0;
+	spin_lock_irqsave(&rtk->mbox->rx_lock, flags);
+	rtk->mbox->rx = apple_rtkit_polled_rx;
+	spin_unlock_irqrestore(&rtk->mbox->rx_lock, flags);
+
+	/* As for the idle above: what's waiting first, then a counter left for the work. */
+	apple_mbox_poll(rtk->mbox);
+	owed = xchg(&rtk->oslog_owed, 0);
+	if (owed) {
+		struct apple_mbox_msg echo = { .msg0 = owed, .msg1 = APPLE_RTKIT_EP_OSLOG };
+
+		apple_rtkit_polled_send(rtk, echo);
+	}
+
+	ret = apple_rtkit_polled_state(rtk, APPLE_RTKIT_MGMT_SET_AP_PWR_STATE, want,
+				       &rtk->ap_power_state, us);
+
+	spin_lock_irqsave(&rtk->mbox->rx_lock, flags);
+	rtk->mbox->rx = apple_rtkit_rx;
+	spin_unlock_irqrestore(&rtk->mbox->rx_lock, flags);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_ap_power_polled);
+
 void apple_rtkit_mailbox_recv_off(struct apple_rtkit *rtk)
 {
 	apple_mbox_set_recv_enabled(rtk->mbox, false);
diff --git a/include/linux/soc/apple/rtkit.h b/include/linux/soc/apple/rtkit.h
index 14f716638e..ddbeec60af 100644
--- a/include/linux/soc/apple/rtkit.h
+++ b/include/linux/soc/apple/rtkit.h
@@ -287,6 +287,13 @@ void apple_rtkit_mailbox_off(struct apple_rtkit *rtk);
 int apple_rtkit_sleep_idle_polled(struct apple_rtkit *rtk, void __iomem *cpu_control,
 				  unsigned int *us);
 
+/*
+ * The AP power notice alone (on, or idle) with interrupts off and timekeeping
+ * suspended: the reply is polled for a counted time. The co-processor keeps
+ * running. @us is about how long the acknowledgment took.
+ */
+int apple_rtkit_ap_power_polled(struct apple_rtkit *rtk, bool on, unsigned int *us);
+
 /*
  * Only the mailbox's receive bit, for the moment before that co-processor's run bit
  * goes. Safe with interrupts off, and apple_rtkit_warm_restart() sets it again.
-- 
2.43.0

