From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 05:53:56 +0000
Subject: [PATCH] drm/asahi: g16: Correct g16_init_macos's
 POWER_PERFORMANCE words

Two corrections to the POWER_PERFORMANCE words g16_init_macos writes:

- Bit 0x20 also writes +0x5b64 = 13.6 and +0x5b68 = 8.0, macOS
  26B123's +0x5bac / +0x5bb0. The firmware's thermal limit path reads
  them next to two sensor registers; the same code in both builds
  places them 0x48 lower in this firmware.
- Bit 0x40 no longer writes +0x6398 = 0xf. It is the mask of a table
  of AON-PTD source codes that macOS fills next to it; written alone,
  it points the firmware at sources with no code.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/fw/initdata.rs | 18 +++++++++++++-----
 1 file changed, 13 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/fw/initdata.rs b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
index a097c5a41d..eb32e9a585 100644
--- a/drivers/gpu/drm/asahi/g16/fw/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
@@ -421,11 +421,19 @@ pub(crate) mod init_macos {
         (0x610, 1000),
         (0x620, 900),
     ];
-    /// 26B123 POWER_PERFORMANCE +0x28e8, +0x2f28, +0x2f30 and +0x2f34.
-    pub(crate) const PP: [(usize, u32); 4] =
-        [(0x28c0, 1), (0x2f08, 0x6958), (0x2f10, 125), (0x2f14, 1)];
-    /// 26B123 POWER_PERFORMANCE +0x2f0c (100.0) and +0x63c0, placed by value anchors.
-    pub(crate) const PP_TAIL: [(usize, u32); 2] = [(0x2eec, 0x42c80000), (0x6398, 0xf)];
+    /// 26B123 POWER_PERFORMANCE +0x28e8, +0x2f28, +0x2f30, +0x2f34, +0x5bac (13.6) and
+    /// +0x5bb0 (8.0).
+    pub(crate) const PP: [(usize, u32); 6] = [
+        (0x28c0, 1),
+        (0x2f08, 0x6958),
+        (0x2f10, 125),
+        (0x2f14, 1),
+        (0x5b64, 0x4159999a),
+        (0x5b68, 0x41000000),
+    ];
+    /// 26B123 POWER_PERFORMANCE +0x2f0c (100.0), placed by value anchors. macOS's +0x63c0 =
+    /// 0xf is left out: it masks a table of AON-PTD source codes this switch does not write.
+    pub(crate) const PP_TAIL: [(usize, u32); 1] = [(0x2eec, 0x42c80000)];
 
     const fn within(words: &[(usize, u32)], size: usize) -> bool {
         let mut i = 0;
-- 
