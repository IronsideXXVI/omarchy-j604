From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <ironsidexxvi@users.noreply.github.com>
Date: Tue, 17 Nov 2026 09:51:43 +0000
Subject: [PATCH] drm/asahi: g16: Bound compute snapshot to the encoded
 prefix

The scratch work image is 8 KiB. Capture its first 4 KiB, including the embedded sequence, within the recorder per-record cap; do not silently skip it.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/engine.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 68d6bdb0d0..1bda9682db 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -2048,7 +2048,7 @@ fn prefix_compute(
             image(&mut scratch.cq)?,
         )
         .map_err(|_| EINVAL)?;
-        super::host_records::capture("compute-encoded", s.work.va, g.qinfo.va, n, w);
+        super::host_records::capture("compute-encoded-prefix", s.work.va, g.qinfo.va, n, &w[..0x1000]);
         if before != 0 {
             // Slots::claim_compute proved a different fully retired unit displaced this
             // descriptor in the same hardware slot. Keep every firmware-mutated byte.
-- 
2.43.0

