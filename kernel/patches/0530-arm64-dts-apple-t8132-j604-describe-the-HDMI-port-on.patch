diff --git a/arch/arm64/boot/dts/apple/t8132-j604-hdmi.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-hdmi.dtsi
new file mode 100644
index 0000000000..029a428d4c
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t8132-j604-hdmi.dtsi
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * HDMI port of the Apple MacBook Pro (14-inch, M4), J604.
+ *
+ * The port (ADT port-hdmi-1) hangs off ATC2, an ATC with no USB controller
+ * on this board, run as a fixed DisplayPort PHY (ADT atc2-dpphy: port-type
+ * HDMI, not tunnelled, atc-lane-config <3 3>), through the ATC2 display
+ * crossbar (dfp endpoint 2, port 0 = the DP PHY) into an on-board DP-to-HDMI
+ * converter (ADT dp2hdmi-gpio0, i2c0/pcon0 at address 0x08). As on the M1/M2
+ * and M3 Pro MacBook Pros, the converter has its own power enable, the HDMI
+ * port another one, and the port's hot-plug signal comes in on an AOP GPIO:
+ *
+ *   dp2hdmi_pwr_en  SMC gP1a  -> smc_gpio 26
+ *   hdmi_pwr_en     SMC gP0f  -> smc_gpio 15
+ *   reset           SMC gP10  (smc_gpio 16, not driven: no binding uses it)
+ *   hdmi_hpd        AOP GPIO 41, also the hot-plug interrupt
+ *   force-dpfu      AOP GPIO 36 (converter firmware update, not used)
+ *
+ * The ADT does not tie the port to one external display coprocessor: any
+ * dispext reaches ATC2 through display-crossbar0. It is described on
+ * dcpext0, the hybrid pipeline (as on the M3 Pro), with UFP selector 2, the
+ * selector dcpext0 uses on every ATC crossbar. dcpext0 keeps its Type-C
+ * routes.
+ *
+ * Everything here stays disabled with dcpext0 (t8132-j604-dcpext.dtsi): no
+ * driver in this tree drives a T8132 external coprocessor, and the T8132 ATC
+ * PHY has no DisplayPort mode outside USB4 tunnels yet. ATC2's power domains
+ * (t8132-j604-pmgr.dtsi) stay disabled as well.
+ *
+ * The port's audio is DPA1 (ADT dp-audio1, SIO channel 0x66, the dp-audio
+ * node dcpext0 names), as on the M3 Pro HDMI port. It is not described: this
+ * tree has no T8132 SIO node yet.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+/ {
+	aliases {
+		/* m1n1 copies the ATC tunables through this alias. */
+		atcphy2 = &atcphy2;
+	};
+};
+
+&atcphy2 {
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@2 {
+			reg = <2>;
+			atcphy2_dp: endpoint {
+				remote-endpoint = <&dcpext0_dpout>;
+			};
+		};
+	};
+};
+
+&dcpext0 {
+	apple,connector-type = "HDMI-A";
+
+	/* HDMI HPD, also used as the hotplug interrupt */
+	hdmi-hpd-gpios = <&pinctrl_aop 41 GPIO_ACTIVE_HIGH>;
+	hdmi-pwren-gpios = <&smc_gpio 15 GPIO_ACTIVE_HIGH>;
+	dp2hdmi-pwren-gpios = <&smc_gpio 26 GPIO_ACTIVE_HIGH>;
+
+	phys = <&atcphy2 PHY_TYPE_DP>, <&atcphy0 PHY_TYPE_DP>,
+	       <&atcphy1 PHY_TYPE_DP>, <&atcphy3 PHY_TYPE_DP>;
+	phy-names = "dp-phy", "typec0", "typec1", "typec2";
+	mux-controls = <&atc2_dpxbar 0>,
+		       <&atc0_dpxbar 0>, <&atc1_dpxbar 0>, <&atc3_dpxbar 0>,
+		       <&atc0_dpxbar 1>, <&atc0_dpxbar 2>,
+		       <&atc1_dpxbar 1>, <&atc1_dpxbar 2>,
+		       <&atc3_dpxbar 1>, <&atc3_dpxbar 2>;
+	mux-control-names = "dp-xbar", "typec0", "typec1", "typec2",
+			    "typec0-dpin0", "typec0-dpin1",
+			    "typec1-dpin0", "typec1-dpin1",
+			    "typec2-dpin0", "typec2-dpin1";
+	mux-index = <2>;
+	apple,dptx-phy = <2>;
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@1 {
+			reg = <1>;
+			dcpext0_dpout: endpoint {
+				remote-endpoint = <&atcphy2_dp>;
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 992d6b1457..1e99778645 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -1041,3 +1041,5 @@
 #include "t8132-j604-dcpext.dtsi"
 
 #include "t8132-j604-sleep.dtsi"
+/* The HDMI port, on dcpext0 (disabled with it). */
+#include "t8132-j604-hdmi.dtsi"
