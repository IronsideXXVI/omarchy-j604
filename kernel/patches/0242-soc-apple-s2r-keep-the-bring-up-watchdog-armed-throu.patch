From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 20:41:30 +0000
Subject: [PATCH] soc: apple: s2r: keep the bring-up watchdog armed
 through resume

With wdt_from_enter, the bring-up watchdog covers ->enter, but the
syscore resume puts the watchdog driver's state back as its first act.
A stall later in resume, in a device's resume or in the thaw, then has
no watchdog at all and leaves a dark machine.

With wdt_from_enter set, keep it armed instead: the syscore resume arms
it once more for a full window (the warm boot path may have stopped it),
and a PM_POST_SUSPEND notifier, which runs after the thaw, puts back what
the watchdog driver had programmed. If the driver started the watchdog
again in its own resume, the hardware no longer holds the bring-up alarm
and is left to the driver. The notifier logs which of the two it found.

Without wdt_from_enter nothing changes; it is off by default.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/apple-s2r.c | 62 ++++++++++++++++++++++++++++++-----
 1 file changed, 54 insertions(+), 8 deletions(-)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index 1415a5d71d..efdd940abb 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -56,8 +56,11 @@
  * never resumes ends in a reset instead of a hang. Both the boot firmware's
  * warm boot path and the syscore resume disarm it; the latter puts back what
  * the watchdog driver had programmed.
- * With wdt_from_enter it is armed already when ->enter starts, so that
- * the coprocessor stops and the SoC steps are covered as well.
+ * With wdt_from_enter it is armed already when ->enter starts, so that the
+ * coprocessor stops and the SoC steps are covered as well, and it stays armed
+ * through the whole resume: the syscore resume gives it a fresh window, and
+ * the PM_POST_SUSPEND notifier, after thaw, puts back what the watchdog
+ * driver had programmed.
  *
  * For bring-up, the breadcrumb parameter makes each late step write its
  * number to the PMU's boot stage byte, which keeps its value through a
@@ -253,6 +256,10 @@ struct apple_s2r {
 
 	/* Watchdog state replaced by the safety timer */
 	bool wdt_armed;
+	/* Armed from ->enter: kept through resume, handed back after it */
+	bool wdt_hold;
+	u32 wdt_alarm;
+	struct notifier_block pm_nb;
 	u32 wdt_saved_ctl;
 	u32 wdt_saved_alarm;
 
@@ -573,7 +580,7 @@ MODULE_PARM_DESC(wdt_timeout, "For bring-up: right before the SoC goes to sleep,
 
 static bool wdt_from_enter;
 module_param(wdt_from_enter, bool, 0644);
-MODULE_PARM_DESC(wdt_from_enter, "For bring-up: arm the wdt_timeout watchdog already when ->enter starts, so that a stop in the coprocessor stops or the SoC steps also ends in a reset; the finisher arms it again with a fresh count; needs wdt_timeout (default: off)");
+MODULE_PARM_DESC(wdt_from_enter, "For bring-up: arm the wdt_timeout watchdog already when ->enter starts, so that a stop in the coprocessor stops or the SoC steps also ends in a reset; the finisher arms it again with a fresh count, the syscore resume once more, and it is handed back only after the whole resume; needs wdt_timeout (default: off)");
 
 static bool breadcrumb;
 module_param(breadcrumb, bool, 0644);
@@ -823,7 +830,8 @@ static void apple_s2r_wdt_arm(struct apple_s2r *s2r)
 {
 	u32 secs = min(wdt_timeout, WDT_MAX_TIMEOUT);
 
-	writel_relaxed(secs * WDT_CLK_HZ, s2r->wdt + WDT_ALARM);
+	s2r->wdt_alarm = secs * WDT_CLK_HZ;
+	writel_relaxed(s2r->wdt_alarm, s2r->wdt + WDT_ALARM);
 	writel_relaxed(0, s2r->wdt + WDT_COUNT);
 	writel(WDT_CTL_RESET_EN, s2r->wdt + WDT_CTL);
 }
@@ -985,6 +993,7 @@ static int apple_s2r_enter(suspend_state_t state)
 	s2r->failed_ret = 0;
 	s2r->restore_ret = 0;
 	s2r->wdt_armed = false;
+	s2r->wdt_hold = false;
 
 	/*
 	 * Without a warm boot mailbox nothing can resume the SoC: only the
@@ -1007,12 +1016,14 @@ static int apple_s2r_enter(suspend_state_t state)
 	}
 
 	/*
-	 * Bring-up: from here on a stop anywhere in ->enter ends in a reset.
-	 * The syscore resume puts the watchdog back on every return.
+	 * Bring-up: from here on a stop anywhere in ->enter or in the resume
+	 * ends in a reset. The syscore resume arms it again, and the watchdog
+	 * goes back to its driver only once the whole sleep has finished.
 	 */
 	if (s2r->wdt && wdt_timeout && READ_ONCE(wdt_from_enter)) {
 		apple_s2r_wdt_take(s2r);
 		apple_s2r_wdt_arm(s2r);
+		s2r->wdt_hold = true;
 	}
 	apple_s2r_crumb(s2r, S2R_CRUMB_ENTER);
 
@@ -1118,8 +1129,15 @@ static void apple_s2r_syscore_resume(void *data)
 	struct apple_s2r *s2r = data;
 	unsigned long done = s2r->done;
 
-	/* First, before anything that could hang until the reset */
-	if (s2r->wdt_armed) {
+	/*
+	 * First, before anything that could hang until the reset. Armed from
+	 * ->enter, the watchdog stays armed through the rest of resume, with a
+	 * full window from here (the warm boot path may have disarmed it), and
+	 * goes back to its driver once the whole sleep has finished.
+	 */
+	if (s2r->wdt_armed && s2r->wdt_hold) {
+		apple_s2r_wdt_arm(s2r);
+	} else if (s2r->wdt_armed) {
 		apple_s2r_wdt_restore(s2r);
 		s2r->wdt_armed = false;
 	}
@@ -1157,6 +1175,31 @@ static const struct syscore_ops apple_s2r_syscore_ops = {
 	.resume = apple_s2r_syscore_resume,
 };
 
+/*
+ * After the whole sleep, thaw included: give the watchdog back. If its driver
+ * started it again in its resume, the driver owns it now: leave it as it is.
+ */
+static int apple_s2r_pm_notify(struct notifier_block *nb, unsigned long action,
+			       void *data)
+{
+	struct apple_s2r *s2r = container_of(nb, struct apple_s2r, pm_nb);
+
+	if (action != PM_POST_SUSPEND || !s2r->wdt_armed || !s2r->wdt_hold)
+		return NOTIFY_DONE;
+
+	if (readl_relaxed(s2r->wdt + WDT_CTL) == WDT_CTL_RESET_EN &&
+	    readl_relaxed(s2r->wdt + WDT_ALARM) == s2r->wdt_alarm) {
+		apple_s2r_wdt_restore(s2r);
+		dev_info(s2r->dev, "bring-up watchdog held through resume, handed back\n");
+	} else {
+		dev_info(s2r->dev, "bring-up watchdog held through resume, its driver took it back\n");
+	}
+	s2r->wdt_armed = false;
+	s2r->wdt_hold = false;
+
+	return NOTIFY_DONE;
+}
+
 static void apple_s2r_wake(void)
 {
 	struct apple_s2r *s2r = apple_s2r;
@@ -1483,6 +1526,9 @@ static int apple_s2r_probe(struct platform_device *pdev)
 	s2r->syscore.data = s2r;
 	register_syscore(&s2r->syscore);
 
+	s2r->pm_nb.notifier_call = apple_s2r_pm_notify;
+	register_pm_notifier(&s2r->pm_nb);
+
 	/*
 	 * The M4 GPU firmware has no stop and warm restart yet, so its driver
 	 * refuses a sleep that powers the SoC down once the firmware ran: with
