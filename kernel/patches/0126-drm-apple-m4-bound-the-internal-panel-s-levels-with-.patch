From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 19:28:04 +0000
Subject: [PATCH] drm/apple: m4: bound the internal panel's levels with
 the XDR guard

The J604 panel's EDR highlights are asked for up to its ADT peak (1600
nits) and a raised SDR ceiling up to the aurora maximum (1000), with
nothing known about how the 26.6.2 firmware answers a level above the
600 nit user maximum; a refused swap leaves the panel black until a
reboot.

Put every swap's levels under the XDR guard: the raised ceiling, the
EDR peak and the EDR brightness limit are bounded by its cap, and the
swap's outcome feeds it back: whether it was taken, how long it took
from A407 to D590 and whether its D590 said displayed (byte 4, as on
dcpext; read for the internal panel's D590 now). The guard starts at
its first rung (800 nits) and climbs to the aurora maximum as swaps
are taken; when it refuses a rung the levels go back at once, the
standing one re-sent. With panel_xdr=0 every level stays at the user
maximum; a write starts the guard over.

The panel also gets a thermal cooling device ("apple-dcp-panel"):
each state lowers every panel level, SDR white included, by 100 nits
down to the ADT thermal minimum cap (300 nits), as macOS does. A
device tree thermal zone may bind it.

debugfs iomfb_m4 shows the guard ("xdr state= cap= limit= taken= ..."),
the journal each rung taken or refused.

The 1600 nit peak stays out: the guard's top is the aurora maximum.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/iomfb_m4.c | 189 ++++++++++++++++++++++++++++++-
 1 file changed, 183 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index 73d1a61c90..3a09ea14c1 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -27,6 +27,7 @@
 #include <linux/unaligned.h>
 #include <linux/workqueue.h>
 #include <linux/hdmi.h>
+#include <linux/thermal.h>
 #include <drm/drm_atomic.h>
 #include <drm/drm_connector.h>
 #include <drm/drm_framebuffer.h>
@@ -64,6 +65,7 @@
 #include "dcp-m4-callback.h"
 #include "dcp-m4-property.h"
 #include "dcp-m4-frame.h"
+#include "dcp-m4-xdr.h"
 #include "parser.h"
 #include "t8132_ext_drm.h"
 
@@ -229,6 +231,29 @@ module_param_cb(panel_boost_nits, &panel_boost_nits_ops, &panel_boost_nits, 0644
 MODULE_PARM_DESC(panel_boost_nits,
 		 "J604: SDR ceiling for bright surroundings: the backlight's full scale shows this many nits, up to the panel's ADT aurora-maximum-nits (an ambient-light policy sets it; 0 or the user maximum: off, default; applies from the next present)");
 
+static bool panel_xdr = true;
+/* Bumped by every write: the guard starts over at the next swap. */
+static atomic_t panel_xdr_gen = ATOMIC_INIT(0);
+
+static int panel_xdr_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	if (!ret)
+		atomic_inc(&panel_xdr_gen);
+	return ret;
+}
+
+static const struct kernel_param_ops panel_xdr_ops = {
+	.flags = KERNEL_PARAM_OPS_FL_NOARG,
+	.set = panel_xdr_set,
+	.get = param_get_bool,
+};
+
+module_param_cb(panel_xdr, &panel_xdr_ops, &panel_xdr, 0644);
+MODULE_PARM_DESC(panel_xdr,
+		 "J604: ask the internal panel for levels above the user maximum (EDR highlights, a raised SDR ceiling) only as far as its firmware has been seen to take them, climbing to the ADT aurora maximum; a level not taken goes back at once to the last one taken (default: on; off holds every level at the user maximum; a write starts over)");
+
 struct iomfb_m4 {
 	struct apple_dcp *owner;
 	struct device *dev;
@@ -322,6 +347,18 @@ struct iomfb_m4 {
 	 * aurora-maximum-nits; 0: none) and the one the last carried level used.
 	 */
 	u32 boost_max, boost_sent;
+	/*
+	 * The XDR guard (panel_xdr, dcp-m4-xdr.h), the panel_xdr writes it has
+	 * seen, the ADT thermal minimum cap, the cooling state, its deepest and
+	 * the cooling device, the last level asked for above the user maximum
+	 * and how long the last swap took.
+	 */
+	struct dcp_m4_xdr xdr;
+	int xdr_gen;
+	bool xdr_ready;
+	u32 thermal_min_cap, thermal_max, thermal_state;
+	struct thermal_cooling_device *xdr_cdev;
+	u32 xdr_asked, xdr_last_us;
 	struct delayed_work idle_cache;
 	/*
 	 * Framebuffer references a window let go of, put
@@ -994,6 +1031,8 @@ struct dcp_m4_runtime {
 	const struct dcp_m4_edr_words *edr;
 	/* A raised panel level for the next primary present, 0: none */
 	u32 level;
+	/* The internal panel's last D590, and whether it said displayed. */
+	bool int_shown_valid, int_shown;
 	struct completion received;
 	struct workqueue_struct *wq;
 	struct work_struct idle;
@@ -2104,6 +2143,12 @@ static int dcp_m4_runtime_callback(struct dcp_m4_runtime *r, u64 word)
 		goto failed;
 	}
 	r->callbacks++;
+	/* The internal panel's D590: displayed at +0x4, as dcpext's says. */
+	if (!dcp->external && dcp_m4_callback_method(packet.tag) == dcp_m4_pf->done_method &&
+	    packet.input_size == dcp_m4_pf->done_size) {
+		r->int_shown = snapshot[4] != 0;
+		r->int_shown_valid = true;
+	}
 	dev_dbg(dcp->dev, "DCP callback D%03d %u/%u remote=%u flag9=%u\n",
 		 dcp_m4_callback_method(packet.tag), packet.input_size, packet.output_size,
 		 packet.remote, packet.callback_flag);
@@ -3206,6 +3251,66 @@ int iomfb_m4_get_mode(struct apple_dcp *owner, struct drm_display_mode *mode)
  * A profile without a model year, or an ADT without a P3 target, keeps the
  * connector as before.
  */
+static int iomfb_m4_cdev_max(struct thermal_cooling_device *cdev, unsigned long *state)
+{
+	struct iomfb_m4 *dcp = cdev->devdata;
+
+	*state = READ_ONCE(dcp->thermal_max);
+	return 0;
+}
+
+static int iomfb_m4_cdev_get(struct thermal_cooling_device *cdev, unsigned long *state)
+{
+	struct iomfb_m4 *dcp = cdev->devdata;
+
+	*state = READ_ONCE(dcp->thermal_state);
+	return 0;
+}
+
+static int iomfb_m4_cdev_set(struct thermal_cooling_device *cdev, unsigned long state)
+{
+	struct iomfb_m4 *dcp = cdev->devdata;
+
+	if (state > READ_ONCE(dcp->thermal_max))
+		return -EINVAL;
+	/* From the next present on. */
+	WRITE_ONCE(dcp->thermal_state, state);
+	return 0;
+}
+
+static const struct thermal_cooling_device_ops iomfb_m4_cdev_ops = {
+	.get_max_state = iomfb_m4_cdev_max,
+	.get_cur_state = iomfb_m4_cdev_get,
+	.set_cur_state = iomfb_m4_cdev_set,
+};
+
+/*
+ * Thermal mitigation of the internal panel, as macOS's: a cooling device
+ * whose states lower every panel level 100 nits at a time, down to the ADT
+ * thermal minimum cap (none without one). A thermal zone of the device tree
+ * may bind it; its sysfs cur_state sets it otherwise.
+ */
+static void iomfb_m4_xdr_cooling(struct iomfb_m4 *dcp)
+{
+	struct thermal_cooling_device *cdev;
+	struct dcp_m4_xdr x;
+
+	dcp_m4_xdr_init(&x, dcp_m4_pf->brightness_max, dcp->boost_max, dcp->thermal_min_cap,
+			true);
+	WRITE_ONCE(dcp->thermal_max, dcp_m4_xdr_max_state(&x));
+	if (!dcp->thermal_max || dcp->xdr_cdev)
+		return;
+	cdev = devm_thermal_of_cooling_device_register(dcp->dev, 0, "apple-dcp-panel", dcp,
+						       &iomfb_m4_cdev_ops);
+	if (IS_ERR(cdev)) {
+		dev_info(dcp->dev, "XDR: no panel cooling device: %pe\n", cdev);
+		return;
+	}
+	dcp->xdr_cdev = cdev;
+	dev_info(dcp->dev, "XDR: panel cooling device, %u states down to %u nits\n",
+		 dcp->thermal_max, dcp->thermal_min_cap);
+}
+
 int iomfb_m4_panel_edid(struct apple_dcp *owner, struct drm_connector *connector)
 {
 	struct iomfb_m4 *dcp = owner->v26_6;
@@ -3242,6 +3347,8 @@ int iomfb_m4_panel_edid(struct apple_dcp *owner, struct drm_connector *connector
 		dcp->boost_max = ret || adt.aurora_max_nits <= dcp_m4_pf->brightness_max ? 0 :
 				 adt.aurora_max_nits;
 		dcp->edr_ceiling = dcp_edr_ceiling(dcp->panel_edr_headroom);
+		dcp->thermal_min_cap = ret ? 0 : adt.thermal_min_cap;
+		iomfb_m4_xdr_cooling(dcp);
 		dev_info(dcp->dev, "panel ADT: %s; colour target %s; EDR headroom %u.%03u\n",
 			 ret ? "unavailable" : "parsed",
 			 dcp->panel_p3 ? "Display P3" :
@@ -3869,13 +3976,52 @@ static u32 iomfb_m4_boost_ceiling(struct iomfb_m4 *dcp)
 	return min(want, dcp->boost_max);
 }
 
+/* Under dcp->lock: (re)start the guard when panel_xdr was written or the ADT read. */
+static void iomfb_m4_xdr_sync(struct iomfb_m4 *dcp)
+{
+	int gen = atomic_read(&panel_xdr_gen);
+	bool same = dcp->xdr_ready && dcp->xdr.top == dcp->boost_max &&
+		    dcp->xdr.min_cap == dcp->thermal_min_cap;
+
+	if (same && dcp->xdr_gen == gen)
+		return;
+	if (same)
+		dcp_m4_xdr_rearm(&dcp->xdr, READ_ONCE(panel_xdr));
+	else
+		dcp_m4_xdr_init(&dcp->xdr, dcp_m4_pf->brightness_max, dcp->boost_max,
+				dcp->thermal_min_cap, READ_ONCE(panel_xdr));
+	dcp->xdr_gen = gen;
+	dcp->xdr_ready = true;
+	dev_info(dcp->dev, "XDR guard %s: user maximum %u, aurora maximum %u, first rung %u, thermal minimum %u nits (panel_xdr)\n",
+		 dcp_m4_xdr_state_name(dcp->xdr.state), dcp->xdr.user_max, dcp->xdr.top,
+		 dcp_m4_xdr_cap(&dcp->xdr), dcp->xdr.min_cap);
+}
+
+/* Under dcp->lock: after a swap that asked for @asked nits (0: none). */
+static void iomfb_m4_xdr_after(struct iomfb_m4 *dcp, u32 asked, bool ok, bool shown, u32 us)
+{
+	dcp->xdr_last_us = us;
+	if (asked > dcp->xdr.user_max)
+		dcp->xdr_asked = asked;
+	if (!dcp_m4_xdr_swap(&dcp->xdr, asked, ok, shown, us))
+		return;
+	if (dcp->xdr.state == DCP_M4_XDR_REFUSED)
+		dev_warn(dcp->dev, "XDR: the firmware did not take %u nits (%s, %u us): panel levels held at %u nits (panel_xdr)\n",
+			 asked, dcp_m4_xdr_reason_name(dcp->xdr.reason), us, dcp->xdr.taken);
+	else
+		dev_info(dcp->dev, "XDR: %u nits taken, panel levels now up to %u nits%s (panel_xdr)\n",
+			 dcp->xdr.taken, dcp_m4_xdr_cap(&dcp->xdr),
+			 dcp->xdr.state == DCP_M4_XDR_TRUSTED ? ", the aurora maximum" : "");
+}
+
 static int iomfb_m4_swap(struct iomfb_m4 *dcp, const struct dcp_m4_frame *frame)
 {
 	struct dcp_backlight_present present = {};
 	struct dcp_m4_edr_words words;
 	int prepared = -ENODATA, ret;
-	u32 ceiling = iomfb_m4_boost_ceiling(dcp), sdr;
-	bool carries, level = false;
+	u32 ceiling = iomfb_m4_boost_ceiling(dcp), sdr, limit, below, key, asked = 0, us;
+	bool carries, level = false, shown;
+	ktime_t start;
 
 	lockdep_assert_held(&dcp->lock);
 	if (dcp_backlight_active(dcp->owner))
@@ -3890,24 +4036,47 @@ static int iomfb_m4_swap(struct iomfb_m4 *dcp, const struct dcp_m4_frame *frame)
 	 * EDR takes SDR white from here. A blank carries no EDR words; the ramp
 	 * after it starts again from 1.0, as macOS's.
 	 */
+	/*
+	 * The XDR guard bounds every level asked for (dcp-m4-xdr.h): a raised
+	 * ceiling, the EDR highlights and, under thermal mitigation, SDR white
+	 * too. A new bound re-sends the standing level as a new ceiling does.
+	 */
+	iomfb_m4_xdr_sync(dcp);
+	limit = dcp_m4_xdr_limit(&dcp->xdr, READ_ONCE(dcp->thermal_state));
+	if (ceiling > limit)
+		ceiling = limit > dcp_m4_pf->brightness_max ? limit : 0;
+	below = limit < dcp_m4_pf->brightness_max ? limit : 0;
+	key = ceiling ?: below;
 	sdr = dcp_m4_boost_level(present.nits, dcp_m4_pf->brightness_max, ceiling);
-	carries = !prepared || (frame && present.nits && ceiling != dcp->boost_sent);
-	if (frame && carries && sdr && (ceiling || dcp->boost_sent)) {
+	if (below && sdr > below)
+		sdr = below;
+	carries = !prepared || (frame && present.nits && key != dcp->boost_sent);
+	if (frame && carries && sdr && (key || dcp->boost_sent)) {
 		dcp->runtime->level = sdr;
 		level = true;
+		asked = sdr;
 	}
 	if (frame && dcp->edr_capable &&
 	    dcp_m4_edr_step(&dcp->edr, frame->pq, carries, sdr,
-			    dcp->panel_peak, dcp->edr_ceiling, &words))
+			    min(dcp->panel_peak, limit), dcp->edr_ceiling, &words)) {
+		words.limit = min_t(u64, words.limit, (u64)limit * 10);
 		dcp->runtime->edr = &words;
+		asked = max(asked, words.nits);
+	}
 	if (!frame)
 		dcp->edr.restart = true;
+	dcp->runtime->int_shown_valid = false;
+	start = ktime_get();
 	ret = dcp_m4_runtime_swap_brightness(dcp->runtime, frame,
 					    !prepared && !level, present.nits);
+	us = min_t(s64, ktime_us_delta(ktime_get(), start), U32_MAX);
+	shown = !dcp->runtime->int_shown_valid || dcp->runtime->int_shown;
+	if (frame)
+		iomfb_m4_xdr_after(dcp, asked, !ret, shown, us);
 	if (dcp->runtime->edr && !ret)
 		dcp->edr_swaps++;
 	if (level && !ret)
-		dcp->boost_sent = ceiling;
+		dcp->boost_sent = key;
 	dcp->runtime->edr = NULL;
 	dcp->runtime->level = 0;
 	if (!prepared)
@@ -6342,6 +6511,14 @@ static int iomfb_m4_status_show(struct seq_file *s, void *unused)
 		seq_printf(s, "boost max=%u want=%u ceiling=%u sent=%u\n", dcp->boost_max,
 			   READ_ONCE(panel_boost_nits), iomfb_m4_boost_ceiling(dcp),
 			   dcp->boost_sent);
+	if (!dcp->external && dcp->xdr_ready)
+		seq_printf(s, "xdr state=%s cap=%u limit=%u taken=%u trying=%u good=%u bad=%u reverts=%u reason=%s shown_seen=%u thermal=%u/%u min_cap=%u asked=%u last_us=%u\n",
+			   dcp_m4_xdr_state_name(dcp->xdr.state), dcp_m4_xdr_cap(&dcp->xdr),
+			   dcp_m4_xdr_limit(&dcp->xdr, READ_ONCE(dcp->thermal_state)),
+			   dcp->xdr.taken, dcp->xdr.trying, dcp->xdr.good, dcp->xdr.bad,
+			   dcp->xdr.reverts, dcp_m4_xdr_reason_name(dcp->xdr.reason),
+			   dcp->xdr.shown_seen, READ_ONCE(dcp->thermal_state), dcp->thermal_max,
+			   dcp->xdr.min_cap, dcp->xdr_asked, dcp->xdr_last_us);
 	if (READ_ONCE(panel_vrr_min_hz))
 		seq_printf(s, "vrr min_hz=%u min_sent=%#x calls=%llu status=%#x\n",
 			   READ_ONCE(panel_vrr_min_hz), dcp->vrr_min_sent, dcp->vrr_calls,
