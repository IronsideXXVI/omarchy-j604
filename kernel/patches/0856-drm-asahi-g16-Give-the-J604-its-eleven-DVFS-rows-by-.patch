From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 23:13:36 +0000
Subject: [PATCH] drm/asahi: g16: Give the J604 its eleven DVFS rows by
 default

With g16_j604_rows11=1 the J604 runs on the eleven firmware rows its
own ADT describes, as macOS 26B123 does, instead of the J713's ten.
The ten-row layout leaves out ADT state 4 (928 MHz at 725 mV), so the
firmware's row numbers name one row lower than the host's: the top
state the host asks for runs at 1470 MHz and 970 mV rather than at
1578 MHz, which macOS reaches at 1.031 V under the same loads.

Make eleven rows the default. The switch is only read on the J604, so
other boards are unchanged, and g16_j604_rows11=0 on the kernel
command line (aurora.g16_j604_rows11=0) restores the ten rows.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/asahi_core.rs | 4 ++--
 drivers/gpu/drm/asahi/g16/params.rs | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/asahi_core.rs b/drivers/gpu/drm/asahi/asahi_core.rs
index 8a074977e2..577a9efedc 100644
--- a/drivers/gpu/drm/asahi/asahi_core.rs
+++ b/drivers/gpu/drm/asahi/asahi_core.rs
@@ -264,8 +264,8 @@ fn init(module: &'static kernel::ThisModule) -> impl PinInit<Self, Error> {
             description: "G16: completion repoll interval, us",
         },
         g16_j604_rows11: u32 {
-            default: 0,
-            description: "G16: J604 with eleven DVFS rows, ADT state 4 kept (default 0)",
+            default: 1,
+            description: "G16: J604 eleven DVFS rows, ADT state 4 kept (default 1; 0: ten rows)",
         },
         g16_main_macos: u32 {
             default: 0,
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index da5ab02c95..30e39137cb 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -2069,7 +2069,8 @@ pub(crate) fn j604_main() -> bool {
 }
 
 /// Whether the J604 takes eleven firmware rows from its sixteen ADT states, keeping state 4
-/// (`g16_j604_rows11`, load time). Its ADT has eleven distinct voltage rows, which macOS uses.
+/// (`g16_j604_rows11`, load time, on by default). Its ADT has eleven distinct voltage rows,
+/// which macOS uses; 0 restores the ten rows. Other boards ignore it.
 pub(crate) fn j604_rows11() -> bool {
     module_parameters::g16_j604_rows11.value() != 0
 }
