From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bartosz Nitka <niteria@gmail.com>
Date: Mon, 9 Nov 2026 11:34:50 +0100
Subject: [PATCH] dt-bindings: rtc: apple,j700-pmu-rtc: add the T8132
 PMU RTC

T8132's PMU RTC has the register layout of T6041's, so it takes that as
a fallback compatible.

Assisted-by: LLM
Signed-off-by: Bartosz Nitka <niteria@gmail.com>
(cherry picked from commit 32410856209475e6fae57401e984aed7c6437711)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../bindings/rtc/apple,j700-pmu-rtc.yaml           | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/rtc/apple,j700-pmu-rtc.yaml b/Documentation/devicetree/bindings/rtc/apple,j700-pmu-rtc.yaml
index 82fec739c7..210c0df2a7 100644
--- a/Documentation/devicetree/bindings/rtc/apple,j700-pmu-rtc.yaml
+++ b/Documentation/devicetree/bindings/rtc/apple,j700-pmu-rtc.yaml
@@ -21,11 +21,15 @@ allOf:
 
 properties:
   compatible:
-    enum:
-      - apple,j700-pmu-rtc
-      - apple,t6000-pmu-rtc
-      - apple,t6041-pmu-rtc
-      - apple,t8112-pmu-rtc
+    oneOf:
+      - enum:
+          - apple,j700-pmu-rtc
+          - apple,t6000-pmu-rtc
+          - apple,t6041-pmu-rtc
+          - apple,t8112-pmu-rtc
+      - items:
+          - const: apple,t8132-pmu-rtc
+          - const: apple,t6041-pmu-rtc
 
   interrupts:
     maxItems: 1
-- 
2.43.0

