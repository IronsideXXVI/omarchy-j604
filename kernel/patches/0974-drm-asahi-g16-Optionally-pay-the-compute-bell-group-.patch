 drivers/gpu/drm/asahi/g16/compute_bell.rs | 167 +++++++++++++++++++---
 drivers/gpu/drm/asahi/g16/engine.rs       |  30 +++-
 drivers/gpu/drm/asahi/g16/params.rs       |  21 +++
 drivers/gpu/drm/asahi/g16/poll.rs         |   8 ++
