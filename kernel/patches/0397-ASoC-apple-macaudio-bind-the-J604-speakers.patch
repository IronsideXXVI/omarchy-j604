From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 03:07:40 +0000
Subject: [PATCH] ASoC: apple: macaudio: bind the J604 speakers

The J604 (MacBook Pro 14" M4) has the J614s's six SN012776 amps, slots
and frame. The boot loader copies each amp's ADT speaker-config row.
Its speakers were kept off with a configuration of their own: no link
bound, waiting for a protection profile.

The J604 has one now. speakersafetyd's J604 profile is made from the
J604's own amp dump and Apple's J604 limits, and it unlocks the speaker
volumes on this Mac. With the card bound as on the J616s, the J604 has
played through its speakers since kernel 1.617.

Bind them as the J614s was bound: enable the speaker card and its six
amps in the J604 tree, and the speakers in macaudio_j604_cfg with the
J616s's tweeter corner grant. Playback still waits for the protection
interface (macaudio_spk_admitted()): speakersafetyd's unlock, or a
speakerguardd v2 lease. Without either, the amps stay at the floor.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 12 +++---------
 sound/soc/apple/macaudio.c               | 13 ++++++++-----
 2 files changed, 11 insertions(+), 14 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 0dbb38584d..b312234a00 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -39,8 +39,9 @@ chosen {
 	 * the ADT amp-tx-zd-config rows 0 and 1: LW1 drives zeros in the right
 	 * amps' sense slots, RW1 in the left amps'.
 	 *
-	 * The speakers wait for their own bring-up and a J604 protection
-	 * profile; until then the card and the amps stay disabled.
+	 * Playback waits for the protection interface: speakersafetyd's J604
+	 * profile unlocks it, or a speakerguardd v2 lease; until then the amps
+	 * stay at the kernel's floor.
 	 */
 	sound: sound {
 		compatible = "apple,j604-macaudio", "apple,macaudio";
@@ -50,7 +51,6 @@ sound: sound {
 				   <&pinctrl_ap 13 GPIO_ACTIVE_HIGH>;
 		#address-cells = <1>;
 		#size-cells = <0>;
-		status = "disabled";
 
 		dai-link@0 {
 			reg = <0>;
@@ -128,7 +128,6 @@ speaker_left_woof1: codec@38 {
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <0>;
 		ti,vmon-slot-no = <2>;
-		status = "disabled";
 	};
 
 	speaker_left_woof2: codec@39 {
@@ -142,7 +141,6 @@ speaker_left_woof2: codec@39 {
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <8>;
 		ti,vmon-slot-no = <10>;
-		status = "disabled";
 	};
 
 	speaker_left_tweet: codec@3a {
@@ -156,7 +154,6 @@ speaker_left_tweet: codec@3a {
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <16>;
 		ti,vmon-slot-no = <18>;
-		status = "disabled";
 	};
 
 	speaker_right_woof1: codec@3b {
@@ -170,7 +167,6 @@ speaker_right_woof1: codec@3b {
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <4>;
 		ti,vmon-slot-no = <6>;
-		status = "disabled";
 	};
 
 	speaker_right_woof2: codec@3c {
@@ -184,7 +180,6 @@ speaker_right_woof2: codec@3c {
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <12>;
 		ti,vmon-slot-no = <14>;
-		status = "disabled";
 	};
 
 	speaker_right_tweet: codec@3d {
@@ -198,7 +193,6 @@ speaker_right_tweet: codec@3d {
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <20>;
 		ti,vmon-slot-no = <22>;
-		status = "disabled";
 	};
 };
 
diff --git a/sound/soc/apple/macaudio.c b/sound/soc/apple/macaudio.c
index 4f9c8eeaab..7a8fa29a60 100644
--- a/sound/soc/apple/macaudio.c
+++ b/sound/soc/apple/macaudio.c
@@ -4209,11 +4209,12 @@ struct macaudio_platform_cfg macaudio_j614_cfg = {
 
 /*
  * J604 (T8132, MacBook Pro 14" M4): the J614s's amps, frame and chassis,
- * but its speakers have not been brought up. Keep them off entirely: the
- * speaker link is not bound, so no stream ever reaches the amps.
+ * bound as on the J616s, with the J616s's tweeter corner grant. Playback
+ * still waits for the protection interface (macaudio_spk_admitted()):
+ * speakersafetyd's J604 profile unlocks it, or a speakerguardd v2 lease.
  */
 struct macaudio_platform_cfg macaudio_j604_cfg = {
-	.enable_speakers = false,
+	.enable_speakers = true,
 	.amp = AMP_SN012776,
 	.speakers = SPKR_2W1T,
 	.stereo = true,
@@ -4224,6 +4225,8 @@ struct macaudio_platform_cfg macaudio_j604_cfg = {
 	.secondary_bclk_ratio = 250,
 	.fe_cpu_is_platform = true,
 	.route_only_fes = BIT(0),
+	/* Granted, the tweeters restore their DT corner, as on the J616s */
+	.tweeter_hpf_granted = true,
 };
 
 /*
@@ -4391,8 +4394,8 @@ static const struct of_device_id macaudio_snd_device_id[]  = {
 	{ .compatible = "apple,j575c-macaudio-jack", .data = &macaudio_j616_jack_cfg },
 	/* j613    AID20   sn012776    15      2x 1W+1T Compat: apple,j413-macaudio */
 	/* j615    AID21   sn012776    15      2x 2W+1T Compat: apple,j415-macaudio */
-	/* j604    AID30   sn012776    15      2x 2W+1T (AOP-fed, the J616s layout) */
-	{ .compatible = "apple,j604-macaudio", .data = &macaudio_j616_cfg },
+	/* j604    -       sn012776    15      2x 2W+1T (AOP-fed, the J616s layout) */
+	{ .compatible = "apple,j604-macaudio", .data = &macaudio_j604_cfg },
 	/* j604    AID30   cs42l84     -       the jack, a card of its own (AOP-fed) */
 	{ .compatible = "apple,j604-macaudio-jack", .data = &macaudio_j616_jack_cfg },
 	/* j614    AID34   sn012776    15      2x 2W+1T (AOP-fed; speakers off until bring-up) */
-- 
2.43.0

