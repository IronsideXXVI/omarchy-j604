From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 16:54:14 +0000
Subject: [PATCH] media: apple: avd: rest the decoder 10 s after a
 reset storm, not the whole window

A third decoder reset within AVD_STORM_WINDOW (60 s) parked the decoder
until that window ended, up to about 60 s after the first reset. The
park is global by necessity: the AVD is one block behind one firmware
and one inbox, a frame that times out leaves the block without a
completion, and the only way back for any client is avd_pm_recover(),
which stops the firmware, blocks DMA and resets the whole block (the
reset is what the budget rations: three hard hangs on the J616s followed
timeouts and resets). But the length of the park is a choice, and one
broken stream kept hardware decode off for every codec and client for
most of a minute.

Park for AVD_REST (10 s), at most until the window ends. Keep the storm
count until the window ends, so a block that fails again after waking
parks again at once instead of being recovered: recoveries of a failed
block stay at most AVD_STORM_MAX per window, as before. What the shorter
rest adds is wake resets of a parked block (DMA blocked, firmware
stopped), at most one per AVD_REST, and only while a client keeps
sending frames.

The recovery and dispatch host tests check the rest length, the end at
the window, and that a failure after a wake inside the window parks
without a reset.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/avd/avd-queue.c   | 18 ++++++++++++++----
 .../platform/apple/avd/tests/dispatch-test.py  |  3 ++-
 .../platform/apple/avd/tests/recovery-test.py  |  9 +++++++++
 3 files changed, 25 insertions(+), 5 deletions(-)

diff --git a/drivers/media/platform/apple/avd/avd-queue.c b/drivers/media/platform/apple/avd/avd-queue.c
index f62daee59f..1848cf780b 100644
--- a/drivers/media/platform/apple/avd/avd-queue.c
+++ b/drivers/media/platform/apple/avd/avd-queue.c
@@ -18,9 +18,15 @@
 #define AVD_CTX_MAX_HW_ERRORS 1
 /* Never reset the decoder more often than this. */
 #define AVD_RECOVER_GAP_MS 20
-/* A third recovery parks the decoder until AVD_STORM_WINDOW ends. */
+/*
+ * A third recovery within AVD_STORM_WINDOW parks the decoder for AVD_REST
+ * (at most until the window ends); every further reset in that window parks
+ * it again at once instead of recovering, so the window still bounds the
+ * recoveries.
+ */
 #define AVD_STORM_MAX 2
 #define AVD_STORM_WINDOW msecs_to_jiffies(60000)
+#define AVD_REST msecs_to_jiffies(10000)
 #define AVD_RETRY_DELAY msecs_to_jiffies(1)
 #define AVD_PROGRAM_SIZE SZ_2M
 
@@ -134,7 +140,7 @@ static void avd_reset_queue(struct avd_dev *avd, int status)
 	 * on the J616s followed timeouts and resets), so recover sparingly:
 	 * at least AVD_RECOVER_GAP_MS apart, at most AVD_STORM_MAX times in
 	 * AVD_STORM_WINDOW, and never again after a recovery fails. Exhausting
-	 * the budget parks DMA until the window ends; only a failed recovery
+	 * the budget parks DMA for AVD_REST; only a failed recovery
 	 * retires the decoder until the module is reloaded.
 	 */
 	if (avd->faulted) {
@@ -148,7 +154,11 @@ static void avd_reset_queue(struct avd_dev *avd, int status)
 		if (++avd->storm_count > AVD_STORM_MAX) {
 			ret = avd_pm_park(avd);
 			if (!ret) {
-				avd->rest_until = avd->storm_start + AVD_STORM_WINDOW;
+				unsigned long until = avd->storm_start + AVD_STORM_WINDOW;
+
+				if (time_before(jiffies + AVD_REST, until))
+					until = jiffies + AVD_REST;
+				avd->rest_until = until ?: 1;
 				dev_warn(avd->dev, "decoder resting after repeated resets, new frames fail for up to %u s\n",
 					 jiffies_to_msecs(avd->rest_until - jiffies) / 1000 + 1);
 				ret = -EBUSY;
@@ -439,8 +449,8 @@ static void avd_queue_submit_work(struct work_struct *work)
 			dev_err(avd->dev, "decoder retired after a failed wake (%d)\n", ret);
 			goto fail;
 		}
+		/* storm_count stays until the window ends: a new reset rests again */
 		avd->rest_until = 0;
-		avd->storm_count = 0;
 		avd_pm_enable_irq(avd);
 	}
 	memset(f->cmd, 0, sizeof(f->cmd));
diff --git a/drivers/media/platform/apple/avd/tests/dispatch-test.py b/drivers/media/platform/apple/avd/tests/dispatch-test.py
index 4a46a45e14..e104c62b9f 100755
--- a/drivers/media/platform/apple/avd/tests/dispatch-test.py
+++ b/drivers/media/platform/apple/avd/tests/dispatch-test.py
@@ -283,7 +283,8 @@ int main(void) {
  assert(!running&&!d.inflight&&!pm_refs&&wakes==old_wakes&&src[17].done&&dst[17].done);
  jiffies=d.rest_until;d.storm_count=3;c[0].broken=false;
  m[0].src=&src[18];m[0].dst=&dst[18];submit(&c[0]);
- assert(!running&&wakes==old_wakes+1&&irq_enables==1&&!d.rest_until&&!d.storm_count);
+ /* The storm count stays until its window ends: a new reset rests again. */
+ assert(!running&&wakes==old_wakes+1&&irq_enables==1&&!d.rest_until&&d.storm_count==3);
  complete(&d,&c[0],0);assert(!pm_refs);
  /* A failed wake retires the decoder and never opens IRQs or posts a frame. */
  d.rest_until=jiffies;wake_error=-EIO;m[0].src=&src[19];m[0].dst=&dst[19];
diff --git a/drivers/media/platform/apple/avd/tests/recovery-test.py b/drivers/media/platform/apple/avd/tests/recovery-test.py
index 03e78d3185..9570e27b05 100755
--- a/drivers/media/platform/apple/avd/tests/recovery-test.py
+++ b/drivers/media/platform/apple/avd/tests/recovery-test.py
@@ -24,6 +24,7 @@ PRELUDE = r'''
 #define AVD_RECOVER_GAP_MS 20
 #define AVD_STORM_MAX 2
 #define AVD_STORM_WINDOW 60000
+#define AVD_REST 10000
 #define AVD_QUIRK_NO_RECOVERY_RESET (1u << 5)
 #define msecs_to_jiffies(x) (x)
 #define jiffies_to_msecs(x) ((unsigned int)(x))
@@ -128,12 +129,20 @@ int main(void) {
  assert(attached==d.empty_domain&&!d.pm.irq_enabled);
  init();avd_reset_queue(&d,-EIO);avd_reset_queue(&d,-EIO);avd_reset_queue(&d,-EIO);
  assert(resets==2&&boots==2&&attaches==3&&detaches==2&&!d.faulted&&d.rest_until);
+ /* The rest is AVD_REST long, not the rest of the storm window. */
+ assert(d.rest_until==jiffies+AVD_REST&&d.storm_count==3);
  assert(d.pm.dma_parked&&attached==d.empty_domain&&!d.pm.irq_enabled);
  unsigned int old_boots=boots,old_resets=resets;
  assert(!avd_pm_power_off(&d)&&!avd_pm_power_on(&d));
  assert(boots==old_boots&&resets==old_resets&&!resubmits&&!d.pm.irq_enabled);
  /* The expiry path (dispatch-test) calls recover under a PM reference. */
  jiffies=d.rest_until;assert(!avd_pm_recover(&d));assert(resets==3&&!d.pm.dma_parked);
+ /* Woken inside the window, a further failure parks again without a reset. */
+ d.rest_until=0;avd_reset_queue(&d,-EIO);
+ assert(resets==3&&d.pm.dma_parked&&d.rest_until==jiffies+AVD_REST&&!d.faulted);
+ /* Near the window's end the rest stops with the window. */
+ jiffies=d.storm_start+AVD_STORM_WINDOW-5;d.rest_until=0;avd_reset_queue(&d,-EIO);
+ assert(resets==3&&d.rest_until==d.storm_start+AVD_STORM_WINDOW);
  init();attach_error=-EIO;assert(avd_pm_recover(&d)==-EIO);assert(!resets&&!boots&&!detaches);
  init();d.pm.dart_active=false;assert(avd_pm_park(&d)==-EHOSTDOWN);assert(!shutdowns&&!resets&&!attaches);
  puts("PASS: production recovery/PM: park before reset, failed reset/boot stays blocked, budget rests, parked resume never boots, expiry recovery");
