From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Mon, 16 Nov 2026 18:01:19 +0000
Subject: [PATCH] drm/asahi: g16: Show the firmware's idle delay and
 its policy words

After its idle event the firmware does not power the GPU down at
once: its idle handler waits a delay taken from a word in its own
data (VA 0x192e68, times 1000) and drops the power-down if the host
rang a doorbell meanwhile. Whether the GPU powers down between
commands it already holds depends on that delay, and the host sets the
power-off policy words in Globals it is derived from.

Add both to aurora-g16/fwpower: `dly`, the firmware's delay word, read
through the existing read-only view of its data segment, and `gpol`,
the Globals words +0x9b8, +0x9bc and +0x9c0 as the firmware sees them.
Nothing is written.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/poll.rs | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/poll.rs b/drivers/gpu/drm/asahi/g16/poll.rs
index 15646fb798..4e26d11441 100644
--- a/drivers/gpu/drm/asahi/g16/poll.rs
+++ b/drivers/gpu/drm/asahi/g16/poll.rs
@@ -157,7 +157,9 @@ pub(crate) struct FwPower {
 /// share is measured. `rx`: the producer indices of the event ring, the nine log sub-rings
 /// (summed), ktrace and statistics; any of them moving at idle means the firmware writes records.
 /// `psreq`: the PMP's SOC-DEV-PS-REQ / PS-ACK words (T8132; GFX is bit 12), all ones where there
-/// is no such report.
+/// is no such report. `dly`: the firmware's idle-delay word (VA 0x192e68; its idle handler
+/// waits this x 1000 between the idle event and the power-down), and `gpol` the Globals
+/// power-off policy words +0x9b8 / +0x9bc / +0x9c0 the host wrote.
 fn fwpower_show(v: &FwPower, f: &mut fmt::Formatter<'_>) -> fmt::Result {
     let [pp, power, control, globals] = &v.objects;
     let r = |o: &FwObject, at: usize| o.r32(at).unwrap_or(0xdead_beef);
@@ -202,7 +204,7 @@ fn fwpower_show(v: &FwPower, f: &mut fmt::Formatter<'_>) -> fmt::Result {
          ctl {:#x}/{:#x}/{:#x}/{:#x}/{:#x} g {}/{}/{}/{}/{} rings {:#x} \
          fw {:#x}/{:#x}/{:#x}/{:#x} st {:#x} ipo {:#x} q {:#x}/{:#x} \
          floor {}/{} cap {}/{} ps {:#x} cpu {:#x} rx {}/{}/{}/{} \
-         psreq {:#x}/{:#x}",
+         psreq {:#x}/{:#x} dly {:#x} gpol {}/{}/{}",
         counter_ticks(),
         r(pp, 0x10),
         r(pp, 0xc),
@@ -249,7 +251,11 @@ fn fwpower_show(v: &FwPower, f: &mut fmt::Formatter<'_>) -> fmt::Result {
         produced(rx_trace, 0),
         produced(rx_stats, 0),
         req,
-        ack
+        ack,
+        p(0x19_2e68) & 0xffff_ffff,
+        r(globals, 0x9b8),
+        r(globals, 0x9bc),
+        r(globals, 0x9c0)
     )
 }
 
