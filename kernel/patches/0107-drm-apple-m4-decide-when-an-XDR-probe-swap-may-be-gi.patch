From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 20:18:48 +0000
Subject: [PATCH] drm/apple: m4: decide when an XDR probe swap may be
 given up

The XDR guard asks the internal panel for a level above the one taken
only as a probe. Today a probe the 26.6.2 firmware refuses (A407
answered with an error status) or leaves without its D590 fails the
whole DCP session: the panel stays black until a reboot.

Add the pure part of a recovery, for the KUnit suite: which ending of
a swap may be given up with the session kept (a probe only, nothing
else outstanding, A407 refused or answered with no D590 by the
deadline), and a two-slot list of given-up swap IDs so that a late
D590 is dropped instead of being taken for the swap in flight. Any
other failure, and every failure of an ordinary swap, still fails the
session. Seven new KUnit cases.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
(cherry picked from commit adf3ca6ceafb5ba8a06dd276c2b14eb03725a8a6)
(cherry picked from commit 71334bf54ca3e9cac0b91064909154810e97282d)
---
 drivers/gpu/drm/apple/dcp-m4-xdr-test.c | 151 +++++++++++++++++++++++-
 drivers/gpu/drm/apple/dcp-m4-xdr.h      | 107 ++++++++++++++++-
 2 files changed, 255 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-m4-xdr-test.c b/drivers/gpu/drm/apple/dcp-m4-xdr-test.c
index fcbe3d0705..0cc7eeb3fe 100644
--- a/drivers/gpu/drm/apple/dcp-m4-xdr-test.c
+++ b/drivers/gpu/drm/apple/dcp-m4-xdr-test.c
@@ -4,7 +4,8 @@
  * The XDR guard (dcp-m4-xdr.h) with the J604's ADT values: a 600 nit user
  * maximum, the 1000 nit aurora maximum and a 300 nit thermal minimum cap.
  * The ladder, what a stalled, hidden or failed swap does, that ordinary
- * swaps never move it, the thermal cap and starting over.
+ * swaps never move it, the thermal cap and starting over; which internal
+ * swaps are given up with the session kept, and their late D590s.
  */
 
 #include <kunit/test.h>
@@ -255,6 +256,147 @@ static void xdr_names(struct kunit *test)
 	KUNIT_EXPECT_STREQ(test, dcp_m4_xdr_reason_name(DCP_M4_XDR_NONE), "none");
 }
 
+/* A probe answered by A407, its D590 not in by the deadline. */
+static struct dcp_m4_xdr_end stalled(u32 id)
+{
+	return (struct dcp_m4_xdr_end){ .id = id, .error = -ETIMEDOUT, .probe = true,
+					.quiet = true, .replied = true };
+}
+
+/* A probe whose A407 came back with an error status. */
+static struct dcp_m4_xdr_end refused(u32 id)
+{
+	return (struct dcp_m4_xdr_end){ .id = id, .error = -EPROTO, .probe = true,
+					.quiet = true, .refused = true };
+}
+
+static void xdr_give_up_stalled_probe(struct kunit *test)
+{
+	struct dcp_m4_xdr_lost l = {};
+	struct dcp_m4_xdr_end e = stalled(41);
+
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_STALLED);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_lost_add(&l, 41));
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_lost_find(&l, 41), 0);
+	KUNIT_EXPECT_EQ(test, l.given_up, 1U);
+	/* Its late D590 is dropped once, then the ID is free again. */
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_lost_drop(&l, 41));
+	KUNIT_EXPECT_EQ(test, l.late, 1U);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_lost_drop(&l, 41));
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_lost_find(&l, 41), -1);
+	KUNIT_EXPECT_EQ(test, l.late, 1U);
+}
+
+static void xdr_give_up_refused_probe(struct kunit *test)
+{
+	struct dcp_m4_xdr_lost l = {};
+	struct dcp_m4_xdr_end e = refused(42);
+
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_REFUSED);
+	/* Refused is an A407 error status: neither answered with 0 nor another error. */
+	e.replied = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	e = refused(42);
+	e.error = -EMSGSIZE;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+}
+
+/* An ordinary swap (no level above the one taken) is never given up. */
+static void xdr_give_up_ordinary_swap_fails(struct kunit *test)
+{
+	struct dcp_m4_xdr_lost l = {};
+	struct dcp_m4_xdr_end e = stalled(43);
+
+	e.probe = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	e = refused(43);
+	e.probe = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+}
+
+/* Only with nothing else outstanding, and only for what the probe itself did. */
+static void xdr_give_up_needs_a_quiet_session(struct kunit *test)
+{
+	struct dcp_m4_xdr_lost l = {};
+	struct dcp_m4_xdr_end e = stalled(44);
+
+	e.quiet = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	e = stalled(44);
+	e.completed = true;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	e = stalled(0);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	/* A407 itself unanswered (no reply, no status): not given up. */
+	e = stalled(44);
+	e.replied = false;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	/* Any other error of the probe: the session fails. */
+	e = stalled(44);
+	e.error = -EIO;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	e.error = -EPROTO;
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+}
+
+static void xdr_give_up_slots(struct kunit *test)
+{
+	struct dcp_m4_xdr_lost l = {};
+	struct dcp_m4_xdr_end e;
+
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_lost_add(&l, 51));
+	/* The same ID again: its first D590 could not be told apart. */
+	e = stalled(51);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_lost_add(&l, 52));
+	/* Every slot taken: not given up. */
+	e = refused(53);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_NONE);
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_lost_add(&l, 53));
+	KUNIT_EXPECT_EQ(test, l.given_up, 2U);
+	/* A late D590 frees its slot. */
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_lost_drop(&l, 51));
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_REFUSED);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_lost_add(&l, 53));
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_lost_find(&l, 53), 0);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_lost_find(&l, 52), 1);
+}
+
+static void xdr_lost_ids(struct kunit *test)
+{
+	struct dcp_m4_xdr_lost l = {};
+
+	/* ID 0 is never kept nor dropped (it marks a free slot). */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_lost_add(&l, 0));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_lost_drop(&l, 0));
+	/* A D590 of a swap never given up is not dropped. */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_lost_drop(&l, 77));
+	KUNIT_EXPECT_EQ(test, l.given_up, 0U);
+	KUNIT_EXPECT_EQ(test, l.late, 0U);
+	KUNIT_EXPECT_STREQ(test, dcp_m4_xdr_give_up_name(DCP_M4_XDR_KEEP_REFUSED), "refused");
+	KUNIT_EXPECT_STREQ(test, dcp_m4_xdr_give_up_name(DCP_M4_XDR_KEEP_STALLED),
+			   "left without its D590");
+	KUNIT_EXPECT_STREQ(test, dcp_m4_xdr_give_up_name(DCP_M4_XDR_KEEP_NONE), "none");
+}
+
+/* A probe given up: the guard refuses, levels back to the one taken, once. */
+static void xdr_give_up_reverts_the_guard(struct kunit *test)
+{
+	struct dcp_m4_xdr x;
+	struct dcp_m4_xdr_lost l = {};
+	struct dcp_m4_xdr_end e = stalled(61);
+
+	j604(&x);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_give_up(&l, &e), DCP_M4_XDR_KEEP_STALLED);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_xdr_swap(&x, 800, false, true, FAST));
+	KUNIT_EXPECT_EQ(test, x.state, DCP_M4_XDR_REFUSED);
+	KUNIT_EXPECT_EQ(test, dcp_m4_xdr_cap(&x), USER);
+	KUNIT_EXPECT_EQ(test, x.reverts, 1U);
+	/* The next swap asks no more than the level taken: no probe, no change. */
+	KUNIT_EXPECT_FALSE(test, dcp_m4_xdr_swap(&x, USER, true, true, FAST));
+	KUNIT_EXPECT_EQ(test, x.reverts, 1U);
+}
+
 static struct kunit_case m4_xdr_cases[] = {
 	KUNIT_CASE(xdr_off),
 	KUNIT_CASE(xdr_climbs_the_ladder),
@@ -268,6 +410,13 @@ static struct kunit_case m4_xdr_cases[] = {
 	KUNIT_CASE(xdr_thermal_cap),
 	KUNIT_CASE(xdr_rearm),
 	KUNIT_CASE(xdr_names),
+	KUNIT_CASE(xdr_give_up_stalled_probe),
+	KUNIT_CASE(xdr_give_up_refused_probe),
+	KUNIT_CASE(xdr_give_up_ordinary_swap_fails),
+	KUNIT_CASE(xdr_give_up_needs_a_quiet_session),
+	KUNIT_CASE(xdr_give_up_slots),
+	KUNIT_CASE(xdr_lost_ids),
+	KUNIT_CASE(xdr_give_up_reverts_the_guard),
 	{}
 };
 
diff --git a/drivers/gpu/drm/apple/dcp-m4-xdr.h b/drivers/gpu/drm/apple/dcp-m4-xdr.h
index 4348cb63a6..23ca184570 100644
--- a/drivers/gpu/drm/apple/dcp-m4-xdr.h
+++ b/drivers/gpu/drm/apple/dcp-m4-xdr.h
@@ -5,8 +5,7 @@
  * The panel takes levels above the user maximum (600 nits on the J604):
  * EDR highlights and a raised SDR ceiling in bright surroundings, up to the
  * ADT aurora maximum (1000 nits, what macOS sustains).  Whether the 26.6.2
- * firmware takes such a level in a swap has not been measured; a swap it
- * refuses fails the session (black panel until a reboot).  So a level above
+ * firmware takes such a level in a swap has not been measured.  So a level above
  * the user maximum is asked for only as far as the firmware has been seen to
  * take one, up a ladder of rungs of DCP_M4_XDR_STEP_NITS:
  *
@@ -23,11 +22,17 @@
  * DCP_M4_XDR_THERMAL_STEP per cooling state and never below the ADT
  * thermal-mitigation-min-cap (300 nits on the J604), as macOS does.
  *
+ * A swap asking for a level above the one taken (a probe) that the firmware
+ * refuses or leaves without its D590 is given up without ending the session
+ * (dcp_m4_xdr_give_up() below): the guard refuses and the panel goes back to
+ * the level taken, as for any failed probe.
+ *
  * Pure functions, for the KUnit suite.
  */
 #ifndef APPLE_DCP_M4_XDR_H
 #define APPLE_DCP_M4_XDR_H
 
+#include <linux/errno.h>
 #include <linux/math.h>
 #include <linux/minmax.h>
 #include <linux/types.h>
@@ -215,4 +220,102 @@ refused:
 	return true;
 }
 
+/*
+ * Giving up an internal probe swap.  A swap that asks for a level above the
+ * one taken while the guard ramps, and that the firmware refuses (A407
+ * answered with an error status) or leaves without its D590 until the swap's
+ * deadline (A407 answered), is given up without ending the session, as
+ * dcpext gives up a swap whose D590 is missing: the guard refuses, every
+ * level goes back to the level taken and the next present re-sends the
+ * standing one.  Only when nothing else of it is outstanding (no session or
+ * transaction error, no call or callback open, the swap not completed) and
+ * with a slot free to keep its ID until its D590 comes late, so that the late
+ * D590 is dropped instead of failing the session.  Any other failure, and
+ * every failure of an ordinary swap, fails the session as before.
+ */
+#define DCP_M4_XDR_LOST		2U	/* given-up probe swaps still without their D590 */
+
+enum dcp_m4_xdr_give_up {
+	DCP_M4_XDR_KEEP_NONE,		/* not given up: the session fails */
+	DCP_M4_XDR_KEEP_STALLED,	/* A407 answered, no D590 by the deadline */
+	DCP_M4_XDR_KEEP_REFUSED,	/* A407 answered with an error status */
+};
+
+struct dcp_m4_xdr_lost {
+	u32 id[DCP_M4_XDR_LOST];	/* 0: a free slot */
+	u32 given_up, late;		/* probes given up; late D590s dropped */
+};
+
+/* How a swap ended, for dcp_m4_xdr_give_up(). */
+struct dcp_m4_xdr_end {
+	u32 id;		/* its ID (0: A406 gave none) */
+	int error;	/* what the swap returned */
+	bool probe;	/* it asked for a level above the one taken */
+	bool quiet;	/* no session or transaction error, no call or callback open */
+	bool replied;	/* A407 answered with status 0 */
+	bool refused;	/* A407 answered with an error status */
+	bool completed;	/* its D590 came */
+};
+
+/* The slot of @id among the given-up swaps (0: a free one), or -1. */
+static inline int dcp_m4_xdr_lost_find(const struct dcp_m4_xdr_lost *l, u32 id)
+{
+	for (unsigned int i = 0; i < DCP_M4_XDR_LOST; i++)
+		if (l->id[i] == id)
+			return i;
+	return -1;
+}
+
+/* Whether the swap that ended so is given up, and how. */
+static inline enum dcp_m4_xdr_give_up
+dcp_m4_xdr_give_up(const struct dcp_m4_xdr_lost *l, const struct dcp_m4_xdr_end *e)
+{
+	if (!e->probe || !e->quiet || !e->id || e->completed)
+		return DCP_M4_XDR_KEEP_NONE;
+	/* Its ID kept already (two D590s could not be told apart), or no slot. */
+	if (dcp_m4_xdr_lost_find(l, e->id) >= 0 || dcp_m4_xdr_lost_find(l, 0) < 0)
+		return DCP_M4_XDR_KEEP_NONE;
+	if (e->refused && !e->replied && e->error == -EPROTO)
+		return DCP_M4_XDR_KEEP_REFUSED;
+	if (e->replied && !e->refused && e->error == -ETIMEDOUT)
+		return DCP_M4_XDR_KEEP_STALLED;
+	return DCP_M4_XDR_KEEP_NONE;
+}
+
+/* Keep the ID of a swap given up; false with no slot (or no ID). */
+static inline bool dcp_m4_xdr_lost_add(struct dcp_m4_xdr_lost *l, u32 id)
+{
+	int slot = id ? dcp_m4_xdr_lost_find(l, 0) : -1;
+
+	if (slot < 0)
+		return false;
+	l->id[slot] = id;
+	l->given_up++;
+	return true;
+}
+
+/* The D590 of swap @id: true, and its ID forgotten, if that swap was given up. */
+static inline bool dcp_m4_xdr_lost_drop(struct dcp_m4_xdr_lost *l, u32 id)
+{
+	int slot = id ? dcp_m4_xdr_lost_find(l, id) : -1;
+
+	if (slot < 0)
+		return false;
+	l->id[slot] = 0;
+	l->late++;
+	return true;
+}
+
+static inline const char *dcp_m4_xdr_give_up_name(enum dcp_m4_xdr_give_up how)
+{
+	switch (how) {
+	case DCP_M4_XDR_KEEP_STALLED:
+		return "left without its D590";
+	case DCP_M4_XDR_KEEP_REFUSED:
+		return "refused";
+	default:
+		return "none";
+	}
+}
+
 #endif
-- 
2.43.0

