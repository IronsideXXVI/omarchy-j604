From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 19:22:35 +0000
Subject: [PATCH] tools/asahi: rtkit-retained-tests: model the killable
 wait and the sleep case

apple_rtkit_wait_timeout() now waits killable outside a retained wake,
and uninterruptibly during a suspend-to-RAM, and the host test no longer
builds: the fixture still stubs the interruptible wait and has no
pm_suspend_target_state. Stub the killable wait and the target state,
and cover the suspend-to-RAM case.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 tools/asahi/rtkit-retained-tests.py | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/tools/asahi/rtkit-retained-tests.py b/tools/asahi/rtkit-retained-tests.py
index b79a9cd542..87acf213f8 100755
--- a/tools/asahi/rtkit-retained-tests.py
+++ b/tools/asahi/rtkit-retained-tests.py
@@ -66,7 +66,7 @@ static int apple_rtkit_management_send(struct apple_rtkit *rtk, u8 type, u64 dat
 {
 	(void)rtk; sent++; sent_type = type; sent_data = data; return 0;
 }
-/* A signal is pending for every interruptible wait. */
+/* A fatal signal is pending for every killable wait. */
 #define ERESTARTSYS 512
 #define READ_ONCE(x) (x)
 struct completion { int unused; };
@@ -75,7 +75,10 @@ static unsigned long wait_for_completion_timeout(struct completion *c, unsigned
 {
 	(void)c; waited_uninterruptible++; return t;
 }
-static long wait_for_completion_interruptible_timeout(struct completion *c, unsigned long t)
+#define PM_SUSPEND_TO_IDLE 1
+#define PM_SUSPEND_MEM 3
+static int pm_suspend_target_state;
+static long wait_for_completion_killable_timeout(struct completion *c, unsigned long t)
 {
 	(void)c; (void)t; waited_interruptible++; return -ERESTARTSYS;
 }
@@ -156,7 +159,7 @@ int main(void)
 	assert(sent == 0 && r.iop_pwr_ack_completion == 1);
 	assert(r.iop_power_state == APPLE_RTKIT_PWR_STATE_QUIESCED);
 
-	/* A retained wake waits through a signal; other waits stay interruptible. */
+	/* A retained wake waits through a signal; other waits stay killable. */
 	struct completion c;
 	r = fresh();
 	assert(apple_rtkit_wait_timeout(&r, &c, 7) == 7);
@@ -164,6 +167,12 @@ int main(void)
 	r.retained_wake = false;
 	assert(apple_rtkit_wait_timeout(&r, &c, 7) == -ERESTARTSYS);
 	assert(waited_uninterruptible == 1 && waited_interruptible == 1);
+	/* During a suspend-to-RAM not even a fatal signal ends it. */
+	pm_suspend_target_state = PM_SUSPEND_MEM;
+	assert(apple_rtkit_wait_timeout(&r, &c, 7) == 7);
+	assert(waited_uninterruptible == 2 && waited_interruptible == 1);
+	pm_suspend_target_state = PM_SUSPEND_TO_IDLE;
+	assert(apple_rtkit_wait_timeout(&r, &c, 7) == -ERESTARTSYS);
 
 	puts("PASS retained endpoint map replies, IOP acknowledgments and waits");
 	return 0;
