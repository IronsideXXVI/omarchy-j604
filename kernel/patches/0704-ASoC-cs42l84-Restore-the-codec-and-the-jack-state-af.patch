From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 14:45:57 +0000
Subject: [PATCH] ASoC: cs42l84: Restore the codec and the jack state
 after system sleep

The driver has no suspend or resume. A sleep that cuts the codec's
supply or reset line, as a firmware-driven (deep) sleep does on Apple
Silicon, brings it back from a power-on reset: the init writes, plug
detection setup and interrupt masks from the probe are gone, the
register cache still believes them, and a headset plugged in or pulled
out while asleep raised no interrupt anyone saw.

Leave the codec alone while asleep (interrupt masked, button polling
stopped, cache only). At resume, sync the cache; when the firmware
reports the sleep or the plug interrupt mask read from the codec no
longer matches the cache, replay what the probe does after its reset.
Then judge the plug once, as the interrupt handler does, so a change
while asleep is reported and a headset still plugged in is set up
again.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 sound/soc/codecs/cs42l84.c | 85 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 85 insertions(+)

diff --git a/sound/soc/codecs/cs42l84.c b/sound/soc/codecs/cs42l84.c
index 3982bfa1ca..573de1eadc 100644
--- a/sound/soc/codecs/cs42l84.c
+++ b/sound/soc/codecs/cs42l84.c
@@ -19,6 +19,7 @@
 #include <linux/devm-helpers.h>
 #include <linux/i2c.h>
 #include <linux/regmap.h>
+#include <linux/suspend.h>
 #include <linux/workqueue.h>
 #include <linux/slab.h>
 #include <linux/acpi.h>
@@ -352,7 +353,12 @@ static int cs42l84_component_probe(struct snd_soc_component *component)
 	return 0;
 }
 
+static int cs42l84_component_suspend(struct snd_soc_component *component);
+static int cs42l84_component_resume(struct snd_soc_component *component);
+
 static const struct snd_soc_component_driver soc_component_dev_cs42l84 = {
+	.suspend		= pm_ptr(cs42l84_component_suspend),
+	.resume			= pm_ptr(cs42l84_component_resume),
 	.set_jack		= cs42l84_set_jack,
 	.probe			= cs42l84_component_probe,
 	.controls		= cs42l84_snd_controls,
@@ -1222,6 +1228,85 @@ static int cs42l84_apply_init_writes(struct cs42l84_private *cs42l84)
 	return 0;
 }
 
+/*
+ * System sleep. The codec is left alone while asleep (cache only, its
+ * interrupt masked). A sleep that cuts its supply or its reset line, as a
+ * firmware-driven (deep) sleep does, brings it back from a power-on reset:
+ * its init writes, plug detection setup and interrupt masks are gone, and
+ * a plug or unplug while asleep raised no interrupt anyone saw.
+ */
+static int cs42l84_component_suspend(struct snd_soc_component *component)
+{
+	struct cs42l84_private *cs42l84 = snd_soc_component_get_drvdata(component);
+	struct i2c_client *client = to_i2c_client(cs42l84->dev);
+
+	if (client->irq)
+		disable_irq(client->irq);
+	cancel_delayed_work_sync(&cs42l84->remote_poll_work);
+	regcache_cache_only(cs42l84->regmap, true);
+	regcache_mark_dirty(cs42l84->regmap);
+	return 0;
+}
+
+/* The plug interrupt mask as the codec holds it differs from the cache after a reset. */
+static bool cs42l84_lost_state(struct cs42l84_private *cs42l84)
+{
+	unsigned int cached, hw;
+	int ret;
+
+	if (regmap_read(cs42l84->regmap, CS42L84_TSRS_PLUG_INT_MASK, &cached))
+		return true;
+	regcache_cache_bypass(cs42l84->regmap, true);
+	ret = regmap_read(cs42l84->regmap, CS42L84_TSRS_PLUG_INT_MASK, &hw);
+	regcache_cache_bypass(cs42l84->regmap, false);
+	return ret || hw != cached;
+}
+
+static int cs42l84_component_resume(struct snd_soc_component *component)
+{
+	struct cs42l84_private *cs42l84 = snd_soc_component_get_drvdata(component);
+	struct i2c_client *client = to_i2c_client(cs42l84->dev);
+	unsigned int reg;
+	bool lost, power_on;
+	int ret;
+
+	regcache_cache_only(cs42l84->regmap, false);
+	lost = cs42l84_lost_state(cs42l84);
+	power_on = lost || pm_resume_via_firmware();
+	if (power_on)
+		usleep_range(CS42L84_BOOT_TIME_US, CS42L84_BOOT_TIME_US * 2);
+
+	ret = regcache_sync(cs42l84->regmap);
+	if (!ret && power_on) {
+		/* As the probe does after its reset */
+		ret = cs42l84_apply_init_writes(cs42l84);
+		if (!ret && cs42l84->ring_detect)
+			regmap_read(cs42l84->regmap, CS42L84_REMOTE_BUTTON_STATUS1, &reg);
+		cs42l84_setup_plug_detect(cs42l84);
+		cs42l84_set_interrupt_masks(cs42l84, cs42l84->ring_detect ?
+					    CS42L84_TS_PLUG | CS42L84_TS_UNPLUG :
+					    CS42L84_RS_PLUG | CS42L84_RS_UNPLUG);
+	}
+	if (!ret && lost) {
+		/*
+		 * The headset setup is gone too: judge the plug afresh. A codec
+		 * that kept its state keeps the plug state it reported, so only
+		 * a change while asleep runs detection again (no mic bias cycle,
+		 * no click, in headphones that stayed plugged in).
+		 */
+		cs42l84->ring_state = 0xff;
+		cs42l84->tip_state = 0xff;
+	}
+	if (ret)
+		dev_err(cs42l84->dev, "restore after sleep failed: %d\n", ret);
+
+	if (client->irq)
+		enable_irq(client->irq);
+	/* A plug or unplug while asleep raised no interrupt we saw: look now */
+	cs42l84_irq_thread(client->irq, cs42l84);
+	return ret;
+}
+
 static int cs42l84_i2c_probe(struct i2c_client *i2c_client)
 {
 	struct cs42l84_private *cs42l84;
-- 
2.43.0

