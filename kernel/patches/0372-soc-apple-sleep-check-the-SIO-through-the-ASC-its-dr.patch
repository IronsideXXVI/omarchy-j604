From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 00:30:12 +0000
Subject: [PATCH] soc: apple: sleep: check the SIO through the ASC its
 driver registered

The last check before the commit reads the CPU control of each
coprocessor that must stop, from the window its node names "coproc"
or "asc". The T8132 SIO node names none, so the check has no window
and counts the SIO as running however it is:

  apple-sleep 380700000.sleep-controller: dma-controller didn't stop:
  control 0x0 status 0x0
  apple-sleep 380700000.sleep-controller: refused: 1 coprocessors that
  must stop or gate are still running

Its driver already registers that ASC with apple_sleep_coproc_register().
Use it when the node names no window. The mapping is the driver's, so
take it only while the device is bound, and look it up again at each
sleep.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/sleep.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/drivers/soc/apple/sleep.c b/drivers/soc/apple/sleep.c
index 0dda66ff5e..928343259e 100644
--- a/drivers/soc/apple/sleep.c
+++ b/drivers/soc/apple/sleep.c
@@ -621,6 +621,8 @@ struct apple_sleep {
 		/* Compared only, never dereferenced: nodes outlive the gate. */
 		const struct device_node *np;
 		void __iomem *asc;
+		/* @asc is its driver's mapping, valid only while it's bound. */
+		bool asc_borrowed;
 		bool bound;
 		bool must_stop;
 		bool sep;
@@ -680,6 +682,19 @@ static bool apple_sleep_coproc_ready_node(const struct device_node *np)
 	return false;
 }
 
+/* The ASC window a coprocessor's driver registered, for a node that names none. */
+static void __iomem *apple_sleep_coproc_asc_node(const struct device_node *np)
+{
+	int i;
+
+	guard(mutex)(&apple_sleep_coprocs_lock);
+	for (i = 0; np && i < SLEEP_COPROCS; i++)
+		if (apple_sleep_coprocs[i].dev && apple_sleep_coprocs[i].asc &&
+		    apple_sleep_coprocs[i].dev->of_node == np)
+			return apple_sleep_coprocs[i].asc;
+	return NULL;
+}
+
 static bool sleep_usb_asleep;
 
 void apple_sleep_usb_set_asleep(bool asleep)
@@ -1596,6 +1611,10 @@ static void apple_sleep_gate_prepare(struct apple_sleep *s)
 		g->sep = of_node_name_eq(c, "sep");
 		g->must_stop = coprocs[i].must_stop;
 		g->ps = coprocs[i].ps;
+		if (g->asc_borrowed) {
+			g->asc = NULL;
+			g->asc_borrowed = false;
+		}
 		if (g->must_stop && !g->asc) {
 			int idx = of_property_match_string(c, "reg-names", "coproc");
 
@@ -1604,6 +1623,11 @@ static void apple_sleep_gate_prepare(struct apple_sleep *s)
 			if (idx >= 0)
 				g->asc = of_iomap(c, idx);
 		}
+		/* The SIO names no window: its driver registered the ASC it stops. */
+		if (g->must_stop && !g->asc && g->bound) {
+			g->asc = apple_sleep_coproc_asc_node(c);
+			g->asc_borrowed = !!g->asc;
+		}
 		if (pdev)
 			put_device(&pdev->dev);
 		of_node_put(c);
-- 
