From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Thu, 5 Nov 2026 12:07:51 -0500
Subject: [PATCH] pmdomain: apple: pmc: provide display pipe interface enables
 as power domains

The T8132 PMC ignores an external display pipe's bandwidth and boost
votes until the pipe's bits are set in the BWR and boost interface
enable words. With them clear, the pipe's display clock stays at its
lowest state, and a 4K mode at 120 Hz shows only the first lines of
each frame. macOS sets the bits when the pipe's SYS power state powers
on, and clears them before it powers off.

Add the offsets of the two enable words in the "rails" region to the
per-SoC layout: 0x2020 and 0x2028 on T8132, and 0 elsewhere, where an
interface node is rejected. Provide each interface-* child node as a
power domain that joins its parent domain like the cluster domains do.

Power on sets the pipe's boost bit and then its BWR bit, and power off
clears them, each with a read-modify-write under the PMC lock that is
read back. If the BWR word does not take the change, the boost bit gets
back the value it had before, and the call fails with -EIO. A bit
claimed by two domains is rejected.

The domain is IRQ safe: the PMGR power states that depend on it are,
and genpd refuses an IRQ-safe subdomain under a parent that is not. The
callbacks only take the PMC's raw spinlock and access MMIO.

Like a voter domain, an interface domain starts from the hardware
state: it is on if both of its bits are already set. With only one bit
set it starts off and that bit is left alone until the domain powers
on, which sets the other one; a failed power on keeps it as well. So the
driver never drops a vote the boot loader left before the pipe powers
off. When the PMC goes away, the domains' bits get back their values at
probe, as the rail enables do. System sleep needs nothing extra: genpd
powers the domain off and on with the domains that depend on it, and
the words, like the rail enables, are not saved and restored.

Show both words in the debugfs status, and add KUnit cases for setting
and clearing a pipe's bits next to the internal display's boost bit, for
a BWR word that does not take the change, for the boot states, and for
the domain linked between IRQ-safe SYS and FE power states the way the
PMGR driver links them, powered through a device on FE.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit c1db3bc458e7590eace43ee03021d61b8ea22eda)
[j604: conflict resolved on a15y by strict diff3 rules (ours==base ws-only -> theirs; empty base -> union): drivers/pmdomain/apple/pmc.c; hunk 1 line 86: ours 3 base 0 theirs 4 -> union (empty base)]
---
 drivers/pmdomain/apple/Kconfig    |   5 +-
 drivers/pmdomain/apple/pmc-test.c | 208 +++++++++++++++++++++++++++++
 drivers/pmdomain/apple/pmc.c      | 213 ++++++++++++++++++++++++++++++
 3 files changed, 424 insertions(+), 2 deletions(-)

diff --git a/drivers/pmdomain/apple/Kconfig b/drivers/pmdomain/apple/Kconfig
index 5f0a9d95c1..1734d09ccd 100644
--- a/drivers/pmdomain/apple/Kconfig
+++ b/drivers/pmdomain/apple/Kconfig
@@ -64,8 +64,9 @@ config APPLE_PMC
 	  shared rails, such as the DRAM controller and the SoC fabric,
 	  between voter agents. This driver enables the static agents and
 	  provides power domains that enable a dynamic agent, such as the
-	  GPU, while its device is powered on. It can also limit the DRAM
-	  controller rail as a thermal cooling device.
+	  GPU, or a display pipe's bandwidth and boost interfaces, while
+	  its device is powered on. It can also limit the DRAM controller
+	  rail as a thermal cooling device.
 
 config APPLE_PMC_KUNIT_TEST
 	bool "KUnit tests for the Apple PMC voter interface" if !KUNIT_ALL_TESTS
diff --git a/drivers/pmdomain/apple/pmc-test.c b/drivers/pmdomain/apple/pmc-test.c
index bf0ec124ee..166fb26ef8 100644
--- a/drivers/pmdomain/apple/pmc-test.c
+++ b/drivers/pmdomain/apple/pmc-test.c
@@ -8,6 +8,7 @@
 
 #include <kunit/device.h>
 #include <kunit/test.h>
+#include <linux/pm_runtime.h>
 
 #define APPLE_PMC_TEST_RAILS_SIZE	0x4000
 
@@ -309,6 +310,209 @@ static void apple_pmc_test_dcs_floor(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, apple_pmc_test_ap_floor(pmc) & ~APPLE_PMC_RAIL_MASK(hw->dcs_rail), 0U);
 }
 
+/*
+ * A T8132 interface domain sets and clears its own BWR and boost enables
+ * only: the internal display's boost enable, bit 0, stays set.
+ */
+static void apple_pmc_test_interface(struct kunit *test)
+{
+	struct apple_pmc *pmc = apple_pmc_test_alloc(test);
+	struct apple_pmc_domain dom = {
+		.pmc = pmc, .interface = true, .bwr_bit = 3, .boost_bit = 1,
+	};
+	const struct apple_pmc_hw *hw = &apple_pmc_hw_t8132;
+
+	pmc->hw = hw;
+	writel(BIT(0), pmc->rails + hw->boost_enable);
+
+	KUNIT_ASSERT_EQ(test, apple_pmc_domain_power_on(&dom.genpd), 0);
+	KUNIT_EXPECT_EQ(test, readl(pmc->rails + hw->bwr_enable), BIT(3));
+	KUNIT_EXPECT_EQ(test, readl(pmc->rails + hw->boost_enable), BIT(0) | BIT(1));
+	KUNIT_ASSERT_EQ(test, apple_pmc_domain_power_off(&dom.genpd), 0);
+	KUNIT_EXPECT_EQ(test, readl(pmc->rails + hw->bwr_enable), 0U);
+	KUNIT_EXPECT_EQ(test, readl(pmc->rails + hw->boost_enable), BIT(0));
+}
+
+struct apple_pmc_test_stuck {
+	u32 offset;
+	u32 value;
+};
+
+/* The interface enable word at stuck->offset keeps stuck->value. */
+static u32 apple_pmc_test_stuck_read(struct apple_pmc *pmc, u32 offset)
+{
+	struct kunit *test = kunit_get_current_test();
+	struct apple_pmc_test_stuck *stuck = test->priv;
+
+	if (offset == stuck->offset)
+		writel(stuck->value, pmc->rails + offset);
+	return readl(pmc->rails + offset);
+}
+
+/*
+ * If the BWR enable does not change, the boost enable goes back too, both
+ * when the domain powers on and when it powers off.
+ */
+static void apple_pmc_test_interface_stuck(struct kunit *test)
+{
+	struct apple_pmc *pmc = apple_pmc_test_alloc(test);
+	struct apple_pmc_domain dom = {
+		.pmc = pmc, .interface = true, .bwr_bit = 3, .boost_bit = 1,
+	};
+	const struct apple_pmc_hw *hw = &apple_pmc_hw_t8132;
+	struct apple_pmc_test_stuck stuck = { .offset = hw->bwr_enable };
+
+	pmc->hw = hw;
+	writel(BIT(0), pmc->rails + hw->boost_enable);
+	test->priv = &stuck;
+	kunit_activate_static_stub(test, apple_pmc_interface_read,
+				   apple_pmc_test_stuck_read);
+
+	KUNIT_EXPECT_EQ(test, apple_pmc_domain_power_on(&dom.genpd), -EIO);
+	KUNIT_EXPECT_EQ(test, apple_pmc_interface_read(pmc, hw->bwr_enable), 0U);
+	KUNIT_EXPECT_EQ(test, apple_pmc_interface_read(pmc, hw->boost_enable), BIT(0));
+
+	stuck.value = BIT(3);
+	writel(BIT(0) | BIT(1), pmc->rails + hw->boost_enable);
+	KUNIT_EXPECT_EQ(test, apple_pmc_domain_power_off(&dom.genpd), -EIO);
+	KUNIT_EXPECT_EQ(test, apple_pmc_interface_read(pmc, hw->bwr_enable), BIT(3));
+	KUNIT_EXPECT_EQ(test, apple_pmc_interface_read(pmc, hw->boost_enable),
+			BIT(0) | BIT(1));
+
+	kunit_deactivate_static_stub(test, apple_pmc_interface_read);
+	test->priv = NULL;
+}
+
+static void apple_pmc_test_genpd_remove(void *genpd)
+{
+	pm_genpd_remove(genpd);
+}
+
+static void apple_pmc_test_genpd_detach(void *dev)
+{
+	pm_runtime_disable(dev);
+	pm_genpd_remove_device(dev);
+}
+
+/* A genpd that is removed again when the test ends, children first. */
+static struct generic_pm_domain *apple_pmc_test_genpd(struct kunit *test,
+						      struct generic_pm_domain *genpd,
+						      int ret)
+{
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+							apple_pmc_test_genpd_remove,
+							genpd), 0);
+	return genpd;
+}
+
+static struct apple_pmc_domain *apple_pmc_test_interface_dom(struct kunit *test,
+							     struct apple_pmc *pmc,
+							     const char *name)
+{
+	struct apple_pmc_domain *dom = kunit_kzalloc(test, sizeof(*dom), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, dom);
+	dom->pmc = pmc;
+	dom->interface = true;
+	dom->bwr_bit = 3;
+	dom->boost_bit = 1;
+	dom->genpd.name = name;
+	apple_pmc_test_genpd(test, &dom->genpd, apple_pmc_interface_init(pmc, dom));
+	return dom;
+}
+
+/*
+ * Link the interface domain as the PMGR driver does: under a SYS power
+ * state, with an FE power state below both, all of them IRQ safe. Powering
+ * FE through a device sets the enables after SYS is on, and powering it
+ * off clears them.
+ */
+static void apple_pmc_test_interface_genpd(struct kunit *test)
+{
+	struct apple_pmc *pmc = apple_pmc_test_alloc(test);
+	const struct apple_pmc_hw *hw = &apple_pmc_hw_t8132;
+	struct generic_pm_domain *sys, *fe;
+	struct apple_pmc_domain *dom;
+	struct device *dev;
+
+	pmc->hw = hw;
+	writel(BIT(0), pmc->rails + hw->boost_enable);
+	pmc->saved_boost = BIT(0);
+	dev = kunit_device_register(test, "apple-pmc-test-fe");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+
+	sys = kunit_kzalloc(test, sizeof(*sys), GFP_KERNEL);
+	fe = kunit_kzalloc(test, sizeof(*fe), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, sys);
+	KUNIT_ASSERT_NOT_NULL(test, fe);
+	sys->name = "apple-pmc-test-sys";
+	sys->flags = GENPD_FLAG_IRQ_SAFE;
+	fe->name = "apple-pmc-test-fe";
+	fe->flags = GENPD_FLAG_IRQ_SAFE;
+	apple_pmc_test_genpd(test, sys, pm_genpd_init(sys, NULL, false));
+	dom = apple_pmc_test_interface_dom(test, pmc, "apple-pmc-test-interface");
+	KUNIT_EXPECT_EQ(test, dom->genpd.status, GENPD_STATE_OFF);
+	apple_pmc_test_genpd(test, fe, pm_genpd_init(fe, NULL, true));
+
+	KUNIT_ASSERT_EQ(test, pm_genpd_add_subdomain(sys, &dom->genpd), 0);
+	KUNIT_ASSERT_EQ(test, pm_genpd_add_subdomain(sys, fe), 0);
+	KUNIT_ASSERT_EQ(test, pm_genpd_add_subdomain(&dom->genpd, fe), 0);
+
+	KUNIT_ASSERT_EQ(test, pm_genpd_add_device(fe, dev), 0);
+	pm_runtime_enable(dev);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+							apple_pmc_test_genpd_detach,
+							dev), 0);
+
+	KUNIT_ASSERT_EQ(test, pm_runtime_resume_and_get(dev), 0);
+	KUNIT_EXPECT_EQ(test, dom->genpd.status, GENPD_STATE_ON);
+	KUNIT_EXPECT_EQ(test, readl(pmc->rails + hw->bwr_enable), BIT(3));
+	KUNIT_EXPECT_EQ(test, readl(pmc->rails + hw->boost_enable), BIT(0) | BIT(1));
+
+	KUNIT_EXPECT_EQ(test, pm_runtime_put_sync_suspend(dev), 0);
+	KUNIT_EXPECT_EQ(test, dom->genpd.status, GENPD_STATE_OFF);
+	KUNIT_EXPECT_EQ(test, readl(pmc->rails + hw->bwr_enable), 0U);
+	KUNIT_EXPECT_EQ(test, readl(pmc->rails + hw->boost_enable), BIT(0));
+}
+
+/*
+ * A pipe with both enables set at boot starts on. One with only its boost
+ * enable set starts off, and a power on that fails on the BWR enable keeps
+ * that boost enable instead of clearing it.
+ */
+static void apple_pmc_test_interface_boot_state(struct kunit *test)
+{
+	struct apple_pmc *pmc = apple_pmc_test_alloc(test);
+	const struct apple_pmc_hw *hw = &apple_pmc_hw_t8132;
+	struct apple_pmc_test_stuck stuck = { .offset = hw->bwr_enable };
+	struct apple_pmc_domain *dom;
+
+	pmc->hw = hw;
+	pmc->saved_bwr = BIT(3);
+	pmc->saved_boost = BIT(0) | BIT(1);
+	dom = apple_pmc_test_interface_dom(test, pmc, "apple-pmc-test-on");
+	KUNIT_EXPECT_EQ(test, dom->genpd.status, GENPD_STATE_ON);
+
+	pmc->saved_bwr = 0;
+	writel(BIT(0) | BIT(1), pmc->rails + hw->boost_enable);
+	dom = apple_pmc_test_interface_dom(test, pmc, "apple-pmc-test-mixed");
+	KUNIT_EXPECT_EQ(test, dom->genpd.status, GENPD_STATE_OFF);
+
+	test->priv = &stuck;
+	kunit_activate_static_stub(test, apple_pmc_interface_read,
+				   apple_pmc_test_stuck_read);
+	KUNIT_EXPECT_EQ(test, apple_pmc_domain_power_on(&dom->genpd), -EIO);
+	KUNIT_EXPECT_EQ(test, apple_pmc_interface_read(pmc, hw->boost_enable),
+			BIT(0) | BIT(1));
+	kunit_deactivate_static_stub(test, apple_pmc_interface_read);
+	test->priv = NULL;
+
+	KUNIT_EXPECT_EQ(test, apple_pmc_domain_power_on(&dom->genpd), 0);
+	KUNIT_EXPECT_EQ(test, readl(pmc->rails + hw->bwr_enable), BIT(3));
+	KUNIT_EXPECT_EQ(test, readl(pmc->rails + hw->boost_enable), BIT(0) | BIT(1));
+}
+
 static struct kunit_case apple_pmc_test_cases[] = {
 	KUNIT_CASE(apple_pmc_test_dcs_floor),
 	KUNIT_CASE(apple_pmc_test_partial_enable),
@@ -320,6 +524,10 @@ static struct kunit_case apple_pmc_test_cases[] = {
 	KUNIT_CASE(apple_pmc_test_t8140_ignores_pending_word),
 	KUNIT_CASE(apple_pmc_test_floor_aggregate),
 	KUNIT_CASE(apple_pmc_test_floor_pending_timeout),
+	KUNIT_CASE(apple_pmc_test_interface),
+	KUNIT_CASE(apple_pmc_test_interface_stuck),
+	KUNIT_CASE(apple_pmc_test_interface_genpd),
+	KUNIT_CASE(apple_pmc_test_interface_boot_state),
 	{}
 };
 
diff --git a/drivers/pmdomain/apple/pmc.c b/drivers/pmdomain/apple/pmc.c
index 3c5a1f1598..d9c6fb7fad 100644
--- a/drivers/pmdomain/apple/pmc.c
+++ b/drivers/pmdomain/apple/pmc.c
@@ -23,6 +23,15 @@
  * at its highest state to encode at full speed; macOS raises the same rail
  * for every encode session. Floors on one rail combine to the highest.
  *
+ * On T8132 a display pipe votes through two more interfaces: bandwidth
+ * requests (BWR) and boost, which raises the display clock. Each has an
+ * enable word with one bit per agent, and the PMC ignores the votes of an
+ * agent whose bit is clear: the external pipes' display clock then stays at
+ * its lowest state, too slow for modes such as 4K at 120 Hz. macOS sets a
+ * pipe's two bits when its PMGR power state powers on, and clears them
+ * before it powers off. The driver models them as a power domain too, that
+ * sits between that power state and the ones that depend on it.
+ *
  * Under thermal pressure the driver can also limit the DRAM controller
  * (DCS) rail: it stops honouring the other agents on that rail and votes
  * on their behalf through the AP's own agent, capped. This bounds the heat
@@ -77,6 +86,10 @@
  * @has_pending: the word after each agent's floor word holds one pending
  *	bit per agent, set until the PMC has taken up that agent's last
  *	floor
+ * @bwr_enable: offset of the bandwidth request (BWR) interface enable word
+ *	in the "rails" region; 0 if the PMC has none
+ * @boost_enable: offset of the boost interface enable word in the "rails"
+ *	region; 0 if the PMC has none
  */
 struct apple_pmc_hw {
 	u32 agent_stride;
@@ -88,6 +101,8 @@ struct apple_pmc_hw {
 	u32 dcs_max;
 	u32 ap_agent;
 	bool has_pending;
+	u32 bwr_enable;
+	u32 boost_enable;
 };
 
 struct apple_pmc {
@@ -108,6 +123,11 @@ struct apple_pmc {
 	u32 static_agents;
 	/* Rails with a floor domain. */
 	u32 floor_rails;
+	/* BWR and boost interface enables at probe, and the bits of domains. */
+	u32 saved_bwr;
+	u32 saved_boost;
+	u32 bwr_bits;
+	u32 boost_bits;
 	struct list_head domains;
 	struct dentry *debugfs;
 	/* Cooling state of the DCS limit: 0 is none, dcs_max holds DCS at 0. */
@@ -130,6 +150,9 @@ struct apple_pmc {
  * @on: with @floor, whether the floor is held; protected by pmc->lock
  * @cluster: the domain is a cluster enable bit in the "clusters" region
  * @bit: with @cluster, the bit in the control and status words
+ * @interface: the domain is a display pipe's BWR and boost interface enables
+ * @bwr_bit: with @interface, the bit in the BWR interface enable word
+ * @boost_bit: with @interface, the bit in the boost interface enable word
  */
 struct apple_pmc_domain {
 	struct generic_pm_domain genpd;
@@ -143,6 +166,9 @@ struct apple_pmc_domain {
 	bool on;
 	bool cluster;
 	unsigned int bit;
+	bool interface;
+	unsigned int bwr_bit;
+	unsigned int boost_bit;
 	bool provider;
 };
 
@@ -681,10 +707,74 @@ static int apple_pmc_cluster_set(struct apple_pmc_domain *dom, bool on)
 	return ret;
 }
 
+static u32 apple_pmc_interface_read(struct apple_pmc *pmc, u32 offset)
+{
+#if IS_ENABLED(CONFIG_APPLE_PMC_KUNIT_TEST)
+	KUNIT_STATIC_STUB_REDIRECT(apple_pmc_interface_read, pmc, offset);
+#endif
+	return readl(pmc->rails + offset);
+}
+
+/*
+ * Caller holds pmc->lock. Set or clear @bit in the interface enable word at
+ * @offset, and read the word back.
+ */
+static int apple_pmc_interface_update(struct apple_pmc *pmc, u32 offset,
+				      unsigned int bit, bool on)
+{
+	u32 old = apple_pmc_interface_read(pmc, offset);
+	u32 val = on ? old | BIT(bit) : old & ~BIT(bit);
+
+	if (val == old)
+		return 0;
+
+	writel(val, pmc->rails + offset);
+	if ((apple_pmc_interface_read(pmc, offset) ^ val) & BIT(bit)) {
+		dev_err_ratelimited(pmc->dev,
+				    "interface enable %#x bit %u did not turn %s\n",
+				    offset, bit, str_on_off(on));
+		return -EIO;
+	}
+
+	return 0;
+}
+
+/*
+ * Set or clear the boost and BWR enables of a display pipe. If the BWR
+ * enable does not take the change, put the boost enable back to what it
+ * was: genpd keeps the domain in its old state when a callback fails, and
+ * a boost enable that was already set, such as one the boot loader left
+ * for a running pipe, must not be lost to a failed power on. Called with
+ * IRQs off for an IRQ-safe domain; everything here is atomic.
+ */
+static int apple_pmc_interface_set(struct apple_pmc_domain *dom, bool on)
+{
+	struct apple_pmc *pmc = dom->pmc;
+	const struct apple_pmc_hw *hw = pmc->hw;
+	unsigned long flags;
+	bool boost;
+	int ret;
+
+	raw_spin_lock_irqsave(&pmc->lock, flags);
+	boost = apple_pmc_interface_read(pmc, hw->boost_enable) & BIT(dom->boost_bit);
+	ret = apple_pmc_interface_update(pmc, hw->boost_enable, dom->boost_bit, on);
+	if (!ret) {
+		ret = apple_pmc_interface_update(pmc, hw->bwr_enable, dom->bwr_bit, on);
+		if (ret)
+			apple_pmc_interface_update(pmc, hw->boost_enable,
+						   dom->boost_bit, boost);
+	}
+	raw_spin_unlock_irqrestore(&pmc->lock, flags);
+
+	return ret;
+}
+
 static int apple_pmc_domain_power_on(struct generic_pm_domain *genpd)
 {
 	struct apple_pmc_domain *dom = genpd_to_apple_pmc_domain(genpd);
 
+	if (dom->interface)
+		return apple_pmc_interface_set(dom, true);
 	if (dom->cluster)
 		return apple_pmc_cluster_set(dom, true);
 	if (dom->floor)
@@ -696,6 +786,8 @@ static int apple_pmc_domain_power_off(struct generic_pm_domain *genpd)
 {
 	struct apple_pmc_domain *dom = genpd_to_apple_pmc_domain(genpd);
 
+	if (dom->interface)
+		return apple_pmc_interface_set(dom, false);
 	if (dom->cluster)
 		return apple_pmc_cluster_set(dom, false);
 	if (dom->floor)
@@ -860,6 +952,100 @@ static int apple_pmc_cluster_add(struct apple_pmc *pmc, struct device_node *np)
 	return 0;
 }
 
+/*
+ * Initialize the genpd of an interface domain, which starts from the
+ * hardware state: on if both of its bits are set, so that the enables of a
+ * pipe the boot loader left running stay set. With only one bit set it
+ * starts off, and the driver leaves that bit alone until the domain powers
+ * on, which sets the other one. A failed power on keeps the bit too, so no
+ * vote the boot loader left is dropped before the pipe powers off.
+ *
+ * The domain is IRQ safe, since the PMGR power states that depend on it
+ * are, and genpd only takes an IRQ-safe subdomain under an IRQ-safe parent.
+ */
+static int apple_pmc_interface_init(struct apple_pmc *pmc,
+				    struct apple_pmc_domain *dom)
+{
+	bool on = (pmc->saved_bwr & BIT(dom->bwr_bit)) &&
+		  (pmc->saved_boost & BIT(dom->boost_bit));
+
+	dom->genpd.flags |= GENPD_FLAG_IRQ_SAFE;
+	dom->genpd.power_on = apple_pmc_domain_power_on;
+	dom->genpd.power_off = apple_pmc_domain_power_off;
+
+	return pm_genpd_init(&dom->genpd, NULL, !on);
+}
+
+/* A display pipe's BWR and boost interface enables, set while powered. */
+static int apple_pmc_interface_add(struct apple_pmc *pmc, struct device_node *np)
+{
+	const struct apple_pmc_hw *hw = pmc->hw;
+	struct device *dev = pmc->dev;
+	struct apple_pmc_domain *dom;
+	struct of_phandle_args parent;
+	const char *label;
+	u32 bwr, boost;
+	int i, ret;
+
+	if (!hw->bwr_enable || !hw->boost_enable)
+		return dev_err_probe(dev, -EINVAL,
+				     "%pOF: no interface enables on this PMC\n", np);
+	if (of_property_read_u32(np, "apple,bwr-bit", &bwr) || bwr >= 32 ||
+	    of_property_read_u32(np, "apple,boost-bit", &boost) || boost >= 32)
+		return dev_err_probe(dev, -EINVAL, "%pOF: invalid interface bits\n", np);
+	if ((pmc->bwr_bits & BIT(bwr)) || (pmc->boost_bits & BIT(boost)))
+		return dev_err_probe(dev, -EINVAL, "%pOF: interface bits in use\n", np);
+
+	dom = kzalloc_obj(*dom);
+	if (!dom)
+		return -ENOMEM;
+
+	dom->pmc = pmc;
+	dom->np = of_node_get(np);
+	dom->interface = true;
+	dom->bwr_bit = bwr;
+	dom->boost_bit = boost;
+	if (of_property_read_string(np, "label", &label))
+		label = np->name;
+	dom->genpd.name = kasprintf(GFP_KERNEL, "pmc-%s", label);
+	if (!dom->genpd.name) {
+		of_node_put(dom->np);
+		kfree(dom);
+		return -ENOMEM;
+	}
+
