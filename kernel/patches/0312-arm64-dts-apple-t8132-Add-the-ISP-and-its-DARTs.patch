From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 28 Oct 2026 09:44:06 -0400
Subject: [PATCH] arm64: dts: apple: t8132: Add the ISP and its DARTs

Describe the ISP from the ADT: the coprocessor, mailbox, handshake and
doorbell registers at the T6041's offsets, the mailbox interrupt, and
three DART instances on one interrupt, which remap streams 1, 2, 3, 6,
7, 10 and 11 to stream 0. The first instance also has the address
filter registers.

The DART's 0xe0000000 window above the firmware's 20 MiB main memory
is the host's allocation aperture. Everything stays disabled until a
board describes its firmware memory.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(backported from commit 41dc2841b379df68b33738480b0a85958fcefbb8)
[j604: context conflict resolved by hand: this tree nests the SoC devices one level deeper and has
 no dart_apcie0 anchor, so the nodes are re-indented one tab and placed after sart@485c50000.
 Node text otherwise identical. Values checked against the J604 ADT (25G83 + 26B123 templates,
 RT27.2 runtime): isp and dart-isp reg/interrupts/remap/vm-size byte-identical to the J713.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132.dtsi | 61 ++++++++++++++++++++++++++++
 1 file changed, 61 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index 226d40b727..1bd4acdf78 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -1092,6 +1092,67 @@
 			status = "disabled";
 		};
 
+		/*
+		 * ADT isp and dart-isp: three DART instances on one interrupt; streams 1,
+		 * 2, 3, 6, 7, 10 and 11 are remapped to stream 0. The first instance also
+		 * has the address filter registers.
+		 */
+		isp: isp@48c000000 {
+			compatible = "apple,t8132-isp", "apple,isp";
+			reg = <0x4 0x8c000000 0x0 0x1604000>,
+			      <0x4 0x8e924000 0x0 0x40>,
+			      <0x4 0x8e9241d0 0x0 0x20>,
+			      <0x4 0x8e924464 0x0 0x10>;
+			reg-names = "coproc", "mbox", "gpio", "mbox2";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 369 IRQ_TYPE_LEVEL_HIGH>;
+			iommus = <&isp_dart0 0>, <&isp_dart1 0>, <&isp_dart2 0>;
+			power-domains = <&ps_isp_sys>, <&ps_isp_cpu>,
+					<&ps_isp_cpu_core0>, <&ps_isp_cpu_core1>,
+					<&ps_isp_fe>, <&ps_isp_dprx>, <&ps_isp_secure>,
+					<&ps_isp_sts0>, <&ps_isp_sts1>, <&ps_isp_pearl>,
+					<&ps_isp_be>, <&ps_isp_clr>, <&ps_isp_cvd>,
+					<&ps_isp_cvm>, <&ps_ispsens0>, <&ps_ispsens1>;
+			/* the DART's 0xe0000000 window above the firmware's 20 MiB */
+			apple,dart-vm-size = /bits/ 64 <0xdec00000>;
+			status = "disabled";
+		};
+
+		isp_dart0: iommu@48e8c0000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x8e8c0000 0x0 0xc000>,
+			      <0x4 0x8e8d0000 0x0 0x4000>;
+			reg-names = "dart", "dapf";
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 387 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_isp_sys>;
+			apple,remap-streams = <1 0>, <2 0>, <3 0>, <6 0>, <7 0>, <10 0>, <11 0>;
+			status = "disabled";
+		};
+
+		isp_dart1: iommu@48e8e0000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x8e8e0000 0x0 0xc000>;
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 387 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_isp_sys>;
+			apple,remap-streams = <1 0>, <2 0>, <3 0>, <6 0>, <7 0>, <10 0>, <11 0>;
+			status = "disabled";
+		};
+
+		isp_dart2: iommu@48e900000 {
+			compatible = "apple,t8132-dart", "apple,t8110-dart";
+			reg = <0x4 0x8e900000 0x0 0xc000>;
+			#iommu-cells = <1>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 387 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_isp_sys>;
+			apple,remap-streams = <1 0>, <2 0>, <3 0>, <6 0>, <7 0>, <10 0>, <11 0>;
+			status = "disabled";
+		};
+
 		nvme: nvme@4c5cc0000 {
 			compatible = "apple,t8132-nvme-ans2";
 			/*
