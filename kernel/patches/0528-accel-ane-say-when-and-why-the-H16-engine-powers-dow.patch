From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 01:00:46 +0000
Subject: [PATCH] accel/ane: say when and why the H16 engine powers
 down

The H16 engine powers off after h16_idle_off_ms with no program
loaded, but the kernel log did not show it. The power-off said
"powered down for system sleep" whatever the reason, the idle one was
a debug line, and the program stage ended with "held until reboot",
which reads as if the engine stayed powered.

Name the reason in the power-down line (idle, system sleep, restart),
log the idle power-off delay once the program stage is up, and say
that what is kept until reboot is the firmware and its mappings.
Nothing changes in what the driver does.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/accel/ane/ane_h16_backend.c | 18 ++++++++++--------
 1 file changed, 10 insertions(+), 8 deletions(-)

diff --git a/drivers/accel/ane/ane_h16_backend.c b/drivers/accel/ane/ane_h16_backend.c
index 586f1eb350..3ff054bbf4 100644
--- a/drivers/accel/ane/ane_h16_backend.c
+++ b/drivers/accel/ane/ane_h16_backend.c
@@ -307,7 +307,7 @@ static int ane_h16_suspend_firmware(struct ane_h16_device *h)
 }
 
 /* Reverse of acquisition: perf floor, DARTs, then base, td, mpm, cpu, sys. */
-static void ane_h16_power_down(struct ane_h16_device *h)
+static void ane_h16_power_down(struct ane_h16_device *h, const char *why)
 {
 	unsigned int i;
 
@@ -318,7 +318,7 @@ static void ane_h16_power_down(struct ane_h16_device *h)
 	for (i = h->powered; i-- > 0; )
 		pm_runtime_put_sync(h->power[i]);
 	h->engine_on = false;
-	dev_info(h->dev, "H16 ANE: powered down for system sleep\n");
+	dev_info(h->dev, "H16 ANE: powered down (%s)\n", why);
 }
 
 /* The five domains in order, then the DARTs (their resume restores SID0). */
@@ -485,7 +485,7 @@ static int ane_h16_power_cycle(struct ane_h16_device *h, bool verify)
 	for (i = 0; i < h->powered; i++)
 		offs[i] = h->genpd[i].offs;
 	if (h->engine_on)
-		ane_h16_power_down(h);
+		ane_h16_power_down(h, "restart");
 	for (i = 1; verify && i < h->powered; i++) {
 		if (!h->genpd[i].added || h->genpd[i].offs == offs[i]) {
 			dev_err(h->dev, "H16 ANE: domain %u did not power off; no restart\n", i);
@@ -592,7 +592,7 @@ static int ane_h16_sleep_prepare(struct ane_h16_device *h)
 				return -EBUSY;
 			}
 		}
-		ane_h16_power_down(h);
+		ane_h16_power_down(h, "system sleep");
 		WRITE_ONCE(h->slept, true);
 		return 0;
 	}
@@ -605,7 +605,7 @@ static int ane_h16_sleep_prepare(struct ane_h16_device *h)
 		ane_h16_session_sleep(&h->session, false);
 		return ret;
 	}
-	ane_h16_power_down(h);
+	ane_h16_power_down(h, "system sleep");
 	WRITE_ONCE(h->slept, true);
 	return 0;
 }
@@ -703,11 +703,10 @@ static void ane_h16_idle_work(struct work_struct *work)
 		ane_h16_idle_arm(h);
 		return;
 	}
-	ane_h16_power_down(h);
+	ane_h16_power_down(h, "idle, no program loaded");
 	WRITE_ONCE(h->slept, true);
 	h->parked = true;
 	WRITE_ONCE(s->parked, true);
-	dev_dbg(h->dev, "H16 ANE: powered off while idle\n");
 }
 
 /* ops->wake: the cold boot of a system resume, for one request. */
@@ -1752,6 +1751,9 @@ static int ane_h16_program_stage(struct ane_h16_device *h)
 	h->program_ready = true;
 	ane_h16_irq_wait_set(h, true);
 	ane_h16_idle_arm(h);
+	if (READ_ONCE(h16_idle_off_ms) && h->boot.soc->sleep_cold && !h->boot.soc->sleep_warm)
+		dev_info(h->dev, "H16 ANE: powers off after %u ms idle with no program loaded\n",
+			 READ_ONCE(h16_idle_off_ms));
 	dev_info(h->dev, "H16 stage 5 program window %llx..%llx%s\n", h->program_next,
 		 h->program_end - 1, h->clpc ? ", CLPC input attached" : "");
 	return 0;
@@ -1814,7 +1816,7 @@ static int ane_h16_advance(struct ane_h16_device *h, enum ane_h16_stage stage)
 		}
 	}
 	dev_info(h->dev, "H16 stage %s complete%s\n", ane_h16_stage_name(stage),
-		 h->boot.ran ? "; held until reboot" : "");
+		 h->boot.ran ? "; firmware and mappings kept until reboot" : "");
 	return 0;
 refuse:
 	/* The identify-only stop is the platform's design, not a failure. */
-- 
2.43.0

