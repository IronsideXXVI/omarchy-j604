From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 7 Nov 2026 07:59:48 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: Enable the video decoder

The J604 ADT has /arm-io/avd (avd,t8103 compatible, avd-version 4,
interrupts 948 and 949) and /arm-io/dart-avd, and the J604 has the decoder
firmware (avd-fw: apple/avd-fw-v5-t1.bin) and the VA-API driver
(libva-v4l2_request-avd) installed; only the device tree was missing.

Enable the decoder, its DART and their power domain, ps_avd_sys (PMGR
device 0x9d, AVD_SYS), which no other J604 node uses. apple-avd
(CONFIG_VIDEO_APPLE_AVD=m in the official configuration) then autoloads,
boots the decoder's CM3 and registers a V4L2 stateless decoder for
H.264, HEVC, VP9 and AV1. The decoder is runtime-active only while frames
are in flight (100 ms autosuspend) and the DART follows it through its
runtime-PM device link, so the domain can stay off on an idle desktop.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi | 3 ++-
 arch/arm64/boot/dts/apple/t8132-j604.dts       | 9 +++++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
index fe3d622b56..33b74ca8d6 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-pmgr.dtsi
@@ -433,8 +433,9 @@
 	status = "disabled";
 };
 
+/* The video decoder and its DART (ADT /arm-io/avd, dart-avd). */
 &ps_avd_sys {
-	status = "disabled";
+	status = "okay";
 };
 
 &ps_sep {
diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index e84afe2cb2..c6eebebae9 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -764,6 +764,15 @@
 	status = "okay";
 };
 
+/* ADT /arm-io/avd (avd-version 4) and /arm-io/dart-avd */
+&avd_dart {
+	status = "okay";
+};
+
+&avd {
+	status = "okay";
+};
+
 &aop_dart {
 	status = "okay"; /* DTV-AUD-4 */
 };
