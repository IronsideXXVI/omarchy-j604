+static void ane_h16_shared_note(void *ctx, const char *event, u64 dva, u64 size, u32 tag)
+{
+	struct ane_h16_device *h = ctx;
+
+	dev_info(h->dev, "H16 SHAREDMALLOC %s bytes %llx tag %08x DVA %llx\n",
+		 event, size, tag, dva);
+}
