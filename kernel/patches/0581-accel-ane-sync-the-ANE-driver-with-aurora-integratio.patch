+#include <linux/of_address.h>
+#include <linux/of_device.h>
+#include <linux/of_irq.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/soc/apple/clpc.h>
+#include <linux/suspend.h>
+
+#include "ane_fw_cold.h"
+#include "ane_fw_sleep.h"
+#include "ane_h16_accel.h"
+
+#define ANE_FW_POOL_DVA 0x10000384000ULL
+#define ANE_FW_IPC_DVA 0x100003d0000ULL
+#define ANE_FW_HEAP_DVA 0x100003e4000ULL
+#define ANE_FW_ALLOC_DVA 0x10001300000ULL
+#define ANE_FW_TIMEOUT_NS (3ULL * NSEC_PER_SEC)
+
+enum ane_fw_stage {
+	ANE_STAGE_UNVERIFIED,
+	ANE_STAGE_PROBED,
+	ANE_STAGE_MAPPED,
+	ANE_STAGE_BOOTED,
+	ANE_STAGE_STARTUP,
+	ANE_STAGE_PROGRAM,
+	ANE_STAGE_QUARANTINED,
+};
+
+struct ane_fw_mapping {
+	struct list_head list;
+	struct ane_fw_surface surface;
+	dma_addr_t physical;
+};
+
+struct ane_fw_backend {
+	struct platform_device *pdev;
+	const struct ane_fw_platform *soc;
+	void __iomem *engine, *pmgr, *gate, *dart[ANE_FW_DARTS];
+	/* Mapped register windows, for the MMIO trace hook. */
+	struct {
+		void __iomem *base;
+		phys_addr_t pa;
+		resource_size_t size;
+	} window[3 + ANE_FW_DARTS];
+	struct device *power, *memory;
+	struct iommu_domain *domain;
+	struct ane_fw_transport transport;
+	/* Programs and their ABI 3 node, after the program stage. */
+	struct ane_h16_session session;
+	struct apple_clpc_ane *clpc;
+	struct ane_fw_surface pool, ipc, heap;
+	/*
+	 * For the cold boot after system sleep: the private TEXT/DATA copies,
+	 * the reserved preload they came from (no-map and untouched, since the
+	 * firmware runs from the copies), the digest DATA had, the heap tail.
+	 */
+	struct ane_fw_surface preload[2], heap_tail;
+	u64 preload_phys[2];
+	u8 data_digest[SHA256_DIGEST_SIZE];
+	/* Powered down for system sleep; a (cold or warm) boot is due. */
+	bool slept;
+	/* The last cold boot after sleep: firmware ready, first replay, count. */
+	u64 resume_ready_ns, resume_first_ns;
+	unsigned int resume_replayed;
+	/*
+	 * EXCLAVE_MODE_STOP completed in this firmware boot: the warm boots
+	 * keep the firmware out of Exclave mode. Cleared by every cold boot.
+	 */
+	bool exclave_mode_stopped;
+	/* The bound device holds ANE_SYS for a hand-off until the bring-up does. */
+	bool bind_held;
+	/* SET_SNE_PMU_BASE2 completed in this firmware boot. */
+	bool pmu_base_set;
+	/* The engine's own ANE_SYS reference (b->power) is held. */
+	bool power_ref;
+	struct list_head mappings;
+	/* Serialize stage changes, command publication and retained lifetimes. */
+	struct mutex lock;
+	struct notifier_block pm_notifier;
+	/*
+	 * genpd's own ANE_SYS power transitions, which during system sleep
+	 * happen only in the noirq phase: counted, with the PMGR state read
+	 * back at each, so a wake can say whether the domain really went off.
+	 */
+	struct notifier_block genpd_nb;
+	bool genpd_nb_added;
+	unsigned int sys_offs, sys_ons;
+	u32 sys_off_pmgr, sys_on_pmgr;
+	u64 sys_off_at, sys_off_ns;
+	struct ane_fw_cold_state cold;
+	u64 ranges[ANE_FW_DAPF_RANGES * 2];
+	u64 next_dva;
+	enum ane_fw_stage stage;
+	bool retained;
+	/* Brings the engine up to the program stage after a loader hand-off. */
+	struct work_struct start;
+	/* ANE_SYS and the child power states are on: the engine is readable. */
+	bool powered;
+};
+
+/* One ANE per SoC. The observer exists before platform driver registration:
+ * the platform bus would otherwise resume genpd and attach DMA before probe.
+ */
+static struct ane_fw_backend *ane_backend;
+/* The H17 platform device, bound by ane_fw_staged_bind(). */
+static struct device *ane_fw_bound_dev;
+
+/* The bring-up holds ANE_SYS itself now: drop the bind's hand-off reference. */
+static void ane_fw_bind_release(struct ane_fw_backend *b)
+{
+	if (!b->bind_held)
+		return;
+	b->bind_held = false;
+	pm_runtime_put(&b->pdev->dev);
+}
+
+/*
+ * Every register access of this backend goes through these helpers, so a
+ * debug build can log the physical address of each access before it is
+ * made. The hook is empty here.
+ */
+static inline void ane_fw_trace(struct ane_fw_backend *b, char op, const void __iomem *a,
+				u64 value)
+{
+}
+
+static u32 ane_rd32(struct ane_fw_backend *b, const void __iomem *a)
+{
+	ane_fw_trace(b, 'r', a, 0);
+	return readl(a);
+}
+
+static u64 ane_rd64(struct ane_fw_backend *b, const void __iomem *a)
+{
+	ane_fw_trace(b, 'R', a, 0);
+	return readq(a);
+}
+
+static void ane_wr32(struct ane_fw_backend *b, u32 value, void __iomem *a)
+{
+	ane_fw_trace(b, 'w', a, value);
+	writel(value, a);
+}
+
+static void ane_wr64(struct ane_fw_backend *b, u64 value, void __iomem *a)
+{
+	ane_fw_trace(b, 'W', a, value);
+	writeq(value, a);
+}
+
+static int ane_poll32(struct ane_fw_backend *b, void __iomem *a, u32 mask, u32 want,
+		      unsigned long sleep_us, u64 timeout_us)
+{
+	u32 value;
+
+	ane_fw_trace(b, 'p', a, want);
+	return readl_poll_timeout(a, value, (value & mask) == want, sleep_us, timeout_us);
+}
+static struct kexec_blocker ane_fw_kexec = {
+	.users = ATOMIC_INIT(0),
+	.reason = "ANE firmware retains private DMA mappings until hardware reset",
+};
+
+static int ane_fw_quarantine(struct ane_fw_backend *b, int error)
+{
+	unsigned int i;
+
+	b->stage = ANE_STAGE_QUARANTINED;
+	dev_err(&b->pdev->dev, "ANE quarantined (%d); mappings and power retained, reboot required\n",
+		error);
+	/* The engine and DARTs are only readable once powered. */
+	if (!b->powered)
+		return error;
+	for (i = 0; i < 8; i++)
+		dev_info(&b->pdev->dev, "scratch%u=%#x\n", i,
+			 ane_rd32(b, b->engine + b->soc->scratch + i * 4));
+	for (i = 0; i < ANE_FW_DARTS; i++)
+		dev_info(&b->pdev->dev, "DART%u error=%#x address=%#x:%#x\n", i,
+			 ane_rd32(b, b->dart[i] + 0x100), ane_rd32(b, b->dart[i] + 0x174),
+			 ane_rd32(b, b->dart[i] + 0x170));
+	return error;
+}
+
+static bool ane_fw_raw_boot(void)
+{
+	struct device_node *chosen __free(device_node) = of_find_node_by_path("/chosen");
+	const char *evidence;
+
+	return chosen && !of_property_read_string(chosen, "apple,ane-cold-boot", &evidence) &&
+	       !strcmp(evidence, ANE_FW_COLD_BOOT_EVIDENCE);
+}
+
+/*
+ * Step 1: PMGR words only. These are the only reads made with ANE_SYS in an
+ * unknown power state; the engine block and its DARTs sit behind ANE_SYS and
+ * an access to them while it is off stalls the bus.
+ */
+static void ane_fw_snapshot_pmgr(struct ane_fw_backend *b)
+{
+	struct ane_fw_cold_state *s = &b->cold;
+
+	s->sys = ane_rd32(b, b->pmgr + 0x290);
+	s->cpu = ane_rd32(b, b->pmgr + 0xc000);
+	s->subblock = ane_rd32(b, b->pmgr + 0xc008);
+	dev_info(&b->pdev->dev, "U2 ANE_SYS=%#x CPU_PS=%#x subblock=%#x\n",
+		 s->sys, s->cpu, s->subblock);
+}
+
+/* Step 2: PWGATE, with ANE_SYS on and before the child power step. */
+static void ane_fw_snapshot_gate(struct ane_fw_backend *b)
+{
+	struct ane_fw_cold_state *s = &b->cold;
+
+	s->gate_request = ane_rd32(b, b->gate + 0xc);
+	s->gate_ack = ane_rd32(b, b->gate + 0x30);
+	dev_info(&b->pdev->dev, "U2 PWGATE=%#x/%#x\n", s->gate_request, s->gate_ack);
+}
+
+/* Step 3: the engine and its DARTs, after the child power step. */
+static void ane_fw_snapshot_engine(struct ane_fw_backend *b)
+{
+	struct ane_fw_cold_state *s = &b->cold;
+	struct device *dev = &b->pdev->dev;
+	unsigned int i, j;
+
+	s->ce_state = ane_rd64(b, b->engine + 0x18a4010);
+	s->ce_error = ane_rd64(b, b->engine + 0x18a4018);
+	s->rvbar = ane_rd64(b, b->engine + 0x1050000);
+	s->control = ane_rd32(b, b->engine + b->soc->wrapper + 0x44);
+	s->status = ane_rd32(b, b->engine + b->soc->wrapper + 0x48);
+	s->pending = ane_rd32(b, b->engine + b->soc->irq_status);
+	for (i = 0; i < 8; i++)
+		s->scratch[i] = ane_rd32(b, b->engine + b->soc->scratch + i * 4);
+	dev_info(dev, "U2 control=%#x status=%#x RVBAR=%#llx CE=%#llx/%#llx pending=%#x\n",
+		 s->control, s->status, s->rvbar, s->ce_state, s->ce_error, s->pending);
+	for (i = 0; i < ANE_FW_DARTS; i++) {
+		s->dart[i].version = ane_rd32(b, b->dart[i] + 8);
+		s->dart[i].protect = ane_rd32(b, b->dart[i] + 0x200);
+		s->dart[i].unprotect = ane_rd32(b, b->dart[i] + 0x204);
+		s->dart[i].lock = ane_rd32(b, b->dart[i] + 0x208);
+		s->dart[i].error = ane_rd32(b, b->dart[i] + 0x100);
+		for (j = 0; j < 16; j++)
+			s->dart[i].enabled[j] = ane_rd32(b, b->dart[i] + 0xc00 + 4 * j);
+		dev_info(dev, "U2 DART%u version=%#x protect=%#x unprotect=%#x lock=%#x error=%#x\n",
+			 i, s->dart[i].version, s->dart[i].protect,
+			 s->dart[i].unprotect, s->dart[i].lock, s->dart[i].error);
+		for (j = 0; j < 16; j++)
+			if (s->dart[i].enabled[j])
+				dev_info(dev, "U2 DART%u stream enable word %u=%#x\n", i, j,
+					 s->dart[i].enabled[j]);
+	}
+	for (i = 0; i < ANE_FW_DAPF_RANGES; i++) {
+		void __iomem *r = b->engine + 0x1810000 + i * 0x40;
+
+		dev_info(dev, "U2 DAPF%u flags=%#x start=%#llx end=%#llx enable=%#x\n",
+			 i, ane_rd32(b, r), ane_rd64(b, r + 8), ane_rd64(b, r + 0x10),
+			 ane_rd32(b, r + 0x20));
+	}
+}
+
+static int ane_fw_power_up(struct ane_fw_backend *b, bool raw_boot, bool cold_engine);
+static int ane_fw_dapf(struct ane_fw_backend *b);
+static int ane_fw_scratch_wait(struct ane_fw_backend *b, unsigned int cell, u32 wanted);
+
+/*
+ * System sleep the macOS way (SPEC-ANE-SLEEP.md, t-4515): the firmware is
+ * suspended, not torn down. At PM_SUSPEND_PREPARE the session is closed to
+ * new requests, the firmware gets SUSPEND (0x24), the engine is power gated
+ * (sub-block, PWGATE, CPU, then ANE_SYS through genpd); every mapping, the
+ * live TEXT/DATA copies, pool, IPC, heap, shared allocations and programs
+ * stay as they are. After resume the engine is powered again, the DART and
+ * DAPF state the power-off lost is restored, CE is brought up, and the CPU is
+ * released with SCRATCH7 = 1, the warm-boot argument, so the same firmware
+ * instance resumes. Programs, processes and transport cursors survive; no
+ * LOAD or CREATE is replayed. A failure before the power-off refuses the
+ * sleep and keeps everything; a failure after it quarantines.
+ */
+#define ANE_FW_CMD_SUSPEND 0x24
+#define ANE_FW_WARM_BOOT 1
+
+/*
+ * Two system sleep paths, chosen by the platform's sleep_warm flag:
+ * - cold (the H17 default): the engine is powered off with no firmware
+ *   cooperation; after resume the firmware is booted again from the
+ *   kernel-held preload and every open program is replayed (LOAD, CREATE)
+ *   behind its existing handle, so applications see no change;
+ * - warm: EXCLAVE_MODE_STOP (0x31, once per firmware boot), SUSPEND (0x24),
+ *   WFI, power-off, then a warm boot with SCRATCH7 = 1 that keeps the
+ *   firmware and its programs (SPEC-ANE-SLEEP-H17.md). On 25G83 0x24 is
+ *   still not taken after 0x31 (C7). A failed warm boot falls back to the
+ *   cold one.
+ */
+#define ane_fw_sleep_warm(b) ((b)->soc->sleep_warm)
+#define ANE_FW_SUSPEND_REPORT_MAX 0x100
+
+static int ane_fw_command(struct ane_fw_backend *b, unsigned int channel,
+			  void *command, size_t size, u64 deadline);
+static u64 ane_fw_load64(void *ctx, const void *p);
+
+/* Scratch, wrapper status and the IO slot, around the sleep handshake. */
+static void ane_fw_sleep_trace(struct ane_fw_backend *b, const char *when, u8 *slot)
+{
+	void __iomem *scratch = b->engine + b->soc->scratch;
+	u8 *t2h, *shm;
+
+	dev_info(&b->pdev->dev,
+		 "H17 ANE: %s: scratch %#x %#x %#x %#x %#x %#x %#x %#x wrapper %#x\n", when,
+		 ane_rd32(b, scratch), ane_rd32(b, scratch + 4), ane_rd32(b, scratch + 8),
+		 ane_rd32(b, scratch + 12), ane_rd32(b, scratch + 16), ane_rd32(b, scratch + 20),
+		 ane_rd32(b, scratch + 24), ane_rd32(b, scratch + 28),
+		 ane_rd32(b, b->engine + b->soc->wrapper + 0x48));
+	if (slot)
+		dev_info(&b->pdev->dev, "H17 ANE: %s: IO slot %#llx %#llx %#llx, IO head %u\n",
+			 when, ane_fw_load64(b, slot), ane_fw_load64(b, slot + 8),
+			 ane_fw_load64(b, slot + 16), b->transport.head[ANE_FW_IO]);
+	t2h = ane_fw_transport_slot(&b->transport, ANE_FW_IO_T2H);
+	shm = ane_fw_transport_slot(&b->transport, ANE_FW_SHAREDMALLOC);
+	dev_info(&b->pdev->dev,
+		 "H17 ANE: %s: T2H head %u %#llx %#llx %#llx, SHAREDMALLOC head %u %#llx %#llx %#llx, irq %#x\n",
+		 when, b->transport.head[ANE_FW_IO_T2H], ane_fw_load64(b, t2h),
+		 ane_fw_load64(b, t2h + 8), ane_fw_load64(b, t2h + 16),
+		 b->transport.head[ANE_FW_SHAREDMALLOC], ane_fw_load64(b, shm),
+		 ane_fw_load64(b, shm + 8), ane_fw_load64(b, shm + 16),
+		 ane_rd32(b, b->engine + b->soc->irq_status));
+}
+
+/*
+ * Wait for the SUSPEND reply. In C2 (boot 0d5a5af9) the firmware took the
+ * command: its log gained a task hand-off record at the SUSPEND time, but the
+ * IO slot never completed. ane_fw_transport_wait() serves SHAREDMALLOC only;
+ * here every T2H report the firmware posts meanwhile is also logged and
+ * acknowledged, the way the session pump does during EXECUTE.
+ */
+static int ane_fw_suspend_wait(struct ane_fw_backend *b)
+{
+	struct ane_fw_transport *t = &b->transport;
+	unsigned int reports = 0, shared = 0;
+	u64 start = ktime_get_ns(), now;
+	u32 pending, seen = 0;
+	size_t size;
+	u8 *report;
+	int ret;
+
+	report = kmalloc(ANE_FW_SUSPEND_REPORT_MAX, GFP_KERNEL);
+	if (!report)
+		return -ENOMEM;
+	for (;;) {
+		ret = ane_fw_transport_poll(t, ANE_FW_IO);
+		if (ret != -EAGAIN)
+			break;
+		ret = ane_fw_transport_consume(t, report, ANE_FW_SUSPEND_REPORT_MAX, &size);
+		if (!ret) {
+			reports++;
+			dev_info(&b->pdev->dev, "H17 ANE: report %u during SUSPEND (%zu bytes): %*ph\n",
+				 reports, size, (int)min_t(size_t, size, 64), report);
+			continue;
+		}
+		if (ret != -EAGAIN)
+			break;
+		ret = ane_fw_transport_irq(t, &pending);
+		if (ret)
+			break;
+		seen |= pending;
+		ret = ane_fw_transport_shared(t);
+		if (!ret)
+			shared++;
+		else if (ret != -EAGAIN)
+			break;
+		now = ktime_get_ns();
+		if (now >= t->pending[ANE_FW_IO].deadline_ns) {
+			ret = ane_fw_transport_fail(t, -ETIMEDOUT);
+			break;
+		}
+		t->polls++;
+		t->ops->relax(t->ctx, now - start);
+	}
+	dev_info(&b->pdev->dev,
+		 "H17 ANE: SUSPEND wait %d after %llu us: %u reports, %u allocations, irq seen %#x\n",
+		 ret, div_u64(ktime_get_ns() - start, NSEC_PER_USEC), reports, shared, seen);
+	kfree(report);
+	return ret;
+}
+
+/*
+ * Leave the firmware's Exclave mode before SUSPEND, once per firmware boot:
+ * the 24-byte zero-body EXCLAVE_MODE_STOP on the control ring, with its
+ * normal completion. Linux has no Exclave state, so the warm wake never
+ * starts the mode again (no 0x30) and later cycles skip this step.
+ */
+static int ane_fw_exclave_mode_stop(struct ane_fw_backend *b)
+{
+	struct ane_fw_transport *t = &b->transport;
+	struct device *dev = &b->pdev->dev;
+	u32 ch = t->control_ch;
+	u64 before[3] = {};
+	int published, ret;
+	u8 *slot = NULL;
+
+	if (!b->soc->exclave_mode_stop || b->exclave_mode_stopped)
+		return 0;
+	if (ch < ANE_FW_CHANNELS) {
+		slot = ane_fw_transport_slot(t, ch);
+		for (unsigned int i = 0; i < 3; i++)
+			before[i] = ane_fw_load64(b, slot + 8 * i);
+	}
+	published = ane_fw_transport_publish_mode_stop(t, ktime_get_ns() + ANE_FW_TIMEOUT_NS);
+	ret = published ?: ane_fw_transport_wait(t, ch);
+	if (ret) {
+		const struct ane_fw_transaction *tx = &t->pending[ch < ANE_FW_CHANNELS ? ch : 0];
+
+		dev_err(dev, "H17 ANE: EXCLAVE_MODE_STOP (0x31) failed %d in %s on %s (table position %d); no SUSPEND, no power-off\n",
+			ret, published ? "publish" : "wait", ane_fw_channel_name(ch),
+			ch < ANE_FW_CHANNELS ? (int)t->channels[ch].index : -1);
+		dev_err(dev, "H17 ANE: 0x31 transport error %d raised at ane_fw_transport.h:%u\n",
+			t->error, t->error_line);
+		if (slot) {
+			dev_err(dev, "H17 ANE: 0x31 slot head %u before %#llx %#llx %#llx after %#llx %#llx %#llx\n",
+				t->head[ch], before[0], before[1], before[2],
+				ane_fw_load64(b, slot), ane_fw_load64(b, slot + 8),
+				ane_fw_load64(b, slot + 16));
+		}
+		/* Only a published command has its copy in the pool. */
+		if (slot && !published)
+			dev_err(dev, "H17 ANE: 0x31 command at %#llx size %zu: %*ph\n", tx->dva,
+				tx->size, ANE_FW_MODE_STOP_SIZE,
+				(u8 *)t->pool.cpu + (tx->dva - t->pool.dva));
+		return ret;
+	}
+	b->exclave_mode_stopped = true;
+	dev_info(&b->pdev->dev, "H17 ANE: EXCLAVE_MODE_STOP (0x31) completed on channel %u\n",
+		 t->channels[t->control_ch].index);
+	return 0;
+}
+
+static int ane_fw_suspend_firmware(struct ane_fw_backend *b)
+{
+	u8 command[8] = {};
+	u8 *slot;
+	u32 status;
+	int ret;
+
+	if (b->transport.error)
+		return b->transport.error;
+	for (unsigned int ch = 0; ch < ANE_FW_CHANNELS; ch++)
+		if (b->transport.pending[ch].active)
+			return -EBUSY;
+	/* Answer any SHAREDMALLOC request already posted (a late FREE). */
+	ret = ane_fw_transport_settle(&b->transport, 2 * NSEC_PER_MSEC, 20 * NSEC_PER_MSEC);
+	if (ret < 0)
+		return ret;
+	ret = ane_fw_exclave_mode_stop(b);
+	if (ret) {
+		ane_h16_session_dump_fwlog(&b->session);
+		return ret;
+	}
+	put_unaligned_le16(ANE_FW_CMD_SUSPEND, command + 4);
+	ane_fw_sleep_trace(b, "before SUSPEND", NULL);
+	slot = ane_fw_transport_slot(&b->transport, ANE_FW_IO);
+	dev_info(&b->pdev->dev, "H17 ANE: SUSPEND %*ph on IO head %u slot %#llx %#llx %#llx\n",
+		 (int)sizeof(command), command, b->transport.head[ANE_FW_IO],
+		 ane_fw_load64(b, slot), ane_fw_load64(b, slot + 8), ane_fw_load64(b, slot + 16));
+	ret = ane_fw_transport_publish(&b->transport, ANE_FW_IO, command, sizeof(command),
+				       ktime_get_ns() + ANE_FW_TIMEOUT_NS);
+	if (!ret)
+		ret = ane_fw_suspend_wait(b);
+	if (!ret)
+		memcpy(command, b->pool.cpu + b->transport.pending[ANE_FW_IO].dva - b->pool.dva,
+		       sizeof(command));
+	ane_fw_sleep_trace(b, ret ? "SUSPEND failed" : "SUSPEND done", slot);
+	if (ret && ane_fw_load64(b, slot) == b->transport.pending[ANE_FW_IO].dva)
+		dev_err(&b->pdev->dev, "H17 ANE: 0x24 not consumed; Exclave mode suspected\n");
+	if (ret) {
+		/* What the firmware made of it, if anything. */
+		ane_h16_session_dump_fwlog(&b->session);
+		return ret;
+	}
+	dev_info(&b->pdev->dev, "H17 ANE: SUSPEND reply %*ph\n", (int)sizeof(command), command);
+	if (get_unaligned_le16(command + 6))
+		return -EREMOTEIO;
+	dev_info(&b->pdev->dev, "H17 ANE: SUSPEND acknowledged, wrapper status %#x\n",
+		 ane_rd32(b, b->engine + b->soc->wrapper + 0x48));
+	/*
+	 * Wait for the ANE CPU to idle in WFI (ASC wrapper status). The held
+	 * H16 shutdown reads 0x6e against the 0x6a reset value; this takes
+	 * bit 2 as the idle indication. TODO(t-4515): confirm the bit.
+	 */
+	ret = ane_poll32(b, b->engine + b->soc->wrapper + 0x48, BIT(2), BIT(2), 10, 1000000);
+	status = ane_rd32(b, b->engine + b->soc->wrapper + 0x48);
+	dev_info(&b->pdev->dev, "H17 ANE: firmware suspended, wrapper status %#x\n", status);
+	return ret;
+}
+
+static const u8 ane_fw_text_pin[SHA256_DIGEST_SIZE];
+static int ane_fw_boot(struct ane_fw_backend *b);
+static int ane_fw_startup(struct ane_fw_backend *b);
+static int ane_fw_rvbar_ready(struct ane_fw_backend *b);
+
+/* Reverse of the proven power-up: sub-block, PWGATE, CPU, then ANE_SYS. */
+static int ane_fw_power_down(struct ane_fw_backend *b)
+{
+	u32 sys;
+	int ret;
+
+	ane_wr32(b, ane_rd32(b, b->pmgr + 0xc008) & ~0xf, b->pmgr + 0xc008);
+	ret = ane_poll32(b, b->pmgr + 0xc008, 0xf0, 0, 1, 100000);
+	if (ret)
+		return ret;
+	ane_wr32(b, 3, b->gate + 0xc);
+	ret = ane_poll32(b, b->gate + 0xc, 3, 3, 1, 100000);
+	if (ret)
+		return ret;
+	ane_wr32(b, ane_rd32(b, b->pmgr + 0xc000) & ~0xf, b->pmgr + 0xc000);
+	ret = ane_poll32(b, b->pmgr + 0xc000, 0xf0, 0, 1, 100000);
+	if (ret)
+		return ret;
+	/* No engine or DART access from here until ANE_SYS is back on. */
+	b->powered = false;
+	b->power_ref = false;
+	pm_runtime_put_sync(b->power);
+	/*
+	 * PMGR reads are safe in any power state. ANE_SYS's actual state
+	 * (bits 7:4) reads 0 once genpd has really turned the domain off.
+	 */
+	sys = ane_rd32(b, b->pmgr + 0x290);
+	/*
+	 * Here only requested: while other devices of the domain (the ANE
+	 * DARTs) are active, genpd turns it off in the noirq phase of the
+	 * system suspend; the genpd notifier records when it really does.
+	 */
+	dev_info(&b->pdev->dev,
+		 "H17 ANE: powered down for system sleep; ANE_SYS requested off, %s at the put (%#x)\n",
+		 sys & 0xf0 ? "still on" : "off", sys);
+	return 0;
+}
+
+/*
+ * After resume: power up from the cold child state, give SID0 its
+ * translation back and the DAPF records, bring CE up, then release the CPU
+ * into the retained firmware with the warm-boot argument.
+ */
+static int ane_fw_warm_boot(struct ane_fw_backend *b)
+{
+	struct device *dev = &b->pdev->dev;
+	void __iomem *scratch = b->engine + b->soc->scratch;
+	unsigned int i;
+	int ret;
+
+	ret = ane_fw_power_up(b, true, false);
+	if (ret)
+		return ret;
+	/*
+	 * The DART lost SID0's translation registers with ANE_SYS; attaching
+	 * the retained domain again rewrites them from its page tables and
+	 * synchronizes the TLB. TODO(hardware): check the cold ANE DART
+	 * profile accepts the detach.
+	 */
+	iommu_detach_device(b->domain, dev);
+	ret = iommu_attach_device(b->domain, dev);
+	if (ret)
+		return ret;
+	ret = ane_fw_dapf(b);
+	if (ret)
+		return ret;
+	/* RVBAR must name TEXT: retained, or written again after a real power-off. */
+	ret = ane_fw_rvbar_ready(b);
+	if (ret)
+		return ret;
+	for (i = 0; i < 8; i++)
+		ane_wr32(b, 0, scratch + i * 4);
+	ane_wr32(b, 1, scratch + 6 * 4);
+	ane_wr32(b, ANE_FW_WARM_BOOT, scratch + 7 * 4);
+	ane_wr32(b, 0, b->engine + b->soc->wrapper + 0x44);
+	dma_wmb();
+	ane_wr32(b, 0x10, b->engine + b->soc->wrapper + 0x44);
+	ret = ane_fw_scratch_wait(b, 7, 0x08042006);
+	dev_info(dev, "H17 ANE: warm boot RVBAR %#llx SCRATCH7 %#x wrapper status %#x (%d)\n",
+		 b->cold.rvbar, ane_rd32(b, scratch + 7 * 4),
+		 ane_rd32(b, b->engine + b->soc->wrapper + 0x48), ret);
+	if (ret)
+		return ret;
+	/* The retained channel table must be what the firmware still uses. */
+	ret = ane_fw_transport_check(&b->transport);
+	if (ret)
+		return ret;
+	dev_info(dev, "H17 ANE: firmware resumed (warm boot); programs kept\n");
+	return 0;
+}
+
+/*
+ * RVBAR must name TEXT before the CPU is released. It keeps the latched
+ * entry while ANE_SYS stays on; if a real power-off cleared it, the entry
+ * is written again, which the RVBAR lifecycle allows only while bit 0
+ * (latched) is clear.
+ */
+static int ane_fw_rvbar_ready(struct ane_fw_backend *b)
+{
+	u64 text = b->soc->preload_dva[0];
+	u64 rvbar = ane_rd64(b, b->engine + 0x1050000);
+
+	switch (ane_fw_rvbar_check(rvbar, text)) {
+	case ANE_FW_RVBAR_LATCHED:
+		return 0;
+	case ANE_FW_RVBAR_WRITABLE:
+		ane_wr64(b, text, b->engine + 0x1050000);
+		dev_info(&b->pdev->dev, "H17 ANE: RVBAR was %#llx; wrote %#llx, reads %#llx\n",
+			 rvbar, text, ane_rd64(b, b->engine + 0x1050000));
+		rvbar = ane_rd64(b, b->engine + 0x1050000);
+		return rvbar == text || rvbar == (text | 1) ? 0 : -EIO;
+	default:
+		dev_err(&b->pdev->dev, "H17 ANE: RVBAR %#llx latched at another entry\n", rvbar);
+		return -EIO;
+	}
+}
+
+/* Copy one preload segment back from its reservation and check its digest. */
+static int ane_fw_reload_segment(struct ane_fw_backend *b, unsigned int i)
+{
+	struct ane_fw_surface *s = &b->preload[i];
+	u8 digest[SHA256_DIGEST_SIZE];
+	void *source;
+
+	if (!s->cpu || !b->preload_phys[i])
+		return -ENODATA;
+	source = memremap(b->preload_phys[i], s->size, MEMREMAP_WB);
+	if (!source)
+		return -ENOMEM;
+	memcpy(s->cpu, source, s->size);
+	memunmap(source);
+	dma_wmb();
+	sha256(s->cpu, s->size, digest);
+	return memcmp(digest, i ? b->data_digest : ane_fw_text_pin, sizeof(digest)) ?
+	       -EKEYREJECTED : 0;
+}
+
+/*
+ * After resume, the cold way: power up from the cold state with the same
+ * checks as at boot (the engine and DARTs must read their reset values),
+ * give SID0 its translation back and the DAPF records, put back pristine
+ * TEXT and DATA and clean heap, pool and IPC, then run the boot handshake
+ * and startup as start-at-boot does. The shared allocations are carried
+ * into the new transport and served again; programs loaded before are lost.
+ * Every wait is bounded (power polls, READY, ANE_FW_TIMEOUT_NS commands).
+ */
+static int ane_fw_cold_cycle_boot(struct ane_fw_backend *b)
+{
+	struct device *dev = &b->pdev->dev;
+	struct ane_fw_transport *old;
+	u64 start = ktime_get_ns();
+	int ret;
+
+	/*
+	 * We powered it down ourselves: the cold PMGR state is our evidence.
+	 * The engine either lost power (reset values) or kept it with the CPU
+	 * stopped by its power state (C4: status 0x62, CE 0x5, DAPF kept);
+	 * either boots from the preload once the DARTs are clean and RVBAR
+	 * names TEXT.
+	 */
+	ret = ane_fw_power_up(b, true, false);
+	if (ret)
+		return ret;
+	/*
+	 * Whether the engine registers kept their values (DAPF, status 0x62)
+	 * although genpd really turned ANE_SYS off says whether they live in
+	 * an always-on block.
+	 */
+	dev_info(dev, "H17 ANE: cold cycle finds the engine %s after ANE_SYS %s (status %#x, DAPF0 %#x)\n",
+		 ane_fw_cold_engine_valid(&b->cold) ? "at its reset values" :
+		 "with registers kept", b->sys_offs ? "really went off" : "stayed on",
+		 b->cold.status, ane_rd32(b, b->engine + 0x1810000));
+	if (!ane_fw_cold_engine_restartable(&b->cold))
+		return -EPERM;
+	ret = ane_fw_rvbar_ready(b);
+	if (ret)
+		return ret;
+	iommu_detach_device(b->domain, dev);
+	ret = iommu_attach_device(b->domain, dev);
+	if (ret)
+		return ret;
+	ret = ane_fw_dapf(b);
+	if (ret)
+		return ret;
+	ret = ane_fw_reload_segment(b, 0);
+	if (!ret)
+		ret = ane_fw_reload_segment(b, 1);
+	if (ret)
+		return ret;
+	memset(b->heap.cpu, 0, b->heap.size);
+	if (b->heap_tail.cpu)
+		memset(b->heap_tail.cpu, 0, b->heap_tail.size);
+	memset(b->pool.cpu, 0, b->pool.size);
+	memset(b->ipc.cpu, 0, b->ipc.size);
+	dma_wmb();
+	old = kmemdup(&b->transport, sizeof(*old), GFP_KERNEL);
+	if (!old)
+		return -ENOMEM;
+	ret = ane_fw_boot(b);
+	if (!ret)
+		ane_fw_transport_carry_shared(&b->transport, old);
+	kfree(old);
+	if (!ret)
+		ret = ane_fw_startup(b);
+	if (ret)
+		return ret;
+	b->transport.allow_free = true;
+	b->resume_ready_ns = ktime_get_ns();
+	dev_info(dev, "H17 ANE: booted again from the preload after system sleep in %llu ms\n",
+		 div_u64(b->resume_ready_ns - start, NSEC_PER_MSEC));
+	/* Every open program back behind its handle, as the application left it. */
+	ane_h16_session_restart(&b->session);
+	ret = ane_h16_session_replay(&b->session, &b->resume_replayed, &b->resume_first_ns);
+	if (ret) {
+		dev_err(dev, "H17 ANE: PROGRAM REPLAY FAILED %d after %u programs; session quarantined\n",
+			ret, b->resume_replayed);
+		WARN_ONCE(1, "H17 ANE: program replay failed after system sleep (%d)\n", ret);
+	}
+	return ret;
+}
+
+/* The cold way down: nothing in flight, then power off under the firmware. */
+static int ane_fw_cold_cycle_down(struct ane_fw_backend *b)
+{
+	for (unsigned int ch = 0; ch < ANE_FW_CHANNELS; ch++)
+		if (b->transport.pending[ch].active)
+			return -EBUSY;
+	return ane_fw_power_down(b);
+}
+
+static int ane_fw_sleep_prepare(struct ane_fw_backend *b)
+{
+	int ret;
+
+	guard(mutex)(&b->lock);
+	/*
+	 * A quarantined engine that never came up has nothing to lose; give
+	 * back an ANE_SYS reference a failed power-up kept.
+	 */
+	if (b->stage == ANE_STAGE_QUARANTINED && !b->powered) {
+		if (b->power_ref) {
+			b->power_ref = false;
+			pm_runtime_put_sync(b->power);
+		}
+		return 0;
+	}
+	/*
+	 * Quarantined and still powered: its state was dumped when it was
+	 * quarantined. Power it off without the firmware so that the system
+	 * can sleep; it stays quarantined and is not booted again.
+	 */
+	if (b->stage == ANE_STAGE_QUARANTINED) {
+		ret = ane_fw_power_down(b);
+		dev_info(&b->pdev->dev, "H17 ANE: quarantined engine powered off for system sleep (%d)\n",
+			 ret);
+		return ret;
+	}
+	if (b->stage != ANE_STAGE_PROGRAM)
+		return -EBUSY;
+	ane_h16_session_sleep(&b->session, true);
+	b->sys_offs = 0;
+	b->sys_ons = 0;
+	b->sys_off_ns = 0;
+	b->sys_off_at = 0;
+	b->sys_off_pmgr = 0;
+	b->sys_on_pmgr = 0;
+	if (!ane_fw_sleep_warm(b)) {
+		ret = ane_fw_cold_cycle_down(b);
+		if (ret == -EBUSY) {
+			/* Nothing was written: refuse this sleep and keep running. */
+			ane_h16_session_sleep(&b->session, false);
+			return ret;
+		}
+	} else {
+		ret = ane_fw_suspend_firmware(b);
+		if (!ret)
+			ret = ane_fw_power_down(b);
+	}
+	if (ret) {
+		/*
+		 * Powered, maybe suspended: the firmware state is uncertain.
+		 * Keep power and every mapping, refuse the sleep and close the
+		 * session (SPEC-ANE-SLEEP.md section 6).
+		 */
+		ane_fw_quarantine(b, ret);
+		b->session.quarantined = true;
+		ane_h16_session_sleep(&b->session, false);
+		return ret;
+	}
+	b->slept = true;
+	return 0;
+}
+
+/* Called by genpd under its lock, in the noirq phase too: record only. */
+static int ane_fw_genpd_event(struct notifier_block *nb, unsigned long action, void *data)
+{
+	struct ane_fw_backend *b = container_of(nb, struct ane_fw_backend, genpd_nb);
+	u64 now = ktime_get_boottime_ns();
+
+	if (action == GENPD_NOTIFY_OFF) {
+		b->sys_offs++;
+		b->sys_off_pmgr = ane_rd32(b, b->pmgr + 0x290);
+		b->sys_off_at = now;
+	} else if (action == GENPD_NOTIFY_ON) {
+		b->sys_ons++;
+		b->sys_on_pmgr = ane_rd32(b, b->pmgr + 0x290);
+		if (b->sys_off_at)
+			b->sys_off_ns += now - b->sys_off_at;
+		b->sys_off_at = 0;
+	}
+	return NOTIFY_OK;
+}
+
+static void ane_fw_sleep_resume(struct ane_fw_backend *b)
+{
+	s64 ready, first;
+	u64 start;
+	int ret;
+
+	guard(mutex)(&b->lock);
+	if (!b->slept)
+		return;
+	b->slept = false;
+	start = ktime_get_ns();
+	b->resume_ready_ns = 0;
+	b->resume_first_ns = 0;
+	b->resume_replayed = 0;
+	ret = ane_fw_sleep_warm(b) ? ane_fw_warm_boot(b) : ane_fw_cold_cycle_boot(b);
+	if (ret && ane_fw_sleep_warm(b)) {
+		/* Fall back to the cold cycle: off again, then boot from the preload. */
+		dev_warn(&b->pdev->dev, "H17 ANE: warm boot failed (%d); cold boot and program replay\n",
+			 ret);
+		ret = b->powered ? ane_fw_power_down(b) : 0;
+		if (!ret)
+			ret = ane_fw_cold_cycle_boot(b);
+	}
+	if (ret) {
+		/* Every mapping and backing stays for diagnosis. */
+		ane_fw_quarantine(b, ret);
+		b->session.quarantined = true;
+	}
+	ane_h16_session_sleep(&b->session, false);
+	/* genpd's record of the domain across this sleep (boot time, so it counts s2idle). */
+	dev_info(&b->pdev->dev,
+		 "H17 ANE: ANE_SYS while asleep: genpd off %u, on %u, off for %llu ms; PMGR %#x at off, %#x at on\n",
+		 b->sys_offs, b->sys_ons, div_u64(b->sys_off_ns, NSEC_PER_MSEC),
+		 b->sys_off_pmgr, b->sys_on_pmgr);
+	/* One line per wake; times from PM_POST_SUSPEND, which follows the thaw. */
+	ready = b->resume_ready_ns ? div_u64(b->resume_ready_ns - start, NSEC_PER_MSEC) : -1;
+	first = b->resume_first_ns ? div_u64(b->resume_first_ns - start, NSEC_PER_MSEC) : -1;
+	dev_info(&b->pdev->dev,
+		 "H17 ANE: resume %s: firmware ready %lld ms, first program ready %lld ms, node reopened %llu ms, %u programs replayed\n",
+		 ret ? "FAILED" : "ok", ready, first,
+		 div_u64(ktime_get_ns() - start, NSEC_PER_MSEC), b->resume_replayed);
+}
+
+static int ane_fw_pm_event(struct notifier_block *nb, unsigned long event, void *unused)
+{
+	struct ane_fw_backend *b = container_of(nb, struct ane_fw_backend, pm_notifier);
+	bool retained = READ_ONCE(b->retained);
+
+	if (event == PM_POST_SUSPEND) {
+		ane_fw_sleep_resume(b);
+		return NOTIFY_DONE;
+	}
+	if (event == PM_SUSPEND_PREPARE && retained) {
+		if (!ane_fw_sleep_prepare(b))
+			return NOTIFY_DONE;
+		dev_warn_once(&b->pdev->dev, ANE_FW_SLEEP_REFUSED);
+		return NOTIFY_BAD;
+	}
+	/* Hibernation and restore stay refused. */
+	if (ane_fw_sleep_refused_cycle(event, retained, true)) {
+		dev_warn_once(&b->pdev->dev, ANE_FW_SLEEP_REFUSED);
+		return NOTIFY_BAD;
+	}
+	return NOTIFY_DONE;
+}
+
+static int ane_fw_retain(struct ane_fw_backend *b)
+{
+	int ret;
+
+	/*
+	 * The kexec blocker takes built-in users only. A module, like the H16
+	 * backend, pins itself and refuses system sleep, but cannot veto kexec.
+	 */
+	if (IS_BUILTIN(CONFIG_DRM_ACCEL_ANE)) {
+		ret = kexec_block(&ane_fw_kexec);
+		if (ret)
+			return ret;
+	}
+	b->pm_notifier.notifier_call = ane_fw_pm_event;
+	ret = register_pm_notifier(&b->pm_notifier);
+	if (ret) {
+		if (IS_BUILTIN(CONFIG_DRM_ACCEL_ANE))
+			kexec_unblock(&ane_fw_kexec);
+		return ret;
+	}
+	__module_get(THIS_MODULE);
+	b->retained = true;
+	return 0;
+}
+
+static int ane_fw_map(struct ane_fw_backend *b, u64 dva, phys_addr_t pa,
+		      size_t size, int prot)
+{
+	int ret = iommu_map(b->domain, dva, pa, size, prot, GFP_KERNEL);
+
+	if (ret)
+		return ret;
+	/* iommu_map includes the DART's normal range synchronization and
+	 * propagates its timeout. Extra invalidates do not fix stale output
+	 * BAR bindings between programs; the transport's queued first EXECUTE
+	 * after a program change does.
+	 */
+	for (unsigned int i = 0; i < ANE_FW_DARTS; i++)
+		if (ane_rd32(b, b->dart[i] + 0x100))
+			return -EIO;
+	return 0;
+}
+
+/*
+ * Coherent (uncached) memory for firmware-owned state, or, with cached,
+ * CPU-cacheable memory for program surfaces that the CPU copies to and from
+ * on every request. The engine does not snoop either; cached surfaces are
+ * kept coherent by ane_fw_program_sync() around each use.
+ */
+static int ane_fw_alloc_mem(struct ane_fw_backend *b, u64 dva, size_t size,
+			    int prot, bool cached, struct ane_fw_surface *s)
+{
+	struct ane_fw_mapping *m;
+	int ret;
+
+	m = kzalloc_obj(*m);
+	if (!m)
+		return -ENOMEM;
+	if (cached)
+		m->surface.cpu = dma_alloc_noncoherent(b->memory, size, &m->physical,
+						       DMA_BIDIRECTIONAL, GFP_KERNEL);
+	else
+		m->surface.cpu = dma_alloc_coherent(b->memory, size, &m->physical,
+						    GFP_KERNEL);
+	if (!m->surface.cpu) {
+		kfree(m);
+		return -ENOMEM;
+	}
+	if (cached) {
+		/* Zero it and write the zeroes back before the engine sees it. */
+		memset(m->surface.cpu, 0, size);
+		dma_sync_single_for_device(b->memory, m->physical, size, DMA_BIDIRECTIONAL);
+		m->surface.handle = m->physical;
+	}
+	m->surface.dva = dva;
+	m->surface.size = size;
+	/* Record before publication, including a failed/partial mapping. */
+	list_add_tail(&m->list, &b->mappings);
+	ret = ane_fw_map(b, dva, m->physical, size, prot);
+	if (!ret)
+		*s = m->surface;
+	return ret;
+}
+
+static int ane_fw_alloc_at(struct ane_fw_backend *b, u64 dva, size_t size,
+			   int prot, struct ane_fw_surface *s)
+{
+	return ane_fw_alloc_mem(b, dva, size, prot, false, s);
+}
+
+static int ane_fw_alloc(void *ctx, size_t size, u32 tag, struct ane_fw_surface *s)
+{
+	struct ane_fw_backend *b = ctx;
+	int ret;
+
+	if (!size || size > ANE_FW_SHARED_TOTAL ||
+	    b->next_dva > ANE_FW_ALLOC_DVA + SZ_512M - size)
+		return -ENOSPC;
+	ret = ane_fw_alloc_at(b, b->next_dva, size, IOMMU_READ | IOMMU_WRITE, s);
+	if (!ret) {
+		b->next_dva += size;
+		dev_info(&b->pdev->dev, "SHAREDMALLOC tag=%#x bytes=%zu\n", tag, size);
+	}
+	return ret;
+}
+
+static u64 ane_fw_load64(void *ctx, const void *p)
+{
+	return le64_to_cpu(READ_ONCE(*(__le64 *)p));
+}
+
+static void ane_fw_store64(void *ctx, void *p, u64 value)
+{
+	WRITE_ONCE(*(__le64 *)p, cpu_to_le64(value));
+}
+
+static void ane_fw_rmb(void *ctx)
+{
+	dma_rmb();
+}
+
+static void ane_fw_wmb(void *ctx)
+{
+	dma_wmb();
+}
+
+static u32 ane_fw_read32(void *ctx, u32 reg)
+{
+	struct ane_fw_backend *b = ctx;
+
+	return ane_rd32(b, b->engine + reg);
+}
+
+static void ane_fw_write32(void *ctx, u32 reg, u32 value)
+{
+	struct ane_fw_backend *b = ctx;
+
+	ane_wr32(b, value, b->engine + reg);
+	if (reg == b->soc->irq_ack) {
+		/* Complete the snapshot acknowledgment before coherent ring reads. */
+		mb();
+	}
+}
+
+static u64 ane_fw_now(void *ctx)
+{
+	return ktime_get_ns();
+}
+
+/*
+ * Every wait polls, with the shared pacing (see ane_fw_poll_sleep_us()):
+ * busy steps for the first 30 us, then short sleeps, backing off for long
+ * waits such as a stalled request.
+ */
+static void ane_fw_relax(void *ctx, u64 waited_ns)
+{
+	ane_fw_poll_pause(waited_ns);
+}
+
+static void ane_fw_refused(void *ctx, u64 word0, u64 word1, u64 word2, int error)
+{
+	struct ane_fw_backend *b = ctx;
+
+	dev_info(&b->pdev->dev, "SHAREDMALLOC refused tuple=%#llx/%#llx/%#llx error=%d\n",
+		 word0, word1, word2, error);
+}
+
+static void ane_fw_cold_shared_note(void *ctx, const char *event, u64 dva, u64 size, u32 tag)
+{
+	struct ane_fw_backend *b = ctx;
+
+	dev_info(&b->pdev->dev, "SHAREDMALLOC %s tag=%#x bytes=%llu dva=%#llx\n",
+		 event, tag, size, dva);
+}
+
+static const struct ane_fw_transport_ops ane_fw_ops = {
+	.load64 = ane_fw_load64, .store64 = ane_fw_store64,
+	.read_barrier = ane_fw_rmb, .write_barrier = ane_fw_wmb,
+	.read32 = ane_fw_read32, .write32 = ane_fw_write32,
+	.now_ns = ane_fw_now, .relax = ane_fw_relax,
+	.alloc = ane_fw_alloc, .refused = ane_fw_refused,
+	.shared_note = ane_fw_cold_shared_note,
+};
+
+/*
+ * Power in the order the H17 U2 runs measured: genpd ANE_SYS on, PWGATE read,
+ * CPU power state on, PWGATE request cleared, sub-block power state on. Only
+ * then are the engine and DARTs read and checked for their reset state, before
+ * Linux writes anything to the engine. A failed check after power-on retains
+ * power and mappings until reboot, like any other quarantine.
+ */
+static int ane_fw_power(struct ane_fw_backend *b, bool raw_boot)
+{
+	struct device *dev = &b->pdev->dev;
+	int ret;
+
+	/*
+	 * The bound device carries ANE_SYS itself (platform_probe attached it
+	 * to its single domain), so genpd sees the engine's own reference.
+	 */
+	if (!dev->pm_domain || !ane_fw_bound_dev)
+		return -ENODEV;
+	b->power = dev;
+	ret = ane_fw_power_up(b, raw_boot, true);
+	/* The bring-up holds ANE_SYS now (or keeps it, quarantined). */
+	ane_fw_bind_release(b);
+	return ret;
+}
+
+/*
+ * ANE_SYS on, then the child power steps from the cold state, then (for a
+ * cold boot) the engine's reset values, and CE. At boot and again after a
+ * power-down for sleep.
+ */
+static int ane_fw_power_up(struct ane_fw_backend *b, bool raw_boot, bool cold_engine)
+{
+	struct device *dev = &b->pdev->dev;
+	u64 ce;
+	int ret;
+
+	/* Taken once; a failed attempt keeps it for the retry or the quarantine. */
+	if (!b->power_ref) {
+		ret = pm_runtime_resume_and_get(b->power);
+		if (ret < 0)
+			return ret;
+		b->power_ref = true;
+	}
+	if ((ane_rd32(b, b->pmgr + 0x290) & 0xff) != 0xff)
+		return -EIO;
+	/* The child state may not have moved since the probe stage. */
+	ane_fw_snapshot_pmgr(b);
+	ane_fw_snapshot_gate(b);
+	if (!ane_fw_cold_pmgr_valid(&b->cold, raw_boot) || !ane_fw_cold_gate_valid(&b->cold)) {
+		dev_info(dev, "H17 ANE: child power or gate not in the cold state; refusing\n");
+		return -EPERM;
+	}
+	ane_wr32(b, ane_rd32(b, b->pmgr + 0xc000) | 0xf, b->pmgr + 0xc000);
+	ret = ane_poll32(b, b->pmgr + 0xc000, 0xff, 0xff, 1, 100000);
+	if (ret)
+		return ret;
+	ane_wr32(b, 0, b->gate + 0xc);
+	ret = ane_poll32(b, b->gate + 0xc, 3, 0, 1, 100000);
+	if (ret)
+		return ret;
+	ane_wr32(b, ane_rd32(b, b->pmgr + 0xc008) | 0xf, b->pmgr + 0xc008);
+	ret = ane_poll32(b, b->pmgr + 0xc008, 0xff, 0xff, 1, 100000);
+	if (ret)
+		return ret;
+	ret = ane_poll32(b, b->gate + 0x30, U32_MAX, 0, 1, 100000);
+	if (ret)
+		return ret;
+	b->powered = true;
+	ane_fw_snapshot_engine(b);
+	/* A warm resume finds a suspended firmware's state, not reset values. */
+	if (cold_engine && !ane_fw_cold_engine_valid(&b->cold)) {
+		dev_info(dev, "H17 ANE: engine or DART not in its reset state; refusing\n");
+		return -EPERM;
+	}
+	ane_wr64(b, 3, b->engine + 0x18a4000);
+	ane_fw_trace(b, 'P', b->engine + 0x18a4008, 3);
+	ret = readq_poll_timeout(b->engine + 0x18a4008, ce, (ce & 3) == 3, 1, 100000);
+	if (ret)
+		return ret;
+	ane_wr64(b, 3, b->engine + 0x18a4008);
+	if ((ane_rd64(b, b->engine + 0x18a4010) & 3) != 3 ||
+	    ane_rd64(b, b->engine + 0x18a4018))
+		return -EIO;
+	dev_info(dev, "ANE power: ANE_SYS on, child/PWGATE/CE ready\n");
+	return 0;
+}
+
+static int ane_fw_dapf(struct ane_fw_backend *b)
+{
+	unsigned int i;
+
+	for (i = 0; i < ANE_FW_DAPF_RANGES; i++) {
+		void __iomem *r = b->engine + 0x1810000 + i * 0x40;
+		u64 start = b->ranges[i * 2], end = b->ranges[i * 2 + 1];
+
+		if (ane_rd32(b, b->dart[0] + 0x208) & BIT(2))
+			return -EPERM;
+		ane_wr32(b, 0x31, r);
+		ane_wr32(b, lower_32_bits(start), r + 8);
+		ane_wr32(b, upper_32_bits(start), r + 0xc);
+		ane_wr32(b, lower_32_bits(end), r + 0x10);
+		ane_wr32(b, upper_32_bits(end), r + 0x14);
+		ane_wr32(b, 1, r + 0x20);
+		if ((ane_rd32(b, r) & 0x333) != 0x31 || ane_rd64(b, r + 8) != start ||
+		    ane_rd64(b, r + 0x10) != end || (ane_rd32(b, r + 0x20) & 0xffff) != 1)
+			return -EIO;
+	}
+	return 0;
+}
+
+/*
+ * The measured 26.6.2 H17 TEXT. A different firmware build is refused before
+ * anything is powered or written.
+ */
+static const u8 ane_fw_text_pin[SHA256_DIGEST_SIZE] = {
+	0xcd, 0xa0, 0x9e, 0xc1, 0xae, 0xe6, 0x8b, 0x88,
+	0xb4, 0x7e, 0xdc, 0x0e, 0xeb, 0xc8, 0x10, 0x45,
+	0x25, 0x32, 0xa8, 0x55, 0x56, 0x3f, 0xbd, 0x65,
+	0x0b, 0x95, 0xe2, 0x84, 0x6c, 0x34, 0x53, 0x10,
+};
+
+/*
+ * The loader's preload hand-off. apple,preload-data-sha256 is optional: with
+ * it the private DATA copy must match the loader's digest of what it handed
+ * off; without it, the live DATA at copy time (ane_fw_preload()).
+ */
+static int ane_fw_preload_metadata(struct ane_fw_backend *b, u64 physical[2],
+				   u64 size[2], u64 dva[2], u8 data_pin[SHA256_DIGEST_SIZE],
+				   bool *have_data_pin)
+{
+	struct device_node *np = b->pdev->dev.of_node;
+	unsigned int i;
+	int ret;
+
+	if (!of_property_read_bool(np, "apple,firmware-preloaded") ||
+	    of_property_count_u32_elems(np, "memory-region") != 2 ||
+	    of_property_read_u64_array(np, "apple,firmware-iovas", dva, 2))
+		return -ENODATA;
+	*have_data_pin = !of_property_read_u8_array(np, "apple,preload-data-sha256",
+						     data_pin, SHA256_DIGEST_SIZE);
+	/* The same no-map, outside-System-RAM rule as the H16 preload. */
+	for (i = 0; i < 2; i++) {
+		const char *name;
+
+		if (of_property_read_string_index(np, "memory-region-names", i, &name) ||
+		    strcmp(name, i ? "firmware-data" : "firmware-text"))
+			return -EINVAL;
+		ret = ane_fw_preload_range(np, i, &physical[i], &size[i]);
+		if (ret)
+			return ret;
+	}
+	if (!ane_fw_preload_ranges_valid(b->soc, physical, size, dva))
+		return -EINVAL;
+	return 0;
+}
+
+static int ane_fw_preload(struct ane_fw_backend *b)
+{
+	u64 physical[2], size[2], dva[2], tail, tail_size;
+	struct ane_fw_surface snapshots[2], heap_tail;
+	u8 digest[SHA256_DIGEST_SIZE], data_pin[SHA256_DIGEST_SIZE];
+	bool have_data_pin;
+	unsigned int i;
+	int ret;
+
+	ret = ane_fw_preload_metadata(b, physical, size, dva, data_pin, &have_data_pin);
+	if (ret)
+		return ret;
+	for (i = 0; i < 2; i++) {
+		void *source = memremap(physical[i], size[i], MEMREMAP_WB);
+		struct sha256_ctx hash;
+
+		if (!source)
+			return -ENOMEM;
+		/* Without a loader digest, the copy must match the live DATA. */
+		if (i && !have_data_pin)
+			sha256(source, size[i], data_pin);
+		ret = ane_fw_alloc_at(b, dva[i], size[i],
+				      IOMMU_READ | (i ? IOMMU_WRITE : 0), &snapshots[i]);
+		if (!ret) {
+			memcpy(snapshots[i].cpu, source, size[i]);
+			b->preload[i] = snapshots[i];
+			b->preload_phys[i] = physical[i];
+		}
+		memunmap(source);
+		if (ret)
+			return ret;
+		sha256_init(&hash);
+		sha256_update(&hash, snapshots[i].cpu, size[i]);
+		sha256_final(&hash, digest);
+		if (memcmp(digest, i ? data_pin : ane_fw_text_pin, sizeof(digest)))
+			return -EKEYREJECTED;
+	}
+	/* Preserve every personalized DATA byte, including the iBoot TLV table. */
+	dma_wmb();
+	memcpy(b->data_digest, data_pin, sizeof(b->data_digest));
+	ret = ane_fw_heap_tail(dva, size, ANE_FW_POOL_DVA, &tail, &tail_size);
+	if (ret || !tail_size)
+		return ret;
+	/* Zeroed by the coherent allocation; kept until reset like the preload. */
+	ret = ane_fw_alloc_at(b, tail, tail_size, IOMMU_READ | IOMMU_WRITE, &heap_tail);
+	if (!ret)
+		b->heap_tail = heap_tail;
+	if (!ret)
+		dev_info(&b->pdev->dev, "ANE map: firmware heap tail at %#llx bytes %#llx\n",
+			 tail, tail_size);
+	return ret;
+}
+
+static int ane_fw_prepare(struct ane_fw_backend *b)
+{
+	struct device *dev = &b->pdev->dev;
+	unsigned int i;
+	int ret;
+
+	ret = ane_fw_power(b, ane_fw_raw_boot());
+	if (ret)
+		return ret;
+	ret = of_dma_configure(dev, dev->of_node, true);
+	if (ret)
+		return ret;
+	ret = iommu_device_claim_dma_owner(dev, b);
+	if (ret)
+		return ret;
+	b->domain = iommu_paging_domain_alloc(dev);
+	if (IS_ERR(b->domain))
+		return PTR_ERR(b->domain);
+	ret = iommu_attach_device(b->domain, dev);
+	if (ret)
+		return ret;
+	if (!(b->domain->pgsize_bitmap & SZ_16K) || !b->domain->ops->iotlb_sync_map ||
+	    b->domain->geometry.aperture_start ||
+	    b->domain->geometry.aperture_end < ANE_FW_ALLOC_DVA + SZ_512M)
+		return -ERANGE;
+	b->memory = root_device_register("ane-fw-memory");
+	if (IS_ERR(b->memory))
+		return PTR_ERR(b->memory);
+	ret = dma_coerce_mask_and_coherent(b->memory, DMA_BIT_MASK(64));
+	if (ret)
+		return ret;
+	ret = ane_fw_preload(b);
+	if (ret)
+		return ret;
+	for (i = 0; i < ANE_FW_DAPF_RANGES; i++) {
+		u64 page = round_down(b->ranges[i * 2], SZ_16K);
+
+		ret = ane_fw_map(b, page, page, SZ_16K, IOMMU_READ | IOMMU_WRITE | IOMMU_MMIO);
+		if (ret)
+			return ret;
+	}
+	ret = ane_fw_dapf(b);
+	if (ret)
+		return ret;
+	ret = ane_fw_alloc_at(b, ANE_FW_POOL_DVA, SZ_256K,
+			      IOMMU_READ | IOMMU_WRITE, &b->pool);
+	if (ret)
+		return ret;
+	ret = ane_fw_alloc_at(b, ANE_FW_IPC_DVA, SZ_64K,
+			      IOMMU_READ | IOMMU_WRITE, &b->ipc);
+	if (ret)
+		return ret;
+	ret = ane_fw_alloc_at(b, ANE_FW_HEAP_DVA, 15 * SZ_1M,
+			      IOMMU_READ | IOMMU_WRITE, &b->heap);
+	if (!ret)
+		dev_info(dev, "ANE map: reserved preload, SID0 on three DARTs, DAPF verified\n");
+	return ret;
+}
+
+static int ane_fw_scratch_wait(struct ane_fw_backend *b, unsigned int cell, u32 wanted)
+{
+	return ane_poll32(b, b->engine + b->soc->scratch + cell * 4, U32_MAX, wanted,
+			  100, 3000000);
+}
+
+static int ane_fw_boot(struct ane_fw_backend *b)
+{
+	void __iomem *scratch = b->engine + b->soc->scratch;
+	u8 *init = b->pool.cpu + 0x180;
+	u64 table;
+	unsigned int i;
+	int ret;
+
+	/* A cold boot starts the firmware in Exclave mode again. */
+	b->exclave_mode_stopped = false;
+	for (i = 0; i < 8; i++)
+		ane_wr32(b, 0, scratch + i * 4);
+	ane_wr32(b, 1, scratch + 6 * 4);
+	ane_wr32(b, 0, b->engine + b->soc->wrapper + 0x44);
+	dma_wmb();
+	ane_wr32(b, 0x10, b->engine + b->soc->wrapper + 0x44);
+	ret = ane_fw_scratch_wait(b, 7, 0x08042006);
+	if (ret)
+		return ret;
+	dev_info(&b->pdev->dev, "ANE boot: READY\n");
+	if (ane_rd32(b, scratch) != 8 || ane_rd32(b, scratch + 4) != 0xc440 ||
+	    ane_rd32(b, scratch + 12) != 0xf00000 || ane_rd32(b, scratch + 16))
+		return -EPROTO;
+	put_unaligned_le64(b->ipc.dva, init + 8);
+	put_unaligned_le64(ANE_FW_SPAN, init + 0x10);
+	put_unaligned_le64(0xfc80000, init + 0x18);
+	put_unaligned_le64(b->heap.dva, init + 0x20);
+	put_unaligned_le64(b->heap.size, init + 0x28);
+	put_unaligned_le64(0xc441, init + 0x50);
+	put_unaligned_le64(b->pool.dva, init + 0x58);
+	put_unaligned_le64(b->pool.size, init + 0x60);
+	put_unaligned_le32(64, init + 0x68);
+	put_unaligned_le32(4, init + 0x12c);
+	dma_wmb();
+	ane_wr32(b, lower_32_bits(b->pool.dva + 0x180), scratch);
+	ane_wr32(b, upper_32_bits(b->pool.dva + 0x180), scratch + 4);
+	ane_wr32(b, 0xf7fbdff9, scratch + 7 * 4);
+	ret = ane_fw_scratch_wait(b, 7, 0x08042006);
+	if (ret)
+		return ret;
+	table = (u64)ane_rd32(b, scratch + 4) << 32 | ane_rd32(b, scratch);
+	if (table != b->ipc.dva)
+		return -EPROTO;
+	ret = ane_fw_transport_init(&b->transport, b->soc, &ane_fw_ops, b,
+				    b->ipc, b->pool, 0x4000, table, ANE_FW_TABLE_SIZE);
+	if (ret)
+		return ret;
+	ret = ane_fw_transport_arm(&b->transport);
+	if (ret)
+		return ret;
+	ane_wr32(b, 0x08042006, scratch + 3 * 4);
+	ret = ane_fw_scratch_wait(b, 3, 0);
+	if (!ret)
+		dev_info(&b->pdev->dev, "ANE boot: eight channels armed, scratch3 cleared (polled)\n");
+	/* The firmware's table order, which the macOS channel selectors index. */
+	for (i = 0; !ret && i < ANE_FW_CHANNELS; i++) {
+		const struct ane_fw_channel *c = &b->transport.channels[i];
+
+		dev_info(&b->pdev->dev,
+			 "ANE channel %s: table position %u, type %u, doorbell bit %u, %u slots at IPC +%#llx\n",
+			 ane_fw_channel_name(i), c->index, c->type, c->bit, c->slots, c->offset);
+	}
+	return ret;
+}
+
+static int ane_fw_command(struct ane_fw_backend *b, unsigned int channel,
+			  void *command, size_t size, u64 deadline)
+{
+	struct ane_fw_transaction *tx = &b->transport.pending[channel];
+	int ret;
+
+	ret = ane_fw_transport_publish(&b->transport, channel, command, size, deadline);
+	if (ret)
+		return ret;
+	ret = ane_fw_transport_wait(&b->transport, channel);
+	if (!ret)
+		memcpy(command, b->pool.cpu + tx->dva - b->pool.dva, size);
+	return ret;
+}
+
+/*
+ * SET_SNE_PMU_BASE2 (0x29) on the control ring with the DT "pmgr" range
+ * base, once per cold firmware boot. Without it the 0x24 handler's DM-bus
+ * idle query never completes (C2-C7; SPEC-ANE-SLEEP-H17-r2.md).
+ */
+static int ane_fw_pmu_base(struct ane_fw_backend *b)
+{
+	struct ane_fw_transport *t = &b->transport;
+	u64 base = b->window[1].pa;
+	int ret;
+
+	b->pmu_base_set = false;
+	ret = ane_fw_transport_publish_pmu_base(t, base, ktime_get_ns() + ANE_FW_TIMEOUT_NS);
+	if (!ret)
+		ret = ane_fw_transport_wait(t, t->control_ch);
+	dev_info(&b->pdev->dev, "H17 ANE: SET_SNE_PMU_BASE2 (0x29) %#llx on ring %s: %d\n",
+		 base, ane_fw_channel_name(t->control_ch), ret);
+	if (!ret)
+		b->pmu_base_set = true;
+	return ret;
+}
+
+static int ane_fw_startup(struct ane_fw_backend *b)
+{
+	static const struct { u16 id, size; } commands[] = {
+		{ 4, 12 }, { 0, 12 }, { 3, 16 }, { 0x22, 100 },
+	};
+	u8 command[100];
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(commands); i++) {
+		memset(command, 0, sizeof(command));
+		put_unaligned_le16(commands[i].id, command + 4);
+		ret = ane_fw_command(b, ANE_FW_IO, command, commands[i].size,
+				     ktime_get_ns() + ANE_FW_TIMEOUT_NS);
+		if (ret)
+			return ret;
+		if (commands[i].id == 4 && get_unaligned_le32(command + 8))
+			return -EPROTO;
+		if (commands[i].id == 3 && ane_fw_config_status(command, 16))
+			return -EPROTO;
+		dev_info(&b->pdev->dev, "ANE startup: command %#x ack=0\n", commands[i].id);
+		if (commands[i].id == 3)
+			dev_info(&b->pdev->dev, "ANE CONFIG_GET tick=%u\n",
+				 get_unaligned_le32(command + 8));
+		if (commands[i].id == 0x22)
+			dev_info(&b->pdev->dev, "ANE RESOURCE_INFO: %*ph\n", 100, command);
+		/* macOS order: START, then SET_SNE_PMU_BASE2, then CONFIG_GET. */
+		if (commands[i].id == 0 && b->soc->sleep_warm) {
+			ret = ane_fw_pmu_base(b);
+			if (ret)
+				return ret;
+		}
+	}
+	return 0;
+}
+
+/* Private program mappings come from the same window as SHAREDMALLOC. */
+static int ane_fw_program_map(void *ctx, size_t size, bool write, struct ane_fw_surface *out)
+{
+	struct ane_fw_backend *b = ctx;
+	int ret;
+
+	if (!size || !IS_ALIGNED(size, SZ_16K) ||
+	    b->next_dva > ANE_FW_ALLOC_DVA + SZ_512M - size)
+		return -ENOSPC;
+	ret = ane_fw_alloc_mem(b, b->next_dva, size,
+			       IOMMU_READ | (write ? IOMMU_WRITE : 0), true, out);
+	if (ret)
+		return ret;
+	b->next_dva += size;
+	return 0;
+}
+
+static void ane_fw_program_log(void *ctx, const char *item, u64 a, u64 c)
+{
+	struct ane_fw_backend *b = ctx;
+
+	dev_info(&b->pdev->dev, "H17 %s %llx %llx\n", item, a, c);
+}
+
+/* Program surfaces are cacheable: clean before the engine, invalidate after. */
+static void ane_fw_program_sync(void *ctx, const struct ane_fw_surface *s, bool for_device)
+{
+	struct ane_fw_backend *b = ctx;
+
+	if (for_device)
+		dma_sync_single_for_device(b->memory, s->handle, s->size, DMA_BIDIRECTIONAL);
+	else
+		dma_sync_single_for_cpu(b->memory, s->handle, s->size, DMA_BIDIRECTIONAL);
+}
+
+static void ane_fw_program_busy(void *ctx, bool busy)
+{
+	struct ane_fw_backend *b = ctx;
+
+	apple_clpc_ane_set_active(b->clpc, busy);
+}
+
+static const struct ane_h16_session_ops ane_fw_session_ops = {
+	.map = ane_fw_program_map,
+	.log = ane_fw_program_log,
+	.sync = ane_fw_program_sync,
+	.busy = ane_fw_program_busy,
+};
+
+/*
+ * After startup: the shared program session and its ABI 3 node. From here on
+ * the node serializes all firmware traffic. The firmware frees each process
+ * pool after UNLOAD, often only during a later program, so FREE stays
+ * admitted; backing is retained until reboot.
+ */
+/*
+ * <debugfs>/ane-h17/<dev>/execute: per-phase EXECUTE times of the shared
+ * session, see ane_h16_session_stats_show(). Writing anything resets them.
+ * Created at the program stage; the retained backend pins the module, so
+ * the file and its session live until reboot.
+ */
+static int ane_fw_execute_show(struct seq_file *m, void *v)
+{
+	return ane_h16_session_stats_show(m, m->private);
+}
+
+static int ane_fw_execute_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, ane_fw_execute_show, inode->i_private);
+}
+
+static ssize_t ane_fw_execute_write(struct file *file, const char __user *ubuf,
+				    size_t count, loff_t *ppos)
+{
+	ane_h16_session_stats(((struct seq_file *)file->private_data)->private, NULL, true);
+	return count;
+}
+
+static const struct file_operations ane_fw_execute_fops = {
+	.owner = THIS_MODULE,
+	.open = ane_fw_execute_open,
+	.read = seq_read,
+	.write = ane_fw_execute_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static void ane_fw_debugfs(struct ane_fw_backend *b)
+{
+	struct dentry *root = debugfs_lookup("ane-h17", NULL);
+	bool found = root;
+
+	if (!found)
+		root = debugfs_create_dir("ane-h17", NULL);
+	debugfs_create_file("execute", 0600,
+			    debugfs_create_dir(dev_name(&b->pdev->dev), root),
+			    &b->session, &ane_fw_execute_fops);
+	if (found)
+		dput(root);
+}
+
+/*
+ * How long dynamic power gating stays off after the last EXECUTE, as on
+ * H16: toggling it around every request costs the H17 engine about 70 us
+ * (gate open plus gate close) of each back-to-back EXECUTE.
+ */
+#define ANE_FW_GATE_HOLD_NS (2 * NSEC_PER_MSEC)
+
+static int ane_fw_program_stage(struct ane_fw_backend *b)
+{
+	int ret;
+
+	b->transport.allow_free = true;
+	ret = ane_h16_session_init(&b->session, &b->transport, &ane_fw_session_ops, b,
+				   ANE_FW_TIMEOUT_NS);
+	if (ret)
+		return ret;
+	ret = apple_clpc_ane_get(&b->pdev->dev, &b->clpc);
+	if (ret)
+		return ret;
+	b->session.gate_hold_ns = ANE_FW_GATE_HOLD_NS;
+	ret = ane_h16_accel_register(&b->pdev->dev, &b->session);
+	if (ret) {
+		apple_clpc_ane_put(b->clpc);
+		b->clpc = NULL;
+		return ret;
+	}
+	ane_fw_debugfs(b);
+	dev_info(&b->pdev->dev, "ANE program: session and ABI 3 node ready\n");
+	return 0;
+}
+
+static ssize_t firmware_stage_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	static const char * const names[] = {
+		"unverified", "probe", "map", "boot", "startup", "program", "quarantined",
+	};
+	struct ane_fw_backend *b = ane_backend;
+
+	return sysfs_emit(buf, "%s\n", names[READ_ONCE(b->stage)]);
+}
+
+static ssize_t ane_fw_stage_action(struct device *dev, const char *buf, size_t count)
+{
+	struct ane_fw_backend *b = ane_backend;
+	enum ane_fw_stage next;
+	int ret = 0;
+
+	guard(mutex)(&b->lock);
+	if (b->stage == ANE_STAGE_QUARANTINED)
+		return -EIO;
+	if (sysfs_streq(buf, "probe")) {
+		if (b->retained)
+			return -EBUSY;
+		/* PMGR only: ANE_SYS may be off, which makes the engine unreadable. */
+		ane_fw_snapshot_pmgr(b);
+		if (!ane_fw_cold_pmgr_valid(&b->cold, ane_fw_raw_boot())) {
+			dev_info(dev, "H17 ANE: cold acquisition unproven (loader or child power state); refusing\n");
+			return -EPERM;
+		}
+		b->stage = ANE_STAGE_PROBED;
+		dev_info(dev, "ANE probe: raw-boot evidence and cold child power verified; no writes\n");
+		return count;
+	}
+	if (sysfs_streq(buf, "map"))
+		next = ANE_STAGE_MAPPED;
+	else if (sysfs_streq(buf, "boot"))
+		next = ANE_STAGE_BOOTED;
+	else if (sysfs_streq(buf, "startup"))
+		next = ANE_STAGE_STARTUP;
+	else if (sysfs_streq(buf, "program"))
+		next = ANE_STAGE_PROGRAM;
+	else
+		return -EINVAL;
+	if (next != b->stage + 1)
+		return -EINVAL;
+	if (next == ANE_STAGE_MAPPED) {
+		u64 physical[2], size[2], dva[2];
+		u8 data_pin[SHA256_DIGEST_SIZE];
+		bool have_data_pin;
+
+		ane_fw_snapshot_pmgr(b);
+		if (!ane_fw_cold_pmgr_valid(&b->cold, ane_fw_raw_boot())) {
+			dev_info(dev, "H17 ANE: cold acquisition unproven (loader or child power state); refusing\n");
+			return -EPERM;
+		}
+		ret = ane_fw_preload_metadata(b, physical, size, dva, data_pin, &have_data_pin);
+		if (ret) {
+			dev_info(dev, "H17 ANE: loader preload reservation missing; refusing\n");
+			return ret;
+		}
+		ret = ane_fw_retain(b);
+		if (ret)
+			return ret;
+		ret = ane_fw_prepare(b);
+	} else if (next == ANE_STAGE_BOOTED) {
+		ret = ane_fw_boot(b);
+	} else if (next == ANE_STAGE_STARTUP) {
+		ret = ane_fw_startup(b);
+	} else {
+		ret = ane_fw_program_stage(b);
+	}
+	if (ret)
+		return ane_fw_quarantine(b, ret);
+	b->stage = next;
+	return count;
+}
+
+static ssize_t firmware_stage_store(struct device *dev, struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	unsigned int sleep_flags = lock_system_sleep();
+	ssize_t ret = ane_fw_stage_action(dev, buf, count);
+
+	unlock_system_sleep(sleep_flags);
+	return ret;
+}
+static DEVICE_ATTR_RW(firmware_stage);
+
+/*
+ * Read the loader hand-off without touching the engine: the raw-boot marker,
+ * the preload reservations (disabled placeholders until a loader fills them)
+ * and the TEXT segment against the driver's pin.
+ */
+static bool ane_fw_handoff_present(struct platform_device *pdev,
+				   const struct ane_fw_platform *soc, struct ane_fw_handoff *hp)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct device_node *chosen __free(device_node) = of_find_node_by_path("/chosen");
+	struct ane_fw_handoff h = {};
+	u8 digest[SHA256_DIGEST_SIZE];
+	unsigned int i;
+
+	if (chosen)
+		of_property_read_string(chosen, "apple,ane-cold-boot", &h.marker);
+	h.preloaded = of_property_read_bool(np, "apple,firmware-preloaded");
+	h.regions_ok = of_property_count_u32_elems(np, "memory-region") == 2 &&
+		       of_property_count_u64_elems(np, "apple,firmware-iovas") == 2 &&
+		       !of_property_read_u64_array(np, "apple,firmware-iovas", h.dva, 2);
+	for (i = 0; h.regions_ok && i < 2; i++) {
+		const char *name;
+
+		h.regions_ok = !of_property_read_string_index(np, "memory-region-names", i,
+							      &name) &&
+			       !strcmp(name, i ? "firmware-data" : "firmware-text") &&
+			       !ane_fw_preload_range(np, i, &h.phys[i], &h.size[i]);
+	}
+	if (h.regions_ok && ane_fw_preload_ranges_valid(soc, h.phys, h.size, h.dva)) {
+		void *text = memremap(h.phys[0], h.size[0], MEMREMAP_WB);
+
+		if (text) {
+			sha256(text, h.size[0], digest);
+			memunmap(text);
+			h.text_ok = !memcmp(digest, ane_fw_text_pin, sizeof(digest));
+		}
+	}
+	*hp = h;
+	if (ane_fw_cold_handoff_loader_ok(&h, soc))
+		return true;
+	dev_info(&pdev->dev, "H17 ANE: no loader hand-off (%s); leaving the engine alone\n",
+		 !h.marker || strcmp(h.marker, ANE_FW_COLD_BOOT_EVIDENCE) ? "raw-boot marker" :
+		 !h.preloaded || !h.regions_ok ? "preload reservations" :
+		 !h.text_ok ? "firmware TEXT pin" : "preload layout");
+	return false;
+}
+
+/*
+ * Run probe..program once, as the stage file would, so the accel node exists
+ * on every boot with a loader hand-off. A failure stops at that stage; after
+ * acquisition it quarantines, as from the stage file.
+ */
+static void ane_fw_start_work(struct work_struct *work)
+{
+	static const char *const steps[] = { "probe", "map", "boot", "startup", "program" };
+	struct ane_fw_backend *b = container_of(work, struct ane_fw_backend, start);
+	unsigned int i, flags;
+	ssize_t ret;
+
+	for (i = 0; i < ARRAY_SIZE(steps); i++) {
+		flags = lock_system_sleep();
+		ret = ane_fw_stage_action(&b->pdev->dev, steps[i], strlen(steps[i]));
+		unlock_system_sleep(flags);
+		if (ret < 0) {
+			dev_err(&b->pdev->dev, "H17 ANE: boot bring-up stopped at %s, error %zd\n",
+				steps[i], ret);
+			ane_fw_bind_release(b);
+			return;
+		}
+	}
+	dev_info(&b->pdev->dev, "H17 ANE: up at boot, accel node ready\n");
+}
+
+static void ane_fw_observer_free(struct ane_fw_backend *b)
+{
+	unsigned int i;
+
+	for (i = 0; i < ANE_FW_DARTS; i++)
+		if (b->dart[i])
+			iounmap(b->dart[i]);
+	if (b->engine)
+		iounmap(b->engine);
+	if (b->pmgr)
+		iounmap(b->pmgr);
+	if (b->gate)
+		iounmap(b->gate);
+	apple_clpc_ane_put(b->clpc);
+	put_device(&b->pdev->dev);
+	kfree(b);
+}
+
+/* Record a mapped register window; the trace hook names accesses by PA. */
+static int ane_fw_window(struct ane_fw_backend *b, unsigned int index, void __iomem *base,
+			 struct device_node *np, unsigned int reg)
+{
+	struct resource res;
+
+	if (!base)
+		return -ENOMEM;
+	if (of_address_to_resource(np, reg, &res))
+		return -EINVAL;
+	b->window[index].base = base;
+	b->window[index].pa = res.start;
+	b->window[index].size = resource_size(&res);
+	return 0;
+}
+
+int ane_fw_staged_init(struct platform_device *pdev, const struct ane_fw_platform *soc)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct ane_fw_handoff handoff;
+	struct ane_fw_backend *b;
+	unsigned int i;
+	u32 dart_phandles[ANE_FW_DARTS];
+	int ret = -EINVAL;
+
+	if (ane_backend || soc->soc != 0x8140)
+		return -EOPNOTSUPP;
+	/* No hand-off (an older loader, a warm boot): leave the engine alone. */
+	if (!ane_fw_handoff_present(pdev, soc, &handoff))
+		return -ENODEV;
+	b = kzalloc_obj(*b);
+	if (!b)
+		return -ENOMEM;
+	b->pdev = pdev;
+	get_device(&pdev->dev);
+	b->soc = soc;
+	b->next_dva = ANE_FW_ALLOC_DVA;
+	mutex_init(&b->lock);
+	INIT_LIST_HEAD(&b->mappings);
+	if (of_property_count_strings(np, "reg-names") != soc->reg_count ||
+	    of_irq_count(np) != soc->interrupt_count ||
+	    of_count_phandle_with_args(np, "power-domains", "#power-domain-cells") != 1)
+		goto fail;
+	for (i = 0; i < soc->reg_count; i++) {
+		struct resource res;
+		const char *name;
+
+		if (of_address_to_resource(np, i, &res) ||
+		    resource_size(&res) != soc->reg_sizes[i] ||
+		    of_property_read_string_index(np, "reg-names", i, &name) ||
+		    strcmp(name, soc->reg_names[i]))
+			goto fail;
+	}
+	if (of_property_read_u64_array(np, "apple,dapf-ranges", b->ranges,
+				       ARRAY_SIZE(b->ranges)))
+		goto fail;
+	for (i = 0; i < ANE_FW_DAPF_RANGES; i++) {
+		u64 start = b->ranges[i * 2], end = b->ranges[i * 2 + 1];
+
+		if (start > end || round_down(start, SZ_16K) != round_down(end, SZ_16K))
+			goto fail;
+		for (unsigned int j = 0; j < i; j++)
+			if (round_down(start, SZ_16K) == round_down(b->ranges[j * 2], SZ_16K))
+				goto fail;
+	}
+	if (of_count_phandle_with_args(np, "iommus", "#iommu-cells") != ANE_FW_DARTS)
+		goto fail;
+	for (i = 0; i < ANE_FW_DARTS; i++) {
+		struct of_phandle_args args;
+
+		ret = of_parse_phandle_with_args(np, "iommus", "#iommu-cells", i, &args);
+		if (ret)
+			goto fail;
+		if (args.args_count != 1 || args.args[0] ||
+		    !of_device_is_compatible(args.np, "apple,t8140-ane-dart")) {
+			of_node_put(args.np);
+			ret = -EINVAL;
+			goto fail;
+		}
+		for (unsigned int j = 0; j < i; j++) {
+			if (dart_phandles[j] == args.np->phandle) {
+				of_node_put(args.np);
+				ret = -EINVAL;
+				goto fail;
+			}
+		}
+		dart_phandles[i] = args.np->phandle;
+		b->dart[i] = of_iomap(args.np, 0);
+		ret = ane_fw_window(b, 3 + i, b->dart[i], args.np, 0);
+		of_node_put(args.np);
+		if (ret)
+			goto fail;
+	}
+	b->engine = of_iomap(np, 0);
+	b->pmgr = of_iomap(np, 1);
+	b->gate = of_iomap(np, 2);
+	ret = ane_fw_window(b, 0, b->engine, np, 0);
+	if (!ret)
+		ret = ane_fw_window(b, 1, b->pmgr, np, 1);
+	if (!ret)
+		ret = ane_fw_window(b, 2, b->gate, np, 2);
+	if (ret)
+		goto fail;
+	/*
+	 * The marker survives a kexec. Read PMGR (safe in any power state) and
+	 * start only if the ANE CPU and sub-block are still off, never in a
+	 * kdump kernel.
+	 */
+	ane_fw_snapshot_pmgr(b);
+	handoff.pmgr = &b->cold;
+	handoff.crash_kernel = is_kdump_kernel();
+	if (!ane_fw_cold_handoff_valid(&handoff, soc)) {
+		dev_info(&pdev->dev, "H17 ANE: engine not cold (%s); leaving it alone\n",
+			 handoff.crash_kernel ? "kdump kernel" : "CPU or sub-block powered");
+		ret = -ENODEV;
+		goto fail;
+	}
+	ane_backend = b;
+	ret = device_create_file(&pdev->dev, &dev_attr_firmware_stage);
+	if (ret) {
+		ane_backend = NULL;
+		goto fail;
+	}
+	dev_info(&pdev->dev, "H17 ANE: loader hand-off verified; starting the engine\n");
+	INIT_WORK(&b->start, ane_fw_start_work);
+	return 0;
+fail:
+	ane_fw_observer_free(b);
+	return ret;
+}
+
+/*
+ * Bind the H17 platform device. Left unbound, it is a fw_devlink consumer
+ * that never binds, so the PMGR power controller's sync_state never runs and
+ * genpd keeps every boot-on domain under it on, ANE_SYS included, whatever
+ * the backend puts (C4: ANE_SYS stayed on across system sleep). Bound, the
+ * device carries ANE_SYS through its own runtime PM: platform_probe attached
+ * it to its single domain. With a loader hand-off, the engine is powered as
+ * the loader left it, so the bind holds ANE_SYS until the bring-up takes its
+ * own reference (ane_fw_power()) or stops; without one the device is
+ * runtime suspended and the domain is free to go off.
+ */
+int ane_fw_staged_bind(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ane_fw_backend *b = ane_backend;
+	bool handoff = b && b->pdev == pdev;
+	int ret;
+
+	if (ane_fw_bound_dev)
+		return -EBUSY;
+	if (handoff) {
+		ret = pm_runtime_set_active(dev);
+		if (ret)
+			return ret;
+		pm_runtime_get_noresume(dev);
+		b->bind_held = true;
+	}
+	ret = devm_pm_runtime_enable(dev);
+	if (ret) {
+		if (handoff) {
+			b->bind_held = false;
+			pm_runtime_put_noidle(dev);
+			pm_runtime_set_suspended(dev);
+		}
+		return ret;
+	}
+	ane_fw_bound_dev = dev;
+	if (handoff) {
+		b->genpd_nb.notifier_call = ane_fw_genpd_event;
+		b->genpd_nb_added = !dev_pm_genpd_add_notifier(dev, &b->genpd_nb);
+		if (!b->genpd_nb_added)
+			dev_info(dev, "H17 ANE: no genpd notifier; ANE_SYS transitions not recorded\n");
+	}
+	dev_info(dev, "H17 ANE: bound; %s\n", handoff ?
+		 "ANE_SYS held until the bring-up owns it" : "no hand-off, engine left off");
+	return 0;
+}
+
+bool ane_fw_staged_bound(struct device *dev)
+{
+	return dev && dev == ane_fw_bound_dev;
+}
+
+void ane_fw_staged_unbind(struct platform_device *pdev)
+{
+	struct ane_fw_backend *b = ane_backend;
+
+	if (b && b->pdev == pdev) {
+		ane_fw_bind_release(b);
+		if (b->genpd_nb_added)
+			dev_pm_genpd_remove_notifier(&pdev->dev);
+		b->genpd_nb_added = false;
+	}
+	ane_fw_bound_dev = NULL;
+}
+
+/*
+ * Device suspend: the notifier already cycled the engine. A backstop for
+ * running firmware it did not reach (a sleep path that skipped notifiers).
+ */
+int ane_fw_staged_suspend(struct device *dev)
+{
+	struct ane_fw_backend *b = ane_backend;
+	bool running = b && &b->pdev->dev == dev && READ_ONCE(b->retained) &&
+		       READ_ONCE(b->powered) && !READ_ONCE(b->slept) &&
+		       READ_ONCE(b->stage) == ANE_STAGE_PROGRAM;
+
+	if (running)
+		dev_warn_once(dev, ANE_FW_SLEEP_REFUSED);
+	return ane_fw_sleep_backstop(running);
+}
+
+/*
+ * Start the bring-up once the platform driver is registered: its probe of
+ * this device has bound it (ane_fw_staged_bind()) by then and cannot race
+ * the power sequence.
+ */
+void ane_fw_staged_start(void)
+{
+	if (ane_backend)
+		schedule_work(&ane_backend->start);
+}
+
+bool ane_fw_staged_exit(void)
+{
+	struct ane_fw_backend *b = ane_backend;
+
+	if (!b)
+		return false;
+	cancel_work_sync(&b->start);
+	/* A retained backend pins the module. No unload or in-place retry. */
+	if (WARN_ON(b->retained))
+		return true;
+	device_remove_file(&b->pdev->dev, &dev_attr_firmware_stage);
+	ane_backend = NULL;
+	ane_fw_observer_free(b);
+	return true;
+}
diff --git a/drivers/accel/ane/ane_fw_cold.h b/drivers/accel/ane/ane_fw_cold.h
new file mode 100644
index 0000000000..6fc23b417f
--- /dev/null
+++ b/drivers/accel/ane/ane_fw_cold.h
@@ -0,0 +1,186 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_FW_COLD_H__
+#define __ANE_FW_COLD_H__
+
+#include "ane_fw_transport.h"
+
+#define ANE_FW_DARTS 3
+#define ANE_FW_DAPF_RANGES 4
+
+struct ane_fw_cold_state {
+	u32 sys, cpu, subblock, gate_request, gate_ack;
+	u64 ce_state, ce_error, rvbar;
+	u32 control, status, pending, scratch[8];
+	struct {
+		u32 version, protect, unprotect, lock, error;
+		u32 enabled[16];
+	} dart[ANE_FW_DARTS];
+};
+
+/*
+ * Cold acquisition is proved in three steps, each read only once its block is
+ * known to be powered, in the order the H17 U2 runs measured as safe:
+ *
+ * 1. PMGR, readable with ANE_SYS in either state: the ANE CPU and sub-block
+ *    power states are off. ANE_SYS itself may read on or off (fact 5: it can
+ *    be on while genpd reports off, and generic DART runtime PM turns it off),
+ *    so it is no marker.
+ * 2. PWGATE, after ANE_SYS is on: the gate is requested and not acknowledged.
+ * 3. The engine and its DARTs, only after the child power step: CE, CPU and
+ *    wrapper reset values, and unlocked, unfaulted DARTs with no stream on.
+ *    Nothing in the engine has been written by Linux at that point.
+ *
+ * DAPF records and invalid TTBR payloads are random at reset, not markers.
+ */
+static inline bool ane_fw_cold_pmgr_valid(const struct ane_fw_cold_state *s, bool raw_boot)
+{
+	return raw_boot && !(s->cpu & 0xff) && s->subblock == 0x300;
+}
+
+static inline bool ane_fw_cold_gate_valid(const struct ane_fw_cold_state *s)
+{
+	return s->gate_request == 3 && !s->gate_ack;
+}
+
+static inline bool ane_fw_cold_engine_valid(const struct ane_fw_cold_state *s)
+{
+	unsigned int i;
+
+	if ((s->ce_state & 3) || s->ce_error || s->control || s->status != 0x6a ||
+	    s->rvbar != 0x10000000001ULL || s->pending)
+		return false;
+	for (i = 0; i < ARRAY_SIZE(s->scratch); i++)
+		if (s->scratch[i])
+			return false;
+	/*
+	 * Stream enables are not judged: the Linux DART driver enables every
+	 * stream globally when it binds and isolates them through the per-stream
+	 * TCRs, so they read set on every boot once the DARTs are bound.
+	 */
+	for (i = 0; i < ANE_FW_DARTS; i++) {
+		if ((s->dart[i].version & 0xffff) != 0x203 ||
+		    (s->dart[i].protect & BIT(0)) ||
+		    (s->dart[i].lock & (BIT(0) | BIT(2))) || s->dart[i].error)
+			return false;
+	}
+	return true;
+}
+
+/*
+ * After our own power-down for system sleep the engine may have kept power
+ * with its CPU stopped by its PMGR power state, so status, CE, scratch and
+ * DAPF are not judged; what must hold is no DART fault and no DART lock
+ * that blocks re-attaching SID0.
+ */
+static inline bool ane_fw_cold_engine_restartable(const struct ane_fw_cold_state *s)
+{
+	unsigned int i;
+
+	for (i = 0; i < ANE_FW_DARTS; i++)
+		if ((s->dart[i].version & 0xffff) != 0x203 || (s->dart[i].protect & BIT(0)) ||
+		    (s->dart[i].lock & (BIT(0) | BIT(2))) || s->dart[i].error)
+			return false;
+	return true;
+}
+
+/*
+ * RVBAR (engine +0x1050000) and the TEXT entry: latched at TEXT (bit 0 set)
+ * is ready; with bit 0 clear the entry may be written; latched at any other
+ * entry is refused (never write RVBAR while bit 0 is set).
+ */
+enum ane_fw_rvbar {
+	ANE_FW_RVBAR_LATCHED,
+	ANE_FW_RVBAR_WRITABLE,
+	ANE_FW_RVBAR_FOREIGN,
+};
+
+static inline enum ane_fw_rvbar ane_fw_rvbar_check(u64 rvbar, u64 text)
+{
+	if (rvbar == (text | 1))
+		return ANE_FW_RVBAR_LATCHED;
+	return rvbar & 1 ? ANE_FW_RVBAR_FOREIGN : ANE_FW_RVBAR_WRITABLE;
+}
+
+static inline bool ane_fw_cold_valid(const struct ane_fw_cold_state *s, bool raw_boot)
+{
+	return ane_fw_cold_pmgr_valid(s, raw_boot) && ane_fw_cold_gate_valid(s) &&
+	       ane_fw_cold_engine_valid(s);
+}
+
+/* Bytes of firmware memory from the TEXT DVA (boot argument +0x10). */
+#define ANE_FW_SPAN 0x380000ULL
+
+/*
+ * The firmware owns ANE_FW_SPAN bytes from its TEXT DVA, but the bootloader
+ * preload covers only TEXT and DATA. The firmware keeps runtime heap state in
+ * the rest of the span (0x14000 bytes past DATA on the 26.6.2 build), which
+ * the host supplies zeroed and device-writable before boot. Returns the tail
+ * DVA and size (0 when DATA ends the span), or -ERANGE when the layout would
+ * overlap DATA, is not in whole 16 KiB pages, or reaches the command pool.
+ */
+static inline int ane_fw_heap_tail(const u64 dva[2], const u64 size[2], u64 limit,
+				   u64 *tail, u64 *tail_size)
+{
+	u64 start = dva[1] + size[1], end = dva[0] + ANE_FW_SPAN;
+
+	if (dva[1] < dva[0] + size[0] || start < dva[1] || start > end ||
+	    !IS_ALIGNED(start, SZ_16K) || !IS_ALIGNED(end, SZ_16K) || end > limit)
+		return -ERANGE;
+	*tail = start;
+	*tail_size = end - start;
+	return 0;
+}
+
+/* The exact /chosen/apple,ane-cold-boot value a raw loader boot publishes. */
+#define ANE_FW_COLD_BOOT_EVIDENCE "raw-no-xnu-ane-untouched-v1"
+
+/*
+ * What the loader handed off, as read from the DT and the TEXT segment, and
+ * the live state of the engine. marker is /chosen/apple,ane-cold-boot or
+ * NULL; regions_ok says both preload reservations are enabled, no-map, not
+ * reusable and outside System RAM; text_ok that TEXT matches the driver's
+ * firmware pin; pmgr the PMGR words (the only engine-side state readable
+ * whatever the power state); crash_kernel that this is a kdump kernel.
+ */
+struct ane_fw_handoff {
+	const char *marker;
+	bool preloaded;
+	bool regions_ok;
+	u64 phys[2], size[2], dva[2];
+	bool text_ok;
+	const struct ane_fw_cold_state *pmgr;
+	bool crash_kernel;
+};
+
+/* The loader's part: raw-boot evidence, the filled reservations, the TEXT. */
+static inline bool ane_fw_cold_handoff_loader_ok(const struct ane_fw_handoff *h,
+						 const struct ane_fw_platform *soc)
+{
+	return h->marker && !strcmp(h->marker, ANE_FW_COLD_BOOT_EVIDENCE) &&
+	       h->preloaded && h->regions_ok &&
+	       ane_fw_preload_ranges_valid(soc, h->phys, h->size, h->dva) && h->text_ok;
+}
+
+/*
+ * Start at boot only with the whole hand-off and a cold engine. kexec copies
+ * /chosen, marker included, from the running DT, so the marker alone does
+ * not prove this boot's state: the ANE CPU and sub-block must still read off
+ * in PMGR (a kernel that ran the ANE keeps them on), and a kdump kernel is
+ * always warm. Anything less leaves the engine alone.
+ */
+static inline bool ane_fw_cold_handoff_valid(const struct ane_fw_handoff *h,
+					     const struct ane_fw_platform *soc)
+{
+	return ane_fw_cold_handoff_loader_ok(h, soc) && !h->crash_kernel && h->pmgr &&
+	       ane_fw_cold_pmgr_valid(h->pmgr, true);
+}
+
+int ane_fw_staged_init(struct platform_device *pdev, const struct ane_fw_platform *soc);
+int ane_fw_staged_bind(struct platform_device *pdev);
+bool ane_fw_staged_bound(struct device *dev);
+void ane_fw_staged_unbind(struct platform_device *pdev);
+int ane_fw_staged_suspend(struct device *dev);
+void ane_fw_staged_start(void);
+bool ane_fw_staged_exit(void);
+
+#endif /* __ANE_FW_COLD_H__ */
diff --git a/drivers/accel/ane/ane_fw_cold_test.c b/drivers/accel/ane/ane_fw_cold_test.c
new file mode 100644
index 0000000000..d05cb3569f
--- /dev/null
+++ b/drivers/accel/ane/ane_fw_cold_test.c
@@ -0,0 +1,382 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <kunit/test.h>
+#include <linux/module.h>
+#include <linux/soc/apple/clpc.h>
+
+#include "ane_fw_cold.h"
+#include "ane_fw_sleep.h"
+
+static struct ane_fw_cold_state ane_cold_fixture(void)
+{
+	struct ane_fw_cold_state s = {
+		.sys = 0x23ff, .cpu = 0x0f000300, .subblock = 0x300,
+		.gate_request = 3, .rvbar = 0x10000000001, .status = 0x6a,
+	};
+
+	for (unsigned int i = 0; i < ANE_FW_DARTS; i++) {
+		s.dart[i].version = 0x2a2a0203;
+		s.dart[i].protect = i == 2 ? 0 : 2;
+		s.dart[i].unprotect = i == 2 ? 0 : 2;
+		s.dart[i].lock = i == 2 ? 0 : 2;
+	}
+	return s;
+}
+
+static void ane_cold_evidence_test(struct kunit *test)
+{
+	struct ane_fw_cold_state s = ane_cold_fixture();
+
+	KUNIT_EXPECT_TRUE(test, ane_fw_cold_valid(&s, true));
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_valid(&s, false));
+	/*
+	 * ANE_SYS is no marker: it may read on while genpd reports off, and
+	 * generic DART runtime PM powers it off again.
+	 */
+	s.sys = 0x2300;
+	KUNIT_EXPECT_TRUE(test, ane_fw_cold_valid(&s, true));
+}
+
+/*
+ * Each step judges only what its power state makes readable: the probe
+ * step only PMGR words, so a warm engine cannot fail it, and the engine
+ * step nothing in PMGR.
+ */
+static void ane_cold_step_test(struct kunit *test)
+{
+	struct ane_fw_cold_state s = ane_cold_fixture();
+
+	s.control = 0x10;
+	s.dart[0].enabled[0] = 1;
+	s.gate_request = 0;
+	KUNIT_EXPECT_TRUE(test, ane_fw_cold_pmgr_valid(&s, true));
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_gate_valid(&s));
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_engine_valid(&s));
+	s = ane_cold_fixture();
+	s.cpu = 0x0f0003ff;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_pmgr_valid(&s, true));
+	KUNIT_EXPECT_TRUE(test, ane_fw_cold_gate_valid(&s));
+	KUNIT_EXPECT_TRUE(test, ane_fw_cold_engine_valid(&s));
+	s = ane_cold_fixture();
+	s.subblock = 0x3ff;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_pmgr_valid(&s, true));
+	s = ane_cold_fixture();
+	s.gate_ack = 1;
+	KUNIT_EXPECT_TRUE(test, ane_fw_cold_pmgr_valid(&s, true));
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_gate_valid(&s));
+}
+
+static void ane_cold_warm_test(struct kunit *test)
+{
+	struct ane_fw_cold_state s, original = ane_cold_fixture();
+	u32 *word;
+	static const size_t offsets[] = {
+		offsetof(struct ane_fw_cold_state, cpu),
+		offsetof(struct ane_fw_cold_state, subblock),
+		offsetof(struct ane_fw_cold_state, gate_request),
+		offsetof(struct ane_fw_cold_state, gate_ack),
+		offsetof(struct ane_fw_cold_state, control),
+		offsetof(struct ane_fw_cold_state, status),
+		offsetof(struct ane_fw_cold_state, pending),
+	};
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(offsets); i++) {
+		s = original;
+		word = (u32 *)((u8 *)&s + offsets[i]);
+		*word ^= 1;
+		KUNIT_EXPECT_FALSE(test, ane_fw_cold_valid(&s, true));
+	}
+	for (unsigned int i = 0; i < 8; i++) {
+		s = original;
+		s.scratch[i] = 1;
+		KUNIT_EXPECT_FALSE(test, ane_fw_cold_valid(&s, true));
+	}
+	s = original;
+	s.rvbar++;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_valid(&s, true));
+	s = original;
+	s.ce_state = 1;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_valid(&s, true));
+	s = original;
+	s.ce_error = BIT_ULL(63);
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_valid(&s, true));
+}
+
+static void ane_cold_dart_test(struct kunit *test)
+{
+	struct ane_fw_cold_state s, original = ane_cold_fixture();
+
+	for (unsigned int i = 0; i < ANE_FW_DARTS; i++) {
+		s = original;
+		s.dart[i].version++;
+		KUNIT_EXPECT_FALSE(test, ane_fw_cold_valid(&s, true));
+		s = original;
+		s.dart[i].protect |= BIT(0);
+		KUNIT_EXPECT_FALSE(test, ane_fw_cold_valid(&s, true));
+		s = original;
+		s.dart[i].lock |= BIT(2);
+		KUNIT_EXPECT_FALSE(test, ane_fw_cold_valid(&s, true));
+		s = original;
+		s.dart[i].error = 1;
+		KUNIT_EXPECT_FALSE(test, ane_fw_cold_valid(&s, true));
+		/* The bound DART driver enables all streams; that is not a refusal. */
+		for (unsigned int j = 0; j < 16; j++) {
+			s = original;
+			s.dart[i].enabled[j] = U32_MAX;
+			KUNIT_EXPECT_TRUE(test, ane_fw_cold_valid(&s, true));
+		}
+	}
+}
+
+static void ane_cold_command_policy_test(struct kunit *test)
+{
+	static const u16 forbidden[] = { 0x27, 0x28, 0x30, 0x31, 0x34 };
+	static const u16 permitted[] = { 0, 3, 4, 0x22, 0x2d, 0x2f, 0x200, 0x202, 0x20c };
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(forbidden); i++)
+		KUNIT_EXPECT_TRUE(test, ane_fw_command_denied(forbidden[i]));
+	for (unsigned int i = 0; i < ARRAY_SIZE(permitted); i++)
+		KUNIT_EXPECT_FALSE(test, ane_fw_command_denied(permitted[i]));
+}
+
+/* The measured 26.6.2 layout: DATA ends 0x14000 short of the span. */
+static void ane_cold_heap_tail_test(struct kunit *test)
+{
+	u64 dva[2] = { 0x10000000000ULL, 0x100000c0000ULL };
+	u64 size[2] = { 0xc0000, 0x2ac000 };
+	const u64 pool = 0x10000384000ULL;
+	u64 tail = 0, tail_size = 0;
+
+	KUNIT_ASSERT_EQ(test, ane_fw_heap_tail(dva, size, pool, &tail, &tail_size), 0);
+	KUNIT_EXPECT_EQ(test, tail, 0x1000036c000ULL);
+	KUNIT_EXPECT_EQ(test, tail_size, 0x14000ULL);
+	/* The faulting writes of neo-run-0045B lie inside the tail. */
+	KUNIT_EXPECT_LE(test, tail, 0x1000037c040ULL);
+	KUNIT_EXPECT_GT(test, tail + tail_size, 0x1000037fc00ULL);
+	/* DATA that ends the span leaves nothing to map. */
+	size[1] = ANE_FW_SPAN - 0xc0000;
+	KUNIT_ASSERT_EQ(test, ane_fw_heap_tail(dva, size, pool, &tail, &tail_size), 0);
+	KUNIT_EXPECT_EQ(test, tail_size, 0ULL);
+	/* DATA past the span, a partial page, overlap, or the pool: refused. */
+	size[1] = ANE_FW_SPAN;
+	KUNIT_EXPECT_EQ(test, ane_fw_heap_tail(dva, size, pool, &tail, &tail_size), -ERANGE);
+	size[1] = 0x2ab000;
+	KUNIT_EXPECT_EQ(test, ane_fw_heap_tail(dva, size, pool, &tail, &tail_size), -ERANGE);
+	size[1] = 0x2ac000;
+	dva[1] = 0x100000bc000ULL;
+	KUNIT_EXPECT_EQ(test, ane_fw_heap_tail(dva, size, pool, &tail, &tail_size), -ERANGE);
+	dva[1] = 0x100000c0000ULL;
+	KUNIT_EXPECT_EQ(test, ane_fw_heap_tail(dva, size, 0x10000370000ULL, &tail,
+					       &tail_size), -ERANGE);
+}
+
+/* The hand-off that starts the engine at boot, and each thing that stops it. */
+static void ane_cold_handoff_test(struct kunit *test)
+{
+	static const struct ane_fw_platform soc = {
+		.preload_dva = { 0x10000000000ULL, 0x100000c0000ULL },
+		.preload_size = { 0xc0000, 0x2ac000 },
+	};
+	static const struct ane_fw_cold_state cold = {
+		.sys = 0x23ff, .cpu = 0x0f000300, .subblock = 0x300,
+	};
+	const struct ane_fw_handoff good = {
+		.pmgr = &cold,
+		.marker = ANE_FW_COLD_BOOT_EVIDENCE,
+		.preloaded = true,
+		.regions_ok = true,
+		.phys = { 0x10000768000ULL, 0x100019a0000ULL },
+		.size = { 0xc0000, 0x2ac000 },
+		.dva = { 0x10000000000ULL, 0x100000c0000ULL },
+		.text_ok = true,
+	};
+	struct ane_fw_handoff h;
+
+	KUNIT_EXPECT_TRUE(test, ane_fw_cold_handoff_valid(&good, &soc));
+	h = good;
+	h.pmgr = NULL;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+	h = good;
+	h.marker = NULL;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+	h.marker = "raw-no-xnu-ane-untouched-v2";
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+	h = good;
+	h.preloaded = false;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+	/* Disabled placeholders (an older loader). */
+	h = good;
+	h.regions_ok = false;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+	h = good;
+	h.size[1] = 0x2a8000;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+	h = good;
+	h.dva[0] = 0x10000004000ULL;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+	h = good;
+	h.phys[1] = h.phys[0];
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+	h = good;
+	h.phys[0] += 0x1000;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+	/* Another firmware build. */
+	h = good;
+	h.text_ok = false;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+}
+
+/*
+ * kexec copies /chosen, so a kernel after one that ran the ANE still sees
+ * the raw-boot marker: the live PMGR state, not the marker, decides.
+ */
+static void ane_cold_handoff_warm_test(struct kunit *test)
+{
+	static const struct ane_fw_platform soc = {
+		.preload_dva = { 0x10000000000ULL, 0x100000c0000ULL },
+		.preload_size = { 0xc0000, 0x2ac000 },
+	};
+	struct ane_fw_cold_state warm = {
+		.sys = 0x23ff, .cpu = 0x0f00030f, .subblock = 0x300,
+	};
+	struct ane_fw_handoff h = {
+		.marker = ANE_FW_COLD_BOOT_EVIDENCE,
+		.preloaded = true,
+		.regions_ok = true,
+		.phys = { 0x10000768000ULL, 0x100019a0000ULL },
+		.size = { 0xc0000, 0x2ac000 },
+		.dva = { 0x10000000000ULL, 0x100000c0000ULL },
+		.text_ok = true,
+		.pmgr = &warm,
+	};
+
+	/* Marker present, ANE CPU powered: warm. */
+	KUNIT_EXPECT_TRUE(test, ane_fw_cold_handoff_loader_ok(&h, &soc));
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+	/* Sub-block on. */
+	warm.cpu = 0x0f000300;
+	warm.subblock = 0x30f;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+	/* Cold PMGR but a kdump kernel. */
+	warm.subblock = 0x300;
+	KUNIT_EXPECT_TRUE(test, ane_fw_cold_handoff_valid(&h, &soc));
+	h.crash_kernel = true;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_handoff_valid(&h, &soc));
+}
+
+/*
+ * While the firmware is retained every sleep state is refused at prepare;
+ * the matching post events and anything without retained firmware pass.
+ */
+static void ane_cold_sleep_test(struct kunit *test)
+{
+	static const unsigned long refused[] = {
+		PM_SUSPEND_PREPARE, PM_HIBERNATION_PREPARE, PM_RESTORE_PREPARE,
+	};
+	static const unsigned long passed[] = {
+		PM_POST_SUSPEND, PM_POST_HIBERNATION, PM_POST_RESTORE,
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(refused); i++) {
+		KUNIT_EXPECT_TRUE(test, ane_fw_sleep_refused(refused[i], true));
+		KUNIT_EXPECT_EQ(test, ane_fw_sleep_event(refused[i], true), NOTIFY_BAD);
+		KUNIT_EXPECT_EQ(test, ane_fw_sleep_event(refused[i], false), NOTIFY_DONE);
+	}
+	for (i = 0; i < ARRAY_SIZE(passed); i++) {
+		KUNIT_EXPECT_EQ(test, ane_fw_sleep_event(passed[i], true), NOTIFY_DONE);
+		KUNIT_EXPECT_EQ(test, ane_fw_sleep_event(passed[i], false), NOTIFY_DONE);
+	}
+	/* A backend that cycles the engine lets suspend through, not hibernation. */
+	KUNIT_EXPECT_FALSE(test, ane_fw_sleep_refused_cycle(PM_SUSPEND_PREPARE, true, true));
+	KUNIT_EXPECT_TRUE(test, ane_fw_sleep_refused_cycle(PM_HIBERNATION_PREPARE, true, true));
+	KUNIT_EXPECT_TRUE(test, ane_fw_sleep_refused_cycle(PM_RESTORE_PREPARE, true, true));
+	KUNIT_EXPECT_TRUE(test, ane_fw_sleep_refused_cycle(PM_SUSPEND_PREPARE, true, false));
+	KUNIT_EXPECT_FALSE(test, ane_fw_sleep_refused_cycle(PM_HIBERNATION_PREPARE, false, true));
+	/* The device callback backstop: refuse with running firmware only. */
+	KUNIT_EXPECT_EQ(test, ane_fw_sleep_backstop(true), -EBUSY);
+	KUNIT_EXPECT_EQ(test, ane_fw_sleep_backstop(false), 0);
+}
+
+/*
+ * The cold cycle after our own power-down: the C4 state (ANE_SYS kept on,
+ * CPU stopped: status 0x62, CE 0x5, DAPF kept) restarts like reset values;
+ * a DART fault or lock does not.
+ */
+static void ane_cold_restartable_test(struct kunit *test)
+{
+	struct ane_fw_cold_state s, original = ane_cold_fixture();
+
+	KUNIT_EXPECT_TRUE(test, ane_fw_cold_engine_restartable(&original));
+	s = original;
+	s.status = 0x62;
+	s.ce_state = 5;
+	s.scratch[6] = 9;
+	KUNIT_EXPECT_FALSE(test, ane_fw_cold_engine_valid(&s));
+	KUNIT_EXPECT_TRUE(test, ane_fw_cold_engine_restartable(&s));
+	for (unsigned int i = 0; i < ANE_FW_DARTS; i++) {
+		s = original;
+		s.dart[i].error = 1;
+		KUNIT_EXPECT_FALSE(test, ane_fw_cold_engine_restartable(&s));
+		s = original;
+		s.dart[i].lock |= BIT(2);
+		KUNIT_EXPECT_FALSE(test, ane_fw_cold_engine_restartable(&s));
+		s = original;
+		s.dart[i].protect |= BIT(0);
+		KUNIT_EXPECT_FALSE(test, ane_fw_cold_engine_restartable(&s));
+	}
+}
+
+/* RVBAR: latched at TEXT is ready, unlatched is written, foreign refused. */
+static void ane_cold_rvbar_test(struct kunit *test)
+{
+	const u64 text = 0x10000000000ULL;
+
+	KUNIT_EXPECT_EQ(test, ane_fw_rvbar_check(text | 1, text), ANE_FW_RVBAR_LATCHED);
+	KUNIT_EXPECT_EQ(test, ane_fw_rvbar_check(0, text), ANE_FW_RVBAR_WRITABLE);
+	KUNIT_EXPECT_EQ(test, ane_fw_rvbar_check(text, text), ANE_FW_RVBAR_WRITABLE);
+	KUNIT_EXPECT_EQ(test, ane_fw_rvbar_check(1, text), ANE_FW_RVBAR_FOREIGN);
+	KUNIT_EXPECT_EQ(test, ane_fw_rvbar_check(0x20000000001ULL, text), ANE_FW_RVBAR_FOREIGN);
+}
+
+/* The boot/transport configs intentionally leave the floor driver disabled. */
+static void ane_cold_no_clpc_test(struct kunit *test)
+{
+#if !IS_REACHABLE(CONFIG_APPLE_CLPC)
+	struct apple_clpc_ane *ane = NULL;
+	struct device dev = {};
+
+	KUNIT_EXPECT_EQ(test, apple_clpc_ane_get(&dev, &ane), 0);
+	KUNIT_EXPECT_PTR_EQ(test, ane, NULL);
+	apple_clpc_ane_set_active(ane, true);
+	apple_clpc_ane_set_active(ane, false);
+	apple_clpc_ane_put(ane);
+#else
+	kunit_skip(test, "CLPC enabled; absence is covered by the CLPC suite");
+#endif
+}
+
+static struct kunit_case ane_cold_cases[] = {
+	KUNIT_CASE(ane_cold_no_clpc_test),
+	KUNIT_CASE(ane_cold_restartable_test),
+	KUNIT_CASE(ane_cold_rvbar_test),
+	KUNIT_CASE(ane_cold_sleep_test),
+	KUNIT_CASE(ane_cold_handoff_warm_test),
+	KUNIT_CASE(ane_cold_handoff_test),
+	KUNIT_CASE(ane_cold_heap_tail_test),
+	KUNIT_CASE(ane_cold_evidence_test),
+	KUNIT_CASE(ane_cold_step_test),
+	KUNIT_CASE(ane_cold_warm_test),
+	KUNIT_CASE(ane_cold_dart_test),
+	KUNIT_CASE(ane_cold_command_policy_test),
+	{}
+};
+
+static struct kunit_suite ane_cold_suite = {
+	.name = "ane-fw-cold",
+	.test_cases = ane_cold_cases,
+};
+
+kunit_test_suite(ane_cold_suite);
+
+MODULE_DESCRIPTION("KUnit tests for cold ANE acquisition and H17 program policy");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/accel/ane/ane_fw_ids.h b/drivers/accel/ane/ane_fw_ids.h
new file mode 100644
index 0000000000..9c8fa99d74
--- /dev/null
+++ b/drivers/accel/ane/ane_fw_ids.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_FW_IDS_H__
+#define __ANE_FW_IDS_H__
+
+#include <linux/errno.h>
+#include <linux/limits.h>
+#include <linux/types.h>
+
+/* Protected by the firmware lock; never reset when firmware restarts. */
+struct ane_fw_ids {
+	u64 next;
+};
+
+static inline int ane_fw_id_alloc(struct ane_fw_ids *ids, u32 *id)
+{
+	if (!ids->next)
+		ids->next = 1;
+	/* Keep zero and the protocol's U32_MAX sentinel out of the namespace. */
+	if (ids->next >= U32_MAX)
+		return -ENOSPC;
+	*id = ids->next++;
+	return 0;
+}
+
+#endif /* __ANE_FW_IDS_H__ */
diff --git a/drivers/accel/ane/ane_fw_ids_test.c b/drivers/accel/ane/ane_fw_ids_test.c
new file mode 100644
index 0000000000..57635daf46
--- /dev/null
+++ b/drivers/accel/ane/ane_fw_ids_test.c
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <kunit/test.h>
+
+#include "ane_fw_ids.h"
+
+static void ane_fw_ids_restart_test(struct kunit *test)
+{
+	struct ane_fw_ids ids = {};
+	u32 old, fresh;
+
+	KUNIT_ASSERT_EQ(test, ane_fw_id_alloc(&ids, &old), 0);
+	/* Firmware may reuse wire ID zero after reset; the kernel namespace
+	 * is deliberately independent and survives cache invalidation.
+	 */
+	KUNIT_ASSERT_EQ(test, ane_fw_id_alloc(&ids, &fresh), 0);
+	KUNIT_EXPECT_NE(test, old, fresh);
+	KUNIT_EXPECT_NE(test, old, 0U);
+	KUNIT_EXPECT_NE(test, fresh, U32_MAX);
+}
+
+static void ane_fw_ids_exhaustion_test(struct kunit *test)
+{
+	struct ane_fw_ids ids = { .next = U32_MAX - 1ULL };
+	u32 key = 0;
+
+	KUNIT_ASSERT_EQ(test, ane_fw_id_alloc(&ids, &key), 0);
+	KUNIT_EXPECT_EQ(test, key, U32_MAX - 1);
+	key = 123;
+	KUNIT_EXPECT_EQ(test, ane_fw_id_alloc(&ids, &key), -ENOSPC);
+	KUNIT_EXPECT_EQ(test, key, 123U);
+	KUNIT_EXPECT_EQ(test, ane_fw_id_alloc(&ids, &key), -ENOSPC);
+}
+
+static void ane_fw_ids_overflow_test(struct kunit *test)
+{
+	struct ane_fw_ids ids = { .next = U64_MAX };
+	u32 key = 123;
+
+	KUNIT_EXPECT_EQ(test, ane_fw_id_alloc(&ids, &key), -ENOSPC);
+	KUNIT_EXPECT_EQ(test, key, 123U);
+	KUNIT_EXPECT_EQ(test, ids.next, U64_MAX);
+}
+
+static struct kunit_case ane_fw_ids_cases[] = {
+	KUNIT_CASE(ane_fw_ids_restart_test),
+	KUNIT_CASE(ane_fw_ids_exhaustion_test),
+	KUNIT_CASE(ane_fw_ids_overflow_test),
+	{}
+};
+
+static struct kunit_suite ane_fw_ids_suite = {
+	.name = "ane-fw-ids",
+	.test_cases = ane_fw_ids_cases,
+};
+
+kunit_test_suite(ane_fw_ids_suite);
+
+MODULE_LICENSE("Dual MIT/GPL");
+MODULE_DESCRIPTION("ANE firmware recovery identifier tests");
diff --git a/drivers/accel/ane/ane_fw_platform.c b/drivers/accel/ane/ane_fw_platform.c
new file mode 100644
index 0000000000..1f0d50a1f0
--- /dev/null
+++ b/drivers/accel/ane/ane_fw_platform.c
@@ -0,0 +1,269 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * H16/H17 facts from the 2026-10-31 H16/H17 specification, sections 3-7,
+ * 12 and 15, and the H16 cold-boot facts, round 5. Metadata preflight
+ * performs no MMIO, DMA mapping or power access.
+ */
+#include <linux/ioport.h>
+#include <linux/mm.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+
+#include "ane_fw_cold.h"
+#include "ane_fw_platform.h"
+#include "ane_h16_boot_data.h"
+
+static const char * const ane_h16_reg_names[] = {
+	"engine", "pmgr", "aux-0", "aux-1", "aux-2", "aux-3", "aux-4",
+};
+
+static const u32 ane_h16_reg_sizes[] = {
+	0x2000000, 0x18000, 0x4000, 0x30000, 0xff4000, 0x2000000, 0x4000,
+};
+
+/* Offsets in reg[1]; genpd, never the ANE driver, owns transitions. */
+static const u32 ane_h16_power_words[] = {
+	0x3c0, 0xc008, 0xc000, 0xc010, 0xc018,
+};
+
+static const char * const ane_h17_reg_names[] = { "engine", "pmgr", "pwgate" };
+static const u32 ane_h17_reg_sizes[] = { 0x2000000, 0x18000, 0x34 };
+
+const struct ane_fw_platform ane_h16_platform = {
+	.h16_profiles = ane_h16_profiles,
+	.h16_profile_count = ARRAY_SIZE(ane_h16_profiles),
+	.h16_mmio = ane_h16_mmio_t6041,
+	.h16_mmio_count = ARRAY_SIZE(ane_h16_mmio_t6041),
+	.dart_params = 0x8,
+	.dapf_dart = 0,
+	.dapf_offset = 0x10000,
+	.dapf_size = SZ_16K,
+	/* The DT compatible is t6041 on the M4 Max and the M4 Pro (T6040) alike. */
+	.soc = 0x6040,
+	.chip_family = 16,
+	.ane_type = 0x110,
+	.hwx_subtype = 7,
+	.task_generation = 17,
+	.interrupt_count = 1,
+	/* J616s IRQ 1054 drains replies and events from all F2H channels. */
+	.irq_role = ANE_FW_IRQ_CHANNELS,
+	.owner = ANE_FW_OWNER_AP,
+	.reg_names = ane_h16_reg_names,
+	.reg_sizes = ane_h16_reg_sizes,
+	.reg_count = ARRAY_SIZE(ane_h16_reg_names),
+	.wrapper = 0x1600000,
+	.mailbox = 0x1608000,
+	.scratch = 0x1880020,
+	.doorbell = 0x1884000,
+	.irq_status = 0x188c000,
+	.irq_ack = 0x1890000,
+	.power_words = ane_h16_power_words,
+	.power_count = ARRAY_SIZE(ane_h16_power_words),
+	.preload_dva = { 0x10000000000, 0x100000c0000 },
+	.preload_size = { 0xc0000, 0x2ac000 },
+	.stream_mask = BIT(0) | BIT(11),
+	/*
+	 * System sleep cycles the engine cold and replays every program.
+	 * The warm path stays off: on 25G83 the J616s firmware does not take
+	 * SUSPEND (0x24), bare or after SET_SNE_PMU_BASE2 and
+	 * EXCLAVE_MODE_STOP.
+	 */
+	.sleep_cold = true,
+	.firmware_preloaded = true,
+	.safe_reset = false,
+};
+
+const struct ane_fw_platform ane_h17_platform = {
+	.soc = 0x8140,
+	.chip_family = 17,
+	.ane_type = 0x200,
+	.hwx_subtype = 9,
+	.task_generation = 19,
+	.interrupt_count = 2,
+	.owner = ANE_FW_OWNER_EXCLAVE,
+	.reg_names = ane_h17_reg_names,
+	.reg_sizes = ane_h17_reg_sizes,
+	.reg_count = ARRAY_SIZE(ane_h17_reg_names),
+	.wrapper = 0x1600000,
+	.mailbox = 0x1608000,
+	.scratch = 0x1880020,
+	.doorbell = 0x1884000,
+	.irq_status = 0x188c000,
+	.irq_ack = 0x1890000,
+	.preload_dva = { 0x10000000000, 0x100000c0000 },
+	.preload_size = { 0xc0000, 0x2ac000 },
+	.stream_mask = BIT(0),
+	.firmware_preloaded = true,
+	.safe_reset = false,
+	/* 25G83 boots this firmware in Exclave mode (SPEC-ANE-SLEEP-H17.md). */
+	.exclave_mode_stop = true,
+	/*
+	 * Off: on 25G83 SUSPEND is still not taken after 0x31 (C7), so sleep
+	 * cycles the engine cold and replays every program behind its handle.
+	 */
+	.sleep_warm = false,
+	/* Cold AP-direct acquisition is staged before any power or DMA write.
+	 * The observer uses the measured H17 26.6.2 register layout.
+	 */
+};
+
+/*
+ * The iBoot preload is firmware memory. Accept it only as a no-map child of
+ * /reserved-memory that Linux does not manage as System RAM, whether the
+ * loader reserved it at boot or left it outside the memory map. The physical
+ * range comes from the node itself, so the check does not depend on when the
+ * node was added.
+ */
+int ane_fw_preload_range(struct device_node *np, unsigned int index, u64 *phys, u64 *size)
+{
+	struct device_node *reserved __free(device_node) =
+		of_find_node_by_path("/reserved-memory");
+	struct device_node *mem __free(device_node) =
+		of_parse_phandle(np, "memory-region", index);
+	struct resource r;
+
+	if (!reserved || !mem || mem->parent != reserved ||
+	    !of_device_is_available(mem) ||
+	    !of_property_read_bool(mem, "no-map") ||
+	    of_property_read_bool(mem, "reusable") ||
+	    of_address_to_resource(mem, 0, &r) || !resource_size(&r))
+		return -EINVAL;
+	if (region_intersects(r.start, resource_size(&r), IORESOURCE_SYSTEM_RAM,
+			      IORES_DESC_NONE) != REGION_DISJOINT)
+		return -EBUSY;
+	*phys = r.start;
+	*size = resource_size(&r);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ane_fw_preload_range);
+
+static int ane_fw_preload_check(struct device *dev,
+				const struct ane_fw_platform *soc)
+{
+	struct device_node *np = dev->of_node;
+	u64 phys[2], size[2], dva[2];
+	unsigned int i;
+	int ret;
+
+	if (of_property_count_u32_elems(np, "memory-region") != 2 ||
+	    of_property_count_strings(np, "memory-region-names") != 2 ||
+	    of_property_count_u64_elems(np, "apple,firmware-iovas") != 2 ||
+	    of_property_read_u64_array(np, "apple,firmware-iovas", dva, 2))
+		return -ENODATA;
+
+	for (i = 0; i < 2; i++) {
+		struct device_node *mem __free(device_node) =
+			of_parse_phandle(np, "memory-region", i);
+		const char *name;
+
+		/* Board DTs carry disabled placeholders the loader fills in. */
+		if (mem && !of_device_is_available(mem))
+			return -ENODEV;
+		if (of_property_read_string_index(np, "memory-region-names", i,
+						  &name) ||
+		    strcmp(name, i ? "firmware-data" : "firmware-text"))
+			return -EINVAL;
+		ret = ane_fw_preload_range(np, i, &phys[i], &size[i]);
+		if (ret)
+			return ret;
+	}
+
+	return ane_fw_preload_ranges_valid(soc, phys, size, dva) ? 0 : -EINVAL;
+}
+
+int ane_fw_platform_preflight(struct platform_device *pdev,
+			      const struct ane_fw_platform *soc)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct resource *res;
+	u32 ane_type;
+	unsigned int i;
+	int ret;
+
+	/* No backend has acquired ownership, even if DT omits the marker.
+	 * Check before resources, firmware, power, IOMMU or engine access.
+	 */
+	/*
+	 * H17 is started (or left alone) by the staged path before the driver
+	 * registers; the platform probe never acquires it. -ENODEV keeps the
+	 * driver core quiet; the staged path already said why.
+	 */
+	if (soc->owner == ANE_FW_OWNER_EXCLAVE)
+		return -ENODEV;
+	if (of_property_read_bool(np, "apple,exclave-assigned")) {
+		dev_info(dev, "ANE: exclave-assigned device has no Linux ownership provider\n");
+		return -EOPNOTSUPP;
+	}
+
+	if (!of_property_read_bool(np, "apple,firmware-preloaded") ||
+	    of_property_read_u32(np, "apple,ane-type", &ane_type) ||
+	    ane_type != soc->ane_type)
+		return dev_err_probe(dev, -EINVAL, "H16 firmware identity missing or invalid\n");
+
+	if (of_property_count_strings(np, "reg-names") != soc->reg_count ||
+	    platform_get_resource(pdev, IORESOURCE_MEM, soc->reg_count) ||
+	    of_irq_count(np) != soc->interrupt_count)
+		return dev_err_probe(dev, -EINVAL, "H16 resource count mismatch\n");
+
+	for (i = 0; i < soc->reg_count; i++) {
+		res = platform_get_resource_byname(pdev, IORESOURCE_MEM,
+						   soc->reg_names[i]);
+		if (!res || resource_size(res) != soc->reg_sizes[i])
+			return dev_err_probe(dev, -EINVAL, "H16 resource geometry mismatch\n");
+	}
+
+	ret = ane_fw_preload_check(dev, soc);
+	if (ret == -ENODEV) {
+		dev_info(dev, "H16 firmware preload not handed off by the bootloader\n");
+		return ret;
+	}
+	if (ret)
+		return dev_err_probe(dev, ret,
+			"H16 requires bootloader-reserved no-map TEXT/DATA preload ranges\n");
+
+	if (!soc->h16_profile_count || !soc->h16_mmio_count || soc->dapf_dart >= 3 ||
+	    !soc->dapf_size || of_property_count_u64_elems(np, "apple,dapf-ranges") != 8)
+		return -ENODATA;
+	return 0;
+}
+
+int ane_fw_platform_probe(struct platform_device *pdev, const struct ane_fw_platform *soc)
+{
+	int ret;
+
+	/* H17: the staged backend owns the engine; the device binds for it. */
+	if (ane_fw_platform_staged(soc))
+		return ane_fw_staged_bind(pdev);
+	ret = ane_fw_platform_preflight(pdev, soc);
+
+	if (ret)
+		return ret;
+	return ane_h16_backend_probe(pdev, soc);
+}
+
+void ane_fw_platform_remove(struct platform_device *pdev)
+{
+	if (ane_fw_staged_bound(&pdev->dev)) {
+		ane_fw_staged_unbind(pdev);
+		return;
+	}
+	ane_h16_backend_remove(pdev);
+}
+
+/* System sleep callbacks of the bound H16 or H17 device. */
+int ane_fw_platform_suspend(struct device *dev)
+{
+	if (ane_fw_staged_bound(dev))
+		return ane_fw_staged_suspend(dev);
+	return ane_h16_backend_suspend(dev);
+}
+
+int ane_fw_platform_resume(struct device *dev)
+{
+	if (ane_fw_staged_bound(dev))
+		return 0;
+	return ane_h16_backend_resume(dev);
+}
diff --git a/drivers/accel/ane/ane_fw_platform.h b/drivers/accel/ane/ane_fw_platform.h
new file mode 100644
index 0000000000..6978b1b6fe
--- /dev/null
+++ b/drivers/accel/ane/ane_fw_platform.h
@@ -0,0 +1,141 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_FW_PLATFORM_H__
+#define __ANE_FW_PLATFORM_H__
+
+#include <linux/align.h>
+#include <linux/bits.h>
+#include <linux/errno.h>
+#include <linux/overflow.h>
+#include <linux/sizes.h>
+#include <linux/types.h>
+
+struct device_node;
+struct platform_device;
+struct ane_h16_profile;
+struct ane_h16_mmio;
+
+enum ane_fw_owner {
+	ANE_FW_OWNER_AP,
+	ANE_FW_OWNER_EXCLAVE,
+};
+
+enum ane_fw_irq_role {
+	ANE_FW_IRQ_UNKNOWN,
+	ANE_FW_IRQ_CHANNELS,
+};
+
+/* Later firmware generations must never enter the H14 staging path. */
+struct ane_fw_platform {
+	const struct ane_h16_profile *h16_profiles;
+	unsigned int h16_profile_count;
+	/* DART/DAPF register tables, one per supported DART revision. */
+	const struct ane_h16_mmio *h16_mmio;
+	unsigned int h16_mmio_count;
+	/* DART PARAMS3, the one DART register read before a table is chosen. */
+	u32 dart_params;
+	/* The DAPF bank: iommus entry that owns it, offset from its reg, size. */
+	u32 dapf_dart;
+	u32 dapf_offset;
+	u32 dapf_size;
+	u32 soc;
+	u16 chip_family;
+	u16 ane_type;
+	u8 hwx_subtype;
+	u8 task_generation;
+	u8 interrupt_count;
+	enum ane_fw_irq_role irq_role;
+	enum ane_fw_owner owner;
+	const char * const *reg_names;
+	const u32 *reg_sizes;
+	u32 reg_count;
+	u32 wrapper;
+	u32 mailbox;
+	u32 scratch;
+	u32 doorbell;
+	u32 irq_status;
+	u32 irq_ack;
+	const u32 *power_words;
+	u32 power_count;
+	u64 preload_dva[2];
+	u64 preload_size[2];
+	u16 stream_mask;
+	bool firmware_preloaded;
+	bool safe_reset;
+	/*
+	 * System sleep first takes the firmware out of Exclave mode
+	 * (EXCLAVE_MODE_STOP on the control ring) so that SUSPEND can run.
+	 */
+	bool exclave_mode_stop;
+	/*
+	 * System sleep keeps the firmware (EXCLAVE_MODE_STOP, SUSPEND, warm
+	 * boot); otherwise the engine is cycled cold and the programs replayed.
+	 */
+	bool sleep_warm;
+	/*
+	 * H16: system sleep cycles the engine cold (no firmware command, cold
+	 * boot and program replay after resume) when sleep_warm is off.
+	 * Without either, H16 refuses system sleep.
+	 */
+	bool sleep_cold;
+};
+
+/* Pure range check: the boot loader supplies the physical addresses. */
+static inline bool
+ane_fw_preload_ranges_valid(const struct ane_fw_platform *soc, const u64 phys[2],
+			    const u64 size[2], const u64 dva[2])
+{
+	u64 end[2];
+	unsigned int i;
+
+	for (i = 0; i < 2; i++) {
+		if (!phys[i] || !IS_ALIGNED(phys[i], SZ_16K) ||
+		    size[i] != soc->preload_size[i] ||
+		    dva[i] != soc->preload_dva[i] ||
+		    check_add_overflow(phys[i], size[i], &end[i]))
+			return false;
+	}
+	return end[0] <= phys[1] || end[1] <= phys[0];
+}
+
+/*
+ * The system sleep path of a device the ane_t6021 driver bound. Devices of
+ * the shared firmware platform (H16, H17) carry the backend's drvdata and
+ * must never reach the H13/H14 rtclient sleep path, which would read that
+ * drvdata as an rtclient.
+ */
+enum ane_fw_sleep_path {
+	ANE_SLEEP_RTCLIENT,
+	ANE_SLEEP_FW_BACKEND,
+};
+
+/*
+ * The device binds for the staged backend (H17): the engine is started by
+ * the backend, the bound device carries its power domain and sleep callbacks.
+ */
+static inline bool ane_fw_platform_staged(const struct ane_fw_platform *platform)
+{
+	return platform && platform->owner == ANE_FW_OWNER_EXCLAVE;
+}
+
+static inline enum ane_fw_sleep_path
+ane_fw_sleep_path(const struct ane_fw_platform *platform)
+{
+	return platform ? ANE_SLEEP_FW_BACKEND : ANE_SLEEP_RTCLIENT;
+}
+
+extern const struct ane_fw_platform ane_h16_platform, ane_h17_platform;
+int ane_fw_platform_preflight(struct platform_device *pdev,
+			      const struct ane_fw_platform *soc);
+
+int ane_fw_platform_probe(struct platform_device *pdev,
+			  const struct ane_fw_platform *soc);
+void ane_fw_platform_remove(struct platform_device *pdev);
+int ane_fw_platform_suspend(struct device *dev);
+int ane_fw_platform_resume(struct device *dev);
+int ane_fw_preload_range(struct device_node *np, unsigned int index, u64 *phys, u64 *size);
+int ane_h16_backend_probe(struct platform_device *pdev, const struct ane_fw_platform *soc);
+void ane_h16_backend_remove(struct platform_device *pdev);
+int ane_h16_backend_suspend(struct device *dev);
+int ane_h16_backend_resume(struct device *dev);
+
+#endif /* __ANE_FW_PLATFORM_H__ */
diff --git a/drivers/accel/ane/ane_fw_platform_test.c b/drivers/accel/ane/ane_fw_platform_test.c
new file mode 100644
index 0000000000..7fa82abf63
--- /dev/null
+++ b/drivers/accel/ane/ane_fw_platform_test.c
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <kunit/test.h>
+#include <linux/module.h>
+
+#include "ane_fw_platform.h"
+
+static void ane_preload_ranges_test(struct kunit *test)
+{
+	const struct ane_fw_platform soc = {
+		.preload_dva = { 0x10000000000, 0x100000c0000 },
+		.preload_size = { 0xc0000, 0x2ac000 },
+	};
+	u64 phys[] = { 0x100000000, 0x200000000 };
+	u64 size[] = { 0xc0000, 0x2ac000 };
+	u64 dva[] = { 0x10000000000, 0x100000c0000 };
+
+	KUNIT_EXPECT_TRUE(test, ane_fw_preload_ranges_valid(&soc, phys, size, dva));
+	/* Physical placement may change independently on every boot. */
+	phys[0] = 0x300000000;
+	KUNIT_EXPECT_TRUE(test, ane_fw_preload_ranges_valid(&soc, phys, size, dva));
+	phys[0] = phys[1] + SZ_16K;
+	KUNIT_EXPECT_FALSE(test, ane_fw_preload_ranges_valid(&soc, phys, size, dva));
+	phys[0] = phys[1] - size[0];
+	KUNIT_EXPECT_TRUE(test, ane_fw_preload_ranges_valid(&soc, phys, size, dva));
+	phys[0]++;
+	KUNIT_EXPECT_FALSE(test, ane_fw_preload_ranges_valid(&soc, phys, size, dva));
+	phys[0] = 0;
+	KUNIT_EXPECT_FALSE(test, ane_fw_preload_ranges_valid(&soc, phys, size, dva));
+	phys[0] = U64_MAX - SZ_16K + 1;
+	KUNIT_EXPECT_FALSE(test, ane_fw_preload_ranges_valid(&soc, phys, size, dva));
+	phys[0] = 0x100000000;
+	size[1] -= SZ_16K;
+	KUNIT_EXPECT_FALSE(test, ane_fw_preload_ranges_valid(&soc, phys, size, dva));
+	size[1] = 0x2ac000;
+	dva[0] = 0x100000c0000;
+	dva[1] = 0x10000000000;
+	KUNIT_EXPECT_FALSE(test, ane_fw_preload_ranges_valid(&soc, phys, size, dva));
+}
+
+/*
+ * H16 and H17 devices (any firmware platform) take the backend's sleep path,
+ * never the rtclient one; only the H13/H14 rtclient (no platform) does.
+ */
+static void ane_platform_sleep_path_test(struct kunit *test)
+{
+	static const struct ane_fw_platform h16 = { .soc = 0x6041 }, h17 = { .soc = 0x8140 };
+
+	KUNIT_EXPECT_EQ(test, ane_fw_sleep_path(&h16), ANE_SLEEP_FW_BACKEND);
+	KUNIT_EXPECT_EQ(test, ane_fw_sleep_path(&h17), ANE_SLEEP_FW_BACKEND);
+	KUNIT_EXPECT_EQ(test, ane_fw_sleep_path(NULL), ANE_SLEEP_RTCLIENT);
+}
+
+/*
+ * Only the staged backend's platform (H17, Exclave-owned firmware) binds
+ * the device for the backend; H16 keeps its own probe; the rtclient has no
+ * platform. A bound H17 device still takes the backend's sleep path.
+ */
+static void ane_platform_staged_bind_test(struct kunit *test)
+{
+	static const struct ane_fw_platform h16 = { .soc = 0x6041, .owner = ANE_FW_OWNER_AP },
+		h17 = { .soc = 0x8140, .owner = ANE_FW_OWNER_EXCLAVE };
+
+	KUNIT_EXPECT_TRUE(test, ane_fw_platform_staged(&h17));
+	KUNIT_EXPECT_FALSE(test, ane_fw_platform_staged(&h16));
+	KUNIT_EXPECT_FALSE(test, ane_fw_platform_staged(NULL));
+	KUNIT_EXPECT_EQ(test, ane_fw_sleep_path(&h17), ANE_SLEEP_FW_BACKEND);
+}
+
+static struct kunit_case ane_fw_platform_cases[] = {
+	KUNIT_CASE(ane_platform_staged_bind_test),
+	KUNIT_CASE(ane_platform_sleep_path_test),
+	KUNIT_CASE(ane_preload_ranges_test),
+	{}
+};
+
+static struct kunit_suite ane_fw_platform_suite = {
+	.name = "ane-fw-platform",
+	.test_cases = ane_fw_platform_cases,
+};
+
+kunit_test_suite(ane_fw_platform_suite);
+
+MODULE_DESCRIPTION("KUnit tests for ANE firmware preload range validation");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/accel/ane/ane_fw_protocol.h b/drivers/accel/ane/ane_fw_protocol.h
new file mode 100644
index 0000000000..40518ab5cc
--- /dev/null
+++ b/drivers/accel/ane/ane_fw_protocol.h
@@ -0,0 +1,307 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_FW_PROTOCOL_H__
+#define __ANE_FW_PROTOCOL_H__
+
+#include <linux/array_size.h>
+#include <linux/bitops.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+
+#define ANE_FW_CHANNELS 8
+#define ANE_FW_DESCRIPTOR_SIZE 0x100
+#define ANE_FW_TABLE_SIZE (ANE_FW_CHANNELS * ANE_FW_DESCRIPTOR_SIZE)
+#define ANE_FW_SLOT_SIZE 64
+#define ANE_FW_TICK_RATE 24000000U
+
+struct ane_fw_channel {
+	u64 offset;
+	u32 slots;
+	u32 type;
+	u32 bit;
+	u32 index;
+};
+
+static inline bool ane_fw_contains(u64 base, u64 bytes, u64 addr, u64 size)
+{
+	return bytes <= U64_MAX - base && size <= bytes && addr >= base &&
+	       addr - base <= bytes - size;
+}
+
+/* The firmware's channel names, in the logical order of the driver. */
+static inline const char *ane_fw_channel_name(unsigned int ch)
+{
+	static const char * const names[ANE_FW_CHANNELS] = {
+		"TERMINAL", "IO", "DEBUG", "BUF_H2T", "BUF_T2H",
+		"SHAREDMALLOC", "IO_T2H", "DATA_CHAIN_H2T",
+	};
+
+	return ch < ANE_FW_CHANNELS ? names[ch] : "none";
+}
+
+/* Parse a host-owned descriptor snapshot; output indices are logical names. */
+static inline int
+ane_fw_channels_parse(const void *table, u64 ipc_dva, size_t ipc_size,
+		      u64 table_dva, struct ane_fw_channel channels[ANE_FW_CHANNELS])
+{
+	static const char * const names[ANE_FW_CHANNELS] = {
+		"TERMINAL", "IO", "DEBUG", "BUF_H2T", "BUF_T2H",
+		"SHAREDMALLOC", "IO_T2H", "DATA_CHAIN_H2T",
+	};
+	struct ane_fw_channel parsed[ANE_FW_CHANNELS] = {};
+	u64 table_off;
+	u32 seen = 0;
+	unsigned int i, j;
+
+	if (!table || !channels ||
+	    !ane_fw_contains(ipc_dva, ipc_size, table_dva, ANE_FW_TABLE_SIZE))
+		return -EPROTO;
+	table_off = table_dva - ipc_dva;
+	for (i = 0; i < ANE_FW_CHANNELS; i++) {
+		const u8 *desc = (const u8 *)table + i * ANE_FW_DESCRIPTOR_SIZE;
+		struct ane_fw_channel *c;
+		u64 slots, ring, end;
+
+		if (!memchr(desc, 0, 64))
+			return -EPROTO;
+		for (j = 0; j < ANE_FW_CHANNELS; j++)
+			if (!strcmp((const char *)desc, names[j]))
+				break;
+		if (j == ANE_FW_CHANNELS || (seen & BIT(j)))
+			return -EPROTO;
+		seen |= BIT(j);
+		c = &parsed[j];
+		c->index = i;
+		c->type = get_unaligned_le32(desc + 0x40);
+		c->bit = get_unaligned_le32(desc + 0x44);
+		slots = get_unaligned_le64(desc + 0x48);
+		ring = get_unaligned_le64(desc + 0x50);
+		if (c->type > 2 || c->bit >= 32 || !slots || slots > 0x400 ||
+		    (ring & (ANE_FW_SLOT_SIZE - 1)) ||
+		    !ane_fw_contains(ipc_dva, ipc_size, ring,
+				     slots * ANE_FW_SLOT_SIZE))
+			return -EPROTO;
+		c->offset = ring - ipc_dva;
+		c->slots = slots;
+		end = c->offset + slots * ANE_FW_SLOT_SIZE;
+		if (c->offset < table_off + ANE_FW_TABLE_SIZE && end > table_off)
+			return -EPROTO;
+	}
+	if (seen != GENMASK(ANE_FW_CHANNELS - 1, 0) ||
+	    parsed[1].type != 0 || parsed[5].type != 1 ||
+	    parsed[6].type != 1 || parsed[7].type != 0)
+		return -EPROTO;
+	for (i = 0; i < ANE_FW_CHANNELS; i++) {
+		u64 end = parsed[i].offset + parsed[i].slots * ANE_FW_SLOT_SIZE;
+
+		for (j = i + 1; j < ANE_FW_CHANNELS; j++)
+			if (parsed[i].offset < parsed[j].offset +
+					       parsed[j].slots * ANE_FW_SLOT_SIZE &&
+			    parsed[j].offset < end)
+				return -EPROTO;
+	}
+	memcpy(channels, parsed, sizeof(parsed));
+	return 0;
+}
+
+/* Call only after parsing the table and checking its immutable snapshot. */
+static inline void
+ane_fw_channels_host_init(void *ipc, const struct ane_fw_channel *channels)
+{
+	unsigned int i, slot;
+
+	for (i = 0; i < ANE_FW_CHANNELS; i++) {
+		const struct ane_fw_channel *c = &channels[i];
+
+		if (c->type)
+			continue;
+		for (slot = 0; slot < c->slots; slot++) {
+			u8 *p = (u8 *)ipc + c->offset + slot * ANE_FW_SLOT_SIZE;
+
+			memset(p, 0, 24);
+			put_unaligned_le64(1, p);
+		}
+	}
+}
+
+/*
+ * H17 system sleep: leave the firmware's Exclave mode (SNE DM bus idle)
+ * before SUSPEND, on the control ring; 0x18 bytes, zero body.
+ */
+#define ANE_FW_CMD_EXCLAVE_MODE_STOP 0x31
+#define ANE_FW_MODE_STOP_SIZE 0x18
+
+/*
+ * SET_SNE_PMU_BASE2, 16 bytes on the control ring at startup, between START
+ * and CONFIG_GET: the u64 base of the ANE's PMGR/PMU aperture (the DT "pmgr"
+ * register range; J700 0x300700000, T6041 0x502280000). The 0x24 handler's
+ * DM-bus endpoint-0 idle query needs it (SPEC-ANE-SLEEP-H17-r2.md).
+ */
+#define ANE_FW_CMD_SET_PMU_BASE 0x29
+#define ANE_FW_PMU_BASE_SIZE 0x10
+
+/* H14 preserves its reserved word; H16 requires bytes 0..3 to be zero. */
+/*
+ * Commands that change engine mode or ownership: secure mode 0x27, 0x28 and
+ * 0x34, exclave mode 0x30 and 0x31. Linux never publishes them.
+ */
+static inline bool ane_fw_command_denied(u16 id)
+{
+	switch (id) {
+	case 0x27:
+	case 0x28:
+	case 0x30:
+	case 0x31:
+	case 0x34:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static inline void ane_fw_command_header(void *command, u16 opcode, bool zero_reserved)
+{
+	u8 *p = command;
+
+	if (zero_reserved)
+		put_unaligned_le32(0, p);
+	put_unaligned_le16(opcode, p + 4);
+	put_unaligned_le16(0, p + 6);
+}
+
+/* A firmware refusal is distinct from corruption and never means success. */
+static inline int
+ane_fw_reply_status(u64 header, u64 slot_length, u64 slot_result,
+		    u64 command_dva, size_t length, u16 opcode, const void *command,
+		    bool zero_reserved)
+{
+	const u8 *p = command;
+
+	if (header & 2)
+		return -EPROTO;
+	if (!(header & 1))
+		return -EAGAIN;
+	if (!command || length < 8 || (command_dva & 1) || header != (command_dva | 1) ||
+	    slot_length != length || slot_result ||
+	    (zero_reserved && get_unaligned_le32(p)) ||
+	    get_unaligned_le16(p + 4) != opcode)
+		return -EPROTO;
+	return get_unaligned_le16(p + 6) ? -EREMOTEIO : 0;
+}
+
+static inline int ane_fw_config_status(const void *command, size_t length)
+{
+	if (!command || length != 16 || get_unaligned_le32((const u8 *)command + 8) !=
+			    ANE_FW_TICK_RATE)
+		return -EPROTO;
+	return 0;
+}
+
+/* Legacy H14/comparator layout only; H16 27.0 reports are 0x60 bytes. */
+static inline int
+ane_fw_finished_event(const void *event, size_t length, u64 cookie,
+		      u32 program, u32 process)
+{
+	const u8 *p = event;
+	u32 state;
+
+	if (!p || length != 0x28 || get_unaligned_le32(p + 4) != 0x300 ||
+	    get_unaligned_le64(p + 8) != cookie ||
+	    get_unaligned_le32(p + 0x10) != program ||
+	    get_unaligned_le32(p + 0x14) != process ||
+	    get_unaligned_le32(p + 0x18))
+		return -EPROTO;
+	state = get_unaligned_le32(p + 0x1c);
+	return state > 1 ? -EPROTO : state;
+}
+
+enum ane_fw_rtk_phase {
+	ANE_FW_RTK_HELLO,
+	ANE_FW_RTK_EPMAP,
+	ANE_FW_RTK_IOP_ACK,
+	ANE_FW_RTK_AP_ACK,
+	ANE_FW_RTK_READY,
+};
+
+struct ane_fw_rtk {
+	u32 endpoints[8];
+	u8 fragments;
+	enum ane_fw_rtk_phase phase;
+};
+
+#define ANE_FW_RTK_TYPE(t) ((u64)(t) << 52)
+#define ANE_FW_RTK_LAST BIT_ULL(51)
+
+/* The caller owns one absolute deadline for the complete management session. */
+static inline int
+ane_fw_rtk_receive(struct ane_fw_rtk *rtk, u64 word0, u64 word1,
+		   void *ctx, int (*send)(void *ctx, u64 word0, u64 word1))
+{
+	static const u8 system_eps[] = { 1, 2, 3, 4, 8, 10 };
+	u32 type = (word0 >> 52) & 0xff;
+	unsigned int base, ep, i;
+	int ret;
+
+	if (word1 & 0xff)
+		return -EOPNOTSUPP;
+	switch (type) {
+	case 1:
+		if (rtk->phase != ANE_FW_RTK_HELLO || (word0 & 0xffff) > 12 ||
+		    ((word0 >> 16) & 0xffff) < 12)
+			return -EPROTO;
+		ret = send(ctx, ANE_FW_RTK_TYPE(2) | (12 << 16) | 12, 0);
+		if (!ret)
+			rtk->phase = ANE_FW_RTK_EPMAP;
+		return ret;
+	case 8:
+		if (rtk->phase != ANE_FW_RTK_EPMAP)
+			return -EPROTO;
+		base = (word0 >> 32) & 7;
+		if (rtk->fragments & BIT(base))
+			return -EPROTO;
+		rtk->fragments |= BIT(base);
+		rtk->endpoints[base] = word0;
+		ret = send(ctx, ANE_FW_RTK_TYPE(8) | ((u64)base << 32) |
+			   (word0 & ANE_FW_RTK_LAST ? ANE_FW_RTK_LAST : 1), 0);
+		if (ret || !(word0 & ANE_FW_RTK_LAST))
+			return ret;
+		for (i = 0; i < ARRAY_SIZE(system_eps); i++) {
+			ep = system_eps[i];
+			if (!(rtk->endpoints[0] & BIT(ep)))
+				continue;
+			ret = send(ctx, ANE_FW_RTK_TYPE(5) | ((u64)ep << 32) | 2, 0);
+			if (ret)
+				return ret;
+		}
+		ret = send(ctx, ANE_FW_RTK_TYPE(6) | 0x20, 0);
+		if (!ret)
+			rtk->phase = ANE_FW_RTK_IOP_ACK;
+		return ret;
+	case 7:
+		if (rtk->phase != ANE_FW_RTK_IOP_ACK || (word0 & 0xffff) != 0x20)
+			return -EPROTO;
+		ret = send(ctx, ANE_FW_RTK_TYPE(0xb) | 0x20, 0);
+		if (!ret)
+			rtk->phase = ANE_FW_RTK_AP_ACK;
+		return ret;
+	case 0xb:
+		if (rtk->phase != ANE_FW_RTK_AP_ACK || (word0 & 0xffff) != 0x20)
+			return -EPROTO;
+		for (ep = 0x20; ep < 0x100; ep++) {
+			if (!(rtk->endpoints[ep / 32] & BIT(ep % 32)))
+				continue;
+			ret = send(ctx, ANE_FW_RTK_TYPE(5) | ((u64)ep << 32) | 2, 0);
+			if (ret)
+				return ret;
+		}
+		rtk->phase = ANE_FW_RTK_READY;
+		return 0;
+	case 0xc:
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+#endif /* __ANE_FW_PROTOCOL_H__ */
diff --git a/drivers/accel/ane/ane_fw_protocol_test.c b/drivers/accel/ane/ane_fw_protocol_test.c
