+	for (n = 0; n < ane->channels[5].slots; n++) {
+		ret = ane_rtclient_malloc_service(ane, &ane->legacy_malloc_cursor);
+		if (ret <= 0)
+			break;
+	}
+	return ret < 0 ? ret : 0;
+}
