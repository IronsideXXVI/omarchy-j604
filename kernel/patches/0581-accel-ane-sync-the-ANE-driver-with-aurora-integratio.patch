+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_H16_HWX_TEST_FIXTURE_H__
+#define __ANE_H16_HWX_TEST_FIXTURE_H__
+
+/* Synthetic H16G containers shared by the HWX and program KUnit suites. */
+#include <kunit/test.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+struct hwx_fixture {
+	u8 *bytes;
+	size_t size, cursor;
+	u32 commands, program, tensor[2], segment[2], text_command, symtab, reloc;
+	u32 symbols, strings;
+};
+
+static u8 *fixture_command(struct hwx_fixture *f, u32 command, u32 length)
+{
+	u8 *c = f->bytes + f->cursor;
+
+	put_unaligned_le32(command, c);
+	put_unaligned_le32(length, c + 4);
+	f->cursor += length;
+	f->commands++;
+	return c;
+}
+
+static u8 *fixture_segment(struct hwx_fixture *f, const char *name, u64 vm,
+			   u64 size, u32 offset, u32 prot, u32 flags, u32 sections)
+{
+	u8 *c = fixture_command(f, 0x19, 72 + sections * 80);
+
+	strscpy(c + 8, name, 16);
+	put_unaligned_le64(vm, c + 24);
+	put_unaligned_le64(size, c + 32);
+	put_unaligned_le64(offset, c + 40);
+	put_unaligned_le64(offset ? size : 0, c + 48);
+	put_unaligned_le32(prot, c + 56);
+	put_unaligned_le32(prot, c + 60);
+	put_unaligned_le32(sections, c + 64);
+	put_unaligned_le32(flags, c + 68);
+	return c + 72;
+}
+
+static void fixture_section(u8 *s, const char *segment, const char *name,
+			    u64 vm, u64 size, u32 offset, u32 alignment, u32 flags)
+{
+	strscpy(s, name, 16);
+	strscpy(s + 16, segment, 16);
+	put_unaligned_le64(vm, s + 32);
+	put_unaligned_le64(size, s + 40);
+	put_unaligned_le32(offset, s + 48);
+	put_unaligned_le32(alignment, s + 52);
+	put_unaligned_le32(flags, s + 64);
+}
+
+static struct hwx_fixture *fixture_create(struct kunit *test, bool mixed, bool kernel)
+{
+	struct hwx_fixture *f;
+	u64 surface = 0x30000000 + (mixed ? SZ_16K : 0);
+	u64 text = surface + 2 * SZ_16K, kern = text + SZ_32K;
+	u32 i, strings_length = 1;
+	u8 *c, *s, *text_section;
+	static const char * const names[] = { "in", "out" };
+	static const char * const symbols[] = { "input", "output" };
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->size = kernel ? SZ_64K : SZ_32K + SZ_16K;
+	f->bytes = kunit_kzalloc(test, f->size, GFP_KERNEL);
+	if (!f->bytes)
+		return NULL;
+	f->cursor = 32;
+	fixture_segment(f, "__PAGEZERO", 0, SZ_16K, 0, 0, 4, 0);
+	if (mixed) {
+		s = fixture_segment(f, "__DATA", 0x30000000, SZ_16K, 0, 3, 4, 1);
+		fixture_section(s, "__DATA", "__bss", 0x30000000, SZ_16K, 0, 6, 0x25);
+	}
+	for (i = 0; i < 2; i++) {
+		f->segment[i] = f->cursor;
+		s = fixture_segment(f, "__FVMLIB", surface + i * SZ_16K, SZ_16K,
+				    0, i + 1, 6, 1);
+		fixture_section(s, "__FVMLIB", i ? "__data" : "__const",
+				surface + i * SZ_16K, SZ_16K, 0, 14, i ? 0x23 : 0x21);
+	}
+	f->text_command = f->cursor;
+	text_section = fixture_segment(f, "__TEXT", text, SZ_32K, SZ_16K, 5,
+				       mixed ? 4 : 0, 2);
+	fixture_section(text_section, "__TEXT", "__text", text, 64, SZ_16K,
+			14, kernel ? 0x128 : 0x28);
+	fixture_section(text_section + 80, "__TEXT", "__const", text + 64,
+			SZ_16K, SZ_16K + 64, 6, 0x26);
+	if (kernel) {
+		s = fixture_segment(f, "__KERN_0", kern, SZ_16K, SZ_32K + SZ_16K, 1, 4, 1);
+		fixture_section(s, "__KERN_0", "__kern_0", kern, 64,
+				SZ_32K + SZ_16K, 6, 0x26);
+	}
+	for (i = 0; i < 2; i++) {
+		c = fixture_command(f, 0x40, 32);
+		put_unaligned_le64(0x18, c + 8);
+		put_unaligned_le64(surface + i * SZ_16K, c + 0x10);
+		strscpy(c + 0x18, names[i], 8);
+	}
+	f->program = f->cursor;
+	c = fixture_command(f, 4, mixed ? 0x8c0 : 0x8a0);
+	put_unaligned_le32(4, c + 8);
+	put_unaligned_le32(mixed ? 0x22a : 0x222, c + 0xc);
+	put_unaligned_le64(text, c + 0x10);
+	put_unaligned_le64(text + 64, c + 0x20);
+	if (mixed)
+		put_unaligned_le64(0x30000000, c + 0x40);
+	for (i = 0; i < 2; i++)
+		put_unaligned_le64(surface + i * SZ_16K, c + 0x70 + i * 16);
+	if (kernel)
+		put_unaligned_le64(kern, c + 0x90);
+	put_unaligned_le64(text, c + 0x810);
+	put_unaligned_le32(4, c + 0x820);
+	put_unaligned_le32(16, c + 0x824);
+	put_unaligned_le32(1, c + 0x830);
+	put_unaligned_le32(U32_MAX, c + 0x838);
+	put_unaligned_le32(U32_MAX, c + 0x83c);
+	put_unaligned_le32(0xffff, c + 0x844);
+	put_unaligned_le32(mixed ? 0x8b8 : 0x898, c + 0x848);
+	put_unaligned_le32(0x10, c + 0x860);
+	put_unaligned_le32(4, c + 0x868);
+	put_unaligned_le32(mixed ? 4 : 2, c + 0x870);
+	put_unaligned_le32(mixed ? 2 : 7, c + 0x878);
+	put_unaligned_le32(8, c + 0x87c);
+	put_unaligned_le32(mixed ? 256 : 0x461c4000, c + 0x880);
+	put_unaligned_le32(mixed ? 3 : 9, c + 0x888);
+	put_unaligned_le32(8, c + 0x88c);
+	if (mixed) {
+		put_unaligned_le32(256, c + 0x858);
+		put_unaligned_le32(0x08020004, c + 0x890);
+		put_unaligned_le32(8, c + 0x894);
+		put_unaligned_le32(7, c + 0x898);
+		put_unaligned_le32(8, c + 0x89c);
+		put_unaligned_le32(0x461c4000, c + 0x8a0);
+		put_unaligned_le32(9, c + 0x8a8);
+		put_unaligned_le32(8, c + 0x8ac);
+	}
+	memcpy(c + (mixed ? 0x8b8 : 0x898), "main", 5);
+	for (i = 0; i < 2; i++) {
+		u32 shortoff = 0xd3d + strlen(symbols[i]) + 1;
+
+		f->tensor[i] = f->cursor;
+		c = fixture_command(f, 4, 0xd48);
+		put_unaligned_le32(3, c + 8);
+		put_unaligned_le32(0x34a, c + 0xc);
+		put_unaligned_le32(3, c + 0x10);
+		put_unaligned_le32(i + 1, c + 0x14);
+		put_unaligned_le32(0xd38, c + 0x18);
+		put_unaligned_le32(0xd3d, c + 0x20);
+		put_unaligned_le32(5, c + 0x24);
+		put_unaligned_le32(1, c + 0x28);
+		put_unaligned_le32(1, c + 0x2c);
+		put_unaligned_le32(1, c + 0x30);
+		put_unaligned_le32(128, c + 0x34);
+		put_unaligned_le32(1, c + 0x38);
+		put_unaligned_le64(256, c + 0x50);
+		put_unaligned_le64(256, c + 0x58);
+		put_unaligned_le64(256, c + 0x60);
+		put_unaligned_le64(2, c + 0x68);
+		put_unaligned_le64(256, c + 0x70);
+		put_unaligned_le32(1, c + 0x78);
+		put_unaligned_le32(shortoff, c + 0x7c);
+		put_unaligned_le64(256, c + 0x80);
+		memcpy(c + 0xd38, "main", 5);
+		memcpy(c + 0xd3d, symbols[i], strlen(symbols[i]) + 1);
+		memcpy(c + shortoff, names[i], strlen(names[i]) + 1);
+	}
+	f->symtab = f->cursor;
+	c = fixture_command(f, 2, 24);
+	f->symbols = f->cursor;
+	f->strings = f->symbols + 2 * 16;
+	for (i = 0; i < 2; i++) {
+		u8 *symbol = f->bytes + f->symbols + i * 16;
+
+		put_unaligned_le32(strings_length, symbol);
+		symbol[4] = 0xf;
+		symbol[5] = (mixed ? 2 : 1) + i;
+		put_unaligned_le64(surface + i * SZ_16K, symbol + 8);
+		memcpy(f->bytes + f->strings + strings_length, names[i], strlen(names[i]) + 1);
+		strings_length += strlen(names[i]) + 1;
+	}
+	put_unaligned_le32(f->symbols, c + 8);
+	put_unaligned_le32(2, c + 12);
+	put_unaligned_le32(f->strings, c + 16);
+	put_unaligned_le32(strings_length, c + 20);
+	f->reloc = ALIGN(f->strings + strings_length, 8);
+	if (kernel) {
+		put_unaligned_le32(f->reloc, text_section + 56);
+		put_unaligned_le32(1, text_section + 60);
+		put_unaligned_le32(56, f->bytes + f->reloc);
+		put_unaligned_le32(0x07000000 | (mixed ? 6 : 5), f->bytes + f->reloc + 4);
+		put_unaligned_le32(32, f->bytes + SZ_16K + 56);
+	}
+	/* Fixed H16 task prologue: u32 1, then twelve zero bytes. */
+	put_unaligned_le32(1, f->bytes + SZ_16K);
+	put_unaligned_le32(11 << 16, f->bytes + SZ_16K + 16);
+	put_unaligned_le32(0x4100 / 4, f->bytes + SZ_16K + 52);
+	put_unaligned_le32(0xbeefface, f->bytes);
+	put_unaligned_le32(0x80, f->bytes + 4);
+	put_unaligned_le32(7, f->bytes + 8);
+	put_unaligned_le32(2, f->bytes + 12);
+	put_unaligned_le32(f->commands, f->bytes + 16);
+	put_unaligned_le32(f->cursor - 32, f->bytes + 20);
+	put_unaligned_le32(0x200000, f->bytes + 24);
+	return f;
+}
+
+#endif /* __ANE_H16_HWX_TEST_FIXTURE_H__ */
diff --git a/drivers/accel/ane/ane_h16_load.c b/drivers/accel/ane/ane_h16_load.c
new file mode 100644
index 0000000000..66a41c7eeb
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_load.c
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <linux/module.h>
+
+#include "ane_h16_load.h"
+
+static int h16_load_plan(const struct ane_h16_hwx *hwx, struct ane_h16_load_plan *plan)
+{
+	struct ane_h16_load_plan next = {};
+	unsigned int i;
+
+	if (!hwx->region_count || hwx->region_count > ANE_H16_REGIONS)
+		return -ENOEXEC;
+	next.count = hwx->region_count;
+	for (i = 0; i < next.count; i++) {
+		const struct ane_h16_hwx_region *r = &hwx->regions[i];
+		u64 rounded;
+
+		if (!r->size || check_add_overflow(r->size, (u64)SZ_16K - 1, &rounded))
+			return -ENOEXEC;
+		next.allocation[i] = round_down(rounded, SZ_16K);
+		if (check_add_overflow(next.total, next.allocation[i], &next.total) ||
+		    next.total > ANE_H16_LOAD_BYTES_MAX)
+			return -E2BIG;
+		next.regions[i] = *r;
+	}
+	*plan = next;
+	return 0;
+}
+
+int ane_h16_load_plan_create(const struct ane_h16_hwx_snapshot *snapshot,
+			     struct ane_h16_load_plan *plan)
+{
+	struct ane_h16_hwx hwx;
+	int ret;
+
+	if (!plan)
+		return -EINVAL;
+	ret = ane_h16_hwx_snapshot_check(snapshot);
+	if (ret)
+		return ret;
+	/* Reparse the authenticated original, not caller-supplied cached metadata. */
+	ret = ane_h16_hwx_validate(snapshot->bytes, snapshot->size, &hwx);
+	if (ret)
+		return ret;
+	return h16_load_plan(&hwx, plan);
+}
+EXPORT_SYMBOL_GPL(ane_h16_load_plan_create);
+
+int ane_h16_load_resources_create(const struct ane_h16_hwx_snapshot *snapshot,
+				  const struct ane_h16_load_mapping *mappings,
+				  unsigned int mapping_count,
+				  const struct ane_h16_process_binding *bindings,
+				  unsigned int binding_count,
+				  struct ane_h16_resource *resources)
+{
+	struct ane_h16_resource next[ANE_H16_SURFACES] = {};
+	struct ane_h16_load_plan plan;
+	struct ane_h16_hwx hwx;
+	unsigned int i, j;
+	int ret;
+
+	if (!mappings || !bindings || !resources)
+		return -EINVAL;
+	ret = ane_h16_hwx_snapshot_check(snapshot);
+	if (ret)
+		return ret;
+	ret = ane_h16_hwx_validate(snapshot->bytes, snapshot->size, &hwx);
+	if (ret)
+		return ret;
+	ret = h16_load_plan(&hwx, &plan);
+	if (ret)
+		return ret;
+	if (mapping_count != plan.count || binding_count != hwx.surface_count)
+		return -EINVAL;
+	for (i = 0; i < mapping_count; i++) {
+		const struct ane_h16_load_mapping *m = &mappings[i];
+		u64 end;
+
+		if (!m->dva || !IS_ALIGNED(m->dva, SZ_16K) ||
+		    m->size != plan.allocation[i] ||
+		    m->permissions != plan.regions[i].permissions ||
+		    check_add_overflow(m->dva, m->size, &end) ||
+		    (m->dva < 0x1000036c000ULL && end > 0x10000000000ULL))
+			return -EINVAL;
+		for (j = 0; j < i; j++)
+			if (m->dva < mappings[j].dva + mappings[j].size &&
+			    mappings[j].dva < end)
+				return -EINVAL;
+	}
+	for (i = 0; i < binding_count; i++) {
+		const struct ane_h16_hwx_surface *s = &hwx.surfaces[i];
+		const struct ane_h16_process_binding *b = &bindings[i];
+
+		if (b->hwx_vm != s->section.vm || b->class != s->direction - 1)
+			return -EINVAL;
+		for (j = 0; j < plan.count; j++)
+			if (plan.regions[j].kind == ANE_H16_REGION_SURFACE &&
+			    plan.regions[j].vm == b->hwx_vm)
+				break;
+		if (j == plan.count)
+			return -EINVAL;
+		next[i].hwx_vm = b->hwx_vm;
+		next[i].permissions = s->direction;
+		next[i].buffer = (struct ane_h16_execute_buffer) {
+			.index = b->index,
+			.class = b->class,
+			.mapping_dva = mappings[j].dva,
+			.mapping_size = mappings[j].size,
+			.size = s->span,
+		};
+	}
+	ret = ane_h16_resources_validate(&hwx, next, binding_count);
+	if (!ret)
+		memcpy(resources, next, binding_count * sizeof(*resources));
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ane_h16_load_resources_create);
+
+MODULE_DESCRIPTION("H16 original HWX load planning and resource geometry");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/accel/ane/ane_h16_load.h b/drivers/accel/ane/ane_h16_load.h
new file mode 100644
index 0000000000..ba55b58385
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_load.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_H16_LOAD_H__
+#define __ANE_H16_LOAD_H__
+
+#include "ane_h16_resources.h"
+
+/* Conservative host budget; firmware resource replies cannot enlarge it. */
+#define ANE_H16_LOAD_BYTES_MAX SZ_512M
+
+struct ane_h16_load_plan {
+	struct ane_h16_hwx_region regions[ANE_H16_REGIONS];
+	u64 allocation[ANE_H16_REGIONS];
+	u64 total;
+	u32 count;
+};
+
+struct ane_h16_load_mapping {
+	u64 dva;
+	u64 size;
+	u32 permissions;
+};
+
+/* Only the backend may resolve these bindings from the validated program
+ * contract. CREATE_PROCESS reply IDs do not describe resource bindings.
+ */
+struct ane_h16_process_binding {
+	u64 hwx_vm;
+	u32 index;
+	u32 class;
+	/* Buffer size the generic section declared at LOAD. */
+	u64 bytes;
+};
+
+/* Geometry helpers do not prove DMA ownership or install a process. All
+ * mappings must be backend-owned and private, with the stated permissions.
+ * Wire serialization and process installation are separate backend operations.
+ */
+int ane_h16_load_plan_create(const struct ane_h16_hwx_snapshot *snapshot,
+			     struct ane_h16_load_plan *plan);
+int ane_h16_load_resources_create(const struct ane_h16_hwx_snapshot *snapshot,
+				  const struct ane_h16_load_mapping *mappings,
+				  unsigned int mapping_count,
+				  const struct ane_h16_process_binding *bindings,
+				  unsigned int binding_count,
+				  struct ane_h16_resource *resources);
+
+#endif /* __ANE_H16_LOAD_H__ */
diff --git a/drivers/accel/ane/ane_h16_pending.h b/drivers/accel/ane/ane_h16_pending.h
new file mode 100644
index 0000000000..b74b20a0b0
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_pending.h
@@ -0,0 +1,143 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_H16_PENDING_H__
+#define __ANE_H16_PENDING_H__
+
+#include <linux/jiffies.h>
+
+#include "ane_h16_execute.h"
+
+#define ANE_H16_PENDING_MAX 64
+
+struct ane_h16_pending {
+	struct ane_h16_request_key key;
+	unsigned long deadline;
+	int status;
+	bool active;
+	bool terminal;
+};
+
+/* All operations, including event dispatch, require the firmware mutex. */
+struct ane_h16_pending_table {
+	struct ane_h16_pending *slots[ANE_H16_PENDING_MAX];
+	u64 next_uuid;
+	int error;
+	bool quarantined;
+};
+
+static inline int
+ane_h16_pending_insert(struct ane_h16_pending_table *table,
+		       struct ane_h16_pending *request, unsigned long now)
+{
+	unsigned int i;
+
+	if (table->quarantined)
+		return -EIO;
+	if (!request || request->active || time_after_eq(now, request->deadline))
+		return -EINVAL;
+	for (i = 0; i < ANE_H16_PENDING_MAX; i++)
+		if (table->slots[i] == request)
+			return -EEXIST;
+	if (table->next_uuid == U64_MAX)
+		return -EOVERFLOW;
+	for (i = 0; i < ANE_H16_PENDING_MAX; i++) {
+		if (table->slots[i])
+			continue;
+		/* Never reuse a UUID, including after pre-publication failure. */
+		request->key.uuid = ++table->next_uuid;
+		request->status = -EINPROGRESS;
+		request->terminal = false;
+		request->active = true;
+		table->slots[i] = request;
+		return 0;
+	}
+	return -ENOSPC;
+}
+
+/* Removal is not permission to release DMA backing. */
+static inline void
+ane_h16_pending_remove(struct ane_h16_pending_table *table,
+		       struct ane_h16_pending *request)
+{
+	unsigned int i;
+
+	for (i = 0; i < ANE_H16_PENDING_MAX; i++)
+		if (table->slots[i] == request)
+			table->slots[i] = NULL;
+	request->active = false;
+}
+
+/* A published command with an uncertain outcome pins all its mappings. */
+static inline void
+ane_h16_pending_abort(struct ane_h16_pending_table *table,
+		      struct ane_h16_pending *request, int status)
+{
+	table->quarantined = true;
+	table->error = status;
+	ane_h16_pending_remove(table, request);
+	request->status = status;
+}
+
+static inline int
+ane_h16_pending_event(struct ane_h16_pending_table *table, const void *bytes,
+		      size_t length, unsigned int channel, unsigned long now)
+{
+	struct ane_h16_pending *request = NULL;
+	struct ane_h16_event event;
+	unsigned int i;
+	int ret;
+
+	if (table->quarantined)
+		return -EIO;
+	ret = ane_h16_event_decode(bytes, length, channel, &event);
+	if (ret)
+		goto corrupt;
+	if (event.destination)
+		return -ENOMSG;
+	for (i = 0; i < ANE_H16_PENDING_MAX; i++)
+		if (table->slots[i] && table->slots[i]->key.uuid == event.key.uuid) {
+			request = table->slots[i];
+			break;
+		}
+	/* Duplicates and late/foreign UUIDs can never retire another call. */
+	if (!request)
+		return -ENOENT;
+	ret = ane_h16_event_result(bytes, length, channel, &request->key);
+	if (ret < 0)
+		goto corrupt;
+	if (time_after_eq(now, request->deadline)) {
+		ane_h16_pending_abort(table, request, -ETIMEDOUT);
+		return -ETIMEDOUT;
+	}
+	if (ret == ANE_H16_EVENT_PROGRESS)
+		return ret;
+	ane_h16_pending_remove(table, request);
+	request->terminal = true;
+	request->status = ret == ANE_H16_EVENT_COMPLETE ? 0 : -EIO;
+	if (request->status) {
+		table->error = request->status;
+		table->quarantined = true;
+	}
+	return ret;
+
+corrupt:
+	table->error = ret;
+	table->quarantined = true;
+	return ret;
+}
+
+/* Channel-6 CPU-load notifications are diagnostics, never completions. */
+static inline int
+ane_h16_pending_dispatch(struct ane_h16_pending_table *table, const void *bytes,
+			 size_t length, unsigned int channel, unsigned long now)
+{
+	const u8 *p = bytes;
+
+	if (table->quarantined)
+		return -EIO;
+	if (p && channel == 6 && length == 0xc &&
+	    get_unaligned_le16(p + 4) == 0x0107 && !get_unaligned_le16(p + 6))
+		return ANE_H16_EVENT_PROGRESS;
+	return ane_h16_pending_event(table, bytes, length, channel, now);
+}
+
+#endif /* __ANE_H16_PENDING_H__ */
diff --git a/drivers/accel/ane/ane_h16_pending_test.c b/drivers/accel/ane/ane_h16_pending_test.c
new file mode 100644
index 0000000000..bff31e3d9c
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_pending_test.c
@@ -0,0 +1,329 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <kunit/test.h>
+#include <linux/module.h>
+
+#include "ane_h16_pending.h"
+#include "ane_h16_resources.h"
+
+static void make_event(u8 *bytes, const struct ane_h16_pending *request, u32 state)
+{
+	memset(bytes, 0, 0x60);
+	put_unaligned_le32(0x12345678, bytes);
+	put_unaligned_le16(ANE_H16_EVENT_REPORT, bytes + 4);
+	put_unaligned_le64(request->key.uuid, bytes + 8);
+	put_unaligned_le32(request->key.program, bytes + 0x10);
+	put_unaligned_le32(request->key.process, bytes + 0x14);
+	put_unaligned_le32(request->key.procedure, bytes + 0x18);
+	put_unaligned_le32(state, bytes + 0x1c);
+}
+
+static void pending_sequence_test(struct kunit *test)
+{
+	struct ane_h16_pending_table table = {};
+	struct ane_h16_pending a = { .key = { .program = 7, .process = 8, .procedure = 9 },
+				     .deadline = 100 };
+	struct ane_h16_pending b = { .key = a.key, .deadline = 100 };
+	u8 event[0x60], ack[8] = {};
+	u32 state;
+
+	KUNIT_ASSERT_EQ(test, ane_h16_pending_insert(&table, &a, 0), 0);
+	KUNIT_ASSERT_EQ(test, ane_h16_pending_insert(&table, &b, 0), 0);
+	KUNIT_EXPECT_NE(test, a.key.uuid, b.key.uuid);
+	/* A valid transport acknowledgment leaves both UUIDs pending. */
+	put_unaligned_le16(ANE_H16_EXECUTE, ack + 4);
+	KUNIT_EXPECT_EQ(test, ane_fw_reply_status(0x10001, 0xca8, 0,
+						  0x10000, 0xca8, ANE_H16_EXECUTE, ack, true), 0);
+	KUNIT_EXPECT_TRUE(test, a.active);
+	KUNIT_EXPECT_TRUE(test, b.active);
+	for (state = 0; state <= 3; state += 3) {
+		make_event(event, &a, state);
+		KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0x60, 6, 1),
+				ANE_H16_EVENT_PROGRESS);
+		KUNIT_EXPECT_TRUE(test, a.active);
+		KUNIT_EXPECT_FALSE(test, a.terminal);
+	}
+	make_event(event, &b, 1);
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0x60, 6, 2),
+			ANE_H16_EVENT_COMPLETE);
+	KUNIT_EXPECT_TRUE(test, b.terminal);
+	KUNIT_EXPECT_EQ(test, b.status, 0);
+	KUNIT_EXPECT_FALSE(test, b.active);
+	KUNIT_EXPECT_TRUE(test, a.active);
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0x60, 6, 3), -ENOENT);
+	make_event(event, &a, 1);
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0x60, 6, 4),
+			ANE_H16_EVENT_COMPLETE);
+	KUNIT_EXPECT_FALSE(test, table.quarantined);
+}
+
+static void pending_mismatched_ids_test(struct kunit *test)
+{
+	unsigned int offset;
+
+	for (offset = 0x10; offset <= 0x18; offset += 4) {
+		struct ane_h16_pending_table table = {};
+		struct ane_h16_pending request = { .deadline = 100 };
+		u8 event[0x60];
+
+		KUNIT_ASSERT_EQ(test, ane_h16_pending_insert(&table, &request, 0), 0);
+		make_event(event, &request, 1);
+		put_unaligned_le32(1, event + offset);
+		KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0x60, 6, 1), -EPROTO);
+		KUNIT_EXPECT_TRUE(test, request.active);
+		KUNIT_EXPECT_FALSE(test, request.terminal);
+		KUNIT_EXPECT_TRUE(test, table.quarantined);
+		KUNIT_EXPECT_EQ(test, table.error, -EPROTO);
+		ane_h16_pending_abort(&table, &request, -EIO);
+		KUNIT_EXPECT_FALSE(test, request.active);
+	}
+}
+
+static void pending_malformed_test(struct kunit *test)
+{
+	unsigned int variant;
+
+	for (variant = 0; variant < 9; variant++) {
+		struct ane_h16_pending_table table = {};
+		struct ane_h16_pending request = { .deadline = 100 };
+		u8 event[0x60];
+		unsigned int channel = 6;
+		size_t length = sizeof(event);
+		const void *bytes = event;
+
+		KUNIT_ASSERT_EQ(test, ane_h16_pending_insert(&table, &request, 0), 0);
+		make_event(event, &request, 1);
+		switch (variant) {
+		case 0:
+			bytes = NULL;
+			break;
+		case 1:
+			length--;
+			break;
+		case 2:
+			length++;
+			break;
+		case 3:
+			channel = 7;
+			break;
+		case 4:
+			put_unaligned_le16(ANE_H16_EXECUTE, event + 4);
+			break;
+		case 5:
+			event[6] = 1;
+			break;
+		case 6:
+			event[7] = 1;
+			break;
+		case 7:
+			put_unaligned_le32(4, event + 0x1c);
+			break;
+		case 8:
+			event[0x30] = 2;
+			break;
+		}
+		KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, bytes, length, channel, 1),
+				-EPROTO);
+		KUNIT_EXPECT_TRUE(test, request.active);
+		KUNIT_EXPECT_TRUE(test, table.quarantined);
+	}
+}
+
+static void pending_routing_test(struct kunit *test)
+{
+	struct ane_h16_pending_table table = {};
+	struct ane_h16_pending request = { .deadline = 100 };
+	u8 event[0x60];
+
+	KUNIT_ASSERT_EQ(test, ane_h16_pending_insert(&table, &request, 0), 0);
+	make_event(event, &request, 1);
+	event[0x30] = 1;
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0x60, 6, 1), -ENOMSG);
+	event[0x30] = 0;
+	put_unaligned_le64(request.key.uuid + 1, event + 8);
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0x60, 6, 1), -ENOENT);
+	memset(event, 0, sizeof(event));
+	put_unaligned_le16(0x0107, event + 4);
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0xc, 6, 1),
+			ANE_H16_EVENT_PROGRESS);
+	KUNIT_EXPECT_TRUE(test, request.active);
+	KUNIT_EXPECT_FALSE(test, table.quarantined);
+	event[7] = 1;
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0xc, 6, 1), -EPROTO);
+	KUNIT_EXPECT_TRUE(test, table.quarantined);
+}
+
+static void pending_failure_test(struct kunit *test)
+{
+	struct ane_h16_pending_table table = {};
+	struct ane_h16_pending request = { .deadline = 100 };
+	struct ane_h16_pending next = { .deadline = 100 };
+	u8 event[0x60];
+
+	KUNIT_ASSERT_EQ(test, ane_h16_pending_insert(&table, &request, 0), 0);
+	make_event(event, &request, 2);
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0x60, 6, 1),
+			ANE_H16_EVENT_FAILED);
+	KUNIT_EXPECT_FALSE(test, request.active);
+	KUNIT_EXPECT_TRUE(test, request.terminal);
+	KUNIT_EXPECT_EQ(test, request.status, -EIO);
+	KUNIT_EXPECT_TRUE(test, table.quarantined);
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_insert(&table, &next, 2), -EIO);
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0x60, 6, 2), -EIO);
+}
+
+static void pending_timeout_test(struct kunit *test)
+{
+	struct ane_h16_pending_table table = {};
+	struct ane_h16_pending request = { .deadline = 100 };
+	u8 event[0x60];
+
+	KUNIT_ASSERT_EQ(test, ane_h16_pending_insert(&table, &request, 0), 0);
+	make_event(event, &request, 1);
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0x60, 6, 100), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, request.status, -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, table.error, -ETIMEDOUT);
+	KUNIT_EXPECT_FALSE(test, request.terminal);
+	KUNIT_EXPECT_FALSE(test, request.active);
+	KUNIT_EXPECT_TRUE(test, table.quarantined);
+	/* Late success never makes output readable after timeout. */
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0x60, 6, 101), -EIO);
+}
+
+static void pending_transport_failure_test(struct kunit *test)
+{
+	static const int errors[] = { -ETIMEDOUT, -EPROTO, -EREMOTEIO, -EIO };
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(errors); i++) {
+		struct ane_h16_pending_table table = {};
+		struct ane_h16_pending request = { .deadline = 100 };
+
+		KUNIT_ASSERT_EQ(test, ane_h16_pending_insert(&table, &request, 0), 0);
+		ane_h16_pending_abort(&table, &request, errors[i]);
+		KUNIT_EXPECT_FALSE(test, request.active);
+		KUNIT_EXPECT_FALSE(test, request.terminal);
+		KUNIT_EXPECT_EQ(test, request.status, errors[i]);
+		KUNIT_EXPECT_TRUE(test, table.quarantined);
+	}
+}
+
+static void pending_capacity_test(struct kunit *test)
+{
+	struct ane_h16_pending_table table = {};
+	struct ane_h16_pending *requests;
+	unsigned int i;
+
+	requests = kunit_kcalloc(test, ANE_H16_PENDING_MAX + 1, sizeof(*requests), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, requests);
+	for (i = 0; i <= ANE_H16_PENDING_MAX; i++)
+		requests[i].deadline = 100;
+	for (i = 0; i < ANE_H16_PENDING_MAX; i++) {
+		KUNIT_ASSERT_EQ(test, ane_h16_pending_insert(&table, &requests[i], 0), 0);
+		KUNIT_EXPECT_EQ(test, requests[i].key.uuid, (u64)i + 1);
+	}
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_insert(&table, &requests[i], 0), -ENOSPC);
+	ane_h16_pending_remove(&table, &requests[0]);
+	KUNIT_ASSERT_EQ(test, ane_h16_pending_insert(&table, &requests[i], 0), 0);
+	KUNIT_EXPECT_EQ(test, requests[i].key.uuid, (u64)ANE_H16_PENDING_MAX + 1);
+	ane_h16_pending_remove(&table, &requests[i]);
+	table.next_uuid = U64_MAX;
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_insert(&table, &requests[i], 0), -EOVERFLOW);
+}
+
+static void pending_deadline_wrap_test(struct kunit *test)
+{
+	struct ane_h16_pending_table table = {};
+	struct ane_h16_pending request = { .deadline = 3 };
+	u8 event[0x60];
+
+	KUNIT_ASSERT_EQ(test, ane_h16_pending_insert(&table, &request, ULONG_MAX - 4), 0);
+	make_event(event, &request, 1);
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_dispatch(&table, event, 0x60, 6, 1),
+			ANE_H16_EVENT_COMPLETE);
+	request.deadline = 3;
+	KUNIT_EXPECT_EQ(test, ane_h16_pending_insert(&table, &request, 3), -EINVAL);
+}
+
+static void resources_test(struct kunit *test)
+{
+	/* add-128 shape: input, output, input with class-local indices 0, 0, 1. */
+	static const u32 direction[3] = { 1, 2, 1 }, index[3] = { 0, 0, 1 };
+	struct ane_h16_hwx hwx = { .surface_count = 3 };
+	struct ane_h16_resource resources[3] = {};
+	unsigned int i, variant;
+
+	for (i = 0; i < 3; i++) {
+		hwx.surfaces[i].section.vm = 0x30000000 + i * SZ_16K;
+		hwx.surfaces[i].section.size = SZ_16K;
+		hwx.surfaces[i].allocation = SZ_16K;
+		hwx.surfaces[i].span = 256;
+		hwx.surfaces[i].direction = direction[i];
+		resources[i].hwx_vm = hwx.surfaces[i].section.vm;
+		resources[i].permissions = direction[i];
+		resources[i].buffer = (struct ane_h16_execute_buffer) {
+			.index = index[i], .class = direction[i] - 1,
+			.mapping_dva = 0x100000000ULL + i * SZ_16K,
+			.mapping_size = SZ_16K, .size = 256,
+		};
+	}
+	KUNIT_EXPECT_EQ(test, ane_h16_resources_validate(&hwx, resources, 3), 0);
+	KUNIT_EXPECT_EQ(test, ane_h16_resources_validate(&hwx, resources, 1), -EINVAL);
+	for (variant = 0; variant < 9; variant++) {
+		struct ane_h16_resource bad[3];
+
+		memcpy(bad, resources, sizeof(bad));
+		switch (variant) {
+		case 0:
+			bad[0].permissions = 2;
+			break;
+		case 1:
+			bad[0].hwx_vm++;
+			break;
+		case 2:
+			bad[0].buffer.class = 8;
+			break;
+		case 3:
+			bad[0].buffer.size++;
+			break;
+		case 4:
+			bad[0].buffer.offset = 1;
+			break;
+		case 5:
+			bad[0].buffer.mapping_dva = U64_MAX - SZ_16K + 1;
+			break;
+		case 6:
+			/* Same class and index: two inputs cannot share index 0. */
+			bad[2].buffer.index = bad[0].buffer.index;
+			break;
+		case 7:
+			bad[1].buffer.mapping_dva = bad[0].buffer.mapping_dva;
+			break;
+		case 8:
+			bad[0].buffer.mapping_size--;
+			break;
+		}
+		KUNIT_EXPECT_EQ(test, ane_h16_resources_validate(&hwx, bad, 3), -EINVAL);
+	}
+}
+
+static struct kunit_case pending_cases[] = {
+	KUNIT_CASE(pending_sequence_test),
+	KUNIT_CASE(pending_mismatched_ids_test),
+	KUNIT_CASE(pending_malformed_test),
+	KUNIT_CASE(pending_routing_test),
+	KUNIT_CASE(pending_failure_test),
+	KUNIT_CASE(pending_timeout_test),
+	KUNIT_CASE(pending_transport_failure_test),
+	KUNIT_CASE(pending_capacity_test),
+	KUNIT_CASE(pending_deadline_wrap_test),
+	KUNIT_CASE(resources_test),
+	{}
+};
+
+static struct kunit_suite pending_suite = {
+	.name = "ane-h16-pending",
+	.test_cases = pending_cases,
+};
+
+kunit_test_suite(pending_suite);
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/accel/ane/ane_h16_preload.c b/drivers/accel/ane/ane_h16_preload.c
new file mode 100644
index 0000000000..03bfbb021e
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_preload.c
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "ane_h16_preload.h"
+
+/*
+ * A rule is data, so check its shape before trusting it: records in DATA
+ * order, each record header and value inside DATA and clear of the previous
+ * value, and the rewritten range after the last value.
+ */
+static bool ane_h16_preload_rule_valid(const struct ane_h16_preload_rule *rule)
+{
+	u32 next = 8;
+	unsigned int i;
+
+	if (!rule->cells || !rule->cell_count)
+		return false;
+	for (i = 0; i < rule->cell_count; i++) {
+		const struct ane_h16_preload_cell *c = &rule->cells[i];
+
+		if (!c->width || c->value < next ||
+		    c->value + c->width > ANE_H16_PRELOAD_DATA_SIZE)
+			return false;
+		next = c->value + c->width + 8;
+	}
+	return rule->zero_start >= next - 8 && rule->zero_start <= rule->zero_end &&
+	       rule->zero_end <= ANE_H16_PRELOAD_DATA_SIZE;
+}
+
+static void ane_h16_hash_zeros(struct sha256_ctx *ctx, size_t length)
+{
+	static const u8 zero[64];
+
+	while (length) {
+		size_t chunk = min(length, sizeof(zero));
+
+		sha256_update(ctx, zero, chunk);
+		length -= chunk;
+	}
+}
+
+int ane_h16_preload_digest(const struct ane_h16_preload_rule *rule,
+			   const void *text, size_t text_size,
+			   const void *data, size_t data_size,
+			   u8 digest[SHA256_DIGEST_SIZE])
+{
+	const u8 *bytes = data;
+	struct sha256_ctx ctx;
+	size_t cursor = 0;
+	unsigned int i;
+
+	if (!rule || !text || !data || !digest || text_size != ANE_H16_PRELOAD_TEXT_SIZE ||
+	    data_size != ANE_H16_PRELOAD_DATA_SIZE || !ane_h16_preload_rule_valid(rule))
+		return -EINVAL;
+	/* Validate all framing before producing a digest. Odd offsets are valid. */
+	for (i = 0; i < rule->cell_count; i++) {
+		const struct ane_h16_preload_cell *c = &rule->cells[i];
+
+		if (memcmp(bytes + c->value - 8, c->tag, 4) ||
+		    get_unaligned_le32(bytes + c->value - 4) != c->width)
+			return -ENOEXEC;
+	}
+	sha256_init(&ctx);
+	sha256_update(&ctx, text, text_size);
+	for (i = 0; i < rule->cell_count; i++) {
+		const struct ane_h16_preload_cell *c = &rule->cells[i];
+
+		if (!c->mutable)
+			continue;
+		sha256_update(&ctx, bytes + cursor, c->value - cursor);
+		ane_h16_hash_zeros(&ctx, c->width);
+		cursor = c->value + c->width;
+	}
+	sha256_update(&ctx, bytes + cursor, rule->zero_start - cursor);
+	ane_h16_hash_zeros(&ctx, rule->zero_end - rule->zero_start);
+	cursor = rule->zero_end;
+	sha256_update(&ctx, bytes + cursor, data_size - cursor);
+	sha256_final(&ctx, digest);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_preload_digest);
+
+int ane_h16_preload_validate(const struct ane_h16_preload_rule *rule,
+			     const void *text, size_t text_size,
+			     const void *data, size_t data_size)
+{
+	u8 digest[SHA256_DIGEST_SIZE];
+	int ret;
+
+	ret = ane_h16_preload_digest(rule, text, text_size, data, data_size, digest);
+	if (ret)
+		return ret;
+	return memcmp(digest, rule->digest, sizeof(digest)) ? -ENOEXEC : 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_preload_validate);
+
+MODULE_DESCRIPTION("H16 resident firmware identity validation");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/accel/ane/ane_h16_preload.h b/drivers/accel/ane/ane_h16_preload.h
new file mode 100644
index 0000000000..efec3e38bb
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_preload.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_H16_PRELOAD_H__
+#define __ANE_H16_PRELOAD_H__
+
+#include <crypto/sha2.h>
+
+#define ANE_H16_PRELOAD_TEXT_SIZE 0xc0000
+#define ANE_H16_PRELOAD_DATA_SIZE 0x2ac000
+
+/*
+ * One aether patchbay record in DATA: a four-byte tag and a 32-bit width,
+ * followed by the value cell at @value. A mutable cell is written by the
+ * bootloader and is normalized to zero before hashing.
+ */
+struct ane_h16_preload_cell {
+	char tag[4];
+	u32 value;
+	u8 width;
+	bool mutable;
+};
+
+/*
+ * How to recognize one firmware build from its iBoot preload: the ordered
+ * patchbay records, the DATA range the bootloader rewrites (@zero_start up to
+ * @zero_end, normalized to zero), and the SHA-256 of the normalized TEXT and
+ * DATA. Adding a firmware build is a new rule, not new code.
+ */
+struct ane_h16_preload_rule {
+	const struct ane_h16_preload_cell *cells;
+	unsigned int cell_count;
+	u32 zero_start;
+	u32 zero_end;
+	u8 digest[SHA256_DIGEST_SIZE];
+};
+
+/* Inputs are stable, host-owned snapshots of the reserved live pages.
+ * Computing a digest validates the rule's framing but not the identity.
+ * Neither function changes the snapshots or the live bootloader values.
+ */
+int ane_h16_preload_digest(const struct ane_h16_preload_rule *rule,
+			   const void *text, size_t text_size,
+			   const void *data, size_t data_size,
+			   u8 digest[SHA256_DIGEST_SIZE]);
+/* 0 when the snapshots are the rule's build, -ENOEXEC when they are not. */
+int ane_h16_preload_validate(const struct ane_h16_preload_rule *rule,
+			     const void *text, size_t text_size,
+			     const void *data, size_t data_size);
+
+#endif /* __ANE_H16_PRELOAD_H__ */
diff --git a/drivers/accel/ane/ane_h16_preload_test.c b/drivers/accel/ane/ane_h16_preload_test.c
new file mode 100644
index 0000000000..184b444a53
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_preload_test.c
@@ -0,0 +1,352 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <kunit/test.h>
+#include <linux/module.h>
+#include <linux/unaligned.h>
+#include <linux/vmalloc.h>
+
+#include "ane_h16_boot_data.h"
+#include "ane_h16_preload.h"
+
+/* Synthetic framing only, with no firmware bytes. Walk records independently
+ * from their widths rather than sharing the production offset manifest.
+ */
+static const struct {
+	char tag[4];
+	u8 width;
+	bool mutable;
+} records[] = {
+	{ "BECA", 8, true }, { "SECA", 8, false }, { "GKTS", 8, true },
+	{ "otcd", 8, false }, { "oscd", 8, false }, { "oecd", 8, false },
+	{ "DILS", 8, true }, { "SRSA", 8, false }, { "GFCM", 8, false },
+	{ "SSSC", 8, true }, { "qF8v", 4, true }, { "LRSD", 1, false },
+	{ "SVSD", 8, false }, { "LCSD", 8, false }, { "ZSTR", 4, false },
+	{ "BPTP", 8, false }, { "TNGI", 1, false }, { "oeNS", 1, false },
+	{ "SEBC", 8, false }, { "ECAP", 8, true }, { "BVTP", 8, true },
+	{ "sP1T", 8, true }, { "BtpG", 8, true }, { "StpG", 8, false },
+	{ "BlpP", 8, true }, { "SPTP", 8, false }, { "SZSD", 8, false },
+	{ "LZSD", 8, false }, { "S2xG", 8, true }, { "SNUT", 8, true },
+	{ "ZNUT", 4, false }, { "OTTR", 8, true }, { "LLTR", 1, false },
+	{ "_COS", 4, true }, { "RCOS", 4, true }, { "dApC", 8, true },
+	{ "dArW", 8, true }, { "fVED", 1, true }, { "GLFp", 8, true },
+	{ "ABOI", 8, false }, { "ZSOI", 4, false }, { "ARcM", 4, true },
+};
+
+struct preload_fixture {
+	u8 *text;
+	u8 *data;
+	struct ane_h16_preload_cell cells[ARRAY_SIZE(records)];
+	struct ane_h16_preload_rule rule;
+};
+
+/* Lay the synthetic records out from @base and describe them as a rule. */
+static size_t preload_frame(struct preload_fixture *f, size_t base, bool write)
+{
+	size_t pos = base;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(records); i++) {
+		if (write) {
+			memcpy(f->data + pos, records[i].tag, 4);
+			put_unaligned_le32(records[i].width, f->data + pos + 4);
+		}
+		memcpy(f->cells[i].tag, records[i].tag, 4);
+		f->cells[i].value = pos + 8;
+		f->cells[i].width = records[i].width;
+		f->cells[i].mutable = records[i].mutable;
+		pos += 8 + records[i].width;
+	}
+	f->rule.cells = f->cells;
+	f->rule.cell_count = ARRAY_SIZE(records);
+	f->rule.zero_start = 0x17c80;
+	f->rule.zero_end = 0x18320;
+	return pos;
+}
+
+static void preload_free(void *allocation)
+{
+	kvfree(allocation);
+}
+
+static int preload_fixture_init(struct kunit *test)
+{
+	struct preload_fixture *f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+
+	if (!f)
+		return -ENOMEM;
+	test->priv = f;
+	f->text = kvmalloc(ANE_H16_PRELOAD_TEXT_SIZE, GFP_KERNEL);
+	if (!f->text)
+		return -ENOMEM;
+	if (kunit_add_action_or_reset(test, preload_free, f->text))
+		return -ENOMEM;
+	f->data = kvmalloc(ANE_H16_PRELOAD_DATA_SIZE, GFP_KERNEL);
+	if (!f->data)
+		return -ENOMEM;
+	if (kunit_add_action_or_reset(test, preload_free, f->data))
+		return -ENOMEM;
+	memset(f->text, 0x5a, ANE_H16_PRELOAD_TEXT_SIZE);
+	memset(f->data, 0xa5, ANE_H16_PRELOAD_DATA_SIZE);
+	return preload_frame(f, 0x5a18, true) == 0x5c79 ? 0 : -EINVAL;
+}
+
+static int preload_digest(struct preload_fixture *f, u8 *digest)
+{
+	return ane_h16_preload_digest(&f->rule, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+				      f->data, ANE_H16_PRELOAD_DATA_SIZE, digest);
+}
+
+static void preload_identity_test(struct kunit *test)
+{
+	/* Independently normalized synthetic bytes, SHA-256 from Python hashlib. */
+	static const u8 expected[SHA256_DIGEST_SIZE] = {
+		0x67, 0xb5, 0x33, 0xc6, 0x0b, 0x11, 0x03, 0x2b,
+		0x3e, 0x75, 0x27, 0x7b, 0x2d, 0xe1, 0x82, 0xc6,
+		0xca, 0x53, 0xa7, 0x18, 0x1f, 0xfc, 0xcc, 0xfe,
+		0xd3, 0xb5, 0xe8, 0x22, 0xaa, 0x12, 0xd0, 0xbb,
+	};
+	struct preload_fixture *f = test->priv;
+	u8 digest[SHA256_DIGEST_SIZE];
+	int ret;
+
+	KUNIT_EXPECT_EQ(test, preload_digest(f, digest), 0);
+	KUNIT_EXPECT_MEMEQ(test, digest, expected, sizeof(digest));
+	/* Correct framing alone cannot authenticate a synthetic image. */
+	ret = ane_h16_preload_validate(&f->rule, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+				       f->data, ANE_H16_PRELOAD_DATA_SIZE);
+	KUNIT_EXPECT_EQ(test, ret, -ENOEXEC);
+	/* The rule's own digest is the whole identity. */
+	memcpy(f->rule.digest, expected, sizeof(expected));
+	ret = ane_h16_preload_validate(&f->rule, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+				       f->data, ANE_H16_PRELOAD_DATA_SIZE);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+}
+
+static void preload_mutable_test(struct kunit *test)
+{
+	struct preload_fixture *f = test->priv;
+	u8 baseline[SHA256_DIGEST_SIZE], digest[SHA256_DIGEST_SIZE];
+	size_t pos = 0x5a18;
+	unsigned int i, mutable = 0;
+
+	KUNIT_ASSERT_EQ(test, preload_digest(f, baseline), 0);
+	for (i = 0; i < ARRAY_SIZE(records); i++) {
+		if (records[i].mutable) {
+			memset(f->data + pos + 8, 0x3c, records[i].width);
+			KUNIT_ASSERT_EQ(test, preload_digest(f, digest), 0);
+			KUNIT_EXPECT_MEMEQ(test, digest, baseline, sizeof(digest));
+			mutable++;
+		}
+		pos += 8 + records[i].width;
+	}
+	KUNIT_EXPECT_EQ(test, mutable, 20);
+	memset(f->data + 0x17c80, 0x7e, 0x6a0);
+	KUNIT_ASSERT_EQ(test, preload_digest(f, digest), 0);
+	KUNIT_EXPECT_MEMEQ(test, digest, baseline, sizeof(digest));
+	/* Validation and normalization never erase the accepted boot data. */
+	KUNIT_EXPECT_EQ(test, f->data[0x5a20], 0x3c);
+	KUNIT_EXPECT_EQ(test, f->data[0x17c80], 0x7e);
+	KUNIT_EXPECT_EQ(test, f->data[0x1831f], 0x7e);
+}
+
+static void preload_framing_test(struct kunit *test)
+{
+	struct preload_fixture *f = test->priv;
+	u8 digest[SHA256_DIGEST_SIZE];
+	size_t pos = 0x5a18;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(records); i++) {
+		f->data[pos] ^= 1;
+		KUNIT_EXPECT_EQ(test, preload_digest(f, digest), -ENOEXEC);
+		f->data[pos] ^= 1;
+		put_unaligned_le32(U32_MAX, f->data + pos + 4);
+		KUNIT_EXPECT_EQ(test, preload_digest(f, digest), -ENOEXEC);
+		put_unaligned_le32(records[i].width, f->data + pos + 4);
+		pos += 8 + records[i].width;
+	}
+	KUNIT_EXPECT_EQ(test, preload_digest(f, digest), 0);
+}
+
+static void preload_immutable_test(struct kunit *test)
+{
+	static const u32 boundaries[] = {
+		0, 0x5a17, 0x5c79, 0x17c7f, 0x18320, 0xb8000, 0x2abfff,
+	};
+	struct preload_fixture *f = test->priv;
+	u8 baseline[SHA256_DIGEST_SIZE], digest[SHA256_DIGEST_SIZE];
+	size_t pos = 0x5a18;
+	unsigned int i;
+
+	KUNIT_ASSERT_EQ(test, preload_digest(f, baseline), 0);
+	for (i = 0; i < ARRAY_SIZE(records); i++) {
+		if (!records[i].mutable) {
+			f->data[pos + 8] ^= 1;
+			KUNIT_ASSERT_EQ(test, preload_digest(f, digest), 0);
+			KUNIT_EXPECT_NE(test, memcmp(digest, baseline, sizeof(digest)), 0);
+			f->data[pos + 8] ^= 1;
+		}
+		pos += 8 + records[i].width;
+	}
+	for (i = 0; i < ARRAY_SIZE(boundaries); i++) {
+		f->data[boundaries[i]] ^= 1;
+		KUNIT_ASSERT_EQ(test, preload_digest(f, digest), 0);
+		KUNIT_EXPECT_NE(test, memcmp(digest, baseline, sizeof(digest)), 0);
+		f->data[boundaries[i]] ^= 1;
+	}
+	f->text[ANE_H16_PRELOAD_TEXT_SIZE - 1] ^= 1;
+	KUNIT_ASSERT_EQ(test, preload_digest(f, digest), 0);
+	KUNIT_EXPECT_NE(test, memcmp(digest, baseline, sizeof(digest)), 0);
+}
+
+static void preload_bounds_test(struct kunit *test)
+{
+	struct preload_fixture *f = test->priv;
+	u8 digest[SHA256_DIGEST_SIZE];
+	int delta, ret;
+
+	for (delta = -1; delta <= 1; delta += 2) {
+		ret = ane_h16_preload_digest(&f->rule, f->text, ANE_H16_PRELOAD_TEXT_SIZE + delta,
+					     f->data, ANE_H16_PRELOAD_DATA_SIZE, digest);
+		KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+		ret = ane_h16_preload_digest(&f->rule, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+					     f->data, ANE_H16_PRELOAD_DATA_SIZE + delta, digest);
+		KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+	}
+	ret = ane_h16_preload_digest(&f->rule, NULL, ANE_H16_PRELOAD_TEXT_SIZE,
+				     f->data, ANE_H16_PRELOAD_DATA_SIZE, digest);
+	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+	ret = ane_h16_preload_digest(&f->rule, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+				     NULL, ANE_H16_PRELOAD_DATA_SIZE, digest);
+	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+	ret = ane_h16_preload_digest(&f->rule, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+				     f->data, ANE_H16_PRELOAD_DATA_SIZE, NULL);
+	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+	ret = ane_h16_preload_digest(NULL, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+				     f->data, ANE_H16_PRELOAD_DATA_SIZE, digest);
+	KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+}
+
+/* A malformed rule is a driver bug: refused as -EINVAL, never as a mismatch. */
+static void preload_rule_shape_test(struct kunit *test)
+{
+	struct preload_fixture *f = test->priv;
+	u8 digest[SHA256_DIGEST_SIZE];
+	struct ane_h16_preload_rule rule;
+
+	rule = f->rule;
+	rule.cell_count = 0;
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_digest(&rule, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+						     f->data, ANE_H16_PRELOAD_DATA_SIZE, digest),
+			-EINVAL);
+	rule = f->rule;
+	rule.zero_start = 0x5c70;	/* inside the last record */
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_digest(&rule, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+						     f->data, ANE_H16_PRELOAD_DATA_SIZE, digest),
+			-EINVAL);
+	rule = f->rule;
+	rule.zero_end = ANE_H16_PRELOAD_DATA_SIZE + 1;
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_digest(&rule, f->text, ANE_H16_PRELOAD_TEXT_SIZE,
+						     f->data, ANE_H16_PRELOAD_DATA_SIZE, digest),
+			-EINVAL);
+	/* Overlapping records. */
+	f->cells[1].value = f->cells[0].value + 4;
+	KUNIT_EXPECT_EQ(test, preload_digest(f, digest), -EINVAL);
+}
+
+/*
+ * A later firmware build moves the patchbay. The rule for one layout rejects
+ * the other as a mismatch (-ENOEXEC), so a profile table can try each rule in
+ * turn and the right one wins.
+ */
+static void preload_layout_select_test(struct kunit *test)
+{
+	struct preload_fixture *f = test->priv;
+	struct ane_h16_preload_rule old_rule;
+	struct ane_h16_preload_cell old_cells[ARRAY_SIZE(records)];
+	u8 digest[SHA256_DIGEST_SIZE];
+
+	memcpy(old_cells, f->cells, sizeof(old_cells));
+	old_rule = f->rule;
+	old_rule.cells = old_cells;
+	memset(f->data + 0x5a18, 0xa5, 0x5c79 - 0x5a18);
+	KUNIT_ASSERT_EQ(test, preload_frame(f, 0x5a18 + 0x3f80, true), 0x5c79 + 0x3f80);
+	f->rule.zero_start += 0x3f80;
+	f->rule.zero_end += 0x3f80;
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_digest(&old_rule, f->text,
+						     ANE_H16_PRELOAD_TEXT_SIZE, f->data,
+						     ANE_H16_PRELOAD_DATA_SIZE, digest),
+			-ENOEXEC);
+	KUNIT_ASSERT_EQ(test, preload_digest(f, digest), 0);
+	memcpy(f->rule.digest, digest, sizeof(digest));
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_validate(&f->rule, f->text,
+						       ANE_H16_PRELOAD_TEXT_SIZE, f->data,
+						       ANE_H16_PRELOAD_DATA_SIZE),
+			0);
+	/* A mutable value of the new layout still normalizes. */
+	memset(f->data + f->cells[0].value, 0x3c, f->cells[0].width);
+	KUNIT_EXPECT_EQ(test, ane_h16_preload_validate(&f->rule, f->text,
+						       ANE_H16_PRELOAD_TEXT_SIZE, f->data,
+						       ANE_H16_PRELOAD_DATA_SIZE),
+			0);
+}
+
+/*
+ * Every shipped profile is well formed: a build to boot with, a rule whose
+ * records frame cleanly when written at their offsets, and an identity no
+ * other profile shares. Synthetic bytes never authenticate as a profile.
+ */
+static void preload_profiles_test(struct kunit *test)
+{
+	struct preload_fixture *f = test->priv;
+	unsigned int i, j, k;
+
+	KUNIT_ASSERT_GT(test, ARRAY_SIZE(ane_h16_profiles), 0);
+	for (i = 0; i < ARRAY_SIZE(ane_h16_profiles); i++) {
+		const struct ane_h16_profile *p = &ane_h16_profiles[i];
+		const struct ane_h16_preload_rule *r = p->preload;
+		u8 digest[SHA256_DIGEST_SIZE];
+
+		KUNIT_ASSERT_NOT_NULL(test, p->build);
+		KUNIT_ASSERT_NOT_NULL(test, p->identity);
+		KUNIT_ASSERT_NOT_NULL(test, r);
+		memset(f->data, 0xa5, ANE_H16_PRELOAD_DATA_SIZE);
+		for (k = 0; k < r->cell_count; k++) {
+			memcpy(f->data + r->cells[k].value - 8, r->cells[k].tag, 4);
+			put_unaligned_le32(r->cells[k].width, f->data + r->cells[k].value - 4);
+		}
+		KUNIT_EXPECT_EQ(test, ane_h16_preload_digest(r, f->text,
+							     ANE_H16_PRELOAD_TEXT_SIZE, f->data,
+							     ANE_H16_PRELOAD_DATA_SIZE, digest),
+				0);
+		KUNIT_EXPECT_EQ(test, ane_h16_preload_validate(r, f->text,
+							       ANE_H16_PRELOAD_TEXT_SIZE, f->data,
+							       ANE_H16_PRELOAD_DATA_SIZE),
+				-ENOEXEC);
+		for (j = 0; j < i; j++) {
+			KUNIT_EXPECT_NE(test, memcmp(r->digest, ane_h16_profiles[j].preload->digest,
+						     SHA256_DIGEST_SIZE), 0);
+			KUNIT_EXPECT_STRNEQ(test, p->identity, ane_h16_profiles[j].identity);
+		}
+	}
+}
+
+static struct kunit_case preload_cases[] = {
+	KUNIT_CASE(preload_identity_test),
+	KUNIT_CASE(preload_mutable_test),
+	KUNIT_CASE(preload_framing_test),
+	KUNIT_CASE(preload_immutable_test),
+	KUNIT_CASE(preload_bounds_test),
+	KUNIT_CASE(preload_rule_shape_test),
+	KUNIT_CASE(preload_layout_select_test),
+	KUNIT_CASE(preload_profiles_test),
+	{}
+};
+
+static struct kunit_suite preload_suite = {
+	.name = "ane-h16-preload",
+	.init = preload_fixture_init,
+	.test_cases = preload_cases,
+};
+
+kunit_test_suite(preload_suite);
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/accel/ane/ane_h16_program.c b/drivers/accel/ane/ane_h16_program.c
new file mode 100644
index 0000000000..0ab46d7a13
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_program.c
@@ -0,0 +1,1632 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* H16 program lifecycle on the shared firmware transport. */
+#include <linux/ctype.h>
+#include <linux/math64.h>
+#include <linux/freezer.h>
+#include <linux/module.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+
+#include "ane_h16_program.h"
+
+/*
+ * The one LOAD slot table. Slot 1 carries the HWX kernel section, or the
+ * __TEXT,__const constants when the program has no kernel section, and slot 2
+ * the task stream. macOS populated slot 1 in every captured load, with at
+ * least 0x4000 bytes at a sub-page DVA, which is the constants section of a
+ * program without a kernel. Slots 1 and 2 carry a per-program pair with
+ * slot 1 = slot 2 + 1. A later correction to any slot is one line here.
+ */
+static const struct ane_h16_slot_rule ane_h16_slot_rules[ANE_H16_LOAD_SLOTS] = {
+	{ ANE_H16_SLOT_AUX_GENERIC, ANE_H16_RESOURCE_GENERIC, 4 },
+	{ ANE_H16_SLOT_KERNEL, ANE_H16_RESOURCE_KERNEL, 3 },
+	{ ANE_H16_SLOT_TEXT, ANE_H16_RESOURCE_TEXT, 4 },
+	{ ANE_H16_SLOT_AUX_OPERATION, ANE_H16_RESOURCE_OPERATION, 4 },
+	{ ANE_H16_SLOT_AUX_PROCEDURE, ANE_H16_RESOURCE_PROCEDURE, 4 },
+	{ ANE_H16_SLOT_EMPTY, 0, 0 },
+	{ ANE_H16_SLOT_AUX_TEXT_PROPERTIES, ANE_H16_RESOURCE_TEXT_PROPERTIES, 4 },
+	{ ANE_H16_SLOT_EMPTY, 0, 0 },
+	{ ANE_H16_SLOT_EMPTY, 0, 0 },
+};
+
+const struct ane_h16_slot_rule *ane_h16_slot_rule(unsigned int slot)
+{
+	return slot < ANE_H16_LOAD_SLOTS ? &ane_h16_slot_rules[slot] : NULL;
+}
+EXPORT_SYMBOL_GPL(ane_h16_slot_rule);
+
+/*
+ * Place a section that lies wholly inside one mapped region of that kind.
+ * With @pages the slot extends to the end of the section's last 16 KiB page
+ * of the region, the form every measured H17 kernel-table LOAD used; the
+ * tail is the zero padding of the mapped segment.
+ */
+static int h16_section_dva(const struct ane_h16_load_plan *plan,
+			   const struct ane_h16_load_layout *layout,
+			   enum ane_h16_region_kind kind,
+			   const struct ane_h16_hwx_section *section,
+			   struct ane_h16_load_slot *slot, bool pages)
+{
+	unsigned int i;
+
+	if (!section->size)
+		return -ENOEXEC;
+	for (i = 0; i < plan->count; i++) {
+		const struct ane_h16_hwx_region *r = &plan->regions[i];
+		u64 offset = section->vm - r->vm;
+
+		if (r->kind != kind || section->vm < r->vm || offset >= r->size ||
+		    section->size > r->size - offset)
+			continue;
+		if (offset > layout->regions[i].size ||
+		    section->size > layout->regions[i].size - offset)
+			return -EINVAL;
+		slot->dva = layout->regions[i].dva + offset;
+		slot->size = section->size;
+		if (pages)
+			slot->size = min_t(u64, ALIGN(offset + section->size, SZ_16K),
+					   layout->regions[i].size) - offset;
+		return 0;
+	}
+	return -ENOEXEC;
+}
+
+int ane_h16_load_slots(const struct ane_h16_hwx *hwx,
+		       const struct ane_h16_load_plan *plan,
+		       const struct ane_h16_load_layout *layout,
+		       struct ane_h16_load_slot slots[ANE_H16_LOAD_SLOTS])
+{
+	struct ane_h16_load_slot next[ANE_H16_LOAD_SLOTS] = {};
+	unsigned int i, aux;
+	int ret;
+
+	if (!hwx || !plan || !layout || !slots || !plan->count ||
+	    layout->region_count != plan->count)
+		return -EINVAL;
+	for (i = 0; i < plan->count; i++)
+		if (!layout->regions[i].dva || layout->regions[i].size != plan->allocation[i])
+			return -EINVAL;
+	for (i = 0; i < ANE_H16_LOAD_SLOTS; i++) {
+		const struct ane_h16_slot_rule *rule = &ane_h16_slot_rules[i];
+		struct ane_h16_load_slot *slot = &next[i];
+
+		switch (rule->source) {
+		case ANE_H16_SLOT_EMPTY:
+			continue;
+		case ANE_H16_SLOT_KERNEL:
+			if (hwx->kernel.size)
+				ret = h16_section_dva(plan, layout, ANE_H16_REGION_KERNEL,
+						      &hwx->kernel, slot, true);
+			else
+				ret = h16_section_dva(plan, layout, ANE_H16_REGION_TEXT,
+						      &hwx->constants, slot, false);
+			break;
+		case ANE_H16_SLOT_TEXT:
+			ret = h16_section_dva(plan, layout, ANE_H16_REGION_TEXT,
+					      &hwx->text, slot, false);
+			break;
+		default:
+			aux = rule->source == ANE_H16_SLOT_AUX_GENERIC ? ANE_H16_AUX_GENERIC :
+			      rule->source == ANE_H16_SLOT_AUX_OPERATION ? ANE_H16_AUX_OPERATION :
+			      rule->source == ANE_H16_SLOT_AUX_PROCEDURE ? ANE_H16_AUX_PROCEDURE :
+			      ANE_H16_AUX_TEXT_PROPERTIES;
+			ret = 0;
+			slot->dva = layout->aux_dva[aux];
+			slot->size = layout->aux_size[aux];
+			if (!slot->dva || slot->size < ANE_H16_AUX_MIN ||
+			    slot->size > ANE_H16_AUX_MAX)
+				ret = -EINVAL;
+			break;
+		}
+		if (ret)
+			return ret;
+		slot->resource = rule->resource;
+		slot->class = rule->class;
+		slot->present = true;
+	}
+	memcpy(slots, next, sizeof(next));
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_load_slots);
+
+int ane_h16_load_encode(void *command, size_t length,
+			const struct ane_h16_load_slot slots[ANE_H16_LOAD_SLOTS])
+{
+	u8 *p = command;
+	unsigned int i;
+
+	if (!p || !slots || length != ANE_H16_LOAD_SIZE)
+		return -EINVAL;
+	for (i = 0; i < ANE_H16_LOAD_SLOTS; i++)
+		if (slots[i].present &&
+		    (!slots[i].size || slots[i].size > U64_MAX - slots[i].dva))
+			return -EINVAL;
+	memset(p, 0, length);
+	for (i = 0; i < ANE_H16_LOAD_SLOTS; i++) {
+		u8 *d = p + ANE_H16_LOAD_SLOT_OFFSET + i * ANE_H16_LOAD_SLOT_SIZE;
+
+		if (!slots[i].present)
+			continue;
+		put_unaligned_le32(1, d);
+		put_unaligned_le32(slots[i].resource, d + 4);
+		put_unaligned_le32(slots[i].class, d + 8);
+		put_unaligned_le32(1, d + 0x10);
+		put_unaligned_le64(slots[i].dva, d + 0x18);
+		put_unaligned_le64(slots[i].size, d + 0x20);
+	}
+	put_unaligned_le32(ANE_H16_LOAD_ID_REQUEST, p + ANE_H16_LOAD_ID_OFFSET);
+	return ane_h16_command_prepare(p, length, ANE_H16_LOAD_PROGRAM, ANE_FW_IO);
+}
+EXPORT_SYMBOL_GPL(ane_h16_load_encode);
+
+static int h16_reply_header(const u8 *reply, size_t length, size_t expected, u16 id)
+{
+	if (!reply || length != expected || get_unaligned_le32(reply) ||
+	    get_unaligned_le16(reply + 4) != id)
+		return -EPROTO;
+	return get_unaligned_le16(reply + 6) ? -EREMOTEIO : 0;
+}
+
+/* The reply echoes every slot and replaces the request ID with the program ID. */
+int ane_h16_load_reply(const void *reply, size_t length, const void *request,
+		       u32 *program)
+{
+	const u8 *p = reply, *q = request;
+	u32 id;
+	int ret;
+
+	if (!program || !q)
+		return -EINVAL;
+	ret = h16_reply_header(p, length, ANE_H16_LOAD_SIZE, ANE_H16_LOAD_PROGRAM);
+	if (ret)
+		return ret;
+	id = get_unaligned_le32(p + ANE_H16_LOAD_ID_OFFSET);
+	if (id == ANE_H16_LOAD_ID_REQUEST || get_unaligned_le32(p + 0x1bc) ||
+	    memcmp(p + ANE_H16_LOAD_SLOT_OFFSET, q + ANE_H16_LOAD_SLOT_OFFSET,
+		   ANE_H16_LOAD_ID_OFFSET - ANE_H16_LOAD_SLOT_OFFSET))
+		return -EPROTO;
+	/* ID 0 is a valid program ID. */
+	*program = id;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_load_reply);
+
+int ane_h16_create_encode(void *command, size_t length, u32 program)
+{
+	u8 *p = command;
+
+	if (!p || length != ANE_H16_CREATE_SIZE)
+		return -EINVAL;
+	/* No process resources travel in CREATE on 27.0; the body stays zero. */
+	memset(p, 0, length);
+	put_unaligned_le32(program, p + 8);
+	return ane_h16_command_prepare(p, length, ANE_H16_CREATE_PROCESS, ANE_FW_IO);
+}
+EXPORT_SYMBOL_GPL(ane_h16_create_encode);
+
+int ane_h16_create_reply(const void *reply, size_t length, u32 program, u32 *process)
+{
+	const u8 *p = reply;
+	int ret;
+
+	if (!process)
+		return -EINVAL;
+	ret = h16_reply_header(p, length, ANE_H16_CREATE_SIZE, ANE_H16_CREATE_PROCESS);
+	if (ret)
+		return ret;
+	if (get_unaligned_le32(p + 8) != program ||
+	    memchr_inv(p + 0x10, 0, ANE_H16_CREATE_SIZE - 0x10))
+		return -EPROTO;
+	/* ID 0 is a valid process ID. */
+	*process = get_unaligned_le32(p + 0xc);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_create_reply);
+
+int ane_h16_terminate_encode(void *command, size_t length, u32 program, u32 process)
+{
+	u8 *p = command;
+
+	if (!p || length != ANE_H16_TERMINATE_SIZE)
+		return -EINVAL;
+	memset(p, 0, length);
+	put_unaligned_le32(program, p + 8);
+	put_unaligned_le32(process, p + 0xc);
+	return ane_h16_command_prepare(p, length, ANE_H16_TERMINATE_PROCESS, ANE_FW_IO);
+}
+EXPORT_SYMBOL_GPL(ane_h16_terminate_encode);
+
+int ane_h16_unload_encode(void *command, size_t length, u32 program)
+{
+	u8 *p = command;
+
+	if (!p || length != ANE_H16_UNLOAD_SIZE)
+		return -EINVAL;
+	memset(p, 0, length);
+	put_unaligned_le32(program, p + 8);
+	return ane_h16_command_prepare(p, length, ANE_H16_UNLOAD_PROGRAM, ANE_FW_IO);
+}
+EXPORT_SYMBOL_GPL(ane_h16_unload_encode);
+
+int ane_h16_gate_encode(void *command, size_t length, u32 value)
+{
+	u8 *p = command;
+
+	if (!p || length != ANE_H16_GATE_SIZE || value > 1)
+		return -EINVAL;
+	memset(p, 0, length);
+	put_unaligned_le32(value, p + 8);
+	return ane_h16_command_prepare(p, length, ANE_H16_POWER_GATE, ANE_FW_DATA_CHAIN);
+}
+EXPORT_SYMBOL_GPL(ane_h16_gate_encode);
+
+/*
+ * Short commands (0x002d, TERMINATE, UNLOAD) have no recorded reply body, so
+ * only the transport reply shape is a predicate: same length and command,
+ * zero first word and a zero acknowledgment.
+ */
+int ane_h16_id_reply(const void *reply, size_t length, const void *request)
+{
+	const u8 *q = request;
+
+	if (!q || length < 8 || length > ANE_H16_TERMINATE_SIZE)
+		return -EINVAL;
+	return h16_reply_header(reply, length, length, get_unaligned_le16(q + 4));
+}
+EXPORT_SYMBOL_GPL(ane_h16_id_reply);
+
+/*
+ * Kernel-owned EXECUTE resource map. EXECUTE names each buffer by its ID in
+ * the generic section that LOAD installs, so the ID comes from that section:
+ * entry k describes surface k in HWX surface order. The entry must agree with
+ * the surface direction and size. IDs are unique and never the reserved
+ * kernel IDs 2 and 3. The class follows the round 5 usage mapping (input
+ * usage 1, output usage 2).
+ *
+ * A program with a __DATA scratch has one more entry, last: the scratch,
+ * typed as an input (type 0, direction 1) of exactly the __bss size. Linked
+ * programs keep the DRAM edges between their tasks there; the measured H17
+ * MobileNet run bound it this way.
+ */
+int ane_h16_process_bindings(const struct ane_h16_hwx *hwx, const void *generic,
+			     size_t generic_size,
+			     struct ane_h16_process_binding *bindings,
+			     unsigned int *count,
+			     struct ane_h16_process_binding *scratch)
+{
+	const u8 *g = generic;
+	unsigned int i, j, entries;
+	u32 seen[2] = {};
+
+	if (!hwx || !g || !bindings || !count || hwx->surface_count < 2 ||
+	    hwx->surface_count > ANE_H16_SURFACES || (hwx->scratch.size && !scratch))
+		return -EINVAL;
+	entries = hwx->surface_count + !!hwx->scratch.size;
+	if (generic_size != ANE_H16_GENERIC_HEADER + entries * ANE_H16_GENERIC_ENTRY ||
+	    get_unaligned_le32(g) != ANE_H16_GENERIC_MAGIC ||
+	    !get_unaligned_le32(g + 4) ||
+	    get_unaligned_le32(g + 4) > ANE_H16_GENERIC_VERSION ||
+	    get_unaligned_le32(g + ANE_H16_GENERIC_COUNT) != entries)
+		return -ENOEXEC;
+	for (i = 0; i < entries; i++) {
+		const u8 *e = g + ANE_H16_GENERIC_HEADER + i * ANE_H16_GENERIC_ENTRY;
+		bool is_scratch = i == hwx->surface_count;
+		u32 direction = is_scratch ? 1 : hwx->surfaces[i].direction;
+		u32 id = get_unaligned_le32(e + 4);
+		u64 bytes = get_unaligned_le64(e + 0x20);
+
+		if (direction < 1 || direction > 2)
+			return -ENOEXEC;
+		if (get_unaligned_le32(e) != 1 || id == 2 || id == 3 ||
+		    id > ANE_H16_GENERIC_ID_MAX ||
+		    get_unaligned_le32(e + 8) != direction - 1 ||
+		    get_unaligned_le32(e + 0x10) != direction)
+			return -ENOEXEC;
+		/* The scratch entry may round __bss up to its 16 KiB mapping. */
+		if (is_scratch ? bytes < hwx->scratch.size ||
+				 bytes > ALIGN(hwx->scratch.size, SZ_16K) :
+		    bytes < hwx->surfaces[i].span || bytes > hwx->surfaces[i].allocation)
+			return -ENOEXEC;
+		for (j = 0; j < i && j < hwx->surface_count; j++)
+			if (bindings[j].index == id)
+				return -ENOEXEC;
+		if (is_scratch) {
+			*scratch = (struct ane_h16_process_binding) {
+				.hwx_vm = hwx->scratch.vm,
+				.index = id,
+				.class = ane_h16_usage_class(direction),
+			};
+			continue;
+		}
+		bindings[i] = (struct ane_h16_process_binding) {
+			.hwx_vm = hwx->surfaces[i].section.vm,
+			.index = id,
+			.class = ane_h16_usage_class(direction),
+			.bytes = bytes,
+		};
+		seen[direction - 1]++;
+	}
+	if (!seen[0] || seen[1] != 1)
+		return -ENOEXEC;
+	if (scratch && !hwx->scratch.size)
+		*scratch = (struct ane_h16_process_binding) {};
+	*count = hwx->surface_count;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_process_bindings);
+
+/*
+ * The operation section binds BAR slots to resources: per record, a count at
+ * +8 and (slot, tag) pairs from +0xc. A tag is a generic-section ID, or the
+ * kernel resource index for a __KERN_0 program. BAR slot s takes its base
+ * from the program descriptor qword at +0x10 * (s + 1), so every pair must
+ * name the resource whose HWX address is that base. Kernel programs must bind
+ * the kernel: the legacy tag 2 instead makes the H17 firmware assert and stop
+ * answering (H17 harness facts, kernel-table programs).
+ */
+int ane_h16_operation_validate(const struct ane_h16_hwx_snapshot *snapshot,
+			       const struct ane_h16_hwx *hwx, const void *operation,
+			       size_t operation_size,
+			       const struct ane_h16_process_binding *bindings,
+			       unsigned int count,
+			       const struct ane_h16_process_binding *scratch)
+{
+	const u8 *o = operation, *c;
+	unsigned int r, records, i, j;
+	bool kernel_bound = false;
+	int ret;
+
+	if (!hwx || !o || !bindings || count != hwx->surface_count ||
+	    (hwx->scratch.size && !scratch))
+		return -EINVAL;
+	ret = ane_h16_hwx_snapshot_check(snapshot);
+	if (ret)
+		return ret;
+	if (!hwx->program_offset || snapshot->size < 0x800 ||
+	    hwx->program_offset > snapshot->size - 0x800)
+		return -ENOEXEC;
+	c = (const u8 *)snapshot->bytes + hwx->program_offset;
+	if (operation_size < 4)
+		return -ENOEXEC;
+	records = get_unaligned_le32(o);
+	if (!records || records > ANE_H16_OPERATION_RECORDS_MAX ||
+	    operation_size != 4 + (size_t)records * ANE_H16_OPERATION_RECORD)
+		return -ENOEXEC;
+	for (r = 0; r < records; r++) {
+		const u8 *rec = o + 4 + r * ANE_H16_OPERATION_RECORD;
+		u32 refs = get_unaligned_le32(rec + 8);
+		u64 seen = 0;
+
+		if (get_unaligned_le32(rec) || get_unaligned_le32(rec + 4) ||
+		    refs > ANE_H16_OPERATION_REFS_MAX)
+			return -ENOEXEC;
+		for (i = 0; i < refs; i++) {
+			u32 slot = get_unaligned_le32(rec + 0xc + i * 8);
+			u32 tag = get_unaligned_le32(rec + 0x10 + i * 8);
+			u64 base, want = 0;
+
+			if (slot >= 64 || (seen & BIT_ULL(slot)))
+				return -ENOEXEC;
+			seen |= BIT_ULL(slot);
+			base = get_unaligned_le64(c + 0x10 * (slot + 1));
+			if (tag == ANE_H16_RESOURCE_KERNEL && hwx->kernel.size) {
+				want = hwx->kernel.vm;
+				kernel_bound = true;
+			} else if (scratch && hwx->scratch.size && tag == scratch->index) {
+				want = scratch->hwx_vm;
+			} else {
+				for (j = 0; j < count; j++)
+					if (tag == bindings[j].index)
+						want = bindings[j].hwx_vm;
+			}
+			if (!want || base != want)
+				return -ENOEXEC;
+		}
+	}
+	return hwx->kernel.size && !kernel_bound ? -ENOEXEC : 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_operation_validate);
+
+/*
+ * The mcache custom-BAR records come from the program descriptor relocation
+ * tuples pinned by the HWX validator.  The linear 0x8a0 form has one prefetch
+ * tuple (BAR ID, field, bit offset, width at +0x868, +0x870, +0x878, +0x87c).
+ * The scratch-backed 0x8c0 form has that tuple plus one intermediate-spill
+ * tuple in the kind-3 payload at +0x890.  The two records use independent
+ * mcache value types even though both name BAR 4 and their bit ranges overlap.
+ */
+int ane_h16_custom_bars(const struct ane_h16_hwx_snapshot *snapshot,
+			const struct ane_h16_hwx *hwx, u32 dsid,
+			struct ane_h16_custom_bar *bars, unsigned int *count)
+{
+	const u8 *c;
+	u32 bar, offset, width, length;
+	int ret;
+
+	if (!hwx || !bars || !count)
+		return -EINVAL;
+	ret = ane_h16_hwx_snapshot_check(snapshot);
+	if (ret)
+		return ret;
+	if (!hwx->program_offset || snapshot->size < 0x8a0 ||
+	    hwx->program_offset > snapshot->size - 0x8a0)
+		return -ENOEXEC;
+	c = (const u8 *)snapshot->bytes + hwx->program_offset;
+	*count = 0;
+	length = get_unaligned_le32(c + 4);
+	bar = get_unaligned_le32(c + 0x868);
+	offset = get_unaligned_le32(c + 0x878);
+	width = get_unaligned_le32(c + 0x87c);
+	if (!width || width > 16 || offset > 64 - width || dsid >= BIT(width))
+		return -ENOEXEC;
+	bars[0] = (struct ane_h16_custom_bar) {
+		.configuration = 1,
+		.value_type = 0,
+		.bar = bar,
+		.bit_offset = offset,
+		.bit_width = width,
+		.value = dsid,
+	};
+	*count = 1;
+	if (length == 0x8a0)
+		return 0;
+	if (length != 0x8c0 || snapshot->size < 0x8c0 ||
+	    hwx->program_offset > snapshot->size - 0x8c0)
+		return -ENOEXEC;
+	bar = get_unaligned_le16(c + 0x890);
+	offset = c[0x893];
+	width = c[0x894];
+	if (!width || width > 16 || offset > 64 - width || dsid >= BIT(width))
+		return -ENOEXEC;
+	bars[1] = (struct ane_h16_custom_bar) {
+		.configuration = 1,
+		.value_type = 1,
+		.bar = bar,
+		.bit_offset = offset,
+		.bit_width = width,
+		.value = dsid,
+	};
+	*count = 2;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_custom_bars);
+
+static void h16_gate_work(struct work_struct *work);
+
+int ane_h16_session_init(struct ane_h16_session *s, struct ane_fw_transport *transport,
+			 const struct ane_h16_session_ops *ops, void *ctx,
+			 u64 timeout_ns)
+{
+	if (!s || !transport || !transport->armed || !ops || !ops->map || !ops->log ||
+	    !timeout_ns)
+		return -EINVAL;
+	memset(s, 0, sizeof(*s));
+	s->transport = transport;
+	s->ops = ops;
+	s->ctx = ctx;
+	s->timeout_ns = timeout_ns;
+	s->dsid = ANE_H16_MCACHE_DSID;
+	s->settle_ns = ANE_H16_SETTLE_QUIET_NS;
+	init_waitqueue_head(&s->wake);
+	INIT_LIST_HEAD(&s->deferred);
+	INIT_LIST_HEAD(&s->programs);
+	spin_lock_init(&s->stats_lock);
+	INIT_DELAYED_WORK(&s->gate_work, h16_gate_work);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_init);
+
+static int h16_fail(struct ane_h16_session *s, int error)
+{
+	if (!s->error)
+		s->error = error;
+	if (!s->quarantined) {
+		s->quarantined = true;
+		s->pending.quarantined = true;
+		s->ops->log(s->ctx, "program quarantine", (u64)-s->error, 0);
+	}
+	return s->error;
+}
+
+static u64 h16_now(struct ane_h16_session *s)
+{
+	return s->transport->ops->now_ns(s->transport->ctx);
+}
+
+/* Publish one command and wait for its transport reply, kept in the pool. */
+static int h16_send(struct ane_h16_session *s, unsigned int ch, const void *command,
+		    size_t length, const u8 **reply)
+{
+	struct ane_fw_transport *t = s->transport;
+	int ret;
+
+	if (ane_fw_command_denied(get_unaligned_le16((const u8 *)command + 4)))
+		return -EPERM;
+	ret = ane_fw_transport_publish(t, ch, command, length, h16_now(s) + s->timeout_ns);
+	if (ret)
+		return ret;
+	ret = ane_fw_transport_wait(t, ch);
+	*reply = (const u8 *)t->pool.cpu + (t->pending[ch].dva - t->pool.dva);
+	return ret;
+}
+
+/*
+ * The transport copies commands into a pool arena. LOAD and CREATE stay in
+ * it; each EXECUTE sequence gives its space back once the firmware reported
+ * the request complete. Refuse a sequence up front when it cannot fit, so
+ * running out of arena is a clean -ENOSPC and never a half-sent sequence.
+ */
+static int h16_pool_room(struct ane_h16_session *s, const size_t *lengths,
+			 unsigned int count)
+{
+	const struct ane_fw_transport *t = s->transport;
+	size_t used = t->pool_used;
+	unsigned int i;
+
+	for (i = 0; i < count; i++) {
+		used = ALIGN(used, ANE_FW_SLOT_SIZE);
+		if (used > t->pool.size || lengths[i] > t->pool.size - used)
+			return -ENOSPC;
+		used += lengths[i];
+	}
+	return 0;
+}
+
+static void h16_sync(struct ane_h16_session *s, const struct ane_fw_surface *surface,
+		     bool for_device)
+{
+	if (s->ops->sync && surface->handle)
+		s->ops->sync(s->ctx, surface, for_device);
+}
+
+/*
+ * Around each EXECUTE: inputs and the poisoned outputs reach memory before
+ * the doorbell (for_device), and the outputs are read fresh after the
+ * completion report (!for_device). Caller holds the node lock.
+ */
+void ane_h16_session_sync(struct ane_h16_session *s, struct ane_h16_program *p,
+			  bool for_device)
+{
+	unsigned int i;
+
+	for (i = 0; i < p->resource_count; i++)
+		if (for_device || p->resources[i].permissions == 2)
+			h16_sync(s, p->surfaces[i], for_device);
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_sync);
+
+static bool h16_take_spare(struct ane_h16_session *s, size_t size, bool write,
+			   struct ane_fw_surface *out)
+{
+	unsigned int i;
+
+	for (i = 0; i < s->spare_count; i++) {
+		if (s->spares[i].surface.size != size || s->spares[i].write != write)
+			continue;
+		*out = s->spares[i].surface;
+		s->spares[i] = s->spares[--s->spare_count];
+		/* Zeroed like new memory; LOAD writes it back after filling it. */
+		memset(out->cpu, 0, size);
+		return true;
+	}
+	return false;
+}
+
+static void h16_give_spare(struct ane_h16_session *s, struct ane_fw_surface *surface,
+			   bool write)
+{
+	/* A full table keeps the surface mapped and unused until reset. */
+	if (surface->cpu && s->spare_count < ANE_H16_SPARES)
+		s->spares[s->spare_count++] = (struct ane_h16_spare) {
+			.surface = *surface,
+			.write = write,
+		};
+	memset(surface, 0, sizeof(*surface));
+}
+
+static void h16_give_back(struct ane_h16_session *s, struct ane_h16_program *p)
+{
+	unsigned int i;
+
+	for (i = 0; i < p->plan.count; i++)
+		h16_give_spare(s, &p->regions[i], p->plan.regions[i].permissions & 2);
+	for (i = 0; i < ANE_H16_AUX_COUNT; i++)
+		h16_give_spare(s, &p->aux[i], false);
+	memset(p->surfaces, 0, sizeof(p->surfaces));
+	p->released = true;
+}
+
+static int h16_map(struct ane_h16_session *s, size_t size, bool write,
+		   struct ane_fw_surface *out)
+{
+	int ret = h16_take_spare(s, size, write, out) ? 0 : s->ops->map(s->ctx, size, write, out);
+
+	if (ret)
+		return ret;
+	if (!ane_fw_surface_valid(out) || out->size != size || !IS_ALIGNED(out->dva, SZ_16K))
+		return -EPROTO;
+	return 0;
+}
+
+static int h16_program_map(struct ane_h16_session *s, struct ane_h16_program *p,
+			   const void *const aux[ANE_H16_AUX_COUNT],
+			   const size_t aux_size[ANE_H16_AUX_COUNT],
+			   struct ane_h16_load_layout *layout)
+{
+	struct ane_h16_process_binding bindings[ANE_H16_SURFACES], scratch = {};
+	const struct ane_h16_hwx *hwx = &p->hwx;
+	unsigned int i, j, count;
+	int ret;
+
+	ret = ane_h16_process_bindings(hwx, aux[ANE_H16_AUX_GENERIC],
+				       aux_size[ANE_H16_AUX_GENERIC], bindings, &count,
+				       &scratch);
+	if (!ret)
+		ret = ane_h16_operation_validate(&p->snapshot, hwx, aux[ANE_H16_AUX_OPERATION],
+						 aux_size[ANE_H16_AUX_OPERATION], bindings,
+						 count, &scratch);
+	if (ret)
+		return ret;
+	for (i = 0; i < p->plan.count; i++) {
+		const struct ane_h16_hwx_region *r = &p->plan.regions[i];
+
+		if (r->file_size > p->plan.allocation[i] ||
+		    r->file_offset > p->snapshot.size ||
+		    r->file_size > p->snapshot.size - r->file_offset)
+			return -ENOEXEC;
+		ret = h16_map(s, p->plan.allocation[i], r->permissions & 2, &p->regions[i]);
+		if (ret)
+			return ret;
+		memcpy(p->regions[i].cpu, (const u8 *)p->snapshot.bytes + r->file_offset,
+		       r->file_size);
+		/* Weights, text and the zeroed scratch reach memory before LOAD. */
+		h16_sync(s, &p->regions[i], true);
+		layout->regions[i] = (struct ane_h16_load_mapping) {
+			.dva = p->regions[i].dva,
+			.size = p->regions[i].size,
+			.permissions = r->permissions,
+		};
+	}
+	layout->region_count = p->plan.count;
+	for (i = 0; i < ANE_H16_AUX_COUNT; i++) {
+		ret = h16_map(s, ALIGN(aux_size[i], SZ_16K), false, &p->aux[i]);
+		if (ret)
+			return ret;
+		memcpy(p->aux[i].cpu, aux[i], aux_size[i]);
+		h16_sync(s, &p->aux[i], true);
+		layout->aux_dva[i] = p->aux[i].dva;
+		layout->aux_size[i] = aux_size[i];
+	}
+	ret = ane_h16_load_resources_create(&p->snapshot, layout->regions,
+					    layout->region_count, bindings, count,
+					    p->resources);
+	if (ret)
+		return ret;
+	p->resource_count = count;
+	for (i = 0; i < count; i++)
+		p->declared[i] = bindings[i].bytes;
+	for (i = 0; i < count; i++) {
+		for (j = 0; j < p->plan.count; j++)
+			if (p->regions[j].dva == p->resources[i].buffer.mapping_dva)
+				p->surfaces[i] = &p->regions[j];
+		if (!p->surfaces[i])
+			return -EINVAL;
+	}
+	if (hwx->scratch.size) {
+		for (j = 0; j < p->plan.count; j++)
+			if (p->plan.regions[j].kind == ANE_H16_REGION_SCRATCH)
+				break;
+		/* The validator puts __bss at the start of its writable segment. */
+		if (j == p->plan.count || p->plan.regions[j].vm != hwx->scratch.vm ||
+		    p->plan.regions[j].permissions != 3 ||
+		    hwx->scratch.size > p->regions[j].size)
+			return -ENOEXEC;
+		p->scratch = (struct ane_h16_execute_buffer) {
+			.index = scratch.index,
+			.class = scratch.class,
+			.mapping_dva = p->regions[j].dva,
+			.mapping_size = p->regions[j].size,
+			.size = hwx->scratch.size,
+		};
+		p->has_scratch = true;
+	}
+	ret = ane_h16_load_slots(hwx, &p->plan, layout, p->slots);
+	if (ret)
+		return ret;
+	/*
+	 * H17 (T8140, 26.6.2 firmware) asserts in EXELOOP right after logging a
+	 * custom BAR record (CAneProgramManagerHx.cpp:416) and never reports the
+	 * request: the mcache record of a linear relu stopped the Neo there.
+	 * Every H17 request that ran sent no record, so H17 programs carry none
+	 * and keep the firmware's default mcache DSID.
+	 */
+	p->bar_count = 0;
+	if (s->transport->soc->chip_family >= 17)
+		return 0;
+	return ane_h16_custom_bars(&p->snapshot, hwx, s->dsid, p->bars, &p->bar_count);
+}
+
+static const size_t h16_load_sequence[] = {
+	ANE_H16_LOAD_SIZE, ANE_H16_CREATE_SIZE, ANE_H16_TERMINATE_SIZE, ANE_H16_UNLOAD_SIZE,
+};
+
+/*
+ * On this firmware family a direct EXECUTE reuses the BAR context of the
+ * program the engine ran last, so the first EXECUTE of a program writes into
+ * the previous program's output buffer unless it is queued. The session
+ * queues the first EXECUTE whenever the engine last ran another program, the
+ * first one after boot included (see ane_h16_session_execute()). A LOAD is
+ * refused while the previous program is still loaded and accepted once it
+ * closed; a switch-safe transport (H17) also requeues on every program or
+ * process change, so its session may hold several programs at once. Every
+ * program's firmware-visible memory stays mapped until reset.
+ */
+int ane_h16_session_load(struct ane_h16_session *s,
+			 struct ane_h16_hwx_snapshot *snapshot,
+			 const void *const aux[ANE_H16_AUX_COUNT],
+			 const size_t aux_size[ANE_H16_AUX_COUNT],
+			 struct ane_h16_program **program)
+{
+	struct ane_h16_load_layout layout = {};
+	struct ane_h16_program *p;
+	u8 *command;
+	const u8 *reply;
+	unsigned int i;
+	int ret;
+
+	if (!s || !snapshot || !aux || !aux_size || !program)
+		return -EINVAL;
+	if (s->quarantined)
+		return -EIO;
+	if (s->program && !s->program->closed &&
+	    !ane_fw_transport_switch_safe(s->transport))
+		return -EBUSY;
+	for (i = 0; i < ANE_H16_AUX_COUNT; i++)
+		if (!aux[i] || aux_size[i] < ANE_H16_AUX_MIN ||
+		    aux_size[i] > ANE_H16_AUX_MAX || !IS_ALIGNED(aux_size[i], 4))
+			return -EINVAL;
+	ret = ane_h16_hwx_snapshot_check(snapshot);
+	if (ret)
+		return ret;
+	ret = h16_pool_room(s, h16_load_sequence, ARRAY_SIZE(h16_load_sequence));
+	if (ret)
+		return ret;
+	p = kzalloc_obj(*p);
+	command = kzalloc(ANE_H16_CREATE_SIZE, GFP_KERNEL);
+	if (!p || !command) {
+		ret = -ENOMEM;
+		goto free;
+	}
+	ret = ane_h16_load_plan_create(snapshot, &p->plan);
+	if (!ret)
+		ret = ane_h16_hwx_validate(snapshot->bytes, snapshot->size, &p->hwx);
+	/* An HWX runs only on the engine generation it was compiled for. */
+	if (!ret && p->hwx.subtype != s->transport->soc->hwx_subtype)
+		ret = -ENOEXEC;
+	if (ret)
+		goto free;
+	p->snapshot = *snapshot;
+	/*
+	 * From the first mapping on, firmware-visible memory exists that is never
+	 * released before reset, so the program becomes the session's here and
+	 * is never freed.
+	 */
+	p->generation = ++s->generation;
+	p->epoch = s->epoch;
+	INIT_LIST_HEAD(&p->deferred);
+	INIT_LIST_HEAD(&p->node);
+	memset(snapshot, 0, sizeof(*snapshot));
+	p->session = s;
+	s->program = p;
+	ret = h16_program_map(s, p, aux, aux_size, &layout);
+	if (!ret)
+		ret = ane_h16_load_encode(command, ANE_H16_LOAD_SIZE, p->slots);
+	if (ret)
+		goto out;
+	ret = h16_send(s, ANE_FW_IO, command, ANE_H16_LOAD_SIZE, &reply);
+	if (!ret)
+		ret = ane_h16_load_reply(reply, ANE_H16_LOAD_SIZE, command, &p->key.program);
+	if (ret) {
+		s->ops->log(s->ctx, "LOAD refused", (u64)-ret, 0);
+		ret = h16_fail(s, ret);
+		goto out;
+	}
+	s->ops->log(s->ctx, "LOAD program", p->key.program, p->bar_count);
+	ret = ane_h16_create_encode(command, ANE_H16_CREATE_SIZE, p->key.program);
+	if (!ret)
+		ret = h16_send(s, ANE_FW_IO, command, ANE_H16_CREATE_SIZE, &reply);
+	if (!ret)
+		ret = ane_h16_create_reply(reply, ANE_H16_CREATE_SIZE, p->key.program,
+					   &p->key.process);
+	if (ret) {
+		s->ops->log(s->ctx, "CREATE refused", (u64)-ret, 0);
+		ret = h16_fail(s, ret);
+		goto out;
+	}
+	/* Each validated program has exactly one procedure. */
+	p->key.procedure = 0;
+	p->created = true;
+	list_add_tail(&p->node, &s->programs);
+	s->ops->log(s->ctx, "CREATE process", p->key.program, p->key.process);
+	*program = p;
+out:
+	kfree(command);
+	return ret;
+free:
+	kfree(command);
+	kfree(p);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_load);
+
+static int h16_gate(struct ane_h16_session *s, u32 value)
+{
+	u8 command[ANE_H16_GATE_SIZE];
+	const u8 *reply;
+	int ret = ane_h16_gate_encode(command, sizeof(command), value);
+
+	if (!ret)
+		ret = h16_send(s, ANE_FW_DATA_CHAIN, command, sizeof(command), &reply);
+	if (!ret)
+		ret = ane_h16_id_reply(reply, sizeof(command), command);
+	return ret;
+}
+
+/* Gating back on now if it is held off. Caller holds the session lock. */
+static int h16_gate_release(struct ane_h16_session *s)
+{
+	int ret;
+
+	if (!s->gate_held)
+		return 0;
+	s->gate_held = false;
+	if (s->quarantined)
+		return -EIO;
+	ret = h16_gate(s, 1);
+	return ret ? h16_fail(s, ret) : 0;
+}
+
+/*
+ * The idle end of the hold: gating goes back on once gate_hold_ns passed
+ * since the last EXECUTE ended. Caller holds the session lock. Returns 0
+ * when gating is on (or was never held off), -EAGAIN while a newer request
+ * keeps it off, or the error of the closing gate.
+ */
+int ane_h16_session_gate_expire(struct ane_h16_session *s)
+{
+	if (!s->gate_held)
+		return 0;
+	if (h16_now(s) - s->gate_last_ns < s->gate_hold_ns)
+		return -EAGAIN;
+	return h16_gate_release(s);
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_gate_expire);
+
+static void h16_gate_work(struct work_struct *work)
+{
+	struct ane_h16_session *s = container_of(to_delayed_work(work),
+						 struct ane_h16_session, gate_work);
+
+	mutex_lock(s->lock);
+	if (!s->asleep && ane_h16_session_gate_expire(s) == -EAGAIN)
+		mod_delayed_work(system_dfl_wq, &s->gate_work, nsecs_to_jiffies(s->gate_hold_ns));
+	mutex_unlock(s->lock);
+}
+
+/*
+ * One firmware log record: a 2-byte header, then NUL-terminated text in the
+ * rest of the 0x80 bytes. Copies the printable text (other bytes become '.')
+ * into line, which holds ANE_H16_FWLOG_RECORD - 1 bytes, and returns its
+ * length; 0 for an empty record.
+ */
+size_t ane_h16_fwlog_line(const u8 *record, char *line)
+{
+	size_t i, n = 0;
+
+	for (i = 2; i < ANE_H16_FWLOG_RECORD && record[i]; i++)
+		line[n++] = isprint(record[i]) ? record[i] : record[i] == '\t' ? ' ' : '.';
+	while (n && line[n - 1] == ' ')
+		n--;
+	line[n] = 0;
+	return n;
+}
+EXPORT_SYMBOL_GPL(ane_h16_fwlog_line);
+
+/*
+ * After a failed EXECUTE the session is quarantined, so this runs at most
+ * once per program: print every non-empty record of the firmware log in
+ * buffer order (at most 512 lines for the 64 KiB log).
+ */
+static unsigned int h16_dump_fwlog(struct ane_h16_session *s)
+{
+	const struct ane_fw_surface *log =
+		ane_fw_transport_shared_tagged(s->transport, ANE_FW_SHARED_LOG);
+	char line[ANE_H16_FWLOG_RECORD];
+	unsigned int i, lines = 0;
+
+	if (!log || !log->cpu) {
+		s->ops->log(s->ctx, "fwlog absent", 0, 0);
+		return 0;
+	}
+	s->transport->ops->read_barrier(s->transport->ctx);
+	for (i = 0; i < log->size / ANE_H16_FWLOG_RECORD; i++) {
+		const u8 *r = (const u8 *)log->cpu + i * ANE_H16_FWLOG_RECORD;
+
+		if (!ane_h16_fwlog_line(r, line))
+			continue;
+		pr_info("H16 fwlog[%03x] %04x %s\n", i, get_unaligned_le16(r), line);
+		lines++;
+	}
+	s->ops->log(s->ctx, "fwlog records printed", lines, log->dva);
+	return lines;
+}
+
+/* The firmware text log, for a backend diagnosing a command it sent. */
+unsigned int ane_h16_session_dump_fwlog(struct ane_h16_session *s)
+{
+	return h16_dump_fwlog(s);
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_dump_fwlog);
+
+/* Non-zero 16-byte rows of a command or reply, as two little-endian words. */
+static void h16_dump_rows(const char *what, const u8 *p, size_t length)
+{
+	size_t off;
+
+	for (off = 0; off + 16 <= length; off += 16) {
+		u64 lo = get_unaligned_le64(p + off), hi = get_unaligned_le64(p + off + 8);
+
+		if (lo || hi)
+			pr_info("H16 %s +%04zx: %016llx %016llx\n", what, off, lo, hi);
+	}
+}
+
+/* What one EXECUTE saw, logged only when it fails. */
+struct h16_execute_trace {
+	u32 step;
+	u32 reports;
+	u32 last_state;
+	u32 other;
+	/* When the first report and the completion of this UUID were seen. */
+	u64 first_ns;
+	u64 done_ns;
+};
+
+enum {
+	H16_STEP_GATE_OPEN = 1,
+	H16_STEP_SEND,
+	H16_STEP_REPORT,
+	H16_STEP_GATE_CLOSE,
+};
+
+static void h16_trace_report(struct h16_execute_trace *trace, const u8 *report,
+			     size_t size, const struct ane_h16_pending *request, u64 now)
+{
+	struct ane_h16_event e;
+
+	if (!ane_h16_event_decode(report, size, ANE_FW_IO_T2H, &e) &&
+	    e.key.uuid == request->key.uuid) {
+		if (!trace->reports++)
+			trace->first_ns = now;
+		trace->last_state = e.state;
+	} else {
+		trace->other++;
+	}
+}
+
+/* Wait for the terminal report of one pending UUID, servicing allocations. */
+static int h16_wait_report(struct ane_h16_session *s, struct ane_h16_pending *request,
+			   u64 deadline, struct h16_execute_trace *trace)
+{
+	struct ane_fw_transport *t = s->transport;
+	u64 start = h16_now(s), now;
+	u8 *report;
+	int ret;
+
+	report = kmalloc(ANE_H16_REPORT_MAX, GFP_KERNEL);
+	if (!report)
+		return -ENOMEM;
+	for (;;) {
+		size_t size;
+		u32 pending;
+
+		ret = ane_fw_transport_consume(t, report, ANE_H16_REPORT_MAX, &size);
+		if (!ret) {
+			ret = ane_h16_pending_dispatch(&s->pending, report, size,
+						       ANE_FW_IO_T2H,
+						       (unsigned long)div_u64(h16_now(s),
+									      NSEC_PER_USEC));
+			if (ret == ANE_H16_EVENT_COMPLETE) {
+				trace->done_ns = h16_now(s);
+				if (!trace->reports)
+					trace->first_ns = trace->done_ns;
+				ret = 0;
+				break;
+			}
+			if (ret == ANE_H16_EVENT_FAILED) {
+				ret = -EIO;
+				break;
+			}
+			/* Foreign or late UUIDs and ISP-routed reports never retire this call. */
+			if (ret == ANE_H16_EVENT_PROGRESS) {
+				h16_trace_report(trace, report, size, request, h16_now(s));
+				continue;
+			}
+			if (ret == -ENOENT || ret == -ENOMSG) {
+				trace->other++;
+				continue;
+			}
+			break;
+		}
+		if (ret != -EAGAIN)
+			break;
+		ret = ane_fw_transport_irq(t, &pending);
+		if (!ret) {
+			ret = ane_fw_transport_shared(t);
+			if (ret == -EAGAIN)
+				ret = 0;
+		}
+		if (!ret)
+			ret = ane_fw_transport_terminal(t);
+		if (ret)
+			break;
+		now = h16_now(s);
+		if (now >= deadline) {
+			ret = -ETIMEDOUT;
+			break;
+		}
+		t->polls++;
+		t->ops->relax(t->ctx, now - start);
+	}
+	kfree(report);
+	return ret;
+}
+
+/*
+ * 0x002d with 0, EXECUTE on channel 7 with its UUID already pending, the
+ * matching state-1 report on channel 6, 0x002d with 1, then a DMA read
+ * barrier before the caller reads outputs. Any uncertain outcome quarantines
+ * the session and keeps every mapping.
+ */
+static int h16_execute(struct ane_h16_session *s, struct ane_h16_program *p)
+{
+	struct ane_h16_execute_buffer buffers[ANE_H16_SURFACES + 1];
+	struct ane_h16_pending request = {};
+	struct h16_execute_trace trace = { .last_state = U32_MAX };
+	struct ane_h16_execute call = {};
+	struct ane_h16_exec_sample *x = &s->timing;
+	size_t length, sequence[5], mark;
+	u8 *command;
+	const u8 *reply = NULL;
+	unsigned int i;
+	u64 deadline, polls, t0, gate_open, t1 = 0, t2 = 0, t3, end;
+	u64 entry = h16_now(s);
+	int ret;
+
+	if (!s || !p || p->session != s)
+		return -EINVAL;
+	if (s->quarantined)
+		return -EIO;
+	if (!p->created || p->closed)
+		return -EINVAL;
+	/*
+	 * The snapshot was hashed and parsed at LOAD, everything the firmware
+	 * reads was copied out of it then, and it stays private and unchanged
+	 * until the program is freed. Hashing it again here (8.4 MB for
+	 * MobileNet, about 2.9 ms) protected nothing per request.
+	 */
+	ret = ane_h16_resources_validate(&p->hwx, p->resources, p->resource_count);
+	if (ret)
+		return ret;
+	/*
+	 * H17 checks each descriptor against the size the generic section
+	 * declared for its buffer at LOAD and asserts in its program manager
+	 * when it is smaller (relu64: section 0x1000 of a declared 0x4000
+	 * surface), so H17 descriptors carry the declared size. H16 keeps the
+	 * whole HWX section, which is what ran MobileNet on the J616s; the two
+	 * agree there (0x4c000). The declared size lies between the tensor span
+	 * and the mapped allocation. Userspace still sees and copies the span.
+	 */
+	for (i = 0; i < p->resource_count; i++) {
+		buffers[i] = p->resources[i].buffer;
+		buffers[i].size = s->transport->soc->chip_family >= 17 ? p->declared[i] :
+				  p->hwx.surfaces[i].section.size;
+	}
+	if (p->has_scratch)
+		buffers[i++] = p->scratch;
+	length = ANE_H16_EXECUTE_BASE_SIZE + p->bar_count * ANE_H16_CUSTOM_BAR_STRIDE;
+	/* Keep room for the teardown pair after this request. */
+	sequence[0] = ANE_H16_GATE_SIZE;
+	sequence[1] = length;
+	sequence[2] = ANE_H16_GATE_SIZE;
+	sequence[3] = ANE_H16_TERMINATE_SIZE;
+	sequence[4] = ANE_H16_UNLOAD_SIZE;
+	ret = h16_pool_room(s, sequence, ARRAY_SIZE(sequence));
+	if (ret)
+		return ret;
+	command = kzalloc(length, GFP_KERNEL);
+	if (!command)
+		return -ENOMEM;
+	mark = ane_fw_transport_mark(s->transport);
+	/* Inputs and poisoned outputs must reach memory before any doorbell. */
+	s->transport->ops->write_barrier(s->transport->ctx);
+	polls = s->transport->polls;
+	trace.step = H16_STEP_GATE_OPEN;
+	t0 = h16_now(s);
+	if (!s->gate_held) {
+		ret = h16_gate(s, 0);
+		if (ret)
+			goto fail;
+		s->gate_held = s->gate_hold_ns != 0;
+	}
+	gate_open = h16_now(s) - t0;
+	deadline = t0 + gate_open + s->timeout_ns;
+	request.key = p->key;
+	request.deadline = (unsigned long)div_u64(deadline, NSEC_PER_USEC);
+	ret = ane_h16_pending_insert(&s->pending, &request,
+				     (unsigned long)div_u64(h16_now(s), NSEC_PER_USEC));
+	if (ret)
+		goto fail;
+	call.key = request.key;
+	call.buffers = buffers;
+	call.buffer_count = p->resource_count + (p->has_scratch ? 1 : 0);
+	/*
+	 * The first request of a program on the engine, the first one after boot
+	 * included, takes the queued path once: only EXELOOP sets up the BAR
+	 * context and the L2-spill mapping that later direct requests reuse.  The
+	 * request carries every descriptor-declared custom BAR, including both
+	 * mixed-descriptor mcache streams, on the queued and direct paths.
+	 */
+	if (s->executed != p->generation)
+		call.flags = ANE_H16_EXECUTE_FLAG_QUEUED;
+	s->executed = p->generation;
+	call.bars = p->bars;
+	call.bar_count = p->bar_count;
+	ret = ane_h16_execute_encode(command, length, &call);
+	if (!ret)
+		ret = ane_h16_command_prepare(command, length, ANE_H16_EXECUTE,
+					      ANE_FW_DATA_CHAIN);
+	if (!ret) {
+		trace.step = H16_STEP_SEND;
+		t1 = h16_now(s);
+		ret = h16_send(s, ANE_FW_DATA_CHAIN, command, length, &reply);
+	}
+	/* The channel-7 reply acknowledges transport only, never completion. */
+	if (!ret) {
+		trace.step = H16_STEP_REPORT;
+		t2 = h16_now(s);
+		ret = h16_wait_report(s, &request, deadline, &trace);
+	}
+	if (ret) {
+		if (request.active)
+			ane_h16_pending_abort(&s->pending, &request, ret);
+		goto fail;
+	}
+	trace.step = H16_STEP_GATE_CLOSE;
+	t3 = h16_now(s);
+	if (!s->gate_held) {
+		ret = h16_gate(s, 1);
+		if (ret)
+			goto fail;
+	}
+	end = h16_now(s);
+	if (s->gate_held) {
+		/* Back-to-back requests find gating off; it goes on when idle. */
+		s->gate_last_ns = end;
+		if (s->lock)
+			mod_delayed_work(system_dfl_wq, &s->gate_work,
+					 nsecs_to_jiffies(s->gate_hold_ns));
+	}
+	s->transport->ops->read_barrier(s->transport->ctx);
+	memset(x, 0, sizeof(*x));
+	x->ns[ANE_H16_T_PREPARE] = t0 - entry;
+	x->ns[ANE_H16_T_GATE_OPEN] = gate_open;
+	x->ns[ANE_H16_T_SUBMIT_ACK] = t2 - t1;
+	x->ns[ANE_H16_T_ACK_REPORT] = trace.first_ns - t2;
+	x->ns[ANE_H16_T_REPORT_DONE] = trace.done_ns - trace.first_ns;
+	x->ns[ANE_H16_T_GATE_CLOSE] = end - t3;
+	x->ns[ANE_H16_T_FIRMWARE] = end - t0;
+	x->polls = s->transport->polls - polls;
+	kfree(command);
+	/*
+	 * The completion report and the closing gate reply both arrived, so the
+	 * firmware no longer reads this sequence's commands: reuse their space.
+	 */
+	ret = ane_fw_transport_release(s->transport, mark);
+	x->ns[ANE_H16_T_FINISH] = h16_now(s) - end;
+	return ret;
+fail:
+	s->ops->log(s->ctx, "EXECUTE failed", (u64)-ret, request.key.uuid);
+	/*
+	 * Step 1 opening gate, 2 channel-7 ack, 3 report wait, 4 closing gate.
+	 * Reports for this UUID and the last state (0 start, 3 engine start,
+	 * ffffffff none), then the count of other reports seen while waiting.
+	 */
+	s->ops->log(s->ctx, "EXECUTE step/flags", trace.step, call.flags);
+	s->ops->log(s->ctx, "EXECUTE reports/last state", trace.reports, trace.last_state);
+	s->ops->log(s->ctx, "EXECUTE other reports", trace.other, 0);
+	if (trace.step >= H16_STEP_SEND) {
+		h16_dump_rows("EXECUTE sent", command, length);
+		if (reply)
+			h16_dump_rows("EXECUTE ack", reply, 0x40);
+	}
+	s->fwlog_lines = h16_dump_fwlog(s);
+	kfree(command);
+	return h16_fail(s, ret);
+}
+
+/* Loaded before the firmware was booted again across system sleep. */
+bool ane_h16_program_lost(const struct ane_h16_session *s, const struct ane_h16_program *p)
+{
+	return p->epoch != s->epoch;
+}
+EXPORT_SYMBOL_GPL(ane_h16_program_lost);
+
+int ane_h16_session_execute(struct ane_h16_session *s, struct ane_h16_program *p)
+{
+	int ret;
+
+	if (!s || !p || p->session != s)
+		return -EINVAL;
+	/* The firmware that knew it is gone: no firmware traffic, reload. */
+	if (ane_h16_program_lost(s, p))
+		return -ENODEV;
+	if (s->ops->busy)
+		s->ops->busy(s->ctx, true);
+	ret = h16_execute(s, p);
+	if (s->ops->busy)
+		s->ops->busy(s->ctx, false);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_execute);
+
+const char *const ane_h16_exec_phase_names[ANE_H16_T_PHASES] = {
+	[ANE_H16_T_LOCK] = "lock",
+	[ANE_H16_T_COPY_IN] = "copy_in",
+	[ANE_H16_T_PREPARE] = "prepare",
+	[ANE_H16_T_GATE_OPEN] = "gate_open",
+	[ANE_H16_T_SUBMIT_ACK] = "submit_ack",
+	[ANE_H16_T_ACK_REPORT] = "ack_report",
+	[ANE_H16_T_REPORT_DONE] = "report_done",
+	[ANE_H16_T_GATE_CLOSE] = "gate_close",
+	[ANE_H16_T_FINISH] = "finish",
+	[ANE_H16_T_COPY_OUT] = "copy_out",
+	[ANE_H16_T_FIRMWARE] = "firmware",
+	[ANE_H16_T_IOCTL] = "ioctl",
+};
+EXPORT_SYMBOL_GPL(ane_h16_exec_phase_names);
+
+/* Fold one sample into last, sum, min and max. */
+void ane_h16_exec_stats_add(struct ane_h16_exec_stats *st,
+			    const struct ane_h16_exec_sample *x)
+{
+	unsigned int i;
+
+	if (!st->count++) {
+		st->min = *x;
+		st->max = *x;
+		memset(&st->sum, 0, sizeof(st->sum));
+	}
+	for (i = 0; i < ANE_H16_T_PHASES; i++) {
+		st->sum.ns[i] += x->ns[i];
+		st->min.ns[i] = min(st->min.ns[i], x->ns[i]);
+		st->max.ns[i] = max(st->max.ns[i], x->ns[i]);
+	}
+	st->sum.polls += x->polls;
+	st->min.polls = min(st->min.polls, x->polls);
+	st->max.polls = max(st->max.polls, x->polls);
+	st->last = *x;
+}
+EXPORT_SYMBOL_GPL(ane_h16_exec_stats_add);
+
+/*
+ * Account the last successful EXECUTE with the caller's copy and whole-request
+ * times. The caller serializes this with ane_h16_session_execute().
+ */
+void ane_h16_session_account(struct ane_h16_session *s, u64 lock_ns, u64 copy_in_ns,
+			     u64 copy_out_ns, u64 ioctl_ns)
+{
+	struct ane_h16_exec_sample x = s->timing;
+
+	x.ns[ANE_H16_T_LOCK] = lock_ns;
+	x.ns[ANE_H16_T_COPY_IN] = copy_in_ns;
+	x.ns[ANE_H16_T_COPY_OUT] = copy_out_ns;
+	x.ns[ANE_H16_T_IOCTL] = ioctl_ns;
+	spin_lock(&s->stats_lock);
+	ane_h16_exec_stats_add(&s->stats, &x);
+	spin_unlock(&s->stats_lock);
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_account);
+
+/* A consistent copy of the statistics, optionally starting them over. */
+void ane_h16_session_stats(struct ane_h16_session *s, struct ane_h16_exec_stats *out,
+			   bool reset)
+{
+	spin_lock(&s->stats_lock);
+	if (out)
+		*out = s->stats;
+	if (reset)
+		memset(&s->stats, 0, sizeof(s->stats));
+	spin_unlock(&s->stats_lock);
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_stats);
+
+static void h16_us(struct seq_file *m, u64 ns)
+{
+	seq_printf(m, " %9llu.%u", div_u64(ns, 1000), (unsigned int)(div_u64(ns, 100) % 10));
+}
+
+/*
+ * Where the time of the successful EXECUTEs since the last reset went, per
+ * phase in microseconds (last, mean, min, max), and the poll sleeps per
+ * request. Backends expose it as <debugfs>/ane-h1x/<dev>/execute.
+ */
+int ane_h16_session_stats_show(struct seq_file *m, struct ane_h16_session *s)
+{
+	struct ane_h16_exec_stats *st;
+	unsigned int i;
+
+	st = kmalloc_obj(*st);
+	if (!st)
+		return -ENOMEM;
+	ane_h16_session_stats(s, st, false);
+	seq_printf(m, "executes %llu\n", st->count);
+	if (st->count) {
+		seq_printf(m, "%-12s %11s %11s %11s %11s\n", "phase", "last_us", "mean_us",
+			   "min_us", "max_us");
+		for (i = 0; i < ANE_H16_T_PHASES; i++) {
+			seq_printf(m, "%-12s", ane_h16_exec_phase_names[i]);
+			h16_us(m, st->last.ns[i]);
+			h16_us(m, div64_u64(st->sum.ns[i], st->count));
+			h16_us(m, st->min.ns[i]);
+			h16_us(m, st->max.ns[i]);
+			seq_putc(m, '\n');
+		}
+		seq_printf(m, "%-12s %11llu %9llu.%u %11llu %11llu\n", "polls", st->last.polls,
+			   div64_u64(st->sum.polls, st->count),
+			   (unsigned int)(div64_u64(st->sum.polls * 10, st->count) % 10),
+			   st->min.polls, st->max.polls);
+	}
+	kfree(st);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_stats_show);
+
+/* TERMINATE then UNLOAD. The mappings stay until reset; a new LOAD may follow. */
+int ane_h16_session_close(struct ane_h16_session *s, struct ane_h16_program *p)
+{
+	u8 command[ANE_H16_TERMINATE_SIZE];
+	const u8 *reply;
+	int ret;
+
+	if (!s || !p || p->session != s)
+		return -EINVAL;
+	if (p->closed || !p->created)
+		return 0;
+	/*
+	 * The firmware is suspended for system sleep and keeps this program:
+	 * tear it down when the session reopens. The session owns it until.
+	 */
+	if (s->asleep) {
+		if (list_empty(&p->deferred))
+			list_add_tail(&p->deferred, &s->deferred);
+		return -EINPROGRESS;
+	}
+	p->closed = true;
+	list_del_init(&p->node);
+	/*
+	 * The firmware that knew this program was powered off and booted again
+	 * from the preload: there is nothing to tear down, and nothing reads
+	 * its memory any more.
+	 */
+	if (ane_h16_program_lost(s, p)) {
+		h16_give_back(s, p);
+		s->ops->log(s->ctx, "program lost across sleep, released", p->key.program,
+			    p->key.process);
+		return 0;
+	}
+	if (s->quarantined)
+		return -EIO;
+	/* TERMINATE and UNLOAD run with gating on, as without the hold. */
+	ret = h16_gate_release(s);
+	if (ret)
+		return ret;
+	ret = ane_h16_terminate_encode(command, ANE_H16_TERMINATE_SIZE, p->key.program,
+				       p->key.process);
+	if (!ret)
+		ret = h16_send(s, ANE_FW_IO, command, ANE_H16_TERMINATE_SIZE, &reply);
+	if (!ret)
+		ret = ane_h16_id_reply(reply, ANE_H16_TERMINATE_SIZE, command);
+	if (!ret)
+		ret = ane_h16_unload_encode(command, ANE_H16_UNLOAD_SIZE, p->key.program);
+	if (!ret)
+		ret = h16_send(s, ANE_FW_IO, command, ANE_H16_UNLOAD_SIZE, &reply);
+	if (!ret)
+		ret = ane_h16_id_reply(reply, ANE_H16_UNLOAD_SIZE, command);
+	if (ret)
+		return h16_fail(s, ret);
+	s->ops->log(s->ctx, "TERMINATE and UNLOAD", p->key.program, p->key.process);
+	/* Answer the FREE of the process pool while the firmware waits for it. */
+	ret = ane_fw_transport_settle(s->transport, s->settle_ns,
+				      max(s->settle_ns, ANE_H16_SETTLE_LIMIT_NS));
+	if (ret < 0)
+		return h16_fail(s, ret);
+	/*
+	 * The firmware acknowledged TERMINATE and UNLOAD, so it no longer
+	 * reads or writes this program's memory: later programs may reuse it.
+	 */
+	h16_give_back(s, p);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_close);
+
+/*
+ * Requests (LOAD, EXECUTE) wait here while the engine is cycled across
+ * system sleep, freezably so the freezer can stop their task, and enter with
+ * the session's serializing lock held.
+ */
+int ane_h16_session_enter(struct ane_h16_session *s, bool nonblock)
+{
+	int ret;
+
+	for (;;) {
+		/* O_NONBLOCK: a clean -EAGAIN while the engine is cycled. */
+		if (nonblock && READ_ONCE(s->asleep))
+			return -EAGAIN;
+		ret = wait_event_freezable(s->wake, !READ_ONCE(s->asleep));
+		if (ret)
+			return ret;
+		mutex_lock(s->lock);
+		if (!s->asleep)
+			return 0;
+		mutex_unlock(s->lock);
+	}
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_enter);
+
+/*
+ * Close the session to new requests and wait for the one in flight
+ * (asleep), or reopen it. The caller cycles the firmware in between.
+ */
+void ane_h16_session_sleep(struct ane_h16_session *s, bool asleep)
+{
+	struct ane_h16_program *p, *n;
+
+	mutex_lock(s->lock);
+	/* The firmware is suspended or powered off with gating on. */
+	if (asleep && s->gate_held && h16_gate_release(s))
+		s->ops->log(s->ctx, "gate release before sleep failed", (u64)-s->error, 0);
+	WRITE_ONCE(s->asleep, asleep);
+	/* Closes that came in while asleep, now that the firmware is back. */
+	if (!asleep) {
+		list_for_each_entry_safe(p, n, &s->deferred, deferred) {
+			list_del_init(&p->deferred);
+			if (!ane_h16_session_close(s, p))
+				ane_h16_session_put(s, p);
+		}
+	}
+	mutex_unlock(s->lock);
+	if (!asleep)
+		wake_up_all(&s->wake);
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_sleep);
+
+/*
+ * The firmware was booted again from the preload (system sleep without
+ * firmware cooperation): every program loaded before is lost (EXECUTE
+ * refuses it with -ENODEV, close only releases its memory), no request is
+ * pending, and the next program starts a new BAR context. Called with the
+ * session asleep, before it reopens.
+ */
+void ane_h16_session_restart(struct ane_h16_session *s)
+{
+	s->epoch++;
+	s->program = NULL;
+	/* A firmware booted again from the preload starts with gating on. */
+	s->gate_held = false;
+	s->executed = 0;
+	memset(s->pending.slots, 0, sizeof(s->pending.slots));
+	s->pending.error = 0;
+	s->error = 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_restart);
+
+/*
+ * Put one program back on a firmware booted again from the preload, behind
+ * its existing handle: its regions are rewritten from the HWX snapshot as at
+ * its first LOAD (the aux sections and every mapping kept their DVAs), then
+ * LOAD and CREATE are sent again and the firmware's new program and process
+ * IDs replace the old ones. The firmware sees exactly the image it saw at
+ * the first LOAD, so the program computes the same outputs.
+ */
+static int h16_replay(struct ane_h16_session *s, struct ane_h16_program *p)
+{
+	u8 *command;
+	const u8 *reply;
+	unsigned int i;
+	int ret;
+
+	ret = h16_pool_room(s, h16_load_sequence, 2);
+	if (ret)
+		return ret;
+	command = kzalloc(ANE_H16_CREATE_SIZE, GFP_KERNEL);
+	if (!command)
+		return -ENOMEM;
+	for (i = 0; i < p->plan.count; i++) {
+		const struct ane_h16_hwx_region *r = &p->plan.regions[i];
+
+		memset(p->regions[i].cpu, 0, p->regions[i].size);
+		memcpy(p->regions[i].cpu, (const u8 *)p->snapshot.bytes + r->file_offset,
+		       r->file_size);
+		h16_sync(s, &p->regions[i], true);
+	}
+	ret = ane_h16_load_encode(command, ANE_H16_LOAD_SIZE, p->slots);
+	if (!ret)
+		ret = h16_send(s, ANE_FW_IO, command, ANE_H16_LOAD_SIZE, &reply);
+	if (!ret)
+		ret = ane_h16_load_reply(reply, ANE_H16_LOAD_SIZE, command, &p->key.program);
+	if (!ret) {
+		memset(command, 0, ANE_H16_CREATE_SIZE);
+		ret = ane_h16_create_encode(command, ANE_H16_CREATE_SIZE, p->key.program);
+	}
+	if (!ret)
+		ret = h16_send(s, ANE_FW_IO, command, ANE_H16_CREATE_SIZE, &reply);
+	if (!ret)
+		ret = ane_h16_create_reply(reply, ANE_H16_CREATE_SIZE, p->key.program,
+					   &p->key.process);
+	kfree(command);
+	if (ret)
+		return h16_fail(s, ret);
+	p->epoch = s->epoch;
+	s->ops->log(s->ctx, "program replayed", p->key.program, p->key.process);
+	return 0;
+}
+
+/*
+ * After ane_h16_session_restart(): replay every program that was loaded and
+ * not closed, in load order, so that its handle runs again unchanged. A
+ * program closed while asleep is only released (it stays lost). A failed
+ * replay is a bug: it is logged loudly, quarantines the session (the
+ * firmware state is uncertain) and returns the error.
+ */
+int ane_h16_session_replay(struct ane_h16_session *s, unsigned int *replayed,
+			   u64 *first_ns)
+{
+	struct ane_h16_program *p;
+	int ret;
+
+	*replayed = 0;
+	*first_ns = 0;
+	list_for_each_entry(p, &s->programs, node) {
+		if (!list_empty(&p->deferred))
+			continue;
+		ret = h16_replay(s, p);
+		if (ret) {
+			s->ops->log(s->ctx, "PROGRAM REPLAY FAILED", p->key.program, (u64)-ret);
+			return ret;
+		}
+		if (!(*replayed)++)
+			*first_ns = h16_now(s);
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_replay);
+
+/*
+ * The caller's last reference: free a closed program and its HWX snapshot.
+ * A program whose teardown failed keeps everything until reset.
+ */
+void ane_h16_session_put(struct ane_h16_session *s, struct ane_h16_program *p)
+{
+	if (!s || !p || p->session != s || !p->released)
+		return;
+	if (s->program == p)
+		s->program = NULL;
+	list_del_init(&p->node);
+	ane_h16_hwx_snapshot_destroy(&p->snapshot);
+	kfree(p);
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_put);
+
+MODULE_DESCRIPTION("H16 program load, execute and teardown on the shared transport");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/accel/ane/ane_h16_program.h b/drivers/accel/ane/ane_h16_program.h
new file mode 100644
index 0000000000..b00c16e9e4
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_program.h
@@ -0,0 +1,355 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_H16_PROGRAM_H__
+#define __ANE_H16_PROGRAM_H__
+
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+#include <linux/spinlock.h>
+
+#include "ane_fw_transport.h"
+#include "ane_h16_load.h"
+#include "ane_h16_pending.h"
+
+/*
+ * Program lifecycle for one H16 firmware session: LOAD_PROGRAM, CREATE_PROCESS,
+ * the 0x002d/EXECUTE/0x002d sequence and TERMINATE/UNLOAD. Wire facts are from
+ * the H16 cold-boot facts (rounds 1 and 5, program load and lifecycle) and the
+ * SPEC-r4 EXECUTE layout. Nothing here maps memory or touches hardware; the
+ * backend supplies private mappings through ane_h16_session_ops.
+ */
+
+#define ANE_H16_LOAD_SIZE 0x1c0
+#define ANE_H16_LOAD_SLOTS 9
+#define ANE_H16_LOAD_SLOT_OFFSET 0x08
+#define ANE_H16_LOAD_SLOT_SIZE 0x30
+#define ANE_H16_LOAD_ID_OFFSET 0x1b8
+#define ANE_H16_LOAD_ID_REQUEST 0xffffffffU
+#define ANE_H16_CREATE_SIZE 0x258
+#define ANE_H16_TERMINATE_SIZE 0x10
+#define ANE_H16_UNLOAD_SIZE 0xc
+#define ANE_H16_GATE_SIZE 0xc
+#define ANE_H16_REPORT_MAX 0x100
+/* First value of the firmware mcache DSID pool (custom-BAR facts, 4). */
+#define ANE_H16_MCACHE_DSID 36
+
+/*
+ * Host-built generic section: header, then one entry per surface in HWX
+ * segment order, then one entry for the __DATA scratch when the program has
+ * one.
+ */
+#define ANE_H16_GENERIC_MAGIC		1
+#define ANE_H16_GENERIC_VERSION		0x10
+#define ANE_H16_GENERIC_COUNT		0x204
+#define ANE_H16_GENERIC_HEADER		0x208
+#define ANE_H16_GENERIC_ENTRY		0x30
+#define ANE_H16_GENERIC_ID_MAX		0x3c
+
+/* Host-built operation section: a count, then fixed-size BAR records. */
+#define ANE_H16_OPERATION_RECORD	0x40c
+#define ANE_H16_OPERATION_RECORDS_MAX	64
+#define ANE_H16_OPERATION_REFS_MAX	64
+
+/* Host-built sections. Userspace packs their bytes; the kernel places them. */
+enum ane_h16_aux {
+	ANE_H16_AUX_GENERIC,
+	ANE_H16_AUX_OPERATION,
+	ANE_H16_AUX_PROCEDURE,
+	ANE_H16_AUX_TEXT_PROPERTIES,
+	ANE_H16_AUX_COUNT,
+};
+
+#define ANE_H16_AUX_MIN 0x28
+#define ANE_H16_AUX_MAX SZ_64K
+
+/* Source of one LOAD slot. */
+enum ane_h16_slot_source {
+	ANE_H16_SLOT_EMPTY,
+	ANE_H16_SLOT_AUX_GENERIC,
+	ANE_H16_SLOT_KERNEL,
+	ANE_H16_SLOT_TEXT,
+	ANE_H16_SLOT_AUX_OPERATION,
+	ANE_H16_SLOT_AUX_PROCEDURE,
+	ANE_H16_SLOT_AUX_TEXT_PROPERTIES,
+};
+
+struct ane_h16_slot_rule {
+	enum ane_h16_slot_source source;
+	u32 resource;
+	u32 class;
+};
+
+/* Resource indices of the six populated slots (facts 9.2, r5 7.1). The
+ * kernel slot index is also the operation tag of a kernel-table program.
+ */
+#define ANE_H16_RESOURCE_GENERIC 1002
+#define ANE_H16_RESOURCE_OPERATION 1003
+#define ANE_H16_RESOURCE_PROCEDURE 1004
+#define ANE_H16_RESOURCE_TEXT_PROPERTIES 1005
+#define ANE_H16_RESOURCE_TEXT 1006
+#define ANE_H16_RESOURCE_KERNEL 1007
+
+const struct ane_h16_slot_rule *ane_h16_slot_rule(unsigned int slot);
+
+struct ane_h16_load_slot {
+	u32 resource;
+	u32 class;
+	u64 dva;
+	u64 size;
+	bool present;
+};
+
+/* Firmware-visible placement of every LOAD input, all kernel-owned. */
+struct ane_h16_load_layout {
+	struct ane_h16_load_mapping regions[ANE_H16_REGIONS];
+	u32 region_count;
+	u64 aux_dva[ANE_H16_AUX_COUNT];
+	u64 aux_size[ANE_H16_AUX_COUNT];
+};
+
+/* Round 5, section 7: resource usage type to EXECUTE descriptor class. */
+static inline u32 ane_h16_usage_class(u32 usage)
+{
+	static const u8 classes[] = {
+		[1] = 0, [2] = 1, [3] = 0, [4] = 1, [5] = 6, [6] = 8, [7] = 2,
+		[8] = 8, [9] = 8, [10] = 4, [11] = 8, [12] = 0, [13] = 0,
+	};
+
+	if (usage < 1 || usage >= ARRAY_SIZE(classes))
+		return 8;
+	return classes[usage];
+}
+
+int ane_h16_load_slots(const struct ane_h16_hwx *hwx,
+		       const struct ane_h16_load_plan *plan,
+		       const struct ane_h16_load_layout *layout,
+		       struct ane_h16_load_slot slots[ANE_H16_LOAD_SLOTS]);
+int ane_h16_load_encode(void *command, size_t length,
+			const struct ane_h16_load_slot slots[ANE_H16_LOAD_SLOTS]);
+int ane_h16_load_reply(const void *reply, size_t length, const void *request,
+		       u32 *program);
+int ane_h16_create_encode(void *command, size_t length, u32 program);
+int ane_h16_create_reply(const void *reply, size_t length, u32 program, u32 *process);
+int ane_h16_terminate_encode(void *command, size_t length, u32 program, u32 process);
+int ane_h16_unload_encode(void *command, size_t length, u32 program);
+int ane_h16_id_reply(const void *reply, size_t length, const void *request);
+int ane_h16_gate_encode(void *command, size_t length, u32 value);
+
+int ane_h16_process_bindings(const struct ane_h16_hwx *hwx, const void *generic,
+			     size_t generic_size,
+			     struct ane_h16_process_binding *bindings,
+			     unsigned int *count,
+			     struct ane_h16_process_binding *scratch);
+int ane_h16_operation_validate(const struct ane_h16_hwx_snapshot *snapshot,
+			       const struct ane_h16_hwx *hwx, const void *operation,
+			       size_t operation_size,
+			       const struct ane_h16_process_binding *bindings,
+			       unsigned int count,
+			       const struct ane_h16_process_binding *scratch);
+int ane_h16_custom_bars(const struct ane_h16_hwx_snapshot *snapshot,
+			const struct ane_h16_hwx *hwx, u32 dsid,
+			struct ane_h16_custom_bar *bars, unsigned int *count);
+
+/* Private, pinned mappings in the firmware domain. Never released before reset. */
+struct ane_h16_session_ops {
+	int (*map)(void *ctx, size_t size, bool device_write,
+		   struct ane_fw_surface *surface);
+	void (*log)(void *ctx, const char *item, u64 a, u64 b);
+	/*
+	 * Optional. For a surface with a handle: before the engine uses it
+	 * (for_device) write back CPU writes; after the engine wrote it
+	 * (!for_device) drop stale lines before the CPU reads. Without it,
+	 * or for a surface without a handle, memory is coherent.
+	 */
+	void (*sync)(void *ctx, const struct ane_fw_surface *surface, bool for_device);
+	/*
+	 * Optional. Called with true before an EXECUTE touches the firmware
+	 * and with false after it ended, successful or not, so a backend can
+	 * hold a performance vote only while work is in flight.
+	 */
+	void (*busy)(void *ctx, bool busy);
+};
+
+struct ane_h16_program {
+	struct ane_h16_hwx_snapshot snapshot;
+	/* Parsed again from the authenticated bytes, never the cached info. */
+	struct ane_h16_hwx hwx;
+	struct ane_h16_load_plan plan;
+	struct ane_fw_surface regions[ANE_H16_REGIONS];
+	struct ane_fw_surface aux[ANE_H16_AUX_COUNT];
+	struct ane_h16_load_slot slots[ANE_H16_LOAD_SLOTS];
+	struct ane_h16_resource resources[ANE_H16_SURFACES];
+	struct ane_fw_surface *surfaces[ANE_H16_SURFACES];
+	struct ane_h16_custom_bar bars[ANE_H16_MAX_CUSTOM_BARS];
+	unsigned int bar_count;
+	unsigned int resource_count;
+	/* Per-surface buffer size from the generic section, sent in EXECUTE. */
+	u64 declared[ANE_H16_SURFACES];
+	/*
+	 * The __DATA scratch: a kernel-owned EXECUTE input that carries the
+	 * DRAM edges between tasks. Userspace never sees or fills it.
+	 */
+	struct ane_h16_execute_buffer scratch;
+	bool has_scratch;
+	struct ane_h16_session *session;
+	/* Session-local identity; firmware program IDs are reused after UNLOAD. */
+	u64 generation;
+	struct ane_h16_request_key key;
+	bool created;
+	bool closed;
+	/* Torn down cleanly: its memory went back to the session's spares. */
+	bool released;
+	/* Closed while the engine slept: torn down when the session reopens. */
+	struct list_head deferred;
+	/* Firmware boot the program was loaded in; an older one means lost. */
+	u64 epoch;
+	/* In the session's list of programs to replay after a cold boot. */
+	struct list_head node;
+};
+
+/* The quiet time that ends serving the SHAREDMALLOC ring after UNLOAD. */
+#define ANE_H16_SETTLE_QUIET_NS (10ULL * 1000 * 1000)
+#define ANE_H16_SETTLE_LIMIT_NS (100ULL * 1000 * 1000)
+
+/*
+ * Where the time of one EXECUTE goes, in nanoseconds. The firmware phases
+ * are measured by ane_h16_session_execute(); a reply or report is "seen"
+ * when a poll finds it, so they include the poll latency. The copy and
+ * ioctl phases come from the caller through ane_h16_session_account().
+ */
+enum ane_h16_exec_phase {
+	ANE_H16_T_LOCK,		/* waiting for the session lock */
+	ANE_H16_T_COPY_IN,	/* inputs copied in, outputs poisoned */
+	ANE_H16_T_PREPARE,	/* checks, command buffer, until the opening gate */
+	ANE_H16_T_GATE_OPEN,	/* 0x002d 0 published until its reply */
+	ANE_H16_T_SUBMIT_ACK,	/* EXECUTE published until its channel-7 ack */
+	ANE_H16_T_ACK_REPORT,	/* the ack until the first report of the UUID */
+	ANE_H16_T_REPORT_DONE,	/* that report until the completion report */
+	ANE_H16_T_GATE_CLOSE,	/* 0x002d 1 published until its reply */
+	ANE_H16_T_FINISH,	/* read barrier, freeing the command and its arena */
+	ANE_H16_T_COPY_OUT,	/* outputs copied out */
+	ANE_H16_T_FIRMWARE,	/* opening gate published until closing gate reply */
+	ANE_H16_T_IOCTL,	/* the whole request after copying its buffer table */
+	ANE_H16_T_PHASES
+};
+
+struct ane_h16_exec_sample {
+	u64 ns[ANE_H16_T_PHASES];
+	/* Sleeps between polls over all four waits. */
+	u64 polls;
+};
+
+struct ane_h16_exec_stats {
+	u64 count;
+	struct ane_h16_exec_sample last, sum, min, max;
+};
+
+extern const char *const ane_h16_exec_phase_names[ANE_H16_T_PHASES];
+void ane_h16_exec_stats_add(struct ane_h16_exec_stats *st,
+			    const struct ane_h16_exec_sample *x);
+
+/*
+ * Programs of one firmware session: one loaded at a time, any number per
+ * boot; a switch-safe transport may hold several. See ane_h16_session_load().
+ */
+/*
+ * Program memory given back by a program that the firmware unloaded. It
+ * stays mapped until reset like every firmware-visible mapping, and serves
+ * a later program's mapping of the same size and permission instead of a
+ * new one, so loading the same model again and again uses no new memory.
+ */
+#define ANE_H16_SPARES 64
+
+struct ane_h16_spare {
+	struct ane_fw_surface surface;
+	bool write;
+};
+
+struct ane_h16_session {
+	struct ane_fw_transport *transport;
+	const struct ane_h16_session_ops *ops;
+	void *ctx;
+	u64 timeout_ns;
+	struct ane_h16_pending_table pending;
+	/* The last loaded program. */
+	struct ane_h16_program *program;
+	struct ane_h16_spare spares[ANE_H16_SPARES];
+	unsigned int spare_count;
+	/* Quiet time that ends serving the SHAREDMALLOC ring after UNLOAD. */
+	u64 settle_ns;
+	/*
+	 * While the firmware is suspended for system sleep, requests wait in
+	 * ane_h16_session_enter() and closes are deferred to the reopen.
+	 */
+	bool asleep;
+	struct list_head deferred;
+	/*
+	 * Firmware boot count: a cold restart across system sleep loses every
+	 * program loaded before it (ane_h16_session_restart()) until it is
+	 * replayed (ane_h16_session_replay()).
+	 */
+	u64 epoch;
+	/* Created programs not yet closed, in load order. */
+	struct list_head programs;
+	wait_queue_head_t wake;
+	/* The accel node lock the sleep gate serializes on. */
+	struct mutex *lock;
+	/* Generation of the last loaded program, and of the last one executed. */
+	u64 generation;
+	u64 executed;
+	u32 dsid;
+	int error;
+	/* Firmware log lines printed after the last failed EXECUTE. */
+	unsigned int fwlog_lines;
+	bool quarantined;
+	/*
+	 * Dynamic power gating (0x002d) held off across back-to-back requests.
+	 * With gate_hold_ns zero every EXECUTE opens and closes the gate itself.
+	 * Otherwise the first EXECUTE opens it, later ones find it open, and it
+	 * closes gate_hold_ns after the last one ended (gate_work, serialized on
+	 * lock), before TERMINATE, and before system sleep.
+	 */
+	u64 gate_hold_ns;
+	bool gate_held;
+	u64 gate_last_ns;
+	struct delayed_work gate_work;
+	/* Firmware phases of the last successful EXECUTE. */
+	struct ane_h16_exec_sample timing;
+	/* Accounted EXECUTEs; the lock lets a reader snapshot them. */
+	spinlock_t stats_lock;
+	struct ane_h16_exec_stats stats;
+};
+
+int ane_h16_session_init(struct ane_h16_session *s, struct ane_fw_transport *transport,
+			 const struct ane_h16_session_ops *ops, void *ctx,
+			 u64 timeout_ns);
+int ane_h16_session_load(struct ane_h16_session *s,
+			 struct ane_h16_hwx_snapshot *snapshot,
+			 const void *const aux[ANE_H16_AUX_COUNT],
+			 const size_t aux_size[ANE_H16_AUX_COUNT],
+			 struct ane_h16_program **program);
+int ane_h16_session_execute(struct ane_h16_session *s, struct ane_h16_program *p);
+int ane_h16_session_close(struct ane_h16_session *s, struct ane_h16_program *p);
+void ane_h16_session_put(struct ane_h16_session *s, struct ane_h16_program *p);
+int ane_h16_session_enter(struct ane_h16_session *s, bool nonblock);
+unsigned int ane_h16_session_dump_fwlog(struct ane_h16_session *s);
+void ane_h16_session_sleep(struct ane_h16_session *s, bool asleep);
+int ane_h16_session_gate_expire(struct ane_h16_session *s);
+void ane_h16_session_restart(struct ane_h16_session *s);
+int ane_h16_session_replay(struct ane_h16_session *s, unsigned int *replayed,
+			   u64 *first_ns);
+bool ane_h16_program_lost(const struct ane_h16_session *s, const struct ane_h16_program *p);
+
+void ane_h16_session_sync(struct ane_h16_session *s, struct ane_h16_program *p,
+			  bool for_device);
+void ane_h16_session_account(struct ane_h16_session *s, u64 lock_ns, u64 copy_in_ns,
+			     u64 copy_out_ns, u64 ioctl_ns);
+void ane_h16_session_stats(struct ane_h16_session *s, struct ane_h16_exec_stats *out,
+			   bool reset);
+
+struct seq_file;
+int ane_h16_session_stats_show(struct seq_file *m, struct ane_h16_session *s);
+
+#define ANE_H16_FWLOG_RECORD 0x80
+size_t ane_h16_fwlog_line(const u8 *record, char *line);
+
+#endif /* __ANE_H16_PROGRAM_H__ */
diff --git a/drivers/accel/ane/ane_h16_program_test.c b/drivers/accel/ane/ane_h16_program_test.c
new file mode 100644
index 0000000000..48c64c73a1
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_program_test.c
@@ -0,0 +1,2273 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <kunit/test.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+
+#include "ane_h16_boot.h"
+#include "ane_h16_program.h"
+
+#include "ane_h16_hwx_test_fixture.h"
+#include "ane_h16_add128_fixture.h"
+#include "ane_h17_mobilenet_fixture.h"
+
+#define FW_IPC_DVA 0x100003d0000ULL
+#define FW_POOL_DVA 0x10000384000ULL
+#define FW_MAP_DVA 0x10001f00000ULL
+#define FW_RING_SLOTS 8
+#define FW_REPORTS 0x8000
+
+enum fw_mode {
+	FW_OK,
+	FW_LOAD_ID_UNCHANGED,
+	FW_LOAD_NAK,
+	FW_CREATE_BODY,
+	FW_REPORT_FOREIGN_UUID,
+	FW_REPORT_WRONG_PROCESS,
+	FW_REPORT_FAILURE,
+	FW_REPORT_STALL,
+	/* State 0 at once, then states 3 and 1 after late_polls sleeps. */
+	FW_REPORT_LATE,
+};
+
+/* A synchronous fake firmware that answers on each doorbell. */
+struct prog_fw {
+	struct kunit *test;
+	struct ane_fw_platform soc;
+	struct ane_fw_surface ipc, pool;
+	struct ane_fw_transport t;
+	struct ane_h16_session s;
+	enum fw_mode mode;
+	u64 now;
+	/* Time each doorbell takes to answer. */
+	u64 doorbell_ns;
+	u64 late_uuid;
+	u32 late_program, late_process;
+	unsigned int late_polls;
+	u64 next_dva;
+	u32 head[ANE_FW_CHANNELS];
+	u32 reports;
+	/* First IDs; the firmware hands out the lowest free one, reused after teardown. */
+	u32 program, process;
+	u32 programs_live, processes_live;
+	u16 ids[32];
+	u32 values[32];
+	unsigned int count;
+	u8 exec[0xd00];
+	size_t exec_length;
+	u32 exec_flags[32];
+	unsigned int execs;
+	u8 load[ANE_H16_LOAD_SIZE];
+	unsigned int maps, writable_maps;
+	/* busy(true) and busy(false) calls, and the deepest nesting seen. */
+	unsigned int busy_on, busy_off;
+	int busy_depth, busy_max;
+	/* Cache maintenance calls, when the fake hands out cached surfaces. */
+	bool cached;
+	unsigned int syncs_device, syncs_cpu;
+	u64 last_sync_dva;
+	/* The EXECUTE failure trace lines, by step. */
+	u64 fail_step, fail_flags, fail_reports, fail_state, fail_other;
+	/* EXECUTE of a program or process this firmware never created fails. */
+	bool strict;
+	unsigned int replay_failed;
+};
+
+static u64 fw_load(void *ctx, const void *p)
+{
+	return get_unaligned_le64(p);
+}
+
+static void fw_store(void *ctx, void *p, u64 value)
+{
+	put_unaligned_le64(value, p);
+}
+
+static void fw_barrier(void *ctx)
+{
+}
+
+static u32 fw_read32(void *ctx, u32 reg)
+{
+	return 0;
+}
+
+static u8 *fw_slot(struct prog_fw *f, unsigned int ch)
+{
+	return (u8 *)f->ipc.cpu + f->t.channels[ch].offset + f->head[ch] * ANE_FW_SLOT_SIZE;
+}
+
+static void fw_advance(struct prog_fw *f, unsigned int ch)
+{
+	f->head[ch] = (f->head[ch] + 1) % f->t.channels[ch].slots;
+}
+
+static void fw_report(struct prog_fw *f, u64 uuid, u32 program, u32 process, u32 state)
+{
+	u32 offset = FW_REPORTS + (f->reports++ % 16) * 0x60;
+	u8 *r = (u8 *)f->ipc.cpu + offset, *slot = fw_slot(f, ANE_FW_IO_T2H);
+
+	memset(r, 0, 0x60);
+	put_unaligned_le32(0xfe00 + (state == 1), r);
+	put_unaligned_le16(0x300, r + 4);
+	put_unaligned_le64(uuid, r + 8);
+	put_unaligned_le32(program, r + 0x10);
+	put_unaligned_le32(process, r + 0x14);
+	put_unaligned_le32(state, r + 0x1c);
+	put_unaligned_le64(0x60, slot + 8);
+	put_unaligned_le64(0, slot + 16);
+	put_unaligned_le64(f->ipc.dva + offset, slot);
+	fw_advance(f, ANE_FW_IO_T2H);
+}
+
+/* Reports carry the IDs of the EXECUTE they answer. */
+static void fw_execute(struct prog_fw *f, const u8 *cmd)
+{
+	u64 uuid = get_unaligned_le64(cmd + 0x20);
+	u32 program = get_unaligned_le32(cmd + 8), process = get_unaligned_le32(cmd + 0xc);
+
+	if (f->execs < ARRAY_SIZE(f->exec_flags))
+		f->exec_flags[f->execs] = get_unaligned_le32(cmd + ANE_H16_EXECUTE_FLAGS);
+	f->execs++;
+	switch (f->mode) {
+	case FW_REPORT_FOREIGN_UUID:
+		fw_report(f, uuid + 100, program, process, 0);
+		fw_report(f, uuid + 100, program, process, 1);
+		break;
+	case FW_REPORT_WRONG_PROCESS:
+		fw_report(f, uuid, program, process, 0);
+		fw_report(f, uuid, program, process + 1, 1);
+		break;
+	case FW_REPORT_FAILURE:
+		fw_report(f, uuid, program, process, 0);
+		fw_report(f, uuid, program, process, 2);
+		break;
+	case FW_REPORT_LATE:
+		fw_report(f, uuid, program, process, 0);
+		f->late_uuid = uuid;
+		f->late_program = program;
+		f->late_process = process;
+		break;
+	case FW_REPORT_STALL:
+		/* Started on the engine, then never a terminal report. */
+		fw_report(f, uuid, program, process, 0);
+		fw_report(f, uuid, program, process, 3);
+		break;
+	default:
+		if (f->strict && (program - f->program >= 32 || process - f->process >= 32 ||
+				  !(f->programs_live & BIT(program - f->program)) ||
+				  !(f->processes_live & BIT(process - f->process)))) {
+			fw_report(f, uuid, program, process, 2);
+			break;
+		}
+		fw_report(f, uuid, program, process, 0);
+		fw_report(f, uuid, program, process, 3);
+		fw_report(f, uuid, program, process, 1);
+		break;
+	}
+}
+
+/* A firmware booted again from the preload: no program or process, new IDs. */
+static void fw_cold_boot(struct prog_fw *f)
+{
+	f->programs_live = 0;
+	f->processes_live = 0;
+	f->program += 0x10;
+	f->process += 0x10;
+}
+
+static u32 fw_take_id(u32 *live, u32 base)
+{
+	unsigned int i = ffz(*live);
+
+	*live |= BIT(i);
+	return base + i;
+}
+
+static void fw_command(struct prog_fw *f, unsigned int ch)
+{
+	u8 *slot = fw_slot(f, ch), *cmd;
+	u64 dva = get_unaligned_le64(slot), length = get_unaligned_le64(slot + 8);
+	u16 id;
+
+	if (dva & 1)
+		return;
+	cmd = (u8 *)f->pool.cpu + (dva - f->pool.dva);
+	id = get_unaligned_le16(cmd + 4);
+	if (f->count < ARRAY_SIZE(f->ids)) {
+		f->ids[f->count] = id;
+		f->values[f->count] = length >= 12 ? get_unaligned_le32(cmd + 8) : 0;
+		f->count++;
+	}
+	switch (id) {
+	case ANE_H16_LOAD_PROGRAM:
+		memcpy(f->load, cmd, sizeof(f->load));
+		if (f->mode == FW_LOAD_NAK)
+			put_unaligned_le16(1, cmd + 6);
+		else if (f->mode != FW_LOAD_ID_UNCHANGED)
+			put_unaligned_le32(fw_take_id(&f->programs_live, f->program),
+					   cmd + ANE_H16_LOAD_ID_OFFSET);
+		break;
+	case ANE_H16_UNLOAD_PROGRAM:
+		if (get_unaligned_le32(cmd + 8) - f->program < 32)
+			f->programs_live &= ~BIT(get_unaligned_le32(cmd + 8) - f->program);
+		break;
+	case ANE_H16_TERMINATE_PROCESS:
+		if (get_unaligned_le32(cmd + 0xc) - f->process < 32)
+			f->processes_live &= ~BIT(get_unaligned_le32(cmd + 0xc) - f->process);
+		break;
+	case ANE_H16_CREATE_PROCESS:
+		KUNIT_EXPECT_FALSE(f->test, memchr_inv(cmd + 0xc, 0, ANE_H16_CREATE_SIZE - 0xc));
+		put_unaligned_le32(fw_take_id(&f->processes_live, f->process), cmd + 0xc);
+		if (f->mode == FW_CREATE_BODY)
+			cmd[0x100] = 1;
+		break;
+	case ANE_H16_EXECUTE:
+		f->exec_length = min_t(size_t, length, sizeof(f->exec));
+		memcpy(f->exec, cmd, f->exec_length);
+		break;
+	}
+	put_unaligned_le64(length, slot + 8);
+	put_unaligned_le64(0, slot + 16);
+	put_unaligned_le64(dva | 1, slot);
+	fw_advance(f, ch);
+	if (id == ANE_H16_EXECUTE)
+		fw_execute(f, cmd);
+}
+
+static void fw_write32(void *ctx, u32 reg, u32 value)
+{
+	struct prog_fw *f = ctx;
+
+	if (reg != f->soc.doorbell)
+		return;
+	/* Commands take doorbell_ns to answer; returning report slots is free. */
+	if (value & (BIT(ANE_FW_IO) | BIT(ANE_FW_DATA_CHAIN)))
+		f->now += f->doorbell_ns;
+	if (value & BIT(ANE_FW_IO))
+		fw_command(f, ANE_FW_IO);
+	if (value & BIT(ANE_FW_DATA_CHAIN))
+		fw_command(f, ANE_FW_DATA_CHAIN);
+}
+
+static u64 fw_now(void *ctx)
+{
+	return ((struct prog_fw *)ctx)->now;
+}
+
+static void fw_relax(void *ctx, u64 waited_ns)
+{
+	struct prog_fw *f = ctx;
+
+	f->now += 10;
+	if (f->late_uuid && !--f->late_polls) {
+		fw_report(f, f->late_uuid, f->late_program, f->late_process, 3);
+		fw_report(f, f->late_uuid, f->late_program, f->late_process, 1);
+		f->late_uuid = 0;
+	}
+}
+
+static int fw_alloc(void *ctx, size_t size, u32 tag, struct ane_fw_surface *s)
+{
+	return -ENOMEM;
+}
+
+static void fw_refused(void *ctx, u64 w0, u64 w1, u64 w2, int error)
+{
+}
+
+static const struct ane_fw_transport_ops fw_ops = {
+	.load64 = fw_load,
+	.store64 = fw_store,
+	.read_barrier = fw_barrier,
+	.write_barrier = fw_barrier,
+	.read32 = fw_read32,
+	.write32 = fw_write32,
+	.now_ns = fw_now,
+	.relax = fw_relax,
+	.alloc = fw_alloc,
+	.refused = fw_refused,
+};
+
+static void fw_kvfree(void *p)
+{
+	kvfree(p);
+}
+
+/* Tests own the memory; a MobileNet kernel region exceeds kmalloc's limit. */
+static void *fw_zalloc(struct kunit *test, size_t size)
+{
+	void *p = kvzalloc(size, GFP_KERNEL);
+
+	if (p && kunit_add_action_or_reset(test, fw_kvfree, p))
+		return NULL;
+	return p;
+}
+
+static int fw_map(void *ctx, size_t size, bool write, struct ane_fw_surface *s)
+{
+	struct prog_fw *f = ctx;
+
+	*s = (struct ane_fw_surface) {
+		.cpu = fw_zalloc(f->test, size),
+		.dva = f->next_dva,
+		.size = size,
+		.handle = f->cached ? f->next_dva : 0,
+	};
+	if (!s->cpu)
+		return -ENOMEM;
+	f->next_dva += size;
+	f->maps++;
+	f->writable_maps += write;
+	return 0;
+}
+
+static void fw_log(void *ctx, const char *item, u64 a, u64 b)
+{
+	struct prog_fw *f = ctx;
+
+	if (!strcmp(item, "EXECUTE step/flags")) {
+		f->fail_step = a;
+		f->fail_flags = b;
+	} else if (!strcmp(item, "EXECUTE reports/last state")) {
+		f->fail_reports = a;
+		f->fail_state = b;
+	} else if (!strcmp(item, "EXECUTE other reports")) {
+		f->fail_other = a;
+	} else if (!strcmp(item, "PROGRAM REPLAY FAILED")) {
+		f->replay_failed++;
+	}
+}
