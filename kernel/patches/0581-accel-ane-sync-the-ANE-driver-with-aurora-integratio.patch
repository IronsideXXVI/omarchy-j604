@@ -0,0 +1,2037 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* Shared firmware backend. H17 is the first measured cold power provider. */
+#include <crypto/sha2.h>
+#include <linux/crash_dump.h>
+#include <linux/debugfs.h>
