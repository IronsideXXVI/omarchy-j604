+static unsigned int ane_test_writes(struct ane_transport_test *f)
+{
+	unsigned int i, n = 0;
+
+	for (i = 0; i < f->count; i++)
+		if (f->access[i].kind == 'w' || f->access[i].kind == 'o')
+			n++;
+	return n;
+}
