index 0000000000..fb98428f3f
--- /dev/null
+++ b/drivers/accel/ane/ane_fw_protocol_test.c
@@ -0,0 +1,373 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <kunit/test.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+#include "ane_fw_protocol.h"
+#include "ane_h16_protocol.h"
+
+static void ane_h16_id_table_test(struct kunit *test)
+{
+	static const struct ane_h16_command_info expected[] = {
+		{ 0x200, 0x1c0, 0x1c0, 1, 1, false },
+		{ 0x201, 0xc, 0xc, 1, 1, false },
+		{ 0x202, 0x258, 0x258, 1, 1, false },
+		{ 0x203, 0x10, 0x10, 1, 1, false },
+		{ 0x20c, 0xca8, 0xcd8, 0x18, 7, false },
+		{ 0x2d, 0xc, 0xc, 1, 7, false },
+		{ 0x300, 0x60, 0x60, 1, 6, true },
+	};
+	u8 *command = kunit_kzalloc(test, 0xcd8, GFP_KERNEL);
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, command);
+	for (i = 0; i < ARRAY_SIZE(expected); i++) {
+		const struct ane_h16_command_info *e = &expected[i];
+		const struct ane_h16_command_info *info = ane_h16_command_info(e->id);
+		size_t length;
+		int ret;
+
+		KUNIT_ASSERT_NOT_NULL(test, info);
+		KUNIT_EXPECT_EQ(test, info->min_size, e->min_size);
+		KUNIT_EXPECT_EQ(test, info->max_size, e->max_size);
+		KUNIT_EXPECT_EQ(test, info->size_step, e->size_step);
+		KUNIT_EXPECT_EQ(test, info->channel, e->channel);
+		KUNIT_EXPECT_EQ(test, info->from_firmware, e->from_firmware);
+		if (e->from_firmware) {
+			ret = ane_h16_command_prepare(command, e->min_size, e->id, e->channel);
+			KUNIT_EXPECT_EQ(test, ret, -EOPNOTSUPP);
+			continue;
+		}
+		for (length = e->min_size; length <= e->max_size; length += e->size_step) {
+			ret = ane_h16_command_prepare(command, length, e->id, e->channel);
+			KUNIT_EXPECT_EQ(test, ret, 0);
+		}
+		ret = ane_h16_command_prepare(command, e->min_size - 1, e->id, e->channel);
+		KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+		ret = ane_h16_command_prepare(command, e->max_size + 1, e->id, e->channel);
+		KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+		ret = ane_h16_command_prepare(command, e->min_size, e->id, e->channel ^ 1);
+		KUNIT_EXPECT_EQ(test, ret, -EINVAL);
+	}
+	KUNIT_EXPECT_PTR_EQ(test, ane_h16_command_info(0x204), NULL);
+	KUNIT_EXPECT_PTR_EQ(test, ane_h16_command_info(0x301), NULL);
+	KUNIT_EXPECT_EQ(test, ane_h16_command_prepare(command, 0xca8, 0x204, 7),
+			-EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, ane_h16_command_prepare(command, 0xca9, 0x20c, 7), -EINVAL);
+	/* The H14 CREATE_PROCESS size must never be sent to H16. */
+	KUNIT_EXPECT_EQ(test, ane_h16_command_prepare(command, 0x10, 0x202, 1), -EINVAL);
+}
+
+static void ane_h16_envelope_test(struct kunit *test)
+{
+	u8 command[0xc];
+	const u64 dva = 0x30000000000;
+
+	memset(command, 0xa5, sizeof(command));
+	put_unaligned_le32(1, command + 8);
+	KUNIT_ASSERT_EQ(test, ane_h16_command_prepare(command, sizeof(command), 0x2d, 7), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(command), 0U);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(command + 4), (u16)0x2d);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(command + 6), (u16)0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(command + 8), 1U);
+	KUNIT_EXPECT_EQ(test, ane_fw_reply_status(dva | 1, 0xc, 0, dva, 0xc,
+						  0x2d, command, true), 0);
+	/* Test the upper byte too: acknowledgment is u16, not u8. */
+	put_unaligned_le16(0x100, command + 6);
+	KUNIT_EXPECT_EQ(test, ane_fw_reply_status(dva | 1, 0xc, 0, dva, 0xc,
+						  0x2d, command, true), -EREMOTEIO);
+	put_unaligned_le32(0, command + 8);
+	KUNIT_ASSERT_EQ(test, ane_h16_command_prepare(command, sizeof(command), 0x2d, 7), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le16(command + 6), (u16)0);
+	put_unaligned_le32(2, command + 8);
+	KUNIT_EXPECT_EQ(test, ane_h16_command_prepare(command, sizeof(command), 0x2d, 7),
+			-EINVAL);
+	KUNIT_EXPECT_EQ(test, ane_h16_command_prepare(NULL, sizeof(command), 0x2d, 7),
+			-EINVAL);
+}
+
+static void ane_h16_report_test(struct kunit *test)
+{
+	u8 event[0x60] = {};
+	unsigned int n;
+
+	put_unaligned_le16(0x300, event + 4);
+	for (n = 0; n < 4; n++) {
+		put_unaligned_le32(0xfe00 | n, event);
+		KUNIT_EXPECT_EQ(test, ane_h16_event_report_status(event, sizeof(event), 6), 0);
+		/* A report can never satisfy the legacy completion predicate. */
+		KUNIT_EXPECT_EQ(test, ane_fw_finished_event(event, sizeof(event), 0, 0, 0),
+				-EPROTO);
+	}
+	KUNIT_EXPECT_EQ(test, ane_h16_event_report_status(event, sizeof(event), 7), -EPROTO);
+	KUNIT_EXPECT_EQ(test, ane_h16_event_report_status(event, 0x28, 6), -EPROTO);
+	KUNIT_EXPECT_EQ(test, ane_h16_event_report_status(event, 0xc, 6), -EPROTO);
+	KUNIT_EXPECT_EQ(test, ane_h16_event_report_status(NULL, 0x60, 6), -EPROTO);
+	put_unaligned_le32(0xfe04, event);
+	KUNIT_EXPECT_EQ(test, ane_h16_event_report_status(event, sizeof(event), 6), 0);
+	put_unaligned_le32(0xfe00, event);
+	put_unaligned_le16(0x301, event + 4);
+	KUNIT_EXPECT_EQ(test, ane_h16_event_report_status(event, sizeof(event), 6), -EPROTO);
+	put_unaligned_le16(0x300, event + 4);
+	put_unaligned_le16(0x100, event + 6);
+	KUNIT_EXPECT_EQ(test, ane_h16_event_report_status(event, sizeof(event), 6), -EPROTO);
+}
+
+#define TEST_IPC_SIZE 0x10000
+#define TEST_IPC_DVA 0x20000000000ULL
+#define TEST_TABLE_OFF 0x1000
+
+static void *ane_test_table(struct kunit *test)
+{
+	static const char * const names[] = {
+		"TERMINAL", "IO", "DEBUG", "BUF_H2T", "BUF_T2H",
+		"SHAREDMALLOC", "IO_T2H", "DATA_CHAIN_H2T",
+	};
+	void *ipc = kunit_kzalloc(test, TEST_IPC_SIZE, GFP_KERNEL);
+	unsigned int i;
+
+	if (!ipc)
+		return NULL;
+	for (i = 0; i < ANE_FW_CHANNELS; i++) {
+		u8 *d = ipc + TEST_TABLE_OFF + i * ANE_FW_DESCRIPTOR_SIZE;
+
+		strscpy((char *)d, names[i], 64);
+		put_unaligned_le32(i == 0 ? 2 : (i == 4 || i == 5 || i == 6), d + 0x40);
+		put_unaligned_le32(31 - i, d + 0x44);
+		put_unaligned_le64(i + 1, d + 0x48);
+		put_unaligned_le64(TEST_IPC_DVA + 0x2000 + i * 0x400, d + 0x50);
+	}
+	return ipc;
+}
+
+static int ane_test_channels_parse(void *ipc, struct ane_fw_channel *channels)
+{
+	return ane_fw_channels_parse(ipc + TEST_TABLE_OFF, TEST_IPC_DVA, TEST_IPC_SIZE,
+				     TEST_IPC_DVA + TEST_TABLE_OFF, channels);
+}
+
+static void ane_dynamic_channels_test(struct kunit *test)
+{
+	struct ane_fw_channel channels[ANE_FW_CHANNELS];
+	u8 *ipc = ane_test_table(test);
+	u8 *io;
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, ipc);
+	KUNIT_ASSERT_EQ(test, ane_test_channels_parse(ipc, channels), 0);
+	KUNIT_EXPECT_EQ(test, channels[1].bit, 30U);
+	KUNIT_EXPECT_EQ(test, channels[1].slots, 2U);
+	KUNIT_EXPECT_EQ(test, channels[1].offset, 0x2400ULL);
+	KUNIT_EXPECT_EQ(test, channels[1].index, 1U);
+	{
+		u8 saved[ANE_FW_DESCRIPTOR_SIZE];
+		u8 *first = ipc + TEST_TABLE_OFF + ANE_FW_DESCRIPTOR_SIZE;
+		u8 *last = ipc + TEST_TABLE_OFF + 7 * ANE_FW_DESCRIPTOR_SIZE;
+
+		memcpy(saved, first, sizeof(saved));
+		memcpy(first, last, sizeof(saved));
+		memcpy(last, saved, sizeof(saved));
+		KUNIT_ASSERT_EQ(test, ane_test_channels_parse(ipc, channels), 0);
+		KUNIT_EXPECT_EQ(test, channels[1].offset, 0x2400ULL);
+		KUNIT_EXPECT_EQ(test, channels[1].index, 7U);
+	}
+	memset(ipc + 0x2000, 0xa5, 0x2000);
+	ane_fw_channels_host_init(ipc, channels);
+	io = ipc + channels[1].offset;
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(io), 1ULL);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le64(io + 8), 0ULL);
+	KUNIT_EXPECT_EQ(test, io[24], (u8)0xa5);
+	for (i = 0; i < 24; i++)
+		KUNIT_EXPECT_EQ(test, ipc[0x2000 + i], (u8)0xa5);
+}
+
+static void ane_channel_snapshot_test(struct kunit *test)
+{
+	struct ane_fw_channel channels[ANE_FW_CHANNELS];
+	u8 *ipc = ane_test_table(test);
+	u8 *snapshot = kunit_kmalloc(test, ANE_FW_TABLE_SIZE, GFP_KERNEL);
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, ipc);
+	KUNIT_ASSERT_NOT_NULL(test, snapshot);
+	memcpy(snapshot, ipc + TEST_TABLE_OFF, ANE_FW_TABLE_SIZE);
+	put_unaligned_le64(0, ipc + TEST_TABLE_OFF + ANE_FW_DESCRIPTOR_SIZE + 0x48);
+	ret = ane_fw_channels_parse(snapshot, TEST_IPC_DVA, TEST_IPC_SIZE,
+				    TEST_IPC_DVA + TEST_TABLE_OFF, channels);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, channels[1].slots, 2U);
+	KUNIT_EXPECT_EQ(test, ane_test_channels_parse(ipc, channels), -EPROTO);
+}
+
+static void ane_channel_rejections_test(struct kunit *test)
+{
+	struct ane_fw_channel channels[ANE_FW_CHANNELS];
+	u8 *ipc = ane_test_table(test);
+	u8 *d;
+
+	KUNIT_ASSERT_NOT_NULL(test, ipc);
+	d = ipc + TEST_TABLE_OFF + ANE_FW_DESCRIPTOR_SIZE;
+	put_unaligned_le64(0, d + 0x48);
+	KUNIT_EXPECT_EQ(test, ane_test_channels_parse(ipc, channels), -EPROTO);
+	put_unaligned_le64(0x401, d + 0x48);
+	KUNIT_EXPECT_EQ(test, ane_test_channels_parse(ipc, channels), -EPROTO);
+	put_unaligned_le64(2, d + 0x48);
+	put_unaligned_le64(TEST_IPC_DVA + TEST_TABLE_OFF, d + 0x50);
+	KUNIT_EXPECT_EQ(test, ane_test_channels_parse(ipc, channels), -EPROTO);
+	put_unaligned_le64(TEST_IPC_DVA + 0x2000, d + 0x50);
+	KUNIT_EXPECT_EQ(test, ane_test_channels_parse(ipc, channels), -EPROTO);
+	put_unaligned_le64(TEST_IPC_DVA + TEST_IPC_SIZE - 64, d + 0x50);
+	KUNIT_EXPECT_EQ(test, ane_test_channels_parse(ipc, channels), -EPROTO);
+	put_unaligned_le64(TEST_IPC_DVA + 0x2400, d + 0x50);
+	put_unaligned_le32(32, d + 0x44);
+	KUNIT_EXPECT_EQ(test, ane_test_channels_parse(ipc, channels), -EPROTO);
+	put_unaligned_le32(30, d + 0x44);
+	put_unaligned_le32(1, d + 0x40);
+	KUNIT_EXPECT_EQ(test, ane_test_channels_parse(ipc, channels), -EPROTO);
+	put_unaligned_le32(0, d + 0x40);
+	strscpy((char *)d, "TERMINAL", 64);
+	KUNIT_EXPECT_EQ(test, ane_test_channels_parse(ipc, channels), -EPROTO);
+	memset(d, 0x41, 64);
+	KUNIT_EXPECT_EQ(test, ane_test_channels_parse(ipc, channels), -EPROTO);
+	KUNIT_EXPECT_FALSE(test, ane_fw_contains(16, 64, U64_MAX, 32));
+	KUNIT_EXPECT_FALSE(test, ane_fw_contains(16, 64, 16, 65));
+}
+
+static void ane_reply_status_test(struct kunit *test)
+{
+	u8 command[16] = {};
+	const u64 dva = 0x30000000000;
+
+	put_unaligned_le16(3, command + 4);
+	put_unaligned_le32(ANE_FW_TICK_RATE, command + 8);
+	KUNIT_EXPECT_EQ(test, ane_fw_reply_status(dva, 16, 16, dva, 16, 3,
+						  command, true), -EAGAIN);
+	KUNIT_EXPECT_EQ(test, ane_fw_reply_status(dva | 1, 16, 0, dva, 16, 3,
+						  command, true), 0);
+	KUNIT_EXPECT_EQ(test, ane_fw_config_status(command, sizeof(command)), 0);
+	put_unaligned_le16(1, command + 6);
+	KUNIT_EXPECT_EQ(test, ane_fw_reply_status(dva | 1, 16, 0, dva, 16, 3,
+						  command, true), -EREMOTEIO);
+	put_unaligned_le16(0xffff, command + 6);
+	KUNIT_EXPECT_EQ(test, ane_fw_reply_status(dva | 1, 16, 0, dva, 16, 3,
+						  command, true), -EREMOTEIO);
+	put_unaligned_le16(0, command + 6);
+	KUNIT_EXPECT_EQ(test, ane_fw_reply_status(dva | 1, 15, 0, dva, 16, 3,
+						  command, true), -EPROTO);
+	KUNIT_EXPECT_EQ(test, ane_fw_reply_status(dva | 1, 16, 1, dva, 16, 3,
+						  command, true), -EPROTO);
+	KUNIT_EXPECT_EQ(test, ane_fw_reply_status(dva | 1, 16, 0, dva, 16, 4,
+						  command, true), -EPROTO);
+	put_unaligned_le32(1, command);
+	KUNIT_EXPECT_EQ(test, ane_fw_reply_status(dva | 1, 16, 0, dva, 16, 3,
+						  command, true), -EPROTO);
+	KUNIT_EXPECT_EQ(test, ane_fw_reply_status(dva | 1, 16, 0, dva, 16, 3,
+						  command, false), 0);
+	put_unaligned_le32(1, command + 8);
+	KUNIT_EXPECT_EQ(test, ane_fw_config_status(command, sizeof(command)), -EPROTO);
+}
+
+static void ane_finished_event_test(struct kunit *test)
+{
+	u8 event[0x28] = {};
+
+	put_unaligned_le32(0x300, event + 4);
+	put_unaligned_le64(42, event + 8);
+	put_unaligned_le32(3, event + 0x10);
+	put_unaligned_le32(4, event + 0x14);
+	KUNIT_EXPECT_EQ(test, ane_fw_finished_event(event, sizeof(event), 42, 3, 4), 0);
+	put_unaligned_le32(1, event + 0x1c);
+	KUNIT_EXPECT_EQ(test, ane_fw_finished_event(event, sizeof(event), 42, 3, 4), 1);
+	KUNIT_EXPECT_EQ(test, ane_fw_finished_event(event, sizeof(event), 41, 3, 4), -EPROTO);
+	KUNIT_EXPECT_EQ(test, ane_fw_finished_event(event, sizeof(event), 42, 3, 5), -EPROTO);
+	KUNIT_EXPECT_EQ(test, ane_fw_finished_event(event, 0x20, 42, 3, 4), -EPROTO);
+	put_unaligned_le32(2, event + 0x1c);
+	KUNIT_EXPECT_EQ(test, ane_fw_finished_event(event, sizeof(event), 42, 3, 4), -EPROTO);
+}
+
+struct ane_test_tx {
+	u64 words[16];
+	unsigned int count;
+};
+
+static int ane_test_send(void *ctx, u64 word0, u64 word1)
+{
+	struct ane_test_tx *tx = ctx;
+
+	if (word1 || tx->count == ARRAY_SIZE(tx->words))
+		return -EOVERFLOW;
+	tx->words[tx->count++] = word0;
+	return 0;
+}
+
+static void ane_rtk_order_test(struct kunit *test)
+{
+	struct ane_fw_rtk rtk = {};
+	struct ane_test_tx tx = {};
+
+	KUNIT_ASSERT_EQ(test, ane_fw_rtk_receive(&rtk, ANE_FW_RTK_TYPE(1) |
+						 (13 << 16) | 11, 0, &tx, ane_test_send), 0);
+	KUNIT_EXPECT_EQ(test, tx.words[0], ANE_FW_RTK_TYPE(2) | (12 << 16) | 12);
+	KUNIT_ASSERT_EQ(test, ane_fw_rtk_receive(&rtk, ANE_FW_RTK_TYPE(8) |
+						 BIT(2) | BIT(8), 0, &tx, ane_test_send), 0);
+	KUNIT_EXPECT_EQ(test, tx.words[1], ANE_FW_RTK_TYPE(8) | 1);
+	KUNIT_ASSERT_EQ(test, ane_fw_rtk_receive(&rtk, ANE_FW_RTK_TYPE(8) |
+						 BIT_ULL(32) | ANE_FW_RTK_LAST | BIT(0) | BIT(5), 0,
+						 &tx, ane_test_send), 0);
+	KUNIT_EXPECT_EQ(test, rtk.phase, ANE_FW_RTK_IOP_ACK);
+	KUNIT_EXPECT_EQ(test, tx.count, 6U);
+	KUNIT_EXPECT_EQ(test, tx.words[2], ANE_FW_RTK_TYPE(8) | BIT_ULL(32) |
+		ANE_FW_RTK_LAST);
+	KUNIT_EXPECT_EQ(test, tx.words[3], ANE_FW_RTK_TYPE(5) | (2ULL << 32) | 2);
+	KUNIT_EXPECT_EQ(test, tx.words[4], ANE_FW_RTK_TYPE(5) | (8ULL << 32) | 2);
+	KUNIT_ASSERT_EQ(test, ane_fw_rtk_receive(&rtk, ANE_FW_RTK_TYPE(7) | 0x20,
+						 0, &tx, ane_test_send), 0);
+	KUNIT_EXPECT_EQ(test, tx.words[6], ANE_FW_RTK_TYPE(0xb) | 0x20);
+	KUNIT_ASSERT_EQ(test, ane_fw_rtk_receive(&rtk, ANE_FW_RTK_TYPE(0xb) | 0x20,
+						 0, &tx, ane_test_send), 0);
+	KUNIT_EXPECT_EQ(test, rtk.phase, ANE_FW_RTK_READY);
+	KUNIT_EXPECT_EQ(test, tx.words[7], ANE_FW_RTK_TYPE(5) | (32ULL << 32) | 2);
+	KUNIT_EXPECT_EQ(test, tx.words[8], ANE_FW_RTK_TYPE(5) | (37ULL << 32) | 2);
+}
+
+static void ane_rtk_rejections_test(struct kunit *test)
+{
+	struct ane_fw_rtk rtk = {};
+	struct ane_test_tx tx = {};
+	u64 hello = ANE_FW_RTK_TYPE(1) | (12 << 16) | 12;
+	int ret;
+
+	KUNIT_EXPECT_EQ(test, ane_fw_rtk_receive(&rtk, ANE_FW_RTK_TYPE(1) |
+						 (2 << 16) | 1, 0, &tx, ane_test_send), -EPROTO);
+	KUNIT_EXPECT_EQ(test, tx.count, 0U);
+	ret = ane_fw_rtk_receive(&rtk, hello, 2, &tx, ane_test_send);
+	KUNIT_EXPECT_EQ(test, ret, -EOPNOTSUPP);
+	KUNIT_EXPECT_EQ(test, tx.count, 0U);
+	KUNIT_EXPECT_EQ(test, ane_fw_rtk_receive(&rtk, ANE_FW_RTK_TYPE(7) | 0x20,
+						 0, &tx, ane_test_send), -EPROTO);
+	KUNIT_EXPECT_EQ(test, ane_fw_rtk_receive(&rtk, ANE_FW_RTK_TYPE(0xff),
+						 0, &tx, ane_test_send), -EOPNOTSUPP);
+}
+
+static struct kunit_case ane_protocol_cases[] = {
+	KUNIT_CASE(ane_h16_id_table_test),
+	KUNIT_CASE(ane_h16_envelope_test),
+	KUNIT_CASE(ane_h16_report_test),
+	KUNIT_CASE(ane_dynamic_channels_test),
+	KUNIT_CASE(ane_channel_snapshot_test),
+	KUNIT_CASE(ane_channel_rejections_test),
+	KUNIT_CASE(ane_reply_status_test),
+	KUNIT_CASE(ane_finished_event_test),
+	KUNIT_CASE(ane_rtk_order_test),
+	KUNIT_CASE(ane_rtk_rejections_test),
+	{}
+};
+
+static struct kunit_suite ane_protocol_suite = {
+	.name = "ane-fw-protocol",
+	.test_cases = ane_protocol_cases,
+};
+
+kunit_test_suite(ane_protocol_suite);
+MODULE_DESCRIPTION("KUnit tests for ANE 27.x channel and RTKit contracts");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/accel/ane/ane_fw_sleep.h b/drivers/accel/ane/ane_fw_sleep.h
new file mode 100644
index 0000000000..1d93692e59
--- /dev/null
+++ b/drivers/accel/ane/ane_fw_sleep.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_FW_SLEEP_H__
+#define __ANE_FW_SLEEP_H__
+
+#include <linux/notifier.h>
+#include <linux/suspend.h>
+
+#define ANE_FW_SLEEP_REFUSED "ANE: system sleep not supported yet, suspend refused\n"
+
+/*
+ * System sleep while the H16/H17 firmware runs. Hibernation and restore are
+ * always refused while the firmware is retained: the image would carry a
+ * firmware state the restored kernel cannot match. Suspend passes only for a
+ * backend that cycles the engine across it: the H17 backend (ane_fw_cold.c)
+ * and the H16 backend (ane_h16_backend.c) power it off and, after resume,
+ * boot the firmware again from the preload and replay every open program
+ * behind its handle. A platform without a sleep path refuses suspend up
+ * front, before any device suspends. Without retained firmware nothing is
+ * refused.
+ */
+static inline bool ane_fw_sleep_refused_cycle(unsigned long event, bool retained, bool cycles)
+{
+	if (!retained)
+		return false;
+	if (event == PM_HIBERNATION_PREPARE || event == PM_RESTORE_PREPARE)
+		return true;
+	return event == PM_SUSPEND_PREPARE && !cycles;
+}
+
+static inline bool ane_fw_sleep_refused(unsigned long event, bool retained)
+{
+	return ane_fw_sleep_refused_cycle(event, retained, false);
+}
+
+static inline int ane_fw_sleep_event(unsigned long event, bool retained)
+{
+	return ane_fw_sleep_refused(event, retained) ? NOTIFY_BAD : NOTIFY_DONE;
+}
+
+/*
+ * The device suspend callback's answer: a backstop for firmware started
+ * after the notifier ran, or a sleep path that skipped the notifiers.
+ */
+static inline int ane_fw_sleep_backstop(bool retained)
+{
+	return retained ? -EBUSY : 0;
+}
+
+#endif /* __ANE_FW_SLEEP_H__ */
diff --git a/drivers/accel/ane/ane_fw_transport.h b/drivers/accel/ane/ane_fw_transport.h
new file mode 100644
index 0000000000..7ae897bc90
--- /dev/null
+++ b/drivers/accel/ane/ane_fw_transport.h
@@ -0,0 +1,912 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_FW_TRANSPORT_H__
+#define __ANE_FW_TRANSPORT_H__
+
+#include <linux/delay.h>
+
+#include "ane_fw_platform.h"
+#include "ane_fw_protocol.h"
+#include "ane_h16_execute.h"
+
+#define ANE_FW_TERMINAL 0
+#define ANE_FW_IO 1
+#define ANE_FW_SHAREDMALLOC 5
+#define ANE_FW_IO_T2H 6
+#define ANE_FW_DATA_CHAIN 7
+#define ANE_FW_SHARED_MAX 64
+#define ANE_FW_SHARED_LIMIT SZ_1M
+#define ANE_FW_SHARED_TOTAL (12 * SZ_1M)
+#define ANE_FW_SHARED_EXPP 0x45585050U
+/* The firmware's text log, 0x80-byte records. */
+#define ANE_FW_SHARED_LOG 0x004c4f47U
+
+struct ane_fw_surface {
+	void *cpu;
+	u64 dva;
+	size_t size;
+	/*
+	 * Backend handle of a CPU-cacheable surface the device reads and writes
+	 * without snooping, kept coherent through ane_h16_session_ops.sync; 0
+	 * for coherent (uncached) memory.
+	 */
+	u64 handle;
+};
+
+/*
+ * Pacing between two polls of one wait. A command reply arrives within tens
+ * of microseconds, so the first ANE_FW_POLL_SPIN_NS of a wait polls in 2 us
+ * busy steps and sees it without a sleep and its wakeup latency. Up to 5 ms
+ * (a whole inference) each step sleeps 20-50 us; long waits (firmware
+ * startup, a stalled request) back off to 250 us and, after 50 ms, to the
+ * 1 ms cadence, so they cost no more CPU than a fixed 1 ms poll did.
+ * Returns the sleep in microseconds, or 0 for a busy step.
+ */
+#define ANE_FW_POLL_SPIN_NS (30ULL * 1000)
+#define ANE_FW_POLL_SPIN_STEP_US 2
+#define ANE_FW_POLL_FINE_NS (5ULL * 1000 * 1000)
+#define ANE_FW_POLL_MEDIUM_NS (50ULL * 1000 * 1000)
+
+static inline unsigned int ane_fw_poll_sleep_us(u64 waited_ns, unsigned int *max_us)
+{
+	unsigned int us = waited_ns < ANE_FW_POLL_SPIN_NS ? 0 :
+			  waited_ns < ANE_FW_POLL_FINE_NS ? 20 :
+			  waited_ns < ANE_FW_POLL_MEDIUM_NS ? 250 : 1000;
+
+	*max_us = !us ? 0 : us == 20 ? 50 : us + 50;
+	return us;
+}
+
+/* One pacing step of a wait that began waited_ns ago (process context). */
+static inline void ane_fw_poll_pause(u64 waited_ns)
+{
+	unsigned int min_us, max_us;
+
+	min_us = ane_fw_poll_sleep_us(waited_ns, &max_us);
+	if (min_us)
+		usleep_range(min_us, max_us);
+	else
+		udelay(ANE_FW_POLL_SPIN_STEP_US);
+}
+
+/*
+ * Accessors operate on coherent owned memory and engine-relative registers.
+ * Barriers must supply DMA read/write ordering, not just compiler ordering.
+ * alloc returns a zeroed, pinned, private-domain mapping of exactly size bytes.
+ * It and its caller retain every mapping, including a rejected result, until
+ * reset. refused must log the tuple and error without exposing private data.
+ */
+struct ane_fw_transport_ops {
+	u64 (*load64)(void *ctx, const void *p);
+	void (*store64)(void *ctx, void *p, u64 value);
+	void (*read_barrier)(void *ctx);
+	void (*write_barrier)(void *ctx);
+	u32 (*read32)(void *ctx, u32 reg);
+	/* Complete/order an irq_ack write before subsequent coherent ring reads. */
+	void (*write32)(void *ctx, u32 reg, u32 value);
+	u64 (*now_ns)(void *ctx);
+	/* Wait before the next poll of a wait that began waited_ns ago. */
+	void (*relax)(void *ctx, u64 waited_ns);
+	int (*alloc)(void *ctx, size_t size, u32 tag, struct ane_fw_surface *surface);
+	void (*refused)(void *ctx, u64 word0, u64 word1, u64 word2, int error);
+	/* Optional: a shared allocation was freed ("FREE") or served again ("reuse"). */
+	void (*shared_note)(void *ctx, const char *event, u64 dva, u64 size, u32 tag);
+};
+
+struct ane_fw_transaction {
+	u64 dva;
+	u64 deadline_ns;
+	size_t size;
+	u16 id;
+	bool active;
+};
+
+/* Caller serializes all entry points. No surface is released by this object. */
+struct ane_fw_transport {
+	const struct ane_fw_transport_ops *ops;
+	const struct ane_fw_platform *soc;
+	void *ctx;
+	struct ane_fw_surface ipc;
+	struct ane_fw_surface pool;
+	struct ane_fw_surface shared[ANE_FW_SHARED_MAX];
+	bool shared_retired[ANE_FW_SHARED_MAX];
+	u32 shared_tags[ANE_FW_SHARED_MAX];
+	/* FREE reply form: 1 (H16 26A428) or DVA|1 (H17 25G83); else refused. */
+	bool native_free;
+	bool allow_free;
+	u32 free_count;
+	/* H17: program and process of the last published EXECUTE. */
+	bool bar_known;
+	u32 bar_program, bar_process;
+	struct ane_fw_channel channels[ANE_FW_CHANNELS];
+	struct ane_fw_transaction pending[ANE_FW_CHANNELS];
+	u32 head[ANE_FW_CHANNELS];
+	/* SHAREDMALLOC entries captured after acknowledging their notification. */
+	u32 shared_ready;
+	/* Polls that saw a request body before its notification (held, not served). */
+	u32 shared_early;
+	u8 table[ANE_FW_TABLE_SIZE];
+	size_t table_offset;
+	size_t pool_used;
+	size_t shared_bytes;
+	u32 shared_count;
+	u64 terminal_messages;
+	u64 terminal_bytes;
+	int error;
+	/* ane_fw_transport.h line that raised error, for diagnosis. */
+	unsigned int error_line;
+	/*
+	 * The second host-to-firmware command ring, at table position 2: the
+	 * firmware's mode commands (EXCLAVE_MODE_STOP) go there, outside the
+	 * IO queue they must not wait behind. ANE_FW_CHANNELS when absent.
+	 */
+	u32 control_ch;
+	/* relax() calls made by every wait so far; callers diff it. */
+	u64 polls;
+	bool armed;
+};
+
+/* The live shared allocation the firmware asked for under tag, or NULL. */
+static inline const struct ane_fw_surface *
+ane_fw_transport_shared_tagged(const struct ane_fw_transport *t, u32 tag)
+{
+	u32 i;
+
+	for (i = 0; i < t->shared_count; i++)
+		if (t->shared_tags[i] == tag && !t->shared_retired[i])
+			return &t->shared[i];
+	return NULL;
+}
+
+static inline bool ane_fw_surface_valid(const struct ane_fw_surface *s)
+{
+	return s->cpu && s->size && s->size <= U64_MAX - s->dva;
+}
+
+static inline bool
+ane_fw_surfaces_overlap(const struct ane_fw_surface *a, const struct ane_fw_surface *b)
+{
+	return a->dva < b->dva + b->size && b->dva < a->dva + a->size;
+}
+
+/* The first error is kept, with the line of this file that raised it. */
+static inline int __ane_fw_transport_fail(struct ane_fw_transport *t, int error,
+					  unsigned int line)
+{
+	if (!t->error) {
+		t->error = error;
+		t->error_line = line;
+	}
+	return t->error;
+}
+
+#define ane_fw_transport_fail(t, error) __ane_fw_transport_fail(t, error, __LINE__)
+
+/*
+ * The command ring at table position 2 (macOS channel selector 2), when it
+ * is a host-to-firmware ring like IO and not one of the rings Linux already
+ * drives. ANE_FW_CHANNELS when the table has none.
+ */
+static inline u32 ane_fw_control_channel(const struct ane_fw_channel channels[ANE_FW_CHANNELS])
+{
+	u32 ch;
+
+	for (ch = 0; ch < ANE_FW_CHANNELS; ch++)
+		if (channels[ch].index == 2)
+			break;
+	if (ch == ANE_FW_CHANNELS || ch == ANE_FW_IO || ch == ANE_FW_DATA_CHAIN ||
+	    channels[ch].type != channels[ANE_FW_IO].type)
+		return ANE_FW_CHANNELS;
+	return ch;
+}
+
+/* pool_reserved protects the init record and any other boot-owned pool bytes. */
+static inline int
+ane_fw_transport_init(struct ane_fw_transport *t, const struct ane_fw_platform *soc,
+		      const struct ane_fw_transport_ops *ops, void *ctx,
+		      struct ane_fw_surface ipc, struct ane_fw_surface pool,
+		      size_t pool_reserved, u64 table_dva, size_t table_size)
+{
+	int ret;
+
+	if (!t || !soc || !ops || !ops->load64 || !ops->store64 ||
+	    !ops->read_barrier || !ops->write_barrier || !ops->read32 ||
+	    !ops->write32 || !ops->now_ns || !ops->relax || !ops->alloc ||
+	    !ops->refused || !ane_fw_surface_valid(&ipc) ||
+	    !ane_fw_surface_valid(&pool) || ane_fw_surfaces_overlap(&ipc, &pool) ||
+	    !IS_ALIGNED(pool.dva, ANE_FW_SLOT_SIZE) || pool_reserved > pool.size ||
+	    table_size != ANE_FW_TABLE_SIZE ||
+	    !ane_fw_contains(ipc.dva, ipc.size, table_dva, table_size))
+		return -EINVAL;
+	memset(t, 0, sizeof(*t));
+	t->ops = ops;
+	t->soc = soc;
+	t->ctx = ctx;
+	t->ipc = ipc;
+	t->pool = pool;
+	t->pool_used = pool_reserved;
+	t->table_offset = table_dva - ipc.dva;
+	ops->read_barrier(ctx);
+	memcpy(t->table, (u8 *)ipc.cpu + t->table_offset, sizeof(t->table));
+	ret = ane_fw_channels_parse(t->table, ipc.dva, ipc.size, table_dva, t->channels);
+	if (ret)
+		return ane_fw_transport_fail(t, ret);
+	t->control_ch = ane_fw_control_channel(t->channels);
+	return 0;
+}
+
+/*
+ * After the firmware was booted again (ane_fw_transport_init() on the same
+ * IPC and pool), give the new transport the shared allocations of the old
+ * one, all retired: the new firmware owns none of them, and its SHAREDMALLOC
+ * requests of the same tag and size are served from them
+ * (ane_fw_shared_reusable()) instead of mapping new memory every cycle.
+ */
+static inline void ane_fw_transport_carry_shared(struct ane_fw_transport *t,
+						 const struct ane_fw_transport *old)
+{
+	unsigned int i;
+
+	t->shared_count = old->shared_count;
+	t->shared_bytes = old->shared_bytes;
+	for (i = 0; i < old->shared_count; i++) {
+		t->shared[i] = old->shared[i];
+		t->shared_tags[i] = old->shared_tags[i];
+		t->shared_retired[i] = true;
+	}
+}
+
+static inline int ane_fw_transport_check(struct ane_fw_transport *t)
+{
+	if (t->error)
+		return t->error;
+	t->ops->read_barrier(t->ctx);
+	if (memcmp(t->table, (u8 *)t->ipc.cpu + t->table_offset, sizeof(t->table)))
+		return ane_fw_transport_fail(t, -EPROTO);
+	return 0;
+}
+
+static inline void *ane_fw_transport_slot(struct ane_fw_transport *t, unsigned int ch)
+{
+	return (u8 *)t->ipc.cpu + t->channels[ch].offset +
+	       t->head[ch] * ANE_FW_SLOT_SIZE;
+}
+
+static inline void ane_fw_transport_advance(struct ane_fw_transport *t, unsigned int ch)
+{
+	t->head[ch] = (t->head[ch] + 1) % t->channels[ch].slots;
+	if (ch == ANE_FW_SHAREDMALLOC)
+		t->shared_ready--;
+}
+
+static inline void ane_fw_transport_doorbell(struct ane_fw_transport *t, unsigned int ch)
+{
+	t->ops->write32(t->ctx, t->soc->doorbell, BIT(t->channels[ch].bit));
+}
+
+static inline int ane_fw_transport_arm(struct ane_fw_transport *t)
+{
+	unsigned int ch, i;
+	int ret = ane_fw_transport_check(t);
+
+	if (ret)
+		return ret;
+	if (t->armed)
+		return -EBUSY;
+	for (ch = 0; ch < ANE_FW_CHANNELS; ch++) {
+		const struct ane_fw_channel *c = &t->channels[ch];
+
+		if (c->type)
+			continue;
+		for (i = 0; i < c->slots; i++) {
+			u8 *p = (u8 *)t->ipc.cpu + c->offset + i * ANE_FW_SLOT_SIZE;
+
+			t->ops->store64(t->ctx, p + 8, 0);
+			t->ops->store64(t->ctx, p + 16, 0);
+			t->ops->store64(t->ctx, p, 1);
+		}
+	}
+	t->ops->write_barrier(t->ctx);
+	t->armed = true;
+	return 0;
+}
+
+/*
+ * The H17 firmware's direct submission path reuses the engine's current BAR
+ * context. When that context came from a different program, a job (of a new
+ * or previously loaded program, even after the earlier one was destroyed) can
+ * write through the earlier program's output binding. Bit 0 of the request
+ * flags word queues the job for the full execution loop instead, which
+ * installs a fresh BAR context. Queue the first EXECUTE after any change of program, process or
+ * program lifetime; later jobs of the same process keep the direct path. This
+ * lifts the one-program-per-firmware-session limit. Applies to the pool copy,
+ * so every published EXECUTE follows the rule. H16 shares the firmware
+ * architecture but has not executed under Linux yet; it is left unchanged.
+ */
+static inline void
+ane_fw_transport_bar_context(struct ane_fw_transport *t, u8 *copy, size_t size)
+{
+	u16 id = get_unaligned_le16(copy + 4);
+	u32 program, process;
+
+	if (id != 0x20c) {
+		/* LOAD, UNLOAD, CREATE and TERMINATE may reuse IDs. */
+		if (id >= 0x200 && id <= 0x203)
+			t->bar_known = false;
+		return;
+	}
+	if (size < ANE_H16_EXECUTE_FLAGS + 4) {
+		t->bar_known = false;
+		return;
+	}
+	program = get_unaligned_le32(copy + 8);
+	process = get_unaligned_le32(copy + 0xc);
+	if (!t->bar_known || t->bar_program != program || t->bar_process != process)
+		put_unaligned_le32(get_unaligned_le32(copy + ANE_H16_EXECUTE_FLAGS) |
+				   ANE_H16_EXECUTE_FLAG_QUEUED, copy + ANE_H16_EXECUTE_FLAGS);
+	t->bar_known = true;
+	t->bar_program = program;
+	t->bar_process = process;
+}
+
+/*
+ * Whether one firmware session may run several programs: the transport
+ * queues the first EXECUTE after every program change (H17, above). H16
+ * shares the firmware design, but the rule is unconfirmed there.
+ */
+static inline bool ane_fw_transport_switch_safe(const struct ane_fw_transport *t)
+{
+	return t->soc->chip_family == 17;
+}
+
+/* Commands are copied into a monotonic pool arena, never external DMA memory. */
+static inline int
+__ane_fw_transport_publish(struct ane_fw_transport *t, unsigned int ch,
+			   const void *command, size_t size, u64 deadline_ns)
+{
+	struct ane_fw_transaction *tx;
+	size_t offset;
+	u8 *p;
+	u64 header;
+	int ret = ane_fw_transport_check(t);
+
+	if (ret)
+		return ret;
+	if (!t->armed || !command || size < 8 || get_unaligned_le32(command) ||
+	    get_unaligned_le16((const u8 *)command + 6))
+		return -EINVAL;
+	tx = &t->pending[ch];
+	if (tx->active)
+		return -EBUSY;
+	if (t->ops->now_ns(t->ctx) >= deadline_ns)
+		return ane_fw_transport_fail(t, -ETIMEDOUT);
+	p = ane_fw_transport_slot(t, ch);
+	header = t->ops->load64(t->ctx, p);
+	if (header & 2)
+		return ane_fw_transport_fail(t, -EPROTO);
+	if (!(header & 1))
+		return -EBUSY;
+	if (t->pool_used > SIZE_MAX - (ANE_FW_SLOT_SIZE - 1))
+		return -ENOSPC;
+	offset = ALIGN(t->pool_used, ANE_FW_SLOT_SIZE);
+	if (offset > t->pool.size || size > t->pool.size - offset)
+		return -ENOSPC;
+	memcpy((u8 *)t->pool.cpu + offset, command, size);
+	*tx = (struct ane_fw_transaction) {
+		.dva = t->pool.dva + offset,
+		.deadline_ns = deadline_ns,
+		.size = size,
+		.id = get_unaligned_le16((const u8 *)command + 4),
+		.active = true,
+	};
+	t->pool_used = offset + size;
+	if (ane_fw_transport_switch_safe(t))
+		ane_fw_transport_bar_context(t, (u8 *)t->pool.cpu + offset, size);
+	t->ops->store64(t->ctx, p + 8, size);
+	t->ops->store64(t->ctx, p + 16, size);
+	t->ops->write_barrier(t->ctx);
+	t->ops->store64(t->ctx, p, tx->dva);
+	t->ops->write_barrier(t->ctx);
+	ane_fw_transport_doorbell(t, ch);
+	return 0;
+}
+
+/* IO and DATA_CHAIN; mode and ownership commands are refused. */
+static inline int
+ane_fw_transport_publish(struct ane_fw_transport *t, unsigned int ch,
+			 const void *command, size_t size, u64 deadline_ns)
+{
+	if (ch != ANE_FW_IO && ch != ANE_FW_DATA_CHAIN)
+		return -EINVAL;
+	if (command && size >= 8 &&
+	    ane_fw_command_denied(get_unaligned_le16((const u8 *)command + 4)))
+		return -EPERM;
+	return __ane_fw_transport_publish(t, ch, command, size, deadline_ns);
+}
+
+/*
+ * The kernel's SET_SNE_PMU_BASE2 on the control ring (16 bytes, the u64 PMU
+ * aperture base). Nothing else from outside the kernel reaches that ring.
+ */
+static inline int
+ane_fw_transport_publish_pmu_base(struct ane_fw_transport *t, u64 base, u64 deadline_ns)
+{
+	u8 command[ANE_FW_PMU_BASE_SIZE] = {};
+
+	if (t->control_ch >= ANE_FW_CHANNELS)
+		return -ENODEV;
+	put_unaligned_le16(ANE_FW_CMD_SET_PMU_BASE, command + 4);
+	put_unaligned_le64(base, command + 8);
+	return __ane_fw_transport_publish(t, t->control_ch, command, sizeof(command),
+					  deadline_ns);
+}
+
+/*
+ * The kernel's own system-sleep step on the control ring: only the 24-byte
+ * EXCLAVE_MODE_STOP with a zero body. Every other mode command stays denied.
+ */
+static inline int
+ane_fw_transport_publish_mode_stop(struct ane_fw_transport *t, u64 deadline_ns)
+{
+	u8 command[ANE_FW_MODE_STOP_SIZE] = {};
+
+	if (t->control_ch >= ANE_FW_CHANNELS)
+		return -ENODEV;
+	put_unaligned_le16(ANE_FW_CMD_EXCLAVE_MODE_STOP, command + 4);
+	return __ane_fw_transport_publish(t, t->control_ch, command, sizeof(command),
+					  deadline_ns);
+}
+
+/* Command arena position, for ane_fw_transport_release(). */
+static inline size_t ane_fw_transport_mark(const struct ane_fw_transport *t)
+{
+	return t->pool_used;
+}
+
+/*
+ * Give back the arena used by every command published since @mark. The caller
+ * guarantees that the firmware is done with all of them, not only that they
+ * were acknowledged: an EXECUTE is done once its completion report arrived.
+ * Refused while any channel still has a command in flight.
+ */
+static inline int ane_fw_transport_release(struct ane_fw_transport *t, size_t mark)
+{
+	unsigned int ch;
+
+	if (t->error || mark > t->pool_used || mark > t->pool.size)
+		return -EINVAL;
+	for (ch = 0; ch < ANE_FW_CHANNELS; ch++)
+		if (t->pending[ch].active)
+			return -EBUSY;
+	t->pool_used = mark;
+	return 0;
+}
+
+/* On success/refusal the reply remains in the pool for the caller to inspect. */
+static inline int ane_fw_transport_poll(struct ane_fw_transport *t, unsigned int ch)
+{
+	struct ane_fw_transaction *tx;
+	u64 header, length, result;
+	u8 *p;
+	int ret = ane_fw_transport_check(t);
+
+	if (ret)
+		return ret;
+	if (ch != ANE_FW_IO && ch != ANE_FW_DATA_CHAIN &&
+	    (ch != t->control_ch || ch >= ANE_FW_CHANNELS))
+		return -EINVAL;
+	tx = &t->pending[ch];
+	if (!tx->active)
+		return -EINVAL;
+	if (t->ops->now_ns(t->ctx) >= tx->deadline_ns)
+		return ane_fw_transport_fail(t, -ETIMEDOUT);
+	p = ane_fw_transport_slot(t, ch);
+	header = t->ops->load64(t->ctx, p);
+	if (header & 2)
+		return ane_fw_transport_fail(t, -EPROTO);
+	if (!(header & 1)) {
+		if (header != tx->dva)
+			return ane_fw_transport_fail(t, -EPROTO);
+		return -EAGAIN;
+	}
+	t->ops->read_barrier(t->ctx);
+	length = t->ops->load64(t->ctx, p + 8);
+	result = t->ops->load64(t->ctx, p + 16);
+	/*
+	 * The control ring (DEBUG) completes with DVA|1 and the length, but
+	 * leaves the result word as published, the command size (H17 C6: 0x31
+	 * completed as 0x...581 0x18 0x18). The IO rings write zero there.
+	 */
+	if (ch == t->control_ch && result == tx->size)
+		result = 0;
+	ret = ane_fw_reply_status(header, length, result, tx->dva, tx->size,
+				  tx->id, (u8 *)t->pool.cpu + (tx->dva - t->pool.dva), true);
+	if (ret)
+		return ane_fw_transport_fail(t, ret);
+	tx->active = false;
+	ane_fw_transport_advance(t, ch);
+	return 0;
+}
+
+static inline bool ane_fw_transport_present(u64 word0, u64 word1)
+{
+	return !(word0 & 1) && (word0 || word1);
+}
+
+static inline const void *
+ane_fw_transport_report(struct ane_fw_transport *t, u64 dva, u64 size)
+{
+	const struct ane_fw_surface *s;
+	unsigned int i;
+
+	for (i = 0; i < t->shared_count + 2; i++) {
+		if (i >= 2 && t->shared_retired[i - 2])
+			continue;
+		s = i == 0 ? &t->ipc : i == 1 ? &t->pool : &t->shared[i - 2];
+		if (ane_fw_contains(s->dva, s->size, dva, size))
+			return (u8 *)s->cpu + (dva - s->dva);
+	}
+	return NULL;
+}
+
+/* Copy before acknowledging. UUID dispatch is deliberately above the transport. */
+static inline int
+ane_fw_transport_consume(struct ane_fw_transport *t, void *report, size_t capacity,
+			 size_t *size)
+{
+	const void *src;
+	u64 word0, word1, word2;
+	u8 *p;
+	int ret = ane_fw_transport_check(t);
+
+	if (ret)
+		return ret;
+	if (!t->armed || !report || !size)
+		return -EINVAL;
+	p = ane_fw_transport_slot(t, ANE_FW_IO_T2H);
+	word0 = t->ops->load64(t->ctx, p);
+	t->ops->read_barrier(t->ctx);
+	word1 = t->ops->load64(t->ctx, p + 8);
+	if (!ane_fw_transport_present(word0, word1))
+		return -EAGAIN;
+	t->ops->read_barrier(t->ctx);
+	word2 = t->ops->load64(t->ctx, p + 16);
+	if ((word0 & 3) || word1 < 8 || word2)
+		return ane_fw_transport_fail(t, -EPROTO);
+	src = ane_fw_transport_report(t, word0, word1);
+	if (!src)
+		return ane_fw_transport_fail(t, -EPROTO);
+	if (word1 > capacity)
+		return -ENOSPC;
+	memcpy(report, src, word1);
+	*size = word1;
+	/* The copy must finish before firmware is allowed to recycle the report. */
+	t->ops->write_barrier(t->ctx);
+	t->ops->store64(t->ctx, p, word0 | 1);
+	t->ops->write_barrier(t->ctx);
+	ane_fw_transport_doorbell(t, ANE_FW_IO_T2H);
+	ane_fw_transport_advance(t, ANE_FW_IO_T2H);
+	return 0;
+}
+
+/* Conservative default allocation policy. Native FREE requires build opt-in. */
+static inline int ane_fw_shared_size(u64 word0, u64 bytes, u64 tag, size_t *size)
+{
+	if (word0 || !bytes)
+		return -EOPNOTSUPP;
+	if (tag > U32_MAX)
+		return -E2BIG;
+	if (bytes > ANE_FW_SHARED_LIMIT &&
+	    (bytes != SZ_2M || tag != ANE_FW_SHARED_EXPP))
+		return -E2BIG;
+	*size = ALIGN(bytes, SZ_16K);
+	return 0;
+}
+
+static inline void ane_fw_shared_note(struct ane_fw_transport *t, const char *event,
+				      unsigned int i)
+{
+	if (t->ops->shared_note)
+		t->ops->shared_note(t->ctx, event, t->shared[i].dva, t->shared[i].size,
+				    t->shared_tags[i]);
+}
+
+/*
+ * SHAREDMALLOC FREE of a live allocation. Backing storage, its mapping and
+ * its quota stay until reset; FREE retires the surface, so no later report
+ * resolves into it, and makes it available to a later request of the same
+ * tag and size (ane_fw_shared_reusable()). Reply before revoking authority.
+ * H16 26A428 (r5 section 6) takes the reply 1. H17 25G83 takes the observed
+ * DVA|1, and its request carries zero length and handle.
+ */
+static inline int
+ane_fw_transport_free(struct ane_fw_transport *t, void *slot, u64 dva, u64 bytes, u64 tag)
+{
+	unsigned int i;
+
+	if (!t->native_free && !t->allow_free)
+		return -EOPNOTSUPP;
+	if (!t->native_free && (bytes || tag || !IS_ALIGNED(dva, SZ_16K)))
+		return -EPROTO;
+	for (i = 0; i < t->shared_count; i++)
+		if (!t->shared_retired[i] && dva == t->shared[i].dva)
+			break;
+	if (i == t->shared_count)
+		return -ENOENT;
+	t->ops->store64(t->ctx, (u8 *)slot + 8, 0);
+	t->ops->store64(t->ctx, (u8 *)slot + 16, 0);
+	t->ops->write_barrier(t->ctx);
+	t->ops->store64(t->ctx, slot, t->native_free ? 1 : dva | 1);
+	t->ops->write_barrier(t->ctx);
+	ane_fw_transport_doorbell(t, ANE_FW_SHAREDMALLOC);
+	t->shared_retired[i] = true;
+	t->free_count++;
+	ane_fw_transport_advance(t, ANE_FW_SHAREDMALLOC);
+	ane_fw_shared_note(t, "FREE", i);
+	return 0;
+}
+
+/*
+ * A retired allocation that can serve a new request of this tag and size, or
+ * shared_count. Every program LOAD asks for a 2 MiB EXPP process pool and the
+ * firmware frees it after UNLOAD (often only during a later program), but the
+ * backing stays mapped until reset: without reuse the 12 MiB quota ran out at
+ * the sixth program of a boot. Only memory the firmware itself gave back by
+ * FREE is served again, and only for the same tag and size.
+ */
+static inline unsigned int
+ane_fw_shared_reusable(const struct ane_fw_transport *t, size_t size, u64 tag)
+{
+	unsigned int i;
+
+	for (i = 0; i < t->shared_count; i++)
+		if (t->shared_retired[i] && t->shared[i].size == size &&
+		    t->shared_tags[i] == tag)
+			return i;
+	return t->shared_count;
+}
+
+static inline int ane_fw_transport_irq(struct ane_fw_transport *t, u32 *pending);
+
+static inline int ane_fw_transport_shared(struct ane_fw_transport *t)
+{
+	struct ane_fw_surface s = {};
+	u64 word0, word1, word2;
+	size_t size;
+	unsigned int i;
+	u32 pending;
+	u8 *p;
+	int ret = ane_fw_transport_check(t);
+
+	if (ret)
+		return ret;
+	if (!t->armed)
+		return -EINVAL;
+	if (!t->shared_ready) {
+		ret = ane_fw_transport_irq(t, &pending);
+		if (ret)
+			return ret;
+		if (!t->shared_ready) {
+			p = ane_fw_transport_slot(t, ANE_FW_SHAREDMALLOC);
+			t->ops->read_barrier(t->ctx);
+			word0 = t->ops->load64(t->ctx, p);
+			if (!(word0 & 1) && (word0 || t->ops->load64(t->ctx, p + 8) ||
+					     t->ops->load64(t->ctx, p + 16)))
+				t->shared_early++;
+			return -EAGAIN;
+		}
+	}
+	p = ane_fw_transport_slot(t, ANE_FW_SHAREDMALLOC);
+	word0 = t->ops->load64(t->ctx, p);
+	t->ops->read_barrier(t->ctx);
+	word1 = t->ops->load64(t->ctx, p + 8);
+	if (word0 & 1)
+		return -EAGAIN;
+	t->ops->read_barrier(t->ctx);
+	word2 = t->ops->load64(t->ctx, p + 16);
+	if (!word0 && !word1 && !word2)
+		return -EAGAIN;
+	if (word0) {
+		ret = ane_fw_transport_free(t, p, word0, word1, word2);
+		if (ret)
+			goto refused;
+		return 0;
+	}
+	ret = ane_fw_shared_size(word0, word1, word2, &size);
+	if (ret)
+		goto refused;
+	i = ane_fw_shared_reusable(t, size, word2);
+	if (i < t->shared_count) {
+		/* Same DVA, same handle as when first served; zeroed like new memory. */
+		memset(t->shared[i].cpu, 0, size);
+		t->shared_retired[i] = false;
+		t->ops->store64(t->ctx, p + 8, 0);
+		t->ops->store64(t->ctx, p + 16, i + 1);
+		t->ops->write_barrier(t->ctx);
+		t->ops->store64(t->ctx, p, t->shared[i].dva | 1);
+		t->ops->write_barrier(t->ctx);
+		ane_fw_transport_doorbell(t, ANE_FW_SHAREDMALLOC);
+		ane_fw_transport_advance(t, ANE_FW_SHAREDMALLOC);
+		ane_fw_shared_note(t, "reuse", i);
+		return 0;
+	}
+	if (t->shared_count == ANE_FW_SHARED_MAX || size > ANE_FW_SHARED_TOTAL -
+	    t->shared_bytes) {
+		ret = -ENOSPC;
+		goto refused;
+	}
+	ret = t->ops->alloc(t->ctx, size, word2, &s);
+	if (ret)
+		goto refused;
+	if (!ane_fw_surface_valid(&s) || !IS_ALIGNED(s.dva, SZ_16K) ||
+	    s.size != size || ane_fw_surfaces_overlap(&s, &t->ipc) ||
+	    ane_fw_surfaces_overlap(&s, &t->pool)) {
+		ret = -EPROTO;
+		goto refused;
+	}
+	for (i = 0; i < t->shared_count; i++) {
+		if (ane_fw_surfaces_overlap(&s, &t->shared[i])) {
+			ret = -EPROTO;
+			goto refused;
+		}
+	}
+	t->shared_tags[t->shared_count] = word2;
+	t->shared[t->shared_count++] = s;
+	t->shared_bytes += size;
+	t->ops->store64(t->ctx, p + 8, 0);
+	t->ops->store64(t->ctx, p + 16, t->shared_count);
+	t->ops->write_barrier(t->ctx);
+	t->ops->store64(t->ctx, p, s.dva | 1);
+	t->ops->write_barrier(t->ctx);
+	ane_fw_transport_doorbell(t, ANE_FW_SHAREDMALLOC);
+	ane_fw_transport_advance(t, ANE_FW_SHAREDMALLOC);
+	return 0;
+refused:
+	t->ops->refused(t->ctx, word0, word1, word2, ret);
+	return ane_fw_transport_fail(t, ret);
+}
+
+/* Read once, reject unknown channels, acknowledge exactly that snapshot. */
+static inline int ane_fw_transport_irq(struct ane_fw_transport *t, u32 *pending)
+{
+	u32 value;
+
+	if (t->error)
+		return t->error;
+	if (!pending)
+		return -EINVAL;
+	value = t->ops->read32(t->ctx, t->soc->irq_status);
+	if (value & ~GENMASK(7, 0))
+		return ane_fw_transport_fail(t, -EPROTO);
+	*pending = value;
+	if (value)
+		t->ops->write32(t->ctx, t->soc->irq_ack, value);
+	if (t->armed && (value & BIT(t->channels[ANE_FW_SHAREDMALLOC].bit))) {
+		const struct ane_fw_channel *c = &t->channels[ANE_FW_SHAREDMALLOC];
+		u32 n;
+
+		/*
+		 * An allocation's header is zero, including on a never-used slot.
+		 * Its body can be visible before firmware posts the notification;
+		 * answering then races the producer's publication/wakeup sequence.
+		 * Capture the notified batch BEFORE replying to any entry. Draining
+		 * until empty after a reply could pick up the next unnotified request.
+		 * One pending bit may cover several already queued entries.
+		 */
+		t->ops->read_barrier(t->ctx);
+		for (n = 0; n < c->slots; n++) {
+			u32 slot = (t->head[ANE_FW_SHAREDMALLOC] + n) % c->slots;
+			u8 *p = (u8 *)t->ipc.cpu + c->offset + slot * ANE_FW_SLOT_SIZE;
+			u64 word0 = t->ops->load64(t->ctx, p);
+			u64 word1, word2;
+
+			if (word0 & 1)
+				break;
+			t->ops->read_barrier(t->ctx);
+			word1 = t->ops->load64(t->ctx, p + 8);
+			word2 = t->ops->load64(t->ctx, p + 16);
+			if (!word0 && !word1 && !word2)
+				break;
+		}
+		t->shared_ready = n;
+	}
+	return 0;
+}
+
+/*
+ * The firmware's text log on a unidirectional type 2 ring: a slot is ready when
+ * bit 0 of its header is clear, and the consumer returns it by storing 1, with
+ * no doorbell. The text is discarded. An unserved ring fills and the firmware's
+ * printf blocks behind it.
+ */
+static inline int ane_fw_transport_terminal(struct ane_fw_transport *t)
+{
+	const struct ane_fw_channel *c = &t->channels[ANE_FW_TERMINAL];
+	unsigned int i;
+
+	if (c->type != 2)
+		return 0;
+	for (i = 0; i < c->slots; i++) {
+		u8 *slot = ane_fw_transport_slot(t, ANE_FW_TERMINAL);
+		u64 header = t->ops->load64(t->ctx, slot), bytes;
+
+		t->ops->read_barrier(t->ctx);
+		if (header & 1)
+			break;
+		bytes = t->ops->load64(t->ctx, slot + 8);
+		if (bytes && !ane_fw_transport_report(t, header & ~3ULL, bytes))
+			return ane_fw_transport_fail(t, -EPROTO);
+		t->terminal_messages++;
+		t->terminal_bytes += bytes;
+		t->ops->write_barrier(t->ctx);
+		t->ops->store64(t->ctx, slot, 1);
+		t->ops->write_barrier(t->ctx);
+		ane_fw_transport_advance(t, ANE_FW_TERMINAL);
+	}
+	return 0;
+}
+
+/* The original absolute command deadline survives every provider/IRQ service. */
+/*
+ * After a program is torn down the firmware posts FREE for its process pool,
+ * sometimes after the UNLOAD reply, and waits for the answer with its shared
+ * memory lock held. Serve the SHAREDMALLOC ring until it has been quiet for
+ * quiet_ns, for at most limit_ns. Returns the number of requests served.
+ */
+static inline int ane_fw_transport_settle(struct ane_fw_transport *t, u64 quiet_ns,
+					  u64 limit_ns)
+{
+	u64 start = t->ops->now_ns(t->ctx), last = start, now;
+	u32 pending;
+	int ret, served = 0;
+
+	for (;;) {
+		ret = ane_fw_transport_irq(t, &pending);
+		if (ret)
+			return ret;
+		ret = ane_fw_transport_shared(t);
+		now = t->ops->now_ns(t->ctx);
+		if (!ret) {
+			served++;
+			last = now;
+		} else if (ret != -EAGAIN) {
+			return ret;
+		}
+		ret = ane_fw_transport_terminal(t);
+		if (ret)
+			return ret;
+		if (now - last >= quiet_ns || now - start >= limit_ns)
+			return served;
+		t->polls++;
+		t->ops->relax(t->ctx, now - last);
+	}
+}
+
+static inline int ane_fw_transport_wait(struct ane_fw_transport *t, unsigned int ch)
+{
+	u64 start = t->ops->now_ns(t->ctx), now;
+	u32 pending;
+	int ret;
+
+	for (;;) {
+		ret = ane_fw_transport_poll(t, ch);
+		if (ret != -EAGAIN)
+			return ret;
+		ret = ane_fw_transport_irq(t, &pending);
+		if (ret)
+			return ret;
+		ret = ane_fw_transport_shared(t);
+		if (ret && ret != -EAGAIN)
+			return ret;
+		ret = ane_fw_transport_terminal(t);
+		if (ret)
+			return ret;
+		/* Recheck before sleeping, including time spent in alloc(). */
+		now = t->ops->now_ns(t->ctx);
+		if (now >= t->pending[ch].deadline_ns)
+			return ane_fw_transport_fail(t, -ETIMEDOUT);
+		t->polls++;
+		t->ops->relax(t->ctx, now - start);
+	}
+}
+
+#endif /* __ANE_FW_TRANSPORT_H__ */
diff --git a/drivers/accel/ane/ane_fw_transport_test.c b/drivers/accel/ane/ane_fw_transport_test.c
new file mode 100644
index 0000000000..4f4b87cf98
--- /dev/null
+++ b/drivers/accel/ane/ane_fw_transport_test.c
@@ -0,0 +1,1600 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <kunit/test.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+#include "ane_fw_transport.h"
+#include "ane_h16_execute.h"
+
+#define TEST_IPC_DVA 0x100003d0000ULL
+#define TEST_POOL_DVA 0x10000384000ULL
+#define TEST_SHARED_DVA 0x10002000000ULL
+#define TEST_IPC_SIZE SZ_64K
+#define TEST_POOL_SIZE SZ_256K
+#define TEST_RESERVED SZ_16K
+#define TEST_DEADLINE 100ULL
+
+struct ane_test_access {
+	char kind;
+	const void *p;
+	u64 value;
+};
+
+struct ane_transport_test {
+	struct kunit *test;
+	struct ane_fw_transport t;
+	struct ane_fw_platform soc;
+	struct ane_fw_surface ipc;
+	struct ane_fw_surface pool;
+	struct ane_test_access access[128];
+	unsigned int count;
+	u64 now;
+	u64 alloc_time;
+	u64 waited;
+	u64 next_dva;
+	u32 irq;
+	u32 last_reg;
+	u32 last_value;
+	unsigned int allocs;
+	unsigned int refusals;
+	u64 refused[3];
+	int refused_error;
+	int alloc_error;
+	int alloc_bad;
+	bool post_next_unnotified;
+};
+
+static void ane_test_access(struct ane_transport_test *f, char kind, const void *p, u64 value)
+{
+	if (f->count < ARRAY_SIZE(f->access))
+		f->access[f->count++] = (struct ane_test_access) { kind, p, value };
+}
+
+static u64 ane_test_load(void *ctx, const void *p)
+{
+	struct ane_transport_test *f = ctx;
+	u64 value = get_unaligned_le64(p);
+
+	ane_test_access(f, 'r', p, value);
+	return value;
+}
+
+static void ane_test_store(void *ctx, void *p, u64 value)
+{
+	struct ane_transport_test *f = ctx;
+
+	ane_test_access(f, 'w', p, value);
+	put_unaligned_le64(value, p);
+}
+
+static void ane_test_rmb(void *ctx)
+{
+	ane_test_access(ctx, 'R', NULL, 0);
+}
+
+static void ane_test_wmb(void *ctx)
+{
+	ane_test_access(ctx, 'W', NULL, 0);
+}
+
+static u32 ane_test_read32(void *ctx, u32 reg)
+{
+	struct ane_transport_test *f = ctx;
+
+	f->last_reg = reg;
+	ane_test_access(f, 'i', NULL, reg);
+	return f->irq;
+}
+
+static void ane_test_write32(void *ctx, u32 reg, u32 value)
+{
+	struct ane_transport_test *f = ctx;
+
+	f->last_reg = reg;
+	f->last_value = value;
+	ane_test_access(f, 'o', NULL, value);
+	if (reg == f->soc.irq_ack)
+		f->irq &= ~value;
+}
+
+static u64 ane_test_now(void *ctx)
+{
+	return ((struct ane_transport_test *)ctx)->now;
+}
+
+static void ane_test_relax(void *ctx, u64 waited_ns)
+{
+	struct ane_transport_test *f = ctx;
+
+	f->waited = waited_ns;
+	f->now++;
+}
+
+static int ane_test_alloc(void *ctx, size_t size, u32 tag, struct ane_fw_surface *s)
+{
+	struct ane_transport_test *f = ctx;
+
+	f->allocs++;
+	f->now += f->alloc_time;
+	if (f->post_next_unnotified) {
+		const struct ane_fw_channel *c = &f->t.channels[ANE_FW_SHAREDMALLOC];
+		u32 next = (f->t.head[ANE_FW_SHAREDMALLOC] + 1) % c->slots;
+		u8 *p = (u8 *)f->ipc.cpu + c->offset + next * ANE_FW_SLOT_SIZE;
+
+		/* Arrives after the batch snapshot, before the first reply. */
+		put_unaligned_le64(0, p);
+		put_unaligned_le64(SZ_16K, p + 8);
+		put_unaligned_le64(0x5678, p + 16);
+		f->post_next_unnotified = false;
+	}
+	if (f->alloc_error)
+		return f->alloc_error;
+	*s = (struct ane_fw_surface) {
+		.cpu = kunit_kzalloc(f->test, size, GFP_KERNEL),
+		.dva = f->next_dva,
+		.size = size,
+	};
+	if (!s->cpu)
+		return -ENOMEM;
+	f->next_dva += size;
+	switch (f->alloc_bad) {
+	case 1:
+		s->dva++;
+		break;
+	case 2:
+		s->size--;
+		break;
+	case 3:
+		s->dva = f->pool.dva;
+		break;
+	case 4:
+		s->dva = f->ipc.dva;
+		break;
+	case 5:
+		s->dva = U64_MAX - SZ_16K + 1;
+		break;
+	case 6:
+		s->cpu = NULL;
+		break;
+	}
+	return 0;
+}
+
+static void ane_test_refused(void *ctx, u64 word0, u64 word1, u64 word2, int error)
+{
+	struct ane_transport_test *f = ctx;
+
+	f->refusals++;
+	f->refused[0] = word0;
+	f->refused[1] = word1;
+	f->refused[2] = word2;
+	f->refused_error = error;
+}
+
+static const struct ane_fw_transport_ops ane_test_ops = {
+	.load64 = ane_test_load,
+	.store64 = ane_test_store,
+	.read_barrier = ane_test_rmb,
+	.write_barrier = ane_test_wmb,
+	.read32 = ane_test_read32,
+	.write32 = ane_test_write32,
+	.now_ns = ane_test_now,
+	.relax = ane_test_relax,
+	.alloc = ane_test_alloc,
+	.refused = ane_test_refused,
+};
+
+static void ane_test_table(struct ane_transport_test *f)
+{
+	static const char * const names[] = {
+		"TERMINAL", "IO", "DEBUG", "BUF_H2T", "BUF_T2H",
+		"SHAREDMALLOC", "IO_T2H", "DATA_CHAIN_H2T",
+	};
+	unsigned int i;
+
+	memset(f->ipc.cpu, 0, f->ipc.size);
+	for (i = 0; i < ANE_FW_CHANNELS; i++) {
+		u8 *p = (u8 *)f->ipc.cpu + i * ANE_FW_DESCRIPTOR_SIZE;
+
+		strscpy((char *)p, names[i], 64);
+		put_unaligned_le32(i == 0 ? 2 : (i >= 4 && i <= 6), p + 0x40);
+		put_unaligned_le32(i, p + 0x44);
+		put_unaligned_le64(2, p + 0x48);
+		put_unaligned_le64(f->ipc.dva + 0x800 + i * 0x80, p + 0x50);
+	}
+}
