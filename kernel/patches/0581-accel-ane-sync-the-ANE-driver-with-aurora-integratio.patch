+
+static void ane_h16_delay(void *ctx, unsigned int us)
+{
+	if (us < 100)
+		udelay(us);
+	else
+		usleep_range(us, us + 50);
+}
+
+static void ane_h16_log(void *ctx, const char *item, u64 a, u64 b)
+{
