+	KUNIT_EXPECT_EQ(test, ane_h16_usage_class(13), 0);
+	KUNIT_EXPECT_EQ(test, ane_h16_usage_class(0), 8);
+	KUNIT_EXPECT_EQ(test, ane_h16_usage_class(99), 8);
+}
