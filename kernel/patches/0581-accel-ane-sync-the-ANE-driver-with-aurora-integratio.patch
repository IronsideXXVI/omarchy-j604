+static void ane_h16_refused(void *ctx, u64 w0, u64 w1, u64 w2, int error)
+{
+	struct ane_h16_device *h = ctx;
+
+	dev_err(h->dev, "H16 SHAREDMALLOC refused %llx %llx %llx error %d\n",
+		w0, w1, w2, error);
+}
