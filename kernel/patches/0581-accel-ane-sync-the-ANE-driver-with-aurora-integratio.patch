+/* A program whose teardown failed keeps its memory and is never freed. */
+static void program_failed_close_keeps_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test);
+	struct ane_h16_program *p = NULL;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &p), 0);
+	f->s.quarantined = true;
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, p), -EIO);
+	KUNIT_EXPECT_FALSE(test, p->released);
+	KUNIT_EXPECT_EQ(test, f->s.spare_count, 0U);
+	ane_h16_session_put(&f->s, p);
+	/* Still there: put refused a program that was not released. */
+	KUNIT_EXPECT_TRUE(test, p->closed);
+	KUNIT_EXPECT_NOT_NULL(test, p->surfaces[0]);
+}
+
+/*
+ * The busy hook brackets every EXECUTE that reaches the firmware, pass or
+ * fail, exactly once and never nested; a refused call never votes.
+ */
+static void program_busy_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test), *g = fw_create(test);
+	struct ane_h16_program *p = NULL, *q = NULL;
+	unsigned int i;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, g);
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &p), 0);
+	KUNIT_EXPECT_EQ(test, f->busy_on, 0);
+	for (i = 0; i < 5; i++)
+		KUNIT_ASSERT_EQ(test, ane_h16_session_execute(&f->s, p), 0);
+	KUNIT_EXPECT_EQ(test, f->busy_on, 5);
+	KUNIT_EXPECT_EQ(test, f->busy_off, 5);
+	KUNIT_EXPECT_EQ(test, f->busy_max, 1);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_execute(&f->s, NULL), -EINVAL);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_execute(&g->s, p), -EINVAL);
+	KUNIT_EXPECT_EQ(test, f->busy_on + g->busy_on, 5);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, p), 0);
+
+	/* A stalled request still releases the vote. */
+	KUNIT_ASSERT_EQ(test, fw_load_program(g, &q), 0);
+	g->mode = FW_REPORT_STALL;
+	KUNIT_EXPECT_NE(test, ane_h16_session_execute(&g->s, q), 0);
+	KUNIT_EXPECT_EQ(test, g->busy_on, 1);
+	KUNIT_EXPECT_EQ(test, g->busy_off, 1);
+	KUNIT_EXPECT_EQ(test, g->busy_depth, 0);
+}
+
+/*
+ * While the firmware is suspended for system sleep, requests wait at the
+ * gate and a close is deferred: no firmware traffic until the session
+ * reopens, then the normal TERMINATE and UNLOAD, and the program survives
+ * the sleep untouched until then (no LOAD or CREATE replay).
+ */
+static void program_sleep_gate_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test);
+	struct ane_h16_program *p = NULL;
+	struct mutex *lock = kunit_kzalloc(test, sizeof(*lock), GFP_KERNEL);
+	unsigned int sent, spares;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, lock);
+	mutex_init(lock);
+	f->s.lock = lock;
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &p), 0);
+	KUNIT_ASSERT_EQ(test, ane_h16_session_execute(&f->s, p), 0);
+
+	ane_h16_session_sleep(&f->s, true);
+	KUNIT_EXPECT_TRUE(test, f->s.asleep);
+	sent = f->count;
+	spares = f->s.spare_count;
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, p), -EINPROGRESS);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, p), -EINPROGRESS);
+	KUNIT_EXPECT_EQ(test, f->count, sent);
+	KUNIT_EXPECT_FALSE(test, p->closed);
+
+	/* Reopen: the deferred close runs once, with its firmware traffic. */
+	ane_h16_session_sleep(&f->s, false);
+	KUNIT_EXPECT_FALSE(test, f->s.asleep);
+	KUNIT_EXPECT_GT(test, f->count, sent);
+	KUNIT_EXPECT_GT(test, f->s.spare_count, spares);
+	KUNIT_EXPECT_TRUE(test, list_empty(&f->s.deferred));
+	KUNIT_EXPECT_FALSE(test, f->s.quarantined);
+
+	/* The gate lets requests in again. */
+	KUNIT_ASSERT_EQ(test, ane_h16_session_enter(&f->s, false), 0);
+	mutex_unlock(lock);
+}
+
+/* A program survives a sleep: the same handle executes afterwards. */
+static void program_sleep_keeps_program_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test);
+	struct ane_h16_program *p = NULL;
+	struct mutex *lock = kunit_kzalloc(test, sizeof(*lock), GFP_KERNEL);
+	unsigned int loads;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, lock);
+	mutex_init(lock);
+	f->s.lock = lock;
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &p), 0);
+	KUNIT_ASSERT_EQ(test, ane_h16_session_execute(&f->s, p), 0);
+	loads = f->programs_live;
+	ane_h16_session_sleep(&f->s, true);
+	ane_h16_session_sleep(&f->s, false);
+	KUNIT_EXPECT_EQ(test, f->programs_live, loads);
+	KUNIT_ASSERT_EQ(test, ane_h16_session_execute(&f->s, p), 0);
+	/* Same program on the engine: the direct path, no requeue. */
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(f->exec + 0x30), 0);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, p), 0);
+}
+
+/*
+ * A cold restart across system sleep: a program from before is lost
+ * (EXECUTE refuses it with no firmware traffic, close only releases its
+ * memory) and a new program loads into the spares it gave back, its first
+ * EXECUTE queued.
+ */
+static void program_sleep_restart_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test);
+	struct ane_h16_program *p = NULL, *q = NULL;
+	struct mutex *lock = kunit_kzalloc(test, sizeof(*lock), GFP_KERNEL);
+	unsigned int maps, sent;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, lock);
+	mutex_init(lock);
+	f->s.lock = lock;
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &p), 0);
+	KUNIT_ASSERT_EQ(test, ane_h16_session_execute(&f->s, p), 0);
+	maps = f->maps;
+
+	ane_h16_session_sleep(&f->s, true);
+	ane_h16_session_restart(&f->s);
+	ane_h16_session_sleep(&f->s, false);
+	KUNIT_EXPECT_FALSE(test, f->s.asleep);
+	KUNIT_EXPECT_TRUE(test, ane_h16_program_lost(&f->s, p));
+	KUNIT_EXPECT_PTR_EQ(test, f->s.program, NULL);
+
+	sent = f->count;
+	KUNIT_EXPECT_EQ(test, ane_h16_session_execute(&f->s, p), -ENODEV);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_execute(&f->s, p), -ENODEV);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, p), 0);
+	KUNIT_EXPECT_EQ(test, f->count, sent);
+	KUNIT_EXPECT_TRUE(test, p->released);
+	KUNIT_EXPECT_GT(test, f->s.spare_count, 0U);
+	KUNIT_EXPECT_FALSE(test, f->s.quarantined);
+	ane_h16_session_put(&f->s, p);
+
+	/* The gate lets requests in again; the new program reuses memory. */
+	KUNIT_ASSERT_EQ(test, ane_h16_session_enter(&f->s, false), 0);
+	mutex_unlock(lock);
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &q), 0);
+	KUNIT_EXPECT_EQ(test, f->maps, maps);
+	KUNIT_EXPECT_FALSE(test, ane_h16_program_lost(&f->s, q));
+	KUNIT_ASSERT_EQ(test, ane_h16_session_execute(&f->s, q), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(f->exec + 0x30), ANE_H16_EXECUTE_FLAG_QUEUED);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, q), 0);
+	KUNIT_EXPECT_FALSE(test, f->s.quarantined);
+}
+
+/*
+ * A close deferred while the engine is powered off for a cold cycle runs
+ * at the reopen as a release only: the new firmware never knew the program.
+ */
+static void program_sleep_restart_deferred_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test);
+	struct ane_h16_program *p = NULL;
+	struct mutex *lock = kunit_kzalloc(test, sizeof(*lock), GFP_KERNEL);
+	unsigned int sent, spares;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, lock);
+	mutex_init(lock);
+	f->s.lock = lock;
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &p), 0);
+	KUNIT_ASSERT_EQ(test, ane_h16_session_execute(&f->s, p), 0);
+
+	ane_h16_session_sleep(&f->s, true);
+	sent = f->count;
+	spares = f->s.spare_count;
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, p), -EINPROGRESS);
+	ane_h16_session_restart(&f->s);
+	/* The reopen releases and frees it, with no TERMINATE or UNLOAD. */
+	ane_h16_session_sleep(&f->s, false);
+	KUNIT_EXPECT_EQ(test, f->count, sent);
+	KUNIT_EXPECT_GT(test, f->s.spare_count, spares);
+	KUNIT_EXPECT_TRUE(test, list_empty(&f->s.deferred));
+	KUNIT_EXPECT_FALSE(test, f->s.quarantined);
+}
+
+/*
+ * A cold cycle with replay is invisible to the application: the same handle
+ * runs after it, on new firmware IDs, the firmware got the identical program
+ * image (LOAD bytes, regions rewritten from the HWX) and the EXECUTE carries
+ * the identical buffer table, so the outputs are the same.
+ */
+static void program_sleep_replay_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test);
+	struct ane_h16_program *p = NULL;
+	struct mutex *lock = kunit_kzalloc(test, sizeof(*lock), GFP_KERNEL);
+	u8 *load = kunit_kzalloc(test, ANE_H16_LOAD_SIZE, GFP_KERNEL);
+	u8 *exec = kunit_kzalloc(test, sizeof(f->exec), GFP_KERNEL);
+	unsigned int replayed, i;
+	size_t exec_length;
+	u32 program, process;
+	u64 first;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, lock);
+	KUNIT_ASSERT_NOT_NULL(test, load);
+	KUNIT_ASSERT_NOT_NULL(test, exec);
+	mutex_init(lock);
+	f->s.lock = lock;
+	f->strict = true;
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &p), 0);
+	KUNIT_ASSERT_EQ(test, ane_h16_session_execute(&f->s, p), 0);
+	memcpy(load, f->load, ANE_H16_LOAD_SIZE);
+	memcpy(exec, f->exec, sizeof(f->exec));
+	exec_length = f->exec_length;
+	program = p->key.program;
+	process = p->key.process;
+	/* The engine wrote into the program's memory while it ran. */
+	for (i = 0; i < p->plan.count; i++)
+		memset(p->regions[i].cpu, 0xa5, p->regions[i].size);
+
+	ane_h16_session_sleep(&f->s, true);
+	fw_cold_boot(f);
+	ane_h16_session_restart(&f->s);
+	KUNIT_EXPECT_TRUE(test, ane_h16_program_lost(&f->s, p));
+	KUNIT_ASSERT_EQ(test, ane_h16_session_replay(&f->s, &replayed, &first), 0);
+	ane_h16_session_sleep(&f->s, false);
+	KUNIT_EXPECT_EQ(test, replayed, 1U);
+	KUNIT_EXPECT_FALSE(test, ane_h16_program_lost(&f->s, p));
+	KUNIT_EXPECT_EQ(test, p->key.program, program + 0x10);
+	KUNIT_EXPECT_EQ(test, p->key.process, process + 0x10);
+	KUNIT_EXPECT_EQ(test, memcmp(f->load + 8, load + 8, ANE_H16_LOAD_SIZE - 8), 0);
+	for (i = 0; i < p->plan.count; i++) {
+		const struct ane_h16_hwx_region *r = &p->plan.regions[i];
+
+		KUNIT_EXPECT_EQ(test, memcmp(p->regions[i].cpu,
+					     (const u8 *)p->snapshot.bytes + r->file_offset,
+					     r->file_size), 0);
+		KUNIT_EXPECT_FALSE(test, memchr_inv((u8 *)p->regions[i].cpu + r->file_size, 0,
+						    p->regions[i].size - r->file_size));
+	}
+
+	/* The same handle runs on the new firmware IDs, queued first. */
+	KUNIT_ASSERT_EQ(test, ane_h16_session_execute(&f->s, p), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(f->exec + 8), program + 0x10);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(f->exec + 0xc), process + 0x10);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(f->exec + 0x30), ANE_H16_EXECUTE_FLAG_QUEUED);
+	KUNIT_EXPECT_EQ(test, f->exec_length, exec_length);
+	KUNIT_EXPECT_EQ(test, memcmp(f->exec + 0x34, exec + 0x34, exec_length - 0x34), 0);
+	KUNIT_EXPECT_FALSE(test, f->s.quarantined);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, p), 0);
+	ane_h16_session_put(&f->s, p);
+}
+
+/* Requests during the cycle wait at the gate; O_NONBLOCK gets -EAGAIN. */
+static void program_sleep_nonblock_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test);
+	struct mutex *lock = kunit_kzalloc(test, sizeof(*lock), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, lock);
+	mutex_init(lock);
+	f->s.lock = lock;
+	ane_h16_session_sleep(&f->s, true);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_enter(&f->s, true), -EAGAIN);
+	ane_h16_session_sleep(&f->s, false);
+	KUNIT_ASSERT_EQ(test, ane_h16_session_enter(&f->s, true), 0);
+	mutex_unlock(lock);
+	KUNIT_ASSERT_EQ(test, ane_h16_session_enter(&f->s, false), 0);
+	mutex_unlock(lock);
+}
+
+/* A replay the new firmware refuses is reported loudly and quarantines. */
+static void program_sleep_replay_failure_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test);
+	struct ane_h16_program *p = NULL;
+	struct mutex *lock = kunit_kzalloc(test, sizeof(*lock), GFP_KERNEL);
+	unsigned int replayed;
+	u64 first;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, lock);
+	mutex_init(lock);
+	f->s.lock = lock;
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &p), 0);
+	ane_h16_session_sleep(&f->s, true);
+	fw_cold_boot(f);
+	f->mode = FW_LOAD_NAK;
+	ane_h16_session_restart(&f->s);
+	KUNIT_EXPECT_NE(test, ane_h16_session_replay(&f->s, &replayed, &first), 0);
+	ane_h16_session_sleep(&f->s, false);
+	KUNIT_EXPECT_EQ(test, replayed, 0U);
+	KUNIT_EXPECT_EQ(test, f->replay_failed, 1U);
+	KUNIT_EXPECT_TRUE(test, f->s.quarantined);
+	KUNIT_EXPECT_TRUE(test, ane_h16_program_lost(&f->s, p));
+}
+
+/* A program closed while asleep is not replayed, only released. */
+static void program_sleep_replay_deferred_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test);
+	struct ane_h16_program *p = NULL;
+	struct mutex *lock = kunit_kzalloc(test, sizeof(*lock), GFP_KERNEL);
+	unsigned int replayed, sent;
+	u64 first;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, lock);
+	mutex_init(lock);
+	f->s.lock = lock;
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &p), 0);
+	ane_h16_session_sleep(&f->s, true);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, p), -EINPROGRESS);
+	fw_cold_boot(f);
+	ane_h16_session_restart(&f->s);
+	sent = f->count;
+	KUNIT_ASSERT_EQ(test, ane_h16_session_replay(&f->s, &replayed, &first), 0);
+	KUNIT_EXPECT_EQ(test, replayed, 0U);
+	ane_h16_session_sleep(&f->s, false);
+	KUNIT_EXPECT_EQ(test, f->count, sent);
+	KUNIT_EXPECT_TRUE(test, list_empty(&f->s.programs));
+	KUNIT_EXPECT_FALSE(test, f->s.quarantined);
+}
+
+static struct kunit_case program_cases[] = {
+	KUNIT_CASE(program_sleep_replay_test),
+	KUNIT_CASE(program_sleep_nonblock_test),
+	KUNIT_CASE(program_sleep_replay_failure_test),
+	KUNIT_CASE(program_sleep_replay_deferred_test),
+	KUNIT_CASE(program_sleep_gate_test),
+	KUNIT_CASE(program_sleep_keeps_program_test),
+	KUNIT_CASE(program_sleep_restart_test),
+	KUNIT_CASE(program_sleep_restart_deferred_test),
+	KUNIT_CASE(program_cycle_test),
+	KUNIT_CASE(program_h17_cycle_test),
+	KUNIT_CASE(program_failed_close_keeps_test),
+	KUNIT_CASE(program_busy_test),
+	KUNIT_CASE(program_cached_sync_test),
+	KUNIT_CASE(program_h17_no_custom_bar_test),
+	KUNIT_CASE(program_add128_slots_test),
+	KUNIT_CASE(program_kernel_slots_test),
+	KUNIT_CASE(program_add128_hwx_test),
+	KUNIT_CASE(program_replies_test),
+	KUNIT_CASE(program_deny_list_test),
+	KUNIT_CASE(program_custom_bar_test),
+	KUNIT_CASE(program_session_test),
+	KUNIT_CASE(program_gate_hold_test),
+	KUNIT_CASE(program_scratch_test),
+	KUNIT_CASE(program_bad_load_test),
+	KUNIT_CASE(program_bad_report_test),
+	KUNIT_CASE(program_stall_trace_test),
+	KUNIT_CASE(program_timing_test),
+	KUNIT_CASE(program_fwlog_line_test),
+	KUNIT_CASE(program_shared_tag_test),
+	KUNIT_CASE(program_pool_test),
+	KUNIT_CASE(program_pool_recycle_test),
+	KUNIT_CASE(program_h17_hwx_test),
+	KUNIT_CASE(program_h17_sections_test),
+	KUNIT_CASE(program_h17_mobilenet_test),
+	KUNIT_CASE(program_h17_switch_test),
+	{}
+};
+
+static struct kunit_suite program_suite = {
+	.name = "ane-h16-program",
+	.test_cases = program_cases,
+};
+
+kunit_test_suite(program_suite);
+MODULE_DESCRIPTION("KUnit tests for the H16 program lifecycle");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/accel/ane/ane_h16_protocol.h b/drivers/accel/ane/ane_h16_protocol.h
new file mode 100644
index 0000000000..a3ef6a9c25
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_protocol.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_H16_PROTOCOL_H__
+#define __ANE_H16_PROTOCOL_H__
+
+#include "ane_fw_protocol.h"
+
+/* Derived field facts from H16/macOS 27.0, 2026-10-31. No payload bytes. */
+enum ane_h16_command {
+	ANE_H16_LOAD_PROGRAM = 0x0200,
+	ANE_H16_UNLOAD_PROGRAM = 0x0201,
+	ANE_H16_CREATE_PROCESS = 0x0202,
+	ANE_H16_TERMINATE_PROCESS = 0x0203,
+	ANE_H16_EXECUTE = 0x020c,
+	ANE_H16_POWER_GATE = 0x002d,
+	ANE_H16_EVENT_REPORT = 0x0300,
+};
+
+struct ane_h16_command_info {
+	u16 id;
+	u16 min_size;
+	u16 max_size;
+	u8 size_step;
+	u8 channel;
+	bool from_firmware;
+};
+
+static inline const struct ane_h16_command_info *ane_h16_command_info(u16 id)
+{
+	static const struct ane_h16_command_info commands[] = {
+		{ ANE_H16_LOAD_PROGRAM, 0x1c0, 0x1c0, 1, 1, false },
+		{ ANE_H16_UNLOAD_PROGRAM, 0xc, 0xc, 1, 1, false },
+		{ ANE_H16_CREATE_PROCESS, 0x258, 0x258, 1, 1, false },
+		{ ANE_H16_TERMINATE_PROCESS, 0x10, 0x10, 1, 1, false },
+		{ ANE_H16_EXECUTE, 0xca8, 0xcd8, 0x18, 7, false },
+		{ ANE_H16_POWER_GATE, 0xc, 0xc, 1, 7, false },
+		{ ANE_H16_EVENT_REPORT, 0x60, 0x60, 1, 6, true },
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(commands); i++)
+		if (commands[i].id == id)
+			return &commands[i];
+	return NULL;
+}
+
+/* Validate the runtime wire shape, never infer a body from the H14 ABI. */
+static inline int
+ane_h16_command_prepare(void *command, size_t length, u16 id, unsigned int channel)
+{
+	const struct ane_h16_command_info *info = ane_h16_command_info(id);
+
+	if (!info || info->from_firmware)
+		return -EOPNOTSUPP;
+	if (!command || channel != info->channel || length < info->min_size ||
+	    length > info->max_size || (length - info->min_size) % info->size_step)
+		return -EINVAL;
+	if (id == ANE_H16_POWER_GATE &&
+	    get_unaligned_le32((u8 *)command + 8) > 1)
+		return -EINVAL;
+	ane_fw_command_header(command, id, true);
+	return 0;
+}
+
+/* The first word selects report slots; rolling words are also valid. */
+static inline int
+ane_h16_event_report_status(const void *event, size_t length, unsigned int channel)
+{
+	const u8 *p = event;
+	const struct ane_h16_command_info *info =
+		ane_h16_command_info(ANE_H16_EVENT_REPORT);
+
+	if (!p || channel != info->channel || length != info->min_size ||
+	    get_unaligned_le16(p + 4) != info->id || get_unaligned_le16(p + 6))
+		return -EPROTO;
+	return 0;
+}
+
+#endif /* __ANE_H16_PROTOCOL_H__ */
diff --git a/drivers/accel/ane/ane_h16_resources.h b/drivers/accel/ane/ane_h16_resources.h
new file mode 100644
index 0000000000..e77e17f21c
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_resources.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_H16_RESOURCES_H__
+#define __ANE_H16_RESOURCES_H__
+
+#include "ane_h16_execute.h"
+#include "ane_h16_hwx.h"
+
+/* Created only by the backend matching a validated HWX with reviewed program
+ * resource bindings. No userspace field may supply this authority. Each
+ * mapping is private, coherent DMA memory with no userspace alias, retained
+ * for process lifetime.
+ */
+struct ane_h16_resource {
+	u64 hwx_vm;
+	u32 permissions;
+	struct ane_h16_execute_buffer buffer;
+};
+
+static inline int
+ane_h16_resources_validate(const struct ane_h16_hwx *hwx,
+			   const struct ane_h16_resource *resources, unsigned int count)
+{
+	unsigned int i, j;
+
+	if (!hwx || !resources || count < 2 || count > ANE_H16_SURFACES ||
+	    count != hwx->surface_count)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		const struct ane_h16_hwx_surface *s = &hwx->surfaces[i];
+		const struct ane_h16_resource *r = &resources[i];
+		const struct ane_h16_execute_buffer *b = &r->buffer;
+		u64 end;
+
+		/* Only the established input/output classes are executable. */
+		if (s->direction < 1 || s->direction > 2 ||
+		    r->hwx_vm != s->section.vm || r->permissions != s->direction ||
+		    b->class != s->direction - 1 || !s->span ||
+		    s->span > s->section.size || s->section.size > s->allocation ||
+		    !IS_ALIGNED(s->allocation, SZ_16K) ||
+		    b->size != s->span || b->offset || !b->mapping_dva ||
+		    !IS_ALIGNED(b->mapping_dva, SZ_16K) ||
+		    b->mapping_size != s->allocation || b->size > b->mapping_size ||
+		    check_add_overflow(b->mapping_dva, b->mapping_size, &end))
+			return -EINVAL;
+		for (j = 0; j < i; j++) {
+			const struct ane_h16_execute_buffer *a = &resources[j].buffer;
+
+			/* Indices are local to a class (inputs and outputs). */
+			if ((a->index == b->index && a->class == b->class) ||
+			    (b->mapping_dva < a->mapping_dva + a->mapping_size &&
+			     a->mapping_dva < end))
+				return -EINVAL;
+		}
+	}
+	return 0;
+}
+
+#endif /* __ANE_H16_RESOURCES_H__ */
diff --git a/drivers/accel/ane/ane_h16_tasks.h b/drivers/accel/ane/ane_h16_tasks.h
new file mode 100644
index 0000000000..e6e4ebc706
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_tasks.h
@@ -0,0 +1,156 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef __ANE_H16_TASKS_H__
+#define __ANE_H16_TASKS_H__
+
+#include <linux/align.h>
+#include <linux/array_size.h>
+#include <linux/bitmap.h>
+#include <linux/errno.h>
+#include <linux/overflow.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+
+#define ANE_H16_TASK_MAX 0x60000
+
+/* Byte addresses in the source-backed H16 register image, exclusive ends. */
+static inline bool ane_h16_register_valid(u32 word)
+{
+	static const struct {
+		u32 start;
+		u32 end;
+	} blocks[] = {
+		{ 0x0000, 0x005c }, { 0x4100, 0x41a4 }, { 0x44d0, 0x44d4 },
+		{ 0x4500, 0x453c }, { 0x4900, 0x4930 }, { 0x4d00, 0x4e44 },
+		{ 0x5100, 0x5154 }, { 0x5500, 0x5620 }, { 0x5900, 0x5930 },
+	};
+	u32 addr = word * 4;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(blocks); i++)
+		if (addr >= blocks[i].start && addr < blocks[i].end)
+			return true;
+	return false;
+}
+
+/*
+ * A stream opens with a 16-byte frame: little-endian u32 @prologue, then
+ * twelve reserved zero bytes. H16 programs open with 1; every measured H17
+ * program opens with 0. The last task may end at the end of the section;
+ * every other task is padded with zeros to 16 bytes. This structural gate
+ * does not replace container/tensor/aperture validation.
+ */
+static inline int
+ane_hx_task_stream_validate(const void *text, size_t size, u32 expected_tasks, u32 prologue)
+{
+	const u8 *p = text;
+	size_t pos = 16;
+	u32 tasks = 0;
+
+	if (!p || !expected_tasks || size < 16 || size > ANE_H16_TASK_MAX ||
+	    (size & 3) || get_unaligned_le32(p) != prologue ||
+	    memchr_inv(p + 4, 0, 12))
+		return -ENOEXEC;
+	while (pos < size) {
+		u32 words, header_words = 9;
+		size_t end, padded, rec;
+
+		if (size - pos < 16)
+			return -ENOEXEC;
+		words = (get_unaligned_le32(p + pos) >> 16) & 0x7ff;
+		if (!words) {
+			if (memchr_inv(p + pos, 0, 16))
+				return -ENOEXEC;
+			pos += 16;
+			continue;
+		}
+		if (words < 9 || words > (size - pos) / 4)
+			return -ENOEXEC;
+		end = pos + words * 4;
+		if ((get_unaligned_le32(p + pos + 8 * 4) & 3) == 3)
+			header_words++;
+		if (words < header_words)
+			return -ENOEXEC;
+		rec = pos + header_words * 4;
+		while (rec < end) {
+			u32 h = get_unaligned_le32(p + rec);
+			u32 base = h & 0x7fff;
+			u32 mask = (h >> 15) & 0xffff;
+			u32 count, i;
+
+			rec += 4;
+			if (h & BIT(31))
+				count = 1 + hweight32(mask);
+			else
+				count = ((h >> 15) & 0x3f) + 1;
+			if (count > (end - rec) / 4 || !ane_h16_register_valid(base))
+				return -ENOEXEC;
+			if (h & BIT(31)) {
+				for (i = 0; i < 16; i++)
+					if ((mask & BIT(i)) &&
+					    !ane_h16_register_valid(base + i + 1))
+						return -ENOEXEC;
+			} else {
+				for (i = 1; i < count; i++)
+					if (!ane_h16_register_valid(base + i))
+						return -ENOEXEC;
+			}
+			rec += count * 4;
+		}
+		padded = end == size ? end : ALIGN(end, 16);
+		if (padded > size || memchr_inv(p + end, 0, padded - end))
+			return -ENOEXEC;
+		pos = padded;
+		if (++tasks > expected_tasks)
+			return -ENOEXEC;
+	}
+	return tasks == expected_tasks ? 0 : -ENOEXEC;
+}
+
+static inline int
+ane_h16_task_stream_validate(const void *text, size_t size, u32 expected_tasks)
+{
+	return ane_hx_task_stream_validate(text, size, expected_tasks, 1);
+}
+
+/* Section ordinal is supplied only by the validated complete section table.
+ * This checks Mach-O relocation entries, not the distinct aperture records.
+ */
+static inline int
+ane_h16_relocations_validate(const void *text, size_t text_size,
+			     const void *relocs, size_t count, u32 ordinal,
+			     u64 kernel_vm, u64 kernel_size,
+			     unsigned long *seen, size_t seen_bits)
+{
+	const u8 *r = relocs;
+	u64 kernel_end;
+	size_t i;
+
+	if (!count)
+		return 0;
+	if (!text || !relocs || !seen || !ordinal || ordinal > 0xffffff ||
+	    !kernel_size || text_size > ANE_H16_TASK_MAX || (text_size & 3) ||
+	    count > text_size / 4 || seen_bits < text_size / 4 ||
+	    check_add_overflow(kernel_vm, kernel_size, &kernel_end))
+		return -ENOEXEC;
+	bitmap_zero(seen, text_size / 4);
+	for (i = 0; i < count; i++) {
+		u32 patch = get_unaligned_le32(r + i * 8);
+		u32 info = get_unaligned_le32(r + i * 8 + 4);
+		u32 addend;
+		u64 target;
+
+		if ((patch & 3) || text_size < 4 || patch > text_size - 4 ||
+		    (info >> 24) != 7 || (info & 0xffffff) != ordinal ||
+		    test_and_set_bit(patch / 4, seen))
+			return -ENOEXEC;
+		addend = get_unaligned_le32((const u8 *)text + patch);
+		if (addend >= kernel_size ||
+		    check_add_overflow(kernel_vm, (u64)addend, &target) ||
+		    target >= kernel_end)
+			return -ENOEXEC;
+	}
+	return 0;
+}
+
+#endif /* __ANE_H16_TASKS_H__ */
diff --git a/drivers/accel/ane/ane_h16_tasks_test.c b/drivers/accel/ane/ane_h16_tasks_test.c
new file mode 100644
index 0000000000..6574dcb617
--- /dev/null
+++ b/drivers/accel/ane/ane_h16_tasks_test.c
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#include <kunit/test.h>
+#include <linux/module.h>
+
+#include "ane_h16_tasks.h"
+
+static void ane_h16_dense_task_test(struct kunit *test)
+{
+	u8 text[64] = {};
+
+	put_unaligned_le32(1, text);
+	/* Nine header words, one dense record and its one-word payload. */
+	put_unaligned_le32(11 << 16, text + 16);
+	put_unaligned_le32(0x4100 / 4, text + 16 + 9 * 4);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), 0);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 2), -ENOEXEC);
+	put_unaligned_le32(0x41a4 / 4, text + 16 + 9 * 4);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), -ENOEXEC);
+	put_unaligned_le32(0x419c / 4 | (1 << 15), text + 16 + 9 * 4);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), -ENOEXEC);
+	put_unaligned_le32(0x4100 / 4, text + 16 + 9 * 4);
+	/* The last task may end the stream without padding (16 + 44 bytes). */
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, 16 + 11 * 4, 1), 0);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, 16 + 10 * 4, 1), -ENOEXEC);
+	text[63] = 1;
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), -ENOEXEC);
+}
+
+static void ane_h16_scatter_task_test(struct kunit *test)
+{
+	u8 text[64] = {};
+
+	put_unaligned_le32(1, text);
+	put_unaligned_le32(12 << 16, text + 16);
+	put_unaligned_le32(BIT(31) | BIT(15) | 21, text + 16 + 9 * 4);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), 0);
+	/* The second scatter write would leave the common register block. */
+	put_unaligned_le32(BIT(31) | BIT(15) | 22, text + 16 + 9 * 4);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), -ENOEXEC);
+}
+
+static void ane_h16_extra_header_test(struct kunit *test)
+{
+	u8 text[64] = {};
+
+	put_unaligned_le32(1, text);
+	put_unaligned_le32(10 << 16, text + 16);
+	put_unaligned_le32(3, text + 16 + 8 * 4);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), 0);
+	put_unaligned_le32(9 << 16, text + 16);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), -ENOEXEC);
+	KUNIT_EXPECT_FALSE(test, ane_h16_register_valid(0x44d4 / 4));
+	KUNIT_EXPECT_TRUE(test, ane_h16_register_valid(0x44d0 / 4));
+	KUNIT_EXPECT_FALSE(test, ane_h16_register_valid(0x5930 / 4));
+}
+
+static void ane_h16_prologue_test(struct kunit *test)
+{
+	u8 text[64] = {};
+	unsigned int i;
+
+	put_unaligned_le32(11 << 16, text + 16);
+	put_unaligned_le32(0x4100 / 4, text + 16 + 9 * 4);
+	/* A zero prologue is not the H16 stream marker. */
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), -ENOEXEC);
+	put_unaligned_le32(1, text);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), 0);
+	put_unaligned_le32(2, text);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), -ENOEXEC);
+	put_unaligned_le32(0x01000000, text);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), -ENOEXEC);
+	put_unaligned_le32(1, text);
+	for (i = 4; i < 16; i++) {
+		text[i] = 1;
+		KUNIT_EXPECT_EQ(test,
+				ane_h16_task_stream_validate(text, sizeof(text), 1), -ENOEXEC);
+		text[i] = 0;
+	}
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, 15, 1), -ENOEXEC);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, 16, 1), -ENOEXEC);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(NULL, sizeof(text), 1), -ENOEXEC);
+}
+
+static void ane_h16_relocation_test(struct kunit *test)
+{
+	u8 text[64] = {};
+	u8 relocs[16] = {};
+	DECLARE_BITMAP(seen, 16);
+	int ret;
+
+	put_unaligned_le32(4, relocs);
+	put_unaligned_le32(0x07000003, relocs + 4);
+	put_unaligned_le32(0x20, text + 4);
+	ret = ane_h16_relocations_validate(text, sizeof(text),
+					   relocs, 1, 3, 0x30020000, 0x100, seen, 16);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	memcpy(relocs + 8, relocs, 8);
+	ret = ane_h16_relocations_validate(text, sizeof(text),
+					   relocs, 2, 3, 0x30020000, 0x100, seen, 16);
+	KUNIT_EXPECT_EQ(test, ret, -ENOEXEC);
+	ret = ane_h16_relocations_validate(text, sizeof(text),
+					   relocs, 1, 4, 0x30020000, 0x100, seen, 16);
+	KUNIT_EXPECT_EQ(test, ret, -ENOEXEC);
+	put_unaligned_le32(0x0f000003, relocs + 4);
+	ret = ane_h16_relocations_validate(text, sizeof(text),
+					   relocs, 1, 3, 0x30020000, 0x100, seen, 16);
+	KUNIT_EXPECT_EQ(test, ret, -ENOEXEC);
+	put_unaligned_le32(0x07000003, relocs + 4);
+	put_unaligned_le32(0x100, text + 4);
+	ret = ane_h16_relocations_validate(text, sizeof(text),
+					   relocs, 1, 3, 0x30020000, 0x100, seen, 16);
+	KUNIT_EXPECT_EQ(test, ret, -ENOEXEC);
+	ret = ane_h16_relocations_validate(text, sizeof(text),
+					   relocs, 1, 3, U64_MAX - 8, 0x100, seen, 16);
+	KUNIT_EXPECT_EQ(test, ret, -ENOEXEC);
+	ret = ane_h16_relocations_validate(text, sizeof(text),
+					   relocs, 1, 3, 0x30020000, 0, seen, 16);
+	KUNIT_EXPECT_EQ(test, ret, -ENOEXEC);
+}
+
+/* H17 streams open with 0, and the last task may end the section unpadded. */
+static void ane_h17_prologue_test(struct kunit *test)
+{
+	u8 text[60] = {};
+
+	put_unaligned_le32(11 << 16, text + 16);
+	put_unaligned_le32(0x4100 / 4, text + 16 + 9 * 4);
+	KUNIT_EXPECT_EQ(test, ane_hx_task_stream_validate(text, sizeof(text), 1, 0), 0);
+	KUNIT_EXPECT_EQ(test, ane_hx_task_stream_validate(text, sizeof(text), 1, 1), -ENOEXEC);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), -ENOEXEC);
+	put_unaligned_le32(1, text);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), 0);
+	/* A task that overruns the section is still refused. */
+	put_unaligned_le32(12 << 16, text + 16);
+	KUNIT_EXPECT_EQ(test, ane_h16_task_stream_validate(text, sizeof(text), 1), -ENOEXEC);
+}
+
+static struct kunit_case ane_h16_task_cases[] = {
+	KUNIT_CASE(ane_h16_prologue_test),
+	KUNIT_CASE(ane_h17_prologue_test),
+	KUNIT_CASE(ane_h16_dense_task_test),
+	KUNIT_CASE(ane_h16_scatter_task_test),
+	KUNIT_CASE(ane_h16_extra_header_test),
+	KUNIT_CASE(ane_h16_relocation_test),
+	{}
+};
+
+static struct kunit_suite ane_h16_task_suite = {
+	.name = "ane-h16-tasks",
+	.test_cases = ane_h16_task_cases,
+};
+
+kunit_test_suite(ane_h16_task_suite);
+MODULE_DESCRIPTION("KUnit tests for H16 task and relocation validation");
+MODULE_LICENSE("Dual MIT/GPL");
