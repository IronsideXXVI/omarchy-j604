From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
Date: Wed, 4 Nov 2026 15:57:57 -0600
Subject: [PATCH] pmdomain: apple: handle half-range vote retry wrap

Treat retry deadlines beyond the backoff window as expired using unsigned distance. Cover the exact half-range boundary and keep the mutation control aligned.

Signed-off-by: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
(cherry picked from commit c3487a528f74dfc036ffba7d3a4e5fa09cf2b52b)
---
 drivers/pmdomain/apple/pmp-agx-vote.h | 2 +-
 tools/asahi/pmp-agx-vote-tests.c      | 2 ++
 tools/asahi/pmp-agx-vote-tests.py     | 2 +-
 3 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/pmdomain/apple/pmp-agx-vote.h b/drivers/pmdomain/apple/pmp-agx-vote.h
index 4bd3ed6836..62ad104340 100644
--- a/drivers/pmdomain/apple/pmp-agx-vote.h
+++ b/drivers/pmdomain/apple/pmp-agx-vote.h
@@ -56,7 +56,7 @@ static inline bool agx_vote_reached(agx_ms_t now, agx_ms_t t)
 static inline bool agx_vote_retry_reached(const struct agx_vote *v, agx_ms_t now)
 {
 	return agx_vote_reached(now, v->retry_at)
-	       || (agx_sms_t)(v->retry_at - now) > (agx_sms_t)AGX_VOTE_RETRY_MS;
+	       || (agx_ms_t)(v->retry_at - now) > AGX_VOTE_RETRY_MS;
 }
 
 /* An operation starts. now is the operation's start time in ms (any wrapping clock; the caller reads it
diff --git a/tools/asahi/pmp-agx-vote-tests.c b/tools/asahi/pmp-agx-vote-tests.c
index a41d97d097..e53a3b4500 100644
--- a/tools/asahi/pmp-agx-vote-tests.c
+++ b/tools/asahi/pmp-agx-vote-tests.c
@@ -354,6 +354,8 @@ int main(void)
 		struct agx_vote w = {.enabled = true, .users = 1, .failures = 1, .retry_at = 0x54u};
 		CHECK(agx_vote_decide(&w, 0x54u + 0x80000005u) == AGX_VOTE_SET);
 		CHECK(agx_vote_next(&w, 0x54u + 0x80000005u) == 1);
+		CHECK(agx_vote_decide(&w, 0x54u + 0x80000000u) == AGX_VOTE_SET);
+		CHECK(agx_vote_next(&w, 0x54u + 0x80000000u) == 1);
 	}
 	// 22. the same review: during backoff begin must not ask for a reconciliation decide would refuse
 	// (every begin during the window kicked a NONE reconcile and the retry timer did the work anyway)
diff --git a/tools/asahi/pmp-agx-vote-tests.py b/tools/asahi/pmp-agx-vote-tests.py
index 37eec88d71..b2017bf6ec 100755
--- a/tools/asahi/pmp-agx-vote-tests.py
+++ b/tools/asahi/pmp-agx-vote-tests.py
@@ -43,7 +43,7 @@ CONTROLS = [
      '\t\tat = agx_vote_retry_reached(v, now) ? now : v->retry_at;\n', ''),
     ('begin-backoff-kick', 'return (!v->failures || agx_vote_retry_reached(v, now)) ? 1 : v->retry_at - now;', 'return (void)now, 1;'),
     ('begin-no-retry-arm', 'return (!v->failures || agx_vote_retry_reached(v, now)) ? 1 : v->retry_at - now;', 'return (void)now, 0;'),
-    ('retry-revival', '|| (agx_sms_t)(v->retry_at - now) > (agx_sms_t)AGX_VOTE_RETRY_MS', ''),
+    ('retry-revival', '|| (agx_ms_t)(v->retry_at - now) > AGX_VOTE_RETRY_MS', ''),
 ]
 
 
