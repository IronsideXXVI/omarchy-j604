From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eryk Wieliczko <eryk@wieliczko.ninja>
Date: Tue, 20 Oct 2026 23:05:29 +0200
Subject: [PATCH] dt-bindings: apple: describe T8132 GPU and retained display
 handoff

Describe the qualified firmware regions, PMP relationship and inherited
display ownership while retaining existing generation contracts.

Generated-by: Codex
Assisted-by: Codex:GPT-6
Signed-off-by: Eryk Wieliczko <eryk@wieliczko.ninja>
[dylan: apple,display-subsystem.yaml: kept omacom's t8122 compatible and
 apple,dma-range next to the T8132 entries. Dropped the new
 apple,t8132-pmp-report.yaml: omacom already documents
 apple,t8132-pmp-v2-report in apple,t8140-pmp-report.yaml (911acb85b)
 and two schemas must not claim one compatible.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../bindings/display/apple,dcp.yaml           | 41 +++++++-
 .../display/apple,display-subsystem.yaml      | 23 ++++-
 .../devicetree/bindings/gpu/apple,agx.yaml    | 96 +++++++++++++++----
 .../reserved-memory/apple,asc-mem.yaml        |  4 +
 .../bindings/soc/apple/apple,pmp.yaml         |  4 +
 5 files changed, 144 insertions(+), 24 deletions(-)

diff --git a/Documentation/devicetree/bindings/display/apple,dcp.yaml b/Documentation/devicetree/bindings/display/apple,dcp.yaml
index a7c74d948e..49d1144bdb 100644
--- a/Documentation/devicetree/bindings/display/apple,dcp.yaml
+++ b/Documentation/devicetree/bindings/display/apple,dcp.yaml
@@ -36,6 +36,11 @@ properties:
       - items:
           - const: apple,t8140-dcpext
           - const: apple,dcp
+      - description:
+          J713 internal display controller (T8132), whose inherited firmware
+          session uses IOMFB 26.6.2. The loader publishes the firmware identity,
+          reserved memory and validated display DART mappings.
+        const: apple,t8132-dcp
 
   reg:
     minItems: 2
@@ -168,6 +173,26 @@ properties:
       the ADT as thirteen little-endian 32-bit words. Linux passes these
       values to the firmware without interpreting or changing them.
 
+  apple,firmware-uuid:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: UUID of the inherited display firmware image.
+
+  apple,j713-native-piodma:
+    type: boolean
+    description: Request loader validation of the inherited J713 PIODMA stream.
+
+  apple,j713-native-scanout:
+    type: boolean
+    description: Request loader validation of the inherited J713 scanout stream.
+
+  apple,panel-width-mm:
+    maxItems: 1
+    description: Physical width of the inherited internal panel.
+
+  apple,panel-height-mm:
+    maxItems: 1
+    description: Physical height of the inherited internal panel.
+
   apple,firmware-version:
     $ref: /schemas/types.yaml#/definitions/uint32-array
     minItems: 3
@@ -252,6 +277,12 @@ properties:
     properties:
       iommus:
         maxItems: 1
+      memory-region:
+        minItems: 1
+        maxItems: 64
+      apple,j713-inherited-mappings:
+        type: boolean
+        description: The loader validated the inherited J713 SID16 PIODMA mapping.
     required:
       - iommus
     additionalProperties: false
@@ -318,9 +349,17 @@ required:
   - reg-names
   - mboxes
   - iommus
-  - apple,bw-scratch
 
 allOf:
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
+              const: apple,t8132-dcp
+    then:
+      required:
+        - apple,bw-scratch
   - if:
       not:
         properties:
diff --git a/Documentation/devicetree/bindings/display/apple,display-subsystem.yaml b/Documentation/devicetree/bindings/display/apple,display-subsystem.yaml
index 14bcb1f275..6ba4b94cb2 100644
--- a/Documentation/devicetree/bindings/display/apple,display-subsystem.yaml
+++ b/Documentation/devicetree/bindings/display/apple,display-subsystem.yaml
@@ -15,9 +15,17 @@ description:
 
 properties:
   compatible:
-    enum:
-      - apple,display-subsystem
-      - apple,t8122-display-subsystem
+    oneOf:
+      - enum:
+          - apple,display-subsystem
+          - apple,t8122-display-subsystem
+          - apple,t8132-display-subsystem
+      - const: apple,t8132-display-diagnostics
+        deprecated: true
+      - items:
+          - const: apple,t8132-display-subsystem
+          - const: apple,t8132-display-diagnostics
+        description: Compatibility with kernels predating the common M4 display backend.
 
   iommus:
     minItems: 1
@@ -32,6 +40,15 @@ properties:
       overrides the default aperture of each referenced DART stream. Other
       consumers of the same DART retain their own apertures.
 
+  memory-region:
+    minItems: 1
+    maxItems: 64
+    description: Reserved memory retaining the inherited display mappings.
+
+  apple,j713-inherited-mappings:
+    type: boolean
+    description: The loader validated the inherited J713 SID0 scanout mapping.
+
 required:
   - compatible
   - iommus
diff --git a/Documentation/devicetree/bindings/gpu/apple,agx.yaml b/Documentation/devicetree/bindings/gpu/apple,agx.yaml
index e7afc4dd87..0118e3afa2 100644
--- a/Documentation/devicetree/bindings/gpu/apple,agx.yaml
+++ b/Documentation/devicetree/bindings/gpu/apple,agx.yaml
@@ -17,6 +17,7 @@ properties:
           - apple,agx-g13s
           - apple,agx-g14g
           - apple,agx-g14s
+          - apple,agx-t8132
           - apple,agx-t8140
       - items:
           - enum:
@@ -50,9 +51,9 @@ properties:
       - description:
           Region containing a shared handoff structure for VM
           management coordination
-      - description: Calibration blob. Mostly power-related configuration
-      - description: Calibration blob. Mostly GPU-related configuration
-      - description: Shared global variables with GPU firmware
+      - description: Power calibration blob or firmware shared-L2 page
+      - description: GPU calibration blob or preserved firmware text
+      - description: Shared global variables or preserved firmware data
 
   memory-region-names:
     minItems: 3
@@ -60,9 +61,13 @@ properties:
       - const: ttbs
       - const: pagetables
       - const: handoff
-      - const: hw-cal-a
-      - const: hw-cal-b
-      - const: globals
+      - enum: [hw-cal-a, shared-l2]
+      - enum: [hw-cal-b, fw-text]
+      - enum: [globals, fw-data]
+
+  apple,pmp:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: PMP firmware provider owning the GPU power vote and telemetry
 
   operating-points-v2: true
 
@@ -85,46 +90,97 @@ allOf:
       properties:
         compatible:
           contains:
-            const: apple,agx-t8140
+            const: apple,agx-t8132
     then:
       properties:
         reg:
           items:
-            - description: GFX coprocessor control registers
+            - description: GPU coprocessor control registers
             - description: GPU block MMIO registers
+        mboxes:
+          maxItems: 1
         reg-names:
           items:
             - const: asc
             - const: sgx
-        mboxes:
-          items:
-            - description: GFX coprocessor mailbox
-            - description: GFX1 coprocessor mailbox
         memory-region:
-          maxItems: 3
+          minItems: 6
         memory-region-names:
-          maxItems: 3
+          items:
+            - const: ttbs
+            - const: pagetables
+            - const: handoff
+            - const: shared-l2
+            - const: fw-text
+            - const: fw-data
       required:
+        - apple,pmp
         - power-domains
-        - operating-points-v2
+        - reg-names
+        - memory-region-names
     else:
+      properties:
+        apple,pmp: false
+        memory-region-names:
+          minItems: 3
+          items:
+            - const: ttbs
+            - const: pagetables
+            - const: handoff
+            - const: hw-cal-a
+            - const: hw-cal-b
+            - const: globals
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,agx-t8140
+    then:
       properties:
         reg:
           items:
-            - description: GPU coprocessor control registers
+            - description: GFX coprocessor control registers
             - description: GPU block MMIO registers
         reg-names:
           items:
             - const: asc
             - const: sgx
         mboxes:
-          maxItems: 1
+          items:
+            - description: GFX coprocessor mailbox
+            - description: GFX1 coprocessor mailbox
         memory-region:
-          minItems: 6
+          maxItems: 3
         memory-region-names:
-          minItems: 6
+          maxItems: 3
       required:
-        - apple,firmware-abi
+        - power-domains
+        - operating-points-v2
+    else:
+      if:
+        properties:
+          compatible:
+            not:
+              contains:
+                const: apple,agx-t8132
+      then:
+        properties:
+          reg:
+            items:
+              - description: GPU coprocessor control registers
+              - description: GPU block MMIO registers
+          reg-names:
+            items:
+              - const: asc
+              - const: sgx
+          mboxes:
+            maxItems: 1
+          memory-region:
+            minItems: 6
+          memory-region-names:
+            minItems: 6
+        required:
+          - apple,firmware-abi
 
 additionalProperties: false
 
diff --git a/Documentation/devicetree/bindings/reserved-memory/apple,asc-mem.yaml b/Documentation/devicetree/bindings/reserved-memory/apple,asc-mem.yaml
index 0554020407..fb306d541c 100644
--- a/Documentation/devicetree/bindings/reserved-memory/apple,asc-mem.yaml
+++ b/Documentation/devicetree/bindings/reserved-memory/apple,asc-mem.yaml
@@ -31,6 +31,10 @@ properties:
 
   iommu-addresses: true
 
+  apple,dcp-os-log:
+    type: boolean
+    description: Reserved DCP OS log buffer supplied by the bootloader.
+
 required:
   - compatible
   - reg
diff --git a/Documentation/devicetree/bindings/soc/apple/apple,pmp.yaml b/Documentation/devicetree/bindings/soc/apple/apple,pmp.yaml
index 997761ed5a..fbf63358fc 100644
--- a/Documentation/devicetree/bindings/soc/apple/apple,pmp.yaml
+++ b/Documentation/devicetree/bindings/soc/apple/apple,pmp.yaml
@@ -45,6 +45,10 @@ properties:
   power-domains:
     maxItems: 1
 
+  apple,pmp-report:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Report provider whose running state qualifies device-power requests.
+
   apple,board-id:
     $ref: /schemas/types.yaml#/definitions/uint32
     description: Board identifier copied by the bootloader.
