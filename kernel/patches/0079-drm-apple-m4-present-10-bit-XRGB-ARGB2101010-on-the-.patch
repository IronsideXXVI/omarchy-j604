diff --git a/drivers/gpu/drm/apple/dcp-m4-frame-test.c b/drivers/gpu/drm/apple/dcp-m4-frame-test.c
new file mode 100644
index 0000000000..1c05c742d9
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-m4-frame-test.c
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+/*
+ * Primary surface formats of the T8132 panel (dcp-m4-frame.h): which DRM
+ * formats the single-surface path takes, and that the surface it encodes
+ * differs between 8 and 10 bits a component only in the firmware OSType
+ * ('BGRA' or 'l10r') at +0x0b, with the 8888 surface byte for byte as before.
+ */
+
+#include <kunit/test.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+#include <drm/drm_fourcc.h>
+
+#include "dcp-m4-frame.h"
+
+static void frame_drm_formats(struct kunit *test)
+{
+	static const struct { u32 drm; int ret; enum dcp_m4_frame_format m4; } t[] = {
+		{ DRM_FORMAT_XRGB8888, 0, DCP_M4_XRGB8888 },
+		{ DRM_FORMAT_ARGB8888, 0, DCP_M4_ARGB8888 },
+		{ DRM_FORMAT_XRGB2101010, 0, DCP_M4_XRGB2101010 },
+		{ DRM_FORMAT_ARGB2101010, 0, DCP_M4_ARGB2101010 },
+		/* No firmware format with this component order or depth. */
+		{ DRM_FORMAT_XBGR2101010, -EINVAL },
+		{ DRM_FORMAT_ABGR2101010, -EINVAL },
+		{ DRM_FORMAT_BGRX1010102, -EINVAL },
+		{ DRM_FORMAT_ABGR16161616F, -EINVAL },
+		{ DRM_FORMAT_XBGR8888, -EINVAL },
+		{ DRM_FORMAT_RGB565, -EINVAL },
+	};
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(t); i++) {
+		enum dcp_m4_frame_format f = DCP_M4_XRGB8888;
+
+		KUNIT_EXPECT_EQ(test, dcp_m4_drm_format(t[i].drm, &f), t[i].ret);
+		if (!t[i].ret)
+			KUNIT_EXPECT_EQ(test, f, t[i].m4);
+	}
+}
+
+static void frame_format_helpers(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_fourcc(DCP_M4_XRGB8888), 0x42475241U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_fourcc(DCP_M4_ARGB8888), 0x42475241U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_fourcc(DCP_M4_XRGB2101010), 0x6c313072U);
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_fourcc(DCP_M4_ARGB2101010), 0x6c313072U);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_format_opaque(DCP_M4_XRGB8888));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_format_opaque(DCP_M4_ARGB8888));
+	KUNIT_EXPECT_TRUE(test, dcp_m4_format_opaque(DCP_M4_XRGB2101010));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_format_opaque(DCP_M4_ARGB2101010));
+	/* The idle cache keeps the frame's depth. */
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_opaque_of(DCP_M4_ARGB8888), DCP_M4_XRGB8888);
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_opaque_of(DCP_M4_XRGB8888), DCP_M4_XRGB8888);
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_opaque_of(DCP_M4_ARGB2101010), DCP_M4_XRGB2101010);
+	KUNIT_EXPECT_EQ(test, dcp_m4_format_opaque_of(DCP_M4_XRGB2101010), DCP_M4_XRGB2101010);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_format_valid(DCP_M4_ARGB2101010));
+	KUNIT_EXPECT_FALSE(test, dcp_m4_format_valid((enum dcp_m4_frame_format)4));
+}
+
+/* The 8888 surface as the encoder wrote it before 10-bit formats existed. */
+static void frame_surface_8888_reference(u8 *s, const struct dcp_m4_frame *f)
+{
+	u32 size = f->stride * f->height;
+
+	memset(s, 0, DCP_M4_SURFACE_SIZE);
+	s[2] = f->format == DCP_M4_XRGB8888;
+	put_unaligned_le32(1, s + 3);
+	put_unaligned_le32(1, s + 7);
+	put_unaligned_le32(0x42475241, s + 0x0b);
+	s[DCP_M4_SURFACE_XFER] = DCP_M4_XFER_SRGB;
+	s[DCP_M4_SURFACE_PRIMARIES] = DCP_M4_PRIMARIES_P3_D65;
+	put_unaligned_le32(f->stride, s + 0x15);
+	put_unaligned_le16(1, s + 0x19);
+	s[0x1b] = 1;
+	s[0x1c] = 1;
+	put_unaligned_le32(f->width, s + 0x21);
+	put_unaligned_le32(f->height, s + 0x25);
+	put_unaligned_le32(size, s + 0x29);
+	put_unaligned_le32(1, s + 0x35);
+	put_unaligned_le64(1, s + 0x51);
+	put_unaligned_le32(f->width, s + 0x59);
+	put_unaligned_le32(f->height, s + 0x5d);
+	put_unaligned_le32(f->stride, s + 0x69);
+	put_unaligned_le32(size, s + 0x6d);
+	put_unaligned_le16(4, s + 0x71);
+	s[0x73] = 1;
+	s[0x74] = 1;
+	put_unaligned_le64(1, s + 0x149);
+}
+
+static void frame_surface_encoding(struct kunit *test)
+{
+	static const enum dcp_m4_frame_format fmts[] = {
+		DCP_M4_XRGB8888, DCP_M4_ARGB8888, DCP_M4_XRGB2101010, DCP_M4_ARGB2101010,
+	};
+	u8 *s = kunit_kzalloc(test, DCP_M4_SURFACE_SIZE, GFP_KERNEL);
+	u8 *ref = kunit_kzalloc(test, DCP_M4_SURFACE_SIZE, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, s);
+	KUNIT_ASSERT_NOT_NULL(test, ref);
+	for (unsigned int i = 0; i < ARRAY_SIZE(fmts); i++) {
+		struct dcp_m4_frame f = {
+			.dva = 1ULL << 40, .backing_size = 3072ULL * 4 * 1964,
+			.width = 3024, .height = 1964, .stride = 3072 * 4, .format = fmts[i],
+		};
+		bool ten = dcp_m4_format_10bit(fmts[i]);
+
+		dcp_m4_surface_encode(s, &f);
+		/* The reference has the 8888 component of the same alpha rule. */
+		f.format = dcp_m4_format_opaque(fmts[i]) ? DCP_M4_XRGB8888 : DCP_M4_ARGB8888;
+		frame_surface_8888_reference(ref, &f);
+		if (ten)
+			put_unaligned_le32(0x6c313072, ref + 0x0b);
+		KUNIT_EXPECT_MEMEQ(test, s, ref, DCP_M4_SURFACE_SIZE);
+		/* 'l10r' in memory is 72 30 31 6c. */
+		if (ten) {
+			KUNIT_EXPECT_EQ(test, s[0x0b], 0x72);
+			KUNIT_EXPECT_EQ(test, s[0x0e], 0x6c);
+		}
+		/* 4 bytes a pixel and the SDR colour tags for every format. */
+		KUNIT_EXPECT_EQ(test, get_unaligned_le16(s + 0x71), 4);
+		KUNIT_EXPECT_EQ(test, s[DCP_M4_SURFACE_XFER], 13);
+		KUNIT_EXPECT_EQ(test, s[DCP_M4_SURFACE_PRIMARIES], 12);
+	}
+}
+
+static struct kunit_case m4_frame_cases[] = {
+	KUNIT_CASE(frame_drm_formats),
+	KUNIT_CASE(frame_format_helpers),
+	KUNIT_CASE(frame_surface_encoding),
+	{}
+};
+
+static struct kunit_suite m4_frame_suite = {
+	.name = "apple-dcp-m4-frame",
+	.test_cases = m4_frame_cases,
+};
+
+kunit_test_suite(m4_frame_suite);
diff --git a/drivers/gpu/drm/apple/dcp-m4-frame.h b/drivers/gpu/drm/apple/dcp-m4-frame.h
index fdec5ae942..fc6106f114 100644
--- a/drivers/gpu/drm/apple/dcp-m4-frame.h
+++ b/drivers/gpu/drm/apple/dcp-m4-frame.h
@@ -10,6 +10,7 @@
 #include <linux/unaligned.h>
 #include "dcp-m4-profile.h"
 #include "dcp-m4-edr.h"
+#include <drm/drm_fourcc.h>
 
 /* Qualified firmware-26.6.2 swap and physical panel dimensions. */
 #define DCP_M4_SWAP_SIZE		(dcp_m4_pf->swap_size)
@@ -21,8 +22,76 @@
 enum dcp_m4_frame_format {
 	DCP_M4_XRGB8888,
 	DCP_M4_ARGB8888,
+	DCP_M4_XRGB2101010,
+	DCP_M4_ARGB2101010,
 };
 
+/*
+ * Surface pixel formats, as the firmware's u32 OSType at surface +0x0b:
+ *  'BGRA' 0x42475241: DRM [A|X]RGB8888 (B, G, R, A bytes in memory).
+ *  'l10r' 0x6c313072: CoreVideo kCVPixelFormatType_ARGB2101010LEPacked,
+ *         "little-endian ARGB2101010 full-range": DRM [A|X]RGB2101010
+ *         (A 31:30, R 29:20, G 19:10, B 9:0 of a little-endian u32).
+ * Both are 4 bytes a pixel, one linear plane; nothing else in the surface
+ * differs. The extended-range 'w30r' and FP16 'RGhA' are not used.
+ */
+#define DCP_M4_FOURCC_BGRA	0x42475241U
+#define DCP_M4_FOURCC_L10R	0x6c313072U
+
+static inline bool dcp_m4_format_valid(enum dcp_m4_frame_format format)
+{
+	switch (format) {
+	case DCP_M4_XRGB8888:
+	case DCP_M4_ARGB8888:
+	case DCP_M4_XRGB2101010:
+	case DCP_M4_ARGB2101010:
+		return true;
+	}
+	return false;
+}
+
+static inline bool dcp_m4_format_10bit(enum dcp_m4_frame_format format)
+{
+	return format == DCP_M4_XRGB2101010 || format == DCP_M4_ARGB2101010;
+}
+
+static inline u32 dcp_m4_format_fourcc(enum dcp_m4_frame_format format)
+{
+	return dcp_m4_format_10bit(format) ? DCP_M4_FOURCC_L10R : DCP_M4_FOURCC_BGRA;
+}
+
+/* X formats carry don't-care alpha: present them premultiplied (surface +2). */
+static inline bool dcp_m4_format_opaque(enum dcp_m4_frame_format format)
+{
+	return format == DCP_M4_XRGB8888 || format == DCP_M4_XRGB2101010;
+}
+
+/* The opaque format of the same depth (a cache of a frame keeps its depth). */
+static inline enum dcp_m4_frame_format dcp_m4_format_opaque_of(enum dcp_m4_frame_format format)
+{
+	return dcp_m4_format_10bit(format) ? DCP_M4_XRGB2101010 : DCP_M4_XRGB8888;
+}
+
+/* DRM primary-plane formats the panel's single-surface path presents. */
+static inline int dcp_m4_drm_format(u32 fourcc, enum dcp_m4_frame_format *format)
+{
+	switch (fourcc) {
+	case DRM_FORMAT_XRGB8888:
+		*format = DCP_M4_XRGB8888;
+		return 0;
+	case DRM_FORMAT_ARGB8888:
+		*format = DCP_M4_ARGB8888;
+		return 0;
+	case DRM_FORMAT_XRGB2101010:
+		*format = DCP_M4_XRGB2101010;
+		return 0;
+	case DRM_FORMAT_ARGB2101010:
+		*format = DCP_M4_ARGB2101010;
+		return 0;
+	}
+	return -EINVAL;
+}
+
 struct dcp_m4_frame {
 	u64 dva;
 	u64 backing_size;
@@ -43,7 +112,7 @@ static inline int dcp_m4_frame_check(const struct dcp_m4_frame *frame)
 	    !size || size > 0xffffffffULL || frame->backing_size < size ||
 	    !frame->dva || frame->dva % 0x4000 || frame->dva >= (1ULL << 42) ||
 	    size > (1ULL << 42) - frame->dva ||
-	    (frame->format != DCP_M4_XRGB8888 && frame->format != DCP_M4_ARGB8888))
+	    !dcp_m4_format_valid(frame->format))
 		return -EINVAL;
 	return 0;
 }
@@ -83,11 +152,12 @@ static inline int dcp_m4_direct_extent(u64 dva, u64 mapped, u64 needed)
 
 /* Describe a qualified client framebuffer at its SID0 DVA; no CPU access. */
 static inline int dcp_m4_direct_frame(struct dcp_m4_frame *frame, u64 dva, u64 mapped,
-				      u32 width, u32 height, u32 pitch, bool alpha)
+				      u32 width, u32 height, u32 pitch,
+				      enum dcp_m4_frame_format format)
 {
 	*frame = (struct dcp_m4_frame) {
 		.dva = dva, .backing_size = mapped, .width = width, .height = height,
-		.stride = pitch, .format = alpha ? DCP_M4_ARGB8888 : DCP_M4_XRGB8888,
+		.stride = pitch, .format = format,
 	};
 	if (dcp_m4_direct_extent(dva, mapped, (u64)pitch * height))
 		return -ERANGE;
@@ -100,10 +170,10 @@ static inline void dcp_m4_surface_encode(u8 *surface, const struct dcp_m4_frame
 	u32 size = frame->stride * frame->height;
 
 	memset(surface, 0, DCP_M4_SURFACE_SIZE);
-	surface[2] = frame->format == DCP_M4_XRGB8888;
+	surface[2] = dcp_m4_format_opaque(frame->format);
 	put_unaligned_le32(1, surface + 3);
 	put_unaligned_le32(1, surface + 7);
-	put_unaligned_le32(0x42475241, surface + 0x0b);
+	put_unaligned_le32(dcp_m4_format_fourcc(frame->format), surface + 0x0b);
 	surface[DCP_M4_SURFACE_XFER] = frame->pq ? DCP_M4_XFER_PQ : DCP_M4_XFER_SRGB;
 	surface[DCP_M4_SURFACE_PRIMARIES] = frame->pq ? DCP_M4_PRIMARIES_BT2020 :
 						      DCP_M4_PRIMARIES_P3_D65;
diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index 4387e46888..fcf45c2c98 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -3783,6 +3783,12 @@ static int dcp_m4_idle_cache_enter(struct iomfb_m4 *dcp)
 	/* The cache surface is tagged SDR; keep EDR frames out of it (TO-VERIFY). */
 	if (dcp->active_frame.pq || dcp->edr.hm)
 		return 0;
+	/*
+	 * The firmware fills the cache from the frame on screen: give it the
+	 * frame's depth, so a 10-bit desktop is not cached at 8 bits. Both
+	 * formats are 4 bytes a pixel, so the surface size is the same.
+	 */
+	r->idle_frame.format = dcp_m4_format_opaque_of(dcp->active_frame.format);
 	ret = dcp_m4_runtime_live(r);
 	if (ret)
 		return ret;
@@ -3889,17 +3895,17 @@ int iomfb_m4_present(struct apple_dcp *owner, struct drm_framebuffer *fb,
 {
 	struct iomfb_m4 *dcp = owner->v26_6;
 	struct drm_framebuffer *retire = NULL;
+	enum dcp_m4_frame_format format;
 	struct dcp_m4_frame frame;
 	u64 now;
 	int ret;
 
 	if (!dcp || !dcp->runtime || !fb || fb->format->num_planes != 1 ||
 	    fb->offsets[0] || fb->modifier != DRM_FORMAT_MOD_LINEAR ||
-	    (fb->format->format != DRM_FORMAT_XRGB8888 &&
-	     fb->format->format != DRM_FORMAT_ARGB8888))
+	    dcp_m4_drm_format(fb->format->format, &format))
 		return -EINVAL;
 	ret = dcp_m4_direct_frame(&frame, dva, mapped, fb->width, fb->height,
-				  fb->pitches[0], fb->format->format == DRM_FORMAT_ARGB8888);
+				  fb->pitches[0], format);
 	if (ret)
 		return ret;
 	/* A power-down not yet started is not needed; one under way finishes first. */
diff --git a/drivers/gpu/drm/apple/iomfb_m4_present.h b/drivers/gpu/drm/apple/iomfb_m4_present.h
index 6f51b93613..7c4dda841b 100644
--- a/drivers/gpu/drm/apple/iomfb_m4_present.h
+++ b/drivers/gpu/drm/apple/iomfb_m4_present.h
@@ -16,12 +16,12 @@ static inline int iomfb_m4_plane_frame(const struct drm_plane_state *state,
 				       struct dcp_m4_frame *frame)
 {
 	struct drm_framebuffer *fb = state->fb;
+	enum dcp_m4_frame_format format;
 	struct drm_gem_dma_object *obj;
 
 	if (!fb || fb->format->num_planes != 1 || fb->offsets[0] ||
 	    fb->modifier != DRM_FORMAT_MOD_LINEAR ||
-	    (fb->format->format != DRM_FORMAT_XRGB8888 &&
-	     fb->format->format != DRM_FORMAT_ARGB8888) ||
+	    dcp_m4_drm_format(fb->format->format, &format) ||
 	    state->src_x || state->src_y || state->crtc_x || state->crtc_y ||
 	    state->src_w != (u64)width << 16 || state->src_h != (u64)height << 16 ||
 	    state->crtc_w != width || state->crtc_h != height)
@@ -30,8 +30,7 @@ static inline int iomfb_m4_plane_frame(const struct drm_plane_state *state,
 	if (!obj)
 		return -EINVAL;
 	return dcp_m4_direct_frame(frame, obj->dma_addr, obj->base.size,
-				   fb->width, fb->height, fb->pitches[0],
-				   fb->format->format == DRM_FORMAT_ARGB8888);
+				   fb->width, fb->height, fb->pitches[0], format);
 }
 
 #endif
diff --git a/drivers/gpu/drm/apple/plane.c b/drivers/gpu/drm/apple/plane.c
index a8c37e29ed..5bfddbb38c 100644
--- a/drivers/gpu/drm/apple/plane.c
+++ b/drivers/gpu/drm/apple/plane.c
@@ -864,6 +864,8 @@ struct drm_plane *apple_plane_init_v14_7(struct drm_device *dev,
 static const u32 dcp_primary_formats_v26_6[] = {
 	DRM_FORMAT_XRGB8888,
 	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_XRGB2101010,
+	DRM_FORMAT_ARGB2101010,
 };
 
 static int apple_plane_atomic_check_v26_6(struct drm_plane *plane,
