From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 01:11:48 +0000
Subject: [PATCH] arm64: dts: apple: t8132-j604: describe ANS's APCIe
 block for a deep sleep

Give the J604's PCIe host the windows of the block ANS's link shares, from
the J604 ADT's /arm-io/apcie: reg[4] axi2af, reg[5] cio3pll, reg[6]
clkgen, reg[2] phy-block and reg[3] phy-ip (the 26B123 and 25G83 ADTs
agree), next to the six it had. The boot loader publishes their tables
from the same ADT.

Point the suspend-to-RAM node at that host, and at the AP pin controller
whose pins a deep sleep resets. The pins the J604 ADT's gpio0 lists in
no-restore-gpio-pins (136, 137 and 10, both captures) are left alone.

Only the T8132 sequence (apple_s2r.t8132_sequence, off by default) uses
the new windows and the apcie link; the pin save and restore run only
around a suspend-to-RAM, which is not offered without it.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
index 1548d40287..0261dbfdbd 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132-j604-lab.dtsi
@@ -93,6 +93,14 @@
 		 * MTP.OutboxNotEmpty, the ones macOS enables.
 		 */
 		apple,wake-enable = <145 69 161 183 85 104>;
+		/* ANS's APCIe block, lowered at the commit and raised on the wake */
+		apple,apcie = <&pcie0>;
+		/*
+		 * The AP pins a deep sleep resets; the J604 ADT's gpio0
+		 * no-restore-gpio-pins (both captures: 136 137 10) are left alone.
+		 */
+		apple,pinctrl = <&pinctrl_ap>;
+		apple,pinctrl-skip-pins = <136 137 10>;
 		status = "okay";
 	};
 	dpaudio1: audio-controller-1 {
@@ -1348,6 +1356,26 @@
 };
 
 &pcie0 {
+	/*
+	 * The six of t8132-apcie-port2.dtsi, then the parts of the block ANS's link
+	 * shares, which apple-s2r's T8132 sequence lowers and raises: the J604 ADT's
+	 * /arm-io/apcie reg[4] (axi2af), [5] (cio3pll), [6] (clkgen), [2] (phy-block)
+	 * and [3] (phy-ip); 26B123 and 25G83 agree. Their tables come from the boot
+	 * loader (m1n1 1.611, aura#112), from this machine's own ADT.
+	 */
+	reg = <0x1c 0xb0000000 0x0 0x10000000>,	/* config */
+	      <0x4 0x94000000 0x0 0x4000>,		/* common */
+	      <0x4 0x90028000 0x0 0x8000>,		/* port 0 */
+	      <0x4 0x97020000 0x0 0x4000>,		/* port 0 PHY glue */
+	      <0x4 0x92028000 0x0 0x8000>,		/* port 2 */
+	      <0x4 0x97028000 0x0 0x4000>,		/* port 2 PHY glue */
+	      <0x4 0x96000000 0x0 0x1000000>,	/* ADT apcie reg[4] */
+	      <0x4 0x95046200 0x0 0x4000>,		/* ADT apcie reg[5] */
+	      <0x4 0x95044000 0x0 0x4000>,		/* ADT apcie reg[6] */
+	      <0x4 0x97000000 0x0 0x40000>,	/* ADT apcie reg[2] */
+	      <0x4 0x97040000 0x0 0x20000>;	/* ADT apcie reg[3] */
+	reg-names = "config", "rc", "port0", "phy0", "port2", "phy2",
+		    "axi2af", "cio3pll", "clkgen", "phy-block", "phy-ip";
 	/delete-property/ apple,managed-sids;
 	power-domains = <&ps_apcie_phy_sw>;
 	pinctrl-0 = <&pcie_pins>;
