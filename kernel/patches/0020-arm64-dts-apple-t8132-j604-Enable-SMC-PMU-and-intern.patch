From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 3 Nov 2026 22:55:22 -0600
Subject: [PATCH] arm64: dts: apple: t8132-j604: Enable SMC, PMU and internal
 SSD

Enable the nodes the MacBook Pro (14-inch, M4, 2024) needs to reach its
root filesystem: the SMC with its mailbox (reboot and RTC), the nub SPMI
bus with the Abbey PMU and its scratch nvmem cells, and the ANS mailbox,
SART and NVMe controller of the internal SSD.

Every value is checked against Apple's J604 template device tree from
the 25G83 and 26B123 IPSWs (DeviceTree.j604ap.im4p) with dtverify; the
DTV-* tags name the rows of DT-VERIFY.tsv. The PMU cell offsets come from
the pmu-main info-* properties (pm_setting 0x2001, clock_offset
0x2100+6, leg_scrpad 0xf800, fault_shadow 0x867b+0x10, scrpad_socd
0x8b00+0x1800), with the leg_scrpad +1/+2/+0xf layout used by t8103,
t8112 and t6030/t6031.

PCIe (Wi-Fi, Bluetooth, SD reader) and the MTP keyboard and trackpad are
left disabled until their power-enable and loader handoff are verified.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 arch/arm64/boot/dts/apple/t8132-j604.dts | 96 +++++++++++++++++++++++-
 1 file changed, 94 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index c4be915cb3..7390f9578a 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -5,6 +5,10 @@
  * target-type: J604
  *
  * Copyright The Asahi Linux Contributors
+ *
+ * DTV-<id> tags name rows of DT-VERIFY.tsv, which records where each value
+ * comes from and checks it against the J604 device tree (Apple template DT
+ * from the IPSW, or a live IODeviceTree capture) and against this DTB.
  */
 
 /dts-v1/;
@@ -14,7 +18,7 @@
 #include <dt-bindings/leds/common.h>
 
 / {
-	compatible = "apple,j604", "apple,t8132", "apple,arm-platform";
+	compatible = "apple,j604", "apple,t8132", "apple,arm-platform"; /* DTV-ROOT-1 */
 	model = "Apple MacBook Pro (14-inch, M4, 2024)";
 
 	led-controller {
@@ -31,5 +35,93 @@
 };
 
 &fpwm1 {
-	status = "okay";
+	status = "okay"; /* DTV-FPWM1-3 */
+};
+
+/* SMC: reboot, RTC and the PMU scratch cells */
+
+&smc_mbox {
+	status = "okay"; /* DTV-SMC-4, DTV-SMC-5 */
+};
+
+&smc {
+	status = "okay"; /* DTV-SMC-1..3 */
+
+	smc_reboot: reboot {
+		compatible = "apple,smc-reboot";
+		nvmem-cells = <&shutdown_flag>, <&boot_stage>,
+			      <&boot_error_count>, <&panic_count>;
+		nvmem-cell-names = "shutdown_flag", "boot_stage",
+				   "boot_error_count", "panic_count";
+	};
+
+	smc_rtc: rtc {
+		compatible = "apple,smc-rtc";
+		nvmem-cells = <&rtc_offset>;
+		nvmem-cell-names = "rtc_offset";
+	};
+};
+
+&nub_spmi {
+	status = "okay"; /* DTV-SPMI-1, DTV-SPMI-2 */
+
+	pmic1: pmic@e {
+		compatible = "apple,abbey-pmic", "apple,spmi-nvmem"; /* DTV-PMU-2 */
+		reg = <0xe SPMI_USID>; /* DTV-PMU-1 */
+
+		nvmem-layout {
+			compatible = "fixed-layout";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			pm_setting: pm-setting@2001 {
+				reg = <0x2001 0x1>; /* DTV-PMU-3 */
+			};
+
+			rtc_offset: rtc-offset@2100 {
+				reg = <0x2100 0x6>; /* DTV-PMU-4 */
+			};
+
+			fault_shadow: fault-shadow@867b {
+				reg = <0x867b 0x10>; /* DTV-PMU-8 */
+			};
+
+			socd: socd@8b00 {
+				reg = <0x8b00 0x1800>; /* DTV-PMU-9 */
+			};
+
+			boot_stage: boot-stage@f801 {
+				reg = <0xf801 0x1>; /* DTV-PMU-5 */
+			};
+
+			boot_error_count: boot-error-count@f802,0 {
+				reg = <0xf802 0x1>; /* DTV-PMU-6 */
+				bits = <0 4>;
+			};
+
+			panic_count: panic-count@f802,4 {
+				reg = <0xf802 0x1>; /* DTV-PMU-6 */
+				bits = <4 4>;
+			};
+
+			shutdown_flag: shutdown-flag@f80f,3 {
+				reg = <0xf80f 0x1>; /* DTV-PMU-7 */
+				bits = <3 1>;
+			};
+		};
+	};
+};
+
+/* Internal SSD */
+
+&ans_mbox {
+	status = "okay"; /* DTV-ANS-1, DTV-ANS-2 */
+};
+
+&sart {
+	status = "okay"; /* DTV-ANS-3..5 */
+};
+
+&nvme {
+	status = "okay"; /* DTV-ANS-6..12 */
 };
