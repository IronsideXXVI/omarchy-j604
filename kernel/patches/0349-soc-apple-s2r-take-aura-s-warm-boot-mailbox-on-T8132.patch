+/*
+ * aura's warm boot mailbox, /chosen/aurora,s2r-mailbox (aurora-silicon/aura
+ * 30896625, "kboot: let an OS at EL2 return from its own sleep"). aura
+ * publishes it only when a running secondary's locked RVBAR leads back into
+ * its image. On a core reset the boot core (boot_mpidr) jumps to resume_pa at
+ * EL2 with the MMU and caches off, or reboots if it is 0; aura then clears
+ * resume_pa and counts the resume. It takes no flags, and its reset paths
+ * stay off the console once the mailbox is out.
+ */
+struct apple_s2r_aura_mailbox {
+	__le64 magic;
+	__le64 boot_mpidr;
+	__le64 resume_pa;
+	__le64 resumes;
+};
+
+#define S2R_AURA_MAGIC		0x3152325341525541ULL	/* "AURAS2R1" */
+
 /*
  * Steps taken by ->enter() that the resume path must undo. The same bits
  * select steps to leave out with the skip parameter.
@@ -791,6 +809,9 @@ struct apple_s2r {
 	void __iomem *timer;
 	void __iomem *wdt;
 	struct apple_s2r_mailbox *mailbox;
