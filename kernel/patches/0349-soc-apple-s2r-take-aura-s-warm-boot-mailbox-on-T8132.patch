 		if (!ab || (!t8132_sequence && ab > S2R_STEP_CLKGEN))
@@ -4068,6 +4099,15 @@ static void apple_s2r_wake(void)
 		WRITE_ONCE(mb->magic, 0);
 		WRITE_ONCE(mb->flags, 0);
