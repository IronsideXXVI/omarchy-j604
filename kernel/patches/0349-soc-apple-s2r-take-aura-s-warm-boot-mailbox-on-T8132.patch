-	WRITE_ONCE(mb->flags, cpu_to_le64(flags));
-	WRITE_ONCE(mb->magic, cpu_to_le64(S2R_MAGIC));
-	dcache_clean_poc((unsigned long)mb, (unsigned long)(mb + 1));
+	if (s2r->aura) {
+		s2r->aura_resumes = le64_to_cpu(READ_ONCE(s2r->aura->resumes));
+		WRITE_ONCE(s2r->aura->resume_pa,
+			   cpu_to_le64(__pa_symbol(apple_s2r_t8132_resume)));
+		dcache_clean_poc((unsigned long)s2r->aura, (unsigned long)(s2r->aura + 1));
+	} else {
+		WRITE_ONCE(mb->entry, cpu_to_le64(__pa_symbol(apple_s2r_t8132_resume)));
+		WRITE_ONCE(mb->arg, 0);
+		WRITE_ONCE(mb->flags, cpu_to_le64(flags));
+		WRITE_ONCE(mb->magic, cpu_to_le64(S2R_MAGIC));
