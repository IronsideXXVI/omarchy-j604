diff --git a/tools/asahi/s2r-aura-mailbox-tests.py b/tools/asahi/s2r-aura-mailbox-tests.py
new file mode 100755
index 0000000000..73f0788cdd
--- /dev/null
+++ b/tools/asahi/s2r-aura-mailbox-tests.py
@@ -0,0 +1,130 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Check apple-s2r's and apple_cpu's use of aura's warm boot mailbox.
+
+aura (aurora-silicon/aura 30896625) publishes /chosen/aurora,s2r-mailbox: a
+32-byte mailbox of magic "AURAS2R1", boot_mpidr, resume_pa and resumes. The
+boot core takes resume_pa at EL2 with the MMU off, or reboots if it is 0, and
+aura counts the resume. This checks, from the sources, that the kernel's
+struct has aura's layout and magic; that m1n1's mailbox is still preferred
+and aura's taken only without it; that the magic, the boot CPU and a locked
+RVBAR shared by the online cores are checked at probe; that a T8132 sleep arms
+resume_pa with the resume stub and touches m1n1's mailbox only without aura;
+that the wake reads the resume count and clears resume_pa; that aura is
+refused outside the T8132 sequence; and that apple_cpu treats aura's re-entry
+as quiet.
+"""
+import argparse
+from pathlib import Path
+import re
+import struct
+
+ROOT = Path(__file__).resolve().parents[2]
+AURA_FIELDS = ['magic', 'boot_mpidr', 'resume_pa', 'resumes']
+MUTATIONS = {
+    'magic-wrong': ('0x3152325341525541ULL', '0x3152325341525542ULL'),
+    'layout-swap': ('\t__le64 resume_pa;\n\t__le64 resumes;\n', '\t__le64 resumes;\n\t__le64 resume_pa;\n'),
+    'aura-first': ('\tif (of_property_read_u64(of_chosen, "asahi,s2r-mailbox", &mailbox)) {\n'
+                   '\t\tif (!of_property_read_u64(of_chosen, "aurora,s2r-mailbox", &mailbox))',
+                   '\tif (of_property_read_u64(of_chosen, "aurora,s2r-mailbox", &mailbox)) {\n'
+                   '\t\tif (!of_property_read_u64(of_chosen, "asahi,s2r-mailbox", &mailbox))'),
+    'no-magic-check': ('\t\tif (magic != S2R_AURA_MAGIC)\n', '\t\tif (0)\n'),
+    'no-mpidr-check': ('\t\tif (mpidr != cpu_logical_map(0))\n', '\t\tif (0)\n'),
+    'no-lock-check': ('\t\tif (!(val & IMPL_RVBAR_LOCK) || !s2r->reset_vector)\n',
+                      '\t\tif (!s2r->reset_vector)\n'),
+    'wrong-entry': ('cpu_to_le64(__pa_symbol(apple_s2r_t8132_resume)));\n\t\tdcache_clean_poc((unsigned long)s2r->aura',
+                    'cpu_to_le64(__pa_symbol(cpu_resume)));\n\t\tdcache_clean_poc((unsigned long)s2r->aura'),
+    'arm-no-clean': ('\t\tdcache_clean_poc((unsigned long)s2r->aura, (unsigned long)(s2r->aura + 1));\n', ''),
+    'wake-no-clear': ('\t\tWRITE_ONCE(am->resume_pa, 0);\n', ''),
+    'no-refuse': ('\tif (s2r->aura && !t8132_sequence)\n\t\treturn -EOPNOTSUPP;\n', ''),
+    'cpu-no-aura': ('\t\tapple_reentry.mode = APPLE_REENTRY_AURA;\n', ''),
+}
+
+
+def fn_body(src, head):
+    at = src.index(head)
+    return src[at:src.index('\n}\n', at)]
+
+
+def check(s2r, cpu):
+    m = re.search(r'struct apple_s2r_aura_mailbox \{(.*?)\};', s2r, re.S)
+    assert m, 'Assertion failed: no struct apple_s2r_aura_mailbox'
+    fields = re.findall(r'__le64 (\w+);', m.group(1))
+    assert fields == AURA_FIELDS, f'Assertion failed: aura mailbox layout {fields}, want {AURA_FIELDS}'
+    magic = int(re.search(r'#define S2R_AURA_MAGIC\s+(0x[0-9a-fA-F]+)ULL', s2r).group(1), 16)
+    assert struct.pack('<Q', magic) == b'AURAS2R1', f'Assertion failed: magic {magic:#x} is not "AURAS2R1"'
+
+    probe = fn_body(s2r, 'static int apple_s2r_probe(struct platform_device *pdev)')
+    i_m1n1 = probe.find('of_property_read_u64(of_chosen, "asahi,s2r-mailbox", &mailbox)')
+    i_aura = probe.find('of_property_read_u64(of_chosen, "aurora,s2r-mailbox", &mailbox)')
+    assert 0 <= i_m1n1 < i_aura, "Assertion failed: m1n1's mailbox must be looked up first"
+    for need in ('if (magic != S2R_AURA_MAGIC)', 'if (mpidr != cpu_logical_map(0))',
+                 'apple_s2r_verify_reset_vector(s2r, true)', 'apple_s2r_verify_reset_vector(s2r, false)'):
+        assert need in probe, f'Assertion failed: probe lacks {need}'
+
+    ver = fn_body(s2r, 'static int apple_s2r_verify_reset_vector(struct apple_s2r *s2r, bool aura)')
+    assert 'if (!(val & IMPL_RVBAR_LOCK) || !s2r->reset_vector)' in ver, \
+        'Assertion failed: aura needs a locked RVBAR'
+    assert ver.find('s2r->reset_vector = val & IMPL_RVBAR_ADDR;') < ver.find('ret = apple_s2r_check_rvbar(s2r, cpu);'), \
+        'Assertion failed: every online core must be checked against the vector read'
+
+    fin = fn_body(s2r, 'static int apple_s2r_t8132_finish(unsigned long arg)')
+    arm = fin[fin.index('\tif (s2r->aura) {'):fin.index('writel(S2R_TIMER_START, t->commit);')]
+    aura_part, _, m1n1_part = arm.partition('\t} else {')
+    assert 'WRITE_ONCE(s2r->aura->resume_pa,\n\t\t\t   cpu_to_le64(__pa_symbol(apple_s2r_t8132_resume)));' in aura_part, \
+        'Assertion failed: resume_pa must be the T8132 resume stub'
+    assert 'dcache_clean_poc((unsigned long)s2r->aura, (unsigned long)(s2r->aura + 1));' in aura_part, \
+        'Assertion failed: the armed mailbox must be cleaned to the PoC'
+    assert 's2r->aura_resumes = le64_to_cpu(READ_ONCE(s2r->aura->resumes));' in aura_part, \
+        'Assertion failed: the resume count must be read before the commit'
+    assert 'mb->' not in aura_part and 'mb->magic' in m1n1_part, \
+        "Assertion failed: m1n1's mailbox may only be written without aura"
+
+    wake = fn_body(s2r, 'static void apple_s2r_wake(void)')
+    aw = wake[wake.index('} else if (s2r->aura) {'):]
