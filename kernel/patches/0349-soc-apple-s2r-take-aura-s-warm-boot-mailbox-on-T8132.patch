+		dcache_clean_inval_poc((unsigned long)am, (unsigned long)(am + 1));
+		if (le64_to_cpu(READ_ONCE(am->resumes)) != s2r->aura_resumes)
+			flags |= S2R_FLAG_RESUMED;
+		WRITE_ONCE(am->resume_pa, 0);
+		dcache_clean_poc((unsigned long)am, (unsigned long)(am + 1));
 	}
 
 	if (s2r->resumed)
@@ -4217,19 +4257,27 @@ static void apple_s2r_unmap_rvbars(void *data)
  * the reset vector the boot firmware verified. Every online core must already
