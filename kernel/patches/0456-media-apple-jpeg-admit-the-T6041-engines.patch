From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Sat, 7 Nov 2026 01:27:46 +1100
Subject: [PATCH] media: apple: jpeg: admit the T6041 engines

The M4 Pro/Max JPEG engines identify as 0x101008 rather than the Neo's
0x110000, but they use the same register layout and encode programming:
64-bit address pairs, HWREV at 0x1c4 and the same job sequence. Accept the
T6041 revision under the existing stepping mask so probe no longer refuses
it, and cover the new admission in the KUnit identity test.

Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Assisted-by: LLM
(cherry picked from commit 538f63d289bfe86ca1fe0940ca22513c32938914)
---
 drivers/media/platform/apple/jpeg/apple-jpeg-hw.h   | 12 ++++++++++--
 drivers/media/platform/apple/jpeg/apple-jpeg-test.c |  4 ++++
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/apple/jpeg/apple-jpeg-hw.h b/drivers/media/platform/apple/jpeg/apple-jpeg-hw.h
index 35b4e9ab49..38d8b20eb9 100644
--- a/drivers/media/platform/apple/jpeg/apple-jpeg-hw.h
+++ b/drivers/media/platform/apple/jpeg/apple-jpeg-hw.h
@@ -85,6 +85,8 @@
 #define AJ_QTBL(t)			(0x1100 + 0x40 * (t))
 
 #define AJ_HWREV_MASK			0xffff0fff
+/* ADT hw-type 0x101008; its stepping nibble is masked off like T8140's. */
+#define AJ_HWREV_T6041			0x100008
 #define AJ_HWREV_T8140			0x110000
 
 struct apple_jpeg_variant {
@@ -92,8 +94,14 @@ struct apple_jpeg_variant {
 	u32 hwrev;
 };
 
-/* T6041 has the engine too, but its register layout is not qualified. */
-static const struct apple_jpeg_variant apple_jpeg_t6041 = { };
+/*
+ * T6041 identifies as 0x101008 but uses the same 64-bit address layout and
+ * encode programming as T8140.
+ */
+static const struct apple_jpeg_variant apple_jpeg_t6041 = {
+	.hwrev_mask = AJ_HWREV_MASK,
+	.hwrev = AJ_HWREV_T6041,
+};
 
 static const struct apple_jpeg_variant apple_jpeg_t8140 = {
 	.hwrev_mask = AJ_HWREV_MASK,
diff --git a/drivers/media/platform/apple/jpeg/apple-jpeg-test.c b/drivers/media/platform/apple/jpeg/apple-jpeg-test.c
index 3676647b7d..8f8d49ade8 100644
--- a/drivers/media/platform/apple/jpeg/apple-jpeg-test.c
+++ b/drivers/media/platform/apple/jpeg/apple-jpeg-test.c
@@ -15,6 +15,10 @@ static void apple_jpeg_hwrev_test(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t8140, 0));
 	KUNIT_EXPECT_FALSE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t8140, U32_MAX));
 	KUNIT_EXPECT_FALSE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t6041, 0x110000));
+	KUNIT_EXPECT_TRUE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t6041, 0x101008));
+	KUNIT_EXPECT_TRUE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t6041, 0x10f008));
+	KUNIT_EXPECT_FALSE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t6041, 0x101009));
+	KUNIT_EXPECT_FALSE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t8140, 0x101008));
 	KUNIT_EXPECT_FALSE(test, apple_jpeg_hwrev_supported(NULL, 0x110000));
 }
 
