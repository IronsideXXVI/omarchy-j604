From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 20:38:12 +0000
Subject: [PATCH] drm/apple: m4: send HDR10 static metadata to the
 dcpext AV service

An HDR10 link carries the sink's Dynamic Range and Mastering InfoFrame,
which the DCP builds from the HDR static metadata the host gives its
DCPAV service (dcpav-service-epic, selector 0x15), as on desktop 26.x
DCPs. The T8132 external DCP's endpoints are started with log-only
service handlers, so none is ever sent.

Keep the dcpav-service-epic instance an external DCP announces, and
reuse the desktop message builders (dcp-hdr-metadata.h): send the
connector's HDR_OUTPUT_METADATA once the link runs PQ, after the mode
set and whenever the block changes (compared, never per frame), and
stop the InfoFrame (selector 0x14) before the link leaves PQ, on the
CRTC's disable. A mode set or a new link starts without metadata.
Without the service a PQ link still goes, without mastering data, and
says so once.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
(cherry picked from commit 7b1307aa8c71d6edff25f60b09f553f00fa592ae)
---
 drivers/gpu/drm/apple/iomfb_m4.c      | 175 ++++++++++++++++++++++++++
 drivers/gpu/drm/apple/iomfb_m4.h      |  13 ++
 drivers/gpu/drm/apple/t8132_ext_drm.c |   8 ++
 3 files changed, 196 insertions(+)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index e4cc4a26e6..854eed604a 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -67,6 +67,7 @@
 #include "dcp-m4-frame.h"
 #include "dcp-m4-xdr.h"
 #include "dcp-m4-ext-colour.h"
+#include "dcp-hdr-metadata.h"
 #include "parser.h"
 #include "t8132_ext_drm.h"
 
@@ -314,6 +315,15 @@ struct iomfb_m4 {
 	 * not, as the one before it, until the next confirmed swap retires both.
 	 */
 	struct drm_framebuffer *lost_fb;
+	/*
+	 * An external DCP's DCPAV service (dcpav-service-epic), for HDR10
+	 * static metadata; the block last sent on the PQ link and whether its
+	 * InfoFrame is up (ext_av_lock).
+	 */
+	spinlock_t ext_av_lock;
+	struct apple_epic_service *ext_av;
+	u8 ext_hdr_sent[DCP_HDR_DATA_SIZE];
+	bool ext_hdr_valid, ext_infoframe, ext_av_missing_said;
 	struct dcp_m4_frame active_frame;
 	u64 flips, blanks, brightness_swaps;
 	/*
@@ -3050,6 +3060,7 @@ int iomfb_m4_init(struct apple_dcp *owner)
 	mutex_init(&dcp->lock);
 	mutex_init(&dcp->ext_modes_lock);
 	spin_lock_init(&dcp->state_lock);
+	spin_lock_init(&dcp->ext_av_lock);
 	init_completion(&dcp->reply);
 	INIT_DELAYED_WORK(&dcp->backlight_work, iomfb_m4_backlight_work);
 	spin_lock_init(&dcp->ext_put_lock);
@@ -3114,7 +3125,60 @@ static void dcp_m4_probe_init(struct apple_epic_service *service, const char *na
 		service->ep->endpoint, service->channel, name ?: "", class ?: "", unit);
 }
 
+/*
+ * The DCPAV service of an external DCP: HDR10 static metadata, as desktop
+ * 26.x DCPs take it (dcp-hdr-metadata.h). A new instance has sent nothing.
+ */
+static void dcp_m4_ext_av_init(struct apple_epic_service *service, const char *name,
+			       const char *class, s64 unit)
+{
+	struct iomfb_m4 *dcp = service->ep->dcp->v26_6;
+	struct apple_epic_service *old;
+
+	dcp_m4_probe_init(service, name, class, unit);
+	if (!dcp || !dcp->external)
+		return;
+	service = afk_service_get(service);
+	if (!service)
+		return;
+	scoped_guard(spinlock_irqsave, &dcp->ext_av_lock) {
+		old = dcp->ext_av;
+		dcp->ext_av = service;
+		dcp->ext_hdr_valid = false;
+		dcp->ext_infoframe = false;
+	}
+	if (old)
+		afk_service_put(old);
+	dev_info(dcp->dev, "DCPAV service on ep %02x: HDR10 static metadata\n",
+		 service->ep->endpoint);
+}
+
+static void dcp_m4_ext_av_teardown(struct apple_epic_service *service)
+{
+	struct iomfb_m4 *dcp = service->ep->dcp->v26_6;
+	bool owned = false;
+
+	if (!dcp)
+		return;
+	scoped_guard(spinlock_irqsave, &dcp->ext_av_lock) {
+		owned = dcp->ext_av == service;
+		if (owned) {
+			dcp->ext_av = NULL;
+			dcp->ext_hdr_valid = false;
+			dcp->ext_infoframe = false;
+		}
+	}
+	if (owned)
+		afk_service_put(service);
+}
+
 static const struct apple_epic_service_ops dcp_m4_probe_ops[] = {
+	{
+		.name = "dcpav-service-epic",
+		.reusable = true,
+		.init = dcp_m4_ext_av_init,
+		.teardown = dcp_m4_ext_av_teardown,
+	},
 	{
 		.name = "*",
 		.init = dcp_m4_probe_init,
@@ -3692,6 +3756,13 @@ void iomfb_m4_external_link_gone(struct apple_dcp *owner)
 	/* The next sink's timing catalog is its own, nothing received before. */
 	if (dcp && dcp->external)
 		dcp_m4_ext_sink_gone(dcp, true);
+	/* HDR10 metadata is link state: a new link starts without it. */
+	if (dcp && dcp->external) {
+		scoped_guard(spinlock_irqsave, &dcp->ext_av_lock) {
+			dcp->ext_hdr_valid = false;
+			dcp->ext_infoframe = false;
+		}
+	}
 	/* No sink until the next D575 reports one. */
 	if (dcp && dcp->external && READ_ONCE(dcp->ext_sink)) {
 		WRITE_ONCE(dcp->ext_sink, false);
@@ -5288,6 +5359,11 @@ int iomfb_m4_ext_enable(struct apple_dcp *owner, const struct iomfb_m4_ext_ids *
 			 ids->depth ?: 8, ids->pq ? "HDR10 (ST 2084, BT.2020)" : "SDR");
 	r->ext_depth = ids->depth;
 	r->ext_pq = ids->pq;
+	/* A mode set starts the link without HDR10 metadata: sent again on PQ. */
+	scoped_guard(spinlock_irqsave, &dcp->ext_av_lock) {
+		dcp->ext_hdr_valid = false;
+		dcp->ext_infoframe = false;
+	}
 	r->ext_width = width;
 	r->ext_height = height;
 	/* After a swap given up on a live link, one swap may try (a probe). */
@@ -5987,6 +6063,105 @@ out:
  * surfaces off; the power and the mode stay (A473 0 is not sent). Nothing to
  * do without a mode or a sink.
  */
+/*
+ * Send the connector's HDR10 static metadata to the DCPAV service once the
+ * link runs PQ (after the mode set that chose the HDR10 element), and when it
+ * changes on it; never on an SDR link, never per frame (compared first).
+ * Without the service a PQ link still goes, without mastering data.
+ */
+void iomfb_m4_ext_hdr_sync(struct apple_dcp *owner, const struct drm_connector_state *state)
+{
+	struct iomfb_m4 *dcp = owner->v26_6;
+	u8 data[DCP_HDR_DATA_SIZE], msg[DCP_HDR_MSG_SIZE], reply[DCP_HDR_MSG_SIZE] = {};
+	struct apple_epic_service *service = NULL;
+	struct dcp_m4_runtime *r;
+	size_t received = 0;
+	u32 retcode = 0;
+	bool same = false, missing = false;
+	int ret;
+
+	if (!dcp || !dcp->external || READ_ONCE(dcp->error) || !state ||
+	    !state->hdr_output_metadata ||
+	    state->hdr_output_metadata->length != sizeof(struct hdr_output_metadata))
+		return;
+	/* Pairs with the release store of dcp->runtime in startup. */
+	r = smp_load_acquire(&dcp->runtime);
+	if (!r || !READ_ONCE(r->ext_pq) ||
+	    ((const struct hdr_output_metadata *)state->hdr_output_metadata->data)
+		    ->hdmi_metadata_type1.eotf != HDMI_EOTF_SMPTE_ST2084 ||
+	    dcp_hdr_data(data, state->hdr_output_metadata->data))
+		return;
+	scoped_guard(spinlock_irqsave, &dcp->ext_av_lock) {
+		same = dcp->ext_hdr_valid && !memcmp(dcp->ext_hdr_sent, data, sizeof(data));
+		if (!same)
+			service = afk_service_get(dcp->ext_av);
+		missing = !same && !service && !dcp->ext_av_missing_said;
+		if (missing)
+			dcp->ext_av_missing_said = true;
+	}
+	if (missing)
+		dev_info(dcp->dev, "PQ link without a DCPAV service: no HDR10 static metadata\n");
+	if (!service)
+		return;
+	dcp_hdr_message(msg, data);
+	ret = afk_send_command_with_reply_len(service, EPIC_SUBTYPE_STD_SERVICE, msg, sizeof(msg),
+					      reply, sizeof(reply), &retcode, &received);
+	ret = dcp_hdr_reply(ret, retcode, reply, received);
+	/* A block refused is not sent again for every frame: a new one, mode or service is. */
+	if (ret)
+		dev_warn_ratelimited(dcp->dev, "HDR10 static metadata not taken: %d\n", ret);
+	else
+		dev_info(dcp->dev, "HDR10 static metadata: MaxCLL %u MaxFALL %u mastering %u/%u\n",
+			 get_unaligned_le16(data + 20), get_unaligned_le16(data + 22),
+			 get_unaligned_le16(data + 16), get_unaligned_le16(data + 18));
+	scoped_guard(spinlock_irqsave, &dcp->ext_av_lock) {
+		if (dcp->ext_av == service) {
+			memcpy(dcp->ext_hdr_sent, data, sizeof(data));
+			dcp->ext_hdr_valid = true;
+			if (!ret)
+				dcp->ext_infoframe = true;
+		}
+	}
+	afk_service_put(service);
+}
+
+/*
+ * Before a link leaves PQ (a mode set or a disable): clear the Dynamic Range
+ * and Mastering InfoFrame (selector 0x14) as macOS does, so the sink is not
+ * left an HDR InfoFrame for an SDR signal.
+ */
+void iomfb_m4_ext_hdr_stop(struct apple_dcp *owner)
+{
+	struct iomfb_m4 *dcp = owner->v26_6;
+	u8 msg[DCP_HDR_STOP_SIZE], reply[DCP_HDR_STOP_SIZE] = {};
+	struct apple_epic_service *service = NULL;
+	size_t received = 0;
+	u32 retcode = 0;
+	int ret;
+
+	if (!dcp || !dcp->external || READ_ONCE(dcp->error))
+		return;
+	scoped_guard(spinlock_irqsave, &dcp->ext_av_lock) {
+		if (dcp->ext_infoframe)
+			service = afk_service_get(dcp->ext_av);
+		dcp->ext_hdr_valid = false;
+	}
+	if (!service)
+		return;
+	dcp_hdr_stop_message(msg);
+	ret = afk_send_command_with_reply_len(service, EPIC_SUBTYPE_STD_SERVICE, msg, sizeof(msg),
+					      reply, sizeof(reply), &retcode, &received);
+	ret = dcp_hdr_stop_reply(ret, retcode, reply, received);
+	if (ret)
+		dev_warn(dcp->dev, "HDR10 InfoFrame not stopped: %d\n", ret);
+	else
+		dev_info(dcp->dev, "HDR10 InfoFrame stopped\n");
+	scoped_guard(spinlock_irqsave, &dcp->ext_av_lock)
+		if (dcp->ext_av == service)
+			dcp->ext_infoframe = false;
+	afk_service_put(service);
+}
+
 int iomfb_m4_ext_blank(struct apple_dcp *owner)
 {
 	struct iomfb_m4 *dcp = owner->v26_6;
diff --git a/drivers/gpu/drm/apple/iomfb_m4.h b/drivers/gpu/drm/apple/iomfb_m4.h
index d2194b1a3e..efc9ed6a9a 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.h
+++ b/drivers/gpu/drm/apple/iomfb_m4.h
@@ -11,6 +11,7 @@ struct device;
 struct dentry;
 struct drm_atomic_commit;
 struct drm_connector;
+struct drm_connector_state;
 struct drm_crtc;
 struct drm_display_mode;
 struct drm_rect;
@@ -81,6 +82,9 @@ int iomfb_m4_ext_enable(struct apple_dcp *dcp, const struct iomfb_m4_ext_ids *id
 int iomfb_m4_ext_present(struct apple_dcp *dcp, const struct iosys_map *src, u32 pitch,
 			 const struct drm_rect *damage);
 int iomfb_m4_ext_blank(struct apple_dcp *dcp);
+/* HDR10 static metadata of a PQ link's connector state; the InfoFrame stopped. */
+void iomfb_m4_ext_hdr_sync(struct apple_dcp *dcp, const struct drm_connector_state *state);
+void iomfb_m4_ext_hdr_stop(struct apple_dcp *dcp);
 /* 0 once submitted, its flip later (t8132_ext_drm_flip_done()); 1: its flip now. */
 int iomfb_m4_ext_present_direct(struct apple_dcp *dcp, const struct iomfb_m4_ext_fb *fb);
 /* Why an external DCP's display refuses system sleep, or NULL. */
@@ -162,6 +166,15 @@ static inline int iomfb_m4_ext_present(struct apple_dcp *dcp, const struct iosys
 	return -ENODEV;
 }
 
+static inline void iomfb_m4_ext_hdr_sync(struct apple_dcp *dcp,
+					 const struct drm_connector_state *state)
+{
+}
+
+static inline void iomfb_m4_ext_hdr_stop(struct apple_dcp *dcp)
+{
+}
+
 static inline int iomfb_m4_ext_blank(struct apple_dcp *dcp) { return -ENODEV; }
 static inline int iomfb_m4_ext_present_direct(struct apple_dcp *dcp,
 					      const struct iomfb_m4_ext_fb *fb)
diff --git a/drivers/gpu/drm/apple/t8132_ext_drm.c b/drivers/gpu/drm/apple/t8132_ext_drm.c
index e4cebe1e92..0bdc8bda4e 100644
--- a/drivers/gpu/drm/apple/t8132_ext_drm.c
+++ b/drivers/gpu/drm/apple/t8132_ext_drm.c
@@ -230,6 +230,9 @@ static void t8132_ext_crtc_disable(struct drm_crtc *crtc, struct drm_atomic_comm
 
 	cancel_delayed_work_sync(&out->flip_work);
 	t8132_ext_send_event(out);
+	/* The HDR10 InfoFrame goes before the link leaves PQ (mode set or off). */
+	if (owner)
+		iomfb_m4_ext_hdr_stop(owner);
 	if (owner)
 		ret = iomfb_m4_ext_blank(owner);
 	dev_info(&out->pdev->dev, "%s off: %d\n", crtc->name, ret);
@@ -510,6 +513,11 @@ static void t8132_ext_crtc_flush(struct drm_crtc *crtc, struct drm_atomic_commit
 	 * at any time from then on (t8132_ext_drm_flip_done()).
 	 */
 	event = t8132_ext_hold_event(out, cs);
+	/* A PQ link's HDR10 metadata, before its frame (compared, not per frame). */
+	if (cs->active && t8132_ext_owner(out))
+		iomfb_m4_ext_hdr_sync(t8132_ext_owner(out),
+				      drm_atomic_get_new_connector_state(state, &out->connector) ?:
+				      out->connector.state);
 	ret = t8132_ext_present(out, state);
 	/* Its damage is lost with it: whole frames until one is shown. */
 	if (ret <= 0)
