From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 00:56:11 +0000
Subject: [PATCH] drm/apple: m4: optionally give J604 panel swaps a
 presentation target

Internal-panel swaps on the J604 carry the constant 120 in their timing
words, a target that is always past: the firmware shows each frame at the
panel's next 4.17 ms tick, at least 8.33 ms after the previous one. With a
desktop at a fixed 120 Hz and 1080p60 video, about a fifth of the frames
were then shown 12.5 or 20.9 ms after the previous one instead of 16.7 ms,
and holding the adaptive-sync minimum at 120 Hz did not change that.

The 14.x code notes that counter values in these words made a T6031
firmware time out; what the 26.6.2 firmware on the J604 does with a target
in the architectural counter's time base has not been tried.

Add swap_target (0644, default 0 = the constant, unchanged) and
swap_target_lead_us (default 2000). At 1 the first word is the counter
at submission; at 2 it is the first 120 Hz tick at least the lead ahead,
on the grid through the counter value taken at the last swap
completion. These are for measuring on the machine before anything
changes by default.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/gpu/drm/apple/iomfb_m4.c | 48 +++++++++++++++++++++++++++++++-
 1 file changed, 47 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index e916f55ebc..30b414bd21 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -23,6 +23,8 @@
 #include <linux/delay.h>
 #include <linux/jiffies.h>
 #include <linux/ktime.h>
+#include <linux/math64.h>
+#include <asm/arch_timer.h>
 #include <linux/minmax.h>
 #include <linux/unaligned.h>
 #include <linux/workqueue.h>
@@ -177,6 +179,16 @@ module_param(swap_timestamps, bool, 0644);
 MODULE_PARM_DESC(swap_timestamps,
 		 "J604: stamp presents with the swap timing words so the 120 Hz panel shows them at 120 Hz, not 60 Hz (default: on; applies from the next swap; J713: no effect)");
 
+static unsigned int swap_target;
+module_param(swap_target, uint, 0644);
+MODULE_PARM_DESC(swap_target,
+		 "J604: presentation target in the first timing word of internal-panel swaps: 0 = 120, always past, \"as soon as possible\" (default); 1 = the architectural counter at submission; 2 = the next 120 Hz tick of the grid of the last swap completion at least swap_target_lead_us ahead (experimental; applies from the next swap)");
+
+static unsigned int swap_target_lead_us = 2000;
+module_param(swap_target_lead_us, uint, 0644);
+MODULE_PARM_DESC(swap_target_lead_us,
+		 "J604: with swap_target=2, how far ahead of submission the target tick must be, us (default 2000)");
+
 static bool panel_edr;
 /* Given on the command line or written: the machine default stays out. */
 static bool panel_edr_given;
@@ -1070,6 +1082,8 @@ struct dcp_m4_ext_done {
 
 struct dcp_m4_runtime {
 	struct iomfb_m4 *dcp;
+	/* Architectural counter at the internal panel's last swap completion (swap_target) */
+	u64 int_done_cnt;
 	struct dcp_m4_properties *properties;
 	struct dcp_m4_timing timing;
 	struct dcp_m4_swap_state swap;
@@ -1696,6 +1710,7 @@ static int dcp_m4_runtime_swap_done(void *cookie, u32 id)
 		/* The late D590 of a probe given up is not this swap's. */
 		if (dcp_m4_int_late_d590(r, id))
 			return 0;
+		WRITE_ONCE(r->int_done_cnt, __arch_counter_get_cntpct());
 		return dcp_m4_swap_record_done(&r->swap, id);
 	}
 	r->ext_done.valid = false;
@@ -2551,6 +2566,32 @@ static bool dcp_m4_ext_swap_give_up(struct dcp_m4_runtime *r, struct dcp_m4_swap
  * primary/frame/upper/keep as dcp_m4_swap_encode_full(); a nonzero intent
  * retargets the swap as dcp_m4_swap_set_intent() describes.
  */
+
+/*
+ * The first timing word of an internal-panel swap (swap_target): 0 keeps the
+ * constant 120 of dcp_m4_swap_set_timing(). 1 is the counter now. 2 is the
+ * first tick at least swap_target_lead_us ahead on the 120 Hz grid through the
+ * counter value taken at the last swap completion, so frames are asked for on
+ * one phase of the panel's refresh instead of its next 4.17 ms tick.
+ */
+static u64 dcp_m4_swap_target(struct dcp_m4_runtime *r)
+{
+	unsigned int mode = READ_ONCE(swap_target);
+	u64 freq, now, base, earliest, period;
+
+	if (!mode)
+		return 0;
+	now = __arch_counter_get_cntpct();
+	if (mode == 1)
+		return now;
+	freq = arch_timer_get_cntfrq();
+	base = READ_ONCE(r->int_done_cnt);
+	period = div_u64(freq, 120);
+	if (!base || !period || base > now)
+		return 0;
+	earliest = now + div_u64(freq * READ_ONCE(swap_target_lead_us), USEC_PER_SEC);
+	return base + div64_u64(earliest - base + period - 1, period) * period;
+}
 static int dcp_m4_runtime_swap_full(struct dcp_m4_runtime *r, bool primary,
 		const struct dcp_m4_frame *frame, const struct dcp_m4_upper *upper, u32 keep,
 		bool brightness_change, u32 nits, u32 intent, u32 surface_id)
@@ -2646,8 +2687,13 @@ static int dcp_m4_runtime_swap_full(struct dcp_m4_runtime *r, bool primary,
 	 * intent and an external output keep zero words.
 	 */
 	if (!ret && !ext && primary && frame && !intent && dcp_m4_pf->swap_timestamps &&
-	    READ_ONCE(swap_timestamps))
+	    READ_ONCE(swap_timestamps)) {
+		u64 target = dcp_m4_swap_target(r);
+
 		dcp_m4_swap_set_timing(input);
+		if (target)
+			put_unaligned_le64(target, input);
+	}
 	if (!ret && intent)
 		dcp_m4_swap_set_intent(input, intent, surface_id);
 	if (!ret && primary && frame && !intent && r->level)
