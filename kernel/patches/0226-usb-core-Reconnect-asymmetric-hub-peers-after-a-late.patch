From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Tue, 20 Oct 2026 11:36:57 +1100
Subject: [PATCH] usb: core: Reconnect asymmetric hub peers after a late
 SuperSpeed connection

On J700, the rear connector's USB2 path goes through a fixed hub while
SuperSpeed goes directly to xHCI. The fixed host starts USB2 before the
Type-C mux can configure the SS lanes. Moving the PIPE with only the SS
root port off leaves the external hub's USB2 subtree enumerated, so its
SS-capable devices can remain at high speed when the SS hub connects.

Resolve port peers by their firmware connector, following a two-sided
mode switch when necessary. Use raw xHCI port numbers for root-port OF
lookups, retaining logical graph numbering for older DTBs. Describe
the SS path by its connector; the companion device-tree
change gives J700's SS endpoint raw port 2.

After an SS hub's initial power-up and debounce, queue one reconnect of
the USB2 hub on its asymmetric peer. Process it on the USB2 parent's hub
worker with references to both observed hubs and recheck identity,
connection state and administrative ownership before switching power.
Use the existing lane-change power helpers and do not nest peer hub
locks. Latch a successful handover until a physical USB2 connection change
so that loss of the SS half during a bus-powered hub cycle cannot loop.

Cover the reconnect decision with the software-HCD port-power KUnit
suite. Add debug messages at mux and power-handover milestones to
separate PHY readiness from enumeration blocked on the shared address
zero mutex in subsequent cold-boot captures.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/phy/apple/atc.c            |   3 +
 drivers/usb/core/hub.c             |  92 ++++++++++
 drivers/usb/core/hub.h             |  40 +++++
 drivers/usb/core/of.c              |  78 ++++++++-
 drivers/usb/core/port-power-test.c | 273 +++++++++++++++++++++++++++++
 drivers/usb/core/port.c            |  33 +++-
 include/linux/usb/of.h             |   7 +
 7 files changed, 523 insertions(+), 3 deletions(-)

diff --git a/drivers/phy/apple/atc.c b/drivers/phy/apple/atc.c
index 2d46bf6ac6..9ea9eee7de 100644
--- a/drivers/phy/apple/atc.c
+++ b/drivers/phy/apple/atc.c
@@ -4927,6 +4927,7 @@ static int atcphy_mux_update(struct apple_atcphy *atcphy, const struct typec_mux
 		in_mode = atcphy_mux_in_mode(atcphy, target_mode);
 	}
 
+	dev_dbg(atcphy->dev, "mux target=%u: waiting for SuperSpeed root\n", target_mode);
 	ret = atcphy_usb3_pm_get(atcphy, &pm);
 	if (ret)
 		goto out;
@@ -4951,6 +4952,8 @@ static int atcphy_mux_update(struct apple_atcphy *atcphy, const struct typec_mux
 		atcphy->usb3_port_off = !ret;
 
 	ret = atcphy_mux_set_locked(atcphy, target_mode, &port_on);
+	dev_dbg(atcphy->dev, "mux target=%u: configured ret=%d restore=%u\n",
+		target_mode, ret, port_on);
 	usb_err = false;
 	if (port_on) {
 		int err = atcphy_usb3_port_on(atcphy, &pm);
diff --git a/drivers/usb/core/hub.c b/drivers/usb/core/hub.c
index f2e6718c3d..214c4d0233 100644
--- a/drivers/usb/core/hub.c
+++ b/drivers/usb/core/hub.c
@@ -1081,6 +1081,38 @@ enum hub_activation_type {
 	HUB_POST_RESET, HUB_RESUME, HUB_RESET_RESUME,
 };
 
+static void hub_reconnect_ss_peer(struct usb_hub *hub)
+{
+	struct usb_device *ss = hub->hdev;
+	struct usb_hub *parent, *hs_hub;
+	struct usb_port *upstream, *peer;
+
+	if (!ss->parent || !hub_is_superspeed(ss))
+		return;
+
+	guard(mutex)(&usb_port_peer_mutex);
+	parent = usb_hub_to_struct_hub(ss->parent);
+	if (!parent || ss->portnum > ss->parent->maxchild)
+		return;
+	upstream = parent->ports[ss->portnum - 1];
+	peer = upstream->peer;
+	/* Only firmware-described, asymmetric paths need this handover. */
+	if (!upstream->connector_node || !peer)
+		return;
+	hs_hub = usb_hub_to_struct_hub(to_usb_device(peer->dev.parent->parent));
+	if (!hs_hub || hs_hub->disconnected || hs_hub->hdev->level == ss->parent->level)
+		return;
+
+	/* Disconnect publishes child = NULL under device_state_lock. */
+	scoped_guard(spinlock_irq, &device_state_lock) {
+		if (!peer->child || peer->reconnect_ss || peer->ss_reconnected)
+			return;
+		peer->reconnect_hs = usb_get_dev(peer->child);
+		peer->reconnect_ss = usb_get_dev(ss);
+	}
+	kick_hub_wq(hs_hub);
+}
+
 static void hub_init_func2(struct work_struct *ws);
 static void hub_init_func3(struct work_struct *ws);
 
@@ -1337,6 +1369,10 @@ static void hub_activate(struct usb_hub *hub, enum hub_activation_type type)
  init3:
 	hub->quiescing = 0;
 
+	/* The SS hub's ports are powered and debounced before USB2 restarts. */
+	if (type == HUB_INIT2 || type == HUB_INIT3)
+		hub_reconnect_ss_peer(hub);
+
 	status = usb_submit_urb(hub->urb, GFP_NOIO);
 	if (status < 0)
 		dev_err(hub->intfdev, "activate --> %d\n", status);
@@ -2215,6 +2251,7 @@ int usb_hub_port_power_off(struct usb_device *hdev, int port1)
 		goto put_port;
 	}
 
+	dev_dbg(&port_dev->dev, "lane handover: power off\n");
 	/* The runtime PM reference is dropped once the hold ends. */
 	port_dev->held_off = !disabled;
 	/* Nothing hub_wq still has queued for the port applies to it off. */
@@ -2280,6 +2317,7 @@ int usb_hub_port_power_on(struct usb_device *hdev, int port1)
 	ret = usb_hub_set_port_power(hdev, hub, port1, true);
 	if (!ret) {
 		msleep(hub_power_on_good_delay(hub));
+		dev_dbg(&port_dev->dev, "lane handover: power on\n");
 		if (hub_is_superspeed(hdev))
 			set_bit(port1, hub->warm_reset_bits);
 		set_bit(port1, hub->change_bits);
@@ -5619,6 +5657,10 @@ static void hub_port_connect(struct usb_hub *hub, int port1, u16 portstatus,
 	static int unreliable_port = -1;
 	bool retry_locked;
 
+	/* Consume our own reconnect once; physical changes start a new attachment. */
+	scoped_guard(mutex, &usb_port_peer_mutex)
+		usb_port_ss_reconnect_event(port_dev, portstatus, portchange);
+
 	/* Disconnect any existing devices under this port */
 	if (udev) {
 		if (hcd->usb_phy && !hdev->parent)
@@ -6092,6 +6134,52 @@ static void port_event(struct usb_hub *hub, int port1)
 		hub_port_connect_change(hub, port1, portstatus, portchange);
 }
 
+/* Process on the USB2 parent's worker: never nest the two peer hub locks. */
+static void hub_port_reconnect_ss(struct usb_hub *hub, int port1)
+{
+	struct usb_port *port = hub->ports[port1 - 1];
+	struct usb_device *hs, *ss;
+	bool reconnect;
+	int ret;
+
+	scoped_guard(mutex, &usb_port_peer_mutex) {
+		hs = port->reconnect_hs;
+		ss = port->reconnect_ss;
+		port->reconnect_hs = NULL;
+		port->reconnect_ss = NULL;
+		if (!ss)
+			return;
+		reconnect = usb_port_needs_ss_reconnect(port, hs, ss);
+	}
+	if (!reconnect)
+		goto out;
+
+	dev_info(&port->dev, "reconnecting USB2 hub after late SuperSpeed connection\n");
+	ret = usb_hub_port_power_off(hub->hdev, port1);
+	if (ret)
+		goto report;
+	/* Power loss can reconnect the SS half too; it must not start a loop. */
+	scoped_guard(mutex, &usb_port_peer_mutex) {
+		port->ss_reconnected = true;
+		port->ss_reconnect_pending = true;
+	}
+
+	/* A transient control-transfer error must not strand the powered-off hub. */
+	for (int retry = 0; retry < 5; retry++) {
+		ret = usb_hub_port_power_on(hub->hdev, port1);
+		if (ret >= 0)
+			break;
+		if (retry < 4)
+			msleep(100 << retry);
+	}
+report:
+	if (ret < 0)
+		dev_warn(&port->dev, "late SuperSpeed handover failed: %d\n", ret);
+ out:
+	usb_put_dev(hs);
+	usb_put_dev(ss);
+}
+
 static void hub_event(struct work_struct *work)
 {
 	struct usb_device *hdev;
@@ -6152,6 +6240,10 @@ static void hub_event(struct work_struct *work)
 		hub->error = 0;
 	}
 
+	/* Each request pins both observed devices and is consumed only once. */
+	for (i = 1; i <= hdev->maxchild; i++)
+		hub_port_reconnect_ss(hub, i);
+
 	/* deal with port status changes */
 	for (i = 1; i <= hdev->maxchild; i++) {
 		struct usb_port *port_dev = hub->ports[i - 1];
diff --git a/drivers/usb/core/hub.h b/drivers/usb/core/hub.h
index aabaf445b0..c095b77aaf 100644
--- a/drivers/usb/core/hub.h
+++ b/drivers/usb/core/hub.h
@@ -89,6 +89,11 @@ struct usb_hub {
  * @dev: generic device interface
  * @port_owner: port's owner
  * @peer: related usb2 and usb3 ports (share the same connector)
+ * @connector_node: firmware identity of the physical connector
+ * @reconnect_hs: USB2 hub observed before its SuperSpeed connection
+ * @reconnect_ss: SuperSpeed hub requesting that USB2 connection restart
+ * @ss_reconnected: the current USB2 attachment already had its late-SS handover
+ * @ss_reconnect_pending: consume the connection event from our own power cycle
  * @connector: USB Type-C connector
  * @req: default pm qos request for hubs without port power control
  * @connect_type: port's connect type
@@ -113,6 +118,9 @@ struct usb_port {
 	struct usb_dev_state *port_owner;
 	struct usb_port *peer;
 	struct typec_connector *connector;
+	struct device_node *connector_node;
+	struct usb_device *reconnect_hs;
+	struct usb_device *reconnect_ss;
 	struct dev_pm_qos_request *req;
 	enum usb_port_connect_type connect_type;
 	enum usb_device_state state;
@@ -130,8 +138,40 @@ struct usb_port {
 	unsigned int usb3_lpm_u2_permit:1;
 	bool disabled;
 	bool held_off;
+	bool ss_reconnected;
+	bool ss_reconnect_pending;
 };
 
+/* Caller holds the hub lock and usb_port_peer_mutex. */
+static inline void usb_port_ss_reconnect_event(struct usb_port *port, u16 status, u16 change)
+{
+	if (port->held_off ||
+	    (port->ss_reconnect_pending && !(status & USB_PORT_STAT_CONNECTION) &&
+	     !(change & USB_PORT_STAT_C_CONNECTION)))
+		return;
+	if (!(status & USB_PORT_STAT_CONNECTION) ||
+	    (!port->ss_reconnect_pending && (change & USB_PORT_STAT_C_CONNECTION)))
+		port->ss_reconnected = false;
+	port->ss_reconnect_pending = false;
+}
+
+/* A late SS hub may restart only the same, still-live USB3-capable USB2 hub. */
+static inline bool usb_port_needs_ss_reconnect(const struct usb_port *port,
+					       const struct usb_device *hs,
+					       const struct usb_device *ss)
+{
+	return hs && ss && !port->ss_reconnected && !port->is_superspeed &&
+	       port->child == hs && port->peer &&
+	       port->peer->is_superspeed && port->connector_node &&
+	       port->peer->connector_node == port->connector_node &&
+	       READ_ONCE(port->peer->child) == ss && !port->disabled && !port->held_off &&
+	       !port->port_owner && READ_ONCE(hs->state) == USB_STATE_CONFIGURED &&
+	       READ_ONCE(ss->state) == USB_STATE_CONFIGURED && hs->speed == USB_SPEED_HIGH &&
+	       ss->speed >= USB_SPEED_SUPER &&
+	       hs->descriptor.bDeviceClass == USB_CLASS_HUB &&
+	       ss->descriptor.bDeviceClass == USB_CLASS_HUB;
+}
+
 #define to_usb_port(_dev) \
 	container_of(_dev, struct usb_port, dev)
 
diff --git a/drivers/usb/core/of.c b/drivers/usb/core/of.c
index a6ee20d877..cce934a09c 100644
--- a/drivers/usb/core/of.c
+++ b/drivers/usb/core/of.c
@@ -10,6 +10,7 @@
 #include <linux/of.h>
 #include <linux/of_graph.h>
 #include <linux/usb/of.h>
+#include <linux/usb/hcd.h>
 
 /**
  * usb_of_get_device_node() - get a USB device node
@@ -90,6 +91,20 @@ static bool usb_of_has_devices_or_graph(const struct usb_device *hub)
 	return false;
 }
 
+/* Prefer raw controller numbering, retaining older logical root-port graphs. */
+static struct device_node *usb_of_get_port_endpoint(struct usb_device *hub, int port1)
+{
+	struct device_node *ep;
+	int raw_port = port1;
+
+	if (!hub->parent)
+		raw_port = usb_hcd_find_raw_port_number(bus_to_hcd(hub->bus), port1);
+	ep = of_graph_get_endpoint_by_regs(hub->dev.of_node, raw_port, -1);
+	if (!ep && raw_port != port1)
+		ep = of_graph_get_endpoint_by_regs(hub->dev.of_node, port1, -1);
+	return ep;
+}
+
 /**
  * usb_of_get_connect_type() - get a USB hub's port connect_type
  * @hub: hub to which port is for @port1
@@ -108,6 +123,7 @@ enum usb_port_connect_type usb_of_get_connect_type(struct usb_device *hub, int p
 {
 	struct device_node *np, *child, *ep, *remote_np;
 	enum usb_port_connect_type connect_type;
+	int raw_port = port1;
 
 	/* Only set connect_type if binding has ports/hardwired devices. */
 	if (!usb_of_has_devices_or_graph(hub))
@@ -117,12 +133,14 @@ enum usb_port_connect_type usb_of_get_connect_type(struct usb_device *hub, int p
 	connect_type = USB_PORT_NOT_USED;
 
 	np = hub->dev.of_node;
+	if (!hub->parent)
+		raw_port = usb_hcd_find_raw_port_number(bus_to_hcd(hub->bus), port1);
 	/*
 	 * Hotplug ports are connected to an available remote node, e.g.
 	 * usb-a-connector compatible node, in the OF graph.
 	 */
 	if (of_graph_is_present(np)) {
-		ep = of_graph_get_endpoint_by_regs(np, port1, -1);
+		ep = usb_of_get_port_endpoint(hub, port1);
 		if (ep) {
 			remote_np = of_graph_get_remote_port_parent(ep);
 			of_node_put(ep);
@@ -136,7 +154,7 @@ enum usb_port_connect_type usb_of_get_connect_type(struct usb_device *hub, int p
 	 * Hard-wired ports are child nodes with a reg property corresponding
 	 * to the port number, i.e. a usb device.
 	 */
-	child = usb_of_get_device_node(hub, port1);
+	child = usb_of_get_device_node(hub, raw_port);
 	if (of_device_is_available(child))
 		connect_type = USB_PORT_CONNECT_TYPE_HARD_WIRED;
 	of_node_put(child);
@@ -145,6 +163,62 @@ enum usb_port_connect_type usb_of_get_connect_type(struct usb_device *hub, int p
 }
 EXPORT_SYMBOL_GPL(usb_of_get_connect_type);
 
+/* Return a connector directly attached to an endpoint, or through one mux. */
+static struct device_node *usb_of_endpoint_connector(struct device_node *endpoint)
+{
+	struct device_node *remote __free(device_node) = of_graph_get_remote_endpoint(endpoint);
+	struct device_node *node __free(device_node) = of_graph_get_port_parent(remote);
+	struct device_node *other __free(device_node) = NULL;
+	struct device_node *ep;
+
+	if (of_device_is_compatible(node, "usb-c-connector") ||
+	    of_device_is_compatible(node, "usb-a-connector"))
+		return of_node_get(node);
+
+	/* A two-sided mode switch carries the same USB port to its connector. */
+	if (!of_property_present(node, "mode-switch"))
+		return NULL;
+	for_each_endpoint_of_node(node, ep) {
+		if (ep == remote)
+			continue;
+		if (other) {
+			of_node_put(ep);
+			return NULL;
+		}
+		other = of_node_get(ep);
+	}
+
+	struct device_node *connector __free(device_node) =
+		of_graph_get_remote_port_parent(other);
+
+	if (of_device_is_compatible(connector, "usb-c-connector") ||
+	    of_device_is_compatible(connector, "usb-a-connector"))
+		return of_node_get(connector);
+	return NULL;
+}
+
+/**
+ * usb_of_get_port_connector() - get a port's physical connector
+ * @hub: hub to which the port belongs
+ * @port1: one-based port number
+ *
+ * The USB2 and USB3 paths can pass through different hubs. Match their
+ * connector identity instead of assuming the same upstream port numbers.
+ * Hard-wired devices belong to the board, not the connector in its graph.
+ *
+ * Return: Connector node with a reference, or NULL if it is not described.
+ */
+struct device_node *usb_of_get_port_connector(struct usb_device *hub, int port1)
+{
+	struct device_node *ep __free(device_node) = NULL;
+
+	if (usb_of_get_connect_type(hub, port1) != USB_PORT_CONNECT_TYPE_HOT_PLUG)
+		return NULL;
+	ep = usb_of_get_port_endpoint(hub, port1);
+	return usb_of_endpoint_connector(ep);
+}
+EXPORT_SYMBOL_GPL(usb_of_get_port_connector);
+
 /**
  * usb_of_get_interface_node() - get a USB interface node
  * @udev: USB device of interface
diff --git a/drivers/usb/core/port-power-test.c b/drivers/usb/core/port-power-test.c
index 9fe6ef0eb6..4a105a2580 100644
--- a/drivers/usb/core/port-power-test.c
+++ b/drivers/usb/core/port-power-test.c
@@ -14,12 +14,16 @@
 #include <linux/file.h>
 #include <linux/fs.h>
 #include <linux/mount.h>
+#include <linux/of.h>
 #include <linux/pm_runtime.h>
 #include <linux/slab.h>
 #include <linux/unaligned.h>
 #include <linux/usb.h>
 #include <linux/usb/ch11.h>
 #include <linux/usb/hcd.h>
+#include <linux/usb/of.h>
+
+#include "hub.h"
 
 struct port_power_test_hc {
 	spinlock_t lock;	/* protects the port status, as hub_wq reads it too */
@@ -230,6 +234,11 @@ static int port_power_test_hub_status_data(struct usb_hcd *hcd, char *buf)
 	return 0;
 }
 
+static int port_power_test_raw_port(struct usb_hcd *hcd, int port1)
+{
+	return hcd->speed >= HCD_USB3 ? port1 + 1 : port1;
+}
+
 static const struct hc_driver port_power_test_hc_driver = {
 	.description = "usb-port-power-test",
 	.product_desc = "USB port power test controller",
@@ -243,6 +252,7 @@ static const struct hc_driver port_power_test_hc_driver = {
 	.get_frame_number = port_power_test_get_frame_number,
 	.hub_status_data = port_power_test_hub_status_data,
 	.hub_control = port_power_test_hub_control,
+	.find_raw_port_number = port_power_test_raw_port,
 };
 
 static void port_power_test_put_hcds(void *data)
@@ -649,7 +659,270 @@ static void port_power_test_unowned_off(struct kunit *test)
 	pm_runtime_enable(t->ss_port);
 }
 
+/* No device connects to the software HCD for these decision tests. */
+static void port_power_test_late_ss_decision(struct kunit *test)
+{
+	struct usb_device *hs = kunit_kzalloc(test, sizeof(*hs), GFP_KERNEL);
+	struct usb_device *ss = kunit_kzalloc(test, sizeof(*ss), GFP_KERNEL);
+	struct usb_port *port = kunit_kzalloc(test, sizeof(*port), GFP_KERNEL);
+	struct usb_port *peer = kunit_kzalloc(test, sizeof(*peer), GFP_KERNEL);
+	struct device_node *connector = kunit_kzalloc(test, sizeof(*connector), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, hs);
+	KUNIT_ASSERT_NOT_NULL(test, ss);
+	KUNIT_ASSERT_NOT_NULL(test, port);
+	KUNIT_ASSERT_NOT_NULL(test, peer);
+	KUNIT_ASSERT_NOT_NULL(test, connector);
+	hs->state = USB_STATE_CONFIGURED;
+	hs->speed = USB_SPEED_HIGH;
+	hs->descriptor.bDeviceClass = USB_CLASS_HUB;
+	ss->state = USB_STATE_CONFIGURED;
+	ss->speed = USB_SPEED_SUPER_PLUS;
+	ss->descriptor.bDeviceClass = USB_CLASS_HUB;
+	port->child = hs;
+	port->peer = peer;
+	port->connector_node = connector;
+	peer->child = ss;
+	peer->is_superspeed = true;
+	peer->connector_node = connector;
+
+	/* The SS half on the same connector proves USB3 support, even without BOS. */
+	KUNIT_EXPECT_TRUE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	hs->speed = USB_SPEED_FULL;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	hs->speed = USB_SPEED_HIGH;
+	hs->descriptor.bDeviceClass = USB_CLASS_MASS_STORAGE;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	hs->descriptor.bDeviceClass = USB_CLASS_HUB;
+	ss->descriptor.bDeviceClass = USB_CLASS_MASS_STORAGE;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	ss->descriptor.bDeviceClass = USB_CLASS_HUB;
+
+	port->ss_reconnected = true;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	port->ss_reconnected = false;
+
+	port->disabled = true;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	port->disabled = false;
+	port->held_off = true;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	port->held_off = false;
+	port->port_owner = (struct usb_dev_state *)test;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	port->port_owner = NULL;
+
+	/* A pending request cannot act on an unplug, replacement or changed peer. */
+	port->child = NULL;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	port->child = ss;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	port->child = hs;
+	peer->child = NULL;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	peer->child = ss;
+	peer->connector_node = NULL;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	peer->connector_node = connector;
+	ss->state = USB_STATE_NOTATTACHED;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	ss->state = USB_STATE_CONFIGURED;
+	hs->state = USB_STATE_NOTATTACHED;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	hs->state = USB_STATE_CONFIGURED;
+	port->peer = NULL;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+	port->peer = peer;
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, NULL, ss));
+	KUNIT_EXPECT_FALSE(test, usb_port_needs_ss_reconnect(port, hs, NULL));
+	KUNIT_EXPECT_TRUE(test, usb_port_needs_ss_reconnect(port, hs, ss));
+}
+
+static void port_power_test_late_ss_attachment(struct kunit *test)
+{
+	struct usb_port port = { .ss_reconnected = true, .ss_reconnect_pending = true };
+
+	/* A logical scan before the powered-on hub connects keeps the guard. */
+	usb_port_ss_reconnect_event(&port, 0, 0);
+	KUNIT_EXPECT_TRUE(test, port.ss_reconnected);
+	KUNIT_EXPECT_TRUE(test, port.ss_reconnect_pending);
+
+	/* Our own power-on does not request another power cycle. */
+	usb_port_ss_reconnect_event(&port, USB_PORT_STAT_CONNECTION, USB_PORT_STAT_C_CONNECTION);
+	KUNIT_EXPECT_TRUE(test, port.ss_reconnected);
+	KUNIT_EXPECT_FALSE(test, port.ss_reconnect_pending);
+
+	/* A fast unplug/replug may coalesce into a connected change event. */
+	usb_port_ss_reconnect_event(&port, USB_PORT_STAT_CONNECTION, USB_PORT_STAT_C_CONNECTION);
+	KUNIT_EXPECT_FALSE(test, port.ss_reconnected);
+
+	port.ss_reconnected = true;
+	port.ss_reconnect_pending = true;
+	port.held_off = true;
+	usb_port_ss_reconnect_event(&port, 0, USB_PORT_STAT_C_CONNECTION);
+	KUNIT_EXPECT_TRUE(test, port.ss_reconnected);
+	KUNIT_EXPECT_TRUE(test, port.ss_reconnect_pending);
+	port.held_off = false;
+	usb_port_ss_reconnect_event(&port, 0, USB_PORT_STAT_C_CONNECTION);
+	KUNIT_EXPECT_FALSE(test, port.ss_reconnected);
+	KUNIT_EXPECT_FALSE(test, port.ss_reconnect_pending);
+}
