From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sean Dolbec <sdolbec1@gmail.com>
Date: Mon, 2 Nov 2026 19:50:17 -0500
Subject: [PATCH] arm64: dts: apple: t8132: Power the PCIe ports with
 pwren-gpios

Describe the Wi-Fi/Bluetooth port's power enable (SMC GPIO 19) as
pwren-gpios on the root port, as the other Apple boards in this tree do.
pcie-apple then drives it itself, with its power-on delay, before the
link comes up. Before, the J773g used a fixed regulator through the
generic PCI power-control driver, with "pciclass,0604" root-port
compatibles. Both are outside apple,pcie.yaml, so dtbs_check refused
the J773g tree.

Drop the root-port compatibles and the regulator. The GPIO, polarity
and port are unchanged.

Signed-off-by: Sean Dolbec <sdolbec1@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t8132-j773g.dts | 9 +--------
 arch/arm64/boot/dts/apple/t8132.dtsi      | 3 ---
 2 files changed, 1 insertion(+), 11 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8132-j773g.dts b/arch/arm64/boot/dts/apple/t8132-j773g.dts
index 8fb264efdd..8c09229f69 100644
--- a/arch/arm64/boot/dts/apple/t8132-j773g.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j773g.dts
@@ -21,13 +21,6 @@
 		ethernet0 = &ethernet0;
 		wifi0 = &wifi0;
 	};
-
-	vreg_pcie0_port0: regulator-pcie0-port0 {
-		compatible = "regulator-fixed";
-		regulator-name = "pwren-pcie0-port0";
-		gpio = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;
-		enable-active-high;
-	};
 };
 
 /*
@@ -159,7 +152,7 @@
 };
 
 &pcie0_port0 {
-	power-supply = <&vreg_pcie0_port0>;
+	pwren-gpios = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;
 	bus-range = <1 1>;
 	status = "okay";
 
diff --git a/arch/arm64/boot/dts/apple/t8132.dtsi b/arch/arm64/boot/dts/apple/t8132.dtsi
index be0bec478b..1adafa4d44 100644
--- a/arch/arm64/boot/dts/apple/t8132.dtsi
+++ b/arch/arm64/boot/dts/apple/t8132.dtsi
@@ -619,7 +619,6 @@
 			status = "disabled";
 
 			pcie0_port0: pci@0,0 {
-				compatible = "pciclass,0604";
 				device_type = "pci";
 				reg = <0x0 0x0 0x0 0x0 0x0>;
 				reset-gpios = <&pinctrl_ap 163 GPIO_ACTIVE_LOW>;
@@ -640,7 +639,6 @@
 			};
 
 			pcie0_port1: pci@1,0 {
-				compatible = "pciclass,0604";
 				device_type = "pci";
 				reg = <0x800 0x0 0x0 0x0 0x0>;
 				reset-gpios = <&pinctrl_ap 164 GPIO_ACTIVE_LOW>;
@@ -661,7 +659,6 @@
 			};
 
 			pcie0_port2: pci@2,0 {
-				compatible = "pciclass,0604";
 				device_type = "pci";
 				reg = <0x1000 0x0 0x0 0x0 0x0>;
 				reset-gpios = <&pinctrl_ap 165 GPIO_ACTIVE_LOW>;
