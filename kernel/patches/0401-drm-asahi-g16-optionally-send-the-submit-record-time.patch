From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 13 Nov 2026 03:07:10 +0000
Subject: [PATCH] drm/asahi: g16: optionally send the submit record
 time on the stage clock

Each submit-pipe record starts with the architectural counter as read,
CNTPCT, which is 1 GHz on M4. Every stamp the firmware writes back runs
at 24 MHz on the same epoch, so a firmware that compares this word with
its own clock sees a time about 41 times later than now.

Add g16_submit_ts (runtime 0644, default 0, unchanged): 1 sends the
same instant converted to the 24 MHz stage clock, so one window can show
whether the firmware's start delay depends on this word.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/asahi/g16/engine.rs | 17 +++++++++++++++--
 drivers/gpu/drm/asahi/g16/params.rs | 19 +++++++++++++++++++
 2 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/engine.rs b/drivers/gpu/drm/asahi/g16/engine.rs
index 65de0eaeab..af9ed473fe 100644
--- a/drivers/gpu/drm/asahi/g16/engine.rs
+++ b/drivers/gpu/drm/asahi/g16/engine.rs
@@ -87,6 +87,19 @@ pub(crate) fn counter_hz() -> u64 {
     }
 }
 
+/// The submit-pipe record's time word (`g16_submit_ts`).
+fn submit_time() -> u64 {
+    let now = counter_ticks();
+    if super::params::submit_ts() == 0 {
+        return now;
+    }
+    let freq = counter_hz();
+    if freq == 0 {
+        return now;
+    }
+    mul_div(now, super::hw::COMMAND_TIMESTAMP_HZ, freq)
+}
+
 /// Counter value carried by a native 25G83 submit-pipe record.
 pub(crate) fn counter_ticks() -> u64 {
     #[cfg(target_arch = "aarch64")]
@@ -649,7 +662,7 @@ pub(crate) fn register_context(&mut self) -> Result {
         self.channels.post(
             Channel::Ta,
             &SubmitRecord {
-                unk_0: counter_ticks(),
+                unk_0: submit_time(),
                 qinfo: r.qinfo[0].va,
                 kind: 0,
                 head: 1,
@@ -1269,7 +1282,7 @@ fn publish_prefix_into(
                     ),
                 };
                 let record = SubmitRecord {
-                    unk_0: counter_ticks(),
+                    unk_0: submit_time(),
                     qinfo,
                     kind: channel as u32,
                     head: head as u16,
diff --git a/drivers/gpu/drm/asahi/g16/params.rs b/drivers/gpu/drm/asahi/g16/params.rs
index 4c74f068fe..c9f31d6182 100644
--- a/drivers/gpu/drm/asahi/g16/params.rs
+++ b/drivers/gpu/drm/asahi/g16/params.rs
@@ -531,6 +531,25 @@ pub(crate) fn kickfw() -> u32 {
     "G16: send the firmware kick with each publication (default 0: boot only; 1: before the stores; 2: after the channel doorbells; runtime 0644)"
 );
 
+/// Storage of `g16_submit_ts` (runtime 0644, default 0).
+static SUBMIT_TS: AtomicU32 = AtomicU32::new(0);
+
+/// The clock of the submit-pipe record's first word: 0 the architectural counter as read
+/// (1 GHz on M4), 1 the same instant on the firmware's stage clock (COMMAND_TIMESTAMP_HZ,
+/// 24 MHz), the clock of every stamp the firmware writes back.
+pub(crate) fn submit_ts() -> u32 {
+    SUBMIT_TS.load(Ordering::Relaxed).min(1)
+}
+
+live_u32_param!(
+    SUBMIT_TS_PARAM,
+    SUBMIT_TS_PARMTYPE,
+    SUBMIT_TS_PARM,
+    SUBMIT_TS,
+    "g16_submit_ts",
+    "G16: clock of the submit record time word (default 0: architectural counter; 1: firmware stage clock, 24 MHz; runtime 0644)"
+);
+
 /// Storage of `g16_effort` (runtime 0644, default 0).
 static EFFORT: AtomicU32 = AtomicU32::new(0);
 
-- 
