From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 06:47:28 +0000
Subject: [PATCH] accel/ane: power the H16 engine off when idle with
 programs loaded

The H16 idle power-off only runs with no program loaded: one process
that keeps a program open holds the five ANE power domains and the
three ANE DARTs until it closes it.

macOS on the J604 (M4 MacBook Pro 14", T8132) powers its ANE off 5 s
after the last request with programs and clients still open, and loads
them again at the next request: its HWDevicePowerOffTimer fired seven
times in two minutes on an idle desktop while the submit count went
from 0 to 42.

Do the same. Park the session with its programs 5 s after the last
request (h16_idle_off_loaded_ms, default 5000; 0 keeps the old
behaviour) and replay them behind their handles at the next request,
on the engine booted again from the verified preload, which is the
cold system sleep path. A close while parked needs no firmware and
only releases the program's memory; the wake holds the session lock
across the cold boot and replay so a close never runs beside them.
The wake message counts the programs it replayed.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/accel/ane/ane_h16_backend.c      | 56 ++++++++++++---
 drivers/accel/ane/ane_h16_program.c      | 32 ++++++++-
 drivers/accel/ane/ane_h16_program.h      |  1 +
 drivers/accel/ane/ane_h16_program_test.c | 90 ++++++++++++++++++++++++
 4 files changed, 169 insertions(+), 10 deletions(-)

diff --git a/drivers/accel/ane/ane_h16_backend.c b/drivers/accel/ane/ane_h16_backend.c
index 3ff054bbf4..feffb913ae 100644
--- a/drivers/accel/ane/ane_h16_backend.c
+++ b/drivers/accel/ane/ane_h16_backend.c
@@ -106,6 +106,8 @@ struct ane_h16_device {
 	/* Powered off while idle (slept too); the next request boots it cold. */
 	bool parked;
 	struct delayed_work idle;
+	/* When the last request ended (ns), for the idle power-off with programs. */
+	u64 idle_since;
 	/* genpd's transitions of each of the five domains across a sleep. */
 	struct ane_h16_genpd {
 		struct notifier_block nb;
@@ -662,12 +664,24 @@ static void ane_h16_sleep_resume(struct ane_h16_device *h)
  * (five domains and the three DARTs released) and the session parked; the
  * next LOAD or EXECUTE boots it cold from the preload again. 0 keeps the
  * engine powered from bring-up until reboot.
+ *
+ * With programs still loaded, macOS powers its ANE off 5 s after the last
+ * request all the same (HWDevicePowerOffTimer) and loads them again at the
+ * next one. h16_idle_off_loaded_ms does that here: the session is parked
+ * with its programs, which the next request replays behind their handles
+ * on the engine booted again from the preload, as after a cold system
+ * sleep. 0 keeps the engine powered while any program is loaded.
  */
 static unsigned int h16_idle_off_ms = 1000;
 module_param(h16_idle_off_ms, uint, 0644);
 MODULE_PARM_DESC(h16_idle_off_ms,
 		 "Power the H16 ANE off after this many idle ms with no program loaded (0: keep it powered; default: 1000)");
 
+static unsigned int h16_idle_off_loaded_ms = 5000;
+module_param(h16_idle_off_loaded_ms, uint, 0644);
+MODULE_PARM_DESC(h16_idle_off_loaded_ms,
+		 "Power the H16 ANE off this many ms after its last request even with programs loaded, replaying them at the next request (0: keep it powered while loaded; default: 5000, as macOS)");
+
 static void ane_h16_idle_arm(struct ane_h16_device *h)
 {
 	unsigned int ms = READ_ONCE(h16_idle_off_ms);
@@ -680,21 +694,39 @@ static void ane_h16_idle_work(struct work_struct *work)
 {
 	struct ane_h16_device *h = container_of(to_delayed_work(work), struct ane_h16_device, idle);
 	struct ane_h16_session *s = &h->session;
-	bool loaded;
+	unsigned int loaded_ms;
+	bool loaded, held;
+	u64 idle_ms;
 
 	guard(mutex)(&ane_h16_lock);
 	if (!READ_ONCE(h16_idle_off_ms) || !h->program_ready || h->slept || h->parked ||
 	    h->boot.quarantined || s->quarantined)
 		return;
-	/* A program is loaded or a request runs: look again later. */
-	if (!list_empty(&s->programs) || READ_ONCE(s->active)) {
+	/* A request runs: look again later. */
+	if (READ_ONCE(s->active)) {
 		ane_h16_idle_arm(h);
 		return;
 	}
+	/* Programs loaded: off only h16_idle_off_loaded_ms after the last request. */
+	held = !list_empty(&s->programs);
+	if (held) {
+		loaded_ms = READ_ONCE(h16_idle_off_loaded_ms);
+		if (!loaded_ms) {
+			ane_h16_idle_arm(h);
+			return;
+		}
+		idle_ms = div_u64(ktime_get_ns() - READ_ONCE(h->idle_since), NSEC_PER_MSEC);
+		if (idle_ms < loaded_ms) {
+			mod_delayed_work(system_wq, &h->idle,
+					 msecs_to_jiffies(loaded_ms - idle_ms));
+			return;
+		}
+	}
 	/* Closed to new requests and drained, then checked again. */
 	ane_h16_session_sleep(s, true);
 	mutex_lock(s->lock);
-	loaded = !list_empty(&s->programs) || s->active;
+	/* A request, or a first program, came in meanwhile. */
+	loaded = s->active || (!held && !list_empty(&s->programs));
 	mutex_unlock(s->lock);
 	for (unsigned int ch = 0; !loaded && ch < ANE_FW_CHANNELS; ch++)
 		loaded = h->boot.transport.pending[ch].active;
@@ -703,10 +735,10 @@ static void ane_h16_idle_work(struct work_struct *work)
 		ane_h16_idle_arm(h);
 		return;
 	}
-	ane_h16_power_down(h, "idle, no program loaded");
+	ane_h16_power_down(h, held ? "idle, programs kept for replay" : "idle, no program loaded");
 	WRITE_ONCE(h->slept, true);
 	h->parked = true;
-	WRITE_ONCE(s->parked, true);
+	ane_h16_session_park(s);
 }
 
 /* ops->wake: the cold boot of a system resume, for one request. */
@@ -720,6 +752,7 @@ static int ane_h16_wake(void *ctx)
 	if (!h->parked)
 		return 0;
 	start = ktime_get_ns();
+	mutex_lock(h->session.lock);
 	h->parked = false;
 	WRITE_ONCE(h->session.parked, false);
 	h->resume_ready_ns = 0;
@@ -728,15 +761,18 @@ static int ane_h16_wake(void *ctx)
 	h->resume_cold = true;
 	h->resume_restarts = 0;
 	ret = ane_h16_cold_boot(h);
+	mutex_unlock(h->session.lock);
 	WRITE_ONCE(h->slept, false);
+	WRITE_ONCE(h->idle_since, ktime_get_ns());
 	if (ret) {
 		ane_h16_quarantine(h, ret);
 		h->boot.quarantined = true;
 		h->session.quarantined = true;
 	}
 	ane_h16_session_sleep(&h->session, false);
-	dev_info(h->dev, "H16 ANE: powered up for a request %s in %llu ms\n",
-		 ret ? "FAILED" : "ok", div_u64(ktime_get_ns() - start, NSEC_PER_MSEC));
+	dev_info(h->dev, "H16 ANE: powered up for a request %s in %llu ms, %u programs replayed\n",
+		 ret ? "FAILED" : "ok", div_u64(ktime_get_ns() - start, NSEC_PER_MSEC),
+		 h->resume_replayed);
 	if (!ret)
 		ane_h16_idle_arm(h);
 	return ret;
@@ -1445,8 +1481,10 @@ static void ane_h16_busy(void *ctx, bool busy)
 
 	apple_clpc_ane_set_active(h->clpc, busy);
 	/* Idle from the end of the last request on. */
-	if (!busy)
+	if (!busy) {
+		WRITE_ONCE(h->idle_since, ktime_get_ns());
 		ane_h16_idle_arm(h);
+	}
 	if (!h->perf)
 		return;
 	if (busy) {
diff --git a/drivers/accel/ane/ane_h16_program.c b/drivers/accel/ane/ane_h16_program.c
index c9127d910a..ea82d705dc 100644
--- a/drivers/accel/ane/ane_h16_program.c
+++ b/drivers/accel/ane/ane_h16_program.c
@@ -1592,8 +1592,10 @@ int ane_h16_session_close(struct ane_h16_session *s, struct ane_h16_program *p)
 	/*
 	 * The firmware is suspended for system sleep and keeps this program:
 	 * tear it down when the session reopens. The session owns it until.
+	 * Parked (powered off while idle), the program is already lost and
+	 * is released below without the firmware.
 	 */
-	if (s->asleep) {
+	if (s->asleep && !s->parked) {
 		if (list_empty(&p->deferred))
 			list_add_tail(&p->deferred, &s->deferred);
 		return -EINPROGRESS;
@@ -1727,6 +1729,34 @@ void ane_h16_session_restart(struct ane_h16_session *s)
 }
 EXPORT_SYMBOL_GPL(ane_h16_session_restart);
 
+/*
+ * The engine was powered off while idle, programs loaded or not: the next
+ * request boots the firmware again from the preload and replays the open
+ * programs (ane_h16_session_replay()), so every program is lost from now
+ * on. Closes deferred until now, and closes while parked, only release
+ * the program's memory; no firmware is involved. Called with the session
+ * asleep. Returns the number of programs kept for replay.
+ */
+unsigned int ane_h16_session_park(struct ane_h16_session *s)
+{
+	struct ane_h16_program *p, *n;
+	unsigned int kept = 0;
+
+	mutex_lock(s->lock);
+	WRITE_ONCE(s->parked, true);
+	ane_h16_session_restart(s);
+	list_for_each_entry_safe(p, n, &s->deferred, deferred) {
+		list_del_init(&p->deferred);
+		if (!ane_h16_session_close(s, p))
+			ane_h16_session_put(s, p);
+	}
+	list_for_each_entry(p, &s->programs, node)
+		kept++;
+	mutex_unlock(s->lock);
+	return kept;
+}
+EXPORT_SYMBOL_GPL(ane_h16_session_park);
+
 /*
  * Put one program back on a firmware booted again from the preload, behind
  * its existing handle: its regions are rewritten from the HWX snapshot as at
diff --git a/drivers/accel/ane/ane_h16_program.h b/drivers/accel/ane/ane_h16_program.h
index dec50a2e3a..409d9f0b4c 100644
--- a/drivers/accel/ane/ane_h16_program.h
+++ b/drivers/accel/ane/ane_h16_program.h
@@ -356,6 +356,7 @@ unsigned int ane_h16_session_dump_fwlog(struct ane_h16_session *s);
 void ane_h16_session_sleep(struct ane_h16_session *s, bool asleep);
 int ane_h16_session_gate_expire(struct ane_h16_session *s);
 void ane_h16_session_restart(struct ane_h16_session *s);
+unsigned int ane_h16_session_park(struct ane_h16_session *s);
 int ane_h16_session_replay(struct ane_h16_session *s, unsigned int *replayed,
 			   u64 *first_ns);
 bool ane_h16_program_lost(const struct ane_h16_session *s, const struct ane_h16_program *p);
diff --git a/drivers/accel/ane/ane_h16_program_test.c b/drivers/accel/ane/ane_h16_program_test.c
index 005ad0fa1e..47880bfbbe 100644
--- a/drivers/accel/ane/ane_h16_program_test.c
+++ b/drivers/accel/ane/ane_h16_program_test.c
@@ -2270,6 +2270,93 @@ static void program_sleep_replay_deferred_test(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, f->s.quarantined);
 }
 
+/* Parked with a program loaded: a close needs no firmware, only releases. */
+static void program_park_close_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test);
+	struct ane_h16_program *p = NULL;
+	struct mutex *lock = kunit_kzalloc(test, sizeof(*lock), GFP_KERNEL);
+	unsigned int sent;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, lock);
+	mutex_init(lock);
+	f->s.lock = lock;
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &p), 0);
+	KUNIT_ASSERT_EQ(test, ane_h16_session_execute(&f->s, p), 0);
+	ane_h16_session_sleep(&f->s, true);
+	sent = f->count;
+	KUNIT_EXPECT_EQ(test, ane_h16_session_park(&f->s), 1U);
+	KUNIT_EXPECT_TRUE(test, f->s.parked);
+	KUNIT_EXPECT_TRUE(test, ane_h16_program_lost(&f->s, p));
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, p), 0);
+	ane_h16_session_put(&f->s, p);
+	KUNIT_EXPECT_EQ(test, f->count, sent);
+	KUNIT_EXPECT_TRUE(test, list_empty(&f->s.programs));
+	KUNIT_EXPECT_FALSE(test, f->s.quarantined);
+}
+
+/* A close deferred before the park is released by it, without firmware. */
+static void program_park_deferred_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test);
+	struct ane_h16_program *p = NULL;
+	struct mutex *lock = kunit_kzalloc(test, sizeof(*lock), GFP_KERNEL);
+	unsigned int sent;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, lock);
+	mutex_init(lock);
+	f->s.lock = lock;
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &p), 0);
+	ane_h16_session_sleep(&f->s, true);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, p), -EINPROGRESS);
+	sent = f->count;
+	KUNIT_EXPECT_EQ(test, ane_h16_session_park(&f->s), 0U);
+	KUNIT_EXPECT_EQ(test, f->count, sent);
+	KUNIT_EXPECT_TRUE(test, list_empty(&f->s.programs));
+	KUNIT_EXPECT_TRUE(test, list_empty(&f->s.deferred));
+	KUNIT_EXPECT_FALSE(test, f->s.quarantined);
+}
+
+/* Parked with a program, then woken: the program is replayed and runs. */
+static void program_park_replay_test(struct kunit *test)
+{
+	struct prog_fw *f = fw_create(test);
+	struct ane_h16_program *p = NULL;
+	struct mutex *lock = kunit_kzalloc(test, sizeof(*lock), GFP_KERNEL);
+	unsigned int replayed;
+	u32 program;
+	u64 first;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	KUNIT_ASSERT_NOT_NULL(test, lock);
+	mutex_init(lock);
+	f->s.lock = lock;
+	f->strict = true;
+	KUNIT_ASSERT_EQ(test, fw_load_program(f, &p), 0);
+	KUNIT_ASSERT_EQ(test, ane_h16_session_execute(&f->s, p), 0);
+	program = p->key.program;
+	ane_h16_session_sleep(&f->s, true);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_park(&f->s), 1U);
+	/* The backend's wake: cold boot, then replay with the session locked. */
+	mutex_lock(lock);
+	WRITE_ONCE(f->s.parked, false);
+	fw_cold_boot(f);
+	ane_h16_session_restart(&f->s);
+	KUNIT_ASSERT_EQ(test, ane_h16_session_replay(&f->s, &replayed, &first), 0);
+	mutex_unlock(lock);
+	ane_h16_session_sleep(&f->s, false);
+	KUNIT_EXPECT_EQ(test, replayed, 1U);
+	KUNIT_EXPECT_FALSE(test, ane_h16_program_lost(&f->s, p));
+	KUNIT_EXPECT_EQ(test, p->key.program, program + 0x10);
+	KUNIT_ASSERT_EQ(test, ane_h16_session_execute(&f->s, p), 0);
+	KUNIT_EXPECT_EQ(test, get_unaligned_le32(f->exec + 8), program + 0x10);
+	KUNIT_EXPECT_FALSE(test, f->s.quarantined);
+	KUNIT_EXPECT_EQ(test, ane_h16_session_close(&f->s, p), 0);
+	ane_h16_session_put(&f->s, p);
+}
+
 /* Real concurrent callers; the fake firmware alone decides completion order. */
 struct pipeline_thread {
 	struct prog_fw *fw;
@@ -2680,6 +2767,9 @@ static struct kunit_case program_cases[] = {
 	KUNIT_CASE(program_sleep_nonblock_test),
 	KUNIT_CASE(program_sleep_replay_failure_test),
 	KUNIT_CASE(program_sleep_replay_deferred_test),
+	KUNIT_CASE(program_park_close_test),
+	KUNIT_CASE(program_park_deferred_test),
+	KUNIT_CASE(program_park_replay_test),
 	KUNIT_CASE(program_sleep_gate_test),
 	KUNIT_CASE(program_sleep_keeps_program_test),
 	KUNIT_CASE(program_sleep_restart_test),
-- 
