From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Tue, 27 Oct 2026 20:04:49 -0400
Subject: [PATCH] phy: apple: atc: Let an idle T8132 PHY runtime-suspend

A J713 (MacBook Air M4) Type-C port keeps its ATC power domains on with
nothing plugged in. For the PHY's domain to drop, the PHY must runtime-
suspend, and its domain has to be the controller's ATCn_USB: that domain
also holds the PIPE handler, which the PHY writes to drive the USB
controller's reset and to route the PIPE, also while the Type-C mux
changes mode before the controller has resumed. A running controller
keeps the shared domain on by itself.

On T8132, once the PHY follows its PM domain with the genpd notifier,
enable runtime PM before the PHYs are created, so that they follow it
too. Power the device for each operation that can reach the hardware:
the USB2 and USB3 PHY ops, the controller's reset, the Type-C mux, and
the deferred SuperSpeed retry. The orientation switch only records the
orientation, and T8132 creates no DisplayPort PHY. Shutdown touches the
hardware only for an owned common epoch, which holds the device on.

Hold a reference while a power-down would lose state: a mode or a host,
a PIPE away from its parked dummy backend or between backends, and the
common-power epoch of a USB3 admission, which only its own stop may end.
The rest is the baseline the restore below sets up. With nothing held,
the PHY autosuspends after 2 s, which spans the burst of mux, orientation
and reset calls of one plug. Unbind drops a hold still taken.

The domain then switches off with the controller's and resets the block,
so also restore the PHY state after that on T8132, as on T8122. The
T8132 baseline is the one its probe sets up: the common block is
acquired only on USB3 admission, so it is not powered down, and the PIPE
is set up as at probe, with the dummy PIPE clock the USB2 controller
needs. System resume leaves a runtime-suspended PHY to its next
operation, as its domain may switch off again once resume completes.

Signed-off-by: Erik Bourget <erik@ebourget.net>

(backported from commit 1c79b032094946a2b3a9207d0e8d0cebf9bc7837)
[j604: the base (omacom linux-aurora 1.607) has no T8132 SuperSpeed
 (3949e3640d), so there is no T8132 USB3 admission and no common-power
 epoch: atcphy_rpm_busy() drops the t8132_common_owned term and its KUnit
 expectation; the USB3 phy ops keep the base form (no .exit) and only gain
 the runtime PM wrappers (T8132 creates no USB3 PHY while usb2_only);
 atcphy_resume() has no t8132_suspended flag to clear. Behaviour on a
 USB2-only T8132 port is otherwise the upstream one.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/phy/apple/atc-test.c | 154 ++++++++++++++++++++
 drivers/phy/apple/atc.c      | 262 ++++++++++++++++++++++++++++++++---
 2 files changed, 394 insertions(+), 22 deletions(-)

diff --git a/drivers/phy/apple/atc-test.c b/drivers/phy/apple/atc-test.c
index fe2ac8dc9b..f9265c0f9a 100644
--- a/drivers/phy/apple/atc-test.c
+++ b/drivers/phy/apple/atc-test.c
@@ -1035,6 +1035,145 @@ static void atcphy_test_usb2_init_after_safe(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, atcphy->mode, APPLE_ATCPHY_MODE_OFF);
 }
 
+/* An idle T8132 PHY may let its domain drop; anything it still runs holds it. */
+static void atcphy_test_t8132_rpm_busy(struct kunit *test)
+{
+	struct apple_atcphy *atcphy = atcphy_test_alloc(test, false);
+
+	atcphy->hw = &atcphy_hw_t8132;
+	atcphy->mode = APPLE_ATCPHY_MODE_OFF;
+	atcphy->pipe_state = ATCPHY_PIPEHANDLER_STATE_DUMMY;
+	KUNIT_EXPECT_FALSE(test, atcphy_rpm_busy(atcphy));
+
+	atcphy->mode = APPLE_ATCPHY_MODE_USB2;
+	KUNIT_EXPECT_TRUE(test, atcphy_rpm_busy(atcphy));
+	atcphy->mode = APPLE_ATCPHY_MODE_OFF;
+
+	atcphy->host_active = true;
+	KUNIT_EXPECT_TRUE(test, atcphy_rpm_busy(atcphy));
+	atcphy->host_active = false;
+
+	atcphy->pipe_pending = true;
+	KUNIT_EXPECT_TRUE(test, atcphy_rpm_busy(atcphy));
+	atcphy->pipe_pending = false;
+
+	atcphy->pipe_state = ATCPHY_PIPEHANDLER_STATE_USB3;
+	KUNIT_EXPECT_TRUE(test, atcphy_rpm_busy(atcphy));
+	atcphy->pipe_state = ATCPHY_PIPEHANDLER_STATE_DUMMY;
+}
+
+/* The hold follows the busy state, with one reference at most. */
+static void atcphy_test_t8132_rpm_hold(struct kunit *test)
+{
+	struct apple_atcphy *atcphy = atcphy_test_alloc_powered_off(test);
+
+	atcphy->hw = &atcphy_hw_t8132;
+	atcphy->idle_rpm = true;
+	atcphy->mode = APPLE_ATCPHY_MODE_USB2;
+	atcphy_rpm_sync(atcphy);
+	KUNIT_EXPECT_TRUE(test, atcphy->rpm_held);
+	KUNIT_EXPECT_EQ(test, atomic_read(&atcphy->dev->power.usage_count), 1);
+	atcphy_rpm_sync(atcphy);
+	KUNIT_EXPECT_EQ(test, atomic_read(&atcphy->dev->power.usage_count), 1);
+
+	atcphy->mode = APPLE_ATCPHY_MODE_OFF;
+	atcphy_rpm_sync(atcphy);
+	KUNIT_EXPECT_FALSE(test, atcphy->rpm_held);
+	KUNIT_EXPECT_EQ(test, atomic_read(&atcphy->dev->power.usage_count), 0);
+
+	/* Unbind drops a hold that is still taken */
+	atcphy->mode = APPLE_ATCPHY_MODE_USB2;
+	atcphy_rpm_sync(atcphy);
+	atcphy_rpm_release(atcphy);
+	KUNIT_EXPECT_FALSE(test, atcphy->rpm_held);
+	KUNIT_EXPECT_EQ(test, atomic_read(&atcphy->dev->power.usage_count), 0);
+}
+
+/* Record the mode a restore asks for, without touching MMIO. */
+static int atcphy_test_configure_record(struct apple_atcphy *atcphy, enum atcphy_mode mode)
+{
+	struct kunit *test = kunit_get_current_test();
+	struct atcphy_test_configure *config = test->priv;
+
+	lockdep_assert_held(&atcphy->lock);
+	config->calls++;
+	if (mode != APPLE_ATCPHY_MODE_OFF)
+		config->lane_requests++;
+	atcphy->mode = mode;
+	return 0;
+}
+
+/* A T8132 PHY whose domain was off: zeroed memory stands in for the reset block. */
+static struct apple_atcphy *atcphy_test_alloc_t8132_pd_off(struct kunit *test,
+							   enum atcphy_mode mode)
+{
+	struct apple_atcphy *atcphy = atcphy_test_alloc_powered_off(test);
+	void *core = kunit_kzalloc(test, ATCPHY_MISC + 4, GFP_KERNEL);
+	void *pipehandler = kunit_kzalloc(test, PIPEHANDLER_T8132_USB2_CONFIG + 4, GFP_KERNEL);
+	void *usb2phy = kunit_kzalloc(test, USB2PHY_MISCTUNE + 4, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, core);
+	KUNIT_ASSERT_NOT_NULL(test, pipehandler);
+	KUNIT_ASSERT_NOT_NULL(test, usb2phy);
+	atcphy->regs.core = (__force void __iomem *)core;
+	atcphy->regs.pipehandler = (__force void __iomem *)pipehandler;
+	atcphy->regs.usb2phy = (__force void __iomem *)usb2phy;
+	atcphy->hw = &atcphy_hw_t8132;
+	atcphy->mode = mode;
+	atcphy->pd_was_off = true;
+
+	return atcphy;
+}
+
+/* The probe baseline comes back: controller in reset, USB2 off, dummy PIPE clock on. */
+static void atcphy_test_t8132_restore_idle(struct kunit *test)
+{
+	struct apple_atcphy *atcphy = atcphy_test_alloc_t8132_pd_off(test, APPLE_ATCPHY_MODE_OFF);
+	struct atcphy_test_configure config = {};
+	u32 aon;
+
+	test->priv = &config;
+	kunit_activate_static_stub(test, atcphy_configure, atcphy_test_configure_record);
+	scoped_guard(mutex, &atcphy->lock)
+		atcphy_restore_after_pd_off(atcphy);
+
+	KUNIT_EXPECT_FALSE(test, atcphy->pd_was_off);
+	KUNIT_EXPECT_EQ(test, config.calls, 0U);
+	KUNIT_EXPECT_EQ(test, atcphy->mode, APPLE_ATCPHY_MODE_OFF);
+	KUNIT_EXPECT_EQ(test, atcphy->pipe_state, ATCPHY_PIPEHANDLER_STATE_DUMMY);
+	aon = readl(atcphy->regs.pipehandler + PIPEHANDLER_AON_GEN);
+	KUNIT_EXPECT_FALSE(test, aon & PIPEHANDLER_AON_GEN_DWC3_RESET_N);
+	KUNIT_EXPECT_TRUE(test, aon & PIPEHANDLER_AON_GEN_DWC3_FORCE_CLAMP_EN);
+	KUNIT_EXPECT_TRUE(test, readl(atcphy->regs.pipehandler + PIPEHANDLER_T8132_USB2_CONFIG) &
+			  PIPEHANDLER_T8132_USB2_CONFIG_EN);
+	KUNIT_EXPECT_TRUE(test, readl(atcphy->regs.usb2phy + USB2PHY_CTL) & USB2PHY_CTL_SIDDQ);
+	/* As at probe, the common block is left for a USB3 admission to acquire. */
+	KUNIT_EXPECT_EQ(test, readl(atcphy->regs.core + ATCPHY_POWER_CTRL), 0U);
+
+	/* Nothing to do once the state is back. */
+	scoped_guard(mutex, &atcphy->lock)
+		atcphy_restore_after_pd_off(atcphy);
+	KUNIT_EXPECT_EQ(test, config.calls, 0U);
+}
+
+/* After the baseline, the mode the Type-C mux selected is requested again. */
+static void atcphy_test_t8132_restore_mode(struct kunit *test)
+{
+	struct apple_atcphy *atcphy = atcphy_test_alloc_t8132_pd_off(test, APPLE_ATCPHY_MODE_USB2);
+	struct atcphy_test_configure config = {};
+
+	test->priv = &config;
+	kunit_activate_static_stub(test, atcphy_configure, atcphy_test_configure_record);
+	scoped_guard(mutex, &atcphy->lock)
+		atcphy_restore_after_pd_off(atcphy);
+
+	KUNIT_EXPECT_EQ(test, config.calls, 1U);
+	KUNIT_EXPECT_EQ(test, config.lane_requests, 1U);
+	KUNIT_EXPECT_EQ(test, atcphy->mode, APPLE_ATCPHY_MODE_USB2);
+	KUNIT_EXPECT_FALSE(test, readl(atcphy->regs.pipehandler + PIPEHANDLER_AON_GEN) &
+			   PIPEHANDLER_AON_GEN_DWC3_RESET_N);
+}
+
 static void atcphy_test_t8103_usb3_machine_scope(struct kunit *test)
 {
 	static const struct {
@@ -1112,3 +1251,18 @@ static struct kunit_suite atcphy_mux_test_suite = {
 };
 
 kunit_test_suite(atcphy_mux_test_suite);
+
+static struct kunit_case atcphy_t8132_pm_test_cases[] = {
+	KUNIT_CASE(atcphy_test_t8132_rpm_busy),
+	KUNIT_CASE(atcphy_test_t8132_rpm_hold),
+	KUNIT_CASE(atcphy_test_t8132_restore_idle),
+	KUNIT_CASE(atcphy_test_t8132_restore_mode),
+	{}
+};
+
+static struct kunit_suite atcphy_t8132_pm_test_suite = {
+	.name = "phy-apple-atc-t8132-pm",
+	.test_cases = atcphy_t8132_pm_test_cases,
+};
+
+kunit_test_suite(atcphy_t8132_pm_test_suite);
diff --git a/drivers/phy/apple/atc.c b/drivers/phy/apple/atc.c
index dbc5365ff5..ce5b613d20 100644
--- a/drivers/phy/apple/atc.c
+++ b/drivers/phy/apple/atc.c
@@ -54,6 +54,9 @@
 #include "atc-t8122-dp.h"
 #include "atc-tunnel.h"
 
+/* Runtime-suspend delay, which covers the mux, orientation and reset calls of a plug */
+#define ATCPHY_AUTOSUSPEND_MS 2000
+
 #define AUSPLL_FSM_CTRL 0x1014
 
 #define AUSPLL_APB_CMD_OVERRIDE 0x2000
@@ -654,8 +657,13 @@ struct apple_atcphy;
  *                  it; the lock handshake that starts the next PIPE change is
  *                  only acknowledged while it runs
  * @restore_after_pd_off: The PHY's power domain may be switched off in system
- *                        sleep, which resets the block; bring the tracked
- *                        state back once the domain is on again
+ *                        sleep, or at runtime with @idle_power_off, which
+ *                        resets the block; bring the tracked state back once
+ *                        the domain is on again
+ * @idle_power_off: Let an idle PHY runtime-suspend, so that its power domain
+ *                  can also drop while the system runs, see atcphy_rpm_get().
+ *                  Only for PHYs without DisplayPort, whose phy ops and tunnel
+ *                  calls take no runtime PM reference
  */
 struct atcphy_hw {
 	void (*configure_post_tunable)(struct apple_atcphy *, enum atcphy_mode);
@@ -674,6 +682,7 @@ struct atcphy_hw {
 	bool park_pipe_unlocked;
 	bool park_dummy_phy;
 	bool restore_after_pd_off;
+	bool idle_power_off;
 };
 
 /**
@@ -745,6 +754,9 @@ struct atcphy_hw {
  * @pd_nb: Power domain notifier, registered with restore_after_pd_off
  * @pd_was_off: The power domain was switched off since the state was last
  *              brought back; set from the notifier, cleared under @lock
+ * @idle_rpm: An idle PHY runtime-suspends, see atcphy_rpm_get()
+ * @rpm_held: A runtime PM reference is held while busy, see atcphy_rpm_busy();
+ *            under @lock
  * @regs: Memory-mapped registers
  * @regs.core: Core registers
  * @regs.axi2af: AXI to Apple Fabric interface registers
@@ -813,6 +825,8 @@ struct apple_atcphy {
 
 	struct notifier_block pd_nb;
 	bool pd_was_off;
+	bool idle_rpm;
+	bool rpm_held;
 
 	bool tunnel_dual_stream;
 	bool tunnel_routes_present;
@@ -3637,6 +3651,71 @@ static int atcphy_configure(struct apple_atcphy *atcphy, enum atcphy_mode mode)
 
 static void _atcphy_dwc3_reset_assert(struct apple_atcphy *atcphy);
 
+/*
+ * On T8132 an idle PHY lets its power domain drop. That domain is the USB
+ * controller's, which also holds the PIPE handler: the PHY writes it to drive
+ * the controller's reset and to route the PIPE, also while the Type-C mux
+ * changes mode before the controller has resumed. So every operation that can
+ * reach the hardware powers the device first, and a reference stays held while
+ * the PHY runs anything, see atcphy_rpm_busy(). A running controller keeps the
+ * shared domain on by itself.
+ */
+static int atcphy_rpm_get(struct apple_atcphy *atcphy)
+{
+	if (!atcphy->idle_rpm)
+		return 0;
+	return pm_runtime_resume_and_get(atcphy->dev);
+}
+
+/*
+ * What a power-down would lose: a mode or a host, or a PIPE away from its
+ * parked dummy backend or between backends. Without these the PHY is in the
+ * baseline that atcphy_restore_after_pd_off() sets up again.
+ */
+static bool atcphy_rpm_busy(const struct apple_atcphy *atcphy)
+{
+	return atcphy->mode != APPLE_ATCPHY_MODE_OFF || atcphy->host_active ||
+	       atcphy->pipe_pending || atcphy->pipe_state != ATCPHY_PIPEHANDLER_STATE_DUMMY;
+}
+
+/* Take or drop the reference held while busy; the device must be on. */
+static void atcphy_rpm_sync(struct apple_atcphy *atcphy)
+{
+	bool busy;
+
+	if (!atcphy->idle_rpm)
+		return;
+	guard(mutex)(&atcphy->lock);
+	busy = atcphy_rpm_busy(atcphy);
+	if (busy == atcphy->rpm_held)
+		return;
+	if (busy)
+		pm_runtime_get_noresume(atcphy->dev);
+	else
+		pm_runtime_put_noidle(atcphy->dev);
+	atcphy->rpm_held = busy;
+	dev_dbg(atcphy->dev, "%s the power domain\n", busy ? "holding" : "releasing");
+}
+
+static void atcphy_rpm_put(struct apple_atcphy *atcphy)
+{
+	if (!atcphy->idle_rpm)
+		return;
+	atcphy_rpm_sync(atcphy);
+	pm_runtime_put_autosuspend(atcphy->dev);
+}
+
+/* Drop the hold of an unbound PHY or a failed probe, before runtime PM is disabled. */
+static void atcphy_rpm_release(void *data)
+{
+	struct apple_atcphy *atcphy = data;
+
+	guard(mutex)(&atcphy->lock);
+	if (atcphy->rpm_held)
+		pm_runtime_put_noidle(atcphy->dev);
+	atcphy->rpm_held = false;
+}
+
 /*
  * A T8122 PHY loses its register state whenever its power domain is switched
  * off. In system sleep that happens to a domain that no running device holds:
@@ -3657,6 +3736,9 @@ static void _atcphy_dwc3_reset_assert(struct apple_atcphy *atcphy);
  * resume callback, whichever comes first, so the order in which the Type-C
  * controller, the USB controller and the display controller resume does not
  * matter.
+ *
+ * On T8132 the domain also switches off at runtime, once an idle PHY and its
+ * USB controller have both suspended, see atcphy_rpm_get().
  */
 static void atcphy_restore_after_pd_off(struct apple_atcphy *atcphy)
 {
@@ -3682,20 +3764,29 @@ static void atcphy_restore_after_pd_off(struct apple_atcphy *atcphy)
 		atcphy->host_active = false;
 		atcphy_usb2_power_off(atcphy);
 	}
-	ret = atcphy_power_off(atcphy);
-	if (ret)
-		dev_warn(atcphy->dev, "PHY did not power down after its domain was off: %d\n",
-			 ret);
+	/* As at probe, M4 acquires its common bank only on USB3 admission. */
+	if (!atcphy->hw->usb2_only) {
+		ret = atcphy_power_off(atcphy);
+		if (ret)
+			dev_warn(atcphy->dev,
+				 "PHY did not power down after its domain was off: %d\n", ret);
+	}
 	atcphy->mode = APPLE_ATCPHY_MODE_OFF;
 
 	if (atcphy->dp_only) {
 		dev_dbg(atcphy->dev, "power domain was off, restoring mode %d\n", mode);
 	} else {
-		ret = atcphy_configure_pipehandler_dummy(atcphy, false);
-		if (ret)
-			dev_warn(atcphy->dev, "Failed to park the PIPE after its domain was off: %d\n",
-				 ret);
-		atcphy->pipe_state = ATCPHY_PIPEHANDLER_STATE_DUMMY;
+		if (atcphy->hw->usb2_only) {
+			/* As at probe, with the dummy PIPE clock the USB2 controller needs */
+			atcphy_setup_pipehandler(atcphy);
+		} else {
+			ret = atcphy_configure_pipehandler_dummy(atcphy, false);
+			if (ret)
+				dev_warn(atcphy->dev,
+					 "Failed to park the PIPE after its domain was off: %d\n",
+					 ret);
+			atcphy->pipe_state = ATCPHY_PIPEHANDLER_STATE_DUMMY;
+		}
 		dev_dbg(atcphy->dev,
 			"power domain was off, restoring mode %d: PIPE mux=%08x lock=%08x/%08x aon=%08x nonsel=%08x\n",
 			mode, readl(atcphy->regs.pipehandler + PIPEHANDLER_MUX_CTRL),
@@ -3786,10 +3877,40 @@ static int atcphy_usb2_init(struct phy *phy)
 	return 0;
 }
 
+/*
+ * The phy core also powers the device for init and power_off; these wrappers
+ * also take or drop the hold for the state an operation leaves behind.
+ */
+static int atcphy_rpm_usb2_init(struct phy *phy)
+{
+	struct apple_atcphy *atcphy = phy_get_drvdata(phy);
+	int ret;
+
+	ret = atcphy_rpm_get(atcphy);
+	if (ret)
+		return ret;
+	ret = atcphy_usb2_init(phy);
+	atcphy_rpm_put(atcphy);
+	return ret;
+}
+
+static int atcphy_rpm_usb2_set_mode(struct phy *phy, enum phy_mode mode, int submode)
+{
+	struct apple_atcphy *atcphy = phy_get_drvdata(phy);
+	int ret;
+
+	ret = atcphy_rpm_get(atcphy);
+	if (ret)
+		return ret;
+	ret = atcphy_usb2_set_mode(phy, mode, submode);
+	atcphy_rpm_put(atcphy);
+	return ret;
+}
+
 static const struct phy_ops apple_atc_usb2_phy_ops = {
 	.owner = THIS_MODULE,
-	.init = atcphy_usb2_init,
-	.set_mode = atcphy_usb2_set_mode,
+	.init = atcphy_rpm_usb2_init,
+	.set_mode = atcphy_rpm_usb2_set_mode,
 };
 
 static int atcphy_usb3_power_off(struct phy *phy)
@@ -3919,10 +4040,36 @@ static int atcphy_usb3_set_mode(struct phy *phy, enum phy_mode mode, int submode
 	return 0;
 }
 
+static int atcphy_rpm_usb3_power_off(struct phy *phy)
+{
+	struct apple_atcphy *atcphy = phy_get_drvdata(phy);
+	int ret;
+
+	ret = atcphy_rpm_get(atcphy);
+	if (ret)
+		return ret;
+	ret = atcphy_usb3_power_off(phy);
+	atcphy_rpm_put(atcphy);
+	return ret;
+}
+
+static int atcphy_rpm_usb3_set_mode(struct phy *phy, enum phy_mode mode, int submode)
+{
+	struct apple_atcphy *atcphy = phy_get_drvdata(phy);
+	int ret;
+
+	ret = atcphy_rpm_get(atcphy);
+	if (ret)
+		return ret;
+	ret = atcphy_usb3_set_mode(phy, mode, submode);
+	atcphy_rpm_put(atcphy);
+	return ret;
+}
+
 static const struct phy_ops apple_atc_usb3_phy_ops = {
 	.owner = THIS_MODULE,
-	.power_off = atcphy_usb3_power_off,
-	.set_mode = atcphy_usb3_set_mode,
+	.power_off = atcphy_rpm_usb3_power_off,
+	.set_mode = atcphy_rpm_usb3_set_mode,
 };
 
 static int atcphy_dpphy_set_mode(struct phy *phy, enum phy_mode mode, int submode)
@@ -4282,9 +4429,35 @@ static int atcphy_dwc3_reset_deassert(struct reset_controller_dev *rcdev, unsign
 	return 0;
 }
 
+static int atcphy_rpm_dwc3_reset_assert(struct reset_controller_dev *rcdev, unsigned long id)
+{
+	struct apple_atcphy *atcphy = container_of(rcdev, struct apple_atcphy, rcdev);
+	int ret;
+
+	ret = atcphy_rpm_get(atcphy);
+	if (ret)
+		return ret;
+	ret = atcphy_dwc3_reset_assert(rcdev, id);
+	atcphy_rpm_put(atcphy);
+	return ret;
+}
+
+static int atcphy_rpm_dwc3_reset_deassert(struct reset_controller_dev *rcdev, unsigned long id)
+{
+	struct apple_atcphy *atcphy = container_of(rcdev, struct apple_atcphy, rcdev);
+	int ret;
+
+	ret = atcphy_rpm_get(atcphy);
+	if (ret)
+		return ret;
+	ret = atcphy_dwc3_reset_deassert(rcdev, id);
+	atcphy_rpm_put(atcphy);
+	return ret;
+}
+
 static const struct reset_control_ops atcphy_dwc3_reset_ops = {
-	.assert = atcphy_dwc3_reset_assert,
-	.deassert = atcphy_dwc3_reset_deassert,
+	.assert = atcphy_rpm_dwc3_reset_assert,
+	.deassert = atcphy_rpm_dwc3_reset_deassert,
 };
 
 static int atcphy_reset_xlate(struct reset_controller_dev *rcdev,
