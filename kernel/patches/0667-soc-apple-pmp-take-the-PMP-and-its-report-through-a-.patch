 					  u32 request_read, u32 request_write,
diff --git a/drivers/pmdomain/apple/pmp-report.c b/drivers/pmdomain/apple/pmp-report.c
index 072eac5fe3..50a0802611 100644
--- a/drivers/pmdomain/apple/pmp-report.c
+++ b/drivers/pmdomain/apple/pmp-report.c
@@ -81,6 +81,15 @@ struct apple_pmp_report {
 	struct apple_pmp_start *start;
 	/* PS-REQ bit of the AGX request this report votes, or -1 (see apple_pmp_report_agx_id()) */
 	int agx_id;
+	/* Requests made through this driver: bits requested on, all bits it set or withdrew. */
+	u64 shadow;
+	u64 known;
+	/* Bits whose drivers withdraw them at the sleep's commit, with the PMP still running. */
+	u64 commit_owned;
+	/* Requests are held in memory while the PMP is stopped for a system sleep. */
+	bool defer;
+	/* The request word when a system sleep stopped the PMP. */
+	u64 sleep_request;
 };
 
 static const struct apple_pmp_report_offsets apple_pmp_offsets_t6030;
@@ -201,6 +210,93 @@ static void apple_pmp_report_release(void *data)
 	debugfs_remove(rep->debugfs);
 }
 
+static bool apple_pmp_report_running(const struct apple_pmp_report *rep)
+{
+	return readq(rep->base + rep->offsets->status) & PMP_REPORT_READY;
+}
+
+/* A report names its PMP where a SoC has more than one kind of link to it. */
+static bool apple_pmp_report_of(const struct apple_pmp_report *rep, const struct device *pmp)
+{
+	struct device_node *np = of_parse_phandle(rep->dev->of_node, "apple,pmp", 0);
+	bool match = !np || np == pmp->of_node;
+
+	of_node_put(np);
+	return match;
+}
+
+/**
+ * apple_pmp_report_sleep() - withdraw and hold requests before a system sleep stops the PMP
+ * @pmp: the PMP device, still running
+ * @at_commit: the PMP stops at the sleep's commit, so requests whose drivers withdraw them
+ *	there are left set
+ *
+ * The devices behind these requests have stopped by now, so the PMP is told before
+ * it goes. Requests made from here on only update the books, so nothing waits on an
+ * acknowledgment from a stopped PMP. Bits this driver never set are left alone.
+ */
+void apple_pmp_report_sleep(struct device *pmp, bool at_commit)
+{
+	struct apple_pmp_report *rep;
+	unsigned long flags;
+	u64 val, withdrawn;
+
+	guard(mutex)(&apple_pmp_reports_lock);
+	list_for_each_entry(rep, &apple_pmp_reports, list) {
+		const struct apple_pmp_report_offsets *offs = rep->offsets;
+
+		if (!apple_pmp_report_of(rep, pmp))
+			continue;
+		spin_lock_irqsave(&rep->lock, flags);
+		rep->sleep_request = readq(rep->base + offs->tgt_read);
+		withdrawn = rep->sleep_request & rep->known & ~(at_commit ? rep->commit_owned : 0);
+		if (withdrawn)
+			writeq(rep->sleep_request & ~withdrawn, rep->base + offs->tgt_write);
+		rep->defer = true;
+		spin_unlock_irqrestore(&rep->lock, flags);
+
+		if (withdrawn && readq_poll_timeout(rep->base + offs->actual, val,
+						    !(val & withdrawn), 100, 50000))
+			dev_warn(rep->dev, "PMP still acknowledges withdrawn requests %#llx (ack %#llx)\n",
+				 withdrawn, val);
+	}
+}
+EXPORT_SYMBOL_GPL(apple_pmp_report_sleep);
+
+/**
+ * apple_pmp_report_wake() - hand the PMP every request after a system sleep
+ * @pmp: the PMP device, running again
+ * @lost_power: the sleep reached the hardware, so the report may have lost its
+ *	contents: bits this driver never set come from the word kept at the sleep
+ */
+void apple_pmp_report_wake(struct device *pmp, bool lost_power)
+{
+	struct apple_pmp_report *rep;
+	unsigned long flags;
+	u64 val, want;
+
+	guard(mutex)(&apple_pmp_reports_lock);
+	list_for_each_entry(rep, &apple_pmp_reports, list) {
+		const struct apple_pmp_report_offsets *offs = rep->offsets;
+
+		if (!apple_pmp_report_of(rep, pmp))
+			continue;
+		spin_lock_irqsave(&rep->lock, flags);
+		val = lost_power ? rep->sleep_request : readq(rep->base + offs->tgt_read);
+		writeq(apple_pmp_request_word(val, rep->known, rep->shadow),
+		       rep->base + offs->tgt_write);
+		want = rep->shadow;
+		rep->defer = false;
+		spin_unlock_irqrestore(&rep->lock, flags);
+
+		if (want && readq_poll_timeout(rep->base + offs->actual, val,
+					       (val & want) == want, 1000, 1000000))
+			dev_warn(rep->dev, "PMP did not acknowledge requests %#llx (ack %#llx)\n",
+				 want, val);
+	}
+}
+EXPORT_SYMBOL_GPL(apple_pmp_report_wake);
+
 /* The unique, enabled and acknowledged T6030 display request (DISP, reg 7). */
 static struct device_node *apple_pmp_report_t6030_entry(struct device_node *report)
 {
@@ -1356,13 +1452,26 @@ static int apple_pmp_report_set_state(struct apple_pmp_report *rep, u32 id,
 	u64 val;
 	unsigned long flags;
 
+	bool held;
+
 	spin_lock_irqsave(&rep->lock, flags);
-	val = readq(rep->base + rep->offsets->tgt_read);
-	val &= ~bit_val;
+	rep->known |= bit_val;
 	if (enable)
-		val |= bit_val;
-	writeq(val, rep->base + rep->offsets->tgt_write);
+		rep->shadow |= bit_val;
+	else
+		rep->shadow &= ~bit_val;
+	/* Held for a system sleep: apple_pmp_report_wake() hands it to the PMP. */
+	held = rep->defer;
+	if (!held) {
+		val = readq(rep->base + rep->offsets->tgt_read);
+		val &= ~bit_val;
+		if (enable)
+			val |= bit_val;
+		writeq(val, rep->base + rep->offsets->tgt_write);
+	}
 	spin_unlock_irqrestore(&rep->lock, flags);
+	if (held)
+		return 0;
 	val = readq(rep->base + rep->offsets->status);
 	if ((val & PMP_REPORT_READY) == 0 || no_ack)
 		return 0;
@@ -1737,6 +1846,136 @@ static int apple_pmp_report_entry_set_state(struct generic_pm_domain *genpd, boo
 	return ret;
 }
 
+/**
+ * apple_pmp_report_entry_request() - set or withdraw one entry's request
+ * @entry: the report entry's node
+ * @enable: make the request, or withdraw it
+ *
+ * For a driver that switches its device's power itself around a system sleep. The
+ * PMP may use a device whose request is set, so that driver withdraws the request
+ * before its power goes and makes it again after its power is back. A withdrawn
+ * request isn't replayed after the PMP restarts.
+ *
+ * Return: 0, also with no report bound or the PMP not running, or the error from
+ * waiting for its acknowledgment.
+ */
+int apple_pmp_report_entry_request(const struct device_node *entry, bool enable)
+{
+	struct device_node *report;
+	struct apple_pmp_report *rep;
+	u32 id;
+	int ret = 0;
+
+	if (of_property_read_u32(entry, "reg", &id))
+		return -EINVAL;
+
+	report = of_get_parent(entry);
+	rcu_read_lock();
+	list_for_each_entry_rcu(rep, &apple_pmp_reports, list) {
+		if (rep->dev->of_node != report)
+			continue;
+		ret = apple_pmp_report_set_state(rep, id, enable, false);
+		break;
+	}
+	rcu_read_unlock();
+	of_node_put(report);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_pmp_report_entry_request);
+
+static struct apple_pmp_report *apple_pmp_report_of_entry(const struct device_node *entry,
+							  u32 *id)
+{
+	struct device_node *report;
+	struct apple_pmp_report *rep, *found = NULL;
+
+	if (of_property_read_u32(entry, "reg", id) || *id >= 64)
+		return NULL;
+	report = of_get_parent(entry);
+	list_for_each_entry_rcu(rep, &apple_pmp_reports, list) {
+		if (rep->dev->of_node == report) {
+			found = rep;
+			break;
+		}
+	}
+	of_node_put(report);
+
+	return found;
+}
+
+/**
+ * apple_pmp_report_entry_commit_owned() - mark an entry withdrawn by its driver at the commit
+ * @entry: the report entry's node
+ * @owned: its driver withdraws it at the sleep's commit, or no longer does
+ *
+ * For a device whose stop moves to the sleep's commit: a PMP that stops there too keeps the
+ * request through apple_pmp_report_sleep(), until apple_pmp_report_entry_withdraw_polled().
+ *
+ * Return: 0, or -ENODEV with no report bound for the entry.
+ */
+int apple_pmp_report_entry_commit_owned(const struct device_node *entry, bool owned)
+{
+	struct apple_pmp_report *rep;
+	unsigned long flags;
+	int ret = -ENODEV;
+	u32 id;
+
+	rcu_read_lock();
+	rep = apple_pmp_report_of_entry(entry, &id);
+	if (rep) {
+		spin_lock_irqsave(&rep->lock, flags);
+		if (owned)
+			rep->commit_owned |= BIT_ULL(id);
+		else
+			rep->commit_owned &= ~BIT_ULL(id);
+		spin_unlock_irqrestore(&rep->lock, flags);
+		ret = 0;
+	}
+	rcu_read_unlock();
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_pmp_report_entry_commit_owned);
+
+/**
+ * apple_pmp_report_entry_withdraw_polled() - withdraw an entry's request at the sleep's commit
+ * @entry: the report entry's node
+ *
+ * Interrupts off, one CPU: the request goes even with requests held for the sleep, and the
+ * PMP's acknowledgment is polled for while it runs. One already withdrawn returns at once.
+ *
+ * Return: 0, also with no report bound, or -ETIMEDOUT with no acknowledgment.
+ */
+int apple_pmp_report_entry_withdraw_polled(const struct device_node *entry)
+{
+	struct apple_pmp_report *rep;
+	unsigned long flags;
+	u64 bit, val;
+	int ret = 0;
+	u32 id;
+
+	rcu_read_lock();
+	rep = apple_pmp_report_of_entry(entry, &id);
+	if (rep) {
+		bit = BIT_ULL(id);
+		spin_lock_irqsave(&rep->lock, flags);
+		rep->known |= bit;
+		rep->shadow &= ~bit;
+		val = readq(rep->base + rep->offsets->tgt_read);
+		if (val & bit)
+			writeq(val & ~bit, rep->base + rep->offsets->tgt_write);
+		spin_unlock_irqrestore(&rep->lock, flags);
+		if (apple_pmp_report_running(rep))
+			ret = readq_poll_timeout_atomic(rep->base + rep->offsets->actual, val,
+							!(val & bit), 10, 50000);
+	}
+	rcu_read_unlock();
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_pmp_report_entry_withdraw_polled);
+
 /*
  * System sleep. An external display processor's request keeps the PMP's
  * external display state up while nothing is shown, about 0.25 W in
diff --git a/drivers/soc/apple/pmp-export.c b/drivers/soc/apple/pmp-export.c
index 41091755a7..93a8aa9123 100644
--- a/drivers/soc/apple/pmp-export.c
+++ b/drivers/soc/apple/pmp-export.c
@@ -1,15 +1,24 @@
 // SPDX-License-Identifier: GPL-2.0-only OR MIT
 #include <linux/device.h>
 #include <linux/export.h>
+#include <linux/io.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/pm.h>
 #include <linux/soc/apple/pmp.h>
+#include <linux/soc/apple/pmp-display.h>
 #include <linux/soc/apple/pmp-report.h>
+#include <linux/soc/apple/rtkit.h>
+#include <linux/soc/apple/sleep.h>
+#include <linux/suspend.h>
 
 /* Join removal and serialize the firmware's untagged power reply stream. */
 static DEFINE_MUTEX(pmp_lock);
 static const void *pmp_data;
 static struct device *pmp_device;
+/* The firmware is stopped for a system sleep. */
+static bool pmp_asleep;
 
 int apple_pmp_register(struct device *dev, const void *data)
 {
@@ -66,6 +75,8 @@ int apple_pmp_set_device_power(u8 command, u16 device_id, u32 enabled)
 	guard(mutex)(&pmp_lock);
 	if (!pmp_data)
 		return -ENODEV;
+	if (pmp_asleep)
+		return -EAGAIN;
 	/* The matched native report must be ready; never use an elapsed-time fallback. */
 	ret = apple_pmp_report_wait_supplier_ready(pmp_device, 5000);
 	if (ret)
@@ -104,9 +115,148 @@ int apple_pmp_t6030_gpu_ready(void)
 	guard(mutex)(&pmp_lock);
 	if (!pmp_data)
 		return -ENODEV;
+	if (pmp_asleep)
+		return -EAGAIN;
 	ret = apple_pmp_report_set_t6030_gfx(pmp_device, false);
 	if (ret)
 		return ret;
 	return apple_pmp_report_set_t6030_gfx(pmp_device, true);
 }
 EXPORT_SYMBOL_GPL(apple_pmp_t6030_gpu_ready);
+
+/*
+ * The PMP's idle is a point of no return: an idled PMP doesn't come back with its power kept,
+ * and only a real sleep restarts it. Where the sleep driver can take them, its idle
+ * and stop move to the sleep's last step, after every refusal: a refused sleep then finds it
+ * still running, and the GPU's request, withdrawn at the commit, reaches a running PMP.
+ */
+static struct apple_pmp_commit_stop pmp_commit;
+static bool pmp_commit_registered, pmp_commit_used;
+
+/* Interrupts off, one CPU: what apple_pmp_sleep() does, through pointers taken before. */
+static int apple_pmp_commit_stop_fn(void *unused)
+{
+	struct apple_pmp_commit_stop *c = &pmp_commit;
+	unsigned int us;
+	size_t i;
+	int ret;
+
+	ret = apple_rtkit_sleep_idle_polled(c->rtk, c->control, &us);
+	apple_rtkit_mailbox_recv_off(c->rtk);
+	for (i = 0; c->sram && i < c->count; i++)
+		c->words[i] = readl_relaxed(c->sram + 4 * i);
+	/* Told to idle, it can't carry on whatever it answered: the sleep goes on. */
+	return ret ? 1 : 0;
+}
+
+/*
+ * Retained J713 power votes have no teardown. On T8140 an unbind leaves the firmware running,
+ * and a commit with it running reset the SoC: its sleep registration is what refuses
+ * then, every sleep until reboot, since a rebind can't register again.
+ */
+bool apple_pmp_keep_bound(void)
+{
+	return apple_pmp_display_retained_board() || of_machine_is_compatible("apple,t8140");
+}
+
+/* Whether the sleep's last step takes the PMP: registered with the sleep driver, once. */
+static bool apple_pmp_commit_available(struct device *dev)
+{
+	void __iomem *asc;
+	int idx;
+
+	if (pmp_commit_registered)
+		return true;
+	idx = of_property_match_string(dev->of_node, "reg-names", "asc");
+	asc = idx >= 0 ? of_iomap(dev->of_node, idx) : NULL;
+	if (!asc)
+		return false;
+	if (apple_sleep_coproc_register(dev, asc, false, apple_pmp_commit_stop_fn, NULL)) {
+		iounmap(asc);
+		return false;
+	}
+	pmp_commit_registered = true;
+
+	return true;
+}
+
+static int apple_pmp_commit_prepare(struct device *dev)
+{
+	int ret;
+
+	ret = apple_pmp_sleep_prepare(pmp_data, &pmp_commit);
+	if (ret)
+		return ret;
+	apple_sleep_coproc_set_ready(dev, true);
+	pmp_commit_used = true;
+	dev_dbg(dev, "idle and stop left for the sleep's commit\n");
+
+	return 0;
+}
+
+static int apple_pmp_suspend_late(struct device *dev)
+{
+	bool at_commit;
+	int ret;
+
+	if (!pm_suspend_via_firmware())
+		return 0;
+	/* Retained power votes have no teardown. */
+	if (apple_pmp_display_retained_board())
+		return -EBUSY;
+
+	guard(mutex)(&pmp_lock);
+	if (pmp_device != dev || pmp_asleep)
+		return 0;
+	at_commit = apple_pmp_commit_available(dev);
+	apple_pmp_report_sleep(dev, at_commit);
+	ret = at_commit ? apple_pmp_commit_prepare(dev) : apple_pmp_sleep(pmp_data);
+	if (ret) {
+		apple_pmp_report_wake(dev, false);
+		return dev_err_probe(dev, ret, "firmware did not go idle for sleep\n");
+	}
+	pmp_asleep = true;
+
+	return 0;
+}
+
+static int apple_pmp_resume_early(struct device *dev)
+{
+	int ret;
+
+	guard(mutex)(&pmp_lock);
+	if (!pmp_asleep)
+		return 0;
+	/* Left for the commit: if the sleep was refused before it, the firmware never idled. */
+	if (pmp_commit_used) {
+		bool stopped = apple_sleep_coproc_stopped(dev);
+
+		pmp_commit_used = false;
+		apple_sleep_coproc_set_ready(dev, false);
+		if (!pm_resume_via_firmware() && !stopped) {
+			pmp_asleep = false;
+			apple_pmp_report_wake(dev, true);
+			dev_info(dev, "sleep refused before the commit: firmware never stopped\n");
+			return 0;
+		}
+	}
