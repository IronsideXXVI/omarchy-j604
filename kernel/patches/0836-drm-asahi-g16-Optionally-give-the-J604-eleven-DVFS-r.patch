+    let top = pstate_max();
+    let floor = floor.clamp(1, top);
     let next = if util >= 70 {
-        PSTATE_MAX
+        top
     } else if util >= 40 {
         current.saturating_add(1)
     } else if average < 10 {
@@ -74,7 +89,7 @@ pub(crate) fn demand_floor(current: u32, util: u32, average: u32, floor: u32) ->
     } else {
         current
     };
-    next.clamp(floor, PSTATE_MAX)
+    next.clamp(floor, top)
 }
 
