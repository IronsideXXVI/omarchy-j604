+/// The words that depend on the top state's scaled value, for an eleven-row table (top 1000,
+/// as macOS 26B123 has them at INIT): max_scaled 1000, max_scaled - 100 = 900, 1000.0,
+/// -1000 / 36294 and (1000 - 100) / 95.
+pub(crate) const ELEVEN_ROWS: [(usize, u32); 25] = [
+    (0x48, 0x000003e8),
+    (0x88, 0x000003e8),
+    (0x9f4, 0x000003e8),
+    (0x9f8, 0x000003e8),
+    (0xa38, 0x000003e8),
+    (0xaac, 0x000003e8),
+    (0xb7c, 0x000003e8),
+    (0x221c, 0x000003e8),
+    (0x22b4, 0x000003e8),
+    (0x22b8, 0x000003e8),
+    (0x22f8, 0x000003e8),
+    (0x2870, 0x000003e8),
+    (0x29f8, 0x000003e8),
+    (0x29fc, 0x000003e8),
+    (0x2a3c, 0x000003e8),
+    (0x2b88, 0x000003e8),
+    (0x2c44, 0x000003e8),
+    (0x2e68, 0x000003e8),
+    (0x2e6c, 0x000003e8),
+    (0x2e78, 0x000003e8),
+    (0x2eac, 0x000003e8),
+    (0x9ec, 0xbce1b655), // -1000 / 36294
+    (0xb74, 0x41179436), // (1000 - 100) / 95
+    (0x21f8, 0x447a0000), // 1000.0
+    (0x2e64, 0x00000384), // max_scaled - 100 = 900
+];
+
 /// Byte words: the turbo controller's input is present (1), and it is not mode 1 (0).
 pub(crate) const BYTES: [(usize, u8); 2] = [(0x2518, 1), (0x2519, 0)];
 
@@ -245,11 +276,16 @@ fn put(out: &mut [u8], at: usize, bytes: &[u8]) -> Result<(), ()> {
 }
 
 /// Writes the controller words into a POWER_PERFORMANCE image; `top_frequency` is the
-/// ceiling row's main frequency, MHz.
-pub(crate) fn encode(pp: &mut [u8], top_frequency: u32) -> Result<(), ()> {
+/// ceiling row's main frequency, MHz, and `ceiling` its row (9, or 10 for eleven rows).
+pub(crate) fn encode(pp: &mut [u8], top_frequency: u32, ceiling: u32) -> Result<(), ()> {
     for (at, value) in WORDS {
         put(pp, at, &value.to_le_bytes())?;
     }
+    if ceiling == 10 {
+        for (at, value) in ELEVEN_ROWS {
+            put(pp, at, &value.to_le_bytes())?;
+        }
+    }
     for (at, value) in BYTES {
         put(pp, at, &[value])?;
     }
