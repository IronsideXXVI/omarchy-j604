@@ -7,6 +7,20 @@
 //! shared C cooling policy. This module defines no temperature thresholds.
 
 pub(crate) const PSTATE_MAX: u32 = 9;
+
+/// The top governed state of the selected table: [`PSTATE_MAX`] for ten firmware rows, one
+/// more for the J604's eleven rows (`g16_j604_rows11`), set once before the firmware starts.
+static TOP: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(PSTATE_MAX);
+
+/// The top governed state, [`PSTATE_MAX`] unless the table has an eleventh row.
+pub(crate) fn pstate_max() -> u32 {
+    TOP.load(core::sync::atomic::Ordering::Relaxed)
+}
+
+/// Sets the top governed state from the selected table's last row, [`PSTATE_MAX`] or one more.
+pub(crate) fn set_pstate_max(top: u32) {
+    TOP.store(top.clamp(PSTATE_MAX, PSTATE_MAX + 1), core::sync::atomic::Ordering::Relaxed);
+}
 pub(crate) const COOLING_MAX: u32 = 8;
 pub(crate) const SAMPLE_NS: u64 = 5_000_000;
 /// Utilization window of the governor.
@@ -25,7 +39,7 @@ pub(crate) fn read_due(last: Option<u64>, now: u64) -> bool {
 /// Zero is not an unlimited selector in the firmware. Every published state
 /// is 1..=9, bounded by the initialized Main table and the user ceiling.
 pub(crate) fn limit(configured: u32, ceiling: u32, user: u32) -> u32 {
-    ceiling.min(PSTATE_MAX).min(configured).min(user).max(1)
+    ceiling.min(pstate_max()).min(configured).min(user).max(1)
 }
 
