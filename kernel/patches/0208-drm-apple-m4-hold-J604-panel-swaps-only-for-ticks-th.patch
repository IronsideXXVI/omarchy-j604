From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 10 Nov 2026 06:06:55 +0000
Subject: [PATCH] drm/apple: m4: hold J604 panel swaps only for ticks
 the panel makes

The J604 panel lengthens its frame time by at most one 4.17 ms tick a
frame. When no new frame has come one tick past the last interval
between completions, it shows the last frame again, which takes two
ticks, and the new frame completes only after that. Measured on the
J604 with pacing off, during YouTube playback: an interval was never
followed by one exactly two ticks longer (four ticks after two: 0 of
619 windowed, 6 to 9 % fullscreen; six after four: 1 of about 1750),
but by one tick longer or by three.

swap_pace holds a video frame for the first even tick after the last
completion that it can still make. When a browser frame for the player
controls or the fullscreen exit hint completed two ticks after a video
frame, and the next video frame came too late for the second tick
after it, that frame was held for the fourth, which the panel does not
make, and completed on the fifth: three ticks off its cadence. Held
swaps aimed at the fourth tick after a two-tick interval missed it 83
to 85 % of the time (after a four-tick interval: 1 %), windowed and
fullscreen alike. Sent at once instead, such a frame can still make the
third tick, one tick off.

Do not hold a frame for a tick further out than the last completion
interval plus one tick; send it at once. swap_pace_ramp=N restores the
old behaviour at runtime.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/iomfb_m4.c | 26 +++++++++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index cb1329dba0..c989837d99 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -210,6 +210,11 @@ module_param(swap_pace_rt, bool, 0644);
 MODULE_PARM_DESC(swap_pace_rt,
 		 "J604: with swap_pace, sleep a held swap at low real-time priority (SCHED_FIFO), so that busy CPUs do not wake it late (default off)");
 
+static bool swap_pace_ramp = true;
+module_param(swap_pace_ramp, bool, 0644);
+MODULE_PARM_DESC(swap_pace_ramp,
+		 "J604: with swap_pace, do not hold a frame for a tick further out than the panel's last frame time plus one tick, which the panel does not make (default on)");
+
 static unsigned int swap_pace_lead_us;
 module_param(swap_pace_lead_us, uint, 0644);
 MODULE_PARM_DESC(swap_pace_lead_us,
@@ -1161,6 +1166,8 @@ struct dcp_m4_runtime {
 	/* Smoothed interval between internal-panel swap completions (1/8 EWMA, 0 after idle) */
 	u64 int_prev_done;
 	u64 int_iv_ewma;
+	/* The last interval between internal-panel swap completions (0 after idle) */
+	u64 int_last_iv;
 	struct dcp_m4_properties *properties;
 	struct dcp_m4_timing timing;
 	struct dcp_m4_swap_state swap;
@@ -1806,6 +1813,8 @@ static void dcp_m4_pace_learn(struct dcp_m4_runtime *r)
 		else
 			WRITE_ONCE(r->int_iv_ewma,
 				   r->int_iv_ewma ? (r->int_iv_ewma * 7 + iv) / 8 : iv);
+		WRITE_ONCE(r->int_last_iv,
+			   iv < div_u64(arch_timer_get_cntfrq(), 20) ? iv : 0);
 	}
 	r->int_prev_done = done;
 	if (e) {
@@ -2737,7 +2746,7 @@ static bool dcp_m4_ext_swap_give_up(struct dcp_m4_runtime *r, struct dcp_m4_swap
  */
 static unsigned long dcp_m4_swap_pace_us(struct dcp_m4_runtime *r)
 {
-	u64 freq, half, margin, base, now, lead, k, start;
+	u64 freq, half, margin, base, now, lead, k, start, last;
 	unsigned int lead_us, min_us;
 
 	r->int_gated = false;
@@ -2765,6 +2774,21 @@ static unsigned long dcp_m4_swap_pace_us(struct dcp_m4_runtime *r)
 	/* The first grid tick base + k * half (k even) at least lead + margin ahead. */
 	k = div64_u64(now + lead + margin - base + half - 1, half);
 	k += k & 1;
+	/*
+	 * The panel lengthens its frame time by at most one tick a frame: with
+	 * no new frame one tick past the last interval between completions,
+	 * it shows the last frame again, which takes two ticks, and the new
+	 * one comes after that. Measured: held swaps aimed at the fourth tick
+	 * after a two-tick interval completed on the fifth 83 to 85 % of the
+	 * time (1 % after a four-tick interval). A frame held for such a tick
+	 * gains nothing; sent at once, it may still make the tick before.
+	 */
+	last = READ_ONCE(r->int_last_iv);
+	if (READ_ONCE(swap_pace_ramp) && last &&
+	    k > div64_u64(last + half / 2, half) + 1) {
+		r->pace_n[1]++;
+		return 0;
+	}
 	/*
 	 * Start once the tick before it, base + (k - 1) * half, is out of reach
 	 * by swap_pace_margin_us: held swaps that take long still make the grid
