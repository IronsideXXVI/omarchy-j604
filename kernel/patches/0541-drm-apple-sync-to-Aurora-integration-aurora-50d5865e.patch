+static const struct {
+	const char *name;
+	u64 start;
+	u64 size;
+} t6041_dcp_regs[] = {
+	{ "coproc", 0x402e00000ULL, 0x4000 },
+	{ "disp-0", 0x400000000ULL, 0x4000000 },
+	{ "disp-1", 0x402240000ULL, 0x10000 },
+	{ "disp-2", 0x4023a8000ULL, 0x4000 },
+	{ "disp-3", 0x402800000ULL, 0x800000 },
