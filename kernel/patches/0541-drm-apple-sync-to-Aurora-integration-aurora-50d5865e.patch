-	/* No ceiling, or none above the user maximum: the level stands. */
-	KUNIT_EXPECT_EQ(test, dcp_m4_boost_level(140, 600, 0), 140U);
-	KUNIT_EXPECT_EQ(test, dcp_m4_boost_level(140, 600, 600), 140U);
-	KUNIT_EXPECT_EQ(test, dcp_m4_boost_level(700, 600, 1001), 1001U);
