+	ret = dcp_desktop_start_ep(dcp, DPAV_CTRL_ENDPOINT, dcp_dpavctrl_ops);
+	if (ret)
+		return ret;
+
+	if (!wait_for_completion_timeout(&dcp->desktop->dpavctrl_ready,
+					 msecs_to_jiffies(1000)))
+		return -ETIMEDOUT;
+	return 0;
