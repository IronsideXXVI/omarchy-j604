-	KUNIT_EXPECT_EQ(test, swap[0x354], 1);
-	KUNIT_EXPECT_EQ(test, swap[0x359], 0);
-	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x35e), dcp_m4_binary64_ratio(1001, 1));
-	KUNIT_EXPECT_EQ(test, get_unaligned_le64(swap + 0x35e), 0x408f480000000000ULL);
-}
-
-static struct kunit_case m4_edr_cases[] = {
