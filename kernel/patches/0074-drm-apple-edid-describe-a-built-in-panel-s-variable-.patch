From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 11:43:40 +0000
Subject: [PATCH] drm/apple: edid: describe a built-in panel's variable
 refresh range

The panel EDID made no refresh-range claim, so a panel offering VRR left
connector->display_info.monitor_range empty and gave user space nothing
to read the range from (Aurora fills monitor_range for the desktop 26.x
panels for that reason: iomfb.c, "An internal panel has no EDID ...").

Let a panel id carry a VRR range. When it does, the base block's third
descriptor becomes an EDID 1.4 Display Range Limits descriptor of the
"range limits only" kind, with the VRR range as its vertical rates, and
the block says continuous frequency: the form drm_get_monitor_range()
takes as the VRR range. The line rates cover the base DTD's (the panel's
totals at 60 Hz) and the panel's own, which a lower rate keeps (it
stretches the vertical blank); the pixel clock is the panel's. A half or
inverted range is refused. Without a range the EDID is unchanged.

Tests: the raw descriptor (rates, line-rate offset, clock, flags,
checksum, the HDR form) and the connector reading 48-120 Hz back.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/dcp-panel-edid-test.c | 77 +++++++++++++++++++++
 drivers/gpu/drm/apple/dcp-panel-edid.c      | 59 +++++++++++++++-
 drivers/gpu/drm/apple/dcp-panel-edid.h      |  5 ++
 3 files changed, 140 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/apple/dcp-panel-edid-test.c b/drivers/gpu/drm/apple/dcp-panel-edid-test.c
index ccede015f8..96b0d281e1 100644
--- a/drivers/gpu/drm/apple/dcp-panel-edid-test.c
+++ b/drivers/gpu/drm/apple/dcp-panel-edid-test.c
@@ -332,6 +332,81 @@ static void panel_edid_update_publishes_hdr(struct kunit *test)
 	KUNIT_EXPECT_TRUE(test, list_empty(&connector->probed_modes));
 }
 
+/*
+ * A panel with a variable refresh rate (T8132 panel_vrr_min_hz): the third
+ * base descriptor is a "range limits only" Display Range Limits descriptor
+ * with the VRR range, and the base block says continuous frequency. A
+ * fixed-rate panel keeps the third descriptor unused. A half range is refused.
+ */
+static void panel_edid_vrr_range(struct kunit *test)
+{
+	u8 *e = kunit_kzalloc(test, DCP_PANEL_EDID_HDR_BLOCKS * EDID_LENGTH, GFP_KERNEL);
+	const struct edid *base = (const struct edid *)e;
+	const u8 *d = e + 0x36 + 2 * 18;
+	struct dcp_panel_id id;
+
+	KUNIT_ASSERT_NOT_NULL(test, e);
+	panel_id_j516(test, &id);
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	KUNIT_EXPECT_EQ(test, d[3], 0x10);
+	KUNIT_EXPECT_EQ(test, base->features & DRM_EDID_FEATURE_CONTINUOUS_FREQ, 0);
+
+	id.vrr_min_hz = 48;
+	KUNIT_EXPECT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), -EINVAL);
+	id.vrr_max_hz = 48;
+	KUNIT_EXPECT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), -EINVAL);
+	id.vrr_max_hz = 120;
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build(&id, J516_W_MM, J516_H_MM, e), 0);
+	KUNIT_EXPECT_EQ(test, sum(e, EDID_LENGTH), 0);
+	KUNIT_EXPECT_TRUE(test, base->features & DRM_EDID_FEATURE_CONTINUOUS_FREQ);
+	KUNIT_EXPECT_EQ(test, d[0] | d[1] | d[2], 0);
+	KUNIT_EXPECT_EQ(test, d[3], EDID_DETAIL_MONITOR_RANGE);
+	KUNIT_EXPECT_EQ(test, d[5], 48);
+	KUNIT_EXPECT_EQ(test, d[6], 120);
+	/* J516: 1042130 kHz, vtotal 2456: line rate 147.36 kHz at 60 Hz, 294.7 at 120. */
+	KUNIT_EXPECT_EQ(test, d[7], 147);
+	KUNIT_EXPECT_EQ(test, d[8], 295 - 255);
+	KUNIT_EXPECT_EQ(test, d[4], DRM_EDID_RANGE_OFFSET_MAX_HFREQ);
+	KUNIT_EXPECT_EQ(test, d[9], 105);
+	KUNIT_EXPECT_EQ(test, d[10], DRM_EDID_RANGE_LIMITS_ONLY_FLAG);
+	/* The HDR form carries the same base block. */
+	id.hdr_max_nits = 1600;
+	KUNIT_ASSERT_EQ(test, dcp_panel_edid_build_hdr(&id, J516_W_MM, J516_H_MM, e), 0);
+	KUNIT_EXPECT_EQ(test, d[3], EDID_DETAIL_MONITOR_RANGE);
+	KUNIT_EXPECT_EQ(test, sum(e, EDID_LENGTH), 0);
+}
+
+/* The connector reads the VRR range back from the published EDID. */
+static void panel_edid_update_publishes_vrr_range(struct kunit *test)
+{
+	struct panel_edid_test *t;
+	struct drm_connector *connector;
+	struct dcp_panel_id id;
+	struct device *dev;
+	int ret;
+
+	dev = drm_kunit_helper_alloc_device(test);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	t = drm_kunit_helper_alloc_drm_device(test, dev, struct panel_edid_test, drm,
+					      DRIVER_MODESET);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, t);
+	connector = &t->connector;
+	ret = drmm_connector_init(&t->drm, connector, &panel_edid_connector_funcs,
+				  DRM_MODE_CONNECTOR_eDP, NULL);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	panel_id_j516(test, &id);
+	id.vrr_min_hz = 48;
+	id.vrr_max_hz = 120;
+	mutex_lock(&t->drm.mode_config.mutex);
+	ret = dcp_panel_edid_update(connector, &id, J516_W_MM, J516_H_MM);
+	mutex_unlock(&t->drm.mode_config.mutex);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	KUNIT_EXPECT_EQ(test, connector->display_info.monitor_range.min_vfreq, 48);
+	KUNIT_EXPECT_EQ(test, connector->display_info.monitor_range.max_vfreq, 120);
+	KUNIT_EXPECT_TRUE(test, list_empty(&connector->probed_modes));
+}
+
 static struct kunit_case panel_edid_cases[] = {
 	KUNIT_CASE(panel_id_from_compatible),
 	KUNIT_CASE(panel_id_needs_a_model_and_a_known_vendor),
@@ -341,6 +416,8 @@ static struct kunit_case panel_edid_cases[] = {
 	KUNIT_CASE(panel_edid_update_publishes_the_block),
 	KUNIT_CASE(panel_edid_hdr_block),
 	KUNIT_CASE(panel_edid_update_publishes_hdr),
+	KUNIT_CASE(panel_edid_vrr_range),
+	KUNIT_CASE(panel_edid_update_publishes_vrr_range),
 	{}
 };
 
diff --git a/drivers/gpu/drm/apple/dcp-panel-edid.c b/drivers/gpu/drm/apple/dcp-panel-edid.c
index 4554554e26..2c97185806 100644
--- a/drivers/gpu/drm/apple/dcp-panel-edid.c
+++ b/drivers/gpu/drm/apple/dcp-panel-edid.c
@@ -20,7 +20,10 @@
  * preferred timing, with the display parameters. Neither is a mode source:
  * the driver publishes the firmware's modes and never adds modes from this
  * EDID. It makes no other claim: no product code or serial number, no
- * manufacture week, no luminance and no refresh range.
+ * manufacture week and no luminance. A panel with a variable refresh rate
+ * gets its range as an EDID 1.4 Display Range Limits descriptor ("range
+ * limits only", continuous frequency), the form drm_edid.c takes as the VRR
+ * range; a fixed-rate panel gets no range.
  */
 
 #include <linux/ctype.h>
@@ -196,6 +199,50 @@ static void base_chromaticity(struct edid *block)
 	block->white_y = v[7] >> 2;
 }
 
+/* The most an EDID 1.4 range field holds: 255 plus its 255 offset. */
+#define DCP_PANEL_EDID_RANGE_MAX 510
+
+/* One rate of a range descriptor: the field, and whether it needs the offset. */
+static u8 range_rate(u32 v, bool *offset)
+{
+	*offset = v > 255;
+	return *offset ? v - 255 : v;
+}
+
+/*
+ * EDID 1.4 Display Range Limits, "range limits only": the vertical range is
+ * the panel's VRR range. The line rate is the panel's own at every rate (a
+ * lower rate stretches the vertical blank) and the base DTD's at
+ * DCP_PANEL_EDID_DTD_HZ, which has the same totals; the pixel clock is the
+ * panel's.
+ */
+static void base_range(u8 *d, const struct dcp_panel_id *id)
+{
+	const struct dcp_panel_timing *t = &id->timing;
+	u32 h_lo = t->vtotal * DCP_PANEL_EDID_DTD_HZ / 1000;
+	u32 h_hi = min_t(u32, DIV_ROUND_UP(t->clock_khz, t->htotal), DCP_PANEL_EDID_RANGE_MAX);
+	bool off_vlo, off_vhi, off_hlo, off_hhi;
+	unsigned int i;
+
+	memset(d, 0, 18);
+	d[3] = EDID_DETAIL_MONITOR_RANGE;
+	d[5] = range_rate(id->vrr_min_hz, &off_vlo);
+	d[6] = range_rate(id->vrr_max_hz, &off_vhi);
+	d[7] = range_rate(min(h_lo, h_hi), &off_hlo);
+	d[8] = range_rate(h_hi, &off_hhi);
+	/* A minimum may use its offset only with its maximum's (EDID 1.4). */
+	d[4] = (off_vlo ? DRM_EDID_RANGE_OFFSET_MIN_VFREQ : 0) |
+	       (off_vhi ? DRM_EDID_RANGE_OFFSET_MAX_VFREQ : 0) |
+	       (off_hlo ? DRM_EDID_RANGE_OFFSET_MIN_HFREQ : 0) |
+	       (off_hhi ? DRM_EDID_RANGE_OFFSET_MAX_HFREQ : 0);
+	/* Maximum pixel clock in 10 MHz units. */
+	d[9] = min_t(u32, DIV_ROUND_UP(t->clock_khz, 10000), 255);
+	d[10] = DRM_EDID_RANGE_LIMITS_ONLY_FLAG;
+	d[11] = '\n';
+	for (i = 12; i < 18; i++)
+		d[i] = ' ';
+}
+
 static int base_block(const struct dcp_panel_id *id, int width_mm, int height_mm,
 		      struct edid *block)
 {
@@ -235,6 +282,11 @@ static int base_block(const struct dcp_panel_id *id, int width_mm, int height_mm
 		name->data.str.str[len] = '\n';
 	for (i = 2; i < ARRAY_SIZE(block->detailed_timings); i++)
 		block->detailed_timings[i].data.other_data.type = 0x10;
+	/* A variable refresh range: the third descriptor, and continuous frequency. */
+	if (id->vrr_max_hz) {
+		base_range((u8 *)&block->detailed_timings[2], id);
+		block->features |= DRM_EDID_FEATURE_CONTINUOUS_FREQ;
+	}
 	block->extensions = DCP_PANEL_EDID_BLOCKS - 1;
 	checksum((u8 *)block, EDID_LENGTH);
 	return 0;
@@ -321,6 +373,11 @@ int dcp_panel_edid_build(const struct dcp_panel_id *id, int width_mm, int height
 		return -EINVAL;
 	if (!timing_valid(&id->timing))
 		return -EINVAL;
+	/* A range is both rates or neither, the minimum below the maximum. */
+	if ((id->vrr_min_hz || id->vrr_max_hz) &&
+	    (!id->vrr_min_hz || id->vrr_min_hz >= id->vrr_max_hz ||
+	     id->vrr_max_hz > DCP_PANEL_EDID_RANGE_MAX))
+		return -EINVAL;
 	ret = base_block(id, width_mm, height_mm, (struct edid *)edid);
 	if (ret)
 		return ret;
diff --git a/drivers/gpu/drm/apple/dcp-panel-edid.h b/drivers/gpu/drm/apple/dcp-panel-edid.h
index 36b17a2da4..0e77def9f2 100644
--- a/drivers/gpu/drm/apple/dcp-panel-edid.h
+++ b/drivers/gpu/drm/apple/dcp-panel-edid.h
@@ -25,6 +25,11 @@ struct dcp_panel_id {
 	u16 model_year;				/* the model's year, 0 if unknown */
 	struct dcp_panel_timing timing;		/* zero if unknown */
 	u16 hdr_max_nits;			/* HDR peak for a CTA-861 block, 0: SDR */
+	/*
+	 * A variable refresh range, minimum and maximum in Hz (both 0: fixed);
+	 * the base block then carries a Display Range Limits descriptor.
+	 */
+	u16 vrr_min_hz, vrr_max_hz;
 };
 
 struct drm_connector;
