 drivers/thunderbolt/tb.h          |   5 +
 drivers/thunderbolt/test.c        | 357 ++++++++++++++++++++++++++++++
 drivers/thunderbolt/tunnel.c      |   6 +
 drivers/thunderbolt/tunnel.h      |  25 ++-
 tools/asahi/tb-dp-repair-tests.py |   9 +-
