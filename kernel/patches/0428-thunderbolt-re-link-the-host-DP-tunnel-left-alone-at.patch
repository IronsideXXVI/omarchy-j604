+	KUNIT_EXPECT_EQ(test, tb_dp_relink_activation(false, false), TB_DP_RELINK_NONE);
+	/* The recovery: HBR2 at most even alone; afterwards HBR3 alone again */
+	KUNIT_EXPECT_EQ(test, tb_dp_host_rate_after(1, true), 5400);
