From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 08:19:16 +0000
Subject: [PATCH] ASoC: tas2764: per-amplifier Apple shutdown dance, on
 for the J604

macOS brackets every software shutdown of the J604's six SN012776
amplifiers with writes to the vendor's hidden page 0xfd: 0x0d = 0x0d,
0x64 = 0x04, 0x0d = 0x00, then PWR_CTRL shutdown, then 0x0d = 0x0d,
0x64 = 0x00, 0x0d = 0x00. Measured on the J604 under macOS 26B123 with
the I2C3 controller traced around a short system sound: the same
sequence on all six amplifiers, 0.59 s after the last mute; power-up
and mute transitions carry no hidden-page writes.

The driver already implements exactly this as TAS2764_SHUTDOWN_DANCE,
but only for every amplifier at once through ENABLED_APPLE_QUIRKS,
which leaves it off. Add an "apple,shutdown-dance" property so a
machine whose Apple driver does it gets it on its SN012776 amplifiers
(with the dance's immediate-SDZ init step), and set it on the J604's
six. Every other machine is unchanged.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 .../devicetree/bindings/sound/ti,tas27xx.yaml |  8 ++++++++
 arch/arm64/boot/dts/apple/t8132-j604.dts      |  6 ++++++
 sound/soc/codecs/tas2764.c                    | 20 +++++++++++++++++--
 3 files changed, 32 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/sound/ti,tas27xx.yaml b/Documentation/devicetree/bindings/sound/ti,tas27xx.yaml
index 6071212d17..00cc6cc9ce 100644
--- a/Documentation/devicetree/bindings/sound/ti,tas27xx.yaml
+++ b/Documentation/devicetree/bindings/sound/ti,tas27xx.yaml
@@ -114,6 +114,14 @@ properties:
       must not enter software shutdown until the bus has stopped. One shut
       down while the bus still runs can leave garbage in its sense slots.
 
+  apple,shutdown-dance:
+    type: boolean
+    description:
+      SN012776 only. Around every entry to software shutdown, write the
+      vendor's hidden page (0xfd) as Apple's driver does on this machine:
+      register 0x64 set to 4 before the shutdown and back to 0 after it,
+      with immediate SDZ mode set at initialisation.
+
   ti,imon-slot-no:
     $ref: /schemas/types.yaml#/definitions/uint32
     description: TDM TX current sense time slot.
diff --git a/arch/arm64/boot/dts/apple/t8132-j604.dts b/arch/arm64/boot/dts/apple/t8132-j604.dts
index 3a964b0400..7095c2c765 100644
--- a/arch/arm64/boot/dts/apple/t8132-j604.dts
+++ b/arch/arm64/boot/dts/apple/t8132-j604.dts
@@ -128,6 +128,7 @@ speaker_left_woof1: codec@38 {
 		SDZ-supply = <&speaker_sdz>;
 		apple,sdz-group-fail-closed;
 		apple,deferred-shutdown;
+		apple,shutdown-dance;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "Left Woofer 1";
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
@@ -141,6 +142,7 @@ speaker_left_woof2: codec@39 {
 		SDZ-supply = <&speaker_sdz>;
 		apple,sdz-group-fail-closed;
 		apple,deferred-shutdown;
+		apple,shutdown-dance;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "Left Woofer 2";
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
@@ -154,6 +156,7 @@ speaker_left_tweet: codec@3a {
 		SDZ-supply = <&speaker_sdz>;
 		apple,sdz-group-fail-closed;
 		apple,deferred-shutdown;
+		apple,shutdown-dance;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "Left Tweeter";
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
@@ -167,6 +170,7 @@ speaker_right_woof1: codec@3b {
 		SDZ-supply = <&speaker_sdz>;
 		apple,sdz-group-fail-closed;
 		apple,deferred-shutdown;
+		apple,shutdown-dance;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "Right Woofer 1";
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
@@ -180,6 +184,7 @@ speaker_right_woof2: codec@3c {
 		SDZ-supply = <&speaker_sdz>;
 		apple,sdz-group-fail-closed;
 		apple,deferred-shutdown;
+		apple,shutdown-dance;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "Right Woofer 2";
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
@@ -193,6 +198,7 @@ speaker_right_tweet: codec@3d {
 		SDZ-supply = <&speaker_sdz>;
 		apple,sdz-group-fail-closed;
 		apple,deferred-shutdown;
+		apple,shutdown-dance;
 		#sound-dai-cells = <0>;
 		sound-name-prefix = "Right Tweeter";
 		interrupts-extended = <&pinctrl_ap 14 IRQ_TYPE_LEVEL_LOW>;
diff --git a/sound/soc/codecs/tas2764.c b/sound/soc/codecs/tas2764.c
index 887de36981..1b80c87682 100644
--- a/sound/soc/codecs/tas2764.c
+++ b/sound/soc/codecs/tas2764.c
@@ -90,6 +90,8 @@ struct tas2764_priv {
 
 	/* apple,deferred-shutdown: software shutdown waits for the bus clock to stop */
 	bool deferred_shutdown;
+	/* apple,shutdown-dance: the hidden-page writes around software shutdown */
+	bool shutdown_dance;
 	/* Muted at a stream's end, until the next one: the bus clock may stop */
 	bool stream_stopped;
 	struct delayed_work shutdown_work;
@@ -316,6 +318,17 @@ static void tas2764_reset(struct tas2764_priv *tas2764)
 	usleep_range(1000, 2000);
 }
 
+/*
+ * Apple's shutdown dance (tas2764-quirks.h): on for every amplifier when
+ * ENABLED_APPLE_QUIRKS has it, else on an SN012776 whose node carries
+ * apple,shutdown-dance, as macOS does on that machine.
+ */
+static bool tas2764_shutdown_dance(struct tas2764_priv *tas2764)
+{
+	return (ENABLED_APPLE_QUIRKS & TAS2764_SHUTDOWN_DANCE) ||
+	       (tas2764->shutdown_dance && tas2764->devid == DEVID_SN012776);
+}
+
 static int tas2764_update_pwr_ctrl(struct tas2764_priv *tas2764)
 {
 	struct snd_soc_component *component = tas2764->component;
@@ -331,7 +344,7 @@ static int tas2764_update_pwr_ctrl(struct tas2764_priv *tas2764)
 	else
 		val = TAS2764_PWR_CTRL_SHUTDOWN;
 
-	if (ENABLED_APPLE_QUIRKS & TAS2764_SHUTDOWN_DANCE)
+	if (tas2764_shutdown_dance(tas2764))
 		return tas2764_do_quirky_pwr_ctrl_change(tas2764, val);
 
 	ret = snd_soc_component_update_bits(component, TAS2764_PWR_CTRL,
@@ -963,7 +976,8 @@ static int tas2764_apply_init_quirks(struct tas2764_priv *tas2764)
 		if (!init_seq->seq)
 			continue;
 
-		if (!(BIT(i) & ENABLED_APPLE_QUIRKS))
+		if (!(BIT(i) & ENABLED_APPLE_QUIRKS) &&
+		    !(BIT(i) == TAS2764_SHUTDOWN_DANCE && tas2764_shutdown_dance(tas2764)))
 			continue;
 
 		ret = regmap_multi_reg_write(tas2764->regmap, init_seq->seq,
@@ -1607,6 +1621,8 @@ static int tas2764_parse_dt(struct device *dev, struct tas2764_priv *tas2764)
 
 	tas2764->deferred_shutdown = of_property_read_bool(dev->of_node,
 							   "apple,deferred-shutdown");
+	tas2764->shutdown_dance = of_property_read_bool(dev->of_node,
+							"apple,shutdown-dance");
 
 	ret = tas2764_parse_bop_config(dev, tas2764);
 	if (ret)
-- 
