+            self.power.governor,
+            self.power.budget,
+            self.power.utilization.demand,
+            self.power.utilization.average,
+            self.power.effective, self.power.temperature_mc, self.power.updates,
+            self.power.sensor_errors
         )?;
         writeln!(
             f,
