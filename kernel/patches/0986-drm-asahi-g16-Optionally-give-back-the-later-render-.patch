+/// Storage of `g16_unit_trim` (runtime 0644, default 0).
+static UNIT_TRIM: AtomicU32 = AtomicU32::new(0);
+
+/// `g16_unit_trim` N: the next submission of a VM that has had no render command outstanding
+/// for N ms first gives back the render units it built after its first render, from the
+/// top, down to what that render built or what the submission needs (resources.rs,
+/// unit_trim.rs). A unit stays while its index is busy, pending or left quarantined by the
+/// VM. 0 (default): a VM keeps every unit it built until it closes, as before.
+pub(crate) fn unit_trim_ms() -> u32 {
+    UNIT_TRIM.load(Ordering::Relaxed)
+}
