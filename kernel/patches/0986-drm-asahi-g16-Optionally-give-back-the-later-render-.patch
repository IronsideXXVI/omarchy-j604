 impl Shared {
+    /// `g16_unit_trim`: the indices in `lo..hi` whose unit of VM `vm` may be freed now, from
+    /// the render units' state under the device lock (slots.rs); none while a system sleep
+    /// is under way or without a running backend.
+    pub(crate) fn unit_free_mask(&self, vm: u64, lo: usize, hi: usize) -> u32 {
+        if self.sleeping.load(Ordering::Acquire) {
+            return 0;
+        }
+        let state = self.state.lock();
+        let Some(fw) = state.as_deref() else {
+            return 0;
+        };
+        (lo..hi.min(32))
+            .filter(|&k| fw.slots.unit_free_ok(vm, k))
+            .fold(0, |m, k| m | 1 << k)
+    }
