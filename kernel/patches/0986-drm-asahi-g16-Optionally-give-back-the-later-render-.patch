+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! `g16_unit_trim`: a live VM gives back the render units it built later, as pure rules.
+//!
+//! With `g16_resident_lazy` a VM builds one more unit whenever it has more render commands
+//! outstanding than units, and it used to keep every unit until it closed: a compositor that
+//! once queued eight frames held eight units for good. With the word, the next submission of a
+//! VM that has had no render command outstanding for the trim delay first gives back its later
+//! units, from the top, down to what its first render builds or what this submission needs.
+//!
+//! A unit's memory may go when (all CODE): no job of the VM exists (render_out 0 under the VM's
+//! resource mutex), no build worker runs, and on the unit's index no flight runs, no
+//! publication is pending, and either another VM's render last retired there or the VM's own
+//! last render there passed its full receipt (not quarantined). After a full receipt the
+//! firmware has cleared the index's UMA binding and saved its row into the descriptor (GPU-FW
+//! 1824Z); a skipped retire keeps the binding and leaves the index quarantined. Whether the
+//! firmware reads a PB manager or heap after the render's retire is not decoded (TO-VERIFY).
+
+/// The unit count to trim down to: what the first render builds (`keep`), or this
+/// submission's renders if more, never more than is built.
+pub(crate) const fn target(keep: usize, built: usize, renders: usize) -> usize {
+    let want = if renders > keep { renders } else { keep };
+    if want < built {
+        want
+    } else {
+        built
+    }
+}
+
+/// Whether the VM has been idle long enough: `since` (ns, 0 never idle yet) at least `ms`
+/// milliseconds before `now`.
+pub(crate) const fn idle_long(since: u64, now: u64, ms: u32) -> bool {
+    ms != 0 && since != 0 && now >= since && now - since >= ms as u64 * 1_000_000
+}
+
+/// Whether the VM's unit on index `k` may be freed, from the index's state under the device
+/// lock: no flight on it, no publication pending on it, and not the VM's own last render left
+/// quarantined there.
+pub(crate) const fn may_free(busy: bool, pending: bool, mine: bool, retired: bool) -> bool {
+    !busy && !pending && (!mine || retired)
+}
+
+/// How many units remain after trimming from the top: units `target..built` go while their
+/// bit in `ok` is set; the first unit that may not go stops the trim (units stay in order).
+pub(crate) const fn remain(target: usize, built: usize, ok: u32) -> usize {
+    let mut n = built;
+    while n > target && n <= 32 && ok & (1 << (n - 1)) != 0 {
+        n -= 1;
+    }
+    n
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn targets() {
+        assert_eq!(target(2, 8, 1), 2);
+        assert_eq!(target(2, 8, 5), 5);
+        assert_eq!(target(2, 3, 9), 3);
+        assert_eq!(target(1, 8, 1), 1);
+        assert_eq!(target(2, 2, 1), 2);
+        assert_eq!(target(2, 1, 1), 1);
+    }
+
+    #[test]
+    fn idle_needs_the_whole_delay() {
+        assert!(!idle_long(0, 10_000_000_000, 100));
+        assert!(!idle_long(5, 10_000_000_000, 0));
+        assert!(!idle_long(1_000_000_000, 1_099_999_999, 100));
+        assert!(idle_long(1_000_000_000, 1_100_000_000, 100));
+        assert!(!idle_long(2_000_000_000, 1_000_000_000, 1));
+    }
+
+    #[test]
+    fn a_unit_in_use_or_quarantined_stays() {
+        assert!(may_free(false, false, false, false));
+        assert!(may_free(false, false, true, true));
+        assert!(!may_free(true, false, false, true));
+        assert!(!may_free(false, true, false, true));
+        assert!(!may_free(false, false, true, false));
+    }
+
+    #[test]
+    fn trims_from_the_top_and_stops_at_the_first_unit_that_stays() {
+        assert_eq!(remain(2, 8, 0xff), 2);
+        assert_eq!(remain(2, 8, 0b1011_1111), 7);
+        assert_eq!(remain(2, 8, 0b0111_1111), 8);
+        assert_eq!(remain(2, 8, 0b1110_1111), 5);
+        assert_eq!(remain(2, 2, 0xff), 2);
+        assert_eq!(remain(0, 32, u32::MAX), 0);
+        assert_eq!(remain(4, 40, u32::MAX), 40);
+    }
+
+    /// A VM through bursts and idle gaps: units are freed only while idle, only down to the
+    /// target, and never below what its first render built.
+    #[test]
+    fn a_model_of_bursts_and_idle() {
+        let keep = 2;
+        let mut built = keep;
+        let mut seed = 7u64;
+        for step in 0..10_000u64 {
+            seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            let renders = 1 + (seed >> 33) as usize % 8;
+            let idle = (seed >> 40) % 3 == 0;
+            let ok = (seed >> 7) as u32;
+            if idle {
+                let t = target(keep, built, renders);
+                let n = remain(t, built, ok);
+                assert!(n >= t && n <= built && n >= keep, "step {step}");
+                built = n;
+            }
+            if renders > built {
+                built = renders.min(8);
+            }
+        }
+    }
+}
