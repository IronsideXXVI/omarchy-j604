From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 21:24:34 +0000
Subject: [PATCH] drm/apple: t8132: scan out 10 bpc framebuffers on
 external outputs

The primary plane of a T8132 external output offers only XRGB8888 and
ARGB8888, so a compositor driving an HDR10 or deep colour link (10 bpc
since the HDR10 commits) still renders 8-bit frames into it: PQ
bands.

Offer XRGB2101010 and ARGB2101010 too. A linear 10 bpc framebuffer is
scanned out directly as an 'l10r' surface under the same rules as an
8 bpc one (both are 4 bytes a pixel); one that cannot be is copied
into a copy surface retagged with its depth, which then takes the
whole frame, as does the next one of the other depth. Frames are
presented opaque, as before.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
(cherry picked from commit 64fa74382b1a055a3866f932555dc11a3397da9b)
---
 drivers/gpu/drm/apple/iomfb_m4.c      | 18 ++++++++++++++----
 drivers/gpu/drm/apple/iomfb_m4.h      | 17 +++++++++--------
 drivers/gpu/drm/apple/t8132_ext_drm.c | 20 ++++++++++++++------
 3 files changed, 37 insertions(+), 18 deletions(-)

diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index 39b30702a6..b802628c23 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -5349,7 +5349,8 @@ static void dcp_m4_ext_frame_colour(const struct dcp_m4_runtime *r, struct dcp_m
 }
 
 /*
- * Two host-written XRGB8888 surfaces in the display DART's SID0, each allocated
+ * Two host-written surfaces in the display DART's SID0 (XRGB8888 until a
+ * 10 bpc frame is copied into one, see iomfb_m4_ext_present()), each allocated
  * once for the largest mode (3840x2160) and reused for every mode, so that
  * mode changes never use up the SID0 arena. Both are stale: the next two
  * frames are copied whole.
@@ -5661,9 +5662,10 @@ static u64 dcp_m4_ext_copy(void *dst, u32 stride, const struct iosys_map *src, u
  * swapped without a mode, a sink or the display DART (its last D572).
  */
 int iomfb_m4_ext_present(struct apple_dcp *owner, const struct iosys_map *src, u32 pitch,
-			 const struct drm_rect *damage)
+			 u32 format, const struct drm_rect *damage)
 {
 	struct iomfb_m4 *dcp = owner->v26_6;
+	enum dcp_m4_frame_format fmt;
 	struct dcp_m4_runtime *r;
 	struct drm_rect full, rect, cur;
 	struct dcp_m4_frame *f;
@@ -5739,6 +5741,12 @@ int iomfb_m4_ext_present(struct apple_dcp *owner, const struct iosys_map *src, u
 	if (!cpu || f->width != r->ext_width || f->height != r->ext_height ||
 	    pitch < f->width * 4)
 		goto out;
+	ret = -EINVAL;
+	if (dcp_m4_ext_format(format, &fmt))
+		goto out;
+	/* A surface last given the other depth takes the whole frame. */
+	if (dcp_m4_ext_retag(f, fmt))
+		r->ext_buf_stale[back] = true;
 	full = DRM_RECT_INIT(0, 0, f->width, f->height);
 	cur = *damage;
 	if (!drm_rect_intersect(&cur, &full))
@@ -6173,6 +6181,7 @@ static void dcp_m4_ext_async_work(struct work_struct *work)
 int iomfb_m4_ext_present_direct(struct apple_dcp *owner, const struct iomfb_m4_ext_fb *fb)
 {
 	struct iomfb_m4 *dcp = owner->v26_6;
+	enum dcp_m4_frame_format fmt;
 	struct dcp_m4_runtime *r;
 	struct dcp_m4_frame f;
 	int ret = -ENOLINK, w;
@@ -6212,7 +6221,8 @@ int iomfb_m4_ext_present_direct(struct apple_dcp *owner, const struct iomfb_m4_e
 	ret = -EOPNOTSUPP;
 	need = PAGE_ALIGN((size_t)fb->pitch * fb->height);
 	if (fb->width != r->ext_width || fb->height != r->ext_height ||
-	    fb->pitch < fb->width * 4 || fb->pitch % 64 || need > SZ_32M)
+	    fb->pitch < fb->width * 4 || fb->pitch % 64 || need > SZ_32M ||
+	    dcp_m4_ext_format(fb->format, &fmt))
 		goto out;
 	/* Last before the DART is touched; no callback is handled until the swap. */
 	ret = dcp_m4_ext_scanout_gate(dcp);
@@ -6239,7 +6249,7 @@ int iomfb_m4_ext_present_direct(struct apple_dcp *owner, const struct iomfb_m4_e
 	f = (struct dcp_m4_frame) {
 		.dva = r->ext_win[w].dva, .backing_size = (u64)r->ext_win[w].count * SZ_16K,
 		.width = fb->width, .height = fb->height, .stride = fb->pitch,
-		.format = DCP_M4_XRGB8888,
+		.format = fmt,
 	};
 	dcp_m4_ext_frame_colour(r, &f);
 	r->ext_hold_probe = false;
diff --git a/drivers/gpu/drm/apple/iomfb_m4.h b/drivers/gpu/drm/apple/iomfb_m4.h
index 8e18246ffa..8e445a49fb 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.h
+++ b/drivers/gpu/drm/apple/iomfb_m4.h
@@ -40,15 +40,16 @@ struct iomfb_m4_ext_want {
 };
 
 /*
- * A framebuffer for direct scanout (XRGB8888/ARGB8888, linear, from its first
- * byte), by its @key: @pages gives the 16 KiB pages behind it (an array the
- * callee frees) for its first mapping; @get and @put take and drop the
- * reference a window holds on it while it may be scanned out (@put never under
- * the session lock).
+ * A framebuffer for direct scanout (XRGB8888, ARGB8888, XRGB2101010 or
+ * ARGB2101010 by its DRM @format, linear, from its first byte), by its
+ * @key: @pages gives the 16 KiB pages behind it (an array the callee frees)
+ * for its first mapping; @get and @put take and drop the reference a window
+ * holds on it while it may be scanned out (@put never under the session
+ * lock).
  */
 struct iomfb_m4_ext_fb {
 	void *key;
-	u32 width, height, pitch;
+	u32 width, height, pitch, format;
 	int (*pages)(void *key, phys_addr_t **phys, unsigned int *count);
 	void (*get)(void *key);
 	void (*put)(void *key);
@@ -86,7 +87,7 @@ int iomfb_m4_ext_mode_ids(struct apple_dcp *dcp, const struct drm_display_mode *
 int iomfb_m4_ext_enable(struct apple_dcp *dcp, const struct iomfb_m4_ext_ids *ids,
 			u32 width, u32 height);
 int iomfb_m4_ext_present(struct apple_dcp *dcp, const struct iosys_map *src, u32 pitch,
-			 const struct drm_rect *damage);
+			 u32 format, const struct drm_rect *damage);
 int iomfb_m4_ext_blank(struct apple_dcp *dcp);
 /* HDR10 static metadata of a PQ link's connector state; the InfoFrame stopped. */
 void iomfb_m4_ext_hdr_sync(struct apple_dcp *dcp, const struct drm_connector_state *state);
@@ -167,7 +168,7 @@ static inline int iomfb_m4_ext_enable(struct apple_dcp *dcp, const struct iomfb_
 }
 
 static inline int iomfb_m4_ext_present(struct apple_dcp *dcp, const struct iosys_map *src,
-				       u32 pitch, const struct drm_rect *damage)
+				       u32 pitch, u32 format, const struct drm_rect *damage)
 {
 	return -ENODEV;
 }
diff --git a/drivers/gpu/drm/apple/t8132_ext_drm.c b/drivers/gpu/drm/apple/t8132_ext_drm.c
index c191977715..ec729c35cd 100644
--- a/drivers/gpu/drm/apple/t8132_ext_drm.c
+++ b/drivers/gpu/drm/apple/t8132_ext_drm.c
@@ -127,6 +127,8 @@ static bool t8132_ext_pm_registered;
 static const u32 t8132_ext_formats[] = {
 	DRM_FORMAT_XRGB8888,
 	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_XRGB2101010,
+	DRM_FORMAT_ARGB2101010,
 };
 
 static const u64 t8132_ext_modifiers[] = {
@@ -355,8 +357,9 @@ static void t8132_ext_direct_refused(struct t8132_ext_out *out, struct drm_frame
  * The frame scanned out directly from @fb: 3 once its swap is submitted
  * with none older in flight (its flip now), 2 once submitted otherwise (its
  * flip comes later, t8132_ext_drm_flip_done()), -ENOSPC or -EOPNOTSUPP to
- * copy it instead, else the error (the frame lost). A linear XRGB8888 or
- * ARGB8888 GEM DMA buffer, own or imported, from its first byte, at the
+ * copy it instead, else the error (the frame lost). A linear XRGB8888,
+ * ARGB8888, XRGB2101010 or ARGB2101010 (10 bpc for an HDR10 or deep colour
+ * link) GEM DMA buffer, own or imported, from its first byte, at the
  * mode's size, the pitch a multiple of 64 bytes, at most 32 MiB, and every
  * 16 KiB of it one 16 KiB page (t8132_ext_fb_pages()).
  *
@@ -376,6 +379,7 @@ static int t8132_ext_present_direct(struct t8132_ext_out *out, struct apple_dcp
 	const struct drm_display_mode *mode = &out->crtc.state->mode;
 	struct iomfb_m4_ext_fb d = {
 		.key = fb, .width = fb->width, .height = fb->height, .pitch = fb->pitches[0],
+		.format = fb->format->format,
 		.pages = t8132_ext_fb_pages, .get = t8132_ext_fb_get, .put = t8132_ext_fb_put,
 	};
 	const char *why = NULL;
@@ -384,8 +388,10 @@ static int t8132_ext_present_direct(struct t8132_ext_out *out, struct apple_dcp
 	if (fb->modifier != DRM_FORMAT_MOD_LINEAR)
 		why = "not linear";
 	else if (fb->format->format != DRM_FORMAT_XRGB8888 &&
-		 fb->format->format != DRM_FORMAT_ARGB8888)
-		why = "not XRGB8888 or ARGB8888";
+		 fb->format->format != DRM_FORMAT_ARGB8888 &&
+		 fb->format->format != DRM_FORMAT_XRGB2101010 &&
+		 fb->format->format != DRM_FORMAT_ARGB2101010)
+		why = "not XRGB8888, ARGB8888, XRGB2101010 or ARGB2101010";
 	else if (fb->offsets[0])
 		why = "not from its first byte";
 	else if (fb->width != mode->hdisplay || fb->height != mode->vdisplay)
@@ -464,7 +470,8 @@ static int t8132_ext_present(struct t8132_ext_out *out, struct drm_atomic_commit
 		if (!dma->vaddr)
 			return -EINVAL;
 		iosys_map_set_vaddr(&data, dma->vaddr + fb->offsets[0]);
-		return iomfb_m4_ext_present(owner, &data, fb->pitches[0], &damage);
+		return iomfb_m4_ext_present(owner, &data, fb->pitches[0], fb->format->format,
+					     &damage);
 	}
 	buf = obj->import_attach->dmabuf;
 	ret = dma_buf_vmap_unlocked(buf, &map);
@@ -474,7 +481,8 @@ static int t8132_ext_present(struct t8132_ext_out *out, struct drm_atomic_commit
 	if (!ret) {
 		data = map;
 		iosys_map_incr(&data, fb->offsets[0]);
-		ret = iomfb_m4_ext_present(owner, &data, fb->pitches[0], &damage);
+		ret = iomfb_m4_ext_present(owner, &data, fb->pitches[0], fb->format->format,
+					   &damage);
 		dma_buf_end_cpu_access(buf, DMA_FROM_DEVICE);
 	}
 	dma_buf_vunmap_unlocked(buf, &map);
