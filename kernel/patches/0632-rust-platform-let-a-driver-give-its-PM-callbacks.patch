From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:14 -0500
Subject: [PATCH] rust: platform: let a driver give its PM callbacks

A Rust platform driver has no way to set driver.pm, so one that has to
run in a particular suspend phase, or to refuse a suspend, can't. Add a
pm_ops() method that defaults to none, and helpers for
pm_suspend_via_firmware() and pm_resume_via_firmware(), which a driver
needs in order to tell a firmware-driven suspend from any other.

No driver changes behaviour here.

Signed-off-by: Diljit Singh <hey@djdev.me>

[j604 backport: resolved: rust/helpers/helpers.c here has no srcu.c helper; only suspend.c is added]
Assisted-by: Claude:claude-opus-5.5

---
 rust/helpers/helpers.c  |  1 +
 rust/helpers/suspend.c  | 13 +++++++++++++
 rust/kernel/platform.rs |  6 ++++++
 3 files changed, 20 insertions(+)
 create mode 100644 rust/helpers/suspend.c

diff --git a/rust/helpers/helpers.c b/rust/helpers/helpers.c
index c90393ecac..c7ec982a2b 100644
--- a/rust/helpers/helpers.c
+++ b/rust/helpers/helpers.c
@@ -99,6 +99,7 @@
 #include "slab.c"
 #include "spinlock.c"
 #include "string.c"
+#include "suspend.c"
 #include "sync.c"
 #include "task.c"
 #include "time.c"
diff --git a/rust/helpers/suspend.c b/rust/helpers/suspend.c
new file mode 100644
index 0000000000..a616907ecc
--- /dev/null
+++ b/rust/helpers/suspend.c
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/suspend.h>
+
+__rust_helper bool rust_helper_pm_suspend_via_firmware(void)
+{
+	return pm_suspend_via_firmware();
+}
+
+__rust_helper bool rust_helper_pm_resume_via_firmware(void)
+{
+	return pm_resume_via_firmware();
+}
diff --git a/rust/kernel/platform.rs b/rust/kernel/platform.rs
index 10ccce3c30..916155327f 100644
--- a/rust/kernel/platform.rs
+++ b/rust/kernel/platform.rs
@@ -80,6 +80,7 @@ unsafe impl<T: Driver> driver::RegistrationOps for Adapter<T> {
             (*pdrv.get()).driver.of_match_table = of_table;
             (*pdrv.get()).driver.acpi_match_table = acpi_table;
             (*pdrv.get()).driver.suppress_bind_attrs = T::suppress_bind_attrs();
+            (*pdrv.get()).driver.pm = T::pm_ops().map_or(core::ptr::null(), core::ptr::from_ref);
         }
 
         // SAFETY: `pdrv` is guaranteed to be a valid `DriverType`.
@@ -231,6 +232,11 @@ pub trait Driver {
         false
     }
 
+    /// The driver's power management callbacks, if it has any.
+    fn pm_ops() -> Option<&'static bindings::dev_pm_ops> {
+        None
+    }
+
     /// Platform driver probe.
     ///
     /// Called when a new platform device is added or discovered.
