From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Fri, 6 Nov 2026 04:12:33 +0000
Subject: [PATCH] iommu/apple-dart: Read the DCP DART registers once per
 segment walk

Until the IOMFB session is qualified, every message the host sends the
DCP first runs the full health check. On the J604 the scanout consumer is
attached before startup, so each check validates the SID23 firmware
segments (7616 pages), SID16 (48) and SID0 (5828) page by page, and every
page goes through apple_dart_dcp_translate(), which re-reads the stream's
TTBR, TCR, enable and protect registers: four non-posted MMIO reads per
page, about 54000 per check. One check takes 13.5-14 ms (SID0 + SID16
alone 5.4 ms, 0.92 us per page), the 317 startup callbacks are each
acknowledged by one checked send, and IOMFB startup takes 4.8 s; the
panel's KMS device arrives some 5 s after the disk password prompt is up
on simpledrm. 73ecee238f ("Requalify only the changed DCP SID23 leaves")
removed a cost that was already small: those leaves sit in the DCP's own
reservations and pass before region_intersects().

The registers cannot change what the walk itself reads; they say whether
the walk may trust the tables at all. Read them before the walk (the
check does, and frontend validation starts with them) and again after it,
and translate the pages in between without the MMIO reads. Every page is
still translated, ownership- and kind-checked as before, root drift and
unsafe leaves still fail the domain, and a register change seen after the
walk fails it too. Single translations elsewhere keep reading the
registers each time.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/iommu/apple-dart-dcp.h | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/drivers/iommu/apple-dart-dcp.h b/drivers/iommu/apple-dart-dcp.h
index 6806262e76..7d20909201 100644
--- a/drivers/iommu/apple-dart-dcp.h
+++ b/drivers/iommu/apple-dart-dcp.h
@@ -476,7 +476,10 @@ static bool apple_dart_dcp_iova(u64 iova)
 	return iova >= DCP_DART_ALIAS && iova - DCP_DART_ALIAS < DCP_DART_APERTURE;
 }
 
-static phys_addr_t apple_dart_dcp_translate(struct apple_dart_dcp *dcp, u64 iova)
+/* regs: also re-read the stream's DART registers. A caller that walks many pages
+ * reads them once before and once after its walk instead (non-posted MMIO).
+ */
+static phys_addr_t __apple_dart_dcp_translate(struct apple_dart_dcp *dcp, u64 iova, bool regs)
 {
 	unsigned int root = (iova >> 25) & 2047;
 	unsigned int leaf = (iova >> 14) & 2047;
@@ -496,7 +499,7 @@ static phys_addr_t apple_dart_dcp_translate(struct apple_dart_dcp *dcp, u64 iova
 			phys = dcp_dart_pte_phys(pte) | (iova & (DCP_DART_PAGE - 1));
 		goto out;
 	}
-	if (dcp->failed || !apple_dart_dcp_registers(dcp))
+	if (dcp->failed || (regs && !apple_dart_dcp_registers(dcp)))
 		goto out;
 	if (READ_ONCE(dcp->root[root]) != dcp->entry[root]) {
 		dcp->failed = true;
@@ -520,6 +523,11 @@ out:
 	return phys;
 }
 
+static phys_addr_t apple_dart_dcp_translate(struct apple_dart_dcp *dcp, u64 iova)
+{
+	return __apple_dart_dcp_translate(dcp, iova, true);
+}
+
 /* The old loader name selects the same common Apple DRM SID0 consumer. */
 static bool apple_dart_j713_scanout_node(struct device_node *node)
 {
@@ -632,7 +640,7 @@ snapshot_done:
 				unsigned int root = ((iova + off) >> 25) & 2047;
 				unsigned int leaf = ((iova + off) >> 14) & 2047;
 
-				if (apple_dart_dcp_translate(dcp, iova + off) != res.start + off ||
+				if (__apple_dart_dcp_translate(dcp, iova + off, false) != res.start + off ||
 				    !test_bit(root, dcp->foreign) ||
 				    !dcp_dart_pte_frontend(READ_ONCE(dcp->table[root][leaf])))
 					goto put_node;
@@ -805,7 +813,7 @@ static int apple_dart_dcp_validate(struct apple_dart_dcp *dcp, struct device *de
 				unsigned int root = ((iova + off) >> 25) & 2047;
 				unsigned int leaf = ((iova + off) >> 14) & 2047;
 
-				if (apple_dart_dcp_translate(dcp, iova + off) != res.start + off ||
+				if (__apple_dart_dcp_translate(dcp, iova + off, false) != res.start + off ||
 				    !test_bit(root, dcp->foreign) ||
 				    !dcp_dart_pte_firmware(READ_ONCE(dcp->table[root][leaf]),
 							  segment->kind)) {
@@ -828,6 +836,9 @@ put_node:
 	for (u32 i = 0; !ret && i < dcp->firmware.num_segments; i++)
 		if (dcp->firmware.segment[i].kind != 10 && !(seen & BIT(i)))
 			ret = -EINVAL;
+	/* The walk above did not re-read the registers per page. */
+	if (!ret && !apple_dart_dcp_registers(dcp))
+		ret = -EBUSY;
 	if (!ret)
 		dcp->owner = dev;
 	return ret;
