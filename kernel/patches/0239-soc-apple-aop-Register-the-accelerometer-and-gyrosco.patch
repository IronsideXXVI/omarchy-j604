From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sat, 31 Oct 2026 17:10:51 +1100
Subject: [PATCH] soc: apple: aop: Register the accelerometer and gyroscope
 services

Create service devices for the "accel" and "gyro" services the AOP
firmware announces, so that their driver can bind to the matching device
tree children.

The T8132 firmware sends its motion samples with report subtypes 0xc1
(gyroscope) and 0xc2 (accelerometer) besides the fake-HID 0xc4, all with
the same payload, so hand those to the fake-HID listeners too.

Based on Eryk Wieliczko's J713 work (dirtyroom-linux 63e6467a), which
found both the services and the report subtypes.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(cherry picked from commit 3cadfe50e124ee450ca7c7905d17d644b6f7c1b8)
Assisted-by: Claude:claude-opus-5.5
---
 drivers/soc/apple/aop.rs | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/apple/aop.rs b/drivers/soc/apple/aop.rs
index 49f91c0287..3fe0eacbcd 100644
--- a/drivers/soc/apple/aop.rs
+++ b/drivers/soc/apple/aop.rs
@@ -121,6 +121,10 @@ const EPIC_CATEGORY_NOTIFY: u8 = 0x10;
 const EPIC_CATEGORY_REPLY: u8 = 0x20;
 const EPIC_SUBTYPE_STD_SERVICE: u16 = 0xc0;
 const EPIC_SUBTYPE_FAKEHID_REPORT: u16 = 0xc4;
+/// The T8132 firmware sends its gyroscope and accelerometer samples with
+/// these report subtypes; they carry the same payload as a fake-HID report.
+const EPIC_SUBTYPE_GYRO_REPORT: u16 = 0xc1;
+const EPIC_SUBTYPE_ACCEL_REPORT: u16 = 0xc2;
 const EPIC_SUBTYPE_RETCODE: u16 = 0x84;
 const EPIC_SUBTYPE_RETCODE_PAYLOAD: u16 = 0xa0;
 const EPIC_SUBTYPE_STRING: u16 = 0x8a;
@@ -756,7 +760,10 @@ impl AFKEndpoint {
                 let name = &name[..name.iter().position(|x| *x == 0).unwrap_or(name.len())];
                 let chan = le_u32(data, EPIC_ANNOUNCE_CHANNEL_OFFSET);
                 return Into::<Arc<_>>::into(client).register_service(self, chan, name);
-            } else if subtype == EPIC_SUBTYPE_FAKEHID_REPORT {
+            } else if subtype == EPIC_SUBTYPE_FAKEHID_REPORT
+                || subtype == EPIC_SUBTYPE_GYRO_REPORT
+                || subtype == EPIC_SUBTYPE_ACCEL_REPORT
+            {
                 return client.process_fakehid_report(self, qhdr.channel, data);
             } else if client.process_report(self, qhdr.channel, subtype, data)? {
                 return Ok(());
@@ -1471,6 +1478,8 @@ impl AopData {
             b"aop-audio" => c_str!("audio"),
             b"las" => c_str!("las"),
             b"als" => c_str!("als"),
+            b"accel" => c_str!("accel"),
+            b"gyro" => c_str!("gyro"),
             _ => {
                 return Ok(());
             }
