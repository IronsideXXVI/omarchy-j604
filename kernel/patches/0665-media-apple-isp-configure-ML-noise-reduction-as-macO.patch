From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 08:42:35 +0000
Subject: [PATCH] media: apple: isp: configure ML noise reduction as
 macOS does on T8132

With the neural engine endpoint up, macOS enables the T8132 camera's ML
noise reduction at every stream start with APPLE_CH_MLVNR_MODE_CONFIG_SET
(mode 2, thresholds 0xe00 and 0xb00, 30 fps for all three rates), not
with the bare algorithm enable the draft sends.

Add the command and a per-SoC config, and send it where the SoC has
one. The endpoint itself is not set up on T8132: the ANE driver does not
provide the link yet, and how the ANE signals the ISP is not known, so
ane_doorbell_known stays unset and nothing changes at run time. The
doorbell macOS has the ISP ring, 0x501660000 selector 1, is recorded for
the ANE side.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 drivers/media/platform/apple/isp/isp-ane.c |  3 +++
 drivers/media/platform/apple/isp/isp-cmd.c | 12 ++++++++++++
 drivers/media/platform/apple/isp/isp-cmd.h | 10 ++++++++++
 drivers/media/platform/apple/isp/isp-drv.c | 10 ++++++++++
 drivers/media/platform/apple/isp/isp-drv.h |  6 ++++++
 5 files changed, 41 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-ane.c b/drivers/media/platform/apple/isp/isp-ane.c
index 448dbf1c1b..908d74fada 100644
--- a/drivers/media/platform/apple/isp/isp-ane.c
+++ b/drivers/media/platform/apple/isp/isp-ane.c
@@ -122,5 +122,8 @@ int apple_isp_ane_stream_start(struct apple_isp *isp, u32 ch)
 {
 	if (!isp->ane_rings)
 		return 0;
+	if (isp->hw->mlvnr_mode_config)
+		return isp_cmd_apple_ch_mlvnr_mode_config_set(isp, ch,
+							      isp->hw->mlvnr_mode_config);
 	return isp_cmd_ch_algorithm_enable(isp, ch, ISP_ALG_RAW_MLVNR, 1);
 }
diff --git a/drivers/media/platform/apple/isp/isp-cmd.c b/drivers/media/platform/apple/isp/isp-cmd.c
index d055b3fdd9..751de96cfa 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.c
+++ b/drivers/media/platform/apple/isp/isp-cmd.c
@@ -509,6 +509,18 @@ int isp_cmd_ipc_endpoint_unset2(struct apple_isp *isp)
 	return CISP_SEND_IN(isp, args);
 }
 
+int isp_cmd_apple_ch_mlvnr_mode_config_set(struct apple_isp *isp, u32 chan,
+					   const u32 config[6])
+{
+	struct cmd_apple_ch_mlvnr_mode_config_set args = {
+		.opcode = CISP_OPCODE(CISP_CMD_APPLE_CH_MLVNR_MODE_CONFIG_SET),
+		.chan = chan,
+	};
+
+	memcpy(args.config, config, sizeof(args.config));
+	return CISP_SEND_IN(isp, args);
+}
+
 int isp_cmd_ch_algorithm_enable(struct apple_isp *isp, u32 chan, u32 alg, u32 enable)
 {
 	struct cmd_ch_algorithm_enable args = {
diff --git a/drivers/media/platform/apple/isp/isp-cmd.h b/drivers/media/platform/apple/isp/isp-cmd.h
index e42a2070b0..bf99879ddf 100644
--- a/drivers/media/platform/apple/isp/isp-cmd.h
+++ b/drivers/media/platform/apple/isp/isp-cmd.h
@@ -112,6 +112,7 @@
 #define CISP_CMD_APPLE_CH_AWB_RGB_COLORSPACE_SET	     0x831d
 #define CISP_CMD_APPLE_CH_AWB_TEMPORAL_STABILIZER_SET	     0x8327
 #define CISP_CMD_APPLE_CH_TEMPORAL_FILTER_START		     0xc100
+#define CISP_CMD_APPLE_CH_MLVNR_MODE_CONFIG_SET		     0xc11f
 #define CISP_CMD_APPLE_CH_TEMPORAL_FILTER_STOP		     0xc101
 #define CISP_CMD_APPLE_CH_MOTION_HISTORY_START		     0xc102
 #define CISP_CMD_APPLE_CH_MOTION_HISTORY_STOP		     0xc103
@@ -630,7 +631,16 @@ int isp_cmd_ch_als_disable(struct apple_isp *isp, u32 chan);
 int isp_cmd_ipc_endpoint_set2(struct apple_isp *isp, u64 rd, u32 rd_len, u64 wr,
 			      u32 wr_len, u64 doorbell, u32 doorbell_sel);
 int isp_cmd_ipc_endpoint_unset2(struct apple_isp *isp);
+struct cmd_apple_ch_mlvnr_mode_config_set {
+	u64 opcode;
+	u32 chan;
+	u32 config[6];
+} __packed;
+static_assert(sizeof(struct cmd_apple_ch_mlvnr_mode_config_set) == 0x24);
+
 int isp_cmd_ch_algorithm_enable(struct apple_isp *isp, u32 chan, u32 alg, u32 enable);
+int isp_cmd_apple_ch_mlvnr_mode_config_set(struct apple_isp *isp, u32 chan,
+					   const u32 config[6]);
 int isp_cmd_ch_cnr_start(struct apple_isp *isp, u32 chan);
 int isp_cmd_ch_mbnr_enable(struct apple_isp *isp, u32 chan, u32 use_case,
 			   u32 mode, u32 enable_chroma);
diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index 89a051c89c..abbc07ed04 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -1287,8 +1287,18 @@ static const struct isp_mmio_window apple_isp_fw_mmio_t8132[] = {
  * quiesced before the power-down, so the ISP is powered only while the
  * camera is in use.
  */
+/*
+ * What macOS sends on T8132 at every stream start with the ISP<->ANE
+ * endpoint up: mode 2, two thresholds and the frame rates. In the same
+ * capture the ISP firmware rings the ANE at 0x501660000, selector 1
+ * (IPC_ENDPOINT_SET2); that is for the ANE driver to return, and how the
+ * ANE signals the ISP is not known, so ane_doorbell_known stays unset.
+ */
+static const u32 isp_t8132_mlvnr_mode_config[6] = { 2, 0xe00, 0xb00, 30, 30, 30 };
+
 static const struct apple_isp_hw apple_isp_hw_t8132 = {
 	.gen = ISP_GEN_T6040,
+	.mlvnr_mode_config = isp_t8132_mlvnr_mode_config,
 	.fw_abi = ISP_FW_ABI_H17,
 	.pmu_base = 0x0,
 
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index e3d60e7160..1a0937c4f5 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -172,6 +172,12 @@ struct apple_isp_hw {
 	bool ane_doorbell_known;
 	u64 ane_isp_doorbell;
 	u32 ane_isp_doorbell_sel;
+	/*
+	 * Per stream, ML noise reduction is configured with
+	 * APPLE_CH_MLVNR_MODE_CONFIG_SET and these words rather than the
+	 * algorithm enable.
+	 */
+	const u32 *mlvnr_mode_config;
 	enum isp_fw_abi fw_abi;
 	u64 pmu_base;
 
-- 
2.43.0

