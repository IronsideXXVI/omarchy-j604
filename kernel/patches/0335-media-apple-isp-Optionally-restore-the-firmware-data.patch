From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Fri, 30 Oct 2026 15:00:03 -0400
Subject: [PATCH] media: apple: isp: Optionally restore the firmware data
 before each start

Firmware that the boot loader loads changes its data segment while it
runs, and does not start again from that state. Add hw->fw_restore:
probe keeps a copy of the data segment, taken before the firmware first
runs, and every start puts it back and clears the firmware main memory
above it. Stopping the firmware puts it back too, also after a start
that failed, and a shutdown stops a stream and such firmware, so that a
rebound driver or a kexec'd kernel finds the firmware as it was loaded.

No SoC uses it yet.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 1ffdbc03d9177356fbb8a26930e50429652cdba7)
---
 drivers/media/platform/apple/isp/isp-drv.c | 64 ++++++++++++++++++++++
 drivers/media/platform/apple/isp/isp-drv.h | 12 ++++
 drivers/media/platform/apple/isp/isp-fw.c  | 25 +++++++++
 3 files changed, 101 insertions(+)

diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index 7b1757fa1c..3baa86dfa9 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -5,10 +5,12 @@
  * Copyright (C) 2023 The Asahi Linux Contributors
  */
 
+#include <linux/io.h>
 #include <linux/iommu.h>
 #include <linux/module.h>
 #include <linux/of_address.h>
 #include <linux/of_device.h>
+#include <linux/of_reserved_mem.h>
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
 #include <linux/pm_runtime.h>
@@ -20,6 +22,41 @@
 #include "isp-regs.h"
 #include "isp-v4l2.h"
 
+static void apple_isp_kvfree(void *data)
+{
+	kvfree(data);
+}
+
+/*
+ * Keep a copy of the firmware data segment as the boot loader loaded it
+ * (hw->fw_restore). This must run before the firmware first starts.
+ */
+static int apple_isp_copy_fw_data(struct apple_isp *isp)
+{
+	struct device *dev = isp->dev;
+	struct resource res;
+	int err;
+
+	err = of_reserved_mem_region_to_resource_byname(dev->of_node, "data", &res);
+	if (err)
+		return err;
+
+	isp->fw_data_size = resource_size(&res);
+	isp->fw_data = devm_memremap(dev, res.start, isp->fw_data_size, MEMREMAP_WB);
+	if (IS_ERR(isp->fw_data))
+		return PTR_ERR(isp->fw_data);
+
+	isp->fw_data_copy = kvmalloc(isp->fw_data_size, GFP_KERNEL);
+	if (!isp->fw_data_copy)
+		return -ENOMEM;
+	err = devm_add_action_or_reset(dev, apple_isp_kvfree, isp->fw_data_copy);
+	if (err)
+		return err;
+
+	memcpy(isp->fw_data_copy, isp->fw_data, isp->fw_data_size);
+	return 0;
+}
+
 static void apple_isp_detach_genpd(struct apple_isp *isp)
 {
 	if (isp->pd_count <= 1)
@@ -648,6 +685,15 @@ static int apple_isp_probe(struct platform_device *pdev)
 		goto free_iommu;
 	}
 
+	if (isp->hw->fw_restore) {
+		err = apple_isp_copy_fw_data(isp);
+		if (err) {
+			dev_err(dev, "failed to copy the firmware data: %d\n", err);
+			apple_isp_free_firmware_surface(isp);
+			goto free_iommu;
+		}
+	}
+
 	pm_runtime_enable(dev);
 
 	if (!isp->hw->resident_fw_deferred) {
@@ -1128,6 +1174,23 @@ static const struct dev_pm_ops apple_isp_pm_ops = {
 	RUNTIME_PM_OPS(apple_isp_runtime_suspend, apple_isp_runtime_resume, NULL)
 };
 
+/*
+ * Stop firmware that starts again (hw->fw_restore) before a reboot or a
+ * kexec, so that the next kernel finds its data segment as loaded.
+ */
+static void apple_isp_shutdown(struct platform_device *pdev)
+{
+	struct apple_isp *isp = platform_get_drvdata(pdev);
+
+	if (!isp || !isp->hw->fw_restore)
+		return;
+	/* A stream that still runs is stopped cleanly first, as for hibernation */
+	apple_isp_video_suspend(isp);
+	mutex_lock(&isp->video_lock);
+	apple_isp_firmware_halt(isp);
+	mutex_unlock(&isp->video_lock);
+}
+
 static struct platform_driver apple_isp_driver = {
 	.driver	= {
 		.name		= "apple-isp",
@@ -1136,6 +1199,7 @@ static struct platform_driver apple_isp_driver = {
 	},
 	.probe	= apple_isp_probe,
 	.remove	= apple_isp_remove,
+	.shutdown = apple_isp_shutdown,
 };
 module_platform_driver(apple_isp_driver);
 
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index 1e938dcd55..2616d78338 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -221,6 +221,14 @@ struct apple_isp_hw {
 	/* metadata buffers carry the frame's exposure report (H17 firmware) */
 	bool meta_exposure;
 
+	/*
+	 * The firmware leaves its data segment changed when it stops, and
+	 * does not start from it again. Keep a copy of the segment as the
+	 * boot loader loaded it, taken at probe before the firmware first
+	 * runs, and put it back whenever the firmware has stopped.
+	 */
+	bool fw_restore;
+
 	/*
 	 * The firmware can be started only once per system boot, so once
 	 * started it is kept running while the driver is bound. It starts at
@@ -381,6 +389,10 @@ struct apple_isp {
 	struct isp_surf *extra_surf;
 	struct isp_surf *data_surf;
 	struct isp_surf *main_tail_surf;
+	/* With hw->fw_restore: the firmware data segment and its copy */
+	void *fw_data;
+	void *fw_data_copy;
+	size_t fw_data_size;
 	struct isp_surf *log_surf;
 	struct isp_surf *bt_surf;
 	struct isp_surf *meta_surfs[ISP_MAX_BUFFERS];
diff --git a/drivers/media/platform/apple/isp/isp-fw.c b/drivers/media/platform/apple/isp/isp-fw.c
index 45ce027b58..149f90096c 100644
--- a/drivers/media/platform/apple/isp/isp-fw.c
+++ b/drivers/media/platform/apple/isp/isp-fw.c
@@ -6,6 +6,7 @@
 
 #include <asm/io.h>
 #include <linux/delay.h>
+#include <linux/highmem.h>
 #include <linux/iopoll.h>
 #include <linux/overflow.h>
 #include <linux/pm_runtime.h>
@@ -391,6 +392,23 @@ static int isp_reset_coproc(struct apple_isp *isp)
 	return 0;
 }
 
+/*
+ * With hw->fw_restore, put the firmware memory back as the boot loader left
+ * it: the data segment from its copy, and the main memory above it cleared.
+ */
+static void isp_restore_fw_memory(struct apple_isp *isp)
+{
+	struct isp_surf *tail = isp->main_tail_surf;
+
+	if (!isp->fw_data_copy)
+		return;
+
+	memcpy(isp->fw_data, isp->fw_data_copy, isp->fw_data_size);
+	if (tail)
+		for (u32 i = 0; i < tail->num_pages; i++)
+			clear_highpage(tail->pages[i]);
+}
+
 static void isp_firmware_shutdown_stage1(struct apple_isp *isp)
 {
 	isp_coproc_write32(isp, isp_coproc_control(isp), 0x0);
@@ -403,6 +421,8 @@ static int isp_firmware_boot_stage1(struct apple_isp *isp)
 	int err;
 	// u32 val;
 
+	isp_restore_fw_memory(isp);
+
 	err = apple_isp_power_up_domains(isp);
 	if (err < 0)
 		return err;
@@ -977,6 +997,9 @@ static void isp_firmware_stop(struct apple_isp *isp)
 	isp_firmware_shutdown_stage3(isp);
 	isp_firmware_shutdown_stage2(isp);
 	isp_collect_gc_surface(isp);
+
+	/* Also leave it as loaded for a rebound driver or another kernel. */
+	isp_restore_fw_memory(isp);
 }
 
 static int isp_firmware_boot(struct apple_isp *isp)
@@ -988,6 +1011,8 @@ static int isp_firmware_boot(struct apple_isp *isp)
 		/* Stage 1 stops the coprocessor and powers it down itself. */
 		isp_err(isp, "failed firmware boot stage 1: %d\n", err);
 		isp_collect_gc_surface(isp);
+		/* The firmware may have run: leave its memory as loaded. */
+		isp_restore_fw_memory(isp);
 		return err;
 	}
 
