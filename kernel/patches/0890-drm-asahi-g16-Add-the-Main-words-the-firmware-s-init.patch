From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Tue, 17 Nov 2026 06:47:46 +0000
Subject: [PATCH] drm/asahi: g16: Add the Main words the firmware's
 init copies to g16_init_macos

macOS 26B123 sets Main +0x26c0, +0x26c4 and +0x26c8 to 1 on the J604.
Both builds' init routines read Main +0x2598..+0x25ac (26B123
+0x26b4..+0x26c8) in the same order and copy them into the firmware's
own state, which places them at +0x25a4, +0x25a8 and +0x25ac here.
This encoder leaves them 0.

Write them under a new g16_init_macos bit, 0x1000, default off.

Assisted-by: LLM
---
 drivers/gpu/drm/asahi/g16/fw/initdata.rs | 19 +++++++++++++++++--
 drivers/gpu/drm/asahi/g16/initdata.rs    |  5 +++--
 2 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g16/fw/initdata.rs b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
index 558d020fa3..6cd5bdce08 100644
--- a/drivers/gpu/drm/asahi/g16/fw/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/fw/initdata.rs
@@ -390,7 +390,9 @@ pub(crate) mod init_macos {
     pub(crate) const RUNTIME_TIMER_8: u32 = 1 << 10;
     /// Main +0xe88 = 0: no retention pointer at INIT, as macOS (26B123 +0xfa0).
     pub(crate) const NO_RETENTION: u32 = 1 << 11;
-    pub(crate) const ALL: u32 = 0xfff;
+    /// [`MAIN_INIT_COPY`]: three Main words the firmware's init copies into its own state.
+    pub(crate) const MAIN_INIT_COPY_WORDS: u32 = 1 << 12;
+    pub(crate) const ALL: u32 = 0x1fff;
 
     pub(crate) const RUNTIME_LOG: usize = 0x250;
     pub(crate) const RUNTIME_TIMER_COPY: usize = 0x8;
@@ -485,6 +487,10 @@ pub(crate) mod init_macos {
         (0x5ec, 0x4000f5a2),
     ];
 
+    /// 26B123 Main +0x26c0 / +0x26c4 / +0x26c8 = 1. Both builds' init routines read +0x2598..
+    /// +0x25ac (26B123 +0x26b4..+0x26c8) in the same order, which places them here.
+    pub(crate) const MAIN_INIT_COPY: [(usize, u32); 3] = [(0x25a4, 1), (0x25a8, 1), (0x25ac, 1)];
+
     const fn within(words: &[(usize, u32)], size: usize) -> bool {
         let mut i = 0;
         while i < words.len() {
@@ -501,6 +507,7 @@ const fn within(words: &[(usize, u32)], size: usize) -> bool {
     const _: () = assert!(within(&PP_TAIL, OBJECT_SIZE[id::POWER_PERFORMANCE]));
     const _: () = assert!(RUNTIME_COUNT_TABLE + 8 <= OBJECT_SIZE[id::RUNTIME]);
     const _: () = assert!(within(&MAIN_LOW, 0x640));
+    const _: () = assert!(within(&MAIN_INIT_COPY, OBJECT_SIZE[id::MAIN]));
     const _: () = assert!(MAIN_RETENTION + 8 <= OBJECT_SIZE[id::MAIN]);
     const _: () = assert!(RUNTIME_STATS_MASK + 4 <= OBJECT_SIZE[id::RUNTIME]);
 }
@@ -1179,6 +1186,11 @@ pub(crate) fn encode(
     if bits & init_macos::NO_RETENTION != 0 {
         put64(objects[id::MAIN], init_macos::MAIN_RETENTION, 0)?;
     }
+    if bits & init_macos::MAIN_INIT_COPY_WORDS != 0 {
+        for &(at, value) in &init_macos::MAIN_INIT_COPY {
+            put32(objects[id::MAIN], at, value)?;
+        }
+    }
     let mut groups = [
         (init_macos::POWER_WORDS, id::POWER, &init_macos::POWER[..]),
         (
@@ -1271,7 +1283,10 @@ fn the_init_macos_words_miss_the_controller_words() {
                 .iter()
                 .any(|(c, _)| c == at));
         }
-        assert_eq!(init_macos::ALL, (init_macos::NO_RETENTION << 1) - 1);
+        assert_eq!(init_macos::ALL, (init_macos::MAIN_INIT_COPY_WORDS << 1) - 1);
+        for (at, _) in init_macos::MAIN_INIT_COPY {
+            assert!(!main_macos::WORDS.iter().any(|(m, _)| usize::from(*m) == at));
+        }
         for (at, _) in init_macos::MAIN_LOW {
             assert!(at != 0x28 && at + 4 <= 0x640);
         }
diff --git a/drivers/gpu/drm/asahi/g16/initdata.rs b/drivers/gpu/drm/asahi/g16/initdata.rs
index 1482e57489..c4117bc9a7 100644
--- a/drivers/gpu/drm/asahi/g16/initdata.rs
+++ b/drivers/gpu/drm/asahi/g16/initdata.rs
@@ -322,11 +322,12 @@ pub(crate) fn build(
         if m >> 8 != 0 {
             dev_info!(
                 dev,
-                "M4 initdata: g16_init_macos: main-low {} fwdata-4 {} runtime-8 {} no-retention {}\n",
+                "M4 initdata: g16_init_macos: main-low {} fwdata-4 {} runtime-8 {} no-retention {} init-copy {}\n",
                 (m >> 8) & 1,
                 (m >> 9) & 1,
                 (m >> 10) & 1,
-                (m >> 11) & 1
+                (m >> 11) & 1,
+                (m >> 12) & 1
             );
         }
         if m & (wire::init_macos::PP_WORDS | wire::init_macos::PP_TAIL_WORDS) != 0
-- 
2.43.0

