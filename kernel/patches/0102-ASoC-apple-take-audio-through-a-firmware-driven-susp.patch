From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:27 -0500
Subject: [PATCH] ASoC: apple: take audio through a firmware-driven
 suspend

The AOP keeps running across a firmware-driven suspend, so anything it
was asked to run outlasts the streams: the serializers' clocks and the
low-power microphone's reports keep going, and the latter would reach a
sleeping AP. Nothing suspends the two microphone PCMs either, since
their card isn't an ASoC one. On such a suspend, suspend those PCMs and
return each of T8140's audio services to its idle state. None of these
streams can resume, so userspace prepares them again, and prepare and
trigger already ask for each service when it isn't running.

MCA: hw_params is the only place a stream's cluster and serdes setup is
written, and a stream that's merely suspended isn't given another. A
sleep that takes those registers would leave it silent with no error, so
refuse a firmware-driven suspend while a cluster is in use.

ADMAC: a channel a client still holds keeps its carveout and
configuration in registers, and a client only writes those at hw_params.
Keep the client's last configuration and write it again before the next
transfer starts, not earlier, as these controllers' registers may need
the audio firmware to power them. A paused transfer's rings are gone as
well, so resuming one starts it from the top.

Signed-off-by: Diljit Singh <hey@djdev.me>
(cherry picked from commit d0a5c12f10a57c629c4eb530f6a71cb10a74941b)
(cherry picked from commit b55f376705ee0c1094e05e2918207134244868f2)
(cherry picked from commit 1d82edcec375c9dbc3c354ed9026d63778d3184f)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/dma/apple-admac.c    | 66 ++++++++++++++++++++++++++++++++++--
 sound/soc/apple/aop_audio.rs | 34 +++++++++++++++++++
 sound/soc/apple/aop_t8140.rs | 47 +++++++++++++++++++++++++
 sound/soc/apple/mca.c        | 32 +++++++++++++++++
 4 files changed, 177 insertions(+), 2 deletions(-)

diff --git a/drivers/dma/apple-admac.c b/drivers/dma/apple-admac.c
index b7336f97ee..ee660cc389 100644
--- a/drivers/dma/apple-admac.c
+++ b/drivers/dma/apple-admac.c
@@ -19,6 +19,7 @@
 #include <linux/pm_runtime.h>
 #include <linux/reset.h>
 #include <linux/spinlock.h>
+#include <linux/suspend.h>
 #include <linux/interrupt.h>
 
 #include "dmaengine.h"
@@ -139,6 +140,12 @@ struct admac_chan {
 	struct list_head issued;
 
 	struct list_head to_free;
+
+	/* The client's last configuration, set up again after a system sleep. */
+	struct dma_slave_config cfg;
+	bool cfg_valid;
+	/* A system sleep took the channel's registers; set it up before a transfer. */
+	bool lost;
 };
 
 struct admac_sram {
@@ -629,11 +636,30 @@ static void admac_reset_rings(struct admac_chan *adchan)
 	writel_relaxed(0, ad->base + REG_CHAN_CTL(ad, adchan->no));
 }
 
+static int admac_device_config(struct dma_chan *chan, struct dma_slave_config *config);
+
+/* Registers can't be reached before a client powers the fabric, so this waits for it. */
+static void admac_restore_chan(struct admac_chan *adchan)
+{
+	struct admac_data *ad = adchan->host;
+
+	if (!adchan->lost)
+		return;
+	adchan->lost = false;
+
+	if (ad->split_channels)
+		writel_relaxed(0x18080001, ad->base + REG_CTL);
+	writel_relaxed(adchan->carveout, ad->base + REG_CHAN_SRAM_CARVEOUT(ad, adchan->no));
+	if (adchan->cfg_valid)
+		admac_device_config(&adchan->chan, &adchan->cfg);
+}
+
 static void admac_start_current_tx(struct admac_chan *adchan)
 {
 	struct admac_data *ad = adchan->host;
 	int ch = adchan->no;
 
+	admac_restore_chan(adchan);
 	admac_reset_rings(adchan);
 	writel_relaxed(0, ad->base + REG_CHAN_CTL(ad, ch));
 	if (ad->split_channels) {
@@ -686,10 +712,15 @@ static int admac_resume(struct dma_chan *chan)
 	int ret = 0;
 
 	spin_lock_irqsave(&adchan->lock, flags);
-	if (adchan->current_tx && adchan->current_tx->error)
+	if (adchan->current_tx && adchan->current_tx->error) {
 		ret = -EIO;
-	else
+	} else if (adchan->lost && adchan->current_tx) {
+		/* The rings went with the registers: start from the top. */
+		adchan->nperiod_acks = 0;
+		admac_start_current_tx(adchan);
+	} else {
 		admac_start_chan(adchan);
+	}
 	spin_unlock_irqrestore(&adchan->lock, flags);
 
 	return ret;
@@ -1052,6 +1083,9 @@ static int admac_device_config(struct dma_chan *chan,
 		       | FIELD_PREP(CHAN_FIFOCTL_THRESHOLD, 0x18 * wordsize),
 		       ad->base + REG_CHAN_FIFOCTL(ad, adchan->no));
 
+	adchan->cfg = *config;
+	adchan->cfg_valid = true;
+
 	return 0;
 }
 
@@ -1081,8 +1115,36 @@ static int admac_runtime_resume(struct device *dev)
 	return 0;
 }
 
+/*
+ * A system sleep that reached the hardware takes the registers of a channel a
+ * client still holds, and its client won't configure it again: only a new
+ * hw_params does that.
+ */
+static int __maybe_unused admac_resume_early(struct device *dev)
+{
+	struct admac_data *ad = dev_get_drvdata(dev);
+	unsigned long flags;
+	int i;
+
+	if (!pm_resume_via_firmware())
+		return 0;
+
+	mutex_lock(&ad->cache_alloc_lock);
+	ad->ctl_programmed = false;
+	mutex_unlock(&ad->cache_alloc_lock);
+
+	for (i = 0; i < ad->nchannels; i++) {
+		spin_lock_irqsave(&ad->channels[i].lock, flags);
+		ad->channels[i].lost = true;
+		spin_unlock_irqrestore(&ad->channels[i].lock, flags);
+	}
+
+	return 0;
+}
+
 /* Allocated channels must stay powered, including paused cyclic transfers. */
 static const struct dev_pm_ops admac_pm_ops = {
+	LATE_SYSTEM_SLEEP_PM_OPS(NULL, admac_resume_early)
 	RUNTIME_PM_OPS(admac_runtime_suspend, admac_runtime_resume, NULL)
 };
 
diff --git a/sound/soc/apple/aop_audio.rs b/sound/soc/apple/aop_audio.rs
index 4d3442bbfe..34f9c75b17 100644
--- a/sound/soc/apple/aop_audio.rs
+++ b/sound/soc/apple/aop_audio.rs
@@ -1092,6 +1092,36 @@ kernel::of_device_table!(
     ]
 );
 
+/// A system sleep with a firmware behind it. The firmware keeps running, so what it runs for
+/// the streams has to stop first. Other variants' firmware isn't traced around a sleep.
+///
+/// # Safety
+///
+/// Called by the PM core with a live device of this driver.
+unsafe extern "C" fn aop_audio_suspend(dev: *mut bindings::device) -> i32 {
+    // SAFETY: the helper only reads a flag.
+    if !unsafe { bindings::pm_suspend_via_firmware() } {
+        return 0;
+    }
+    // SAFETY: the PM core passes a live device, and keeps unbind away for this call.
+    let dev = unsafe { device::Device::<device::Normal>::from_raw(dev) };
+    let driver = dev.get_drvdata::<AopAudio>();
+    if driver.is_null() {
+        return 0;
+    }
+    // SAFETY: this driver stored it at probe, and it stays until unbind.
+    if let AopAudio::T8140(driver) = unsafe { &*driver } {
+        driver.sleep_stop();
+    }
+    0
+}
+
+static AOP_AUDIO_PM_OPS: bindings::dev_pm_ops = bindings::dev_pm_ops {
+    suspend: Some(aop_audio_suspend),
+    // SAFETY: all-zero is a valid `dev_pm_ops`: no callbacks.
+    ..unsafe { core::mem::zeroed() }
+};
+
 /// The bound driver, as the variant set it up.
 enum AopAudio {
     /// Held for its `Drop`, which frees the card.
@@ -1105,6 +1135,10 @@ impl platform::Driver for AopAudio {
 
     const OF_ID_TABLE: Option<of::IdTable<Self::IdInfo>> = Some(&OF_TABLE);
 
+    fn pm_ops() -> Option<&'static bindings::dev_pm_ops> {
+        Some(&AOP_AUDIO_PM_OPS)
+    }
+
     fn probe<'bound>(
         pdev: &'bound platform::Device<Core<'_>>,
         info: Option<&'bound Self::IdInfo>,
diff --git a/sound/soc/apple/aop_t8140.rs b/sound/soc/apple/aop_t8140.rs
index aa97deda3b..97c6c16800 100644
--- a/sound/soc/apple/aop_t8140.rs
+++ b/sound/soc/apple/aop_t8140.rs
@@ -1037,6 +1037,34 @@ impl SndSocT8140AopData {
         Ok(())
     }
 
+    /// `pw0 ` if running; the leaves stay with the stream.
+    fn service_stop(&self, svc: &Service) {
+        if svc.running.load(Relaxed) {
+            if let Err(e) = self.service_set_power(svc, SPKR_POWER_STATE_PW0) {
+                dev_err!(self.dev, "{}: pw0 failed: {:?}\n", svc.name, e);
+            }
+            svc.running.store(false, Relaxed);
+        }
+    }
+
+    /// A system sleep: nothing the firmware runs may outlast the streams, whose DMA stops with
+    /// the sleep. Each one's next prepare or start asks for it again.
+    fn sleep_stop(&self) {
+        if self.powered.xchg(false, Relaxed) {
+            if let Err(e) = self.lpai_run_put() {
+                dev_err!(self.dev, "unable to return lpai to idle: {:?}\n", e);
+            }
+        }
+        self.flush_hpai_start();
+        self.service_stop(&self.hpai);
+        if let Err(e) = self.spkr_prepare() {
+            dev_err!(self.dev, "spkr: stop failed: {:?}\n", e);
+        }
+        self.service_stop(&self.tap);
+        self.service_stop(&self.cout);
+        self.service_stop(&self.cin);
+    }
+
     /// Called from sleeping prepare/shutdown paths while ALSA serializes
     /// this stream: a queued start must finish before the mute and pw0.
     fn flush_spkr_start(&self) {
@@ -2609,6 +2637,8 @@ impl AsocContext {
 
 pub(crate) struct SndSocT8140AopDriver {
     card: *mut bindings::snd_card,
+    /// The card's two microphone PCMs, null until created.
+    pcms: [*mut bindings::snd_pcm; 2],
     data: Arc<SndSocT8140AopData>,
     asoc: KBox<AsocContext>,
     asoc_registered: bool,
@@ -2664,6 +2694,7 @@ impl SndSocT8140AopDriver {
         // whatever was set up.
         let mut this = SndSocT8140AopDriver {
             card: ptr::null_mut(),
+            pcms: [ptr::null_mut(); 2],
             asoc: AsocContext::new(data.clone())?,
             data: data.clone(),
             asoc_registered: false,
@@ -2777,6 +2808,7 @@ impl SndSocT8140AopDriver {
             (*pcm).private_free = Some(pcm_free_private);
             (*pcm).info_flags = 0;
         }
+        self.pcms[device as usize] = pcm;
         // SAFETY: as above.
         copy_str(unsafe { &mut (*pcm).name }, name.to_bytes_with_nul())?;
         if device == 0 {
@@ -2797,6 +2829,21 @@ impl SndSocT8140AopDriver {
         Ok(())
     }
 
+    /// A system sleep: stop the card's own streams, then whatever the firmware runs for them
+    /// and for the sound card's. Userspace prepares its streams again afterwards, since none
+    /// of them can resume.
+    pub(crate) fn sleep_stop(&self) {
+        for pcm in self.pcms.iter().copied().filter(|pcm| !pcm.is_null()) {
+            // SAFETY: the PCMs live as long as the card, and the driver core keeps
+            // unbind away from a system sleep.
+            let ret = unsafe { bindings::snd_pcm_suspend_all(pcm) };
+            if ret < 0 {
+                dev_err!(self.data.dev, "unable to suspend a PCM: {}\n", ret);
+            }
+        }
+        self.data.sleep_stop();
+    }
+
     /// Undo probe: stop the reports, unregister the ASoC component and free
     /// the card (which closes every stream, releasing its channel and power
     /// references), then return lpai to idle.  Runs from unbind, and again
diff --git a/sound/soc/apple/mca.c b/sound/soc/apple/mca.c
index 18d73b50af..9dfb329f46 100644
--- a/sound/soc/apple/mca.c
+++ b/sound/soc/apple/mca.c
@@ -36,6 +36,7 @@
 #include <linux/regmap.h>
 #include <linux/reset.h>
 #include <linux/slab.h>
+#include <linux/suspend.h>
 
 #include <sound/core.h>
 #include <sound/pcm.h>
@@ -1467,10 +1468,41 @@ static const struct of_device_id apple_mca_of_match[] = {
 };
 MODULE_DEVICE_TABLE(of, apple_mca_of_match);
 
+/*
+ * hw_params is the only place a stream's cluster and serdes setup is written. A
+ * sleep that takes the registers would leave an open stream silent, and nothing
+ * here restores them yet.
+ */
+static int __maybe_unused apple_mca_suspend_late(struct device *dev)
+{
+	struct mca_data *mca = dev_get_drvdata(dev);
+	int i;
+
+	if (!pm_suspend_via_firmware())
+		return 0;
+
+	for (i = 0; i < mca->nclusters; i++) {
+		struct mca_cluster *cl = &mca->clusters[i];
+
+		if (cl->pd_link || cl->clocks_in_use[SNDRV_PCM_STREAM_PLAYBACK] ||
+		    cl->clocks_in_use[SNDRV_PCM_STREAM_CAPTURE]) {
+			dev_err(dev, "cluster %d is in use, refusing the sleep\n", i);
+			return -EBUSY;
+		}
+	}
+
+	return 0;
+}
+
+static const struct dev_pm_ops apple_mca_pm_ops = {
+	LATE_SYSTEM_SLEEP_PM_OPS(apple_mca_suspend_late, NULL)
+};
+
 static struct platform_driver apple_mca_driver = {
 	.driver = {
 		.name = "apple-mca",
 		.of_match_table = apple_mca_of_match,
+		.pm = pm_sleep_ptr(&apple_mca_pm_ops),
 	},
 	.probe = apple_mca_probe,
 	.remove = apple_mca_remove,
