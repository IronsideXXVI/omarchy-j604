From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 21:39:34 +0000
Subject: [PATCH] dt-bindings: iommu: apple,dart: require the filter
 ranges with a dapf reg

The address filter registers are only useful with the ranges the loader
programs into them, which the DART writes back after a sleep. Require
apple,dapf-ranges whenever reg-names lists "dapf", and give the example
a range.

dtbs_check reports a missing property only on an enabled node. A DART
that the boot loader enables, such as the T8132 ISP DART, is described
disabled, so the check sees the omission only in a tree that enables it.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
(cherry picked from commit d231e5bf3ccbfb7c3538fc76ed931611f6a0bb78)
---
 .../devicetree/bindings/iommu/apple,dart.yaml         | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/Documentation/devicetree/bindings/iommu/apple,dart.yaml b/Documentation/devicetree/bindings/iommu/apple,dart.yaml
index b81761f5a4..5c6631d150 100644
--- a/Documentation/devicetree/bindings/iommu/apple,dart.yaml
+++ b/Documentation/devicetree/bindings/iommu/apple,dart.yaml
@@ -246,6 +246,16 @@ allOf:
     then:
       required:
         - reg-names
+  - if:
+      properties:
+        reg-names:
+          contains:
+            const: dapf
+      required:
+        - reg-names
+    then:
+      required:
+        - apple,dapf-ranges
 
 additionalProperties: false
 
@@ -287,4 +297,5 @@ examples:
       reg-names = "dart", "dapf";
       interrupts = <1 387 4>;
       #iommu-cells = <1>;
+      apple,dapf-ranges = /bits/ 64 <0x380704000 0x380704063>;
     };
