From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 02:55:04 +0000
Subject: [PATCH] soc: apple: s2r: T8132 breadcrumbs past the match,
 and a split step at the raise

The first real T8132 sleep on a J604 reset itself after the 120 s
watchdog, and nothing of it survived: no kernel line past the PCIe
removal reached the disk, and the PMU boot stage byte held macOS's sleep
value 0x50 from the match on, so the next boot was not counted as a
failed one and named no step.

With the breadcrumb on, write a distinct value to the PMU boot stage
byte at each step past the match: the parked CPUs stopped, the image
cleaned, ATC0 lowered, each part of ANS's APCIe block lowered, ANS read
off, WD2 armed, the SoC at its sleep performance state (0x41-0x4b).
0x50 goes back as the last PMU write before the engine, so that a start
after the commit is still taken for a wake. On the return through
cpu_resume, write 0x61-0x66 at its steps. A reset in either span then
starts as a failed boot that names the step, as the earlier resets
before the match did with their 0x3x values.

Add abort_before 16, the split step: ANS alone is stopped, the IO
lowering runs in full (ATC0, ANS's APCIe block, ANS read off), then it
is undone on the same core as the return from a sleep undoes it (ATC0
back, the block raised from power-off with its ports left down for their
host), and ->enter returns -ECANCELED before WD2's 5 s and before the
commit. ANS's driver starts ANS again in its resume, as after a wake.
It takes the ANS refusals of a real sleep, not the display ones, and
logs its own line with the off and raise results. It proves the lowering,
the raise and the disk coming back without a commit (0x4c-0x4f).

The trail record grows to 48 steps. Nothing changes unless
t8132_sequence and the breadcrumb or abort_before are set.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/apple-s2r.c | 190 ++++++++++++++++++++++++++++++----
 1 file changed, 170 insertions(+), 20 deletions(-)

diff --git a/drivers/soc/apple/apple-s2r.c b/drivers/soc/apple/apple-s2r.c
index d4b7654c4b..f5b10cc94a 100644
--- a/drivers/soc/apple/apple-s2r.c
+++ b/drivers/soc/apple/apple-s2r.c
@@ -433,6 +433,8 @@ struct apple_s2r_t8132 {
 	bool pcie_ans_stopped;
 	int ans_off_ret;
 	int pcie_ans_on_ret;
+	/* abort_before at the raise: the IO lowering was undone without a commit */
+	bool raised;
 
 	/* PMU boot stage byte: macOS's sleep value is written at the match */
 	bool pmu_written;
@@ -551,6 +553,8 @@ enum apple_s2r_step {
 	S2R_STEP_T8132_MATCH,
 	S2R_STEP_T8132_STOP,
 	S2R_STEP_T8132_LOWER,
+	/* Only abort_before takes it: the IO lowering undone, before the commit */
+	S2R_STEP_T8132_RAISE,
 };
 
 static const char *const apple_s2r_step_names[] = {
@@ -570,6 +574,7 @@ static const char *const apple_s2r_step_names[] = {
 	[S2R_STEP_T8132_MATCH]	= "T8132 power words as macOS has them",
 	[S2R_STEP_T8132_STOP]	= "T8132 parked CPUs stop",
 	[S2R_STEP_T8132_LOWER]	= "T8132 IO lowering, the first SoC power-down step",
+	[S2R_STEP_T8132_RAISE]	= "T8132 IO lowered and raised again, no commit",
 };
 
 struct apple_s2r {
@@ -617,7 +622,7 @@ struct apple_s2r {
 	u16 crumb_addr;
 	bool crumb_on;
 	u8 crumb_orig;
-	u8 crumb_trail[16];
+	u8 crumb_trail[48];
 	unsigned int crumb_n;
 	unsigned int crumb_err;
 
@@ -877,7 +882,8 @@ static int apple_s2r_coprocs_check(struct apple_s2r *s2r, bool tell_enclave)
 		 * ANS's last check is its shutdown notification: like a stop, never
 		 * in a run that aborts on purpose.
 		 */
-		if (c->pcie_ans && READ_ONCE(abort_before))
+		if (c->pcie_ans && READ_ONCE(abort_before) &&
+		    READ_ONCE(abort_before) != S2R_STEP_T8132_RAISE)
 			continue;
 		ret = c->last_check(c->data);
 		if (ret) {
@@ -901,6 +907,20 @@ static int apple_s2r_coprocs_check(struct apple_s2r *s2r, bool tell_enclave)
  * real sleep. Those registered first go before the others; then each run bit
  * is cleared from what it reads back, twice, as on Aurora's ANS stop.
  */
+static void apple_s2r_coproc_stop_one(struct apple_s2r_coproc *c)
+{
+	if (c->last_stop)
+		c->last_stop(c->data);
+	if (c->asc) {
+		c->status = readl(c->asc + ASC_CPU_STATUS);
+		writel(readl(c->asc + ASC_CPU_CONTROL) & ~ASC_CPU_CONTROL_RUN,
+		       c->asc + ASC_CPU_CONTROL);
+		writel(readl(c->asc + ASC_CPU_CONTROL) & ~ASC_CPU_CONTROL_RUN,
+		       c->asc + ASC_CPU_CONTROL);
+	}
+	c->stopped = true;
+}
+
 static void apple_s2r_coprocs_stop(bool first)
 {
 	int i;
@@ -910,16 +930,26 @@ static void apple_s2r_coprocs_stop(bool first)
 
 		if (!c->dev || !c->ready || c->stopped || c->first != first)
 			continue;
-		if (c->last_stop)
-			c->last_stop(c->data);
-		if (c->asc) {
-			c->status = readl(c->asc + ASC_CPU_STATUS);
-			writel(readl(c->asc + ASC_CPU_CONTROL) & ~ASC_CPU_CONTROL_RUN,
-			       c->asc + ASC_CPU_CONTROL);
-			writel(readl(c->asc + ASC_CPU_CONTROL) & ~ASC_CPU_CONTROL_RUN,
-			       c->asc + ASC_CPU_CONTROL);
-		}
-		c->stopped = true;
+		apple_s2r_coproc_stop_one(c);
+	}
+	dsb(sy);
+}
+
+/*
+ * The T8132 split step stops ANS alone: its power domain goes down and comes
+ * back with its APCIe block, as after a real sleep, while every other
+ * coprocessor keeps running through the abort.
+ */
+static void apple_s2r_coprocs_stop_ans(void)
+{
+	int i;
+
+	for (i = 0; i < S2R_COPROCS; i++) {
+		struct apple_s2r_coproc *c = &apple_s2r_coprocs[i];
+
+		if (!c->dev || !c->ready || c->stopped || !c->pcie_ans)
+			continue;
+		apple_s2r_coproc_stop_one(c);
 	}
 	dsb(sy);
 }
@@ -938,7 +968,7 @@ MODULE_PARM_DESC(skip, "Steps to leave out, for bring-up: 0x2 CPM gating, 0x4 AF
 
 static uint abort_before;
 module_param(abort_before, uint, 0644);
-MODULE_PARM_DESC(abort_before, "Abort suspend-to-RAM before this step, for bring-up: 1 parked CPUs power-down, 2 CPU complex state save, 3 CPM gating, 4 AFR off, 5 SoC clusters off (CPU cluster targets are already off), 6 SIO auto-enable off, 7 AP wake source masks, 8 clock generators, 10 CPU suspend (default: 0, never)");
+MODULE_PARM_DESC(abort_before, "Abort suspend-to-RAM before this step, for bring-up: 1 parked CPUs power-down, 2 CPU complex state save, 3 CPM gating, 4 AFR off, 5 SoC clusters off (CPU cluster targets are already off), 6 SIO auto-enable off, 7 AP wake source masks, 8 clock generators, 10 CPU suspend; with t8132_sequence: 12 AP wake masks, 13 match, 14 parked CPUs stop, 15 IO lowering, 16 after the IO lowering: ANS stopped, ANS's APCIe block lowered and raised again, no commit (default: 0, never)");
 
 static uint wdt_timeout;
 module_param(wdt_timeout, uint, 0644);
@@ -956,7 +986,7 @@ static bool abort_tells_enclave;
 module_param(abort_tells_enclave, bool, 0644);
 MODULE_PARM_DESC(abort_tells_enclave, "For bring-up: with abort_before=1, still send the enclave its sleep request before the abort, as before the enclave was left out of aborted runs, to reproduce a stop there under instrumentation; refused unless breadcrumb, wdt_from_enter and wdt_timeout are all set (default: off)");
 
-static char breadcrumb_trail[128];
+static char breadcrumb_trail[256];
 module_param_string(breadcrumb_trail, breadcrumb_trail, sizeof(breadcrumb_trail), 0444);
 MODULE_PARM_DESC(breadcrumb_trail, "Breadcrumb result of the last suspend-to-RAM cycle: steps written, write errors, value read back at the end, value put back");
 
@@ -1101,6 +1131,34 @@ enum apple_s2r_crumb {
 	S2R_CRUMB_ABORT,		/* 0x3b ->enter returns without sleeping */
 	S2R_CRUMB_SYSCORE_IN,		/* 0x3c syscore resume entered */
 	S2R_CRUMB_END,			/* 0x3d ->end: every device resumed and completed */
+	/*
+	 * T8132 sequence, past the match. The byte holds macOS's 0x50 from the
+	 * match; these replace it until it is written back right before the
+	 * engine, so that a reset in between starts as a failed boot that names
+	 * the step, not as a wake.
+	 */
+	S2R_CRUMB_T8132_STOPPED = 0x41,	/* parked CPUs stopped */
+	S2R_CRUMB_T8132_RAM,		/* 0x42 kernel image cleaned to the PoC */
+	S2R_CRUMB_T8132_IO,		/* 0x43 ATC0 lowered */
+	S2R_CRUMB_T8132_PORTS,		/* 0x44 APCIe root ports stopped */
+	S2R_CRUMB_T8132_PHY,		/* 0x45 APCIe PHY off and lowered */
+	S2R_CRUMB_T8132_SYS,		/* 0x46 APCIe system domains lowered */
+	S2R_CRUMB_T8132_GP,		/* 0x47 AXI enables cleared, GP lowered */
+	S2R_CRUMB_T8132_ANS,		/* 0x48 ANS lowered */
+	S2R_CRUMB_T8132_ANS_OFF,	/* 0x49 ANS read off, or its wait ran out */
+	S2R_CRUMB_T8132_WD2,		/* 0x4a WD2 armed with 5 s */
+	S2R_CRUMB_T8132_SOC,		/* 0x4b SoC at its sleep performance state */
+	S2R_CRUMB_T8132_RAISE,		/* 0x4c split step: raising, no commit */
+	S2R_CRUMB_T8132_RAISE_IO,	/* 0x4d split step: ATC0 back */
+	S2R_CRUMB_T8132_RAISE_APCIE,	/* 0x4e split step: ANS's APCIe block back */
+	S2R_CRUMB_T8132_RAISE_DONE,	/* 0x4f split step: returning -ECANCELED */
+	/* T8132 sequence, the return through cpu_resume */
+	S2R_CRUMB_T8132_BACK = 0x61,	/* first C line after the wake */
+	S2R_CRUMB_T8132_BACK_CLUSTERS,	/* 0x62 CPU clusters on */
+	S2R_CRUMB_T8132_BACK_PS,	/* 0x63 power words and ATC0 written back */
+	S2R_CRUMB_T8132_BACK_WD2,	/* 0x64 WD2 at 120 s */
+	S2R_CRUMB_T8132_BACK_APCIE,	/* 0x65 ANS's APCIe block raised */
+	S2R_CRUMB_T8132_BACK_DONE,	/* 0x66 the return done */
 };
 
 /*
@@ -1372,7 +1430,7 @@ static bool apple_s2r_abort_reachable(struct apple_s2r *s2r, unsigned int ab)
 		switch (ab) {
 		case S2R_STEP_NONE:
 		case S2R_STEP_SUSPEND:
-		case S2R_STEP_T8132_WAKE ... S2R_STEP_T8132_LOWER:
+		case S2R_STEP_T8132_WAKE ... S2R_STEP_T8132_RAISE:
 			return true;
 		default:
 			return false;
@@ -1902,16 +1960,19 @@ static void apple_s2r_t8132_lower_apcie(struct apple_s2r *s2r)
 	u32 val;
 
 	apple_s2r_t8132_ports_stop(s2r);
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_PORTS);
 	/* The PHY's registers need both domains on. */
 	if (apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_PHY_SW) &&
 	    apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_SYS_ST))
 		apple_s2r_t8132_apcie_phy_off(t);
 	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_APCIE_PHY_SW);
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_PHY);
 
 	if (apple_s2r_t8132_ps_on(s2r, T8132_PS_APCIE_SYS_ST))
 		apple_s2r_t8132_apcie_clk_off(t);
 	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_APCIE_SYS_ST);
 	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_APCIE_ST);
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_SYS);
 
 	/*
 	 * The AXI enables are the block's link into the fabric. macOS reads the
@@ -1926,7 +1987,9 @@ static void apple_s2r_t8132_lower_apcie(struct apple_s2r *s2r)
 	apple_s2r_t8132_ps_lower_finish(gp, val);
 
 	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_APCIE_GP);
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_GP);
 	apple_s2r_t8132_ps_lower(t->ps + T8132_PS_ANS);
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_ANS);
 }
 
 /* Read-modify-write in table order, with no write where nothing changes. */
@@ -2263,11 +2326,55 @@ static void apple_s2r_t8132_clean_ram(void)
 	dsb(sy);
 }
 
+/*
+ * abort_before at the raise (the split step): what the return from a real
+ * sleep brings back of the IO lowering, on this core, with the rest of the
+ * SoC never down: ATC0's words in reverse order, then ANS's APCIe block from
+ * power-off with its ports marked down for their host. ANS's driver starts
+ * ANS again in its resume, as after a wake. Proves the lowering, the raise
+ * and the disk coming back without a commit.
+ */
+static void apple_s2r_t8132_raise_after_lower(struct apple_s2r *s2r)
+{
+	struct apple_s2r_t8132 *t = &s2r->t8132;
+	int i;
+
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_RAISE);
+	apple_s2r_t8132_ps_restore(t->ps + T8132_PS_ATC0_COMMON, t->atc0_saved[2]);
+	apple_s2r_t8132_ps_restore(t->ps_aon + T8132_PS_AON_ATC0_USB_AON, t->atc0_saved[1]);
+	apple_s2r_t8132_ps_restore(t->ps_aon + T8132_PS_AON_ATC0_USB, t->atc0_saved[0]);
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_RAISE_IO);
+	if (t->pcie_ans_stopped) {
+		t->pcie_ans_on_ret = apple_s2r_t8132_raise_apcie(s2r);
+		for (i = 0; i < APCIE_MAX_PORTS; i++)
+			if (t->apcie_ports[i].stopped)
+				t->apcie_ports[i].down = true;
+	}
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_RAISE_APCIE);
+	t->raised = true;
+}
+
+/*
+ * With the breadcrumb on, the steps past the match replaced macOS's 0x50:
+ * it goes back as the last PMU write before the engine, so that a start
+ * after the commit is taken for a wake again.
+ */
+static void apple_s2r_t8132_stage_sleep(struct apple_s2r *s2r)
+{
+	u8 stage = T8132_PMU_BOOT_STAGE_SLEEP;
+
+	if (!s2r->crumb_on)
+		return;
+	if (spmi_ext_register_writel(s2r->crumb_dev, s2r->crumb_addr, &stage, 1))
+		s2r->t8132.pmu_err++;
+}
+
 /*
  * The last mile, in macOS's order (t8132_sleep_commit()). From the IO
  * lowering on nothing returns: a hang ends at a watchdog. abort_before stops
  * before the parked CPUs are stopped, or after it, before the IO lowering;
- * the stopped CPUs then power down and stay down until a reboot.
+ * the stopped CPUs then power down and stay down until a reboot. At the
+ * raise, it undoes the IO lowering instead and returns, before WD2's 5 s.
  */
 static int apple_s2r_t8132_finish(unsigned long arg)
 {
@@ -2290,6 +2397,7 @@ static int apple_s2r_t8132_finish(unsigned long arg)
 		apple_cpu_t8132_release_stopped(false);
 		return ret;
 	}
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_STOPPED);
 	ret = apple_s2r_check(s2r, S2R_STEP_T8132_LOWER);
 	if (ret) {
 		apple_cpu_t8132_release_stopped(false);
@@ -2299,21 +2407,35 @@ static int apple_s2r_t8132_finish(unsigned long arg)
 	/* From here the SoC powers down. */
 	pm_set_resume_via_firmware();
 	apple_s2r_t8132_clean_ram();
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_RAM);
 	apple_s2r_t8132_lower_io(s2r);
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_IO);
 	if (t->pcie_ans_stopped) {
 		apple_s2r_t8132_lower_apcie(s2r);
 		t->ans_off_ret = apple_s2r_t8132_ps_wait_off(t->ps + T8132_PS_ANS);
+		apple_s2r_crumb(s2r, S2R_CRUMB_T8132_ANS_OFF);
+	}
+
+	ret = apple_s2r_check(s2r, S2R_STEP_T8132_RAISE);
+	if (ret) {
+		apple_s2r_t8132_raise_after_lower(s2r);
+		apple_cpu_t8132_release_stopped(false);
+		apple_s2r_crumb(s2r, S2R_CRUMB_T8132_RAISE_DONE);
+		return ret;
 	}
 
 	/* The safety net, as macOS arms it (apple_sleep_arm_wd2()) */
 	writel(0, s2r->wdt + T8132_WD0_CTL);
 	apple_s2r_t8132_set_wd2(s2r, T8132_WD2_SLEEP_SECS);
 	writel(0, t->aon_misc + T8132_AON_AP_DEADLINE);
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_WD2);
 
 	if (apple_s2r_t8132_perf_wait(t->clk_perf + T8132_CLK_PERF_SOC, T8132_SOC_SLEEP_STATE)) {
 		writel(T8132_SOC_SLEEP_STATE, t->clk_perf + T8132_CLK_PERF_SOC);
 		apple_s2r_t8132_perf_wait(t->clk_perf + T8132_CLK_PERF_SOC, T8132_SOC_SLEEP_STATE);
 	}
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_SOC);
+	apple_s2r_t8132_stage_sleep(s2r);
 	apple_s2r_t8132_dcs_down(s2r);
 	apple_s2r_t8132_mcc_stop(s2r);
 
@@ -2383,6 +2505,7 @@ static void apple_s2r_t8132_return(struct apple_s2r *s2r)
 	write_sysreg(t->cntkctl, cntkctl_el1);
 	isb();
 	write_sysreg_s(t->siq_cfg, SYS_APL_SIQ_CFG_EL1);
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_BACK);
 
 	/* Before anything starts a core: what the wake left there */
 	t->stop_word[2] = apple_cpu_stop_word();
@@ -2393,6 +2516,7 @@ static void apple_s2r_t8132_return(struct apple_s2r *s2r)
 						     val & T8132_CLUSTER_E_READY, 1,
 						     T8132_CLUSTER_TIMEOUT_US);
 	writel(T8132_CLUSTER_ON, t->cluster + T8132_CLUSTER_P);
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_BACK_CLUSTERS);
 
 	writel(T8132_PWRGATE_ON, t->pwrgate + T8132_PWRGATE_WAKE_0);
 	writel(T8132_PWRGATE_ON, t->pwrgate + T8132_PWRGATE_WAKE_1);
@@ -2402,6 +2526,7 @@ static void apple_s2r_t8132_return(struct apple_s2r *s2r)
 	apple_s2r_t8132_ps_restore(t->ps + T8132_PS_ATC0_COMMON, t->atc0_saved[2]);
 	apple_s2r_t8132_ps_restore(t->ps_aon + T8132_PS_AON_ATC0_USB_AON, t->atc0_saved[1]);
 	apple_s2r_t8132_ps_restore(t->ps_aon + T8132_PS_AON_ATC0_USB, t->atc0_saved[0]);
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_BACK_PS);
 
 	val = readl(t->ps + T8132_PS_SEP);
 	if (val & T8132_PS_DEV_DISABLE)
@@ -2412,6 +2537,7 @@ static void apple_s2r_t8132_return(struct apple_s2r *s2r)
 
 	/* macOS stops it here. Keep a longer one over device resume, until ->end. */
 	apple_s2r_t8132_set_wd2(s2r, T8132_WD2_SUSPEND_SECS);
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_BACK_WD2);
 
 	/* What the commit lowered for a driver comes back before anything uses it. */
 	if (t->pcie_ans_stopped)
@@ -2421,12 +2547,15 @@ static void apple_s2r_t8132_return(struct apple_s2r *s2r)
 		if (t->apcie_ports[i].stopped)
 			t->apcie_ports[i].down = true;
 
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_BACK_APCIE);
+
 	apple_cpu_power_cycled();
 	s2r->pins_lost = s2r->pins_saved_valid;
 
 	for (i = 0; i < T8132_WAKE_WORDS; i++)
 		t->wake_status[i] = readl(t->wake + T8132_WAKE_STATUS(i));
 	t->returned = true;
+	apple_s2r_crumb(s2r, S2R_CRUMB_T8132_BACK_DONE);
 }
 
 /*
@@ -2450,16 +2579,17 @@ static int apple_s2r_t8132_refuse(struct apple_s2r *s2r)
 		pr_warn("apple-s2r: T8132 sequence: PMU boot stage byte not usable: refused\n");
 		return -ENODEV;
 	}
-	if (READ_ONCE(abort_before))
+	if (READ_ONCE(abort_before) && READ_ONCE(abort_before) != S2R_STEP_T8132_RAISE)
 		return 0;
 
 	/*
 	 * A real sleep. The engine waits for the display CPUs with no timeout
 	 * (SOURCE): kept as a safety (all three read off at ->enter, MEASURED).
 	 * ANS's block can be lowered and raised once its driver idled ANS and the
-	 * loader's tables are in.
+	 * loader's tables are in. The split step lowers and raises ANS's block
+	 * without the engine, so it takes the ANS checks only.
 	 */
-	for (i = 0; i < ARRAY_SIZE(t8132_ps_disp_cpu); i++)
+	for (i = 0; !READ_ONCE(abort_before) && i < ARRAY_SIZE(t8132_ps_disp_cpu); i++)
 		if (apple_s2r_t8132_ps_on(s2r, t8132_ps_disp_cpu[i])) {
 			pr_warn("apple-s2r: T8132 sequence: display CPU domain %#x is on: refused\n",
