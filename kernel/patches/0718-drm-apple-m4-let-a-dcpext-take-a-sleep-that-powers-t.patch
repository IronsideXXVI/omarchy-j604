From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 18:46:18 +0000
Subject: [PATCH] drm/apple: m4: let a dcpext take a sleep that powers the SoC
 down

A bound J604 external DCP (apple,t8132-dcpext) refused every sleep
that powers the SoC down (DCP_M4_FW_SLEEP_EXTERNAL, ecb6c069d9): it
had no firmware stop, and iomfb_m4_power_gate() is the internal
panel's.

Give it its own, for that sleep only. Its display already goes down
before the freeze (iomfb_m4_ext_sleep_down(): A473 0, D572(0)), or was
never powered when no display is attached. iomfb_m4_suspend_firmware()
then takes the same checks with its inputs (dcp_m4_ext_sleep_state():
session started and not failed, providers described, display powered
off, display DART off, no swap in flight; power_gate_ms, the internal
blank's knob, plays no part) and powers it down as the internal one:
A500, drain, RTKit idle, CPU stop, then its firmware DART, its pipe's
PMC interface enables and its CPU, frontend and system domains
(apple,pmc-interface and the consumer-switched states, 5e4a069ffb).
Firmware, endpoints and buffers stay in DRAM. iomfb_m4_resume() powers
it up in reverse and wakes the CPU through RTKit's retained wake,
after the epoch moved on; the DRM replay after the sleep then powers
the display on and sets its mode from scratch, as after s2idle. A
power-up failure fails the session and the replay marks the link BAD.

Anything that cannot run refuses the sleep with a named reason
(-EBUSY), as for the internal display. The HDMI hotplug interrupt is
stopped for the sleep and started again after it, or at once on a
refusal. No display attached is the fast path: nothing to take down,
straight to the firmware stop.

The apple-dcp-m4-sleep KUnit suite replaces the blanket external
refusal case with dcpext cases: no display, HDMI down or not yet down,
swaps in flight, missing providers, failure, no session.

Assisted-by: Claude:claude-opus-5.5
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/gpu/drm/apple/dcp-m4-sleep-test.c |  81 +++++++--
 drivers/gpu/drm/apple/dcp-m4-sleep.h      |  43 +++--
 drivers/gpu/drm/apple/dcp.c               |  11 +-
 drivers/gpu/drm/apple/iomfb_m4.c          | 200 +++++++++++++++++++++-
 4 files changed, 308 insertions(+), 27 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-m4-sleep-test.c b/drivers/gpu/drm/apple/dcp-m4-sleep-test.c
index dda0233e76..011dbdd99e 100644
--- a/drivers/gpu/drm/apple/dcp-m4-sleep-test.c
+++ b/drivers/gpu/drm/apple/dcp-m4-sleep-test.c
@@ -80,22 +80,75 @@ static void dcp_m4_sleep_no_gate_board(struct kunit *test)
 					   "no display firmware stop"));
 }
 
+/* A J604 dcpext with a started session and its providers described. */
+static struct dcp_m4_ext_sleep_inputs dcpext(void)
+{
+	return (struct dcp_m4_ext_sleep_inputs) {
+		.runtime = true,
+		.gate_capable = true,
+	};
+}
+
+static enum dcp_m4_fw_sleep_verdict dcpext_verdict(const struct dcp_m4_ext_sleep_inputs *in)
+{
+	struct dcp_m4_fw_sleep_state s = dcp_m4_ext_sleep_state(in);
+
+	return dcp_m4_fw_sleep_check(&s);
+}
+
 /*
- * An external DCP (the J604 dcpext) refuses with its own reason whatever else
- * holds: it has no firmware stop, and the power-down is the internal one's.
+ * (a) No display attached: never powered, its display DART off since the
+ * session started. It does not block the sleep, and power_gate_ms (the
+ * internal panel's) plays no part.
  */
-static void dcp_m4_sleep_external(struct kunit *test)
+static void dcp_m4_sleep_dcpext_no_display(struct kunit *test)
 {
-	struct dcp_m4_fw_sleep_state s = ready();
+	struct dcp_m4_ext_sleep_inputs in = dcpext();
 
-	s.external = true;
-	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_EXTERNAL);
-	s.gated = true;
-	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_EXTERNAL);
-	s = (struct dcp_m4_fw_sleep_state) { .external = true };
-	KUNIT_EXPECT_EQ(test, dcp_m4_fw_sleep_check(&s), DCP_M4_FW_SLEEP_EXTERNAL);
-	KUNIT_EXPECT_NOT_NULL(test, strstr(dcp_m4_fw_sleep_reason(DCP_M4_FW_SLEEP_EXTERNAL),
-					   "external display processor"));
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_OK);
+	KUNIT_EXPECT_TRUE(test, dcp_m4_ext_sleep_state(&in).gate_enabled);
+}
+
+/*
+ * (b) HDMI attached: after iomfb_m4_ext_sleep_down() (A473 0, D572(0)) it
+ * may sleep; while its display is still powered, its display DART still on
+ * or a swap in flight, it refuses with the matching reason.
+ */
+static void dcp_m4_sleep_dcpext_hdmi(struct kunit *test)
+{
+	struct dcp_m4_ext_sleep_inputs in = dcpext();
+
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_OK);
+	in.powered = true;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_NOT_BLANKED);
+	in = dcpext();
+	in.dart_on = true;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_SCANNING);
+	in = dcpext();
+	in.swaps = 1;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_SCANNING);
+}
+
+/* What still refuses a dcpext, each with its own reason; and down already is OK. */
+static void dcp_m4_sleep_dcpext_refusals(struct kunit *test)
+{
+	struct dcp_m4_ext_sleep_inputs in;
+
+	in = dcpext();
+	in.gate_capable = false;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_NO_GATE);
+	in = dcpext();
+	in.failed = true;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_FAILED);
+	in = dcpext();
+	in.runtime = false;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_NO_SESSION);
+	in = dcpext();
+	in.gated = true;
+	in.powered = true;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_OK);
+	in.failed = true;
+	KUNIT_EXPECT_EQ(test, dcpext_verdict(&in), DCP_M4_FW_SLEEP_FAILED);
 }
 
 static void dcp_m4_sleep_reasons(struct kunit *test)
@@ -113,7 +166,9 @@ static struct kunit_case dcp_m4_sleep_cases[] = {
 	KUNIT_CASE(dcp_m4_sleep_each_refusal),
 	KUNIT_CASE(dcp_m4_sleep_gated_ok),
 	KUNIT_CASE(dcp_m4_sleep_no_gate_board),
-	KUNIT_CASE(dcp_m4_sleep_external),
+	KUNIT_CASE(dcp_m4_sleep_dcpext_no_display),
+	KUNIT_CASE(dcp_m4_sleep_dcpext_hdmi),
+	KUNIT_CASE(dcp_m4_sleep_dcpext_refusals),
 	KUNIT_CASE(dcp_m4_sleep_reasons),
 	{}
 };
diff --git a/drivers/gpu/drm/apple/dcp-m4-sleep.h b/drivers/gpu/drm/apple/dcp-m4-sleep.h
index 0d95c39571..0e73f34fc8 100644
--- a/drivers/gpu/drm/apple/dcp-m4-sleep.h
+++ b/drivers/gpu/drm/apple/dcp-m4-sleep.h
@@ -19,11 +19,6 @@
 
 enum dcp_m4_fw_sleep_verdict {
 	DCP_M4_FW_SLEEP_OK,
-	/*
-	 * An external DCP (T8132 dcpext, the same backend): it has no firmware
-	 * stop for this sleep, and its display power-down is the internal one's.
-	 */
-	DCP_M4_FW_SLEEP_EXTERNAL,
 	/* No display session was started: nothing here can stop that firmware. */
 	DCP_M4_FW_SLEEP_NO_SESSION,
 	/* The session failed. */
@@ -43,7 +38,6 @@ enum dcp_m4_fw_sleep_verdict {
 };
 
 struct dcp_m4_fw_sleep_state {
-	bool external;		/* an external DCP (T8132 dcpext) */
 	bool runtime;		/* a display session was started */
 	bool failed;		/* it failed */
 	bool gated;		/* the DCP and its domains are down already */
@@ -57,8 +51,6 @@ struct dcp_m4_fw_sleep_state {
 static inline enum dcp_m4_fw_sleep_verdict
 dcp_m4_fw_sleep_check(const struct dcp_m4_fw_sleep_state *s)
 {
-	if (s->external)
-		return DCP_M4_FW_SLEEP_EXTERNAL;
 	if (!s->runtime)
 		return DCP_M4_FW_SLEEP_NO_SESSION;
 	if (s->failed)
@@ -82,8 +74,6 @@ static inline const char *dcp_m4_fw_sleep_reason(enum dcp_m4_fw_sleep_verdict ve
 	switch (verdict) {
 	case DCP_M4_FW_SLEEP_OK:
 		return "display powered down";
-	case DCP_M4_FW_SLEEP_EXTERNAL:
-		return "external display processor: no firmware stop for this sleep yet";
 	case DCP_M4_FW_SLEEP_NO_SESSION:
 		return "no display session to stop";
 	case DCP_M4_FW_SLEEP_FAILED:
@@ -104,4 +94,37 @@ static inline const char *dcp_m4_fw_sleep_reason(enum dcp_m4_fw_sleep_verdict ve
 	return "unknown";
 }
 
+/*
+ * An external DCP (T8132 dcpext) takes the same checks with its own inputs:
+ * no blank of its own and no power_gate_ms (that knob is the internal
+ * panel's), but its display powered off for the sleep (A473 0, done by
+ * iomfb_m4_ext_sleep_down() before the freeze, or never powered on: no
+ * display attached, the fast path) and its display DART off (the
+ * firmware's last D572 was 0) with no swap in flight. Its providers are its
+ * own: apple,pmc-interface and its DARTs' and domains' (gate_capable).
+ */
+struct dcp_m4_ext_sleep_inputs {
+	bool runtime;		/* its session was started */
+	bool failed;		/* it failed */
+	bool gated;		/* the DCP and its domains are down already */
+	bool gate_capable;	/* the board describes its power-down */
+	bool powered;		/* its display is powered on */
+	bool dart_on;		/* its display DART is on (last D572 was 1) */
+	unsigned int swaps;	/* swaps in flight */
+};
+
+static inline struct dcp_m4_fw_sleep_state
+dcp_m4_ext_sleep_state(const struct dcp_m4_ext_sleep_inputs *in)
+{
+	return (struct dcp_m4_fw_sleep_state) {
+		.runtime = in->runtime,
+		.failed = in->failed,
+		.gated = in->gated,
+		.gate_capable = in->gate_capable,
+		.gate_enabled = true,
+		.scanning = in->swaps || in->dart_on,
+		.display_off = !in->powered,
+	};
+}
+
 #endif
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 1ce336704c..1d89b9b0a9 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -8328,14 +8328,21 @@ static int dcp_platform_suspend(struct device *dev)
 	 * T8132, a sleep that powers the SoC down: the coprocessor must not be
 	 * running when its power goes. Its display power-down stops it and powers
 	 * its domains down, and releases the PMP DISP vote; then the PMP is armed
-	 * for this sleep (iomfb_m4_suspend_firmware()). Where that cannot run the
+	 * for this sleep (iomfb_m4_suspend_firmware()). An external one (dcpext)
+	 * stops its firmware and powers its own domains down, its display gone
+	 * down before the freeze (t8132_ext_drm.c). Where that cannot run the
 	 * sleep is refused, as asahi does for G16; suspend-to-idle goes on below.
 	 */
 	if (pm_suspend_via_firmware() && iomfb_is_m4(dcp)) {
-		int ret = iomfb_m4_suspend_firmware(dcp);
+		int ret;
 
+		/* HDMI edges wait for resume, which acts on the level. */
+		dcp_t8132_hdmi_stop(dcp);
+		ret = iomfb_m4_suspend_firmware(dcp);
 		if (!ret)
 			device_set_wakeup_path(dev);
+		else
+			dcp_t8132_hdmi_start(dcp);
 		return ret;
 	}
 
diff --git a/drivers/gpu/drm/apple/iomfb_m4.c b/drivers/gpu/drm/apple/iomfb_m4.c
index 5504ebadbe..b54563e6d4 100644
--- a/drivers/gpu/drm/apple/iomfb_m4.c
+++ b/drivers/gpu/drm/apple/iomfb_m4.c
@@ -269,6 +269,12 @@ struct iomfb_m4 {
 	 */
 	bool gate_capable;
 	bool gated;
+	/*
+	 * An external DCP: whether the board describes its power-down for a
+	 * sleep that powers the SoC down (iomfb_m4_ext_power_gate()). Then
+	 * gated says it is down.
+	 */
+	bool ext_gate_capable;
 	struct delayed_work gate_work;
 	u64 gate_cycles;
 	s64 gate_off_us, gate_on_us;
@@ -2952,6 +2958,9 @@ int iomfb_m4_init(struct apple_dcp *owner)
 		return ret;
 	dcp->external = external;
 	/* The internal display's power-down: its PMC interface names the rest. */
+	/* An external DCP's power-down for a SoC power-down sleep: its own providers. */
+	dcp->ext_gate_capable = external && apple_pmp_display_board() &&
+				of_property_present(dev->of_node, "apple,pmc-interface");
 	dcp->gate_capable = !external && apple_pmp_display_board() &&
 			    of_property_present(dev->of_node, "apple,pmc-interface");
 	owner->v26_6 = dcp;
@@ -4274,6 +4283,133 @@ fail:
 	return ret;
 }
 
+/*
+ * An external DCP (T8132 dcpext), for a sleep that powers the SoC down, its
+ * display already off (iomfb_m4_ext_sleep_down() before the freeze, or never
+ * powered: no display attached): release the AP link (A500), let RTKit idle,
+ * stop the CPU, then power its firmware DART down, clear its pipe's PMC
+ * interface enables and power its CPU, frontend and system domains off, as
+ * the internal display's power-down does. Its display DART went off with
+ * the display (D572(0)) and is the firmware's. Firmware, endpoints and
+ * shared buffers stay in DRAM for iomfb_m4_ext_power_ungate(). If a
+ * provider cannot take part nothing changes; a failure after that fails
+ * the session.
+ */
+static int iomfb_m4_ext_power_gate(struct iomfb_m4 *dcp)
+{
+	struct dcp_m4_runtime *r = dcp->runtime;
+	unsigned long flags;
+	__le32 zero = 0;
+	const char *step;
+	int ret;
+
+	lockdep_assert_held(&dcp->lock);
+	if (!dcp->ext_gate_capable || dcp->gated || !r || !READ_ONCE(dcp->ext_dart_down) ||
+	    READ_ONCE(r->ext_powered) || r->ext_qn || dcp->transaction.calls)
+		return -EBUSY;
+	ret = dcp_m4_runtime_live(r);
+	if (ret)
+		return ret;
+	ret = apple_dart_dcp_power_check(dcp->dev) ?:
+	      apple_pmc_interface_consumer_check(dcp->dev) ?:
+	      apple_pmgr_ps_consumer_check(dcp->dev);
+	if (ret) {
+		dev_warn(dcp->dev, "sleep: power-down not possible now (%d)\n", ret);
+		return ret;
+	}
+
+	step = "A500";
+	ret = dcp_m4_runtime_call(r, 500, false, &zero, sizeof(zero), NULL, 0);
+	if (!ret) {
+		step = "drain";
+		ret = dcp_m4_runtime_drain(r, 64);
+		if (ret > 0 || (!ret && r->count))
+			ret = -EBUSY;
+	}
+	if (!ret) {
+		step = "RTKit idle";
+		ret = apple_rtkit_idle(dcp->rtkit);
+	}
+	if (ret)
+		goto fail;
+	apple_rtkit_hold_rx(dcp->rtkit);
+	step = "CPU stop";
+	ret = iomfb_m4_cpu_run(dcp, false);
+	if (ret)
+		goto fail;
+	/* As for the internal one: nothing may arrive after the CPU stopped. */
+	step = "late message";
+	ret = apple_rtkit_poll(dcp->rtkit);
+	if (ret >= 0) {
+		apple_rtkit_flush_rx(dcp->rtkit);
+		spin_lock_irqsave(&dcp->state_lock, flags);
+		ret = r->count ? -EBUSY : 0;
+		spin_unlock_irqrestore(&dcp->state_lock, flags);
+	}
+	if (ret)
+		goto fail;
+
+	/* From here on nothing may use the DCP's or its firmware DART's registers. */
+	WRITE_ONCE(dcp->gated, true);
+	step = "DART";
+	ret = apple_dart_dcp_power_off(dcp->dev);
+	if (!ret) {
+		step = "PMC";
+		ret = apple_pmc_interface_consumer_off(dcp->dev);
+	}
+	if (!ret) {
+		step = "PMGR";
+		ret = apple_pmgr_ps_consumer_off(dcp->dev);
+	}
+	if (ret)
+		goto fail;
+	return 0;
+fail:
+	dev_err(dcp->dev, "sleep: power-down failed at %s: %d\n", step, ret);
+	dcp_m4_failed(dcp, ret);
+	return ret;
+}
+
+/*
+ * After the sleep, before the DRM state is replayed (PM_POST_SUSPEND): its
+ * domains, its PMC interface enables, its firmware DART, then the CPU
+ * through RTKit's retained wake. The replay powers the display on and sets
+ * its mode from scratch (t8132_ext_sleep_restore()). A failure fails the
+ * session: the replay then marks the link BAD.
+ */
+static int iomfb_m4_ext_power_ungate(struct iomfb_m4 *dcp)
+{
+	const char *step;
+	int ret;
+
+	lockdep_assert_held(&dcp->lock);
+	if (!dcp->gated)
+		return 0;
+	step = "PMGR";
+	ret = apple_pmgr_ps_consumer_on(dcp->dev);
+	if (!ret) {
+		step = "PMC";
+		ret = apple_pmc_interface_consumer_on(dcp->dev);
+	}
+	if (!ret) {
+		step = "DART";
+		ret = apple_dart_dcp_power_on(dcp->dev);
+	}
+	if (!ret) {
+		step = "RTKit wake";
+		ret = apple_rtkit_wake_retained(dcp->rtkit, iomfb_m4_cpu_start, dcp);
+	}
+	if (ret)
+		goto fail;
+	WRITE_ONCE(dcp->gated, false);
+	dev_info(dcp->dev, "resume: external display coprocessor up\n");
+	return 0;
+fail:
+	dev_err(dcp->dev, "resume: power-up failed at %s: %d\n", step, ret);
+	dcp_m4_failed(dcp, ret);
+	return ret;
+}
+
 static void iomfb_m4_gate_work(struct work_struct *work)
 {
 	struct iomfb_m4 *dcp = container_of(to_delayed_work(work), struct iomfb_m4, gate_work);
@@ -5910,6 +6046,61 @@ int iomfb_m4_suspend(struct apple_dcp *owner)
 	return ret;
 }
 
+/*
+ * An external DCP and a sleep that powers the SoC down: the same checks with
+ * its own inputs (dcp_m4_ext_sleep_state()), then its own power-down. What
+ * RTKit received so far is dispatched with the old epoch first, as
+ * iomfb_m4_suspend() does for suspend-to-idle; the epoch moves on only if
+ * the sleep goes ahead.
+ */
+static int iomfb_m4_ext_suspend_firmware(struct iomfb_m4 *dcp)
+{
+	enum dcp_m4_fw_sleep_verdict verdict;
+	struct dcp_m4_ext_sleep_inputs in;
+	struct dcp_m4_fw_sleep_state st;
+	struct dcp_m4_runtime *r;
+	bool attached;
+
+	mutex_lock(&dcp->lock);
+	r = dcp->runtime;
+	attached = r && r->ext_connected;
+	in = (struct dcp_m4_ext_sleep_inputs) {
+		/* Pairs with the release store of r->done in startup. */
+		.runtime = r && smp_load_acquire(&r->done),
+		.failed = READ_ONCE(dcp->error) != 0,
+		.gated = dcp->gated,
+		.gate_capable = dcp->ext_gate_capable,
+		.powered = r && READ_ONCE(r->ext_powered),
+		.dart_on = !READ_ONCE(dcp->ext_dart_down),
+		.swaps = r ? r->ext_qn : 0,
+	};
+	st = dcp_m4_ext_sleep_state(&in);
+	verdict = dcp_m4_fw_sleep_check(&st);
+	mutex_unlock(&dcp->lock);
+	if (verdict != DCP_M4_FW_SLEEP_OK) {
+		dev_err(dcp->dev, "%s: refusing the sleep\n", dcp_m4_fw_sleep_reason(verdict));
+		return -EBUSY;
+	}
+	if (dcp->rtkit)
+		apple_rtkit_flush_rx(dcp->rtkit);
+	mutex_lock(&dcp->lock);
+	if (!dcp->gated && iomfb_m4_ext_power_gate(dcp))
+		verdict = DCP_M4_FW_SLEEP_GATE_FAILED;
+	if (verdict == DCP_M4_FW_SLEEP_OK) {
+		atomic_inc(&dcp->ext_pm_epoch);
+		WRITE_ONCE(dcp->ext_dart_down, true);
+		dcp->ext_dart_since_sleep = true;
+	}
+	mutex_unlock(&dcp->lock);
+	if (verdict != DCP_M4_FW_SLEEP_OK) {
+		dev_err(dcp->dev, "%s: refusing the sleep\n", dcp_m4_fw_sleep_reason(verdict));
+		return -EBUSY;
+	}
+	dev_info(dcp->dev, "external display coprocessor and domains down for this sleep (%s)\n",
+		 attached ? "display attached, powered off" : "no display attached");
+	return 0;
+}
+
 /*
  * A sleep that powers the SoC down (pm_suspend_via_firmware()). Once
  * iomfb_m4_power_gate() has stopped the DCP CPU and powered its DARTs and
@@ -5931,10 +6122,11 @@ int iomfb_m4_suspend_firmware(struct apple_dcp *owner)
 		dev_err(owner->dev, "no display backend: refusing the sleep\n");
 		return -EBUSY;
 	}
+	if (dcp->external)
+		return iomfb_m4_ext_suspend_firmware(dcp);
 	cancel_delayed_work_sync(&dcp->gate_work);
 	mutex_lock(&dcp->lock);
 	st = (struct dcp_m4_fw_sleep_state) {
-		.external = dcp->external,
 		.runtime = !!dcp->runtime,
 		.failed = READ_ONCE(dcp->error) != 0,
 		.gated = dcp->gated,
@@ -5981,7 +6173,11 @@ int iomfb_m4_resume(struct apple_dcp *owner)
 		if (dcp->rtkit)
 			apple_rtkit_flush_rx(dcp->rtkit);
 		atomic_inc(&dcp->ext_pm_epoch);
-		return 0;
+		/* Down for a SoC power-down sleep: up again, in the new epoch. */
+		mutex_lock(&dcp->lock);
+		ret = dcp->gated ? iomfb_m4_ext_power_ungate(dcp) : 0;
+		mutex_unlock(&dcp->lock);
+		return ret;
 	}
 	if (!dcp || !dcp->runtime)
 		return -ENODEV;
