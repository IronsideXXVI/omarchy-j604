From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Sun, 8 Nov 2026 22:46:40 -0500
Subject: [PATCH] usb: typec: tipd: disable LDCM work during removal

Reset recovery can invalidate the detector after tipd_remove cancels its work but before cd321x_remove drains resume work. Disable delayed work permanently at removal so this late producer cannot restart it after driver resources are released.

Exercise the production stop and invalidate callbacks in KUnit. The regression test runs the callback after cancellation on the old implementation and passes when work is disabled.

Developed with Claude Code.

Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 0471ea2c525c8e6d041479c60593e60f0ad90158)
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/usb/typec/tipd/sn201202x-pm-test.c | 50 ++++++++++++++++++++++
 drivers/usb/typec/tipd/spmi.c              |  6 ++-
 drivers/usb/typec/tipd/tps6598x.h          |  1 +
 3 files changed, 55 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/typec/tipd/sn201202x-pm-test.c b/drivers/usb/typec/tipd/sn201202x-pm-test.c
index ae55166c33..7fab562ea8 100644
--- a/drivers/usb/typec/tipd/sn201202x-pm-test.c
+++ b/drivers/usb/typec/tipd/sn201202x-pm-test.c
@@ -982,6 +982,55 @@ static void sn201202x_ldcm_read_failure_with_result_test(struct kunit *test)
 	sn201202x_ldcm_test_actions(test, &t, actions, ARRAY_SIZE(actions));
 }
 
+struct sn201202x_ldcm_stop_test {
+	struct sn201202x sn;
+	atomic_t runs;
+};
+
+static void sn201202x_ldcm_test_work(struct work_struct *work)
+{
+	struct sn201202x *sn = container_of(to_delayed_work(work),
+					  struct sn201202x, ldcm_work);
+	struct sn201202x_ldcm_stop_test *t = container_of(sn,
+					struct sn201202x_ldcm_stop_test, sn);
+
+	atomic_inc(&t->runs);
+}
+
+static void sn201202x_ldcm_test_cancel(void *data)
+{
+	cancel_delayed_work_sync(data);
+}
+
+static void sn201202x_ldcm_stop_requeue_test(struct kunit *test)
+{
+	struct sn201202x_ldcm_stop_test *t;
+	struct tps6598x *tps;
+	int ret;
+
+	t = kunit_kzalloc(test, sizeof(*t), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, t);
+	tps = &t->sn.cd.tps;
+	mutex_init(&tps->lock);
+	atomic_set(&t->runs, 0);
+	INIT_DELAYED_WORK(&t->sn.ldcm_work, sn201202x_ldcm_test_work);
+	ret = kunit_add_action_or_reset(test, sn201202x_ldcm_test_cancel, &t->sn.ldcm_work);
+	KUNIT_ASSERT_EQ(test, ret, 0);
+
+	/* Removal must cancel a pending retry and prevent later producers. */
+	mod_delayed_work(system_freezable_wq, &t->sn.ldcm_work, 60 * HZ);
+	sn201202x_contaminant_ops.stop(tps);
+	KUNIT_EXPECT_FALSE(test, delayed_work_pending(&t->sn.ldcm_work));
+
+	/* Reset recovery can still invalidate the detector before it is drained. */
+	mutex_lock(&tps->lock);
+	sn201202x_contaminant_ops.invalidate(tps);
+	mutex_unlock(&tps->lock);
+	flush_delayed_work(&t->sn.ldcm_work);
+	KUNIT_EXPECT_EQ(test, atomic_read(&t->runs), 0);
+	KUNIT_EXPECT_FALSE(test, delayed_work_pending(&t->sn.ldcm_work));
+}
+
 static struct kunit_case sn201202x_pm_cases[] = {
 	KUNIT_CASE(sn201202x_sleep_cycle_test),
 	KUNIT_CASE(sn201202x_failed_wakeup_test),
@@ -1003,6 +1052,7 @@ static struct kunit_case sn201202x_pm_cases[] = {
 	KUNIT_CASE(sn201202x_ldcm_busy_keeps_result_test),
 	KUNIT_CASE(sn201202x_ldcm_busy_without_result_test),
 	KUNIT_CASE(sn201202x_ldcm_read_failure_with_result_test),
+	KUNIT_CASE(sn201202x_ldcm_stop_requeue_test),
 	KUNIT_CASE(sn201202x_idle_sleep_test),
 	KUNIT_CASE(sn201202x_atomic_access_test),
 	KUNIT_CASE(sn201202x_idle_sleep_retry_test),
diff --git a/drivers/usb/typec/tipd/spmi.c b/drivers/usb/typec/tipd/spmi.c
index 1b9cc31692..340517efb3 100644
--- a/drivers/usb/typec/tipd/spmi.c
+++ b/drivers/usb/typec/tipd/spmi.c
@@ -467,16 +467,18 @@ static void sn201202x_ldcm_invalidate(struct tps6598x *tps)
 
 static void sn201202x_ldcm_stop(struct tps6598x *tps)
 {
-	cancel_delayed_work_sync(&tps_to_sn(tps)->ldcm_work);
+	/* Reset recovery is drained later and may still try to queue an update. */
+	disable_delayed_work_sync(&tps_to_sn(tps)->ldcm_work);
 }
 
-static const struct tipd_contaminant_ops sn201202x_contaminant_ops = {
+VISIBLE_IF_KUNIT const struct tipd_contaminant_ops sn201202x_contaminant_ops = {
 	.update = sn201202x_ldcm_update,
 	.refresh = sn201202x_ldcm_refresh,
 	.event = sn201202x_ldcm_event,
 	.invalidate = sn201202x_ldcm_invalidate,
 	.stop = sn201202x_ldcm_stop,
 };
+EXPORT_SYMBOL_IF_KUNIT(sn201202x_contaminant_ops);
 
 static struct regmap *__devm_regmap_init_sn201202x(struct spmi_device *sdev,
 						   const struct regmap_config *config,
diff --git a/drivers/usb/typec/tipd/tps6598x.h b/drivers/usb/typec/tipd/tps6598x.h
index f0dfd0a3b1..5aae06c95b 100644
--- a/drivers/usb/typec/tipd/tps6598x.h
+++ b/drivers/usb/typec/tipd/tps6598x.h
@@ -569,6 +569,7 @@ int sn201202x_runtime_resume(struct device *dev);
 void sn201202x_idle_sleep_start(struct tps6598x *tps);
 void sn201202x_idle_sleep_stop(struct tps6598x *tps);
 extern const struct regmap_bus regmap_sn201202x;
+extern const struct tipd_contaminant_ops sn201202x_contaminant_ops;
 u32 sn201202x_sleep_links(const struct cd321x_sleep_state *st);
 enum typec_contaminant
 sn201202x_ldcm_decode(const u8 status[SN201202X_LDCM_STATUS_LEN]);
