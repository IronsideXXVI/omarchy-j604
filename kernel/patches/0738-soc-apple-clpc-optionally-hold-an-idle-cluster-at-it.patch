From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 15 Nov 2026 17:34:57 +0000
Subject: [PATCH] soc: apple: clpc: optionally hold an idle cluster at
 its slowest state

At an idle desktop macOS runs the J604's P cluster at its slowest
frequency (912 MHz 99 % of the time) while schedutil's headroom keeps
it one step up (1260 MHz 89 %), as a few short wakeups per second are
enough to lift the request past the first table step.

Add idle_cap_pct: outside the low-power profile, a cluster whose busiest
CPU stayed below that share of the last sample is held at its slowest
frequency until the next evaluation, 100 ms later. The default, 0, holds
nothing.

Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 drivers/soc/apple/clpc.c | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/drivers/soc/apple/clpc.c b/drivers/soc/apple/clpc.c
index 9a73e18633..4d97e64d38 100644
--- a/drivers/soc/apple/clpc.c
+++ b/drivers/soc/apple/clpc.c
@@ -284,6 +284,17 @@ static int all_core_override_count;
 module_param_array(all_core_override, uint, &all_core_override_count, 0644);
 MODULE_PARM_DESC(all_core_override,
 		 "kHz per cluster type for the all-core ceiling instead of the SoC table (e.g. 4416000,2892000 = what macOS asks; 0 = table)");
+
+/*
+ * idle_cap_pct: outside the low-power profile, a cluster whose busiest CPU stayed below
+ * this percentage of the last sample is held at its slowest frequency until the next
+ * evaluation (APPLE_CLPC_POWER_MS); macOS idles its P cluster at its slowest state
+ * where schedutil's headroom keeps one step up. 0, the default, holds nothing.
+ */
+static unsigned int idle_cap_pct;
+module_param(idle_cap_pct, uint, 0644);
+MODULE_PARM_DESC(idle_cap_pct,
+		 "Hold a cluster whose busiest CPU was below this % of the last sample at its slowest frequency (0 = off, default)");
 MODULE_PARM_DESC(floor_stock,
 		 "Use the SoC table's CPU floor map and quarters instead of the machine's measured ones (J604: back to DCS 5 / fabric 3 for any busy cluster)");
 
@@ -1169,10 +1180,15 @@ static void apple_clpc_profile_limit(struct apple_clpc *clpc)
 		    (clpc->hw->low_power_fast_only &&
 		     !apple_clpc_has_khz(policy[i], clpc->low_power_khz)))
 			cl->top_khz = policy[i]->cpuinfo.max_freq;
-		if (!low)
+		if (!low) {
+			unsigned int cap = READ_ONCE(idle_cap_pct);
+
 			cl->max_khz = apple_clpc_all_core_khz(clpc, cl, policy[i]);
-		else if (!cl->max_khz)
+			if (!cl->max_khz && cap && cl->online && cl->busy < cap)
+				cl->max_khz = policy[i]->cpuinfo.min_freq;
+		} else if (!cl->max_khz) {
 			cl->max_khz = cl->top_khz;
+		}
 		if (!step)
 			continue;
 		khz = apple_clpc_step_khz(policy[i], cl->max_khz, step > 0);
-- 
