From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Sat, 7 Nov 2026 07:40:23 -0500
Subject: [PATCH] usb: typec: tipd: tell the root port's controller about a USB
 sleep

macOS's root port, when it goes to sleep with the host in Sleep, sends
its port controller the 4CC USBw with a mode by the speed on the port:
0x09 for full and high speed. At the wake it sends 0x80 and then 0x00
before the port resumes. The controller then watches the USB2 lines for
a remote wakeup. macOS (25G83, read statically) does this only for a
root port with Usb2ExternalRemoteWake, set from a dock-remote-wake
property on the port, a usb-repeater value of 'mcaw' or the
usb-dock-remote-wake boot argument. The J700's ADT has none of them
(J713's root ports have dock-remote-wake), so macOS likely sends no USBw
there; here it is what lets a USB keyboard on a connector wake a J700.

Do the same on the controller a tree marks with apple,usb-remote-wake,
for a firmware-driven sleep only, and only when the fixed hub's port
wired to this connector, found through the connector's graph, has a
device at or below it with wakeup enabled, as the USB host's glue
recorded before the freeze. Armed without one, the controller reported a
USB2 plug at the sleep's entry and the sleep came straight back: on an
empty port, and on one left with a passive adapter, a partner with
nothing on USB (measured on a J700). A device on the other connector
doesn't count: going by the empty-port and adapter cases, the controller
watches only its own connector's lines. A device plugged in during the
sleep still wakes the system through the SMC's plug event. The arm comes
right before the controller's SPMI sleep, the hand back right after its
wake, and the controller out of S3 before that, at every wake. It
registers before xHCI, so xHCI has suspended by the first and hasn't
resumed by the second. A failure only logs.

A controller the sleep's debug link cut reset is set up again after the
wake, as asked; that's no longer reported as a warning, which stays for
one that reset by itself.

Measured on a J700: with nothing on the ports, USB wake isn't armed and
the sleeps commit; with a USB keyboard plugged into a connector, a key
press wakes the system through the SMC.

Signed-off-by: Diljit Singh <hey@djdev.me>

[j604 backport: context conflict only: struct tps6598x here has no partner_altmode_dp, so only usbw_armed is added. apple_sleep_usb_port_can_wake() is a sleep.h stub returning false (no host sleeps in place on apple-s2r SoCs). On J604 the DT has no apple,usb-remote-wake, so tipd_usb_wake() returns at once in both directions; the J604 ADT does give dock-remote-wake on usb-drd0/1/3 port-hs and usb-repeater 'mcaw' (MEASURED), the basis for that property once a T8132 host can sleep in place.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: Claude:claude-opus-5.5
---
 drivers/usb/typec/tipd/core.c     | 90 ++++++++++++++++++++++++++++++-
 drivers/usb/typec/tipd/spmi.c     |  7 ++-
 drivers/usb/typec/tipd/tps6598x.h |  5 ++
 3 files changed, 99 insertions(+), 3 deletions(-)

diff --git a/drivers/usb/typec/tipd/core.c b/drivers/usb/typec/tipd/core.c
index 286ca0df27..bd1102bca8 100644
--- a/drivers/usb/typec/tipd/core.c
+++ b/drivers/usb/typec/tipd/core.c
@@ -1543,8 +1543,10 @@ static void cd321x_complete(struct tps6598x *tps)
 	 * The cut was a cold reset of this controller's firmware: its interrupt mask and power
 	 * state are back at their defaults, so set them up again whether or not an event comes.
 	 */
-	if (apple_sleep_debug_link_cut_peek(tps->dev))
+	if (apple_sleep_debug_link_cut_peek(tps->dev)) {
 		cd321x->pm.setup_pending = true;
+		cd321x->reset_by_cut = true;
+	}
 	if (pm_suspend_via_firmware() && device_property_read_bool(tps->dev, "apple,sleep-ssps"))
 		tps->data->switch_power_state(tps, TPS_SYSTEM_POWER_STATE_S0);
 	cd321x_rearm_debug_link(tps);
@@ -1611,8 +1613,11 @@ static int cd321x_check_setup(struct cd321x *cd321x, u64 event)
 			dev_err(tps->dev, "controller setup recovery exhausted: %d\n", ret);
 		return ret;
 	}
-	if (ret)
+	if (ret && cd321x->reset_by_cut)
+		dev_dbg(tps->dev, "set up again after the debug link's cut\n");
+	else if (ret)
 		dev_warn(tps->dev, "restored controller power state and interrupt mask\n");
+	cd321x->reset_by_cut = false;
 	/* Only a fresh snapshot may be applied after restoring the controller. */
 	cd321x->state_valid = false;
 	cd321x->pm.phase = CD321X_PM_REVALIDATE;
@@ -2949,6 +2954,87 @@ void tipd_remove(struct tps6598x *tps)
 }
 EXPORT_SYMBOL_GPL(tipd_remove);
 
+/*
+ * macOS tells the port controller of a USB root port with dock-remote-wake when that port
+ * sleeps, and the controller then watches the USB2 lines for a remote wakeup (static; what its
+ * firmware does with it isn't known). The J700's root port has none, but measured on a J700,
+ * a USB keyboard on a connector wakes it this way. The mode goes by the speed on the port: 0x09
+ * for full and high speed. At the wake the controller hands the lines back before the port
+ * resumes. Only a firmware-driven sleep needs this, and a failure only logs.
+ */
+#define TIPD_USBW_HIGH_SPEED	0x09
+#define TIPD_USBW_HAND_BACK	0x80
+#define TIPD_USBW_OFF		0x00
+
+static void tipd_usbw(struct tps6598x *tps, u8 mode)
+{
+	int ret;
+
+	guard(mutex)(&tps->lock);
+	ret = tps6598x_exec_cmd(tps, "USBw", sizeof(mode), &mode, 0, NULL);
+	if (ret)
+		dev_warn(tps->dev, "USBw %#x failed: %d\n", mode, ret);
+	else
+		dev_dbg(tps->dev, "USBw %#x\n", mode);
+}
+
+/* The fixed hub's port that the connector's USB2 pair goes to, from the graph, or 0. */
+static u32 tipd_hub_port(struct tps6598x *tps)
+{
+	struct fwnode_handle *con __free(fwnode_handle) =
+		device_get_named_child_node(tps->dev, "connector");
+	struct fwnode_handle *ep __free(fwnode_handle) =
+		fwnode_graph_get_endpoint_by_id(con, 0, 0, 0);
+	struct fwnode_handle *port __free(fwnode_handle) = fwnode_graph_get_remote_port(ep);
+	u32 reg = 0;
+
+	fwnode_property_read_u32(port, "reg", &reg);
+	return reg;
+}
+
+void tipd_usb_wake(struct tps6598x *tps, bool asleep)
+{
+	bool armed;
+
+	if (!pm_suspend_via_firmware() ||
+	    !device_property_read_bool(tps->dev, "apple,usb-remote-wake"))
+		return;
+	if (asleep) {
+		u32 port = tipd_hub_port(tps);
+		bool wake = apple_sleep_usb_port_can_wake(port);
+
+		/*
+		 * Only for a device on this connector that can wake. Armed without one, the
+		 * controller reported a USB2 plug at the sleep's entry and the sleep came straight
+		 * back, on an empty port and on one left with a passive adapter (measured on a
+		 * J700). A device plugged in during the sleep still wakes through the SMC's plug
+		 * event.
+		 */
+		if (wake)
+			dev_dbg(tps->dev, "a device on hub port %u can wake: arming USB wake\n",
+				port);
+		else
+			dev_dbg(tps->dev, "nothing on hub port %u can wake: USB wake not armed\n",
+				port);
+		scoped_guard(mutex, &tps->lock)
+			tps->usbw_armed = wake;
+		if (wake)
+			tipd_usbw(tps, TIPD_USBW_HIGH_SPEED);
+		return;
+	}
+	/* Out of S3 first: .complete would only come once the port has resumed. */
+	scoped_guard(mutex, &tps->lock) {
+		tps->data->switch_power_state(tps, TPS_SYSTEM_POWER_STATE_S0);
+		armed = tps->usbw_armed;
+		tps->usbw_armed = false;
+	}
+	if (!armed)
+		return;
+	tipd_usbw(tps, TIPD_USBW_HAND_BACK);
+	tipd_usbw(tps, TIPD_USBW_OFF);
+}
+EXPORT_SYMBOL_GPL(tipd_usb_wake);
+
 int tipd_suspend(struct tps6598x *tps)
 {
 	if (tps->wakeup) {
diff --git a/drivers/usb/typec/tipd/spmi.c b/drivers/usb/typec/tipd/spmi.c
index 11c1174c19..e39abf4af5 100644
--- a/drivers/usb/typec/tipd/spmi.c
+++ b/drivers/usb/typec/tipd/spmi.c
@@ -606,8 +606,11 @@ VISIBLE_IF_KUNIT int __maybe_unused sn201202x_resume(struct device *dev)
 	} else {
 		err = sn201202x_wake(sn);
 	}
-	if (!err)
+	if (!err) {
+		/* Registered before xHCI, so this is before the root port resumes. */
+		tipd_usb_wake(tps, false);
 		err = tipd_resume(tps);
+	}
 	/* The resume revalidation acknowledges events latched while asleep. */
 	if (tps->irq)
 		enable_irq(tps->irq);
@@ -657,6 +660,8 @@ VISIBLE_IF_KUNIT int __maybe_unused sn201202x_suspend(struct device *dev)
 		else
 			dev_warn(dev, "port state unreadable, no wakeup for an attach\n");
 	}
+	/* Registered before xHCI, so its root port has suspended by now. */
+	tipd_usb_wake(tps, true);
 	reinit_completion(&sn->sleep_completion);
 	err = spmi_command_sleep(sn->sdev);
 	if (err)
diff --git a/drivers/usb/typec/tipd/tps6598x.h b/drivers/usb/typec/tipd/tps6598x.h
index af5aead839..d2041bc711 100644
--- a/drivers/usb/typec/tipd/tps6598x.h
+++ b/drivers/usb/typec/tipd/tps6598x.h
@@ -367,6 +367,8 @@ struct tps6598x {
 	const struct tipd_data *data;
 
 	struct tipd_debugfs *debugfs;
+	/* USB remote wake armed on this port for the sleep (USBw). */
+	bool usbw_armed;
 };
 
 /* TPS_REG_USB4_STATUS */
@@ -433,6 +435,8 @@ struct cd321x {
 	atomic_t ready_event;
 	atomic_t restore_event;
 	bool display_route_active;
+	/* The sleep's debug link cut reset this controller: its setup is expected. */
+	bool reset_by_cut;
 	bool dp_sink_reported;
 	bool dp_irq_hpd;
 
@@ -484,6 +488,7 @@ struct cd321x_sleep_state {
 };
 
 int cd321x_sleep_events(struct tps6598x *tps, struct cd321x_sleep_state *st);
+void tipd_usb_wake(struct tps6598x *tps, bool asleep);
 int tps6598x_exec_cmd_tmo(struct tps6598x *tps, const char *cmd,
 			  size_t in_len, const u8 *in_data,
 			  size_t out_len, u8 *out_data,
