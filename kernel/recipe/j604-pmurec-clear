#!/bin/bash
# J604 systemd-sleep hook (install: /usr/lib/systemd/system-sleep/j604-pmurec-clear, mode 0755). DEFAULT OFF.
# iBoot's boot record lives in PMU scratch spmi_nvmem0 0xf800..: f801 = boot stage (the kernel writes 0x30,
# a deep sleep leaves 0x50), f802 = failed-boot count, f803 = the stage of the last failed boot. The Omarchy loader's
# Stage 1 (aura v1.0.0b13, stage1_proxy.c:59) opens its 10 s recovery window when (f802 & 0xf) != 0 and f803 < 0x30.
# Only when /etc/j604-pmurec-clear exists, after each resume this hook:
#   - reads f800-f803 and logs them
#   - writes f802 = 0 if it is non-zero (no recovery window on the next boot)
#   - if the flag file contains the word stage30: writes f801 = 0x30 when it is not 0x30
#   - reads back and logs. Never touches anything else. Every failure is logged and the hook exits 0 (never blocks a resume).
# Test hooks: PMUREC_NVMEM (a plain file), PMUREC_FLAG, PMUREC_LOG.
NV=${PMUREC_NVMEM:-/sys/bus/nvmem/devices/spmi_nvmem0/nvmem}
FLAG=${PMUREC_FLAG:-/etc/j604-pmurec-clear}
LOG=${PMUREC_LOG:-/var/log/j604-pmurec.log}
[ "$1" = post ] || exit 0
[ -e "$FLAG" ] || exit 0
say() { local m="$(date -u +%Y-%m-%dT%H:%M:%SZ) j604-pmurec ($2): $1"; echo "$m" >> "$LOG" 2>/dev/null; command -v logger > /dev/null && logger -t j604-pmurec "$1"; }
rd() { timeout 5 dd if="$NV" bs=1 skip=$((0xf800)) count=4 status=none 2>/dev/null | od -An -tx1 -v | tr -s ' ' | sed 's/^ //;s/ $//'; }
wr() { printf "\\x$2" | timeout 5 dd of="$NV" bs=1 seek=$(($1)) count=1 conv=notrunc status=none 2>/dev/null; }
before=$(rd)
[ -n "$before" ] || { say "f800-f803 unreadable at $NV; nothing written" "$2"; exit 0; }
set -- $before "$2"; f801=$2; f802=$3; kind=$5
say "before f800-f803 [$before]" "$kind"
did=""
if [ "$f802" != 00 ]; then wr 0xf802 00 && did="$did f802=00" || did="$did f802-write-refused"; fi
if grep -qw stage30 "$FLAG" 2>/dev/null && [ "$f801" != 30 ]; then wr 0xf801 30 && did="$did f801=30" || did="$did f801-write-refused"; fi
after=$(rd)
say "after f800-f803 [${after:-unread}]${did:+ wrote:$did}${did:- (nothing to clear)}" "$kind"
exit 0
