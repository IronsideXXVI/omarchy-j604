From 9d8ea350b0221bc19dc96eda04c14ee14b04d696 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 17:32:34 +0000
Subject: [PATCH 31/32] kboot: hand the preloaded AVE encoder firmware over on
 the T8132

iBoot preloads the AVE video encoder firmware on the M4 (T8132) as it does
on the A18 Pro: the J604 ADT /arm-io/ave is "pre-loaded" with a __TEXT and
a __DATA segment range. dt_set_ave() only handled the T8140, by a fixed DT
path, so the T8132 encoder node never got its firmware regions and the
kernel driver stops at "no preloaded firmware".

Port aura's generic hand-over (aurora-silicon/aura 9113c42b, src/kboot.c:
ave_compatibles[], dt_set_ave_node(), dt_set_ave()): the DT node is found
by its compatible, the ADT node is "ave" or "ave0", and the checks, the
segment reservation and the /chosen aurora,ave-<segment>-crc32 strings are
unchanged from the T8140 code. Add "apple,t8132-ave" to the list. The
T8140 keeps its path: its DT node is the one with "apple,t8140-ave".

Each segment is reserved no-map as apple,asc-mem with iommu-addresses at
its remap address, and the encoder node gets both as memory-region; a node
whose preload cannot be handed over is disabled. The node's status is left
as the DT has it otherwise, so a DT that ships the encoder disabled only
gets the regions reserved and the CRCs exported.

On the J604 boot ADT the segments are TEXT 0x148000 bytes at
0x10000b88000 (remap 0x10000000000) and DATA 0x12c000 bytes at
0x10001cd8000 (remap 0x10000148000), both below the OS; the device tree
grows by 432 bytes (host test, tests/run-kboot-ave.sh).

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 src/kboot.c | 45 +++++++++++++++++++++++++++++++++++----------
 1 file changed, 35 insertions(+), 10 deletions(-)

diff --git a/src/kboot.c b/src/kboot.c
index 11e09579..92ea922e 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -2697,18 +2697,33 @@ static int dt_reserve_asc_firmware(const char *adt_path, const char *adt_path_al
     return dt_reserve_asc_segments(adt_path, adt_path_alt, fdt_path, remap, base, false);
 }
 
-static int dt_set_ave(void)
-{
-    if (chip_id != T8140)
-        return 0;
+/*
+ * The AVE video encoder runs firmware that iBoot preloads. The ADT calls the
+ * encoder "ave" on the M2, M4 and A18 Pro and "ave0" on the M1 Pro/Max and M4 Pro.
+ * The DT node is found by its compatible, so describing a SoC's encoder is all
+ * it takes.
+ */
+static const char *const ave_compatibles[] = {
+    "apple,t6000-ave",
+    "apple,t8112-ave",
+    "apple,t8132-ave",
+    "apple,t8140-ave",
+    "apple,t6041-ave",
+};
 
-    const char *path = "/soc/video-codec@285100000";
-    int node = fdt_path_offset(dt, path);
-    if (node < 0)
-        return 0;
+static int dt_set_ave_node(int node)
+{
+    char path[64];
+    if (fdt_get_path(dt, node, path, sizeof(path)))
+        bail("FDT: AVE node path too long\n");
 
     const char *reason = "invalid ADT firmware segments";
-    int anode = adt_path_offset(adt, "/arm-io/ave");
+    const char *adt_path = "/arm-io/ave";
+    int anode = adt_path_offset(adt, adt_path);
+    if (anode < 0) {
+        adt_path = "/arm-io/ave0";
+        anode = adt_path_offset(adt, adt_path);
+    }
     if (anode < 0) {
         reason = "ADT node absent";
         goto disable;
@@ -2776,7 +2791,7 @@ static int dt_set_ave(void)
     for (size_t i = 0; i < count; i++)
         crcs[i] = tinf_crc32((void *)seg[i].phys, seg[i].size);
 
-    if (dt_reserve_asc_firmware("/arm-io/ave", NULL, path, true, 0)) {
+    if (dt_reserve_asc_firmware(adt_path, NULL, path, true, 0)) {
         reason = "firmware reservation failed";
         goto disable;
     }
@@ -2800,6 +2815,16 @@ disable:
     return 0;
 }
 
+static int dt_set_ave(void)
+{
+    for (size_t i = 0; i < ARRAY_SIZE(ave_compatibles); i++) {
+        int node = fdt_node_offset_by_compatible(dt, -1, ave_compatibles[i]);
+        if (node >= 0)
+            return dt_set_ave_node(node);
+    }
+    return 0;
+}
+
 /*
  * The M4, M4 Pro and A18 Pro Neural Engines run firmware that iBoot preloads into
  * DRAM below the OS: /arm-io/ane0 (M4 Pro) or /arm-io/ane (M4, A18 Pro) is
-- 
2.43.0

