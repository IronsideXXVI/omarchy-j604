diff --git a/src/kboot.c b/src/kboot.c
index de107d5a..819c7dff 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -2905,6 +2905,8 @@ static bool dt_j713_dcpext_powered(const char *alias)
  * apple,t8132-dcpext node ready for the kernel to adopt the running controller. Only with the
