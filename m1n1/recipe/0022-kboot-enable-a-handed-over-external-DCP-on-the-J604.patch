 static void dt_reserve_j713_dcpext(void)
 {
@@ -2912,8 +2914,10 @@ static void dt_reserve_j713_dcpext(void)
     int len = 0;
     const char *opt = chosen < 0 ? NULL : fdt_getprop(dt, chosen, "asahi,j713-dcpext", &len);
