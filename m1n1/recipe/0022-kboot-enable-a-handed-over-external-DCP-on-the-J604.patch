 }
 
+/*
+ * One-tree T8132 boards (the J604): the kernel boots with the device tree m1n1 completes, in
+ * which an external DCP and the nodes it consumes are disabled until it is handed over. Enable
+ * a disabled node; one that is already enabled is left as it is.
+ */
+static int dt_enable_dcpext_one_node(int node)
+{
+    int len = 0;
+    const char *status = fdt_getprop(dt, node, "status", &len);
+
+    if (!status || (len == sizeof("okay") && !strcmp(status, "okay")))
+        return 0;
+    if (len != sizeof("disabled") || strcmp(status, "disabled"))
+        return -1;
+    return fdt_setprop_string(dt, node, "status", "okay") ? -1 : 0;
+}
+
+/*
+ * Enable the power-domain chain of a node: every domain must be a firmware-owned PMGR state with
+ * #power-domain-cells = <0>, so the kernel registers it without reading or writing it.
+ */
+static int dt_enable_dcpext_domains(int node, unsigned int depth)
+{
+    int len = 0;
+    const fdt32_t *pd = fdt_getprop(dt, node, "power-domains", &len);
+
+    if (!pd)
+        return 0;
+    if (depth > 4 || len <= 0 || len % 4)
+        return -1;
+    for (int i = 0; i < len / 4; i++) {
+        uint32_t phandle = fdt32_ld(&pd[i]);
+        int target = fdt_node_offset_by_phandle(dt, phandle);
+        int clen = 0;
+        const fdt32_t *cells =
+            target < 0 ? NULL : fdt_getprop(dt, target, "#power-domain-cells", &clen);
+
+        if (!cells || clen != 4 || fdt32_ld(cells) != 0 ||
+            !fdt_getprop(dt, target, "apple,firmware-owned", NULL) ||
+            dt_enable_dcpext_one_node(target))
+            return -1;
+        /* Offsets move when a property shrinks: look the target up again by phandle. */
+        target = fdt_node_offset_by_phandle(dt, phandle);
+        if (target < 0 || dt_enable_dcpext_domains(target, depth + 1))
+            return -1;
+        pd = fdt_getprop(dt, node, "power-domains", &len);
+        if (!pd)
+            return -1;
+    }
+    return 0;
+}
+
+/* Enable the node a property's first phandle names (mboxes, iommus), with its domains. */
+static int dt_enable_dcpext_ref(const char *path, const char *prop)
+{
+    int node = fdt_path_offset(dt, path);
+    int len = 0;
+    const fdt32_t *ref = node < 0 ? NULL : fdt_getprop(dt, node, prop, &len);
+
+    if (!ref || len < 4)
+        return -1;
+    uint32_t phandle = fdt32_ld(ref);
+    int target = fdt_node_offset_by_phandle(dt, phandle);
+    if (target < 0 || dt_enable_dcpext_one_node(target))
+        return -1;
+    target = fdt_node_offset_by_phandle(dt, phandle);
+    return target < 0 ? -1 : dt_enable_dcpext_domains(target, 0);
+}
+
+/*
+ * A handed-over dcpext (marker set by dt_reserve_j713_dcpext()): enable its mailbox, its
+ * firmware DART, its display DART (named by its piodma child, which stays disabled: the kernel
+ * enables PIODMA at runtime) and the dcpext itself, each with its firmware-owned PMGR domains.
+ */
+static int dt_enable_j604_dcpext_one(unsigned int n)
+{
+    if (n >= ARRAY_SIZE(dcpext_aliases))
+        return -1;
+    const char *alias = dcpext_aliases[n];
+    int node = fdt_path_offset(dt, alias);
+    char piodma[64];
+
+    if (node < 0 || fdt_get_path(dt, node, piodma, sizeof(piodma) - sizeof("/piodma")))
+        return -1;
+    size_t plen = strlen(piodma);
+    memcpy(piodma + plen, "/piodma", sizeof("/piodma"));
+    if (dt_enable_dcpext_ref(alias, "mboxes") || dt_enable_dcpext_ref(alias, "iommus") ||
+        dt_enable_dcpext_ref(piodma, "iommus"))
+        return -1;
+    node = fdt_path_offset(dt, alias);
+    if (node < 0 || dt_enable_dcpext_one_node(node))
+        return -1;
+    node = fdt_path_offset(dt, alias);
+    return node < 0 ? -1 : dt_enable_dcpext_domains(node, 0);
+}
+
+static void dt_enable_j604_dcpext(void)
+{
+    if (!t8132_board_admitted(dt, T8132_PATH_DCPEXT_ENABLE))
+        return;
+    for (size_t n = 0; n < ARRAY_SIZE(dcpext_aliases); n++) {
+        const char *alias = dcpext_aliases[n];
+        int node = fdt_path_offset(dt, alias);
+        int len = 0;
+        const fdt32_t *ready =
+            node < 0 ? NULL : fdt_getprop(dt, node, T8132_DCPEXT_READY, &len);
+
+        if (!ready || len != 4 || fdt32_ld(ready) != 1)
+            continue;
+        if (!dt_display_transaction(dt_enable_j604_dcpext_one, n)) {
+            printf("FDT: '%s' and its mailbox, DARTs and domains enabled for the kernel\n", alias);
+            continue;
+        }
+        /* Not enabled: withdraw the marker, so the kernel gate stays closed. */
+        node = fdt_path_offset(dt, alias);
+        if (node >= 0)
+            fdt_delprop(dt, node, T8132_DCPEXT_READY);
+        printf("FDT: '%s' nodes could not be enabled; kernel gate remains closed\n", alias);
+    }
+}
+
 /*
  * T8122: reserve the external DCP firmware for the kernel's gate only with the boot.bin config
  * line chosen.asahi,t8122-dcpext=1, and only when the internal display was handed over
@@ -5607,8 +5732,10 @@ static int dt_set_display(void)
     if (chip_id == T8132) {
         if (dt_set_j713_dcp_handoff())
             printf("FDT: J713 DCP handoff refused; keeping the boot framebuffer\n");
-        else
+        else {
             dt_reserve_j713_dcpext();
+            dt_enable_j604_dcpext();
+        }
         return 0;
     }
 
