     };
diff --git a/tests/python/test_j604_dcpext_enable.py b/tests/python/test_j604_dcpext_enable.py
new file mode 100644
index 00000000..86997a69
--- /dev/null
+++ b/tests/python/test_j604_dcpext_enable.py
@@ -0,0 +1,190 @@
+# SPDX-License-Identifier: MIT
+"""J604: a handed-over external DCP is enabled with the nodes it consumes, and only then."""
+
+from pathlib import Path
+from test_siliconforest_handoff import run_c
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def test_j604_dcpext_enable(tmp_path):
+    kboot = (ROOT / "src/kboot.c").read_text()
+
+    def function(name, kind):
+        start = kboot.index(kind + name + "(")
+        return kboot[start:kboot.index("\n}\n", start) + 3]
+
+    start = kboot.index("static const char dcpext_aliases")
+    aliases = kboot[start:kboot.index("\n};", start) + 3]
+    board = "\n".join(line for line in (ROOT / "src/t8132_board.h").read_text().splitlines()
+                      if not line.startswith("#include"))
+    code = "\n".join([
+        aliases,
+        function("dt_display_transaction", "static int "),
+        function("dt_enable_dcpext_one_node", "static int "),
+        function("dt_enable_dcpext_domains", "static int "),
+        function("dt_enable_dcpext_ref", "static int "),
+        function("dt_enable_j604_dcpext_one", "static int "),
+        function("dt_enable_j604_dcpext", "static void "),
+    ])
+    run_c(tmp_path, "j604-dcpext-enable", r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "libfdt.h"
+#define ARRAY_SIZE(x) (sizeof(x) / sizeof((x)[0]))
+#define T8132_DCPEXT_READY "apple,t8132-dcpext-firmware-ready"
+static void *dt;
+''' + board + "\n" + code + r'''
+static char buf[16384];
+
+static int sub(int parent, const char *name, uint32_t phandle, bool disabled)
+{
+    int n = fdt_add_subnode(dt, parent, name);
+    assert(n >= 0);
+    if (phandle)
+        assert(!fdt_setprop_u32(dt, n, "phandle", phandle));
+    if (disabled)
+        assert(!fdt_setprop_string(dt, n, "status", "disabled"));
+    return n;
+}
+
+static int at(const char *path) { int n = fdt_path_offset(dt, path); assert(n >= 0); return n; }
+
+static void pd(const char *path, uint32_t parent, bool owned)
+{
+    int n = at(path);
+    assert(!fdt_setprop_u32(dt, n, "#power-domain-cells", 0));
+    if (owned)
+        assert(!fdt_setprop_empty(dt, n, "apple,firmware-owned"));
+    if (parent)
+        assert(!fdt_setprop_u32(dt, at(path), "power-domains", parent));
+}
+
+/* Two dcpexts in the J604 kernel tree's layout, every node disabled. */
+static void tree(const char *compatible, int len, bool owned_cpu1)
+{
+    dt = buf;
+    assert(!fdt_create_empty_tree(dt, sizeof(buf)));
+    assert(!fdt_setprop(dt, 0, "compatible", compatible, len));
+    int al = sub(0, "aliases", 0, false);
+    assert(!fdt_setprop_string(dt, al, "dcpext0", "/soc/dcp@286e00000"));
+    assert(!fdt_setprop_string(dt, at("/aliases"), "dcpext1", "/soc/dcp@48ae00000"));
+    int soc = sub(0, "soc", 0, false);
+    (void)soc;
+    for (int i = 0; i < 2; i++) {
+        uint32_t b = 10 * (i + 1);
+        char p[64];
+        const char *pmgr[] = {"sys", "fe", "cpu"};
+        for (int j = 0; j < 3; j++) {
+            snprintf(p, sizeof(p), "ps_dispext%d_%s", i, pmgr[j]);
+            sub(at("/soc"), p, b + 1 + j, true);
+            snprintf(p, sizeof(p), "/soc/ps_dispext%d_%s", i, pmgr[j]);
+            pd(p, j ? b + j : 0, !(i == 1 && j == 2 && !owned_cpu1));
+        }
+        snprintf(p, sizeof(p), "mailbox%d", i);
+        sub(at("/soc"), p, b + 4, true);
+        snprintf(p, sizeof(p), "/soc/mailbox%d", i);
+        assert(!fdt_setprop_u32(dt, at(p), "power-domains", b + 3));
+        snprintf(p, sizeof(p), "dart-dcpext%d", i);
+        sub(at("/soc"), p, b + 5, true);
+        snprintf(p, sizeof(p), "/soc/dart-dcpext%d", i);
+        assert(!fdt_setprop_u32(dt, at(p), "power-domains", b + 3));
+        snprintf(p, sizeof(p), "dart-dispext%d", i);
+        sub(at("/soc"), p, b + 6, true);
+        snprintf(p, sizeof(p), "/soc/dart-dispext%d", i);
+        assert(!fdt_setprop_u32(dt, at(p), "power-domains", b + 3));
+        snprintf(p, sizeof(p), i ? "dcp@48ae00000" : "dcp@286e00000");
+        int d = sub(at("/soc"), p, b + 7, true);
+        snprintf(p, sizeof(p), i ? "/soc/dcp@48ae00000" : "/soc/dcp@286e00000");
+        d = at(p);
+        assert(!fdt_setprop_string(dt, d, "compatible", "apple,t8132-dcpext"));
+        assert(!fdt_setprop_u32(dt, at(p), "mboxes", b + 4));
+        uint32_t iommu[2] = {cpu_to_fdt32(b + 5), cpu_to_fdt32(23)};
+        assert(!fdt_setprop(dt, at(p), "iommus", iommu, sizeof(iommu)));
+        assert(!fdt_setprop_u32(dt, at(p), "power-domains", b + 3));
+        sub(at(p), "piodma", 0, true);
+        char q[80];
+        snprintf(q, sizeof(q), "%s/piodma", p);
+        uint32_t pio[2] = {cpu_to_fdt32(b + 6), cpu_to_fdt32(16)};
+        assert(!fdt_setprop(dt, at(q), "iommus", pio, sizeof(pio)));
+    }
+}
+
+static bool okay(const char *path)
+{
+    const char *s = fdt_getprop(dt, at(path), "status", NULL);
+    return !s || !strcmp(s, "okay");
+}
+
+static void mark(const char *path, uint32_t v)
+{
+    assert(!fdt_setprop_u32(dt, at(path), T8132_DCPEXT_READY, v));
+}
+
+static bool marked(const char *path) { return fdt_getprop(dt, at(path), T8132_DCPEXT_READY, NULL); }
+
+static const char *const set0[] = {"/soc/dcp@286e00000", "/soc/mailbox0", "/soc/dart-dcpext0",
+                                   "/soc/dart-dispext0", "/soc/ps_dispext0_cpu",
+                                   "/soc/ps_dispext0_fe", "/soc/ps_dispext0_sys"};
+static const char *const set1[] = {"/soc/dcp@48ae00000", "/soc/mailbox1", "/soc/dart-dcpext1",
+                                   "/soc/dart-dispext1", "/soc/ps_dispext1_cpu",
+                                   "/soc/ps_dispext1_fe", "/soc/ps_dispext1_sys"};
+
+static void all(const char *const *set, bool want)
+{
+    for (int i = 0; i < 7; i++)
+        assert(okay(set[i]) == want);
+}
+
+#define J604 "apple,j604\0apple,t8132\0apple,arm-platform"
+#define J713 "apple,j713\0apple,t8132\0apple,arm-platform"
+
+int main(void)
+{
+    /* Marked dcpext0: it, its mailbox, both DARTs and its domains; piodma and dcpext1 stay off. */
+    tree(J604, sizeof(J604), true);
+    mark("/soc/dcp@286e00000", 1);
+    dt_enable_j604_dcpext();
+    all(set0, true);
+    all(set1, false);
+    assert(!okay("/soc/dcp@286e00000/piodma"));
+    assert(marked("/soc/dcp@286e00000"));
+
+    /* Both marked: both enabled. */
+    tree(J604, sizeof(J604), true);
+    mark("/soc/dcp@286e00000", 1);
+    mark("/soc/dcp@48ae00000", 1);
+    dt_enable_j604_dcpext();
+    all(set0, true);
+    all(set1, true);
+
+    /* A domain that is not firmware-owned: dcpext1 is left as it was, its marker withdrawn. */
+    tree(J604, sizeof(J604), false);
+    mark("/soc/dcp@286e00000", 1);
+    mark("/soc/dcp@48ae00000", 1);
+    dt_enable_j604_dcpext();
+    all(set0, true);
+    all(set1, false);
+    assert(!marked("/soc/dcp@48ae00000"));
+    assert(marked("/soc/dcp@286e00000"));
+
+    /* No marker, or a marker other than 1: nothing changes. */
+    tree(J604, sizeof(J604), true);
+    mark("/soc/dcp@48ae00000", 0);
+    dt_enable_j604_dcpext();
+    all(set0, false);
+    all(set1, false);
+
+    /* The J713 (U-Boot imports its handoff): never enabled by m1n1. */
+    tree(J713, sizeof(J713), true);
+    mark("/soc/dcp@286e00000", 1);
+    dt_enable_j604_dcpext();
+    all(set0, false);
+    assert(marked("/soc/dcp@286e00000"));
+    return 0;
+}
+''')
