@@ -50,7 +56,10 @@ static inline bool t8132_board_admitted(const void *fdt, enum t8132_board_path p
          * The ISP path reads the isp node's segment-names, segment-ranges
          * and sensor-type; isp, ispRtb and dart-isp match the J713 apart
          * from sensor-type (0x2e, J713 0x17), which becomes the platform ID.
-         * See docs/j604.md.
+         * The J604 boots one device tree, the kernel's, so a dcpext m1n1
