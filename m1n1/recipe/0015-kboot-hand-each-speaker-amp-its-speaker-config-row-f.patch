From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Thu, 5 Nov 2026 18:07:05 +1100
Subject: [PATCH 15/16] kboot: hand each speaker amp its speaker-config row
 from the ADT

The kernel's speaker driver limits every SN012776's amp level to a
value from a per-board table. The ADT carries that level: an amp
group's speaker-config has one four-byte row per amp, in the group's
order (the first amp, then speaker1, speaker2, ...), whose second byte
is the amp's operating level; the other bytes are its receive slot and
its sense slots.

Give every amp of the group its own row, byte for byte, as
apple,speaker-config. A speaker-config without a row for every amp is
not passed on, and the property is removed from the group's amps, as
for the group-wide properties.

Tests: tests/run-kboot-audio.sh, 8 scenarios (new: a speaker-config
too short for the group). On the M1 Pro (J316s), M2 (J413) and M4 Pro
(J616s) ADTs every amp gets its own row, at the amp level the kernel's
table has today.

Assisted-by: LLM
Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>

(cherry picked from aurora-silicon/aura commit 97c979d606455fd3d36ca634f89c4d2a462a16bc)
---
 src/kboot_audio.c        | 68 ++++++++++++++++++++++++++++------------
 tests/kboot_audio_adt.py | 16 ++++++++--
 tests/kboot_audio_host.c |  5 +--
 tests/run-kboot-audio.sh | 45 ++++++++++++++++----------
 4 files changed, 92 insertions(+), 42 deletions(-)

diff --git a/src/kboot_audio.c b/src/kboot_audio.c
index 4ef967d0..2de52d54 100644
--- a/src/kboot_audio.c
+++ b/src/kboot_audio.c
@@ -12,11 +12,15 @@
  *   bop-config            -> apple,bop-config            (the brownout prevention block)
  *   amp-dcblocker-config  -> apple,amp-dcblocker-config  (the DC blocker setting)
  *
- * A property the group does not have is removed from its amps, so the kernel never sees a
- * value that did not come from this Mac. Amps are matched to the DT's ti,sn012776 nodes by I2C
- * address, which must name exactly one node. A group with an amp that cannot be matched is left
- * as it is: the kernel gets either the whole group's configuration or none of it. Nothing here
- * stops the boot.
+ * The group's speaker-config has one four-byte row per amp, in the group's order (the first amp,
+ * then speaker1, speaker2, ...); each amp gets its own row as apple,speaker-config. It carries
+ * the amp's operating level and its slots.
+ *
+ * A property the group does not have (or a speaker-config without a row for every amp) is
+ * removed from its amps, so the kernel never sees a value that did not come from this Mac. Amps
+ * are matched to the DT's ti,sn012776 nodes by I2C address, which must name exactly one node. A
+ * group with an amp that cannot be matched is left as it is: the kernel gets either the whole
+ * group's configuration or none of it. Nothing here stops the boot.
  */
 
 #include "kboot_audio.h"
@@ -29,6 +33,7 @@
 #define AMP_ADT_COMPAT "audio-control,sn012776"
 #define AMP_DT_COMPAT  "ti,sn012776"
 #define MAX_GROUP_AMPS 16
+#define SPEAKER_ROW    4
 
 static const struct {
     const char *adt;
@@ -92,6 +97,26 @@ static int dt_amp_by_addr(const void *dt, u32 addr)
     return found;
 }
 
+/* Set @name on the DT amp at @addr to @val (remove it when @val is NULL) */
+static int dt_amp_setprop(void *dt, u32 addr, const char *name, const void *val, u32 len)
+{
+    /* Offsets move with every change to the tree: look the amp up each time */
+    int node = dt_amp_by_addr(dt, addr);
+    int ret;
+
+    if (node < 0)
+        return -1;
+    if (val)
+        ret = fdt_setprop(dt, node, name, val, len);
+    else
+        ret = fdt_delprop(dt, node, name);
+    if (ret && !(ret == -FDT_ERR_NOTFOUND && !val)) {
+        printf("kboot: audio: could not set %s on the amp at 0x%x: %d\n", name, addr, ret);
+        return -1;
+    }
+    return 0;
+}
+
 static int setup_amp_group(void *dt, const void *adt, int arm_io, int group)
 {
     const char *name = adt_get_name(adt, group);
@@ -144,24 +169,26 @@ static int setup_amp_group(void *dt, const void *adt, int arm_io, int group)
         const void *val = adt_getprop(adt, group, amp_group_props[p].adt, &len);
 
         for (int i = 0; i < n; i++) {
-            /* Offsets move with every change to the tree: look the amp up each time */
-            int node = dt_amp_by_addr(dt, addrs[i]);
-            int ret;
-
-            if (node < 0)
-                return -1;
-            if (val)
-                ret = fdt_setprop(dt, node, amp_group_props[p].dt, val, len);
-            else
-                ret = fdt_delprop(dt, node, amp_group_props[p].dt);
-            if (ret && !(ret == -FDT_ERR_NOTFOUND && !val)) {
-                printf("kboot: audio: %s: could not set %s on the amp at 0x%x: %d\n", name,
-                       amp_group_props[p].dt, addrs[i], ret);
+            if (dt_amp_setprop(dt, addrs[i], amp_group_props[p].dt, val, len))
                 return -1;
-            }
         }
     }
 
+    /* One speaker-config row per amp, in the group's order */
+    u32 len = 0;
+    const u8 *rows = adt_getprop(adt, group, "speaker-config", &len);
+
+    if (rows && len < (u32)n * SPEAKER_ROW) {
+        printf("kboot: audio: %s: speaker-config has %u bytes for %d amps, not passed on\n", name,
+               len, n);
+        rows = NULL;
+    }
+    for (int i = 0; i < n; i++) {
+        if (dt_amp_setprop(dt, addrs[i], "apple,speaker-config",
+                           rows ? rows + i * SPEAKER_ROW : NULL, SPEAKER_ROW))
+            return -1;
+    }
+
     printf("kboot: audio: %s: amp configuration for %d amps\n", name, n);
     return 0;
 }
@@ -185,7 +212,8 @@ int kboot_audio_amp_config(void *dt, const void *adt)
             /* Only a group's first amp has speakerN or the group's configuration */
             if (!adt_getprop(adt, dev, "speaker1", NULL) &&
                 !adt_getprop(adt, dev, "bop-config", NULL) &&
-                !adt_getprop(adt, dev, "amp-dcblocker-config", NULL))
+                !adt_getprop(adt, dev, "amp-dcblocker-config", NULL) &&
+                !adt_getprop(adt, dev, "speaker-config", NULL))
                 continue;
             setup_amp_group(dt, adt, arm_io, dev);
         }
diff --git a/tests/kboot_audio_adt.py b/tests/kboot_audio_adt.py
index 6e1809e2..3d6332fc 100644
--- a/tests/kboot_audio_adt.py
+++ b/tests/kboot_audio_adt.py
@@ -18,6 +18,8 @@ import sys
 # Made-up configuration blobs: the code under test copies bytes and never reads them
 BOP = bytes(range(0xA0, 0xA0 + 24))
 DCB = bytes([0x5A, 0x01, 0x00, 0x00])
+# One four-byte row per amp of a three-amp group, in the group's order
+ROWS = bytes([0xC0, 0xC1, 0xC2, 0xC3, 0xD0, 0xD1, 0xD2, 0xD3, 0xE0, 0xE1, 0xE2, 0xE3])
 
 
 def u32(v):
@@ -81,9 +83,10 @@ def dts(amps, stale=None):
     return "\n".join(out)
 
 
-GROUP3 = {"bop-config": BOP, "amp-dcblocker-config": DCB,
+GROUP3 = {"bop-config": BOP, "amp-dcblocker-config": DCB, "speaker-config": ROWS,
           "speaker1": u32(0x11), "speaker2": u32(0x12)}
-STALE = {"apple,amp-dcblocker-config": b"\xee\xee", "apple,bop-config": b"\xee"}
+STALE = {"apple,amp-dcblocker-config": b"\xee\xee", "apple,bop-config": b"\xee",
+         "apple,speaker-config": b"\xee\xee\xee\xee"}
 
 
 def scenario(name):
@@ -101,6 +104,13 @@ def scenario(name):
                                     amp("audio-speaker-b", 0x42, 0x12)]),
                  Node("i2c1", {}, [amp("audio-speaker-a", 0x41, 0x11)])]
         return adt(buses), dts(three, {(1, 0x41): STALE})
+    if name == "short-speaker-config":
+        g = dict(GROUP3)
+        g["speaker-config"] = ROWS[:8]
+        buses = [Node("i2c0", {}, [amp("audio-speaker", 0x40, 0x10, g),
+                                    amp("audio-speaker-b", 0x42, 0x12)]),
+                 Node("i2c1", {}, [amp("audio-speaker-a", 0x41, 0x11)])]
+        return adt(buses), dts(three, {(1, 0x41): STALE})
     if name == "single-amp":
         one = {"bop-config": BOP}
         return adt([Node("i2c0", {}, [amp("audio-speaker", 0x40, 0x10, one)])]), dts([(0, 0x40)])
@@ -120,7 +130,7 @@ def scenario(name):
     raise SystemExit("unknown scenario %s" % name)
 
 
-SCENARIOS = ["group", "no-dcblocker", "single-amp", "amp-missing-in-dt", "amp-not-unique-in-dt",
+SCENARIOS = ["group", "no-dcblocker", "short-speaker-config", "single-amp", "amp-missing-in-dt", "amp-not-unique-in-dt",
              "dangling-phandle", "no-amps"]
 
 
diff --git a/tests/kboot_audio_host.c b/tests/kboot_audio_host.c
index 9ad3b761..b1844729 100644
--- a/tests/kboot_audio_host.c
+++ b/tests/kboot_audio_host.c
@@ -6,8 +6,8 @@
  *   kboot-audio-host <in.adt> <in.dtb>
  *
  * Runs kboot_audio_amp_config() and prints, for every ti,sn012776 node of the result in tree
- * order, its I2C address and its apple,bop-config and apple,amp-dcblocker-config ("-" when
- * absent), one line each ("amp ..."), after aura's own log lines.
+ * order, its I2C address and its apple,bop-config, apple,amp-dcblocker-config and
+ * apple,speaker-config ("-" when absent), one line each ("amp ..."), after aura's own log lines.
  */
 #include <stdio.h>
 #include <stdlib.h>
@@ -94,6 +94,7 @@ int main(int argc, char **argv)
         printf("amp 0x%x", reg ? fdt32_to_cpu(reg[0]) : 0);
         print_prop(dt, node, "apple,bop-config");
         print_prop(dt, node, "apple,amp-dcblocker-config");
+        print_prop(dt, node, "apple,speaker-config");
         printf("\n");
     }
     return 0;
diff --git a/tests/run-kboot-audio.sh b/tests/run-kboot-audio.sh
index b50d4ce7..0f4f35b7 100644
--- a/tests/run-kboot-audio.sh
+++ b/tests/run-kboot-audio.sh
@@ -57,30 +57,41 @@ BOP=a0a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7
 DCB=5a010000
 STALE_DCB=eeee
 STALE_BOP=ee
-expect() { # expect <scenario>: the amp lines that scenario must give
+R0=c0c1c2c3
+R1=d0d1d2d3
+R2=e0e1e2e3
+STALE_ROW=eeeeeeee
+amp() { # amp <addr> <bop> <dcb> <row>
+    printf 'amp 0x%s apple,bop-config=%s apple,amp-dcblocker-config=%s apple,speaker-config=%s\n' "$@"
+}
+expect() { # expect <scenario>: the amp lines that scenario must give (tree order 0x40, 0x42, 0x41)
     case $1 in
     group)
-        printf 'amp 0x40 apple,bop-config=%s apple,amp-dcblocker-config=%s\n' $BOP $DCB
-        printf 'amp 0x42 apple,bop-config=%s apple,amp-dcblocker-config=%s\n' $BOP $DCB
-        printf 'amp 0x41 apple,bop-config=%s apple,amp-dcblocker-config=%s\n' $BOP $DCB ;;
+        amp 40 $BOP $DCB $R0
+        amp 42 $BOP $DCB $R2
+        amp 41 $BOP $DCB $R1 ;;
     no-dcblocker)
-        printf 'amp 0x40 apple,bop-config=%s apple,amp-dcblocker-config=-\n' $BOP
-        printf 'amp 0x42 apple,bop-config=%s apple,amp-dcblocker-config=-\n' $BOP
-        printf 'amp 0x41 apple,bop-config=%s apple,amp-dcblocker-config=-\n' $BOP ;;
+        amp 40 $BOP - $R0
