From 55107444abcf9a2fe14d2b05bda1f0aec13d57a1 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 20:09:04 +0000
Subject: [PATCH 34/35] sio: build the T8132 SIO's firmware tables in the
 protocol-10 layout

dt_setup_sio() looks the SIO up by its "sio" alias on every SoC, but
sio_setup_fwdata() only knows two layouts: the M1/M2 one and the T6030's
protocol 10 (six 36-byte DMA shim records, nine device types). An M4
(T8132) SIO got the M1 layout.

The J604's boot ADT describes its SIO as the T6030's is described: the
firmware is pre-loaded with a __TEXT and a __DATA segment, and the node
carries asio-ascwrap-tunables (48 bytes), map-range (MISC), dmashim
(SSPI, SUAR, SAUD) and device-type (dSPI, dUAR, dDPA), each record the
32- or 8-byte payload behind its key. Build the protocol-10 tables for
the T8132 too, and only on boards admitted for it (T8132_PATH_SIO, new;
the J604 and the J713, whose template ADTs carry the same records).

Which protocol the T8132 firmware speaks is only known once it runs. The
kernel reads it from the firmware's start message before it sends any of
these tables, and leaves the SIO stopped unless it is 10, so a mismatch
costs the SIO and nothing else. m1n1 logs "T8132 SIO enabled with
protocol-10 tables" when it hands the SIO over and "T8132 SIO not
admitted on this board" on other M4 boards.

On the J604 boot ADT the tables are tunables 0x30, map ranges 0x40,
DMA shims 0xd8 and device types 0x48 bytes, the sizes the kernel's
protocol-10 check expects (host test, tests/run-sio-host.sh).

tests/python/test_sio_reservation_full.py copies dt_setup_sio() out of
src/kboot.c and builds it with -Werror; give it stand-ins for chip_id and
the board admission, and two more cases: an M4 board not admitted for
its SIO reserves and enables nothing, and an admitted one whose
reservation fails stays disabled. Without the admission check, the
not-admitted case fails.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 src/kboot.c                               |  8 ++++++++
 src/sio.c                                 |  7 ++++++-
 src/t8132_board.h                         |  6 +++++-
 tests/python/test_sio_reservation_full.py | 16 ++++++++++++++++
 4 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/src/kboot.c b/src/kboot.c
index d865aeed..901f7689 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -6473,6 +6473,12 @@ static int dt_setup_sio(void)
         char adt_path[16];
         snprintf(adt_path, sizeof(adt_path), "/arm-io/%s", sio_names[i]);
 
+        /* An M4 board's SIO tables are only built where they were checked. */
+        if (chip_id == T8132 && !t8132_board_admitted(dt, T8132_PATH_SIO)) {
+            printf("FDT: %s: T8132 SIO not admitted on this board\n", sio_names[i]);
+            continue;
+        }
+
         if (dt_reserve_asc_firmware(adt_path, NULL, sio_names[i], true, 0))
             continue;
         if (dt_set_sio_fwdata(adt_path, sio_names[i]))
@@ -6480,6 +6486,8 @@ static int dt_setup_sio(void)
 
         node = fdt_path_offset(dt, sio_names[i]);
         fdt_setprop_string(dt, node, "status", "okay");
+        if (chip_id == T8132)
+            printf("FDT: %s: T8132 SIO enabled with protocol-10 tables\n", sio_names[i]);
     }
 
     return 0;
diff --git a/src/sio.c b/src/sio.c
index d94f438f..557fca9c 100644
--- a/src/sio.c
+++ b/src/sio.c
@@ -139,6 +139,11 @@ struct copy_rule copy_rules[] = {
  * SIO firmware protocol 10 (T6030) takes six DMA shim records of 36 bytes, the
  * ADT's 32 bytes and an interrupt (none for any of them), and nine device types.
  * The ADT still describes the shims and device types as above.
+ *
+ * The T8132 (M4) gets the same tables: its ADT describes the same records
+ * (map-range MISC, dmashim SSPI/SUAR/SAUD, device-type dSPI/dUAR/dDPA). Its
+ * firmware's protocol is only known once it runs: the kernel reads it before it
+ * sends any of these tables and leaves the SIO stopped unless it is 10.
  */
 static struct copy_rule copy_rules_v10[] = {
     {
@@ -211,7 +216,7 @@ struct sio_data *sio_setup_fwdata(const char *adt_path)
     struct copy_rule *rules = copy_rules;
     int nrules = ARRAY_SIZE(copy_rules);
 
-    if (chip_id == T6030) {
+    if (chip_id == T6030 || chip_id == T8132) {
         rules = copy_rules_v10;
         nrules = ARRAY_SIZE(copy_rules_v10);
     }
diff --git a/src/t8132_board.h b/src/t8132_board.h
index 2f06c6c2..b2595ed0 100644
--- a/src/t8132_board.h
+++ b/src/t8132_board.h
@@ -29,6 +29,7 @@ enum t8132_board_path {
     T8132_PATH_PCIE_RADIO, /* SMC gP13 radio rail, SID16 bypass, PCIe disable on failure */
     T8132_PATH_ISP,        /* ISP firmware handoff: text/data placeholders, platform ID */
     T8132_PATH_DCPEXT_ENABLE, /* enable a handed-over dcpext's disabled nodes (one-tree boards) */
+    T8132_PATH_SIO,        /* SIO firmware tables in the protocol-10 layout, firmware segments */
     T8132_PATH_COUNT,
 };
 
@@ -59,7 +60,10 @@ static inline bool t8132_board_admitted(const void *fdt, enum t8132_board_path p
          * The J604 boots one device tree, the kernel's, so a dcpext m1n1
          * hands over is enabled here (T8132_PATH_DCPEXT_ENABLE); the
          * dcpext0/1, dart-dcpext0/1 and dart-dispext0/1 nodes match the
-         * J713 ones. See docs/j604.md.
+         * J713 ones. The SIO path reads the sio node's map-range (MISC),
+         * dmashim (SSPI, SUAR, SAUD), device-type (dSPI, dUAR, dDPA),
+         * asio-ascwrap-tunables and firmware segments, all present in the
+         * J604's boot ADT with the firmware pre-loaded. See docs/j604.md.
          */
         {"apple,j604", T8132_PATHS_ALL},
     };
diff --git a/tests/python/test_sio_reservation_full.py b/tests/python/test_sio_reservation_full.py
index 1b044c5d..27b2028a 100644
--- a/tests/python/test_sio_reservation_full.py
+++ b/tests/python/test_sio_reservation_full.py
@@ -32,6 +32,12 @@ struct sio_data {
 };
 static void *dt;
 static int enabled, reserve_calls;
+#define T8132 0x8132
+enum { T8132_PATH_SIO };
+static u32 chip_id = 0x8103;
+static bool sio_admitted;
+static bool t8132_board_admitted(const void *tree, int path)
+{ (void)tree; assert(path == T8132_PATH_SIO); return sio_admitted; }
 static int fdt_path_offset(const void *tree, const char *path)
 { (void)tree; return strcmp(path, "sio") == 0 ? 1 : -1; }
 static u32 fdt_get_phandle(const void *tree, int node)
@@ -76,6 +82,16 @@ int main(void)
     assert(dt_setup_sio() == 0);
     assert(reserve_calls == 1);
     assert(enabled == 0);
+    /* An M4 board not admitted for its SIO: nothing reserved, nothing enabled. */
+    chip_id = T8132;
+    assert(dt_setup_sio() == 0);
+    assert(reserve_calls == 1);
+    assert(enabled == 0);
+    /* Admitted: the failed reservation still leaves the node disabled. */
+    sio_admitted = true;
+    assert(dt_setup_sio() == 0);
+    assert(reserve_calls == 2);
+    assert(enabled == 0);
     return 0;
 }
 '''
