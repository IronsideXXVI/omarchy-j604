From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DjDeveloperr <hey@djdev.me>
Date: Tue, 10 Nov 2026 09:08:59 -0500
Subject: [PATCH] pcie: publish APCIe tables as a DT transaction
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Use the caller’s existing DT buffer capacity to stage the complete export even when the input tree is packed. Copy the packed result back only after every property succeeds, preserving the original tree and existing values on failure. Report publication only after the transaction commits.

Signed-off-by: Diljit Singh <hey@djdev.me>
(cherry picked from commit 5e7406f609e3a8246e6d4bf514cf063f27aadbf6)
[Dylan: host test stub conflict only; our stub signature with the new capacity argument.]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 src/kboot.c                           |  2 +-
 src/pcie.h                            |  2 +-
 src/pcie_fdt.c                        | 46 ++++++++++++++++++++-------
 tests/python/test_smp_handoff_gate.py |  2 +-
 4 files changed, 37 insertions(+), 15 deletions(-)

diff --git a/src/kboot.c b/src/kboot.c
index 69d533ab..cc6b37e5 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -8005,7 +8005,7 @@ int kboot_boot(void *kernel)
         }
     }
     /* Linux's deep sleep needs them to bring ANS's APCIe block back. */
-    if (!ret && pcie_apcie_tables_fdt(dt) < 0)
+    if (!ret && pcie_apcie_tables_fdt(dt, dt_bufsize) < 0)
         printf("kboot: APCIe tables not published; deep sleep stays refused\n");
     if (chip_id == T8140) {
         if (ret < 0) {
diff --git a/src/pcie.h b/src/pcie.h
index 4e86d090..3135103f 100644
--- a/src/pcie.h
+++ b/src/pcie.h
@@ -11,6 +11,6 @@ int pcie_shutdown(void);
 /* Disable optional J713 PCIe admission after rail/controller/DART failure. */
 int pcie_disable_j713_fdt(void *dt);
 /* Post-M4: copy the APCIe tables from the ADT to the DT's PCIe host and its port. */
-int pcie_apcie_tables_fdt(void *dt);
+int pcie_apcie_tables_fdt(void *dt, int capacity);
 
 #endif
diff --git a/src/pcie_fdt.c b/src/pcie_fdt.c
index 45566d0e..8b3b6afb 100644
--- a/src/pcie_fdt.c
+++ b/src/pcie_fdt.c
@@ -506,14 +506,8 @@ static int pcie_apcie_host(void *dt, int *path)
 }
 
 /* 0 on a Mac whose ANS doesn't run on the APCIe block: nothing to publish. */
-int pcie_apcie_tables_fdt(void *dt)
+static int pcie_apcie_tables_publish(void *dt, const char *apcie)
 {
-    int ans = adt_path_offset(adt, "/arm-io/ans");
-    if (ans < 0 || !adt_get_property(adt, ans, "nvme-secure-bar"))
-        return 0;
-
-    const char *apcie =
-        adt_path_offset(adt, "/arm-io/apcie") >= 0 ? "/arm-io/apcie" : "/arm-io/apcie0";
     char bridge[32];
     int path[8], bridge_path[8];
     snprintf(bridge, sizeof(bridge), "%s/pci-bridge0", apcie);
@@ -531,18 +525,46 @@ int pcie_apcie_tables_fdt(void *dt)
     for (size_t i = 0; i < ARRAY_SIZE(pcie_apcie_tables); i++) {
         int from = pcie_apcie_tables[i].port ? adt_bridge : adt_node;
         int n = pcie_apcie_table_fdt(dt, host, from, path, i);
-        if (n < 0) {
-            for (size_t j = 0; j < i; j++)
-                fdt_delprop(dt, pcie_apcie_table_node(dt, host, j), pcie_apcie_tables[j].fdt);
+        if (n < 0)
             return -1;
-        }
         records += n;
     }
 
-    printf("FDT: %s tables published, %d records\n", apcie, records);
     return records;
 }
 
+/* Use the already reserved buffer size, even if the caller packed the tree.
+ * Commit all ten properties together; an error preserves the original DT,
+ * including any properties that were present before this export attempt.
+ */
+int pcie_apcie_tables_fdt(void *dt, int capacity)
+{
+    int ans = adt_path_offset(adt, "/arm-io/ans");
+    if (ans < 0 || !adt_get_property(adt, ans, "nvme-secure-bar"))
+        return 0;
+    if (capacity <= 0 || (u32)capacity < fdt_totalsize(dt))
+        return -1;
+
+    void *staged = malloc(capacity);
+    if (!staged)
+        return -1;
+    const char *apcie =
+        adt_path_offset(adt, "/arm-io/apcie") >= 0 ? "/arm-io/apcie" : "/arm-io/apcie0";
+    int ret = fdt_open_into(dt, staged, capacity);
+    if (!ret)
+        ret = pcie_apcie_tables_publish(staged, apcie);
+    if (ret >= 0) {
+        if (fdt_pack(staged))
+            ret = -1;
+        else {
+            memcpy(dt, staged, fdt_totalsize(staged));
+            printf("FDT: %s tables published, %d records\n", apcie, ret);
+        }
+    }
+    free(staged);
+    return ret;
+}
+
 int pcie_disable_j713_fdt(void *dt)
 {
     int host = -1;
diff --git a/tests/python/test_smp_handoff_gate.py b/tests/python/test_smp_handoff_gate.py
index 1e1545b2..c8dbd20f 100644
--- a/tests/python/test_smp_handoff_gate.py
+++ b/tests/python/test_smp_handoff_gate.py
@@ -50,7 +50,7 @@ static void usb_init(void) {}
 static int pcie_init(void) { return 0; }
 static int pcie_prepare_fdt(void *p) { return 0; }
 static int pcie_handoff_fdt(void *p) { return 0; }
-static int pcie_apcie_tables_fdt(void *p) { return 0; }
+static int pcie_apcie_tables_fdt(void *p, int capacity) { return 0; }
 static int fdt_node_check_compatible(const void *p, int node, const char *compatible) { return 1; }
 static int dt_disable_j713_pcie(void) { return 0; }
 static int dt_disable_t8140_pcie(void) { return 0; }
