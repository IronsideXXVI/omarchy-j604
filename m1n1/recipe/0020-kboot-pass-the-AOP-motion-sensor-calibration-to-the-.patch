From 5ad786b43f1d651d6134b9fd28f627dcc94225dd Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sun, 1 Nov 2026 09:44:34 +1100
Subject: [PATCH] kboot: pass the AOP motion sensor calibration to the OS

The AOP accelerometer and gyroscope take the machine's calibration from
the OS, as three per-sensor packets. Copy the accel and gyro
calibration properties from the ADT AOP services into the matching
children of the OS AOP node, where the OS driver reads them. A missing
service or property is skipped.

Ported from aurora-silicon/m1n1#61.

Assisted-by: LLM
Signed-off-by: Ryan Murray <ryan@aurorasilicon.org>
(backported from aurora-silicon/aura commit 174a42c5be9126526522a8ccdea0067efb444a21)
[j604: same function, byte for byte. This tree's dt_set_aop_firmware() is
 T8132-only (no T6040/T6041 AOP segment path), so the call goes right before
 dt_set_t8132_aop(). On the J604 ADT both services carry all three
 properties (one location-0 entry each), and the J604 device tree has the
 accel and gyro children (linux-aurora j604/imu).]
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 src/kboot.c | 45 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/src/kboot.c b/src/kboot.c
index 8b9ea72d..4c591a38 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -6124,6 +6124,49 @@ disable:
     return 0;
 }
 
+/*
+ * The AOP's accelerometer and gyroscope report only once the OS has sent them
+ * the machine's calibration. Copy it from the ADT services into the matching
+ * children of the OS AOP node; a missing service or property is skipped.
+ */
+static void dt_set_aop_motion_cal(const char *path)
+{
+    static const char *const services[] = {"accel", "gyro"};
+    static const char *const props[][2] = {
+        {"range-intr-cal", "apple,range-intrinsic-cal"},
+        {"nominal-extr-cal", "apple,nominal-extrinsic-cal"},
+        {"range-extr-cal", "apple,range-extrinsic-cal"},
+    };
+
+    for (size_t i = 0; i < ARRAY_SIZE(services); i++) {
+        char adt_path[64], name[32];
+
+        snprintf(adt_path, sizeof(adt_path), "/arm-io/aop/iop-aop-nub/%s", services[i]);
+        int anode = adt_path_offset(adt, adt_path);
+        int aop = fdt_path_offset(dt, path);
+        int node = aop < 0 ? aop : fdt_subnode_offset(dt, aop, services[i]);
+        if (anode < 0 || node < 0)
+            continue;
+
+        int copied = 0;
+        for (size_t j = 0; j < ARRAY_SIZE(props); j++) {
+            u32 len = 0;
+
+            snprintf(name, sizeof(name), "%s-%s", services[i], props[j][0]);
+            const void *val = adt_getprop(adt, anode, name, &len);
+            if (!val || !len)
+                continue;
+            if (fdt_setprop(dt, node, props[j][1], val, len)) {
+                printf("FDT: %s/%s: cannot set %s\n", path, services[i], props[j][1]);
+                continue;
+            }
+            copied++;
+        }
+        printf("FDT: %s/%s: %d of %d calibration properties\n", path, services[i], copied,
+               (int)ARRAY_SIZE(props));
+    }
+}
+
 /*
  * T8132 (J713, and J604 once admitted): hand the AOP over through
  * dt_set_t8132_aop(). This tree does not port aurora-wip's T6040/T6041 AOP
@@ -6148,6 +6191,8 @@ static int dt_set_aop_firmware(void)
         return 0;
     }
 
+    dt_set_aop_motion_cal(path);
+
     return dt_set_t8132_aop(path);
 }
 
