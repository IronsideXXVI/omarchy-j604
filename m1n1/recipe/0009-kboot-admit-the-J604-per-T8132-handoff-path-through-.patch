diff --git a/src/t8132_board.h b/src/t8132_board.h
new file mode 100644
index 00000000..eff16ee7
--- /dev/null
+++ b/src/t8132_board.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: MIT */
+
+#ifndef T8132_BOARD_H
+#define T8132_BOARD_H
+
+#include "types.h"
+
+#include "libfdt/libfdt.h"
+
+/*
+ * T8132 (M4) boards admitted on the board-gated handoff paths.
+ *
+ * The J713 handoff paths (aurora-silicon/m1n1 #35-#48) were qualified on the
+ * J713 only. Another T8132 board is admitted per path, and only where the
+ * values that path depends on are shown to match from source: see
+ * docs/j604.md for the J604 evidence table. A path not admitted for a board
+ * behaves as it does on any unqualified M4 board (it is skipped or refused),
+ * so an unverified path fails closed. Every admitted path still checks its
+ * live ADT values at boot and refuses on a mismatch.
+ */
+
+enum t8132_board_path {
+    T8132_PATH_STORAGE,    /* ANS adoption for U-Boot, heap/high-water and lifecycle handoff */
+    T8132_PATH_DISPLAY,    /* DCP firmware mappings and the inherited display DART */
+    T8132_PATH_GPU,        /* G16 GPU handoff (sgx/gfx-asc windows and interrupts) */
+    T8132_PATH_DAPF,       /* DAPF consumers mtp/pmp/isp requested by the kernel DT */
+    T8132_PATH_AOP,        /* AOP handoff: DAPF bank, firmware segments, windows */
+    T8132_PATH_ATC_USB3,   /* T8132 ATC USB3 tunables */
+    T8132_PATH_PCIE_RADIO, /* SMC gP13 radio rail, SID16 bypass, PCIe disable on failure */
+    T8132_PATH_COUNT,
+};
+
+#define T8132_PATH_BIT(p) (1u << (p))
+#define T8132_PATHS_ALL   (T8132_PATH_BIT(T8132_PATH_COUNT) - 1)
+
+static inline bool t8132_board_admitted(const void *fdt, enum t8132_board_path path)
+{
+    static const struct {
+        const char *compatible;
+        unsigned int paths;
+    } boards[] = {
+        /* The board aurora-silicon/m1n1 #35-#48 were qualified on. */
+        {"apple,j713", T8132_PATHS_ALL},
+        /*
+         * J604 (MacBook Pro 14-inch, M4, Mac16,1). AOP is held back: its
+         * iop-aop-nub aop-target differs from the J713's (0 vs 1 in the
+         * 26B123 template ADT) and the effect on the J713 AOP handoff is not
+         * known. See docs/j604.md.
+         */
+        {"apple,j604", T8132_PATH_BIT(T8132_PATH_STORAGE) | T8132_PATH_BIT(T8132_PATH_DISPLAY) |
+                           T8132_PATH_BIT(T8132_PATH_GPU) | T8132_PATH_BIT(T8132_PATH_DAPF) |
+                           T8132_PATH_BIT(T8132_PATH_ATC_USB3) |
+                           T8132_PATH_BIT(T8132_PATH_PCIE_RADIO)},
+    };
+
+    if (!fdt || (unsigned int)path >= T8132_PATH_COUNT)
+        return false;
+    for (unsigned int i = 0; i < sizeof(boards) / sizeof(boards[0]); i++)
+        if (!fdt_node_check_compatible(fdt, 0, boards[i].compatible))
+            return (boards[i].paths & T8132_PATH_BIT(path)) != 0;
+    return false;
+}
+
+#endif
