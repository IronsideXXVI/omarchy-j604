diff --git a/tests/python/test_t8132_board_admission.py b/tests/python/test_t8132_board_admission.py
new file mode 100644
index 00000000..5fde1b82
--- /dev/null
+++ b/tests/python/test_t8132_board_admission.py
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: MIT
+"""t8132_board_admitted(): which T8132 board is admitted on which handoff path."""
+
+from pathlib import Path
+import subprocess
+
+
+def test_t8132_board_admission(tmp_path):
+    repo = Path(__file__).resolve().parents[2]
+    board = "\n".join(line for line in (repo / "src/t8132_board.h").read_text().splitlines()
+                      if not line.startswith("#include"))
+    harness = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <string.h>
+#include "libfdt.h"
+''' + board + r'''
+static void tree(void *dt, const char *compatible, int len)
+{
+    assert(!fdt_create_empty_tree(dt, 4096));
+    assert(!fdt_setprop(dt, 0, "compatible", compatible, len));
+}
+#define TREE(dt, s) tree(dt, s, sizeof(s))
+int main(void)
+{
+    char dt[4096];
+    unsigned int all = 0;
+
+    TREE(dt, "apple,j713\0apple,t8132\0apple,arm-platform");
+    for (int p = 0; p < T8132_PATH_COUNT; p++) {
+        assert(t8132_board_admitted(dt, p));
+        all |= T8132_PATH_BIT(p);
+    }
+    assert(all == T8132_PATHS_ALL);
+
+    /* J604: every path but the AOP handoff (see docs/j604.md). */
+    TREE(dt, "apple,j604\0apple,t8132\0apple,arm-platform");
+    for (int p = 0; p < T8132_PATH_COUNT; p++)
+        assert(t8132_board_admitted(dt, p) == (p != T8132_PATH_AOP));
+
+    /* Other T8132 boards, and look-alike names, are admitted nowhere. */
+    const char *others[] = {"apple,j715", "apple,j604x", "apple,j60", "apple,t8132"};
+    for (unsigned i = 0; i < sizeof(others) / sizeof(others[0]); i++) {
+        tree(dt, others[i], strlen(others[i]) + 1);
+        for (int p = 0; p < T8132_PATH_COUNT; p++)
+            assert(!t8132_board_admitted(dt, p));
+    }
+
+    /* No tree, or a path outside the table, is never admitted. */
+    TREE(dt, "apple,j713");
+    assert(!t8132_board_admitted(NULL, T8132_PATH_STORAGE));
+    assert(!t8132_board_admitted(dt, T8132_PATH_COUNT));
+    assert(!t8132_board_admitted(dt, (enum t8132_board_path)-1));
+    return 0;
+}
+'''
+    source = tmp_path / "t8132-board.c"
+    binary = tmp_path / "t8132-board"
+    source.write_text(harness)
+    libfdt = repo / "src/libfdt"
+    sources = [libfdt / (n + ".c") for n in ("fdt", "fdt_ro", "fdt_rw", "fdt_sw", "fdt_wip",
+                                             "fdt_empty_tree", "fdt_check", "fdt_strerror",
+                                             "fdt_addresses")]
+    subprocess.run(["cc", "-D_GNU_SOURCE", "-std=gnu11", "-Wall", "-Wextra", "-Werror",
+                    "-Wno-unused-parameter", "-I", str(libfdt), str(source),
+                    *map(str, sources), "-o", str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
