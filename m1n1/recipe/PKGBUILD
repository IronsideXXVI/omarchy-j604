# omacom/m1n1; ordinary updates refresh ESP Stage 2, never enroll Stage 1.
pkgname=m1n1-aurora
pkgver=1.6.1.aurora22
pkgrel=1.3  # local J604 build of the official 1.6.1.aurora22-1 recipe; any official -2 or newer wins
pkgdesc='Omarchy Apple Silicon bootloader from omacom/m1n1 (J604 patch series, private draft)'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/omacom/m1n1'
license=('MIT' 'GPL-2.0-only' 'CC0-1.0' 'OFL-1.1-RFN' 'Zlib' 'BSD-2-Clause OR GPL-2.0-or-later' 'BSD-3-Clause OR GPL-2.0-or-later' 'MIT OR Apache-2.0')
provides=("m1n1=$pkgver" "m1n1-neo=$pkgver")
conflicts=('m1n1' 'aura' 'm1n1-neo')
# Only migrate the downstream providers, never the stock Asahi package.
replaces=('aura' 'm1n1-neo')
makedepends=('git' 'clang' 'lld' 'llvm' 'rustup' 'make' 'python')
options=('!strip' '!debug')
_commit=bc79acc434e612ffcb95bfc7cb2fd7543afac5f2
# J604 (Mac16,1, T8132) series on the official pin: the omacom integration/aurora
# private port (lab branch private/j604-aop-dapf-f15, 349c2904, minus the T8122-only
# 121fcbf3 GPU identity merge) and 0013, which leaves plain SMC GPIO output port rails
# (ADT pKW4 template 0, e.g. the J604 SD reader) to the OS. Drop each patch
# once omacom/m1n1 carries it.
