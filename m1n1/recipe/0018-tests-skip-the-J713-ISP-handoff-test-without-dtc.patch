Subject: [PATCH 18/19] tests: skip the J713 ISP handoff test without dtc

The CI runners have no dtc, so the test failed there with
FileNotFoundError. Skip it when dtc is missing, as the T6041 display
handoff test does.

Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Assisted-by: LLM
---
 tests/python/test_j713_isp_handoff.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/tests/python/test_j713_isp_handoff.py b/tests/python/test_j713_isp_handoff.py
index 2fefaab6..767b68db 100644
--- a/tests/python/test_j713_isp_handoff.py
+++ b/tests/python/test_j713_isp_handoff.py
@@ -1,8 +1,11 @@
 # SPDX-License-Identifier: MIT
 """Exercise the J713 ISP firmware handoff with production kboot code and real FDTs."""
 
+import shutil
 import subprocess
 from pathlib import Path
+
+import pytest
 from test_siliconforest_handoff import run_c
 
 ROOT = Path(__file__).resolve().parents[2]
@@ -37,6 +40,8 @@ TREE = r'''/dts-v1/;
 
 
 def test_j713_isp_handoff_fills_placeholders_or_leaves_the_camera_off(tmp_path):
+    if not shutil.which("dtc"):
+        pytest.skip("needs dtc")
     kboot = (ROOT / "src/kboot.c").read_text()
 
     def function(name, kind="static int "):
