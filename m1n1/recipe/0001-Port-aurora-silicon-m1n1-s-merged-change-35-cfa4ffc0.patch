+++ b/docs/j713.md
@@ -0,0 +1,61 @@
+<!-- SPDX-License-Identifier: GPL-2.0-only OR MIT -->
+
+# J713 (M4 MacBook Air) boot and firmware handoff
+
+This series prepares J713 for the common Aurora boot flow: retained ANS
+storage, PMU/SPMI resources, PCIe radio power and selected DART streams,
+requested DAPF consumers, and the inherited display framebuffer. It is the
+bootloader companion to the [basic Linux support](https://github.com/aurora-silicon/linux/pull/366).
+
+Build stage 2 from `aurora-wip` plus this series:
+
+```
+make -j8 USE_CLANG=1 ARCH=aarch64-linux-gnu- RELEASE=1 CHAINLOADING=1 ESP_STAGE2=1
+```
+
+Append the J713 DTB and a gzip-compressed `u-boot-nodtb.bin` built with
+`apple_m1_defconfig` from the companion U-Boot series. Preserve the ESP path
+configured by stage 1; `/m1n1/boot.bin` is not necessarily the installed path.
+
+ANS may already be running when stage 2 starts. Adopt that RTKit session
+without replaying its handshake; initialize a stopped session when needed.
+Admit the measured J713 split-BAR queue layout and publish validated live
+ANS/SART/mailbox resources. Retain the session and its buffers for U-Boot.
+
+PCIe endpoint power and stream IDs come from the DT. The J713 radio rail
+uses the qualified native gP13 pKW4 action template 0x00800000 with argument
+one. Unknown keys, namespaces or active-low wiring are refused. Optional
+radio setup failure disables that controller while retaining the independent
+ANS boot path. Disabling that controller does not undo a prepared rail,
+link or DART state; those resources remain retained. Only selected unlocked
+DART streams enter bypass; display translations are preserved. DAPF setup
+needs both an explicit handoff request and a known active consumer.
+T8132 additionally requires validated typed instance metadata: a selected
+GAPF bank with no DAPF instance is preserved without filter writes, and a
+genuine DAPF selection is refused until its writer is qualified. This
+refusal does not remove independent, explicitly requested consumer power.
+
+The shared firmware handoff retains GPU and DCP reservations and validates
+their metadata without starting native GPU or display drivers. Unknown
+optional native resources leave the firmware framebuffer available. Keeping
+these reservations is necessary even when the OS uses software rendering.
+Native Linux GPU/DCP activation remains a separate kernel series.
+
+U-Boot initializes and retains the MTP helper. Linux owns DockChannel
+discovery and keyboard/trackpad configuration. Use the companion
+[U-Boot review branch](https://github.com/aurora-silicon/u-boot/tree/m4/pr1-basic-bringup)
+and matching Linux DT/UKI handoff support. Per-kernel DTBs are prepared through
+EFI fixup without replacing the shared raw DTB bundle.
+
+The stage-2 control DTB must provide `atcphy0` and `atcphy1` aliases for
+banked T8132 USB3 calibration export. Bluetooth requires a `bluetooth0`
+alias and the matching `pci14e4,5f72` endpoint node so the shared handoff
+can publish the per-machine address and Taurus calibration. Preserve a
+USB2-only control topology when retaining older fallback kernels; the
+per-kernel DTB selects which qualified port has USB3 resources. The
+companion U-Boot importer copies calibration without adding OS topology
+or importing the control DTB's power-ownership policy.
+
+Qualification must record both running bootloader versions after a real
+reboot, the kernel's imported DT provenance, and physical display/input
+response. A successful build or host test does not establish hardware support.
diff --git a/src/dapf.c b/src/dapf.c
index b9a05385..63dd9e5d 100644
--- a/src/dapf.c
+++ b/src/dapf.c
@@ -134,6 +134,85 @@ static int dapf_init_t8110(const char *path, u64 base, int node)
     }
 }
 
+enum dapf_instance_type {
+    DAPF_INSTANCE_DART = 0x44415254,
+    DAPF_INSTANCE_DAPF = 0x44415046,
+    DAPF_INSTANCE_GAPF = 0x47415046,
+};
+
+struct dapf_instance {
+    u32 type;
+    u32 instance;
+    char name[8];
+} PACKED;
+
+static_assert(sizeof(struct dapf_instance) == 16, "Invalid DAPF instance size");
+
+static int dapf_preserve_t8132(const char *path, int index, int node, int *dart_path)
+{
+    u32 length;
+    const struct dapf_instance *instances = adt_getprop(adt, node, "instance", &length);
+
+    if (!instances || !length || length % sizeof(*instances) || index < 0 ||
+        (u32)index >= length / sizeof(*instances)) {
+        printf("dapf: Invalid T8132 instance metadata for %s\n", path);
+        return -1;
+    }
+
+    bool has_dart = false, has_dapf = false;
+    u32 count = length / sizeof(*instances);
+    for (u32 i = 0; i < count; i++) {
+        switch (instances[i].type) {
+            case DAPF_INSTANCE_DART:
+                has_dart = true;
+                break;
+            case DAPF_INSTANCE_DAPF:
+                has_dapf = true;
+                break;
+            case DAPF_INSTANCE_GAPF:
+                break;
+            default:
+                printf("dapf: Unknown T8132 instance type for %s\n", path);
+                return -1;
+        }
+        for (u32 j = 0; j < i; j++) {
+            if (instances[i].type == instances[j].type &&
+                instances[i].instance == instances[j].instance) {
+                printf("dapf: Duplicate T8132 instance for %s\n", path);
+                return -1;
+            }
+        }
+        u64 base, size;
+        if (adt_get_reg(adt, dart_path, "reg", i, &base, &size) < 0 || !size ||
+            base + size < base ||
+            (instances[i].type != DAPF_INSTANCE_DART &&
+             ((base & 0x3fff) || size != 0x4000))) {
+            printf("dapf: Invalid T8132 instance resource for %s\n", path);
+            return -1;
+        }
+    }
+
+    if (!has_dart) {
+        printf("dapf: Missing T8132 DART instance for %s\n", path);
+        return -1;
+    }
+
+    if (!has_dapf && instances[index].type == DAPF_INSTANCE_GAPF) {
+        /* Native PMP has GAPF only; its DAPF property does not create an APF. */
+        printf("dapf: No T8132 DAPF instance for %s; preserving filter state\n", path);
+        return 0;
+    }
+
+    if (instances[index].type != DAPF_INSTANCE_DAPF) {
+        printf("dapf: Selected T8132 resource is not DAPF for %s\n", path);
+        return -1;
+    }
+
+    /* Do not admit the legacy writer, even for a genuine T8132 DAPF bank. */
+    printf("dapf: T8132 DAPF programming is unsupported for %s; preserving filter state\n", path);
+    return -1;
+}
+
 int dapf_init(const char *path, int index)
 {
     int ret = -1;
@@ -144,6 +223,9 @@ int dapf_init(const char *path, int index)
         return -1;
     }
 
+    if (chip_id == T8132)
+        return dapf_preserve_t8132(path, index, node, dart_path);
+
     u32 pwr;
     if (!adt_getprop(adt, node, "clock-gates", &pwr))
         pwr = 0;
@@ -191,8 +273,85 @@ struct entry dapf_entries[] = {
     {"/arm-io/dart-isp", 5, "isp"}, {"/arm-io/dart-isp0", 5, "isp"}, {NULL, -1, NULL},
 };
 
+static int dapf_init_j713(void *dt)
+{
+    int ret = 0;
+    int count = 0;
+    static const struct {
+        const char *path;
+        const char *consumer;
+        int index;
+    } entries[] = {
+        {"/arm-io/dart-aop", "/arm-io/aop", 1},
+        {"/arm-io/dart-mtp", "/arm-io/mtp", 1},
+        {"/arm-io/dart-pmp", "/arm-io/pmp", 1},
+        {"/arm-io/dart-isp", "/arm-io/isp", 5},
+        {"/arm-io/dart-isp0", "/arm-io/isp0", 5},
+        {NULL, NULL, -1},
+    };
+    const typeof(entries[0]) *entry = entries;
+    int chosen = dt ? fdt_path_offset(dt, "/chosen") : -1;
+    bool described =
+        chosen >= 0 && fdt_getprop(dt, chosen, "linux-enablement-mac,dapf-handoff", NULL);
+
+    if (!described) {
+        printf("dapf: No J713 consumer handoff requested; preserving firmware state\n");
+        return 0;
+    }
+
+    while (entry->path != NULL) {
+        if (adt_path_offset(adt, entry->path) < 0) {
+            entry++;
+            continue;
+        }
+
+        if (described) {
+            if (fdt_stringlist_search(dt, chosen, "linux-enablement-mac,dapf-handoff",
+                                      entry->consumer) < 0) {
+                printf("dapf: Skipping %s; consumer %s is not requested for handoff\n", entry->path,
+                       entry->consumer);
+                entry++;
+                continue;
+            }
+
+            if (fdt_stringlist_search(dt, chosen, "linux-enablement-mac,dapf-power-on-handoff",
+                                      entry->consumer) >= 0) {
+                if (pmgr_adt_power_enable(entry->consumer) < 0) {
+                    printf("dapf: Failed to power requested consumer %s\n", entry->consumer);
+                    ret = -1;
+                    entry++;
+                    continue;
+                }
+                printf("dapf: Preserving requested consumer %s in the active state\n",
+                       entry->consumer);
+            }
+
+            int powered = pmgr_adt_is_powered(entry->consumer);
+            if (powered <= 0) {
+                printf("dapf: Skipping %s; consumer %s is inactive or its state is unknown\n", entry->path,
+                       entry->consumer);
+                entry++;
+                continue;
+            }
+        }
+
+        if (dapf_init(entry->path, entry->index) < 0) {
+            ret = -1;
+        }
+        entry++;
+        count += 1;
+    }
+    return ret ? ret : count;
+}
+
 int dapf_init_fdt(const void *fdt)
 {
+    if (chip_id == T8132) {
+        if (!fdt || fdt_node_check_compatible(fdt, 0, "apple,j713"))
+            return 0; /* No other M4 board's power/DAPF contract is qualified. */
+        return dapf_init_j713((void *)fdt);
+    }
+
     int ret = 0;
     int count = 0;
     struct entry *entry = dapf_entries;
diff --git a/src/dart.c b/src/dart.c
index 040535be..8de5fbdb 100644
--- a/src/dart.c
+++ b/src/dart.c
@@ -79,6 +79,9 @@
 #define DART_T8110_TLB_CMD_OP_FLUSH_SID 1
 #define DART_T8110_TLB_CMD_STREAM       GENMASK(7, 0)
 
+#define DART_T8110_PARAMS2        0x4
+#define DART_T8110_PARAMS2_BYPASS BIT(0)
+
 #define DART_T8110_PROTECT          0x200
 #define DART_T8110_PROTECT_TTBR_TCR BIT(0)
 
@@ -496,6 +499,57 @@ dart_dev_t *dart_init_adt_display(const char *path, int instance, int device)
     return dart;
 }
 
+int dart_set_bypass_fdt(void *dt, u32 phandle, u8 device)
+{
+    int node = fdt_node_offset_by_phandle(dt, phandle);
+    if (node < 0) {
+        printf("dart: FDT node for phandle %u not found\n", phandle);
+        return -1;
+    }
+
+    const char *name = fdt_get_name(dt, node, NULL);
+    u64 base = dt_get_address(dt, node);
+    if (!base) {
+        printf("dart: Error getting FDT DART %s base address\n", name);
+        return -1;
+    }
+
+    if (fdt_node_check_compatible(dt, node, "apple,t8110-dart") || device >= dart_t8110.sid_count) {
+        printf("dart: FDT DART %s cannot bypass stream %u\n", name, device);
+        return -1;
+    }
+
+    if (read32(base + DART_T8110_PROTECT) & DART_T8110_PROTECT_TTBR_TCR) {
+        printf("dart: FDT DART %s TTBR/TCR registers are locked\n", name);
+        return -1;
+    }
+
+    if (!(read32(base + DART_T8110_PARAMS2) & DART_T8110_PARAMS2_BYPASS)) {
+        printf("dart: FDT DART %s does not support bypass\n", name);
+        return -1;
+    }
+
+    write32(base + DART_T8110_ENABLE_STREAMS + 4 * (device >> 5), BIT(device & 31));
+    write32(base + DART_T8110_TCR_OFF + 4 * device, dart_t8110.tcr_disabled);
+
+    u32 tcr = read32(base + DART_T8110_TCR_OFF + 4 * device);
+    /*
+     * AURORA_TODO: Find a reliable way to read back or otherwise verify the
+     * DAPF-stage bypass request.
+     *
+     * T8132's DAPF bypass request does not remain set in the readable TCR,
+     * while the DART bypass bit does. Request both stages, but validate the
+     * persistent DART state.
+     */
+    if (!(tcr & DART_T8110_TCR_BYPASS_DART)) {
+        printf("dart: FDT DART %s failed to bypass stream %u (TCR 0x%x)\n", name, device, tcr);
+        return -1;
+    }
+
+    printf("dart: FDT DART %s stream %u is in bypass\n", name, device);
+    return 0;
+}
+
 void dart_lock_adt(const char *path, int instance)
 {
     int dart_path[8];
