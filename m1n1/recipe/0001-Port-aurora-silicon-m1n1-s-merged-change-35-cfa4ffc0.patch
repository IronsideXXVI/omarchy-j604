+/* payload_run() prepares the M4 ANS session; these fixtures never run a T8132. */
+static bool nvme_init(void) { return true; }
 static bool nvme_keep_running_for_linux;
 static bool nvme_adopt_live_session;
 static int display_configure(const char *s) { printf("DISPLAY %s\n", s); return 0; }
diff --git a/tests/python/test_m4_ans_fdt.py b/tests/python/test_m4_ans_fdt.py
new file mode 100644
index 00000000..b78a7d3d
--- /dev/null
+++ b/tests/python/test_m4_ans_fdt.py
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Only enable ANS placeholder nodes once their live resources are complete."""
+from pathlib import Path
+import subprocess
+
+
+def test_ans_fdt_admission(tmp_path):
+    repo = Path(__file__).resolve().parents[2]
+    text = (repo / "src/kboot.c").read_text()
+    def function(name):
+        start = text.index("static int " + name + "(")
+        opening = text.index("{", start)
+        depth = 1
+        end = opening + 1
+        while depth:
+            depth += (text[end] == "{") - (text[end] == "}")
+            end += 1
+        return text[start:end]
+    production = "\n".join(function(name) for name in
+                           ["dt_set_adt_regs", "dt_set_adt_irqs", "dt_set_ans_nvme"])
+    harness = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "libfdt.h"
+typedef uint64_t u64;
+typedef uint32_t u32;
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define bail(...) do { printf(__VA_ARGS__); return -1; } while (0)
+static void *dt, *adt;
+static int fault;
+static const u32 irqs[] = {70, 71, 72, 73, 74};
+static int adt_path_offset_trace(void *a, const char *p, int *path)
+{ path[0] = strstr(p, "sart") ? 2 : 1; return path[0]; }
+static void *adt_get_property(void *a, int node, const char *p) { return (void *)1; }
+static int adt_get_reg(void *a, int *path, const char *p, int index, u64 *base, u64 *size)
+{
+ if (fault == 1 && path[0] == 2) return -1;
+ *base = path[0] == 2 ? 0x485c50000ULL : index == 0 ? 0x481600000ULL :
+         index == 3 ? 0x485cc0000ULL : 0x4c5cc0000ULL;
+ *size = index == 9 ? 0x10000 : 0x60000;
+ return 0;
+}
+static const void *adt_getprop(void *a, int n, const char *p, u32 *len)
+{ *len = fault == 2 ? 16 : sizeof(irqs); return irqs; }
+''' + production + r'''
+static void setup(void *blob)
+{
+ dt = blob;
+ assert(!fdt_create_empty_tree(dt, 8192));
+ const char *aliases[] = {"ans", "ans-mbox", "sart-ans"};
+ for (unsigned i = 0; i < 3; i++) {
+  int n = fdt_add_subnode(dt, 0, aliases[i]);
+  assert(n >= 0 && !fdt_setprop_string(dt, n, "status", "disabled"));
+ }
+ int n = fdt_add_subnode(dt, 0, "aliases");
+ for (unsigned i = 0; i < 3; i++) {
+  char path[32]; snprintf(path, sizeof(path), "/%s", aliases[i]);
+  assert(!fdt_setprop_string(dt, n, aliases[i], path));
+ }
+}
+int main(void)
+{
+ char blob[8192];
+ for (fault = 0; fault < 3; fault++) {
+  setup(blob);
+  assert((dt_set_ans_nvme(false) < 0) == (fault != 0));
+  const char *aliases[] = {"ans", "ans-mbox", "sart-ans"};
+  for (unsigned i = 0; i < 3; i++) {
+   int n = fdt_path_offset(dt, aliases[i]);
+   const char *status = fdt_getprop(dt, n, "status", NULL);
+   assert(status && !strcmp(status, fault ? "disabled" : "okay"));
+  }
+  if (!fault) {
+   int len;
+   const fdt32_t *v = fdt_getprop(dt, fdt_path_offset(dt, "ans-mbox"), "interrupts", &len);
+   assert(v && len == 48);
+   assert(fdt32_to_cpu(v[1]) == 71 && fdt32_to_cpu(v[4]) == 70);
+   assert(fdt32_to_cpu(v[7]) == 73 && fdt32_to_cpu(v[10]) == 72);
+   const fdt64_t *reg = fdt_getprop(dt, fdt_path_offset(dt, "ans"), "reg", &len);
+   assert(reg && len == 48 && fdt64_to_cpu(reg[1]) == 0x40000);
+  }
+ }
+ return 0;
+}
+'''
+    source = tmp_path / "ans-fdt.c"
+    source.write_text(harness)
+    binary = tmp_path / "ans-fdt"
+    libfdt = repo / "src/libfdt"
+    sources = [libfdt / (n + ".c") for n in ("fdt", "fdt_ro", "fdt_rw", "fdt_sw",
+               "fdt_wip", "fdt_empty_tree", "fdt_check", "fdt_strerror", "fdt_addresses")]
+    subprocess.run(["cc", "-D_GNU_SOURCE", "-std=gnu11", "-Wall", "-Wextra", "-Werror",
+                    "-Wno-unused-parameter", "-Wno-format", "-I", str(libfdt), str(source),
+                    *map(str, sources), "-o", str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
diff --git a/tests/python/test_m4_dapf_power.py b/tests/python/test_m4_dapf_power.py
new file mode 100644
index 00000000..33ff2e24
--- /dev/null
+++ b/tests/python/test_m4_dapf_power.py
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Do not access DAPF MMIO without both a handoff request and known power."""
+from pathlib import Path
+import subprocess
+
+
+def test_j713_dapf_power_admission(tmp_path):
+    repo = Path(__file__).resolve().parents[2]
+    text = (repo / "src/dapf.c").read_text()
+    start = text.index("static int dapf_init_j713(")
+    production = text[start:text.index("int dapf_init_fdt(", start)]
+    harness = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+static void *adt;
+static int requested, power, enable_error, requests_power, dapf_calls, enables;
+static int fdt_path_offset(void *dt, const char *p) { return 1; }
+static void *fdt_getprop(void *dt, int n, const char *p, void *len)
+{ return requested ? (void *)1 : NULL; }
+static int fdt_stringlist_search(void *dt, int n, const char *p, const char *v)
+{
+    if (strcmp(v, "/arm-io/mtp")) return -1;
+    return !strcmp(p, "linux-enablement-mac,dapf-handoff") || requests_power ? 0 : -1;
+}
+static int adt_path_offset(void *dt, const char *p)
+{ return !strcmp(p, "/arm-io/dart-mtp") ? 1 : -1; }
+static int pmgr_adt_power_enable(const char *p) { enables++; return enable_error; }
+static int pmgr_adt_is_powered(const char *p) { return power; }
+static int dapf_init(const char *p, int i)
+{ assert(power == 1 && requested); dapf_calls++; return 0; }
+''' + production + r'''
+int main(void)
+{
+    for (requested = 0; requested <= 1; requested++)
+    for (requests_power = 0; requests_power <= 1; requests_power++)
+    for (power = -1; power <= 1; power++)
+    for (enable_error = -1; enable_error <= 0; enable_error++) {
+        dapf_calls = enables = 0;
+        int ret = dapf_init_j713((void *)1);
+        bool failed = requested && requests_power && enable_error;
+        assert(dapf_calls == (requested && !failed && power == 1));
+        assert(enables == (requested && requests_power));
+        assert((ret < 0) == failed);
+    }
+    return 0;
+}
+'''
+    source = tmp_path / "dapf-power.c"
+    source.write_text(harness)
+    binary = tmp_path / "dapf-power"
+    subprocess.run(["cc", "-std=gnu11", "-Wall", "-Wextra", "-Werror",
+                    "-Wno-unused-parameter", str(source), "-o", str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
diff --git a/tests/python/test_m4_gpu_handoff.py b/tests/python/test_m4_gpu_handoff.py
new file mode 100644
index 00000000..eb6465e7
--- /dev/null
+++ b/tests/python/test_m4_gpu_handoff.py
@@ -0,0 +1,125 @@
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Run the M4 resource publisher against real libfdt and malformed firmware data."""
+from pathlib import Path
+import subprocess
+
+
+def test_m4_gpu_resource_admission(tmp_path):
+    repo = Path(__file__).resolve().parents[2]
+    production = (repo / 'src/kboot_gpu_m4.c').read_text()
+    production = '\n'.join(line for line in production.splitlines() if not line.startswith('#include'))
+    harness = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "libfdt.h"
+typedef uint64_t u64;
+typedef uint32_t u32;
+#define T8132 0x8132
+#define SZ_16K 0x4000
+struct adt_segment_ranges { u64 phys, iova, remap; u32 size, unk; };
+static void *adt;
+static unsigned chip_id = T8132;
+static int fault;
+static struct adt_segment_ranges segs[2];
+static u64 bases[4], sizes[4];
+static u32 irqs[4];
+static int adt_path_offset_trace(void *a, const char *p, int *trace)
+{ trace[0] = strstr(p, "gfx-asc") ? 2 : 1; return trace[0]; }
+static int adt_get_reg(void *a, int *trace, const char *name, unsigned i, u64 *base, u64 *size)
+{
+    *base = trace[0] == 1 ? 0x300000000 : 0x302600000;
+    *size = trace[0] == 1 ? 0x4000000 : 0x88000;
+    if (fault == 1) *base += 0x4000;
+    return 0;
+}
+static const void *adt_getprop(void *a, int n, const char *p, u32 *len)
+{
+    const char *names[] = {"gpu-region", "gfx-shared-region", "gfx-handoff", "gfx-shared-l2-region"};
+    if (!strcmp(p, "interrupts")) { *len = sizeof(irqs); return irqs; }
+    if (!strcmp(p, "segment-names")) { *len = sizeof("__TEXT;__DATA"); return "__TEXT;__DATA"; }
+    if (!strcmp(p, "segment-ranges")) { *len = sizeof(segs); return segs; }
+    for (unsigned i = 0; i < 4; i++) {
+        char prop[64];
+        snprintf(prop, sizeof(prop), "%s-base", names[i]);
+        if (!strcmp(p, prop)) { *len = fault == 8 ? 4 : 8; return &bases[i]; }
+        snprintf(prop, sizeof(prop), "%s-size", names[i]);
+        if (!strcmp(p, prop)) { *len = 8; return &sizes[i]; }
+    }
+    *len = 0; return NULL;
+}
+''' + production + r'''
+int main(void)
+{
+    char blob[32768];
+    const char *regions[] = {"uat-ttbs", "uat-pagetables", "uat-handoff", "uat-shared-l2", "gpu-fw-text", "gpu-fw-data"};
+    for (fault = 0; fault <= 12; fault++) {
+        assert(!fdt_create_empty_tree(blob, sizeof(blob)));
+        assert(!fdt_setprop_string(blob, 0, "compatible", "apple,j713"));
+        int gpu = fdt_add_subnode(blob, 0, "gpu"); assert(gpu >= 0);
+        assert(!fdt_setprop_string(blob, gpu, "compatible", "apple,agx-t8132"));
+        assert(!fdt_setprop_u32(blob, gpu, "apple,g16-handoff-version", 99));
+        int aliases = fdt_add_subnode(blob, 0, "aliases"); assert(aliases >= 0);
+        assert(!fdt_setprop_string(blob, aliases, "gpu", "/gpu"));
+        int fb = fdt_add_subnode(blob, 0, "framebuffer"); assert(fb >= 0);
+        assert(!fdt_setprop_string(blob, fb, "status", "okay"));
+        int res = fdt_add_subnode(blob, 0, "reserved-memory"); assert(res >= 0);
+        for (unsigned i = 0; i < 6; i++)
+            if (fault != 7 || i != 5) assert(fdt_add_subnode(blob, res, regions[i]) >= 0);
+        for (unsigned i = 0; i < 4; i++) {
+            bases[i] = 0x800000000ULL + i * 0x100000;
+            sizes[i] = 0x4000;
+        }
+        segs[0] = (struct adt_segment_ranges){0x800400000, 0xfffffc0000000000, 0x800400000, 0x4000, 1};
+        segs[1] = (struct adt_segment_ranges){0x800500000, 0xfffffc0000004000, 0x800500000, 0x8000, 0};
+        irqs[0] = 994; irqs[1] = 993; irqs[2] = 996; irqs[3] = 995;
+        if (fault == 2) irqs[0]++;
+        if (fault == 3) bases[1] = bases[0];
+        if (fault == 4) sizes[0] = 0;
+        if (fault == 5) segs[1].iova++;
+        if (fault == 6) bases[0] = (1ULL << 42);
+        if (fault == 9) sizes[0] = UINT64_MAX - 0x3fff;
+        if (fault == 10) bases[0]++;
+        if (fault == 11) assert(!fdt_setprop_string(blob, 0, "compatible", "apple,j715"));
+        if (fault == 12) {
+            gpu = fdt_path_offset(blob, "/gpu");
+            assert(!fdt_setprop_string(blob, gpu, "compatible", "apple,unsupported-gpu"));
+        }
+        int result = dt_set_gpu_m4(blob);
+        fb = fdt_path_offset(blob, "/framebuffer");
+        const char *fb_status = fdt_getprop(blob, fb, "status", NULL);
+        assert(fb >= 0 && fb_status && !strcmp(fb_status, "okay"));
+        gpu = fdt_path_offset(blob, "/gpu");
+        int len;
+        const fdt32_t *version = fdt_getprop(blob, gpu, "apple,g16-handoff-version", &len);
+        if (fault) {
+            assert(!result && !version && !fdt_num_mem_rsv(blob));
+            const char *status = fdt_getprop(blob, gpu, "status", NULL);
+            assert(status && !strcmp(status, "disabled"));
+        } else {
+            assert(!result && version && len == 4 && fdt32_to_cpu(*version) == 1);
+            assert(fdt_num_mem_rsv(blob) == 6);
+            for (unsigned i = 0; i < 6; i++) {
+                char path[80]; snprintf(path, sizeof(path), "/reserved-memory/%s", regions[i]);
+                int node = fdt_path_offset(blob, path); assert(node >= 0);
+                assert(fdt_getprop(blob, node, "no-map", &len) && !len);
+                const fdt64_t *reg = fdt_getprop(blob, node, "reg", &len); assert(reg && len == 16);
+                assert(fdt64_to_cpu(reg[0]) == (i < 4 ? bases[i] : segs[i - 4].phys));
+                assert(fdt64_to_cpu(reg[1]) == (i < 4 ? sizes[i] : segs[i - 4].size));
+            }
+            assert(!dt_set_gpu_m4(blob) && fdt_num_mem_rsv(blob) == 6);
+        }
+    }
+    puts("M4 live resources, repeat publication and malformed/overlapping carveouts PASS");
+    return 0;
+}
+'''
+    source = tmp_path / 'gpu.c'
+    source.write_text(harness)
+    binary = tmp_path / 'gpu'
+    libfdt = repo / 'src/libfdt'
+    sources = [libfdt / (n + '.c') for n in ('fdt', 'fdt_ro', 'fdt_rw', 'fdt_sw', 'fdt_wip', 'fdt_empty_tree', 'fdt_check', 'fdt_strerror', 'fdt_addresses')]
+    subprocess.run(['cc', '-D_GNU_SOURCE', '-std=gnu11', '-Wall', '-Wextra', '-Werror', '-Wno-unused-parameter', '-Wno-format', '-I', str(libfdt), str(source), *map(str, sources), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
diff --git a/tests/python/test_m4_pcie_power_fdt.py b/tests/python/test_m4_pcie_power_fdt.py
new file mode 100644
index 00000000..2bef961a
--- /dev/null
+++ b/tests/python/test_m4_pcie_power_fdt.py
@@ -0,0 +1,201 @@
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""PCIe handoff keeps OS ownership and requires the native J713 gP13 action."""
+from pathlib import Path
+import subprocess
+
+
+def test_j713_pcie_power_contract(tmp_path):
+    repo = Path(__file__).resolve().parents[2]
+    text = (repo / "src/pcie_fdt.c").read_text()
+    production = "\n".join(line for line in text.splitlines() if not line.startswith("#include"))
+    harness = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "libfdt.h"
+typedef uint8_t u8;
+typedef uint32_t u32;
+typedef int smc_dev_t;
+#define BIT(n) (1U << (n))
+static int writes, bypasses;
+static int smc_result;
+static u32 last_value, last_key;
+static u8 expected_sid = 16;
+static smc_dev_t smc;
+static smc_dev_t *smc_init(void) { return &smc; }
+static int smc_write_u32(smc_dev_t *s, u32 key, u32 value)
+{ writes++; last_key = key; last_value = value; return smc_result; }
+static void smc_shutdown(smc_dev_t *s) {}
+static int dart_set_bypass_fdt(void *dt, u32 phandle, u8 sid)
+{ assert(phandle == 2 && sid == expected_sid); bypasses++; return 0; }
+''' + production + r'''
+static void setup(void *dt, bool j713, int fault)
+{
+ assert(!fdt_create_empty_tree(dt, 8192));
+ assert(!fdt_setprop_string(dt, 0, "compatible", j713 ? "apple,j713" : "apple,j715"));
+ int gpio = fdt_add_subnode(dt, 0, "gpio");
+ assert(gpio >= 0 && !fdt_setprop_string(dt, gpio, "compatible",
+                                      fault == 2 ? "apple,smc-low-gpio" : "apple,smc-gpio"));
+ assert(!fdt_setprop_u32(dt, gpio, "phandle", 3));
+ int dart = fdt_add_subnode(dt, 0, "dart");
+ assert(dart >= 0 && !fdt_setprop_string(dt, dart, "compatible", "apple,t8132-dart"));
+ assert(!fdt_setprop_u32(dt, dart, "phandle", 2));
+ assert(!fdt_setprop_u32(dt, dart, "#iommu-cells", 1));
+ int host = fdt_add_subnode(dt, 0, "pcie");
+ assert(host >= 0 && !fdt_setprop_string(dt, host, "compatible", "apple,t8132-pcie"));
+ fdt32_t map[] = {cpu_to_fdt32(0x100), cpu_to_fdt32(2), cpu_to_fdt32(16), cpu_to_fdt32(1)};
+ assert(!fdt_setprop(dt, host, "iommu-map", map, sizeof(map)));
+ assert(!fdt_setprop_u32(dt, host, "iommu-map-mask", 0xff00));
+ int port = fdt_add_subnode(dt, host, "port");
+ fdt32_t pwren[] = {cpu_to_fdt32(3), cpu_to_fdt32(fault == 3 ? 0x14 : 0x13),
+                    cpu_to_fdt32(fault == 1 ? 1 : fault == 4 ? 2 : 0)};
+ assert(!fdt_setprop(dt, port, "pwren-gpios", pwren, sizeof(pwren)));
+ int endpoint = fdt_add_subnode(dt, port, "wifi");
+ fdt32_t reg[] = {cpu_to_fdt32(0x10000), 0, 0, 0, 0};
+ assert(!fdt_setprop(dt, endpoint, "reg", reg, sizeof(reg)));
+}
+static void check_admission(void *dt, bool valid)
+{
+ writes = bypasses = 0;
+ assert(pcie_prepare_fdt(dt) == (valid ? 1 : 0));
+ assert(writes == valid);
+ assert(pcie_handoff_fdt(dt) == (valid ? 1 : -1));
+ assert(bypasses == valid);
+}
+static void test_iommu_admission(void *dt)
+{
+ const struct { u32 base, offset; bool valid; } streams[] = {
+  {0xffffffffU, 1, false}, /* Must not wrap to SID 0. */
+  {256, 0, false}, {255, 1, false},
+  {255, 0, true}, {254, 1, true}, {0, 0, true},
+ };
+ for (unsigned i = 0; i < sizeof(streams) / sizeof(*streams); i++) {
+  setup(dt, true, 0);
+  fdt32_t map[] = {cpu_to_fdt32(0x100), cpu_to_fdt32(2),
+                  cpu_to_fdt32(streams[i].base), cpu_to_fdt32(streams[i].offset + 1)};
+  assert(!fdt_setprop(dt, fdt_path_offset(dt, "/pcie"), "iommu-map", map, sizeof(map)));
+  assert(!fdt_setprop_u32(dt, fdt_path_offset(dt, "/pcie"), "iommu-map-mask", 0xffff));
+  fdt32_t reg[] = {cpu_to_fdt32((0x100 + streams[i].offset) << 8), 0, 0, 0, 0};
+  assert(!fdt_setprop(dt, fdt_path_offset(dt, "/pcie/port/wifi"), "reg", reg, sizeof(reg)));
+  expected_sid = streams[i].base + streams[i].offset;
+  check_admission(dt, streams[i].valid);
+ }
+ const struct { const char *path, *property; int len; } malformed[] = {
+  {"/pcie", "iommu-map", 0}, {"/pcie", "iommu-map", 1},
+  {"/pcie", "iommu-map", 15}, {"/pcie", "iommu-map", 17},
+  {"/pcie", "iommu-map", 20},
+  {"/pcie", "iommu-map-mask", 0}, {"/pcie", "iommu-map-mask", 1},
+  {"/pcie", "iommu-map-mask", 3}, {"/pcie", "iommu-map-mask", 5},
+  {"/pcie", "iommu-map-mask", 8},
+  {"/dart", "#iommu-cells", 0}, {"/dart", "#iommu-cells", 1},
+  {"/dart", "#iommu-cells", 3}, {"/dart", "#iommu-cells", 5},
+  {"/dart", "#iommu-cells", 8},
+  {"/pcie/port/wifi", "reg", 0}, {"/pcie/port/wifi", "reg", 1},
+  {"/pcie/port/wifi", "reg", 3}, {"/pcie/port/wifi", "reg", 4},
+  {"/pcie/port/wifi", "reg", 5}, {"/pcie/port/wifi", "reg", 8},
+  {"/pcie/port/wifi", "reg", 16}, {"/pcie/port/wifi", "reg", 19},
+  {"/pcie/port/wifi", "reg", 21}, {"/pcie/port/wifi", "reg", 24},
+ };
+ for (unsigned i = 0; i < sizeof(malformed) / sizeof(*malformed); i++) {
+  setup(dt, true, 0);
+  int node = fdt_path_offset(dt, malformed[i].path), len;
+  const void *original = fdt_getprop(dt, node, malformed[i].property, &len);
+  unsigned char value[32] = {0};
+  assert(original && len <= (int)sizeof(value));
+  memcpy(value, original, len);
+  assert(!fdt_setprop(dt, node, malformed[i].property, value, malformed[i].len));
+  check_admission(dt, false);
+ }
+ /* The optional mask may be absent; the provider cell count may not. */
+ setup(dt, true, 0); expected_sid = 16;
+ assert(!fdt_delprop(dt, fdt_path_offset(dt, "/pcie"), "iommu-map-mask"));
+ check_admission(dt, true);
+ setup(dt, true, 0);
+ assert(!fdt_delprop(dt, fdt_path_offset(dt, "/dart"), "#iommu-cells"));
+ check_admission(dt, false);
+ setup(dt, true, 0);
+ assert(!fdt_setprop_u32(dt, fdt_path_offset(dt, "/dart"), "#iommu-cells", 2));
+ check_admission(dt, false);
+ setup(dt, true, 0);
+ assert(!fdt_delprop(dt, fdt_path_offset(dt, "/pcie"), "iommu-map"));
+ check_admission(dt, false);
+ /* Linux rejects an id-base with bits outside the mask; do not normalize it. */
+ setup(dt, true, 0);
+ fdt32_t map[] = {cpu_to_fdt32(0x1ff), cpu_to_fdt32(2), cpu_to_fdt32(16), cpu_to_fdt32(1)};
+ assert(!fdt_setprop(dt, fdt_path_offset(dt, "/pcie"), "iommu-map", map, sizeof(map)));
+ check_admission(dt, false);
+ /* A malformed enabled sibling must not redirect selection to a later RID. */
+ for (int disabled = 0; disabled <= 1; disabled++) {
+  setup(dt, true, 0);
+  int bad = fdt_add_subnode(dt, fdt_path_offset(dt, "/pcie/port"), "bad");
+  assert(bad >= 0 && !fdt_setprop_u32(dt, bad, "reg", 0x10000));
+  if (disabled) assert(!fdt_setprop_string(dt, bad, "status", "disabled"));
+  check_admission(dt, disabled);
+ }
+ /* Skip zero-count and nonmatching entries, but require a supported provider. */
+ for (int empty = 0; empty <= 1; empty++) {
+  setup(dt, true, 0);
+  fdt32_t entries[] = {cpu_to_fdt32(0x200), cpu_to_fdt32(2), 0, cpu_to_fdt32(empty ? 0 : 1),
+                      cpu_to_fdt32(0x100), cpu_to_fdt32(2), cpu_to_fdt32(16), cpu_to_fdt32(1)};
+  assert(!fdt_setprop(dt, fdt_path_offset(dt, "/pcie"), "iommu-map", entries, sizeof(entries)));
+  check_admission(dt, true);
+ }
+ setup(dt, true, 0); map[0] = cpu_to_fdt32(0x100); map[3] = 0;
+ assert(!fdt_setprop(dt, fdt_path_offset(dt, "/pcie"), "iommu-map", map, sizeof(map)));
+ check_admission(dt, false);
+ setup(dt, true, 0);
+ assert(!fdt_setprop_string(dt, fdt_path_offset(dt, "/dart"), "compatible", "apple,t8103-dart"));
+ check_admission(dt, false);
+}
+static void test_smc_failure_admission(void *dt)
+{
+ /* smc_cmd returns a positive firmware status, not a negative errno. */
+ for (smc_result = -1; smc_result <= 255; smc_result++) {
+  if (!smc_result)
+   continue;
+  setup(dt, true, 0); writes = bypasses = 0;
+  assert(pcie_prepare_fdt(dt) < 0);
+  assert(writes == 1 && !bypasses);
+  /* Follow kboot's optional-radio failure path: no DART bypass follows. */
+  assert(!pcie_disable_j713_fdt(dt));
+  assert(!pcie_handoff_fdt(dt) && !bypasses);
+ }
+ smc_result = 0;
+}
+int main(void)
+{
+ char blob[8192];
+ for (int j713 = 0; j713 <= 1; j713++)
+ for (int fault = 0; fault < 5; fault++) {
+  setup(blob, j713, fault); writes = bypasses = 0;
+  assert(pcie_prepare_fdt(blob) == (!j713 ? 0 : fault ? -1 : 1));
+  assert(writes == (j713 && !fault));
+  if (writes) {
+   assert(last_key == 0x67503133); /* gP13 */
+   assert(last_value == 0x00800001U); /* Native pKW4 template + high argument. */
+  }
+  assert(pcie_handoff_fdt(blob) == j713 && bypasses == j713);
+  assert(fdt_getprop(blob, fdt_path_offset(blob, "/pcie/port"), "pwren-gpios", NULL));
+  assert(pcie_disable_j713_fdt(blob) == (j713 ? 0 : -1));
+  const char *status = fdt_getprop(blob, fdt_path_offset(blob, "/pcie"), "status", NULL);
+  assert(j713 ? status && !strcmp(status, "disabled") : !status);
+  /* A disabled controller cannot have an endpoint re-admitted by handoff. */
+  assert(!pcie_prepare_fdt(blob) && !pcie_handoff_fdt(blob));
+ }
+ test_iommu_admission(blob);
+ test_smc_failure_admission(blob);
+ return 0;
+}
