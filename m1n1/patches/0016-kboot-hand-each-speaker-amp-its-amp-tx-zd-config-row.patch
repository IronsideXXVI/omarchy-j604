From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>
Date: Thu, 5 Nov 2026 18:18:00 +1100
Subject: [PATCH 16/16] kboot: hand each speaker amp its amp-tx-zd-config row
 from the ADT

An amp group's amp-tx-zd-config has one eight-byte row per amp, in the
group's order: which of the amp's idle sense output slots drive zeros
rather than float, one byte per eight slots. The kernel takes these
from per-board masks in the sound card's DT node today.

Give every amp of the group its own row as apple,amp-tx-zd-config,
with the same rules as apple,speaker-config (a property without a row
for every amp is not passed on and is removed from the group's amps).

Tests: tests/run-kboot-audio.sh, 9 scenarios (new: a six-amp group over
two buses in the order the 14"/16" MacBook Pros list them; the short
scenario now also covers a short amp-tx-zd-config). On the M1 Pro, M2
and M4 Pro ADTs every amp gets its own row; on the M2 the first 16
slots of each row equal the DT's masks.

Assisted-by: LLM
Signed-off-by: Ryan Murray <81541646+RyanTheTide@users.noreply.github.com>

(cherry picked from aurora-silicon/aura commit 9c0839218c0e42573374ab4f77978a98e3c56b6b)
---
 src/kboot_audio.c        | 50 +++++++++++++++++++++------------
 tests/kboot_audio_adt.py | 26 +++++++++++++++--
 tests/kboot_audio_host.c |  6 ++--
 tests/run-kboot-audio.sh | 60 +++++++++++++++++++++++++---------------
 4 files changed, 97 insertions(+), 45 deletions(-)

diff --git a/src/kboot_audio.c b/src/kboot_audio.c
index 2de52d54..730df9d6 100644
--- a/src/kboot_audio.c
+++ b/src/kboot_audio.c
@@ -12,11 +12,13 @@
  *   bop-config            -> apple,bop-config            (the brownout prevention block)
  *   amp-dcblocker-config  -> apple,amp-dcblocker-config  (the DC blocker setting)
  *
- * The group's speaker-config has one four-byte row per amp, in the group's order (the first amp,
- * then speaker1, speaker2, ...); each amp gets its own row as apple,speaker-config. It carries
- * the amp's operating level and its slots.
+ * Two of the group's properties have one row per amp, in the group's order (the first amp, then
+ * speaker1, speaker2, ...); each amp gets its own row:
  *
- * A property the group does not have (or a speaker-config without a row for every amp) is
+ *   speaker-config        -> apple,speaker-config        (4 bytes: operating level and slots)
+ *   amp-tx-zd-config      -> apple,amp-tx-zd-config      (8 bytes: sense output idle slots)
+ *
+ * A property the group does not have (or one without a row for every amp) is
  * removed from its amps, so the kernel never sees a value that did not come from this Mac. Amps
  * are matched to the DT's ti,sn012776 nodes by I2C address, which must name exactly one node. A
  * group with an amp that cannot be matched is left as it is: the kernel gets either the whole
@@ -33,7 +35,6 @@
 #define AMP_ADT_COMPAT "audio-control,sn012776"
 #define AMP_DT_COMPAT  "ti,sn012776"
 #define MAX_GROUP_AMPS 16
-#define SPEAKER_ROW    4
 
 static const struct {
     const char *adt;
@@ -43,6 +44,15 @@ static const struct {
     {"amp-dcblocker-config", "apple,amp-dcblocker-config"},
 };
 
+static const struct {
+    const char *adt;
+    const char *dt;
+    u32 row;
+} amp_row_props[] = {
+    {"speaker-config", "apple,speaker-config", 4},
+    {"amp-tx-zd-config", "apple,amp-tx-zd-config", 8},
+};
+
 /* The I2C address of an ADT amp node: the first word of its reg */
 static int adt_amp_addr(const void *adt, int node, u32 *addr)
 {
@@ -174,19 +184,22 @@ static int setup_amp_group(void *dt, const void *adt, int arm_io, int group)
         }
     }
 
-    /* One speaker-config row per amp, in the group's order */
-    u32 len = 0;
-    const u8 *rows = adt_getprop(adt, group, "speaker-config", &len);
+    /* One row per amp, in the group's order */
+    for (size_t p = 0; p < ARRAY_SIZE(amp_row_props); p++) {
+        u32 len = 0;
+        u32 row = amp_row_props[p].row;
+        const u8 *rows = adt_getprop(adt, group, amp_row_props[p].adt, &len);
 
-    if (rows && len < (u32)n * SPEAKER_ROW) {
-        printf("kboot: audio: %s: speaker-config has %u bytes for %d amps, not passed on\n", name,
-               len, n);
-        rows = NULL;
-    }
-    for (int i = 0; i < n; i++) {
-        if (dt_amp_setprop(dt, addrs[i], "apple,speaker-config",
-                           rows ? rows + i * SPEAKER_ROW : NULL, SPEAKER_ROW))
-            return -1;
+        if (rows && len < (u32)n * row) {
+            printf("kboot: audio: %s: %s has %u bytes for %d amps, not passed on\n", name,
+                   amp_row_props[p].adt, len, n);
+            rows = NULL;
+        }
+        for (int i = 0; i < n; i++) {
+            if (dt_amp_setprop(dt, addrs[i], amp_row_props[p].dt, rows ? rows + i * row : NULL,
+                               row))
+                return -1;
+        }
     }
 
     printf("kboot: audio: %s: amp configuration for %d amps\n", name, n);
@@ -213,7 +226,8 @@ int kboot_audio_amp_config(void *dt, const void *adt)
             if (!adt_getprop(adt, dev, "speaker1", NULL) &&
                 !adt_getprop(adt, dev, "bop-config", NULL) &&
                 !adt_getprop(adt, dev, "amp-dcblocker-config", NULL) &&
-                !adt_getprop(adt, dev, "speaker-config", NULL))
+                !adt_getprop(adt, dev, "speaker-config", NULL) &&
+                !adt_getprop(adt, dev, "amp-tx-zd-config", NULL))
                 continue;
             setup_amp_group(dt, adt, arm_io, dev);
         }
diff --git a/tests/kboot_audio_adt.py b/tests/kboot_audio_adt.py
index 3d6332fc..16e64431 100644
--- a/tests/kboot_audio_adt.py
+++ b/tests/kboot_audio_adt.py
@@ -20,6 +20,8 @@ BOP = bytes(range(0xA0, 0xA0 + 24))
 DCB = bytes([0x5A, 0x01, 0x00, 0x00])
 # One four-byte row per amp of a three-amp group, in the group's order
 ROWS = bytes([0xC0, 0xC1, 0xC2, 0xC3, 0xD0, 0xD1, 0xD2, 0xD3, 0xE0, 0xE1, 0xE2, 0xE3])
+# One eight-byte row per amp
+ZD = bytes(range(0x10, 0x28))
 
 
 def u32(v):
@@ -84,9 +86,13 @@ def dts(amps, stale=None):
 
 
 GROUP3 = {"bop-config": BOP, "amp-dcblocker-config": DCB, "speaker-config": ROWS,
-          "speaker1": u32(0x11), "speaker2": u32(0x12)}
+          "amp-tx-zd-config": ZD, "speaker1": u32(0x11), "speaker2": u32(0x12)}
 STALE = {"apple,amp-dcblocker-config": b"\xee\xee", "apple,bop-config": b"\xee",
-         "apple,speaker-config": b"\xee\xee\xee\xee"}
+         "apple,speaker-config": b"\xee\xee\xee\xee", "apple,amp-tx-zd-config": b"\xee" * 8}
+# Six amps over two buses, as the 14"/16" MacBook Pros have them: the first amp and speaker1..5
+SIX = [(0, 0x38), (0, 0x39), (0, 0x3a), (1, 0x3b), (1, 0x3c), (1, 0x3d)]
+ROWS6 = bytes(b for i in range(6) for b in (0x60 + i, 0x70 + i, 0x80 + i, 0x90 + i))
+ZD6 = bytes(range(0x30, 0x30 + 48))
 
 
 def scenario(name):
@@ -104,9 +110,23 @@ def scenario(name):
                                     amp("audio-speaker-b", 0x42, 0x12)]),
                  Node("i2c1", {}, [amp("audio-speaker-a", 0x41, 0x11)])]
         return adt(buses), dts(three, {(1, 0x41): STALE})
+    if name == "six-amps":
+        # group order: 0x38, then 0x3b, 0x39, 0x3c, 0x3a, 0x3d (speaker1..5), as on those Macs
+        order = [0x38, 0x3b, 0x39, 0x3c, 0x3a, 0x3d]
+        g = {"bop-config": BOP, "amp-dcblocker-config": DCB, "speaker-config": ROWS6,
+             "amp-tx-zd-config": ZD6}
+        for k, a in enumerate(order[1:], 1):
+            g["speaker%d" % k] = u32(0x20 + k)
+        nodes = {0: [], 1: []}
+        for k, a in enumerate(order):
+            bus = 0 if a <= 0x3a else 1
+            nodes[bus].append(amp("audio-speaker" if k == 0 else "audio-speaker-%d" % k, a,
+                                  0x20 + k, g if k == 0 else None))
+        return adt([Node("i2c0", {}, nodes[0]), Node("i2c1", {}, nodes[1])]), dts(SIX)
     if name == "short-speaker-config":
         g = dict(GROUP3)
         g["speaker-config"] = ROWS[:8]
+        g["amp-tx-zd-config"] = ZD[:16]
         buses = [Node("i2c0", {}, [amp("audio-speaker", 0x40, 0x10, g),
                                     amp("audio-speaker-b", 0x42, 0x12)]),
                  Node("i2c1", {}, [amp("audio-speaker-a", 0x41, 0x11)])]
@@ -130,7 +150,7 @@ def scenario(name):
     raise SystemExit("unknown scenario %s" % name)
 
 
-SCENARIOS = ["group", "no-dcblocker", "short-speaker-config", "single-amp", "amp-missing-in-dt", "amp-not-unique-in-dt",
+SCENARIOS = ["group", "no-dcblocker", "six-amps", "short-speaker-config", "single-amp", "amp-missing-in-dt", "amp-not-unique-in-dt",
              "dangling-phandle", "no-amps"]
 
 
diff --git a/tests/kboot_audio_host.c b/tests/kboot_audio_host.c
index b1844729..c65be8a6 100644
--- a/tests/kboot_audio_host.c
+++ b/tests/kboot_audio_host.c
@@ -6,8 +6,9 @@
  *   kboot-audio-host <in.adt> <in.dtb>
  *
  * Runs kboot_audio_amp_config() and prints, for every ti,sn012776 node of the result in tree
- * order, its I2C address and its apple,bop-config, apple,amp-dcblocker-config and
- * apple,speaker-config ("-" when absent), one line each ("amp ..."), after aura's own log lines.
+ * order, its I2C address and its apple,bop-config, apple,amp-dcblocker-config,
+ * apple,speaker-config and apple,amp-tx-zd-config ("-" when absent), one line each ("amp ..."),
+ * after aura's own log lines.
  */
 #include <stdio.h>
 #include <stdlib.h>
@@ -95,6 +96,7 @@ int main(int argc, char **argv)
         print_prop(dt, node, "apple,bop-config");
         print_prop(dt, node, "apple,amp-dcblocker-config");
         print_prop(dt, node, "apple,speaker-config");
+        print_prop(dt, node, "apple,amp-tx-zd-config");
         printf("\n");
     }
     return 0;
diff --git a/tests/run-kboot-audio.sh b/tests/run-kboot-audio.sh
index 0f4f35b7..fa79b559 100644
--- a/tests/run-kboot-audio.sh
+++ b/tests/run-kboot-audio.sh
@@ -61,37 +61,53 @@ R0=c0c1c2c3
 R1=d0d1d2d3
 R2=e0e1e2e3
 STALE_ROW=eeeeeeee
-amp() { # amp <addr> <bop> <dcb> <row>
-    printf 'amp 0x%s apple,bop-config=%s apple,amp-dcblocker-config=%s apple,speaker-config=%s\n' "$@"
+STALE_ZD=eeeeeeeeeeeeeeee
+Z0=1011121314151617
+Z1=18191a1b1c1d1e1f
+Z2=2021222324252627
+amp() { # amp <addr> <bop> <dcb> <row> <zd row>
+    printf 'amp 0x%s apple,bop-config=%s apple,amp-dcblocker-config=%s apple,speaker-config=%s apple,amp-tx-zd-config=%s\n' "$@"
+}
+six() { # six <addr> <group index>: an amp of the six-amps group
+    i=$2
+    amp $1 $BOP $DCB "$(printf '%02x%02x%02x%02x' $((0x60 + i)) $((0x70 + i)) $((0x80 + i)) $((0x90 + i)))" \
+        "$(printf '%02x' $(seq $((0x30 + 8 * i)) $((0x37 + 8 * i))) | tr -d '\n')"
 }
 expect() { # expect <scenario>: the amp lines that scenario must give (tree order 0x40, 0x42, 0x41)
     case $1 in
     group)
-        amp 40 $BOP $DCB $R0
-        amp 42 $BOP $DCB $R2
-        amp 41 $BOP $DCB $R1 ;;
-    no-dcblocker)
-        amp 40 $BOP - $R0
-        amp 42 $BOP - $R2
-        amp 41 $BOP - $R1 ;;
+        amp 40 $BOP $DCB $R0 $Z0
+        amp 42 $BOP $DCB $R2 $Z2
+        amp 41 $BOP $DCB $R1 $Z1 ;;
+    no-dcblocker) # as on the 14"/16" M1 Pro/Max, whose ADT has no DC blocker setting
+        amp 40 $BOP - $R0 $Z0
+        amp 42 $BOP - $R2 $Z2
+        amp 41 $BOP - $R1 $Z1 ;;
+    six-amps) # tree order 0x38..0x3d; group order 0x38 0x3b 0x39 0x3c 0x3a 0x3d
+        six 38 0
+        six 39 2
+        six 3a 4
+        six 3b 1
+        six 3c 3
+        six 3d 5 ;;
     short-speaker-config)
-        amp 40 $BOP $DCB -
-        amp 42 $BOP $DCB -
-        amp 41 $BOP $DCB - ;;
+        amp 40 $BOP $DCB - -
+        amp 42 $BOP $DCB - -
+        amp 41 $BOP $DCB - - ;;
     single-amp)
-        amp 40 $BOP - - ;;
+        amp 40 $BOP - - - ;;
     amp-missing-in-dt)
-        amp 40 - - -
-        amp 42 $STALE_BOP $STALE_DCB $STALE_ROW ;;
+        amp 40 - - - -
+        amp 42 $STALE_BOP $STALE_DCB $STALE_ROW $STALE_ZD ;;
     amp-not-unique-in-dt)
-        amp 40 - - -
-        amp 42 - - -
-        amp 41 - - -
-        amp 42 - - - ;;
+        amp 40 - - - -
+        amp 42 - - - -
+        amp 41 - - - -
+        amp 42 - - - - ;;
     dangling-phandle|no-amps)
-        amp 40 - - -
-        amp 42 - - -
-        amp 41 $STALE_BOP $STALE_DCB $STALE_ROW ;;
+        amp 40 - - - -
+        amp 42 - - - -
+        amp 41 $STALE_BOP $STALE_DCB $STALE_ROW $STALE_ZD ;;
     *) fail "no expected result for $1" ;;
     esac
 }
