+/* A plain SMC GPIO output rail (ADT pKW4 template 0) is the OS's on any admitted
+ * board: no SMC write and no DART bypass for its port. The endpoint does not matter. */
+static void add_os_rail_port(void *dt, u32 line, u32 flags, const char *compatible)
+{
+ int host = fdt_path_offset(dt, "/pcie");
+ fdt32_t map[] = {cpu_to_fdt32(0x100), cpu_to_fdt32(2), cpu_to_fdt32(16), cpu_to_fdt32(1),
+                  cpu_to_fdt32(0x200), cpu_to_fdt32(2), cpu_to_fdt32(1), cpu_to_fdt32(1)};
+ assert(!fdt_setprop(dt, host, "iommu-map", map, sizeof(map)));
+ int port = fdt_add_subnode(dt, host, "sdport");
+ fdt32_t pwren[] = {cpu_to_fdt32(3), cpu_to_fdt32(line), cpu_to_fdt32(flags)};
+ assert(port >= 0 && !fdt_setprop(dt, port, "pwren-gpios", pwren, sizeof(pwren)));
+ int ep = fdt_add_subnode(dt, port, "endpoint");
+ assert(ep >= 0);
