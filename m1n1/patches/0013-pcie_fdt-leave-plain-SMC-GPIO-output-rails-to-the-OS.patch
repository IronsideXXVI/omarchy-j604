index 14cad14b..020f56ba 100644
--- a/tests/python/test_m4_pcie_power_fdt.py
+++ b/tests/python/test_m4_pcie_power_fdt.py
@@ -1,18 +1,122 @@
 # SPDX-License-Identifier: GPL-2.0-only OR MIT
 """PCIe handoff keeps OS ownership and requires the native J713 gP13 action."""
 from pathlib import Path
+import struct
 import subprocess
 
 
+def adt_blob(node):
+    """Serialize (name, [(prop, bytes)], [children]) in the ADT layout m1n1 reads."""
+    name, props, children = node
+    props = [("name", name.encode() + b"\0")] + props
+    out = struct.pack("<II", len(props), len(children))
+    for key, value in props:
+        out += key.encode().ljust(32, b"\0") + struct.pack("<I", len(value)) + value
+        out += b"\0" * (-len(value) % 4)
+    for child in children:
+        out += adt_blob(child)
+    return out
+
+
+PKW4 = 0x704B5734  # "pKW4" as the ADT stores it
+PMU_PHANDLE = 0x10D  # J604 26B123 smc-pmu AAPL,phandle
+
+
+def smc_function(key, arg, phandle=PMU_PHANDLE):
+    return struct.pack("<IIII", phandle, PKW4, key, arg)
+
+
+def j604_adt(sd_pwr_en=(0x67503139, 0), helper=(0x67503139, 0), phandle=PMU_PHANDLE):
+    """The J604 ADT's SMC GPIO functions (26B123 template and 27.2 runtime ADT):
+    amfm function-reg_on = pKW4(gP13, 0x00800000); apcie pci-bridge2
+    pcie-sdreader and pcie-sdreader-helper function-sd_pwr_en = pKW4(gP19, 0)."""
+    sd = [("function-sd_pwr_en", smc_function(*sd_pwr_en, phandle))] if sd_pwr_en else []
+    hp = [("function-sd_pwr_en", smc_function(*helper, phandle))] if helper else []
+    pmu = ("smc-pmu", [("AAPL,phandle", struct.pack("<I", PMU_PHANDLE))], [])
+    return adt_blob(("device-tree", [], [
+        ("amfm", [("function-reg_on", smc_function(0x67503133, 0x00800000))], []),
+        ("arm-io", [], [
+            ("smc", [], [("iop-smc-nub", [], [pmu])]),
+            ("apcie", [], [("pci-bridge2", [], [("pcie-sdreader", sd, [])])]),
+        ]),
+        ("pcie-sdreader-helper", hp, []),
+    ]))
+
+
+def c_array(name, blob):
+    return "static const unsigned char %s[] __attribute__((aligned(4))) = {%s};\n" % (
+        name, ",".join(str(b) for b in blob))
+
+ADT_MODEL = r"""
+void *adt;
+static u32 adt_u32(const void *a, int off) { u32 v; memcpy(&v, (const u8 *)a + off, 4); return v; }
+static int adt_prop_end(const void *a, int off)
+{ return off + 36 + ((adt_u32(a, off + 32) & 0x7fffffff) + 3) / 4 * 4; }
+int adt_get_property_count(const void *a, int node) { return adt_u32(a, node); }
+int adt_get_child_count(const void *a, int node) { return adt_u32(a, node + 4); }
+int adt_first_property_offset(const void *a, int node) { return node + 8; }
+int adt_next_property_offset(const void *a, int off) { return adt_prop_end(a, off); }
+int adt_first_child_offset(const void *a, int node)
+{
+ int off = node + 8;
+ for (u32 i = 0; i < adt_u32(a, node); i++) off = adt_prop_end(a, off);
+ return off;
+}
+int adt_next_sibling_offset(const void *a, int node)
+{
+ int off = adt_first_child_offset(a, node);
+ for (u32 i = 0; i < adt_u32(a, node + 4); i++) off = adt_next_sibling_offset(a, off);
+ return off;
+}
+static const struct adt_property *adt_find(const void *a, int node, const char *name)
+{
+ int off = node + 8;
+ for (u32 i = 0; i < adt_u32(a, node); i++, off = adt_prop_end(a, off))
+  if (!strcmp(ADT_PROP(a, off)->name, name)) return ADT_PROP(a, off);
+ return NULL;
+}
+int adt_getprop_copy(const void *a, int node, const char *name, void *out, size_t len)
+{
+ const struct adt_property *p = adt_find(a, node, name);
+ if (!p || p->size != len) return -1;
+ memcpy(out, p->value, len); return len;
+}
+int adt_path_offset(const void *a, const char *path)
+{
+ int node = 0;
+ while (*path == '/') {
+  const char *s = ++path; size_t n = strcspn(s, "/"); path += n;
+  int child = adt_first_child_offset(a, node), found = -1;
+  for (u32 i = 0; i < adt_u32(a, node + 4); i++, child = adt_next_sibling_offset(a, child)) {
+   const struct adt_property *p = adt_find(a, child, "name");
+   if (p && strlen((const char *)p->value) == n && !strncmp((const char *)p->value, s, n)) { found = child; break; }
+  }
+  if (found < 0) return -1;
+  node = found;
+ }
+ return node;
+}
+"""
+
+
 def test_j713_pcie_power_contract(tmp_path):
     repo = Path(__file__).resolve().parents[2]
     text = (repo / "src/pcie_fdt.c").read_text()
