-    key |= (u32)pcie_hex_digit(line >> 4) << 8;
-    key |= pcie_hex_digit(line & 0xf);
+    u32 key = pcie_smc_gpio_key(line);
 
     smc_dev_t *smc = smc_init();
     if (!smc)
@@ -206,30 +307,44 @@ static int pcie_fdt_enable_pwren(void *dt, int port)
 
