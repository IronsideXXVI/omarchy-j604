+
+/*
+ * Port rails come in two kinds. The radio's REG_ON is a qualified SMC action:
+ * this handoff applies it itself before Linux adopts the live link and its
+ * DART stream. Every other rail must be one the ADT describes as a plain SMC
+ * GPIO output, a pKW4 function of the SMC PMU with a zero template (on the
+ * J604, apcie pcie-sdreader function-sd_pwr_en = pKW4(gP19, 0)). Such a rail
+ * is the OS's: pcie-apple drives it through pwren-gpios before it trains the
+ * port, as on the other Apple SoCs (the t600x/t602x SD reader ports, the
+ * T8132 J773g radio), so this handoff neither powers that port nor bypasses
+ * its DART stream. A rail the ADT does not describe, or describes with a
+ * template, or wires active-low, stays refused.
+ */
+enum pcie_rail {
+    PCIE_RAIL_NONE,
+    PCIE_RAIL_QUALIFIED,
+    PCIE_RAIL_OS,
+};
+
+#define PCIE_ADT_SMC_PMU     "/arm-io/smc/iop-smc-nub/smc-pmu"
+#define PCIE_ADT_FOURCC_PKW4 0x704b5734 /* "pKW4" */
+#define PCIE_ADT_MAX_DEPTH   32
+
+struct pcie_adt_smc_function {
+    u32 phandle;
+    u32 fourcc;
+    u32 key;
+    u32 arg;
+};
+
+/* Count the ADT's pKW4 functions for key; any that is not a plain output of
+ * the SMC PMU refuses the rail. */
+static int pcie_adt_plain_smc_outputs(int node, u32 pmu, u32 key, int depth)
+{
+    int plain = 0;
+
+    if (depth > PCIE_ADT_MAX_DEPTH)
+        return -1;
+
+    ADT_FOREACH_PROPERTY(adt, node, prop)
+    {
+        struct pcie_adt_smc_function f;
+
+        if (strncmp(prop->name, "function-", 9) || prop->size != sizeof(f))
+            continue;
+        memcpy(&f, prop->value, sizeof(f));
+        if (f.fourcc != PCIE_ADT_FOURCC_PKW4 || f.key != key)
+            continue;
+        if (f.phandle != pmu || f.arg)
+            return -1;
+        plain++;
+    }
+
+    int child = node;
+    ADT_FOREACH_CHILD(adt, child)
+    {
+        int ret = pcie_adt_plain_smc_outputs(child, pmu, key, depth + 1);
+        if (ret < 0)
+            return -1;
+        plain += ret;
+    }
+
+    return plain;
+}
+
+static bool pcie_adt_rail_is_plain_output(u32 line)
+{
+    u32 pmu;
+
+    if (!adt)
+        return false;
+    int node = adt_path_offset(adt, PCIE_ADT_SMC_PMU);
+    if (node < 0 || adt_getprop_copy(adt, node, "AAPL,phandle", &pmu, sizeof(pmu)) < 0)
+        return false;
+
+    return pcie_adt_plain_smc_outputs(0, pmu, pcie_smc_gpio_key(line), 0) > 0;
+}
+
+static int pcie_fdt_port_rail(void *dt, int port, u32 *line_out)
 {
     int len;
     const fdt32_t *pwren = fdt_getprop(dt, port, "pwren-gpios", &len);
     if (!pwren)
-        return 0;
+        return len == -FDT_ERR_NOTFOUND ? PCIE_RAIL_NONE : -1;
     if (len != 3 * (int)sizeof(*pwren)) {
         printf("pcie: invalid pwren-gpios on %s\n", fdt_get_name(dt, port, NULL));
         return -1;
     }
 
     int gpio = fdt_node_offset_by_phandle(dt, fdt32_ld(&pwren[0]));
-    if (gpio < 0)
+    if (gpio < 0 || fdt_node_check_compatible(dt, gpio, "apple,smc-gpio"))
+        return -1;
+
+    u32 line = fdt32_ld(&pwren[1]);
+    u32 flags = fdt32_ld(&pwren[2]);
+    if (line > 0xff || flags)
         return -1;
+    *line_out = line;
 
     /* Only the upper-case gP13 action of the admitted boards has a qualified
      * template (J713; J604 has the same amfm reg_on, see docs/j604.md).
-     * A generic GPIO output command is not known to be equivalent. */
-    if (!t8132_board_admitted(dt, T8132_PATH_PCIE_RADIO) ||
-        fdt_node_check_compatible(dt, gpio, "apple,smc-gpio"))
-        return -1;
-    u32 key = 0x67500000; /* gP00 */
+     * A generic GPIO output command is not known to be equivalent, so this
+     * rail is never left to the OS. */
+    if (line == SMC_J713_RADIO_REG_ON_LINE)
+        return t8132_board_admitted(dt, T8132_PATH_PCIE_RADIO) ? PCIE_RAIL_QUALIFIED : -1;
 
-    u32 line = fdt32_ld(&pwren[1]);
-    u32 flags = fdt32_ld(&pwren[2]);
-    if (line != 0x13 || flags)
+    return pcie_adt_rail_is_plain_output(line) ? PCIE_RAIL_OS : -1;
+}
