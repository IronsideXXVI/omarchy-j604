 src/t8132_board.h                           |  14 +-
 tests/python/test_t8132_aop_handoff_gate.py | 156 ++++++++++++++++++++
 tests/python/test_t8132_board_admission.py  |   4 +-
 4 files changed, 166 insertions(+), 12 deletions(-)
 create mode 100644 tests/python/test_t8132_aop_handoff_gate.py

