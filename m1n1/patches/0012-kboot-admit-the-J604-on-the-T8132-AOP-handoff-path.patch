diff --git a/tests/python/test_t8132_aop_handoff_gate.py b/tests/python/test_t8132_aop_handoff_gate.py
new file mode 100644
index 00000000..b8b84458
--- /dev/null
+++ b/tests/python/test_t8132_aop_handoff_gate.py
@@ -0,0 +1,156 @@
+# SPDX-License-Identifier: MIT
+"""Run kboot's T8132 AOP handoff gate (dt_set_aop_firmware, dt_set_t8132_aop) per board.
+
+The production functions are cut out of src/kboot.c and run against real
+libfdt trees. The hardware steps they call (ASC state, the DAPF writer, the
+segment and window reservations) are stubs that count their calls, so the
+test checks the gate: which board and /chosen request reach the handoff, and
+that every refusal disables the AOP before any hardware step that follows it.
+"""
+
+from pathlib import Path
+import subprocess
+
+from test_j713_dapf_instance import block
+
+PREFIX = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "libfdt.h"
+typedef uint32_t u32;
+typedef unsigned long u64;
+#define T8132 0x8132
+#define T8140 0x8140
+#define bail(...) do { printf(__VA_ARGS__); return -1; } while (0)
+static int chip_id = T8132;
+static void *dt;
+typedef struct asc_dev asc_dev_t;
+struct asc_dev { int unused; };
+static struct asc_dev the_asc;
+static bool asc_ok, cpu_running;
+static int dapf_ret, seg_ret, win_ret;
+static unsigned asc_calls, dapf_calls, seg_calls, win_calls;
+static asc_dev_t *asc_init(const char *path)
+{ assert(!strcmp(path, "/arm-io/aop")); asc_calls++; return asc_ok ? &the_asc : NULL; }
+static bool asc_cpu_running(asc_dev_t *asc) { assert(asc == &the_asc); return cpu_running; }
+static void asc_free(asc_dev_t *asc) { assert(asc == &the_asc); }
+static int dapf_init_t8132_halted(const char *path, int index)
+{ assert(!strcmp(path, "/arm-io/dart-aop") && index == 1); dapf_calls++; return dapf_ret; }
+static int dt_reserve_asc_segments(const char *adt_path, const char *adt_path_alt,
+                                   const char *fdt_path, bool remap, u64 base, bool dram_only)
+{
+    assert(!strcmp(adt_path, "/arm-io/aop/iop-aop-nub") && !adt_path_alt);
+    assert(!strcmp(fdt_path, "/soc/aop@390600000") && remap && !base && dram_only);
+    seg_calls++; return seg_ret;
+}
+static int dt_reserve_t8132_aop_windows(const char *path)
+{ assert(!strcmp(path, "/soc/aop@390600000")); win_calls++; return win_ret; }
+'''
+
+TESTS = r'''
+static char tree[8192];
+/* A kernel DT: the board compatible, /chosen with the requested handoffs (a
+ * NUL-separated list, or none) and an AOP node with the given status. */
+static void make(const char *compatible, int clen, const char *request, int rlen, const char *status)
+{
+    int soc, aop, chosen;
+    assert(!fdt_create_empty_tree(tree, sizeof(tree)));
+    assert(!fdt_setprop(tree, 0, "compatible", compatible, clen));
+    chosen = fdt_add_subnode(tree, 0, "chosen");
+    assert(chosen >= 0);
+    if (request)
+        assert(!fdt_setprop(tree, chosen, "linux-enablement-mac,dapf-handoff", request, rlen));
+    soc = fdt_add_subnode(tree, 0, "soc");
+    assert(soc >= 0);
+    aop = fdt_add_subnode(tree, soc, "aop@390600000");
+    assert(aop >= 0);
+    assert(!fdt_setprop_string(tree, aop, "compatible", "apple,t8132-aop"));
+    if (status)
+        assert(!fdt_setprop_string(tree, aop, "status", status));
+    assert(!fdt_setprop_u32(tree, aop, "phandle", 7));
+    dt = tree;
+    chip_id = T8132; asc_ok = true; cpu_running = false;
+    dapf_ret = seg_ret = win_ret = 0;
+    asc_calls = dapf_calls = seg_calls = win_calls = 0;
+}
+static const char *status(void)
+{
+    const char *s = fdt_getprop(dt, fdt_path_offset(dt, "/soc/aop@390600000"), "status", NULL);
+    return s ? s : "(none)";
+}
+static void calls(unsigned a, unsigned d, unsigned s, unsigned w)
+{ assert(asc_calls == a && dapf_calls == d && seg_calls == s && win_calls == w); }
+
+static const char J604[] = "apple,j604\0apple,t8132\0apple,arm-platform";
+static const char J713[] = "apple,j713\0apple,t8132\0apple,arm-platform";
+static const char J715[] = "apple,j715\0apple,t8132\0apple,arm-platform";
+static const char AOP_MTP[] = "/arm-io/aop\0/arm-io/mtp";
+static const char MTP[] = "/arm-io/mtp";
+
+static void admitted(const char *board, int blen)
+{
+    /* Requested, halted, every step succeeds: handed over, left enabled. */
+    make(board, blen, AOP_MTP, sizeof(AOP_MTP), "okay");
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "okay")); calls(1, 1, 1, 1);
+    make(board, blen, AOP_MTP, sizeof(AOP_MTP), NULL);
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "(none)")); calls(1, 1, 1, 1);
+    /* Not requested: disabled before the ASC is touched. */
+    make(board, blen, NULL, 0, "okay");
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "disabled")); calls(0, 0, 0, 0);
+    make(board, blen, MTP, sizeof(MTP), "okay");
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "disabled")); calls(0, 0, 0, 0);
+    /* Each failing step disables the AOP and stops the steps after it. */
+    make(board, blen, AOP_MTP, sizeof(AOP_MTP), "okay"); asc_ok = false;
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "disabled")); calls(1, 0, 0, 0);
+    make(board, blen, AOP_MTP, sizeof(AOP_MTP), "okay"); cpu_running = true;
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "disabled")); calls(1, 0, 0, 0);
+    make(board, blen, AOP_MTP, sizeof(AOP_MTP), "okay"); dapf_ret = -1;
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "disabled")); calls(1, 1, 0, 0);
+    make(board, blen, AOP_MTP, sizeof(AOP_MTP), "okay"); seg_ret = -1;
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "disabled")); calls(1, 1, 1, 0);
+    make(board, blen, AOP_MTP, sizeof(AOP_MTP), "okay"); win_ret = -1;
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "disabled")); calls(1, 1, 1, 1);
+    /* A disabled AOP node, or another SoC, is left alone. */
+    make(board, blen, AOP_MTP, sizeof(AOP_MTP), "disabled");
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "disabled")); calls(0, 0, 0, 0);
+    make(board, blen, AOP_MTP, sizeof(AOP_MTP), "okay"); chip_id = T8140;
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "okay")); calls(0, 0, 0, 0);
+}
+
+int main(void)
+{
+    admitted(J604, sizeof(J604));
+    admitted(J713, sizeof(J713));
+    /* An unqualified T8132 board: neither handed over nor disabled, requested or not. */
+    make(J715, sizeof(J715), AOP_MTP, sizeof(AOP_MTP), "okay");
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "okay")); calls(0, 0, 0, 0);
+    make(J715, sizeof(J715), NULL, 0, "okay");
+    assert(!dt_set_aop_firmware() && !strcmp(status(), "okay")); calls(0, 0, 0, 0);
+    puts("T8132 AOP handoff gate: J604 and J713 admitted, J715 skipped, every refusal disables");
+    return 0;
+}
+'''
+
+
+def test_t8132_aop_handoff_gate(tmp_path):
+    repo = Path(__file__).resolve().parents[2]
+    kboot = (repo / "src/kboot.c").read_text()
+    production = (block(kboot, "static int dt_set_t8132_aop(const char *path)") + "\n" +
+                  block(kboot, "static int dt_set_aop_firmware(void)") + "\n")
+    board = "\n".join(line for line in (repo / "src/t8132_board.h").read_text().splitlines()
+                      if not line.startswith("#include"))
+    source = tmp_path / "aop-gate.c"
+    binary = tmp_path / "aop-gate"
+    source.write_text(PREFIX + board + "\n" + production + TESTS)
+    libfdt = repo / "src/libfdt"
+    sources = [libfdt / (n + ".c") for n in ("fdt", "fdt_ro", "fdt_rw", "fdt_sw", "fdt_wip",
+                                             "fdt_empty_tree", "fdt_check", "fdt_strerror",
+                                             "fdt_addresses")]
+    subprocess.run(["cc", "-D_GNU_SOURCE", "-std=gnu11", "-Wall", "-Wextra", "-Werror",
+                    "-Wno-unused-parameter", "-Wno-unused-function", "-I", str(libfdt),
+                    str(source), *map(str, sources), "-o", str(binary)], check=True)
+    result = subprocess.run([str(binary)], check=True, capture_output=True, text=True)
+    assert "J604 and J713 admitted" in result.stdout
diff --git a/tests/python/test_t8132_board_admission.py b/tests/python/test_t8132_board_admission.py
index 5fde1b82..6c22af47 100644
--- a/tests/python/test_t8132_board_admission.py
+++ b/tests/python/test_t8132_board_admission.py
@@ -33,10 +33,10 @@ int main(void)
     }
     assert(all == T8132_PATHS_ALL);
 
-    /* J604: every path but the AOP handoff (see docs/j604.md). */
+    /* J604: every path, the AOP handoff included (see docs/j604.md). */
     TREE(dt, "apple,j604\0apple,t8132\0apple,arm-platform");
     for (int p = 0; p < T8132_PATH_COUNT; p++)
-        assert(t8132_board_admitted(dt, p) == (p != T8132_PATH_AOP));
+        assert(t8132_board_admitted(dt, p));
 
     /* Other T8132 boards, and look-alike names, are admitted nowhere. */
     const char *others[] = {"apple,j715", "apple,j604x", "apple,j60", "apple,t8132"};
