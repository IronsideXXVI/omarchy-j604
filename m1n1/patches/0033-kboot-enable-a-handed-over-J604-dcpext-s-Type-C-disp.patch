From c0e48c66f4bc88d3bdc50e1be4ccdac08db2278e Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 19:15:16 +0000
Subject: [PATCH] kboot: enable a handed-over J604 dcpext's Type-C display
 routes

The J604 kernel tree keeps each dcpext's typec-routes disabled, because a
USB-C port controller waits for every available route's mode switch. They
were to be enabled for a dcpext the boot loader hands over, but
dt_enable_j604_dcpext_one() enabled the dcpext, its mailbox, its DARTs and
its domains only. No route was ever available, so no USB-C port could get
an external display: neither a Thunderbolt/USB4 DP tunnel nor DP Alt Mode.

Enable the routes the tree describes as "disabled" in the same display
transaction, after the dcpext and its domains: a route with any other
status is left as it is, a dcpext without routes is enabled as before, and
a dcpext that is not enabled (no marker, a domain that is not
firmware-owned, any failure inside the transaction) keeps its routes
disabled, so the port controllers never wait for it. Once adopted, the
kernel registers the routes, and disables them again in the live tree if
it cannot (dcp_typec_routes_disable()).

Host test (test_j604_dcpext_enable.py): routes come with their dcpext and
only with it, a "reserved" route is left alone, a dcpext without routes is
enabled as before, a failed dcpext's routes stay off, the J713 is never
touched.

[j604: X2-01 (BOARD-SWEEP-1838 row X2), for the m1n1 packager; patch
 number after 0033.]

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 src/kboot.c                             | 39 ++++++++++++++++++-
 tests/python/test_j604_dcpext_enable.py | 51 +++++++++++++++++++++++++
 2 files changed, 88 insertions(+), 2 deletions(-)

diff --git a/src/kboot.c b/src/kboot.c
index 92ea922e..d865aeed 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -3225,10 +3225,43 @@ static int dt_enable_dcpext_ref(const char *path, const char *prop)
     return target < 0 ? -1 : dt_enable_dcpext_domains(target, 0);
 }
 
+/*
+ * The Type-C display routes of a handed-over dcpext: each route the tree describes as
+ * "disabled" is enabled. A route with any other status (reserved, failed, malformed) is left as
+ * it is, and a dcpext without routes has nothing to enable. The kernel tree keeps the routes
+ * disabled because a USB-C port controller waits for every available route's mode switch; the
+ * dcpext registers them once it is adopted, and disables them again in the live tree if it
+ * cannot.
+ */
+static int dt_enable_dcpext_routes(const char *alias)
+{
+    int node = fdt_path_offset(dt, alias);
+    int routes = node < 0 ? node : fdt_subnode_offset(dt, node, "typec-routes");
+    int route;
+
+    if (routes == -FDT_ERR_NOTFOUND)
+        return 0;
+    if (routes < 0)
+        return -1;
+    fdt_for_each_subnode(route, dt, routes)
+    {
+        int len = 0;
+        const char *status = fdt_getprop(dt, route, "status", &len);
+
+        if (!status || len != sizeof("disabled") || memcmp(status, "disabled", len))
+            continue;
+        /* Only what follows this route moves; the walk goes on from its offset. */
+        if (fdt_setprop_string(dt, route, "status", "okay"))
+            return -1;
+    }
+    return route == -FDT_ERR_NOTFOUND ? 0 : -1;
+}
+
 /*
  * A handed-over dcpext (marker set by dt_reserve_j713_dcpext()): enable its mailbox, its
  * firmware DART, its display DART (named by its piodma child, which stays disabled: the kernel
- * enables PIODMA at runtime) and the dcpext itself, each with its firmware-owned PMGR domains.
+ * enables PIODMA at runtime) and the dcpext itself, each with its firmware-owned PMGR domains,
+ * and its Type-C display routes (dt_enable_dcpext_routes()).
  */
 static int dt_enable_j604_dcpext_one(unsigned int n)
 {
@@ -3249,7 +3282,9 @@ static int dt_enable_j604_dcpext_one(unsigned int n)
     if (node < 0 || dt_enable_dcpext_one_node(node))
         return -1;
     node = fdt_path_offset(dt, alias);
-    return node < 0 ? -1 : dt_enable_dcpext_domains(node, 0);
+    if (node < 0 || dt_enable_dcpext_domains(node, 0))
+        return -1;
+    return dt_enable_dcpext_routes(alias);
 }
 
 static void dt_enable_j604_dcpext(void)
diff --git a/tests/python/test_j604_dcpext_enable.py b/tests/python/test_j604_dcpext_enable.py
index 86997a69..c7c06c5d 100644
--- a/tests/python/test_j604_dcpext_enable.py
+++ b/tests/python/test_j604_dcpext_enable.py
@@ -24,6 +24,7 @@ def test_j604_dcpext_enable(tmp_path):
         function("dt_enable_dcpext_one_node", "static int "),
         function("dt_enable_dcpext_domains", "static int "),
         function("dt_enable_dcpext_ref", "static int "),
+        function("dt_enable_dcpext_routes", "static int "),
         function("dt_enable_j604_dcpext_one", "static int "),
         function("dt_enable_j604_dcpext", "static void "),
     ])
@@ -40,6 +41,7 @@ def test_j604_dcpext_enable(tmp_path):
 static void *dt;
 ''' + board + "\n" + code + r'''
 static char buf[16384];
+static bool okay(const char *path);
 
 static int sub(int parent, const char *name, uint32_t phandle, bool disabled)
 {
@@ -111,9 +113,31 @@ static void tree(const char *compatible, int len, bool owned_cpu1)
         snprintf(q, sizeof(q), "%s/piodma", p);
         uint32_t pio[2] = {cpu_to_fdt32(b + 6), cpu_to_fdt32(16)};
         assert(!fdt_setprop(dt, at(q), "iommus", pio, sizeof(pio)));
+        /* Its three Type-C routes, disabled as in the kernel tree. */
+        sub(at(p), "typec-routes", 0, false);
+        snprintf(q, sizeof(q), "%s/typec-routes", p);
+        for (int r = 0; r < 3; r++) {
+            char name[16];
+            snprintf(name, sizeof(name), "route@%d", r);
+            sub(at(q), name, 0, true);
+        }
     }
 }
 
+static bool route_okay(int dcp, int r)
+{
+    char p[80];
+    snprintf(p, sizeof(p), "%s/typec-routes/route@%d",
+             dcp ? "/soc/dcp@48ae00000" : "/soc/dcp@286e00000", r);
+    return okay(p);
+}
+
+static void routes(int dcp, bool want)
+{
+    for (int r = 0; r < 3; r++)
+        assert(route_okay(dcp, r) == want);
+}
+
 static bool okay(const char *path)
 {
     const char *s = fdt_getprop(dt, at(path), "status", NULL);
@@ -153,6 +177,27 @@ int main(void)
     all(set1, false);
     assert(!okay("/soc/dcp@286e00000/piodma"));
     assert(marked("/soc/dcp@286e00000"));
+    /* Its Type-C routes come with it; dcpext1's stay off. */
+    routes(0, true);
+    routes(1, false);
+
+    /* A route with another status is left as it is; the others are enabled. */
+    tree(J604, sizeof(J604), true);
+    assert(!fdt_setprop_string(dt, at("/soc/dcp@286e00000/typec-routes/route@1"), "status",
+                               "reserved"));
+    mark("/soc/dcp@286e00000", 1);
+    dt_enable_j604_dcpext();
+    all(set0, true);
+    assert(route_okay(0, 0) && route_okay(0, 2));
+    assert(!strcmp(fdt_getprop(dt, at("/soc/dcp@286e00000/typec-routes/route@1"), "status",
+                               NULL), "reserved"));
+
+    /* A dcpext without routes is enabled as before. */
+    tree(J604, sizeof(J604), true);
+    assert(!fdt_del_node(dt, at("/soc/dcp@286e00000/typec-routes")));
+    mark("/soc/dcp@286e00000", 1);
+    dt_enable_j604_dcpext();
+    all(set0, true);
 
     /* Both marked: both enabled. */
     tree(J604, sizeof(J604), true);
@@ -171,6 +216,9 @@ int main(void)
     all(set1, false);
     assert(!marked("/soc/dcp@48ae00000"));
     assert(marked("/soc/dcp@286e00000"));
+    /* The failed one's routes stay off with it: the port controllers do not wait for it. */
+    routes(0, true);
+    routes(1, false);
 
     /* No marker, or a marker other than 1: nothing changes. */
     tree(J604, sizeof(J604), true);
@@ -178,6 +226,8 @@ int main(void)
     dt_enable_j604_dcpext();
     all(set0, false);
     all(set1, false);
+    routes(0, false);
+    routes(1, false);
 
     /* The J713 (U-Boot imports its handoff): never enabled by m1n1. */
     tree(J713, sizeof(J713), true);
@@ -185,6 +235,7 @@ int main(void)
     dt_enable_j604_dcpext();
     all(set0, false);
     assert(marked("/soc/dcp@286e00000"));
+    routes(0, false);
     return 0;
 }
 ''')
