 src/pcie.h                             |   2 +
 src/pcie_fdt.c                         | 140 +++++++++++++++++++++++++
 tests/python/test_m4_pcie_power_fdt.py |  11 +-
 tests/python/test_smp_handoff_gate.py  |   1 +
 5 files changed, 156 insertions(+), 1 deletion(-)

