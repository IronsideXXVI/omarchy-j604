From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Wed, 11 Nov 2026 02:12:32 +0000
Subject: [PATCH] pcie_fdt: publish every APCIe root port's own tables, not
 only port 0's

An OS that cycles the power of ANS's APCIe block in a deep sleep has to
bring every root port on it back, not only the first. On the J604 the
block carries the Wi-Fi/Bluetooth radio on port 0 and the SD card reader
on port 2 (ADT pci-bridge2). The export so far copied the four port
tables (apcie-config-tunables, pcie-rc-tunables and the gen3/gen4 shadow
tables) from pci-bridge0 to the DT's pci@0,0 only, so the SD reader's
port cannot be set up again after the power comes back.

For each further port N whose ADT pci-bridgeN and DT pci@N,0 both exist,
copy the same four tables from pci-bridgeN to pci@N,0. A port's own
window is reg[7 + N * stride], with stride the reg entries per port
after the host's seven, worked out from #ports the same way the PCIe
init does. The rc tables stay relative to that port's slice of the
config window, as for port 0.

A further port is published whole or not at all: a missing or malformed
table, a record outside its own window, or no usable #ports leaves that
port out (and logs it) and takes nothing from the host's six tables or
port 0's four, which are exported exactly as before. A second log line
names the ports published as a mask.

The host test models the APCIe ADT with pci-bridge0 and pci-bridge2: both
ports published (14 records, port 2's from its own bridge and window);
no pci@2,0 in the DT or no pci-bridge2 in the ADT gives port 0 alone
(10); a broken port 2 table, no #ports, or a record inside port 0's
window but outside port 2's leaves port 2 out and port 0 whole. It fails
on the previous code.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 src/pcie_fdt.c                         |  97 ++++++++++--
 tests/python/test_apcie_port_tables.py | 196 +++++++++++++++++++++++++
 2 files changed, 282 insertions(+), 11 deletions(-)
 create mode 100644 tests/python/test_apcie_port_tables.py

diff --git a/src/pcie_fdt.c b/src/pcie_fdt.c
index 8b3b6afb..430e1e54 100644
--- a/src/pcie_fdt.c
+++ b/src/pcie_fdt.c
@@ -438,23 +438,35 @@ static const struct {
     {"pcie-rc-gen4-shadow-tunables", "apple,tunable-rc-gen4", 0, true},
 };
 
-/* Adding to the host moves its port, so the port is looked up each time. */
-static int pcie_apcie_table_node(void *dt, int host, size_t i)
+/* Adding to the host moves its ports, so a port is looked up each time. */
+static int pcie_apcie_table_node(void *dt, int host, size_t i, u32 port)
 {
-    return pcie_apcie_tables[i].port ? fdt_subnode_offset(dt, host, "pci@0,0") : host;
+    char name[16];
+
+    if (!pcie_apcie_tables[i].port)
+        return host;
+    snprintf(name, sizeof(name), "pci@%u,0", port);
+    return fdt_subnode_offset(dt, host, name);
 }
 
-/* One table, whole or not at all. */
-static int pcie_apcie_table_fdt(void *dt, int host, int adt_node, int *path, size_t i)
+/*
+ * One table, whole or not at all. A port's own window follows the host's
+ * windows, one stride of reg entries per port: reg[7] is port 0's.
+ */
+static int pcie_apcie_table_fdt(void *dt, int host, int adt_node, int *path, size_t i, u32 port,
+                                u32 stride)
 {
     const struct pcie_adt_tunable *t;
-    int node = pcie_apcie_table_node(dt, host, i);
+    int node = pcie_apcie_table_node(dt, host, i, port);
+    int reg = pcie_apcie_tables[i].reg;
     u64 base, size;
     u32 len;
 
+    if (pcie_apcie_tables[i].port && reg)
+        reg += port * stride;
     t = adt_getprop(adt, adt_node, pcie_apcie_tables[i].adt, &len);
-    if (!t || !len || len % sizeof(*t) ||
-        adt_get_reg(adt, path, "reg", pcie_apcie_tables[i].reg, &base, &size) < 0 || size < 4) {
+    if (node < 0 || !t || !len || len % sizeof(*t) ||
+        adt_get_reg(adt, path, "reg", reg, &base, &size) < 0 || size < 4) {
         printf("FDT: %s missing or malformed\n", pcie_apcie_tables[i].adt);
         return -1;
     }
@@ -505,8 +517,58 @@ static int pcie_apcie_host(void *dt, int *path)
     return -1;
 }
 
+/* The reg entries per port after the host's seven, from the controller's #ports, or 0. */
+static u32 pcie_apcie_port_stride(int adt_node)
+{
+    const u32 *ports;
+    u32 len, entries;
+
+    ports = adt_getprop(adt, adt_node, "#ports", &len);
+    if (!ports || len != sizeof(*ports) || !*ports || *ports > 8 ||
+        !adt_getprop(adt, adt_node, "reg", &len) || len % 16)
+        return 0;
+    entries = len / 16;
+    if (entries < 7 + 3 * *ports || (entries - 7) % *ports)
+        return 0;
+    return (entries - 7) / *ports;
+}
+
+/*
+ * Another root port's own four tables, from its pci-bridgeN to the DT's pci@N,0: all four or
+ * none. A port the ADT or the DT doesn't have publishes nothing; one that fails takes nothing
+ * from port 0 or the host.
+ */
+static int pcie_apcie_port_publish(void *dt, int host, const char *apcie, int *path, u32 port,
+                                   u32 stride)
+{
+    char bridge[32], name[16];
+    int adt_bridge, records = 0;
+
+    snprintf(bridge, sizeof(bridge), "%s/pci-bridge%u", apcie, port);
+    snprintf(name, sizeof(name), "pci@%u,0", port);
+    adt_bridge = adt_path_offset(adt, bridge);
+    if (adt_bridge < 0 || fdt_subnode_offset(dt, host, name) < 0)
+        return 0;
+
+    for (size_t i = 0; i < ARRAY_SIZE(pcie_apcie_tables); i++) {
+        if (!pcie_apcie_tables[i].port)
+            continue;
+        int n = stride ? pcie_apcie_table_fdt(dt, host, adt_bridge, path, i, port, stride) : -1;
+        if (n < 0) {
+            for (size_t j = 0; j < i; j++)
+                if (pcie_apcie_tables[j].port)
+                    fdt_delprop(dt, pcie_apcie_table_node(dt, host, j, port),
+                                pcie_apcie_tables[j].fdt);
+            printf("FDT: %s port %u tables left out\n", apcie, port);
+            return -1;
+        }
+        records += n;
+    }
+    return records;
+}
+
 /* 0 on a Mac whose ANS doesn't run on the APCIe block: nothing to publish. */
-static int pcie_apcie_tables_publish(void *dt, const char *apcie)
+static int pcie_apcie_tables_publish(void *dt, const char *apcie, u32 *ports)
 {
     char bridge[32];
     int path[8], bridge_path[8];
@@ -524,11 +586,22 @@ static int pcie_apcie_tables_publish(void *dt, const char *apcie)
     /* Properties added to the host or its port leave the host's offset as it is. */
     for (size_t i = 0; i < ARRAY_SIZE(pcie_apcie_tables); i++) {
         int from = pcie_apcie_tables[i].port ? adt_bridge : adt_node;
-        int n = pcie_apcie_table_fdt(dt, host, from, path, i);
+        int n = pcie_apcie_table_fdt(dt, host, from, path, i, 0, 0);
         if (n < 0)
             return -1;
         records += n;
     }
+    *ports = BIT(0);
+
+    /* The block's other root ports (the J604's SD reader is port 2) restart after it too. */
+    u32 stride = pcie_apcie_port_stride(adt_node);
+    for (u32 port = 1; port < 8; port++) {
+        int n = pcie_apcie_port_publish(dt, host, apcie, path, port, stride);
+        if (n > 0) {
+            records += n;
+            *ports |= BIT(port);
+        }
+    }
 
     return records;
 }
@@ -550,15 +623,17 @@ int pcie_apcie_tables_fdt(void *dt, int capacity)
         return -1;
     const char *apcie =
         adt_path_offset(adt, "/arm-io/apcie") >= 0 ? "/arm-io/apcie" : "/arm-io/apcie0";
+    u32 ports = 0;
     int ret = fdt_open_into(dt, staged, capacity);
     if (!ret)
-        ret = pcie_apcie_tables_publish(staged, apcie);
+        ret = pcie_apcie_tables_publish(staged, apcie, &ports);
     if (ret >= 0) {
         if (fdt_pack(staged))
             ret = -1;
         else {
             memcpy(dt, staged, fdt_totalsize(staged));
             printf("FDT: %s tables published, %d records\n", apcie, ret);
+            printf("FDT: %s port tables published for ports 0x%x\n", apcie, ports);
         }
     }
     free(staged);
diff --git a/tests/python/test_apcie_port_tables.py b/tests/python/test_apcie_port_tables.py
new file mode 100644
index 00000000..36220f02
--- /dev/null
+++ b/tests/python/test_apcie_port_tables.py
@@ -0,0 +1,196 @@
+# SPDX-License-Identifier: GPL-2.0-only OR MIT
+"""Every root port of ANS's APCIe block gets its own four tables, all or none, never at port 0's cost."""
+from pathlib import Path
+import struct
+import subprocess
+
+from test_m4_pcie_power_fdt import ADT_MODEL, adt_blob, c_array
+
+STRIDE = 5  # reg entries per port after the host's seven (#ports 3: 7 + 3 * 5 = 22)
+RC = 0x1CB0000000
+
+
+def rec(off, val, mask=0xFF, size=4):
+    return struct.pack("<IIQQ", off, size, mask, val)
+
+
+def regs(port2_size=0x10000):
+    out = b""
+    for i in range(7 + 3 * STRIDE):
+        addr = RC if i == 1 else 0x1C00000000 + i * 0x100000
+        size = 0x100000 if i == 0 else 0x4000 if i == 1 else 0x10000
+        if i == 7 + 2 * STRIDE:
+            size = port2_size
+        out += struct.pack("<QQ", addr, size)
+    return out
+
+
+HOST = ["apcie-axi2af-tunables", "apcie-phy-tunables", "apcie-phy-ip-pll-tunables",
+        "apcie-phy-ip-auspma-tunables", "apcie-cio3pllcore-tunables", "apcie-pcieclkgen-tunables"]
+PORT = ["apcie-config-tunables", "pcie-rc-tunables", "pcie-rc-gen3-shadow-tunables",
+        "pcie-rc-gen4-shadow-tunables"]
+
+
+def bridge(n, base, broken=None, config_off=0x100):
+    props = []
+    for i, name in enumerate(PORT):
+        off = config_off if i == 0 else 0x200 + 4 * i
+        props.append((name, rec(off, base + i, size=8 if name == broken else 4)))
+    return ("pci-bridge%d" % n, props, [])
+
+
+def apcie_adt(bridge2=True, broken=None, ports=True, port2_size=0x10000, config_off=0x100):
+    props = [("reg", regs(port2_size))]
+    if ports:
+        props.append(("#ports", struct.pack("<I", 3)))
+    props += [(name, rec(0x10, 1 + i)) for i, name in enumerate(HOST)]
+    children = [bridge(0, 0xA0)]
+    if bridge2:
+        children.append(bridge(2, 0xB0, broken, config_off))
+    return adt_blob(("device-tree", [], [("arm-io", [], [
+        ("ans", [("nvme-secure-bar", struct.pack("<I", 1))], []),
+        ("apcie", props, children)])]))
+
+
+MODEL = r"""
+const struct adt_property *adt_get_property(const void *a, int node, const char *name)
+{ return adt_find(a, node, name); }
+const void *adt_getprop(const void *a, int node, const char *name, u32 *len)
+{
+ const struct adt_property *p = adt_find(a, node, name);
+ if (!p) return NULL;
+ if (len) *len = p->size;
+ return p->value;
+}
+int adt_path_offset_trace(const void *a, const char *path, int *offsets)
+{
+ int node = adt_path_offset(a, path);
+ offsets[0] = node; offsets[1] = 0;
+ return node;
+}
+/* The model's reg is plain <u64 addr, u64 size> entries on the traced node. */
+int adt_get_reg(const void *a, int *path, const char *prop, int idx, u64 *addr, u64 *size)
+{
+ u32 len;
+ const u8 *r = adt_getprop(a, path[0], prop, &len);
+ if (!r || idx < 0 || (u32)(idx + 1) * 16 > len) return -1;
+ memcpy(addr, r + 16 * idx, 8);
+ if (size) memcpy(size, r + 16 * idx + 8, 8);
+ return 0;
+}
+"""
+
+
+def test_apcie_port_tables(tmp_path):
+    repo = Path(__file__).resolve().parents[2]
+    strip = lambda p: "\n".join(l for l in (repo / p).read_text().splitlines()
+                                if not l.startswith("#include"))
+    adts = (c_array("adt_full", apcie_adt()) +
+            c_array("adt_no_bridge2", apcie_adt(bridge2=False)) +
+            c_array("adt_bad_rc", apcie_adt(broken="pcie-rc-gen4-shadow-tunables")) +
+            c_array("adt_no_ports", apcie_adt(ports=False)) +
+            c_array("adt_outside", apcie_adt(port2_size=0x4000, config_off=0x8000)))
+    production = (strip("src/t8132_board.h") + "\n" + strip("src/adt.h") + "\n" + ADT_MODEL +
+                  MODEL + adts + strip("src/pcie_fdt.c"))
+    harness = r'''
+#include <assert.h>
+#include <stddef.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "libfdt.h"
+typedef uint8_t u8;
+typedef uint32_t u32;
+typedef uint64_t u64;
+typedef int smc_dev_t;
+#define BIT(n) (1U << (n))
+#define PACKED __attribute__((packed))
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+static smc_dev_t smc;
+static smc_dev_t *smc_init(void) { return &smc; }
+static int smc_write_u32(smc_dev_t *s, u32 key, u32 value) { return 0; }
+static void smc_shutdown(smc_dev_t *s) {}
+static int dart_set_bypass_fdt(void *dt, u32 phandle, u8 sid) { return 0; }
+''' + production + r'''
+static char blob[16384];
+static void setup(bool port2)
+{
+ assert(!fdt_create_empty_tree(blob, 8192));
+ assert(!fdt_setprop_u32(blob, 0, "#address-cells", 2));
+ assert(!fdt_setprop_u32(blob, 0, "#size-cells", 2));
+ int host = fdt_add_subnode(blob, 0, "pcie");
+ assert(host >= 0);
+ const char names[] = "config\0rc\0port0\0phy0\0port2\0phy2";
+ assert(!fdt_setprop(blob, host, "reg-names", names, sizeof(names)));
+ fdt32_t reg[24] = {0};
+ reg[4] = cpu_to_fdt32((u32)(0x1CB0000000ULL >> 32));
+ reg[5] = cpu_to_fdt32((u32)0x1CB0000000ULL);
+ assert(!fdt_setprop(blob, host, "reg", reg, sizeof(reg)));
+ assert(fdt_add_subnode(blob, fdt_path_offset(blob, "/pcie"), "pci@0,0") >= 0);
+ if (port2)
+  assert(fdt_add_subnode(blob, fdt_path_offset(blob, "/pcie"), "pci@2,0") >= 0);
+}
+/* One <offset mask value> record, or none at all. */
+static void expect(const char *node, const char *prop, u32 off, u32 val)
+{
+ int len;
+ const fdt32_t *c = fdt_getprop(blob, fdt_path_offset(blob, node), prop, &len);
+ if (!val) { assert(!c); return; }
+ assert(c && len == 12);
+ assert(fdt32_to_cpu(c[0]) == off && fdt32_to_cpu(c[1]) == 0xff && fdt32_to_cpu(c[2]) == val);
+}
+static void expect_port(const char *node, u32 base, u32 config_off)
+{
+ expect(node, "apple,tunable-port", config_off, base);
+ expect(node, "apple,tunable-rc", 0x204, base ? base + 1 : 0);
+ expect(node, "apple,tunable-rc-gen3", 0x208, base ? base + 2 : 0);
+ expect(node, "apple,tunable-rc-gen4", 0x20c, base ? base + 3 : 0);
+}
+static void expect_host_and_port0(void)
+{
+ const char *host[] = {"apple,tunable-axi2af", "apple,tunable-phy", "apple,tunable-phy-ip-pll",
+                       "apple,tunable-phy-ip-auspma", "apple,tunable-cio3pll", "apple,tunable-clkgen"};
+ for (u32 i = 0; i < 6; i++)
+  expect("/pcie", host[i], 0x10, i + 1);
+ expect_port("/pcie/pci@0,0", 0xa0, 0x100);
+}
+int main(void)
+{
+ /* Both ports: 6 + 4 + 4 records, port 2's from pci-bridge2 and its own window. */
+ adt = (void *)adt_full; setup(true);
+ assert(pcie_apcie_tables_fdt(blob, sizeof(blob)) == 14);
+ expect_host_and_port0(); expect_port("/pcie/pci@2,0", 0xb0, 0x100);
+ /* No pci@2,0 in the DT, or no pci-bridge2 in the ADT: port 0 exactly as before. */
+ setup(false);
+ assert(pcie_apcie_tables_fdt(blob, sizeof(blob)) == 10);
+ expect_host_and_port0();
+ adt = (void *)adt_no_bridge2; setup(true);
+ assert(pcie_apcie_tables_fdt(blob, sizeof(blob)) == 10);
+ expect_host_and_port0(); expect_port("/pcie/pci@2,0", 0, 0);
+ /* Port 2 whole or not at all: a bad last table, no #ports (no stride), or a record outside
+  * port 2's own window (inside port 0's) leaves port 2 out and port 0 and the host whole. */
+ const void *partial[] = {adt_bad_rc, adt_no_ports, adt_outside};
+ for (u32 i = 0; i < 3; i++) {
+  adt = (void *)partial[i]; setup(true);
+  assert(pcie_apcie_tables_fdt(blob, sizeof(blob)) == 10);
+  expect_host_and_port0(); expect_port("/pcie/pci@2,0", 0, 0);
+ }
+ /* Not a post-M4 ANS: nothing published. */
+ adt = NULL;
+ return 0;
+}
+'''
+    source = tmp_path / "apcie-port-tables.c"
+    source.write_text(harness)
+    binary = tmp_path / "apcie-port-tables"
+    libfdt = repo / "src/libfdt"
+    sources = [libfdt / (n + ".c") for n in ("fdt", "fdt_ro", "fdt_rw", "fdt_sw",
+               "fdt_wip", "fdt_empty_tree", "fdt_check", "fdt_strerror", "fdt_addresses")]
+    subprocess.run(["cc", "-D_GNU_SOURCE", "-std=gnu11", "-Wall", "-Wextra", "-Werror",
+                    "-Wno-unused-parameter", "-Wno-unused-function", "-Wno-format", "-I",
+                    str(libfdt), str(source), *map(str, sources), "-o", str(binary)], check=True)
+    out = subprocess.run([str(binary)], check=True, capture_output=True, text=True).stdout
+    assert "port tables published for ports 0x5" in out
+    assert "port 2 tables left out" in out
-- 
2.43.0

