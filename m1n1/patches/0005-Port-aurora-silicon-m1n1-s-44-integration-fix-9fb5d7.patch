From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ryan Murray <ryan@aurorasilicon.org>
Date: Sun, 25 Oct 2026 12:11:48 +1100
Subject: [PATCH] Port aurora-silicon/m1n1's #44 integration fix 9fb5d7a0

dart: bound the locked T8110 walk by the DART's register window

aurora-silicon/m1n1 #44 (sync/omacom-integration-aurora-20261025, merged
as e6862970) merged omacom integration/aurora into aurora-wip. 9fb5d7a0
is one of the fixes that merge needed so omacom's code and the J713
display handoff work together. This tree combines the same two code
bases (omacom bc79acc plus the J713 ports #35, #36, #40, #46), so it
has the same defect. Upstream's message:

  86b91cd6 limited dart_walk_locked_t8110() to streams 0 to 15, because
  the J514S display handoff only validates a 0x1440 byte register window,
  which holds the TTBRs of those streams. The J713 display handoff from
  aurora-wip walks stream 16 of a DART whose window is 0xc000 bytes, so
  after the merge its PIODMA handoff is always refused and the J713 keeps
  only the boot framebuffer.

  Take the window size instead and refuse a stream whose TTBR lies outside
  it. J514S passes the smaller of its ADT and FDT windows, and J713 its
  0xc000 byte block (reg of iommu@30a300000 in t8132-j713-display.dtsi).
  The host fixture covers both windows.

Applied cleanly with no conflicts (CODE: git cherry-pick, 4 files,
+20/-13). The J713 window (0xc000) is a J713 value. Whether the J604
display DART has the same base and window is TO-VERIFY against the
fresh 27.2 ADT capture (see the J604 board-data table, a later commit).

Hardware tested on: NOT YET
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 src/dart.c                                 |  6 ++++--
 src/dart.h                                 |  2 +-
 src/kboot.c                                |  8 ++++----
 tests/python/test_siliconforest_handoff.py | 17 +++++++++++------
 4 files changed, 20 insertions(+), 13 deletions(-)

diff --git a/src/dart.c b/src/dart.c
index 03641376..2b2a7130 100644
--- a/src/dart.c
+++ b/src/dart.c
@@ -1033,12 +1033,14 @@ void *dart_translate_silent(dart_dev_t *dart, uintptr_t iova)
  * outside DRAM are refused. @visit is called for every valid L2 entry and stops
  * the walk by returning non-zero.
  */
-int dart_walk_locked_t8110(uintptr_t base, u8 sid, u64 dram_base, u64 dram_size,
+int dart_walk_locked_t8110(uintptr_t base, u64 size, u8 sid, u64 dram_base, u64 dram_size,
                            int (*visit)(u64 iova, u64 paddr, void *opaque), void *opaque)
 {
     u64 dram_end = dram_base + dram_size;
 
-    if (!visit || sid >= 16 || dram_size < SZ_16K || dram_end <= dram_base)
+    /* The stream's TTBR is the highest register read; the window must cover it. */
+    if (!visit || size < DART_T8110_TTBR_OFF + 4 * ((u64)sid + 1) || dram_size < SZ_16K ||
+        dram_end <= dram_base)
         return -1;
 
     u32 tcr = read32(base + DART_T8110_TCR_OFF + 4 * sid);
diff --git a/src/dart.h b/src/dart.h
index c51bdfbb..0e84bef4 100644
--- a/src/dart.h
+++ b/src/dart.h
@@ -34,7 +34,7 @@ void dart_unmap(dart_dev_t *dart, uintptr_t iova, size_t len);
 void dart_free_l2(dart_dev_t *dart, uintptr_t iova);
 void *dart_translate(dart_dev_t *dart, uintptr_t iova);
 void *dart_translate_silent(dart_dev_t *dart, uintptr_t iova);
-int dart_walk_locked_t8110(uintptr_t base, u8 sid, u64 dram_base, u64 dram_size,
+int dart_walk_locked_t8110(uintptr_t base, u64 size, u8 sid, u64 dram_base, u64 dram_size,
                            int (*visit)(u64 iova, u64 paddr, void *opaque), void *opaque);
 u64 dart_search(dart_dev_t *dart, void *paddr);
 u64 dart_find_iova(dart_dev_t *dart, s64 start, size_t len);
diff --git a/src/kboot.c b/src/kboot.c
index cca48064..b7719933 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -4838,8 +4838,8 @@ static int dt_set_t6030_display_maps(const struct adt_segment_ranges *segments,
         return t6030_display_handoff_fail("DART base: FDT 0x%lx, ADT 0x%lx", dart_base, adt_base);
 
     for (u32 n = 0; n < 2; n++) {
-        if (dart_walk_locked_t8110(dart_base, streams[n], dram_base, dram_size, t6030_display_page,
-                                   &maps[n])) {
+        if (dart_walk_locked_t8110(dart_base, min(adt_size, dart_size), streams[n], dram_base,
+                                   dram_size, t6030_display_page, &maps[n])) {
             if (maps[n].rejected)
                 return t6030_display_handoff_fail("SID%u: no segment for iova 0x%lx -> 0x%lx",
                                                   streams[n], maps[n].rejected_iova,
@@ -5313,8 +5313,8 @@ static int dt_set_j713_display_maps(const struct adt_segment_ranges *segments, u
 
     /* Exact J713 register block; reading tables must not enable/reset streams. */
     for (u32 n = 0; n < 2; n++) {
-        if (dart_walk_locked_t8110(0x30a300000, streams[n], dram_start, dram_size,
-                                    j713_display_page, &maps[n]))
+        if (dart_walk_locked_t8110(0x30a300000, 0xc000, streams[n], dram_start, dram_size,
+                                   j713_display_page, &maps[n]))
             return -1;
         u32 regions = 0;
         for (u32 i = 0; i < count; i++) {
diff --git a/tests/python/test_siliconforest_handoff.py b/tests/python/test_siliconforest_handoff.py
index d63919bb..0d2b8846 100644
--- a/tests/python/test_siliconforest_handoff.py
+++ b/tests/python/test_siliconforest_handoff.py
@@ -122,12 +122,17 @@ static u32 read32(uintptr_t address) { reads++; return 0; }
 static int visit(u64 iova, u64 physical, void *context) { assert(0); return -1; }
 int main(void)
 {
-    assert(dart_walk_locked_t8110(0, 16, 0, SZ_16K, visit, NULL) == -1 && !reads);
-    assert(dart_walk_locked_t8110(0, 255, 0, SZ_16K, visit, NULL) == -1 && !reads);
-    assert(dart_walk_locked_t8110(0, 0, 0, 1, visit, NULL) == -1 && !reads);
-    assert(dart_walk_locked_t8110(0, 0, UINT64_MAX - 1, SZ_16K, visit, NULL) == -1 && !reads);
-    assert(dart_walk_locked_t8110(0, 0, 0, SZ_16K, NULL, NULL) == -1 && !reads);
-    assert(dart_walk_locked_t8110(0, 15, 0, SZ_16K, visit, NULL) == -1 && reads == 3);
+    /* A 0x1440 window, as J514S validates, holds the TTBRs of streams 0 to 15. */
+    assert(dart_walk_locked_t8110(0, 0x1440, 16, 0, SZ_16K, visit, NULL) == -1 && !reads);
+    assert(dart_walk_locked_t8110(0, 0x1440, 255, 0, SZ_16K, visit, NULL) == -1 && !reads);
+    assert(dart_walk_locked_t8110(0, 0x1440, 0, 0, 1, visit, NULL) == -1 && !reads);
+    assert(dart_walk_locked_t8110(0, 0x1440, 0, UINT64_MAX - 1, SZ_16K, visit, NULL) == -1 && !reads);
+    assert(dart_walk_locked_t8110(0, 0x1440, 0, 0, SZ_16K, NULL, NULL) == -1 && !reads);
+    assert(dart_walk_locked_t8110(0, 0, 0, 0, SZ_16K, visit, NULL) == -1 && !reads);
+    assert(dart_walk_locked_t8110(0, 0x1440, 15, 0, SZ_16K, visit, NULL) == -1 && reads == 3);
+    /* J713's 0xc000 window reaches stream 16, which its display handoff walks. */
+    assert(dart_walk_locked_t8110(0, 0xc000, 16, 0, SZ_16K, visit, NULL) == -1 && reads == 6);
+    assert(dart_walk_locked_t8110(0, 0xc000, 255, 0, SZ_16K, visit, NULL) == -1 && reads == 9);
     return 0;
 }
 ''')
