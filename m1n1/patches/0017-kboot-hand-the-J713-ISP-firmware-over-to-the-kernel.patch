From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Thu, 5 Nov 2026 09:18:28 -0500
Subject: [PATCH 17/19] kboot: hand the J713 ISP firmware over to the kernel

iBoot loads the camera firmware outside the kernel's memory, at
addresses that move with the boot firmware. The J713 device tree
therefore describes the ISP and its DARTs disabled, with empty
isp-firmware-text and isp-firmware-data placeholders and an isp-heap
window for the firmware's main memory.

Fill the placeholders from this boot's ADT isp segment-ranges: reserve
each segment by physical address, and map it where the firmware runs
it, from the base of the heap window. Then set apple,platform-id from
the ADT isp node's sensor-type and enable the ISP and its DARTs.

The segments must be the firmware's __TEXT and __DATA, 16K aligned and
inside DRAM, with TEXT at the base of the heap window and DATA right
above it. Otherwise the tree is left as it was, the camera stays
disabled and the boot goes on. A tree whose ISP is already enabled
reserves its own firmware and is left alone.

Signed-off-by: Erik Bourget <erik@ebourget.net>
---
 src/kboot.c                           | 143 ++++++++++++++++
 tests/python/test_j713_isp_handoff.py | 231 ++++++++++++++++++++++++++
 2 files changed, 374 insertions(+)
 create mode 100644 tests/python/test_j713_isp_handoff.py

diff --git a/src/kboot.c b/src/kboot.c
index ced76b75..bb8c94d0 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -6254,6 +6254,148 @@ static int dt_set_isp(void)
     return 0;
 }
 
+/*
+ * J713: iBoot loads the camera firmware, and the kernel starts it as iBoot left it. The
+ * segments move with the boot firmware, so the device tree describes the ISP disabled, with empty
+ * placeholders isp-firmware-text and isp-firmware-data and an isp-heap window for the
+ * firmware's main memory. Fill the placeholders from this boot's ADT isp segment-ranges: reg,
+ * and iommu-addresses where the firmware runs them. Then set the platform ID from the ADT's
+ * sensor-type and enable the ISP and its DARTs.
+ */
+static int dt_set_j713_isp_one(unsigned int unused)
+{
+    static const char dt_names[] = "text\0data\0heap";
+    static const char adt_names[] = "__TEXT;__DATA";
+    static const char *const paths[] = {"/reserved-memory/isp-firmware-text",
+                                        "/reserved-memory/isp-firmware-data",
+                                        "/reserved-memory/isp-heap"};
+    const struct adt_segment_ranges *segments;
+    const fdt32_t *refs, *map;
+    const fdt64_t *reg;
+    u64 phys[2], iova[2], size[2], heap_base, heap_size, dram_base, dram_size;
+    u32 isp_phandle, sensor, darts[3], len;
+    int isp, node, bytes;
+
+    UNUSED(unused);
+    isp = fdt_node_offset_by_compatible(dt, -1, "apple,t8132-isp");
+    isp_phandle = fdt_get_phandle(dt, isp);
+    const char *names = fdt_getprop(dt, isp, "memory-region-names", &bytes);
+    if (!isp_phandle || !names || bytes != sizeof(dt_names) ||
+        memcmp(names, dt_names, sizeof(dt_names)))
+        bail("FDT: J713 ISP memory regions are not text, data and heap\n");
+    refs = fdt_getprop(dt, isp, "memory-region", &bytes);
+    if (!refs || bytes != 3 * sizeof(*refs))
+        bail("FDT: J713 ISP has no three memory regions\n");
+    for (int i = 0; i < 3; i++) {
+        node = fdt_path_offset(dt, paths[i]);
+        if (node < 0 || fdt_node_offset_by_phandle(dt, fdt32_ld(refs + i)) != node)
+            bail("FDT: J713 ISP region %d is not %s\n", i, paths[i]);
+        if (i < 2) {
+            reg = fdt_getprop(dt, node, "reg", &bytes);
+            if (reg && (bytes != 2 * sizeof(*reg) || fdt64_ld(reg) || fdt64_ld(reg + 1)))
+                bail("FDT: %s is not an empty placeholder\n", paths[i]);
+        }
+    }
+    map = fdt_getprop(dt, fdt_path_offset(dt, paths[2]), "iommu-addresses", &bytes);
+    if (!map || bytes != 5 * sizeof(*map) || fdt32_ld(map) != isp_phandle)
+        bail("FDT: J713 ISP heap has no window\n");
+    heap_base = ((u64)fdt32_ld(map + 1) << 32) | fdt32_ld(map + 2);
+    heap_size = ((u64)fdt32_ld(map + 3) << 32) | fdt32_ld(map + 4);
+    if (heap_base != 0x10000000000ULL || !heap_size || heap_size > 64 * SZ_1M)
+        bail("FDT: J713 ISP heap window 0x%lx+0x%lx unexpected\n", heap_base, heap_size);
+    refs = fdt_getprop(dt, isp, "iommus", &bytes);
+    if (!refs || bytes != 6 * sizeof(*refs))
+        bail("FDT: J713 ISP has no three DARTs\n");
+    for (int i = 0; i < 3; i++)
+        darts[i] = fdt32_ld(refs + 2 * i);
+
+    int chosen = adt_path_offset(adt, "/chosen");
+    int adt_isp = adt_path_offset(adt, "/arm-io/isp");
+    if (chosen < 0 || adt_isp < 0 ||
+        ADT_GETPROP(adt, chosen, "dram-base", &dram_base) != sizeof(dram_base) ||
+        ADT_GETPROP(adt, chosen, "dram-size", &dram_size) != sizeof(dram_size) || !dram_size ||
+        dram_base > UINT64_MAX - dram_size)
+        bail("ADT: J713 ISP or DRAM bounds missing\n");
+    const char *segment_names = adt_getprop(adt, adt_isp, "segment-names", &len);
+    if (!segment_names || len != sizeof(adt_names) || memcmp(segment_names, adt_names, len))
+        bail("ADT: J713 ISP segments are not __TEXT;__DATA\n");
+    segments = adt_getprop(adt, adt_isp, "segment-ranges", &len);
+    if (!segments || len != 2 * sizeof(*segments))
+        bail("ADT: J713 ISP has no two segment ranges\n");
+    if (ADT_GETPROP(adt, adt_isp, "sensor-type", &sensor) != sizeof(sensor) || !sensor)
+        bail("ADT: J713 ISP has no sensor-type\n");
+    for (int i = 0; i < 2; i++) {
+        phys[i] = segments[i].phys;
+        iova[i] = segments[i].remap;
+        size[i] = ALIGN_UP((u64)segments[i].size, SZ_16K);
+        if (!size[i] || size[i] > heap_size || (phys[i] & (SZ_16K - 1)) ||
+            (iova[i] & (SZ_16K - 1)) || phys[i] < dram_base || size[i] > dram_size ||
+            phys[i] - dram_base > dram_size - size[i])
+            bail("ADT: J713 ISP segment %d 0x%lx+0x%lx outside DRAM\n", i, phys[i], size[i]);
+    }
+    /* TEXT at the start of the firmware's memory, DATA right above it, both below the heap top. */
+    if (iova[0] != heap_base || iova[1] != iova[0] + size[0] ||
+        size[1] > heap_base + heap_size - iova[1] ||
+        (phys[0] < phys[1] + size[1] && phys[1] < phys[0] + size[0]))
+        bail("ADT: J713 ISP segments at 0x%lx and 0x%lx do not fit the firmware window\n", iova[0],
+             iova[1]);
+
+    for (int i = 0; i < 2; i++) {
+        fdt64_t range[2] = {cpu_to_fdt64(phys[i]), cpu_to_fdt64(size[i])};
+        int ret;
+
+        node = fdt_path_offset(dt, paths[i]);
+        if (node < 0 || fdt_setprop(dt, node, "reg", range, sizeof(range)))
+            return -1;
+        node = fdt_path_offset(dt, paths[i]);
+        if (node < 0 || fdt_setprop_empty(dt, node, "no-map"))
+            return -1;
+        node = fdt_path_offset(dt, paths[i]);
+        if (node < 0 || fdt_setprop_string(dt, node, "status", "okay"))
+            return -1;
+        node = fdt_path_offset(dt, paths[i]);
+        ret = node < 0 ? node : fdt_delprop(dt, node, "iommu-addresses");
+        if (ret && ret != -FDT_ERR_NOTFOUND)
+            return -1;
+        node = fdt_path_offset(dt, paths[i]);
+        if (node < 0 || dt_device_set_reserved_mem(node, paths[i], isp_phandle, iova[i], size[i]))
+            return -1;
+        printf("FDT: J713 ISP %s at 0x%lx (+0x%lx), runs at 0x%lx\n", i ? "DATA" : "TEXT", phys[i],
+               size[i], iova[i]);
+    }
+    isp = fdt_node_offset_by_phandle(dt, isp_phandle);
+    if (isp < 0 || fdt_setprop_u32(dt, isp, "apple,platform-id", sensor))
+        return -1;
+    isp = fdt_node_offset_by_phandle(dt, isp_phandle);
+    if (isp < 0 || fdt_setprop_string(dt, isp, "status", "okay"))
+        return -1;
+    for (int i = 0; i < 3; i++) {
+        int dart = fdt_node_offset_by_phandle(dt, darts[i]);
+        if (dart < 0 || fdt_setprop_string(dt, dart, "status", "okay"))
+            return -1;
+    }
+    printf("FDT: J713 ISP handed over, platform ID 0x%x\n", sensor);
+    return 0;
+}
+
+/*
+ * Only a disabled ISP with the placeholders is a handoff target. A tree without them (no camera,
+ * or a kernel that reserves the firmware itself and enables the ISP) is left as it is. A refused
+ * handoff leaves the camera disabled; the boot goes on.
+ */
+static void dt_set_j713_isp(void)
+{
+    if (chip_id != T8132 || fdt_node_check_compatible(dt, 0, "apple,j713"))
+        return;
+    int isp = fdt_node_offset_by_compatible(dt, -1, "apple,t8132-isp");
+    const char *status = isp < 0 ? NULL : fdt_getprop(dt, isp, "status", NULL);
+    if (!status || strcmp(status, "disabled") ||
+        fdt_path_offset(dt, "/reserved-memory/isp-firmware-text") < 0)
+        return;
+    if (dt_display_transaction(dt_set_j713_isp_one, 0))
+        printf("FDT: J713 ISP handoff refused; keeping the camera disabled\n");
+}
+
 /* J700 is sold both with and without a built-in Touch ID sensor.  A paired
  * external keyboard is not evidence of the SPI sensor: iBoot omits spi2 from
  * the ADT on the sensorless variant.  Leave every other machine unchanged. */
@@ -7217,6 +7359,7 @@ int kboot_prepare_dt(void *fdt)
         return -1;
     if (dt_set_isp())
         return -1;
+    dt_set_j713_isp();
     if (dt_set_pmgr())
         return -1;
     if (chip_id == T8132 && t8132_board_admitted(dt, T8132_PATH_STORAGE) &&
diff --git a/tests/python/test_j713_isp_handoff.py b/tests/python/test_j713_isp_handoff.py
new file mode 100644
index 00000000..2fefaab6
--- /dev/null
+++ b/tests/python/test_j713_isp_handoff.py
@@ -0,0 +1,231 @@
+# SPDX-License-Identifier: MIT
+"""Exercise the J713 ISP firmware handoff with production kboot code and real FDTs."""
+
+import subprocess
+from pathlib import Path
+from test_siliconforest_handoff import run_c
+
+ROOT = Path(__file__).resolve().parents[2]
+
+# The kernel's J713 camera description: the ISP and its DARTs disabled, empty
+# firmware placeholders and the firmware's 20 MiB main memory window.
+TREE = r'''/dts-v1/;
+/ {
+    compatible = "apple,j713", "apple,t8132";
+    #address-cells = <2>; #size-cells = <2>;
+    reserved-memory {
+        #address-cells = <2>; #size-cells = <2>; ranges;
+        isp_fw_text: isp-firmware-text { };
+        isp_fw_data: isp-firmware-data { };
+        isp_heap: isp-heap { iommu-addresses = <&isp 0x100 0x0 0x0 0x1400000>; };
+    };
+    soc {
+        #address-cells = <2>; #size-cells = <2>; ranges;
+        isp: isp@48c000000 {
+            compatible = "apple,t8132-isp", "apple,isp";
+            iommus = <&isp_dart0 0>, <&isp_dart1 0>, <&isp_dart2 0>;
+            memory-region = <&isp_fw_text>, <&isp_fw_data>, <&isp_heap>;
+            memory-region-names = "text", "data", "heap";
+            status = "disabled";
+        };
+        isp_dart0: iommu@48e8c0000 { #iommu-cells = <1>; status = "disabled"; };
+        isp_dart1: iommu@48e8e0000 { #iommu-cells = <1>; status = "disabled"; };
+        isp_dart2: iommu@48e900000 { #iommu-cells = <1>; status = "disabled"; };
+    };
+};
+'''
+
+
+def test_j713_isp_handoff_fills_placeholders_or_leaves_the_camera_off(tmp_path):
+    kboot = (ROOT / "src/kboot.c").read_text()
+
+    def function(name, kind="static int "):
+        start = kboot.index(kind + name + "(")
+        return kboot[start:kboot.index("\n}", start) + 2] + "\n"
+
+    header = (ROOT / "src/adt.h").read_text()
+    start = header.index("struct adt_segment_ranges {")
+    layout = header[start:header.index("} PACKED;", start) + len("} PACKED;")]
+    dtb = tmp_path / "j713.dtb"
+    subprocess.run(["dtc", "-q", "-I", "dts", "-O", "dtb", "-o", str(dtb), "-"],
+                   input=TREE, text=True, check=True)
+    run_c(tmp_path, "j713-isp-handoff", '#define DTB_PATH "%s"\n' % dtb + r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "libfdt.h"
+/* Match aura's aarch64-linux-gnu target, not the host libc's uint64_t alias. */
+typedef unsigned long u64;
+_Static_assert(sizeof(u64) == 8, "the aura host fixture requires an LP64 host");
+typedef uint32_t u32;
+#define PACKED __attribute__((packed))
+#define T8132 0x8132
+#define SZ_16K 0x4000
+#define SZ_1M 0x100000
+#define ALIGN_UP(x, a) (((x) + (a) - 1) & ~((a) - 1))
+#define UNUSED(x) (void)(x)
+#define bail(...) do { return -1; } while (0)
+static void *dt, *adt;
+static u32 chip_id = T8132;
+static int fault;
+static unsigned char blob[16384], original[16384];
+''' + layout + r'''
+static struct adt_segment_ranges segments[2];
+static u64 dram_base, dram_size;
+static u32 sensor;
+static const char *names;
+static int adt_path_offset(void *tree, const char *path)
+{
+    if (!strcmp(path, "/chosen")) return 2;
+    if (!strcmp(path, "/arm-io/isp")) return 3;
+    return -1;
+}
+static const void *adt_getprop(void *tree, int node, const char *name, u32 *len)
+{
+    if (node == 3 && !strcmp(name, "segment-names")) {
+        *len = strlen(names) + 1;
+        return names;
+    }
+    if (node == 3 && !strcmp(name, "segment-ranges")) {
+        *len = sizeof(segments);
+        return segments;
+    }
+    if (node == 3 && !strcmp(name, "sensor-type") && fault != 2) {
+        *len = 4;
+        return &sensor;
+    }
+    *len = 8;
+    if (node == 2 && !strcmp(name, "dram-base")) return &dram_base;
+    if (node == 2 && !strcmp(name, "dram-size")) return &dram_size;
+    return NULL;
+}
+static int get_value(int node, const char *name, void *out, size_t capacity)
+{
+    u32 len = 0;
+    const void *p = adt_getprop(adt, node, name, &len);
+    if (!p || len > capacity) return -1;
+    memcpy(out, p, len);
+    return len;
+}
+#define ADT_GETPROP(a, n, k, v) get_value(n, k, v, sizeof(*(v)))
+''' + function("dt_device_set_reserved_mem") + function("dt_display_transaction") +
+        function("dt_set_j713_isp_one") + function("dt_set_j713_isp", "static void ") + r'''
+static void load(const char *path)
+{
+    FILE *f = fopen(path, "rb");
+    unsigned char raw[8192];
+    size_t n;
+    assert(f && (n = fread(raw, 1, sizeof(raw), f)) > 0);
+    fclose(f);
+    memset(blob, 0, sizeof(blob));
+    assert(!fdt_open_into(raw, blob, sizeof(blob)));
+    dt = blob;
+}
+static const char *status(const char *path)
+{
+    const char *s = fdt_getprop(dt, fdt_path_offset(dt, path), "status", NULL);
+    return s ? s : "okay";
+}
+static void world(const char *path)
+{
+    load(path);
+    chip_id = T8132;
+    names = "__TEXT;__DATA";
+    sensor = 0x17;
+    /* This J713's ADT isp segment-ranges. */
+    dram_base = 0x10000000000ULL;
+    dram_size = 0x400000000ULL;
+    segments[0] = (struct adt_segment_ranges){.phys = 0x10000d30000ULL, .iova = 0,
+        .remap = 0x10000000000ULL, .size = 0xca4000, .unk = 1};
+    segments[1] = (struct adt_segment_ranges){.phys = 0x10001f40000ULL, .iova = 0xca4000,
+        .remap = 0x10000ca4000ULL, .size = 0x748000};
+}
+static void check_region(const char *path, u64 phys, u64 iova, u64 size)
+{
+    int node = fdt_path_offset(dt, path), len;
+    const fdt64_t *reg = fdt_getprop(dt, node, "reg", &len);
+    assert(reg && len == 16 && fdt64_ld(reg) == phys && fdt64_ld(reg + 1) == size);
+    assert(fdt_getprop(dt, node, "no-map", &len) && !len);
+    assert(!strcmp(status(path), "okay"));
+    const fdt32_t *map = fdt_getprop(dt, node, "iommu-addresses", &len);
+    u32 isp = fdt_get_phandle(dt, fdt_path_offset(dt, "/soc/isp@48c000000"));
+    assert(map && len == 20 && fdt32_ld(map) == isp);
+    assert((((u64)fdt32_ld(map + 1) << 32) | fdt32_ld(map + 2)) == iova);
+    assert((((u64)fdt32_ld(map + 3) << 32) | fdt32_ld(map + 4)) == size);
+}
+int main(void)
+{
+    const char *darts[] = {"/soc/iommu@48e8c0000", "/soc/iommu@48e8e0000",
+                           "/soc/iommu@48e900000"};
+    int len;
+
+    /* Handed over: both segments where the firmware runs them, the platform ID, enabled. */
+    world(DTB_PATH);
+    dt_set_j713_isp();
+    check_region("/reserved-memory/isp-firmware-text", 0x10000d30000ULL, 0x10000000000ULL,
+                 0xca4000);
+    check_region("/reserved-memory/isp-firmware-data", 0x10001f40000ULL, 0x10000ca4000ULL,
+                 0x748000);
+    const fdt32_t *id = fdt_getprop(dt, fdt_path_offset(dt, "/soc/isp@48c000000"),
+                                    "apple,platform-id", &len);
+    assert(id && len == 4 && fdt32_ld(id) == 0x17);
+    assert(!strcmp(status("/soc/isp@48c000000"), "okay"));
+    for (int i = 0; i < 3; i++)
+        assert(!strcmp(status(darts[i]), "okay"));
+    const fdt32_t *heap = fdt_getprop(dt, fdt_path_offset(dt, "/reserved-memory/isp-heap"),
+                                      "iommu-addresses", &len);
+    assert(heap && len == 20 && fdt32_ld(heap + 4) == 0x1400000);
+    assert(!fdt_getprop(dt, fdt_path_offset(dt, "/reserved-memory/isp-heap"), "reg", NULL));
+
+    /* Every refusal leaves the tree exactly as it was: the camera stays off. */
+    for (fault = 1; fault <= 12; fault++) {
+        world(DTB_PATH);
+        if (fault == 1) names = "__TEXT";
+        if (fault == 3) segments[1].remap += SZ_16K; /* DATA not right above TEXT */
+        if (fault == 4) dram_base = 0x10001000000ULL; /* TEXT below DRAM */
+        if (fault == 5) segments[1].size = 0x800000; /* DATA past the heap top */
+        if (fault == 6) segments[1].phys = 0x10000d34000ULL; /* overlapping segments */
+        if (fault == 7) {
+            fdt32_t window[5] = {0};
+            int heap_node = fdt_path_offset(dt, "/reserved-memory/isp-heap");
+            memcpy(window, fdt_getprop(dt, heap_node, "iommu-addresses", NULL), 20);
+            window[1] = cpu_to_fdt32(0x200);
+            assert(!fdt_setprop(dt, heap_node, "iommu-addresses", window, sizeof(window)));
+        }
+        if (fault == 8) {
+            fdt64_t reg[2] = {cpu_to_fdt64(0x10000d30000ULL), cpu_to_fdt64(0xca4000)};
+            assert(!fdt_setprop(dt, fdt_path_offset(dt, "/reserved-memory/isp-firmware-data"),
+                                "reg", reg, sizeof(reg)));
+        }
+        if (fault == 9)
+            assert(!fdt_setprop_string(dt, fdt_path_offset(dt, "/soc/isp@48c000000"),
+                                       "memory-region-names", "text"));
+        if (fault == 10) segments[0].phys += 0x1000; /* not 16K aligned */
+        if (fault == 11) sensor = 0;
+        if (fault == 12) dram_size = 0x400000; /* DRAM smaller than TEXT */
+        memcpy(original, blob, sizeof(blob));
+        dt_set_j713_isp();
+        assert(!memcmp(original, blob, sizeof(blob)));
+        assert(!strcmp(status("/soc/isp@48c000000"), "disabled"));
+    }
+
+    /* Trees that are not handoff targets are left alone: an enabled ISP (a kernel that
+     * reserves its own firmware), no placeholders, another machine. */
+    for (fault = 20; fault <= 22; fault++) {
+        world(DTB_PATH);
+        int isp = fdt_path_offset(dt, "/soc/isp@48c000000");
+        if (fault == 20) assert(!fdt_setprop_string(dt, isp, "status", "okay"));
+        if (fault == 21)
+            assert(!fdt_del_node(dt, fdt_path_offset(dt, "/reserved-memory/isp-firmware-text")));
+        if (fault == 22) chip_id = 0x8122;
+        memcpy(original, blob, sizeof(blob));
+        dt_set_j713_isp();
+        assert(!memcmp(original, blob, sizeof(blob)));
+    }
+    puts("J713 ISP handoff verified");
+    return 0;
+}
+''')
