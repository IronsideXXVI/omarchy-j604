From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ewb <erik@ebourget.net>
Date: Thu, 22 Oct 2026 20:09:16 -0400
Subject: [PATCH] Port aurora-silicon/m1n1's merged change #36 (dcaf0e8e)

nvme: J713 stage 1: handshake with iBoot's ANS and quiesce it before
chainloading

aurora-silicon/m1n1 #36 (erikwb/j713/stage1-ans), merged as dcaf0e8e,
ported as its merge diff against the first parent. It carries:

  1416e742 nvme: handshake with iBoot's ANS in stage 1 instead of adopting it
  f1118f85 nvme: quiesce ANS AP power before stage 1 hands the session on

Both are by ewb <erik@ebourget.net>. rtkit.c/rtkit.h (the new
rtkit_quiesce_ap()) and nvme_init() apply unchanged.

Conflict resolution, src/nvme.c nvme_shutdown(): omacom ead37bd8
(iconidentify, "Neo: validate display ownership and refuse unsafe
CPU/NVMe handoffs (#8)") moved the T8132 IOQ register clear from before
nvme_ctrl_disable() into the final T8132 preserve block. #36 inserts
its stage-1 AP quiesce at the start of that same block. Both are kept,
the IOQ clear first, so the quiesce is still the last thing before the
session is marked for adoption, as in #36.

Build (RELEASE=1 CHAINLOADING=1, clang/lld 23.1.4): no new warnings.
test_nvme_adoption.py and test_m4_ans_fdt.py pass.

Hardware tested on: NOT YET
Assisted-by: LLM
Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
 src/nvme.c  | 18 ++++++++++++++++++
 src/rtkit.c | 54 ++++++++++++++++++++++++++++++++++++++++++++++++-----
 src/rtkit.h |  1 +
 3 files changed, 68 insertions(+), 5 deletions(-)

diff --git a/src/nvme.c b/src/nvme.c
index 95b89559..f1941347 100644
--- a/src/nvme.c
+++ b/src/nvme.c
@@ -1,5 +1,7 @@
 /* SPDX-License-Identifier: MIT */
 
+#include "../build/build_cfg.h"
+
 #include "adt.h"
 #include "assert.h"
 #include "malloc.h"
@@ -452,9 +454,16 @@ bool nvme_init(void)
     if (nvme_type == NVME_T8132) {
         bool running = asc_cpu_running(nvme_asc);
         nvme_log_entry_state(running);
+#if defined(CHAINLOADING) && !defined(ESP_STAGE2)
+        /* Stage 1 runs straight after iBoot: a running ANS here is iBoot's
+         * session, which still needs the RTKit handshake. Only an earlier
+         * m1n1 stage (nvme.adopt) leaves a session that can be adopted. */
+        adopting = nvme_adopt_live_session;
+#else
         /* Older stage 1 shuts ANS down; newer stage 1 leaves a live session.
          * Never replay RTKit's one-time handshake on the latter. */
         adopting = nvme_adopt_live_session || (chip_id == T8132 && running);
+#endif
         if (adopting) {
             u32 boot_status = read32(nvme_base + NVME_BOOT_STATUS);
             u32 csts = read32(nvme_base + NVME_CSTS);
@@ -719,6 +728,15 @@ bool nvme_shutdown(void)
     if (nvme_type == NVME_T8132) {
         write64_lo_hi(nvme_base + NVME_IOQ_CMDS, 0);
         write64_lo_hi(nvme_base + NVME_IOQ_CQES, 0);
+#if defined(CHAINLOADING) && !defined(ESP_STAGE2)
+        /* Stage 2 and U-Boot adopt this session without servicing its mailbox
+         * (only Linux takes RTKit ownership again), so stop the IOP pushing
+         * log traffic at the AP before handing it on. */
+        if (nvme_rtkit && rtkit_quiesce_ap(nvme_rtkit))
+            printf("nvme: ANS AP power quiesced for the next stage\n");
+        else
+            printf("nvme: could not quiesce ANS AP power; later stages may stall\n");
+#endif
         nvme_adopt_live_session = true;
         nvme_initialized = false;
         printf("nvme: controller disabled; preserving live RTKit session\n");
diff --git a/src/rtkit.c b/src/rtkit.c
index 703c6bf2..570a1e51 100644
--- a/src/rtkit.c
+++ b/src/rtkit.c
@@ -783,13 +783,10 @@ u32 rtkit_get_timeout(rtkit_dev_t *rtk)
     return rtk->timeout_usec;
 }
 
-static bool rtkit_switch_power_state(rtkit_dev_t *rtk, enum rtkit_power_state target)
+static bool rtkit_quiesce_ap_power(rtkit_dev_t *rtk)
 {
     struct asc_message msg;
 
-    if (rtk->crashed)
-        return false;
-
     /* AP power should always go to QUIESCED, otherwise rebooting doesn't work */
     msg.msg0 = FIELD_PREP(MGMT_TYPE, MGMT_MSG_AP_PWR_STATE) |
                FIELD_PREP(MGMT_PWR_STATE, RTKIT_POWER_QUIESCED);
@@ -818,13 +815,27 @@ static bool rtkit_switch_power_state(rtkit_dev_t *rtk, enum rtkit_power_state ta
         }
     }
 
+    return true;
+}
+
+static bool rtkit_switch_power_state(rtkit_dev_t *rtk, enum rtkit_power_state target)
+{
+    struct asc_message msg;
+
+    if (rtk->crashed)
+        return false;
+
+    if (!rtkit_quiesce_ap_power(rtk))
+        return false;
+
     msg.msg0 = FIELD_PREP(MGMT_TYPE, MGMT_MSG_IOP_PWR_STATE) | FIELD_PREP(MGMT_PWR_STATE, target);
+    msg.msg1 = RTKIT_EP_MGMT;
     if (!asc_send(rtk->asc, &msg)) {
         rtkit_printf("unable to send shutdown message\n");
         return false;
     }
 
-    timeout = timeout_calculate(rtk->timeout_usec ? rtk->timeout_usec : 1000000);
+    u64 timeout = timeout_calculate(rtk->timeout_usec ? rtk->timeout_usec : 1000000);
     while (rtk->iop_power != target) {
         if (timeout_expired(timeout)) {
             rtkit_printf("IOP power transition timed out\n");
@@ -846,6 +857,39 @@ static bool rtkit_switch_power_state(rtkit_dev_t *rtk, enum rtkit_power_state ta
     return true;
 }
 
+/*
+ * Stop the IOP sending syslog, ioreport and oslog traffic to the AP while the
+ * IOP itself keeps running, for a next stage that uses the coprocessor without
+ * servicing its mailbox.
+ */
+bool rtkit_quiesce_ap(rtkit_dev_t *rtk)
+{
+    struct rtkit_message msg;
+    int ret;
+
+    if (rtk->crashed)
+        return false;
+
+    while ((ret = rtkit_recv(rtk, &msg)) > 0)
+        rtkit_printf("dropping message to non-system endpoint 0x%02x before AP quiesce: %lx\n",
+                     msg.ep, msg.msg);
+    if (ret < 0 || !rtkit_quiesce_ap_power(rtk))
+        return false;
+
+    /* Acknowledge anything the IOP sent along with the transition. */
+    u64 timeout = timeout_calculate(50000);
+    while (!timeout_expired(timeout)) {
+        ret = rtkit_recv(rtk, &msg);
+        if (ret < 0)
+            return false;
+        if (ret > 0)
+            rtkit_printf("dropping message to non-system endpoint 0x%02x after AP quiesce: %lx\n",
+                         msg.ep, msg.msg);
+    }
+
+    return true;
+}
+
 bool rtkit_quiesce(rtkit_dev_t *rtk)
 {
     return rtkit_switch_power_state(rtk, RTKIT_POWER_QUIESCED);
diff --git a/src/rtkit.h b/src/rtkit.h
index 366b750d..29ca859c 100644
--- a/src/rtkit.h
+++ b/src/rtkit.h
@@ -26,6 +26,7 @@ struct rtkit_buffer {
 rtkit_dev_t *rtkit_init(const char *name, asc_dev_t *asc, dart_dev_t *dart,
                         iova_domain_t *dart_iovad, sart_dev_t *sart, bool sram);
 bool rtkit_quiesce(rtkit_dev_t *rtk);
+bool rtkit_quiesce_ap(rtkit_dev_t *rtk);
 bool rtkit_sleep(rtkit_dev_t *rtk);
 void rtkit_free(rtkit_dev_t *rtk);
 bool rtkit_has_owned_buffers(const rtkit_dev_t *rtk);
