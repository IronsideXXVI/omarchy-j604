From bc9d92e972a717ea6eead869d483014605a141e2 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 20:41:35 +0000
Subject: [PATCH 37/37] tests: host test of the PCIe port stride on the T8132

Run the production PCIe initializer on a T8132 apcie with pci-bridge0
and pci-bridge2 but no pci-bridge1, as on the J604. Check that port 2's
RC tunables, link speed (LNKCAP, LNKCAP2, LNKCTL2 and the directed
speed change) and link width land in ECAM device 2's window, that the
absent port's window is never touched, and that a bridge with
maximum-link-speed 1 takes its child's expected-link-speed. A second
case with every bridge present keeps one window per port.

[j604: X4-02, for the m1n1 packager: 0037 on 1.607 (m1n1 1.608).]

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 tests/python/test_pcie_port_stride.py | 204 ++++++++++++++++++++++++++
 1 file changed, 204 insertions(+)
 create mode 100644 tests/python/test_pcie_port_stride.py

diff --git a/tests/python/test_pcie_port_stride.py b/tests/python/test_pcie_port_stride.py
new file mode 100644
index 00000000..b71676c2
--- /dev/null
+++ b/tests/python/test_pcie_port_stride.py
@@ -0,0 +1,204 @@
+"""Run the production PCIe initializer on a T8132 with an unused port.
+
+The J604 apcie has pci-bridge0 (radio) and pci-bridge2 (SD reader) but no
+pci-bridge1. Each root port's DesignWare registers sit in its own 32 KiB ECAM
+device window (device N at N << 15). The model records every ECAM access and
+checks that port 2's RC tunables, link speed (LNKCAP, LNKCAP2, LNKCTL2 and the
+directed speed change) and link width land in device 2's window, that the
+absent port 1's window is never touched, and that port 2 takes its speed from
+the first child's expected-link-speed when the bridge says
+maximum-link-speed 1.
+"""
+
+from pathlib import Path
+import subprocess
+
+
+HARNESS = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef uint64_t u64;
+#define BIT(n) (1UL << (n))
+#define GENMASK(h, l) ((BIT((h) + 1) - 1) & ~(BIT(l) - 1))
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define FIELD_PREP(f, v) (((v) * ((f) & -(f))) & (f))
+#define FIELD_GET(f, v) (((v) & (f)) / ((f) & -(f)))
+#define T8140 0x8140
+#define ADT_GETPROP(a, n, p, v) adt_getprop_copy(a, n, p, v, sizeof(*(v)))
+static void *adt;
+static int chip_id = 0x8132;
+#define ECAM 0x1cb0000000ULL
+#define DEVS 4
+#define NREGS (7 + 3 * 8)
+static u64 regs[NREGS][2];
+static u32 ecam[DEVS][0x8000 / 4];
+static int ecam_access[DEVS];
+static u64 rc_tunables[DEVS];
+static int all_bridges;
+static int adt_path_offset(const void *a, const char *path)
+{
+    if (!strcmp(path, "/arm-io/apcie")) return 1;
+    if (!strcmp(path, "/arm-io/apcie/pci-bridge0")) return 2;
+    if (all_bridges && !strcmp(path, "/arm-io/apcie/pci-bridge1")) return 3;
+    if (!strcmp(path, "/arm-io/apcie/pci-bridge2")) return 4;
+    return -1;
+}
+static int adt_path_offset_trace(const void *a, const char *path, int *trace)
+{
+    trace[0] = adt_path_offset(a, path);
+    return trace[0];
+}
+static bool adt_is_compatible(const void *a, int node, const char *compat)
+{
+    return !strcmp(compat, node == 1 ? "apcie,t8132" : "apcie-bridge");
+}
+static const void *adt_getprop(const void *a, int node, const char *prop, u32 *len)
+{
+    if (!strcmp(prop, "apcie-common-tunables")) return NULL;
+    if (len) *len = sizeof(regs);
+    return regs;
+}
+static int adt_getprop_copy(const void *a, int node, const char *prop, void *out, size_t len)
+{
+    assert(len == 4);
+    if (!strcmp(prop, "#ports") && node == 1) *(u32 *)out = 3;
+    /* pci-bridge0 states Gen2 itself; the others defer to their child. */
+    else if (!strcmp(prop, "maximum-link-speed") && node >= 2 && node <= 4)
+        *(u32 *)out = node == 2 ? 2 : 1;
+    else if (!strcmp(prop, "expected-link-speed") && node >= 13 && node <= 14)
+        *(u32 *)out = 2;
+    else return -1;
+    return 4;
+}
+static int adt_get_reg(const void *a, int *path, const char *prop, int i, u64 *base, u64 *size)
+{
+    assert(i >= 0 && i < NREGS);
+    *base = regs[i][0];
+    if (size) *size = regs[i][1];
+    return 0;
+}
+static int adt_first_child_offset(const void *a, int node) { return node + 10; }
+static int tunables_validate_local(const char *path, const char *prop, u64 span) { return 0; }
+static int pmgr_adt_power_enable(const char *path) { return 0; }
+static int pmgr_adt_power_disable_index(const char *path, int i) { return 0; }
+static u32 *ecam_word(u64 addr)
+{
+    if (addr < ECAM || addr >= ECAM + DEVS * 0x8000ULL)
+        return NULL;
+    u64 off = addr - ECAM;
+    ecam_access[off >> 15]++;
+    return &ecam[off >> 15][(off & 0x7fff) / 4];
+}
+static u32 read32(u64 addr)
+{
+    u32 *w = ecam_word(addr);
+    return w ? *w : 0;
+}
+static void write32(u64 addr, u32 val)
+{
+    u32 *w = ecam_word(addr);
+    if (w) *w = val;
+}
+static void set32(u64 addr, u32 val) { write32(addr, read32(addr) | val); }
+static void clear32(u64 addr, u32 val) { write32(addr, read32(addr) & ~val); }
+static void mask32(u64 addr, u32 mask, u32 val) { write32(addr, (read32(addr) & ~mask) | val); }
+static void mask16(u64 addr, u16 mask, u16 val) { mask32(addr, mask, val); }
+static void udelay(int us) { }
+static int poll32(u64 addr, u32 mask, u32 target, int timeout) { return 0; }
+static int tunables_apply_local_addr(const char *path, const char *prop, uintptr_t base)
+{
+    if (!strcmp(prop, "pcie-rc-tunables")) {
+        assert(base >= ECAM && base < ECAM + DEVS * 0x8000ULL && !(base & 0x7fff));
+        rc_tunables[(base - ECAM) >> 15]++;
+    }
+    return 0;
+}
+static int tunables_apply_local(const char *path, const char *prop, u32 index)
+{
+    return tunables_apply_local_addr(path, prop, regs[index][0]);
+}
+''' + "%SOURCE%" + r'''
+#define LNKCAP(d)  ecam[d][(0x70 + 0x0c) / 4]
+#define LNKCAP2(d) ecam[d][(0x70 + 0x2c) / 4]
+#define LNKCTL2(d) ecam[d][(0x70 + 0x30) / 4]
+#define GEN2CTL(d) ecam[d][0x80c / 4]
+static void reset_model(void)
+{
+    memset(controllers, 0, sizeof(controllers));
+    memset(ecam, 0, sizeof(ecam));
+    memset(ecam_access, 0, sizeof(ecam_access));
+    memset(rc_tunables, 0, sizeof(rc_tunables));
+    pcie_initialized = false;
+    regs[0][0] = ECAM;
+    regs[0][1] = 0x10000000;
+    for (int i = 1; i < NREGS; i++) {
+        regs[i][0] = 0x390000000ULL + 0x100000ULL * i;
+        regs[i][1] = 0x10000;
+    }
+    /* DesignWare reset defaults: 16 GT/s x2, as Linux reads an unprogrammed port. */
+    for (int d = 0; d < DEVS; d++) {
+        LNKCAP(d) = 0x4 | (2 << 4);
+        LNKCAP2(d) = 0xf << 1;
+        LNKCTL2(d) = 0x4;
+    }
+}
+static void expect_gen2_x1(int d)
+{
+    assert(rc_tunables[d] == 1);
+    assert((LNKCAP(d) & 0xf) == 2);
+    assert(((LNKCAP(d) >> 4) & 0x3f) == 1);
+    assert(((LNKCAP2(d) >> 1) & 0x3f) == 0x3);
+    assert((LNKCTL2(d) & 0xf) == 2);
+    assert(GEN2CTL(d) & BIT(17));
+}
+int main(void)
+{
+    /* J604: ports 0 and 2, no pci-bridge1. */
+    reset_model();
+    assert(pcie_init() == 0);
+    assert(pcie_initialized);
+    expect_gen2_x1(0);
+    expect_gen2_x1(2);
+    assert(ecam_access[1] == 0 && rc_tunables[1] == 0);
+    assert((LNKCAP(1) & 0xf) == 4 && (LNKCTL2(1) & 0xf) == 4);
+    assert(ecam_access[3] == 0);
+
+    /* Every bridge present: the stride stays one window per port. */
+    reset_model();
+    all_bridges = 1;
+    assert(pcie_init() == 0);
+    assert(pcie_initialized);
+    expect_gen2_x1(0);
+    expect_gen2_x1(1);
+    expect_gen2_x1(2);
+    assert(ecam_access[3] == 0);
+    printf("pcie port stride: ok\n");
+    return 0;
+}
+'''
+
+
+def build_and_run(tmp_path, source_path):
+    source = Path(source_path).read_text()
+    source = "\n".join(line for line in source.splitlines()
+                       if not line.startswith("#include"))
+    binary = tmp_path / "pcie-port-stride"
+    subprocess.run(
+        ["cc", "-std=c11", "-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter",
+         "-Wno-unused-function", "-x", "c", "-", "-o", str(binary)],
+        input=HARNESS.replace("%SOURCE%", source), text=True, check=True,
+    )
+    return subprocess.run([str(binary)], capture_output=True, text=True)
+
+
+def test_t8132_unused_port_stride(tmp_path):
+    repo = Path(__file__).resolve().parents[2]
+    result = build_and_run(tmp_path, repo / "src/pcie.c")
+    assert result.returncode == 0, result.stderr
+    assert "pcie port stride: ok" in result.stdout
-- 
2.43.0

