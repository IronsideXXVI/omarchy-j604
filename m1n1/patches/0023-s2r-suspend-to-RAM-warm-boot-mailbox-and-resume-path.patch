diff --git a/src/s2r.c b/src/s2r.c
new file mode 100644
index 00000000..0bc43d95
--- /dev/null
+++ b/src/s2r.c
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: MIT */
+
+/*
+ * Suspend-to-RAM warm boot path (J604 / T8132 bring-up, not installed).
+ *
+ * After suspend-to-RAM the SoC wakes the boot core through a core reset at
+ * its locked RVBAR (aura PR #109 J713 trace: "wake = the first core reset
+ * after the commit", MMU off; SOURCE). On T8132 the RVBAR is the
+ * _vectors_start of the m1n1 image that ran kboot (smp.c refuses to start a
+ * secondary otherwise; chainload.c copies each stage over the previous
+ * stage's _base), so this binary, its .data and this mailbox are what the
+ * reset reaches (CODE; TO-VERIFY on a J604 with the read-only probe). kboot
+ * reserves _base.._end, so Linux never reuses this memory.
+ *
+ * Linux (apple-s2r) arms the mailbox right before the final WFI: magic,
+ * entry = __pa(cpu_resume), arg, flags, cleaned to the PoC. Here, on the boot
+ * core only, before anything prints or touches a SoC-domain device (the
+ * UARTs and the USB gadget are powered off across suspend-to-RAM):
+ *
+ *  1. disarm the mailbox and record that the warm path ran (bit 63),
+ *  2. stop the watchdog if apple-s2r armed it as a bring-up safety net, using
+ *     the base this m1n1 recorded at boot (the ADT is gone by now),
+ *  3. redo the per-core setup a reset loses (init_cpu: chicken bits, ...)
+ *     quietly,
+ *  4. branch to the kernel's entry at EL2 with the MMU and caches off.
+ *
+ * The cluster frequency and memory cache init requests (flags 1, 2) need the
+ * ADT, which Linux has reclaimed; they are refused on this path: the kernel
+ * side restores what it needs (apple-s2r syscore resume, cpufreq).
+ */
+
+#include "s2r.h"
+#include "adt.h"
+#include "chickens.h"
+#include "libfdt/libfdt.h"
+#include "memory.h"
+#include "smp.h"
+#include "soc.h"
+#include "utils.h"
+#include "wdt.h"
+
+bool s2r_warm_quiet = false;
+
+/* Reset through the watchdog this m1n1 found at boot; spin if that fails */
+static void __attribute__((noreturn)) s2r_reboot(void)
+{
+    wdt_reboot();
+    while (1)
+        sysop("wfi");
+}
+
+/*
+ * In .data, so it lives in this image's reserved memory; 64-byte aligned
+ * so it shares no cache line with anything Linux could see.
+ */
+static struct s2r_mailbox s2r_mailbox __attribute__((section(".data"), aligned(64))) = {0};
+
+bool s2r_supported(void)
+{
+    /* J604 bring-up only; other SoCs are untouched. */
+    return chip_id == T8132;
+}
+
+bool s2r_warm_pending(void)
+{
+    if (!s2r_supported())
+        return false;
+
+    /* MMU and caches are off here: this reads what Linux cleaned to the PoC. */
+    return read64((u64)&s2r_mailbox.magic) == S2R_MAGIC;
+}
+
+void s2r_warm_resume(void)
+{
+    u64 base = (u64)&s2r_mailbox;
+    u64 entry = read64(base + 8);
+    u64 arg = read64(base + 16);
+    u64 flags = read64(base + 24);
+
+    write64(base, 0);
+    write64(base + 24, flags | S2R_FLAG_RESUMED);
+    sysop("dsb sy");
+
+    if (flags & S2R_FLAG_REBOOT_AT_ENTRY)
+        s2r_reboot();
+
+    /* A watchdog apple-s2r armed for bring-up would reset us otherwise. */
+    wdt_disable_cached();
+
+    s2r_warm_quiet = true;
+    init_cpu();
+
+    if ((flags & S2R_FLAG_REBOOT_AT_BRANCH) || !entry)
+        s2r_reboot();
+
+    s2r_jump_el2(entry, arg);
+}
+
+int s2r_publish(void *dt)
+{
+    if (!s2r_supported())
+        return 0;
+
+    memset(&s2r_mailbox, 0, sizeof(s2r_mailbox));
+    dc_civac_range(&s2r_mailbox, sizeof(s2r_mailbox));
+
+    int node = fdt_path_offset(dt, "/chosen");
+    if (node < 0)
+        return -1;
+
+    if (fdt_setprop_u64(dt, node, "asahi,s2r-mailbox", (u64)&s2r_mailbox))
+        return -1;
+
+    printf("FDT: suspend-to-RAM warm boot mailbox at %p\n", &s2r_mailbox);
+    return 0;
+}
diff --git a/src/s2r.h b/src/s2r.h
new file mode 100644
index 00000000..efbc1895
--- /dev/null
+++ b/src/s2r.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: MIT */
+
+#ifndef S2R_H
+#define S2R_H
+
+#include "types.h"
+
+/*
+ * Suspend-to-RAM warm boot mailbox, the contract of the Linux apple-s2r
+ * driver (Documentation/devicetree/bindings/power/apple,pmgr-s2r.yaml):
+ * four little-endian u64 words at the physical address published in
+ * /chosen/asahi,s2r-mailbox.
+ */
+struct s2r_mailbox {
+    u64 magic;
+    u64 entry;
+    u64 arg;
+    u64 flags;
+};
+
+#define S2R_MAGIC                 0x21523253316e316dULL /* "m1n1S2R!" */
+#define S2R_FLAG_QUIET            BIT(0)
+#define S2R_FLAG_CPUFREQ_INIT     BIT(1)
+#define S2R_FLAG_MCC_INIT         BIT(2)
+#define S2R_FLAG_REBOOT_AT_ENTRY  BIT(3)
+#define S2R_FLAG_REBOOT_AT_BRANCH BIT(4)
+#define S2R_FLAG_RESUMED          BIT(63)
+
+/* Set while the warm boot path runs: everything that would print stays quiet */
+extern bool s2r_warm_quiet;
+
+bool s2r_supported(void);
+bool s2r_warm_pending(void);
+void __attribute__((noreturn)) s2r_warm_resume(void);
+int s2r_publish(void *dt);
+
+/* s2r_asm.S */
+void __attribute__((noreturn)) s2r_jump_el2(u64 entry, u64 arg);
+
+#endif
diff --git a/src/s2r_asm.S b/src/s2r_asm.S
new file mode 100644
index 00000000..ec41cee7
--- /dev/null
+++ b/src/s2r_asm.S
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: MIT */
+
+#include "cpu_regs.h"
+
+.text
+
+/*
+ * void s2r_jump_el2(u64 entry, u64 arg)
+ *
+ * Enter the kernel's resume entry (arm64 cpu_resume) the way it expects it:
+ * EL2, MMU and data/instruction caches off, interrupts masked, x0 = arg.
+ * The warm boot path never turned the MMU on, so this only makes sure of it.
+ */
+.globl s2r_jump_el2
+.type s2r_jump_el2, @function
+s2r_jump_el2:
+    msr daifset, #0xf
+    mov x9, x0
+    mrs x10, sctlr_el2
+    bic x10, x10, #(1 << 0)  /* M */
+    bic x10, x10, #(1 << 2)  /* C */
+    bic x10, x10, #(1 << 12) /* I */
+    msr sctlr_el2, x10
+    isb
+    ic iallu
+    dsb sy
+    isb
+    mov x0, x1
+    mov x1, xzr
+    mov x2, xzr
+    mov x3, xzr
+    br x9
