diff --git a/src/kboot.c b/src/kboot.c
index 4c591a38..de107d5a 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -2669,12 +2669,13 @@ static int dt_reserve_asc_segments(const char *adt_path, const char *adt_path_al
