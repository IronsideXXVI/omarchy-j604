# J604 local build: the official omarchy-pkgs recipe at 9679db33, changed only by
# pkgrel 6 -> 6.604 and the J604 patches in the source array (carried from 4.1.aurora3-3.612).
pkgname=aurora-audio
pkgver=4.1.aurora3
pkgrel=6.604
pkgdesc='Aurora Apple Silicon PipeWire/WirePlumber DSP profiles including J700'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/aurora-silicon/asahi-audio'
license=('MIT' 'GPL-2.0-only')
_commit=06aec67a8ac866eb5b40f44634652beff454e297
makedepends=('git' 'make')
provides=("asahi-audio=$pkgver" "asahi-audio-aurora=$pkgver")
conflicts=('asahi-audio' 'asahi-audio-aurora')
replaces=('asahi-audio-aurora')
# J616s speakers and microphones, which asahi-audio at $_commit does not cover yet:
# - graph-j616.json: aurora-silicon/asahi-audio c967141161be, firs/j616/graph.json (MIT)
# - mic-j616.json: the same commit's firs/j616/mic.json (MIT)
# - 99-asahi-j616.conf: the WirePlumber rules that put those graphs on hw:AppleJ616,1
#   and hw:AppleJ616HPAI,0,
#   and rank the separate headphone-jack card above DisplayPort audio
# - speakersafetyd-j616.conf: aurora-silicon/alarm-aurora f757ef3e3a,
#   packages/speakersafetyd-aurora-profiles/j616.conf (GPL-2.0-only): speakersafetyd
#   2.0.1's j316.conf model values with the J616 sense layout
source=("asahi-audio::git+$url.git#commit=$_commit"
        graph-j616.json
        mic-j616.json
        99-asahi-j616.conf
        speakersafetyd-j616.conf
        0001-j616-make-the-headphone-jack-card-the-default-when-p.patch
        0002-mics-present-the-processed-microphone-as-MONO-not-AU.patch
        0003-wireplumber-keep-the-headphone-volume-and-mute-of-ev.patch
        0004-speakers-end-every-output-path-with-a-true-peak-bric.patch
        0005-j604-add-the-J604-speaker-graph-and-microphone.patch
        0006-wireplumber-no-pro-audio-profile-on-the-headphone-ja.patch
        0007-wireplumber-hide-the-microphone-cards-from-clients.patch
        0008-j604-report-the-speaker-graph-s-latency.patch
        0009-j604-tune-the-speakers-with-our-own-biquads-fitted-t.patch
        0010-j604-steer-the-microphone-array-as-macOS-does.patch
        0011-j604-give-the-microphone-macOS-s-tonal-balance.patch)
