prepare() {
  # J604: the asahi-audio patches, in order
  local p
  for p in 0001-j616-make-the-headphone-jack-card-the-default-when-p.patch 0002-mics-present-the-processed-microphone-as-MONO-not-AU.patch 0003-wireplumber-keep-the-headphone-volume-and-mute-of-ev.patch 0004-speakers-end-every-output-path-with-a-true-peak-bric.patch 0005-j604-add-the-J604-speaker-graph-and-microphone.patch 0006-wireplumber-no-pro-audio-profile-on-the-headphone-ja.patch 0007-wireplumber-hide-the-microphone-cards-from-clients.patch 0008-j604-report-the-speaker-graph-s-latency.patch 0009-j604-tune-the-speakers-with-our-own-biquads-fitted-t.patch 0010-j604-steer-the-microphone-array-as-macOS-does.patch 0011-j604-give-the-microphone-macOS-s-tonal-balance.patch; do
    git -C asahi-audio apply --whitespace=nowarn "$srcdir/$p"
  done
}

package() {
  # The profile files can be packaged without installing the target audio stack.
  depends=('alsa-ucm-conf-aurora' 'pipewire-audio' 'wireplumber' 'bankstown'
           'lsp-plugins-lv2' 'triforce-lv2>=0.3.2-2.604' 'speakersafetyd' 'speakerguardd')
  make -C asahi-audio install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 asahi-audio/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 graph-j616.json "$pkgdir/usr/share/asahi-audio/j616/graph.json"
  install -Dm644 mic-j616.json "$pkgdir/usr/share/asahi-audio/j616/mic.json"
  install -Dm644 99-asahi-j616.conf "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/99-asahi-j616.conf"
  install -Dm644 speakersafetyd-j616.conf "$pkgdir/usr/share/speakersafetyd/apple/j616.conf"
}
