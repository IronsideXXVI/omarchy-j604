# J604 local build (see README)
# The official omarchy-pkgs recipe (941cc6bf), changed only by: pkgrel 3 -> 3.607 and the patches applied in prepare().
pkgname=aurora-audio
pkgver=4.1.aurora3
pkgrel=3.607
pkgdesc='Aurora Apple Silicon PipeWire/WirePlumber DSP profiles including J700'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
url='https://github.com/aurora-silicon/asahi-audio'
license=('MIT')
_commit=06aec67a8ac866eb5b40f44634652beff454e297
makedepends=('git' 'make')
provides=("asahi-audio=$pkgver" "asahi-audio-aurora=$pkgver")
conflicts=('asahi-audio' 'asahi-audio-aurora')
replaces=('asahi-audio-aurora')
source=("asahi-audio::git+$url.git#commit=$_commit"
        0001-j616-make-the-headphone-jack-card-the-default-when-p.patch
        0002-mics-present-the-processed-microphone-as-MONO-not-AU.patch
        0003-wireplumber-keep-the-headphone-volume-and-mute-of-ev.patch
        0004-speakers-end-every-output-path-with-a-true-peak-bric.patch
        0005-j604-add-the-J604-speaker-graph-and-microphone.patch
        0006-wireplumber-no-pro-audio-profile-on-the-headphone-ja.patch
        0007-wireplumber-hide-the-microphone-cards-from-clients.patch)
sha256sums=('SKIP'
            '11c0bae538763798df1d9eb0effd5bf83258a3df952037c2b7f8327ef9370878'
            'd3eba39d02955f1f4096633f25b92ba07c86f8f9738d01c34a3fd8308340a070'
            '7a78133815e4b0709014b015caeccaa4658897e5f81cc95eeac87ff730a3b070'
            'e6c37462e00c157c6643ba22c8ef4cfecce9a3af67344c4b24a202b25093c94c'
            'ee082856f5a66589b13326776b7fa27adcec1fa858b3a5b0995fd32d140e73cd'
            '777ab670da371b2442ba131964447a4c5db3c9b1ad9f8d661931f2d2dec15140'
            '83c69622c4b0466bd4032d88964d0c8befd930662de1c0615c40ff8311ac3664')
prepare() {
  # J604: six upstream asahi-audio commits (cherry-picked with -x) and the J604 graphs.
  local p
  for p in "${source[@]:1}"; do
    git -C asahi-audio apply --whitespace=nowarn "$srcdir/$p"
  done
}
package() {
  # The profile files can be packaged without installing the target audio stack.
  depends=('alsa-ucm-conf-aurora' 'pipewire-audio' 'wireplumber' 'bankstown'
           'lsp-plugins-lv2' 'triforce-lv2>=0.2.0' 'speakersafetyd' 'speakerguardd')
  make -C asahi-audio install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 asahi-audio/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
