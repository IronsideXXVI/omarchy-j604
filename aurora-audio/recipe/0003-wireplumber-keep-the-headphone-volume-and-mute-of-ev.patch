+    {
+        matches = [
+            { device.name = "~alsa_card.*", api.alsa.card.name = "~^Mac.*" }
+        ]
+        actions = {
+            update-props = {
+                asahi.routes.select-unplugged = true
+            }
+        }
+    }
     # J700: the headphone route starts at 10 % on the desktop's (cubic)
     # volume scale, 60 dB below jack full scale, until the user sets a
-    # volume. With nothing plugged in, the jack's route is unavailable and
-    # WirePlumber would leave its node at 100 %: asahi-unplugged-routes.lua
-    # gives it the same stored or default volume. Both are device
-    # properties: match the card device by name (its alsa.* properties are
-    # only set once the device exists, after the rules have run).
+    # volume.
     {
         matches = [
             { device.name = "~alsa_card.*", api.alsa.card.name = "MacBook Neo J700" }
@@ -69,7 +84,6 @@ monitor.alsa.rules = [
         actions = {
             update-props = {
                 device.routes.default-sink-volume = 0.001
-                asahi.routes.select-unplugged = true
             }
         }
     }
