From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sat, 14 Nov 2026 15:37:42 +0000
Subject: [PATCH] j604: steer the microphone array as macOS does

The J604 used the J314 microphone graph: a 2 cm equilateral triangle
steered broadside. macOS's own beamformers for this board say otherwise.
Its 12-beam dictation array is plain delay-and-sum, and its per-microphone
delays fit one plane geometry to 0.1 us: microphone 2 at (21.55, 0.00) mm
and microphone 3 at (5.88, 14.76) mm from microphone 1. Its general beam
looks along azimuth 0 in the array plane.

Give the J604 its own mic.json with those positions and that direction
(h_angle 180, v_angle 90 in triforce's propagation-direction convention),
and stop aliasing the J314 graph for it. Node names and levels are those
of the alias it replaces.
---
 Makefile              |   2 +-
 README.J604.md        |  17 +++++++
 conf/wireplumber.conf |   2 +-
 firs/j604/mic.json    | 112 ++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 131 insertions(+), 2 deletions(-)
 create mode 100644 firs/j604/mic.json

diff --git a/Makefile b/Makefile
index 23f8b7d..e1ba748 100644
--- a/Makefile
+++ b/Makefile
@@ -18,7 +18,7 @@ aliases-j293:
 	make -f $$PWD/Makefile -C firs/j293 graph-j493.json mic-j493.json
 
 aliases-j314:
-	make -f $$PWD/Makefile -C firs/j314 graph-j414.json mic-j414.json graph-j504.json mic-j504.json graph-j514.json mic-j514.json mic-j604.json
+	make -f $$PWD/Makefile -C firs/j314 graph-j414.json mic-j414.json graph-j504.json mic-j504.json graph-j514.json mic-j514.json
 
 aliases-j316:
 	make -f $$PWD/Makefile -C firs/j316 graph-j416.json mic-j416.json graph-j516.json mic-j516.json
diff --git a/README.J604.md b/README.J604.md
index 52fe8c6..2202ff3 100644
--- a/README.J604.md
+++ b/README.J604.md
@@ -76,3 +76,20 @@ biquad chain, fitted to a measured target:
 - Per-unit calibration: macOS fills `speaker-thiele-small` and the mic trims
   (`syscfg/MiGa`) at run time; these graphs, like every asahi-audio graph, do
   not use them.
+
+## Microphone geometry and steering
+
+macOS's own beamformers for this board (AID30 tuning, board strips of the
+J604) contain a 12-beam dictation array that is pure delay-and-sum: every
+weight has magnitude 1/3, and its phase is a constant delay per microphone
+in every band. Those delays fit one plane geometry to 0.1 us rms: with
+microphone 1 at the origin, microphone 2 at (21.55, 0.00) mm and
+microphone 3 at (5.88, 14.76) mm, so the array is not the 2 cm equilateral
+triangle of the J314 graph. macOS's general (non-dictation) beam looks along
+azimuth 0 in the array plane. mic.json gives triforce those positions and
+that look direction (h_angle 180 and v_angle 90 in triforce's convention,
+where the direction is the one the wave travels). Only the geometry and the
+direction are used; no Apple coefficients are added.
+
+This needs triforce-lv2 with the steering phase fix (0.3.2-1.611): older
+builds compute almost the same steering vector for every direction.
diff --git a/conf/wireplumber.conf b/conf/wireplumber.conf
index 9c4d5ed..8209e8f 100644
--- a/conf/wireplumber.conf
+++ b/conf/wireplumber.conf
@@ -588,7 +588,7 @@ node.software-dsp.rules = [
         ]
         actions = {
             create-filter = {
-                filter-path = "/usr/share/asahi-audio/j314/mic-j604.json"
+                filter-path = "/usr/share/asahi-audio/j604/mic.json"
                 hide-parent = true
             }
         }
diff --git a/firs/j604/mic.json b/firs/j604/mic.json
new file mode 100644
index 0000000..166fb0c
--- /dev/null
+++ b/firs/j604/mic.json
@@ -0,0 +1,112 @@
+{
+    "node.description": "MacBook Pro J604 Microphone",
+    "media.name": "MacBook Pro J604 Microphone",
+    "filter.graph": {
+        "nodes": [
+            {
+                "type": "builtin",
+                "label": "mixer",
+                "name": "mixL",
+                "control": {
+                    "Gain 1": 3
+                }
+            }
+            {
+                "type": "builtin",
+                "label": "mixer",
+                "name": "mixR",
+                "control": {
+                    "Gain 1": 3
+                }
+            }
+            {
+                "type": "builtin",
+                "label": "mixer",
+                "name": "mixO",
+                "control": {
+                    "Gain 1": 2
+                }
+            }
+            {
+                "type": "lv2",
+                "plugin": "https://chadmed.au/triforce",
+                "name": "bf",
+                "control": {
+                    "h_angle": 180.0,
+                    "v_angle": 90.0,
+                    "opt_freq": 1100.0,
+                    "t_win": 500.0,
+                    "mic2_x": 0.02155,
+                    "mic2_y": 0.0,
+                    "mic3_x": 0.00588,
+                    "mic3_y": 0.01476,
+                }
+            },
+            {
+                "type": "builtin",
+                "label": "mixer",
+                "name": "boostInter",
+                "control": {
+                    "Gain 1": 7.6
+                }
+            },
+            {
+                "type": "builtin",
+                "label": "mixer",
+                "name": "boostFinal",
+                "control": {
+                    "Gain 1": 7.6
+                }
+            },
+            {
+                "type": "builtin",
+                "label": "bq_highpass",
+                "name": "hpf",
+                "control": {
+                    "Freq": 120,
+                    "Gain": 1,
+                    "Q": 0.707
+                }
+            },
+        ],
+        "links": [
+            { "output": "mixL:Out", "input": "bf:in_1" },
+            { "output": "mixR:Out", "input": "bf:in_2" },
+            { "output": "mixO:Out", "input": "bf:in_3" },
+            { "output": "bf:out", "input": "boostInter:In 1" },
+            { "output": "boostInter:Out", "input": "boostFinal:In 1" },
+            { "output": "boostFinal:Out", "input": "hpf:In" },
+        ],
+        "inputs": [
+            "mixL:In 1",
+            "mixR:In 1",
+            "mixO:In 1",
+        ],
+        "outputs": [
+            "hpf:Out"
+        ],
+    },
+    "capture.props": {
+        "node.name": "audio_effect.j604-mic",
+        "audio.channels": "3",
+        "audio.position": ["AUX0", "AUX1", "AUX2"],
+        "audio.allowed-rates": [48000],
+        "node.virtual": "false",
+        "state.default-volume": 1.00,
+        "device.icon-name": "audio-microphone",
+        "target.object": "alsa_input.platform-sound.RawMics",
+        "node.dont-fallback": "true",
+        "node.passive": "true"
+    },
+    "playback.props": {
+        "node.name": "effect_output.j604-mic",
+        "media.class": "Audio/Source",
+        "priority.session": 2005,
+        "node.passive": "true",
+        "audio.channels": "1",
+        "node.virtual": "false",
+        "state.default-volume": 0.343,
+        "audio.allowed-rates": [8000, 11025, 16000, 22050, 44100, 48000],
+        "audio.position": ["MONO"]
+    }
+}
