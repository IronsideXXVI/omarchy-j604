From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Sun, 8 Nov 2026 14:09:07 +0000
Subject: [PATCH 104/104] Let a platform leave keys its keyboards lack out of
 the keybindings menu

The platform's key-names file names keys the way its keyboards print them (on a MacBook, XF86MonBrightnessUp/Down are F2/F1), but a key the platform's keyboards don't have at all still shows as a raw keysym row. On a MacBook the Super+K list ends with XF86KbdBrightnessDown, XF86KbdBrightnessUp and XF86KbdLightOnOff, which media.lua binds for keyboards with backlight keys and notes MacBooks lack (it binds Ctrl + F1/F2 for the same actions, and those rows already show).

A key-names line "<keysym> -" now says the key is not on the platform's keyboards, and the menu leaves that key's rows out. The binding itself is untouched and still works for a keyboard that has the key. Without a platform file, or without such a line, nothing changes; an older menu ignores the line. The cache key moves to v20 because the same binds and key names can render differently now.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
Assisted-by: LLM
---
 bin/omarchy-menu-keybindings          | 12 +++++++++---
 test/shell.d/keybindings-menu-test.sh | 18 +++++++++++++++++-
 2 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/bin/omarchy-menu-keybindings b/bin/omarchy-menu-keybindings
index e5372f740ab3b44ecac12723bf2228dc5ffaeae0..d18c171b5061c1c47ca39b900e091aae2ca7cc2c 100755
--- a/bin/omarchy-menu-keybindings
+++ b/bin/omarchy-menu-keybindings
@@ -11,7 +11,9 @@ declare -A LUA_BIND_ARG_MAP
 
 # A platform package can name keys the way its keyboards print them: one
 # "<keysym> <name>" per line (on a MacBook, XF86MonBrightnessUp is F2), in the
-# fixed platform root, which no environment variable moves.
+# fixed platform root, which no environment variable moves. "<keysym> -" says
+# its keyboards have no such key, and the menu leaves that key's rows out; the
+# binding itself still works.
 key_names_file=/usr/share/omarchy-platform/key-names
 
 # The leading layout and variant, which Hyprland resolves bindings against.
@@ -39,7 +41,10 @@ parse_keycodes() {
         # Blanks around a line and a CRLF line end read the same, as in
         # displays.conf.
         gsub(/^[ \t\r]+|[ \t\r]+$/, "", line)
-        if (split(line, name_parts, /[ \t]+/) == 2 && name_parts[1] ~ /^[A-Za-z0-9_]+$/ && name_parts[2] ~ /^[A-Za-z0-9_]+$/) key_name[name_parts[1]] = name_parts[2]
+        if (split(line, name_parts, /[ \t]+/) == 2 && name_parts[1] ~ /^[A-Za-z0-9_]+$/) {
+          if (name_parts[2] ~ /^[A-Za-z0-9_]+$/) key_name[name_parts[1]] = name_parts[2]
+          else if (name_parts[2] == "-") key_absent[name_parts[1]] = 1
+        }
       }
       close(key_names)
 
@@ -99,6 +104,7 @@ parse_keycodes() {
         rest = substr($0, first + 1)
         second = index(rest, ",")
         key = second > 0 ? substr(rest, 1, second - 1) : rest
+        if (key in key_absent) next
         if (key in key_name) $0 = substr($0, 1, first) key_name[key] (second > 0 ? substr(rest, second) : "")
       }
 
@@ -682,7 +688,7 @@ output_binding_records_uncached() {
 
 keybindings_cache_key() {
   {
-    printf 'v19\n'
+    printf 'v20\n'
     leading_keyboard
     omarchy-language 2>/dev/null
     cat "$OMARCHY_PATH/default/i18n/$(omarchy-language 2>/dev/null)/keybindings.json" 2>/dev/null
diff --git a/test/shell.d/keybindings-menu-test.sh b/test/shell.d/keybindings-menu-test.sh
index 0a952de37466e5181efcb169ee707def29edfb07..4573a37685ccffe41c1d1b6662fab7f11e02f23a 100755
--- a/test/shell.d/keybindings-menu-test.sh
+++ b/test/shell.d/keybindings-menu-test.sh
@@ -303,7 +303,7 @@ pass "keybinding descriptions show in the Omarchy language"
 # saved with CRLF line ends and blanks around a line, and (the copy above) none.
 platform=$tmpdir/platform
 mkdir -p "$platform/root" "$platform/crlf"
-printf '%s\n' 'XF86MonBrightnessUp F2' 'XF86MonBrightnessDown F1' 'not a line' 'Bad-Sym F3' >"$platform/root/key-names"
+printf '%s\n' 'XF86MonBrightnessUp F2' 'XF86MonBrightnessDown F1' 'not a line' 'Bad-Sym F3' 'XF86KbdBrightnessUp -' 'Bad-Sym -' >"$platform/root/key-names"
 printf '%s\r\n' 'XF86MonBrightnessUp F2' '  XF86MonBrightnessDown	F1 ' >"$platform/crlf/key-names"
 platform_root_copy "$ROOT/bin/omarchy-menu-keybindings" "$platform/with-names" "$platform/root"
 platform_root_copy "$ROOT/bin/omarchy-menu-keybindings" "$platform/crlf-names" "$platform/crlf"
@@ -341,6 +341,14 @@ bind
 	dispatcher: exec
 	arg: wtype -k XF86MonBrightnessUp
 
+bindl
+	modmask: 0
+	key: XF86KbdBrightnessUp
+	keycode: 0
+	description: Keyboard brightness up
+	dispatcher: exec
+	arg: omarchy-brightness-keyboard up
+
 bindm
 	modmask: 64
 	key: Q
@@ -375,6 +383,12 @@ grep -qF 'XF86MonBrightness' <<<"$output" &&
 tr -s ' ' <<<"$output" | grep -qF 'SUPER + Q → Close window' ||
   fail "unrelated bindings render unchanged (SUPER + Q)" "$output"
 
+# A key the platform's keyboards do not have ("<keysym> -") leaves its rows out.
+grep -qF 'XF86KbdBrightnessUp' <<<"$output" &&
+  fail "a key the platform's keyboards lack is left out of the menu" "$output"
+(( $(tr -s ' ' <<<"$output" | grep -cF '→ Keyboard brightness up') == 1 )) ||
+  fail "only the absent key's row goes, not others with the same action" "$output"
+
 # The menu runs a chosen row from its cached record, which carries what the
 # binding runs.
 records=$(cat "$names_cache"/omarchy/keybindings-*.records)
@@ -394,6 +408,8 @@ output=$(keybindings "$menu" "$names_cache")
 tr -s ' ' <<<"$output" | grep -qF 'SHIFT + XF86MonBrightnessUp → Keyboard brightness up' ||
   fail "without key names the brightness key keeps its own name" "$output"
 grep -qF 'SHIFT + F2' <<<"$output" && fail "without key names nothing is renamed F2" "$output"
+tr -s ' ' <<<"$output" | grep -qF 'XF86KbdBrightnessUp → Keyboard brightness up' ||
+  fail "without key names no key is left out" "$output"
 pass "keybindings menu keeps keysym names without a platform package"
 
 # The menu learns about Lua-only binds by running the user's hyprland.lua under
