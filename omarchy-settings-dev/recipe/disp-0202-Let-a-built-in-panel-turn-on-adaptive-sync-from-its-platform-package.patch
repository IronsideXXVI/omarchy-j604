From 6ef854e510c4646c97dfa66a53bbf660b894d972 Mon Sep 17 00:00:00 2001
From: Dylan Ironside <dylan@dylanironside.io>
Date: Thu, 12 Nov 2026 19:21:10 +0000
Subject: [PATCH] Let a built-in panel turn on adaptive sync from its platform
 package

A panel line in displays.conf can now carry vrr, Hyprland's adaptive sync setting (0 off, 1 on, 2 fullscreen only, 3 fullscreen video or game), next to bitdepth and cm. It reaches only that panel's rules, and a vrr chosen in hypr/monitors.lua still wins.
---
 default/hypr/panel-defaults.lua     | 12 +++++++++---
 docs/file-layout.md                 |  4 ++--
 test/shell.d/panel-defaults-test.sh | 16 +++++++++++++++-
 3 files changed, 26 insertions(+), 6 deletions(-)

diff --git a/default/hypr/panel-defaults.lua b/default/hypr/panel-defaults.lua
index d04153ee..7ce0eee4 100644
--- a/default/hypr/panel-defaults.lua
+++ b/default/hypr/panel-defaults.lua
@@ -5,9 +5,10 @@
 --   panel <connector> <width>x<height> <key>=<value> ...
 --
 -- the panel on a connector whose name starts with <connector>, running at that
--- mode (see docs/file-layout.md). Omarchy reads two keys: bitdepth (8 or 10)
--- and cm (a Hyprland color preset for SDR: srgb, dp3, dcip3, adobe, wide or
--- edid). Give each of that panel's rules those settings. Omarchy ships no such
+-- mode (see docs/file-layout.md). Omarchy reads three keys: bitdepth (8 or
+-- 10), cm (a Hyprland color preset for SDR: srgb, dp3, dcip3, adobe, wide or
+-- edid) and vrr (Hyprland's adaptive sync: 0 off, 1 on, 2 fullscreen only, 3
+-- fullscreen video or game). Give each of that panel's rules those settings. Omarchy ships no such
 -- line, so without a platform package that names a panel this changes nothing,
 -- and other monitors are never touched.
 --
@@ -39,6 +40,11 @@ local KEYS = {
       return value
     end
   end,
+  vrr = function(value)
+    if value == "0" or value == "1" or value == "2" or value == "3" then
+      return tonumber(value)
+    end
+  end,
 }
 
 local function parse_line(line)
diff --git a/docs/file-layout.md b/docs/file-layout.md
index 75a5928e..7bec4bb1 100644
--- a/docs/file-layout.md
+++ b/docs/file-layout.md
@@ -176,7 +176,7 @@ See [lifecycle-dispatch.md](lifecycle-dispatch.md#platform-files).
 
 - `backlight-skip <glob>`: a `/sys/class/backlight` name (a shell glob) that never drives the built-in panel, such as a Touch Bar's. It is never picked, not even when a later directive or the built-in order names it.
 - `backlight-prefer <name>`: the built-in panel's backlight, a literal name, tried after `gmux_backlight` and before the GPU and ACPI ones, in file order.
-- `panel <connector> <width>x<height> <key>=<value> ...`: monitor settings a built-in panel needs that Hyprland doesn't pick for it, for the panel on a connector whose name starts with `<connector>` (as in `display-cutouts.json`), running at that mode. Keys: `bitdepth` (8 or 10) and `cm` (`srgb`, `dp3`, `dcip3`, `adobe`, `wide` or `edid`); a key Omarchy doesn't know is skipped, and a line with a bad value is left out whole. `default/hypr/panel-defaults.lua` gives every monitor rule for that panel the settings, and gives the panel a copy of the catch-all rule of its own, so external monitors never get them. A setting made in `hypr/monitors.lua` for the port, the monitor's description or every monitor wins, key by key.
+- `panel <connector> <width>x<height> <key>=<value> ...`: monitor settings a built-in panel needs that Hyprland doesn't pick for it, for the panel on a connector whose name starts with `<connector>` (as in `display-cutouts.json`), running at that mode. Keys: `bitdepth` (8 or 10), `cm` (`srgb`, `dp3`, `dcip3`, `adobe`, `wide` or `edid`) and `vrr` (Hyprland's adaptive sync: `0` off, `1` on, `2` fullscreen only, `3` fullscreen video or game); a key Omarchy doesn't know is skipped, and a line with a bad value is left out whole. `default/hypr/panel-defaults.lua` gives every monitor rule for that panel the settings, and gives the panel a copy of the catch-all rule of its own, so external monitors never get them. A setting made in `hypr/monitors.lua` for the port, the monitor's description or every monitor wins, key by key.
 - `ddc-require-connector-ddc`: the display driver registers no DDC channel, so a probe would only walk unrelated I2C buses. An external monitor (other than an Apple Studio or XDR Display, which `omarchy-brightness-display-apple` drives with asdcontrol) is probed only when its DRM connector has a `ddc` node (`/sys/class/drm/card*-<connector>/ddc`); otherwise it gets no DDC or backlight control, and the built-in panel is never dimmed in its place.
 
 No environment variable moves the file: these commands also run under `sudo` and from the brightness keys. Their tests (`test/shell.d/hw-display-test.sh`, `test/shell.d/brightness-display-test.sh`, `test/shell.d/panel-defaults-test.sh`) run a copy rewritten to read a fixture in its place.
@@ -397,7 +397,7 @@ A platform's default package set is the base list, then its architecture's addit
 
 - `backlight-skip <glob>`: a `/sys/class/backlight` name (a shell glob) that never drives the built-in panel, such as a Touch Bar's. It is never picked, not even when a later directive or the built-in order names it.
 - `backlight-prefer <name>`: the built-in panel's backlight, a literal name, tried after `gmux_backlight` and before the GPU and ACPI ones, in file order.
-- `panel <connector> <width>x<height> <key>=<value> ...`: monitor settings a built-in panel needs that Hyprland doesn't pick for it, for the panel on a connector whose name starts with `<connector>` (as in `display-cutouts.json`), running at that mode. Keys: `bitdepth` (8 or 10) and `cm` (`srgb`, `dp3`, `dcip3`, `adobe`, `wide` or `edid`); a key Omarchy doesn't know is skipped, and a line with a bad value is left out whole. `default/hypr/panel-defaults.lua` gives every monitor rule for that panel the settings, and gives the panel a copy of the catch-all rule of its own, so external monitors never get them. A setting made in `hypr/monitors.lua` for the port, the monitor's description or every monitor wins, key by key.
+- `panel <connector> <width>x<height> <key>=<value> ...`: monitor settings a built-in panel needs that Hyprland doesn't pick for it, for the panel on a connector whose name starts with `<connector>` (as in `display-cutouts.json`), running at that mode. Keys: `bitdepth` (8 or 10), `cm` (`srgb`, `dp3`, `dcip3`, `adobe`, `wide` or `edid`) and `vrr` (Hyprland's adaptive sync: `0` off, `1` on, `2` fullscreen only, `3` fullscreen video or game); a key Omarchy doesn't know is skipped, and a line with a bad value is left out whole. `default/hypr/panel-defaults.lua` gives every monitor rule for that panel the settings, and gives the panel a copy of the catch-all rule of its own, so external monitors never get them. A setting made in `hypr/monitors.lua` for the port, the monitor's description or every monitor wins, key by key.
 - `ddc-require-connector-ddc`: the display driver registers no DDC channel, so a probe would only walk unrelated I2C buses. An external monitor (other than an Apple Studio or XDR Display, which `omarchy-brightness-display-apple` drives with asdcontrol) is probed only when its DRM connector has a `ddc` node (`/sys/class/drm/card*-<connector>/ddc`); otherwise it gets no DDC or backlight control, and the built-in panel is never dimmed in its place.
 
 No environment variable moves the file: these commands also run under `sudo` and from the brightness keys. Their tests (`test/shell.d/hw-display-test.sh`, `test/shell.d/brightness-display-test.sh`, `test/shell.d/panel-defaults-test.sh`) run a copy rewritten to read a fixture in its place.
diff --git a/test/shell.d/panel-defaults-test.sh b/test/shell.d/panel-defaults-test.sh
index 3845a8c9..9a5aafb8 100644
--- a/test/shell.d/panel-defaults-test.sh
+++ b/test/shell.d/panel-defaults-test.sh
@@ -184,6 +184,20 @@ check(last_for("eDP-1").bitdepth == 10 and last_for("eDP-1").cm == "dp3" and las
 ' || fail "a named panel arriving later gets its settings"
 pass "a panel arriving later gets its settings"
 
+# A panel line can turn on adaptive sync; external monitors and a choice made in
+# the config keep theirs.
+printf 'panel eDP 3024x1964 bitdepth=10 cm=dp3 vrr=1\n' >"$displays_conf"
+run_lua "$panel"'
+load_module()
+hl.monitor({ output = "", scale = "auto" })
+check(last_for("eDP-1").vrr == 1 and last_for("eDP-1").bitdepth == 10, "gives the panel adaptive sync, got " .. tostring(last_for("eDP-1").vrr))
+check(applied[1].vrr == nil, "leaves the catch-all without it")
+check(#for_output("DP-1") == 0, "an external monitor gets no rule of its own")
+hl.monitor({ output = "eDP-1", scale = 2, vrr = 0 })
+check(last_for("eDP-1").vrr == 0, "keeps 0 chosen for the port, got " .. tostring(last_for("eDP-1").vrr))
+' || fail "a panel line sets vrr"
+pass "a panel line sets vrr"
+
 # A key this Omarchy doesn't know is skipped, and the ones it knows still apply.
 printf 'panel eDP 3024x1964 bitdepth=10 sharpness=3\n' >"$displays_conf"
 run_lua "$panel"'
@@ -195,7 +209,7 @@ pass "an unknown key is skipped"
 
 # Without a well-formed panel line, or without the file, hl.monitor isn't wrapped.
 for content in missing 'backlight-prefer apple-panel-bl' 'panel eDP 3024x1964' 'panel eDP 3024x1964 sharpness=3' \
-  'panel eDP 3024x1964 bitdepth=12' 'panel eDP 3024x1964 cm=hdr' 'panel eDP 3024x1964 cm=bogus bitdepth=10' \
+  'panel eDP 3024x1964 bitdepth=12' 'panel eDP 3024x1964 cm=hdr' 'panel eDP 3024x1964 vrr=4' 'panel eDP 3024x1964 vrr=on' 'panel eDP 3024x1964 cm=bogus bitdepth=10' \
   'panel eDP 3024x1964 bitdepth' 'panel eDP 3024-1964 bitdepth=10' 'panel ../eDP 3024x1964 bitdepth=10' \
   'panel-bitdepth eDP 3024x1964 10'; do
   if [[ $content == missing ]]; then
