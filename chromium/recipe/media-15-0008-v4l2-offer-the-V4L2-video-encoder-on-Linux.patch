media/gpu: offer the V4L2 video encoder on Linux

On Linux, GpuVideoEncodeAcceleratorFactory picks the encoder backend that
matches the active decoder, and with use_v4l2_codec that is V4L2, but
V4L2VideoEncodeAccelerator is built only for ChromeOS and CreateV4L2VEA()
returns no encoder elsewhere (crbug.com/901264: the DMA-buf plane offset
is passed in data_offset). A V4L2 build then has no hardware encoder at
all, whatever the features.

Build V4L2VideoEncodeAccelerator on Linux too, and create it when the
AcceleratedVideoEncoder feature (kAcceleratedVideoEncodeLinux) is
enabled, as the VA-API encoder already requires. Without the feature
nothing changes.

--- a/media/gpu/gpu_video_encode_accelerator_factory.cc
+++ b/media/gpu/gpu_video_encode_accelerator_factory.cc
@@ -63,6 +63,13 @@
   // a DMA-buf, which is not supported upstream.
   return base::WrapUnique<VideoEncodeAccelerator>(
       new V4L2VideoEncodeAccelerator(base::MakeRefCounted<V4L2Device>()));
+#elif BUILDFLAG(IS_LINUX)
+  // As the VA-API encoder: only with the AcceleratedVideoEncoder feature.
+  if (!base::FeatureList::IsEnabled(kAcceleratedVideoEncodeLinux)) {
+    return nullptr;
+  }
+  return base::WrapUnique<VideoEncodeAccelerator>(
+      new V4L2VideoEncodeAccelerator(base::MakeRefCounted<V4L2Device>()));
 #else
   return nullptr;
 #endif
--- a/media/gpu/v4l2/BUILD.gn
+++ b/media/gpu/v4l2/BUILD.gn
@@ -83,7 +83,7 @@
     ]
   }
 
-  if (is_chromeos) {
+  if (is_chromeos || is_linux) {
     sources += [
       # TODO(crbug.com/901264): Encoders use hack for passing offset
       # within a DMA-buf, which is not supported upstream.
