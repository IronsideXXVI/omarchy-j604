media/gpu/v4l2: offer stateless HEVC only with Annex-B start codes

V4L2VideoDecoderDelegateH265 sends Annex-B pictures and no slice
parameters, and never reads the START_CODE or DECODE_MODE controls. On a
decoder that only takes start-code-less slices with slice parameters it
fails every picture. Skip HEVC profiles unless the decoder's START_CODE
control offers ANNEX_B.

--- a/media/gpu/v4l2/v4l2_utils.cc
+++ b/media/gpu/v4l2/v4l2_utils.cc
@@ -460,6 +460,20 @@
     return {};
   }
   const auto profile_cid = kV4L2CodecPixFmtToProfileCID.at(codec_as_pix_fmt);
+
+#if BUILDFLAG(ENABLE_HEVC_PARSER_AND_HW_DECODER)
+  // The stateless HEVC decoder sends each picture as Annex-B NAL units and no
+  // slice parameters. A decoder whose START_CODE control does not offer
+  // ANNEX_B needs slice parameters, so it cannot decode what is sent.
+  if (codec_as_pix_fmt == V4L2_PIX_FMT_HEVC_SLICE) {
+    v4l2_queryctrl start_code = {.id = V4L2_CID_STATELESS_HEVC_START_CODE};
+    if (ioctl_cb.Run(VIDIOC_QUERYCTRL, &start_code) != kIoctlOk ||
+        start_code.maximum < V4L2_STATELESS_HEVC_START_CODE_ANNEX_B) {
+      VLOGF(1) << "HEVC decoder does not take Annex-B start codes, skipping";
+      return {};
+    }
+  }
+#endif  // BUILDFLAG(ENABLE_HEVC_PARSER_AND_HW_DECODER)
 
   v4l2_queryctrl query_ctrl = {.id = static_cast<__u32>(profile_cid)};
   if (ioctl_cb.Run(VIDIOC_QUERYCTRL, &query_ctrl) != kIoctlOk) {
