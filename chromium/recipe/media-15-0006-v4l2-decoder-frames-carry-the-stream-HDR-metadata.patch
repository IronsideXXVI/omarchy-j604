media/gpu/v4l2: V4L2VideoDecoder frames carry the stream's HDR metadata

VpxVideoDecoder, Dav1dVideoDecoder and V4L2StatefulVideoDecoder attach the
config's HDR metadata (mastering display, content light level) to every
frame; V4L2VideoDecoder set only the colour space. The compositor's HDR
tone mapping then used different parameters for the same stream depending
on whether it was decoded in hardware or software. Keep the metadata from
Initialize() and set it in OutputFrame().

--- a/media/gpu/v4l2/v4l2_video_decoder.cc
+++ b/media/gpu/v4l2/v4l2_video_decoder.cc
@@ -324,6 +324,7 @@
   profile_ = config.profile();
   aspect_ratio_ = config.aspect_ratio();
   color_space_ = config.color_space_info();
+  hdr_metadata_ = config.hdr_metadata();
   current_resolution_ = config.visible_rect().size();
 
   if (profile_ == VIDEO_CODEC_PROFILE_UNKNOWN) {
@@ -1326,6 +1327,9 @@
   }
 
   frame->set_color_space(color_space.ToGfxColorSpace());
+  // As the software decoders and the V4L2 stateful decoder do: without it an
+  // HDR stream is tone-mapped differently when it is hardware decoded.
+  frame->set_hdr_metadata(hdr_metadata_);
 
   output_cb_.Run(std::move(frame));
 }
--- a/media/gpu/v4l2/v4l2_video_decoder.h
+++ b/media/gpu/v4l2/v4l2_video_decoder.h
@@ -32,6 +32,7 @@
 #include "media/gpu/v4l2/v4l2_status.h"
 #include "media/gpu/v4l2/v4l2_video_decoder_backend.h"
 #include "ui/gfx/geometry/size.h"
+#include "ui/gfx/hdr_metadata.h"
 
 namespace media {
 
@@ -211,6 +212,8 @@
   // it is available for InitializeBackend().
   VideoCodecProfile profile_ = VIDEO_CODEC_PROFILE_UNKNOWN;
   VideoColorSpace color_space_;
+  // The stream's HDR metadata, attached to every output frame.
+  gfx::HDRMetadata hdr_metadata_;
 
   // Hold onto the current resolution so we can use that to determine the size
   // of the input(OUTPUT) buffers.
