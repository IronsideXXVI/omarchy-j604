+namespace {
+
+// Whether the device's input queue takes user pointers. Drivers whose
+// encoder reads through an IOMMU of its own often offer MMAP and DMABUF only.
+bool InputQueueSupportsUserPtr(V4L2Device& device) {
+  struct v4l2_requestbuffers reqbufs = {};
+  reqbufs.count = 0;
+  reqbufs.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+  reqbufs.memory = V4L2_MEMORY_MMAP;
+  if (device.Ioctl(VIDIOC_REQBUFS, &reqbufs) != 0) {
+    return true;
+  }
+  if (!(reqbufs.capabilities & V4L2_BUF_CAP_SUPPORTS_MMAP)) {
+    // No capabilities reported (pre-5.0 kernel): keep USERPTR.
+    return true;
+  }
+  return reqbufs.capabilities & V4L2_BUF_CAP_SUPPORTS_USERPTR;
+}
+
+}  // namespace
+
 bool V4L2VideoEncodeAccelerator::InitInputMemoryType(const Config& config) {
   DCHECK_CALLED_ON_VALID_SEQUENCE(encoder_sequence_checker_);
+  if (!InitInputMemoryTypeInternal(config)) {
+    return false;
+  }
+  if (input_memory_type_ == V4L2_MEMORY_USERPTR &&
+      !InputQueueSupportsUserPtr(*device_)) {
+    VLOGF(1) << "Input queue has no USERPTR: copying frames into MMAP buffers";
+    input_memory_type_ = V4L2_MEMORY_MMAP;
+  }
+  return true;
+}
