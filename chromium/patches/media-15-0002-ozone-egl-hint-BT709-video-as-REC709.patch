From: Dylan Ironside <dylan@dylanironside.io>
Subject: [PATCH] ozone: hint BT.709 video as BT.709 when importing it through EGL

NativePixmapEGLBinding passes EGL_ITU_REC601_EXT as the YUV colour-space
hint for every NV12, YV12 and P010 import whose matrix is not BT.2020.
The comment ties that to ChromeOS, where frames may be promoted to
DRM/KMS overlays that are forced to BT.601. Linux composites video
through this import instead, so BT.709 content (most video) is converted
with the BT.601 matrix and its colours are shifted.

Hint BT.709 for the BT.709 matrix on Linux.

Signed-off-by: Dylan Ironside <dylan@dylanironside.io>
---
--- a/ui/ozone/common/native_pixmap_egl_binding.cc
+++ b/ui/ozone/common/native_pixmap_egl_binding.cc
@@ -10,6 +10,7 @@
 #include "base/memory/scoped_refptr.h"
 #include "base/notreached.h"
 #include "base/numerics/safe_conversions.h"
+#include "build/build_config.h"
 #include "ui/gfx/linux/drm_util_linux.h"
 #include "ui/gl/gl_bindings.h"
 #include "ui/gl/gl_surface_egl.h"
@@ -133,6 +134,13 @@
       case gfx::ColorSpace::MatrixID::BT2020_NCL:
         attrs.push_back(EGL_ITU_REC2020_EXT);
         break;
+#if BUILDFLAG(IS_LINUX)
+      // Linux composites video through this import (no DRM/KMS overlay with a
+      // forced BT.601 matrix), so BT.709 content needs the BT.709 matrix.
+      case gfx::ColorSpace::MatrixID::BT709:
+        attrs.push_back(EGL_ITU_REC709_EXT);
+        break;
+#endif
       default:
         attrs.push_back(EGL_ITU_REC601_EXT);
     }
